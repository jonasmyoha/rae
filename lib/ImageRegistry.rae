# Rae-owned image resource policy.
#
# This module owns image keys, loaded/failed status, retry throttling and cache
# metadata; the decode is C and the textures + key table live on the app's
# Gpu2dCanvas (#908), so every entry that touches an image takes the canvas.
import Gpu2d
open Gpu2dCanvas

enum ImageLoadStatus { none, pending, loaded, failed }

type ImageResource {
  key: String
  path: String
  status: ImageLoadStatus
  handle: Int
  attempts: Int
}

type ImageRegistry {
  items: List(ImageResource)
  failedPaths: String
  firedPaths: String
  revision: Int
}

func createImageRegistry() pub ret ImageRegistry {
  ret ImageRegistry {
    items: List.create(ImageResource, cap: 32)
    failedPaths: "|"
    firedPaths: "|"
    revision: 0
  }
}

func pathContains(haystack: view String, path: view String) ret Bool {
  let needle: String = "|{path}|"
  ret haystack.contains(sub: needle)
}

func appendPath(haystack: view String, path: view String) ret String {
  if pathContains(haystack: haystack, path: path) {
    ret haystack
  }
  ret haystack.concat(other: path).concat(other: "|")
}

func index(reg: view ImageRegistry, key: view String) pub ret Int {
  unsafe {
    var i: Int = 0
    loop i < reg.items.length {
      let item: ImageResource = rae_ext_rae_buf_get(buf: reg.items.data, index: i)
      if item.key is key {
        ret i
      }
      i = i + 1
    }
    ret 0 - 1
  }
}

func imageRegistryHas(
  reg: view ImageRegistry
  canvas: view Gpu2dCanvas
  key: view String
) pub ret Bool {
  unsafe {
    let idx: Int = index(reg: reg, key: key)
    if idx >= 0 {
      let item: ImageResource = rae_ext_rae_buf_get(buf: reg.items.data, index: idx)
      if item.status is ImageLoadStatus.loaded {
        ret true
      }
    }
    # The canvas owns the render-time key table; consult it as the bridge for
    # images registered outside this registry.
    ret Gpu2d.hasImageKey(canvas: canvas, key: key)
  }
}

func isFailedPath(reg: view ImageRegistry, path: view String) pub ret Bool {
  ret pathContains(haystack: reg.failedPaths, path: path)
}

func markFailedPath(reg: mod ImageRegistry, path: view String) pub {
  let next: String = appendPath(haystack: reg.failedPaths, path: path)
  if next is reg.failedPaths is false {
    reg.failedPaths = next
    reg.revision = reg.revision + 1
  }
}

func wasFired(reg: view ImageRegistry, path: view String) pub ret Bool {
  ret pathContains(haystack: reg.firedPaths, path: path)
}

func markFired(reg: mod ImageRegistry, path: view String) pub {
  let next: String = appendPath(haystack: reg.firedPaths, path: path)
  if next is reg.firedPaths is false {
    reg.firedPaths = next
    reg.revision = reg.revision + 1
  }
}

func markPending(reg: mod ImageRegistry, key: view String, path: view String) pub {
  unsafe {
    let idx: Int = index(reg: reg, key: key)
    if idx >= 0 {
      let item: ImageResource = rae_ext_rae_buf_get(buf: reg.items.data, index: idx)
      let updated: ImageResource = {
        key: "{item.key}"
        path: "{path}"
        status: ImageLoadStatus.pending
        handle: item.handle
        attempts: item.attempts
      }
      reg.items.set(index: idx, value: own updated)
      reg.revision = reg.revision + 1
      ret
    }
    let res: ImageResource = {
      key: "{key}"
      path: "{path}"
      status: ImageLoadStatus.pending
      handle: 0
      attempts: 0
    }
    reg.items.add(value: own res)
    reg.revision = reg.revision + 1
  }
}

func upsertResult(
  reg: mod ImageRegistry
  key: view String
  path: view String
  handle: view Int
) {
  unsafe {
    var status: ImageLoadStatus = ImageLoadStatus.failed
    if handle > 0 {
      status = ImageLoadStatus.loaded
    }
    let idx: Int = index(reg: reg, key: key)
    if idx >= 0 {
      let item: ImageResource = rae_ext_rae_buf_get(buf: reg.items.data, index: idx)
      var attempts: Int = item.attempts
      if handle <= 0 {
        attempts = attempts + 1
      }
      let updated: ImageResource = {
        key: "{key}"
        path: "{path}"
        status: status
        handle: handle
        attempts: attempts
      }
      reg.items.set(index: idx, value: own updated)
    } else {
      var attempts: Int = 0
      if handle <= 0 {
        attempts = 1
      }
      let res: ImageResource = {
        key: "{key}"
        path: "{path}"
        status: status
        handle: handle
        attempts: attempts
      }
      reg.items.add(value: own res)
    }
    if handle <= 0 {
      markFailedPath(reg: reg, path: path)
    } else {
      reg.revision = reg.revision + 1
    }
  }
}

func load(
  reg: mod ImageRegistry
  canvas: mod Gpu2dCanvas
  key: view String
  path: view String
) pub ret Int {
  unsafe {
    if imageRegistryHas(reg: reg, canvas: canvas, key: key) {
      let idx: Int = index(reg: reg, key: key)
      if idx >= 0 {
        let item: ImageResource = rae_ext_rae_buf_get(buf: reg.items.data, index: idx)
        ret item.handle
      }
      ret 1
    }
    if isFailedPath(reg: reg, path: path) {
      ret 0
    }
    let copiedKey: String = "{key}"
    let copiedPath: String = "{path}"
    let handle: Int = Gpu2d.loadImageKey(canvas: canvas, key: copiedKey, path: copiedPath)
    upsertResult(
      reg: reg
      key: key
      path: path
      handle: handle
    )
    ret handle
  }
}
