# String utilities for Rae
import Char

func rae_str_len(s: String) unsafe extern ret Int

func rae_str_eq(a: String, b: String) unsafe extern ret Bool

func rae_str_concat(a: String, b: String) unsafe extern ret String

func rae_str_sub(s: String, start: Int, len: Int) unsafe extern ret String

func rae_str_to_f64(s: String) unsafe extern ret Float

# The byte primitives the algorithms below are built on (inline in
# compiler/runtime/rae_runtime.h; docs/runtime-c-audit.md row 3): `memcmp` of
# two byte ranges (a range outside either String compares as different), and
# `memchr` for one byte from a position (-1 when absent). Allocating a String
# from bytes is the third.
func rae_ext_rae_str_compare_bytes(
  a: String
  aStart: Int
  b: String
  bStart: Int
  count: Int
) unsafe extern ret Int

func rae_ext_rae_str_find_byte(s: String, value: Int, from: Int) unsafe extern ret Int

# One to four byte values as a String (one UTF-8 character, no List)
func rae_ext_rae_str_from_small_bytes(
  first: Int
  second: Int
  third: Int
  fourth: Int
  count: Int
) unsafe extern ret String

func rae_ext_rae_str_from_bytes(
  buffer: Buffer(UInt8)
  offset: Int
  count: Int
) unsafe extern ret String

# Bytes `start` .. `start + count` of `bytes` as a String. The bytes are
# copied as they are: the caller decides what they encode.
func fromBytes(bytes: view List(UInt8), start: view Int, count: view Int) ret String {
  if start < 0 or count <= 0 or start + count > bytes.length {
    ret ""
  }
  unsafe {
    ret rae_ext_rae_str_from_bytes(buffer: bytes.data, offset: start, count: count)
  }
}

func rae_ext_rae_str_from_cstr(s: view Buffer(Any)) unsafe extern ret String

func rae_ext_rae_str_to_cstr(s: String) unsafe extern ret Buffer(Any)

# Deep-copy a String into a fresh owned heap allocation. Use this
# in any accessor that would otherwise return a shallow alias of
# someone else's storage — see jsonString in lib/json.rae for the
# canonical case. The result is always is_owned=1, so the caller
# can safely store it in a binding/struct field and rely on cascade
# drop to free it without double-freeing the source.
func rae_ext_rae_string_copy(string: view String) unsafe extern ret String

func stringCopy(string: view String) ret String {
  unsafe {
    ret rae_ext_rae_string_copy(string: string)
  }
}

# Adopts a raw C string pointer whose validity and NUL-termination the caller
# must guarantee — an unchecked lifetime obligation, so the wrapper is unsafe.
func fromCStr(s: view Buffer(Any)) unsafe ret String {
  unsafe {
    ret rae_ext_rae_str_from_cstr(s: s)
  }
}

# One Unicode scalar (a code point, e.g. 8212 for the em dash) as a String —
# its 1..4 UTF-8 bytes. A value outside U+0000..U+10FFFF, or in the
# surrogate range, becomes U+FFFD. The inverse of `at`. U+0000 gives ""
# (a String holds text, and the runtime ends text at a zero byte).
func fromCodepoint(code: view Int) ret String {
  var scalar: Int = code
  if code < 0 or code > 1114111 or (code >= 55296 and code <= 57343) {
    scalar = 65533
  }
  if scalar is 0 {
    ret ""
  }
  unsafe {
    if scalar < 128 {
      ret rae_ext_rae_str_from_small_bytes(
        first: scalar
        second: 0
        third: 0
        fourth: 0
        count: 1
      )
    }
    if scalar < 2048 {
      ret rae_ext_rae_str_from_small_bytes(
        first: 192 bitor (scalar shr 6)
        second: 128 bitor (scalar bitand 63)
        third: 0
        fourth: 0
        count: 2
      )
    }
    if scalar < 65536 {
      ret rae_ext_rae_str_from_small_bytes(
        first: 224 bitor (scalar shr 12)
        second: 128 bitor ((scalar shr 6) bitand 63)
        third: 128 bitor (scalar bitand 63)
        fourth: 0
        count: 3
      )
    }
    ret rae_ext_rae_str_from_small_bytes(
      first: 240 bitor (scalar shr 18)
      second: 128 bitor ((scalar shr 12) bitand 63)
      third: 128 bitor ((scalar shr 6) bitand 63)
      fourth: 128 bitor (scalar bitand 63)
      count: 4
    )
  }
}

# Hands out a raw pointer aliasing this String's storage; the caller must not
# let it outlive the String. Delegates that obligation, so it is unsafe.
func toCStr(this: view String) unsafe ret Buffer(Any) {
  unsafe {
    ret rae_ext_rae_str_to_cstr(s: this)
  }
}

# A code point as a Char32. Rae has no `as Char32` conversion; this inline
# runtime cast stands in for it (rae_runtime.h).
func rae_ext_rae_char_from_code(code: Int) unsafe extern ret Char32

func charFromCode(code: view Int) ret Char32 {
  unsafe {
    ret rae_ext_rae_char_from_code(code: code)
  }
}

# The character (Unicode scalar) whose UTF-8 encoding starts at byte
# `index`; 0 out of range. A byte that does not start a valid sequence, or a
# sequence cut short by the end of the String, reads as the byte itself.
func at(this: view String, index: view Int) ret Char32 {
  let first: Int = this.byteAt(index: index)
  if first < 0 {
    ret charFromCode(code: 0)
  }
  if first < 128 {
    ret charFromCode(code: first)
  }
  let length: Int = this.length()
  if (first bitand 224) is 192 {
    if index + 1 >= length {
      ret charFromCode(code: first)
    }
    let second: Int = this.byteAt(index: index + 1) bitand 63
    ret charFromCode(code: ((first bitand 31) shl 6) bitor second)
  }
  if (first bitand 240) is 224 {
    if index + 2 >= length {
      ret charFromCode(code: first)
    }
    let second: Int = this.byteAt(index: index + 1) bitand 63
    let third: Int = this.byteAt(index: index + 2) bitand 63
    ret charFromCode(code: ((first bitand 15) shl 12) bitor (second shl 6) bitor third)
  }
  if (first bitand 248) is 240 {
    if index + 3 >= length {
      ret charFromCode(code: first)
    }
    let second: Int = this.byteAt(index: index + 1) bitand 63
    let third: Int = this.byteAt(index: index + 2) bitand 63
    let fourth: Int = this.byteAt(index: index + 3) bitand 63
    ret charFromCode(
      code: ((first bitand 7) shl 18) bitor (second shl 12) bitor (third shl 6) bitor fourth
    )
  }
  ret charFromCode(code: first)
}

# Stage 5: read-only String helpers take `view String` so callers
# never have to pay a deep-copy at the call site. The externs they
# wrap still take `rae_String` by value at the C level; the codegen
# auto-derefs the view when emitting the call.
func rae_ext_rae_str_byte_at(s: String, index: Int) unsafe extern ret Int

# The raw byte at `index` (0..255; -1 when out of range) — as opposed to
# `at`, which decodes the UTF-8 character starting there. For byte-level
# editing such as stepping back over continuation bytes (0x80..0xBF).
func byteAt(this: view String, index: view Int) ret Int {
  unsafe {
    ret rae_ext_rae_str_byte_at(s: this, index: index)
  }
}

func length(this: view String) ret Int {
  unsafe {
    ret rae_str_len(s: this)
  }
}

# Byte-wise order: < 0, 0 or > 0 (memcmp's sign); when one String is a
# prefix of the other, the shorter one comes first.
func compare(this: view String, other: view String) ret Int {
  let length: Int = this.length()
  let otherLength: Int = other.length()
  var common: Int = length
  if otherLength < common {
    common = otherLength
  }
  unsafe {
    let result: Int = rae_ext_rae_str_compare_bytes(
      a: this
      aStart: 0
      b: other
      bStart: 0
      count: common
    )
    if result is not 0 {
      ret result
    }
  }
  if length < otherLength {
    ret -1
  }
  if length > otherLength {
    ret 1
  }
  ret 0
}

# 64-bit FNV-1a over the bytes (UInt64 arithmetic wraps). Equal Strings hash
# equal, the empty String included.
func hash(this: view String) ret Int {
  var value: UInt64 = 14695981039346656037
  let prime: UInt64 = 1099511628211
  let length: Int = this.length()
  loop var i: Int = 0, i < length, ++i {
    value = (value bitxor (this.byteAt(index: i) as UInt64)) * prime
  }
  ret value as Int
}

func concat(this: view String, other: view String) ret String {
  unsafe {
    ret rae_str_concat(a: this, b: other)
  }
}

# Byte-indexed substring: `start` and `len` are BYTES (like `length()`),
# but the cut never lands inside a character — a range that starts or ends
# inside a multi-byte UTF-8 sequence is widened to whole characters, so the
# result is always valid UTF-8 (docs/strings.md). For character positions use
# `charSub`.
func sub(this: view String, start: view Int, len: view Int) ret String {
  unsafe {
    ret rae_str_sub(s: this, start: start, len: len)
  }
}

# ----- characters (code points), on top of the byte API (docs/strings.md) --
#
# `length()`, `sub`, `at`, `byteAt`, `indexOf` are BYTE-indexed: fast, and
# what file formats, protocols and text layout want. These three count and
# index CHARACTERS (Unicode code points) instead. They walk the string, so
# they are O(n) — fine for a label, not for a loop over a large text; walk
# bytes with `at`/`byteAt` there.

# Number of characters (code points) — 6 for "héllo👋", where `length()` is 10.
func charCount(this: view String) ret Int {
  var count: Int = 0
  var i: Int = 0
  let n: Int = this.length()
  loop i < n {
    let byte: Int = this.byteAt(index: i)
    # Every byte that is not a continuation byte (0x80..0xBF) starts a
    # character.
    if byte < 128 or byte >= 192 {
      count = count + 1
    }
    i = i + 1
  }
  ret count
}

# The byte offset where character `index` starts; `length()` when `index`
# is past the end. The one walk the character API is built on.
func charByteOffset(this: view String, index: view Int) ret Int {
  if index < 0 {
    ret 0
  }
  var seen: Int = 0
  var i: Int = 0
  let n: Int = this.length()
  loop i < n {
    let byte: Int = this.byteAt(index: i)
    if byte < 128 or byte >= 192 {
      if seen is index {
        ret i
      }
      seen = seen + 1
    }
    i = i + 1
  }
  ret n
}

# The character at character position `index` (0 when out of range) — `at`
# with a character index instead of a byte index.
func charAt(this: view String, index: view Int) ret Char32 {
  let offset: Int = this.charByteOffset(index: index)
  if offset >= this.length() {
    ret 0
  }
  ret this.at(index: offset)
}

# `count` characters starting at character position `start`, as a new
# String — `sub` with character positions. Out-of-range positions clamp like
# `sub`; an empty range is the empty string.
func charSub(this: view String, start: view Int, count: view Int) ret String {
  if count <= 0 {
    ret ""
  }
  let from: Int = this.charByteOffset(index: start)
  let to: Int = this.charByteOffset(index: start + count)
  if from >= to {
    ret ""
  }
  ret this.sub(start: from, len: to - from)
}

func contains(this: view String, sub: view String) ret Bool {
  ret this.indexOf(sub: sub) is not -1
}

func startsWith(this: view String, prefix: view String) ret Bool {
  let prefixLength: Int = prefix.length()
  if prefixLength is 0 {
    ret true
  }
  if prefixLength > this.length() {
    ret false
  }
  unsafe {
    ret rae_ext_rae_str_compare_bytes(
      a: this
      aStart: 0
      b: prefix
      bStart: 0
      count: prefixLength
    ) is 0
  }
}

func endsWith(this: view String, suffix: view String) ret Bool {
  let suffixLength: Int = suffix.length()
  if suffixLength is 0 {
    ret true
  }
  let length: Int = this.length()
  if suffixLength > length {
    ret false
  }
  unsafe {
    ret rae_ext_rae_str_compare_bytes(
      a: this
      aStart: length - suffixLength
      b: suffix
      bStart: 0
      count: suffixLength
    ) is 0
  }
}

# The byte index of the first occurrence of `sub`, or -1; 0 for an empty
# `sub`. Jumps between occurrences of `sub`'s first byte (memchr) and
# compares the rest there (memcmp): no allocation.
func indexOf(this: view String, sub: view String) ret Int {
  let needleLength: Int = sub.length()
  if needleLength is 0 {
    ret 0
  }
  let lastStart: Int = this.length() - needleLength
  if lastStart < 0 {
    ret -1
  }
  let first: Int = sub.byteAt(index: 0)
  unsafe {
    var position: Int = rae_ext_rae_str_find_byte(s: this, value: first, from: 0)
    loop position >= 0 and position <= lastStart {
      if rae_ext_rae_str_compare_bytes(
        a: this
        aStart: position
        b: sub
        bStart: 0
        count: needleLength
      ) is 0 {
        ret position
      }
      position = rae_ext_rae_str_find_byte(s: this, value: first, from: position + 1)
    }
  }
  ret -1
}

# The byte index of the last occurrence of `sub`, or -1 (also -1 for an
# empty `sub`). Scans back from the end; no allocation.
func lastIndexOf(this: view String, sub: view String) ret Int {
  let needleLength: Int = sub.length()
  if needleLength is 0 {
    ret -1
  }
  let first: Int = sub.byteAt(index: 0)
  var position: Int = this.length() - needleLength
  unsafe {
    loop position >= 0 {
      if this.byteAt(index: position) is first and rae_ext_rae_str_compare_bytes(
        a: this
        aStart: position
        b: sub
        bStart: 0
        count: needleLength
      ) is 0 {
        ret position
      }
      position = position - 1
    }
  }
  ret -1
}

func lowerAsciiByte(ch: view String) ret String {
  let c: Char32 = ch.at(index: 0)
  if c is 'A' {
    ret "a"
  }
  if c is 'B' {
    ret "b"
  }
  if c is 'C' {
    ret "c"
  }
  if c is 'D' {
    ret "d"
  }
  if c is 'E' {
    ret "e"
  }
  if c is 'F' {
    ret "f"
  }
  if c is 'G' {
    ret "g"
  }
  if c is 'H' {
    ret "h"
  }
  if c is 'I' {
    ret "i"
  }
  if c is 'J' {
    ret "j"
  }
  if c is 'K' {
    ret "k"
  }
  if c is 'L' {
    ret "l"
  }
  if c is 'M' {
    ret "m"
  }
  if c is 'N' {
    ret "n"
  }
  if c is 'O' {
    ret "o"
  }
  if c is 'P' {
    ret "p"
  }
  if c is 'Q' {
    ret "q"
  }
  if c is 'R' {
    ret "r"
  }
  if c is 'S' {
    ret "s"
  }
  if c is 'T' {
    ret "t"
  }
  if c is 'U' {
    ret "u"
  }
  if c is 'V' {
    ret "v"
  }
  if c is 'W' {
    ret "w"
  }
  if c is 'X' {
    ret "x"
  }
  if c is 'Y' {
    ret "y"
  }
  if c is 'Z' {
    ret "z"
  }
  ret "{ch}"
}

# ASCII lowercase conversion. Non-ASCII bytes pass through unchanged.
func toLower(this: view String) ret String {
  var out: String = ""
  var i: Int = 0
  let n: Int = this.length()
  loop i < n {
    # `sub` hands back the WHOLE character the byte belongs to, so step by
    # its byte length — a multi-byte character is copied through once.
    let ch: String = this.sub(start: i, len: 1)
    out = out.concat(other: String.lowerAsciiByte(ch: ch))
    i = i + ch.length()
  }
  ret out
}

func trim(this: view String) ret String {
  let n: Int = this.length()
  if n is 0 {
    ret ""
  }

  var start: Int = 0
  loop start < n and Char.isWhitespace(this: this.at(index: start)) {
    start = start + 1
  }
  if start is n {
    ret ""
  }

  var end: Int = n - 1
  loop end > start and Char.isWhitespace(this: this.at(index: end)) {
    end = end - 1
  }
  ret this.sub(start: start, len: end - start + 1)
}

func split(this: view String, sep: view String) ret List(String) {
  var result: List(String) = List.create(String, cap: 4)
  if sep.length() is 0 {
    # A COPY, not the borrow. `result` is returned and eventually dropped,
    # and dropping it would free the caller's buffer — `this` is a view we
    # do not own. Caught by the own-argument check once the stdlib stopped
    # being exempt from it.
    result.add(value: "{this}")
    ret result
  }
  var remaining: String = this
  loop true {
    let idx: Int = remaining.indexOf(sub: sep)
    if idx is -1 {
      result.add(value: remaining)
      ret result
    }
    let part: String = remaining.sub(start: 0, len: idx)
    result.add(value: part)
    remaining = remaining.sub(
      start: idx + sep.length()
      len: remaining.length() - idx - sep.length()
    )
  }
  ret result
}

# Always returns a FRESH owned String — never `this` or anything
# aliasing it (#203). Returning the view param or a split element
# hands the caller a buffer whose ownership stays elsewhere; in a
# `r = r.replace(...)` chain the reassignment's drop-then-store then
# frees or leaks the very bytes the caller keeps reading.
func replace(this: view String, old: view String, new: view String) ret String {
  if old.length() is 0 {
    # Fresh copy, not `ret this` — don't rely on codegen inserting a
    # deep copy for view-param returns.
    ret "{this}"
  }
  let parts: List(String) = this.split(sep: old)
  ret parts.join(sep: new)
}

func join(this: view List(String), sep: view String) ret String {
  if this.length is 0 {
    ret ""
  }
  # Accumulate from "" instead of binding element 0 directly (#203):
  # `var result = get(this, index: 0)` borrow-binds the element, and
  # a single-element list then RETURNS that borrow — the caller gets
  # a buffer it doesn't own (dangling or leaked depending on how the
  # opt-unwrap codegen treats the element). `replace` hit exactly
  # this through its no-match split ([whole string] -> join).
  # "".concat(elem) always allocates a private heap for the result.
  var result: String = ""
  if let head: String = copyAt(this, index: 0) {
    result = result.concat(other: head)
  }
  var i: Int = 1
  loop i < this.length {
    if let element: String = copyAt(this, index: i) {
      result = result.concat(other: sep).concat(other: element)
    }
    i = i + 1
  }
  ret result
}

func toFloat(this: view String) ret Float {
  unsafe {
    ret rae_str_to_f64(s: this)
  }
}

# The smallest Int (-2^63), spelled as arithmetic because its magnitude has
# no positive Int
const smallestInt: Int = -9223372036854775807 - 1

# A decimal integer at the start of the String, like C's strtoll: leading
# spaces, tabs and line breaks are skipped, then an optional sign, then digits
# up to the first non-digit. No digits gives 0; a value out of Int's range
# clamps to the nearest end.
func toInt(this: view String) ret Int {
  let length: Int = this.length()
  var i: Int = 0
  loop i < length {
    let space: Int = this.byteAt(index: i)
    if space is 32 or (space >= 9 and space <= 13) {
      i = i + 1
    } else {
      break
    }
  }
  var negative: Bool = false
  if i < length {
    let sign: Int = this.byteAt(index: i)
    if sign is 45 {
      negative = true
      i = i + 1
    } else if sign is 43 {
      i = i + 1
    }
  }
  # Accumulated as a NEGATIVE number, so the smallest Int is reachable
  var value: Int = 0
  var clamped: Bool = false
  loop i < length {
    let digit: Int = this.byteAt(index: i) - 48
    if digit < 0 or digit > 9 {
      break
    }
    if value < (smallestInt + digit) / 10 {
      clamped = true
      break
    }
    value = value * 10 - digit
    i = i + 1
  }
  if negative {
    if clamped {
      ret smallestInt
    }
    ret value
  }
  if clamped or value is smallestInt {
    ret 9223372036854775807
  }
  ret -value
}
