# A frame's time by system, for the physics examples' performance pass
# (docs/physics-performance-plan.md §10). Off unless the app turns it on
# (the playground's RAE_PLAYGROUND_PROFILE=<frames>); then the frame loop marks
# a lap after each system, and after `frameLimit` frames one report gives each
# system's average and worst milliseconds per frame. A lap is one nowNs()
# call, so the profile does not change what it measures. The first
# `warmupFrames` frames (startup, the first uploads) are not counted.
import Math
open RendererDeferred
open RendererPassTiming

const warmupFrames: Int = 120

# A system taking longer than this in one frame is logged as a spike (a
# hitch; present is left out, it waits for the GPU and the display)
const spikeNs: Int = 8000000

# The systems a frame is split into, in frame order
const profileInput: Int = 0

const profileShots: Int = 1

const profileCharacter: Int = 2

const profilePush: Int = 3

const profileWorldStep: Int = 4

const profilePull: Int = 5

const profileEvents: Int = 6

const profileCopyPrevious: Int = 7

const profileInterpolate: Int = 8

const profileHud: Int = 9

const profileBatches: Int = 10

const profileShadowQueue: Int = 11

const profileGbuffer: Int = 12

const profileLightingPasses: Int = 13

const profileUiOverlay: Int = 14

const profilePresent: Int = 15

const profileFrameEnd: Int = 16

const profileSectionCount: Int = 17

func profileSectionName(section: view Int) ret String {
  if section is profileInput {
    ret "input, camera"
  }
  if section is profileShots {
    ret "spawn and despawn balls"
  }
  if section is profileCharacter {
    ret "character system"
  }
  if section is profilePush {
    ret "physics push (ECS -> world)"
  }
  if section is profileWorldStep {
    ret "physics world step"
  }
  if section is profilePull {
    ret "physics pull (world -> ECS)"
  }
  if section is profileEvents {
    ret "physics events"
  }
  if section is profileCopyPrevious {
    ret "keep previous poses"
  }
  if section is profileInterpolate {
    ret "interpolate poses"
  }
  if section is profileHud {
    ret "HUD"
  }
  if section is profileBatches {
    ret "instance batches"
  }
  if section is profileShadowQueue {
    ret "shadow casters (cull, queue)"
  }
  if section is profileGbuffer {
    ret "gbuffer (instance upload, draw)"
  }
  if section is profileLightingPasses {
    ret "deferred passes"
  }
  if section is profileUiOverlay {
    ret "UI overlay"
  }
  if section is profilePresent {
    ret "present (end frame)"
  }
  ret "frame end, poll, wait"
}

type FrameProfile {
  enabled: Bool
  frameLimit: Int
  warmupLeft: Int
  frames: Int
  steps: Int
  frameSteps: Int
  # Per section: this frame's, the run's total and the worst frame's ns
  frameNs: List(Int)
  totalNs: List(Int)
  maxNs: List(Int)
  # The worst whole frame, and the time the last lap ended
  maxFrameNs: Int
  frameStartNs: Int
  markNs: Int
  reported: Bool
  # GPU time per graph pass (RAE_GPU_PASS_TIMING=1, RendererPassTiming): the
  # renderer's samples taken after warm-up, summed per pass, with the worst
  gpuSamplesSeen: Int
  gpuSamples: Int
  gpuTags: List(Int)
  gpuTotalUs: List(Int)
  gpuMaxUs: List(Int)
}

# A profile of `frameLimit` frames; 0 is off.
func createFrameProfile(frameLimit: view Int) ret FrameProfile {
  var profile: FrameProfile = {
    enabled: frameLimit > 0
    frameLimit: frameLimit
    warmupLeft: warmupFrames
    frames: 0
    steps: 0
    frameSteps: 0
    frameNs: List.create(Int, cap: profileSectionCount)
    totalNs: List.create(Int, cap: profileSectionCount)
    maxNs: List.create(Int, cap: profileSectionCount)
    maxFrameNs: 0
    frameStartNs: 0
    markNs: 0
    reported: false
    gpuSamplesSeen: 0
    gpuSamples: 0
    gpuTags: List.create(Int, cap: 16)
    gpuTotalUs: List.create(Int, cap: 16)
    gpuMaxUs: List.create(Int, cap: 16)
  }
  loop var i: Int = 0, i < profileSectionCount, ++i {
    profile.frameNs.add(value: 0)
    profile.totalNs.add(value: 0)
    profile.maxNs.add(value: 0)
  }
  ret profile
}

# Start timing a frame. The time since the last frame's end (the window
# poll at the top of the loop) goes to the frame's first lap.
func profileFrameStart(profile: mod FrameProfile) {
  if profile.enabled {
    if profile.markNs is 0 {
      profile.markNs = nowNs()
    }
    profile.frameStartNs = profile.markNs
  }
}

# The time since the last lap belongs to `section`.
func profileLap(profile: mod FrameProfile, section: view Int) {
  if profile.enabled is false {
    ret
  }
  let now: Int = nowNs()
  profile.frameNs.set(
    index: section
    value: profile.frameNs.copyAtDefault(index: section) + now - profile.markNs
  )
  profile.markNs = now
}

# Take in the renderer's newest GPU pass sample, if there is one since the
# last call (after warm-up only).
func profileGpuPasses(profile: mod FrameProfile, passTiming: view DeferredPassTiming) {
  if profile.enabled is false or passTiming.samples is profile.gpuSamplesSeen {
    ret
  }
  profile.gpuSamplesSeen = passTiming.samples
  if profile.warmupLeft > 0 or profile.reported {
    ret
  }
  if profile.gpuTags.length is 0 {
    loop var i: Int = 0, i < passTiming.lastTags.length, ++i {
      profile.gpuTags.add(value: passTiming.lastTags.copyAtDefault(index: i))
      profile.gpuTotalUs.add(value: 0)
      profile.gpuMaxUs.add(value: 0)
    }
  }
  if passTiming.lastTags.length is not profile.gpuTags.length {
    ret
  }
  loop var i: Int = 0, i < profile.gpuTags.length, ++i {
    let microseconds: Int = passTiming.lastMicroseconds.copyAtDefault(index: i)
    profile.gpuTotalUs.set(
      index: i
      value: profile.gpuTotalUs.copyAtDefault(index: i) + microseconds
    )
    if microseconds > profile.gpuMaxUs.copyAtDefault(index: i) {
      profile.gpuMaxUs.set(index: i, value: microseconds)
    }
  }
  profile.gpuSamples = profile.gpuSamples + 1
}

func usToMs(microseconds: view Int) ret Float {
  ret Math.round(x: (microseconds as Float) / 10.0) / 100.0
}

# The GPU part of the report: ms per sampled frame, average and worst.
func reportGpuPasses(profile: view FrameProfile) {
  if profile.gpuSamples is 0 {
    ret
  }
  log("[profile] GPU per pass, {profile.gpuSamples} sampled frames; ms: average, worst")
  var sum: Int = 0
  loop var i: Int = 0, i < profile.gpuTags.length, ++i {
    let total: Int = profile.gpuTotalUs.copyAtDefault(index: i)
    sum = sum + total
    log(
      "[profile] GPU {renderTagName(tag: profile.gpuTags.copyAtDefault(index: i))}: {usToMs(
        microseconds: total / profile.gpuSamples
      )}, {usToMs(microseconds: profile.gpuMaxUs.copyAtDefault(index: i))}"
    )
  }
  log("[profile] GPU whole frame: {usToMs(microseconds: sum / profile.gpuSamples)}")
}

func profileSteps(profile: mod FrameProfile, steps: view Int) {
  profile.steps = profile.steps + steps
  profile.frameSteps = profile.frameSteps + steps
}

func nsToMs(ns: view Int) ret Float {
  ret Math.round(x: (ns as Float) / 10000.0) / 100.0
}

# Close the frame (its last lap is `section`); after `frameLimit` frames, log
# the report once. True when the report was just logged.
func profileFrameEnd(profile: mod FrameProfile, section: view Int) ret Bool {
  if profile.enabled is false or profile.reported {
    ret false
  }
  profileLap(profile: profile, section: section)
  if profile.warmupLeft > 0 {
    profile.warmupLeft = profile.warmupLeft - 1
    profile.steps = 0
    profile.frameSteps = 0
    loop var i: Int = 0, i < profileSectionCount, ++i {
      profile.frameNs.set(index: i, value: 0)
    }
    ret false
  }
  loop var i: Int = 0, i < profileSectionCount, ++i {
    let ns: Int = profile.frameNs.copyAtDefault(index: i)
    if ns > spikeNs and i is not profilePresent {
      log(
        "[profile] spike: frame {profile.frames} ({profile.frameSteps} steps), {profileSectionName(
          section: i
        )} {nsToMs(ns: ns)} ms"
      )
    }
    profile.totalNs.set(index: i, value: profile.totalNs.copyAtDefault(index: i) + ns)
    if ns > profile.maxNs.copyAtDefault(index: i) {
      profile.maxNs.set(index: i, value: ns)
    }
    profile.frameNs.set(index: i, value: 0)
  }
  profile.frameSteps = 0
  let frameNs: Int = profile.markNs - profile.frameStartNs
  if frameNs > profile.maxFrameNs {
    profile.maxFrameNs = frameNs
  }
  profile.frames = profile.frames + 1
  if profile.frames < profile.frameLimit {
    ret false
  }
  profile.reported = true
  var sum: Int = 0
  log(
    "[profile] {profile.frames} frames, {profile.steps} physics steps; ms per frame: average, worst"
  )
  loop var i: Int = 0, i < profileSectionCount, ++i {
    let total: Int = profile.totalNs.copyAtDefault(index: i)
    sum = sum + total
    log(
      "[profile] {profileSectionName(section: i)}: {nsToMs(ns: total / profile.frames)}, {nsToMs(
        ns: profile.maxNs.copyAtDefault(index: i)
      )}"
    )
  }
  log("[profile] whole frame: {nsToMs(ns: sum / profile.frames)}, {nsToMs(ns: profile.maxFrameNs)}")
  reportGpuPasses(profile: profile)
  ret true
}
