# SkyClouds — the sky's clouds as the light uniform carries them to the sky
# shader (LightU clouds and cloudShape, lib/deferred_uniforms.wgsl; drawn by
# skyClouds in lib/sky_hosek.wgsl): the cloud layer's interface
# (docs/cloud-rendering-research.md §8.2), from a Sky's cloud fields, which
# the app sets from lib/Weather.
open Sky
open CloudTier
open gpu/GpuArgs

type SkyClouds {
  # how much of the sky they cover (0 .. 1), how dark (0 white .. 1 the
  # gray of a storm), how far they drifted (noise units)
  cover: Float = 0.0
  darkness: Float = 0.0
  drift: Float = 0.0
  # their kind (0 stratus .. 1 cumulus), the high cirrus (0 .. 1), the
  # base's height (m) and the shapes' size (1: the kind's own)
  cloudType: Float = 0.6
  cirrus: Float = 0.0
  height: Float = 1200.0
  scale: Float = 1.0
  # the cloud tier (lib/CloudTier rank: 0 off, 1 layer, 2 slab, 3 volumetric)
  tier: Int = 1
  # their shadows on the ground (off: the sun dimmed evenly by the cover)
  shadows: Bool = true
  # the shadows' shapes' size apart from the clouds' (1: as the clouds)
  shadowScale: Float = 1.0
}

# The clouds `sky` asks for
func skyCloudsOf(sky: view Sky) ret SkyClouds {
  ret SkyClouds {
    cover: sky.cloudCover
    darkness: sky.cloudDarkness
    drift: sky.cloudDrift
    cloudType: sky.cloudType
    cirrus: sky.cloudCirrus
    height: sky.cloudHeight
    scale: sky.cloudScale
    tier: cloudTierRank(tier: sky.cloudTier)
    shadows: sky.cloudShadows
    shadowScale: sky.cloudShadowScale
  }
}

# Write `clouds` as the uniform's three vec4s (the third: cloudOptions, x
# the shadows on, y their scale): clouds (cover, darkness, drift,
# tier)
# and cloudShape (kind, cirrus, height, scale)
func pushSkyClouds(writer: mod ArgWriter, clouds: view SkyClouds) {
  pushVec4F(
    writer: writer
    x: clouds.cover
    y: clouds.darkness
    z: clouds.drift
    w: clouds.tier.toFloat()
  )
  pushVec4F(
    writer: writer
    x: clouds.cloudType
    y: clouds.cirrus
    z: clouds.height
    w: clouds.scale
  )
  var shadowsOn: Float = 0.0
  if clouds.shadows {
    shadowsOn = 1.0
  }
  pushVec4F(
    writer: writer
    x: shadowsOn
    y: clouds.shadowScale
    z: 0.0
    w: 0.0
  )
}
