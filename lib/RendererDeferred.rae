# renderer_deferred — the deferred frame, declared as a render graph.
#
# Track B (#356). This is NOT a port of the forward prototype in
# renderer3d.rae. That one computes lighting inside each material's
# fragment shader, so shading cost scales with (objects x lights) and every
# lit pixel is shaded whether or not it survives depth. The deferred frame
# separates the two: the G-buffer pass writes surface attributes once per
# visible pixel, and lighting reads them once per pixel regardless of how
# many objects contributed.
#
# The frame is:
#
#   gbuffer -> depthPyramid -> lighting -> composite -> present
#
# but that order is NEVER written down. Passes are declared deliberately
# out of order below and the sequence is DERIVED from which resources each
# one reads and writes — the same property 553 pins for the forward frame.
# Getting this wrong is a class of bug that otherwise shows up as a subtly
# wrong image rather than an error.
#
# WHY THE DEPTH PYRAMID IS IN THE SLICE. It is not decoration: a mip chain
# of depth is what Hi-Z occlusion culling and SSAO's coarse steps both
# read, and the reference engine shares one pyramid between them rather
# than building two. Declaring it now means the slice's dependency edges
# are the real ones, so when culling arrives it slots in rather than
# reshaping the frame.
#
# ALLOCATION-FREE PER OBJECT is the acceptance criterion (#356), which is
# why transforms flow through the #354 value types: a Mat4 is 16 floats by
# value and modelMatrix no longer allocates, so a frame's per-object data
# path touches the allocator zero times.
import Gpu2d
open Rendergraph
open Math3d
open Scene3d
open Gbuffer
open GbufferWorld
open GbufferInspector
open GbufferPasses
open TransparentForward
open Sky

# ----- pass tags ------------------------------------------------------
# Which pass of the deferred frame this is. An enum (not Int consts) so the
# render-graph walk can `match` on it exhaustively — adding a pass then forces
# every walker to handle it. The enum namespaces the names too, so there is no
# longer a clash with renderer3d's forward tags (the old `…D` suffix's job).
enum RenderTag {
  gbuffer       # writes surface attributes, no lighting
  depthPyramid  # mip chain of depth, for Hi-Z + SSAO
  ssao          # screen-space AO from G-buffer depth+normal (#387)
  lighting      # reads the G-buffer, writes radiance
  composite     # radiance -> the frame's colour target
  present       # resolve/present
  uiOverlay     # load-preserving 2D UI painted over the composited frame (#389)
  taa           # temporal resolve (#390); HDR in, HDR out
  shadow        # sun cascade depth (#382); lighting reads it
  transparentForward # snapshots opaque radiance before transparent draws
}

type DeferredRenderer {
  graph: RenderGraph
  gbufferPass: Int
  pyramidPass: Int
  lightingPass: Int
  compositePass: Int
  presentPass: Int
  uiPass: Int       # -1 when the frame has no UI overlay
  hasUi: Bool
  # Which channel the composite paints. `viewLit` is the real frame; the
  # others are the G-buffer inspector (lib/gbuffer.rae), which is permanent
  # equipment in a deferred renderer rather than temporary scaffolding.
  debugView: Int
  # The bound environment (#399). A scene that never sets one keeps the
  # authored hemisphere and the clear-colour background, so binding a sky
  # is opt-in rather than a silent change to every existing example.
  sky: Sky
  hasSky: Bool
  # The look applied by the composite pass (#556). Defaults to neutralGrade(),
  # which is exactly the historical ACES-plus-gamma result -- opting in is the
  # app's call, so this library cannot silently restyle an example that was
  # calibrated against the old operator.
  grade: ColorGrade
  # #764: the deferred pass caches (pipeline/bind "made" flags + target
  # generations) were module-level globals in gbuffer_passes / gbufferInspector.
  # The renderer owns them now; renderDeferredPassWorld threads each pass its cache.
  passes: RenderPasses
}

# The Rae-side deferred-pass caches, aggregated. Fields hold each pass's "have I
# built the pipeline/bind, and at which target generation" state — one struct so
# a DeferredRenderer carries all of it.
type RenderPasses {
  composite: CompositePassCache
  ao: AoPassCache
  light: LightPassCache
  taa: TaaPassCache
  pyr: PyrPassCache
  inspect: ViewPassCache
  gbuffer: GbufferCache
}

func createRenderPasses() ret RenderPasses {
  ret RenderPasses {
    composite: { pipeMade: false, bindGen: 0 - 1, bindMade: createList(Bool, cap: 3), uniform: createList(Float, cap: 16) },
    ao: { pipeMade: false, bindGen: 0 - 1, bindMade: false },
    light: { bindGen: 0 - 1, bindMade: false },
    taa: { bindGen: 0 - 1, bindMade: createList(Bool, cap: 2) },
    pyr: { bindGen: 0 - 1 },
    inspect: { pipeMade: false, bindMade: false, lastTargetsGen: 0 - 1, uniform: createList(Float, cap: 4) },
    gbuffer: createGbufferCache()
  }
}

# Declare the deferred frame. Pass declaration order here is deliberately
# scrambled — present first, gbuffer last — so that a regression to
# insertion order is visible immediately in the derived sequence.
# ONE builder, parameterised. renderer3d.rae has two near-identical copies
# of its graph (with and without the UI overlay) and they have to be kept
# in step by hand; this does not repeat that.
func buildDeferredGraph(withUi: view Bool) ret DeferredRenderer {
  var renderGraph: RenderGraph = createRenderGraph()

  # --- resources ---
  # sceneColor is External: the target gpu2d owns and presents.
  let colorId: Int = addResource(renderGraph: renderGraph, name: "sceneColor", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeExternal)

  # The G-buffer (#366). Three attachments plus depth, 16 bytes/pixel, with
  # attributes packed ACROSS the targets rather than one per target: A holds
  # the octahedral normal and a shading mode, B albedo and roughness, C
  # motion, metallic and occlusion-or-emissive. Named A/B/C rather than by
  # content precisely because no target holds one thing — a name like
  # "gNormal" would be a lie about where roughness lives.
  let albedoId: Int = addResource(renderGraph: renderGraph, name: "gbufferA", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let normalId: Int = addResource(renderGraph: renderGraph, name: "gbufferB", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let materialId: Int = addResource(renderGraph: renderGraph, name: "gbufferC", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let depthId: Int = addResource(renderGraph: renderGraph, name: "gDepth", kind: resDepth, format: 0, sizing: sizeFull, lifetime: lifeTransient)

  # Hi-Z / coarse-trace source. Half-res because the top mip is gDepth
  # itself; this is the chain below it.
  let pyramidId: Int = addResource(renderGraph: renderGraph, name: "depthPyramid", kind: resTexture2d, format: 0, sizing: sizeHalf, lifetime: lifeTransient)

  # Linear HDR radiance. Everything radiometric happens here; only
  # composite writes the presentable target.
  let litId: Int = addResource(renderGraph: renderGraph, name: "litColor", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let litCopyId: Int = addResource(renderGraph: renderGraph, name: "litCopy", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  # AO is full-resolution for now. It is low-frequency and belongs at half
  # res with a depth-aware upsample, which is a tier knob rather than a
  # correctness question — declared truthfully as Full until it moves.
  let aoId: Int = addResource(renderGraph: renderGraph, name: "aoTex", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  # PERSISTENT, not transient: the history is read NEXT frame, which is
  # the lifetime class #331 put in graph v1 so temporal techniques could
  # be declared truthfully instead of hidden in C statics.
  let taaId: Int = addResource(renderGraph: renderGraph, name: "taaColor", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifePersistent)
  let shadowId: Int = addResource(renderGraph: renderGraph, name: "shadowMap", kind: resDepth, format: 0, sizing: sizeFull, lifetime: lifeTransient)

  # --- passes, declared backwards on purpose ---
  let present: Int = addPass(renderGraph: renderGraph, name: "present", kind: passRaster, tag: RenderTag.present)
  let composite: Int = addPass(renderGraph: renderGraph, name: "composite", kind: passRaster, tag: RenderTag.composite)
  let lighting: Int = addPass(renderGraph: renderGraph, name: "lighting", kind: passRaster, tag: RenderTag.lighting)
  let transparent: Int = addPass(renderGraph: renderGraph, name: "transparentForward", kind: passRaster, tag: RenderTag.transparentForward)
  let ssaoP: Int = addPass(renderGraph: renderGraph, name: "ssao", kind: passRaster, tag: RenderTag.ssao)
  let taaP: Int = addPass(renderGraph: renderGraph, name: "taa", kind: passRaster, tag: RenderTag.taa)
  let shadowP: Int = addPass(renderGraph: renderGraph, name: "shadow", kind: passRaster, tag: RenderTag.shadow)
  let pyramid: Int = addPass(renderGraph: renderGraph, name: "depthPyramid", kind: passCompute, tag: RenderTag.depthPyramid)
  let gbuffer: Int = addPass(renderGraph: renderGraph, name: "gbuffer", kind: passRaster, tag: RenderTag.gbuffer)

  # --- edges: these, and only these, determine the order ---
  passWrites(renderGraph: renderGraph, pass: gbuffer, resource: albedoId, access: accAttachmentWrite)
  passWrites(renderGraph: renderGraph, pass: gbuffer, resource: normalId, access: accAttachmentWrite)
  passWrites(renderGraph: renderGraph, pass: gbuffer, resource: materialId, access: accAttachmentWrite)
  passWrites(renderGraph: renderGraph, pass: gbuffer, resource: depthId, access: accAttachmentWrite)

  # The pyramid is built from finished depth, so it must follow gbuffer.
  passReads(renderGraph: renderGraph, pass: pyramid, resource: depthId, access: accSampledRead)
  passWrites(renderGraph: renderGraph, pass: pyramid, resource: pyramidId, access: accStorageWrite)

  # Lighting consumes every G-buffer attachment plus the pyramid, and is
  # the only writer of radiance.
  # SSAO reads what the G-buffer wrote and lighting reads the AO, so the
  # graph derives gbuffer -> ssao -> lighting with nobody stating it.
  passReads(renderGraph: renderGraph, pass: ssaoP, resource: normalId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: ssaoP, resource: depthId, access: accSampledRead)
  passWrites(renderGraph: renderGraph, pass: ssaoP, resource: aoId, access: accAttachmentWrite)
  # Lighting reads the cascades, so the graph orders shadow before it —
  # and, since shadow has no other edges, before the G-buffer too, which
  # is fine: the cascades depend on the scene, not on the G-buffer.
  passWrites(renderGraph: renderGraph, pass: shadowP, resource: shadowId, access: accAttachmentWrite)
  passReads(renderGraph: renderGraph, pass: lighting, resource: shadowId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: lighting, resource: aoId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: lighting, resource: albedoId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: lighting, resource: normalId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: lighting, resource: materialId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: lighting, resource: depthId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: lighting, resource: pyramidId, access: accStorageRead)
  passWrites(renderGraph: renderGraph, pass: lighting, resource: litId, access: accAttachmentWrite)

  # Snapshot opaque radiance before any transparent draw modifies it.
  # passModifies orders all later radiance readers after this pass.
  passReads(renderGraph: renderGraph, pass: transparent, resource: depthId, access: accSampledRead)
  passModifies(renderGraph: renderGraph, pass: transparent, resource: litId, access: accAttachmentRead)
  passWrites(renderGraph: renderGraph, pass: transparent, resource: litCopyId, access: accAttachmentWrite)

  # TAA reads radiance and the motion the G-buffer packed, and writes the
  # history the composite then reads — so the graph derives
  # lighting -> transparentForward -> taa -> composite.
  passReads(renderGraph: renderGraph, pass: taaP, resource: litId, access: accSampledRead)
  passReads(renderGraph: renderGraph, pass: taaP, resource: materialId, access: accSampledRead)
  passWrites(renderGraph: renderGraph, pass: taaP, resource: taaId, access: accAttachmentWrite)

  # Composite is the only writer of the presentable target.
  passReads(renderGraph: renderGraph, pass: composite, resource: taaId, access: accSampledRead)
  passWrites(renderGraph: renderGraph, pass: composite, resource: colorId, access: accAttachmentWrite)

  # The UI overlay MODIFIES the composited target rather than writing it:
  # it loads the finished 3D image and paints over it. Declaring that as a
  # second write would be rejected as two writers; declaring it as a plain
  # read would not order it after composite. `passModifies` is the only
  # honest statement, and the graph derives composite -> ui -> present.
  var ui: Int = 0 - 1
  if withUi {
    ui = addPass(renderGraph: renderGraph, name: "uiOverlay", kind: passRaster, tag: RenderTag.uiOverlay)
    passModifies(renderGraph: renderGraph, pass: ui, resource: colorId, access: accAttachmentRead)
  }

  passReads(renderGraph: renderGraph, pass: present, resource: colorId, access: accSampledRead)

  ret DeferredRenderer {
    graph: renderGraph,
    gbufferPass: gbuffer,
    pyramidPass: pyramid,
    lightingPass: lighting,
    compositePass: composite,
    presentPass: present,
    uiPass: ui,
    hasUi: withUi,
    debugView: viewLit
    sky: createSkyNone(light: defaultLight3d(), clearColor: vec3.create(x: 0.02, y: 0.02, z: 0.03))
    hasSky: false
    grade: neutralGrade()
    passes: createRenderPasses()
  }
}

# See the note on renderer3d.rae's version: same name, so migrating an
# example flips the word with no edit at the call site.
func rendererPathName() pub ret String {
  ret "deferred"
}

func createDeferredRenderer() pub ret DeferredRenderer {
  ret buildDeferredGraph(withUi: false)
}

# Deferred frame with a load-preserving 2D UI overlay between composite
# and present (#389). Examples 110 and 113 both need this before they can
# leave the forward path.
func createDeferredRendererWithUi() pub ret DeferredRenderer {
  ret buildDeferredGraph(withUi: true)
}

# Choose which channel the composite pass paints (see gbuffer.view*).
func setDebugView(renderer: mod DeferredRenderer, mode: view Int) pub {
  renderer.debugView = mode
}

# TAA on/off (#20). DEFAULT IS OFF = FXAA: the composite paints the raw lit
# result through FXAA, the taa pass is a no-op and the G-buffer jitter is
# suppressed. TAA is opt-in (the shared settings pane has a toggle) because the
# current resolve blurs/ghosts on detailed top-down terrain and crowd motion;
# its quality fixes are POSTPONED queue tasks.
func setTaaEnabled(on: copy Bool) pub {
  if on { gbSetTaaEnabled(on: 1) } else { gbSetTaaEnabled(on: 0) }
}

# Distance fog (#57, per-app). Fades geometry to `color` (LINEAR HDR — the same
# space the lit radiance and sky background live in) over [start,end] world
# units from the camera, and paints that colour as the background so a far
# ground/sea plane dissolves into the horizon with no far-clip seam. Off by
# default; every deferred example that never calls this keeps its sky.
func setFog(color: copy Vec3, start: copy Float, end: copy Float) pub {
  gbSetFog(on: 1, renderer: color.x, renderGraph: color.y, b: color.z, start: start, end: end)
}

func setFogDisabled() pub {
  gbSetFog(on: 0, renderer: 0.0, renderGraph: 0.0, b: 0.0, start: 0.0, end: 0.0)
}

func compileDeferred(renderer: mod DeferredRenderer) pub ret Int {
  ret compile(renderGraph: renderer.graph)
}

func describeDeferred(renderer: view DeferredRenderer) pub ret String {
  ret describe(renderGraph: renderer.graph)
}

# Execute one deferred frame.
#
# The loop walks `r.graph.order` — the sequence the graph DERIVED from the
# resource edges — and switches on the pass tag. There is no written
# ordering here to disagree with the declaration: adding an edge in
# createDeferredRenderer changes what runs when, and this function does not
# need editing for that to take effect. Rae has no first-class function
# references, so dispatch is a tag switch, the same pattern renderer3d and
# lib/ui/registry.rae use; the graph never inspects a tag, so that
# constraint stays out of it.

# ----- app-driven dispatch (#389) -------------------------------------
# A UI overlay needs lib/ui types, and a renderer must not depend on the
# UI layer. So an app that has a UI walks the DERIVED order itself and
# dispatches every non-UI tag through the helper below — order still comes
# from the graph; only the switch moves to where the UI knowledge is.
# Same seam renderer3d.rae opened for the forward frame.

func deferredOrderLength(renderer: view DeferredRenderer) pub ret Int {
  ret renderer.graph.order.length
}

func deferredTagAt(renderer: view DeferredRenderer, i: view Int) pub ret Int {
  let p: Int = graphIntAt(values: renderer.graph.order, index: i)
  ret graphPassAt(values: renderer.graph.passes, index: p).tag
}

# Run one pass of the deferred frame from a World3d. Handles every tag EXCEPT the
# UI overlay, which the caller owns (PRESENT differs with a UI: Gpu2d.endFrame
# presents, so the renderer must not present again). The G-buffer pass fills from
# the World3d ECS queries (renderSceneWorld + renderSceneSdfWorld); every other tag
# is scene-independent — it reads G-buffer/depth resources the gbuffer pass already
# wrote — so those tags ignore the world.
func renderDeferredPassWorld(renderer: mod DeferredRenderer, tag: view Int, world: view World3d,
                             camera: view Camera3d, light: view Light3d, aspect: view Float) pub {
  if tag is RenderTag.gbuffer {
    beginPass(cache: renderer.passes.gbuffer, camera: camera, light: light, aspect: aspect)
    GbufferWorld.renderSceneWorld(cache: renderer.passes.gbuffer, world: world)
    # Metaballs go into the SAME pass as the triangles, so the two kinds
    # depth-test against each other rather than compositing (#392).
    renderSceneSdfWorld(world: world, camera: camera)
    endPass()
  }
  if tag is RenderTag.depthPyramid {
    buildDepthPyramid(cache: renderer.passes.pyr)
  }
  if tag is RenderTag.ssao {
    ssaoPass(cache: renderer.passes.ao, camera: camera)
  }
  if tag is RenderTag.lighting {
    var sky: Sky = createSkyNone(light: light, clearColor: light.clearColor)
    if renderer.hasSky {
      sky = renderer.sky
    }
    lightingPassSky(cache: renderer.passes.light, camera: camera, light: light, sky: sky)
  }
  if tag is RenderTag.taa {
    taaPass(cache: renderer.passes.taa)
  }
  if tag is RenderTag.transparentForward {
    copyOpaqueRadiance()
  }
  if tag is RenderTag.composite {
    if renderer.debugView is viewLit {
      compositePassGraded(cache: renderer.passes.composite, exposure: light.exposure, grade: renderer.grade)
    } else {
      inspect(cache: renderer.passes.inspect, mode: renderer.debugView, zNear: camera.nearZ, zFar: camera.farZ)
    }
  }
  if tag is RenderTag.present {
    if renderer.hasUi {
      Gpu2d.endFrame()
    } else {
      presentFrame()
    }
  }
}

# #794: the World3d twin of renderDeferredFrame — walk the derived graph order and
# dispatch each pass through renderDeferredPassWorld.
func renderDeferredFrameWorld(renderer: mod DeferredRenderer, world: view World3d, camera: view Camera3d, light: view Light3d, aspect: view Float) pub {
  var i: Int = 0
  loop i < renderer.graph.order.length {
    renderDeferredPassWorld(renderer: renderer, tag: deferredTagAt(renderer: renderer, i: i), world: world,
                            camera: camera, light: light, aspect: aspect)
    i = i + 1
  }
}

# How many instances the G-buffer pass submitted last frame.
func deferredDrawCount(renderer: view DeferredRenderer) pub ret Int {
  ret passDrawCount()
}

# Mip levels in the depth pyramid built by the last frame.
func deferredPyramidMips(renderer: view DeferredRenderer) pub ret Int {
  ret depthPyramidMips()
}

# Bind an environment. The frame's background and its ambient both come
# from it after this, which is the whole point of #399's interface — a
# scene cannot end up lit by one sky and drawn against another.
func setRendererSky(renderer: mod DeferredRenderer, sky: view Sky) pub {
  renderer.sky = sky
  renderer.hasSky = true
}

# Build a UI-composited deferred frame with an environment already bound.
#
# A convenience constructor that binds the sky up front. `setRendererSky`
# (the setter, above) writes back fine through a `mod` renderer — including a
# nested renderer field — now that nested-field `mod` write-back is guaranteed
# (#762, test 707_nested_mod_writeback); this just saves the two-line build+set.
func createDeferredRendererWithUiSky(sky: view Sky) pub ret DeferredRenderer {
  var renderer: DeferredRenderer = buildDeferredGraph(withUi: true)
  renderer.sky = sky
  renderer.hasSky = true
  ret renderer
}
