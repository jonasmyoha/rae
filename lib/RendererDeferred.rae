# renderer_deferred — the deferred frame, declared as a render graph.
#
# Track B (#356). A forward frame computes lighting inside each material's
# fragment shader (RendererForward / ForwardMain do, with this renderer's
# post passes). The deferred frame separates the two: the G-buffer pass
# writes surface attributes once per visible pixel, and lighting reads them
# once per pixel regardless of how many objects contributed.
#
# The frame is:
#
#   gbuffer -> depthPyramid -> lighting -> composite -> present
#
# but that order is NEVER written down. Passes are declared deliberately
# out of order below and the sequence is DERIVED from which resources each
# one reads and writes — the same property 553 pins for the forward frame.
# Getting this wrong is a class of bug that otherwise shows up as a subtly
# wrong image rather than an error.
#
# WHY THE DEPTH PYRAMID IS IN THE SLICE. It is not decoration: a mip chain
# of depth is what Hi-Z occlusion culling and SSAO's coarse steps both
# read, and the reference engine shares one pyramid between them rather
# than building two. Declaring it now means the slice's dependency edges
# are the real ones, so when culling arrives it slots in rather than
# reshaping the frame. Nothing samples it yet, so the pass runs only after
# requestDepthPyramid (render-perf-5); the edges stay declared.
#
# ALLOCATION-FREE PER OBJECT is the acceptance criterion (#356), which is
# why transforms flow through the #354 value types: a Mat4 is 16 floats by
# value and modelMatrix no longer allocates, so a frame's per-object data
# path touches the allocator zero times.
import Gpu2d
open Rendergraph
open Math3d
open Scene3d
open MeshStore
open SkinStore
open Gbuffer
open GbufferWorld
open GbufferTerrain
open GbufferInspector
open GbufferPasses
open GbufferAo
open GbufferBloom
open GbufferSmaa
open GbufferWarmUp
open GbufferFullscreen
open TransparentForward
open GbufferUnderwater
open GbufferTargets
open RendererDeferredGraph
open Sky
open Shadow3d
open ShadowMaps
open ShadowMapsSdf
open gpu/GpuResources
open gpu/GpuLifetime
open Gpu2dCanvas
open RendererPassTiming
open RenderResolution
open RendererPasses
open ForwardMain
open RendererForward

# ----- pass tags ------------------------------------------------------
# Which pass of the deferred frame this is. An enum (not Int consts) so the
# render-graph walk can `match` on it exhaustively — adding a pass then forces
# every walker to handle it. The enum namespaces the names too.
enum RenderTag {
  gbuffer
  depthPyramid
  ssao
  lighting
  composite
  present
  uiOverlay
  taa
  shadow
  transparentForward
  waterFft
  underwater
  antialias
  bloom
  forward
}

# writes surface attributes, no lighting
# mip chain of depth, for Hi-Z + SSAO
# screen-space AO from G-buffer depth+normal (#387)
# reads the G-buffer, writes radiance
# radiance -> the frame's colour target
# resolve/present
# load-preserving 2D UI painted over the composited frame (#389)
# temporal resolve (#390); HDR in, HDR out
# sun cascade depth (#382); lighting reads it
# snapshot opaque radiance, then alpha-blend transparents into it (#842/#843)
# compute: the FFT ocean cascades the water surface samples (#831); app-dispatched
# underwater tint/fog over the composed lit frame while the camera is submerged (#855)
# the forward main pass (RendererForward, forward-rae-1): shades the scene in one
# 4x MSAA pass into the lit image, in place of gbuffer + ssao + lighting
type DeferredRenderer {
  graph: RenderGraph
  gbufferPass: Int
  pyramidPass: Int
  lightingPass: Int
  compositePass: Int
  presentPass: Int
  uiPass: Int  # -1 when the frame has no UI overlay
  hasUi: Bool
  # Which channel the composite paints. `viewLit` is the real frame; the
  # others are the G-buffer inspector (lib/gbuffer.rae), which is permanent
  # equipment in a deferred renderer rather than temporary scaffolding.
  debugView: Int
  # The bound environment (#399). A scene that never sets one keeps the
  # authored hemisphere and the clear-colour background, so binding a sky
  # is opt-in rather than a silent change to every existing example.
  sky: Sky
  hasSky: Bool
  # The look applied by the composite pass (#556). Defaults to neutralGrade(),
  # which is exactly the historical ACES-plus-gamma result -- opting in is the
  # app's call, so this library cannot silently restyle an example that was
  # calibrated against the old operator.
  grade: ColorGrade
  # #764: the deferred pass caches (pipeline/bind "made" flags + target
  # generations) were module-level globals in gbuffer_passes / gbufferInspector.
  # The renderer owns them now; renderDeferredPassWorld threads each pass its cache.
  passes: RenderPasses
  # #904: the renderer-owned GPU manager every deferred pass's objects (its
  # pipelines, uniforms, samplers, bind groups and the adopted C-owned inputs)
  # are typed IDs in. Created lazily at the first frame (the device must be up)
  # and released by shutdownDeferredRenderer BEFORE the C shutdown.
  idIssuer: IdIssuer
  gpuResources: opt GpuResources
  # #907: the 2D box pass the UI-overlay present flushes with (its own manager).
  canvas: Gpu2dCanvas
  # The underwater pass's per-frame parameters (#855): the water system that
  # owns the bodies decides (water/Underwater.rae) and sets them; inactive
  # by default, so a frame without water pays nothing.
  underwater: UnderwaterParams
  # Per-pass GPU timing (RendererPassTiming), on with RAE_GPU_PASS_TIMING=1
  passTiming: DeferredPassTiming
}

# The manager slot budget: the post-pass targets + views, uniforms, pipelines
# and binds (~40), the geometry frame's 4 targets + views, 2 buffers, the SDF
# clusters' buffers + binds (~30), the shadow cascades' texture, 5 views,
# sampler, 3 pipelines, 8 uniforms + queue buffers, 8 caster binds and up to
# 8 x 4 metaball uniform + bind slots (~90), plus a few in-flight submissions
# (~160 in all) — and two buffers (vertex + index) for every static and skinned
# mesh uploaded through the MeshStore / SkinStore, which is what grows with the
# app: a venue of ~60 static meshes plus a character in ~10 parts, uploaded once
# per colour variant, already passes 256. A full table makes createBuffer return
# none, and the frame then draws nothing with no error, so this is sized for
# hundreds of meshes; a slot is a few Ints per table.
const deferredManagerCapacity: Int = 1024

func ensureRendererResources(renderer: mod DeferredRenderer) pub {
  if let existing: view GpuResources => renderer.gpuResources {
    ret
  }
  renderer.gpuResources = GpuResources.create(
    issuer: renderer.idIssuer
    capacity: deferredManagerCapacity
  )
}

# Use the app's own terrain shader: the six-part terrain composition with the
# app's grade-calibrated palette (a copy of lib/terrain_palette.wgsl with the
# RAE_TERRAIN_* albedos recalibrated for its grade) and/or its grass style in
# place of the lib parts — declared in the app with `shader(files: [...])`, so
# its `assets/` parts resolve next to its own files (GbufferTerrain.terrainSetShader).
func rendererSetTerrainShader(renderer: mod DeferredRenderer, shader: own Shader) {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    terrainSetShader(cache: renderer.passes.gbuffer, resources: resources, shader: shader)
  }
}

# As rendererSetTerrainShader, but with the app's own island-size `override` constants for a
# runtime-variable island (#41). The lib default path (no app terrain shader) is unchanged.
func rendererSetTerrainShaderWithConstants(
  renderer: mod DeferredRenderer
  shader: own Shader
  constants: own List(ShaderConstant)
) {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    terrainSetShaderWithConstants(
      cache: renderer.passes.gbuffer
      resources: resources
      shader: shader
      constants: constants
    )
  }
}

# #905: upload a static mesh into the renderer's MeshStore (the geometry pass
# cache owns it; every deferred pass resolves MeshHandles there).
func uploadMesh(
  renderer: mod DeferredRenderer
  verts: view List(Float)
  vertCount: view Int
  indices: view List(Int)
) pub ret MeshHandle {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    ret meshStoreUpload(
      store: renderer.passes.gbuffer.meshes
      resources: resources
      verts: verts
      vertCount: vertCount
      indices: indices
    )
  }
  ret meshHandleNone()
}

# #921: a SKINNED mesh (20 Floats per vertex: pos3, nrm3, uv2, four joint
# indices as Floats, four weights, an RGBA vertex colour) into the renderer's
# SkinStore; the deferred skin pass and the skinned shadow casters resolve it there.
func uploadSkinnedMesh(
  renderer: mod DeferredRenderer
  verts: view List(Float)
  vertCount: view Int
  indices: view List(Int)
) pub ret MeshHandle {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    ret skinStoreUpload(
      store: renderer.passes.gbuffer.skins
      resources: resources
      verts: verts
      vertCount: vertCount
      indices: indices
    )
  }
  ret meshHandleNone()
}

# The joint palette for this frame (#921): 12 Floats per joint, three vec4 rows
# of an affine transform, written at slot 0 of the renderer's palette buffer.
# Per FRAME, not per draw — every part of a character shares one skeleton;
# uploadPaletteSlot (GbufferInstanced) writes the other characters' slots.
func uploadPalette(
  renderer: mod DeferredRenderer
  rows: view List(Float)
  jointCount: view Int
) pub {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    let wrote: Bool = skinStoreWritePalette(
      store: renderer.passes.gbuffer.skins
      resources: resources
      rows: rows
      jointCount: jointCount
      baseRow: 0
    )
  }
}

# ----- the shadow pass (#925) ------------------------------------------
# The sun cascades are the renderer's ShadowCache (RenderPasses.shadow); the
# app fits the cascades (Shadow3d.fitShadowCascades) and, at RenderTag.shadow,
# opens the pass, queues its casters and closes it. Everything queued between
# beginShadowPass and endShadowPass casts.
func beginShadowPass(renderer: mod DeferredRenderer, c: view ShadowCascades) pub {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    shadowBegin(shadow: renderer.passes.shadow, resources: resources, cascades: c)
  }
}

# The cascades are their own submit, on purpose: the GPU starts on them while
# the CPU still records the G-buffer. Recording them into the post passes'
# shared submit (render-perf-5b) saved a submit but made the frame slower
# (114: 5.3 -> 5.5 ms, 112: 8.5 -> 9.0 ms headless).
func endShadowPass(renderer: mod DeferredRenderer) {
  if let resources: mod GpuResources => renderer.gpuResources {
    shadowEnd(shadow: renderer.passes.shadow, resources: resources)
  }
}

# How many casters the last shadow pass rasterised (#388: only a count tells
# a working pass from a dead one).
func shadowCasterCount(renderer: view DeferredRenderer) pub ret Int {
  ret ShadowMaps.shadowCasterCount(shadow: renderer.passes.shadow)
}

# Per-app cast-shadow ambient darkening [0..1] (shadowCfg.z; 0 = off).
func setShadowAmbient(renderer: mod DeferredRenderer, strength: copy Float) pub {
  ShadowMaps.setShadowAmbient(shadow: renderer.passes.shadow, strength: strength)
}

# Every visible mesh of a World3d as a static caster, resolved in this
# renderer's MeshStore.
func renderSceneShadowWorldWith(renderer: mod DeferredRenderer, world: view World3d) pub {
  if let resources: view GpuResources => renderer.gpuResources {
    ShadowMaps.renderSceneShadowWorld(
      shadow: renderer.passes.shadow
      meshes: renderer.passes.gbuffer.meshes
      resources: resources
      world: world
    )
  }
}

# One static caster from this renderer's MeshStore.
func drawShadowCasterWith(
  renderer: mod DeferredRenderer
  mesh: view MeshHandle
  model: view Mat4
) pub {
  if let resources: view GpuResources => renderer.gpuResources {
    drawShadowCaster(
      shadow: renderer.passes.shadow
      meshes: renderer.passes.gbuffer.meshes
      resources: resources
      mesh: mesh
      model: model
    )
  }
}

# Every instance of `batch` as a shadow caster of `mesh` (the batch's own
# mesh, or a stand-in such as a sphere for capsules): the models the G-buffer
# draws, queued in one go.
func drawShadowCasterBatchWith(
  renderer: mod DeferredRenderer
  mesh: view MeshHandle
  batch: view InstanceBatch
) {
  if let resources: view GpuResources => renderer.gpuResources {
    drawShadowCasterRecords(
      shadow: renderer.passes.shadow
      meshes: renderer.passes.gbuffer.meshes
      resources: resources
      mesh: mesh
      records: batch.records
      stride: instanceRecordFloats
      count: batch.count
    )
  }
}

# A skinned shadow caster from this renderer's SkinStore; `paletteBase` is its
# start row in the palette (characterPaletteBase, #547).
func drawShadowCasterSkinnedWith(
  renderer: mod DeferredRenderer
  mesh: view MeshHandle
  model: view Mat4
  paletteBase: copy Int
) pub {
  if let resources: view GpuResources => renderer.gpuResources {
    drawShadowCasterSkinned(
      shadow: renderer.passes.shadow
      skins: renderer.passes.gbuffer.skins
      resources: resources
      mesh: mesh
      model: model
      paletteBase: paletteBase
    )
  }
}

# A metaball cluster as a caster (`packedBalls`: count x (x, y, z, radius)).
func shadowMetaballsWith(
  renderer: mod DeferredRenderer
  packedBalls: view List(Float)
  count: copy Int
  smoothing: copy Float
) pub {
  if let resources: mod GpuResources => renderer.gpuResources {
    shadowMetaballs(
      shadow: renderer.passes.shadow
      resources: resources
      packedBalls: packedBalls
      count: count
      smoothing: smoothing
    )
  }
}

# Rewrite a mesh's vertex data in place (pooled geometry, e.g. recycled
# terrain tiles); the index buffer and vertex count stay.
func updateMeshVerts(
  renderer: mod DeferredRenderer
  mesh: view MeshHandle
  verts: view List(Float)
  vertCount: view Int
) pub {
  if let resources: view GpuResources => renderer.gpuResources {
    meshStoreUpdateVerts(
      store: renderer.passes.gbuffer.meshes
      resources: resources
      mesh: mesh
      verts: verts
      vertCount: vertCount
    )
  }
}

# Retire every manager object the passes hold and drop the manager. Call BEFORE
# Gbuffer.shutdownAll(): the adopted C-owned handles must
# still be valid while their bind groups are released, and the device must
# still be up for the releases. The geometry frame (#906) drains its in-flight
# submissions and retires the targets first; C forgets the borrowed views.
func shutdownDeferredRenderer(renderer: mod DeferredRenderer) {
  if let resources: mod GpuResources => renderer.gpuResources {
    # Anything still recorded goes to the GPU before its objects are retired
    flushPostPasses(targets: renderer.passes.targets, resources: resources)
    postPassesShutdown(
      composite: renderer.passes.composite
      ao: renderer.passes.ao
      light: renderer.passes.light
      taa: renderer.passes.taa
      pyr: renderer.passes.pyr
      resources: resources
    )
    antialiasPassShutdown(cache: renderer.passes.antialias, resources: resources)
    bloomPassShutdown(cache: renderer.passes.bloom, resources: resources)
    smaaPassShutdown(cache: renderer.passes.smaa, resources: resources)
    inspectorShutdown(cache: renderer.passes.inspect, resources: resources)
    transparentShutdown(cache: renderer.passes.transparent, resources: resources)
    underwaterShutdown(cache: renderer.passes.underwater, resources: resources)
    deferredTargetsShutdown(targets: renderer.passes.targets, resources: resources)
    shadowShutdown(shadow: renderer.passes.shadow, resources: resources)
    shutdownForwardMain(forward: renderer.passes.forward, resources: resources)
    gbufferShutdown(cache: renderer.passes.gbuffer, resources: resources)
    terrainShutdown(cache: renderer.passes.gbuffer, resources: resources)
    meshStoreShutdown(store: renderer.passes.gbuffer.meshes, resources: resources)
    skinStoreShutdown(store: renderer.passes.gbuffer.skins, resources: resources)
    passTimingShutdown(passTiming: renderer.passTiming, resources: resources)
    shutdown(resources: resources)
  }
  renderer.gpuResources = none
  canvasShutdown(canvas: renderer.canvas)
}

# The graph itself (resources, passes, edges) is declared in
# RendererDeferredGraph.buildDeferredGraph (#855 split for the 1000-line cap).
func rendererPathName() pub ret String {
  ret "deferred"
}

# The scene resolution (lib/RenderResolution): the dynamic scale is a fraction
# of the ceiling (app3d/RenderScale's controller sets it each frame), the
# ceiling is the most scene pixels the app wants (by default the device's,
# RenderResolution.defaultRenderCeiling).
# The UI, the composite's output and the present stay at native size.
func setDynamicRenderScale(renderer: mod DeferredRenderer, scale: view Float) {
  renderer.passes.gbuffer.dynamicScale = scale
}

# A ceiling forced by RAE_RENDER_CEILING (screenshots, frame times) wins.
func setRenderCeiling(renderer: mod DeferredRenderer, ceiling: view RenderCeiling) {
  if renderCeilingFromEnv() is not none {
    ret
  }
  renderer.passes.gbuffer.ceilingWidth = ceiling.width
  renderer.passes.gbuffer.ceilingHeight = ceiling.height
}

# Opt out of the default ceiling: draw the 3D scene at the drawable's full
# size (a still-image tool, a reference capture). The dynamic scale still
# applies; RAE_RENDER_CEILING still wins.
func renderAtNativeResolution(renderer: mod DeferredRenderer) {
  setRenderCeiling(renderer: renderer, ceiling: noRenderCeiling())
}

func createDeferredRenderer() pub ret DeferredRenderer {
  ret buildDeferredGraph(withUi: false)
}

# Deferred frame with a load-preserving 2D UI overlay between composite
# and present (#389). Examples 110 and 113 both need this before they can
# leave the forward path.
func createDeferredRendererWithUi() pub ret DeferredRenderer {
  ret buildDeferredGraph(withUi: true)
}

# Choose which channel the composite pass paints (see gbuffer.view*).
func setDebugView(renderer: mod DeferredRenderer, mode: view Int) pub {
  renderer.debugView = mode
}

# TAA on/off (#20). DEFAULT IS OFF = FXAA: the composite paints the raw lit
# result through FXAA, the taa pass is a no-op and the G-buffer jitter is
# suppressed. TAA is opt-in (the shared settings pane has a toggle) because the
# current resolve blurs/ghosts on detailed top-down terrain and crowd motion;
# its quality fixes are POSTPONED queue tasks.
func setTaaEnabled(renderer: mod DeferredRenderer, on: copy Bool) {
  var enabled: Bool = on
  if renderer.passes.targets.taaOverride >= 0 {
    enabled = renderer.passes.targets.taaOverride is 1  # RAE_TAA wins
  }
  if renderer.passes.forwardMain {
    enabled = false  # MSAA is the forward frame's antialiasing
  }
  renderer.passes.targets.taaEnabled = enabled
  renderer.passes.gbuffer.taaEnabled = enabled  # the geometry jitter follows the switch
}

# SMAA 1x (the default) or FXAA when TAA is off (render-perf-9); TAA, when
# on, replaces both.
func setAntialiasMode(renderer: mod DeferredRenderer, mode: view AntialiasMode) {
  renderer.passes.smaa.mode = mode
}

func taaIsEnabled(renderer: view DeferredRenderer) pub ret Bool {
  ret renderer.passes.targets.taaEnabled
}

# Distance fog (#57, per-app). Fades geometry to `color` (LINEAR HDR — the same
# space the lit radiance and sky background live in) over [start,end] world
# units from the camera, and paints that colour as the background so a far
# ground/sea plane dissolves into the horizon with no far-clip seam. Off by
# default; every deferred example that never calls this keeps its sky.
func setFog(
  renderer: mod DeferredRenderer
  color: copy Vec3
  start: copy Float
  end: copy Float
) pub {
  renderer.passes.targets.fogOn = true
  renderer.passes.targets.fogColor = color
  renderer.passes.targets.fogStart = start
  renderer.passes.targets.fogEnd = end
}

func setFogDisabled(renderer: mod DeferredRenderer) pub {
  renderer.passes.targets.fogOn = false
}

func compileDeferred(renderer: mod DeferredRenderer) pub ret Int {
  ret compile(renderGraph: renderer.graph)
}

func describeDeferred(renderer: view DeferredRenderer) pub ret String {
  ret describe(renderGraph: renderer.graph)
}

# Execute one deferred frame.
#
# The loop walks `r.graph.order` — the sequence the graph DERIVED from the
# resource edges — and switches on the pass tag. There is no written
# ordering here to disagree with the declaration: adding an edge in
# createDeferredRenderer changes what runs when, and this function does not
# need editing for that to take effect. Rae has no first-class function
# references, so dispatch is a tag switch, the same pattern
# lib/ui/registry.rae uses; the graph never inspects a tag, so that
# constraint stays out of it.

# ----- app-driven dispatch (#389) -------------------------------------
# A UI overlay needs lib/ui types, and a renderer must not depend on the
# UI layer. So an app that has a UI walks the DERIVED order itself and
# dispatches every non-UI tag through the helper below — order still comes
# from the graph; only the switch moves to where the UI knowledge is.
func deferredOrderLength(renderer: view DeferredRenderer) pub ret Int {
  ret renderer.graph.order.length
}

func deferredTagAt(renderer: view DeferredRenderer, i: view Int) pub ret Int {
  let p: Int = graphIntAt(values: renderer.graph.order, index: i)
  ret graphPassAt(values: renderer.graph.passes, index: p).tag
}

# Run one pass of the deferred frame from a World3d. Handles every tag EXCEPT the
# UI overlay, which the caller owns (PRESENT differs with a UI: Gpu2d.endFrame
# presents, so the renderer must not present again). The G-buffer pass fills from
# the World3d ECS queries (renderSceneWorld + renderSceneSdfWorld); every other tag
# is scene-independent — it reads G-buffer/depth resources the gbuffer pass already
# wrote — and goes through renderDeferredPass, which takes no world at all.
func renderDeferredPassWorld(
  renderer: mod DeferredRenderer
  tag: view Int
  world: view World3d
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
) pub {
  if tag is RenderTag.forward {
    renderForwardPassWorld(
      renderer: renderer
      world: world
      camera: camera
      light: light
      aspect: aspect
    )
    ret
  }
  if tag is not RenderTag.gbuffer {
    renderDeferredPass(
      renderer: renderer
      tag: tag
      camera: camera
      light: light
      aspect: aspect
    )
    ret
  }
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    beginPass(
      cache: renderer.passes.gbuffer
      resources: resources
      camera: camera
      light: light
      aspect: aspect
    )
    GbufferWorld.renderSceneWorld(
      cache: renderer.passes.gbuffer
      resources: resources
      world: world
    )
    # Metaballs go into the SAME pass as the triangles, so the two kinds
    # depth-test against each other rather than compositing (#392).
    renderSceneSdfWorld(
      cache: renderer.passes.gbuffer
      resources: resources
      world: world
      camera: camera
    )
    endPass(cache: renderer.passes.gbuffer, resources: resources)
  }
}

# Run one SCENE-INDEPENDENT pass: every tag except gbuffer (which needs a world —
# renderDeferredPassWorld — or the app's own geometry draws between beginPass and
# endPass) and the UI overlay. An app that fills the G-buffer itself (skinned,
# instanced, procedural or grass draws, never the World3d mesh query) dispatches
# its post-geometry tags here and owns no World3d at all (#994). The gbuffer tag
# is a no-op here on purpose: there is nothing to draw it from.
func renderDeferredPass(
  renderer: mod DeferredRenderer
  tag: view Int
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
) pub {
  if tag is RenderTag.gbuffer or tag is RenderTag.forward {
    ret
  }
  # Present copies the canvas's offscreen target into the drawable (C glue,
  # #920); with a UI the 2D endFrame does it after the overlay.
  if tag is RenderTag.present {
    flushDeferredWork(renderer: renderer)
    if renderer.hasUi {
      endUiFrameTimed(renderer: renderer)
    } else {
      presentFrame(canvas: renderer.canvas)
    }
    ret
  }
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    renderDeferredPassWith(
      renderer: renderer
      resources: resources
      tag: tag
      camera: camera
      light: light
      aspect: aspect
    )
  }
}

# The manager-backed scene-independent passes (#904): every tag but gbuffer and
# present.
func renderDeferredPassWith(
  renderer: mod DeferredRenderer
  resources: mod GpuResources
  tag: view Int
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
) {
  # Every pipeline before the first frame is presented (render-perf-13)
  if not renderer.passes.warmedUp and postPassReady(
    targets: renderer.passes.targets
    resources: resources
    gbuffer: renderer.passes.gbuffer
  ) {
    renderer.passes.warmedUp = true
    warmUpDeferredPipelines(
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
      composite: renderer.passes.composite
      ao: renderer.passes.ao
      antialias: renderer.passes.antialias
      smaa: renderer.passes.smaa
      bloom: renderer.passes.bloom
      inspect: renderer.passes.inspect
      transparent: renderer.passes.transparent
      underwater: renderer.passes.underwater
      shadow: renderer.passes.shadow
    )
  }
  if tag is RenderTag.depthPyramid {
    buildDepthPyramid(
      cache: renderer.passes.pyr
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
    )
  }
  if tag is RenderTag.ssao {
    ssaoPass(
      cache: renderer.passes.ao
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
      camera: camera
    )
  }
  if tag is RenderTag.lighting {
    var sky: Sky = createSkyNone(light: light, clearColor: light.clearColor)
    if renderer.hasSky {
      sky = renderer.sky
    }
    lightingPassSky(
      cache: renderer.passes.light
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
      shadow: renderer.passes.shadow
      camera: camera
      light: light
      sky: sky
    )
  }
  if tag is RenderTag.taa {
    taaPass(
      cache: renderer.passes.taa
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
    )
  }
  if tag is RenderTag.bloom {
    bloomPass(
      cache: renderer.passes.bloom
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
      exposure: light.exposure
    )
  }
  if tag is RenderTag.antialias and effectiveAntialiasMode(cache: renderer.passes.smaa) is AntialiasMode.smaa {
    smaaPass(
      cache: renderer.passes.smaa
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
      exposure: light.exposure
    )
  } else if tag is RenderTag.antialias {
    antialiasPass(
      cache: renderer.passes.antialias
      resources: resources
      targets: renderer.passes.targets
      gbuffer: renderer.passes.gbuffer
      exposure: light.exposure
    )
  }
  if tag is RenderTag.transparentForward {
    transparentPass(
      cache: renderer.passes.transparent
      resources: resources
      gbuffer: renderer.passes.gbuffer
      targets: renderer.passes.targets
    )
  }
  if tag is RenderTag.underwater {
    underwaterPass(
      cache: renderer.passes.underwater
      resources: resources
      gbuffer: renderer.passes.gbuffer
      targets: renderer.passes.targets
      camera: camera
      aspect: aspect
      params: renderer.underwater
    )
  }
  # waterFft is dispatched by the app that owns a WaterSystem (waterFftStep);
  # an app without water simply has nothing to do at this tag.
  if tag is RenderTag.composite {
    if renderer.debugView is viewLit {
      compositePassGraded(
        cache: renderer.passes.composite
        resources: resources
        targets: renderer.passes.targets
        gbuffer: renderer.passes.gbuffer
        canvas: renderer.canvas
        exposure: light.exposure
        grade: renderer.grade
      )
    } else {
      # The inspector submits on its own; the post passes go first
      flushPostPasses(targets: renderer.passes.targets, resources: resources)
      inspect(
        cache: renderer.passes.inspect
        resources: resources
        gbuffer: renderer.passes.gbuffer
        canvas: renderer.canvas
        mode: renderer.debugView
        zNear: camera.nearZ
        zFar: camera.farZ
      )
    }
  }
}

# Per-pass GPU timing (RendererPassTiming, RAE_GPU_PASS_TIMING=1). A frame
# loop calls gpuPassTimingBegin before its first pass, gpuPassMark before
# each graph pass and gpuPassTimingEnd after the last; the results are in
# renderer.passTiming (lastTags, lastMicroseconds, samples). Every call is a
# no-op while the flag is off.
func gpuPassTimingBegin(renderer: mod DeferredRenderer) {
  if let resources: mod GpuResources => renderer.gpuResources {
    passTimingFrameBegin(passTiming: renderer.passTiming, resources: resources)
  }
  if renderer.passTiming.reportFrames >= passTimingReportFrames {
    logPassTimingReport(passTiming: renderer.passTiming)
  }
}

func gpuPassMark(renderer: mod DeferredRenderer, tag: view Int) {
  if let resources: mod GpuResources => renderer.gpuResources {
    passTimingMark(
      passTiming: renderer.passTiming
      resources: resources
      targets: renderer.passes.targets
      tag: tag
    )
  }
}

# The UI-overlay frame's end (Gpu2d.endFrame) with a timing mark between the
# 2D submit and the copy into the drawable, so the two are timed apart.
func endUiFrameTimed(renderer: mod DeferredRenderer) {
  flushDeferredWork(renderer: renderer)
  if Gpu2d.endFrameSubmit(canvas: renderer.canvas) {
    gpuPassMark(renderer: renderer, tag: passTimingCopyTag)
    Gpu2d.endFramePresent(canvas: renderer.canvas)
  }
}

func gpuPassTimingEnd(renderer: mod DeferredRenderer) {
  gpuPassMark(renderer: renderer, tag: -1)
}

# #794: the World3d twin of renderDeferredFrame — walk the derived graph order and
# dispatch each pass through renderDeferredPassWorld.
func renderDeferredFrameWorld(
  renderer: mod DeferredRenderer
  world: view World3d
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
) pub {
  gpuPassTimingBegin(renderer: renderer)
  var i: Int = 0
  loop i < renderer.graph.order.length {
    gpuPassMark(renderer: renderer, tag: deferredTagAt(renderer: renderer, i: i))
    renderDeferredPassWorld(
      renderer: renderer
      tag: deferredTagAt(renderer: renderer, i: i)
      world: world
      camera: camera
      light: light
      aspect: aspect
    )
    i = i + 1
  }
  gpuPassTimingEnd(renderer: renderer)
}

# How many instances the G-buffer pass submitted last frame.
func deferredDrawCount(renderer: view DeferredRenderer) pub ret Int {
  ret passDrawCount(cache: renderer.passes.gbuffer)
}

# Bloom (render-perf-8, GbufferBloom): on/off, threshold and knee in the
# exposed scene's units, intensity. Off (the default) costs nothing.
func setBloom(renderer: mod DeferredRenderer, settings: view BloomSettings) {
  renderer.passes.bloom.settings = settings
}

# Bloom on or off with the current threshold, knee and intensity (the
# library's defaults until setBloom changed them).
func setBloomEnabled(renderer: mod DeferredRenderer, on: copy Bool) {
  renderer.passes.bloom.settings.enabled = on
}

func bloomSettings(renderer: view DeferredRenderer) ret BloomSettings {
  ret renderer.passes.bloom.settings
}

# Mip levels in the depth pyramid built by the last frame (0 until a
# consumer asked for it).
func deferredPyramidMips(renderer: view DeferredRenderer) ret Int {
  ret renderer.passes.targets.pyramidMips
}

# Ask for the depth pyramid. The depthPyramid pass builds it (and allocates
# it) only after this call: no current pass samples it, so building it every
# frame was wasted GPU time (render-perf-5). A pass that starts sampling the
# pyramid (Hi-Z culling, SSAO's coarse steps) calls this once.
func requestDepthPyramid(renderer: mod DeferredRenderer) {
  renderer.passes.targets.pyramidWanted = true
}

# The underwater pass's parameters for this frame (#855): set by the water
# system's waterUnderwaterUpdate before the graph walk; `active` false skips it.
func setUnderwater(renderer: mod DeferredRenderer, params: view UnderwaterParams) pub {
  renderer.underwater = params
}

func rendererIsUnderwater(renderer: view DeferredRenderer) pub ret Bool {
  ret renderer.underwater.active
}

# The opaque snapshot BEFORE a refracting surface draws (#832): apps call this
# at the transparentForward tag before their water, then the renderer's pass.
func snapshotOpaque(renderer: mod DeferredRenderer) {
  ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources => renderer.gpuResources {
    transparentSnapshot(
      cache: renderer.passes.transparent
      resources: resources
      targets: renderer.passes.targets
    )
  }
}

# Submit the post passes recorded so far (render-perf-5b: they share one
# encoder, submitted at the composite). An app that does its OWN GPU work in
# the middle of the graph that reads or writes the renderer's targets calls
# this first, so that work lands after the passes before it. snapshotOpaque
# does it for the refracting surfaces; the composite and present do it at
# the end of the frame.
func flushDeferredWork(renderer: mod DeferredRenderer) {
  if let resources: mod GpuResources => renderer.gpuResources {
    flushPostPasses(targets: renderer.passes.targets, resources: resources)
  }
}

# Bind an environment. The frame's background and its ambient both come
# from it after this, which is the whole point of #399's interface — a
# scene cannot end up lit by one sky and drawn against another.
func setRendererSky(renderer: mod DeferredRenderer, sky: view Sky) pub {
  renderer.sky = sky
  renderer.hasSky = true
}

# Build a UI-composited deferred frame with an environment already bound.
#
# A convenience constructor that binds the sky up front. `setRendererSky`
# (the setter, above) writes back fine through a `mod` renderer — including a
# nested renderer field — now that nested-field `mod` write-back is guaranteed
# (#762, test 707_nested_mod_writeback); this just saves the two-line build+set.
func createDeferredRendererWithUiSky(sky: view Sky) pub ret DeferredRenderer {
  var renderer: DeferredRenderer = buildDeferredGraph(withUi: true)
  renderer.sky = sky
  renderer.hasSky = true
  ret renderer
}
