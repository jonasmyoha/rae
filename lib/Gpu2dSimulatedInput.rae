# Gpu2dSimulatedInput — input a headless test can make happen. The calls
# push the very SDL events a touch screen and a phone's app lifecycle send, so
# the next Gpu2d.pollClose handles them like real ones (the touch list, the
# pointer kind) and a test exercises the same event loop as a device.
# Simulated touches for headless tests: push the same SDL finger event a
# touch screen sends (`kind` one of the simulatedTouch* below; x, y 0..1 of
# the window), handled by the next pollClose like a real one.
const simulatedTouchDown: Int = 0

const simulatedTouchMotion: Int = 1

const simulatedTouchUp: Int = 2

const simulatedTouchCancel: Int = 3

func nativeSimulateTouch(
  kind: Int
  id: Int
  x: Float
  y: Float
) mainThread unsafe extern("rae_ext_Gpu2d_simulateTouch")

func simulateTouch(
  kind: copy Int
  id: copy Int
  x: copy Float
  y: copy Float
) {
  unsafe {
    nativeSimulateTouch(
      kind: kind
      id: id
      x: x
      y: y
    )
  }
}

# The pointer SDL makes of the first finger on a touch screen (`kind`
# simulatedTouchDown, simulatedTouchMotion or simulatedTouchUp; x, y 0..1 of
# the window): the mouse moved there, its button events marked as a finger's
# (the pointer kind is touch). A pushed finger event makes no pointer, so a
# test whose finger is the pointer too sends both.
func nativeSimulateFingerPointer(
  kind: Int
  x: Float
  y: Float
) mainThread unsafe extern("rae_ext_Gpu2d_simulateFingerPointer")

func simulateFingerPointer(kind: copy Int, x: copy Float, y: copy Float) {
  unsafe {
    nativeSimulateFingerPointer(kind: kind, x: x, y: y)
  }
}

# A mouse button's event (`kind` simulatedTouchDown, simulatedTouchMotion or simulatedTouchUp;
# `button` 1 left, 2 middle, 3 right; x, y 0..1 of the window), `clicks` the click count SDL gives
# a press (2 for a double click)
func nativeSimulateMouseButton(
  kind: Int
  button: Int
  x: Float
  y: Float
  clicks: Int
) mainThread unsafe extern("rae_ext_Gpu2d_simulateMouseButton")

func simulateMouseButton(
  kind: copy Int
  button: copy Int
  x: copy Float
  y: copy Float
  clicks: copy Int
) {
  unsafe {
    nativeSimulateMouseButton(
      kind: kind
      button: button
      x: x
      y: y
      clicks: clicks
    )
  }
}

# ...and the events a phone's app gets as it goes to the background (willEnterBackground, then
# didEnterBackground) and comes back (willEnterForeground, then didEnterForeground), which
# lib/AppLifecycle hands the program. Without a window they go to AppLifecycle directly.
func nativeSimulateEnterBackground() mainThread unsafe extern("rae_ext_Gpu2d_simulateEnterBackground")

func nativeSimulateEnterForeground() mainThread unsafe extern("rae_ext_Gpu2d_simulateEnterForeground")

func simulateEnterBackground() {
  unsafe {
    nativeSimulateEnterBackground()
  }
}

func simulateEnterForeground() {
  unsafe {
    nativeSimulateEnterForeground()
  }
}

# Whether a wake (EventLoop.wake) waits in the window's event queue: a test sees that something
# woke the frame loop (false without a window)
func nativeWakePending() mainThread unsafe extern("rae_ext_Gpu2d_wakePending") ret Bool

func wakePending() ret Bool {
  unsafe {
    ret nativeWakePending()
  }
}
