# GPU grass generation (grass epic #486) — Rae over the WebGPU bindings, on the
# App-owned gpu/GpuResources manager (#874: typed IDs, no C slot store).
#
# A frame-integrated COMPUTE pass writes one DrawU record per blade into a
# storage buffer entirely on the GPU: a grid of blades around the player,
# hash-jittered, dropped onto the terrain via the SAME analytic height field as
# the CPU terrain mesh, swayed by the wind model. No CPU per-blade work and no
# readback. The instanced grass draw then binds that buffer and reads
# draws[instance_index] with the grass render pipeline.
#
# The compute pass is its OWN manager recording, submitted before the geometry
# pass each frame (the geometry pass's render encoder is already mid-render-pass
# when Rae sees it, so a compute pass cannot share it). The GPU orders the
# compute submit before the later G-buffer submit, so the draw reads fresh data.
# The draw itself goes INTO the gbuffer's open geometry pass (the renderer's
# GbufferCache since #906) through gpu/GpuRenderPass.recordDrawIndirectInPass
# — the pass encoder is the one raw handle this module touches, so it is the
# opted-in unsafe module for grass. The grass objects live in the APP's manager
# while the frame uniform is the renderer's, so the draw bind BORROWS that
# buffer as an external (a cross-manager reference, not C-owned).
#
# The shaders are assets: lib/grass_compute.wgsl (composed with the biome and
# noise chunks) and lib/grass_render.wgsl (moved verbatim out of C by #874).
open webgpu/Webgpu
open webgpu/Context
open webgpu/WebgpuEnums
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuCompute
open gpu/GpuReadback
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuArgs
open gpu/GpuIds
import Profile
import GrassConfig
open Gbuffer
open GbufferRecord
open ForwardMaterial
open gpu/DeviceFeatures
import String
import WorldBiome

# Blade count MUST be a perfect square: the compute grid is side x side, and the
# shader derives side = sqrt(count). 256 x 256 = 65536 candidate blades; GPU
# culling keeps only the visible subset (indirect draw).
const grassGpuBladeCount: Int = 65536

# The compute kernel's workgroup size (its `computeWorkgroupSize` override)
const grassWorkgroupSize: Int = 64

const grassRecordBytes: Int = instanceRecordFloats * 4  # one DrawU (GbufferRecord)

const grassUniformFloats: Int = 28  # seven vec4 (GrassU: player/time, count/extent, cam, forward, ground, wind, blade)

const grassUniformBytes: Int = 112

const grassIndirectBytes: Int = 16  # 4 u32 DrawIndirect args (vertexCount, instanceCount, ...)

# Vertices per procedural blade: a tapered quad = two triangles (see bladeLocal
# in the render WGSL). No mesh, no vertex/index buffer.
const grassBladeVerts: Int = 6

# The grass field's cross-frame state: the "made" flags, the reused per-frame
# argument writers (allocated once so the hot path stays zero-alloc), the
# throttled-diagnostics frame counter + last visible count, and the typed IDs
# of its GPU objects. A resource the app owns; every entry point threads it
# together with the manager. Copying it copies IDs only; grassShutdown /
# ensureGrassGpu retire through the manager.
type GrassCompute {
  # The app's own compute shader (grassSetComputeShader): a declared
  # composition ending in lib/grass_compute.wgsl whose earlier parts define
  # raeTerrainHeight(vec2<f32>, f32) -> f32 and raeBiomeSample(vec2<f32>).
  # Unset = defaultGrassComputeShader() (the lib noise + biome field).
  computeShaderSet: Bool
  computeShader: Shader
  # The `override` constants handed to the app's compute shader at pipeline
  # creation. wgpu rejects an entry the shader does not declare, so an app
  # surface names exactly its own (grassSetComputeShaderWithConstants); the
  # plain setter keeps the lib island pair for a surface built on
  # lib/world_biome.wgsl.
  computeConstants: List(ShaderConstant)
  # The app's own surface data (grassSetSurfaceField): read-only f32 values the
  # compute shader's surface part reads at @binding(4) — a baked height and
  # grass map, say. Empty: no such binding.
  surfaceField: List(Float)
  surfaceFieldBuffer: BufferId
  made: Bool
  drawBindMade: Bool
  uniformArgs: ArgWriter
  resetArgs: ArgWriter
  diagFrame: Int
  visibleCache: Int
  computePipeline: PipelineId
  # The blade count the kernel's bounds check reads (lib/gpu/GpuCompute)
  bounds: ComputeBounds
  renderPipeline: RenderPipelineId
  instances: BufferId
  uniform: BufferId
  indirect: BufferId
  staging: BufferId
  computeBind: BindGroupId
  drawBind: BindGroupId
  frameUniform: ExternalId
  inFlight: List(SubmissionId)
  # The grass in the forward main pass (forward-rae-4): its pipeline for the
  # lit format, its bind (the draw bind's entries + the renderer's lighting
  # inputs, adopted into this manager) and the inputs generation it was
  # built for
  forwardPipeline: RenderPipelineId
  forwardPipelineFormat: Int32
  forwardBind: BindGroupId
  forwardBindGen: Int
  forwardAdopted: List(ExternalId)
}

func createGrassCompute() ret GrassCompute {
  ret GrassCompute {
    computeShaderSet: false
    computeShader: { text: "", sources: List.create(String, cap: 0), generation: 0 }
    computeConstants: List.create(ShaderConstant, cap: 0)
    surfaceField: List.create(Float, cap: 0)
    surfaceFieldBuffer: noBufferId()
    made: false
    drawBindMade: false
    uniformArgs: createArgs(uniform: true)
    resetArgs: createArgs(uniform: false)
    diagFrame: 0
    visibleCache: 0
    computePipeline: noPipelineId()
    bounds: noComputeBounds(workgroupSize: grassWorkgroupSize)
    renderPipeline: noRenderPipelineId()
    instances: noBufferId()
    uniform: noBufferId()
    indirect: noBufferId()
    staging: noBufferId()
    computeBind: noBindGroupId()
    drawBind: noBindGroupId()
    frameUniform: noExternalId()
    inFlight: List.create(SubmissionId, cap: 4)
    forwardPipeline: noRenderPipelineId()
    forwardPipelineFormat: 0
    forwardBind: noBindGroupId()
    forwardBindGen: -1
    forwardAdopted: List.create(ExternalId, cap: 4)
  }
}

# The compute-pass shader: the shared noise + biome field, then the grass pass
# itself — the same parts the terrain splat pipeline composes, declared and
# validated at build (docs/shaders-and-the-compiler.md). The island size is
# the `override` pair WorldBiome.islandConstants() sets at pipeline creation.
func defaultGrassComputeShader() ret Shader {
  ret shader(
    files: [
      "lib/gpu/computeBounds.wgsl"
      "lib/noise.wgsl"
      "lib/world_biome.wgsl"
      "lib/grass_compute.wgsl"
    ]
  )
}

# Use an app's own compute shader — a declared composition that starts with
# lib/gpu/computeBounds.wgsl (the bounds check, since 0.1.267), whose next
# parts define the surface (raeTerrainHeight / raeBiomeSample) and whose last
# part is lib/grass_compute.wgsl. Declared in the app so a surface that drifts from
# the grass pass fails the app's build, not its first frame.
func grassSetComputeShader(grass: mod GrassCompute, shader: own Shader) {
  grassSetComputeShaderWithConstants(
    grass: grass
    shader: shader
    constants: WorldBiome.islandConstants()
  )
}

# The same, with the app's own `override` constants — a surface that is not the
# lib island biome declares its own overrides (a venue's dimensions, say) and
# must not receive the island pair, which its shader does not declare.
func grassSetComputeShaderWithConstants(
  grass: mod GrassCompute
  shader: own Shader
  constants: own List(ShaderConstant)
) {
  grass.computeShader = shader
  grass.computeConstants = constants
  grass.computeShaderSet = true
  resetGrassPipeline(grass: grass)
}

# Give the app's compute shader its own data: `values` go to the GPU once, as a
# read-only storage buffer at @binding(4), which the surface part declares as
# `var<storage, read> ...: array<f32>` and reads — the lib's grass pass never
# does. For a surface no formula describes: a modelled venue's ground heights
# and where grass grows, baked on the CPU. Rebuilds the pipeline.
func grassSetSurfaceField(grass: mod GrassCompute, values: own List(Float)) {
  grass.surfaceField = values
  resetGrassPipeline(grass: grass)
}

# Rewrite part of the surface field in place — `values` from index `offset`
# on — for a field that fills in as the app learns more of its ground (a
# streamed world's tiles, as they load). The field keeps its length; values
# past its end are dropped. Once the GPU buffer exists only that range is
# written to it, with no pipeline rebuild; before, the first upload takes
# the whole field anyway.
func grassUpdateSurfaceField(
  grass: mod GrassCompute
  resources: mod GpuResources
  offset: view Int
  values: view List(Float)
) {
  var count: Int = values.length
  if count > grass.surfaceField.length - offset {
    count = grass.surfaceField.length - offset
  }
  if offset < 0 or count <= 0 {
    ret
  }
  loop var i: Int = 0, i < count, ++i {
    grass.surfaceField.set(index: offset + i, value: values.copyAtDefault(index: i))
  }
  if not isValidBuffer(resources: resources, id: grass.surfaceFieldBuffer) {
    ret
  }
  var writer: ArgWriter = createArgs(uniform: false)
  loop var i: Int = 0, i < count, ++i {
    pushF32(writer: writer, value: values.copyAtDefault(index: i))
  }
  let uploaded: Bool = uploadArgs(
    writer: writer
    resources: resources
    buffer: grass.surfaceFieldBuffer
    offset: offset * 4
  )
}

# The compute pipeline from the app's shader when one was set, else the lib's.
func grassComputePipeline(
  grass: view GrassCompute
  resources: mod GpuResources
) ret opt PipelineId {
  if grass.computeShaderSet {
    ret createComputePipelineWithConstants(
      resources: resources
      shader: grass.computeShader
      entryPoint: "main"
      constants: computeConstantsFor(bounds: grass.bounds, constants: grass.computeConstants)
    )
  }
  let computeShader: Shader = defaultGrassComputeShader()
  ret createComputePipelineWithConstants(
    resources: resources
    shader: computeShader
    entryPoint: "main"
    constants: computeConstantsFor(bounds: grass.bounds, constants: WorldBiome.islandConstants())
  )
}

# Force a grass-pipeline rebuild on the next frame — the island radius is an
# `override` set at pipeline creation, so growing the island (#41) must rebuild it.
func resetGrassPipeline(grass: mod GrassCompute) {
  grass.made = false
  # The draw bind group is auto-layouted from the OLD render pipeline; invalidate it
  # so it rebuilds against the recomposed pipeline (#41 grow).
  grass.drawBindMade = false
}

# The G-buffer's procedural-geometry pipeline spec: the same 3 colour targets +
# reverse-Z depth WRITE as the static pipeline, NO vertex buffers (the geometry
# is generated in the vertex shader from vertex_index) and no back-face cull,
# since a thin blade (or a billboard) is seen from both sides. Shared with the
# sprite pass.
func gbufferProceduralPipelineSpec() ret RenderPipelineSpec {
  var colorFormats: List(Int32) = List.create(Int32, cap: 3)
  colorFormats.add(value: WGPUTextureFormat_RGB10A2Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 1)
  ret RenderPipelineSpec {
    vertexStride: 0
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: false
    premultiplied: false
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: true
    depthCompare: WGPUCompareFunction_Greater
    cullMode: WGPUCullMode_None
    sampleCount: 1
  }
}

# Retire every grass GPU object (a rebuild or shutdown). The manager releases
# them once no in-flight submission uses them. No-op on blank IDs.
func releaseGrassGpu(grass: mod GrassCompute, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: grass.drawBind)
  retireBindGroup(resources: resources, id: grass.computeBind)
  retirePipeline(resources: resources, id: grass.computePipeline)
  retireRenderPipeline(resources: resources, id: grass.renderPipeline)
  retireBuffer(resources: resources, id: grass.instances)
  retireBuffer(resources: resources, id: grass.uniform)
  retireBuffer(resources: resources, id: grass.indirect)
  retireBuffer(resources: resources, id: grass.staging)
  retireBuffer(resources: resources, id: grass.surfaceFieldBuffer)
  retireBuffer(resources: resources, id: grass.bounds.buffer)
  releaseExternal(resources: resources, id: grass.frameUniform)
  grass.drawBind = noBindGroupId()
  grass.computeBind = noBindGroupId()
  grass.computePipeline = noPipelineId()
  grass.renderPipeline = noRenderPipelineId()
  grass.instances = noBufferId()
  grass.uniform = noBufferId()
  grass.indirect = noBufferId()
  grass.staging = noBufferId()
  grass.surfaceFieldBuffer = noBufferId()
  grass.bounds = noComputeBounds(workgroupSize: grassWorkgroupSize)
  grass.frameUniform = noExternalId()
  grass.drawBindMade = false
  retireBindGroup(resources: resources, id: grass.forwardBind)
  retireRenderPipeline(resources: resources, id: grass.forwardPipeline)
  releaseExternalIds(resources: resources, list: grass.forwardAdopted)
  grass.forwardBind = noBindGroupId()
  grass.forwardPipeline = noRenderPipelineId()
  grass.forwardPipelineFormat = 0
  grass.forwardBindGen = -1
}

# The grass in the FORWARD main pass: the grass composition after the shading
# prelude, with forward_entry.wgsl last, 4x into the lit format; and its bind,
# the draw bind's three entries + the renderer's lighting inputs, adopted into
# this manager. Rebuilt when the lighting inputs are recreated.
func ensureGrassForward(
  grass: mod GrassCompute
  resources: mod GpuResources
  gbuffer: view GbufferCache
  gbufferResources: view GpuResources
) {
  let litFormat: Int32 = gbuffer.forward.litFormat
  if litFormat is (0 as Int32) or not grass.drawBindMade {
    ret
  }
  if not (grass.forwardPipelineFormat is litFormat) {
    retireBindGroup(resources: resources, id: grass.forwardBind)
    retireRenderPipeline(resources: resources, id: grass.forwardPipeline)
    grass.forwardBind = noBindGroupId()
    grass.forwardPipeline = noRenderPipelineId()
    grass.forwardPipelineFormat = litFormat
    var grassShader: Shader = shader(files: [
      "lib/precision_f32.wgsl"
      "lib/sky_hosek.wgsl"
      "lib/deferred_uniforms.wgsl"
      "lib/deferred_shade.wgsl"
      "lib/ssao_upsample.wgsl"
      "lib/grass_render.wgsl"
      "lib/forward_entry.wgsl"
    ])
    if deviceHasShaderF16() {
      grassShader = shader(files: [
        "lib/precision_f16.wgsl"
        "lib/sky_hosek.wgsl"
        "lib/deferred_uniforms.wgsl"
        "lib/deferred_shade.wgsl"
        "lib/ssao_upsample.wgsl"
        "lib/grass_render.wgsl"
        "lib/forward_entry.wgsl"
      ])
    }
    if let pipeline: RenderPipelineId = createRenderPipelineWithConstants(
      resources: resources
      shader: grassShader
      vertexEntry: "vs"
      fragmentEntry: "fsForward"
      spec: forwardMaterialSpec(
        litFormat: litFormat
        stride: 0
        attributes: List.create(VertexAttributeSpec, cap: 0)
        depthWrite: true
        depthCompare: WGPUCompareFunction_Greater
        cullMode: WGPUCullMode_None
      )
      constants: forwardSsaoConstants(ssao: gbuffer.forward.ssao)
    ) {
      grass.forwardPipeline = pipeline
    }
  }
  let inputsGen: Int = gbuffer.forward.inputsGen
  if grass.forwardBindGen is inputsGen and bindGroupIsUsable(
    resources: resources
    id: grass.forwardBind
  ) {
    ret
  }
  retireBindGroup(resources: resources, id: grass.forwardBind)
  grass.forwardBind = noBindGroupId()
  releaseExternalIds(resources: resources, list: grass.forwardAdopted)
  if gbuffer.forward.inputs.length < forwardInputCount {
    ret
  }
  # The inputs are the renderer's manager objects: adopt them here
  # (two buffers, the cascades' view, their sampler, the two AO views)
  var adopted: List(ResourceRef) = List.create(ResourceRef, cap: forwardInputCount)
  unsafe {
    loop var i: Int = 0, i < forwardInputCount, ++i {
      let input: ResourceRef = gbuffer.forward.inputs.copyAtFallback(index: i, fallback: noRef())
      let handle: Ptr = refHandle(resources: gbufferResources, ref: input)
      if i < 2 {
        adopted.add(
          value: adoptBufferRef(resources: resources, adopted: grass.forwardAdopted, handle: handle)
        )
      } else if i is not 3 {
        adopted.add(
          value: adoptTextureViewRef(
            resources: resources
            adopted: grass.forwardAdopted
            handle: handle
          )
        )
      } else {
        adopted.add(
          value: adoptSamplerRef(
            resources: resources
            adopted: grass.forwardAdopted
            handle: handle
          )
        )
      }
    }
  }
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 16)
  entries.add(value: externalRef(id: grass.frameUniform))
  entries.add(value: bufferRef(id: grass.instances))
  entries.add(value: bufferRef(id: grass.uniform))
  if not addForwardInputs(entries: entries, inputs: adopted) {
    ret
  }
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: grass.forwardPipeline
    entries: entries
  ) {
    grass.forwardBind = bind
    grass.forwardBindGen = inputsGen
  }
}

# Create the instance buffer, uniform, compute pipeline, compute bind group and
# grass render pipeline once. Safe after the device + static pipeline exist.
func ensureGrassGpu(grass: mod GrassCompute, resources: mod GpuResources) {
  if grass.made {
    ret
  }
  grass.made = true
  # On a REBUILD (island grow reset grass.made) the previous pipelines, buffers
  # and bind groups are retired first — deferred behind any frame still using them.
  releaseGrassGpu(grass: grass, resources: resources)
  let instBytes: Int = grassGpuBladeCount * grassRecordBytes
  if let instances: BufferId = createBuffer(
    resources: resources
    size: instBytes
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
  ) {
    grass.instances = instances
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: grassUniformBytes
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    grass.uniform = uniform
  }
  # Indirect draw-args buffer: the compute atomically bumps instanceCount as it
  # appends visible blades; the draw reads it via DrawIndirect. Needs Indirect
  # (drawn from) + Storage (compute writes) + CopyDst (per-frame reset) +
  # CopySrc (#488: the diagnostics read the bumped instanceCount back).
  if let indirect: BufferId = createBuffer(
    resources: resources
    size: grassIndirectBytes
    usage: WGPUBufferUsage_Indirect + WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst + WGPUBufferUsage_CopySrc
  ) {
    grass.indirect = indirect
  }
  # Tiny MapRead staging for reading the visible count back (#488).
  if let staging: BufferId = createBuffer(
    resources: resources
    size: grassIndirectBytes
    usage: WGPUBufferUsage_CopyDst + WGPUBufferUsage_MapRead
  ) {
    grass.staging = staging
  }

  # Composed from FILES, not a C string, so the pass shares the one biome and
  # terrain-height definition with everything else that touches the ground.
  # Carrying its own copy is what left blades standing on a height field the
  # terrain had already moved off.
  if let bounds: ComputeBounds = createComputeBounds(
    resources: resources
    workgroupSize: grassWorkgroupSize
  ) {
    grass.bounds = bounds
  }
  if let computePipeline: PipelineId = grassComputePipeline(grass: grass, resources: resources) {
    grass.computePipeline = computePipeline
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
    entries.add(value: bufferRef(id: grass.bounds.buffer))
    entries.add(value: bufferRef(id: grass.uniform))
    entries.add(value: bufferRef(id: grass.instances))
    entries.add(value: bufferRef(id: grass.indirect))
    if grass.surfaceField.length > 0 {
      ensureGrassSurfaceField(grass: grass, resources: resources)
      entries.add(value: bufferRef(id: grass.surfaceFieldBuffer))
    }
    if let computeBind: BindGroupId = createComputeBindGroupOrdered(
      resources: resources
      pipeline: computePipeline
      entries: entries
    ) {
      grass.computeBind = computeBind
    }
  }
  let renderShader: Shader = shader(files: ["lib/grass_render.wgsl"])
  if let renderPipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    shader: renderShader
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: gbufferProceduralPipelineSpec()
  ) {
    grass.renderPipeline = renderPipeline
  }
  if not isValidBindGroup(resources: resources, id: grass.computeBind) or not isValidRenderPipeline(
    resources: resources
    id: grass.renderPipeline
  ) {
    log("[grass] GPU objects could not be created; grass is not drawn")
  }
}

# Upload the app's surface field (grassSetSurfaceField) into its storage buffer.
func ensureGrassSurfaceField(grass: mod GrassCompute, resources: mod GpuResources) {
  if let buffer: BufferId = createBuffer(
    resources: resources
    size: grass.surfaceField.length * 4
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
  ) {
    grass.surfaceFieldBuffer = buffer
    var writer: ArgWriter = createArgs(uniform: false)
    loop let value: view Float in grass.surfaceField {
      pushF32(writer: writer, value: value)
    }
    let uploaded: Bool = uploadArgs(
      writer: writer
      resources: resources
      buffer: buffer
      offset: 0
    )
  }
}

# The draw bind group needs the frame uniform, which only exists after the first
# beginPass — so build it lazily on first draw: frame uniform @0 (adopted from
# the gbuffer), instance storage @1, grass uniform @2, over the grass render
# pipeline's group-0 layout.
func ensureGrassDrawBind(
  grass: mod GrassCompute
  resources: mod GpuResources
  gbuffer: view GbufferCache
  gbufferResources: view GpuResources
) {
  if grass.drawBindMade {
    ret
  }
  if not isValidRenderPipeline(resources: resources, id: grass.renderPipeline) {
    ret
  }
  if not isValidBuffer(resources: gbufferResources, id: gbuffer.frameUniform) {
    ret
  }
  grass.drawBindMade = true
  releaseExternal(resources: resources, id: grass.frameUniform)
  grass.frameUniform = noExternalId()
  unsafe {
    if let frameUniform: ExternalId = adoptExternalBuffer(
      resources: resources
      handle: refHandle(resources: gbufferResources, ref: bufferRef(id: gbuffer.frameUniform))
    ) {
      grass.frameUniform = frameUniform
    }
  }
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
  entries.add(value: externalRef(id: grass.frameUniform))
  entries.add(value: bufferRef(id: grass.instances))
  entries.add(value: bufferRef(id: grass.uniform))
  if let drawBind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: grass.renderPipeline
    entries: entries
  ) {
    grass.drawBind = drawBind
  }
}

# Cull tuning: blades within nearKeep of the camera are always kept (so the field
# never holes out at the player's feet); beyond that, a blade survives only if it
# is within the view cone (dot(dirToBlade, forward) >= coneCos). coneCos ~ cos(69)
# is generous so nothing on-screen is clipped early.
const grassNearKeep: Float = 5.0

const grassConeCos: Float = 0.36

# Dispatch the grass generation + CULLING compute for this frame. Centres the
# candidate grid on (playerX, playerY); each survivor (on-terrain, unfaded, inside
# the view cone from the camera) is appended to a compacted list and bumps the
# indirect draw's instanceCount. No readback, no blocking. Call BEFORE the pass.
func grassGenerate(
  grass: mod GrassCompute
  resources: mod GpuResources
  playerX: copy Float
  playerY: copy Float
  groundZ: copy Float
  time: copy Float
  deltaTime: copy Float
  toon: copy Int
  camX: copy Float
  camY: copy Float
  camZ: copy Float
  fwdX: copy Float
  fwdY: copy Float
  fwdZ: copy Float
  settings: view GrassViewSettings
) {
  pollSubmissions(inFlight: grass.inFlight, resources: resources)
  ensureGrassGpu(grass: grass, resources: resources)
  if not isValidBindGroup(resources: resources, id: grass.computeBind) {
    ret
  }
  var toonF: Float = 0.0
  if toon is 1 {
    toonF = 1.0
  }
  resetArgs(writer: grass.uniformArgs)
  pushVec4F(
    writer: grass.uniformArgs
    x: playerX
    y: playerY
    z: groundZ
    w: time
  )
  pushVec4F(
    writer: grass.uniformArgs
    x: grassGpuBladeCount.toFloat()
    y: settings.extent
    z: toonF
    w: deltaTime
  )
  pushVec4F(
    writer: grass.uniformArgs
    x: camX
    y: camY
    z: camZ
    w: grassNearKeep
  )
  pushVec4F(
    writer: grass.uniformArgs
    x: fwdX
    y: fwdY
    z: fwdZ
    w: grassConeCos
  )
  pushVec4F(
    writer: grass.uniformArgs
    x: settings.groundColor.x
    y: settings.groundColor.y
    z: settings.groundColor.z
    w: settings.clusterStrength
  )
  # gradient bottom = ground
  pushVec4F(
    writer: grass.uniformArgs
    x: settings.windDirX
    y: settings.windDirY
    z: settings.windStrength
    w: settings.windGust
  )
  # f: wind
  pushVec4F(
    writer: grass.uniformArgs
    x: settings.bladeHeightScale
    y: settings.bladeWidthScale
    z: settings.densityScale
    w: settings.tipLighten
  )
  # g: blade + gradient
  uploadArgs(
    writer: grass.uniformArgs
    resources: resources
    buffer: grass.uniform
    offset: 0
  )

  # Reset the indirect args so this frame's atomic append counts from 0.
  resetArgs(writer: grass.resetArgs)
  pushU32(writer: grass.resetArgs, value: grassBladeVerts)
  pushU32(writer: grass.resetArgs, value: 0)
  pushU32(writer: grass.resetArgs, value: 0)
  pushU32(writer: grass.resetArgs, value: 0)
  uploadArgs(
    writer: grass.resetArgs
    resources: resources
    buffer: grass.indirect
    offset: 0
  )

  # ceil(blades / 64) workgroups; the kernel's bounds check skips the last
  # group's extra invocations (lib/gpu/GpuCompute)
  if var recording: Recording = beginRecording(resources: resources) {
    if recordBoundedCompute(
      recording: recording
      resources: resources
      pipeline: grass.computePipeline
      bindGroup: grass.computeBind
      bounds: grass.bounds
      elementCount: grassGpuBladeCount
    ) {
      trackSubmission(inFlight: grass.inFlight, resources: resources, recording: recording)
    }
  }
}

# Draw the whole GPU-generated grass field in one instanced, non-indexed indirect
# draw inside the G-buffer geometry pass (call between beginPass and endPass).
# The grass render pipeline generates each blade's geometry in-shader from
# vertex_index (no mesh), reading its per-blade transform from the instance
# buffer; instanceCount was written by the culling compute, so only the
# surviving (visible) blades are drawn. Restores the shared static pipeline +
# bind group after so any following static draw is unaffected.
func grassDraw(
  grass: mod GrassCompute
  resources: mod GpuResources
  gbuffer: view GbufferCache
  gbufferResources: view GpuResources
) {
  ensureGrassGpu(grass: grass, resources: resources)
  ensureGrassDrawBind(
    grass: grass
    resources: resources
    gbuffer: gbuffer
    gbufferResources: gbufferResources
  )
  var pipeline: RenderPipelineId = grass.renderPipeline
  var bind: BindGroupId = grass.drawBind
  if gbuffer.forwardFrame {
    ensureGrassForward(
      grass: grass
      resources: resources
      gbuffer: gbuffer
      gbufferResources: gbufferResources
    )
    pipeline = grass.forwardPipeline
    bind = grass.forwardBind
  }
  unsafe {
    if not gbufferFrameActive(cache: gbuffer) {
      ret
    }
    # No static re-bind after: every G-buffer draw binds its own pipeline (#912).
    recordDrawIndirectInPass(
      resources: resources
      pass: gbuffer.pass
      pipeline: pipeline
      bindGroup: bind
      indirect: bufferRef(id: grass.indirect)
    )
  }
}

# Total candidate blades the compute considers each frame (#488 diagnostics).
func grassGeneratedCount() ret Int {
  ret grassGpuBladeCount
}

# Read the VISIBLE blade count back (#488): the culling compute atomically bumped
# the indirect draw's instanceCount (u32 #1 of the 4-word args) to the number of
# survivors. Copy the args into the MapRead staging buffer and read it through a
# manager ReadbackId. BLOCKING — it waits for the GPU, so call it throttled
# (every N frames), not per frame. Returns none before the grass GPU exists or
# when the readback failed.
func grassReadVisible(grass: mod GrassCompute, resources: mod GpuResources) ret opt Int {
  if not isValidBuffer(resources: resources, id: grass.staging) {
    ret none
  }
  var copied: Bool = false
  if var recording: Recording = beginRecording(resources: resources) {
    if recordCopyBuffer(
      recording: recording
      resources: resources
      source: grass.indirect
      sourceOffset: 0
      destination: grass.staging
      destinationOffset: 0
      size: grassIndirectBytes
    ) {
      if let submission: SubmissionId = trackSubmission(
        inFlight: grass.inFlight
        resources: resources
        recording: recording
      ) {
        copied = waitSubmission(resources: resources, id: submission)
      }
    }
  }
  if not copied {
    ret none
  }
  pollSubmissions(inFlight: grass.inFlight, resources: resources)
  var visible: opt Int = none
  if let read: ReadbackId = startReadback(
    resources: resources
    buffer: grass.staging
    offset: 0
    size: grassIndirectBytes
  ) {
    if waitReadback(resources: resources, id: read) {
      var bytes: List(UInt8) = List.create(UInt8, cap: grassIndirectBytes)
      loop bytes.length < grassIndirectBytes {
        bytes.add(value: 0 as UInt8)
      }
      if copyReadback(resources: resources, id: read, destination: bytes) {
        # args = {vertexCount:u32, instanceCount:u32, ...}: instanceCount is
        # little-endian bytes 4..7.
        var count: Int = 0
        var i: Int = 7
        loop i >= 4 {
          count = count * 256 + (bytes.copyAtFallback(index: i, fallback: 0 as UInt8) as Int)
          i = i - 1
        }
        visible = count
      }
    }
    retireReadback(resources: resources, id: read)
  }
  ret visible
}

# Last read visible-blade count (#488). Cheap; refreshed by grassDiagTick.
func grassVisibleCount(grass: view GrassCompute) ret Int {
  ret grass.visibleCache
}

# Per-frame grass diagnostics (#488). Only active during a profile capture so the
# blocking readback never stalls normal play, and throttled to every 10th frame
# so even a capture takes at most one grass sync per ~6 wall-frames. Emits
# generated / visible / culled candidate counts as counters — plot them in the
# capture alongside fps and per-pass GPU ms. Call once per frame after
# grassGenerate.
func grassDiagTick(grass: mod GrassCompute, resources: mod GpuResources, profiler: mod Profiler) {
  if Profile.capturing(profiler: profiler) is false {
    ret
  }
  grass.diagFrame = grass.diagFrame + 1
  if grass.diagFrame % 10 is 0 {
    if let visible: Int = grassReadVisible(grass: grass, resources: resources) {
      grass.visibleCache = visible
    }
  }
  Profile.counter(profiler: profiler, name: "grass.generated", value: grassGpuBladeCount)
  Profile.counter(profiler: profiler, name: "grass.visible", value: grass.visibleCache)
  Profile.counter(
    profiler: profiler
    name: "grass.culled"
    value: grassGpuBladeCount - grass.visibleCache
  )
}

# Retire the field's GPU objects and drain its submissions (app shutdown). The
# manager frees them synchronously; another consumer of the manager is untouched.
func grassShutdown(grass: mod GrassCompute, resources: mod GpuResources) {
  releaseGrassGpu(grass: grass, resources: resources)
  drainSubmissions(inFlight: grass.inFlight, resources: resources)
  grass.made = false
}
