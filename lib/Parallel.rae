# The worker pool behind `parallelLoop` (runtime_threads.c, docs/concurrency-
# model.md §5): one worker per performance core but one (left to the
# program's other threads), the thread that starts a parallelLoop being one of
# them. `RAE_WORKERS=n` sets the count;
# `RAE_WORKERS=1` makes every parallelLoop sequential.
func nativeWorkerCount() unsafe extern("rae_ext_Parallel_workerCount") ret Int

# How many workers run a parallelLoop's iterations (at least 1). Starts the
# pool if no parallelLoop has yet.
func workerCount() ret Int {
  unsafe {
    ret nativeWorkerCount()
  }
}

func nativeCheckWrites(enabled: Bool) unsafe extern("rae_ext_Parallel_checkWrites")

# Check, while the program runs, that the writes an `unsafe { }` block makes
# in a parallelLoop body are disjoint: two iterations of one parallelLoop
# writing the same List element stop the program with both iteration numbers.
# The same as running with RAE_PARALLEL_CHECK=1 (docs/parallel-stages-
# design.md §3). Costs a table insert per such write; for tests.
func checkWrites(enabled: view Bool) {
  unsafe {
    nativeCheckWrites(enabled: enabled)
  }
}
