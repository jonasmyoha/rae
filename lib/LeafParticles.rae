# LeafParticles — leaves in the air on the GPU (docs/leaf-particles-design.md
# §4): one resource the app owns, no entity and no CPU state per leaf.
#
# - The leaves live in a ring of `capacity` 32-byte records in a storage
#   buffer (lib/leaf_particles.wgsl Leaf). A new leaf takes the next slot;
#   the oldest is overwritten first, so no free list is needed. A slot whose
#   age is 0 (as a new buffer is) is empty.
# - Each frame the app lists the crowns letting leaves go (leafEmit: a
#   center, a radius, a color, a size and how many; at most leafEmitMax),
#   then stepLeafParticles uploads the list and the frame's uniform and
#   records two compute passes in one recording: `spawn` (one invocation per
#   leaf released this frame) and `fly` (one per ring slot: the fall in the
#   wind, the landing on the terrain or the water, the death past the reach
#   or the leaf's life).
# - drawLeafParticles draws the ring's live run (the newest releases over
#   the release budget's window; `fly` covers the same run) as one instanced
#   indirect draw of a
#   midrib-folded card made in the vertex shader (lib/leaf_render.wgsl),
#   into the open G-buffer pass, or the forward main pass in a forward
#   frame (forward_entry.wgsl after it).
#
# The objects live in the renderer's own GPU manager, beside the frame
# uniform and the forward lighting inputs the draws bind. Nothing is read
# back; with no leaf released over the budget's window (22 s) nothing is
# dispatched or drawn. The releases are budgeted so the ring never
# overwrites a live leaf (leafFrameCap). The capacity and the reach follow
# the target (leafDefaultCapacity, leafDefaultReach: 16384 within 40 m on
# the desktop, 4096 within 25 m on the phone and in the browser);
# RAE_LEAVES=0 turns the leaves off. app3d/LeafRelease decides which trees let leaves go.
import Math
import Sys
import Vec3
open Wind
open webgpu/WebgpuEnums
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuCompute
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuArgs
open gpu/GpuIds
open gpu/DeviceFeatures
open Gbuffer
open GbufferIssue
open ForwardMaterial
open GrassCompute

# A leaf's longest life (s): MUST match leaf_particles.wgsl leafLifeSeconds
const leafLifeSeconds: Float = 20.0

const leafEmitMax: Int = 512

const leafRecordBytes: Int = 32

const leafEmitBytes: Int = 48

const leafUniformBytes: Int = 112

# The folded card: two halves of two triangles
const leafCardVertices: Int = 12

const leafWorkgroupSize: Int = 64

# The window (s, one bucket a second) the release budget counts over: past
# a leaf's longest life and a second more, so every leaf released before it
# has been flown to its death
const leafBudgetSeconds: Int = 22

# The phone and the browser keep fewer leaves, closer (§6)
const leafSmallTarget: Bool = Target.isMobileOs or Target.isNative is false

# How many leaves the ring holds on this target: 16384 on the desktop, 4096
# on the phone and in the browser
func leafDefaultCapacity() ret Int {
  if leafSmallTarget {
    ret 4096
  }
  ret 16384
}

# How far from the eye (m) trees let leaves go on this target: 40 on the
# desktop, 25 on the phone and in the browser
func leafDefaultReach() ret Float {
  if leafSmallTarget {
    ret 25.0
  }
  ret 40.0
}

# One crown letting `count` leaves go this frame
type LeafEmit {
  crown: Vec3
  radius: Float
  color: Vec3
  size: Float
  count: Int
  seed: Int
  # 0 an oval, 1 a maple, 2 a birch, 3 a ginkgo leaf (leaf_render.wgsl)
  shape: Int = 0
  # a ground lift: the leaves start on the ground at `crown` and are thrown
  # up (the fallen leaves a strong gust sweeps up)
  lift: Bool = false
}

# A frame's step: the eye and the reach past which leaves die; the wind in
# m/s and the renderer's wind vector (its gusts and swirls); the frame's
# length; the ground (`groundZ`, flat there with `flatGround`, else the
# terrain), the water's surface and the snow's depth; the toon look; the
# direction toward the sun (the backlit glow)
type LeafStep {
  eye: Vec3
  reach: Float
  windX: Float
  windY: Float
  wind: WindVector
  deltaTime: Float
  groundZ: Float
  flatGround: Bool = false
  waterZ: Float = -1000.0
  snowDepth: Float = 0.0
  toon: Bool = false
  sun: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
}

type LeafParticles {
  capacity: Int
  # the `override` constants of the terrain the leaves land on (the app's
  # island: WorldBiome.islandConstantsFor)
  constants: List(ShaderConstant)
  emits: List(LeafEmit)
  # the ring's next slot, this frame's releases, all released so far, and
  # the seconds since the last release (past a leaf's life: nothing to do)
  head: Int = 0
  released: Int = 0
  totalReleased: Int = 0
  # the run of ring slots that may hold a live leaf this frame: its first
  # slot and its length (every leaf released over the budget window ends
  # there, so none outside it is alive)
  liveBase: Int = 0
  liveCount: Int = 0
  clock: Float = 0.0
  # RAE_LEAVES=0 turns the leaves off (nothing released, so nothing runs)
  enabled: Bool = true
  # RAE_LEAF_DRAW_REPEAT=<n> draws the leaves n times, to measure the draw
  # above the noise of a pass's timing (docs/leaf-particles-design.md §6)
  drawRepeat: Int = 1
  # the leaves released in each of the last leafBudgetSeconds seconds, and
  # the second the newest bucket is
  releaseBuckets: List(Int)
  bucketSecond: Int = 0
  # RAE_LEAF_REPORT=1: a line a second of the releases and the frame cap
  report: Bool = false
  reportReleased: Int = 0
  reportCapped: Int = 0
  reportSeconds: Float = 0.0
  made: Bool = false
  uniformArgs: ArgWriter
  emitArgs: ArgWriter
  drawArgs: ArgWriter
  leaves: BufferId
  uniform: BufferId
  emitBuffer: BufferId
  indirect: BufferId
  spawnBounds: ComputeBounds
  flyBounds: ComputeBounds
  spawnPipeline: PipelineId
  flyPipeline: PipelineId
  spawnBind: BindGroupId
  flyBind: BindGroupId
  renderPipeline: RenderPipelineId
  drawBind: BindGroupId
  forwardPipeline: RenderPipelineId
  forwardPipelineFormat: Int32 = 0
  forwardBind: BindGroupId
  forwardBindGen: Int = -1
  inFlight: List(SubmissionId)
}

func leafEmptyBuckets() ret List(Int) {
  var buckets: List(Int) = List.create(Int, cap: leafBudgetSeconds)
  loop var i: Int = 0, i < leafBudgetSeconds, ++i {
    buckets.add(value: 0)
  }
  ret buckets
}

# An empty system of `capacity` leaves landing on the terrain of
# `constants` (created on the GPU at the first step)
func createLeafParticles(
  capacity: view Int
  constants: view List(ShaderConstant)
) ret LeafParticles {
  ret LeafParticles {
    capacity: Math.max(a: capacity, b: 64)
    enabled: Sys.getEnv(name: "RAE_LEAVES") is not "0"
    drawRepeat: Math.max(a: 1, b: Sys.getEnv(name: "RAE_LEAF_DRAW_REPEAT").toInt())
    releaseBuckets: leafEmptyBuckets()
    report: Sys.getEnv(name: "RAE_LEAF_REPORT") is "1"
    constants: constants
    emits: List.create(LeafEmit, cap: leafEmitMax)
    uniformArgs: createArgs(uniform: true)
    emitArgs: createArgs(uniform: false)
    drawArgs: createArgs(uniform: false)
    leaves: noBufferId()
    uniform: noBufferId()
    emitBuffer: noBufferId()
    indirect: noBufferId()
    spawnBounds: noComputeBounds(workgroupSize: leafWorkgroupSize)
    flyBounds: noComputeBounds(workgroupSize: leafWorkgroupSize)
    spawnPipeline: noPipelineId()
    flyPipeline: noPipelineId()
    spawnBind: noBindGroupId()
    flyBind: noBindGroupId()
    renderPipeline: noRenderPipelineId()
    drawBind: noBindGroupId()
    forwardPipeline: noRenderPipelineId()
    forwardBind: noBindGroupId()
    inFlight: List.create(SubmissionId, cap: 4)
  }
}

# A crown at `crown` (radius `radius`) lets `count` leaves of `color` and
# `size` (m) go this frame; false once the frame's list is full
func leafEmit(
  leafParticles: mod LeafParticles
  crown: view Vec3
  radius: view Float
  color: view Vec3
  size: view Float
  count: view Int
  seed: view Int
  shape: view Int
  lift: view Bool
) ret Bool {
  if count <= 0 or not leafParticles.enabled {
    ret true
  }
  if leafParticles.emits.length >= leafEmitMax {
    ret false
  }
  leafParticles.emits.add(value: {
    crown: crown
    radius: radius
    color: color
    size: size
    count: count
    seed: seed
    shape: shape
    lift: lift
  })
  ret true
}

# The leaves in the air or lying might still be alive
func leafParticlesActive(leafParticles: view LeafParticles) ret Bool {
  ret leafParticles.liveCount > 0
}

func leafComputeShader() ret Shader {
  ret shader(files: [
    "lib/gpu/computeBounds.wgsl"
    "lib/noise.wgsl"
    "lib/world_biome.wgsl"
    "lib/wind.wgsl"
    "lib/leaf_particles.wgsl"
  ])
}

# The buffers, the two compute pipelines and the G-buffer pipeline, once
func ensureLeafGpu(leafParticles: mod LeafParticles, resources: mod GpuResources) {
  if leafParticles.made {
    ret
  }
  leafParticles.made = true
  if let leaves: BufferId = createBuffer(
    resources: resources
    size: leafParticles.capacity * leafRecordBytes
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst + WGPUBufferUsage_CopySrc
  ) {
    leafParticles.leaves = leaves
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: leafUniformBytes
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    leafParticles.uniform = uniform
  }
  if let emitBuffer: BufferId = createBuffer(
    resources: resources
    size: leafEmitMax * leafEmitBytes
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
  ) {
    leafParticles.emitBuffer = emitBuffer
  }
  # every slot drawn as one card: the empty ones collapse in the shader
  if let indirect: BufferId = createBuffer(
    resources: resources
    size: 16
    usage: WGPUBufferUsage_Indirect + WGPUBufferUsage_CopyDst
  ) {
    leafParticles.indirect = indirect
    var args: ArgWriter = createArgs(uniform: false)
    pushU32(writer: args, value: leafCardVertices)
    pushU32(writer: args, value: leafParticles.capacity)
    pushU32(writer: args, value: 0)
    pushU32(writer: args, value: 0)
    let unusedUploaded: Bool = uploadArgs(
      writer: args
      resources: resources
      buffer: indirect
      offset: 0
    )
  }
  if let spawnBounds: ComputeBounds = createComputeBounds(
    resources: resources
    workgroupSize: leafWorkgroupSize
  ) {
    leafParticles.spawnBounds = spawnBounds
  }
  if let flyBounds: ComputeBounds = createComputeBounds(
    resources: resources
    workgroupSize: leafWorkgroupSize
  ) {
    leafParticles.flyBounds = flyBounds
  }
  if let spawnPipeline: PipelineId = createComputePipelineWithConstants(
    resources: resources
    shader: leafComputeShader()
    entryPoint: "spawn"
    constants: computeConstantsFor(
      bounds: leafParticles.spawnBounds
      constants: leafParticles.constants
    )
  ) {
    leafParticles.spawnPipeline = spawnPipeline
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
    entries.add(value: bufferRef(id: leafParticles.spawnBounds.buffer))
    entries.add(value: bufferRef(id: leafParticles.uniform))
    entries.add(value: bufferRef(id: leafParticles.leaves))
    entries.add(value: bufferRef(id: leafParticles.emitBuffer))
    if let bind: BindGroupId = createComputeBindGroupOrdered(
      resources: resources
      pipeline: spawnPipeline
      entries: entries
    ) {
      leafParticles.spawnBind = bind
    }
  }
  if let flyPipeline: PipelineId = createComputePipelineWithConstants(
    resources: resources
    shader: leafComputeShader()
    entryPoint: "fly"
    constants: computeConstantsFor(
      bounds: leafParticles.flyBounds
      constants: leafParticles.constants
    )
  ) {
    leafParticles.flyPipeline = flyPipeline
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: leafParticles.flyBounds.buffer))
    entries.add(value: bufferRef(id: leafParticles.uniform))
    entries.add(value: bufferRef(id: leafParticles.leaves))
    if let bind: BindGroupId = createComputeBindGroupOrdered(
      resources: resources
      pipeline: flyPipeline
      entries: entries
    ) {
      leafParticles.flyBind = bind
    }
  }
  if let renderPipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    shader: shader(files: ["lib/leaf_render.wgsl"])
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: gbufferProceduralPipelineSpec()
  ) {
    leafParticles.renderPipeline = renderPipeline
  }
  if not isValidBindGroup(resources: resources, id: leafParticles.flyBind) or not isValidRenderPipeline(
    resources: resources
    id: leafParticles.renderPipeline
  ) {
    log("[leaves] GPU objects could not be created; no leaves are drawn")
  }
}

# An emit's shape and lift as leaf_particles.wgsl reads them (info.w)
func leafEmitFlags(emit: view LeafEmit) ret Int {
  if emit.lift {
    ret (emit.shape bitand 3) + 16
  }
  ret emit.shape bitand 3
}

# The most leaves a frame may release into a ring of `capacity` when
# `recent` were released over the last leafBudgetSeconds: what is left of
# the ring (a leaf lives at most leafLifeSeconds, so none of those still
# alive is overwritten: a gale fills the ring and then releases as fast as
# leaves die), and an eighth of the ring in one frame at most
func leafFrameCap(capacity: view Int, recent: view Int) ret Int {
  ret Math.max(a: 0, b: Math.min(a: capacity / 8, b: capacity - recent))
}

# The leaves released over the last leafBudgetSeconds (the one-second
# buckets), after the clock moved to `clock`
func leafRecentReleases(leafParticles: mod LeafParticles, clock: view Float) ret Int {
  let second: Int = Math.floor(x: clock).toInt()
  var steps: Int = 0
  loop leafParticles.bucketSecond < second and steps < leafBudgetSeconds {
    leafParticles.bucketSecond = leafParticles.bucketSecond + 1
    leafParticles.releaseBuckets.set(
      index: leafParticles.bucketSecond % leafBudgetSeconds
      value: 0
    )
    steps = steps + 1
  }
  leafParticles.bucketSecond = second
  var recent: Int = 0
  loop let count: view Int in leafParticles.releaseBuckets {
    recent = recent + count
  }
  ret recent
}

# The frame's step up to its compute: the releases counted against the
# budget, the emit list and the uniform uploaded (`step`: its air, its
# ground, its reach; LeafStep). True when there is compute to record
# (recordLeafCompute).
func prepareLeafStep(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  step: view LeafStep
) ret Bool {
  pollSubmissions(inFlight: leafParticles.inFlight, resources: resources)
  # the releases, capped so a gale fills the ring instead of overwriting
  # leaves still in the air
  var released: Int = 0
  let deltaTime: Float = step.deltaTime
  let recent: Int = leafRecentReleases(
    leafParticles: leafParticles
    clock: leafParticles.clock + deltaTime
  )
  let frameCap: Int = leafFrameCap(capacity: leafParticles.capacity, recent: recent)
  var emitCount: Int = 0
  resetArgs(writer: leafParticles.emitArgs)
  loop let emit: view LeafEmit in leafParticles.emits {
    let count: Int = Math.min(a: emit.count, b: frameCap - released)
    if count > 0 {
      pushVec4F(
        writer: leafParticles.emitArgs
        x: emit.crown.x
        y: emit.crown.y
        z: emit.crown.z
        w: emit.radius
      )
      pushVec4F(
        writer: leafParticles.emitArgs
        x: emit.color.x
        y: emit.color.y
        z: emit.color.z
        w: emit.size
      )
      pushVec4U(
        writer: leafParticles.emitArgs
        x: count
        y: released
        z: emit.seed bitand 16777215
        w: leafEmitFlags(emit: emit)
      )
      released = released + count
      emitCount = emitCount + 1
    }
  }
  if leafParticles.report {
    var asked: Int = 0
    loop let emit: view LeafEmit in leafParticles.emits {
      asked = asked + emit.count
    }
    leafParticles.reportReleased = leafParticles.reportReleased + released
    leafParticles.reportCapped = leafParticles.reportCapped + asked - released
    leafParticles.reportSeconds = leafParticles.reportSeconds + deltaTime
    if leafParticles.reportSeconds >= 1.0 {
      log(
        "[leaves] {leafParticles.reportReleased} released, {leafParticles.reportCapped} over the cap in {leafParticles.reportSeconds} s"
      )
      leafParticles.reportReleased = 0
      leafParticles.reportCapped = 0
      leafParticles.reportSeconds = 0.0
    }
  }
  leafParticles.emits.clear()
  leafParticles.released = released
  leafParticles.totalReleased = leafParticles.totalReleased + released
  let bucket: Int = leafParticles.bucketSecond % leafBudgetSeconds
  leafParticles.releaseBuckets.set(
    index: bucket
    value: leafParticles.releaseBuckets.copyAtFallback(index: bucket, fallback: 0) + released
  )
  leafParticles.clock = leafParticles.clock + deltaTime
  # the slots that may be alive: the newest releases over the budget window,
  # ending at this frame's last
  let live: Int = Math.min(a: recent + released, b: leafParticles.capacity)
  leafParticles.liveCount = live
  leafParticles.liveBase = ((leafParticles.head + released - live) % leafParticles.capacity + leafParticles.capacity) % leafParticles.capacity
  if not leafParticlesActive(leafParticles: leafParticles) {
    ret false
  }
  ensureLeafGpu(leafParticles: leafParticles, resources: resources)
  if not isValidBindGroup(resources: resources, id: leafParticles.flyBind) {
    ret false
  }
  var flat: Float = 0.0
  if step.flatGround {
    flat = 1.0
  }
  var toon: Float = 0.0
  if step.toon {
    toon = 1.0
  }
  resetArgs(writer: leafParticles.uniformArgs)
  pushVec4F(
    writer: leafParticles.uniformArgs
    x: step.eye.x
    y: step.eye.y
    z: step.eye.z
    w: step.reach
  )
  pushVec4F(
    writer: leafParticles.uniformArgs
    x: step.windX
    y: step.windY
    z: Math.clamp(val: deltaTime, low: 0.0, high: 0.0333)
    w: leafParticles.clock
  )
  pushVec4F(
    writer: leafParticles.uniformArgs
    x: step.groundZ
    y: flat
    z: step.waterZ
    w: step.snowDepth
  )
  pushVec4U(
    writer: leafParticles.uniformArgs
    x: leafParticles.head
    y: leafParticles.capacity
    z: emitCount
    w: leafParticles.liveBase
  )
  pushVec4F(
    writer: leafParticles.uniformArgs
    x: step.wind.x
    y: step.wind.y
    z: step.wind.gustiness
    w: step.wind.time
  )
  pushVec4F(
    writer: leafParticles.uniformArgs
    x: step.wind.driftX
    y: step.wind.driftY
    z: toon
    w: 0.0
  )
  pushVec4F(
    writer: leafParticles.uniformArgs
    x: step.sun.x
    y: step.sun.y
    z: step.sun.z
    w: 0.0
  )
  # the draw: the live run's cards only
  resetArgs(writer: leafParticles.drawArgs)
  pushU32(writer: leafParticles.drawArgs, value: leafCardVertices)
  pushU32(writer: leafParticles.drawArgs, value: live)
  pushU32(writer: leafParticles.drawArgs, value: 0)
  pushU32(writer: leafParticles.drawArgs, value: 0)
  let unusedDrawArgs: Bool = uploadArgs(
    writer: leafParticles.drawArgs
    resources: resources
    buffer: leafParticles.indirect
    offset: 0
  )
  let unusedUniform: Bool = uploadArgs(
    writer: leafParticles.uniformArgs
    resources: resources
    buffer: leafParticles.uniform
    offset: 0
  )
  if emitCount > 0 {
    let unusedEmits: Bool = uploadArgs(
      writer: leafParticles.emitArgs
      resources: resources
      buffer: leafParticles.emitBuffer
      offset: 0
    )
  }
  ret true
}

# The frame's compute (prepareLeafStep's releases spawned, every slot
# flown) recorded into `recording`; false when it could not be
func recordLeafCompute(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  recording: mod Recording
) ret Bool {
  let released: Int = leafParticles.released
  var recorded: Bool = true
  if released > 0 {
    recorded = recordBoundedCompute(
      recording: recording
      resources: resources
      pipeline: leafParticles.spawnPipeline
      bindGroup: leafParticles.spawnBind
      bounds: leafParticles.spawnBounds
      elementCount: released
    )
  }
  if recorded {
    recorded = recordBoundedCompute(
      recording: recording
      resources: resources
      pipeline: leafParticles.flyPipeline
      bindGroup: leafParticles.flyBind
      bounds: leafParticles.flyBounds
      elementCount: leafParticles.liveCount
    )
  }
  leafParticles.head = (leafParticles.head + released) % leafParticles.capacity
  ret recorded
}

# This frame's leaves: the listed releases spawned and every leaf moved on
# by `step` (its air, its ground, its reach; LeafStep), in one submission.
# Call before the frame's pass.
func stepLeafParticles(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  step: view LeafStep
) {
  if not prepareLeafStep(leafParticles: leafParticles, resources: resources, step: step) {
    ret
  }
  if var recording: Recording = beginRecording(resources: resources) {
    if recordLeafCompute(leafParticles: leafParticles, resources: resources, recording: recording) {
      let unusedSubmission: opt SubmissionId = trackSubmission(
        inFlight: leafParticles.inFlight
        resources: resources
        recording: recording
      )
    }
  }
}

# The forward main pass's pipeline and bind (a forward frame): the card
# after the shading prelude, forward_entry.wgsl last; rebuilt when the
# lighting inputs are
func ensureLeafForward(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  gbuffer: view GbufferCache
) {
  let litFormat: Int32 = gbuffer.forward.litFormat
  if litFormat is (0 as Int32) {
    ret
  }
  if not (leafParticles.forwardPipelineFormat is litFormat) {
    retireBindGroup(resources: resources, id: leafParticles.forwardBind)
    retireRenderPipeline(resources: resources, id: leafParticles.forwardPipeline)
    leafParticles.forwardBind = noBindGroupId()
    leafParticles.forwardPipeline = noRenderPipelineId()
    leafParticles.forwardPipelineFormat = litFormat
    var leafShader: Shader = shader(files: [
      "lib/precision_f32.wgsl"
      "lib/sky_hosek.wgsl"
      "lib/deferred_uniforms.wgsl"
      "lib/deferred_shade.wgsl"
      "lib/ssao_upsample.wgsl"
      "lib/leaf_render.wgsl"
      "lib/forward_entry.wgsl"
    ])
    if deviceHasShaderF16() {
      leafShader = shader(files: [
        "lib/precision_f16.wgsl"
        "lib/sky_hosek.wgsl"
        "lib/deferred_uniforms.wgsl"
        "lib/deferred_shade.wgsl"
        "lib/ssao_upsample.wgsl"
        "lib/leaf_render.wgsl"
        "lib/forward_entry.wgsl"
      ])
    }
    if let pipeline: RenderPipelineId = createRenderPipelineWithConstants(
      resources: resources
      shader: leafShader
      vertexEntry: "vs"
      fragmentEntry: "fsForward"
      spec: forwardMaterialSpec(
        litFormat: litFormat
        stride: 0
        attributes: List.create(VertexAttributeSpec, cap: 0)
        depthWrite: true
        depthCompare: WGPUCompareFunction_Greater
        cullMode: WGPUCullMode_None
      )
      constants: forwardSsaoConstants(ssao: gbuffer.forward.ssao)
    ) {
      leafParticles.forwardPipeline = pipeline
    }
  }
  if leafParticles.forwardBindGen is gbuffer.forward.inputsGen and bindGroupIsUsable(
    resources: resources
    id: leafParticles.forwardBind
  ) {
    ret
  }
  retireBindGroup(resources: resources, id: leafParticles.forwardBind)
  leafParticles.forwardBind = noBindGroupId()
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 18)
  entries.add(value: bufferRef(id: gbuffer.frameUniform))
  entries.add(value: bufferRef(id: leafParticles.leaves))
  entries.add(value: bufferRef(id: leafParticles.uniform))
  if not addForwardInputs(entries: entries, inputs: gbuffer.forward.inputs) {
    ret
  }
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: leafParticles.forwardPipeline
    entries: entries
  ) {
    leafParticles.forwardBind = bind
    leafParticles.forwardBindGen = gbuffer.forward.inputsGen
  }
}

# Every leaf into the open G-buffer (or forward) pass: one indirect draw.
# `resources` is the renderer's manager (the pass's).
func drawLeafParticles(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  gbuffer: view GbufferCache
) {
  if not leafParticles.made or not leafParticlesActive(leafParticles: leafParticles) {
    ret
  }
  if not bindGroupIsUsable(resources: resources, id: leafParticles.drawBind) {
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: gbuffer.frameUniform))
    entries.add(value: bufferRef(id: leafParticles.leaves))
    entries.add(value: bufferRef(id: leafParticles.uniform))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: leafParticles.renderPipeline
      entries: entries
    ) {
      leafParticles.drawBind = bind
    }
  }
  var pipeline: RenderPipelineId = leafParticles.renderPipeline
  var bind: BindGroupId = leafParticles.drawBind
  if gbuffer.forwardFrame {
    ensureLeafForward(leafParticles: leafParticles, resources: resources, gbuffer: gbuffer)
    pipeline = leafParticles.forwardPipeline
    bind = leafParticles.forwardBind
  }
  unsafe {
    if not gbufferFrameActive(cache: gbuffer) {
      ret
    }
    loop var repeat: Int = 0, repeat < leafParticles.drawRepeat, ++repeat {
      let unusedDrawn: Bool = recordDrawIndirectInPass(
        resources: resources
        pass: gbuffer.pass
        pipeline: pipeline
        bindGroup: bind
        indirect: bufferRef(id: leafParticles.indirect)
      )
    }
  }
}

# Retire the GPU objects and drain the submissions (the app's shutdown)
func releaseLeafParticles(leafParticles: mod LeafParticles, resources: mod GpuResources) {
  drainSubmissions(inFlight: leafParticles.inFlight, resources: resources)
  retireBindGroup(resources: resources, id: leafParticles.forwardBind)
  retireBindGroup(resources: resources, id: leafParticles.drawBind)
  retireBindGroup(resources: resources, id: leafParticles.spawnBind)
  retireBindGroup(resources: resources, id: leafParticles.flyBind)
  retireRenderPipeline(resources: resources, id: leafParticles.forwardPipeline)
  retireRenderPipeline(resources: resources, id: leafParticles.renderPipeline)
  retirePipeline(resources: resources, id: leafParticles.spawnPipeline)
  retirePipeline(resources: resources, id: leafParticles.flyPipeline)
  retireBuffer(resources: resources, id: leafParticles.leaves)
  retireBuffer(resources: resources, id: leafParticles.uniform)
  retireBuffer(resources: resources, id: leafParticles.emitBuffer)
  retireBuffer(resources: resources, id: leafParticles.indirect)
  retireBuffer(resources: resources, id: leafParticles.spawnBounds.buffer)
  retireBuffer(resources: resources, id: leafParticles.flyBounds.buffer)
  leafParticles.made = false
}
