# GPU timestamp timing (#528) — real per-pass GPU milliseconds, over the WebGPU
# bindings (no new renderer C surface). The CPU zones in lib/profile.rae bound
# submit cost and reveal CPU-vs-GPU-bound; this measures what the GPU actually
# spends inside each pass — the definitive signal for where a frame's time goes
# and the input a dynamic-resolution controller needs.
#
# Model: one timestamp query set with 2 slots per pass. Each pass writes a begin
# timestamp on its command encoder before its work and an end timestamp after,
# then resolves that pair into a QueryResolve buffer. Once per frame, collect()
# copies the resolves into a MapRead buffer, reads them back (blocking — fine, it
# only runs during a capture and does not perturb the GPU timestamps), converts
# ticks→microseconds via the queue's timestamp period, and emits one profiler
# counter per pass (gpu.<name>) plus gpu.total. Perfetto then plots per-pass GPU
# time across the capture — e.g. shadow GPU ms rising as the device throttles.
#
# Timestamps are taken at pass boundaries via the pass descriptor's
# timestampWrites (NOT wgpuCommandEncoderWriteTimestamp — Metal, hence iPhone,
# does not support timestamps inside an encoder, only at pass begin/end).
#
# Usage per render/compute pass:
#   let tsIdx = passBegin(name: "gbuffer")
#   let rpDesc = { ...attachments..., timestampWrites: writesPtr() }
#   ... begin pass, draw, end pass ...
#   resolve(enc: enc, idx: tsIdx)               # before finish
# and once per frame: frameBegin() early, collect() at the end.
import core
import webgpu/context
import webgpu/webgpu
import profile
# Match grass_compute's imports/opens exactly: importing webgpu_enums/_types would
# bulk-emit every WGPU enum constant as a C static that clashes with webgpu.h.
# Types are cross-file visible without import; the enum constants used here resolve
# through `open webgpu/webgpu`.
open webgpu/context
open webgpu/webgpu

const gtMaxPasses: Int = 16

# #764: the GPU-timing ring (query set indices, per-frame pass names, the readback
# buffer, the timestamp period) was a set of module-level gt* globals. It is a
# resource an app owns (only zz_gpu_timing_check drives it today); every entry
# point takes it. The WGPU handles stay in C behind rae_gt_set/get.
type GpuTiming {
  enabled: Bool
  inited: Bool
  names: List(String)
  # One reusable timestampWrites struct: passes are encoded sequentially and wgpu
  # copies its contents at beginPass, so a single slot (overwritten per pass) is
  # enough. .data is handed to each pass descriptor's timestampWrites field.
  tsw: List(WGPUPassTimestampWrites)
  count: Int
  period: Float           # nanoseconds per timestamp tick
  dst: List(Int)
  totalUs: Int
}

func createGpuTiming() pub ret GpuTiming {
  ret GpuTiming {
    enabled: false, inited: false,
    names: createList(String, cap: gtMaxPasses),
    tsw: createList(WGPUPassTimestampWrites, cap: 1),
    count: 0, period: 1.0,
    dst: createList(Int, cap: gtMaxPasses * 2),
    totalUs: 0
  }
}

func enabled(timing: view GpuTiming) pub ret Bool { ret timing.enabled }

# WGPU handle store lives in C (index 0=querySet, 1=resolveBuf, 2=readBuf) — see
# runtime_webgpu.c rae_gt_set/get, same seam grass uses for its handles.
func gtSet(index: Int, ptr: Ptr) extern("rae_gt_set")
func gtGet(index: Int) extern("rae_gt_get") ret Ptr
func gtQset() ret Ptr { ret gtGet(index: 0) }
func gtResolve() ret Ptr { ret gtGet(index: 1) }
func gtRead() ret Ptr { ret gtGet(index: 2) }

# Create the query set + resolve/readback buffers. Idempotent; safe no-op when the
# adapter lacks the timestamp features (enabled() then stays false and all
# other calls are cheap no-ops). Must run after the WebGPU device exists.
func init(timing: mod GpuTiming) pub ret Bool {
  if timing.inited { ret timing.enabled }
  timing.inited = true
  if webgpuHaveTimestamp() is 0 {
    ret false
  }
  let qDesc: WGPUQuerySetDescriptor = {
    type_: WGPUQueryType_Timestamp, count: (gtMaxPasses * 2) as UInt32
  }
  gtSet(index: 0, ptr: wgpuDeviceCreateQuerySet(device: webgpuDevice(), descriptor: qDesc))
  let rDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_QueryResolve + WGPUBufferUsage_CopySrc,
    size: (gtMaxPasses * 16) as UInt64
  }
  gtSet(index: 1, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: rDesc))
  let mDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_CopyDst + WGPUBufferUsage_MapRead,
    size: (gtMaxPasses * 16) as UInt64
  }
  gtSet(index: 2, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: mDesc))
  timing.period = wgpuQueueGetTimestampPeriod(queue: webgpuQueue())
  timing.tsw.add(value: {
    querySet: gtQset(), beginningOfPassWriteIndex: 0 as UInt32, endOfPassWriteIndex: 1 as UInt32
  })
  var k: Int = 0
  loop k < gtMaxPasses * 2 {
    timing.dst.add(value: 0)
    k = k + 1
  }
  timing.enabled = true
  ret true
}

# Reset the per-frame pass list. Call once at the start of a frame.
func frameBegin(timing: mod GpuTiming) pub {
  if timing.enabled is false { ret }
  timing.count = 0
  timing.names.length = 0
}

# Claim a pass slot and point the shared timestampWrites at its two query indices.
# Returns the pass index for resolve, or -1 when disabled / budget full.
# Call immediately before building the pass descriptor.
func passBegin(timing: mod GpuTiming, name: view String) pub ret Int {
  if timing.enabled is false { ret 0 - 1 }
  let idx: Int = timing.count
  if idx >= gtMaxPasses { ret 0 - 1 }
  timing.names.add(value: "{name}")
  timing.tsw.set(index: 0, value: {
    querySet: gtQset(),
    beginningOfPassWriteIndex: (idx * 2) as UInt32,
    endOfPassWriteIndex: (idx * 2 + 1) as UInt32
  })
  timing.count = idx + 1
  ret idx
}

# The Ptr to hand to a pass descriptor's `timestampWrites` field (null when timing
# is disabled, which the descriptor treats as "no timestamps").
func writesPtr(timing: view GpuTiming) pub ret Ptr {
  if timing.enabled is false { ret webgpuNull() }
  ret timing.tsw.data
}

# Resolve a pass's timestamp pair into the resolve buffer. Recorded on that pass's
# encoder after the pass ends, before finish. (Resolve is a normal encoder command
# and needs no inside-encoder feature.)
func resolve(timing: view GpuTiming, enc: copy Ptr, idx: copy Int) pub {
  if timing.enabled is false or idx < 0 { ret }
  wgpuCommandEncoderResolveQuerySet(commandEncoder: enc, querySet: gtQset(),
    firstQuery: (idx * 2) as UInt32, queryCount: 2 as UInt32,
    destination: gtResolve(), destinationOffset: (idx * 16) as UInt64)
}

# Copy the frame's resolved timestamps to the readback buffer, read them (blocking
# until GPU-complete), and emit per-pass GPU microseconds as profiler counters.
func collect(timing: mod GpuTiming, profiler: mod Profiler) pub {
  if timing.enabled is false or timing.count is 0 { ret }
  let bytes: Int = timing.count * 16
  # Fresh MapRead staging buffer each frame + release after: this mirrors the
  # runtime's proven readback (rae_gpu_readback); reusing one buffer across
  # map/unmap cycles did not read back correctly on Metal.
  let stDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_CopyDst + WGPUBufferUsage_MapRead, size: bytes as UInt64
  }
  let staging: Ptr = wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: stDesc)
  let encDesc: WGPUCommandEncoderDescriptor = { }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  wgpuCommandEncoderCopyBufferToBuffer(commandEncoder: enc, source: gtResolve(),
    sourceOffset: 0 as UInt64, destination: staging, destinationOffset: 0 as UInt64,
    size: bytes as UInt64)
  let cbDesc: WGPUCommandBufferDescriptor = { }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gtSubmit(cmd: cmd)
  let ok: Int = webgpuMapRead(buffer: staging, size: bytes as UInt64, dst: timing.dst.data)
  wgpuBufferRelease(buffer: staging)
  if ok is 0 { ret }
  timing.totalUs = 0
  var i: Int = 0
  loop i < timing.count {
    let begin: Int = rae_ext_rae_buf_get(V: Int, buf: timing.dst.data, index: i * 2)
    let endTick: Int = rae_ext_rae_buf_get(V: Int, buf: timing.dst.data, index: i * 2 + 1)
    let us: Int = rae_float_to_int(f: (endTick - begin) as Float * timing.period / 1000.0)
    let nm: String = rae_ext_rae_buf_get(V: String, buf: timing.names.data, index: i)
    profile.counter(profiler: profiler, name: "gpu.{nm}", value: us)
    timing.totalUs = timing.totalUs + us
    i = i + 1
  }
  profile.counter(profiler: profiler, name: "gpu.total", value: timing.totalUs)
}

# Total GPU microseconds across all passes from the last collect() — the signal a
# dynamic-resolution controller reads.
func lastTotalUs(timing: view GpuTiming) pub ret Int { ret timing.totalUs }


# Submit one command buffer to the global queue. Reuses the existing C shim (Rae
# cannot yet take the address of a single handle for wgpuQueueSubmit).
func gtSubmit(cmd: Ptr) extern("rae_gb_submit")
