# Gpu2d: input, valid after pollClose each frame (lib/Gpu2d/ is one module, see Window.rae)
open Gpu2dCanvas
open Gpu2dCanvasImage
open Gpu2dCanvasClip
open Gpu2dCanvasText
open Gpu2dCanvasFrame
open webgpu/Webgpu
open webgpu/Context
open gpu/FramePacer
open gpu/DeviceFeatures
open Gpu2dWindowIcon

# --- Input (valid after pollClose each frame) ----------------------------
# pollClose records mouse/keyboard/wheel state while it pumps the event queue,
# so these read this frame's input. Coordinates are in DESIGN units (the same
# space drawRect etc. take), so hit-testing lines up with what was drawn.
func nativePointerX() mainThread unsafe extern("rae_ext_Gpu2d_pointerX") ret Float

func pointerX() ret Float {
  unsafe {
    ret nativePointerX()
  }
}

func nativePointerY() mainThread unsafe extern("rae_ext_Gpu2d_pointerY") ret Float

func pointerY() ret Float {
  unsafe {
    ret nativePointerY()
  }
}

# Multitouch (#526): active finger count + per-finger position in design units.
# On desktop this is 0 (use the mouse pointer); on iOS every touch is reported so
# a UI can drive a joystick with one finger and the camera with another.
func nativeTouchCount() mainThread unsafe extern("rae_ext_Gpu2d_touchCount") ret Int

func touchCount() ret Int {
  unsafe {
    ret nativeTouchCount()
  }
}

func nativeTouchX(index: Int) mainThread unsafe extern("rae_ext_Gpu2d_touchX") ret Float

func touchX(index: copy Int) ret Float {
  unsafe {
    ret nativeTouchX(index: index)
  }
}

func nativeTouchY(index: Int) mainThread unsafe extern("rae_ext_Gpu2d_touchY") ret Float

func touchY(index: copy Int) ret Float {
  unsafe {
    ret nativeTouchY(index: index)
  }
}

# Stable finger id (grab a finger at press, hold it for the whole drag) + whether
# it went down this frame (edge). id is -1 out of range.
func nativeTouchId(index: Int) mainThread unsafe extern("rae_ext_Gpu2d_touchId") ret Int

func touchId(index: copy Int) ret Int {
  unsafe {
    ret nativeTouchId(index: index)
  }
}

func nativeTouchPressed(index: Int) mainThread unsafe extern("rae_ext_Gpu2d_touchPressed") ret Bool

func touchPressed(index: copy Int) ret Bool {
  unsafe {
    ret nativeTouchPressed(index: index)
  }
}

# OS safe-area insets (notch / home indicator / rounded corners) in design units.
# 0 on platforms without insets. Lay HUD + UI chrome inside these.
func nativeSafeTop() mainThread unsafe extern("rae_ext_Gpu2d_safeTop") ret Float

func safeTop() ret Float {
  unsafe {
    ret nativeSafeTop()
  }
}

func nativeSafeBottom() mainThread unsafe extern("rae_ext_Gpu2d_safeBottom") ret Float

func safeBottom() ret Float {
  unsafe {
    ret nativeSafeBottom()
  }
}

func nativeSafeLeft() mainThread unsafe extern("rae_ext_Gpu2d_safeLeft") ret Float

func safeLeft() ret Float {
  unsafe {
    ret nativeSafeLeft()
  }
}

func nativeSafeRight() mainThread unsafe extern("rae_ext_Gpu2d_safeRight") ret Float

func safeRight() ret Float {
  unsafe {
    ret nativeSafeRight()
  }
}

# A mouse button. A finger and a pen's tip are the primary one.
enum PointerButton { primary, middle, secondary }

# The button as SDL numbers it
func pointerButtonNumber(button: copy PointerButton) ret Int {
  match button {
    case PointerButton.primary {
      ret 1
    }
    case PointerButton.middle {
      ret 2
    }
    case PointerButton.secondary {
      ret 3
    }
  }
}

func nativeButtonDown(button: Int) mainThread unsafe extern("rae_ext_Gpu2d_buttonDown") ret Bool

# `button` is held
func buttonDown(button: copy PointerButton) ret Bool {
  unsafe {
    ret nativeButtonDown(button: pointerButtonNumber(button: button))
  }
}

func nativeButtonPressed(
  button: Int
) mainThread unsafe extern("rae_ext_Gpu2d_buttonPressed") ret Bool

# `button` went down this frame
func buttonPressed(button: copy PointerButton) ret Bool {
  unsafe {
    ret nativeButtonPressed(button: pointerButtonNumber(button: button))
  }
}

func nativeButtonReleased(
  button: Int
) mainThread unsafe extern("rae_ext_Gpu2d_buttonReleased") ret Bool

# `button` came up this frame
func buttonReleased(button: copy PointerButton) ret Bool {
  unsafe {
    ret nativeButtonReleased(button: pointerButtonNumber(button: button))
  }
}

func nativeButtonClicks(button: Int) mainThread unsafe extern("rae_ext_Gpu2d_buttonClicks") ret Int

# Which click of a series the last press of `button` was: 1 a click, 2 a double click, 3 a triple
# one (by the system's own interval); 0 before the first press
func buttonClicks(button: copy PointerButton) ret Int {
  unsafe {
    ret nativeButtonClicks(button: pointerButtonNumber(button: button))
  }
}

func nativeSetEscapeQuits(on: Bool) mainThread unsafe extern("rae_ext_Gpu2d_setEscapeQuits")

# Whether Escape closes the window (pollClose answers true), as it does unless told not to. A
# program where Escape means something else (a menu, a dialog) turns it off.
func setEscapeQuits(on: copy Bool) {
  unsafe {
    nativeSetEscapeQuits(on: on)
  }
}

func nativeEscapeQuits() mainThread unsafe extern("rae_ext_Gpu2d_escapeQuits") ret Bool

func escapeQuits() ret Bool {
  unsafe {
    ret nativeEscapeQuits()
  }
}

# Left mouse button held this frame.
func nativePointerDown() mainThread unsafe extern("rae_ext_Gpu2d_pointerDown") ret Bool

func pointerDown() ret Bool {
  unsafe {
    ret nativePointerDown()
  }
}

func nativePointerPressed() mainThread unsafe extern("rae_ext_Gpu2d_pointerPressed") ret Bool

func pointerPressed() ret Bool {
  unsafe {
    ret nativePointerPressed()
  }
}

func nativePointerReleased() mainThread unsafe extern("rae_ext_Gpu2d_pointerReleased") ret Bool

func pointerReleased() ret Bool {
  unsafe {
    ret nativePointerReleased()
  }
}

# Per-frame mouse-wheel / trackpad delta (positive = scrolled up), matching
# raylib's getMouseWheelMove semantics.
func nativeWheelMove() mainThread unsafe extern("rae_ext_Gpu2d_wheelMove") ret Float

func wheelMove() ret Float {
  unsafe {
    ret nativeWheelMove()
  }
}

# Desktop cursor kind. 0=arrow, 1=pointer/hand, 2=text, 3=horizontal resize,
# 4=vertical resize, 5=crosshair, 6=not-allowed.
func nativeSetMouseCursor(kind: Int) mainThread unsafe extern("rae_ext_Gpu2d_setMouseCursor")

func setMouseCursor(kind: copy Int) {
  unsafe {
    nativeSetMouseCursor(kind: kind)
  }
}

# Monotonic wall-clock seconds since process start (for scroll/animation timing).
# Epoch seconds. Float64 deliberately: as f32 two calls one frame apart
# return the SAME value (~1.7e9 has ~128s granularity), so every frame delta
# would be exactly 0.0. See docs/primitive-types.md.
func nativeNowSeconds() unsafe extern("rae_ext_Gpu2d_nowSeconds") ret Float64

func nowSeconds() ret Float64 {
  unsafe {
    ret nativeNowSeconds()
  }
}
