# Math and Random library for Rae
func rae_popcount(x: Int) unsafe extern ret Int

func rae_leading_zeros(x: Int) unsafe extern ret Int

func rae_trailing_zeros(x: Int) unsafe extern ret Int

func nativeTrailingZerosUInt64(x: UInt64) unsafe extern("rae_ext_Math_trailingZerosUInt64") ret Int

func nativeTrailingZerosUInt32(x: UInt32) unsafe extern("rae_ext_Math_trailingZerosUInt32") ret Int

func nativeTrailingZerosInt32(x: Int32) unsafe extern("rae_ext_Math_trailingZerosInt32") ret Int

func nativeSin(x: Float) unsafe extern("rae_ext_Math_sin") ret Float

func sin(x: copy Float) ret Float {
  unsafe {
    ret nativeSin(x: x)
  }
}

