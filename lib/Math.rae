# pi, and tau = 2*pi (one full turn in radians). Compile-time constants, used
# directly (no call): `random.nextFloat() * tau`.
const pi: Float = 3.14159265358979323846

const tau: Float = pi * 2.0

# A pseudo-random number generator as a value its owner holds (no hidden
# global, so two owners — two threads, two systems — never share a stream).
# Same seed, same numbers, on every platform: a 64-bit linear congruential
# step (Knuth's MMIX multiplier) whose high 32 bits are the output.
type Random {
  state: Int
}

# The seed a program used when it never seeded the former global generator;
# `createRandom(seed: defaultRandomSeed)` gives that same sequence.
const defaultRandomSeed: Int = 1311768467463790320

func createRandom(seed: view Int) ret Random {
  ret Random { state: seed }
}

# The next 32 random bits, 0 .. 4294967295
func nextBits(this: mod Random) ret Int {
  this.state = this.state * 6364136223846793005 + 1
  ret (this.state shr 32) bitand 4294967295
}

# A Float in 0.0 ..= 1.0
func nextFloat(this: mod Random) ret Float {
  let bits: Int = this.nextBits()
  ret ((bits as Float64) / 4294967295.0) as Float
}

# An Int in min ..= max (min when max <= min)
func nextInt(this: mod Random, min: view Int, max: view Int) ret Int {
  if min >= max {
    ret min
  }
  let bits: Int = this.nextBits()
  let range: Int = max - min + 1
  if range <= 0 {
    # The range is wider than Int: every 32-bit value fits in it.
    ret min + bits
  }
  ret min + bits % range
}

# Bit intrinsics over the 64-bit two's-complement Int. popcount = number of set
# bits; leadingZeros/trailingZeros count zero bits above the highest / below the
# lowest set bit, and are 64 for an input of 0 (the CPU instructions are
# undefined on 0, so this pins a defined answer). Each is one CPU instruction:
# the runtime defines them inline (rae_runtime.h). trailingZeros also takes
# UInt64 (a bitset word: the physics port walks set bits with it), UInt32 and
# Int32; the 32-bit forms answer 32 for 0.
func popcount(x: view Int) ret Int {
  unsafe {
    ret rae_popcount(x: x)
  }
}

func leadingZeros(x: view Int) ret Int {
  unsafe {
    ret rae_leading_zeros(x: x)
  }
}

func trailingZeros(x: view Int) ret Int {
  unsafe {
    ret rae_trailing_zeros(x: x)
  }
}

func trailingZeros(x: view UInt64) ret Int {
  unsafe {
    ret nativeTrailingZerosUInt64(x: x)
  }
}

func trailingZeros(x: view UInt32) ret Int {
  unsafe {
    ret nativeTrailingZerosUInt32(x: x)
  }
}

func trailingZeros(x: view Int32) ret Int {
  unsafe {
    ret nativeTrailingZerosInt32(x: x)
  }
}

func abs(value: view Int) ret Int {
  if value < 0 {
    ret -value
  }
  ret value
}

func abs(value: view Float) ret Float {
  if value < 0.0 {
    ret -value
  }
  ret value
}

func min(a: view Int, b: view Int) ret Int {
  if a < b {
    ret a
  }
  ret b
}

func min(a: view Float, b: view Float) ret Float {
  if a < b {
    ret a
  }
  ret b
}

func max(a: view Int, b: view Int) ret Int {
  if a > b {
    ret a
  }
  ret b
}

func max(a: view Float, b: view Float) ret Float {
  if a > b {
    ret a
  }
  ret b
}

func clamp(val: view Int, low: view Int, high: view Int) ret Int {
  if val < low {
    ret low
  }
  if val > high {
    ret high
  }
  ret val
}

func clamp(val: view Float, low: view Float, high: view Float) ret Float {
  if val < low {
    ret low
  }
  if val > high {
    ret high
  }
  ret val
}

func lerp(a: view Float, b: view Float, t: view Float) ret Float {
  ret a + (b - a) * t
}
