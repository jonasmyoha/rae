# Math and Random library for Rae
func rae_seed(n: Int) unsafe extern

func rae_random() unsafe extern ret Float

func rae_random_int(min: Int, max: Int) unsafe extern ret Int

func rae_popcount(x: Int) unsafe extern ret Int

func rae_leading_zeros(x: Int) unsafe extern ret Int

func rae_trailing_zeros(x: Int) unsafe extern ret Int

func nativeSin(x: Float) unsafe extern("rae_ext_Math_sin") ret Float

func sin(x: copy Float) ret Float {
  unsafe {
    ret nativeSin(x: x)
  }
}

func nativeCos(x: Float) unsafe extern("rae_ext_Math_cos") ret Float

func cos(x: copy Float) ret Float {
  unsafe {
    ret nativeCos(x: x)
  }
}

func nativeTan(x: Float) unsafe extern("rae_ext_Math_tan") ret Float

func tan(x: copy Float) ret Float {
  unsafe {
    ret nativeTan(x: x)
  }
}

func nativeAsin(x: Float) unsafe extern("rae_ext_Math_asin") ret Float

func asin(x: copy Float) ret Float {
  unsafe {
    ret nativeAsin(x: x)
  }
}

func nativeAcos(x: Float) unsafe extern("rae_ext_Math_acos") ret Float

func acos(x: copy Float) ret Float {
  unsafe {
    ret nativeAcos(x: x)
  }
}

func nativeAtan(x: Float) unsafe extern("rae_ext_Math_atan") ret Float

func atan(x: copy Float) ret Float {
  unsafe {
    ret nativeAtan(x: x)
  }
}

func nativeAtan2(y: Float, x: Float) unsafe extern("rae_ext_Math_atan2") ret Float

func atan2(y: copy Float, x: copy Float) ret Float {
  unsafe {
    ret nativeAtan2(y: y, x: x)
  }
}

func nativeSqrt(x: Float) unsafe extern("rae_ext_Math_sqrt") ret Float

func sqrt(x: copy Float) ret Float {
  unsafe {
    ret nativeSqrt(x: x)
  }
}

func nativePow(base: Float, exp: Float) unsafe extern("rae_ext_Math_pow") ret Float

func pow(base: copy Float, exp: copy Float) ret Float {
  unsafe {
    ret nativePow(base: base, exp: exp)
  }
}

func nativeExp(x: Float) unsafe extern("rae_ext_Math_exp") ret Float

func exp(x: copy Float) ret Float {
  unsafe {
    ret nativeExp(x: x)
  }
}

func nativeNaturalLog(x: Float) unsafe extern("rae_ext_Math_math_log") ret Float

func naturalLog(x: copy Float) ret Float {
  unsafe {
    ret nativeNaturalLog(x: x)
  }
}

func nativeFloor(x: Float) unsafe extern("rae_ext_Math_floor") ret Float

func floor(x: copy Float) ret Float {
  unsafe {
    ret nativeFloor(x: x)
  }
}

func nativeCeil(x: Float) unsafe extern("rae_ext_Math_ceil") ret Float

func ceil(x: copy Float) ret Float {
  unsafe {
    ret nativeCeil(x: x)
  }
}

func nativeRound(x: Float) unsafe extern("rae_ext_Math_round") ret Float

func round(x: copy Float) ret Float {
  unsafe {
    ret nativeRound(x: x)
  }
}

# pi, and tau = 2*pi (one full turn in radians). Compile-time constants, used
# directly (no call): `random() * tau`.
const pi: Float = 3.14159265358979323846

const tau: Float = pi * 2.0

func seed(value: view Int) {
  unsafe {
    rae_seed(value: value)
  }
}

func random() ret Float {
  unsafe {
    ret rae_random()
  }
}

func random(min: view Int, max: view Int) ret Int {
  unsafe {
    ret rae_random_int(min: min, max: max)
  }
}

# Bit intrinsics over the 64-bit two's-complement Int. popcount = number of set
# bits; leadingZeros/trailingZeros count zero bits above the highest / below the
# lowest set bit, and are 64 for an input of 0 (the CPU instructions are
# undefined on 0, so this pins a defined answer).
func popcount(x: view Int) ret Int {
  unsafe {
    ret rae_popcount(x: x)
  }
}

func leadingZeros(x: view Int) ret Int {
  unsafe {
    ret rae_leading_zeros(x: x)
  }
}

func trailingZeros(x: view Int) ret Int {
  unsafe {
    ret rae_trailing_zeros(x: x)
  }
}

func abs(value: view Int) ret Int {
  if value < 0 {
    ret -value
  }
  ret value
}

func abs(value: view Float) ret Float {
  if value < 0.0 {
    ret -value
  }
  ret value
}

func min(a: view Int, b: view Int) ret Int {
  if a < b {
    ret a
  }
  ret b
}

func min(a: view Float, b: view Float) ret Float {
  if a < b {
    ret a
  }
  ret b
}

func max(a: view Int, b: view Int) ret Int {
  if a > b {
    ret a
  }
  ret b
}

func max(a: view Float, b: view Float) ret Float {
  if a > b {
    ret a
  }
  ret b
}

func clamp(val: view Int, low: view Int, high: view Int) ret Int {
  if val < low {
    ret low
  }
  if val > high {
    ret high
  }
  ret val
}

func clamp(val: view Float, low: view Float, high: view Float) ret Float {
  if val < low {
    ret low
  }
  if val > high {
    ret high
  }
  ret val
}

func lerp(a: view Float, b: view Float, t: view Float) ret Float {
  ret a + (b - a) * t
}

func randomFloat(min: view Float, max: view Float) ret Float {
  unsafe {
    ret min + rae_random() * (max - min)
  }
}

# Alias: prefer the explicit `randomInt` name in new code. The existing
# overloaded `random(min, max)` stays for backward compatibility.
func randomInt(min: view Int, max: view Int) ret Int {
  unsafe {
    ret rae_random_int(min: min, max: max)
  }
}
