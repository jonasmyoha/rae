# Frame profiler — captures nested CPU timing zones + counters and dumps them as
# a Chrome Trace Event JSON file, viewable at https://ui.perfetto.dev (or
# chrome://tracing) with a full SQL query engine over the trace. There is NO
# in-engine viewer: Perfetto is far better than anything we would build.
#
# The events go through the event recorder (lib/perf/Perf, docs/perf-tools-design.md
# §3.4): a capture owns a PerfHub whose window holds the capture's events, the main
# loop writes into its own ring, and a thread that is measured writes into a ring of
# its own (profileThreadRing). The trace has one lane (`tid`) per ring, named after
# its thread, and the GPU as a process of its own: its counters (gpu.*) and spans.
#
# Usage in an app:
#   maybeAutoStart()                 # once at startup (reads RAE_PROFILE*)
#   ... each frame ...
#   zoneBegin(name: "shadow") ... zoneEnd(name: "shadow")   # nest freely
#   counter(name: "fps", value: fps)
#   tick()                           # once per frame; collects, auto-stops + writes
#
# Environment (zero-UI capture, works on desktop AND iPhone):
#   RAE_PROFILE=1                start a capture at launch
#   RAE_PROFILE_SECONDS=20       capture length (default 20s)
#   RAE_PROFILE_OUT=path.json    output path (default rae_profile.json; on iOS the
#                                cwd is the app's Documents dir, pulled like rae.log)
#
# Overhead when NOT capturing is a single bool test per zone call. While capturing a
# zone is a name lookup and one event pushed into the ring (no allocation once the
# name is known); all string and file work is deferred to stop time so it never
# skews the frames it measures.
import Math
import Sys
import String
open collections/StringMap
open perf/Perf
open perf/GpuClock

# Cap the event window so a runaway capture can't exhaust memory. 300k events is
# ~30s at 60fps with ~160 zones/frame; past it the oldest events are let go
# (flagged in the log).
const profMaxEvents: Int = 300000

# The lane of the main loop's ring, the first of a capture
const profMainThreadName: String = "CPU main loop"

# The frame profiler as an App-owned resource (#764). Every profiling call takes
# the profiler, so a capture's lifetime and owner are explicit. Outside a capture
# the hub is a small one with no rings; startCapture makes the capture's hub.
type Profiler {
  capturing: Bool
  startNs: Int
  endNs: Int
  outPath: String
  # the capture's events (lib/perf/Perf)
  hub: PerfHub
  # the main loop's ring (none outside a capture)
  mainRing: opt PerfRing
  # a zone or counter name's id in the hub
  nameIds: StringMap(Int)
  # the hub's first name the program registered (the runtime's come before it)
  firstOwnName: Int = 0
  # the GPU's timestamps on the CPU's clock (perf/GpuClock), and the last GPU sample written for
  # each timing (its first pass's name -> that sample's last end)
  gpuClock: PerfGpuClock = PerfGpuClock {}
  gpuSamplesWritten: StringMap(Int)
}

func idlePerfSettings() ret PerfSettings {
  ret PerfSettings { windowSeconds: 1, windowEvents: 1, ringEvents: 2, frameRecords: 1 }
}

# A profiler that is not capturing. Owned by the App / the example's main.
func createProfiler() ret Profiler {
  unsafe {
    ret Profiler {
      capturing: false
      startNs: 0
      endNs: 0
      outPath: "rae_profile.json"
      hub: createPerfHub(settings: idlePerfSettings())
      mainRing: none
      nameIds: StringMap.create(Int, cap: 8)
      gpuSamplesWritten: StringMap.create(Int, cap: 4)
    }
  }
}

func capturing(profiler: view Profiler) ret Bool {
  ret profiler.capturing
}

# Begin a capture of `seconds`, writing to `outPath` when it ends. The hub's window is
# allocated up front so recording never allocates.
func startCapture(profiler: mod Profiler, seconds: view Float, outPath: view String) {
  unsafe {
    profileDiscard(profiler: profiler)
    let windowSeconds: Int = rae_float_to_int(f: seconds) + 2
    let settings: PerfSettings = {
      windowSeconds: windowSeconds
      windowEvents: profMaxEvents
      ringEvents: 16384
      frameRecords: 4096
    }
    profiler.hub = createPerfHub(settings: settings)
    profiler.nameIds = StringMap.create(Int, cap: 64)
    let mainRing: PerfRing = profiler.hub.perfThreadRing(name: profMainThreadName)
    # the runtime's work too: the pool's workers on lanes of their own, the waits as spans
    profiler.hub.perfInstallRuntime(mainRing: mainRing)
    profiler.firstOwnName = profiler.hub.perfNameCount()
    profiler.mainRing = mainRing
    profiler.startNs = nowNs()
    profiler.endNs = profiler.startNs + rae_float_to_int(f: seconds * 1000000000.0)
    profiler.outPath = "{outPath}"
    profiler.capturing = true
  }
}

# Start a capture from the environment if RAE_PROFILE is set. Call once at startup.
func maybeAutoStart(profiler: mod Profiler) {
  let flag: String = Sys.getEnv(name: "RAE_PROFILE")
  if flag.length() is 0 {
    ret
  }
  var seconds: Float = 20.0
  let secondsText: String = Sys.getEnv(name: "RAE_PROFILE_SECONDS")
  if secondsText.length() > 0 {
    seconds = secondsText.toFloat()
  }
  var out: String = "rae_profile.json"
  let outEnv: String = Sys.getEnv(name: "RAE_PROFILE_OUT")
  if outEnv.length() > 0 {
    out = "{outEnv}"
  }
  startCapture(profiler: profiler, seconds: seconds, outPath: out)
}

# The capture's id of `name`, registered on its first use
func profNameId(profiler: mod Profiler, name: view String) ret PerfName {
  if let id: Int = profiler.nameIds.get(k: name) {
    ret PerfName { id: id }
  }
  let perfName: PerfName = profiler.hub.perfName(name: name)
  profiler.nameIds.set(k: name, value: perfName.id)
  ret perfName
}

# A ring for another thread's events while the capture runs, its lane named `name`
# (lib/perf/Perf perfZoneBegin and the others write into it, with names from
# profileName). None outside a capture. Made on the main thread, handed to the
# thread; it is freed when the capture ends, so the thread stops writing first.
func profileThreadRing(profiler: mod Profiler, name: view String) ret opt PerfRing {
  if profiler.capturing is false {
    ret none
  }
  ret profiler.hub.perfThreadRing(name: name)
}

# A name for a thread's writes into its ring (profileThreadRing)
func profileName(profiler: mod Profiler, name: view String) ret PerfName {
  ret profNameId(profiler: profiler, name: name)
}

func profWrite(
  profiler: mod Profiler
  kind: view PerfKind
  name: view String
  value: view Int
) {
  let perfName: PerfName = profNameId(profiler: profiler, name: name)
  if let ring: view PerfRing = profiler.mainRing {
    perfWrite(
      ring: ring
      kind: kind
      name: perfName
      value: value
      extra: 0
    )
  }
}

# Open a timing zone on the CPU main-loop lane. Cheap no-op when not capturing.
# Zones must be strictly nested (LIFO) — every zoneBegin needs a matching zoneEnd,
# which the Chrome format relies on to build the flame graph.
func zoneBegin(profiler: mod Profiler, name: view String) {
  if profiler.capturing is false {
    ret
  }
  profWrite(
    profiler: profiler
    kind: PerfKind.zoneBegin
    name: name
    value: 0
  )
}

func zoneEnd(profiler: mod Profiler, name: view String) {
  if profiler.capturing is false {
    ret
  }
  profWrite(
    profiler: profiler
    kind: PerfKind.zoneEnd
    name: name
    value: 0
  )
}

# A single-value time series (fps, draw count, RSS, caster count, …). Perfetto
# plots these as a track you can overlay against the zones. A name that starts with
# "gpu." is a GPU number and goes on the GPU's lane.
func counter(profiler: mod Profiler, name: view String, value: view Int) {
  if profiler.capturing is false {
    ret
  }
  profWrite(
    profiler: profiler
    kind: PerfKind.counter
    name: name
    value: value
  )
}

# A moment on the CPU main-loop lane (an instant in the trace), with a number of its own
func mark(profiler: mod Profiler, name: view String, extra: view Int) {
  if profiler.capturing is false {
    ret
  }
  let perfName: PerfName = profNameId(profiler: profiler, name: name)
  if let ring: view PerfRing = profiler.mainRing {
    perfMark(ring: ring, name: perfName, extra: extra)
  }
}

# A GPU sample's passes as spans on the GPU's lane: `beginNs` / `endNs` on the GPU's clock, put on
# the CPU's by the capture's PerfGpuClock from the sample's bounds (`cpuBeforeNs` when its frame
# began, `cpuSeenNs` when it was read); and the clock's offset and drift as counters. A sample is
# written once, however often it is handed in. A slot is not a cost on a tile GPU
# (docs/profiling.md): the span says when the GPU stamped, not what the pass took.
func gpuSpans(
  profiler: mod Profiler
  names: view List(String)
  beginNs: view List(Int)
  endNs: view List(Int)
  cpuBeforeNs: view Int
  cpuSeenNs: view Int
) {
  if profiler.capturing is false or names.length is 0 or beginNs.length is not names.length {
    ret
  }
  var lastEnd: Int = 0
  loop let end: Int in endNs {
    if end > lastEnd {
      lastEnd = end
    }
  }
  let key: String = names.copyAtDefault(index: 0)
  if let written: Int = profiler.gpuSamplesWritten.get(k: key) {
    if written is lastEnd {
      ret
    }
  }
  profiler.gpuSamplesWritten.set(k: key, value: lastEnd)
  if cpuBeforeNs <= 0 or cpuSeenNs <= 0 {
    ret
  }
  gpuClockSample(
    clock: profiler.gpuClock
    cpuBeforeNs: cpuBeforeNs
    gpuBeginNs: beginNs.copyAtDefault(index: 0)
    gpuEndNs: lastEnd
    cpuSeenNs: cpuSeenNs
  )
  loop var i: Int = 0, i < names.length, ++i {
    let begin: Int = beginNs.copyAtDefault(index: i)
    let end: Int = endNs.copyAtDefault(index: i)
    if end > begin and begin > 0 {
      let perfName: PerfName = profNameId(profiler: profiler, name: names.copyAtDefault(index: i))
      if let ring: view PerfRing = profiler.mainRing {
        perfWriteAt(
          ring: ring
          kind: PerfKind.gpuSpan
          name: perfName
          time: gpuClockToCpu(clock: profiler.gpuClock, gpuNs: begin)
          value: gpuClockToCpu(clock: profiler.gpuClock, gpuNs: end)
          extra: i
        )
      }
    }
  }
  counter(profiler: profiler, name: "gpu.clock offset us", value: profiler.gpuClock.offsetNs / 1000)
  counter(profiler: profiler, name: "gpu.clock drift ns per s", value: profiler.gpuClock.driftNs)
}

# Call once per frame. Collects the rings into the capture's window, and auto-stops
# and writes the trace when the capture window elapses. Returns true on the frame
# it wrote the file.
func tick(profiler: mod Profiler) ret Bool {
  if profiler.capturing is false {
    ret false
  }
  profiler.hub.perfFrame()
  if nowNs() < profiler.endNs {
    ret false
  }
  ret profileStop(profiler: profiler)
}

# Stop early and write immediately. Returns true if the file was written.
func profileStop(profiler: mod Profiler) ret Bool {
  if profiler.capturing is false {
    ret false
  }
  profiler.hub.perfFrame()
  let ok: Bool = write(profiler: profiler, path: profiler.outPath)
  profileDiscard(profiler: profiler)
  ret ok
}

# End the capture without writing it: its rings freed, the hub small again
func profileDiscard(profiler: mod Profiler) {
  profiler.capturing = false
  profiler.hub.freePerfHub()
  profiler.hub = createPerfHub(settings: idlePerfSettings())
  profiler.mainRing = none
  profiler.firstOwnName = 0
}

# The names the program used in the capture, in the order of their first use (the runtime's own,
# such as "chunk" and "Task.get", left out)
func capturedNames(profiler: view Profiler) ret List(String) {
  var names: List(String) = {}
  loop var i: Int = profiler.firstOwnName, i < profiler.hub.perfNameCount(), ++i {
    names.add(value: profiler.hub.perfNameText(nameId: i))
  }
  ret names
}

# Nanoseconds as the trace's microseconds, to the nanosecond ("12.034")
func traceMicroseconds(nanoseconds: view Int) ret String {
  let fraction: Int = nanoseconds % 1000
  if fraction < 10 {
    ret "{nanoseconds / 1000}.00{fraction}"
  }
  if fraction < 100 {
    ret "{nanoseconds / 1000}.0{fraction}"
  }
  ret "{nanoseconds / 1000}.{fraction}"
}

# The GPU's process in the trace: its counters and spans, apart from the threads
const profGpuPid: Int = 2

# One trace event object, or "" for a kind the trace does not show. Literal JSON
# braces are `\{` / `\}`; `{expr}` is Rae interpolation. Zone names are static
# identifiers, so no JSON escaping of the name is needed.
func profFragment(
  event: view PerfEvent
  name: view String
  tid: view Int
  startNs: view Int
) ret String {
  let ts: String = traceMicroseconds(nanoseconds: event.time - startNs)
  if event.kind is PerfKind.counter {
    var pid: Int = 1
    if name.startsWith(prefix: "gpu.") {
      pid = profGpuPid
    }
    ret "\{\"name\":\"{name}\",\"ph\":\"C\",\"ts\":{ts},\"pid\":{pid},\"tid\":{tid},\"args\":\{\"v\":{event.value}\}\}"
  }
  if event.kind is PerfKind.zoneBegin {
    if event.value is 0 and event.extra is 0 {
      ret "\{\"name\":\"{name}\",\"ph\":\"B\",\"ts\":{ts},\"pid\":1,\"tid\":{tid}\}"
    }
    # a chunk's iterations and index, a parallelLoop's iterations
    ret "\{\"name\":\"{name}\",\"ph\":\"B\",\"ts\":{ts},\"pid\":1,\"tid\":{tid},\"args\":\{\"value\":{event.value},\"index\":{event.extra}\}\}"
  }
  # a wait is a span of its own category, so a view can color it
  if event.kind is PerfKind.waitBegin {
    ret "\{\"name\":\"{name}\",\"cat\":\"wait\",\"ph\":\"B\",\"ts\":{ts},\"pid\":1,\"tid\":{tid}\}"
  }
  if event.kind is PerfKind.zoneEnd or event.kind is PerfKind.waitEnd {
    ret "\{\"name\":\"{name}\",\"ph\":\"E\",\"ts\":{ts},\"pid\":1,\"tid\":{tid}\}"
  }
  # a flow (a spawn to its task's run): its id is the value, extra 0 its start, 1 its end
  if event.kind is PerfKind.flow {
    if event.extra is 0 {
      ret "\{\"name\":\"{name}\",\"cat\":\"flow\",\"ph\":\"s\",\"id\":{event.value},\"ts\":{ts},\"pid\":1,\"tid\":{tid}\}"
    }
    ret "\{\"name\":\"{name}\",\"cat\":\"flow\",\"ph\":\"f\",\"bp\":\"e\",\"id\":{event.value},\"ts\":{ts},\"pid\":1,\"tid\":{tid}\}"
  }
  if event.kind is PerfKind.mark {
    ret "\{\"name\":\"{name}\",\"ph\":\"i\",\"s\":\"t\",\"ts\":{ts},\"pid\":1,\"tid\":{tid},\"args\":\{\"extra\":{event.extra}\}\}"
  }
  if event.kind is PerfKind.gpuSpan {
    let duration: String = traceMicroseconds(nanoseconds: event.value - event.time)
    # a Metal command buffer is the GPU's own busy time, on a lane of its own
    if name is "command buffer" {
      ret "\{\"name\":\"{name}\",\"ph\":\"X\",\"ts\":{ts},\"dur\":{duration},\"pid\":{profGpuPid},\"tid\":1\}"
    }
    ret "\{\"name\":\"{name}\",\"ph\":\"X\",\"ts\":{ts},\"dur\":{duration},\"pid\":{profGpuPid},\"tid\":0,\"args\":\{\"note\":\"a slot, not a cost on a tile GPU\"\}\}"
  }
  ret ""
}

# Join with `sep` in sqrt(n)-sized blocks. A single left-fold join is O(n^2) in
# total bytes copied (the accumulator is recopied every step); blocking makes it
# O(n*sqrt(n)) — sub-second for tens of thousands of events instead of tens of
# seconds. Deferred to stop time, so it never touches a measured frame.
func joinBlocked(frags: view List(String), blockSize: view Int) ret String {
  let n: Int = frags.length
  if n is 0 {
    ret ""
  }
  var blocks: List(String) = List.create(String, cap: n / blockSize + 2)
  var i: Int = 0
  loop i < n {
    let stop: Int = Math.min(a: i + blockSize, b: n)
    var block: String = frags.copyAtDefault(index: i)
    loop var j: Int = i + 1, j < stop, ++j {
      block = block.concat(other: ",").concat(other: frags.copyAtDefault(index: j))
    }
    blocks.add(value: block)
    i = stop
  }
  ret blocks.join(sep: ",")
}

# The lanes' names: the CPU process with a thread per ring, and the GPU process
func profLaneNames(profiler: view Profiler, frags: mod List(String)) {
  frags.add(
    value: "\{\"name\":\"process_name\",\"ph\":\"M\",\"pid\":1,\"args\":\{\"name\":\"CPU\"\}\}"
  )
  frags.add(
    value: "\{\"name\":\"process_name\",\"ph\":\"M\",\"pid\":{profGpuPid},\"args\":\{\"name\":\"GPU\"\}\}"
  )
  frags.add(
    value: "\{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":{profGpuPid},\"tid\":0,\"args\":\{\"name\":\"GPU passes\"\}\}"
  )
  frags.add(
    value: "\{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":{profGpuPid},\"tid\":1,\"args\":\{\"name\":\"Metal command buffers\"\}\}"
  )
  loop var ring: Int = 0, ring < profiler.hub.ringNames.length, ++ring {
    let threadName: String = profiler.hub.ringNames.copyAtDefault(index: ring)
    frags.add(
      value: "\{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":{ring},\"args\":\{\"name\":\"{threadName}\"\}\}"
    )
  }
}

# The capture's window as a trace at `path`
func write(profiler: view Profiler, path: view String) ret Bool {
  let hub: view PerfHub = profiler.hub
  let first: Int = hub.perfOldest()
  let end: Int = hub.perfWritten()
  var frags: List(String) = List.create(String, cap: end - first + 8)
  profLaneNames(profiler: profiler, frags: frags)
  var count: Int = 0
  loop var number: Int = first, number < end, ++number {
    let event: PerfEvent = hub.perfEventAt(number: number)
    let fragment: String = profFragment(
      event: event
      name: hub.perfNameText(nameId: event.nameId as Int)
      tid: hub.perfEventRing(number: number)
      startNs: profiler.startNs
    )
    if fragment.length() > 0 {
      frags.add(value: fragment)
      count = count + 1
    }
  }
  let body: String = joinBlocked(frags: frags, blockSize: 256)
  let json: String = "\{\"traceEvents\":[".concat(other: body).concat(other: "]\}")
  let ok: Bool = Sys.writeFile(path: path, content: json)
  if ok {
    log("profile: wrote {count} events to {path}")
  } else {
    log("profile: FAILED to write {path}")
  }
  let dropped: Int = hub.perfDropped()
  if first > 0 or dropped > 0 {
    log(
      "profile: WARNING {first} events past the window of {profMaxEvents} and {dropped} past a full ring were let go: trace truncated"
    )
  }
  ret ok
}
