# Frame profiler — captures nested CPU timing zones + counters and dumps them as
# a Chrome Trace Event JSON file, viewable at https://ui.perfetto.dev (or
# chrome://tracing) with a full SQL query engine over the trace. There is NO
# in-engine viewer: Perfetto is far better than anything we would build, and the
# format is task/thread aware (each `tid` is its own lane, so concurrent CPU and
# GPU work show side by side).
#
# Usage in an app:
#   maybeAutoStart()                 # once at startup (reads RAE_PROFILE*)
#   ... each frame ...
#   zoneBegin(name: "shadow") ... zoneEnd(name: "shadow")   # nest freely
#   counter(name: "fps", value: fps)
#   tick()                           # once per frame; auto-stops + writes
#
# Environment (zero-UI capture, works on desktop AND iPhone):
#   RAE_PROFILE=1                start a capture at launch
#   RAE_PROFILE_SECONDS=20       capture length (default 20s)
#   RAE_PROFILE_OUT=path.json    output path (default rae_profile.json; on iOS the
#                                cwd is the app's Documents dir, pulled like rae.log)
#
# Overhead when NOT capturing is a single bool test per zone call; all string and
# file work is deferred to stop time so it never skews the frames it measures.
import Sys
import String

# Cap the event buffer so a runaway capture can't exhaust memory. 300k events is
# ~30s at 60fps with ~160 zones/frame; excess is dropped (flagged in the trace).
const profMaxEvents: Int = 300000

# Phase codes stored per event; mapped to Chrome Trace `ph` chars at write time.
const profPhBegin: Int = 0    # "B"
const profPhEnd: Int = 1      # "E"
const profPhCounter: Int = 2  # "C"

# The frame profiler as an App-owned resource (#764). Was a set of module-level
# gProf* globals; every profiling call now takes the profiler, so a capture's
# lifetime and owner are explicit. The parallel arrays are one slot per event,
# kept small until a capture starts then reallocated to the full cap so no
# growth allocates mid-frame.
type Profiler {
  capturing: Bool
  startNs: Int
  endNs: Int
  outPath: String
  dropped: Bool
  names: List(String)
  phases: List(Int)
  times: List(Int)
  tids: List(Int)
  values: List(Int)
}

# A profiler that is not capturing. Buffers start tiny; startCapture
# reallocates them to the full cap. Owned by the App / the example's main.
func createProfiler() pub ret Profiler {
  ret Profiler {
    capturing: false, startNs: 0, endNs: 0, outPath: "rae_profile.json", dropped: false,
    names: createList(String, cap: 1),
    phases: createList(Int, cap: 1),
    times: createList(Int, cap: 1),
    tids: createList(Int, cap: 1),
    values: createList(Int, cap: 1)
  }
}

func capturing(profiler: view Profiler) pub ret Bool { ret profiler.capturing }

# Begin a capture of `seconds`, writing to `outPath` when it ends. Reallocates the
# event buffers up front so recording never allocates.
func startCapture(profiler: mod Profiler, seconds: view Float, outPath: view String) pub {
  profiler.names = createList(String, cap: profMaxEvents)
  profiler.phases = createList(Int, cap: profMaxEvents)
  profiler.times = createList(Int, cap: profMaxEvents)
  profiler.tids = createList(Int, cap: profMaxEvents)
  profiler.values = createList(Int, cap: profMaxEvents)
  profiler.startNs = nowNs()
  profiler.endNs = profiler.startNs + rae_float_to_int(f: seconds * 1000000000.0)
  profiler.outPath = "{outPath}"
  profiler.dropped = false
  profiler.capturing = true
}

# Start a capture from the environment if RAE_PROFILE is set. Call once at startup.
func maybeAutoStart(profiler: mod Profiler) pub {
  let flag: String = Sys.getEnv(name: "RAE_PROFILE")
  if flag.length() is 0 { ret }
  var seconds: Float = 20.0
  let secStr: String = Sys.getEnv(name: "RAE_PROFILE_SECONDS")
  if secStr.length() > 0 { seconds = secStr.toFloat() }
  var out: String = "rae_profile.json"
  let outEnv: String = Sys.getEnv(name: "RAE_PROFILE_OUT")
  if outEnv.length() > 0 { out = "{outEnv}" }
  startCapture(profiler: profiler, seconds: seconds, outPath: out)
}

func profRecord(profiler: mod Profiler, name: view String, ph: view Int, tsNs: view Int, tid: view Int, value: view Int) {
  if profiler.names.length >= profMaxEvents {
    profiler.dropped = true
    ret
  }
  profiler.names.add(value: "{name}")
  profiler.phases.add(value: ph)
  profiler.times.add(value: (tsNs - profiler.startNs) / 1000)   # ns -> microseconds
  profiler.tids.add(value: tid)
  profiler.values.add(value: value)
}

# Open a timing zone on the CPU main-loop track (tid 0). Cheap no-op when not
# capturing. Zones must be strictly nested (LIFO) — every zoneBegin needs a
# matching zoneEnd, which the Chrome format relies on to build the flame graph.
func zoneBegin(profiler: mod Profiler, name: view String) pub {
  if profiler.capturing is false { ret }
  profRecord(profiler: profiler, name: name, ph: profPhBegin, tsNs: nowNs(), tid: 0, value: 0)
}

func zoneEnd(profiler: mod Profiler, name: view String) pub {
  if profiler.capturing is false { ret }
  profRecord(profiler: profiler, name: name, ph: profPhEnd, tsNs: nowNs(), tid: 0, value: 0)
}

# A single-value time series (fps, draw count, RSS, caster count, …). Perfetto
# plots these as a track you can overlay against the zones.
func counter(profiler: mod Profiler, name: view String, value: view Int) pub {
  if profiler.capturing is false { ret }
  profRecord(profiler: profiler, name: name, ph: profPhCounter, tsNs: nowNs(), tid: 0, value: value)
}

# Call once per frame. Auto-stops and writes the trace when the capture window
# elapses. Returns true on the frame it wrote the file.
func tick(profiler: mod Profiler) pub ret Bool {
  if profiler.capturing is false { ret false }
  if nowNs() < profiler.endNs { ret false }
  ret profileStop(profiler: profiler)
}

# Stop early and write immediately. Returns true if the file was written.
func profileStop(profiler: mod Profiler) pub ret Bool {
  if profiler.capturing is false { ret false }
  profiler.capturing = false
  ret write(profiler: profiler, path: profiler.outPath)
}

# One trace event object. Literal JSON braces are `\{` / `\}`; `{expr}` is Rae
# interpolation. Zone names here are static identifiers, so no JSON escaping of
# the name is needed.
func profFragment(name: view String, ph: view Int, ts: view Int, tid: view Int, value: view Int) ret String {
  if ph is profPhCounter {
    ret "\{\"name\":\"{name}\",\"ph\":\"C\",\"ts\":{ts},\"pid\":1,\"tid\":{tid},\"args\":\{\"v\":{value}\}\}"
  }
  var phc: String = "B"
  if ph is profPhEnd { phc = "E" }
  ret "\{\"name\":\"{name}\",\"ph\":\"{phc}\",\"ts\":{ts},\"pid\":1,\"tid\":{tid}\}"
}

# Join with `sep` in sqrt(n)-sized blocks. A single left-fold join is O(n^2) in
# total bytes copied (the accumulator is recopied every step); blocking makes it
# O(n*sqrt(n)) — sub-second for tens of thousands of events instead of tens of
# seconds. Deferred to stop time, so it never touches a measured frame.
func joinBlocked(frags: view List(String), blockSize: view Int) ret String {
  let n: Int = frags.length
  if n is 0 { ret "" }
  let blocks: List(String) = createList(String, cap: n / blockSize + 2)
  var i: Int = 0
  loop i < n {
    var stop: Int = i + blockSize
    if stop > n { stop = n }
    var block: String = rae_ext_rae_buf_get(V: String, buf: frags.data, index: i)
    var j: Int = i + 1
    loop j < stop {
      block = block.concat(other: ",").concat(
        other: rae_ext_rae_buf_get(V: String, buf: frags.data, index: j))
      j = j + 1
    }
    blocks.add(value: block)
    i = stop
  }
  ret blocks.join(sep: ",")
}

func write(profiler: view Profiler, path: view String) ret Bool {
  let n: Int = profiler.names.length
  let frags: List(String) = createList(String, cap: n + 2)
  # Label the CPU track; a second thread_name for tid 1 (GPU) lands here once GPU
  # timestamp events exist (phase 2).
  frags.add(value: "\{\"name\":\"thread_name\",\"ph\":\"M\",\"pid\":1,\"tid\":0,\"args\":\{\"name\":\"CPU main loop\"\}\}")
  var i: Int = 0
  loop i < n {
    let nm: String = rae_ext_rae_buf_get(V: String, buf: profiler.names.data, index: i)
    let ph: Int = rae_ext_rae_buf_get(V: Int, buf: profiler.phases.data, index: i)
    let ts: Int = rae_ext_rae_buf_get(V: Int, buf: profiler.times.data, index: i)
    let tid: Int = rae_ext_rae_buf_get(V: Int, buf: profiler.tids.data, index: i)
    let value: Int = rae_ext_rae_buf_get(V: Int, buf: profiler.values.data, index: i)
    frags.add(value: profFragment(name: nm, ph: ph, ts: ts, tid: tid, value: value))
    i = i + 1
  }
  let body: String = joinBlocked(frags: frags, blockSize: 256)
  let json: String = "\{\"traceEvents\":[".concat(other: body).concat(other: "]\}")
  let ok: Bool = Sys.writeFile(path: path, content: json)
  if ok {
    log("profile: wrote {n} events to {path}")
  } else {
    log("profile: FAILED to write {path}")
  }
  if profiler.dropped {
    log("profile: WARNING event cap {profMaxEvents} hit — trace truncated")
  }
  ret ok
}
