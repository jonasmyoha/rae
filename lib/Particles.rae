# particles.rae — a small CPU particle system (engine subsystem, #84).
#
# A general, reusable particle pool: emit particles with a position + velocity + life,
# advance them under gravity each frame, and draw them as instanced cubes that FADE by
# ALPHA over their life through the transparent forward pass (#843/#844) — constant
# size, alpha = remaining-life fraction. (Until #843 the G-buffer had no alpha blend,
# so "fade" had to be faked by shrinking; that is gone.) One cube mesh; the pass owns
# the per-frame batch, so this module keeps no GPU batch of its own. Purely visual:
# update it per-frame (not in a fixed sim step) so it never touches lockstep state.
#
# First user is the game's water splashes (#84), but nothing here is game-specific:
# `particleEmit` / `particleBurst` take a colour + spread, so any effect (dust, sparks,
# embers) is just a different emit call.
import Vec3
import Math
open Mesh3d
open Gpu3d
open Scene3d
open TransparentForward

type Particle {
  x: Float
  y: Float
  z: Float
  vx: Float
  vy: Float
  vz: Float
  life: Float       # seconds remaining
  maxLife: Float
  size: Float       # world-unit cube edge at birth
  r: Float
  g: Float
  b: Float
}

type ParticleSystem {
  list: List(Particle)
  mesh: MeshHandle
  gravity: Float    # downward accel (world units / s^2)
  cap: Int
}

func createParticleSystem(cap: copy Int, gravity: copy Float) pub ret ParticleSystem {
  let box: MeshData = makeBox(size: 1.0)
  let mesh: MeshHandle = uploadMesh(verts: box.verts, vertCount: box.vertCount, indices: box.indices)
  ret ParticleSystem { list: createList(Particle, cap: cap), mesh: mesh, gravity: gravity, cap: cap }
}

# Emit one particle. Drops the oldest if the pool is full, so emission never grows
# unbounded and recent particles always win.
func particleEmit(sys: mod ParticleSystem, x: copy Float, y: copy Float, z: copy Float,
                  vx: copy Float, vy: copy Float, vz: copy Float,
                  life: copy Float, size: copy Float,
                  r: copy Float, g: copy Float, b: copy Float) pub {
  if sys.list.length >= sys.cap {
    sys.list.removeAt(index: 0)
  }
  sys.list.add(value: { x: x, y: y, z: z, vx: vx, vy: vy, vz: vz,
    life: life, maxLife: life, size: size, r: r, g: g, b: b })
}

# Emit a BURST of `count` particles from (x,y,z): each thrown up + outward with a
# spread, so it reads as a splash / puff. `hVel`/`upVel` set the outward/upward speed;
# the fan angle spreads deterministically by index (no RNG, so callers stay
# lockstep-safe if they emit from a fixed-step path).
func particleBurst(sys: mod ParticleSystem, x: copy Float, y: copy Float, z: copy Float,
                   count: copy Int, hVel: copy Float, upVel: copy Float,
                   life: copy Float, size: copy Float,
                   r: copy Float, g: copy Float, b: copy Float, phase: copy Float) pub {
  var i: Int = 0
  loop i < count {
    let a: Float = phase + i.toFloat() * 2.399963
    let spd: Float = hVel * (0.55 + 0.45 * Math.sin(x: a * 1.7))
    let up: Float = upVel * (0.7 + 0.5 * Math.abs(value: Math.cos(x: a * 0.9)))
    particleEmit(sys: sys, x: x, y: y, z: z,
      vx: Math.cos(x: a) * spd, vy: Math.sin(x: a) * spd, vz: up,
      life: life, size: size, r: r, g: g, b: b)
    i = i + 1
  }
}

# Advance every particle: integrate velocity + gravity, age, and compact out the dead.
# Call once per frame with the frame dt.
func particleUpdate(sys: mod ParticleSystem, deltaTime: copy Float) pub {
  var live: List(Particle) = createList(Particle, cap: sys.list.length)
  var i: Int = 0
  loop i < sys.list.length {
    if let p: Particle = sys.list.copyAt(index: i) {
      var pp: Particle = p
      pp.life = pp.life - deltaTime
      if pp.life > 0.0 {
        pp.vz = pp.vz - sys.gravity * deltaTime
        pp.x = pp.x + pp.vx * deltaTime
        pp.y = pp.y + pp.vy * deltaTime
        pp.z = pp.z + pp.vz * deltaTime
        live.add(value: pp)
      }
    }
    i = i + 1
  }
  sys.list = own live
}

# Queue every particle into the transparent forward pass as a constant-size cube
# whose ALPHA is its remaining-life fraction, so it fades out instead of shrinking.
# Call at the transparentForward tag (before renderDeferredPassWorld runs it) —
# NOT inside the G-buffer pass; the pass draws and resets the batch itself. The
# pool cap should not exceed the pass batch capacity or the oldest are dropped.
func particleDraw(sys: view ParticleSystem, transparent: mod TransparentPassCache) pub {
  var i: Int = 0
  loop i < sys.list.length {
    if let p: Particle = sys.list.copyAt(index: i) {
      var alpha: Float = p.life / p.maxLife
      if alpha < 0.0 { alpha = 0.0 }
      if alpha > 1.0 { alpha = 1.0 }
      let t: Transform3d = {
        position: Vec3.create(x: p.x, y: p.y, z: p.z),
        rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0),
        scale: Vec3.create(x: p.size, y: p.size, z: p.size)
      }
      addTransparentInstance(cache: transparent, mesh: sys.mesh, transform: t,
        r: p.r, g: p.g, b: p.b, alpha: alpha)
    }
    i = i + 1
  }
}
