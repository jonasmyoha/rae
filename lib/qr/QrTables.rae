func qrEccPerBlock(level: view QrErrorCorrection, version: view Int) ret Int {
  ret eccPerBlockTable(level: level).copyAtFallback(index: version - 1, fallback: 0)
}

func qrBlockCount(level: view QrErrorCorrection, version: view Int) ret Int {
  ret blockCountTable(level: level).copyAtFallback(index: version - 1, fallback: 1)
}

# The side of a version's symbol in modules: 21 for version 1, 4 more per
# version, 177 for version 40
func qrSize(version: view Int) ret Int {
  ret version * 4 + 17
}

# The modules that carry data and error correction (everything but the
# finder, timing and alignment patterns, the format and version information
# and the dark module), in bits
func qrRawDataModules(version: view Int) ret Int {
  var result: Int = (16 * version + 128) * version + 64
  if version >= 2 {
    let alignments: Int = version / 7 + 2
    result = result - ((25 * alignments - 10) * alignments - 55)
    if version >= 7 {
      result = result - 36
    }
  }
  ret result
}

# All the codewords a version holds (data and error correction)
func qrTotalCodewords(version: view Int) ret Int {
  ret qrRawDataModules(version: version) / 8
}

# The data codewords of a version at a level
func qrDataCodewords(version: view Int, level: view QrErrorCorrection) ret Int {
  ret qrTotalCodewords(version: version) - qrEccPerBlock(level: level, version: version) * qrBlockCount(
    level: level
    version: version
  )
}

# The centers of the alignment patterns on each axis (none for version 1)
func qrAlignmentPositions(version: view Int) ret List(Int) {
  var positions: List(Int) = {}
  if version is 1 {
    ret positions
  }
  let count: Int = version / 7 + 2
  var step: Int = 26
  if version is not 32 {
    step = (version * 4 + count * 2 + 1) / (count * 2 - 2) * 2
  }
  positions.addDefaults(count: count)
  positions.set(index: 0, value: 6)
  var position: Int = qrSize(version: version) - 7
  var i: Int = count - 1
  loop i >= 1 {
    positions.set(index: i, value: position)
    position = position - step
    i = i - 1
  }
  ret positions
}
