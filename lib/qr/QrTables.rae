# The QR code's numbers per version and error-correction level (ISO/IEC
# 18004:2015, tables 1, 9 and E.1): how many codewords a symbol holds, how
# they split into Reed-Solomon blocks, and where the alignment patterns go.
# Plain functions over small literal tables; lib/qr/QrEncoder uses them.

# The four error-correction levels: about 7, 15, 25 and 30 % of the
# codewords can be restored
enum QrErrorCorrection { low, medium, quartile, high }

const qrMinVersion: Int = 1

const qrMaxVersion: Int = 40

# The level's two bits in the format information (L 01, M 00, Q 11, H 10)
func qrLevelFormatBits(level: view QrErrorCorrection) ret Int {
  if level is QrErrorCorrection.low {
    ret 1
  }
  if level is QrErrorCorrection.medium {
    ret 0
  }
  if level is QrErrorCorrection.quartile {
    ret 3
  }
  ret 2
}

func qrLevelName(level: view QrErrorCorrection) ret String {
  if level is QrErrorCorrection.low {
    ret "L"
  }
  if level is QrErrorCorrection.medium {
    ret "M"
  }
  if level is QrErrorCorrection.quartile {
    ret "Q"
  }
  ret "H"
}

