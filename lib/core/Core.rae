# core/Core.rae — the core package main module.
# Console output, time, numeric conversions, compiler intrinsics, the raw
# Buffer primitives, and the general String externs. The List/StringMap/
# IntMap containers are siblings in this same package (core/List.rae, …),
# auto-loaded and auto-opened together as the prelude.
# Everything here is bare-callable everywhere; no import needed.
func nativeNextTick() unsafe extern("rae_ext_nextTick") ret Int

func nextTick() ret Int {
  unsafe {
    ret nativeNextTick()
  }
}

# Console output — a core essential (globally visible, callable bare), so
# everyday code writes `log(x)` not `io.log(x)`. (docs/module-namespacing.md)
func rae_ext_rae_log_any(value: Any) unsafe extern

func rae_ext_rae_log_stream_any(value: Any) unsafe extern

func log(value: Any) {
  unsafe {
    rae_ext_rae_log_any(value: value)
  }
}

func logS(value: Any) {
  unsafe {
    rae_ext_rae_log_stream_any(value: value)
  }
}

# A runtime error raised by library code (docs/collections.md, docs/
# integer-semantics.md): prints `runtime error: <message>` to stderr and ends
# the program with exit code 70 — the same trap the compiler's own Int checks
# use. For a state the caller could not have asked for on purpose (an index
# past the end); never for ordinary failure, which is an `opt` or a Bool.
func rae_ext_rae_runtime_error(message: String) unsafe extern

func runtimeError(message: view String) {
  unsafe {
    rae_ext_rae_runtime_error(message: message)
  }
}

# A runtime warning from library code: prints `warning: <message>` to stderr
# and the program CONTINUES. For a request the library can safely decline —
# a List write past the end is dropped, and this line is what keeps that
# from being silent (docs/collections.md). The same in every build profile.
func rae_ext_rae_runtime_warning(message: String) unsafe extern

func runtimeWarning(message: view String) {
  unsafe {
    rae_ext_rae_runtime_warning(message: message)
  }
}

# A declared shader composition (docs/shaders-and-the-compiler.md). Produced
# only by the compile-time construct `shader(files: ["lib/noise.wgsl", ...])`:
# the compiler resolves the parts at build time, composes them in order (a
# `// --- <path>` marker before each), validates the text with naga and
# embeds it here — the runtime never opens a `.wgsl` file for it. A Shader is
# a VALUE, never collapsed to a String at a call site: `sources` (the
# resolved part paths) and `generation` are what an in-process reload will
# use to re-compose and swap the pipeline that owns it.
type Shader {
  text: String
  sources: List(String)
  generation: Int
}

func nativeNowMs() unsafe extern("rae_ext_nowMs") ret Int

func nowMs() ret Int {
  unsafe {
    ret nativeNowMs()
  }
}

func nativeNowNs() unsafe extern("rae_ext_nowNs") ret Int

func nowNs() ret Int {
  unsafe {
    ret nativeNowNs()
  }
}

func nativeSleep(ms: Int) unsafe extern("rae_ext_rae_sleep")

func sleep(ms: copy Int) {
  unsafe {
    nativeSleep(ms: ms)
  }
}

func rae_int_to_float(i: Int) unsafe extern ret Float

func rae_float_to_int(f: Float) unsafe extern ret Int

func toFloat(this: view Int) ret Float {
  unsafe {
    ret rae_int_to_float(i: this)
  }
}

func toInt(this: view Float) ret Int {
  unsafe {
    ret rae_float_to_int(f: this)
  }
}

# -- Compiler Intrinsics --
func sizeof(T: type) unsafe extern ret Int

# -- Buffer Primitives (Compiler-internal) --
func rae_ext_rae_buf_alloc(size: Int, elemSize: Int) unsafe extern ret Buffer(Any)

func rae_ext_rae_buf_free(buf: Buffer(Any)) unsafe extern

func rae_ext_rae_buf_copy(
  V: type
  src: Buffer(V)
  src_off: Int
  dst: Buffer(V)
  dst_off: Int
  len: Int
  elemSize: Int
) unsafe extern

func rae_ext_rae_buf_set(
  V: type
  buf: mod Buffer(V)
  index: Int
  value: V
) unsafe extern

# Drop the contents of `buf[index]` via the synthesised
# rae_drop_struct_<V> (or rae_string_drop for V=String). The
# compiler recognises this name as an intrinsic and emits the
# right drop call for V; the slot is left in a stale-pointer state
# that the caller must overwrite before anything else reads it.
# Used by the "replace existing element" path of stdlib helpers
# like StringMap.set / componentSet to avoid leaking the slot's
# old String fields.
func rae_ext_rae_buf_drop_at(V: type, buf: mod Buffer(V), index: Int) unsafe extern

func rae_ext_rae_buf_get(V: type, buf: view Buffer(V), index: Int) unsafe extern ret V

# -- General String externs (used by String.rae, StringMap, Json, …) --
func rae_str_hash(s: String) unsafe extern ret Int

func rae_str_eq(a: String, b: String) unsafe extern ret Bool

# Deep-copy a String — declared here so `StringMap.set` can own its
# keys without relying on lib/string.rae (which itself imports
# core). Maps to the same runtime helper as `String.stringCopy`.
func rae_ext_rae_string_copy(string: view String) unsafe extern ret String
