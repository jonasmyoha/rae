# core/List.rae — the generic List(T), the language's array type.
# A sibling of core/Core.rae in the core package (auto-loaded, auto-opened).
# -- Generic List Implementation (Rae-native) --
type List(T: type) {
  data: Buffer(T)
  length: Int
  cap: Int
}

func createList(T: type, cap: view Int) ret List(T) {
  ret List(T) { data: rae_ext_rae_buf_alloc(size: cap, elemSize: sizeof(T)), length: 0, cap: cap }
}

func grow(T: type, this: mod List(T)) {
  var newCap: Int = this.cap * 2
  if newCap is 0 {
    newCap = 4
  }
  let newData: Buffer(T) = rae_ext_rae_buf_alloc(size: newCap, elemSize: sizeof(T))
  rae_ext_rae_buf_copy(
    src: this.data
    src_off: 0
    dst: newData
    dst_off: 0
    len: this.length
    elemSize: sizeof(T)
  )
  rae_ext_rae_buf_free(buf: this.data)
  this.data = newData
  this.cap = newCap
}

func add(T: type, this: mod List(T), value: own T) {
  if this.length is this.cap {
    grow(this)
  }
  rae_ext_rae_buf_set(buf: this.data, index: this.length, value: value)
  this.length = this.length + 1
}

# Copy the element out of the list. Indexed List access is always optional
# (out-of-range yields none). The `copy` in the name is the point: this returns
# a COPY of the element (a whole-struct copy, including deep copies of any heap
# fields) — reach for `viewAt`/`modAt` to alias the list's storage instead.
func copyAt(T: type, this: view List(T), index: view Int) ret opt T {
  if index < 0 or index >= this.length {
    ret none
  }
  ret rae_ext_rae_buf_get(buf: this.data, index: index)
}

# TOTAL (non-optional) reads for the structure-of-arrays pattern: several
# same-length parallel lists indexed together, where wrapping every element
# read in `if let` is noise. Both return T directly, not `opt T`.
#
# `copyAtFallback` returns the caller's own value out of range — the #642
# rule (the else branch is a value the PROGRAMMER wrote). Prefer it when a
# meaningful sentinel exists.
func copyAtFallback(T: type, this: view List(T), index: view Int, fallback: T) ret T {
  if index < 0 or index >= this.length {
    ret fallback
  }
  ret rae_ext_rae_buf_get(buf: this.data, index: index)
}

# `copyAtDefault` returns the type's zero value out of range (0, 0.0, false,
# "", a zero-initialized struct) — the convenience form when any-old-default
# is fine and spelling a sentinel every call would be noise. Use
# `copyAt` + `if let` when absence must be handled distinctly from a real
# zero, or `copyAtFallback` when the sentinel matters.
func copyAtDefault(T: type, this: view List(T), index: view Int) ret T {
  if index < 0 or index >= this.length {
    var defaultValue: T
    ret defaultValue
  }
  ret rae_ext_rae_buf_get(buf: this.data, index: index)
}

# A read-only window INTO the list's own storage, rather than a copy of the
# element. `at` hands back an optional value, so reading one field of a
# big struct copies the whole struct — including a deep copy of every heap
# field it owns. `viewAt` costs a pointer.
func viewAt(T: type, this: view List(T), index: view Int) ret opt view T {
  if index < 0 or index >= this.length {
    ret none
  }
  ret view rae_ext_rae_buf_get(buf: this.data, index: index)
}

# Mutable window into the list's storage. Writing through the returned
# reference writes the element in place — no read-modify-`set` round trip,
# and no drop/re-add of the element's owned fields.
func modAt(T: type, this: mod List(T), index: view Int) ret opt mod T {
  if index < 0 or index >= this.length {
    ret none
  }
  ret mod rae_ext_rae_buf_get(buf: this.data, index: index)
}

func set(T: type, this: mod List(T), index: view Int, value: own T) {
  if index < 0 or index >= this.length {
    ret
  }
  rae_ext_rae_buf_drop_at(buf: this.data, index: index)
  rae_ext_rae_buf_set(buf: this.data, index: index, value: value)
}

func insert(T: type, this: mod List(T), index: view Int, value: own T) {
  if index < 0 or index > this.length {
    ret
  }
  if this.length is this.cap {
    grow(this)
  }
  # Shift elements to the right
  if index < this.length {
    rae_ext_rae_buf_copy(
      src: this.data
      src_off: index
      dst: this.data
      dst_off: index + 1
      len: this.length - index
      elemSize: sizeof(T)
    )
  }
  rae_ext_rae_buf_set(buf: this.data, index: index, value: value)
  this.length = this.length + 1
}

func pop(T: type, this: mod List(T)) ret T {
  if this.length is 0 {
    ret none
  }
  let val: T = rae_ext_rae_buf_get(buf: this.data, index: this.length - 1)
  this.length = this.length - 1
  ret val
}

func remove(T: type, this: mod List(T), index: view Int) {
  if index < 0 or index >= this.length {
    ret
  }
  rae_ext_rae_buf_drop_at(buf: this.data, index: index)
  # Shift elements to the left
  if index < this.length - 1 {
    rae_ext_rae_buf_copy(
      src: this.data
      src_off: index + 1
      dst: this.data
      dst_off: index
      len: this.length - index - 1
      elemSize: sizeof(T)
    )
  }
  this.length = this.length - 1
}

# Unordered remove. Drops the removed slot; if it is not the tail, moves the
# tail payload into its place and shrinks without dropping the moved tail bytes.
func swapRemove(T: type, this: mod List(T), index: view Int) {
  if index < 0 or index >= this.length {
    ret
  }
  let last: Int = this.length - 1
  if index is last {
    this.remove(index: index)
    ret
  }
  rae_ext_rae_buf_drop_at(buf: this.data, index: index)
  let lastVal: T = rae_ext_rae_buf_get(buf: this.data, index: last)
  rae_ext_rae_buf_set(buf: this.data, index: index, value: lastVal)
  this.length = this.length - 1
}

func clear(T: type, this: mod List(T)) {
  var i: Int = 0
  loop i < this.length {
    rae_ext_rae_buf_drop_at(buf: this.data, index: i)
    i = i + 1
  }
  this.length = 0
}

# Drop the last element (no return). Use pop() when you need the value; this is
# for discarding it — one buffer drop, no shift. A no-op on an empty list.
func removeLast(T: type, this: mod List(T)) {
  if this.length is 0 {
    ret
  }
  rae_ext_rae_buf_drop_at(buf: this.data, index: this.length - 1)
  this.length = this.length - 1
}

# Drop every element from index `len` to the end, keeping the first `len`. A
# `len` at or past the current length is a no-op; a negative `len` empties the
# list. Cheaper than repeated removeLast() and drops each discarded element.
func truncate(T: type, this: mod List(T), len: view Int) {
  var target: Int = len
  if target < 0 {
    target = 0
  }
  if target >= this.length {
    ret
  }
  var i: Int = target
  loop i < this.length {
    rae_ext_rae_buf_drop_at(buf: this.data, index: i)
    i = i + 1
  }
  this.length = target
}

# Ordered remove at `index`: drop the element there and shift the tail left.
# A named alias of remove(index:) for symmetry with removeLast(); out-of-range
# is a no-op.
func removeAt(T: type, this: mod List(T), index: view Int) {
  this.remove(index: index)
}

func length(T: type, this: view List(T)) ret Int {
  ret this.length
}

# Release the List's backing Buffer to the allocator. After `drop`,
# the List's `data` pointer is dangling and the List must not be
# used. Call when the List is about to go out of scope (until the
# compiler emits this automatically — see docs/scope-exit-dealloc.md).
#
# Stage 1 limitation: when `T` is itself a heap-owning type
# (another List, a Map, a struct that owns a Buffer), this `drop`
# does NOT recurse into the elements. The recursive form lands in
# Stage 2.1; for now this matches the use sites in the music-player
# example, where `T` is always a value type or a struct with no
# heap fields of its own.
func drop(T: type, this: mod List(T)) {
  rae_ext_rae_buf_free(buf: this.data)
  this.length = 0
  this.cap = 0
}

func swap(T: type, this: mod List(T), i: view Int, j: view Int) {
  let temp: T = rae_ext_rae_buf_get(buf: this.data, index: i)
  rae_ext_rae_buf_set(buf: this.data, index: i, value: rae_ext_rae_buf_get(buf: this.data, index: j))
  rae_ext_rae_buf_set(buf: this.data, index: j, value: temp)
}

# In-place insertion sort, ascending. Works for any numeric T (Int / Float)
# where `<` is defined. For String / struct types, write a custom sort or
# use `sortByDesc` once a comparator API lands.
func sort(T: type, this: mod List(T)) {
  var i: Int = 1
  loop i < this.length {
    var j: Int = i
    loop j > 0 {
      let a: T = rae_ext_rae_buf_get(buf: this.data, index: j - 1)
      let b: T = rae_ext_rae_buf_get(buf: this.data, index: j)
      if a < b {
        # already in order
        j = 0
      } else {
        swap(this, i: j - 1, j: j)
        j = j - 1
      }
    }
    i = i + 1
  }
}

# In-place insertion sort, descending. Useful for highscore tables and
# anything that wants the largest values first.
func sortDesc(T: type, this: mod List(T)) {
  var i: Int = 1
  loop i < this.length {
    var j: Int = i
    loop j > 0 {
      let a: T = rae_ext_rae_buf_get(buf: this.data, index: j - 1)
      let b: T = rae_ext_rae_buf_get(buf: this.data, index: j)
      if a > b {
        j = 0
      } else {
        swap(this, i: j - 1, j: j)
        j = j - 1
      }
    }
    i = i + 1
  }
}

# In-place reverse. Works for any T.
func reverse(T: type, this: mod List(T)) {
  var lo: Int = 0
  var hi: Int = this.length - 1
  loop lo < hi {
    swap(this, i: lo, j: hi)
    lo = lo + 1
    hi = hi - 1
  }
}

func isEmpty(T: type, this: view List(T)) ret Bool {
  ret this.length is 0
}

# Linear search for `value`. Works for any T where `is` is defined.
func contains(T: type, this: view List(T), value: view T) ret Bool {
  var i: Int = 0
  loop i < this.length {
    let cur: T = rae_ext_rae_buf_get(buf: this.data, index: i)
    if cur is value {
      ret true
    }
    i = i + 1
  }
  ret false
}

# Returns the first index of `value`, or -1 if not found.
func indexOf(T: type, this: view List(T), value: view T) ret Int {
  var i: Int = 0
  loop i < this.length {
    let cur: T = rae_ext_rae_buf_get(buf: this.data, index: i)
    if cur is value {
      ret i
    }
    i = i + 1
  }
  ret -1
}

func free(T: type, this: mod List(T)) {
  clear(this)
  rae_ext_rae_buf_free(buf: this.data)
  this.length = 0
  this.cap = 0
}

