# The WebSocket opening handshake's key (RFC 6455 §4.2.2): the server answers
# a client's `Sec-WebSocket-Key` with `Sec-WebSocket-Accept`, the base64 of
# the SHA-1 of the key followed by a fixed GUID.
import crypto/Sha1
import text/Base64

const webSocketGuid: String = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

# The Sec-WebSocket-Accept value for a client's Sec-WebSocket-Key
func webSocketAccept(key: view String) ret String {
  ret Base64.base64Encode(bytes: Sha1.sha1Text(text: "{key}{webSocketGuid}"))
}
