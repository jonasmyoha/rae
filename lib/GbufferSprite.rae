# Billboard sprite pass driver (#15). A textured, alpha-tested, cylindrical-quad
# pipeline that draws standing props (trees, ...) from the shared DrawU records —
# the grass render technique (procedural quad, no vertex buffer) plus a sprite
# texture array. Modeled on the terrain pipeline (GbufferTerrain.rae), sharing
# GrassCompute.gbufferProceduralPipelineSpec for the no-vertex-buffer,
# cull-none, reverse-Z setup. Since #874 the pipeline, bind group, uniform and
# sampler are typed IDs in the App-owned manager (SpriteCache holds them); the
# sprite image ARRAY stays a C asset-upload ABI (rae_gb_sprite_array_*) and
# its view is adopted as an external, re-adopted when the array is rebuilt.
# app3d/PropField draws its sprite levels with it (drawPropFieldSprites): the
# far trees of examples 136, 137 and 143 are billboards of pictures baked with
# app3d/SpriteBake. The instance's mode (lit / toon) is carried like a mesh
# instance's. Their shadows are ShadowMapsSprite's (the same pictures, each
# quad turned to face the sun). In a forward frame (lib/RendererForward) the
# same quads are drawn with a forward pipeline: the billboard's
# gbufferSurface shaded by forward_entry.wgsl into the lit target. With an
# impostor atlas set (setSpriteImpostors, lib/ImpostorAtlas) the quads read
# it instead of the sprite array: each prop's bounding sphere, turned to the
# eye, showing the baked view nearest the direction to it.
open Gbuffer
open GbufferInstanced
open GbufferRecord
open Math3d
import Vec3
import Math
open GbufferResources
open Scene3d
open webgpu/Webgpu
open webgpu/Context
open GrassCompute
open gpu/GpuResources
open gpu/GpuTextures
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuRenderTransfer
open gpu/GpuArgs
open gpu/GpuIds
open ForwardMaterial
open gpu/DeviceFeatures
open ImpostorAtlas

# C-side sprite texture array (runtime_gpu3d_gbuffer.c): the array texture is a
# platform upload; its view and generation are read here.
func gbSpriteArrayView() unsafe extern("rae_gb_sprite_array_view") ret Ptr

func gbSpriteTexGen() unsafe extern("rae_gb_sprite_tex_gen") ret Int

func gbSpriteArrayInit(
  w: Int
  h: Int
  layers: Int
  mips: Int
) unsafe extern("rae_gb_sprite_array_init")

func gbSpriteArrayWrite(
  layer: Int
  mip: Int
  pixels: view Buffer(Int)
  w: Int
  h: Int
) unsafe extern("rae_gb_sprite_array_write")

type SpriteCache {
  pipeMade: Bool
  bindGen: Int
  pipeline: RenderPipelineId
  bindGroup: BindGroupId
  uniform: BufferId
  sampler: SamplerId
  arrayView: ExternalId
  # The forward frame's pipeline (made for the lit format it was made with)
  # and bind (rebuilt when the sprite array or the lighting inputs change)
  forwardPipeline: RenderPipelineId
  forwardPipelineFormat: Int32
  forwardBind: BindGroupId
  forwardBindGen: Int
  forwardInputsGen: Int
  # The first billboards drawn in a forward frame were logged (the 137 gate
  # greps the line)
  forwardDrawLogged: Bool
  # The parameters spriteSetParams was given, and the hashed alpha test's
  # band last uploaded with them (-1: none yet): the band follows the
  # frame's TAA, so the uniform is written again when it changes
  heightK: Float = 1.0
  aspect: Float = 1.0
  cutoff: Float = 0.5
  time: Float = 0.0
  tilt: Float = 0.0
  uploadedBand: Float = -1.0
  # The impostor atlas the quads read instead of the sprite array (none:
  # no layers), what the G-buffer and forward binds were built over, and
  # the frames buffer bound when there is none (the shader declares it)
  impostors: ImpostorAtlas = noImpostorAtlas()
  boundImpostors: ImpostorBinding = noImpostorBinding()
  forwardImpostors: ImpostorBinding = noImpostorBinding()
  unusedFrames: BufferId = noBufferId()
  # The G-buffer pipeline that keeps the quad's depth (and with it the early
  # depth test) for an impostor too, and its bind: for far props, where the
  # moved depth is not worth turning that test off (drawSpriteInstances)
  quadDepthPipeline: RenderPipelineId = noRenderPipelineId()
  quadDepthBindGroup: BindGroupId = noBindGroupId()
}

# The hashed alpha test's band round the cutoff when TAA resolves it
# (sprite_billboard.wgsl alphaThreshold): soft, stable leaf edges. Without
# TAA (the default FXAA, the forward pass's MSAA) the band is 0, a plain cut
# on mips that keep their coverage, so nothing is left grainy.
const spriteHashBand: Float = 0.5

func createSpriteCache() ret SpriteCache {
  ret SpriteCache {
    pipeMade: false
    bindGen: -1
    pipeline: noRenderPipelineId()
    bindGroup: noBindGroupId()
    uniform: noBufferId()
    sampler: noSamplerId()
    arrayView: noExternalId()
    forwardPipeline: noRenderPipelineId()
    forwardPipelineFormat: 0
    forwardBind: noBindGroupId()
    forwardBindGen: -1
    forwardInputsGen: -1
    forwardDrawLogged: false
  }
}

const spriteUniformBytes: Int = 48  # three vec4 (SpriteU)

const spriteRecordFloats: Int = instanceRecordFloats  # DrawU, same as the instanced path

# Create the sprite image array (one layer per prop kind, `mips` levels each:
# 1 for none, spriteMipCount for the full chain) + upload one level of a
# layer (level `mip` is w >> mip by h >> mip, at least 1). The game calls
# these once with plate-cut RGBA sprites (straight alpha for the cutout);
# app3d/SpriteBake builds and uploads a picture's whole chain.
func spriteInitArray(
  w: copy Int
  h: copy Int
  layers: copy Int
  mips: copy Int
) {
  unsafe {
    gbSpriteArrayInit(
      w: w
      h: h
      layers: layers
      mips: mips
    )
  }
}

func spriteUploadLayer(
  layer: copy Int
  mip: copy Int
  pixels: view Buffer(Int)
  w: copy Int
  h: copy Int
) {
  unsafe {
    gbSpriteArrayWrite(
      layer: layer
      mip: mip
      pixels: pixels
      w: w
      h: h
    )
  }
}

# The levels of a full mip chain for a `w` x `h` picture: halved down to 1 x 1
func spriteMipCount(w: view Int, h: view Int) ret Int {
  var size: Int = Math.max(a: w, b: h)
  var levels: Int = 1
  loop size > 1 {
    size = size / 2
    levels = levels + 1
  }
  ret levels
}

# The SpriteU uniform buffer — created on demand so spriteSetParams can write it
# at SETUP without touching the pipeline (which needs the frame/draws buffers that
# only exist during the render).
func ensureSpriteUniform(cache: mod SpriteCache, resources: mod GpuResources) {
  if isValidBuffer(resources: resources, id: cache.uniform) {
    ret
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: spriteUniformBytes
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
}

# Sampler (clamp — a sprite is not tiled; linear between mip levels, so a far
# billboard averages its picture instead of shimmering), the SpriteU uniform buffer, and a 1x1
# transparent default array so the bind group is always valid before upload.
func ensureSpriteDefaults(cache: mod SpriteCache, resources: mod GpuResources) {
  if not isValidSampler(resources: resources, id: cache.sampler) {
    if let sampler: SamplerId = createSamplerMipped(
      resources: resources
      addressMode: WGPUAddressMode_ClampToEdge
    ) {
      cache.sampler = sampler
    }
  }
  ensureSpriteUniform(cache: cache, resources: resources)
  if not isValidBuffer(resources: resources, id: cache.unusedFrames) {
    if let frames: BufferId = createBuffer(
      resources: resources
      size: 16
      usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
    ) {
      cache.unusedFrames = frames
    }
  }
  unsafe {
    if gbSpriteArrayView() is webgpuNull() {
      gbSpriteArrayInit(
        w: 1
        h: 1
        layers: 1
        mips: 1
      )
      var one: List(Int) = List.create(Int, cap: 1)
      one.add(value: 0)  # transparent -> alpha-tested away; never visible
      gbSpriteArrayWrite(
        layer: 0
        mip: 0
        pixels: one.data
        w: 1
        h: 1
      )
    }
  }
}

func ensureSpritePipeline(
  cache: mod SpriteCache
  resources: mod GpuResources
  gbuffer: view GbufferCache
) {
  if not cache.pipeMade {
    cache.pipeMade = true
    let billboardShader: Shader = shader(
      files: ["lib/fade_dither.wgsl", "lib/impostor_octahedral.wgsl", "lib/sprite_billboard.wgsl"]
    )
    if let pipeline: RenderPipelineId = createRenderPipeline(
      resources: resources
      shader: billboardShader
      vertexEntry: "vs"
      fragmentEntry: "fs"
      spec: gbufferProceduralPipelineSpec()
    ) {
      cache.pipeline = pipeline
    }
    if let pipeline: RenderPipelineId = createRenderPipeline(
      resources: resources
      shader: billboardShader
      vertexEntry: "vs"
      fragmentEntry: "fsQuadDepth"
      spec: gbufferProceduralPipelineSpec()
    ) {
      cache.quadDepthPipeline = pipeline
    }
  }
  ensureSpriteDefaults(cache: cache, resources: resources)
  var gen: Int = 0
  unsafe {
    gen = gbSpriteTexGen()
  }
  if gen is cache.bindGen and sameImpostorBinding(
    first: cache.boundImpostors
    second: cache.impostors.binding
  ) and bindGroupIsUsable(resources: resources, id: cache.bindGroup) and bindGroupIsUsable(
    resources: resources
    id: cache.quadDepthBindGroup
  ) {
    ret
  }
  # The bind groups are rebuilt (the old ones retire behind any frame still
  # drawing with them); the array view is re-adopted when it changed generation
  retireBindGroup(resources: resources, id: cache.bindGroup)
  retireBindGroup(resources: resources, id: cache.quadDepthBindGroup)
  cache.bindGroup = noBindGroupId()
  cache.quadDepthBindGroup = noBindGroupId()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    releaseExternal(resources: resources, id: cache.arrayView)
    cache.arrayView = noExternalId()
    unsafe {
      if let arrayView: ExternalId = adoptExternalTextureView(
        resources: resources
        handle: gbSpriteArrayView()
      ) {
        cache.arrayView = arrayView
      }
    }
  }
  cache.boundImpostors = cache.impostors.binding
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 7)
  addSpriteEntries(cache: cache, gbuffer: gbuffer, entries: entries)
  if let bindGroup: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.pipeline
    entries: entries
  ) {
    cache.bindGroup = bindGroup
  }
  # Each pipeline's own layout, so each its own group over the same entries
  if let bindGroup: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.quadDepthPipeline
    entries: entries
  ) {
    cache.quadDepthBindGroup = bindGroup
  }
}

# The sprite pass's own bindings 0..6: the frame, the draws, SpriteU, the
# pictures (the impostor atlas's albedo or the sprite array) and the
# sampler, then the atlas's normal and depth and its frames (the sprite
# array and an unread buffer when there is no atlas)
func addSpriteEntries(
  cache: view SpriteCache
  gbuffer: view GbufferCache
  entries: mod List(ResourceRef)
) {
  let impostors: view ImpostorBinding = cache.impostors.binding
  let hasImpostors: Bool = impostors.viewsPerSide > 0
  entries.add(value: bufferRef(id: gbuffer.frameUniform))
  entries.add(value: bufferRef(id: gbuffer.draws))
  entries.add(value: bufferRef(id: cache.uniform))
  if hasImpostors {
    entries.add(value: textureViewRef(id: impostors.albedo))
  } else {
    entries.add(value: externalRef(id: cache.arrayView))
  }
  entries.add(value: samplerRef(id: cache.sampler))
  if hasImpostors {
    entries.add(value: textureViewRef(id: impostors.normalDepth))
    entries.add(value: bufferRef(id: impostors.frames))
  } else {
    entries.add(value: externalRef(id: cache.arrayView))
    entries.add(value: bufferRef(id: cache.unusedFrames))
  }
}

# 1 when the impostor draw blends three views, else 0 (the nearest only)
func impostorBlendFlag(binding: view ImpostorBinding) ret Float {
  if binding.blendViews {
    ret 1.0
  }
  ret 0.0
}

# 1 when the impostor draw marches each view (a box framed atlas), else 0
func impostorMarchFlag(binding: view ImpostorBinding) ret Float {
  if binding.marchViews and binding.viewsPerSide > 0 {
    ret 1.0
  }
  ret 0.0
}

# Draw the quads from `atlas` (ImpostorBake) instead of the sprite array,
# from the next frame on; the atlas held before is retired. The layers are
# the same as the sprite array's (one per prop kind), and an instance's
# height (addSpriteInstance) sizes its prop's bounding sphere.
func setSpriteImpostors(
  cache: mod SpriteCache
  resources: mod GpuResources
  atlas: view ImpostorAtlas
) {
  retireImpostorAtlas(atlas: cache.impostors, resources: resources)
  cache.impostors = atlas
  writeSpriteUniform(cache: cache, resources: resources, band: cache.uploadedBand)
}

# Sprite params (SpriteU): a = (world height per unit instance scale, sprite
# aspect w/h, alpha cutoff, time); b.x = camera TILT (0 = upright cylindrical,
# 1 = lay flat to face the camera, #22). Camera-right/up are derived in the shader
# from viewProj, so no camera vector is needed here. Set once (or when tuning).
func spriteSetParams(
  cache: mod SpriteCache
  resources: mod GpuResources
  heightK: copy Float
  aspect: copy Float
  cutoff: copy Float
  time: copy Float
  tilt: copy Float
) {
  cache.heightK = heightK
  cache.aspect = aspect
  cache.cutoff = cutoff
  cache.time = time
  cache.tilt = tilt
  writeSpriteUniform(cache: cache, resources: resources, band: 0.0)
}

# The sprite uniform (SpriteU) from the cache's parameters and `band`
func writeSpriteUniform(cache: mod SpriteCache, resources: mod GpuResources, band: view Float) {
  ensureSpriteUniform(cache: cache, resources: resources)
  var args: ArgWriter = createArgs(uniform: true)
  pushVec4F(
    writer: args
    x: cache.heightK
    y: cache.aspect
    z: cache.cutoff
    w: cache.time
  )
  pushVec4F(
    writer: args
    x: cache.tilt
    y: band
    z: cache.impostors.binding.viewsPerSide.toFloat()
    w: impostorBlendFlag(binding: cache.impostors.binding)
  )
  pushVec4F(
    writer: args
    x: impostorMarchFlag(binding: cache.impostors.binding)
    y: 0.0
    z: 0.0
    w: 0.0
  )
  uploadArgs(
    writer: args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )
  cache.uploadedBand = band
}

# One billboard instance into `batch`: standing at `position` (its foot),
# `height` tall in the world, turned `yaw` (radians about z: an impostor shows
# the prop turned as its meshes are; a plain picture ignores it), showing
# layer `layer` of the sprite array, with the instance mode of a `toon` (or
# lit) mesh. The record is the shared DrawU: the model is the turn and the
# translation, at scale 1 (the shader reads the
# height per unit scale from params.x, the roughness slot, and the layer from
# slot 39, the skinned path's palette base — a billboard is never skinned).
func addSpriteInstance(
  batch: mod InstanceBatch
  position: view Vec3
  height: view Float
  yaw: view Float
  layer: view Int
  toon: view Bool
) {
  if batch.count >= batch.capacity {
    ret
  }
  var toonFlag: Int = 0
  if toon {
    toonFlag = 1
  }
  # The turn and the translation written straight in (no matrix product:
  # a frame adds tens of thousands of these)
  var model: Mat4 = mat4Translate(x: position.x, y: position.y, z: position.z)
  if not (yaw is 0.0) {
    let cosine: Float = Math.cos(x: yaw)
    let sine: Float = Math.sin(x: yaw)
    model.m.set(index: 0, value: cosine)
    model.m.set(index: 1, value: sine)
    model.m.set(index: 4, value: -sine)
    model.m.set(index: 5, value: cosine)
  }
  packInstanceRecord(
    records: batch.records
    slot: batch.count
    model: model
    prevModel: model
    r: 1.0
    g: 1.0
    b: 1.0
    metallic: 0.0
    roughness: height
    emissive: 0.0
    toon: toonFlag
    paletteBase: layer
  )
  batch.count = batch.count + 1
}

# The sprite FORWARD material: the billboard composition plus the shading
# prelude and forward_entry.wgsl, 4x into the lit format, and its bind (the
# sprite bind's five entries + the lighting inputs). Made at the first forward
# frame that draws a billboard; the bind is rebuilt when the sprite array or
# the lighting inputs are recreated. Call after ensureSpritePipeline (the
# array view and the sampler).
func ensureSpriteForward(
  cache: mod SpriteCache
  resources: mod GpuResources
  gbuffer: view GbufferCache
) {
  let materials: view ForwardMaterials = gbuffer.forward
  if materials.litFormat is (0 as Int32) {
    ret
  }
  if not (cache.forwardPipelineFormat is materials.litFormat) {
    retireBindGroup(resources: resources, id: cache.forwardBind)
    retireRenderPipeline(resources: resources, id: cache.forwardPipeline)
    cache.forwardBind = noBindGroupId()
    cache.forwardPipeline = noRenderPipelineId()
    cache.forwardPipelineFormat = materials.litFormat
    var billboardShader: Shader = shader(files: [
      "lib/precision_f32.wgsl"
      "lib/sky_hosek.wgsl"
      "lib/deferred_uniforms.wgsl"
      "lib/deferred_shade.wgsl"
      "lib/ssao_upsample.wgsl"
      "lib/fade_dither.wgsl"
      "lib/impostor_octahedral.wgsl"
      "lib/sprite_billboard.wgsl"
      "lib/forward_entry.wgsl"
    ])
    if deviceHasShaderF16() {
      billboardShader = shader(files: [
        "lib/precision_f16.wgsl"
        "lib/sky_hosek.wgsl"
        "lib/deferred_uniforms.wgsl"
        "lib/deferred_shade.wgsl"
        "lib/ssao_upsample.wgsl"
        "lib/fade_dither.wgsl"
        "lib/impostor_octahedral.wgsl"
        "lib/sprite_billboard.wgsl"
        "lib/forward_entry.wgsl"
      ])
    }
    if let pipeline: RenderPipelineId = createRenderPipelineWithConstants(
      resources: resources
      shader: billboardShader
      vertexEntry: "vs"
      fragmentEntry: "fsForward"
      spec: forwardMaterialSpec(
        litFormat: materials.litFormat
        stride: 0
        attributes: List.create(VertexAttributeSpec, cap: 0)
        depthWrite: true
        depthCompare: WGPUCompareFunction_Greater
        cullMode: WGPUCullMode_None
      )
      constants: forwardSsaoConstants(ssao: materials.ssao)
    ) {
      cache.forwardPipeline = pipeline
    }
  }
  if cache.forwardBindGen is cache.bindGen and cache.forwardInputsGen is materials.inputsGen and sameImpostorBinding(
    first: cache.forwardImpostors
    second: cache.impostors.binding
  ) and bindGroupIsUsable(resources: resources, id: cache.forwardBind) {
    ret
  }
  retireBindGroup(resources: resources, id: cache.forwardBind)
  cache.forwardBind = noBindGroupId()
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 18)
  addSpriteEntries(cache: cache, gbuffer: gbuffer, entries: entries)
  if not addForwardInputs(entries: entries, inputs: materials.inputs) {
    ret
  }
  if let bindGroup: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.forwardPipeline
    entries: entries
  ) {
    cache.forwardBind = bindGroup
    cache.forwardBindGen = cache.bindGen
    cache.forwardInputsGen = materials.inputsGen
    cache.forwardImpostors = cache.impostors.binding
  }
}

# Draw a batch of billboard instances from packed DrawU `records` (count of them):
# upload to the shared draws buffer at the running base, draw 6 procedural verts x
# count with the sprite pipeline. `records` is a raw record
# pointer into the caller's packed floats, hence unsafe. With `movedDepth`, an
# impostor writes the depth of the point it shows (it is lit and shadowed at
# its surface, not its quad); that turns off the early depth test for the
# batch, so a batch of far, small props passes false and keeps the quad's.
func drawSpriteInstances(
  cache: mod SpriteCache
  resources: mod GpuResources
  gbuffer: mod GbufferCache
  records: copy Ptr
  count: copy Int
  movedDepth: copy Bool
) unsafe {
  if count <= 0 {
    ret
  }
  ensurePipelineForDraw(cache: cache, resources: resources, gbuffer: gbuffer)
  # The hashed alpha test only where TAA resolves it
  var band: Float = 0.0
  if gbuffer.taaEnabled and not gbuffer.forwardFrame {
    band = spriteHashBand
  }
  if not (cache.uploadedBand is band) {
    writeSpriteUniform(cache: cache, resources: resources, band: band)
  }
  var pipeline: RenderPipelineId = cache.pipeline
  var bindGroup: BindGroupId = cache.bindGroup
  if not movedDepth {
    pipeline = cache.quadDepthPipeline
    bindGroup = cache.quadDepthBindGroup
  }
  if gbuffer.forwardFrame {
    ensureSpriteForward(cache: cache, resources: resources, gbuffer: gbuffer)
    pipeline = cache.forwardPipeline
    bindGroup = cache.forwardBind
  }
  unsafe {
    let base: Int = gbDrawCount(cache: gbuffer)
    if base + count > gbufferMaxDraws {
      ret
    }
    let strideBytes: Int = spriteRecordFloats * 4
    if not writeBufferFromPtr(
      resources: resources
      id: gbuffer.draws
      offset: base * strideBytes
      data: records
      size: count * strideBytes
    ) {
      ret
    }
    if not gbufferFrameActive(cache: gbuffer) {
      ret
    }
    let pass: Ptr = gbuffer.pass
    # No static re-bind after: every G-buffer draw binds its own pipeline (#912).
    if recordDrawInPass(
      resources: resources
      pass: pass
      pipeline: pipeline
      bindGroup: bindGroup
      vertexCount: 6
      instanceCount: count
      firstVertex: 0
      firstInstance: base
    ) {
      gbAdvanceDraws(cache: gbuffer, count: count)
      if gbuffer.forwardFrame and not cache.forwardDrawLogged {
        cache.forwardDrawLogged = true
        log("[sprite] billboards drawn in the forward pass: {count}")
      }
    }
  }
}

func ensurePipelineForDraw(
  cache: mod SpriteCache
  resources: mod GpuResources
  gbuffer: view GbufferCache
) {
  ensureSpritePipeline(cache: cache, resources: resources, gbuffer: gbuffer)
}

# Retire the pass's GPU objects (renderer shutdown); the array texture is the
# C side's and is released by its shutdown.
func spriteShutdown(cache: mod SpriteCache, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: cache.forwardBind)
  retireRenderPipeline(resources: resources, id: cache.forwardPipeline)
  retireBindGroup(resources: resources, id: cache.bindGroup)
  retireRenderPipeline(resources: resources, id: cache.pipeline)
  retireBindGroup(resources: resources, id: cache.quadDepthBindGroup)
  retireRenderPipeline(resources: resources, id: cache.quadDepthPipeline)
  retireBuffer(resources: resources, id: cache.uniform)
  retireSampler(resources: resources, id: cache.sampler)
  retireBuffer(resources: resources, id: cache.unusedFrames)
  retireImpostorAtlas(atlas: cache.impostors, resources: resources)
  releaseExternal(resources: resources, id: cache.arrayView)
  cache = createSpriteCache()
}
