# gbuffer_passes — the passes that consume the G-buffer, in Rae (#504).
#
# These are the deferred post-passes (composite, lighting, ssao, taa, depth
# pyramid). Each is a fullscreen pass built over the WebGPU bindings. Since
# #904 every object here is a typed ID in the DeferredRenderer-owned
# gpu/GpuResources manager, threaded in as `resources`; since #923 the pass
# TARGETS, uniforms and pipelines are the renderer's DeferredTargets
# (GbufferTargets.rae) and the G-buffer views the GbufferCache's, so the binds
# name IDs, the shadow inputs the renderer's ShadowCache's (#925), rebuilt at
# the targets' or the cascades' generation. The pass is opened in Rae over the
# bindings and submitted on the shared queue (gbSubmit) so graph order is
# preserved; the draw is recorded from the IDs.
import String
open Gpu2dCanvas
open Gbuffer
open Scene3d
open Vec3
open Sky
open LightUnits
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds
open GbufferResources
open GbufferTargets
open gpu/GpuTextures
open GbufferPassesNative
open GbufferFullscreen
open GbufferAo
open ShadowMaps

# Presentable target + resize generation (also declared in gbuffer_inspector;
# these bind the same C symbols).

# Composite: tonemap the last radiometric result into the presentable target.
func gbDeferredPrepare() ret Int {
  unsafe {
    ret nativeGbDeferredPrepare()
  }
}

# One fullscreen pass (clear + draw 3) into a C-owned `target` view, opened in
# Rae and submitted on the shared queue. The draw is recorded from manager IDs
# (a manager pipeline, or an adopted C pipeline via runFullscreenExternal).
type FullscreenPass {
  encoder: Ptr
  pass: Ptr
}

# #764: the deferred pass caches were module-level globals; they are per-frame
# state a deferred renderer owns, so they live in RenderPasses, threaded from
# DeferredRenderer through renderDeferredPassWorld. #904/#923: each holds its
# manager IDs — the pass's own objects and the bind groups (rebuilt at
# `bindGen`, the targets generation they were built at; the lighting bind also
# at `shadowGen`, the shadow cascades' generation).
type CompositePassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  uniform: BufferId
  sampler: SamplerId
  binds: List(BindGroupId)  # per source slot: TAA 0/1, no-TAA lit 2, anti-aliased 3
  bindGen: Int
  # The bloom the binds were built over: targets.bloomGen, -1 for none
  bloomKey: Int
  args: ArgWriter
}

type LightPassCache {
  bindGroup: BindGroupId
  bindGen: Int
  shadowGen: Int  # the ShadowCache targets generation the bind samples
}

type TaaPassCache {
  binds: List(BindGroupId)  # per ping-pong slot
  bindGen: Int
  sampler: SamplerId  # the history's Catmull-Rom fetch (linear, clamped)
}

# The antialias pass (FXAA at the scene resolution, before the upscale): its
# pipeline is built for the lit target's format, so it is made at the first
# frame that has targets.
type AntialiasPassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  uniform: BufferId
  sampler: SamplerId
  bind: BindGroupId
  bindGen: Int
  args: ArgWriter
}

func createAntialiasPassCache() ret AntialiasPassCache {
  ret AntialiasPassCache {
    pipeMade: false
    pipeline: noRenderPipelineId()
    uniform: noBufferId()
    sampler: noSamplerId()
    bind: noBindGroupId()
    bindGen: -1
    args: createArgs(uniform: true)
  }
}

type PyrPassCache {
  binds: List(BindGroupId)  # per mip
  bindGen: Int
}

# ----- colour grade (#556) --------------------------------------------------
#
# What the composite pass does after tone mapping. Held as data rather than as
# shader constants so a game can art-direct its look without a runtime rebuild,
# and so two apps sharing this library can look different.
#
# `neutralGrade()` is EXACTLY identity: ACES as before, contrast 1, saturation 1,
# no vibrance, no tint. Every existing caller gets it and sees no change.
type ColorGrade {
  # false = ACES (film emulation, the historical default)
  # true  = Khronos PBR Neutral (preserves albedo hue and saturation)
  pbrNeutral: Bool
  # Multiplier around mid-grey. 1.0 is identity; 1.1 is a gentle punch.
  contrast: Float
  # Saturation push weighted toward ALREADY-DULL pixels, so vivid ones do not
  # clip and lose hue. 0.0 is identity.
  vibrance: Float
  # Flat saturation multiply, applied after vibrance. 1.0 is identity.
  saturation: Float
  # Split tone. Added, not mixed, so keep these small (0.02-0.08 reads well).
  shadowTint: Vec3
  shadowTintStrength: Float
  highlightTint: Vec3
  highlightTintStrength: Float
}

# Identity. What every caller that does not ask for a grade gets.
func neutralGrade() pub ret ColorGrade {
  ret ColorGrade {
    pbrNeutral: false
    contrast: 1.0
    vibrance: 0.0
    saturation: 1.0
    shadowTint: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    shadowTintStrength: 0.0
    highlightTint: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    highlightTintStrength: 0.0
  }
}

# The composite's own objects, created once: the fullscreen pipeline in the
# presentable format, the 64-byte CompositeU uniform and the linear clamp
# sampler for the dynamic-resolution upscale (#530).
func ensureCompositeObjects(cache: mod CompositePassCache, resources: mod GpuResources) {
  if cache.pipeMade {
    ret
  }
  cache.pipeMade = true
  let compositeShader: Shader = shader(files: ["lib/deferred_composite.wgsl"])
  unsafe {
    cache.pipeline = createFullscreenPipeline(
      resources: resources
      shader: compositeShader
      format: g2dFormat() as Int32
    )
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 64
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
  if let sampler: SamplerId = createSampler(resources: resources) {
    cache.sampler = sampler
  }
}

# The shared prep of every post pass: the device + surface are up (C) and the
# targets exist for the current G-buffer generation.
func postPassReady(
  targets: mod DeferredTargets
  resources: mod GpuResources
  gbuffer: view GbufferCache
) ret Bool {
  if gbDeferredPrepare() is 0 {
    ret false
  }
  if not ensureDeferredTargets(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret false
  }
  ensureDeferredPipelines(targets: targets, resources: resources)
  # The TAA history exists only while TAA is on; without it the TAA pass and
  # the composite's TAA source have nothing to bind and are skipped.
  if targets.taaEnabled {
    let taaReady: Bool = ensureTaaTargets(targets: targets, resources: resources)
  }
  ret true
}

# Composite the lit/TAA result into the presentable target with exposure.
# What the composite multiplies the bloom by: 0 when bloom did not run.
func bloomStrength(targets: view DeferredTargets) ret Float {
  if targets.bloomWritten {
    ret targets.bloomIntensity
  }
  ret 0.0
}

func composite(
  cache: mod CompositePassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  canvas: mod Gpu2dCanvas
  exposure: copy Float
  grade: view ColorGrade
) pub {
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not canvasEnsureOffscreen(canvas: canvas) {
    ret
  }
  ensureCompositeObjects(cache: cache, resources: resources)

  # The source bind is per TAA slot (0/1) or the no-TAA lit slot (2), rebuilt
  # when the targets change (the source views were re-created then).
  # Bloom off or not run: the bloom slot holds the source again (bound, never
  # read), and the binds are rebuilt whenever that changes.
  var bloomKey: Int = -1
  if targets.bloomWritten {
    bloomKey = targets.bloomGen
  }
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) or not (bloomKey is cache.bloomKey) {
    cache.bindGen = gen
    cache.bloomKey = bloomKey
    retireBindGroupIds(resources: resources, list: cache.binds)
  }
  let idx: Int = compositeSourceIndex(targets: targets)
  if not bindSlotUsable(resources: resources, binds: cache.binds, idx: idx) {
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
    entries.add(value: bufferRef(id: cache.uniform))
    entries.add(value: compositeSourceRef(targets: targets))
    entries.add(value: samplerRef(id: cache.sampler))
    if targets.bloomWritten {
      entries.add(value: textureViewRef(id: targets.bloomView))
    } else {
      entries.add(value: compositeSourceRef(targets: targets))
    }
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: cache.pipeline
      entries: entries
    ) {
      cache.binds.set(index: idx, value: bind)
    }
  }

  # Four vec4s, matching CompositeU in the shader. Order is load-bearing. The
  # writer is held on the cache (allocated once) so the hot path stays
  # zero-alloc (#573).
  var opFlag: Float = 0.0
  if grade.pbrNeutral {
    opFlag = 1.0
  }
  resetArgs(writer: cache.args)
  pushVec4F(
    writer: cache.args
    x: exposure
    y: gbuffer.sceneScale
    z: opFlag
    w: grade.contrast
  )
  # y: #530 upscale ratio
  pushVec4F(
    writer: cache.args
    x: grade.vibrance
    y: grade.saturation
    z: grade.shadowTintStrength
    w: grade.highlightTintStrength
  )
  pushVec4F(
    writer: cache.args
    x: grade.shadowTint.x
    y: grade.shadowTint.y
    z: grade.shadowTint.z
    w: bloomStrength(targets: targets)
  )
  pushVec4F(
    writer: cache.args
    x: grade.highlightTint.x
    y: grade.highlightTint.y
    z: grade.highlightTint.z
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: cache.args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )

  if let bind: BindGroupId = cache.binds.copyAt(index: idx) {
    unsafe {
      let encoder: Ptr = postEncoder(targets: targets, resources: resources)
      runFullscreenInBatch(
        encoder: encoder
        resources: resources
        pipeline: cache.pipeline
        bind: bind
        target: canvasFrameTargetView(canvas: canvas)
      )
    }
  }
  # the next frame's antialias and bloom passes write them again, and the
  # next opaque snapshot is the next frame's
  targets.aaWritten = false
  targets.bloomWritten = false
  targets.litCopyFresh = false
  # The composite ends the renderer's part of the frame: submit every post
  # pass recorded since the frame began, before the UI's own submit.
  flushPostPasses(targets: targets, resources: resources)
}

# Public wrapper: the render graph's composite step (was gbuffer.compositePass).
# Ungraded, so every existing caller keeps the look it was calibrated against.
func compositePass(
  cache: mod CompositePassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  canvas: mod Gpu2dCanvas
  exposure: view Float
) pub {
  composite(
    cache: cache
    resources: resources
    targets: targets
    gbuffer: gbuffer
    canvas: canvas
    exposure: exposure
    grade: neutralGrade()
  )
}

# Composite with a look. See ColorGrade.
func compositePassGraded(
  cache: mod CompositePassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  canvas: mod Gpu2dCanvas
  exposure: view Float
  grade: view ColorGrade
) pub {
  composite(
    cache: cache
    resources: resources
    targets: targets
    gbuffer: gbuffer
    canvas: canvas
    exposure: exposure
    grade: grade
  )
}

# The light uniform both main passes read (LightU in deferred_uniforms.wgsl):
# the sun, the ambient hemisphere and the sky. With a bound sky its
# irradiance is the ambient, desaturated by the sky's own setting: a
# physically blue daylight sky lights every surface blue (a white ground
# albedo came out (0.59, 0.71, 0.96)), which makes warm materials unreachable;
# the default 1.0 is a no-op and the visible sky is untouched either way. A
# renderer without a bound sky passes createSkyNone. False when it could not
# be written.
func uploadSceneLight(
  targets: mod DeferredTargets
  resources: mod GpuResources
  gbuffer: view GbufferCache
  camera: view Camera3d
  light: view Light3d
  sky: view Sky
) ret Bool {
  let up: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let down: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: -1.0)
  # The light arrives in real units (LightUnits: the sun in lux, the ambient
  # in cd/m2) and is exposed here, where it is summed: the camera's scale
  # brings it into the range the lighting pass and the 16-bit HDR targets
  # hold. The sky models are exposed in the shader with the same scale.
  let scale: Float = exposureScale(ev100: light.ev100)
  # The night sky's moonlit ambient adds to the sky's own, which fades with the sun
  let skyC: Vec3 = Vec3.vscale(
    a: Vec3.vadd(
      a: desaturate(c: irradiance(sky: sky, normal: up), sat: sky.ambientSaturation)
      b: sky.nightAmbient
    )
    s: scale
  )
  let gndC: Vec3 = Vec3.vscale(
    a: Vec3.vadd(
      a: desaturate(c: irradiance(sky: sky, normal: down), sat: sky.ambientSaturation)
      b: Vec3.vscale(a: sky.nightAmbient, s: 0.5)
    )
    s: scale
  )
  setHosekChannel(targets: targets, c: sky.hosek.r, base: 0)
  setHosekChannel(targets: targets, c: sky.hosek.g, base: 12)
  setHosekChannel(targets: targets, c: sky.hosek.b, base: 24)
  ret uploadLightUniform(
    targets: targets
    resources: resources
    gbuffer: gbuffer
    camera: camera
    exposureScale: scale
    sunDir: light.sunDir
    sunColor: Vec3.vscale(a: light.sunColor, s: scale)
    skyAmbient: skyC
    groundAmbient: gndC
    skyKind: kindCode(sky: sky)
    turbidity: sky.turbidity
    skyExposure: sky.exposure
    sunSizeRad: sky.sunAngularRadius
    zenith: sky.zenithColor
    bands: sky.bands
    horizon: sky.horizonColor
    discIntensity: sky.sunDiscIntensity
    skySunDir: sky.sunDir
    moonDir: sky.moonDir
    moonRadius: sky.moonAngularRadius
    moonIntensity: sky.moonDiscIntensity
    nightLight: sky.nightLight
  )
}

# The deferred lighting pass: upload the light uniform, build the bind
# (rebuilt on resize and when the shadow cascades are recreated) and run the
# fullscreen pass into the lit target. The whole G-buffer + AO + the shadow
# cascades (the renderer's ShadowCache, #925 — its default targets when no
# shadow pass ran) are read once per pixel.
func lightingPassSky(
  cache: mod LightPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  shadow: mod ShadowCache
  camera: view Camera3d
  light: view Light3d
  sky: view Sky
) pub {
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  let uploaded: Bool = uploadSceneLight(
    targets: targets
    resources: resources
    gbuffer: gbuffer
    camera: camera
    light: light
    sky: sky
  )
  ensureShadowDefaults(shadow: shadow, resources: resources)
  if not shadowTargetsReady(shadow: shadow, resources: resources) {
    ret
  }
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) or not (shadow.gen is cache.shadowGen) {
    cache.bindGen = gen
    cache.shadowGen = shadow.gen
    retireBindGroup(resources: resources, id: cache.bindGroup)
    cache.bindGroup = noBindGroupId()
  }
  if not bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 10)
    entries.add(value: bufferRef(id: targets.lightUniform))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetA))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetB))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetC))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth))
    entries.add(value: textureViewRef(id: targets.aoView))
    entries.add(value: bufferRef(id: shadow.frameUniform))
    entries.add(value: textureViewRef(id: shadow.arrayView))
    entries.add(value: samplerRef(id: shadow.sampler))
    entries.add(value: textureViewRef(id: targets.aoDepthView))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: targets.lightPipeline
      entries: entries
    ) {
      cache.bindGroup = bind
    }
  }
  unsafe {
    let encoder: Ptr = postEncoder(targets: targets, resources: resources)
    runFullscreenInBatch(
      encoder: encoder
      resources: resources
      pipeline: targets.lightPipeline
      bind: cache.bindGroup
      target: textureViewHandle(resources: resources, id: targets.litView)
    )
  }
  # Lighting is the frame's heaviest pass: submit it (with SSAO before it) now,
  # so the GPU starts on it while the CPU records the rest of the frame.
  flushPostPasses(targets: targets, resources: resources)
}

# The FXAA pipeline, uniform and sampler, once (also the renderer's warm-up)
func ensureAntialiasObjects(
  cache: mod AntialiasPassCache
  resources: mod GpuResources
  format: copy Int32
) {
  if cache.pipeMade {
    ret
  }
  cache.pipeMade = true
  let antialiasShader: Shader = shader(files: ["lib/deferred_antialias.wgsl"])
  cache.pipeline = createFullscreenPipeline(
    resources: resources
    shader: antialiasShader
    format: format
  )
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 16
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
  if let sampler: SamplerId = createSampler(resources: resources) {
    cache.sampler = sampler
  }
}

# TAA resolve (#390): this frame's radiance + last frame's history, reprojected
# through the G-buffer's motion channel, into the slot the composite then
# reads. A no-op with TAA off (#20).
# FXAA at the SCENE resolution (render-perf-4): reads the lit image, writes
# the anti-aliased one the composite then upscales. It used to run inside the
# composite, after the upscale, where edges were already smeared and every
# native pixel was shaded five to nine times. A no-op with TAA on: TAA
# resolves the aliasing and the composite reads its history.
func antialiasPass(
  cache: mod AntialiasPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  exposure: view Float
) {
  if targets.taaEnabled {
    ret
  }
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  ensureAntialiasObjects(cache: cache, resources: resources, format: targets.litFormat)
  if not isValidRenderPipeline(resources: resources, id: cache.pipeline) {
    ret
  }
  if not (targets.gen is cache.bindGen) or not bindGroupIsUsable(
    resources: resources
    id: cache.bind
  ) {
    cache.bindGen = targets.gen
    retireBindGroup(resources: resources, id: cache.bind)
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: cache.uniform))
    entries.add(value: textureViewRef(id: targets.litView))
    entries.add(value: samplerRef(id: cache.sampler))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: cache.pipeline
      entries: entries
    ) {
      cache.bind = bind
    }
  }
  resetArgs(writer: cache.args)
  pushVec4F(
    writer: cache.args
    x: exposure
    y: 0.0
    z: 0.0
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: cache.args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )
  if bindGroupIsUsable(resources: resources, id: cache.bind) {
    unsafe {
      let encoder: Ptr = postEncoder(targets: targets, resources: resources)
      runFullscreenInBatch(
        encoder: encoder
        resources: resources
        pipeline: cache.pipeline
        bind: cache.bind
        target: textureViewHandle(resources: resources, id: targets.antialiasedView)
      )
    }
    targets.aaWritten = true
  }
}

func antialiasPassShutdown(cache: mod AntialiasPassCache, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: cache.bind)
  retireRenderPipeline(resources: resources, id: cache.pipeline)
  retireBuffer(resources: resources, id: cache.uniform)
  retireSampler(resources: resources, id: cache.sampler)
  cache = createAntialiasPassCache()
}

func taaPass(
  cache: mod TaaPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
) pub {
  if not targets.taaEnabled {
    ret
  }
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not isValidRenderPipeline(resources: resources, id: targets.taaPipeline) {
    ret
  }
  if not isValidSampler(resources: resources, id: cache.sampler) {
    if let sampler: SamplerId = createSampler(resources: resources) {
      cache.sampler = sampler
    }
  }
  let cur: Int = taaBegin(targets: targets, resources: resources)
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
  }
  if not bindSlotUsable(resources: resources, binds: cache.binds, idx: cur) {
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 7)
    entries.add(value: textureViewRef(id: targets.litView))
    entries.add(value: taaViewRef(targets: targets, slot: 1 - cur))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetC))
    entries.add(value: bufferRef(id: targets.taaUniform))
    # The reactive flag (gba.z) and the opaque snapshot (render-perf-10)
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetA))
    entries.add(value: textureViewRef(id: targets.litCopyView))
    entries.add(value: samplerRef(id: cache.sampler))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: targets.taaPipeline
      entries: entries
    ) {
      cache.binds.set(index: cur, value: bind)
    }
  }
  if let bind: BindGroupId = cache.binds.copyAt(index: cur) {
    if let target: TextureViewId = targets.taaViews.copyAt(index: cur) {
      unsafe {
        let encoder: Ptr = postEncoder(targets: targets, resources: resources)
        runFullscreenInBatch(
          encoder: encoder
          resources: resources
          pipeline: targets.taaPipeline
          bind: bind
          target: textureViewHandle(resources: resources, id: target)
        )
      }
    }
  }
  taaEnd(targets: targets)
}

# The depth pyramid: a MIN mip chain — level 0 reduces the G-buffer depth,
# every later level the one above, one single-entry fullscreen pass each (a
# level cannot be read until the pass that produced it finished). No shader
# samples it yet, so it is built only after a consumer called
# requestDepthPyramid; until then the pass costs nothing (render-perf-5).
func buildDepthPyramid(
  cache: mod PyrPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
) pub {
  if not targets.pyramidWanted {
    ret
  }
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not ensurePyramidTarget(targets: targets, resources: resources) {
    ret
  }
  if not isValidRenderPipeline(resources: resources, id: targets.pyrReduce) {
    ret
  }
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
  }
  let mips: Int = targets.pyramidMips
  loop cache.binds.length < mips {
    cache.binds.add(value: noBindGroupId())
  }
  # Every mip is its own render pass, recorded into the frame's post recording
  unsafe {
    let encoder: Ptr = postEncoder(targets: targets, resources: resources)
    var i: Int = 0
    loop i < mips {
      var pipeline: RenderPipelineId = targets.pyrReduce
      var source: ResourceRef = pyramidViewRef(targets: targets, level: i - 1)
      if i is 0 {
        pipeline = targets.pyrFromDepth
        source = gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth)
      }
      if not bindSlotUsable(resources: resources, binds: cache.binds, idx: i) {
        var entries: List(ResourceRef) = List.create(ResourceRef, cap: 1)
        entries.add(value: source)
        if let bind: BindGroupId = createRenderBindGroup(
          resources: resources
          pipeline: pipeline
          entries: entries
        ) {
          cache.binds.set(index: i, value: bind)
        } else {
          # The mips already recorded stay; the rest wait for a later frame
          ret
        }
      }
      if let bind: BindGroupId = cache.binds.copyAt(index: i) {
        if let target: TextureViewId = targets.pyramidViews.copyAt(index: i) {
          runFullscreenInBatch(
            encoder: encoder
            resources: resources
            pipeline: pipeline
            bind: bind
            target: textureViewHandle(resources: resources, id: target)
          )
        }
      }
      i = i + 1
    }
  }
}

# Retire every manager object the post-passes hold (renderer shutdown): the
# bind groups first (dropping their pins), then the composite / ssao objects. The targets, uniforms
# and
# pipelines are the DeferredTargets' (deferredTargetsShutdown).
func postPassesShutdown(
  composite: mod CompositePassCache
  ao: mod AoPassCache
  light: mod LightPassCache
  taa: mod TaaPassCache
  pyr: mod PyrPassCache
  resources: mod GpuResources
) {
  retireBindGroupIds(resources: resources, list: composite.binds)
  retireRenderPipeline(resources: resources, id: composite.pipeline)
  retireBuffer(resources: resources, id: composite.uniform)
  retireSampler(resources: resources, id: composite.sampler)
  composite = createCompositePassCache()
  aoPassShutdown(cache: ao, resources: resources)
  retireBindGroup(resources: resources, id: light.bindGroup)
  light = createLightPassCache()
  retireBindGroupIds(resources: resources, list: taa.binds)
  retireSampler(resources: resources, id: taa.sampler)
  taa = createTaaPassCache()
  retireBindGroupIds(resources: resources, list: pyr.binds)
  pyr = createPyrPassCache()
}
