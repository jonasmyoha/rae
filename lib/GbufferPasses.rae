# gbuffer_passes — the passes that consume the G-buffer, in Rae (#504).
#
# These are the deferred post-passes (composite, lighting, ssao, taa, depth
# pyramid). Each is a fullscreen pass built over the WebGPU bindings. Since
# #904 every object here is a typed ID in the DeferredRenderer-owned
# gpu/GpuResources manager, threaded in as `resources`; since #923 the pass
# TARGETS, uniforms and pipelines are the renderer's DeferredTargets
# (GbufferTargets.rae) and the G-buffer views the GbufferCache's, so the binds
# name IDs — only the lighting pass still ADOPTS the three shadow inputs (C
# until #925), per targets generation. The pass is opened in Rae over the
# bindings and submitted on the shared queue (gbSubmit) so graph order is
# preserved; the draw is recorded from the IDs.
import String
open Gpu2dCanvas
open Gbuffer
open Scene3d
open Vec3
open Sky
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds
open GbufferResources
open GbufferTargets
open gpu/GpuTextures
open GbufferPassesNative
open GbufferFullscreen

# Presentable target + resize generation (also declared in gbuffer_inspector;
# these bind the same C symbols).

# Composite: tonemap the last radiometric result into the presentable target.
func gbDeferredPrepare() ret Int {
  unsafe {
    ret nativeGbDeferredPrepare()
  }
}

# One fullscreen pass (clear + draw 3) into a C-owned `target` view, opened in
# Rae and submitted on the shared queue. The draw is recorded from manager IDs
# (a manager pipeline, or an adopted C pipeline via runFullscreenExternal).
type FullscreenPass {
  encoder: Ptr
  pass: Ptr
}

# #764: the deferred pass caches were module-level globals; they are per-frame
# state a deferred renderer owns, so they live in RenderPasses, threaded from
# DeferredRenderer through renderDeferredPassWorld. #904/#923: each holds its
# manager IDs — the pass's own objects and the bind groups (rebuilt at
# `bindGen`, the targets generation they were built at); the lighting cache
# also holds the adopted C shadow inputs of that generation.
type CompositePassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  uniform: BufferId
  sampler: SamplerId
  binds: List(BindGroupId)  # per source slot: TAA 0/1, no-TAA lit 2
  bindGen: Int
  args: ArgWriter
}

type AoPassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  bindGroup: BindGroupId
  bindGen: Int
}

type LightPassCache {
  bindGroup: BindGroupId
  adopted: List(ExternalId)  # the C shadow inputs (frame uniform, array view, sampler)
  bindGen: Int
}

type TaaPassCache {
  binds: List(BindGroupId)  # per ping-pong slot
  bindGen: Int
}

type PyrPassCache {
  binds: List(BindGroupId)  # per mip
  bindGen: Int
}

# ----- colour grade (#556) --------------------------------------------------
#
# What the composite pass does after tone mapping. Held as data rather than as
# shader constants so a game can art-direct its look without a runtime rebuild,
# and so two apps sharing this library can look different.
#
# `neutralGrade()` is EXACTLY identity: ACES as before, contrast 1, saturation 1,
# no vibrance, no tint. Every existing caller gets it and sees no change.
type ColorGrade {
  # false = ACES (film emulation, the historical default)
  # true  = Khronos PBR Neutral (preserves albedo hue and saturation)
  pbrNeutral: Bool
  # Multiplier around mid-grey. 1.0 is identity; 1.1 is a gentle punch.
  contrast: Float
  # Saturation push weighted toward ALREADY-DULL pixels, so vivid ones do not
  # clip and lose hue. 0.0 is identity.
  vibrance: Float
  # Flat saturation multiply, applied after vibrance. 1.0 is identity.
  saturation: Float
  # Split tone. Added, not mixed, so keep these small (0.02-0.08 reads well).
  shadowTint: Vec3
  shadowTintStrength: Float
  highlightTint: Vec3
  highlightTintStrength: Float
}

# Identity. What every caller that does not ask for a grade gets.
func neutralGrade() pub ret ColorGrade {
  ret ColorGrade {
    pbrNeutral: false
    contrast: 1.0
    vibrance: 0.0
    saturation: 1.0
    shadowTint: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    shadowTintStrength: 0.0
    highlightTint: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    highlightTintStrength: 0.0
  }
}

# The composite's own objects, created once: the fullscreen pipeline in the
# presentable format, the 64-byte CompositeU uniform and the linear clamp
# sampler for the dynamic-resolution upscale (#530).
func ensureCompositeObjects(cache: mod CompositePassCache, resources: mod GpuResources) {
  if cache.pipeMade {
    ret
  }
  cache.pipeMade = true
  unsafe {
    cache.pipeline = createFullscreenPipeline(
      resources: resources
      wgsl: gbCompositeWgsl()
      format: g2dFormat() as Int32
    )
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 64
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
  if let sampler: SamplerId = createSampler(resources: resources) {
    cache.sampler = sampler
  }
}

# The shared prep of every post pass: the device + surface are up (C) and the
# targets exist for the current G-buffer generation.
func postPassReady(
  targets: mod DeferredTargets
  resources: mod GpuResources
  gbuffer: view GbufferCache
) ret Bool {
  if gbDeferredPrepare() is 0 {
    ret false
  }
  if not ensureDeferredTargets(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret false
  }
  ensureDeferredPipelines(targets: targets, resources: resources)
  ret true
}

# Composite the lit/TAA result into the presentable target with exposure.
func composite(
  cache: mod CompositePassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  canvas: mod Gpu2dCanvas
  exposure: copy Float
  grade: view ColorGrade
) pub {
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not canvasEnsureOffscreen(canvas: canvas) {
    ret
  }
  ensureCompositeObjects(cache: cache, resources: resources)

  # The source bind is per TAA slot (0/1) or the no-TAA lit slot (2), rebuilt
  # when the targets change (the source views were re-created then).
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
  }
  let idx: Int = compositeSourceIndex(targets: targets)
  if not bindSlotUsable(resources: resources, binds: cache.binds, idx: idx) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: cache.uniform))
    entries.add(value: compositeSourceRef(targets: targets))
    entries.add(value: samplerRef(id: cache.sampler))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: cache.pipeline
      entries: entries
    ) {
      cache.binds.set(index: idx, value: bind)
    }
  }

  # Four vec4s, matching CompositeU in the shader. Order is load-bearing. The
  # writer is held on the cache (allocated once) so the hot path stays
  # zero-alloc (#573).
  var opFlag: Float = 0.0
  if grade.pbrNeutral {
    opFlag = 1.0
  }
  # p2.w = FXAA flag (#20): on exactly when TAA is off, so the aliasing TAA used
  # to resolve gets a spatial pass instead. Identity when TAA is enabled.
  var fxaaFlag: Float = 0.0
  if not targets.taaEnabled {
    fxaaFlag = 1.0
  }
  resetArgs(writer: cache.args)
  pushVec4F(
    writer: cache.args
    x: exposure
    y: gbRenderScale() as Float
    z: opFlag
    w: grade.contrast
  )
  # y: #530 upscale ratio
  pushVec4F(
    writer: cache.args
    x: grade.vibrance
    y: grade.saturation
    z: grade.shadowTintStrength
    w: grade.highlightTintStrength
  )
  pushVec4F(
    writer: cache.args
    x: grade.shadowTint.x
    y: grade.shadowTint.y
    z: grade.shadowTint.z
    w: fxaaFlag
  )
  pushVec4F(
    writer: cache.args
    x: grade.highlightTint.x
    y: grade.highlightTint.y
    z: grade.highlightTint.z
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: cache.args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )

  if let bind: BindGroupId = cache.binds.copyAt(index: idx) {
    unsafe {
      runFullscreen(
        resources: resources
        pipeline: cache.pipeline
        bind: bind
        target: canvasOffscreenView(canvas: canvas)
      )
    }
  }
}

# Public wrapper: the render graph's composite step (was gbuffer.compositePass).
# Ungraded, so every existing caller keeps the look it was calibrated against.
func compositePass(
  cache: mod CompositePassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  canvas: mod Gpu2dCanvas
  exposure: view Float
) pub {
  composite(
    cache: cache
    resources: resources
    targets: targets
    gbuffer: gbuffer
    canvas: canvas
    exposure: exposure
    grade: neutralGrade()
  )
}

# Composite with a look. See ColorGrade.
func compositePassGraded(
  cache: mod CompositePassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  canvas: mod Gpu2dCanvas
  exposure: view Float
  grade: view ColorGrade
) pub {
  composite(
    cache: cache
    resources: resources
    targets: targets
    gbuffer: gbuffer
    canvas: canvas
    exposure: exposure
    grade: grade
  )
}

# SSAO (#387): reads the G-buffer normal (A) + depth, writes the R8 AO target.
# Its uniform (inverse jittered viewProj + camera) is the light uniform's head,
# written here since it runs before lighting.
func ssaoPass(
  cache: mod AoPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  camera: view Camera3d
) pub {
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not cache.pipeMade {
    cache.pipeMade = true
    unsafe {
      cache.pipeline = createFullscreenPipeline(
        resources: resources
        wgsl: gbAoWgsl()
        format: WGPUTextureFormat_R8Unorm
      )
    }
  }
  let uploaded: Bool = uploadSsaoUniform(
    targets: targets
    resources: resources
    gbuffer: gbuffer
    camera: camera
  )
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroup(resources: resources, id: cache.bindGroup)
    cache.bindGroup = noBindGroupId()
  }
  if not bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: targets.lightUniform))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetA))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: cache.pipeline
      entries: entries
    ) {
      cache.bindGroup = bind
    }
  }
  unsafe {
    runFullscreen(
      resources: resources
      pipeline: cache.pipeline
      bind: cache.bindGroup
      target: textureViewHandle(resources: resources, id: targets.aoView)
    )
  }
}

# Low-level lighting: upload the uniform, build the bind (rebuilt on resize)
# and run the fullscreen pass into the lit target. The whole G-buffer + AO +
# the shadow cascades (adopted, C until #925) are read once per pixel.
func lighting(
  cache: mod LightPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  camera: view Camera3d
  exposure: copy Float
  sunDir: view Vec3
  sunColor: view Vec3
  skyAmbient: view Vec3
  groundAmbient: view Vec3
  skyKind: copy Float
  turbidity: copy Float
  skyExposure: copy Float
  sunSizeRad: copy Float
  zenith: view Vec3
  bands: copy Float
  horizon: view Vec3
  discIntensity: copy Float
) {
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  let uploaded: Bool = uploadLightUniform(
    targets: targets
    resources: resources
    gbuffer: gbuffer
    camera: camera
    exposure: exposure
    sunDir: sunDir
    sunColor: sunColor
    skyAmbient: skyAmbient
    groundAmbient: groundAmbient
    skyKind: skyKind
    turbidity: turbidity
    skyExposure: skyExposure
    sunSizeRad: sunSizeRad
    zenith: zenith
    bands: bands
    horizon: horizon
    discIntensity: discIntensity
  )
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroup(resources: resources, id: cache.bindGroup)
    cache.bindGroup = noBindGroupId()
    releaseExternalIds(resources: resources, list: cache.adopted)
  }
  if not bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 9)
    entries.add(value: bufferRef(id: targets.lightUniform))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetA))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetB))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetC))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth))
    entries.add(value: textureViewRef(id: targets.aoView))
    unsafe {
      entries.add(
        value: adoptBufferRef(
          resources: resources
          adopted: cache.adopted
          handle: gbShadowFrameUbuf()
        )
      )
      entries.add(
        value: adoptTextureViewRef(
          resources: resources
          adopted: cache.adopted
          handle: gbShadowArrayView()
        )
      )
      entries.add(
        value: adoptSamplerRef(
          resources: resources
          adopted: cache.adopted
          handle: gbShadowSampler()
        )
      )
    }
    var made: Bool = false
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: targets.lightPipeline
      entries: entries
    ) {
      cache.bindGroup = bind
      made = true
    }
    if not made {
      releaseExternalIds(resources: resources, list: cache.adopted)
    }
  }
  unsafe {
    runFullscreen(
      resources: resources
      pipeline: targets.lightPipeline
      bind: cache.bindGroup
      target: textureViewHandle(resources: resources, id: targets.litView)
    )
  }
}

# Public: lighting with a bound sky environment (Hosek ambient + background).
func lightingPassSky(
  cache: mod LightPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  camera: view Camera3d
  light: view Light3d
  sky: view Sky
) pub {
  let up: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let down: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0 - 1.0)
  # DESATURATED BY THE SKY'S OWN SETTING. The sky's irradiance is THE ambient
  # term here, so a physically blue daylight sky lights every surface blue --
  # measured, a white ground albedo came out (0.59, 0.71, 0.96), which makes warm
  # materials unreachable at any albedo. Default is 1.0, so this is a no-op for
  # every existing caller; the visible sky is untouched either way.
  let skyC: Vec3 = desaturate(c: irradiance(sky: sky, normal: up), sat: sky.ambientSaturation)
  let gndC: Vec3 = desaturate(c: irradiance(sky: sky, normal: down), sat: sky.ambientSaturation)
  setHosekChannel(targets: targets, c: sky.hosek.r, base: 0)
  setHosekChannel(targets: targets, c: sky.hosek.g, base: 12)
  setHosekChannel(targets: targets, c: sky.hosek.b, base: 24)
  lighting(
    cache: cache
    resources: resources
    targets: targets
    gbuffer: gbuffer
    camera: camera
    exposure: light.exposure
    sunDir: light.sunDir
    sunColor: light.sunColor
    skyAmbient: skyC
    groundAmbient: gndC
    skyKind: kindCode(sky: sky)
    turbidity: sky.turbidity
    skyExposure: sky.exposure
    sunSizeRad: sky.sunAngularRadius
    zenith: sky.zenithColor
    bands: sky.bands
    horizon: sky.horizonColor
    discIntensity: sky.sunDiscIntensity
  )
}

# Public: lighting with the authored ambient hemisphere, no sky.
func lightingPass(
  cache: mod LightPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  camera: view Camera3d
  light: view Light3d
) pub {
  let zero: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  lighting(
    cache: cache
    resources: resources
    targets: targets
    gbuffer: gbuffer
    camera: camera
    exposure: light.exposure
    sunDir: light.sunDir
    sunColor: light.sunColor
    skyAmbient: light.ambSky
    groundAmbient: light.ambGround
    skyKind: 0.0
    turbidity: 3.0
    skyExposure: 1.0
    sunSizeRad: 0.0047
    zenith: zero
    bands: 1.0
    horizon: zero
    discIntensity: 0.0
  )
}

# TAA resolve (#390): this frame's radiance + last frame's history, reprojected
# through the G-buffer's motion channel, into the slot the composite then
# reads. A no-op with TAA off (#20).
func taaPass(
  cache: mod TaaPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
) pub {
  if not targets.taaEnabled {
    ret
  }
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not isValidRenderPipeline(resources: resources, id: targets.taaPipeline) {
    ret
  }
  let cur: Int = taaBegin(targets: targets, resources: resources)
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
  }
  if not bindSlotUsable(resources: resources, binds: cache.binds, idx: cur) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
    entries.add(value: textureViewRef(id: targets.litView))
    entries.add(value: taaViewRef(targets: targets, slot: 1 - cur))
    entries.add(value: gbufferTargetRef(cache: gbuffer, index: gbufferTargetC))
    entries.add(value: bufferRef(id: targets.taaUniform))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: targets.taaPipeline
      entries: entries
    ) {
      cache.binds.set(index: cur, value: bind)
    }
  }
  if let bind: BindGroupId = cache.binds.copyAt(index: cur) {
    if let target: TextureViewId = targets.taaViews.copyAt(index: cur) {
      unsafe {
        runFullscreen(
          resources: resources
          pipeline: targets.taaPipeline
          bind: bind
          target: textureViewHandle(resources: resources, id: target)
        )
      }
    }
  }
  taaEnd(targets: targets)
}

# The depth pyramid: a MIN mip chain — level 0 reduces the G-buffer depth,
# every later level the one above, one single-entry fullscreen pass each (a
# level cannot be read until the pass that produced it finished).
func buildDepthPyramid(
  cache: mod PyrPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
) pub {
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  if not isValidRenderPipeline(resources: resources, id: targets.pyrReduce) {
    ret
  }
  let gen: Int = targets.gen
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
  }
  let mips: Int = targets.pyramidMips
  loop cache.binds.length < mips {
    cache.binds.add(value: noBindGroupId())
  }
  var i: Int = 0
  loop i < mips {
    var pipeline: RenderPipelineId = targets.pyrReduce
    var source: ResourceRef = pyramidViewRef(targets: targets, level: i - 1)
    if i is 0 {
      pipeline = targets.pyrFromDepth
      source = gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth)
    }
    if not bindSlotUsable(resources: resources, binds: cache.binds, idx: i) {
      let entries: List(ResourceRef) = List.create(ResourceRef, cap: 1)
      entries.add(value: source)
      if let bind: BindGroupId = createRenderBindGroup(
        resources: resources
        pipeline: pipeline
        entries: entries
      ) {
        cache.binds.set(index: i, value: bind)
      } else {
        ret
      }
    }
    if let bind: BindGroupId = cache.binds.copyAt(index: i) {
      if let target: TextureViewId = targets.pyramidViews.copyAt(index: i) {
        unsafe {
          runFullscreen(
            resources: resources
            pipeline: pipeline
            bind: bind
            target: textureViewHandle(resources: resources, id: target)
          )
        }
      }
    }
    i = i + 1
  }
}

# Retire every manager object the post-passes hold (renderer shutdown): the
# bind groups first (dropping their pins), then the lighting's adopted shadow
# inputs, then the composite / ssao objects. The targets, uniforms and
# pipelines are the DeferredTargets' (deferredTargetsShutdown).
func postPassesShutdown(
  composite: mod CompositePassCache
  ao: mod AoPassCache
  light: mod LightPassCache
  taa: mod TaaPassCache
  pyr: mod PyrPassCache
  resources: mod GpuResources
) {
  retireBindGroupIds(resources: resources, list: composite.binds)
  retireRenderPipeline(resources: resources, id: composite.pipeline)
  retireBuffer(resources: resources, id: composite.uniform)
  retireSampler(resources: resources, id: composite.sampler)
  composite = createCompositePassCache()
  retireBindGroup(resources: resources, id: ao.bindGroup)
  retireRenderPipeline(resources: resources, id: ao.pipeline)
  ao = createAoPassCache()
  retireBindGroup(resources: resources, id: light.bindGroup)
  releaseExternalIds(resources: resources, list: light.adopted)
  light = createLightPassCache()
  retireBindGroupIds(resources: resources, list: taa.binds)
  taa = createTaaPassCache()
  retireBindGroupIds(resources: resources, list: pyr.binds)
  pyr = createPyrPassCache()
}
