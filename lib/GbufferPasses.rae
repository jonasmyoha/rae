# gbuffer_passes — the passes that consume the G-buffer, in Rae (#504).
#
# These are the deferred post-passes (composite, lighting, ssao, taa, depth
# pyramid). Each is a fullscreen pass built over the WebGPU bindings. Since
# #904 every Rae-created object here (the composite / ssao pipelines, the
# composite uniform + upscale sampler, every bind group) is a typed ID in the
# DeferredRenderer-owned gpu/GpuResources manager, threaded in as `resources`;
# the C-owned inputs (the G-buffer views, the light / taa / shadow uniforms,
# the lighting / taa / pyramid pipelines and the pass targets) are ADOPTED as
# externals per targets generation and re-adopted when it changes. The pass is
# still opened in Rae over the bindings and submitted on the shared queue
# (gbSubmit) so graph order is preserved; the draw is recorded from the IDs.
import String
open Gbuffer
open Scene3d
open Vec3
open Sky
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds

# Presentable target + resize generation (also declared in gbuffer_inspector;
# these bind the same C symbols).

# Composite: tonemap the last radiometric result into the presentable target.
func nativeGbDeferredPrepare() unsafe extern("rae_gb_deferred_prepare") ret Int
func gbDeferredPrepare() ret Int {
  unsafe { ret nativeGbDeferredPrepare() }
}
# The pass WGSL sources stay C string constants; read as NUL-terminated C
# strings and copied into a String for the manager's createRenderPipeline.
func gbCompositeWgsl() unsafe extern("rae_gb_composite_wgsl") ret Buffer(Any)
func gbCompositeSourceView() unsafe extern("rae_gb_composite_source_view") ret Ptr
func nativeGbCompositeSourceIndex() unsafe extern("rae_gb_composite_source_index") ret Int
func gbCompositeSourceIndex() ret Int {
  unsafe { ret nativeGbCompositeSourceIndex() }
}
# TAA on/off (#20). Off routes composite to raw lit and turns on FXAA instead.
func nativeGbTaaIsEnabled() unsafe extern("rae_gb_taa_is_enabled") ret Int
func gbTaaIsEnabled() ret Int {
  unsafe { ret nativeGbTaaIsEnabled() }
}
func nativeGbSetTaaEnabled(on: Int) unsafe extern("rae_gb_set_taa_enabled")
func gbSetTaaEnabled(on: copy Int) {
  unsafe { nativeGbSetTaaEnabled(on: on) }
}
# Distance fog (#57, per-app). on=1 fades geometry to (r,g,b) over [start,end]
# world units and paints that colour as the background; on=0 keeps the sky.
func nativeGbSetFog(on: Int, r: Float, g: Float, b: Float, start: Float, end: Float) unsafe extern("rae_gb_set_fog")
func gbSetFog(on: copy Int, r: copy Float, g: copy Float, b: copy Float, start: copy Float, end: copy Float) {
  unsafe { nativeGbSetFog(on: on, r: r, g: g, b: b, start: start, end: end) }
}
# Dynamic resolution (#530): the current render scale (the upscale sampler is
# a manager sampler on the composite cache).
func nativeGbRenderScale() unsafe extern("rae_gb_render_scale") ret Float64
func gbRenderScale() ret Float64 {
  unsafe { ret nativeGbRenderScale() }
}

# A fullscreen pipeline: no vertex buffer, no depth, no cull, one colour
# target. The reusable primitive every deferred post-pass builds on.
func fullscreenPipelineSpec(format: copy Int32) ret RenderPipelineSpec {
  let colorFormats: List(Int32) = List.create(Int32, cap: 1)
  colorFormats.add(value: format)
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 1)
  ret RenderPipelineSpec {
    vertexStride: 0, attributes: own attributes, colorFormats: own colorFormats,
    alphaBlend: false, depthFormat: 0 as Int32, depthWrite: false,
    depthCompare: WGPUCompareFunction_Always, cullMode: WGPUCullMode_None
  }
}

func createFullscreenPipeline(resources: mod GpuResources, wgsl: view Buffer(Any), format: copy Int32) ret RenderPipelineId {
  var source: String = ""
  unsafe { source = String.fromCStr(s: wgsl) }
  if let pipeline: RenderPipelineId = createRenderPipeline(resources: resources, wgsl: source, vertexEntry: "vs", fragmentEntry: "fs", spec: fullscreenPipelineSpec(format: format)) {
    ret pipeline
  }
  ret noRenderPipelineId()
}

# One fullscreen pass (clear + draw 3) into a C-owned `target` view, opened in
# Rae and submitted on the shared queue. The draw is recorded from manager IDs
# (a manager pipeline, or an adopted C pipeline via runFullscreenExternal).
type FullscreenPass { encoder: Ptr, pass: Ptr }

func beginFullscreen(target: copy Ptr) unsafe ret FullscreenPass {
  unsafe {
    let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
    var atts: List(WGPURenderPassColorAttachment) = List.create(WGPURenderPassColorAttachment, cap: 1)
    atts.add(value: {
      view_: target, depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
      loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store
    })
    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 1 as UInt64, colorAttachments: atts.data
    }
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    ret FullscreenPass { encoder: enc, pass: pass }
  }
}

func endFullscreen(fullscreen: view FullscreenPass) unsafe {
  unsafe {
    wgpuRenderPassEncoderEnd(renderPassEncoder: fullscreen.pass)
    let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
    let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: fullscreen.encoder, descriptor: cbDesc)
    gbSubmit(cmd: cmd)
    wgpuCommandBufferRelease(commandBuffer: cmd)
    wgpuRenderPassEncoderRelease(renderPassEncoder: fullscreen.pass)
    wgpuCommandEncoderRelease(commandEncoder: fullscreen.encoder)
  }
}

func runFullscreen(resources: view GpuResources, pipeline: view RenderPipelineId, bind: view BindGroupId, target: copy Ptr) {
  unsafe {
    if target is webgpuNull() { ret }
    let fullscreen: FullscreenPass = beginFullscreen(target: target)
    let drawn: Bool = recordDrawInPass(resources: resources, pass: fullscreen.pass, pipeline: pipeline, bindGroup: bind, vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0)
    endFullscreen(fullscreen: fullscreen)
  }
}

func runFullscreenExternal(resources: view GpuResources, pipeline: view ExternalId, bind: view BindGroupId, target: copy Ptr) {
  unsafe {
    if target is webgpuNull() { ret }
    let fullscreen: FullscreenPass = beginFullscreen(target: target)
    let drawn: Bool = recordDrawInPassExternal(resources: resources, pass: fullscreen.pass, pipeline: pipeline, bindGroup: bind, vertexCount: 3, instanceCount: 1, firstVertex: 0, firstInstance: 0)
    endFullscreen(fullscreen: fullscreen)
  }
}

# #764: the deferred pass caches were module-level globals; they are per-frame
# state a deferred renderer owns, so they live in RenderPasses, threaded from
# DeferredRenderer through renderDeferredPassWorld. #904: each holds its manager
# IDs — the pass's own objects, the bind groups (rebuilt at `bindGen`, the
# targets generation they were built at) and `adopted`, the C-owned inputs
# adopted for that generation and released with the binds.
type CompositePassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  uniform: BufferId
  sampler: SamplerId
  binds: List(BindGroupId)      # per source slot: TAA 0/1, no-TAA lit 2
  adopted: List(ExternalId)
  bindGen: Int
  args: ArgWriter
}
type AoPassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  bindGroup: BindGroupId
  adopted: List(ExternalId)
  bindGen: Int
}
type LightPassCache {
  pipeline: ExternalId          # the C-owned lighting pipeline, adopted
  bindGroup: BindGroupId
  adopted: List(ExternalId)
  bindGen: Int
}
type TaaPassCache {
  pipeline: ExternalId          # the C-owned resolve pipeline, adopted
  binds: List(BindGroupId)      # per ping-pong slot
  adopted: List(ExternalId)
  bindGen: Int
}
type PyrPassCache {
  fromDepth: ExternalId         # the C-owned level-0 pipeline, adopted
  reduce: ExternalId            # the C-owned reduce pipeline, adopted
  binds: List(BindGroupId)      # per mip
  adopted: List(ExternalId)
  bindGen: Int
}

func createCompositePassCache() ret CompositePassCache {
  ret CompositePassCache {
    pipeMade: false, pipeline: noRenderPipelineId(), uniform: noBufferId(), sampler: noSamplerId(),
    binds: fillBindGroupIds(count: 3), adopted: List.create(ExternalId, cap: 4), bindGen: 0 - 1,
    args: createArgs(uniform: true)
  }
}
func createAoPassCache() ret AoPassCache {
  ret AoPassCache { pipeMade: false, pipeline: noRenderPipelineId(), bindGroup: noBindGroupId(), adopted: List.create(ExternalId, cap: 4), bindGen: 0 - 1 }
}
func createLightPassCache() ret LightPassCache {
  ret LightPassCache { pipeline: noExternalId(), bindGroup: noBindGroupId(), adopted: List.create(ExternalId, cap: 10), bindGen: 0 - 1 }
}
func createTaaPassCache() ret TaaPassCache {
  ret TaaPassCache { pipeline: noExternalId(), binds: fillBindGroupIds(count: 2), adopted: List.create(ExternalId, cap: 10), bindGen: 0 - 1 }
}
func createPyrPassCache() ret PyrPassCache {
  ret PyrPassCache { fromDepth: noExternalId(), reduce: noExternalId(), binds: List.create(BindGroupId, cap: 16), adopted: List.create(ExternalId, cap: 20), bindGen: 0 - 1 }
}

# A failed bind build (a C input not up yet) resets the pass's generation
# state — binds retired, adoptions released — so the retry next frame starts
# clean instead of accumulating adopted slots.
func failPassGeneration(resources: mod GpuResources, binds: mod List(BindGroupId), adopted: mod List(ExternalId)) {
  retireBindGroupIds(resources: resources, list: binds)
  releaseExternalIds(resources: resources, list: adopted)
}

# A bind slot is usable when its group is live AND its adopted inputs still
# are (the generation check above retires both together).
func bindSlotUsable(resources: view GpuResources, binds: view List(BindGroupId), idx: copy Int) ret Bool {
  if let bind: BindGroupId = binds.copyAt(index: idx) { ret bindGroupIsUsable(resources: resources, id: bind) }
  ret false
}

# ----- colour grade (#556) --------------------------------------------------
#
# What the composite pass does after tone mapping. Held as data rather than as
# shader constants so a game can art-direct its look without a runtime rebuild,
# and so two apps sharing this library can look different.
#
# `neutralGrade()` is EXACTLY identity: ACES as before, contrast 1, saturation 1,
# no vibrance, no tint. Every existing caller gets it and sees no change.
type ColorGrade {
  # false = ACES (film emulation, the historical default)
  # true  = Khronos PBR Neutral (preserves albedo hue and saturation)
  pbrNeutral: Bool
  # Multiplier around mid-grey. 1.0 is identity; 1.1 is a gentle punch.
  contrast: Float
  # Saturation push weighted toward ALREADY-DULL pixels, so vivid ones do not
  # clip and lose hue. 0.0 is identity.
  vibrance: Float
  # Flat saturation multiply, applied after vibrance. 1.0 is identity.
  saturation: Float
  # Split tone. Added, not mixed, so keep these small (0.02-0.08 reads well).
  shadowTint: Vec3
  shadowTintStrength: Float
  highlightTint: Vec3
  highlightTintStrength: Float
}

# Identity. What every caller that does not ask for a grade gets.
func neutralGrade() pub ret ColorGrade {
  ret ColorGrade {
    pbrNeutral: false, contrast: 1.0, vibrance: 0.0, saturation: 1.0,
    shadowTint: Vec3.create(x: 0.0, y: 0.0, z: 0.0), shadowTintStrength: 0.0,
    highlightTint: Vec3.create(x: 0.0, y: 0.0, z: 0.0), highlightTintStrength: 0.0
  }
}

# The composite's own objects, created once: the fullscreen pipeline in the
# presentable format, the 64-byte CompositeU uniform and the linear clamp
# sampler for the dynamic-resolution upscale (#530).
func ensureCompositeObjects(cache: mod CompositePassCache, resources: mod GpuResources) {
  if cache.pipeMade { ret }
  cache.pipeMade = true
  unsafe { cache.pipeline = createFullscreenPipeline(resources: resources, wgsl: gbCompositeWgsl(), format: g2dFormat() as Int32) }
  if let uniform: BufferId = createBuffer(resources: resources, size: 64, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) { cache.uniform = uniform }
  if let sampler: SamplerId = createSampler(resources: resources) { cache.sampler = sampler }
}

# Composite the lit/TAA result into the presentable target with exposure.
func composite(cache: mod CompositePassCache, resources: mod GpuResources, exposure: copy Float, grade: view ColorGrade) pub {
  if gbDeferredPrepare() is 0 { ret }
  ensureCompositeObjects(cache: cache, resources: resources)

  # The source bind is per TAA slot (0/1) or the no-TAA lit slot (2), rebuilt
  # when the targets change (the source views were re-created then).
  let gen: Int = gbTargetsGen()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
    releaseExternalIds(resources: resources, list: cache.adopted)
  }
  let idx: Int = gbCompositeSourceIndex()
  if not bindSlotUsable(resources: resources, binds: cache.binds, idx: idx) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: cache.uniform))
    unsafe { entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbCompositeSourceView())) }
    entries.add(value: samplerRef(id: cache.sampler))
    var made: Bool = false
    if let bind: BindGroupId = createRenderBindGroup(resources: resources, pipeline: cache.pipeline, entries: entries) {
      cache.binds.set(index: idx, value: bind)
      made = true
    }
    # A failed build (an input not up yet) drops this generation's adoptions
    # so a retry next frame does not accumulate slots.
    if not made { failPassGeneration(resources: resources, binds: cache.binds, adopted: cache.adopted) }
  }

  # Four vec4s, matching CompositeU in the shader. Order is load-bearing. The
  # writer is held on the cache (allocated once) so the hot path stays
  # zero-alloc (#573).
  var opFlag: Float = 0.0
  if grade.pbrNeutral { opFlag = 1.0 }
  # p2.w = FXAA flag (#20): on exactly when TAA is off, so the aliasing TAA used
  # to resolve gets a spatial pass instead. Identity when TAA is enabled.
  var fxaaFlag: Float = 0.0
  if gbTaaIsEnabled() is 0 { fxaaFlag = 1.0 }
  resetArgs(writer: cache.args)
  pushVec4F(writer: cache.args, x: exposure, y: gbRenderScale() as Float, z: opFlag, w: grade.contrast)   # y: #530 upscale ratio
  pushVec4F(writer: cache.args, x: grade.vibrance, y: grade.saturation, z: grade.shadowTintStrength, w: grade.highlightTintStrength)
  pushVec4F(writer: cache.args, x: grade.shadowTint.x, y: grade.shadowTint.y, z: grade.shadowTint.z, w: fxaaFlag)
  pushVec4F(writer: cache.args, x: grade.highlightTint.x, y: grade.highlightTint.y, z: grade.highlightTint.z, w: 0.0)
  let uploaded: Bool = uploadArgs(writer: cache.args, resources: resources, buffer: cache.uniform, offset: 0)

  if let bind: BindGroupId = cache.binds.copyAt(index: idx) {
    unsafe { runFullscreen(resources: resources, pipeline: cache.pipeline, bind: bind, target: g2dOffView()) }
  }
}

# Public wrapper: the render graph's composite step (was gbuffer.compositePass).
# Ungraded, so every existing caller keeps the look it was calibrated against.
func compositePass(cache: mod CompositePassCache, resources: mod GpuResources, exposure: view Float) pub {
  composite(cache: cache, resources: resources, exposure: exposure, grade: neutralGrade())
}

# Composite with a look. See ColorGrade.
func compositePassGraded(cache: mod CompositePassCache, resources: mod GpuResources, exposure: view Float, grade: view ColorGrade) pub {
  composite(cache: cache, resources: resources, exposure: exposure, grade: grade)
}

# ----- SSAO: screen-space ambient occlusion (#504) ---------------------------
# Reads the G-buffer normal (A) + depth, writes the R8 AO target. The uniform
# (inverse jittered viewProj + camera pos) is C math, uploaded into the shared
# light uniform by gbSsaoUpload.
func nativeGbSsaoUpload(camX: Float, camY: Float, camZ: Float) unsafe extern("rae_gb_ssao_upload")
func gbSsaoUpload(camX: copy Float, camY: copy Float, camZ: copy Float) {
  unsafe { nativeGbSsaoUpload(camX: camX, camY: camY, camZ: camZ) }
}
func gbAoWgsl() unsafe extern("rae_gb_ao_wgsl") ret Buffer(Any)
func gbAoView() unsafe extern("rae_gb_ao_view") ret Ptr
func gbLightUbuf() unsafe extern("rae_gb_light_ubuf") ret Ptr
func nativeGbLightBytes() unsafe extern("rae_gb_light_bytes") ret Int
func gbLightBytes() ret Int {
  unsafe { ret nativeGbLightBytes() }
}

func ssao(cache: mod AoPassCache, resources: mod GpuResources, camX: copy Float, camY: copy Float, camZ: copy Float) pub {
  if gbDeferredPrepare() is 0 { ret }
  if not cache.pipeMade {
    cache.pipeMade = true
    unsafe { cache.pipeline = createFullscreenPipeline(resources: resources, wgsl: gbAoWgsl(), format: WGPUTextureFormat_R8Unorm) }
  }
  gbSsaoUpload(camX: camX, camY: camY, camZ: camZ)
  let gen: Int = gbTargetsGen()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroup(resources: resources, id: cache.bindGroup)
    cache.bindGroup = noBindGroupId()
    releaseExternalIds(resources: resources, list: cache.adopted)
  }
  if not bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    unsafe {
      entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbLightUbuf()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewA()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewDepth()))
    }
    var made: Bool = false
    if let bind: BindGroupId = createRenderBindGroup(resources: resources, pipeline: cache.pipeline, entries: entries) {
      cache.bindGroup = bind
      made = true
    }
    if not made { releaseExternalIds(resources: resources, list: cache.adopted) }
  }
  unsafe { runFullscreen(resources: resources, pipeline: cache.pipeline, bind: cache.bindGroup, target: gbAoView()) }
}

# Public wrapper: the render graph's SSAO step (was gbuffer.ssaoPass).
func ssaoPass(cache: mod AoPassCache, resources: mod GpuResources, camera: view Camera3d) pub {
  ssao(cache: cache, resources: resources, camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z)
}

# ----- lighting: the deferred shading pass (#504) ----------------------------
# Reads the whole G-buffer + AO + the shadow cascades, writes linear HDR
# radiance into the lit target. The large uniform (inverse viewProj + camera/
# sun/sky params + the Rae-cooked Hosek state) is C frame-math, uploaded by
# gbLightUpload; Rae builds the 9-entry bind and runs the pass. The lighting
# pipeline stays C for now (its creation guards the shared init block).
func nativeGbLightUpload(camX: Float, camY: Float, camZ: Float, exposure: Float, sunX: Float, sunY: Float, sunZ: Float, sunR: Float, sunG: Float, sunB: Float, skyR: Float, skyG: Float, skyB: Float, gndR: Float, gndG: Float, gndB: Float, skyKind: Float, turbidity: Float, skyExposure: Float, sunSizeRad: Float, zenR: Float, zenG: Float, zenB: Float, bands: Float, horR: Float, horG: Float, horB: Float, discI: Float) unsafe extern("rae_gb_light_upload")
func gbLightUpload(camX: copy Float, camY: copy Float, camZ: copy Float, exposure: copy Float, sunX: copy Float, sunY: copy Float, sunZ: copy Float, sunR: copy Float, sunG: copy Float, sunB: copy Float, skyR: copy Float, skyG: copy Float, skyB: copy Float, gndR: copy Float, gndG: copy Float, gndB: copy Float, skyKind: copy Float, turbidity: copy Float, skyExposure: copy Float, sunSizeRad: copy Float, zenR: copy Float, zenG: copy Float, zenB: copy Float, bands: copy Float, horR: copy Float, horG: copy Float, horB: copy Float, discI: copy Float) {
  unsafe { nativeGbLightUpload(camX: camX, camY: camY, camZ: camZ, exposure: exposure, sunX: sunX, sunY: sunY, sunZ: sunZ, sunR: sunR, sunG: sunG, sunB: sunB, skyR: skyR, skyG: skyG, skyB: skyB, gndR: gndR, gndG: gndG, gndB: gndB, skyKind: skyKind, turbidity: turbidity, skyExposure: skyExposure, sunSizeRad: sunSizeRad, zenR: zenR, zenG: zenG, zenB: zenB, bands: bands, horR: horR, horG: horG, horB: horB, discI: discI) }
}
func nativeSkyHosekPush(index: Int, value: Float) unsafe extern("rae_ext_Gbuffer_skyHosekPush")
func skyHosekPush(index: copy Int, value: copy Float) {
  unsafe { nativeSkyHosekPush(index: index, value: value) }
}
func gbLightPipeline() unsafe extern("rae_gb_light_pipeline") ret Ptr
func gbLitView() unsafe extern("rae_gb_lit_view") ret Ptr
func gbShadowFrameUbuf() unsafe extern("rae_gb_shadow_frame_ubuf") ret Ptr
func nativeGbShadowFrameBytes() unsafe extern("rae_gb_shadow_frame_bytes") ret Int
func gbShadowFrameBytes() ret Int {
  unsafe { ret nativeGbShadowFrameBytes() }
}
func gbShadowArrayView() unsafe extern("rae_gb_shadow_array_view") ret Ptr
func gbShadowSampler() unsafe extern("rae_gb_shadow_sampler") ret Ptr


# Cooked Hosek-Wilkie coefficients pushed before lighting; three vec4 per
# channel, matching the WGSL `hosek` layout.
func pushHosekChannel(c: view HosekChannel, base: view Int) {
  unsafe {
    skyHosekPush(index: base + 0, value: c.a)
    skyHosekPush(index: base + 1, value: c.b)
    skyHosekPush(index: base + 2, value: c.c)
    skyHosekPush(index: base + 3, value: c.d)
    skyHosekPush(index: base + 4, value: c.e)
    skyHosekPush(index: base + 5, value: c.f)
    skyHosekPush(index: base + 6, value: c.g)
    skyHosekPush(index: base + 7, value: c.h)
    skyHosekPush(index: base + 8, value: c.i)
    skyHosekPush(index: base + 9, value: c.radiance)
  }
}

# Low-level lighting: upload the uniform (C), build the bind (rebuilt on resize)
# over the adopted C pipeline, run the fullscreen pass into the lit target.
func lighting(cache: mod LightPassCache, resources: mod GpuResources, camX: copy Float, camY: copy Float, camZ: copy Float, exposure: copy Float,
              sunX: copy Float, sunY: copy Float, sunZ: copy Float,
              sunR: copy Float, sunG: copy Float, sunB: copy Float,
              skyR: copy Float, skyG: copy Float, skyB: copy Float,
              gndR: copy Float, gndG: copy Float, gndB: copy Float,
              skyKind: copy Float, turbidity: copy Float, skyExposure: copy Float,
              sunSizeRad: copy Float, zenR: copy Float, zenG: copy Float, zenB: copy Float,
              bands: copy Float, horR: copy Float, horG: copy Float, horB: copy Float,
              discI: copy Float) {
  if gbDeferredPrepare() is 0 { ret }
  gbLightUpload(camX: camX, camY: camY, camZ: camZ, exposure: exposure,
    sunX: sunX, sunY: sunY, sunZ: sunZ, sunR: sunR, sunG: sunG, sunB: sunB,
    skyR: skyR, skyG: skyG, skyB: skyB, gndR: gndR, gndG: gndG, gndB: gndB,
    skyKind: skyKind, turbidity: turbidity, skyExposure: skyExposure, sunSizeRad: sunSizeRad,
    zenR: zenR, zenG: zenG, zenB: zenB, bands: bands, horR: horR, horG: horG, horB: horB, discI: discI)
  let gen: Int = gbTargetsGen()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroup(resources: resources, id: cache.bindGroup)
    cache.bindGroup = noBindGroupId()
    releaseExternalIds(resources: resources, list: cache.adopted)
    cache.pipeline = noExternalId()
  }
  if not bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 9)
    unsafe {
      if let pipeline: ExternalId = adoptExternalRenderPipeline(resources: resources, handle: gbLightPipeline()) {
        cache.adopted.add(value: pipeline)
        cache.pipeline = pipeline
      }
      entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbLightUbuf()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewA()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewB()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewC()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewDepth()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbAoView()))
      entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbShadowFrameUbuf()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbShadowArrayView()))
      entries.add(value: adoptSamplerRef(resources: resources, adopted: cache.adopted, handle: gbShadowSampler()))
    }
    var made: Bool = false
    if let bind: BindGroupId = createRenderBindGroupExternal(resources: resources, pipeline: cache.pipeline, entries: entries) {
      cache.bindGroup = bind
      made = true
    }
    if not made {
      releaseExternalIds(resources: resources, list: cache.adopted)
      cache.pipeline = noExternalId()
    }
  }
  unsafe { runFullscreenExternal(resources: resources, pipeline: cache.pipeline, bind: cache.bindGroup, target: gbLitView()) }
}

# Public: lighting with a bound sky environment (Hosek ambient + background).
func lightingPassSky(cache: mod LightPassCache, resources: mod GpuResources, camera: view Camera3d, light: view Light3d, sky: view Sky) pub {
  let up: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let down: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0 - 1.0)
  # DESATURATED BY THE SKY'S OWN SETTING. The sky's irradiance is THE ambient
  # term here, so a physically blue daylight sky lights every surface blue --
  # measured, a white ground albedo came out (0.59, 0.71, 0.96), which makes warm
  # materials unreachable at any albedo. Default is 1.0, so this is a no-op for
  # every existing caller; the visible sky is untouched either way.
  let skyC: Vec3 = desaturate(c: irradiance(sky: sky, normal: up), sat: sky.ambientSaturation)
  let gndC: Vec3 = desaturate(c: irradiance(sky: sky, normal: down), sat: sky.ambientSaturation)
  pushHosekChannel(c: sky.hosek.r, base: 0)
  pushHosekChannel(c: sky.hosek.g, base: 12)
  pushHosekChannel(c: sky.hosek.b, base: 24)
  lighting(cache: cache, resources: resources,
    camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
    exposure: light.exposure,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    skyR: skyC.x, skyG: skyC.y, skyB: skyC.z,
    gndR: gndC.x, gndG: gndC.y, gndB: gndC.z,
    skyKind: kindCode(sky: sky), turbidity: sky.turbidity,
    skyExposure: sky.exposure, sunSizeRad: sky.sunAngularRadius,
    zenR: sky.zenithColor.x, zenG: sky.zenithColor.y, zenB: sky.zenithColor.z,
    bands: sky.bands,
    horR: sky.horizonColor.x, horG: sky.horizonColor.y, horB: sky.horizonColor.z,
    discI: sky.sunDiscIntensity
  )
}

# Public: lighting with the authored ambient hemisphere, no sky.
func lightingPass(cache: mod LightPassCache, resources: mod GpuResources, camera: view Camera3d, light: view Light3d) pub {
  lighting(cache: cache, resources: resources,
    camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
    exposure: light.exposure,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    skyR: light.ambSky.x, skyG: light.ambSky.y, skyB: light.ambSky.z,
    gndR: light.ambGround.x, gndG: light.ambGround.y, gndB: light.ambGround.z,
    skyKind: 0.0, turbidity: 3.0, skyExposure: 1.0, sunSizeRad: 0.0047,
    zenR: 0.0, zenG: 0.0, zenB: 0.0, bands: 1.0,
    horR: 0.0, horG: 0.0, horB: 0.0, discI: 0.0
  )
}

# ----- TAA: temporal resolve (#504) ------------------------------------------
# Reads this frame's radiance + last frame's history + motion, writes the
# resolved image into the slot the composite then reads. The ping-pong slot and
# history flag are C frame state (taaBegin flips + uploads, taaEnd marks
# history); Rae builds the per-slot bind and runs the pass. Pipeline stays C.
func nativeGbTaaReady() unsafe extern("rae_gb_taa_ready") ret Int
func gbTaaReady() ret Int {
  unsafe { ret nativeGbTaaReady() }
}
func nativeGbTaaBegin() unsafe extern("rae_gb_taa_begin") ret Int
func gbTaaBegin() ret Int {
  unsafe { ret nativeGbTaaBegin() }
}
func nativeGbTaaEnd() unsafe extern("rae_gb_taa_end")
func gbTaaEnd() {
  unsafe { nativeGbTaaEnd() }
}
func gbTaaPipeline() unsafe extern("rae_gb_taa_pipeline") ret Ptr
func gbTaaUbuf() unsafe extern("rae_gb_taa_ubuf") ret Ptr
func gbTaaTargetView() unsafe extern("rae_gb_taa_target_view") ret Ptr
func gbTaaHistoryView() unsafe extern("rae_gb_taa_history_view") ret Ptr

func taa(cache: mod TaaPassCache, resources: mod GpuResources) pub {
  if gbTaaReady() is 0 { ret }
  let cur: Int = gbTaaBegin()
  let gen: Int = gbTargetsGen()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
    releaseExternalIds(resources: resources, list: cache.adopted)
    cache.pipeline = noExternalId()
  }
  if not isExternalRenderPipeline(resources: resources, id: cache.pipeline) {
    unsafe {
      if let pipeline: ExternalId = adoptExternalRenderPipeline(resources: resources, handle: gbTaaPipeline()) {
        cache.adopted.add(value: pipeline)
        cache.pipeline = pipeline
      }
    }
  }
  if not bindSlotUsable(resources: resources, binds: cache.binds, idx: cur) {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
    unsafe {
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbLitView()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbTaaHistoryView()))
      entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewC()))
      entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbTaaUbuf()))
    }
    var made: Bool = false
    if let bind: BindGroupId = createRenderBindGroupExternal(resources: resources, pipeline: cache.pipeline, entries: entries) {
      cache.binds.set(index: cur, value: bind)
      made = true
    }
    if not made {
      failPassGeneration(resources: resources, binds: cache.binds, adopted: cache.adopted)
      cache.pipeline = noExternalId()
    }
  }
  if let bind: BindGroupId = cache.binds.copyAt(index: cur) {
    unsafe { runFullscreenExternal(resources: resources, pipeline: cache.pipeline, bind: bind, target: gbTaaTargetView()) }
  }
  gbTaaEnd()
}

# Public wrapper: the render graph's TAA step (was gbuffer.taaPass).
func taaPass(cache: mod TaaPassCache, resources: mod GpuResources) pub {
  taa(cache: cache, resources: resources)
}

# ----- depth pyramid: a Hi-Z mip chain (#504) --------------------------------
# A loop of single-entry fullscreen passes: mip 0 reduces the G-buffer depth,
# each later mip reduces the one above. C keeps the per-mip targets + the two
# pipelines; Rae drives the loop, building one bind per level (reading the
# previous mip) and running each pass into that mip's target.
func nativeGbPyramidReady() unsafe extern("rae_gb_pyramid_ready") ret Int
func gbPyramidReady() ret Int {
  unsafe { ret nativeGbPyramidReady() }
}
func gbPyrFromDepthPipeline() unsafe extern("rae_gb_pyr_from_depth_pipeline") ret Ptr
func gbPyrReducePipeline() unsafe extern("rae_gb_pyr_reduce_pipeline") ret Ptr
func gbPyrSrcView(i: Int) unsafe extern("rae_gb_pyr_src_view") ret Ptr
func gbPyrRtView(i: Int) unsafe extern("rae_gb_pyr_rt_view") ret Ptr
func nativeGbPyramidMips() unsafe extern("rae_ext_Gbuffer_pyramidMips") ret Int
func gbPyramidMips() ret Int {
  unsafe { ret nativeGbPyramidMips() }
}

func depthPyramid(cache: mod PyrPassCache, resources: mod GpuResources) pub {
  if gbPyramidReady() is 0 { ret }
  let gen: Int = gbTargetsGen()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroupIds(resources: resources, list: cache.binds)
    releaseExternalIds(resources: resources, list: cache.adopted)
    cache.fromDepth = noExternalId()
    cache.reduce = noExternalId()
  }
  if not isExternalRenderPipeline(resources: resources, id: cache.reduce) {
    unsafe {
      if let pipeline: ExternalId = adoptExternalRenderPipeline(resources: resources, handle: gbPyrFromDepthPipeline()) {
        cache.adopted.add(value: pipeline)
        cache.fromDepth = pipeline
      }
      if let pipeline: ExternalId = adoptExternalRenderPipeline(resources: resources, handle: gbPyrReducePipeline()) {
        cache.adopted.add(value: pipeline)
        cache.reduce = pipeline
      }
    }
  }
  let mips: Int = gbPyramidMips()
  loop cache.binds.length < mips { cache.binds.add(value: noBindGroupId()) }
  var i: Int = 0
  loop i < mips {
    # Level 0 reduces the G-buffer depth; every later level reduces the one above.
    var pipeline: ExternalId = cache.reduce
    if i is 0 { pipeline = cache.fromDepth }
    if not bindSlotUsable(resources: resources, binds: cache.binds, idx: i) {
      let entries: List(ResourceRef) = List.create(ResourceRef, cap: 1)
      unsafe { entries.add(value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbPyrSrcView(i: i))) }
      var made: Bool = false
      if let bind: BindGroupId = createRenderBindGroupExternal(resources: resources, pipeline: pipeline, entries: entries) {
        cache.binds.set(index: i, value: bind)
        made = true
      }
      if not made {
        failPassGeneration(resources: resources, binds: cache.binds, adopted: cache.adopted)
        cache.fromDepth = noExternalId()
        cache.reduce = noExternalId()
        ret
      }
    }
    if let bind: BindGroupId = cache.binds.copyAt(index: i) {
      unsafe { runFullscreenExternal(resources: resources, pipeline: pipeline, bind: bind, target: gbPyrRtView(i: i)) }
    }
    i = i + 1
  }
}

# Public wrapper: the render graph's depth-pyramid step (was gbuffer.buildDepthPyramid).
func buildDepthPyramid(cache: mod PyrPassCache, resources: mod GpuResources) pub {
  depthPyramid(cache: cache, resources: resources)
}

# Retire every manager object the post-passes hold (renderer shutdown): the
# bind groups first (dropping their pins), then the adopted inputs, then the
# composite / ssao objects. The C-owned inputs are released by C's shutdown.
func postPassesShutdown(composite: mod CompositePassCache, ao: mod AoPassCache, light: mod LightPassCache, taa: mod TaaPassCache, pyr: mod PyrPassCache, resources: mod GpuResources) {
  retireBindGroupIds(resources: resources, list: composite.binds)
  releaseExternalIds(resources: resources, list: composite.adopted)
  retireRenderPipeline(resources: resources, id: composite.pipeline)
  retireBuffer(resources: resources, id: composite.uniform)
  retireSampler(resources: resources, id: composite.sampler)
  composite = createCompositePassCache()
  retireBindGroup(resources: resources, id: ao.bindGroup)
  releaseExternalIds(resources: resources, list: ao.adopted)
  retireRenderPipeline(resources: resources, id: ao.pipeline)
  ao = createAoPassCache()
  retireBindGroup(resources: resources, id: light.bindGroup)
  releaseExternalIds(resources: resources, list: light.adopted)
  light = createLightPassCache()
  retireBindGroupIds(resources: resources, list: taa.binds)
  releaseExternalIds(resources: resources, list: taa.adopted)
  taa = createTaaPassCache()
  retireBindGroupIds(resources: resources, list: pyr.binds)
  releaseExternalIds(resources: resources, list: pyr.adopted)
  pyr = createPyrPassCache()
}
