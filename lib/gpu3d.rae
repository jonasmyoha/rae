# gpu3d — raster + bounded SDF backend of the unified 3D renderer.
#
# Renders `scene3d` triangle meshes (MeshRenderer components) with PBR
# lighting through wgpu-native into the same SDL3 window/surface gpu2d
# owns. An app opens the window with gpu2d.initWindow(...) then drives
# frames with gpu3d. Single-sampled since #333 (MSAA dropped so depth is
# sampleable; TAA #335 takes over antialiasing): the scene pass writes
# linear HDR (rgba16f) plus depth/normal/velocity prepass targets, and the
# tonemap pass (#334) resolves HDR into gpu2d's persistent LDR offscreen,
# so present + RAE_GPU2D_SCREENSHOT + the 2D UI overlay all keep working
# unchanged.
#
# WORLD CONVENTION: right-handed Z-up (Blender) per
# `docs/coordinate-system.md`. Only mat4Perspective knows about WebGPU
# clip space; world space is Z-up everywhere.
#
# API SHAPE: the C ABI underneath is flat float buffers (packed frame
# block, 9 loose material floats per draw) because that is what crosses
# the extern boundary cheaply. That packing is an IMPLEMENTATION DETAIL —
# app code uses the typed `Camera3d`/`Light3d`/`Transform3d`/`Material3d`
# structs from lib/scene3d.rae and this module encodes them. Nobody
# should be counting magic float offsets in application code.
#
# A mesh is interleaved float data — 8 Floats per vertex: position xyz,
# normal xyz, uv — plus a triangle index list. Generate with
# lib/mesh3d.rae or build your own.
#
# Lighting (single uber-shader): Cook-Torrance GGX specular + Lambert
# diffuse, one directional sun, hemisphere ambient (sky/ground), emissive.
# The shader outputs LINEAR radiance; exposure + ACES + gamma happen once,
# in the tonemap pass — never inside material shaders (#334).
#
# KNOWN LIMITATION (queued): normals are transformed by the model matrix
# directly, so NON-UNIFORM scale skews lighting — use uniform scale per
# draw until the inverse-transpose normal matrix lands.
#
# Sphere SdfPrimitive components are submitted as one smooth-union metaball
# group using the first primitive's material. The fragment raymarch pass writes
# depth into the same attachment as meshes, so both geometry types occlude.
# Other SDF shapes and multiple material groups remain follow-up work.
#
# DRAW CAPACITY: the backend accepts at most 4096 mesh draws per frame.
# Additional draws are safely discarded and emit one renderer-lifetime error
# instead of failing silently. `RAE_GPU3D_DRAW_LIMIT=N` can lower the effective
# limit for diagnostics/tests, but cannot raise the hard capacity.
import core
import shadow3d
open shadow3d
# The sun cascade shadow render moved to Rae (#504); endShadowPass calls it.
import gbuffer_shadow
# The sky the forward background draws (#418). sky.rae does not import this,
# so the dependency runs one way only.
import sky
open sky
import math
open vec3
open scene3d
open math3d
# The forward render pass is built in Rae over the WebGPU bindings (#514),
# the same way gbuffer.rae builds the deferred geometry pass.
open webgpu/webgpu
import webgpu/context

# ----- raw C ABI (implementation detail; prefer the typed API below) ---
func meshCreate(verts: view Buffer(Float), vertCount: Int, indices: view Buffer(Int), indexCount: Int) extern ret Int
func meshUpdate(mesh: Int, verts: view Buffer(Float), vertCount: Int) extern
# Frame prepare (#514): C packs+uploads the per-frame uniform and returns 1 when
# the device/targets are ready; the render pass is then built in Rae below.
func g3dFramePrepare(frame: view Buffer(Float), count: Int) extern("rae_g3d_frame_prepare") ret Int
# Forward target-view + pipeline handle accessors (ungated platform ABI,
# mirroring the deferred rae_gb_* accessors).
func g3dHdrView() extern("rae_g3d_hdr_view") ret Ptr
func g3dNormalView() extern("rae_g3d_normal_view") ret Ptr
func g3dVelocityView() extern("rae_g3d_velocity_view") ret Ptr
func g3dAmbientView() extern("rae_g3d_ambient_view") ret Ptr
func g3dDepthView() extern("rae_g3d_depth_view") ret Ptr
func g3dPipeline() extern("rae_g3d_pipeline") ret Ptr
func g3dBind() extern("rae_g3d_bind") ret Ptr
# Hand the Rae-built encoder + render pass back to C so the still-C end/submit
# path (and metaballs/skinned draws) encode into them.
func g3dSetFrame(enc: Ptr, pass: Ptr) extern("rae_g3d_set_frame")
# Forward mesh draw (#514): C does the shared CPU bookkeeping (validate mesh +
# draw limit, pack the 40-float record, return the firstInstance slot or -1);
# Rae encodes the instanced DrawIndexed below.
func g3dPushDrawRecord(mesh: Int, model: view Mat4, prevModel: view Mat4, r: Float, g: Float, b: Float, metallic: Float, emR: Float, emG: Float, emB: Float, roughness: Float) extern("rae_g3d_push_draw_record") ret Int
func g3dMeshVbuf(mesh: Int) extern("rae_g3d_mesh_vbuf") ret Ptr
func g3dMeshIbuf(mesh: Int) extern("rae_g3d_mesh_ibuf") ret Ptr
func g3dMeshIcount(mesh: Int) extern("rae_g3d_mesh_icount") ret Int
# The current scene pass (set by beginForward via g3dSetFrame). draw() reads it
# to encode; the still-C end/submit/skinned path reads the same global.
func g3dPass() extern("rae_g3d_pass") ret Ptr
# Metaball cluster (#514): C ensures the SDF pipeline, takes a per-frame group
# slot, packs+uploads the balls/colors/params, and returns the slot (or -1);
# Rae encodes the SDF fullscreen draw and restores the geometry pipeline/bind.
func g3dPushMetaballCluster(packedBalls: view Buffer(Float), count: Int, packedColors: view Buffer(Float), smoothing: Float, metallic: Float, roughness: Float, emR: Float, emG: Float, emB: Float) extern("rae_g3d_push_metaball_cluster") ret Int
func g3dSdfPipeline() extern("rae_g3d_sdf_pipeline") ret Ptr
func g3dSdfBind(slot: Int) extern("rae_g3d_sdf_bind") ret Ptr
# Scene-pass finish primitives (#514): Rae ends the pass + finishes the command
# buffer over the bindings; g3dSubmitCmd is the one thin C call (Rae cannot yet
# take the address of a single handle for wgpuQueueSubmit).
func g3dEncoder() extern("rae_g3d_encoder") ret Ptr
func g3dFrameActive() extern("rae_g3d_frame_active") ret Int
func g3dClearFrame() extern("rae_g3d_clear_frame")
func g3dSubmitCmd(cmd: Ptr) extern("rae_g3d_submit_cmd")
# The LDR offscreen the window presents (shared with the deferred/2D path).
func g2dOffView() extern("rae_g2d_off_view") ret Ptr
# Tonemap (#514): C ensures the pipeline/bind and returns the source slot (the
# TAA slot when TAA is on), or -1; Rae encodes the fullscreen resolve into the
# offscreen. present-frame advances the virtual clock + copies to the drawable.
func g3dTonemapPrepare() extern("rae_g3d_tonemap_prepare") ret Int
func g3dTonemapPipeline() extern("rae_g3d_tonemap_pipeline") ret Ptr
func g3dTonemapBind(slot: Int) extern("rae_g3d_tonemap_bind") ret Ptr
func g3dTonemapPending() extern("rae_g3d_tonemap_pending") ret Int
func g3dPresentFrame() extern("rae_g3d_present_frame")
# TAA (#514): C ensures the pipeline/bind, uploads the blend params, flips
# history-valid and returns the current history slot (or -1); Rae encodes the
# fullscreen resolve into taa_view[cur].
func g3dTaaPrepare() extern("rae_g3d_taa_prepare") ret Int
func g3dTaaPipeline() extern("rae_g3d_taa_pipeline") ret Ptr
func g3dTaaBind(slot: Int) extern("rae_g3d_taa_bind") ret Ptr
func g3dTaaView(slot: Int) extern("rae_g3d_taa_view") ret Ptr
func ssao() extern
func shutdown() extern

# ----- frame parameter block (internal encoding) ----------------------
# `begin` takes a packed 36-Float block:
#   [0..15] viewProj (column-major)
#   [16..18] camera position        [19] time (seconds, for shaders)
#   [20..22] sun direction (toward the scene)   [23] exposure
#   [24..26] sun color * intensity
#   [27..29] ambient sky color
#   [30..32] ambient ground color
#   [33..35] clear color
type Frame3d {
  data: List(Float)
}

func createFrame3d() pub ret Frame3d {
  let d: List(Float) = createList(Float, cap: 36)
  var i: Int = 0
  loop i < 36 {
    d.add(value: 0.0)
    i = i + 1
  }
  ret Frame3d { data: own d }
}

func setViewProj(frame: mod Frame3d, m: view Mat4) {
  var i: Int = 0
  loop i < 16 {
    frame.data.set(index: i, value: m.m[i])
    i = i + 1
  }
}



func setVec3At(frame: mod Frame3d, base: view Int, v: view Vec3) {
  frame.data.set(index: base, value: v.x)
  frame.data.set(index: base + 1, value: v.y)
  frame.data.set(index: base + 2, value: v.z)
}

func setTime(frame: mod Frame3d, t: view Float) pub {
  frame.data.set(index: 19, value: t)
}

# ----- typed renderer seam -------------------------------------------
# Encode a typed camera + light into the flat frame block and start the
# 3D pass. `aspect` is width/height of the target.
# Persistent attachment storage for the forward pass (4 colour + 1 depth), so
# the descriptor's .data pointers stay valid for the BeginRenderPass call.
var gFwdColorAtts: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 4)
var gFwdDepthAtt: List(WGPURenderPassDepthStencilAttachment) = createList(WGPURenderPassDepthStencilAttachment, cap: 1)
# One-attachment storage for the fullscreen post-process passes (tonemap, …),
# kept persistent so the descriptor's .data pointer is valid for BeginRenderPass.
var gFwdPostAtt: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 1)
func ensureFwdPostAtt() {
  loop gFwdPostAtt.length < 1 { gFwdPostAtt.add(value: { depthSlice: 0 as UInt32 }) }
}

# Encode a fullscreen post-process pass (#514): its own encoder + one-attachment
# render pass writing `target`, a triangle draw with `pipeline`+`bind`, then
# finish+submit — the shared shape of tonemap/taa/ssao, mirroring the deferred
# fullscreen passes. Clears the target (the triangle overwrites every pixel).
func fullscreenPostPass(target: copy Ptr, pipeline: copy Ptr, bind: copy Ptr) {
  ensureFwdPostAtt()
  let att: WGPURenderPassColorAttachment = {
    view_: target, depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
  }
  gFwdPostAtt.set(index: 0, value: att)
  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 1 as UInt64, colorAttachments: gFwdPostAtt.data
  }
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: pipeline)
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: bind, dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  wgpuRenderPassEncoderDraw(renderPassEncoder: pass, vertexCount: 3 as UInt32,
    instanceCount: 1 as UInt32, firstVertex: 0 as UInt32, firstInstance: 0 as UInt32)
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  g3dSubmitCmd(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
}
func ensureFwdAttachments() {
  loop gFwdColorAtts.length < 4 { gFwdColorAtts.add(value: { depthSlice: 0 as UInt32 }) }
  loop gFwdDepthAtt.length < 1 { gFwdDepthAtt.add(value: { depthReadOnly: 0 as UInt32 }) }
}

# Build the forward scene pass in Rae over the WebGPU bindings (#514). C has
# already packed+uploaded the frame uniform (g3dFramePrepare); here we open the
# 4-target + depth render pass and hand the encoder/pass to the C draw path.
# The four targets mirror the old C encoder exactly: HDR (clear = sky/bg colour),
# world normal, velocity, ambient (all clear to zero), depth (standard Z, far =
# 1.0). clearR/G/B are the frame's clearColor (frame[33..35]).
func beginForward(frame: view Buffer(Float), count: copy Int,
                  clearR: copy Float, clearG: copy Float, clearB: copy Float) {
  if g3dFramePrepare(frame: frame, count: count) is 0 { ret }
  ensureFwdAttachments()

  let undefinedSlice: UInt32 = WGPU_DEPTH_SLICE_UNDEFINED as UInt32

  # 0: linear HDR; tonemap writes the offscreen (#334). Clear to the bg colour.
  let att0: WGPURenderPassColorAttachment = {
    view_: g3dHdrView(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: clearR as Float64, g: clearG as Float64, b: clearB as Float64, a: 1.0 }
  }
  # 1: world normal (sampled by SSAO/GI). Clear to zero.
  let att1: WGPURenderPassColorAttachment = {
    view_: g3dNormalView(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  }
  # 2: velocity (sampled by TAA). Clear to zero motion.
  let att2: WGPURenderPassColorAttachment = {
    view_: g3dVelocityView(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  }
  # 3: ambient (sampled by the SSAO composite). Clear to zero.
  let att3: WGPURenderPassColorAttachment = {
    view_: g3dAmbientView(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
  }
  gFwdColorAtts.set(index: 0, value: att0)
  gFwdColorAtts.set(index: 1, value: att1)
  gFwdColorAtts.set(index: 2, value: att2)
  gFwdColorAtts.set(index: 3, value: att3)

  # Depth: standard Z here (forward), so the far plane clears to 1.0. (#333:
  # stored so it is sampleable by SSAO/TAA.)
  let depthAtt: WGPURenderPassDepthStencilAttachment = {
    view_: g3dDepthView(),
    depthLoadOp: WGPULoadOp_Clear, depthStoreOp: WGPUStoreOp_Store,
    depthClearValue: 1.0
  }
  gFwdDepthAtt.set(index: 0, value: depthAtt)

  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 4 as UInt64,
    colorAttachments: gFwdColorAtts.data,
    depthStencilAttachment: gFwdDepthAtt.data
  }
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: g3dBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  g3dSetFrame(enc: enc, pass: pass)
}

# Forward mesh draw (#514): encode one instanced DrawIndexed into the scene
# pass over the WebGPU bindings. C packs the per-draw record + returns the
# firstInstance slot (shared with metaballs/skinned, flushed by end()); Rae
# binds the mesh buffers and issues the draw. firstInstance = slot lets the
# shader pick its per-draw record, the same trick the deferred path uses.
func draw(mesh: copy Int, model: view Mat4, prevModel: view Mat4,
          r: copy Float, g: copy Float, b: copy Float,
          metallic: copy Float, roughness: copy Float,
          emR: copy Float, emG: copy Float, emB: copy Float) {
  let slot: Int = g3dPushDrawRecord(mesh: mesh, model: model, prevModel: prevModel,
    r: r, g: g, b: b, metallic: metallic, emR: emR, emG: emG, emB: emB, roughness: roughness)
  if slot < 0 { ret }
  let pass: Ptr = g3dPass()
  let vbuf: Ptr = g3dMeshVbuf(mesh: mesh)
  let ibuf: Ptr = g3dMeshIbuf(mesh: mesh)
  let icount: Int = g3dMeshIcount(mesh: mesh)
  wgpuRenderPassEncoderSetVertexBuffer(renderPassEncoder: pass, slot: 0 as UInt32,
    buffer: vbuf, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: vbuf))
  wgpuRenderPassEncoderSetIndexBuffer(renderPassEncoder: pass, buffer: ibuf,
    format: WGPUIndexFormat_Uint32, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: ibuf))
  wgpuRenderPassEncoderDrawIndexed(renderPassEncoder: pass, indexCount: icount as UInt32,
    instanceCount: 1 as UInt32, firstIndex: 0 as UInt32, baseVertex: 0 as Int32,
    firstInstance: slot as UInt32)
}

# Forward metaball cluster draw (#514): encode the SDF raymarch fullscreen draw
# into the scene pass. C packs+uploads the cluster and returns its group slot;
# Rae binds the SDF pipeline + that slot's bind group, draws a fullscreen
# triangle, then restores the geometry pipeline/bind so following mesh draws
# use them.
func drawMetaballs(packedBalls: view Buffer(Float), count: copy Int, packedColors: view Buffer(Float),
                   smoothing: copy Float, metallic: copy Float, roughness: copy Float,
                   emR: copy Float, emG: copy Float, emB: copy Float) {
  let slot: Int = g3dPushMetaballCluster(packedBalls: packedBalls, count: count, packedColors: packedColors,
    smoothing: smoothing, metallic: metallic, roughness: roughness, emR: emR, emG: emG, emB: emB)
  if slot < 0 { ret }
  let pass: Ptr = g3dPass()
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dSdfPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: g3dSdfBind(slot: slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  wgpuRenderPassEncoderDraw(renderPassEncoder: pass, vertexCount: 3 as UInt32,
    instanceCount: 1 as UInt32, firstVertex: 0 as UInt32, firstInstance: 0 as UInt32)
  # Restore the geometry pipeline/bind for subsequent mesh draws.
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: g3dBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
}

func beginScene(camera: view Camera3d, light: view Light3d, aspect: view Float, time: view Float) pub {
  var frame: Frame3d = createFrame3d()
  let worldUp: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let viewM: Mat4 = mat4LookAt(
    eyeX: camera.position.x, eyeY: camera.position.y, eyeZ: camera.position.z,
    atX: camera.target.x, atY: camera.target.y, atZ: camera.target.z,
    upX: worldUp.x, upY: worldUp.y, upZ: worldUp.z
  )
  let proj: Mat4 = mat4Perspective(fovYDeg: camera.fovYDeg, aspect: aspect, near: camera.nearZ, far: camera.farZ)
  let viewProj: Mat4 = mat4Mul(a: proj, b: viewM)
  setViewProj(frame: frame, m: viewProj)
  setVec3At(frame: frame, base: 16, v: camera.position)
  setTime(frame: frame, t: time)
  setVec3At(frame: frame, base: 20, v: light.sunDir)
  frame.data.set(index: 23, value: light.exposure)
  setVec3At(frame: frame, base: 24, v: light.sunColor)
  setVec3At(frame: frame, base: 27, v: light.ambSky)
  setVec3At(frame: frame, base: 30, v: light.ambGround)
  setVec3At(frame: frame, base: 33, v: light.clearColor)
  beginForward(frame: frame.data.data, count: 36,
    clearR: light.clearColor.x, clearG: light.clearColor.y, clearB: light.clearColor.z)
}

# ----- the sky (#418) -------------------------------------------------
#
# The background, for the FORWARD frame. The deferred path gets its sky from
# gbuffer.lightingPassSky, which can compute it for every pixel the G-buffer
# left empty; there is no G-buffer here, so the same shader runs as a
# fullscreen draw at the start of the scene pass instead. One shader, shared in
# runtime_sky_wgsl.h — examples 111 and 112 are the same scene under the two
# renderers, and they must not disagree about what the sky looks like.
#
# OPT IN, one line, between beginScene and the geometry:
#
#     beginScene(camera: camera, light: light, aspect: aspect, time: t)
#     drawSky(sky: sky, light: light)
#     renderScene(scene: scene)
#
# An app that does not write that line keeps the flat clear colour.
func skyHosekPush(index: Int, value: Float) extern
func skyDraw(skyKind: Float, turbidity: Float, skyExposure: Float, sunSizeRad: Float,
             sunX: Float, sunY: Float, sunZ: Float,
             sunR: Float, sunG: Float, sunB: Float,
             zenR: Float, zenG: Float, zenB: Float, bands: Float,
             horR: Float, horG: Float, horB: Float, discI: Float,
             clearR: Float, clearG: Float, clearB: Float) extern

# Three vec4 per channel: [A B C D][E F G H][I radiance _ _], matching `hosek`
# in the WGSL. The deferred path has the same walk in lib/gbuffer.rae, and the
# two stay separate because a Rae extern's C name follows its module — they
# land in the ONE table in runtime_sky_state.h, so the duplication is in how
# the values are handed over, never in the values themselves.
func pushForwardHosekChannel(c: view HosekChannel, base: view Int) {
  skyHosekPush(index: base + 0, value: c.a)
  skyHosekPush(index: base + 1, value: c.b)
  skyHosekPush(index: base + 2, value: c.c)
  skyHosekPush(index: base + 3, value: c.d)
  skyHosekPush(index: base + 4, value: c.e)
  skyHosekPush(index: base + 5, value: c.f)
  skyHosekPush(index: base + 6, value: c.g)
  skyHosekPush(index: base + 7, value: c.h)
  skyHosekPush(index: base + 8, value: c.i)
  skyHosekPush(index: base + 9, value: c.radiance)
}

# The SUN comes from the light, not from the sky, which is the same choice
# lightingPassSky makes: the disc the camera sees and the shadows on the ground
# then come from one direction by construction. A sky whose own sunDir differs
# is telling the renderer where its HDRI's sun is (#403), not where to put the
# shadows.
func drawSky(sky: view Sky, light: view Light3d) pub {
  # Before the draw: the pass copies whatever is in the table, so pushing
  # afterwards would show last frame's sky.
  pushForwardHosekChannel(c: sky.hosek.r, base: 0)
  pushForwardHosekChannel(c: sky.hosek.g, base: 12)
  pushForwardHosekChannel(c: sky.hosek.b, base: 24)
  skyDraw(
    skyKind: skyKindCode(sky: sky), turbidity: sky.turbidity,
    skyExposure: sky.exposure, sunSizeRad: sky.sunAngularRadius,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    zenR: sky.zenithColor.x, zenG: sky.zenithColor.y, zenB: sky.zenithColor.z,
    bands: sky.bands,
    horR: sky.horizonColor.x, horG: sky.horizonColor.y, horB: sky.horizonColor.z,
    discI: sky.sunDiscIntensity,
    # Kind 0 shows this and nothing else, so an app can bind a `none` sky and
    # get exactly the background it had before it called this at all.
    clearR: sky.clearColor.x, clearG: sky.clearColor.y, clearB: sky.clearColor.z
  )
}

# Build a model matrix from a typed transform: M = T * Rz * Ry * Rx * S.
# Rotation is Euler XYZ radians, right-handed (yaw about +Z, pitch about
# +X) per docs/coordinate-system.md.
func modelMatrix(t: view Transform3d) pub ret Mat4 {
  let s: Mat4 = mat4ScaleXYZ(x: t.scale.x, y: t.scale.y, z: t.scale.z)
  let rx: Mat4 = mat4RotateX(angle: t.rotation.x)
  let ry: Mat4 = mat4RotateY(angle: t.rotation.y)
  let rz: Mat4 = mat4RotateZ(angle: t.rotation.z)
  let tr: Mat4 = mat4Translate(x: t.position.x, y: t.position.y, z: t.position.z)
  let rxs: Mat4 = mat4Mul(a: rx, b: s)
  let ryrxs: Mat4 = mat4Mul(a: ry, b: rxs)
  let rot: Mat4 = mat4Mul(a: rz, b: ryrxs)
  ret mat4Mul(a: tr, b: rot)
}

# Draw one mesh with a typed transform + material. `prevTransform` is
# where the instance was LAST frame; it drives per-object motion vectors
# for TAA (#335). Pass the same transform when an object did not move.
func drawInstance(mesh: view MeshHandle, transform: view Transform3d, prevTransform: view Transform3d, material: view Material3d) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  let model: Mat4 = modelMatrix(t: transform)
  let prevModel: Mat4 = modelMatrix(t: prevTransform)
  draw(
    mesh: mesh.id, model: model, prevModel: prevModel,
    r: material.baseColor.x, g: material.baseColor.y, b: material.baseColor.z,
    metallic: material.metallic, roughness: material.roughness,
    emR: material.emission.x, emG: material.emission.y, emB: material.emission.z
  )
}

# Render visible mesh components, then depth-integrated sphere SDF components.
# This is the world-oriented entry point; apps do not submit geometry manually.
# Submit a scene's meshes as shadow CASTERS. Deliberately separate from
# renderScene rather than a flag on it: the shadow pass runs first, needs
# no materials and no previous transforms, and skips the SDF metaball
# clusters entirely — those have no triangles, and shadowing them is
# Layer C's job once the GI representation exists (#386).
# Submit a scene's metaball clusters as shadow CASTERS. They have no
# triangles, so the cascade pass raymarches the field from the light
# instead of rasterising — see the note in runtime_gpu3d_shadow.c. Cluster
# discovery mirrors the render walk exactly, or a blob would cast a shadow
# that does not match its shape.
func renderSceneShadowSdf(scene: view Scene3d) pub {
  if scene.sdfPrimitives.length is 0 {
    ret
  }
  var clusterScan: Int = 0
  loop clusterScan < scene.sdfPrimitives.length {
    let head: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: clusterScan)
    var alreadyDrawn: Bool = false
    var back: Int = 0
    loop back < clusterScan {
      let prior: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: back)
      if prior.shape is 0 {
        if prior.cluster is head.cluster { alreadyDrawn = true }
      }
      back = back + 1
    }
    if head.shape is 0 {
      if alreadyDrawn is false {
        let packed: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
        var ballCount: Int = 0
        var i: Int = 0
        loop i < scene.sdfPrimitives.length {
          let sdf: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: i)
          if sdf.shape is 0 {
            if sdf.cluster is head.cluster {
              let t: Transform3d = sceneTransformAt(values: scene.transforms, index: sdf.entity)
              packed.add(value: t.position.x)
              packed.add(value: t.position.y)
              packed.add(value: t.position.z)
              packed.add(value: t.scale.x)
              ballCount = ballCount + 1
            }
          }
          i = i + 1
        }
        if ballCount > 0 {
          shadowMetaballs(packedBalls: packed.data, count: ballCount, smoothing: head.smoothing)
        }
      }
    }
    clusterScan = clusterScan + 1
  }
}

func renderSceneShadow(scene: view Scene3d) pub {
  var i: Int = 0
  loop i < scene.meshRenderers.length {
    let r: MeshRenderer = sceneMeshRendererAt(values: scene.meshRenderers, index: i)
    if r.visible {
      let t: Transform3d = sceneTransformAt(values: scene.transforms, index: r.entity)
      drawShadowCaster(mesh: r.mesh, model: modelMatrix(t: t))
    }
    i = i + 1
  }
}

func renderScene(scene: view Scene3d) pub {
  var i: Int = 0
  loop i < scene.meshRenderers.length {
    let r: MeshRenderer = sceneMeshRendererAt(values: scene.meshRenderers, index: i)
    if r.visible {
      let t: Transform3d = sceneTransformAt(values: scene.transforms, index: r.entity)
      # prevTransforms is kept in lockstep with transforms by addTransform,
      # so this index is always valid (#336).
      let pt: Transform3d = sceneTransformAt(values: scene.prevTransforms, index: r.entity)
      let m: Material3d = sceneMaterialAt(values: scene.materials, index: r.material)
      drawInstance(mesh: r.mesh, transform: t, prevTransform: pt, material: m)
    }
    i = i + 1
  }
  # Sphere SDF primitives render as smooth-union metaball clusters: one
  # raymarch pass per cluster, so separate blobs occlude each other via
  # depth but never fuse into one another. Within a cluster every ball
  # contributes its OWN material colour, blended by the same weight that
  # fuses the distances; the surface's metallic/roughness/emission and the
  # cluster's stickiness come from its first primitive, since those
  # describe the fused surface rather than any one ball.
  #
  # Clusters are found by scanning for unseen ids rather than sorting,
  # because a scene has a handful of clusters and this keeps the pass
  # allocation-free beyond the two packed buffers.
  if scene.sdfPrimitives.length > 0 {
    var clusterScan: Int = 0
    loop clusterScan < scene.sdfPrimitives.length {
      let head: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: clusterScan)
      # Only the first primitive of a cluster emits a draw; later members
      # of an already-drawn cluster are skipped.
      var alreadyDrawn: Bool = false
      var back: Int = 0
      loop back < clusterScan {
        let prior: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: back)
        if prior.shape is 0 {
          if prior.cluster is head.cluster { alreadyDrawn = true }
        }
        back = back + 1
      }
      if head.shape is 0 {
        if alreadyDrawn is false {
          let packed: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
          let colors: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
          var ballCount: Int = 0
          i = 0
          loop i < scene.sdfPrimitives.length {
            let sdf: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: i)
            if sdf.shape is 0 {
              if sdf.cluster is head.cluster {
                let transform: Transform3d = sceneTransformAt(values: scene.transforms, index: sdf.entity)
                packed.add(value: transform.position.x)
                packed.add(value: transform.position.y)
                packed.add(value: transform.position.z)
                packed.add(value: transform.scale.x)
                let ballMaterial: Material3d = sceneMaterialAt(values: scene.materials, index: sdf.material)
                colors.add(value: ballMaterial.baseColor.x)
                colors.add(value: ballMaterial.baseColor.y)
                colors.add(value: ballMaterial.baseColor.z)
                colors.add(value: 0.0)
                ballCount = ballCount + 1
              }
            }
            i = i + 1
          }
          if ballCount > 0 {
            let material: Material3d = sceneMaterialAt(values: scene.materials, index: head.material)
            drawMetaballs(
              packedBalls: packed.data, count: ballCount,
              packedColors: colors.data, smoothing: head.smoothing,
              metallic: material.metallic, roughness: material.roughness,
              emR: material.emission.x, emG: material.emission.y, emB: material.emission.z
            )
          }
        }
      }
      clusterScan = clusterScan + 1
    }
  }
}

# Finish the frame (#514, was the C end): close the scene pass, run tonemap if
# the graph did not, then present. Records upload per-draw and passes dispatch
# in graph order, so this is the last thing a forward frame does.
func end() pub {
  finishForward()
  if g3dTonemapPending() is not 0 {
    tonemapPass()
  }
  g3dPresentFrame()
}

func endFrame() pub {
  end()
}

# Finish and submit the open scene pass over the WebGPU bindings (#514),
# mirroring the deferred renderer's end(): end the render pass, finish the
# command buffer, submit it, release, and clear the C-side frame handles.
# Idempotent — a no-op (returns 0) if the scene pass is already closed, so it is
# safe to call from more than one place (submit, and later the post-process
# wrappers). Records already uploaded per-draw, so nothing bulk-uploads here.
func finishForward() ret Int {
  if g3dFrameActive() is 0 { ret 0 }
  let pass: Ptr = g3dPass()
  let enc: Ptr = g3dEncoder()
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  g3dSubmitCmd(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
  g3dClearFrame()
  ret 1
}

# Submit the 3D pass without screenshot or present (#514, was the C submit).
# Follow with gpu2d.beginFrameLoad(), the ECS UI render pass, and
# gpu2d.endFrame() so the composed frame is presented exactly once. Poll only
# when something was actually submitted.
func submit() pub {
  if finishForward() is not 0 {
    webgpuPoll(wait: 0)
  }
}

func endPass() pub {
  submit()
}

# Resolve the linear HDR scene target into the LDR offscreen (#334):
# exposure + ACES + gamma, the frame's LAST radiometric operation. The
# render graph dispatches this between the scene pass and any LDR
# composition (UI overlay, present). Ends the scene pass if still open.
func tonemapPass() pub {
  finishForward()
  let slot: Int = g3dTonemapPrepare()
  if slot < 0 { ret }
  fullscreenPostPass(target: g2dOffView(), pipeline: g3dTonemapPipeline(), bind: g3dTonemapBind(slot: slot))
}

# Ambient occlusion (#337): horizon-search AO with a visibility bitmask,
# generated at half resolution and composited onto the INDIRECT term only.
# Runs before TAA so the half-res noise resolves temporally, and before
# tonemap so it modulates linear radiance.
func ssaoPass() pub {
  ssao()
}

# Temporal antialiasing resolve (#335): reproject the previous frame
# through the velocity buffer, clamp it to the current neighbourhood and
# blend. Runs on HDR, BEFORE tonemap, so accumulation stays linear.
func taaPass() pub {
  finishForward()
  let slot: Int = g3dTaaPrepare()
  if slot < 0 { ret }
  fullscreenPostPass(target: g3dTaaView(slot: slot), pipeline: g3dTaaPipeline(), bind: g3dTaaBind(slot: slot))
}

# Upload interleaved mesh data and get a typed handle back.
func uploadMesh(verts: view List(Float), vertCount: view Int, indices: view List(Int)) pub ret MeshHandle {
  let raw: Int = meshCreate(verts: verts.data, vertCount: vertCount, indices: indices.data, indexCount: indices.length)
  ret meshHandle(id: raw, generation: 0)
}

# Rewrite an existing mesh's vertex data in place; the index buffer and vertex
# count stay as created. For pooled geometry whose shape depends on where in
# the world it currently sits (recycled terrain tiles).
func updateMeshVerts(mesh: view MeshHandle, verts: view List(Float), vertCount: view Int) pub {
  if not meshHandleIsValid(h: mesh) { ret }
  meshUpdate(mesh: mesh.id, verts: verts.data, vertCount: vertCount)
}

# ----- shadows (#382) -------------------------------------------------
# Cascaded shadow maps for the sun. The cascade FIT is in lib/shadow3d.rae
# (pure arithmetic, unit-tested); these only move it to the GPU and
# rasterise the casters.
func shadowBegin(cascades: view Buffer(Float), count: Int, resolution: Int,
                 splits: view Buffer(Float), texelWorld: view Buffer(Float),
                 depthRange: view Buffer(Float)) extern
func shadowDraw(mesh: Int, model: view Mat4) extern
func shadowDrawSkinned(mesh: Int, model: view Mat4) extern
func shadowMetaballs(packedBalls: view Buffer(Float), count: Int, smoothing: Float) extern
func shadowDrawCount() extern ret Int
func shadowShutdown() extern

# Open the shadow pass for a fitted cascade set. Everything drawn between
# this and `endShadowPass` casts.
func beginShadowPass(c: view ShadowCascades) pub {
  shadowBegin(cascades: c.viewProj.data, count: c.count, resolution: c.resolution,
              splits: c.splitFar.data, texelWorld: c.texelWorld.data,
              depthRange: c.depthRange.data)
}

func drawShadowCaster(mesh: view MeshHandle, model: view Mat4) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  shadowDraw(mesh: mesh.id, model: model)
}

func drawShadowCasterSkinned(mesh: view MeshHandle, model: view Mat4) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  shadowDrawSkinned(mesh: mesh.id, model: model)
}

func endShadowPass() pub {
  gbuffer_shadow.shadowEnd()
}

# How many casters the shadow pass rasterised. Exposed because a shadow
# pass that draws NOTHING still produces a lit, non-blank frame — so a
# screenshot check cannot tell a working pass from a dead one, and only a
# count can (#388).
func shadowCasterCount() pub ret Int {
  ret shadowDrawCount()
}

# ----- skinned meshes (#374) ------------------------------------------
# A second vertex format and pipeline for skeletally animated geometry.
# Separate from the static path because a ground plane should not carry
# joint indices it can never read — see runtime_gpu3d_skin.c.
func skinnedMeshCreate(verts: view Buffer(Float), vertCount: Int, indices: view Buffer(Int), indexCount: Int) extern ret Int
func setPalette(rows: view Buffer(Float), jointCount: Int) extern
# Skinned draw (#514): C validates the mesh + draw limit, uploads the per-frame
# palette (if dirty) and the per-draw record, and returns the firstInstance slot
# (or -1); Rae encodes the instanced DrawIndexed below.
func g3dPushSkinnedDraw(mesh: Int, model: view Mat4, r: Float, g: Float, b: Float, metallic: Float, roughness: Float) extern("rae_g3d_push_skinned_draw") ret Int
func g3dSkinPipeline() extern("rae_g3d_skin_pipeline") ret Ptr
func g3dSkinBind() extern("rae_g3d_skin_bind") ret Ptr
func g3dSkinVbuf(mesh: Int) extern("rae_g3d_skin_vbuf") ret Ptr
func g3dSkinIbuf(mesh: Int) extern("rae_g3d_skin_ibuf") ret Ptr
func g3dSkinIcount(mesh: Int) extern("rae_g3d_skin_icount") ret Int
func skinFrameBegin() extern
func skinDrawCount() extern ret Int
func skinShutdown() extern

# Upload a skinned mesh. `verts` is 20 Floats per vertex: pos3, nrm3, uv2,
# four joint indices (as Floats), four weights and an RGBA vertex colour
# that MULTIPLIES the material's base colour — white is a no-op (#378).
func uploadSkinnedMesh(verts: view List(Float), vertCount: view Int, indices: view List(Int)) pub ret MeshHandle {
  let id: Int = skinnedMeshCreate(verts: verts.data, vertCount: vertCount, indices: indices.data, indexCount: indices.length)
  if id is 0 {
    ret meshHandleNone()
  }
  ret meshHandle(id: id, generation: 1)
}

# Upload the joint palette for this frame: 12 Floats per joint, three vec4
# rows of an affine transform. Per FRAME, not per draw — every part of a
# character shares one skeleton.
func uploadPalette(rows: view List(Float), jointCount: view Int) pub {
  setPalette(rows: rows.data, jointCount: jointCount)
}

# Per-character palette uploads (#547) live in gbuffer.rae, done directly over
# the WebGPU bindings (wgpuQueueWriteBuffer into gbSkinPalette at a per-slot
# offset) — the same pattern the draws buffer uses (#502/#503), so no C entry
# point is needed. See uploadPaletteSlot there.

# Forward skinned mesh draw (#514): encode one instanced DrawIndexed into the
# scene pass. C uploads the palette + per-draw record and returns the slot; Rae
# binds the skinned pipeline/bind + mesh buffers, draws, then restores the
# geometry pipeline/bind (leaving the skinned pipeline bound would feed plain
# vertices to a shader expecting joint attributes).
func drawSkinned(mesh: copy Int, model: view Mat4,
                 r: copy Float, g: copy Float, b: copy Float,
                 metallic: copy Float, roughness: copy Float) {
  let slot: Int = g3dPushSkinnedDraw(mesh: mesh, model: model, r: r, g: g, b: b,
    metallic: metallic, roughness: roughness)
  if slot < 0 { ret }
  let pass: Ptr = g3dPass()
  let vbuf: Ptr = g3dSkinVbuf(mesh: mesh)
  let ibuf: Ptr = g3dSkinIbuf(mesh: mesh)
  let icount: Int = g3dSkinIcount(mesh: mesh)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dSkinPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: g3dSkinBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  wgpuRenderPassEncoderSetVertexBuffer(renderPassEncoder: pass, slot: 0 as UInt32,
    buffer: vbuf, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: vbuf))
  wgpuRenderPassEncoderSetIndexBuffer(renderPassEncoder: pass, buffer: ibuf,
    format: WGPUIndexFormat_Uint32, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: ibuf))
  wgpuRenderPassEncoderDrawIndexed(renderPassEncoder: pass, indexCount: icount as UInt32,
    instanceCount: 1 as UInt32, firstIndex: 0 as UInt32, baseVertex: 0 as Int32,
    firstInstance: slot as UInt32)
  # Restore the geometry pipeline/bind for subsequent static draws.
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: g3dBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
}

func drawSkinnedInstance(mesh: view MeshHandle, model: view Mat4, material: view Material3d) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  drawSkinned(
    mesh: mesh.id, model: model,
    r: material.baseColor.x, g: material.baseColor.y, b: material.baseColor.z,
    metallic: material.metallic, roughness: material.roughness
  )
}
