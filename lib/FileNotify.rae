# OS file-change notifications: the OS tells the app that a file changed,
# instead of the app stat-ing it on a timer.
#
# A file watcher that polls makes an idle app wake 4-20 times a second only to
# find nothing changed. With a FileNotify, the kernel queue it owns collects
# the changes, and the runtime's waker wakes the event loop — the same
# `EventLoop.wake` a spawn'd worker uses — the moment one arrives, so the loop
# can block until then.
#
# A notification is a HINT, not a diff: `fileNotifyTakeChanged` says "look
# now", and the caller still compares mtimes to decide whether anything
# changed. Each path is watched together with its directory (an editor saves
# by renaming a temp file over the original, which only the directory sees),
# so an unrelated file beside a watched one also says "look now". After a
# real change, re-arm with `fileNotifyClear` + `fileNotifyWatch`: the file
# that is there now may be a new inode.
#
# This module is the policy, in Rae (docs/runtime-c-audit.md row 10): the
# table of watched paths and their handles, the parent-directory rule and what
# a change means. The runtime makes one call per function
# (compiler/runtime/runtime_file_notify.c): kqueue, wherever lib/net's
# `hasKqueue` capability holds (Apple, the BSDs). Elsewhere (Linux until its
# inotify shim lands with epoll, Windows, WASM) the shims do not exist at
# all, `fileNotifyActive` is false and the caller keeps polling, slowly. `RAE_FILE_NOTIFY=off`
# forces that path. lib/FileWatch.rae and
# lib/HotReload.rae are the users in the stdlib.
open net/NetSystem

when hasKqueue {
  func nativeOpenForEvents(path: String) unsafe extern("rae_ext_FileNotify_openForEvents") ret Int

  func nativeWatchHandle(
    queue: Int
    handle: Int
  ) unsafe extern("rae_ext_FileNotify_watchHandle") ret Int

  func nativeDrain(queue: Int) unsafe extern("rae_ext_FileNotify_drain") ret Int

  func nativeWakeOnChange(queue: Int) unsafe extern("rae_ext_FileNotify_wakeOnChange") ret Int

  func nativeTakePending(queue: Int) unsafe extern("rae_ext_FileNotify_takePending") ret Int
}

type FileNotify {
  # The kernel queue's handle; < 0 when notifications are unavailable.
  id: Int
  # What is watched now: each path and the open handle its watch is on
  paths: List(String)
  handles: List(Int)
}

func noFileNotify() ret FileNotify {
  ret FileNotify { id: -1, paths: {}, handles: {} }
}

func createFileNotify() ret FileNotify {
  if getEnv(name: "RAE_FILE_NOTIFY") is "off" {
    ret noFileNotify()
  }
  when hasKqueue {
    unsafe {
      let queue: Int = systemPollerCreate()
      if queue < 0 {
        ret noFileNotify()
      }
      let closeOnExec: Int = systemSetCloseOnExec(handle: queue)
      # Without the waker the queue still collects changes, but a loop
      # blocked in its event wait would not hear of them: then poll instead.
      if nativeWakeOnChange(queue: queue) < 0 {
        let closed: Int = systemClose(handle: queue)
        ret noFileNotify()
      }
      ret FileNotify { id: queue, paths: {}, handles: {} }
    }
  }
  ret noFileNotify()
}

# Whether the OS delivers notifications for this watcher. False means the
# caller must poll (and its event loop must wake to do so).
func fileNotifyActive(fileNotify: view FileNotify) ret Bool {
  ret fileNotify.id >= 0
}

# The directory of `path`: "." when it names none, "/" for a file at the root
func parentDirectory(path: view String) ret String {
  let slash: Int = path.lastIndexOf(sub: "/")
  if slash < 0 {
    ret "."
  }
  if slash is 0 {
    ret "/"
  }
  ret path.sub(start: 0, len: slash)
}

# Watch one path unless this watcher already does. Whether it is watched.
func watchOnePath(fileNotify: mod FileNotify, path: view String) ret Bool {
  loop let watched: String in fileNotify.paths {
    if watched is path {
      ret true
    }
  }
  when hasKqueue {
    unsafe {
      let handle: Int = nativeOpenForEvents(path: path)
      if handle < 0 {
        ret false
      }
      if nativeWatchHandle(queue: fileNotify.id, handle: handle) < 0 {
        let closed: Int = systemClose(handle: handle)
        ret false
      }
      fileNotify.paths.add(value: "{path}")
      fileNotify.handles.add(value: handle)
    }
    ret true
  }
  ret false
}

# Watch `path` (and its directory). A missing file is fine: its directory sees
# it appear. Returns whether anything could be watched.
func fileNotifyWatch(fileNotify: mod FileNotify, path: view String) ret Bool {
  if fileNotify.id < 0 or path.length() is 0 {
    ret false
  }
  # The directory first: it is what still sees the file after a rename over
  # it, or its creation when it does not exist yet.
  let directoryWatched: Bool = watchOnePath(
    fileNotify: fileNotify
    path: parentDirectory(path: path)
  )
  let fileWatched: Bool = watchOnePath(fileNotify: fileNotify, path: path)
  ret directoryWatched or fileWatched
}

# Stop watching every path, keeping the watcher (re-arm by watching again).
# Closing a handle removes its watch from the queue.
func fileNotifyClear(fileNotify: mod FileNotify) {
  unsafe {
    loop let handle: Int in fileNotify.handles {
      let closed: Int = systemClose(handle: handle)
    }
  }
  fileNotify.handles.clear()
  fileNotify.paths.clear()
  when hasKqueue {
    if fileNotify.id >= 0 {
      unsafe {
        let dropped: Int = nativeDrain(queue: fileNotify.id)
      }
    }
  }
}

# Whether a watched file (or its directory) changed since the last call;
# takes the pending notifications.
func fileNotifyTakeChanged(fileNotify: view FileNotify) ret Bool {
  if fileNotify.id < 0 {
    ret false
  }
  when hasKqueue {
    unsafe {
      # The waker marks a queue that got an event (one atomic swap here);
      # only then is the queue drained, which is a system call of ~10 us.
      let pending: Int = nativeTakePending(queue: fileNotify.id)
      if pending is 0 {
        ret false
      }
      var changed: Bool = pending is 1
      loop {
        let count: Int = nativeDrain(queue: fileNotify.id)
        if count <= 0 {
          break
        }
        changed = true
      }
      ret changed
    }
  }
  ret false
}

# Release the watcher's queue and every watched handle.
func closeFileNotify(fileNotify: mod FileNotify) {
  fileNotifyClear(fileNotify: fileNotify)
  if fileNotify.id >= 0 {
    unsafe {
      let closed: Int = systemClose(handle: fileNotify.id)
    }
  }
  fileNotify.id = -1
}
