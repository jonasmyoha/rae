# Gpu2dTextInput — OS text input for the Gpu2d window: the characters the
# user typed (#976) and the switch that turns text input on while a text
# field is on screen. Split from Gpu2d.rae, which is at the 1,000-line cap.
# The extern surface is the same runtime_gpu2d_platform.c the rest of Gpu2d
# uses.

# The characters the user typed since the last event poll, as UTF-8 (#976).
# Empty on frames with no typing. Backspace / Enter are key edges, not text
# — read them with Sdl3.isKeyPressed(keyBackspace / keyEnter).
func nativeTextInput() unsafe extern("rae_ext_Gpu2d_textInput") ret String

func textInput() ret String {
  unsafe {
    ret nativeTextInput()
  }
}

# Turn OS text input on while a text field is on screen, off otherwise — call
# it every frame with the current state (idempotent). Off, the window gets raw
# key events only, which is what a game wants: with it on, the OS treats the
# window as a text field, and on macOS holding a key opens the press-and-hold
# accent popover. `textInput()` only delivers text while it is on. Never on
# under a headless run.
func nativeSetTextInput(active: Bool) unsafe extern("rae_ext_Gpu2d_setTextInput")

func setTextInput(active: view Bool) {
  unsafe {
    nativeSetTextInput(active: active)
  }
}

# The on-screen keyboard's height in points while it is shown, 0 when it is
# not and on a desktop (iOS: UIKit's keyboard frame; SDL reports only that it
# was shown). A layout reads it to keep a text field above the keyboard.
func nativeKeyboardHeight() unsafe extern("rae_ext_Gpu2d_keyboardHeight") ret Float

func keyboardHeight() ret Float {
  unsafe {
    ret nativeKeyboardHeight()
  }
}

# The system clipboard's text (macOS NSPasteboard, iOS UIPasteboard, through
# SDL3), "" when it holds none. Under a headless run it is never read, and
# setClipboardText answers false: an automated run must not touch the
# person's clipboard (a test pastes through ui/textFieldSystem's scripted
# clipboard instead).
func nativeClipboardText() unsafe extern("rae_ext_Gpu2d_clipboardText") ret String

func clipboardText() ret String {
  unsafe {
    ret nativeClipboardText()
  }
}

func nativeSetClipboardText(text: String) unsafe extern("rae_ext_Gpu2d_setClipboardText") ret Bool

func setClipboardText(text: view String) ret Bool {
  unsafe {
    ret nativeSetClipboardText(text: text)
  }
}

# The system edit menu at (x, y) in design units, with Paste and/or Copy and
# Cut (iOS: UIEditMenuInteraction, as a UITextField's long press shows; a
# no-op elsewhere, where the keys copy and paste). What the person picks is
# read once with editMenuChoice: 1 paste, 2 copy, 3 cut, 0 nothing.
func nativeShowEditMenu(
  x: Float
  y: Float
  canPaste: Bool
  canCopy: Bool
) unsafe extern("rae_ext_Gpu2d_showEditMenu")

func showEditMenu(
  x: view Float
  y: view Float
  canPaste: view Bool
  canCopy: view Bool
) {
  unsafe {
    nativeShowEditMenu(
      x: x
      y: y
      canPaste: canPaste
      canCopy: canCopy
    )
  }
}

func nativeEditMenuChoice() unsafe extern("rae_ext_Gpu2d_editMenuChoice") ret Int

func editMenuChoice() ret Int {
  unsafe {
    ret nativeEditMenuChoice()
  }
}
