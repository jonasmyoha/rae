# RegistryGeneric — the generic authored-component decoder (#960/#961, from
# the #942 (C) decision). ONE function decodes a field of any scalar / enum /
# value-struct type from a `.raescene` component object, and ONE function
# decodes a whole component into its table by looping that over the
# component's fields — so the registry has no hand-written arm per component:
#
#     var comp: T = T.default()                 # declared field defaults
#     loop let f: mod any in fields(comp) {
#       f.set(value: decodeField(fallback: f, doc: doc, val: val, key: fieldName(f), theme: theme))
#     }
#     componentSet(this: table, entity: entity, data: comp)
#
# How one body serves every type: `typeName(fallback)` is a compile-time query
# on the generic parameter, and an `if typeName(fallback) is "Int" { ... }` arm
# is DECIDED per instantiation — only the matching arm exists in the Int
# instantiation, so the String arm never has to type-check against Int
# (docs/compile-time-reflection.md, "Generic bodies that branch on the type").
# The enum arm comes last: `enumFromName(T, name:)` is the constant none for a
# non-enum T, so it costs nothing to try. Anything else (a List field, an
# EntityId) keeps `fallback`; the explicit fixups in ui/Registry handle the
# few authored shapes that are not field-structural.
#
# Missing key: the field keeps `fallback` — the caller passes the current
# value, which is `T.default()` for a freshly created component.
# Theme tokens: a Float field accepts a token name where the authored grammar
# allows one — space tokens ("gap": "spaceM") through optFloatOrToken, and the
# `radius` key through the radius-category tokens ("radius": "radiusCard").
# Value structs: an `RgbaColor` accepts a palette slot name or an {r,g,b,a}
# literal, `Insets` / `Vec2` / `SizeAxis` a sub-object — the same grammar the
# hand-written arms used (ui/RegistryValues).
open ui/RegistryOpt
open ui/ScenePolicy
open ui/RegistryValues
open ui/Components
import Json
import ui/Theme
open ecs/ComponentTable
open ecs/Entity

# Authored enum vocabulary is PascalCase ("Horizontal", "SpaceBetween"); Rae
# enum cases are camelCase (`horizontal`, `spaceBetween`). The first letter is
# the only difference, so lower it before the compile-time member lookup.
func authoredEnumName(text: view String) ret String {
  if text.length() is 0 {
    ret ""
  }
  let head: String = text.sub(start: 0, len: 1)
  let tail: String = text.sub(start: 1, len: text.length() - 1)
  ret "{head.toLower()}{tail}"
}

func decodeField(
  T: type
  fallback: copy T
  doc: view JsonDoc
  val: view JsonValue
  key: view String
  theme: view UiTheme
  diagnostics: mod List(SceneDiagnostic)
  sceneId: view String
  nodeId: view String
) ret T {
  if typeName(fallback) is "Int" {
    ret optInt(
      doc: doc
      container: val
      key: key
      fallback: fallback
    )
  }
  if typeName(fallback) is "Float" {
    let radiusKey: String = "radius"
    if key is radiusKey {
      ret optRadiusOrToken(
        doc: doc
        theme: theme
        container: val
        key: key
        fallback: fallback
        diagnostics: diagnostics
        sceneId: sceneId
        nodeId: nodeId
      )
    }
    ret optFloatOrToken(
      doc: doc
      theme: theme
      container: val
      key: key
      fallback: fallback
      diagnostics: diagnostics
      sceneId: sceneId
      nodeId: nodeId
    )
  }
  if typeName(fallback) is "Bool" {
    ret optBool(
      doc: doc
      container: val
      key: key
      fallback: fallback
    )
  }
  if typeName(fallback) is "String" {
    ret optString(
      doc: doc
      container: val
      key: key
      fallback: fallback
    )
  }
  # Value structs: present sub-value or keep the fallback.
  if typeName(fallback) is "RgbaColor" {
    let idx: Int = Json.field(doc: doc, this: val, key: key)
    if idx < 0 {
      ret fallback
    }
    ret deserRgba(
      doc: doc
      theme: theme
      val: Json.jsonValueAt(doc: doc, idx: idx)
      diagnostics: diagnostics
      sceneId: sceneId
      nodeId: nodeId
    )
  }
  if typeName(fallback) is "Insets" {
    let idx: Int = Json.field(doc: doc, this: val, key: key)
    if idx < 0 {
      ret fallback
    }
    ret deserInsets(
      doc: doc
      theme: theme
      val: Json.jsonValueAt(doc: doc, idx: idx)
      diagnostics: diagnostics
      sceneId: sceneId
      nodeId: nodeId
    )
  }
  if typeName(fallback) is "Vec2" {
    let idx: Int = Json.field(doc: doc, this: val, key: key)
    if idx < 0 {
      ret fallback
    }
    ret deserVec2(doc: doc, val: Json.jsonValueAt(doc: doc, idx: idx))
  }
  if typeName(fallback) is "SizeAxis" {
    let idx: Int = Json.field(doc: doc, this: val, key: key)
    if idx < 0 {
      ret fallback
    }
    ret deserSizeAxis(doc: doc, val: Json.jsonValueAt(doc: doc, idx: idx))
  }
  # List fields (#1006/#1007): `typeName` spells the full generic type, so a
  # `List(Int)` / `List(String)` field reaches its OWN arm and decodes from its
  # JSON array element by element; an absent key keeps the authored default.
  # The decode is inlined into the arm rather than a helper: a plain helper
  # called from a generic specialization is not instantiated by the backend.
  if typeName(fallback) is "List(Int)" {
    let arr: Int = Json.field(doc: doc, this: val, key: key)
    if arr < 0 {
      ret fallback
    }
    var ints: List(Int) = List.create(Int, cap: 4)
    let array: JsonValue = Json.jsonValueAt(doc: doc, idx: arr)
    loop var i: Int = 0, i < Json.arrayLen(this: array), ++i {
      ints.add(value: Json.jsonInt(this: Json.arrayAt(doc: doc, this: array, idx: i), fallback: 0))
    }
    ret ints
  }
  if typeName(fallback) is "List(String)" {
    let arr: Int = Json.field(doc: doc, this: val, key: key)
    if arr < 0 {
      ret fallback
    }
    var strings: List(String) = List.create(String, cap: 4)
    let array: JsonValue = Json.jsonValueAt(doc: doc, idx: arr)
    loop var i: Int = 0, i < Json.arrayLen(this: array), ++i {
      strings.add(
        value: Json.jsonString(this: Json.arrayAt(doc: doc, this: array, idx: i), fallback: "")
      )
    }
    ret strings
  }
  # Enum (or nothing): the authored member name, if the key is present.
  let empty: String = ""
  let text: String = optString(
    doc: doc
    container: val
    key: key
    fallback: empty
  )
  if text.length() > 0 {
    if let member: T = enumFromName(T, name: authoredEnumName(text: text)) {
      ret member
    }
  }
  ret fallback
}

# Decode one authored component object into `table` for `entity`: start from
# the type's declared defaults, fill every field the object names, store.
func decodeComponent(
  T: type
  table: mod ComponentTable(T)
  entity: view EntityId
  doc: view JsonDoc
  val: view JsonValue
  theme: view UiTheme
  diagnostics: mod List(SceneDiagnostic)
  sceneId: view String
  nodeId: view String
) {
  var comp: T = T.default()
  loop let f: mod any in fields(comp) {
    f.set(value: decodeField(
      fallback: f
      doc: doc
      val: val
      key: fieldName(f)
      theme: theme
      diagnostics: diagnostics
      sceneId: sceneId
      nodeId: nodeId
    ))
  }
  componentSet(this: table, entity: entity, data: comp)
}
