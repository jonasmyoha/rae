# UI transform driver — RUICS § 8 in Rae form.
#
# #727: the UI no longer recurses the tree itself. Each entity's parent-local
# `ComputedRect` (+ scroll offset + TransformFx) becomes a local `Transform2D`,
# and the GENERAL lib/ecs `transformSystem2D` folds those into `WorldTransform2D`
# by walking the cached parent-before-child DEPTH ORDER (#713/#716) — the same
# system a GameWorld uses. This file now only: builds the local transforms,
# invokes that system, and accumulates the UI-specific `WorldVisual`
# (alpha/visible), which the general geometry system does not carry.
#
# Inputs (all populated by layoutSystem):
#   ComputedRect  — local position+size in parent content space
# Optional inputs:
#   Opacity       — multiplied with parent's alpha
#   Active        — false hides this entity AND its subtree
#   TransformFx   — scale/rotation/extra alpha (multiplicative)
#   AnimationPose — animationSystem's result, folded in after all of these
#
# Output per entity: WorldTransform2D (position/rotation/scale) plus a
# WorldVisual (accumulated alpha/visible) — alpha/visible are their own derived
# cache, no longer baked into the transform.
#
# Coordinate convention: x grows right, y grows down (raylib-friendly).
# rotation is in radians. scale defaults to 1.0. alpha defaults to 1.0.
import Math
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
import ecs/Transform
open ecs/hierarchySystem/HierarchySystem
open ecs/transformSystem/TransformSystem
open ui/UiSystems
open ui/animationSystem/AnimationRules

# Returns the active flag for entity; defaults to true if no Active.
func active(world: view UiWorld, entityId: view EntityId) ret Bool {
  if componentHas(this: world.actives, entityId: entityId) is false {
    ret true
  }
  let a: view Active = componentView(this: world.actives, entityId: entityId)
  ret a.value
}

func opacity(world: view UiWorld, entityId: view EntityId) ret Float {
  if componentHas(this: world.opacities, entityId: entityId) is false {
    ret 1.0
  }
  let o: view Opacity = componentView(this: world.opacities, entityId: entityId)
  ret o.value
}

# The entity's derived alpha/visible cache (#725), defaulting to fully visible
# when the transform pass hasn't written one (e.g. an entity with no
# ComputedRect). Consumers read this instead of the old WorldTransform.alpha /
# .visible fields.
func worldVisualOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret WorldVisual {
  if componentHas(this: uiSystems.transform2d.worldVisuals, entityId: entityId) is false {
    ret WorldVisual { alpha: 1.0, visible: true }
  }
  let wv: view WorldVisual = componentView(
    this: uiSystems.transform2d.worldVisuals
    entityId: entityId
  )
  ret wv
}

func fxOf(world: view UiWorld, entityId: view EntityId) ret TransformFx {
  if componentHas(this: world.transforms, entityId: entityId) is false {
    ret defaultTransformFx()
  }
  let t: view TransformFx = componentView(this: world.transforms, entityId: entityId)
  ret t
}

func computedRectOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret ComputedRect {
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false {
    ret ComputedRect { position: { x: 0.0, y: 0.0 }, size: { x: 0.0, y: 0.0 } }
  }
  let r: view ComputedRect = componentView(this: uiSystems.layout.computedRects, entityId: entityId)
  ret r
}

# The rectangle a node occupies on screen. Everything that reads a node's place
# reads this one: the painters, the clips, the hit test. The transform pass has
# already moved the origin for the node's own pivot, so nothing moves it again.
type WorldRect {
  x: Float
  y: Float
  w: Float
  h: Float
}

func worldRectOf(wt: view WorldTransform2D, cr: view ComputedRect) ret WorldRect {
  ret WorldRect {
    x: wt.position.x
    y: wt.position.y
    w: cr.size.x * wt.scale.x
    h: cr.size.y * wt.scale.y
  }
}

# Runtime-only translation applied in TRANSFORM (post-layout), not in
# layout. Scrolling writes this instead of `Offset` so a scroll step
# reruns only transform (a cheap translation of the subtree) and never
# the full layout pass — the key to smooth scrolling. Absent → (0,0).
func runtimeOffsetOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Vec2 {
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId) is false {
    ret Vec2 { x: 0.0, y: 0.0 }
  }
  let ro: view RuntimeOffset = componentView(
    this: uiSystems.transform2d.runtimeOffsets
    entityId: entityId
  )
  ret ro.delta
}

# Fold the parent's accumulated alpha/visible with this entity's own Opacity /
# Active / TransformFx into a WorldVisual. Clamped to [0,1]. Roots start from
# parentAlpha=1 / parentVisible=true. (Alpha/visible are the UI-specific concern
# the general geometry TransformSystem does not track — see accumulateVisibility.)
func composeVisual(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  parentAlpha: view Float
  parentVisible: view Bool
) ret WorldVisual {
  let fx: TransformFx = fxOf(world: world, entityId: entityId)
  var visible: Bool = parentVisible
  if active(world: world, entityId: entityId) is false {
    visible = false
  }
  if fx.visible is false {
    visible = false
  }
  var alpha: Float = parentAlpha * opacity(world: world, entityId: entityId) * fx.alpha
  if componentHas(this: uiSystems.animation.poses, entityId: entityId) {
    alpha = alpha * componentView(this: uiSystems.animation.poses, entityId: entityId).opacity
  }
  if alpha < 0.0 {
    alpha = 0.0
  }
  if alpha > 1.0 {
    alpha = 1.0
  }
  ret WorldVisual { alpha: alpha, visible: visible }
}

# Populate each laid-out entity's LOCAL Transform2D (#727): parent-content-local
# position from layout (ComputedRect), plus the runtime-only scroll offset
# (applied here so it never dirties layout), plus authored TransformFx
# rotation/scale. This is the input the general TransformSystem folds into
# worldTransforms. Iterates the ComputedRect table — one local per laid-out node.
func buildLocalTransforms(world: mod UiWorld, uiSystems: mod UiSystems) {
  # A page at rest pays nothing for animation: no pose, no lookup per node
  let anyPose: Bool = componentCount(this: uiSystems.animation.poses) > 0
  loop var i: Int = 0, i < componentCount(this: uiSystems.layout.computedRects), ++i {
    let entityId: EntityId = componentEntityAt(this: uiSystems.layout.computedRects, i: i)
    let cr: view ComputedRect = queryViewAt(table: uiSystems.layout.computedRects, denseIndex: i)
    let ro: Vec2 = runtimeOffsetOf(world: world, uiSystems: uiSystems, entityId: entityId)
    let fx: TransformFx = fxOf(world: world, entityId: entityId)
    # The ECS transform turns and scales about the entity's ORIGIN (its
    # top-left); TransformFx.pivot asks for both about a point inside the box.
    # The origin is moved so that the pivot lands where it was:
    # origin' = origin + p - R(θ) S p, with p the pivot in the box (#1003). The
    # children fold through this, so a scaled card carries its whole subtree.
    var originX: Float = cr.position.x + ro.x
    var originY: Float = cr.position.y + ro.y
    var scaleX: Float = fx.scaleX
    var scaleY: Float = fx.scaleY
    var rotation: Float = fx.rotation
    if anyPose and componentHas(this: uiSystems.animation.poses, entityId: entityId) {
      let pose: view AnimationPose = componentView(
        this: uiSystems.animation.poses
        entityId: entityId
      )
      originX = originX + pose.x
      originY = originY + pose.y
      scaleX = scaleX * pose.scale
      scaleY = scaleY * pose.scale * pose.stretchY
      rotation = rotation + pose.rotation
    }
    if rotation is not 0.0 or scaleX is not 1.0 or scaleY is not 1.0 {
      let pivotX: Float = cr.size.x * fx.pivot.x
      let pivotY: Float = cr.size.y * fx.pivot.y
      let scaledX: Float = pivotX * scaleX
      let scaledY: Float = pivotY * scaleY
      let cosR: Float = Math.cos(x: rotation)
      let sinR: Float = Math.sin(x: rotation)
      originX = originX + pivotX - (scaledX * cosR - scaledY * sinR)
      originY = originY + pivotY - (scaledX * sinR + scaledY * cosR)
    }
    let local: Transform2D = {
      position: { x: originX, y: originY }
      rotation: rotation
      scale: { x: scaleX, y: scaleY }
    }
    componentSet(this: uiSystems.transform2d.localTransforms, entityId: entityId, data: local)
  }
  sharedTakeOutPagePose(world: world, uiSystems: uiSystems)
}

# A node's local place by layout alone
func sharedLocalPlace(uiSystems: view UiSystems, entityId: view EntityId) ret Vec2 {
  var x: Float = 0.0
  var y: Float = 0.0
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) {
    let box: view ComputedRect = componentView(
      this: uiSystems.layout.computedRects
      entityId: entityId
    )
    x = box.position.x
    y = box.position.y
  }
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId) {
    let moved: view RuntimeOffset = componentView(
      this: uiSystems.transform2d.runtimeOffsets
      entityId: entityId
    )
    x = x + moved.delta.x
    y = y + moved.delta.y
  }
  ret Vec2 { x: x, y: y }
}

# A shared node does not take its page's pose. World place is page place + page scale * local
# place, so
# this is the local place that lands it where it would be with the page at rest. The page's pose
# does not
# rotate, and the nodes between are taken to have no scale of their own.
func sharedTakeOutPagePose(world: view UiWorld, uiSystems: mod UiSystems) {
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.sharedNodes), ++i {
    let entityId: EntityId = componentEntityAt(this: uiSystems.animation.sharedNodes, i: i)
    let root: EntityId = componentView(this: uiSystems.animation.sharedNodes, entityId: entityId).pageRoot
    if isNone(this: root) is false and componentHas(
      this: uiSystems.transform2d.localTransforms
      entityId: root
    ) and componentHas(this: uiSystems.transform2d.localTransforms, entityId: entityId) {
      let rootLocal: view Transform2D = componentView(
        this: uiSystems.transform2d.localTransforms
        entityId: root
      )
      let scale: Float = rootLocal.scale.x
      if scale > 0.0 {
        let rest: Vec2 = sharedLocalPlace(uiSystems: uiSystems, entityId: root)
        let awayX: Float = rest.x - rootLocal.position.x
        let awayY: Float = rest.y - rootLocal.position.y
        # The parents' place under the page
        var underX: Float = 0.0
        var underY: Float = 0.0
        var at: EntityId = entityId
        var guard: Int = 0
        loop guard < 256 and componentHas(this: uiSystems.hierarchy.parents, entityId: at) {
          at = componentView(this: uiSystems.hierarchy.parents, entityId: at).parent
          if at is root {
            guard = 256
          } else {
            let place: Vec2 = sharedLocalPlace(uiSystems: uiSystems, entityId: at)
            underX = underX + place.x
            underY = underY + place.y
            guard = guard + 1
          }
        }
        let local: mod Transform2D = componentMod(
          this: uiSystems.transform2d.localTransforms
          entityId: entityId
        )
        local.position.x = (awayX + underX + local.position.x) / scale - underX
        local.position.y = (awayY + underY + local.position.y) / scale - underY
        local.scale.x = local.scale.x / scale
        local.scale.y = local.scale.y / scale
      }
    }
  }
}

# The alpha a shared node inherits: from everything above it but its page's pose
func sharedParentAlpha(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  root: view EntityId
) ret Float {
  var alpha: Float = 1.0
  var at: EntityId = entityId
  var guard: Int = 0
  loop guard < 256 and componentHas(this: uiSystems.hierarchy.parents, entityId: at) {
    at = componentView(this: uiSystems.hierarchy.parents, entityId: at).parent
    alpha = alpha * opacity(world: world, entityId: at) * fxOf(world: world, entityId: at).alpha
    if at is root {
      if componentHas(this: uiSystems.hierarchy.parents, entityId: at) {
        ret alpha * worldVisualOf(
          world: world
          uiSystems: uiSystems
          entityId: componentView(this: uiSystems.hierarchy.parents, entityId: at).parent
        ).alpha
      }
      ret alpha
    }
    if componentHas(this: uiSystems.animation.poses, entityId: at) {
      alpha = alpha * componentView(this: uiSystems.animation.poses, entityId: at).opacity
    }
    guard = guard + 1
  }
  ret alpha
}

# Accumulate alpha/visible down the hierarchy into WorldVisual, in the SAME
# parent-before-child depth order the geometry pass uses. Roots (no Parent) fold
# onto a fully-visible parent; every other entity folds onto its parent's
# already-written WorldVisual (depthOrder guarantees the parent came first).
func accumulateVisibility(world: mod UiWorld, uiSystems: mod UiSystems) {
  # Roots: a local transform but no Parent — the `without` filter (#807/#940)
  # names exactly this "in table A, NOT in table B" set, replacing the manual
  # scan-and-skip. Each root's WorldVisual is computed independently, so the
  # dense walk order (unchanged from the old loop) does not affect the result.
  let roots: List(QueryMatch) = without(
    dataTable: uiSystems.transform2d.localTransforms
    tagTable: uiSystems.hierarchy.parents
  )
  loop let row: view QueryMatch in roots {
    let entityId: EntityId = row.entityId
    let wv: WorldVisual = composeVisual(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      parentAlpha: 1.0
      parentVisible: true
    )
    componentSet(this: uiSystems.transform2d.worldVisuals, entityId: entityId, data: wv)
  }
  # Parented entities, parent before child.
  let order: view List(EntityId) = depthOrder(
    state: world.hierarchyOrder
    parents: uiSystems.hierarchy.parents
    childrens: world.childrens
  )
  loop let entityId: view EntityId in order {
    if componentHas(this: uiSystems.hierarchy.parents, entityId: entityId) {
      let link: view Parent = componentView(this: uiSystems.hierarchy.parents, entityId: entityId)
      let parentWv: WorldVisual = worldVisualOf(
        world: world
        uiSystems: uiSystems
        entityId: link.parent
      )
      var inherited: Float = parentWv.alpha
      if componentHas(this: uiSystems.animation.sharedNodes, entityId: entityId) {
        let root: EntityId = componentView(
          this: uiSystems.animation.sharedNodes
          entityId: entityId
        ).pageRoot
        if isNone(this: root) is false {
          inherited = sharedParentAlpha(
            world: world
            uiSystems: uiSystems
            entityId: entityId
            root: root
          )
        }
      }
      let wv: WorldVisual = composeVisual(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        parentAlpha: inherited
        parentVisible: parentWv.visible
      )
      componentSet(this: uiSystems.transform2d.worldVisuals, entityId: entityId, data: wv)
    }
  }
}

# The UI transform pass (#727): every entity's WorldTransform2D now comes from the
# GENERAL lib/ecs TransformSystem folded over the depth-sorted hierarchy order —
# NOT a bespoke recursive walk. Three steps: build the per-entity local
# Transform2D, run transformSystem2D to fold locals into world transforms, and
# accumulate the alpha/visible WorldVisual cache the geometry system doesn't
# carry. With an identity scale and rotation, the general per-axis compose
# reduces to translation only.
func transformSystem(world: mod UiWorld, uiSystems: mod UiSystems) {
  buildLocalTransforms(world: world, uiSystems: uiSystems)
  transformSystem2D(
    orderState: world.hierarchyOrder
    transforms: uiSystems.transform2d.localTransforms
    worldTransforms: uiSystems.transform2d.worldTransforms
    parents: uiSystems.hierarchy.parents
    childrens: world.childrens
  )
  accumulateVisibility(world: world, uiSystems: uiSystems)
}

# Per-call cache for `systemIfDirty`. SUPERSEDED by the declared schedule
# (#939, lib/ui/Pipeline.rae: the `transform` entry declares this exact read
# set) — fixture 839 proves the two agree; retained for fixture 489 and the
# legacy raylib example until #949 migrates the mobile-UI example. Stores the generation
# of every ComponentTable that transformSystem reads. When all of them
# match the cached values, the whole walk + write-back to
# `worldTransforms` can be skipped — the output would be identical.
#
# `entityCount` snapshots `alive.length` (no per-frame generation on a
# raw List, so we fall back to a structural fingerprint that's
# good-enough for the UI's "no entities created or destroyed without
# also touching a component table" invariant).
#
# Initial -1 sentinels guarantee the first call always runs.
type TransformCache {
  computedRectsGen: Int
  activesGen: Int
  opacitiesGen: Int
  transformsGen: Int
  childrensGen: Int
  parentsGen: Int
  runtimeOffsetsGen: Int
  posesGen: Int
  entityCount: Int
}

func createTransformCache() pub ret TransformCache {
  ret TransformCache {
    computedRectsGen: -1
    activesGen: -1
    opacitiesGen: -1
    transformsGen: -1
    childrensGen: -1
    parentsGen: -1
    runtimeOffsetsGen: -1
    posesGen: -1
    entityCount: -1
  }
}

# Runs transformSystem only when at least one input table has bumped
# its generation since the last call (or the alive-entity count
# changed). Returns true when the system actually ran, false when the
# cached worldTransforms output is still valid.
#
# Conservative-but-correct: never skips when in doubt. The component tables here
# cover every read inside buildLocalTransforms / transformSystem2D /
# accumulateVisibility; we don't track `uiSystems.transform2d.worldTransforms` itself (nor the
# derived localTransforms / worldVisuals) because we're the only writer
# and any external mutation would still be observable through one of
# the other tables (e.g. reading computedRects first).
func systemIfDirty(
  world: mod UiWorld
  uiSystems: mod UiSystems
  cache: mod TransformCache
) pub ret Bool {
  let crGen: Int = componentTableGeneration(ComputedRect, this: uiSystems.layout.computedRects)
  let acGen: Int = componentTableGeneration(Active, this: world.actives)
  let opGen: Int = componentTableGeneration(Opacity, this: world.opacities)
  let txGen: Int = componentTableGeneration(TransformFx, this: world.transforms)
  let chGen: Int = componentTableGeneration(Children, this: world.childrens)
  let plGen: Int = componentTableGeneration(Parent, this: uiSystems.hierarchy.parents)
  let roGen: Int = componentTableGeneration(
    RuntimeOffset
    this: uiSystems.transform2d.runtimeOffsets
  )
  let posesGen: Int = componentTableGeneration(AnimationPose, this: uiSystems.animation.poses)
  let entityCount: Int = world.allocator.alive.length

  var dirty: Bool = false
  if posesGen is not cache.posesGen {
    dirty = true
  }
  if crGen is not cache.computedRectsGen {
    dirty = true
  }
  if roGen is not cache.runtimeOffsetsGen {
    dirty = true
  }
  if acGen is not cache.activesGen {
    dirty = true
  }
  if opGen is not cache.opacitiesGen {
    dirty = true
  }
  if txGen is not cache.transformsGen {
    dirty = true
  }
  if chGen is not cache.childrensGen {
    dirty = true
  }
  if plGen is not cache.parentsGen {
    dirty = true
  }
  if entityCount is not cache.entityCount {
    dirty = true
  }

  if dirty is false {
    ret false
  }

  transformSystem(world: world, uiSystems: uiSystems)
  cache.runtimeOffsetsGen = roGen
  cache.posesGen = posesGen
  cache.computedRectsGen = crGen
  cache.activesGen = acGen
  cache.opacitiesGen = opGen
  cache.transformsGen = txGen
  cache.childrensGen = chGen
  cache.parentsGen = plGen
  cache.entityCount = entityCount
  ret true
}
