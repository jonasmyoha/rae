# RenderPaintCache — how the paint walk draws a node's children: as they are, not at all, or into a
# cached picture (ui/PaintCacheComponents, lib/Gpu2dCanvasCache).
#
# Not at all: a node scaled down (under a zoomed-out camera) to at most `paintDetailPixels` on
# screen draws its own box only; its children would be specks. (The text of a node scaled down
# under `paintTextPixels` tall is skipped the same way, in paintEntityG.) A node at scale 1 or more
# is never cut, so an ordinary page draws as it always has.
#
# A cached picture: a PaintCache node whose whole subtree fits on screen is drawn from its picture
# when that holds this content (a signature of the tables that change what is drawn: rects,
# shapes, texts, sprites, layout's inputs, which nodes are active or there; not the camera) at a
# zoom near this one; otherwise its
# children are drawn into the picture (a capture) and the picture is drawn. Its content's box
# (the union of its subtree's boxes, in its own units) is measured again only when the signature
# changes. A camera that only pans or zooms changes none of those tables, so a zoomed-out canvas
# of 50,000 nodes costs one image a frame.
import Math
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open Gpu2dCanvasCache
open ui/Components
open ui/Ecs
open ui/PaintCacheComponents
open ui/Transform
open ui/UiSystems

# A node scaled down to at most this many pixels on screen (its larger side) draws its own box only
const paintDetailPixels: Float = 4.0

# Text scaled down to under this many pixels tall is not drawn
const paintTextPixels: Float = 3.0

enum PaintChildren { walk, skip, capture }

# `wt`'s node is scaled down and its text would be under paintTextPixels tall
func paintTextTooSmall(wt: view WorldTransform2D, cr: view ComputedRect) ret Bool {
  ret wt.scale.y < 1.0 and cr.size.y > 0.0 and cr.size.y * wt.scale.y < paintTextPixels
}

# The key of `entityId`'s cache slot
func paintCacheKey(entityId: view EntityId) ret Int {
  ret entityId.index * 65536 + entityId.generation % 65536
}

# A number that changes when anything that changes what a subtree draws changes (not the camera)
func paintCacheSignature(world: view UiWorld, uiSystems: view UiSystems) ret Int {
  var signature: Int = aliveCount(world: world)
  loop let generation: Int in List(Int) {
    componentTableGeneration(this: world.rects)
    componentTableGeneration(this: world.shapes)
    componentTableGeneration(this: world.texts)
    componentTableGeneration(this: world.sprites)
    componentTableGeneration(this: world.actives)
    componentTableGeneration(this: world.opacities)
    componentTableGeneration(this: world.childrens)
    componentTableGeneration(this: world.styleOverrides)
    componentTableGeneration(this: world.gradientFills)
    componentTableGeneration(this: world.wireDatas)
    componentTableGeneration(this: world.wireSets)
    # layout's inputs, not its output: a layout run that changes nothing still rewrites its rects
    componentTableGeneration(this: world.sizes)
    componentTableGeneration(this: world.layouts)
    componentTableGeneration(this: world.paddings)
    componentTableGeneration(this: world.offsets)
    componentTableGeneration(this: world.aligns)
  } {
    signature = (signature * 1000003 + generation) % 2305843009213693951
  }
  ret signature
}

# The union of `entityId`'s descendants' boxes, in its own units (left, top, right, bottom), with
# a margin for strokes and shadows; none with no laid-out descendant
func paintSubtreeBox(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret opt List(Float) {
  if not componentHas(this: uiSystems.transform2d.worldTransforms, entityId: entityId) {
    ret none
  }
  let origin: view WorldTransform2D = componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  )
  let scale: Float = Math.max(a: 0.000001, b: Math.abs(value: origin.scale.x))
  var stack: List(EntityId) = { entityId }
  var found: Bool = false
  var left: Float = 0.0
  var top: Float = 0.0
  var right: Float = 0.0
  var bottom: Float = 0.0
  loop stack.length > 0 {
    let at: EntityId = stack.pop()
    if componentHas(this: world.childrens, entityId: at) {
      let children: view List(EntityId) = componentView(this: world.childrens, entityId: at).ids
      loop let child: view EntityId in children {
        stack.add(value: child)
      }
    }
    if at is not entityId and componentHas(this: uiSystems.layout.computedRects, entityId: at) and componentHas(
      this: uiSystems.transform2d.worldTransforms
      entityId: at
    ) {
      let rect: WorldRect = worldRectOf(
        wt: componentView(this: uiSystems.transform2d.worldTransforms, entityId: at)
        cr: componentView(this: uiSystems.layout.computedRects, entityId: at)
      )
      let x0: Float = (Math.min(a: rect.x, b: rect.x + rect.w) - origin.position.x) / scale
      let x1: Float = (Math.max(a: rect.x, b: rect.x + rect.w) - origin.position.x) / scale
      let y0: Float = (Math.min(a: rect.y, b: rect.y + rect.h) - origin.position.y) / scale
      let y1: Float = (Math.max(a: rect.y, b: rect.y + rect.h) - origin.position.y) / scale
      if not found or x0 < left {
        left = x0
      }
      if not found or y0 < top {
        top = y0
      }
      if not found or x1 > right {
        right = x1
      }
      if not found or y1 > bottom {
        bottom = y1
      }
      found = true
    }
  }
  if not found {
    ret none
  }
  let margin: Float = paintCullMargin
  ret List(Float) { left - margin, top - margin, right + margin, bottom + margin }
}

# How `entityId`'s children are drawn this frame (a capture has begun when it says `capture`)
func paintChildrenChoose(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  canvas: mod Gpu2dCanvas
) ret PaintChildren {
  if not componentHas(this: uiSystems.transform2d.worldTransforms, entityId: entityId) {
    ret PaintChildren.walk
  }
  let transform: view WorldTransform2D = componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  )
  # a node scaled down to a speck: its own box only
  if transform.scale.x < 1.0 and componentHas(
    this: uiSystems.layout.computedRects
    entityId: entityId
  ) {
    let size: Vec2 = componentView(this: uiSystems.layout.computedRects, entityId: entityId).size
    if size.x > 0.0 and size.y > 0.0 and Math.max(a: size.x, b: size.y) * transform.scale.x <= paintDetailPixels {
      ret PaintChildren.skip
    }
  }
  if not componentHas(this: world.paintCaches, entityId: entityId) or transform.rotation is not 0.0 {
    ret PaintChildren.walk
  }
  let settings: view PaintCache = componentView(this: world.paintCaches, entityId: entityId)
  if not settings.enabled or canvas.caches.capturing >= 0 {
    ret PaintChildren.walk
  }
  let key: Int = paintCacheKey(entityId: entityId)
  let signature: Int = paintCacheSignature(world: world, uiSystems: uiSystems)
  var slot: Int = canvasCacheFind(canvas: canvas, key: key)
  var held: Gpu2dCacheSlot = { key: key }
  if slot >= 0 {
    held = canvas.caches.slots.copyAtDefault(index: slot)
  }
  # the content's box in the node's units: measured again when the content changed
  var box: List(Float) = { held.left, held.top, held.right, held.bottom }
  if slot < 0 or held.signature is not signature {
    if let measured: List(Float) = paintSubtreeBox(
      world: world
      uiSystems: uiSystems
      entityId: entityId
    ) {
      box = measured
    } else {
      ret PaintChildren.walk
    }
  }
  let scale: Float = transform.scale.x
  let left: Float = transform.position.x + box.copyAtDefault(index: 0) * scale
  let top: Float = transform.position.y + box.copyAtDefault(index: 1) * scale
  let right: Float = transform.position.x + box.copyAtDefault(index: 2) * scale
  let bottom: Float = transform.position.y + box.copyAtDefault(index: 3) * scale
  # all of it on screen, or the picture would miss a part
  if left < 0.0 or top < 0.0 or right > paintViewWidth() or bottom > paintViewHeight() {
    ret PaintChildren.walk
  }
  let ratio: Float = scale / Math.max(a: 0.000001, b: held.scale)
  if slot >= 0 and held.ready and held.signature is signature and ratio <= settings.zoomInLimit and ratio >= settings.zoomOutLimit and held.width is canvas.offscreenWidth and held.height is canvas.offscreenHeight {
    canvasDrawCache(
      canvas: canvas
      slot: slot
      fromX: held.captureX + held.left * held.scale
      fromY: held.captureY + held.top * held.scale
      fromW: (held.right - held.left) * held.scale
      fromH: (held.bottom - held.top) * held.scale
      x: left
      y: top
      w: right - left
      h: bottom - top
    )
    ret PaintChildren.skip
  }
  slot = canvasCacheBegin(canvas: canvas, key: key)
  if slot < 0 {
    ret PaintChildren.walk
  }
  if let captured: mod Gpu2dCacheSlot = canvas.caches.slots.modAt(index: slot) {
    captured.signature = signature
    captured.left = box.copyAtDefault(index: 0)
    captured.top = box.copyAtDefault(index: 1)
    captured.right = box.copyAtDefault(index: 2)
    captured.bottom = box.copyAtDefault(index: 3)
    captured.scale = scale
    captured.captureX = transform.position.x
    captured.captureY = transform.position.y
  }
  ret PaintChildren.capture
}

# After a capture's children were drawn: back to the frame, and the picture drawn there
func paintCaptureFinish(canvas: mod Gpu2dCanvas) {
  let slot: Int = canvas.caches.capturing
  canvasCacheEnd(canvas: canvas)
  if slot < 0 {
    ret
  }
  let held: Gpu2dCacheSlot = canvas.caches.slots.copyAtDefault(index: slot)
  let x: Float = held.captureX + held.left * held.scale
  let y: Float = held.captureY + held.top * held.scale
  let w: Float = (held.right - held.left) * held.scale
  let h: Float = (held.bottom - held.top) * held.scale
  canvasDrawCache(
    canvas: canvas
    slot: slot
    fromX: x
    fromY: y
    fromW: w
    fromH: h
    x: x
    y: y
    w: w
    h: h
  )
}
