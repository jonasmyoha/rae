# RenderFlameGraph — a FlameGraph (ui/ChartComponents, ui/flameGraphSystem) drawn into its node's
# box: each bar flameVisible gives in its name's color, its name inside when it is wide enough, the
# selected bar outlined. Clipped to the box; its cost is the bars that show.
import Gpu2d
import Math
import Gpu2dText
import SdfText
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open ui/ChartComponents
open ui/Components
open ui/Ecs
open ui/Transform
open ui/UiSystems
open ui/flameGraphSystem/FlameGraphSystem
open ui/timelineSystem/TimelineSystem

func paintFlameGraphG(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  res: view Gpu2dUi
  canvas: mod Gpu2dCanvas
) {
  if componentHas(this: world.flameGraphStates, entityId: entityId) is false {
    ret
  }
  let flame: view FlameGraph = componentView(this: world.flameGraphs, entityId: entityId)
  let state: view FlameGraphState = componentView(this: world.flameGraphStates, entityId: entityId)
  let paint: PaintBox = g2dPaintBox(
    world: world
    entityId: entityId
    wt: wt
    cr: cr
  )
  let box: TimelineBox = { x: paint.x, y: paint.y, w: paint.w, h: paint.h }
  let outline: Int = g2dColor(
    color: g2dChain(color: world.theme.active.palette.textPrimary, chain255: chain255)
  )
  Gpu2d.pushClipRect(
    canvas: canvas
    x: box.x
    y: box.y
    w: box.w
    h: box.h
  )
  loop let rect: FlameRect in flameVisible(flame: flame, state: state, box: box) {
    Gpu2d.drawRect(
      canvas: canvas
      x: rect.x
      y: rect.y
      w: Math.max(a: 1.0, b: rect.w - 1.0)
      h: rect.h
      color: timelineSpanColor(nameId: rect.nameId)
    )
    if rect.w > 48.0 and Gpu2dText.measureText(
      font: res.textFont
      text: state.names.copyAtDefault(index: rect.nameId)
      sizePx: rect.h * 0.7
    ) + 6.0 <= rect.w {
      Gpu2dText.drawText(
        canvas: canvas
        font: res.textFont
        text: state.names.copyAtDefault(index: rect.nameId)
        x: rect.x + 3.0
        y: rect.y + rect.h * 0.78
        sizePx: rect.h * 0.7
        color: 0xFF101010
      )
    }
    if rect.node is state.selected {
      let shown: TimelineRect = {
        x: rect.x
        y: rect.y
        w: rect.w - 1.0
        h: rect.h
        lane: 0
        span: 0
        nameId: rect.nameId
        depth: 0
      }
      timelineOutline(canvas: canvas, rect: shown, color: outline)
    }
  }
  Gpu2d.popClipRect(canvas: canvas)
}
