# RenderLineGraph — a LineGraph (ui/ChartComponents, ui/lineGraphSystem) drawn into its node's box:
# per series, each pixel column a stroke from its lowest to its highest value, joined to the next
# column's, in the series' color; each series' name in a legend at the top left; the selected point
# marked. Clipped to the box; its cost is the visible points.
import Gpu2d
import Gpu2dText
import SdfText
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open ui/ChartComponents
open ui/Components
open ui/Ecs
open ui/Transform
open ui/UiSystems
open ui/lineGraphSystem/LineGraphSystem
open ui/timelineSystem/TimelineSystem

func paintLineGraphG(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  res: view Gpu2dUi
  canvas: mod Gpu2dCanvas
) {
  if componentHas(this: world.lineGraphStates, entityId: entityId) is false {
    ret
  }
  let graph: view LineGraph = componentView(this: world.lineGraphs, entityId: entityId)
  let state: view LineGraphState = componentView(this: world.lineGraphStates, entityId: entityId)
  let paint: PaintBox = g2dPaintBox(
    world: world
    entityId: entityId
    wt: wt
    cr: cr
  )
  let box: TimelineBox = { x: paint.x, y: paint.y, w: paint.w, h: paint.h }
  let columns: List(LineColumn) = lineColumns(state: state, box: box)
  let range: LineRange = lineRange(graph: graph, columns: columns)
  Gpu2d.pushClipRect(
    canvas: canvas
    x: box.x
    y: box.y
    w: box.w
    h: box.h
  )
  var previous: LineColumn = {
    series: -1
    x: 0.0
    low: 0.0
    high: 0.0
    first: 0.0
    last: 0.0
  }
  loop let column: LineColumn in columns {
    let color: Int = timelineSpanColor(nameId: column.series)
    let top: Float = lineY(range: range, box: box, value: column.high)
    let bottom: Float = lineY(range: range, box: box, value: column.low)
    Gpu2d.drawRect(
      canvas: canvas
      x: column.x
      y: top - 1.0
      w: 2.0
      h: bottom - top + 2.0
      color: color
    )
    if previous.series is column.series {
      Gpu2d.drawLine(
        canvas: canvas
        x0: previous.x + 1.0
        y0: lineY(range: range, box: box, value: previous.last)
        x1: column.x + 1.0
        y1: lineY(range: range, box: box, value: column.first)
        thickness: 2.0
        color: color
      )
    }
    previous = column
  }
  # the selected point
  if state.selectedSeries >= 0 {
    if let series: view LineSeries = state.series.viewAt(index: state.selectedSeries) {
      if state.selectedPoint >= 0 and state.selectedPoint < series.times.length {
        let x: Float = lineX(
          state: state
          box: box
          time: series.times.copyAtDefault(index: state.selectedPoint)
        )
        let y: Float = lineY(
          range: range
          box: box
          value: series.values.copyAtDefault(index: state.selectedPoint)
        )
        Gpu2d.drawRoundedRect(
          canvas: canvas
          x: x - 4.0
          y: y - 4.0
          w: 8.0
          h: 8.0
          radius: 4.0
          color: 0xFFF0F0F0
        )
      }
    }
  }
  # the legend
  var legendX: Float = box.x + 6.0
  loop var s: Int = 0, s < state.series.length, ++s {
    if let series: view LineSeries = state.series.viewAt(index: s) {
      Gpu2d.drawRect(
        canvas: canvas
        x: legendX
        y: box.y + 9.0
        w: 10.0
        h: 4.0
        color: timelineSpanColor(nameId: s)
      )
      Gpu2dText.drawText(
        canvas: canvas
        font: res.textFont
        text: series.name
        x: legendX + 14.0
        y: box.y + 16.0
        sizePx: 13.0
        color: 0xFFE0E0E0
      )
      legendX = legendX + 24.0 + Gpu2dText.measureText(
        font: res.textFont
        text: series.name
        sizePx: 13.0
      )
    }
  }
  Gpu2d.popClipRect(canvas: canvas)
}
