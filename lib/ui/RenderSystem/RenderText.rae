# RenderText: a Text node's glyphs, and a changing text (AnimateText) as its old and new text
# together.
# The old text is only drawn here: layout and measuring never see it.
open ui/Ecs
import Gpu2d
import Math
import Gpu2dText
import SdfText
open text/Graphemes
open ui/AnimationSystem
import ui/Components
import ui/IconCodepoints
import ui/Layer
import ui/Theme
import ui/ThemeResolved
import ui/TextStyle
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open ui/UiSystems
open ui/Transform
open ui/AnimationComponents

func paintTextG(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  res: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  content: view String
) {
  let t: view Text = componentView(this: world.texts, entityId: entityId)
  let textFont: view SdfFont = uiTextFont(
    world: world
    entityId: entityId
    styleId: t.styleId
    res: res
  )
  if content.length() is 0 {
    ret
  }
  # cut in its middle where it is too wide (and not being cut already)
  if t.cut is TextCut.middle and t.wrapWidthMode is WrapWidthMode.none {
    let shown: String = textCutToBox(
      world: world
      entityId: entityId
      wt: wt
      cr: cr
      res: res
      content: content
    )
    if shown is not content {
      paintTextG(
        world: world
        entityId: entityId
        wt: wt
        cr: cr
        chain255: chain255
        res: res
        canvas: canvas
        content: shown
      )
      ret
    }
  }
  # Hard line breaks ("\n", "\r\n"): each line on its own (a wrapping text
  # breaks there itself, drawTextWrappedEx)
  if t.wrapWidthMode is WrapWidthMode.none and SdfText.sdfHasHardBreak(text: content) {
    paintTextLines(
      world: world
      entityId: entityId
      wt: wt
      cr: cr
      chain255: chain255
      res: res
      canvas: canvas
      content: content
    )
    ret
  }
  var size: Float = resolveTextSize(theme: res.theme, styleId: t.styleId)
  let weight: Float = resolveTextWeight(theme: res.theme, styleId: t.styleId)
  var baseCol: RgbaColor = resolveTextColor(
    theme: res.theme
    styleId: t.styleId
    active: world.theme.active
  )
  # Tier-2 style override (#236): size/color patch over the resolved
  # style for the sparse set of entities that carry one; base styleId
  # still drives everything else (alignment, shadow, unset fields).
  if componentHas(this: world.styleOverrides, entityId: entityId) {
    let so: view StyleOverride = componentView(this: world.styleOverrides, entityId: entityId)
    size = styleOverrideSize(base: size, so: so)
    if so.hasColor and so.colorSlot.length() > 0 {
      baseCol = uiThemeColor(theme: world.theme, name: so.colorSlot)
    } else {
      baseCol = styleOverrideColor(base: baseCol, so: so, active: world.theme.active)
    }
  }
  # An inherited scale (editor camera, scaled parent) scales glyphs + box.
  size = size * wt.scale.x
  let rect: WorldRect = worldRectOf(wt: wt, cr: cr)
  let boxW: Float = rect.w
  let boxH: Float = rect.h
  if t.shrinkToFit and t.wrapWidthMode is WrapWidthMode.none {
    let natural: SdfTextBounds = visualBoundsAt(
      world: world
      entityId: entityId
      text: content
      isIcon: false
      sizePx: size
      res: res
    )
    size = TextStyle.shrinkTextSizeToFit(size: size, naturalWidth: natural.advance, boxWidth: boxW)
  }
  let col: RgbaColor = g2dChain(color: baseCol, chain255: chain255)
  var boldWidth: Float = 0.0
  if weight > 450.0 {
    boldWidth = ((weight - 400.0) / 300.0) * size * 0.025
    if boldWidth > 1.5 {
      boldWidth = 1.5
    }
  }
  var centerX: Bool = resolveTextIsCentered(theme: res.theme, styleId: t.styleId)
  var rightX: Bool = resolveTextIsRightAligned(theme: res.theme, styleId: t.styleId)
  # The optical-align fields this draw uses, read off the component through a
  # view when the node has one (plain values, no component copy).
  var opticalEnabled: Bool = false
  var opticalCenterX: Bool = false
  var opticalCenterY: Bool = false
  var opticalBias: Vec2 = { x: 0.0, y: 0.0 }
  if componentHas(this: world.aligns, entityId: entityId) {
    let al: view Align = componentView(this: world.aligns, entityId: entityId)
    if al.hasX {
      if al.x is AlignKind.center {
        centerX = true
      }
      if al.x is AlignKind.end {
        rightX = true
      }
    }
  }
  if componentHas(this: world.opticalAligns, entityId: entityId) {
    let optical: view OpticalAlign = componentView(this: world.opticalAligns, entityId: entityId)
    opticalEnabled = optical.enabled
    opticalCenterX = optical.centerX
    opticalCenterY = optical.centerY
    opticalBias = optical.bias
    if optical.enabled {
      centerX = optical.centerX
      if optical.centerX {
        rightX = false
      }
    }
  }
  var drawX: Float = rect.x
  var drawY: Float = rect.y + size
  if resolveTextIsVCentered(theme: res.theme, styleId: t.styleId) {
    # The style centers the font's capitals in the node's box: the baseline
    # half a cap height (measured off "H") below the middle, so a label reads
    # centered whatever its letters, with descenders hanging below. Centering a
    # line box [top, top + size] with the baseline at its bottom left the
    # capitals about 0.15 of the size low.
    let capital: SdfTextBounds = SdfText.sdfMeasureTextBounds(
      font: textFont
      text: "H"
      sizePx: size
    )
    drawY = rect.y + boxH / 2.0 - (capital.top + capital.bottom) / 2.0
  }
  if centerX or rightX {
    let bounds: SdfTextBounds = visualBoundsAt(
      world: world
      entityId: entityId
      text: content
      isIcon: false
      sizePx: size
      res: res
    )
    if centerX {
      drawX = rect.x + boxW / 2.0 - (bounds.left + bounds.right) / 2.0
    }
    if rightX {
      drawX = rect.x + boxW - bounds.right
    }
  }
  if opticalEnabled {
    let bounds: SdfTextBounds = visualBoundsAt(
      world: world
      entityId: entityId
      text: content
      isIcon: false
      sizePx: size
      res: res
    )
    if opticalCenterX {
      drawX = rect.x + boxW / 2.0 - (bounds.left + bounds.right) / 2.0 + opticalBias.x
    }
    if opticalCenterY {
      drawY = rect.y + boxH / 2.0 - (bounds.top + bounds.bottom) / 2.0 + opticalBias.y
    }
  }
  # The style's outline (its theme `outline` token), in physical pixels: the
  # width in points, by the node's scale and the canvas's pixels per point
  let outline: TextOutlineDraw = textStyleOutline(
    world: world
    res: res
    styleId: t.styleId
    chain255: chain255
    scale: wt.scale.x * canvasPixelsPerUnit(canvas: canvas)
  )
  let pixelsPerUnit: Float = Math.abs(value: wt.scale.x) * canvasPixelsPerUnit(canvas: canvas)
  if t.wrapWidthMode is WrapWidthMode.nodeWidth {
    let lineHeight: Float = size * resolveTextLineHeight(theme: res.theme, styleId: t.styleId)
    warnTextRange(
      canvas: canvas
      font: textFont
      styleId: t.styleId
      emPixels: size * pixelsPerUnit
      outlinePixels: outline.width
      softnessPixels: 0.0
    )
    if outline.width > 0.0 {
      Gpu2dText.drawTextWrappedEx(
        canvas: canvas
        font: textFont
        text: content
        x: drawX
        y: drawY
        sizePx: size
        color: outline.color
        maxWidth: boxW
        lineHeight: lineHeight
        outlineWidth: boldWidth + outline.width
        outlineColor: outline.color
      )
    }
    Gpu2dText.drawTextWrappedEx(
      canvas: canvas
      font: textFont
      text: content
      x: drawX
      y: drawY
      sizePx: size
      color: g2dColor(color: col)
      maxWidth: boxW
      lineHeight: lineHeight
      outlineWidth: boldWidth
      outlineColor: g2dColor(color: col)
    )
    ret
  }
  # Text shadow (#232). Precedence per §7's override ladder:
  #   1. a raw TextShadow component (the last-resort per-entity
  #      override) wins when present;
  #   2. otherwise the STYLE's shadow token (theme-owned) — the paved
  #      path that replaced the inline TextShadow blocks from e39a378.
  # Both feed the same drawTextEx, so a token whose values match the
  # old inline block renders byte-identically.
  var hasShadow: Bool = false
  var shCol: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  var shOffX: Float = 0.0
  var shOffY: Float = 0.0
  var shSoft: Float = 1.0
  if componentHas(this: world.textShadows, entityId: entityId) {
    let sh: view TextShadow = componentView(this: world.textShadows, entityId: entityId)
    hasShadow = true
    shCol = sh.color
    shOffX = sh.offset.x
    shOffY = sh.offset.y
    shSoft = sh.softness
  } else {
    let shadowName: String = resolveTextShadowName(theme: res.theme, styleId: t.styleId)
    if shadowName.length() > 0 {
      if let si: Int = themeShadowIndex(theme: res.theme, name: shadowName) {
        hasShadow = true
        var r: Int = 0
        var g: Int = 0
        var b: Int = 0
        var a: Int = 255
        if let shadowRVal: Int = res.theme.shadowR.copyAt(index: si) {
          r = shadowRVal
        }
        if let shadowGVal: Int = res.theme.shadowG.copyAt(index: si) {
          g = shadowGVal
        }
        if let shadowBVal: Int = res.theme.shadowB.copyAt(index: si) {
          b = shadowBVal
        }
        if let shadowAVal: Int = res.theme.shadowA.copyAt(index: si) {
          a = shadowAVal
        }
        shCol = RgbaColor { r: r, g: g, b: b, a: a }
        if let shadowOffXVal: Float = res.theme.shadowOffX.copyAt(index: si) {
          shOffX = shadowOffXVal
        }
        if let shadowOffYVal: Float = res.theme.shadowOffY.copyAt(index: si) {
          shOffY = shadowOffYVal
        }
        if let shadowSoftVal: Float = res.theme.shadowSoft.copyAt(index: si) {
          shSoft = shadowSoftVal
        }
      }
    }
  }
  var shadowSoftness: Float = 0.0
  if hasShadow {
    shadowSoftness = shSoft
  }
  warnTextRange(
    canvas: canvas
    font: textFont
    styleId: t.styleId
    emPixels: size * pixelsPerUnit
    outlinePixels: outline.width
    softnessPixels: shadowSoftness
  )
  if outline.width > 0.0 {
    # The shadow (of the outlined glyphs), the outline, then the glyphs
    if hasShadow {
      var soft: Float = shSoft
      if soft < 1.0 {
        soft = 1.0
      }
      let shadowColor: Int = g2dColor(color: g2dChain(color: shCol, chain255: chain255))
      Gpu2dText.emitRun(
        canvas: canvas
        font: textFont
        text: content
        x: drawX + shOffX * wt.scale.x
        y: drawY + shOffY * wt.scale.y
        sizePx: size
        color: shadowColor
        outlineWidth: boldWidth + outline.width
        outlineColor: shadowColor
        softness: soft
      )
    }
    Gpu2dText.emitRun(
      canvas: canvas
      font: textFont
      text: content
      x: drawX
      y: drawY
      sizePx: size
      color: outline.color
      outlineWidth: boldWidth + outline.width
      outlineColor: outline.color
      softness: 1.0
    )
    Gpu2dText.emitRun(
      canvas: canvas
      font: textFont
      text: content
      x: drawX
      y: drawY
      sizePx: size
      color: g2dColor(color: col)
      outlineWidth: boldWidth
      outlineColor: g2dColor(color: col)
      softness: 1.0
    )
    ret
  }
  if hasShadow {
    let shChained: RgbaColor = g2dChain(color: shCol, chain255: chain255)
    Gpu2dText.drawTextEx(
      canvas: canvas
      font: textFont
      text: content
      x: drawX
      y: drawY
      sizePx: size
      color: g2dColor(color: col)
      outlineColor: g2dColor(color: col)
      outlineWidth: boldWidth
      shadowColor: g2dColor(color: shChained)
      shadowOffX: shOffX * wt.scale.x
      shadowOffY: shOffY * wt.scale.y
      shadowSoftness: shSoft
    )
    ret
  }
  if boldWidth > 0.0 {
    Gpu2dText.drawTextEx(
      canvas: canvas
      font: textFont
      text: content
      x: drawX
      y: drawY
      sizePx: size
      color: g2dColor(color: col)
      outlineColor: g2dColor(color: col)
      outlineWidth: boldWidth
      shadowColor: 0
      shadowOffX: 0.0
      shadowOffY: 0.0
      shadowSoftness: 1.0
    )
  } else {
    Gpu2dText.drawText(
      canvas: canvas
      font: textFont
      text: content
      x: drawX
      y: drawY
      sizePx: size
      color: g2dColor(color: col)
    )
  }
}

# A text with hard line breaks: each line drawn as a text of its own, aligned
# on its own (start, center or end of the node), one line height (the style's
# lineHeight) below the one before. A style that centers vertically centers
# the block of lines; otherwise the first line sits where a single line would.
func paintTextLines(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  res: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  content: view String
) {
  let t: view Text = componentView(this: world.texts, entityId: entityId)
  var size: Float = resolveTextSize(theme: res.theme, styleId: t.styleId)
  if componentHas(this: world.styleOverrides, entityId: entityId) {
    let so: view StyleOverride = componentView(this: world.styleOverrides, entityId: entityId)
    size = styleOverrideSize(base: size, so: so)
  }
  size = size * wt.scale.x
  let lineHeight: Float = size * resolveTextLineHeight(theme: res.theme, styleId: t.styleId)
  var centeredBlock: Bool = resolveTextIsVCentered(theme: res.theme, styleId: t.styleId)
  if componentHas(this: world.opticalAligns, entityId: entityId) {
    let optical: view OpticalAlign = componentView(this: world.opticalAligns, entityId: entityId)
    if optical.enabled and optical.centerY {
      centeredBlock = true
    }
  }
  let lines: List(String) = SdfText.sdfHardLines(text: content)
  var shift: Float = 0.0
  if centeredBlock {
    shift = 0.0 - (lines.length - 1).toFloat() * lineHeight / 2.0
  }
  loop var i: Int = 0, i < lines.length, ++i {
    let line: String = lines.copyAtFallback(index: i, fallback: "")
    if line.length() is 0 {
      continue
    }
    var lineTransform: WorldTransform2D = wt
    lineTransform.position.y = wt.position.y + shift + i.toFloat() * lineHeight
    paintTextG(
      world: world
      entityId: entityId
      wt: lineTransform
      cr: cr
      chain255: chain255
      res: res
      canvas: canvas
      content: line
    )
  }
}

# Where a rolling text may be drawn: its box, inside the nearest shape it sits on (itself or an
# ancestor), with that shape's round corners when the text covers the whole shape, as a label that
# fills its chip does. A parent's Overflow clip is already on the canvas and cuts this too.
func textRollClip(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
) ret ClipBox {
  var box: ClipBox = {
    x: wt.position.x
    y: wt.position.y
    w: cr.size.x * wt.scale.x
    h: cr.size.y * wt.scale.y
    radius: 0.0
  }
  var current: EntityId = entityId
  loop var depth: Int = 0, depth < 16, ++depth {
    if componentHas(this: world.shapes, entityId: current) and componentHas(
      this: uiSystems.transform2d.worldTransforms
      entityId: current
    ) and componentHas(this: uiSystems.layout.computedRects, entityId: current) {
      let shapeAt: view WorldTransform2D = componentView(
        this: uiSystems.transform2d.worldTransforms
        entityId: current
      )
      let shape: WorldRect = worldRectOf(
        wt: shapeAt
        cr: componentView(this: uiSystems.layout.computedRects, entityId: current)
      )
      let x0: Float = Math.max(a: box.x, b: shape.x)
      let y0: Float = Math.max(a: box.y, b: shape.y)
      let x1: Float = Math.min(a: box.x + box.w, b: shape.x + shape.w)
      let y1: Float = Math.min(a: box.y + box.h, b: shape.y + shape.h)
      let covers: Bool = x0 - shape.x < 0.5 and y0 - shape.y < 0.5 and shape.x + shape.w - x1 < 0.5 and shape.y + shape.h - y1 < 0.5
      box.x = x0
      box.y = y0
      box.w = Math.max(a: 0.0, b: x1 - x0)
      box.h = Math.max(a: 0.0, b: y1 - y0)
      if covers {
        let radius: Float = componentView(this: world.shapes, entityId: current).radius * shapeAt.scale.x
        box.radius = Math.min(a: radius, b: Math.min(a: box.w, b: box.h) / 2.0)
      }
      ret box
    }
    if componentHas(this: uiSystems.hierarchy.parents, entityId: current) is false {
      ret box
    }
    current = componentView(this: uiSystems.hierarchy.parents, entityId: current).parent
  }
  ret box
}

type ClipBox {
  x: Float
  y: Float
  w: Float
  h: Float
  radius: Float
}

# A text changing (AnimateText): the old one going and the new one coming. A roll stays in the box.
func paintTextWithGhost(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  res: view Gpu2dUi
  canvas: mod Gpu2dCanvas
) {
  let ghost: view TextGhost = componentView(
    this: uiSystems.animation.textGhosts
    entityId: entityId
  )
  var look: TextGhostLook = textGhostLook(
    kind: AnimateTextKind.fade
    rollFrom: RollFrom.below
    progress: ghost.progress.current
    start: 0.0
    height: 0.0
  )
  var rolling: Bool = false
  if componentHas(this: world.animateTexts, entityId: entityId) {
    let animate: view AnimateText = componentView(this: world.animateTexts, entityId: entityId)
    rolling = animate.kind is AnimateTextKind.roll and not uiSystems.animation.settings.reduceMotion
    var kind: AnimateTextKind = AnimateTextKind.fade
    if rolling {
      kind = AnimateTextKind.roll
    }
    var rollFrom: RollFrom = animate.rollFrom
    if rollFrom is RollFrom.auto {
      rollFrom = ghost.rollFrom
    }
    look = textGhostLook(
      kind: kind
      rollFrom: rollFrom
      progress: ghost.progress.current
      start: ghost.progress.start
      height: cr.size.y * wt.scale.y
    )
  }
  if rolling {
    let clip: ClipBox = textRollClip(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      wt: wt
      cr: cr
    )
    if clip.radius > 0.0 {
      Gpu2d.pushClipRoundedRect(
        canvas: canvas
        x: clip.x
        y: clip.y
        w: clip.w
        h: clip.h
        radius: clip.radius
      )
    } else {
      Gpu2d.pushClipRect(
        canvas: canvas
        x: clip.x
        y: clip.y
        w: clip.w
        h: clip.h
      )
    }
  }
  var ghostAt: WorldTransform2D = wt
  ghostAt.position.y = wt.position.y + look.ghostY
  paintTextG(
    world: world
    entityId: entityId
    wt: ghostAt
    cr: cr
    chain255: (chain255.toFloat() * look.ghostAlpha).toInt()
    res: res
    canvas: canvas
    content: ghost.text
  )
  var textAt: WorldTransform2D = wt
  textAt.position.y = wt.position.y + look.textY
  paintTextG(
    world: world
    entityId: entityId
    wt: textAt
    cr: cr
    chain255: (chain255.toFloat() * look.textAlpha).toInt()
    res: res
    canvas: canvas
    content: componentView(this: world.texts, entityId: entityId).text
  )
  if rolling {
    Gpu2d.flush(canvas: canvas)
    Gpu2d.popClipRect(canvas: canvas)
  }
}

# A text style's outline as drawn: its color (0xAARRGGBB, faded with the node)
# and its width in physical pixels (0: none)
type TextOutlineDraw {
  color: Int
  width: Float
}

# The outline of style `styleId` (its theme `outline` token; ui/ThemeParse
# Outline.rae), `scale` physical pixels a point
func textStyleOutline(
  world: view UiWorld
  res: view Gpu2dUi
  styleId: view String
  chain255: view Int
  scale: view Float
) ret TextOutlineDraw {
  let name: String = resolveTextOutlineName(theme: res.theme, styleId: styleId)
  if name.length() is 0 {
    ret TextOutlineDraw { color: 0, width: 0.0 }
  }
  if let index: Int = themeOutlineIndex(theme: res.theme, name: name) {
    let slot: String = res.theme.outlineColorSlots.copyAtFallback(index: index, fallback: "")
    var color: RgbaColor = {
      r: res.theme.outlineR.copyAtFallback(index: index, fallback: 0)
      g: res.theme.outlineG.copyAtFallback(index: index, fallback: 0)
      b: res.theme.outlineB.copyAtFallback(index: index, fallback: 0)
      a: res.theme.outlineA.copyAtFallback(index: index, fallback: 255)
    }
    if slot.length() > 0 {
      color = uiThemeColor(theme: world.theme, name: slot)
    }
    let width: Float = res.theme.outlineWidths.copyAtFallback(index: index, fallback: 0.0) * scale
    ret TextOutlineDraw {
      color: g2dColor(color: g2dChain(color: color, chain255: chain255))
      width: width
    }
  }
  ret TextOutlineDraw { color: 0, width: 0.0 }
}

# Physical pixels a canvas unit (a point) is drawn at: the frame's scale
func canvasPixelsPerUnit(canvas: view Gpu2dCanvas) ret Float {
  let scale: Float = (xformAt(canvas: canvas, index: 2) + xformAt(canvas: canvas, index: 3)) / 2.0
  if scale <= 0.0 {
    ret 1.0
  }
  ret scale
}

# The text of a node as it fits its box, cut in the middle when it does not
func textCutToBox(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  res: view Gpu2dUi
  content: view String
) ret String {
  let t: view Text = componentView(this: world.texts, entityId: entityId)
  let textFont: view SdfFont = uiTextFont(
    world: world
    entityId: entityId
    styleId: t.styleId
    res: res
  )
  var size: Float = resolveTextSize(theme: res.theme, styleId: t.styleId)
  if componentHas(this: world.styleOverrides, entityId: entityId) {
    let override: view StyleOverride = componentView(this: world.styleOverrides, entityId: entityId)
    size = styleOverrideSize(base: size, so: override)
  }
  ret middleCutText(
    font: textFont
    text: content
    sizePx: size * wt.scale.x
    width: worldRectOf(wt: wt, cr: cr).w
  )
}

# `text` with its middle replaced by "..." so that it is at most `width` wide, by whole characters,
# the same room at each end; itself when it fits
func middleCutText(
  font: view SdfFont
  text: view String
  sizePx: view Float
  width: view Float
) ret String {
  if SdfText.sdfMeasureText(font: font, text: text, sizePx: sizePx) <= width {
    ret "{text}"
  }
  let dots: String = "..."
  let room: Float = width - SdfText.sdfMeasureText(font: font, text: dots, sizePx: sizePx)
  var head: Int = 0
  var tail: Int = text.length()
  var headWidth: Float = 0.0
  var tailWidth: Float = 0.0
  loop head < tail {
    # the shorter end grows
    let atHead: Bool = headWidth <= tailWidth
    var start: Int = previousGrapheme(text: text, at: tail)
    var end: Int = tail
    if atHead {
      start = head
      end = nextGrapheme(text: text, at: head)
    }
    let grown: Float = SdfText.sdfMeasureText(
      font: font
      text: text.sub(start: start, len: end - start)
      sizePx: sizePx
    )
    if headWidth + tailWidth + grown > room {
      break
    }
    if atHead {
      head = end
      headWidth = headWidth + grown
    } else {
      tail = start
      tailWidth = tailWidth + grown
    }
  }
  ret "{text.sub(start: 0, len: head)}{dots}{text.sub(start: tail, len: text.length() - tail)}"
}

# A font's atlas carries a distance of half its distanceRange outside each glyph, at its bake size
# (px per em); drawn smaller, proportionally less. An outline (and a shadow's softness) past that
# fills the glyph's whole box, so the shader thins it to fit, and this says, once per style and
# font, which distanceRange the style needs: pxRange >= (2 x outline + softness) x bakeSize / the
# drawn em, in pixels, softness at least 1 (docs/ui-scene-format.md "Text outlines"). The
# distanceRange it needs, 0 when the font's is enough or the style has neither.
func textRangeNeeded(
  font: view SdfFont
  emPixels: view Float
  outlinePixels: view Float
  softnessPixels: view Float
) ret Float {
  let outline: Float = Math.max(a: outlinePixels, b: 0.0)
  let softness: Float = Math.max(a: softnessPixels, b: 1.0)
  if (outline <= 0.0 and softness <= 1.0) or font.bakeSize <= 0.0 or emPixels <= 0.0 {
    ret 0.0
  }
  # the shader's limit (gpu2d_text.wgsl): the range in drawn pixels holds 2 x outline + softness
  let needed: Float = (2.0 * outline + softness) * font.bakeSize / emPixels
  if font.pxRange >= needed {
    ret 0.0
  }
  ret needed
}

func warnTextRange(
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  styleId: view String
  emPixels: view Float
  outlinePixels: view Float
  softnessPixels: view Float
) {
  let needed: Float = textRangeNeeded(
    font: font
    emPixels: emPixels
    outlinePixels: outlinePixels
    softnessPixels: softnessPixels
  )
  if needed <= 0.0 {
    ret
  }
  let key: String = "{styleId}|{font.jsonPath}"
  loop let known: view String in canvas.textRangeWarnings {
    if known is key {
      ret
    }
  }
  canvas.textRangeWarnings.add(value: key)
  let rebake: Int = Math.ceil(x: needed).toInt()
  log(
    "[text] style '{styleId}' at {Math.round(x: emPixels)} px with a {outlinePixels} px outline and a softness of {softnessPixels} px needs an atlas distanceRange of {rebake} or more; the font {font.jsonPath} has {font.pxRange} (baked at {font.bakeSize} px per em): rebake it with -pxrange {rebake}; until then the outline is thinned to what the range carries"
  )
}
