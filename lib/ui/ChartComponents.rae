# ui/ChartComponents — chart widgets for large data (docs/perf-tools-design.md §6), general
# widgets that know nothing of where the data comes from. A chart node has two components: the
# authored one (its scene keys, saved with the scene) and its state (the app's data and what the
# view shows, never saved), which the chart's system creates and the app fills.

# A timeline: lanes of spans and marks against time (ui/timelineSystem). Each lane is as many
# rows as its spans' nesting depth needs, `rowHeight` each, with `laneGap` between lanes. The
# wheel over it zooms about the pointer, a drag pans, a click selects the span under the pointer
# and sends `actionId` (when set) as a UI action. Give the node a WheelTarget too, so the wheel
# comes to it.
type Timeline {
  rowHeight: Float = 16.0
  laneGap: Float = 4.0
  actionId: String = ""
}

# One span: from `start` to `end` (the app's time unit, nanoseconds for a capture), its name (an
# index into the state's `names`) and its nesting depth (its row in the lane)
type TimelineSpan {
  start: Int
  end: Int
  nameId: Int
  depth: Int
}

# Spans per block of the lane's index of block ends (timelineAddSpan keeps it)
const timelineBlockSpans: Int = 64

# A lane: its spans in order of their start, its marks (moments), its deepest row, the longest
# span (how far back a span that reaches into the view can start), and the latest end of each
# block of timelineBlockSpans spans (so the drawing can skip a block it knows ends too early)
type TimelineLane {
  name: String
  spans: List(TimelineSpan)
  marks: List(Int)
  rows: Int = 1
  maxDuration: Int = 0
  blockEnds: List(Int)
}

type TimelineState {
  # the time at the view's left and right edges
  viewStart: Int = 0
  viewEnd: Int = 1000000000
  lanes: List(TimelineLane)
  names: List(String)
  # the selected span (-1 none) and its lane
  selectedLane: Int = -1
  selectedSpan: Int = -1
  # a press on the timeline: where it began, the view then, and whether it moved (a pan, not a
  # click)
  dragging: Bool = false
  dragX: Float = 0.0
  dragViewStart: Int = 0
  dragViewEnd: Int = 0
  dragMoved: Bool = false
}

# A flame graph (ui/flameGraphSystem): a call tree's totals as nested bars, the focused node as
# wide as the chart on the top row, each child under its parent as wide as its share of the
# parent's total. A click on a bar zooms into it (it becomes the focus), a click on the focus
# zooms back out to its parent; either selects the bar and sends `actionId` (when set).
type FlameGraph {
  rowHeight: Float = 18.0
  actionId: String = ""
}

# One node of the tree: its parent (-1 for the root), its name (an index into the state's
# names), its total (the app's unit: time, samples, bytes), its depth, and its first child and
# next sibling (-1 none), in the order they were added
type FlameNode {
  parent: Int
  nameId: Int
  total: Int
  depth: Int
  firstChild: Int = -1
  lastChild: Int = -1
  nextSibling: Int = -1
}

type FlameGraphState {
  # node 0 is the root ("all"), made with the state
  nodes: List(FlameNode)
  names: List(String)
  focus: Int = 0
  selected: Int = -1
  pressed: Bool = false
}

# A histogram (ui/histogramSystem): buckets of values as bars, with a line at the `budget`
# (the app's unit; 0 for none) and lines at the 50th, 95th and 99.9th percentiles the buckets
# give. A click selects the bucket under it and sends `actionId` (when set).
type Histogram {
  budget: Float = 0.0
  barGap: Float = 1.0
  actionId: String = ""
}

# The buckets: bucket i counts the values from edges[i] to edges[i + 1]
type HistogramState {
  edges: List(Float)
  counts: List(Int)
  selected: Int = -1
  pressed: Bool = false
}

# A line graph (ui/lineGraphSystem): counters over time, a line per series. With `link` naming a
# Timeline node it shows that timeline's view (so the two zoom and pan together); without one the
# wheel zooms it about the pointer and a drag pans it. The values run from `minValue` to
# `maxValue`, or (both 0) from the lowest to the highest point in view. A click selects the point
# nearest the pointer and sends `actionId` (when set).
type LineGraph {
  link: String = ""
  minValue: Float = 0.0
  maxValue: Float = 0.0
  actionId: String = ""
}

# One series: its name, and its points in order of time
type LineSeries {
  name: String
  times: List(Int)
  values: List(Float)
}

type LineGraphState {
  viewStart: Int = 0
  viewEnd: Int = 1000000000
  series: List(LineSeries)
  selectedSeries: Int = -1
  selectedPoint: Int = -1
  dragging: Bool = false
  dragX: Float = 0.0
  dragViewStart: Int = 0
  dragViewEnd: Int = 0
  dragMoved: Bool = false
}

# A table (ui/statTableSystem): a header row of column titles over rows of cells. A click on a
# header sorts by that column (again: the other way), the wheel scrolls the rows, a click on a row
# selects it and sends `actionId` (when set).
type StatTable {
  rowHeight: Float = 22.0
  headerHeight: Float = 26.0
  actionId: String = ""
}

# A column: its title, its width, and whether it sorts by the rows' numbers (else by their text);
# a numeric column's cells are drawn to the right
type StatColumn {
  title: String
  width: Float
  numeric: Bool
}

# A row: a text per column, and a number per column for sorting a numeric column
type StatRow {
  texts: List(String)
  values: List(Float)
}

type StatTableState {
  columns: List(StatColumn)
  rows: List(StatRow)
  # the rows in the order shown (indexes into `rows`)
  order: List(Int)
  sortColumn: Int = -1
  descending: Bool = false
  # how far the rows are scrolled, in the table's units
  scroll: Float = 0.0
  # the selected row (an index into `rows`; -1 none)
  selected: Int = -1
  pressed: Bool = false
}
