# ScrollRootSystem — scrolling as DATA (docs/ecs-general-architecture.md).
#
# A scene authors `ScrollRoot` on the node that moves (ui/Components); this
# system owns everything that used to be hand-seeded per page:
#
#   * `scrollRootSystem` seeds the root's `ScrollState` on mount — the
#     position restored from a `ScrollMemory` resource by page id, so a page
#     re-mounted after a data change (or a hot-reload restart) lands where it
#     was — and keeps the memory current from the live positions.
#   * `findScrollRoot` (ui/Ecs) is the target query: the ScrollRoot on the
#     active page.
#   * `scrollRootRange` is the FLOOR, computed from the laid-out geometry:
#     how far the root's content extends past the window its parent shows,
#     minus the authored `endInset`. Nothing to scroll → inert.
#   * `updateScrollRoot` is the lib drag / wheel / momentum / spring physics
#     (iOS feel via ui/ScrollPhysics) for an app that does not carry its own
#     scroll state machine; it replaces the former ScrollPanel (#729). A press
#     becomes a drag only past 10 points along the axis; the drag then claims
#     the press (ScrollDrag.active, read by updateUiInput), so a drag over a
#     button scrolls and its release clicks nothing, while a tap still clicks.
#     The wheel (a trackpad) moves the content itself, never mid-press, at most
#     120 points past a bound; the spring and the momentum wait a few frames
#     after its last event so they do not fight a trackpad's own momentum, and
#     `scrollRootSettling` tells an event loop to keep rendering until all of
#     it is at rest. Distances are points, through the input's touch target.
#   * `ScrollRoot.anchor: end` (ui/ScrollAnchor): content that fits rests at
#     the window's end (`ScrollRange.rest`, a positive position), and a root
#     pinned to its end (`ScrollDrag.pinnedToEnd`) follows the floor as the
#     content grows; the physics are the same as at the start.
#
# The position is a `RuntimeOffset` on the root (`applyScrollPosition`): a
# transform-time translation of the subtree, never a relayout.
import Math
open Spring
open ui/Ecs
open ui/AnimationComponents
open ui/Components
open ui/inputSystem/InputSystem
open ui/Transform
open ui/ScrollPhysics
open ui/layoutSystem/LayoutSystem
open collections/StringMap
open ecs/Entity
open ecs/ComponentTable
open ecs/Hierarchy
open ui/UiSystems
open ui/ScrollDrag
open ui/InputKind
open ui/ListReorder
open ui/dialogSystem/DialogSystem
open ecs/Query

# Where each page's scroll position is when its root is not mounted: page
# id -> position along the axis. An app resource (on its session) that outlives
# world rebuilds; the hot-reload restore writes the restored page into it and
# `scrollRootSystem` keeps it current.
type ScrollMemory {
  positions: StringMap(Float)
}

func createScrollMemory() ret ScrollMemory {
  ret ScrollMemory { positions: StringMap.create(Float, cap: 8) }
}

func rememberScroll(memory: mod ScrollMemory, pageId: view String, position: view Float) {
  memory.positions.set(k: "{pageId}", value: position)
}

# Forget a page's position, so its next mount starts at the top — what a
# page entered afresh (its data rebuilt) wants.
func forgetScroll(memory: mod ScrollMemory, pageId: view String) {
  memory.positions.remove(k: pageId)
}

func recallScroll(memory: view ScrollMemory, pageId: view String) ret Float {
  if let position: Float = memory.positions.get(k: pageId) {
    ret position
  }
  ret 0.0
}

# The scroll bounds of one root this frame. `active` is false until the root
# is laid out or when its content fits — a root with nothing to scroll is
# inert, and an app's physics skips it. `floor` is the most-negative position
# (<= 0); `window` the visible length along the axis, the rubber-band's
# reference dimension; `rest` where a root whose content fits sits: 0 (its
# start) unless it is anchored at its end, then the room left over, so the
# content's end meets the window's end (less `endInset`).
type ScrollRange {
  active: Bool
  floor: Float
  window: Float
  rest: Float = 0.0
}

func axisLength(root: view ScrollRoot, size: view Vec2) ret Float {
  if root.axis is ScrollAxis.x {
    ret size.x
  }
  ret size.y
}

func axisFarEdge(root: view ScrollRoot, rect: view ComputedRect) ret Float {
  if root.axis is ScrollAxis.x {
    ret rect.position.x + rect.size.x
  }
  ret rect.position.y + rect.size.y
}

func axisPaddingEnd(root: view ScrollRoot, insets: view Insets) ret Float {
  if root.axis is ScrollAxis.x {
    ret insets.r
  }
  ret insets.b
}

func axisPaddingSum(root: view ScrollRoot, insets: view Insets) ret Float {
  if root.axis is ScrollAxis.x {
    ret insets.l + insets.r
  }
  ret insets.t + insets.b
}

# How far the root's content reaches from the root's start edge: the far edge
# of the children its layout placed (in the root's own coordinates, so a
# `Fill` body whose grid overflows it measures the grid, not the body) plus
# the root's end padding after the last child; the root's own length when it
# has no children. A VIRTUAL `ListView` host keeps only a window of rows live,
# so its content is the whole data list: rows × pitch (ui/listViewSystem
# places row i at i × pitch).
func scrollContentExtent(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  root: view ScrollRoot
) ret Float {
  let padEnd: Float = axisPaddingEnd(
    root: root
    insets: entityPadding(world: world, uiSystems: uiSystems, entityId: entityId)
  )
  var extent: Float = 0.0
  var measured: Bool = false
  if componentHas(this: world.listViews, entityId: entityId) and componentHas(
    this: world.listViewDatas
    entityId: entityId
  ) {
    # Views, not a copy: this runs every frame for every scrolling list, and a
    # copy (componentCopy) is a deep copy of the list's whole row data just to read
    # its length (#32786425 — it also leaked that copy until the compiler fix).
    let listView: view ListView = componentView(this: world.listViews, entityId: entityId)
    if listView.mode is ListViewMode.virtual {
      let count: Int = componentView(this: world.listViewDatas, entityId: entityId).rows.length
      if count > 0 {
        let pitch: Float = listView.itemHeight + listView.itemGap
        extent = count.toFloat() * pitch - listView.itemGap + padEnd
        measured = true
      }
    }
  }
  if componentHas(this: world.childrens, entityId: entityId) {
    let children: view Children = componentView(this: world.childrens, entityId: entityId)
    loop var i: Int = 0, i < children.ids.length, ++i {
      let child: EntityId = children.ids.copyAtFallback(index: i, fallback: noEntity())
      if componentHas(this: uiSystems.layout.computedRects, entityId: child) {
        let rect: view ComputedRect = componentView(
          this: uiSystems.layout.computedRects
          entityId: child
        )
        let far: Float = axisFarEdge(root: root, rect: rect) + padEnd
        if far > extent {
          extent = far
        }
        measured = true
      }
    }
  }
  if measured is false {
    let ownRect: view ComputedRect = componentView(
      this: uiSystems.layout.computedRects
      entityId: entityId
    )
    extent = axisLength(root: root, size: ownRect.size)
  }
  ret extent
}

# The length of the root the parent shows: the smaller of the root's own box
# and the parent's content box (a Hug content taller than its clipped
# viewport scrolls by the viewport's height; a Fill body by its own).
func scrollWindowLength(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  root: view ScrollRoot
) ret Float {
  let ownRect: view ComputedRect = componentView(
    this: uiSystems.layout.computedRects
    entityId: entityId
  )
  var window: Float = axisLength(root: root, size: ownRect.size)
  if componentHas(this: uiSystems.hierarchy.parents, entityId: entityId) {
    let parent: EntityId = componentView(this: uiSystems.hierarchy.parents, entityId: entityId).parent
    if componentHas(this: uiSystems.layout.computedRects, entityId: parent) {
      let parentRect: view ComputedRect = componentView(
        this: uiSystems.layout.computedRects
        entityId: parent
      )
      let parentBox: Float = axisLength(root: root, size: parentRect.size) - axisPaddingSum(
        root: root
        insets: entityPadding(world: world, uiSystems: uiSystems, entityId: parent)
      )
      if parentBox < window {
        window = parentBox
      }
    }
  }
  ret window
}

func scrollRootRange(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret ScrollRange {
  let inert: ScrollRange = { active: false, floor: 0.0, window: 1.0 }
  if isNone(this: entityId) {
    ret inert
  }
  if componentHas(this: world.scrollRoots, entityId: entityId) is false {
    ret inert
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false {
    ret inert
  }
  let root: view ScrollRoot = componentView(this: world.scrollRoots, entityId: entityId)
  let window: Float = scrollWindowLength(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    root: root
  )
  if root.floor is ScrollFloorMode.fixed {
    ret ScrollRange { active: root.fixedFloor < 0.0, floor: root.fixedFloor, window: window }
  }
  let extent: Float = scrollContentExtent(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    root: root
  )
  let overflow: Float = extent - (window - root.endInset)
  if overflow <= 0.0 {
    var rest: Float = 0.0
    if root.anchor is ScrollAnchor.end {
      rest = 0.0 - overflow
    }
    ret ScrollRange { active: false, floor: 0.0, window: window, rest: rest }
  }
  ret ScrollRange { active: true, floor: 0.0 - overflow, window: window }
}

# Apply a position: the RuntimeOffset along the root's axis (a transform-time
# translation) and the ScrollState it mirrors. Writes the offset only on a
# real change — a per-frame write to an unchanged offset keeps the render
# cache permanently dirty (#407).
func applyScrollPosition(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  root: view ScrollRoot
  position: view Float
) {
  var want: Vec2 = { x: 0.0, y: position }
  if root.axis is ScrollAxis.x {
    want = { x: position, y: 0.0 }
  }
  var changed: Bool = true
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId) {
    let current: Vec2 = componentView(
      this: uiSystems.transform2d.runtimeOffsets
      entityId: entityId
    ).delta
    changed = current.x is not want.x or current.y is not want.y
  }
  if changed {
    let offset: RuntimeOffset = { delta: want }
    componentSet(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId, data: offset)
  }
  if componentHas(this: world.scrollStates, entityId: entityId) {
    let state: mod ScrollState = componentMod(this: world.scrollStates, entityId: entityId)
    state.y = position
  }
}

# Reset every ScrollRoot on `pageId` to the top, in place (no re-mount): the
# ScrollState and the RuntimeOffset both go to 0. Used when a persistent page
# is repointed at fresh content — e.g. the album page showing a different
# album — so the new content starts at the top instead of the old scroll.
func resetScrollRootOnPage(world: mod UiWorld, uiSystems: mod UiSystems, pageId: view String) pub {
  let n: Int = componentCount(this: world.scrollRoots)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: world.scrollRoots, i: i)
    if pageOf(world: world, uiSystems: uiSystems, entityId: entityId) is pageId {
      let root: view ScrollRoot = componentView(this: world.scrollRoots, entityId: entityId)
      applyScrollPosition(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        root: root
        position: 0.0
      )
    }
    i = i + 1
  }
}

# Seed every ScrollRoot that has no ScrollState yet (a fresh mount) from the
# memory, applying the position as the root's RuntimeOffset; record every
# seeded root's live position back into the memory when it moved. Idempotent
# and cheap (a handful of roots) — run it after a mount and once per frame.
func scrollRootSystem(world: mod UiWorld, uiSystems: mod UiSystems, memory: mod ScrollMemory) {
  let n: Int = componentCount(this: world.scrollRoots)
  loop var i: Int = 0, i < n, ++i {
    let entityId: EntityId = componentEntityAt(this: world.scrollRoots, i: i)
    let pageId: String = pageOf(world: world, uiSystems: uiSystems, entityId: entityId)
    if componentHas(this: world.scrollStates, entityId: entityId) is false {
      let position: Float = recallScroll(memory: memory, pageId: pageId)
      let seeded: ScrollState = { y: position, velocity: 0.0 }
      componentSet(this: world.scrollStates, entityId: entityId, data: seeded)
      let root: view ScrollRoot = componentView(this: world.scrollRoots, entityId: entityId)
      # An end-anchored root mounted afresh opens at its end; one with a
      # remembered position goes back there
      if root.anchor is ScrollAnchor.end and memory.positions.get(k: pageId) is none {
        let pinned: ScrollDrag = {
          dragging: false
          lastPointer: 0.0
          d0: 0.0
          d1: 0.0
          d2: 0.0
          pinnedToEnd: true
        }
        componentSet(this: world.scrollDrags, entityId: entityId, data: pinned)
      }
      applyScrollPosition(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        root: root
        position: position
      )
    } else {
      let state: view ScrollState = componentView(this: world.scrollStates, entityId: entityId)
      if state.y is not recallScroll(memory: memory, pageId: pageId) {
        rememberScroll(memory: memory, pageId: pageId, position: state.y)
      }
    }
  }
}

# ----- the lib physics (former ScrollPanel, #729) ---------------------------

# Wheel notches are small integers; this turns one into a useful jump without
# making a trackpad flick fly past the whole panel. In points, like the two
# below: the UI's units per point come from the input's touch target size.
const scrollWheelStepPoints: Float = 48.0

# How far the wheel may stretch the content past a bound. The rubber band
# still gives a little at a large overshoot, and a trackpad's momentum can
# deliver hundreds of events: without a cap they add up to a huge stretch
# and a long spring back.
const scrollWheelOvershootPoints: Float = 120.0

# Seconds after the last wheel event before the spring and the momentum run: a trackpad keeps
# sending
# its own momentum events after the fingers lift, and the spring must not fight them
const scrollWheelQuietSeconds: Float = 0.0499

# Seconds after the last wheel event that still count as settling, so an event loop keeps rendering
# until the wheel has gone quiet
const scrollWheelSettleSeconds: Float = 0.2499

# A long frame slows scrolling and never skips it, as for any motion
const scrollMaxStepSeconds: Float = 0.05

# Momentum fling decay while inside the bounds, a long smooth glide: 0.97 of the speed each 1/60 s
const momentumDecayPerSecond: Float = 1.8276

# Below these, momentum and spring are settled and snapped to rest: 1 point, and 18 points a second,
# are just under human perception, so it cuts the asymptotic tail with no visible jump
const scrollVelEps: Float = 18.0

const scrollPosEps: Float = 1.0

func scrollAbs(value: view Float) ret Float {
  if value < 0.0 {
    ret 0.0 - value
  }
  ret value
}

# Is the pointer over the root's window? The window is the parent's box when
# the root has one (the clipped viewport around a Hug content), else the root's
# own. POSITION comes from WorldTransform2D, SIZE from ComputedRect —
# ComputedRect is PARENT-LOCAL, so a panel nested three deep reports x=12
# while sitting at x=952 on screen.
func pointerOverScrollRoot(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  var window: EntityId = entityId
  if componentHas(this: uiSystems.hierarchy.parents, entityId: entityId) {
    let parent: EntityId = componentView(this: uiSystems.hierarchy.parents, entityId: entityId).parent
    if componentHas(this: uiSystems.layout.computedRects, entityId: parent) and componentHas(
      this: uiSystems.transform2d.worldTransforms
      entityId: parent
    ) {
      window = parent
    }
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: window) is false {
    ret false
  }
  if componentHas(this: uiSystems.transform2d.worldTransforms, entityId: window) is false {
    ret false
  }
  let r: view ComputedRect = componentView(this: uiSystems.layout.computedRects, entityId: window)
  let wt: view WorldTransform2D = componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: window
  )
  let placed: WorldRect = worldRectOf(wt: wt, cr: r)
  if x < placed.x or x > placed.x + placed.w {
    ret false
  }
  if y < placed.y or y > placed.y + placed.h {
    ret false
  }
  ret true
}

func pointerAlongAxis(root: view ScrollRoot, input: view UiInput) ret Float {
  if root.axis is ScrollAxis.x {
    ret input.pointer.x
  }
  ret input.pointer.y
}

# One frame of scroll on `entityId`. Returns true when the position moved, so a
# caller can repaint only on frames that scrolled (including every momentum /
# spring frame). Inert (false) when the root is not laid out or its content
# fits. The whole state is read into locals, stepped, and written back — no
# mod-borrow is held across the read-only geometry queries.
# Does a lifted row of a reorderable list (ui/ListReorder) hold the press in
# the scroll root `scrollRoot`?
func listReorderHolds(world: view UiWorld, scrollRoot: view EntityId) ret Bool {
  loop var i: Int = 0, i < componentCount(this: world.listReorderDrags), ++i {
    let drag: view ListReorderDrag = queryViewAt(table: world.listReorderDrags, denseIndex: i)
    if drag.phase is ListReorderPhase.lifted and drag.scrollRoot.index is scrollRoot.index and drag.scrollRoot.generation is scrollRoot.generation {
      ret true
    }
  }
  ret false
}

# An end-anchored root's hold on its end, after this frame's step: a drag or
# the wheel lets go of it; a root that holds it and is at rest (no drag, no
# fling, the wheel quiet) moves to the floor, which follows the content as
# rows are added; one that comes to rest at the floor holds it again.
func pinToEnd(
  drag: mod ScrollDrag
  state: mod ScrollState
  floor: view Float
  wheel: view Float
) {
  if drag.active or wheel is not 0.0 {
    drag.pinnedToEnd = false
    ret
  }
  let resting: Bool = drag.dragging is false and state.velocity is 0.0 and drag.wheelIdleSeconds >= scrollWheelQuietSeconds
  if resting is false {
    ret
  }
  if drag.pinnedToEnd {
    state.y = floor
  } else if scrollAbs(value: state.y - floor) < scrollPosEps {
    drag.pinnedToEnd = true
  }
}

func updateScrollRoot(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  input: view UiInput
  deltaTime: view Float
) ret Bool {
  let step: Float = Math.max(a: 0.0, b: Math.min(a: deltaTime, b: scrollMaxStepSeconds))
  if isNone(this: entityId) {
    ret false
  }
  if componentHas(this: world.scrollRoots, entityId: entityId) is false {
    ret false
  }
  let root: view ScrollRoot = componentView(this: world.scrollRoots, entityId: entityId)
  # Real COPIES, by design (see above): the state and the drag are stepped in
  # locals and written back whole at the end, so no reference into these tables
  # is held across applyScrollPosition, which writes them.
  var state: ScrollState = { y: 0.0, velocity: 0.0 }
  if let stored: ScrollState = componentCopy(this: world.scrollStates, entityId: entityId) {
    state = stored
  }
  var drag: ScrollDrag = {
    dragging: false
    lastPointer: 0.0
    d0: 0.0
    d1: 0.0
    d2: 0.0
  }
  if let storedDrag: ScrollDrag = componentCopy(this: world.scrollDrags, entityId: entityId) {
    drag = storedDrag
  }
  let before: Float = state.y
  # A row lifted out of a list in this root (ui/listReorderSystem) has the
  # press: the content does not follow the finger, and the press stays
  # claimed (`active`), so its release clicks nothing
  # Under a presented page (a dialog's scrim, a page over this one): the
  # finger is not this root's
  if presentedPageBlocks(world: world, uiSystems: uiSystems, entityId: entityId) {
    drag.dragging = false
    drag.active = false
    componentSet(this: world.scrollDrags, entityId: entityId, data: drag)
    ret false
  }
  # A swipe from the screen's edge (ui/pageTransitionSystem/EdgeSwipe) has it in the same way
  if listReorderHolds(world: world, scrollRoot: entityId) or world.edgeSwipe.phase is EdgeSwipePhase.active {
    drag.dragging = false
    drag.active = true
    state.velocity = 0.0
    componentSet(this: world.scrollDrags, entityId: entityId, data: drag)
    if componentHas(this: world.scrollStates, entityId: entityId) {
      let still: mod ScrollState = componentMod(this: world.scrollStates, entityId: entityId)
      still.velocity = 0.0
    }
    ret false
  }
  let range: ScrollRange = scrollRootRange(world: world, uiSystems: uiSystems, entityId: entityId)

  if range.active is false {
    # Content fits. Reset rather than leaving a stale position behind: a panel
    # that shrinks while scrolled would otherwise keep a gap at the top. It
    # rests at its start, or at its end when anchored there (and its end is
    # then in view, so it holds it as the content grows).
    drag.dragging = false
    if root.anchor is ScrollAnchor.end {
      drag.pinnedToEnd = true
    }
    componentSet(this: world.scrollDrags, entityId: entityId, data: drag)
    if before is not range.rest {
      applyScrollPosition(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        root: root
        position: range.rest
      )
      let rest: mod ScrollState = componentMod(this: world.scrollStates, entityId: entityId)
      rest.velocity = 0.0
    }
    ret before is not range.rest
  }

  let floor: Float = range.floor
  let dim: Float = range.window
  let inside: Bool = pointerOverScrollRoot(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    x: input.pointer.x
    y: input.pointer.y
  )
  let pointer: Float = pointerAlongAxis(root: root, input: input)

  # ----- press / activation / release -----
  # A press is tracked from the frame it lands; it becomes a drag only once
  # the pointer has moved `scrollActivationPoints` along the axis (iOS's pan
  # threshold), so a tap with a little tremor stays a tap and clicks. An
  # active drag claims the press (`active`, read by updateUiInput), so its
  # release clicks nothing under the finger.
  if input.pointer.pressed and inside {
    drag.dragging = true
    drag.active = false
    drag.pressPointer = pointer
    drag.lastPointer = pointer
    state.velocity = 0.0
    drag.d0 = 0.0
    drag.d1 = 0.0
    drag.d2 = 0.0
  }
  if drag.dragging and drag.active is false and input.pointer.down {
    if scrollAbs(value: pointer - drag.pressPointer) > scrollActivationUnits(input: input) {
      drag.active = true
      # the content starts to follow from here, without a jump
      drag.lastPointer = pointer
    }
  }
  if input.pointer.released or input.pointer.down is false {
    if drag.active {
      # Hand the finger's lift velocity to the momentum fling.
      state.velocity = pickReleaseVelocity(d0: drag.d0, d1: drag.d1, d2: drag.d2)
    }
    drag.dragging = false
    drag.active = false
  }

  # ----- wheel (only when updateUiInput routed it here, never mid-press) -----
  var wheel: Float = uiWheelFor(input: input, entityId: entityId)
  if input.pointer.down {
    wheel = 0.0
  }
  if drag.wheelIdleSeconds < 1000.0 {
    drag.wheelIdleSeconds = drag.wheelIdleSeconds + step
  }
  if wheel is not 0.0 {
    let unitsPerPoint: Float = input.touchTargetSize / touchTargetPoints
    let raw: Float = wheel * scrollWheelStepPoints * unitsPerPoint
    state.y = state.y + dampedDelta(
      current: state.y
      delta: raw
      low: floor
      high: 0.0
      dim: dim
    )
    let overshoot: Float = scrollWheelOvershootPoints * unitsPerPoint
    if state.y < floor - overshoot {
      state.y = floor - overshoot
    }
    if state.y > overshoot {
      state.y = overshoot
    }
    # the wheel moves the content itself; the spring and the momentum wait
    # until it is quiet
    state.velocity = 0.0
    drag.wheelIdleSeconds = 0.0
  }

  if drag.active {
    # ----- drag: content follows the finger 1:1, rubber-banded near a bound -----
    let rawDelta: Float = pointer - drag.lastPointer
    drag.lastPointer = pointer
    let damped: Float = dampedDelta(
      current: state.y
      delta: rawDelta
      low: floor
      high: 0.0
      dim: dim
    )
    state.y = state.y + damped
    # Keep the last three damped deltas; release velocity is picked from them.
    drag.d2 = drag.d1
    drag.d1 = drag.d0
    drag.d0 = 0.0
    if step > 0.0 {
      drag.d0 = damped / step
    }
  } else if drag.wheelIdleSeconds >= scrollWheelQuietSeconds {
    # ----- momentum + rubber-band spring (not dragging, the wheel quiet) -----
    if state.y > 0.0 or state.y < floor {
      var target: Float = 0.0
      if state.y < floor {
        target = floor
      }
      var spring: SpringState = { value: state.y, velocity: state.velocity }
      springStep(
        state: spring
        target: target
        response: scrollSpringResponse
        damping: scrollSpringDamping
        deltaTime: step
      )
      state.y = spring.value
      state.velocity = spring.velocity
      if scrollAbs(value: state.y - target) < scrollPosEps and scrollAbs(value: state.velocity) < scrollVelEps {
        state.y = target
        state.velocity = 0.0
      }
    } else {
      # In bounds: momentum fling, decaying under friction.
      if scrollAbs(value: state.velocity) > scrollVelEps {
        state.y = state.y + state.velocity * step
        state.velocity = state.velocity * Math.exp(x: -momentumDecayPerSecond * step)
      } else {
        state.velocity = 0.0
      }
    }
  }

  if root.anchor is ScrollAnchor.end {
    pinToEnd(
      drag: drag
      state: state
      floor: floor
      wheel: wheel
    )
  }
  componentSet(this: world.scrollDrags, entityId: entityId, data: drag)
  componentSet(this: world.scrollStates, entityId: entityId, data: state)
  if state.y is not before {
    applyScrollPosition(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      root: root
      position: state.y
    )
  }
  ret before is not state.y
}

# The root's scroll position along its axis (0 for none)
func scrollPositionOf(world: view UiWorld, entityId: view EntityId) ret Float {
  if isNone(this: entityId) or componentHas(this: world.scrollStates, entityId: entityId) is false {
    ret 0.0
  }
  ret componentView(this: world.scrollStates, entityId: entityId).y
}

# Whether the root is still moving or may move without new input: a press
# is tracked, a fling or a spring is running, or the wheel was used in the
# last few frames. An event loop keeps rendering frames while it is true
# (the spring waits for the wheel to go quiet, which takes frames).
func scrollRootSettling(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  if isNone(this: entityId) or componentHas(this: world.scrollStates, entityId: entityId) is false {
    ret false
  }
  let state: view ScrollState = componentView(this: world.scrollStates, entityId: entityId)
  if state.velocity is not 0.0 {
    ret true
  }
  let range: ScrollRange = scrollRootRange(world: world, uiSystems: uiSystems, entityId: entityId)
  if range.active and (state.y > 0.0 or state.y < range.floor) {
    ret true
  }
  # a root whose content fits rests at its start (or its end when anchored there)
  if range.active is false and state.y is not range.rest {
    ret true
  }
  if componentHas(this: world.scrollDrags, entityId: entityId) {
    let drag: view ScrollDrag = componentView(this: world.scrollDrags, entityId: entityId)
    # an end-anchored root that holds its end and is not there yet (it was
    # mounted before its first layout, or rows were added) moves next frame
    if drag.pinnedToEnd and range.active and state.y is not range.floor {
      ret true
    }
    ret drag.dragging or drag.wheelIdleSeconds < scrollWheelSettleSeconds
  }
  ret false
}

# Whether a press on the root is being tracked (a drag, or a press that may
# still become one), so a caller can suppress its own pointer handling — a
# drag that started on the panel should not also orbit the camera.
func scrollRootDragging(world: view UiWorld, entityId: view EntityId) ret Bool {
  if isNone(this: entityId) {
    ret false
  }
  if componentHas(this: world.scrollDrags, entityId: entityId) is false {
    ret false
  }
  ret componentView(this: world.scrollDrags, entityId: entityId).dragging
}
