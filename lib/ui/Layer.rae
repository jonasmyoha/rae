# Layer / paint-order helpers. Pure ECS queries against `LayerRoot`,
# `LayerRef`, `Parent`, and `WorldTransform2D` — no raylib calls — so
# `ui/input` can use `collectPaintableRoots` for hit-testing without
# pulling in `ui/render`'s raylib externs (which would break tests
# that import only `ui/input` under a non-raylib live VM).
import ui/Ecs
import ui/Components
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ui/UiSystems

# The layer dialogs and popovers go on (ui/dialogSystem, app3d/ModeMenu's menu):
# over the page content, the dock and the back button, under the debug layer
const layerDialogId: String = "dialog"

const layerDialogOrder: Int = 300

# Layer-root entity factory. Creates a parentless entity with a
# `LayerRoot { id, order }` component — no Rect / Layout / Sprite,
# just the label that `setLayerById` / `renderSystem` look up. Apps
# call this once per named layer at boot, stash the returned ids in
# whatever structure they like, and from then on tag overlay roots
# with `setLayerById(world, entityId, id)`.
func createLayerEntity(world: mod UiWorld, id: own String, order: view Int) pub ret EntityId {
  let e: EntityId = createEntity(world: world)
  let lr: LayerRoot = { id: own id, order: order }
  componentSet(this: world.layerRoots, entityId: e, data: own lr)
  ret e
}

# Set up the standard layer stack apps usually want:
#   content (0)  ─ page content (default for roots without LayerRef)
#   dock (100)   ─ persistent bottom toolbar
#   back-button (200) ─ top-left back chevron overlay
#   dialog (300) ─ modal popovers
#   debug (400)  ─ debug button + menu, always on top
# Apps that want a different stack can skip this and call
# `createLayerEntity` per their own scheme.
func createStandardLayers(world: mod UiWorld) pub {
  let contentId: String = "content"
  let dockId: String = "dock"
  let backId: String = "back-button"
  let dialogId: String = "dialog"
  let debugId: String = "debug"
  let content: EntityId = createLayerEntity(world: world, id: contentId, order: 0)
  let dock: EntityId = createLayerEntity(world: world, id: dockId, order: 100)
  let back: EntityId = createLayerEntity(world: world, id: backId, order: 200)
  let dialog: EntityId = createLayerEntity(world: world, id: dialogId, order: 300)
  let debug: EntityId = createLayerEntity(world: world, id: debugId, order: 400)
}

# Find the layer-root entity with the given id. O(n) over the layer
# roots component table — n is the count of named layers (5-ish in
# practice), so the cost is negligible compared to a per-frame walk
# of the whole alive list.
func findLayerEntity(world: view UiWorld, id: view String) pub ret EntityId {
  let n: Int = componentCount(this: world.layerRoots)
  var i: Int = 0
  loop i < n {
    let e: EntityId = componentEntityAt(this: world.layerRoots, i: i)
    let lr: view LayerRoot = queryViewAt(table: world.layerRoots, denseIndex: i)
    if lr.id is id {
      ret e
    }
    i = i + 1
  }
  ret noEntity()
}

# Stamp a `LayerRef` linking `entityId` to the layer-root with `id`.
# No-op when the layer doesn't exist — the entity stays on the
# default content plane.
func setLayerById(world: mod UiWorld, entityId: view EntityId, id: view String) pub {
  let layer: EntityId = findLayerEntity(world: world, id: id)
  if isNone(this: layer) {
    ret
  }
  let ref: LayerRef = { layer: layer }
  componentSet(this: world.layerRefs, entityId: entityId, data: ref)
}

# Read the paint-order of the layer an entity belongs to. Falls back
# to the content layer's order (or 0 when no content layer exists).
func entityLayerOrder(world: view UiWorld, entityId: view EntityId) pub ret Int {
  if componentHas(this: world.layerRefs, entityId: entityId) {
    let ref: view LayerRef = componentView(this: world.layerRefs, entityId: entityId)
    if componentHas(this: world.layerRoots, entityId: ref.layer) {
      let lr: view LayerRoot = componentView(this: world.layerRoots, entityId: ref.layer)
      ret lr.order
    }
  }
  let contentId: String = "content"
  let content: EntityId = findLayerEntity(world: world, id: contentId)
  if isNone(this: content) is false {
    let lr: view LayerRoot = componentView(this: world.layerRoots, entityId: content)
    ret lr.order
  }
  ret 0
}

# A raised node: one inside a scene (it has a parent) with a LayerRef of its
# own, such as a menu or a popover that must show over every other root (the
# game's HUD scenes mounted after the scene that holds it). It is laid out and
# placed under its parent as before, but painted and hit-tested with its
# layer's roots (collectPaintableRoots), not inside its parent's subtree
# (renderSystem and the hit test skip it there). Its parent's clip does not
# cut it. Raise one with `raiseNodeToLayer`.
func isRaisedNode(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) pub ret Bool {
  ret componentHas(this: world.layerRefs, entityId: entityId) and componentHas(
    this: uiSystems.hierarchy.parents
    entityId: entityId
  )
}

# Is a raised node shown? Painted and hit alone, it takes its ancestors'
# visibility from the transform pass (an inactive ancestor hides it)
func raisedNodeShown(uiSystems: view UiSystems, entityId: view EntityId) pub ret Bool {
  if componentHas(this: uiSystems.transform2d.worldVisuals, entityId: entityId) is false {
    ret true
  }
  ret componentView(this: uiSystems.transform2d.worldVisuals, entityId: entityId).visible
}

# Put the node `entityId` (inside a scene) on the layer `layerId`, made with
# `order` if the app has none: it paints over every root of a lower layer, and
# takes taps first. A no-op when it is there already.
func raiseNodeToLayer(
  world: mod UiWorld
  entityId: view EntityId
  layerId: view String
  order: view Int
) pub {
  if isNone(this: entityId) {
    ret
  }
  var layer: EntityId = findLayerEntity(world: world, id: layerId)
  if isNone(this: layer) {
    layer = createLayerEntity(world: world, id: "{layerId}", order: order)
  }
  if componentHas(this: world.layerRefs, entityId: entityId) and componentView(
    this: world.layerRefs
    entityId: entityId
  ).layer is layer {
    ret
  }
  componentSet(this: world.layerRefs, entityId: entityId, data: LayerRef { layer: layer })
}

# Collect every parentless root with a WorldTransform2D, and every raised node
# (isRaisedNode), in ascending Layer order. Used by both `renderSystem`
# (painter's algorithm) and the input hit-test (which walks the result in
# reverse).
func collectPaintableRoots(world: view UiWorld, uiSystems: view UiSystems) pub ret List(EntityId) {
  unsafe {
    var roots: List(EntityId) = List.create(EntityId, cap: 16)
    let alive: view List(EntityId) = world.allocator.alive
    let n: Int = alive.length
    var i: Int = 0
    loop i < n {
      let e: EntityId = rae_ext_rae_buf_get(buf: alive.data, index: i)
      if componentHas(this: uiSystems.hierarchy.parents, entityId: e) is false {
        if componentHas(this: uiSystems.transform2d.worldTransforms, entityId: e) {
          roots.add(value: e)
        }
      }
      i = i + 1
    }
    loop var r: Int = 0, r < componentCount(this: world.layerRefs), ++r {
      let raised: EntityId = componentEntityAt(this: world.layerRefs, i: r)
      if isRaisedNode(world: world, uiSystems: uiSystems, entityId: raised) and componentHas(
        this: uiSystems.transform2d.worldTransforms
        entityId: raised
      ) {
        roots.add(value: raised)
      }
    }
    let m: Int = roots.length
    var outer: Int = 0
    loop outer < m {
      var minIdx: Int = outer
      let outerE: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: outer)
      var minOrd: Int = entityLayerOrder(world: world, entityId: outerE)
      var inner: Int = outer + 1
      loop inner < m {
        let innerE: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: inner)
        let ord: Int = entityLayerOrder(world: world, entityId: innerE)
        if ord < minOrd {
          minIdx = inner
          minOrd = ord
        }
        inner = inner + 1
      }
      if minIdx is not outer {
        let a: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: outer)
        let b: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: minIdx)
        rae_ext_rae_buf_set(buf: roots.data, index: outer, value: b)
        rae_ext_rae_buf_set(buf: roots.data, index: minIdx, value: a)
      }
      outer = outer + 1
    }
    ret roots
  }
}
