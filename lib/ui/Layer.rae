# ui/Layer — a node's layer is its LayerTag (docs/ui-layers-design.md §4.2, §6). A node names the
# layer it paints and takes input in by `LayerTag { id, z }`, authored in a .raescene
# ("LayerTag": { "id": "dialog" }) or set by code (setLayerById); the window's LayerStack
# (ui/UiLayers) resolves the name. A root with no tag is in hud. A node inside a scene with a tag
# that names a layer is raised: laid out and placed by its parent, painted and hit with its
# layer's roots. A tag below a LayerScope stays in its scope. Pure ECS queries, no drawing, so
# ui/InputSystem can use them.
import ui/Ecs
import ui/Components
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ui/UiSystems

# The layer dialogs and popovers go on (ui/dialogSystem, app3d/ModeMenu's menu)
const layerDialogId: String = "dialog"

# Put `entityId` (a root, or a node inside a scene, which is then raised) on the layer named `id`,
# keeping its z: its LayerTag's id. A name the window's stack has not is painted in hud.
func setLayerById(world: mod UiWorld, entityId: view EntityId, id: view String) {
  if isNone(this: entityId) {
    ret
  }
  if componentHas(this: world.layerTags, entityId: entityId) {
    if componentView(this: world.layerTags, entityId: entityId).id is not id {
      componentMod(this: world.layerTags, entityId: entityId).id = "{id}"
    }
    ret
  }
  componentSet(this: world.layerTags, entityId: entityId, data: LayerTag { id: "{id}", z: 0 })
}

# Raise the node `entityId` (inside a scene) to the layer `layerId`: setLayerById
func raiseNodeToLayer(world: mod UiWorld, entityId: view EntityId, layerId: view String) {
  setLayerById(world: world, entityId: entityId, id: layerId)
}

# Does `entityId` have a LayerTag that names a layer (not only a z)?
func tagNamesLayer(world: view UiWorld, entityId: view EntityId) ret Bool {
  ret componentHas(this: world.layerTags, entityId: entityId) and componentView(
    this: world.layerTags
    entityId: entityId
  ).id.length() > 0
}

# A raised node: one inside a scene (it has a parent) whose LayerTag names a layer, and not below a
# LayerScope (a scope keeps its tags). It is laid out and placed under its parent, but painted and
# hit-tested with its layer's roots, not inside its parent's subtree (the paint and the hit test
# skip it there). Its parent's clip does not cut it.
func isRaisedNode(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  ret tagNamesLayer(world: world, entityId: entityId) and componentHas(
    this: uiSystems.hierarchy.parents
    entityId: entityId
  ) and not insideLayerScope(world: world, uiSystems: uiSystems, entityId: entityId)
}

# Is a raised node shown? Painted and hit alone, it takes its ancestors'
# visibility from the transform pass (an inactive ancestor hides it)
func raisedNodeShown(uiSystems: view UiSystems, entityId: view EntityId) ret Bool {
  if componentHas(this: uiSystems.transform2d.worldVisuals, entityId: entityId) is false {
    ret true
  }
  ret componentView(this: uiSystems.transform2d.worldVisuals, entityId: entityId).visible
}

# The standard stack's order for a layer name (ui/UiLayers layerOrder*, here so a LayerScope can
# sort its tags without a stack): hud (200) for a name of the program's own
func tagLayerOrderOf(name: view String) ret Int {
  if name is "world" {
    ret 100
  }
  if name is "hudOver" {
    ret 300
  }
  if name is "dock" {
    ret 400
  }
  if name is "popover" {
    ret 500
  }
  if name is "toast" {
    ret 600
  }
  if name is "dialog" {
    ret 700
  }
  if name is "cover" {
    ret 750
  }
  if name is "notification" {
    ret 800
  }
  if name is "log" {
    ret 850
  }
  if name is "debug" {
    ret 900
  }
  ret 200
}

# Is `entityId` below a LayerScope node (its own LayerScope does not count)?
func insideLayerScope(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  if componentCount(this: world.layerScopes) is 0 {
    ret false
  }
  var at: EntityId = entityId
  loop var depth: Int = 0, depth < 256, ++depth {
    if not componentHas(this: uiSystems.hierarchy.parents, entityId: at) {
      ret false
    }
    at = componentView(this: uiSystems.hierarchy.parents, entityId: at).parent
    if componentHas(this: world.layerScopes, entityId: at) {
      ret true
    }
  }
  ret false
}

# A node a LayerScope paints after the rest of its subtree: one with a LayerTag naming a layer,
# below a LayerScope
func isScopedTagged(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  if componentCount(this: world.layerScopes) is 0 or not componentHas(
    this: world.layerTags
    entityId: entityId
  ) {
    ret false
  }
  ret componentView(this: world.layerTags, entityId: entityId).id.length() > 0 and insideLayerScope(
    world: world
    uiSystems: uiSystems
    entityId: entityId
  )
}

# The scope's place for a tagged node: its layer's order (tagLayerOrderOf), then z
func scopedOrderBefore(world: view UiWorld, a: view EntityId, b: view EntityId) ret Bool {
  let tagA: view LayerTag = componentView(this: world.layerTags, entityId: a)
  let tagB: view LayerTag = componentView(this: world.layerTags, entityId: b)
  let orderA: Int = tagLayerOrderOf(name: tagA.id)
  let orderB: Int = tagLayerOrderOf(name: tagB.id)
  if orderA is not orderB {
    ret orderA < orderB
  }
  ret tagA.z < tagB.z
}

func collectScopedTagged(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  out: mod List(EntityId)
) {
  if not componentHas(this: world.childrens, entityId: entityId) {
    ret
  }
  let children: view Children = componentView(this: world.childrens, entityId: entityId)
  loop let child: view EntityId in children.ids {
    if componentHas(this: world.layerTags, entityId: child) and componentView(
      this: world.layerTags
      entityId: child
    ).id.length() > 0 {
      # in paint order: by layer, then z, keeping tree order for ties
      var at: Int = out.length
      loop at > 0 and scopedOrderBefore(
        world: world
        a: child
        b: out.copyAtFallback(index: at - 1, fallback: child)
      ) {
        at = at - 1
      }
      out.insert(index: at, value: child)
    }
    # a nested scope keeps its own
    if not componentHas(this: world.layerScopes, entityId: child) {
      collectScopedTagged(
        world: world
        uiSystems: uiSystems
        entityId: child
        out: out
      )
    }
  }
}

# The LayerScope node `scope`'s tagged nodes in paint order (bottom first)
func scopedTaggedNodes(
  world: view UiWorld
  uiSystems: view UiSystems
  scope: view EntityId
) ret List(EntityId) {
  var out: List(EntityId) = {}
  collectScopedTagged(
    world: world
    uiSystems: uiSystems
    entityId: scope
    out: out
  )
  ret out
}

# Does the root take input: shown, and not leaving (a dialog animating out after its close takes
# no press and holds none)
func sceneRootTakesInput(
  world: view UiWorld
  uiSystems: view UiSystems
  root: view EntityId
) ret Bool {
  ret sceneRootShown(world: world, uiSystems: uiSystems, root: root) and not componentHas(
    this: world.leavings
    entityId: root
  )
}

# Does the root (or raised node) show anything a press could land on or a cover could hide
# under? A raised node of a hidden scene does not, and neither does a root that is inactive or
# hidden: a mounted but hidden page keeps its layer from blocking input
func sceneRootShown(world: view UiWorld, uiSystems: view UiSystems, root: view EntityId) ret Bool {
  if isRaisedNode(world: world, uiSystems: uiSystems, entityId: root) and raisedNodeShown(
    uiSystems: uiSystems
    entityId: root
  ) is false {
    ret false
  }
  if componentHas(this: world.actives, entityId: root) and componentView(
    this: world.actives
    entityId: root
  ).value is false {
    ret false
  }
  if componentHas(this: uiSystems.transform2d.worldVisuals, entityId: root) {
    ret componentView(this: uiSystems.transform2d.worldVisuals, entityId: root).visible
  }
  ret true
}
