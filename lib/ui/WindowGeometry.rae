# Remember where the user put the window, across restarts.
#
# OPT IN, in three lines. An app that does not write them does not have this:
#
#     var windowGeometry: WindowGeometry = createWindowGeometry(
#       dir: dir(), name: "window.{myAppId}.geometry")
#     restoreWindowGeometry(windowGeometry: windowGeometry)          # after initWindow
#     ...
#     updateWindowGeometry(windowGeometry: windowGeometry, now: now, resized: Gpu2d.windowResized())
#
# This used to live in the runtime, in C, and applied to every app whether or
# not its author asked for it: the C chose the file path, decided when to write,
# and restored the window before any Rae code ran. Two things wrong with that.
# It is app behavior, so it belongs in Rae. And it was invisible — you could
# not read an app and see that it had the feature, nor leave it out.
#
# What stays in C is only what C can do: notice the SDL events. `windowMoved`
# and `windowResized` are one-shot flags in the same shape as the rest of the
# gpu2d input surface, and everything below is built on them.
import Sys
import Gpu2d
import Target
open Filesystem

# Whole-file read. `Sys.readFile` returns `opt String`, and the C backend has a
# known bug comparing those against `none`; lib/hot_reload and lib/sky_hosek
# declare the same raw extern for the same reason.
func rae_ext_rae_sys_read_file(path: String) unsafe extern ret String

# A move fires an event per frame of the drag, and the value that matters is the
# one it ends on. Waiting for the drag to settle turns a drag into one write
# rather than sixty.
const windowGeometrySettleSeconds: Float = 0.25

# After fullscreen the OS takes a moment to give the window back its size (on macOS about 0.8 s of
# animation): until this long after, what it has is not the window's own.
const windowGeometryBackSeconds: Float = 1.5

type WindowGeometry {
  # Split so the directory can be created before writing into it, without this
  # module having to pick apart a path string.
  dir: String
  path: String
  # Set by an SDL move/resize event, cleared once written.
  dirty: Bool
  dirtyAt: Float64
  # What was last written, so an event that did not actually change anything —
  # SDL sends a resize when the window is merely shown — writes nothing.
  lastX: Int
  lastY: Int
  lastW: Int
  lastH: Int
  # The window is fullscreen, whoever made it so; and since when it is not any more
  fullscreen: Bool = false
  leftFullscreenAt: Float64 = -1000.0
  # Where the window was when last at rest and not fullscreen
  home: WindowPlace = {}
}

# A window's place and size in points (0 wide: not known)
type WindowPlace {
  x: Int = 0
  y: Int = 0
  w: Int = 0
  h: Int = 0
}

# UNITS MATTER HERE, and getting them wrong is not obvious from a screenshot.
# Gpu2d.windowWidth/Height are the DRAWABLE size in physical pixels, while
# setWindowSize takes LOGICAL points — so on a 2x display, saving the physical
# size and restoring it as logical doubles the window on every launch. It went
# 900x640 -> 1800x1280 -> 3600x2560 across three runs before this converted.
func windowPlaceNow() ret WindowPlace {
  var scale: Float = Gpu2d.dpr()
  if scale <= 0.0 {
    scale = 1.0
  }
  ret WindowPlace {
    x: Gpu2d.windowPositionX()
    y: Gpu2d.windowPositionY()
    w: (Gpu2d.windowWidth().toFloat() / scale).toInt()
    h: (Gpu2d.windowHeight().toFloat() / scale).toInt()
  }
}

# Just out of fullscreen: is the window to be moved home? Once it has its own size again. (Out by
# the OS's own control, the green button or its key, SDL on macOS gave it back at the bottom of the
# screen.)
func windowPlaceAway(home: view WindowPlace, now: view WindowPlace) ret Bool {
  ret home.w > 0 and home.w is now.w and home.h is now.h and (home.x is not now.x or home.y is not now.y)
}

# `dir` is the app's choice, and that is the point: an app wanting one window
# per project passes its hot-reload channel directory, an installed app passes
# somewhere in the user's config. Nothing here guesses.
#
# PUT THE APP'S IDENTITY IN `name`. `dir()` answers ".rae" for every
# app unless RAE_HOT_RELOAD_DIR overrides it, so two apps passing the same name
# share one file and therefore one window. That is not hypothetical: the
# examples all passed "window.geometry", and the 3D ones opened at 599x1259
# because they restored the phone-shaped mobile UI example's window. Nothing
# errored -- each app faithfully applied a size another app had saved.
func createWindowGeometry(dir: view String, name: view String) ret WindowGeometry {
  ret WindowGeometry {
    dir: "{dir}"
    path: "{dir}/{name}"
    dirty: false
    dirtyAt: 0.0
    lastX: -1
    lastY: -1
    lastW: -1
    lastH: -1
  }
}

# Apply the saved geometry, if there is any. Returns true when it applied
# something, so a caller can tell "restored" from "first run" — an app that
# wants to center itself on first launch needs to know which happened.
#
# CALL AFTER initWindow. There is no window to place before that.
func restoreWindowGeometry(windowGeometry: mod WindowGeometry) ret Bool {
  unsafe {
    # Declaration-only marking for now: this module is coupled to the Gpu2d
    # renderer externs (window position/size/dpr), whose unsafe migration lands
    # with the GPU consumers (#876). Opting this file in here would require
    # wrapping those renderer calls too, so the raw read stays unwrapped until
    # then. The extern is still marked `unsafe extern`.
    let raw: String = rae_ext_rae_sys_read_file(path: windowGeometry.path)
    if raw.length() < 1 {
      ret false
    }
    let parts: List(String) = raw.trim().split(sep: " ")
    if parts.length < 4 {
      ret false
    }
    let x: Int = parts.copyAtDefault(index: 0).trim().toInt()
    let y: Int = parts.copyAtDefault(index: 1).trim().toInt()
    let w: Int = parts.copyAtDefault(index: 2).trim().toInt()
    let h: Int = parts.copyAtDefault(index: 3).trim().toInt()
    # A zero or negative size is a corrupt or truncated line. Changing nothing is
    # the right answer: a bad file must not be able to strand the window at 0x0 or
    # off-screen, where the user cannot get at it to fix it.
    if w <= 0 or h <= 0 {
      ret false
    }
    Gpu2d.setWindowSize(w: w, h: h)
    Gpu2d.setWindowPosition(x: x, y: y)
    windowGeometry.lastX = x
    windowGeometry.lastY = y
    windowGeometry.lastW = w
    windowGeometry.lastH = h
    ret true
  }
}

# Apply only the saved POSITION, keeping the size the app opened at. For an
# app whose window shape is part of its design (a phone-shaped UI opens
# phone-shaped every time; the user can still resize it while it runs).
func restoreWindowPosition(windowGeometry: mod WindowGeometry) ret Bool {
  unsafe {
    let raw: String = rae_ext_rae_sys_read_file(path: windowGeometry.path)
    if raw.length() < 1 {
      ret false
    }
    let parts: List(String) = raw.trim().split(sep: " ")
    if parts.length < 4 {
      ret false
    }
    let x: Int = parts.copyAtDefault(index: 0).trim().toInt()
    let y: Int = parts.copyAtDefault(index: 1).trim().toInt()
    Gpu2d.setWindowPosition(x: x, y: y)
    windowGeometry.lastX = x
    windowGeometry.lastY = y
    ret true
  }
}

func writeWindowGeometry(windowGeometry: mod WindowGeometry) {
  let place: WindowPlace = windowPlaceNow()
  let x: Int = place.x
  let y: Int = place.y
  let w: Int = place.w
  let h: Int = place.h
  # Only a desktop has windows to move: on a phone a turn is a resize too, and its working folder
  # may be read-only
  if w <= 0 or h <= 0 or not Target.isDesktopOs {
    ret
  }
  if x is windowGeometry.lastX and y is windowGeometry.lastY and w is windowGeometry.lastW and h is windowGeometry.lastH {
    ret
  }
  makeDir(path: windowGeometry.dir)
  if Sys.writeFile(path: windowGeometry.path, content: "{x} {y} {w} {h}\n") {
    windowGeometry.lastX = x
    windowGeometry.lastY = y
    windowGeometry.lastW = w
    windowGeometry.lastH = h
  }
}

# How long until the window is itself again after fullscreen (s; 0 or less: it is)
func windowGeometryBack(windowGeometry: view WindowGeometry, now: view Float64) ret Float {
  ret windowGeometryBackSeconds - (now - windowGeometry.leftFullscreenAt) as Float
}

# How long a pending write still waits (s): for the drag to settle, and for a window that was
# fullscreen to be itself again
func windowGeometryWaitSeconds(windowGeometry: view WindowGeometry, now: view Float64) ret Float {
  let settle: Float = windowGeometrySettleSeconds - (now - windowGeometry.dirtyAt) as Float
  let back: Float = windowGeometryBack(windowGeometry: windowGeometry, now: now)
  if back > settle {
    ret back
  }
  ret settle
}

# Once per frame. Consumes this frame's move/resize events and writes when the
# drag has settled.
#
# EVENT-DRIVEN, NOT POLLED. It asks the OS for the window position only on a
# frame where SDL actually reported a move or a resize; the rest of the time it
# is one boolean test. These apps are built to idle at ~0% CPU
# (docs/ui-render-loop-performance.md), and a feature that fires when a human
# drags a window has no business waking anything.
# `resized` is PASSED IN, not read here. Gpu2d.windowResized() is one-shot —
# reading it clears it — and the apps already read it to rebuild their layout.
# A module that consumed it behind their back would make adding this feature
# silently break resize handling, which is a rotten trade for one argument.
func updateWindowGeometry(
  windowGeometry: mod WindowGeometry
  now: view Float64
  resized: view Bool
) {
  # (windowMoved is cleared as it is read: read in fullscreen too, so the move into it is not a
  # later move)
  let moved: Bool = Gpu2d.windowMoved()
  if Gpu2d.isWindowFullscreen() {
    windowGeometry.fullscreen = true
    windowGeometry.dirty = false
    ret
  }
  if windowGeometry.fullscreen {
    windowGeometry.fullscreen = false
    windowGeometry.leftFullscreenAt = now
  }
  if windowGeometryBack(windowGeometry: windowGeometry, now: now) > 0.0 {
    let place: WindowPlace = windowPlaceNow()
    if windowPlaceAway(home: windowGeometry.home, now: place) {
      Gpu2d.setWindowPosition(x: windowGeometry.home.x, y: windowGeometry.home.y)
    }
  } else if windowGeometry.home.w is 0 {
    windowGeometry.home = windowPlaceNow()
  }
  if moved or resized {
    windowGeometry.dirty = true
    windowGeometry.dirtyAt = now
  }
  if windowGeometry.dirty is false {
    ret
  }
  if windowGeometryWaitSeconds(windowGeometry: windowGeometry, now: now) > 0.0 {
    ret
  }
  windowGeometry.dirty = false
  windowGeometry.home = windowPlaceNow()
  writeWindowGeometry(windowGeometry: windowGeometry)
}

# Seconds until a pending write is due, for the loop's wait deadline
# (EventLoop.nextWaitTimeoutSeconds `heartbeatSeconds`): a drag that ends while the
# app sits idle is still written, without a periodic wake to notice the
# settle. 0 when nothing is pending.
func windowGeometryDeadlineSeconds(
  windowGeometry: view WindowGeometry
  now: view Float64
) ret Float {
  if windowGeometry.dirty is false {
    ret 0.0
  }
  let remaining: Float = windowGeometryWaitSeconds(windowGeometry: windowGeometry, now: now)
  if remaining < 0.001 {
    ret 0.001
  }
  ret remaining
}

# For an app that would rather write on its own schedule — on quit, say — than
# let the settle timer do it. Nothing while the window is fullscreen.
func flushWindowGeometry(windowGeometry: mod WindowGeometry) {
  if windowGeometry.dirty is false or Gpu2d.isWindowFullscreen() {
    ret
  }
  windowGeometry.dirty = false
  writeWindowGeometry(windowGeometry: windowGeometry)
}
