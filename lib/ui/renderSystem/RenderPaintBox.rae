# RenderPaintBox — the geometry helpers the gpu2d painter shares (#1000, split
# out of RenderSystem.rae at the 1000-line cap): the box an entity paints into
# (WorldTransform2D scale + hover scale about the TransformFx pivot), the soft
# drop shadow for `Shadow.blur`, and the `MaskShape` clip.
open ui/Ecs
import Gpu2d
import ui/Components
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open ui/UiSystems
open ui/buttonSystem/ButtonHoverFade

func g2dColor(color: view RgbaColor) ret Int {
  ret (color.a shl 24) bitor (color.r shl 16) bitor (color.g shl 8) bitor color.b
}

# Sprite scale mode -> the gpu2d draw call's mode code.
func g2dScaleMode(m: view ScaleMode) ret Int {
  if m is ScaleMode.fill {
    ret 1
  }
  if m is ScaleMode.stretch {
    ret 2
  }
  ret 0
}

# A colour with the subtree's accumulated alpha (0..255) applied.
func g2dChain(color: view RgbaColor, chain255: view Int) ret RgbaColor {
  let a: Int = (color.a * chain255) / 255
  ret RgbaColor { r: color.r, g: color.g, b: color.b, a: a }
}

func g2dRadius(world: view UiWorld, entityId: view EntityId, fallback: view Float) ret Float {
  if componentHas(this: world.cornerRadiuses, entityId: entityId) {
    let cr: CornerRadius = componentGet(this: world.cornerRadiuses, entityId: entityId)
    ret cr.radius
  }
  ret fallback
}

func g2dHoverMul(world: view UiWorld, entityId: view EntityId) ret Float {
  if componentHas(this: world.hoverScales, entityId: entityId) {
    let hs: HoverScale = componentGet(this: world.hoverScales, entityId: entityId)
    ret hs.current
  }
  ret 1.0
}

# The box an entity paints into (#1000): its computed size scaled by the
# accumulated WorldTransform2D scale (TransformFx.scaleX/Y down the tree) and
# the hover multiplier, placed about the entity's own TransformFx pivot
# (centre when it has none — the hover scale's convention). Rotation is
# carried by the transform but not drawn: gpu2d has no rotated quads yet.
type PaintBox {
  x: Float
  y: Float
  w: Float
  h: Float
  scale: Float
}

func g2dPaintBox(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
) ret PaintBox {
  let hoverMul: Float = g2dHoverMul(world: world, entityId: entityId)
  let scaleX: Float = wt.scale.x * hoverMul
  let scaleY: Float = wt.scale.y * hoverMul
  var pivotX: Float = 0.5
  var pivotY: Float = 0.5
  # The entity's OWN scale (its TransformFx, times hover) grows the box about
  # its pivot; the scale it INHERITS from ancestors (an editor camera, a scaled
  # parent) has already placed its origin, so it only sizes the box. Using
  # the total scale for the pivot offset made every child of a scaled parent
  # drift by (1 - scale) * pivot of its size.
  var ownX: Float = hoverMul
  var ownY: Float = hoverMul
  if componentHas(this: world.transforms, entityId: entityId) {
    let fx: TransformFx = componentGet(this: world.transforms, entityId: entityId)
    pivotX = fx.pivot.x
    pivotY = fx.pivot.y
    ownX = fx.scaleX * hoverMul
    ownY = fx.scaleY * hoverMul
  }
  var inheritedX: Float = 1.0
  var inheritedY: Float = 1.0
  if ownX is not 0.0 {
    inheritedX = scaleX / ownX
  }
  if ownY is not 0.0 {
    inheritedY = scaleY / ownY
  }
  let w: Float = cr.size.x * scaleX
  let h: Float = cr.size.y * scaleY
  var uniform: Float = scaleX
  if scaleY < uniform {
    uniform = scaleY
  }
  ret PaintBox {
    x: wt.position.x + cr.size.x * inheritedX * (1.0 - ownX) * pivotX
    y: wt.position.y + cr.size.y * inheritedY * (1.0 - ownY) * pivotY
    w: w
    h: h
    scale: uniform
  }
}

# A bounded stack of translucent shapes approximates a soft shadow in Rae.
# Three layers at opacity 1 preserve the original appearance; authored scenes
# can opt into a finer falloff. Alpha is normalized by layer count.
func paintShadowG(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  box: view PaintBox
  radius: view Float
  chain255: view Int
  canvas: mod Gpu2dCanvas
) {
  let shadow: Shadow = componentGet(this: world.shadows, entityId: entityId)
  if shadow.blur <= 0.0 {
    ret
  }
  # Rest and hovered opacity, mixed by the hover fade (ui/buttonSystem).
  var restOpacity: Float = shadow.opacity
  var hoverOpacity: Float = shadow.opacity
  if shadow.hoverOnly {
    restOpacity = 0.0
  } else if shadow.hoverOpacity > 0.0 {
    hoverOpacity = shadow.hoverOpacity
  }
  var opacity: Float = restOpacity
  if restOpacity is not hoverOpacity {
    let hover: Float = hoverFadeAmount(world: world, uiSystems: uiSystems, entityId: entityId)
    opacity = restOpacity + (hoverOpacity - restOpacity) * hover
  }
  if opacity <= 0.0 {
    ret
  }
  var layers: Int = shadow.layers
  if layers < 1 {
    layers = 1
  }
  if layers > 16 {
    layers = 16
  }
  if opacity < 0.0 {
    opacity = 0.0
  }
  if opacity > 1.0 {
    opacity = 1.0
  }
  var color: RgbaColor = { r: 0, g: 0, b: 0, a: 255 }
  if shadow.hasColor {
    color = shadow.color
  }
  let step: Float = shadow.blur / layers.toFloat()
  var offset: Float = shadow.blur / 3.0
  if shadow.centered {
    offset = 0.0
  }
  loop var layer: Int = 0, layer < layers, ++layer {
    let grow: Float = step * (layer + 1).toFloat()
    let falloff: Float = (70.0 - layer.toFloat() * 66.0 / layers.toFloat()) * 3.0 / layers.toFloat()
    let alpha: Int = (falloff * opacity).toInt() * chain255 / 255 * color.a / 255
    Gpu2d.drawRoundedRect(
      canvas: canvas
      x: box.x - grow
      y: box.y - grow + offset
      w: box.w + grow * 2.0
      h: box.h + grow * 2.0
      radius: radius + grow
      color: g2dColor(color: RgbaColor { r: color.r, g: color.g, b: color.b, a: alpha })
    )
  }
}

# The mask's box: the entity's own, or the named source node's (resolved in
# the entity's page). Returns whether a clip was pushed.
func pushMaskClipG(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  canvas: mod Gpu2dCanvas
) ret Bool {
  let mask: MaskShape = componentGet(this: world.maskShapes, entityId: entityId)
  var source: EntityId = entityId
  if mask.sourceNodeId.length() > 0 {
    let page: String = pageOf(world: world, uiSystems: uiSystems, entityId: entityId)
    if let index: Int = findNodeInPage(world: world, pageId: page, nodeId: mask.sourceNodeId) {
      source = nodeEntity(world: world, index: index)
    }
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: source) is false or componentHas(
    this: uiSystems.transform2d.worldTransforms
    entityId: source
  ) is false {
    ret false
  }
  let cr: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entityId: source)
  let wt: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entityId: source
  )
  var x: Float = wt.position.x
  var y: Float = wt.position.y
  var w: Float = cr.size.x * wt.scale.x
  var h: Float = cr.size.y * wt.scale.y
  var radius: Float = mask.radius * wt.scale.x
  if mask.kind is MaskKind.circle {
    var diameter: Float = w
    if h < diameter {
      diameter = h
    }
    x = x + (w - diameter) / 2.0
    y = y + (h - diameter) / 2.0
    w = diameter
    h = diameter
    radius = diameter / 2.0
  }
  Gpu2d.pushClipRoundedRect(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
  )
  ret true
}

# One edge of a dashed outline: segments of `dash` then `gap` along the edge,
# starting at its beginning; a partial last segment is clipped to the edge.
# `horizontal` runs along x at (x, y) for `length`, else along y.
func paintDashedEdge(
  canvas: mod Gpu2dCanvas
  x: view Float
  y: view Float
  length: view Float
  width: view Float
  horizontal: view Bool
  dash: view Float
  gap: view Float
  color: view Int
) {
  var at: Float = 0.0
  var guard: Int = 0
  loop at < length and guard < 4096 {
    var segment: Float = dash
    if at + segment > length {
      segment = length - at
    }
    if horizontal {
      Gpu2d.drawRect(
        canvas: canvas
        x: x + at
        y: y
        w: segment
        h: width
        color: color
      )
    } else {
      Gpu2d.drawRect(
        canvas: canvas
        x: x
        y: y + at
        w: width
        h: segment
        color: color
      )
    }
    at = at + dash + gap
    guard = guard + 1
  }
}

# The four edges of a dashed box, the stroke inside the box like drawBox's
# border: top and bottom run full width, left and right fill the remaining
# height between them.
func paintDashedEdges(
  canvas: mod Gpu2dCanvas
  x: view Float
  y: view Float
  w: view Float
  h: view Float
  width: view Float
  dash: view Float
  gap: view Float
  color: view Int
) {
  var step: Float = gap
  if step < 0.0 {
    step = 0.0
  }
  paintDashedEdge(
    canvas: canvas
    x: x
    y: y
    length: w
    width: width
    horizontal: true
    dash: dash
    gap: step
    color: color
  )
  paintDashedEdge(
    canvas: canvas
    x: x
    y: y + h - width
    length: w
    width: width
    horizontal: true
    dash: dash
    gap: step
    color: color
  )
  let sideLength: Float = h - width * 2.0
  if sideLength > 0.0 {
    paintDashedEdge(
      canvas: canvas
      x: x
      y: y + width
      length: sideLength
      width: width
      horizontal: false
      dash: dash
      gap: step
      color: color
    )
    paintDashedEdge(
      canvas: canvas
      x: x + w - width
      y: y + width
      length: sideLength
      width: width
      horizontal: false
      dash: dash
      gap: step
      color: color
    )
  }
}
