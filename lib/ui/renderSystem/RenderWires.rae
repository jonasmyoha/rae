# RenderWires — a Wires node's wires (ui/WireComponents, ui/wireSystem): each one curve in the box
# shader's curve mode (Gpu2dCanvasCurve), so all of them are instances of the frame's one box draw.
# A wire whose four points (and width) miss the screen is left out.
import Math
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open Gpu2dCanvasCurve
open ui/Components
open ui/Ecs
open ui/Theme
open ui/UiSystems
open ui/WireComponents
open ui/renderSystem/RenderCull
open ui/renderSystem/RenderPaintBox
open ui/wireSystem/WireSystem

func paintWiresG(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  chain255: view Int
  canvas: mod Gpu2dCanvas
) {
  if not componentHas(this: world.wireDatas, entityId: entityId) {
    ret
  }
  let style: view Wires = componentView(this: world.wireSets, entityId: entityId)
  let space: WireSpace = wireSpace(uiSystems: uiSystems, wiresEntityId: entityId)
  let themeColor: Int = g2dColor(
    color: g2dChain(color: uiThemeColor(theme: world.theme, name: style.color), chain255: chain255)
  )
  let viewW: Float = paintViewWidth()
  let viewH: Float = paintViewHeight()
  let wires: view List(Wire) = componentView(this: world.wireDatas, entityId: entityId).wires
  loop let wire: view Wire in wires {
    let curve: WireCurve = wireCurveOf(
      uiSystems: uiSystems
      space: space
      style: style
      wire: wire
    )
    let pad: Float = curve.width
    let left: Float = Math.min(
      a: Math.min(a: curve.x0, b: curve.x1)
      b: Math.min(a: curve.x2, b: curve.x3)
    )
    let right: Float = Math.max(
      a: Math.max(a: curve.x0, b: curve.x1)
      b: Math.max(a: curve.x2, b: curve.x3)
    )
    let top: Float = Math.min(
      a: Math.min(a: curve.y0, b: curve.y1)
      b: Math.min(a: curve.y2, b: curve.y3)
    )
    let bottom: Float = Math.max(
      a: Math.max(a: curve.y0, b: curve.y1)
      b: Math.max(a: curve.y2, b: curve.y3)
    )
    if curve.ok and right + pad >= 0.0 and left - pad <= viewW and bottom + pad >= 0.0 and top - pad <= viewH {
      var color: Int = themeColor
      if wire.color is not 0 {
        color = g2dColor(
          color: g2dChain(
            color: RgbaColor {
              r: (wire.color shr 16) bitand 255
              g: (wire.color shr 8) bitand 255
              b: wire.color bitand 255
              a: (wire.color shr 24) bitand 255
            }
            chain255: chain255
          )
        )
      }
      canvasDrawCurve(
        canvas: canvas
        x0: curve.x0
        y0: curve.y0
        x1: curve.x1
        y1: curve.y1
        x2: curve.x2
        y2: curve.y2
        x3: curve.x3
        y3: curve.y3
        width: curve.width
        color: color
      )
    }
  }
}
