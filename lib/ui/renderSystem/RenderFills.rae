# RenderFills — the gradient and backdrop painters split from RenderSystem
# (the file cap): GradientFill through the gpu2d box shader's gradient mode,
# BackdropImage as the tinted, clipped image behind a node.
open ui/Ecs
open ui/UiSystems
open ui/renderSystem/RenderPaintBox
import Gpu2d
import ui/Components
import ui/Theme
import ui/ThemeResolved
open ecs/ComponentTable
open Gpu2dCanvas

# GradientFill uses the gpu2d box shader's gradient mode so dock shadows and
# dialog scrims stay in the same painter-order pipeline as normal shapes.
func paintGradientG(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  canvas: mod Gpu2dCanvas
) {
  let gf: view GradientFill = componentView(this: world.gradientFills, entityId: entityId)
  let box: PaintBox = g2dPaintBox(
    world: world
    entityId: entityId
    wt: wt
    cr: cr
  )
  # the corners of the node's Shape (or its CornerRadius), already scaled
  let fillRadius: Float = g2dFillRadius(world: world, entityId: entityId, box: box)
  let drawW: Float = box.w
  let drawH: Float = box.h
  let drawX: Float = box.x
  let drawY: Float = box.y
  var fromBase: RgbaColor = gf.from
  if gf.fromSlot.length() > 0 {
    fromBase = uiThemeColor(theme: world.theme, name: gf.fromSlot)
  }
  var toBase: RgbaColor = gf.to
  if gf.toSlot.length() > 0 {
    toBase = uiThemeColor(theme: world.theme, name: gf.toSlot)
  }
  let from: RgbaColor = g2dChain(color: fromBase, chain255: chain255)
  let to: RgbaColor = g2dChain(color: toBase, chain255: chain255)
  if componentHas(this: world.shadows, entityId: entityId) {
    paintShadowG(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      box: box
      radius: fillRadius
      chain255: chain255
      canvas: canvas
    )
  }
  Gpu2d.drawGradientRect(
    canvas: canvas
    x: drawX
    y: drawY
    w: drawW
    h: drawH
    radius: fillRadius
    from: g2dColor(color: from)
    to: g2dColor(color: to)
    angleDeg: gf.angle
  )
  # The fill first, then the node's Shape stroke over it: a gradient button
  # keeps its edge.
  paintShapeStrokeG(
    world: world
    entityId: entityId
    box: box
    radius: fillRadius
    chain255: chain255
    canvas: canvas
  )
}

# Only the stroke of a node's Shape (no fill), at `radius`: what a GradientFill
# paints after itself. Nothing when the node has no Shape or no stroke.
func paintShapeStrokeG(
  world: view UiWorld
  entityId: view EntityId
  box: view PaintBox
  radius: view Float
  chain255: view Int
  canvas: mod Gpu2dCanvas
) {
  if not componentHas(this: world.shapes, entityId: entityId) {
    ret
  }
  let shape: view Shape = componentView(this: world.shapes, entityId: entityId)
  if shape.strokeWidth <= 0.0 {
    ret
  }
  let stroke: RgbaColor = shapeStroke(world: world, shape: shape, chain255: chain255)
  if shape.strokeDash > 0.0 and shape.kind is not ShapeKind.circle {
    paintDashedEdges(
      canvas: canvas
      x: box.x
      y: box.y
      w: box.w
      h: box.h
      width: shape.strokeWidth
      dash: shape.strokeDash
      gap: shape.strokeGap
      color: g2dColor(color: stroke)
    )
    ret
  }
  # the gradient's own box, so the edge lies on the fill
  Gpu2d.drawBox(
    canvas: canvas
    x: box.x
    y: box.y
    w: box.w
    h: box.h
    radius: radius
    fill: 0
    borderWidth: shape.strokeWidth
    border: g2dColor(color: stroke)
  )
}

func paintBackdropG(
  world: view UiWorld
  entityId: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
  canvas: mod Gpu2dCanvas
) {
  let bi: view BackdropImage = componentView(this: world.backdropImages, entityId: entityId)
  let radius: Float = g2dRadius(world: world, entityId: entityId, fallback: 0.0)
  let box: PaintBox = g2dPaintBox(
    world: world
    entityId: entityId
    wt: wt
    cr: cr
  )
  let hoverMul: Float = box.scale
  let drawW: Float = box.w
  let drawH: Float = box.h
  let drawX: Float = box.x
  let drawY: Float = box.y
  if Gpu2d.hasImageKey(canvas: canvas, key: bi.textureKey) {
    let white: RgbaColor = { r: 255, g: 255, b: 255, a: 255 }
    let tint: RgbaColor = g2dChain(color: white, chain255: chain255)
    Gpu2d.drawImageKey(
      canvas: canvas
      key: bi.textureKey
      x: drawX
      y: drawY
      w: drawW
      h: drawH
      radius: radius * hoverMul
      tint: g2dColor(color: tint)
    )
    ret
  }
  # Raylib uses captured blur textures for BackdropImage. gpu2d does not have
  # framebuffer capture yet, so paint a stable translucent glass fallback.
  let fallback: RgbaColor = { r: 18, g: 22, b: 30, a: 210 }
  let chained: RgbaColor = g2dChain(color: fallback, chain255: chain255)
  Gpu2d.drawRoundedRect(
    canvas: canvas
    x: drawX
    y: drawY
    w: drawW
    h: drawH
    radius: radius * hoverMul
    color: g2dColor(color: chained)
  )
}
