# lib/ui — Pipeline: the UI systems on a lib/ecs Schedule with DECLARED
# read/write tables (#939).
#
# createUiPipeline registers every lib/ui system as a Schedule entry in its
# canonical run order, each with the UiWorld tables it reads and writes,
# resolved from the field names by reflection (tableIdByName). The per-frame
# runner then asks `uiShouldRun(schedule, world, index)` before calling a
# system — the schedule computes the read generation from the declaration, no
# caller-supplied generation. Rae has no first-class function references, so the
# app still CALLS the systems; the schedule owns the order, the declarations and
# the dirty state.
#
# Dirty-skip semantics are unchanged from the hand-written wrappers: only
# layoutSystem and transformSystem skip when clean (their entries declare EXACTLY
# the tables LayoutCache / TransformCache tracked, deliberate exclusions
# included — see the notes on each), and both also re-run when the live entity
# count moves. Every other system runs every frame; its sets are declaration,
# for a future parallel stager (docs/parallelism-first-plan.md Phase 2).
#
# The entry indices are the constants below; createUiPipeline registers in that
# exact order and the fixture asserts it.
import Sys
open ecs/Entity
open ecs/ComponentTable
open ecs/Schedule
open ui/Ecs
open ui/UiSystems

const uiSystemInput: Int = 0

const uiSystemWidgetStyle: Int = 1

const uiSystemSafeArea: Int = 2

const uiSystemLayout: Int = 3

const uiSystemFit: Int = 4

# #11920833: a Camera2D on a root becomes its TransformFx + RuntimeOffset.
const uiSystemCamera: Int = 5

const uiSystemTransform: Int = 6

const uiSystemHoverScale: Int = 7

# #1005: the effect systems (lib/ui/animationSystem/EffectSystems.rae), in
# the order the app calls them, after hoverScale and before visualBounds.
const uiSystemAnimFrames: Int = 8

const uiSystemAnimTrigger: Int = 9

const uiSystemWobbleFx: Int = 10

const uiSystemBackgroundPan: Int = 11

const uiSystemSmokeFx: Int = 12

const uiSystemCarousel: Int = 13

const uiSystemVisualBounds: Int = 14

const uiSystemRender: Int = 15

const uiSystemCount: Int = 16

# Resolve UiWorld table FIELD names to table ids. A name that is not a
# ComponentTable field of UiWorld is a registration bug in this file, so it is
# loud and fatal — never a silently-untracked read.
func uiTableIds(world: view UiWorld, names: view List(String)) ret List(Int) {
  var ids: List(Int) = List.create(Int, cap: 24)
  loop let name: view String in names {
    let id: Int = tableIdByName(UiWorld, world: world, name: name)
    if id < 0 {
      log("error: ui pipeline declares unknown UiWorld table '{name}'")
      Sys.exit(code: 1)
    }
    ids.add(value: id)
  }
  ret ids
}

func uiRegister(
  schedule: mod Schedule
  world: view UiWorld
  name: view String
  reads: view List(String)
  writes: view List(String)
  skipWhenClean: view Bool
) {
  addDeclaredSystem(
    schedule: schedule
    name: name
    reads: uiTableIds(world: world, names: reads)
    writes: uiTableIds(world: world, names: writes)
    skipWhenClean: skipWhenClean
  )
}

# Build the UI schedule: every lib/ui system, canonical order, declared sets.
func createUiPipeline(world: view UiWorld) ret Schedule {
  var schedule: Schedule = createSchedule()

  # updateUiInput — pointer hit-test against last frame's transforms.
  uiRegister(
    schedule: schedule
    world: world
    name: "input"
    reads: [
      "actives"
      "childrens"
      "interactions"
      "layerRoots"
      "onClicks"
      "worldTransforms"
    ]
    writes: ["interactions"]
    skipWhenClean: false
  )

  # widgetStyleSystem — widget state -> style tables; before layout because it
  # writes offsets, which layout reads.
  uiRegister(
    schedule: schedule
    world: world
    name: "widgetStyle"
    reads: [
      "offsets"
      "opacities"
      "shapes"
      "sprites"
      "stateStyles"
      "texts"
      "widgetStates"
    ]
    writes: [
      "offsets"
      "opacities"
      "shapes"
      "sprites"
      "texts"
    ]
    skipWhenClean: false
  )

  # safeAreaSystem — viewport insets into safeInsets, which layout reads.
  uiRegister(
    schedule: schedule
    world: world
    name: "safeArea"
    reads: ["safeAreas"]
    writes: List.create(String, cap: 0)
    skipWhenClean: false
  )

  # layoutSystem — the set LayoutCache tracked. Deliberately NOT declared as
  # reads (as before): the outputs measuredSizes/computedRects (tracking them
  # would re-dirty the entry on its own first run), and extentAnchors /
  # safeAreas / safeInsets, which are set at build and ride the rebuild that
  # already dirties rects.
  uiRegister(
    schedule: schedule
    world: world
    name: "layout"
    reads: [
      "rects"
      "sizes"
      "layouts"
      "paddings"
      "offsets"
      "constraints"
      "actives"
      "aligns"
      "childrens"
    ]
    writes: List.create(String, cap: 0)
    skipWhenClean: true
  )

  # fitSystem — scale-to-fit / aspect adjustments over computedRects.
  uiRegister(
    schedule: schedule
    world: world
    name: "fit"
    reads: [
      "aspects"
      "childrens"
      "paddings"
      "rects"
      "scaleToFits"
    ]
    writes: List.create(String, cap: 0)
    skipWhenClean: false
  )

  # cameraSystem — a root's Camera2D into its TransformFx + RuntimeOffset,
  # right before transform folds them (compare-before-write, so a still
  # camera leaves both tables' generations alone).
  uiRegister(
    schedule: schedule
    world: world
    name: "camera"
    reads: ["cameras", "transforms", "runtimeOffsets"]
    writes: ["transforms", "runtimeOffsets"]
    skipWhenClean: true
  )

  # transformSystem — the set TransformCache tracked. Its outputs
  # (localTransforms, worldTransforms, worldVisuals) are not reads, as before.
  uiRegister(
    schedule: schedule
    world: world
    name: "transform"
    reads: [
      "actives"
      "opacities"
      "transforms"
      "childrens"
      "runtimeOffsets"
    ]
    writes: ["localTransforms", "worldTransforms", "worldVisuals"]
    skipWhenClean: true
  )

  # hoverScaleSystem — hover animation state, read by render.
  uiRegister(
    schedule: schedule
    world: world
    name: "hoverScale"
    reads: ["childrens", "hoverScales"]
    writes: ["hoverScales"]
    skipWhenClean: false
  )

  # The effect systems (#1005): each always runs while its table has rows;
  # their outputs are the runtime channels the transform pass folds in.
  uiRegister(
    schedule: schedule
    world: world
    name: "animFrames"
    reads: ["animFrames", "animStates", "sprites"]
    writes: ["animStates", "sprites"]
    skipWhenClean: false
  )
  uiRegister(
    schedule: schedule
    world: world
    name: "animTrigger"
    reads: [
      "animTriggers"
      "animFrames"
      "animStates"
      "interactions"
      "sprites"
    ]
    writes: ["animStates", "sprites"]
    skipWhenClean: false
  )
  uiRegister(
    schedule: schedule
    world: world
    name: "wobbleFx"
    reads: ["wobbleFxs"]
    writes: ["runtimeOffsets"]
    skipWhenClean: false
  )
  uiRegister(
    schedule: schedule
    world: world
    name: "backgroundPan"
    reads: ["backgroundPans"]
    writes: ["runtimeOffsets"]
    skipWhenClean: false
  )
  uiRegister(
    schedule: schedule
    world: world
    name: "smokeFx"
    reads: ["smokeFxs", "smokeStates", "childrens", "transforms"]
    writes: ["smokeStates", "runtimeOffsets", "opacities", "transforms"]
    skipWhenClean: false
  )
  uiRegister(
    schedule: schedule
    world: world
    name: "carousel"
    reads: [
      "carousels"
      "carouselStates"
      "childrens"
      "worldTransforms"
      "actives"
      "transforms"
    ]
    writes: ["carouselStates", "runtimeOffsets", "transforms"]
    skipWhenClean: false
  )

  # visualBoundsSystem — measured glyph/sprite bounds, read by render.
  uiRegister(
    schedule: schedule
    world: world
    name: "visualBounds"
    reads: ["sprites", "styleOverrides", "texts", "visualBounds"]
    writes: ["visualBounds"]
    skipWhenClean: false
  )

  # renderSystemGpu2d — reads everything it paints, writes no table.
  uiRegister(
    schedule: schedule
    world: world
    name: "render"
    reads: [
      "aligns"
      "backdropImages"
      "childrens"
      "cornerRadiuses"
      "gradientFills"
      "hoverScales"
      "layerRoots"
      "opticalAligns"
      "overflows"
      "shapes"
      "sprites"
      "styleOverrides"
      "texts"
      "textShadows"
      "visualBounds"
      "worldTransforms"
    ]
    writes: List.create(String, cap: 0)
    skipWhenClean: false
  )

  ret schedule
}

# Should the UI system at `index` run this frame? The declared-set judgement
# over this world (see shouldRunDeclared).
# The generations of the tables the stage at `index` reads on the lib
# SYSTEMS (docs/ecs-systems-own-their-tables.md §3.1) — the derived tables
# are no longer world fields the declared sets can name, so what each stage
# reads of them is listed here by hand, next to the declarations above:
#   input, fit, camera, hoverScale, anim*, visualBounds, render: computedRects
#   layout: parents, measuredTexts (it writes measuredSizes / computedRects)
#   transform: computedRects, parents
#   safeArea: safeInsets
func uiSystemsReadGeneration(uiSystems: view UiSystems, index: view Int) ret Int {
  let rects: Int = componentTableGeneration(this: uiSystems.layout.computedRects)
  let parents: Int = componentTableGeneration(this: uiSystems.hierarchy.parents)
  if index is uiSystemLayout {
    ret parents + componentTableGeneration(this: uiSystems.layout.measuredTexts)
  }
  if index is uiSystemTransform {
    ret rects + parents
  }
  if index is uiSystemSafeArea {
    ret componentTableGeneration(this: uiSystems.safeArea.safeInsets)
  }
  if index is uiSystemWidgetStyle {
    ret 0
  }
  ret rects
}

func uiShouldRun(
  schedule: mod Schedule
  world: view UiWorld
  uiSystems: view UiSystems
  index: view Int
) ret Bool {
  ret shouldRunDeclaredPlus(
    UiWorld
    schedule: schedule
    world: world
    index: index
    extraGeneration: uiSystemsReadGeneration(uiSystems: uiSystems, index: index)
  )
}
