# Backend-agnostic text style resolution.
#
# Maps a Text node's `styleId` to a font size and an RgbaColor pulled from the
# active theme palette, so a renderer never hardcodes per-style sizes/colors in
# app or example code. Depends only on core + ui/components + ui/theme (NO
# raylib / no render surface), so both the raylib render path and the gpu2d
# render path can share it.
#
# The size/color tables mirror the music-player styles in lib/ui/render.rae
# (authored for the ~498-unit-wide phone canvas the mobile UI uses). render.rae
# still carries its own raylib-Color copy plus the royalblush `menu.*` set;
# unifying both onto this module is tracked as QUEUE #142.
import core
import ui/components
import ui/theme
import ui/theme_resolved

# ================================================================
# Theme-driven resolver (#231, Theme M1) — the SINGLE styleId ->
# concrete-value mapping for the gpu2d render path. Reads a
# ResolvedTheme (loaded from a .raescene theme, #230) instead of the
# hardcoded tables below.
#
# The hardcoded `textStyle*(styleId)` functions further down stay for
# the legacy raylib path (lib/ui/legacy_raylib + example 98), which is
# out of scope and keeps its own copy — do not route it through here.
#
# Color policy (byte-identical to the old g2dTextStyleColor): a style
# whose `color` is a palette SLOT resolves against the ACTIVE theme
# (theme.rae module global) so light/dark switching still works; a
# style with an inline color returns its baked RGBA. M5 moves slot
# resolution onto the ResolvedTheme palette + a generation counter.
# ================================================================

let styleBodySize: Float = 43.373493975903614

func resolveTextSize(theme: view ResolvedTheme, styleId: view String) pub ret Float {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 {
    ret styleBodySize
  }
  if let sz: Float = theme.textSizes.copyAt(index: i) {
    ret sz
  }
  ret styleBodySize
}

func resolveTextWeight(theme: view ResolvedTheme, styleId: view String) pub ret Float {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 { ret 400.0 }
  if let weight: Float = theme.textWeights.copyAt(index: i) {
    ret weight
  }
  ret 400.0
}

func resolveTextLineHeight(theme: view ResolvedTheme, styleId: view String) pub ret Float {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 { ret 1.0 }
  if let lineHeight: Float = theme.textLineHeights.copyAt(index: i) {
    ret lineHeight
  }
  ret 1.0
}

func resolveTextColor(theme: view ResolvedTheme, styleId: view String) pub ret RgbaColor {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 {
    ret themeColorByName(name: "textPrimary")
  }
  let slot: String = rae_ext_rae_buf_get(buf: theme.textColorSlots.data, index: i)
  if slot.length() > 0 {
    ret themeColorByName(name: slot)
  }
  var r: Int = 0
  var g: Int = 0
  var b: Int = 0
  var a: Int = 255
  if let colorRVal: Int = theme.textColorR.copyAt(index: i) { r = colorRVal }
  if let colorGVal: Int = theme.textColorG.copyAt(index: i) { g = colorGVal }
  if let colorBVal: Int = theme.textColorB.copyAt(index: i) { b = colorBVal }
  if let colorAVal: Int = theme.textColorA.copyAt(index: i) { a = colorAVal }
  ret RgbaColor { r: r, g: g, b: b, a: a }
}

func resolveTextIsCentered(theme: view ResolvedTheme, styleId: view String) pub ret Bool {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 {
    ret false
  }
  if let al: Int = theme.textAligns.copyAt(index: i) {
    ret al is themeAlignCenter
  }
  ret false
}

func resolveTextIsRightAligned(theme: view ResolvedTheme, styleId: view String) pub ret Bool {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 {
    ret false
  }
  if let al: Int = theme.textAligns.copyAt(index: i) {
    ret al is themeAlignEnd
  }
  ret false
}

# The shadow-token name a style references, or "" for no shadow
# (#232). The renderer looks the token up in the theme's shadow table
# (themeShadowIndex + shadow* lists) to get color/offset/softness —
# so a text shadow is a property of the named STYLE, not a per-entity
# component. Repairs e39a378, where the shadow was authored inline on
# every entity.
func resolveTextShadowName(theme: view ResolvedTheme, styleId: view String) pub ret String {
  let i: Int = themeTextStyleIndex(theme: theme, styleId: styleId)
  if i < 0 {
    ret ""
  }
  let name: String = rae_ext_rae_buf_get(buf: theme.textShadowNames.data, index: i)
  ret name
}

# Tier-2 override application (#236, theme §7). Layer a sparse
# StyleOverride over a base value the resolvers produced. World-free
# (takes the struct, not the world) so this module stays free of ECS
# dependencies; the render path fetches the component and passes it in
# only for the entities that carry one. A non-empty `colorSlot` resolves
# against the ACTIVE theme (M5-consistent) so an overridden color still
# tracks light/dark; else the literal `color` wins.
func styleOverrideSize(base: view Float, so: view StyleOverride) pub ret Float {
  if so.hasSize {
    ret so.size
  }
  ret base
}

func styleOverrideColor(base: view RgbaColor, so: view StyleOverride) pub ret RgbaColor {
  if so.hasColor {
    if so.colorSlot.length() > 0 {
      ret themeColorByName(name: so.colorSlot)
    }
    ret so.color
  }
  ret base
}

# ---------------------------------------------------------------
# LEGACY (raylib / example 98) hardcoded tables — out of scope.
# ---------------------------------------------------------------

# Font size (design units) for a style id. Mirrors render.rae's textStyleSize.
func textStyleSize(styleId: view String) pub ret Float {
  if styleId is "h1" { ret 78.0722891566265 }
  if styleId is "h2" { ret 60.722891566265055 }
  if styleId is "pageTitle" { ret 60.722891566265055 }
  if styleId is "topBarTitle" { ret 39.03614457831325 }
  if styleId is "miniTitle" { ret 39.03614457831325 }
  if styleId is "miniMuted" { ret 30.361445783132528 }
  if styleId is "caption" { ret 34.69879518072289 }
  if styleId is "albumCaption" { ret 30.361445783132528 }
  if styleId is "pillLabel" { ret 39.03614457831325 }
  if styleId is "trackTitle" { ret 43.373493975903614 }
  if styleId is "trackMuted" { ret 30.361445783132528 }
  if styleId is "historyTitle" { ret 39.03614457831325 }
  if styleId is "historyArtist" { ret 30.361445783132528 }
  if styleId is "tabActive" { ret 30.361445783132528 }
  if styleId is "tabInactive" { ret 30.361445783132528 }
  if styleId is "timeTotal" { ret 34.69879518072289 }
  # body / muted / primary and unknowns.
  ret 43.373493975903614
}

# Theme-palette color for a style id. Mirrors render.rae's textStyleColor —
# light/dark themes flip for free because every branch reads a semantic slot.
func textStyleColorRgba(styleId: view String) pub ret RgbaColor {
  if styleId is "muted" { ret themeColorByName(name: "textMuted") }
  if styleId is "caption" { ret themeColorByName(name: "textMuted") }
  if styleId is "albumCaption" { ret themeColorByName(name: "textMuted") }
  if styleId is "trackMuted" { ret themeColorByName(name: "textMuted") }
  if styleId is "historyArtist" { ret themeColorByName(name: "textMuted") }
  if styleId is "tabInactive" { ret themeColorByName(name: "textMuted") }
  if styleId is "timeTotal" { ret themeColorByName(name: "textMuted") }
  # "On surfaceAlt"/accent-panel styles.
  if styleId is "miniTitle" { ret themeColorByName(name: "accentText") }
  if styleId is "miniMuted" { ret themeColorByName(name: "accentTextMuted") }
  if styleId is "pillLabel" { ret themeColorByName(name: "accentText") }
  # primary / h1 / h2 / pageTitle / topBarTitle / trackTitle / tabActive / body
  # and unknowns fall back to primary text.
  ret themeColorByName(name: "textPrimary")
}

# Whether a style id is horizontally centered within its rect. Mirrors
# render.rae's textStyleIsCentered.
func textStyleIsCentered(styleId: view String) pub ret Bool {
  if styleId is "tabActive" { ret true }
  if styleId is "tabInactive" { ret true }
  if styleId is "pageTitle" { ret true }
  ret false
}

# Whether a style id is right-aligned within its rect (NowPlaying TimeTotal).
func textStyleIsRightAligned(styleId: view String) pub ret Bool {
  if styleId is "timeTotal" { ret true }
  ret false
}
