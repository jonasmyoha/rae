# Material Icons (Round): the codepoint of each icon name, GENERATED by
# tools/gen-material-icons.py from lib/assets/fonts/
# MaterialIconsRound-Regular.codepoints (the font's own list, Apache 2.0).
# Do not edit; rerun the tool. The baked atlas beside the font
# (MaterialIconsRound-Regular.mtsdf.json/.png) holds every one of them.
#
# The renderer draws a `mat:<name>` Sprite as the glyph iconText returns;
# the scene loader reports a name iconCodepoint does not know as an
# `unknownIcon` diagnostic (ui/IconCheck), so it never silently draws
# nothing. The codepoints are the same in every Material Icons style.
#
# Each group is one const per first character: fixed-width records, the
# name padded with spaces to the group's width less 4, then 4 hex digits,
# sorted by name, so a lookup is a binary search inside its group.
# 2200 names.

# The codepoint of the icon `name`, or -1 for a name the font does not have
func iconCodepoint(name: view String) ret Int {
  let first: Int = name.byteAt(index: 0)
  if first is 49 {
    ret iconSearch(name: name, table: iconsDigit1, width: 18)
  }
  if first is 50 {
    ret iconSearch(name: name, table: iconsDigit2, width: 12)
  }
  if first is 51 {
    ret iconSearch(name: name, table: iconsDigit3, width: 18)
  }
  if first is 52 {
    ret iconSearch(name: name, table: iconsDigit4, width: 23)
  }
  if first is 53 {
    ret iconSearch(name: name, table: iconsDigit5, width: 12)
  }
  if first is 54 {
    ret iconSearch(name: name, table: iconsDigit6, width: 17)
  }
  if first is 55 {
    ret iconSearch(name: name, table: iconsDigit7, width: 12)
  }
  if first is 56 {
    ret iconSearch(name: name, table: iconsDigit8, width: 12)
  }
  if first is 57 {
    ret iconSearch(name: name, table: iconsDigit9, width: 12)
  }
  if first is 97 {
    ret iconSearch(name: name, table: iconsA, width: 34)
  }
  if first is 98 {
    ret iconSearch(name: name, table: iconsB, width: 26)
  }
  if first is 99 {
    ret iconSearch(name: name, table: iconsC, width: 28)
  }
  if first is 100 {
    ret iconSearch(name: name, table: iconsD, width: 36)
  }
  if first is 101 {
    ret iconSearch(name: name, table: iconsE, width: 28)
  }
  if first is 102 {
    ret iconSearch(name: name, table: iconsF, width: 32)
  }
  if first is 103 {
    ret iconSearch(name: name, table: iconsG, width: 22)
  }
  if first is 104 {
    ret iconSearch(name: name, table: iconsH, width: 26)
  }
  if first is 105 {
    ret iconSearch(name: name, table: iconsI, width: 29)
  }
  if first is 106 {
    ret iconSearch(name: name, table: iconsJ, width: 15)
  }
  if first is 107 {
    ret iconSearch(name: name, table: iconsK, width: 32)
  }
  if first is 108 {
    ret iconSearch(name: name, table: iconsL, width: 28)
  }
  if first is 109 {
    ret iconSearch(name: name, table: iconsM, width: 27)
  }
  if first is 110 {
    ret iconSearch(name: name, table: iconsN, width: 32)
  }
  if first is 111 {
    ret iconSearch(name: name, table: iconsO, width: 23)
  }
  if first is 112 {
    ret iconSearch(name: name, table: iconsP, width: 32)
  }
  if first is 113 {
    ret iconSearch(name: name, table: iconsQ, width: 26)
  }
  if first is 114 {
    ret iconSearch(name: name, table: iconsR, width: 27)
  }
  if first is 115 {
    ret iconSearch(name: name, table: iconsS, width: 50)
  }
  if first is 116 {
    ret iconSearch(name: name, table: iconsT, width: 30)
  }
  if first is 117 {
    ret iconSearch(name: name, table: iconsU, width: 23)
  }
  if first is 118 {
    ret iconSearch(name: name, table: iconsV, width: 27)
  }
  if first is 119 {
    ret iconSearch(name: name, table: iconsW, width: 33)
  }
  if first is 121 {
    ret iconSearch(name: name, table: iconsY, width: 25)
  }
  if first is 122 {
    ret iconSearch(name: name, table: iconsZ, width: 17)
  }
  ret -1
}

# Whether the font has an icon called `name`
func isIconName(name: view String) ret Bool {
  ret iconCodepoint(name: name) >= 0
}

# The UTF-8 text of the icon `name` (one character), or "" for a name the
# font does not have (the loader reports such a name at load)
func iconText(name: view String) ret String {
  let code: Int = iconCodepoint(name: name)
  if code < 0 {
    ret ""
  }
  ret String.fromCodepoint(code: code)
}

# A binary search of `table`'s records of `width` bytes for `name`: its
# codepoint, or -1
func iconSearch(name: view String, table: view String, width: view Int) ret Int {
  let nameLength: Int = name.length()
  if nameLength is 0 or nameLength > width - 5 {
    ret -1
  }
  var low: Int = 0
  var high: Int = table.length() / width - 1
  loop low <= high {
    let middle: Int = (low + high) / 2
    let order: Int = iconCompare(name: name, table: table, start: middle * width)
    if order is 0 {
      ret iconHex(table: table, start: middle * width + width - 4)
    }
    if order < 0 {
      high = middle - 1
    } else {
      low = middle + 1
    }
  }
  ret -1
}

# `name` against the record at `start`: < 0, 0 or > 0. The padding is a
# space, which sorts before every character of a name, so a name that is
# a prefix of the record's comes first
func iconCompare(name: view String, table: view String, start: view Int) ret Int {
  let nameLength: Int = name.length()
  loop var i: Int = 0, i < nameLength, ++i {
    let difference: Int = name.byteAt(index: i) - table.byteAt(index: start + i)
    if difference is not 0 {
      ret difference
    }
  }
  if table.byteAt(index: start + nameLength) is 32 {
    ret 0
  }
  ret -1
}

# The 4 hex digits at `start` as a number
func iconHex(table: view String, start: view Int) ret Int {
  var value: Int = 0
  loop var i: Int = 0, i < 4, ++i {
    let digit: Int = table.byteAt(index: start + i)
    if digit >= 97 {
      value = value * 16 + digit - 87
    } else {
      value = value * 16 + digit - 48
    }
  }
  ret value
}

