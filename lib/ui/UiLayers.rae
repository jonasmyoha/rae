# ui/UiLayers — one stack of layers per window, and the paint plan made from it
# (docs/ui-layers-design.md §4, §6).
#
# A window has one LayerStack (a resource the program keeps next to its canvas). Its
# layers are named and ordered; a program adds its own in a gap. Every UI world that
# draws in the window joins the stack with a key, and keeps a LayerContribution: its
# roots (and raised nodes) per layer, sorted by z, then by the order the world lists
# them. Things drawn that are not nodes (world labels, the log strip, a program's
# compass) are LayerDraws in the stack. Each frame buildLayerPaintPlan merges the
# contributions and the draws into one list of steps in paint order; Rae draws its
# steps and a program's steps come back to it (step 2 of the design paints by it).
#
#   var stack: LayerStack = createStandardLayerStack()
#   layerStackAddWorld(stack: stack, worldKey: 0)
#   var contribution: LayerContribution = createLayerContribution(worldKey: 0)
#   var plan: LayerPaintPlan = createLayerPaintPlan()
#   ...each frame:
#   refreshLayerContribution(contribution: contribution, stack: stack, world: world, uiSystems:
#   uiSystems)
#   buildLayerPaintPlan(plan: plan, stack: stack, contributions: contributions, editor: false)
#
# Nothing allocates in a steady frame: the contribution is rebuilt only when its world's
# roots or the stack changed, a z change moves one entry in place (setRootZ), and the
# plan refills its own list.
#
# The old ui/Layer API (LayerRoot, LayerRef, createStandardLayers, raiseNodeToLayer,
# setLayerById, collectPaintableRoots) still works as before; a world's layer names are
# read from it here ("content" is hud, "back-button" is dock).
import ui/Components
open ecs/Entity
open ecs/ComponentTable
open ui/Ecs
open ui/Layer
open ui/UiSystems

# In which of the game / editor modes a layer is painted
enum LayerShows { always, gameMode, editorMode }

type UiLayer {
  # Given by the stack when the layer is added (stable while the stack lives)
  id: Int = 0
  name: String
  # Lower paints first
  order: Int
  # While it shows anything, input below it is blocked
  modal: Bool = false
  # A press outside what it shows is reported (LayerTappedOutside)
  dismissOnOutsideTap: Bool = false
  # While it shows anything, the layers under it are not painted
  hidesBelow: Bool = false
  shows: LayerShows = LayerShows.always
  opacity: Float = 1.0
  offsetX: Float = 0.0
  offsetY: Float = 0.0
  # Its clip and full-screen roots keep inside the safe area
  safeArea: Bool = false
  # Drawn to an offscreen target and composited once
  isolated: Bool = false
}

# The standard layers' orders (docs/ui-layers-design.md §4.3)
const layerOrderWorld: Int = 100

const layerOrderHud: Int = 200

const layerOrderHudOver: Int = 300

const layerOrderDock: Int = 400

const layerOrderPopover: Int = 500

const layerOrderToast: Int = 600

const layerOrderDialog: Int = 700

const layerOrderCover: Int = 750

const layerOrderNotification: Int = 800

const layerOrderLog: Int = 850

const layerOrderDebug: Int = 900

# What a LayerDraw draws: Rae's own kinds, or the program's (`appKind` tells them apart)
enum LayerDrawKind { worldLabels, logStrip, debugReadout, app }

# Something drawn in a layer that is not a node. `areaW` 0 or less: the whole layer.
type LayerDraw {
  layer: Int
  kind: LayerDrawKind
  z: Int = 0
  appKind: Int = 0
  # It also hit-tests, as a surface, inside its area
  hit: Bool = false
  areaX: Float = 0.0
  areaY: Float = 0.0
  areaW: Float = 0.0
  areaH: Float = 0.0
  # It blocks input under it while active (a full-screen map)
  modal: Bool = false
  active: Bool = true
}

type LayerStack {
  # Sorted by order; equal orders in the order they were added
  layers: List(UiLayer)
  # In the order they were added (an index stays the draw's)
  draws: List(LayerDraw)
  # The draws' indexes sorted by z, equal z in the order they were added
  drawOrder: List(Int)
  # The keys of the UI worlds that draw here, ascending
  worlds: List(Int)
  nextLayerId: Int = 1
  # Changes when a layer, a draw or a world is added: contributions rebuild
  generation: Int = 0
  # Layers' opacity and offsets on their way to a value (animateLayer)
  motions: List(LayerMotion)
}

# What of a layer a motion moves
enum LayerMotionProperty { opacity, offsetX, offsetY }

# A layer's property easing from `from` to `to` over `seconds` (layerMotionStep moves it)
type LayerMotion {
  layer: Int
  property: LayerMotionProperty
  from: Float
  to: Float
  seconds: Float
  elapsed: Float = 0.0
}

func createLayerStack() ret LayerStack {
  ret LayerStack {
    layers: {}
    draws: {}
    drawOrder: {}
    worlds: {}
    motions: {}
  }
}

# Add `layer` (its id is given here) after every layer of an order not above its own;
# returns its id
func addUiLayer(stack: mod LayerStack, layer: view UiLayer) ret Int {
  var added: UiLayer = layer
  added.id = stack.nextLayerId
  stack.nextLayerId = stack.nextLayerId + 1
  var at: Int = stack.layers.length
  loop at > 0 and stack.layers.copyAtFallback(index: at - 1, fallback: added).order > added.order {
    at = at - 1
  }
  let id: Int = added.id
  stack.layers.insert(index: at, value: own added)
  stack.generation = stack.generation + 1
  ret id
}

# Add a plain layer named `name` at `order`; returns its id
func addLayer(stack: mod LayerStack, name: view String, order: view Int) ret Int {
  ret addUiLayer(stack: stack, layer: UiLayer { name: "{name}", order: order })
}

# The standard stack (docs/ui-layers-design.md §4.3)
func createStandardLayerStack() ret LayerStack {
  var stack: LayerStack = createLayerStack()
  let unusedWorld: Int = addLayer(stack: stack, name: "world", order: layerOrderWorld)
  let unusedHud: Int = addLayer(stack: stack, name: "hud", order: layerOrderHud)
  let unusedHudOver: Int = addLayer(stack: stack, name: "hudOver", order: layerOrderHudOver)
  let unusedDock: Int = addUiLayer(
    stack: stack
    layer: UiLayer { name: "dock", order: layerOrderDock, safeArea: true }
  )
  let unusedPopover: Int = addUiLayer(
    stack: stack
    layer: UiLayer { name: "popover", order: layerOrderPopover, dismissOnOutsideTap: true }
  )
  let unusedToast: Int = addUiLayer(
    stack: stack
    layer: UiLayer { name: "toast", order: layerOrderToast, safeArea: true }
  )
  let unusedDialog: Int = addUiLayer(
    stack: stack
    layer: UiLayer {
      name: "dialog"
      order: layerOrderDialog
      modal: true
      dismissOnOutsideTap: true
    }
  )
  let unusedCover: Int = addUiLayer(
    stack: stack
    layer: UiLayer { name: "cover", order: layerOrderCover, modal: true, hidesBelow: true }
  )
  let unusedNotification: Int = addUiLayer(
    stack: stack
    layer: UiLayer { name: "notification", order: layerOrderNotification, safeArea: true }
  )
  let unusedLog: Int = addUiLayer(
    stack: stack
    layer: UiLayer { name: "log", order: layerOrderLog, shows: LayerShows.editorMode }
  )
  let unusedDebug: Int = addLayer(stack: stack, name: "debug", order: layerOrderDebug)
  ret stack
}

# The id of the layer named `name`, if there is one
func layerIdNamed(stack: view LayerStack, name: view String) ret opt Int {
  loop let layer: view UiLayer in stack.layers {
    if layer.name is name {
      ret layer.id
    }
  }
  ret none
}

# The id of the layer named `name`, -1 when there is none
func layerIdOf(stack: view LayerStack, name: view String) ret Int {
  if let id: Int = layerIdNamed(stack: stack, name: name) {
    ret id
  }
  ret -1
}

# Where the layer `id` is in the stack's order (-1: no such layer)
func layerPosition(stack: view LayerStack, id: view Int) ret Int {
  loop var i: Int = 0, i < stack.layers.length, ++i {
    if let layer: view UiLayer = stack.layers.viewAt(index: i) {
      if layer.id is id {
        ret i
      }
    }
  }
  ret -1
}

func layerNameOf(stack: view LayerStack, id: view Int) ret String {
  loop let layer: view UiLayer in stack.layers {
    if layer.id is id {
      ret "{layer.name}"
    }
  }
  ret "?"
}

# An order in the gap just above the layer `name` (halfway to the next layer, or 50
# above the top one); the layer's own order when there is no gap; 0 for no such layer
func layerOrderAbove(stack: view LayerStack, name: view String) ret Int {
  loop var i: Int = 0, i < stack.layers.length, ++i {
    if let layer: view UiLayer = stack.layers.viewAt(index: i) {
      if layer.name is name {
        if let next: view UiLayer = stack.layers.viewAt(index: i + 1) {
          ret layer.order + (next.order - layer.order) / 2
        }
        ret layer.order + 50
      }
    }
  }
  ret 0
}

# The UI world `worldKey` draws in this window; worlds sharing a layer paint in key
# order (the outgoing screen of a page transition under the incoming one)
func layerStackAddWorld(stack: mod LayerStack, worldKey: view Int) {
  var at: Int = stack.worlds.length
  loop at > 0 and stack.worlds.copyAtFallback(index: at - 1, fallback: 0) > worldKey {
    at = at - 1
  }
  if at > 0 and stack.worlds.copyAtFallback(index: at - 1, fallback: 0) is worldKey {
    ret
  }
  stack.worlds.insert(index: at, value: worldKey)
  stack.generation = stack.generation + 1
}

# Add a draw; returns its index, which stays its own
func addLayerDraw(stack: mod LayerStack, draw: view LayerDraw) ret Int {
  let index: Int = stack.draws.length
  stack.draws.add(value: draw)
  var at: Int = stack.drawOrder.length
  loop at > 0 and stack.draws.copyAtFallback(
    index: stack.drawOrder.copyAtFallback(index: at - 1, fallback: 0)
    fallback: draw
  ).z > draw.z {
    at = at - 1
  }
  stack.drawOrder.insert(index: at, value: index)
  stack.generation = stack.generation + 1
  ret index
}

# Show or hide the draw `index` (no rebuild)
func setLayerDrawActive(stack: mod LayerStack, index: view Int, active: view Bool) {
  if let draw: mod LayerDraw = stack.draws.modAt(index: index) {
    draw.active = active
  }
}

func layerShowsIn(layer: view UiLayer, editor: view Bool) ret Bool {
  if layer.shows is LayerShows.gameMode {
    ret editor is false
  }
  if layer.shows is LayerShows.editorMode {
    ret editor
  }
  ret true
}

# The layer `id` (a plain layer of order 0 named "" when the stack has none)
func layerOf(stack: view LayerStack, id: view Int) ret UiLayer {
  loop let layer: view UiLayer in stack.layers {
    if layer.id is id {
      ret layer
    }
  }
  ret UiLayer { name: "", order: 0 }
}

# The stack's order for an old ui/Layer order (content 0, dock 100, back-button 200, dialog 300,
# debug 400), in steps between the standard layers they became, so a world's own layers keep
# their place among them: 0 is hud (200), 100 dock (400), 300 dialog (700), 400 debug (900)
func stackOrderOfLegacy(order: view Int) ret Int {
  if order < 0 {
    ret layerOrderHud + order
  }
  if order <= 100 {
    ret layerOrderHud + order * 2
  }
  if order <= 300 {
    ret layerOrderDock + (order - 100) * 3 / 2
  }
  if order <= 400 {
    ret layerOrderDialog + (order - 300) * 2
  }
  ret layerOrderDebug + order - 400
}

# Add to the stack every layer `world` made itself (ui/Layer createLayerEntity) whose name the
# stack does not have, at stackOrderOfLegacy of its order: example 121's document, guides and
# chrome. The standard names ("content", "dock", "back-button", "dialog", "debug") are the
# stack's own.
func adoptWorldLayers(stack: mod LayerStack, world: view UiWorld) {
  loop var i: Int = 0, i < componentCount(this: world.layerRoots), ++i {
    let layerRoot: view LayerRoot = componentView(
      this: world.layerRoots
      entityId: componentEntityAt(this: world.layerRoots, i: i)
    )
    let name: String = stackLayerName(legacy: layerRoot.id)
    if layerIdOf(stack: stack, name: name) < 0 {
      let unusedId: Int = addLayer(
        stack: stack
        name: name
        order: stackOrderOfLegacy(order: layerRoot.order)
      )
    }
  }
}

# ----- a world's contribution ------------------------------------------------------
# One root (or raised node) of a world in a layer
type LayerEntry {
  layer: Int
  # The layer's place in the stack when the entry was made (the sort's first key)
  layerPosition: Int
  z: Int
  # The order the world listed it in (its mount order)
  seq: Int
  entityId: EntityId
  # It shows anything (sceneRootShown), as of the last refresh
  shown: Bool = true
}

type LayerContribution {
  worldKey: Int
  # Sorted by (layerPosition, z, seq)
  entries: List(LayerEntry)
  # This refresh's roots, reused
  scratch: List(EntityId)
  stackGeneration: Int = -1
  # How many times the entries were made again (a z change does not count)
  rebuilds: Int = 0
  # Roots whose layer name the stack does not have (they go in hud)
  unknownLayers: Int = 0
}

func createLayerContribution(worldKey: view Int) ret LayerContribution {
  ret LayerContribution { worldKey: worldKey, entries: {}, scratch: {} }
}

func entryBefore(a: view LayerEntry, b: view LayerEntry) ret Bool {
  if a.layerPosition is not b.layerPosition {
    ret a.layerPosition < b.layerPosition
  }
  if a.z is not b.z {
    ret a.z < b.z
  }
  ret a.seq < b.seq
}

# The stack's name for a world's legacy layer name
func stackLayerName(legacy: view String) ret String {
  if legacy is "content" {
    ret "hud"
  }
  if legacy is "back-button" {
    ret "dock"
  }
  ret "{legacy}"
}

# The z a node asks for (its LayerTag's), 0 without one
func nodeLayerZ(world: view UiWorld, entityId: view EntityId) ret Int {
  if componentHas(this: world.layerTags, entityId: entityId) {
    ret componentView(this: world.layerTags, entityId: entityId).z
  }
  ret 0
}

# The layer a root or a raised node is in: its LayerRef's layer by name, else its
# LayerTag's name, else hud; -1 when the stack has no such layer
func nodeLayerId(stack: view LayerStack, world: view UiWorld, entityId: view EntityId) ret Int {
  var name: String = "hud"
  if componentHas(this: world.layerRefs, entityId: entityId) {
    let layer: EntityId = componentView(this: world.layerRefs, entityId: entityId).layer
    if componentHas(this: world.layerRoots, entityId: layer) {
      name = stackLayerName(legacy: componentView(this: world.layerRoots, entityId: layer).id)
    }
  } else if componentHas(this: world.layerTags, entityId: entityId) {
    let tag: view LayerTag = componentView(this: world.layerTags, entityId: entityId)
    if tag.id.length() > 0 {
      name = stackLayerName(legacy: tag.id)
    }
  }
  if let id: Int = layerIdNamed(stack: stack, name: name) {
    ret id
  }
  ret -1
}

# Is `entityId` among the contribution's entries?
func contributionHolds(contribution: view LayerContribution, entityId: view EntityId) ret Bool {
  loop let entry: view LayerEntry in contribution.entries {
    if entry.entityId is entityId {
      ret true
    }
  }
  ret false
}

# The world's roots and raised nodes now, in the order the world lists them (as
# collectPaintableRoots finds them), into the contribution's scratch list
func gatherLayerRoots(
  contribution: mod LayerContribution
  world: view UiWorld
  uiSystems: view UiSystems
) {
  contribution.scratch.clear()
  loop let entityId: view EntityId in world.allocator.alive {
    if componentHas(this: uiSystems.hierarchy.parents, entityId: entityId) is false and componentHas(
      this: uiSystems.transform2d.worldTransforms
      entityId: entityId
    ) {
      contribution.scratch.add(value: entityId)
    }
  }
  loop var r: Int = 0, r < componentCount(this: world.layerRefs), ++r {
    let raised: EntityId = componentEntityAt(this: world.layerRefs, i: r)
    if isRaisedNode(world: world, uiSystems: uiSystems, entityId: raised) and componentHas(
      this: uiSystems.transform2d.worldTransforms
      entityId: raised
    ) {
      contribution.scratch.add(value: raised)
    }
  }
}

# Bring the contribution up to date with its world: made again only when the stack
# changed or the world's roots are not the ones it holds; a z change (setRootZ) keeps it
func refreshLayerContribution(
  contribution: mod LayerContribution
  stack: view LayerStack
  world: view UiWorld
  uiSystems: view UiSystems
) {
  gatherLayerRoots(contribution: contribution, world: world, uiSystems: uiSystems)
  var same: Bool = contribution.stackGeneration is stack.generation and contribution.scratch.length is contribution.entries.length
  if same {
    loop let entityId: view EntityId in contribution.scratch {
      if not contributionHolds(contribution: contribution, entityId: entityId) {
        same = false
        break
      }
    }
  }
  if same {
    updateEntriesShown(contribution: contribution, world: world, uiSystems: uiSystems)
    ret
  }
  contribution.entries.clear()
  contribution.unknownLayers = 0
  var hud: Int = -1
  if let id: Int = layerIdNamed(stack: stack, name: "hud") {
    hud = id
  }
  loop var seq: Int = 0, seq < contribution.scratch.length, ++seq {
    let entityId: EntityId = contribution.scratch.copyAtFallback(index: seq, fallback: noEntity())
    var layer: Int = nodeLayerId(stack: stack, world: world, entityId: entityId)
    if layer < 0 {
      contribution.unknownLayers = contribution.unknownLayers + 1
      layer = hud
    }
    let entry: LayerEntry = {
      layer: layer
      layerPosition: layerPosition(stack: stack, id: layer)
      z: nodeLayerZ(world: world, entityId: entityId)
      seq: seq
      entityId: entityId
    }
    var at: Int = contribution.entries.length
    loop at > 0 and entryBefore(
      a: entry
      b: contribution.entries.copyAtFallback(index: at - 1, fallback: entry)
    ) {
      at = at - 1
    }
    contribution.entries.insert(index: at, value: entry)
  }
  contribution.stackGeneration = stack.generation
  contribution.rebuilds = contribution.rebuilds + 1
  updateEntriesShown(contribution: contribution, world: world, uiSystems: uiSystems)
}

# Each entry's root shows anything now (every refresh: a page shown or hidden is no rebuild)
func updateEntriesShown(
  contribution: mod LayerContribution
  world: view UiWorld
  uiSystems: view UiSystems
) {
  loop var i: Int = 0, i < contribution.entries.length, ++i {
    if let entry: mod LayerEntry = contribution.entries.modAt(index: i) {
      entry.shown = sceneRootShown(world: world, uiSystems: uiSystems, root: entry.entityId)
    }
  }
}

# Does the root (or raised node) show anything a press could land on or a cover could hide
# under? A layer entity does not, a raised node of a hidden scene does not, and neither does a
# root that is inactive or hidden: a mounted but hidden page keeps its layer from blocking input
func sceneRootShown(world: view UiWorld, uiSystems: view UiSystems, root: view EntityId) ret Bool {
  if componentHas(this: world.layerRoots, entityId: root) {
    ret false
  }
  if isRaisedNode(world: world, uiSystems: uiSystems, entityId: root) and raisedNodeShown(
    uiSystems: uiSystems
    entityId: root
  ) is false {
    ret false
  }
  if componentHas(this: world.actives, entityId: root) and componentView(
    this: world.actives
    entityId: root
  ).value is false {
    ret false
  }
  if componentHas(this: uiSystems.transform2d.worldVisuals, entityId: root) {
    ret componentView(this: uiSystems.transform2d.worldVisuals, entityId: root).visible
  }
  ret true
}

# Make the contribution again on its next refresh. Call it after a root already in the
# world moved to another layer (its LayerTag's id or its LayerRef changed): the refresh
# only notices roots coming and going.
func markLayerContributionStale(contribution: mod LayerContribution) {
  contribution.stackGeneration = -1
}

# Set the root (or raised node) `entityId`'s z: on its LayerTag (made with no layer
# name of its own when it has none), and its entry moved to its new place among its
# layer's entries, in place: no rebuild, no allocation
func setRootZ(
  contribution: mod LayerContribution
  world: mod UiWorld
  entityId: view EntityId
  z: view Int
) {
  if componentHas(this: world.layerTags, entityId: entityId) {
    componentMod(this: world.layerTags, entityId: entityId).z = z
  } else {
    componentSet(this: world.layerTags, entityId: entityId, data: LayerTag { id: "", z: z })
  }
  var at: Int = -1
  loop var i: Int = 0, i < contribution.entries.length and at < 0, ++i {
    if let entry: view LayerEntry = contribution.entries.viewAt(index: i) {
      if entry.entityId is entityId {
        at = i
      }
    }
  }
  if at < 0 {
    ret
  }
  if let entry: mod LayerEntry = contribution.entries.modAt(index: at) {
    entry.z = z
  }
  # toward the front while it belongs before the one in front of it, else toward the back
  loop at > 0 and entryBefore(
    a: contribution.entries.copyAtFallback(index: at, fallback: emptyLayerEntry())
    b: contribution.entries.copyAtFallback(index: at - 1, fallback: emptyLayerEntry())
  ) {
    contribution.entries.swap(i: at, j: at - 1)
    at = at - 1
  }
  loop at + 1 < contribution.entries.length and entryBefore(
    a: contribution.entries.copyAtFallback(index: at + 1, fallback: emptyLayerEntry())
    b: contribution.entries.copyAtFallback(index: at, fallback: emptyLayerEntry())
  ) {
    contribution.entries.swap(i: at, j: at + 1)
    at = at + 1
  }
}

func emptyLayerEntry() ret LayerEntry {
  ret LayerEntry {
    layer: -1
    layerPosition: -1
    z: 0
    seq: 0
    entityId: noEntity()
    shown: false
  }
}

# ----- the paint plan ----------------------------------------------------------------
enum PaintStepKind { layerBegin, sceneRoot, draw, layerEnd }

type PaintStep {
  kind: PaintStepKind
  layer: Int
  # The world's key (sceneRoot), -1 otherwise
  world: Int
  # The root or raised node (sceneRoot)
  entityId: EntityId
  # The draw's index in the stack's draws (draw), -1 otherwise
  draw: Int
  appKind: Int
  z: Int
}

type LayerPaintPlan {
  steps: List(PaintStep)
  # Each contribution's place in its entries while merging, reused
  cursors: List(Int)
}

func createLayerPaintPlan() ret LayerPaintPlan {
  ret LayerPaintPlan { steps: {}, cursors: {} }
}

func paintStepOf(kind: view PaintStepKind, layer: view Int) ret PaintStep {
  ret PaintStep {
    kind: kind
    layer: layer
    world: -1
    entityId: noEntity()
    draw: -1
    appKind: 0
    z: 0
  }
}

# The place in drawOrder of the next active draw of the layer `layer` at or after
# `from` (-1: none)
func nextDrawIn(stack: view LayerStack, layer: view Int, from: view Int) ret Int {
  loop var o: Int = from, o < stack.drawOrder.length, ++o {
    let index: Int = stack.drawOrder.copyAtFallback(index: o, fallback: -1)
    if let draw: view LayerDraw = stack.draws.viewAt(index: index) {
      if draw.layer is layer and draw.active {
        ret o
      }
    }
  }
  ret -1
}

func drawAtOrder(stack: view LayerStack, order: view Int) ret LayerDraw {
  ret stack.draws.copyAtFallback(
    index: stack.drawOrder.copyAtFallback(index: order, fallback: -1)
    fallback: LayerDraw { layer: -1, kind: LayerDrawKind.app }
  )
}

# This frame's steps, in paint order, into `plan` (its lists reused). Layers in order,
# those the mode shows; in each, its draws and every contribution's entries by z; at an
# equal z draws first (under the roots), then worlds in key order, then the order each
# world listed its roots. A layer with nothing in it has no steps. `contributions` must
# be up to date with `stack` (refreshLayerContribution).
func buildLayerPaintPlan(
  plan: mod LayerPaintPlan
  stack: view LayerStack
  contributions: view List(LayerContribution)
  editor: view Bool
) {
  plan.steps.clear()
  plan.cursors.clear()
  loop var c: Int = 0, c < contributions.length, ++c {
    plan.cursors.add(value: 0)
  }
  loop var position: Int = 0, position < stack.layers.length, ++position {
    let layer: UiLayer = stack.layers.copyAtFallback(
      index: position
      fallback: UiLayer { name: "", order: 0 }
    )
    let shown: Bool = layerShowsIn(layer: layer, editor: editor)
    let begin: Int = plan.steps.length
    var layerShows: Bool = false
    plan.steps.add(value: paintStepOf(kind: PaintStepKind.layerBegin, layer: layer.id))
    var draw: Int = nextDrawIn(stack: stack, layer: layer.id, from: 0)
    # entries of a layer the stack no longer has (made before it changed) are passed over
    loop var c: Int = 0, c < contributions.length, ++c {
      if let contribution: view LayerContribution = contributions.viewAt(index: c) {
        var at: Int = plan.cursors.copyAtFallback(index: c, fallback: 0)
        loop at < contribution.entries.length and contribution.entries.copyAtFallback(
          index: at
          fallback: emptyLayerEntry()
        ).layerPosition < position {
          at = at + 1
        }
        plan.cursors.set(index: c, value: at)
      }
    }
    loop true {
      # the best entry among the contributions at this layer
      var best: Int = -1
      var bestEntry: LayerEntry = emptyLayerEntry()
      var bestWorld: Int = 0
      loop var c: Int = 0, c < contributions.length, ++c {
        if let contribution: view LayerContribution = contributions.viewAt(index: c) {
          let at: Int = plan.cursors.copyAtFallback(index: c, fallback: 0)
          if let entry: view LayerEntry = contribution.entries.viewAt(index: at) {
            if entry.layerPosition is position {
              if best < 0 or entry.z < bestEntry.z or (entry.z is bestEntry.z and contribution.worldKey < bestWorld) {
                best = c
                bestEntry = entry
                bestWorld = contribution.worldKey
              }
            }
          }
        }
      }
      let picked: LayerDraw = drawAtOrder(stack: stack, order: draw)
      if draw >= 0 and (best < 0 or picked.z <= bestEntry.z) {
        layerShows = true
        if shown {
          var step: PaintStep = paintStepOf(kind: PaintStepKind.draw, layer: layer.id)
          step.draw = stack.drawOrder.copyAtFallback(index: draw, fallback: -1)
          step.appKind = picked.appKind
          step.z = picked.z
          plan.steps.add(value: step)
        }
        draw = nextDrawIn(stack: stack, layer: layer.id, from: draw + 1)
      } else if best >= 0 {
        if bestEntry.shown {
          layerShows = true
        }
        if shown {
          var step: PaintStep = paintStepOf(kind: PaintStepKind.sceneRoot, layer: layer.id)
          step.world = bestWorld
          step.entityId = bestEntry.entityId
          step.z = bestEntry.z
          plan.steps.add(value: step)
        }
        plan.cursors.set(
          index: best
          value: plan.cursors.copyAtFallback(index: best, fallback: 0) + 1
        )
      } else {
        break
      }
    }
    if plan.steps.length is begin + 1 {
      plan.steps.removeAt(index: begin)
    } else {
      plan.steps.add(value: paintStepOf(kind: PaintStepKind.layerEnd, layer: layer.id))
      # a cover that shows something: nothing under it is painted (its steps moved to the front)
      if layer.hidesBelow and shown and layerShows and begin > 0 {
        dropStepsBefore(plan: plan, cut: begin)
      }
    }
  }
}

# The steps from `cut` on moved to the front, the ones before dropped (in place)
func dropStepsBefore(plan: mod LayerPaintPlan, cut: view Int) {
  let kept: Int = plan.steps.length - cut
  loop var i: Int = 0, i < kept, ++i {
    plan.steps.swap(i: i, j: i + cut)
  }
  loop plan.steps.length > kept {
    plan.steps.removeLast()
  }
}

# ----- motion (docs/ui-layers-design.md §9) ----------------------------------------------
func layerPropertyValue(layer: view UiLayer, property: view LayerMotionProperty) ret Float {
  if property is LayerMotionProperty.opacity {
    ret layer.opacity
  }
  if property is LayerMotionProperty.offsetX {
    ret layer.offsetX
  }
  ret layer.offsetY
}

func setLayerProperty(
  stack: mod LayerStack
  id: view Int
  property: view LayerMotionProperty
  value: view Float
) {
  loop var i: Int = 0, i < stack.layers.length, ++i {
    if let layer: mod UiLayer = stack.layers.modAt(index: i) {
      if layer.id is id {
        if property is LayerMotionProperty.opacity {
          layer.opacity = value
        } else if property is LayerMotionProperty.offsetX {
          layer.offsetX = value
        } else {
          layer.offsetY = value
        }
      }
    }
  }
}

# Ease the layer `id`'s `property` from where it is to `to` over `seconds` (0: at once); a motion
# of the same layer and property already running is replaced, from where it got to
func animateLayer(
  stack: mod LayerStack
  id: view Int
  property: view LayerMotionProperty
  to: view Float
  seconds: view Float
) {
  let from: Float = layerPropertyValue(layer: layerOf(stack: stack, id: id), property: property)
  loop var i: Int = stack.motions.length - 1, i >= 0, --i {
    if let motion: view LayerMotion = stack.motions.viewAt(index: i) {
      if motion.layer is id and motion.property is property {
        stack.motions.removeAt(index: i)
      }
    }
  }
  if seconds <= 0.0 {
    setLayerProperty(
      stack: stack
      id: id
      property: property
      value: to
    )
    ret
  }
  stack.motions.add(value: LayerMotion {
    layer: id
    property: property
    from: from
    to: to
    seconds: seconds
  })
}

# The share of a motion done at `progress` (0..1): a cubic ease-out, fast at first and settling
func layerMotionEase(progress: view Float) ret Float {
  var left: Float = 1.0 - progress
  if left < 0.0 {
    left = 0.0
  }
  if left > 1.0 {
    left = 1.0
  }
  ret 1.0 - left * left * left
}

# Every layer motion moved on by `deltaTime` (s), the finished ones at their end and removed;
# true while any is still running (the program keeps drawing frames)
func layerMotionStep(stack: mod LayerStack, deltaTime: view Float) ret Bool {
  loop var i: Int = stack.motions.length - 1, i >= 0, --i {
    var finished: Bool = false
    var id: Int = -1
    var property: LayerMotionProperty = LayerMotionProperty.opacity
    var value: Float = 0.0
    if let motion: mod LayerMotion = stack.motions.modAt(index: i) {
      motion.elapsed = motion.elapsed + deltaTime
      let share: Float = layerMotionEase(progress: motion.elapsed / motion.seconds)
      id = motion.layer
      property = motion.property
      value = motion.from + (motion.to - motion.from) * share
      finished = motion.elapsed >= motion.seconds
      if finished {
        value = motion.to
      }
    }
    setLayerProperty(
      stack: stack
      id: id
      property: property
      value: value
    )
    if finished {
      stack.motions.removeAt(index: i)
    }
  }
  ret stack.motions.length > 0
}
