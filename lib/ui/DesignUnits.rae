# Design units (du): the one UI unit of every Rae program
# (docs/ui-coordinate-and-responsive-layout.md, rules 1-4). A design unit is
# a logical point, the unit of iOS, Android (dp), CSS and Figma: a phone is
# about 360-430 wide, a margin 16, a touch target 44. A UI size, position,
# font size, padding or inset is in du; the GPU draws pixels (px):
#
#   du = pt x unitScale        unitScale is 1: the layout fills the window in points
#   px = pt x dpr              the display's scale (1, 2 or 3)
#   px = du x renderScale      renderScale = dpr / unitScale, only where the GPU draws
#
# So 200 du is the same physical size on every device: 200 px on a 1x
# monitor, 400 on a @2x display, 600 on a @3x phone. Size classes, safe areas
# and touch targets are in du. These functions are the one place a program
# converts, so a later user zoom changes them and nothing else.

import ui/Components

# Design units per logical point
const unitScale: Float = 1.0

# The smallest touch target, 44 pt, in du
const minTouchTargetDu: Float = 44.0

func duFromPoints(points: view Float) ret Float {
  ret points * unitScale
}

func pointsFromDu(du: view Float) ret Float {
  ret du / unitScale
}

# Pixels per du on a display of `dpr` pixels per point (a dpr of 0 or less is
# taken as 1)
func renderScale(dpr: view Float) ret Float {
  if dpr <= 0.0 {
    ret 1.0 / unitScale
  }
  ret dpr / unitScale
}

func pixelsFromDu(du: view Float, dpr: view Float) ret Float {
  ret du * renderScale(dpr: dpr)
}

func duFromPixels(pixels: view Float, dpr: view Float) ret Float {
  ret pixels / renderScale(dpr: dpr)
}

# Insets given in points, in du (a device's safe area as the OS reports it)
func insetsDuFromPoints(insets: view Insets) ret Insets {
  ret Insets {
    l: duFromPoints(points: insets.l)
    t: duFromPoints(points: insets.t)
    r: duFromPoints(points: insets.r)
    b: duFromPoints(points: insets.b)
  }
}

# ----- user zoom ----------------------------------------------------------
# A user zoom (ui/UiZoom, written like `1.25x`) makes the whole UI bigger for
# reading comfort without changing any authored number: the layout area is
# the window in points / zoom, and every design unit is drawn `zoom` points
# big. 1 is no zoom; it is kept within these bounds.
const minUiZoom: Float = 0.5

const maxUiZoom: Float = 4.0

func clampUiZoom(zoom: view Float) ret Float {
  if zoom < minUiZoom {
    ret minUiZoom
  }
  if zoom > maxUiZoom {
    ret maxUiZoom
  }
  ret zoom
}

# `points` of the window in design units at `zoom` (a layout extent, a
# pointer position, an inset the OS gave in points)
func duFromPointsAt(points: view Float, zoom: view Float) ret Float {
  ret duFromPoints(points: points) / clampUiZoom(zoom: zoom)
}

func pointsFromDuAt(du: view Float, zoom: view Float) ret Float {
  ret pointsFromDu(du: du) * clampUiZoom(zoom: zoom)
}

# Pixels per design unit on a display of `dpr` pixels per point at `zoom`
func renderScaleAt(dpr: view Float, zoom: view Float) ret Float {
  ret renderScale(dpr: dpr) * clampUiZoom(zoom: zoom)
}
