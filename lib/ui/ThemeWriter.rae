# ThemeWriter — one motion token back into a theme's file, and nothing else: every other byte of the
# text stays as the author wrote it, so a palette keeps its layout and its order. SceneWriter
# rewrites a page in the canonical layout because it owns every node there. A theme file is shared,
# and an edit to one token must show as one line in a diff.
#
# The text is walked by hand, as a parsed JsonDoc has no positions.
import Json
open ui/ThemeResolved

# Where one member of an object sits. `closeAt` is the object's closing brace, found or not.
type ThemeMemberSpan {
  found: Bool = false
  valueStart: Int = 0
  valueEnd: Int = 0
  closeAt: Int = 0
}

func themeSkipSpace(text: view String, start: view Int) ret Int {
  var at: Int = start
  loop at < text.length() {
    let byte: Int = text.byteAt(index: at)
    if byte is not 32 and byte is not 9 and byte is not 10 and byte is not 13 {
      ret at
    }
    at = at + 1
  }
  ret at
}

# The position after the string that opens at `start`
func themeStringEnd(text: view String, start: view Int) ret Int {
  var at: Int = start + 1
  loop at < text.length() {
    let byte: Int = text.byteAt(index: at)
    if byte is 92 {
      at = at + 2
      continue
    }
    if byte is 34 {
      ret at + 1
    }
    at = at + 1
  }
  ret at
}

# The position after the JSON value that opens at `start`
func themeValueEnd(text: view String, start: view Int) ret Int {
  let first: Int = text.byteAt(index: start)
  if first is 34 {
    ret themeStringEnd(text: text, start: start)
  }
  var at: Int = start
  if first is 123 or first is 91 {
    var depth: Int = 0
    loop at < text.length() {
      let byte: Int = text.byteAt(index: at)
      if byte is 34 {
        at = themeStringEnd(text: text, start: at)
        continue
      }
      if byte is 123 or byte is 91 {
        depth = depth + 1
      } else if byte is 125 or byte is 93 {
        depth = depth - 1
        if depth is 0 {
          ret at + 1
        }
      }
      at = at + 1
    }
    ret at
  }
  loop at < text.length() {
    let byte: Int = text.byteAt(index: at)
    if byte is 44 or byte is 125 or byte is 93 or byte is 32 or byte is 9 or byte is 10 or byte is 13 {
      ret at
    }
    at = at + 1
  }
  ret at
}

# Look for `key` in the object that opens at `objectAt`
func themeFindMember(text: view String, objectAt: view Int, key: view String) ret ThemeMemberSpan {
  var span: ThemeMemberSpan = {}
  var at: Int = themeSkipSpace(text: text, start: objectAt + 1)
  loop at < text.length() {
    let byte: Int = text.byteAt(index: at)
    if byte is 125 {
      span.closeAt = at
      ret span
    }
    if byte is 44 {
      at = themeSkipSpace(text: text, start: at + 1)
      continue
    }
    let keyEnd: Int = themeStringEnd(text: text, start: at)
    let name: String = text.sub(start: at + 1, len: keyEnd - at - 2)
    # Past the colon
    let valueAt: Int = themeSkipSpace(
      text: text
      start: themeSkipSpace(text: text, start: keyEnd) + 1
    )
    let valueEnd: Int = themeValueEnd(text: text, start: valueAt)
    if name is key and span.found is false {
      span.found = true
      span.valueStart = valueAt
      span.valueEnd = valueEnd
    }
    at = themeSkipSpace(text: text, start: valueEnd)
  }
  ret span
}

# A new member last in the object that closes at `closeAt`
func themeInsertMember(
  text: view String
  closeAt: view Int
  member: view String
  indent: view String
) ret String {
  var last: Int = closeAt - 1
  loop last > 0 and themeSkipSpace(text: text, start: last) is not last {
    last = last - 1
  }
  let before: String = text.sub(start: 0, len: last + 1)
  if text.byteAt(index: last) is 123 {
    let outer: String = indent.sub(start: 0, len: indent.length() - 2)
    ret "{before}\n{indent}{member}\n{outer}{text.sub(start: closeAt, len: text.length() - closeAt)}"
  }
  ret "{before},\n{indent}{member}{text.sub(start: last + 1, len: text.length() - last - 1)}"
}

# A token as the theme's `motion` section writes it
func themeMotionJson(token: view MotionToken) ret String {
  if token.kind is MotionKind.curve {
    ret "\{\"kind\": \"curve\", \"curve\": {Json.quote(text: token.curve)}, \"seconds\": {Json.jbNumber(
      value: token.seconds
    )}\}"
  }
  ret "\{\"kind\": \"spring\", \"response\": {Json.jbNumber(value: token.response)}, \"damping\": {Json.jbNumber(
    value: token.damping
  )}\}"
}

# Whether this file's text declares the motion called `name`
func themeDeclaresMotion(source: view String, name: view String) ret Bool {
  let doc: JsonDoc = Json.parseJson(source: source)
  if doc.ok is false {
    ret false
  }
  let section: Int = Json.field(doc: doc, this: Json.root(doc: doc), key: "motion")
  if section < 0 {
    ret false
  }
  ret Json.field(doc: doc, this: Json.jsonValueAt(doc: doc, idx: section), key: name) >= 0
}

# `source` with `token` declared in its `motion` section: replaced where it is, else added last,
# with
# the section added last when the file has none. None when `source` is not a JSON object.
func writeThemeMotion(source: view String, token: view MotionToken) ret opt String {
  let doc: JsonDoc = Json.parseJson(source: source)
  if doc.ok is false or Json.root(doc: doc).kind is not JsonKind.object {
    ret none
  }
  let member: String = "{Json.quote(text: token.name)}: {themeMotionJson(token: token)}"
  let rootAt: Int = themeSkipSpace(text: source, start: 0)
  let section: ThemeMemberSpan = themeFindMember(text: source, objectAt: rootAt, key: "motion")
  if section.found is false {
    ret themeInsertMember(
      text: source
      closeAt: section.closeAt
      member: "\"motion\": \{\n    {member}\n  \}"
      indent: "  "
    )
  }
  let entry: ThemeMemberSpan = themeFindMember(
    text: source
    objectAt: section.valueStart
    key: token.name
  )
  if entry.found is false {
    ret themeInsertMember(
      text: source
      closeAt: entry.closeAt
      member: member
      indent: "    "
    )
  }
  ret "{source.sub(start: 0, len: entry.valueStart)}{themeMotionJson(token: token)}{source.sub(
    start: entry.valueEnd
    len: source.length() - entry.valueEnd
  )}"
}
