# Built-in bundles: named component sets lib/ui itself provides, so every
# scene can use them without declaring them in its theme
# (docs/ui-scene-format.md §9). A scene's own `bundles` block and its
# imports come first: a theme that declares the same name replaces the
# built-in one. They carry SHAPE and PLACEMENT, never colors, so they
# combine with a theme's look: `"bundles": ["secondaryButton",
# "circleButton"]` is the theme's button drawn as a true circle.
#
#   circleButton  a round button for an icon: a 44-point square box (the
#                 smallest touch target; a node's own Rect sets another
#                 size, keep it square), a Circle shape (its fill and
#                 stroke come from an earlier bundle or the node), and its
#                 child (the icon) centered; a tap anywhere in the square
#                 counts (lib/ui tests taps against the node's box)
#
#   switch        an on/off switch (ui/switchSystem): a 52 by 32 point box, a Switch, and an
#                 OnClick so that a tap reaches it (a node's own OnClick adds its label)
const builtInSwitch: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":52,\"h\":32\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Switch\":\{\},\"OnClick\":\{\}\}"

const builtInCircleButton: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":44,\"h\":44\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Shape\":\{\"kind\":\"Circle\",\"radius\":0\},\"Layout\":\{\"type\":\"Stack\",\"alignMain\":\"Center\",\"alignCross\":\"Center\"\}\}"

# Motion (docs/ui-animation-design.md section 4): one bundle on a node gives it good motion. A
# node's
# own component wins field by field: "bundles": ["appearRise"], "Appear": { "y": 40 }.
const builtInAppearFade: String = "\{\"Appear\":\{\"motion\":\"smooth\",\"y\":0\}\}"

const builtInAppearRise: String = "\{\"Appear\":\{\"motion\":\"smooth\",\"y\":16\}\}"

const builtInAppearPop: String = "\{\"Appear\":\{\"motion\":\"lively\",\"y\":0,\"scale\":0.86\}\}"

const builtInAppearDrop: String = "\{\"Appear\":\{\"motion\":\"lively\",\"y\":-24\}\}"

const builtInDisappearFade: String = "\{\"Disappear\":\{\"scale\":1\}\}"

const builtInDisappearShrink: String = "\{\"Disappear\":\{\"scale\":0.94\}\}"

const builtInStaggerFromEnd: String = "\{\"Stagger\":\{\"appearFrom\":\"end\",\"disappearFrom\":\"start\"\}\}"

const builtInStaggerFromStart: String = "\{\"Stagger\":\{\"appearFrom\":\"start\",\"disappearFrom\":\"end\"\}\}"

const builtInPressable: String = "\{\"HoverScale\":\{\"pressedScale\":0.96,\"motion\":\"quick\"\}\}"

const builtInDialogMotion: String = "\{\"Appear\":\{\"motion\":\"lively\",\"y\":0,\"scale\":0.9\},\"Disappear\":\{\"scale\":0.96\}\}"

const builtInGlideOnChange: String = "\{\"AnimateLayout\":\{\"motion\":\"smooth\"\}\}"

# A menu's parts (ui/MenuSystem): its panel, a row (its Shape is drawn while the row is focused), a
# row's icon, text and shortcut, and a separator with its line. Their colors are theme slots; a
# focused row's text and icons are accentText, on its accent.
const builtInMenuPanel: String = "\{\"Layout\":\{\"type\":\"Vertical\",\"gap\":0\},\"Padding\":\{\"l\":5,\"t\":5,\"r\":5,\"b\":5\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Hug\"\}\},\"Shape\":\{\"kind\":\"RoundedRect\",\"fill\":\"surfaceAlt\",\"stroke\":\"outline\",\"strokeWidth\":1,\"radius\":8\},\"Shadow\":\{\"blur\":24,\"opacity\":0.5\}\}"

const builtInMenuRow: String = "\{\"Layout\":\{\"type\":\"Horizontal\",\"gap\":8,\"alignCross\":\"Center\"\},\"Padding\":\{\"l\":8,\"t\":0,\"r\":8,\"b\":0\},\"Size\":\{\"w\":\{\"mode\":\"Fill\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Shape\":\{\"kind\":\"RoundedRect\",\"fill\":\"accent\",\"radius\":5\}\}"

const builtInMenuIcon: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":18,\"h\":18\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Sprite\":\{\"textureKey\":\"\",\"tint\":\"textPrimary\"\}\}"

const builtInMenuText: String = "\{\"Offset\":\{\"x\":0,\"y\":-2\},\"Size\":\{\"w\":\{\"mode\":\"Hug\"\},\"h\":\{\"mode\":\"Hug\"\}\},\"Text\":\{\"text\":\"\",\"styleId\":\"primary\",\"styleOverride\":\{\"size\":15\}\}\}"

const builtInMenuShortcut: String = "\{\"Offset\":\{\"x\":0,\"y\":-2\},\"Size\":\{\"w\":\{\"mode\":\"Hug\"\},\"h\":\{\"mode\":\"Hug\"\}\},\"Text\":\{\"text\":\"\",\"styleId\":\"muted\",\"styleOverride\":\{\"size\":14\}\}\}"

const builtInMenuSeparator: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":0,\"h\":9\},\"Size\":\{\"w\":\{\"mode\":\"Fill\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Padding\":\{\"l\":8,\"t\":4,\"r\":8,\"b\":4\},\"Layout\":\{\"type\":\"Vertical\",\"gap\":0\}\}"

const builtInMenuLine: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":0,\"h\":1\},\"Size\":\{\"w\":\{\"mode\":\"Fill\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Shape\":\{\"kind\":\"Rect\",\"fill\":\"outline\",\"radius\":0\}\}"

# The file browser's (ui/fileBrowser): a row of a column, and a column's body
const builtInFileRow: String = "\{\"Layout\":\{\"type\":\"Stack\"\},\"Shape\":\{\"kind\":\"RoundedRect\",\"radius\":5\}\}"

const builtInFileColumn: String = "\{\"Padding\":\{\"l\":4,\"t\":4,\"r\":4,\"b\":4\}\}"

# A drag's label (ui/DragSystem): its panel, its text, and its icon and mark
const builtInDragLabel: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":0,\"h\":28\},\"Size\":\{\"w\":\{\"mode\":\"Hug\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Layout\":\{\"type\":\"Horizontal\",\"gap\":6,\"alignCross\":\"Center\"\},\"Padding\":\{\"l\":9,\"t\":0,\"r\":8,\"b\":0\},\"Shape\":\{\"kind\":\"RoundedRect\",\"fill\":\"surfaceAlt\",\"stroke\":\"outline\",\"strokeWidth\":1,\"radius\":7\},\"Shadow\":\{\"blur\":16,\"opacity\":0.4\}\}"

const builtInDragText: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":0,\"h\":20\},\"Size\":\{\"w\":\{\"mode\":\"Hug\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Text\":\{\"text\":\"\",\"styleId\":\"primary\",\"styleOverride\":\{\"size\":14\}\}\}"

const builtInDragEffect: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":16,\"h\":16\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Sprite\":\{\"textureKey\":\"mat:block\",\"scaleMode\":\"Fit\",\"tint\":\"textMuted\"\}\}"

# The built-in bundle `name`'s JSON object, or "" when lib/ui has none
func builtInBundleJson(name: view String) ret String {
  if name is "dragLabel" {
    ret builtInDragLabel
  }
  if name is "dragText" {
    ret builtInDragText
  }
  if name is "dragEffect" {
    ret builtInDragEffect
  }
  if name is "fileRow" {
    ret builtInFileRow
  }
  if name is "fileColumn" {
    ret builtInFileColumn
  }
  if name is "appearFade" {
    ret builtInAppearFade
  }
  if name is "appearRise" {
    ret builtInAppearRise
  }
  if name is "appearPop" {
    ret builtInAppearPop
  }
  if name is "appearDrop" {
    ret builtInAppearDrop
  }
  if name is "disappearFade" {
    ret builtInDisappearFade
  }
  if name is "disappearShrink" {
    ret builtInDisappearShrink
  }
  if name is "staggerFromEnd" {
    ret builtInStaggerFromEnd
  }
  if name is "staggerFromStart" {
    ret builtInStaggerFromStart
  }
  if name is "pressable" {
    ret builtInPressable
  }
  if name is "dialogMotion" {
    ret builtInDialogMotion
  }
  if name is "glideOnChange" {
    ret builtInGlideOnChange
  }
  if name is "circleButton" {
    ret builtInCircleButton
  }
  if name is "switch" {
    ret builtInSwitch
  }
  if name is "menuPanel" {
    ret builtInMenuPanel
  }
  if name is "menuRow" {
    ret builtInMenuRow
  }
  if name is "menuIcon" {
    ret builtInMenuIcon
  }
  if name is "menuText" {
    ret builtInMenuText
  }
  if name is "menuShortcut" {
    ret builtInMenuShortcut
  }
  if name is "menuSeparator" {
    ret builtInMenuSeparator
  }
  if name is "menuLine" {
    ret builtInMenuLine
  }
  ret ""
}
