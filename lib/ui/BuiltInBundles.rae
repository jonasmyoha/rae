# Built-in bundles: named component sets lib/ui itself provides, so every
# scene can use them without declaring them in its theme
# (docs/ui-scene-format.md §9). A scene's own `bundles` block and its
# imports come first: a theme that declares the same name replaces the
# built-in one. They carry SHAPE and PLACEMENT, never colors, so they
# combine with a theme's look: `"bundles": ["secondaryButton",
# "circleButton"]` is the theme's button drawn as a true circle.
#
#   circleButton  a round button for an icon: a 44-point square box (the
#                 smallest touch target; a node's own Rect sets another
#                 size, keep it square), a Circle shape (its fill and
#                 stroke come from an earlier bundle or the node), and its
#                 child (the icon) centered; a tap anywhere in the square
#                 counts (lib/ui tests taps against the node's box)
#
#   switch        an on/off switch (ui/switchSystem): a 52 by 32 point box, a Switch, and an
#                 OnClick so that a tap reaches it (a node's own OnClick adds its label)
const builtInSwitch: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":52,\"h\":32\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Switch\":\{\},\"OnClick\":\{\}\}"

const builtInCircleButton: String = "\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":44,\"h\":44\},\"Size\":\{\"w\":\{\"mode\":\"Fixed\"\},\"h\":\{\"mode\":\"Fixed\"\}\},\"Shape\":\{\"kind\":\"Circle\",\"radius\":0\},\"Layout\":\{\"type\":\"Stack\",\"alignMain\":\"Center\",\"alignCross\":\"Center\"\}\}"

# Motion (docs/ui-animation-design.md section 4): one bundle on a node gives it good motion. A
# node's
# own component wins field by field: "bundles": ["appearRise"], "Appear": { "y": 40 }.
const builtInAppearFade: String = "\{\"Appear\":\{\"motion\":\"smooth\",\"y\":0\}\}"

const builtInAppearRise: String = "\{\"Appear\":\{\"motion\":\"smooth\",\"y\":16\}\}"

const builtInAppearPop: String = "\{\"Appear\":\{\"motion\":\"lively\",\"y\":0,\"scale\":0.86\}\}"

const builtInAppearDrop: String = "\{\"Appear\":\{\"motion\":\"lively\",\"y\":-24\}\}"

const builtInDisappearFade: String = "\{\"Disappear\":\{\"scale\":1\}\}"

const builtInDisappearShrink: String = "\{\"Disappear\":\{\"scale\":0.94\}\}"

const builtInStaggerFromEnd: String = "\{\"Stagger\":\{\"appearFrom\":\"end\",\"disappearFrom\":\"start\"\}\}"

const builtInStaggerFromStart: String = "\{\"Stagger\":\{\"appearFrom\":\"start\",\"disappearFrom\":\"end\"\}\}"

const builtInPressable: String = "\{\"HoverScale\":\{\"pressedScale\":0.96\}\}"

const builtInDialogMotion: String = "\{\"Appear\":\{\"motion\":\"lively\",\"y\":0,\"scale\":0.9\},\"Disappear\":\{\"scale\":0.96\}\}"

# The built-in bundle `name`'s JSON object, or "" when lib/ui has none
func builtInBundleJson(name: view String) ret String {
  if name is "appearFade" {
    ret builtInAppearFade
  }
  if name is "appearRise" {
    ret builtInAppearRise
  }
  if name is "appearPop" {
    ret builtInAppearPop
  }
  if name is "appearDrop" {
    ret builtInAppearDrop
  }
  if name is "disappearFade" {
    ret builtInDisappearFade
  }
  if name is "disappearShrink" {
    ret builtInDisappearShrink
  }
  if name is "staggerFromEnd" {
    ret builtInStaggerFromEnd
  }
  if name is "staggerFromStart" {
    ret builtInStaggerFromStart
  }
  if name is "pressable" {
    ret builtInPressable
  }
  if name is "dialogMotion" {
    ret builtInDialogMotion
  }
  if name is "circleButton" {
    ret builtInCircleButton
  }
  if name is "switch" {
    ret builtInSwitch
  }
  ret ""
}
