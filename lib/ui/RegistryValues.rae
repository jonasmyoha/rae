# RegistryValues — the value-level JSON decoders the component deserializers
# share (#918 split of ui/Registry for the 1000-line cap): the enum-name
# parsers (parseSizeMode / parseLayoutType / ... — `enumFromName` lookups since
# #960), the small
# value decoders (deserInsets / deserVec2 / deserRgba / deserSizeAxis /
# deserRect / deserSize) and the data-resource / field id lookups.
# ui/RegistryDeser's `deser<Component>` functions are built on these.
open ui/RegistryOpt
open ui/RegistryGeneric
open ui/ContainerStyle
import Json
import ui/Theme
import ui/Spacing
import ui/ThemeResolved
open ecs/ComponentTable
open ui/Registry
open ui/RegistryDeser

# The authored enum vocabulary is PascalCase ("Horizontal"); each parser is
# the compile-time member lookup `enumFromName` (#960) over the camelCase
# case name, with the same default the old `if text is` ladder fell back to.
# `parseScaleMode` keeps its one alias ("Cover" = fill, CSS object-fit).
func parseSizeMode(text: view String) ret SizeMode {
  if let kind: SizeMode = enumFromName(SizeMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret SizeMode.fixed
}

func parseLayoutType(text: view String) ret LayoutType {
  if let kind: LayoutType = enumFromName(LayoutType, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret LayoutType.none
}

func parseAlignKind(text: view String) ret AlignKind {
  if let kind: AlignKind = enumFromName(AlignKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret AlignKind.start
}

func parseShapeKind(text: view String) ret ShapeKind {
  if let kind: ShapeKind = enumFromName(ShapeKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret ShapeKind.rect
}

func parseScaleMode(text: view String) ret ScaleMode {
  # CSS object-fit vocabulary (S6): Cover = aspect-preserving crop (same as
  # Fill), Contain = aspect-preserving letterbox (same as the Fit default).
  let cover: String = "Cover"
  if text is cover {
    ret ScaleMode.fill
  }
  if let kind: ScaleMode = enumFromName(ScaleMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret ScaleMode.fit
}

func parseWrapWidthMode(text: view String) ret WrapWidthMode {
  if let kind: WrapWidthMode = enumFromName(WrapWidthMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret WrapWidthMode.none
}

func parseHitAreaKind(text: view String) ret HitAreaKind {
  if let kind: HitAreaKind = enumFromName(HitAreaKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret HitAreaKind.rect
}

func parseMaskKind(text: view String) ret MaskKind {
  if let kind: MaskKind = enumFromName(MaskKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret MaskKind.circle
}

func parseResolverMode(text: view String) ret ResolverMode {
  if let kind: ResolverMode = enumFromName(ResolverMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret ResolverMode.fixed
}

func parseTextFormat(text: view String) ret TextFormat {
  if let kind: TextFormat = enumFromName(TextFormat, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret TextFormat.plain
}

# -----------------------------------------------------------------
# Sub-type deserialisers
# -----------------------------------------------------------------
func deserInsets(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Insets {
  let l: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "l"
    fallback: 0.0
  )
  let t: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "t"
    fallback: 0.0
  )
  let r: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "r"
    fallback: 0.0
  )
  let b: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "b"
    fallback: 0.0
  )
  ret Insets { l: l, t: t, r: r, b: b }
}

func deserVec2(doc: view JsonDoc, val: view JsonValue) ret Vec2 {
  let x: Float = optFloat(
    doc: doc
    container: val
    key: "x"
    fallback: 0.0
  )
  let y: Float = optFloat(
    doc: doc
    container: val
    key: "y"
    fallback: 0.0
  )
  ret Vec2 { x: x, y: y }
}

func deserRgba(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret RgbaColor {
  # Theme token form: scene authors can write `"fill": "surface"`
  # instead of `"fill": {r:..,g:..,b:..,a:..}` to pick a color from
  # the current `activeTheme` in `lib/ui/theme.rae`. The JSON shape
  # already disambiguates — a literal color is an object, a token
  # reference is a string — so no sigil is needed. Unknown token
  # names render magenta via `colorByName` rather than failing
  # silently, so typos are visible.
  let empty: String = ""
  let asStr: String = Json.jsonString(this: val, fallback: empty)
  if asStr.length() > 0 {
    ret colorByName(theme: theme.active, name: asStr)
  }
  let r: Int = optInt(
    doc: doc
    container: val
    key: "r"
    fallback: 0
  )
  let g: Int = optInt(
    doc: doc
    container: val
    key: "g"
    fallback: 0
  )
  let b: Int = optInt(
    doc: doc
    container: val
    key: "b"
    fallback: 0
  )
  let a: Int = optInt(
    doc: doc
    container: val
    key: "a"
    fallback: 255
  )
  ret RgbaColor { r: r, g: g, b: b, a: a }
}

func deserSizeAxis(doc: view JsonDoc, val: view JsonValue) ret SizeAxis {
  let modeStr: String = optString(
    doc: doc
    container: val
    key: "mode"
    fallback: "Fixed"
  )
  let mode: SizeMode = parseSizeMode(text: modeStr)
  let minV: Int = optInt(
    doc: doc
    container: val
    key: "min"
    fallback: -1
  )
  let maxV: Int = optInt(
    doc: doc
    container: val
    key: "max"
    fallback: -1
  )
  ret SizeAxis { mode: mode, min: minV, max: maxV }
}

# -----------------------------------------------------------------
# Component deserialisers — call site is the dispatch in
# `applyComponentByName`. Each function takes the JsonValue of the
# component bag (e.g. `{"x":0,"w":100}`) and produces the typed
# component.
# -----------------------------------------------------------------
func deserRect(doc: view JsonDoc, val: view JsonValue) ret Rect {
  # Wire format stays flat {x,y,w,h}; bridge into the Vec2 position/size pair.
  ret Rect {
    position: {
      x: optFloat(
        doc: doc
        container: val
        key: "x"
        fallback: 0.0
      )
      y: optFloat(
        doc: doc
        container: val
        key: "y"
        fallback: 0.0
      )
    }
    size: {
      x: optFloat(
        doc: doc
        container: val
        key: "w"
        fallback: 0.0
      )
      y: optFloat(
        doc: doc
        container: val
        key: "h"
        fallback: 0.0
      )
    }
  }
}

func deserSize(doc: view JsonDoc, val: view JsonValue) ret Size {
  let wIdx: Int = Json.field(doc: doc, this: val, key: "w")
  let hIdx: Int = Json.field(doc: doc, this: val, key: "h")
  var wAxis: SizeAxis = defaultSizeAxis()
  var hAxis: SizeAxis = defaultSizeAxis()
  if wIdx >= 0 {
    let wv: JsonValue = Json.jsonValueAt(doc: doc, idx: wIdx)
    wAxis = deserSizeAxis(doc: doc, val: wv)
  }
  if hIdx >= 0 {
    let hv: JsonValue = Json.jsonValueAt(doc: doc, idx: hIdx)
    hAxis = deserSizeAxis(doc: doc, val: hv)
  }
  ret Size { w: wAxis, h: hAxis }
}

func dataResourceIdFromString(name: view String) ret DataResourceId {
  if name is "albums" {
    ret DataResourceId.albums
  }
  if name is "history" {
    ret DataResourceId.history
  }
  if name is "library" {
    ret DataResourceId.library
  }
  if name is "playback" {
    ret DataResourceId.playback
  }
  if name is "playlists" {
    ret DataResourceId.playlists
  }
  if name is "spotify" {
    ret DataResourceId.spotify
  }
  if name is "settings" {
    ret DataResourceId.settings
  }
  if name is "debug" {
    ret DataResourceId.debug
  }
  ret DataResourceId.none
}

func dataFieldIdFromString(name: view String) ret DataFieldId {
  if name is "all" {
    ret DataFieldId.all
  }
  if name is "isPlaying" {
    ret DataFieldId.isPlaying
  }
  if name is "likedTrack" {
    ret DataFieldId.likedTrack
  }
  if name is "playingTrack" {
    ret DataFieldId.playingTrack
  }
  if name is "debugToggle" {
    ret DataFieldId.debugToggle
  }
  ret DataFieldId.none
}
