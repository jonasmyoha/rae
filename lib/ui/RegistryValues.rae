# RegistryValues — the value-level JSON decoders behind the generic component
# decoder (ui/RegistryGeneric, #961) and the registry's fixups: the enum-name
# parsers (parseSizeMode / parseLayoutType / ... — `enumFromName` lookups since
# #960), the small
# value decoders (deserInsets / deserVec2 / deserRgba / deserSizeAxis /
# deserSizeAxis) and the data-resource / field id lookups, plus the
# three authored shapes that are arrays or presence-flagged (styleOverride,
# SceneInstance overrides, ListView bindings).
open ui/RegistryOpt
open ui/RegistryGeneric
open ui/ContainerStyle
import Json
import ui/Theme
import ui/Spacing
import ui/ThemeResolved
open ecs/ComponentTable
open ui/Registry

# The authored enum vocabulary is PascalCase ("Horizontal"); each parser is
# the compile-time member lookup `enumFromName` (#960) over the camelCase
# case name, with the same default the old `if text is` ladder fell back to.
# `parseScaleMode` keeps its one alias ("Cover" = fill, CSS object-fit).
func parseSizeMode(text: view String) ret SizeMode {
  if let kind: SizeMode = enumFromName(SizeMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret SizeMode.fixed
}

func parseLayoutType(text: view String) ret LayoutType {
  if let kind: LayoutType = enumFromName(LayoutType, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret LayoutType.none
}

func parseAlignKind(text: view String) ret AlignKind {
  if let kind: AlignKind = enumFromName(AlignKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret AlignKind.start
}

func parseShapeKind(text: view String) ret ShapeKind {
  if let kind: ShapeKind = enumFromName(ShapeKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret ShapeKind.rect
}

func parseScaleMode(text: view String) ret ScaleMode {
  # CSS object-fit vocabulary (S6): Cover = aspect-preserving crop (same as
  # Fill), Contain = aspect-preserving letterbox (same as the Fit default).
  let cover: String = "Cover"
  if text is cover {
    ret ScaleMode.fill
  }
  if let kind: ScaleMode = enumFromName(ScaleMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret ScaleMode.fit
}

func parseWrapWidthMode(text: view String) ret WrapWidthMode {
  if let kind: WrapWidthMode = enumFromName(WrapWidthMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret WrapWidthMode.none
}

func parseHitAreaKind(text: view String) ret HitAreaKind {
  if let kind: HitAreaKind = enumFromName(HitAreaKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret HitAreaKind.rect
}

func parseMaskKind(text: view String) ret MaskKind {
  if let kind: MaskKind = enumFromName(MaskKind, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret MaskKind.circle
}

func parseResolverMode(text: view String) ret ResolverMode {
  if let kind: ResolverMode = enumFromName(ResolverMode, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret ResolverMode.fixed
}

func parseTextFormat(text: view String) ret TextFormat {
  if let kind: TextFormat = enumFromName(TextFormat, name: authoredEnumName(text: text)) {
    ret kind
  }
  ret TextFormat.plain
}

# -----------------------------------------------------------------
# Sub-type deserialisers
# -----------------------------------------------------------------
func deserInsets(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Insets {
  let l: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "l"
    fallback: 0.0
  )
  let t: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "t"
    fallback: 0.0
  )
  let r: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "r"
    fallback: 0.0
  )
  let b: Float = optFloatOrToken(
    doc: doc
    theme: theme
    container: val
    key: "b"
    fallback: 0.0
  )
  ret Insets { l: l, t: t, r: r, b: b }
}

func deserVec2(doc: view JsonDoc, val: view JsonValue) ret Vec2 {
  let x: Float = optFloat(
    doc: doc
    container: val
    key: "x"
    fallback: 0.0
  )
  let y: Float = optFloat(
    doc: doc
    container: val
    key: "y"
    fallback: 0.0
  )
  ret Vec2 { x: x, y: y }
}

func deserRgba(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret RgbaColor {
  # Theme token form: scene authors can write `"fill": "surface"`
  # instead of `"fill": {r:..,g:..,b:..,a:..}` to pick a color from
  # the current `activeTheme` in `lib/ui/theme.rae`. The JSON shape
  # already disambiguates — a literal color is an object, a token
  # reference is a string — so no sigil is needed. Unknown token
  # names render magenta via `colorByName` rather than failing
  # silently, so typos are visible.
  let empty: String = ""
  let asStr: String = Json.jsonString(this: val, fallback: empty)
  if asStr.length() > 0 {
    ret colorByName(theme: theme.active, name: asStr)
  }
  let r: Int = optInt(
    doc: doc
    container: val
    key: "r"
    fallback: 0
  )
  let g: Int = optInt(
    doc: doc
    container: val
    key: "g"
    fallback: 0
  )
  let b: Int = optInt(
    doc: doc
    container: val
    key: "b"
    fallback: 0
  )
  let a: Int = optInt(
    doc: doc
    container: val
    key: "a"
    fallback: 255
  )
  ret RgbaColor { r: r, g: g, b: b, a: a }
}

func deserSizeAxis(doc: view JsonDoc, val: view JsonValue) ret SizeAxis {
  let modeStr: String = optString(
    doc: doc
    container: val
    key: "mode"
    fallback: "Fixed"
  )
  let mode: SizeMode = parseSizeMode(text: modeStr)
  let minV: Int = optInt(
    doc: doc
    container: val
    key: "min"
    fallback: -1
  )
  let maxV: Int = optInt(
    doc: doc
    container: val
    key: "max"
    fallback: -1
  )
  ret SizeAxis { mode: mode, min: minV, max: maxV }
}

# -----------------------------------------------------------------
# Component deserialisers — call site is the dispatch in
# `applyComponentByName`. Each function takes the JsonValue of the
# component bag (e.g. `{"x":0,"w":100}`) and produces the typed
# component.
# -----------------------------------------------------------------

# The data-source / field ids are enum members spelled exactly as authored
# ("albums", "isPlaying"), so the lookup is the compile-time member table.
func dataResourceIdFromString(name: view String) ret DataResourceId {
  if let id: DataResourceId = enumFromName(DataResourceId, name: name) {
    ret id
  }
  ret DataResourceId.none
}

func dataFieldIdFromString(name: view String) ret DataFieldId {
  if let id: DataFieldId = enumFromName(DataFieldId, name: name) {
    ret id
  }
  ret DataFieldId.none
}

# Tier-2 partial style override (#236): the `styleOverride` sub-object of a
# Text bag. Presence-flagged: only the scalars the author wrote are applied
# over the resolved style at paint; a colour may be a palette slot.
func deserStyleOverride(
  doc: view JsonDoc
  theme: view UiTheme
  val: view JsonValue
) ret StyleOverride {
  var so: StyleOverride = defaultStyleOverride()
  let sizeIdx: Int = Json.field(doc: doc, this: val, key: "size")
  if sizeIdx >= 0 {
    so.hasSize = true
    so.size = optFloat(
      doc: doc
      container: val
      key: "size"
      fallback: 0.0
    )
  }
  let colorIdx: Int = Json.field(doc: doc, this: val, key: "color")
  if colorIdx >= 0 {
    so.hasColor = true
    let cv: JsonValue = Json.jsonValueAt(doc: doc, idx: colorIdx)
    so.color = deserRgba(doc: doc, theme: theme, val: cv)
    let emptySlot: String = ""
    so.colorSlot = Json.jsonString(this: cv, fallback: emptySlot)
  }
  ret so
}

# `SceneInstance.params.overrides`: an array of {nodeId, component, field,
# value} records, stored as four parallel lists on the component.
func deserSceneInstanceOverrides(
  instance: mod SceneInstance
  doc: view JsonDoc
  val: view JsonValue
) {
  let paramsIdx: Int = Json.field(doc: doc, this: val, key: "params")
  if paramsIdx < 0 {
    ret
  }
  let paramsVal: JsonValue = Json.jsonValueAt(doc: doc, idx: paramsIdx)
  let overridesIdx: Int = Json.field(doc: doc, this: paramsVal, key: "overrides")
  if overridesIdx < 0 {
    ret
  }
  let arr: JsonValue = Json.jsonValueAt(doc: doc, idx: overridesIdx)
  let n: Int = Json.arrayLen(this: arr)
  let empty: String = ""
  var i: Int = 0
  loop i < n {
    let elem: JsonValue = Json.arrayAt(doc: doc, this: arr, idx: i)
    instance.overrideNodeIds.add(value: optString(
      doc: doc
      container: elem
      key: "nodeId"
      fallback: empty
    ))
    instance.overrideComponents.add(value: optString(
      doc: doc
      container: elem
      key: "component"
      fallback: empty
    ))
    instance.overrideFields.add(value: optString(
      doc: doc
      container: elem
      key: "field"
      fallback: empty
    ))
    instance.overrideValues.add(value: optString(
      doc: doc
      container: elem
      key: "value"
      fallback: empty
    ))
    i = i + 1
  }
}

# `ListView.bindings`: an array of {nodeId, component, field, itemField,
# prefix, suffix} records.
func deserListViewBindings(doc: view JsonDoc, val: view JsonValue) ret List(ListViewBinding) {
  var bindings: List(ListViewBinding) = List.create(ListViewBinding, cap: 4)
  let bindingsIdx: Int = Json.field(doc: doc, this: val, key: "bindings")
  if bindingsIdx < 0 {
    ret bindings
  }
  let arr: JsonValue = Json.jsonValueAt(doc: doc, idx: bindingsIdx)
  let n: Int = Json.arrayLen(this: arr)
  let empty: String = ""
  var i: Int = 0
  loop i < n {
    let elem: JsonValue = Json.arrayAt(doc: doc, this: arr, idx: i)
    let binding: ListViewBinding = {
      nodeId: optString(
        doc: doc
        container: elem
        key: "nodeId"
        fallback: empty
      )
      componentName: optString(
        doc: doc
        container: elem
        key: "component"
        fallback: empty
      )
      fieldName: optString(
        doc: doc
        container: elem
        key: "field"
        fallback: empty
      )
      itemField: optString(
        doc: doc
        container: elem
        key: "itemField"
        fallback: empty
      )
      prefix: optString(
        doc: doc
        container: elem
        key: "prefix"
        fallback: empty
      )
      suffix: optString(
        doc: doc
        container: elem
        key: "suffix"
        fallback: empty
      )
    }
    bindings.add(value: binding)
    i = i + 1
  }
  ret bindings
}
