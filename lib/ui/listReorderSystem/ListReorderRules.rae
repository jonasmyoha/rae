# The arithmetic of reordering a list (ui/listReorderSystem), as plain
# numbers: where a lifted row would land, how far the other rows step aside,
# where each row goes once the move is made, the easing, and how fast the
# list scrolls while the finger is near an end. Positions are along the
# list's content: row `index` rests at `index * pitch`.
open ui/animationSystem/AnimationSystem
import Math

# The indexes a row lifted at `index` may land on: `low` to `high`, the rows
# between the fixed rows around it (`fixed`: one Bool per row, true for a
# row that stays where it is, ListReorder.fixedField)
type ReorderSpan {
  low: Int
  high: Int
}

func reorderSpan(fixed: view List(Bool), index: view Int) ret ReorderSpan {
  var low: Int = 0
  loop var i: Int = index - 1, i >= 0, --i {
    if fixed.copyAtFallback(index: i, fallback: false) {
      low = i + 1
      break
    }
  }
  var high: Int = fixed.length - 1
  loop var i: Int = index + 1, i < fixed.length, ++i {
    if fixed.copyAtFallback(index: i, fallback: false) {
      high = i - 1
      break
    }
  }
  ret ReorderSpan { low: low, high: high }
}

# After a drop, the app's new rows by key: for each new row, how far from
# its resting place it is drawn now (where the same key was drawn,
# `drawnAt`, one per old row), so it eases from there; 0 for a row that is
# new
func reorderKeyedShifts(
  oldKeys: view List(String)
  drawnAt: view List(Float)
  newKeys: view List(String)
  pitch: view Float
) ret List(Float) {
  var shifts: List(Float) = List.create(Float, cap: newKeys.length)
  loop var index: Int = 0, index < newKeys.length, ++index {
    var shift: Float = 0.0
    let key: String = newKeys.copyAtFallback(index: index, fallback: "")
    loop var old: Int = 0, old < oldKeys.length, ++old {
      if oldKeys.copyAtFallback(index: old, fallback: "") is key {
        shift = drawnAt.copyAtFallback(index: old, fallback: index.toFloat() * pitch) - index.toFloat() * pitch
      }
    }
    shifts.add(value: shift)
  }
  ret shifts
}

# The index a lifted row whose top is at `rowY` would land on
func reorderTargetIndex(rowY: view Float, pitch: view Float, count: view Int) ret Int {
  if pitch <= 0.0 or count <= 0 {
    ret 0
  }
  var index: Int = Math.floor(x: rowY / pitch + 0.5).toInt()
  if index < 0 {
    index = 0
  }
  if index > count - 1 {
    index = count - 1
  }
  ret index
}

# How far row `index` (not the lifted one) steps aside while the row from
# `fromIndex` hovers over `toIndex`: the rows between move one pitch toward
# the place the lifted row left
func reorderShiftTarget(
  index: view Int
  fromIndex: view Int
  toIndex: view Int
  pitch: view Float
) ret Float {
  if fromIndex < toIndex and index > fromIndex and index <= toIndex {
    ret 0.0 - pitch
  }
  if toIndex < fromIndex and index >= toIndex and index < fromIndex {
    ret pitch
  }
  ret 0.0
}

# Where row `index` is once the row at `fromIndex` has moved to `toIndex`
func reorderNewIndex(index: view Int, fromIndex: view Int, toIndex: view Int) ret Int {
  if index is fromIndex {
    ret toIndex
  }
  if fromIndex < toIndex and index > fromIndex and index <= toIndex {
    ret index - 1
  }
  if toIndex < fromIndex and index >= toIndex and index < fromIndex {
    ret index + 1
  }
  ret index
}

# `current` eased toward `target` over `seconds` (about 95% of the way in 3 / rate seconds)
func reorderEase(
  current: view Float
  target: view Float
  seconds: view Float
  rate: view Float
) ret Float {
  ret easeTowards(
    current: current
    target: target
    speed: rate
    deltaTime: seconds
    epsilon: 0.25
  )
}

# The auto-scroll speed in points per second while the finger is at
# `pointer`, inside a window from `windowStart` to `windowEnd` along the
# list: positive near the start (the content moves toward the end, showing
# earlier rows), negative near the end, 0 in the middle; `maxSpeed` at the
# very edge
func reorderScrollSpeed(
  pointer: view Float
  windowStart: view Float
  windowEnd: view Float
  edge: view Float
  maxSpeed: view Float
) ret Float {
  if edge <= 0.0 or windowEnd - windowStart < edge * 2.0 {
    ret 0.0
  }
  let fromStart: Float = pointer - windowStart
  if fromStart < edge {
    var depth: Float = 1.0 - fromStart / edge
    if depth > 1.0 {
      depth = 1.0
    }
    ret maxSpeed * depth * depth
  }
  let fromEnd: Float = windowEnd - pointer
  if fromEnd < edge {
    var depth: Float = 1.0 - fromEnd / edge
    if depth > 1.0 {
      depth = 1.0
    }
    ret 0.0 - maxSpeed * depth * depth
  }
  ret 0.0
}

# The UI action a drop fires: `<actionId>.<from>.<to>`, a template action's
# id with the move as its payload
func reorderActionId(actionId: view String, fromIndex: view Int, toIndex: view Int) ret String {
  ret "{actionId}.{fromIndex}.{toIndex}"
}
