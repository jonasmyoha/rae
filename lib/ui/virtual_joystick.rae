# Virtual joystick — reusable touch/mouse movement stick for the Rae UI stdlib.
#
# Renders a translucent base ring + a draggable knob in gpu2d DESIGN units and
# outputs a normalized 2D vector (valueX right, valueY up/forward). It ACTIVATES
# only when a press starts inside its activation zone, so the rest of the screen
# stays free for camera drag; report `active` so the caller can suppress other
# pointer uses (e.g. camera look) for the same touch. Single-pointer: on a device
# without multitouch the stick and camera take turns, not simultaneously.
#
#   let stick = createVirtualJoystick(baseX, baseY, baseRadius)   # once
#   let active = updateVirtualJoystick(joy: stick)                # each frame
#   ... use stick.valueX / stick.valueY for movement ...
#   drawVirtualJoystick(joy: stick)                               # in the 2D pass
import core
import gpu2d
import math

# The anchor is stored as FRACTIONS of the design canvas (left pad / bottom pad /
# radius as a fraction of the shorter side), so the stick sits in the same
# lower-left spot regardless of window size, aspect or orientation — resolved to
# absolute design units each frame.
type VirtualJoystick {
  padFracX: Float    # left margin as a fraction of design width
  padFracY: Float    # bottom margin as a fraction of design height
  radiusFrac: Float  # base radius as a fraction of min(designW, designH)
  baseX: Float
  baseY: Float
  baseRadius: Float
  knobRadius: Float
  active: Bool
  grabbedId: Int  # finger id currently owned (-1 = none); held until it lifts
  knobX: Float
  knobY: Float
  valueX: Float   # -1..1, right positive
  valueY: Float   # -1..1, up (forward) positive
}

func createVirtualJoystick(padFracX: copy Float, padFracY: copy Float,
                           radiusFrac: copy Float) pub ret VirtualJoystick {
  ret VirtualJoystick {
    padFracX: padFracX, padFracY: padFracY, radiusFrac: radiusFrac,
    baseX: 0.0, baseY: 0.0, baseRadius: 0.0, knobRadius: 0.0,
    active: false, grabbedId: 0 - 1, knobX: 0.0, knobY: 0.0, valueX: 0.0, valueY: 0.0
  }
}

# Resolve the absolute base position from the CURRENT design canvas (lower-left).
func resolveVirtualJoystick(joy: mod VirtualJoystick) {
  let dw: Float = gpu2d.designWidth()
  let dh: Float = gpu2d.designHeight()
  var shorter: Float = dw
  if dh < shorter { shorter = dh }
  joy.baseRadius = shorter * joy.radiusFrac
  joy.knobRadius = joy.baseRadius * 0.42
  joy.baseX = gpu2d.safeLeft() + dw * joy.padFracX + joy.baseRadius
  joy.baseY = dh - gpu2d.safeBottom() - dh * joy.padFracY - joy.baseRadius
}

# Radius of the activation zone (design units). A finger going down inside this
# radius of the base belongs to the stick; the camera rig excludes the SAME zone
# so the two are exactly complementary. Valid after resolveVirtualJoystick.
func virtualJoystickZoneRadius(joy: view VirtualJoystick) pub ret Float {
  ret joy.baseRadius * 1.7
}

# Poll the current pointer (gpu2d, design units). Returns true while the stick is
# capturing the pointer this frame.
func updateVirtualJoystick(joy: mod VirtualJoystick) pub ret Bool {
  resolveVirtualJoystick(joy: joy)
  let zone: Float = virtualJoystickZoneRadius(joy: joy)
  var px: Float = 0.0
  var py: Float = 0.0
  let touches: Int = gpu2d.touchCount()
  if touches > 0 {
    # Multitouch GRAB: own a finger from the moment it presses inside the zone and
    # keep it for the whole drag (even if it leaves the zone), so the gesture can
    # never turn into a camera rotation mid-drag. Another finger stays free.
    var found: Bool = false
    var index: Int = 0
    loop index < touches {
      let id: Int = gpu2d.touchId(index: index)
      let tx: Float = gpu2d.touchX(index: index)
      let ty: Float = gpu2d.touchY(index: index)
      let pressed: Bool = gpu2d.touchPressed(index: index)
      # Reused-id release: a fresh press on the id we hold means SDL recycled the
      # id after our finger lifted (see camera_rig). A hold is never a fresh press
      # — drop it so the grab below re-decides by zone, else a reused id keeps the
      # stick and the camera fighting over one finger.
      if joy.grabbedId >= 0 and id is joy.grabbedId and pressed { joy.grabbedId = 0 - 1 }
      if joy.grabbedId >= 0 and id is joy.grabbedId {
        px = tx
        py = ty
        found = true
      }
      if joy.grabbedId < 0 and pressed {
        let d2: Float = (tx - joy.baseX) * (tx - joy.baseX) + (ty - joy.baseY) * (ty - joy.baseY)
        if d2 <= zone * zone {
          joy.grabbedId = id
          px = tx
          py = ty
          found = true
        }
      }
      index = index + 1
    }
    if found is false { joy.grabbedId = 0 - 1 }
    joy.active = found
  } else {
    # Desktop: the mouse pointer.
    px = gpu2d.pointerX()
    py = gpu2d.pointerY()
    if gpu2d.pointerPressed() {
      let ax: Float = px - joy.baseX
      let ay: Float = py - joy.baseY
      if ax * ax + ay * ay <= zone * zone { joy.active = true }
    }
    if not gpu2d.pointerDown() { joy.active = false }
  }
  if joy.active {
    var dx: Float = px - joy.baseX
    var dy: Float = py - joy.baseY
    let dist: Float = math.sqrt(x: dx * dx + dy * dy)
    if dist > joy.baseRadius and dist > 0.0001 {
      let scale: Float = joy.baseRadius / dist
      dx = dx * scale
      dy = dy * scale
    }
    joy.knobX = joy.baseX + dx
    joy.knobY = joy.baseY + dy
    joy.valueX = dx / joy.baseRadius
    joy.valueY = 0.0 - dy / joy.baseRadius   # screen-down is +y; forward is up
  } else {
    joy.knobX = joy.baseX
    joy.knobY = joy.baseY
    joy.valueX = 0.0
    joy.valueY = 0.0
  }
  ret joy.active
}

# Draw the base ring + knob (translucent white so it reads over any scene). A
# rounded rect with radius = half its size is a circle. Call inside the 2D pass.
func drawVirtualJoystick(joy: view VirtualJoystick) pub {
  let baseDiam: Float = joy.baseRadius * 2.0
  gpu2d.drawRoundedRect(x: joy.baseX - joy.baseRadius, y: joy.baseY - joy.baseRadius,
    w: baseDiam, h: baseDiam, radius: joy.baseRadius, color: 0x38FFFFFF)
  let knobDiam: Float = joy.knobRadius * 2.0
  gpu2d.drawRoundedRect(x: joy.knobX - joy.knobRadius, y: joy.knobY - joy.knobRadius,
    w: knobDiam, h: knobDiam, radius: joy.knobRadius, color: 0xB0FFFFFF)
}
