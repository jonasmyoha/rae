# dialogSystem — presenting a page over the screen, as a dialog or as a page
# (ui/Dialog has the model). lib/app3d/UiShell's `presentPage` mounts a
# scene and calls `presentMountedPage`; an app that mounts its own calls it
# directly. A presented page lives on the "dialog" layer (ui/Layer; made if
# the app has none), under a host root that fills the screen:
#
#   * dialog: the host holds a scrim (a full-screen dimming rectangle that
#     takes every tap outside the card, firing DialogOptions.dismissActionId)
#     and a slot with the page's root in it, in the middle of the screen or
#     at its bottom (DialogOptions.placement), as wide as it may be
#     (maxWidth, less the margins on a narrow screen) and as tall as its
#     content;
#   * page: the page's root fills the host.
#
# Either way it is modal: taps go to the topmost layer first (uiHitTest), so
# nothing under it can be pressed, and `presentedPageBlocks` tells the
# scroll root (and other pointer systems) to leave content under it alone.
# `dialogSystem`, each frame with UI actions, closes a dialog whose own
# button fired one (DialogOptions.closeOnAction), after the app has seen the
# action. `closePresentedPage` closes one any time.
#
# Motion (docs/ui-animation-design.md section 9): the scrim fades, and the card plays its root's
# Appear
# and Disappear; a dialog with neither gets the bundle dialogMotion, so a scene needs no change. A
# close has two steps. The page stops being presented at once: it is out of presentedPageCount, its
# node ids are gone, and a new one can open. Its host stays with Leaving and takes no input until
# its tracks end, then it is destroyed. A dialog with another over it scales to 0.97 and comes back.
# A full page follows its root's PageTransition, a sheet by default, over the screen, which stays
# still.
# Its arrival only waits in the inbox here: a host that runs no animation never takes it, shows the
# page
# in place, and closes it at once.
import ui/BundleApply
import ui/Components
open ui/AnimationComponents
open ui/Ecs
open ui/UiSystems
open ui/animationSystem/AnimationRules
open ui/animationSystem/AnimationTracks
open ui/animationSystem/AnimationTriggers
open ui/Dialog
open ecs/Queue
open ui/pageTransitionSystem/PageTransitionRules
open ui/pageTransitionSystem/PageTransitionSystem
open ui/Layer
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ecs/Event
open ecs/hierarchySystem/HierarchySystem

# The scrim's dimming, black at this opacity (0..255)
const dialogScrimAlpha: Int = 140

# How far a dialog steps back while another is over it
const dialogUnderScale: Float = 0.97

func dialogOptionsOf(world: view UiWorld, pageRoot: view EntityId) ret DialogOptions {
  if let options: DialogOptions = componentCopy(this: world.dialogOptions, entityId: pageRoot) {
    ret options
  }
  ret DialogOptions { maxWidth: 360.0 }
}

# Show the mounted page `pageRoot` (its node ids under `pageId`, as
# loadSceneIntoPage scoped them) over everything else, then set the fields
# `overrides` name on its nodes (the text of a message, the action of a
# button: SceneOverride, as a SceneInstance's). Returns the host, the handle
# to close it with.
func presentMountedPage(
  world: mod UiWorld
  uiSystems: mod UiSystems
  pageRoot: view EntityId
  pageId: view String
  overrides: view List(SceneOverride)
) ret EntityId {
  var layer: EntityId = findLayerEntity(world: world, id: layerDialogId)
  if isNone(this: layer) {
    layer = createLayerEntity(world: world, id: "{layerDialogId}", order: layerDialogOrder)
  }
  var presentation: PagePresentation = PagePresentation.page
  if componentHas(this: world.pageRoots, entityId: pageRoot) {
    presentation = componentView(this: world.pageRoots, entityId: pageRoot).presentation
  }
  let options: DialogOptions = dialogOptionsOf(world: world, pageRoot: pageRoot)
  var order: Int = 1
  loop var i: Int = 0, i < componentCount(this: world.presentedPages), ++i {
    let presented: view PresentedPage = queryViewAt(table: world.presentedPages, denseIndex: i)
    if presented.order >= order {
      order = presented.order + 1
    }
  }

  # It is about to have one over it
  dialogStepBack(
    world: world
    uiSystems: uiSystems
    under: topPresentedPage(world: world)
    presentation: presentation
  )

  let host: EntityId = createEntity(world: world)
  componentSet(
    this: world.rects
    entityId: host
    data: Rect {
      position: Vec2 { x: 0.0, y: 0.0 }
      size: Vec2 { x: world.layoutW, y: world.layoutH }
    }
  )
  componentSet(
    this: world.sizes
    entityId: host
    data: Size { w: SizeAxis { mode: SizeMode.fill }, h: SizeAxis { mode: SizeMode.fill } }
  )
  componentSet(
    this: world.layouts
    entityId: host
    data: Layout {
      kind: LayoutType.stack
      gap: 0.0
      alignMain: AlignKind.center
      alignCross: AlignKind.center
      columns: 0
      rowGap: 0.0
      columnGap: 0.0
    }
  )
  componentSet(this: world.layerRefs, entityId: host, data: LayerRef { layer: layer })

  # The dialog's slot (none for a page)
  var slot: EntityId = noEntity()
  var scrim: EntityId = noEntity()
  if presentation is PagePresentation.dialog {
    scrim = createEntity(world: world)
    applyBundle(world: world, entityId: scrim, name: "appearFade")
    applyBundle(world: world, entityId: scrim, name: "disappearFade")
    if componentHas(this: world.appears, entityId: pageRoot) is false and componentHas(
      this: world.disappears
      entityId: pageRoot
    ) is false {
      applyBundle(world: world, entityId: pageRoot, name: "dialogMotion")
    }
    componentSet(
      this: world.rects
      entityId: scrim
      data: Rect {
        position: Vec2 { x: 0.0, y: 0.0 }
        size: Vec2 { x: world.layoutW, y: world.layoutH }
      }
    )
    componentSet(
      this: world.sizes
      entityId: scrim
      data: Size { w: SizeAxis { mode: SizeMode.fill }, h: SizeAxis { mode: SizeMode.fill } }
    )
    var dim: Shape = defaultShape()
    dim.kind = ShapeKind.rect
    dim.fill = RgbaColor { r: 0, g: 0, b: 0, a: dialogScrimAlpha }
    componentSet(this: world.shapes, entityId: scrim, data: own dim)
    componentSet(
      this: world.pointerEvents
      entityId: scrim
      data: PointerEvents { enabled: true, cursor: "default", blockChildren: false }
    )
    if options.dismissActionId.length() > 0 {
      componentSet(
        this: world.onClicks
        entityId: scrim
        data: OnClick { actionId: "{options.dismissActionId}", label: "{options.dismissLabel}" }
      )
    }
    setParent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: scrim
      parent: host
    )
    # The slot the card sits in: the whole screen, its content in the
    # middle, or at the bottom above the safe area. It is not clickable, so
    # a tap beside the card still lands on the scrim.
    slot = createEntity(world: world)
    componentSet(
      this: world.rects
      entityId: slot
      data: Rect {
        position: Vec2 { x: 0.0, y: 0.0 }
        size: Vec2 { x: world.layoutW, y: world.layoutH }
      }
    )
    componentSet(
      this: world.sizes
      entityId: slot
      data: Size { w: SizeAxis { mode: SizeMode.fill }, h: SizeAxis { mode: SizeMode.fill } }
    )
    var along: AlignKind = AlignKind.center
    if options.placement is not DialogPlacement.center {
      if options.placement is DialogPlacement.bottom {
        along = AlignKind.end
      }
      componentSet(
        this: world.paddings
        entityId: slot
        data: Padding { insets: Insets { l: 0.0, t: options.margin, r: 0.0, b: options.margin } }
      )
      componentSet(
        this: world.safeAreas
        entityId: slot
        data: SafeArea {
          enabled: true
          apply: Insets { l: 0.0, t: 1.0, r: 0.0, b: 1.0 }
          extra: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
        }
      )
    }
    componentSet(
      this: world.layouts
      entityId: slot
      data: Layout {
        kind: LayoutType.vertical
        gap: 0.0
        alignMain: along
        alignCross: AlignKind.center
        columns: 0
        rowGap: 0.0
        columnGap: 0.0
      }
    )
    setParent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: slot
      parent: host
    )
    # The card: as wide as it may be, as tall as its content
    var width: Float = world.layoutW - options.margin * 2.0
    if width > options.maxWidth {
      width = options.maxWidth
    }
    var height: Float = 0.0
    if componentHas(this: world.rects, entityId: pageRoot) {
      height = componentView(this: world.rects, entityId: pageRoot).size.y
    }
    componentSet(
      this: world.rects
      entityId: pageRoot
      data: Rect { position: Vec2 { x: 0.0, y: 0.0 }, size: Vec2 { x: width, y: height } }
    )
    componentSet(
      this: world.sizes
      entityId: pageRoot
      data: Size { w: SizeAxis { mode: SizeMode.fixed }, h: SizeAxis { mode: SizeMode.hug } }
    )
    setParent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: pageRoot
      parent: slot
    )
  } else {
    componentSet(
      this: world.sizes
      entityId: pageRoot
      data: Size { w: SizeAxis { mode: SizeMode.fill }, h: SizeAxis { mode: SizeMode.fill } }
    )
    setParent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: pageRoot
      parent: host
    )
    presentedPageArrive(world: world, uiSystems: uiSystems, pageRoot: pageRoot)
  }
  componentSet(
    this: world.presentedPages
    entityId: host
    data: PresentedPage {
      pageRoot: pageRoot
      pageId: "{pageId}"
      presentation: presentation
      closeOnAction: options.closeOnAction and presentation is PagePresentation.dialog
      order: order
      placement: options.placement
      at: options.at
      margin: options.margin
      slot: slot
      scrim: scrim
    }
  )
  loop let override: view SceneOverride in overrides {
    if let found: Int = findNodeInPage(world: world, pageId: pageId, nodeId: override.nodeId) {
      applyOverride(
        world: world
        entityId: nodeEntityId(world: world, index: found)
        override: override
      )
    } else {
      reportSceneDiagnostic(
        diagnostics: world.sceneDiagnostics
        sceneId: pageId
        nodeId: override.nodeId
        kind: SceneDiagnosticKind.unknownNode
        name: override.nodeId
        message: "presentPage: no node '{override.nodeId}' on page {pageId} to set {override.componentName}.{override.fieldName}"
      )
    }
  }
  ret host
}

# The topmost presented page's host, or none
func topPresentedPage(world: view UiWorld) ret EntityId {
  var top: EntityId = noEntity()
  var best: Int = 0
  loop var i: Int = 0, i < componentCount(this: world.presentedPages), ++i {
    let presented: view PresentedPage = queryViewAt(table: world.presentedPages, denseIndex: i)
    if presented.order > best {
      best = presented.order
      top = componentEntityAt(this: world.presentedPages, i: i)
    }
  }
  ret top
}

# Is `entityId` inside the subtree of `ancestor` (or it)?
func dialogInside(
  uiSystems: view UiSystems
  entityId: view EntityId
  ancestor: view EntityId
) ret Bool {
  var current: EntityId = { index: entityId.index, generation: entityId.generation }
  loop true {
    if current.index is ancestor.index and current.generation is ancestor.generation {
      ret true
    }
    if componentHas(this: uiSystems.hierarchy.parents, entityId: current) is false {
      ret false
    }
    let link: view Parent = componentView(this: uiSystems.hierarchy.parents, entityId: current)
    current = { index: link.parent.index, generation: link.parent.generation }
  }
  ret false
}

# A page is presented and `entityId` is not on it: the pointer must leave
# it alone (it is under the scrim, or under a full-screen page)
func presentedPageBlocks(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  let top: EntityId = topPresentedPage(world: world)
  if isNone(this: top) {
    ret false
  }
  ret dialogInside(uiSystems: uiSystems, entityId: entityId, ancestor: top) is false
}

func presentedPageKind(world: view UiWorld, pageRoot: view EntityId) ret PageTransitionKind {
  if componentHas(this: world.pageTransitions, entityId: pageRoot) {
    ret componentView(this: world.pageTransitions, entityId: pageRoot).kind
  }
  ret PageTransitionKind.sheet
}

# A presented page's poses: it comes in over the screen, and goes back out the same way
func presentedPagePoses(
  world: view UiWorld
  kind: view PageTransitionKind
  back: view Bool
) ret PagePoses {
  let box: PageBox = { x: 0.0, y: 0.0, w: world.layoutW, h: world.layoutH }
  ret pagePosesFor(
    kind: kind
    back: back
    box: box
    source: pageDefaultSource(box: box)
  )
}

func presentedPageMotion(
  world: view UiWorld
  kind: view PageTransitionKind
  pageRoot: view EntityId
) ret String {
  ret motionNameOr(
    world: world
    name: pageMotionName(kind: kind, authored: pageAuthoredMotion(world: world, root: pageRoot))
    fallback: "smooth"
  )
}

func presentedPageArrive(world: view UiWorld, uiSystems: mod UiSystems, pageRoot: view EntityId) {
  let kind: PageTransitionKind = presentedPageKind(world: world, pageRoot: pageRoot)
  if kind is PageTransitionKind.none {
    ret
  }
  let motion: String = presentedPageMotion(world: world, kind: kind, pageRoot: pageRoot)
  enqueue(
    this: uiSystems.animation.commands
    value: AnimationCommand {
      entityId: pageRoot
      hasFrom: true
      from: presentedPagePoses(world: world, kind: kind, back: false).arriveFrom
      to: AnimationPose {}
      motion: motion
      opacityMotion: "fadeIn"
      delaySeconds: 0.0
      phase: AnimationPhase.appearing
      onEnd: AnimationEnd.stay
      appearsWait: pageSecondsNamed(world: world, name: motion) * pageAppearShare
    }
  )
}

# A dialog steps back when a dialog comes over it. A full page over it hides it, so it stays still.
func dialogStepBack(
  world: view UiWorld
  uiSystems: mod UiSystems
  under: view EntityId
  presentation: view PagePresentation
) {
  if isNone(this: under) or presentation is not PagePresentation.dialog {
    ret
  }
  let presented: view PresentedPage = componentView(this: world.presentedPages, entityId: under)
  if presented.presentation is PagePresentation.dialog {
    animationTo(
      uiSystems: uiSystems
      entityId: presented.pageRoot
      to: AnimationPose { scale: dialogUnderScale }
      motion: "smooth"
      opacityMotion: "fadeIn"
      delaySeconds: 0.0
    )
  }
}

# The page's way out, if it has one: only a page a person has seen has anywhere to leave from. A
# page
# with no Disappear of its own and no scrim has none yet (its transition is PageTransition).
func closeWithMotion(
  world: mod UiWorld
  uiSystems: mod UiSystems
  host: view EntityId
  presented: view PresentedPage
) ret Bool {
  if presented.presentation is not PagePresentation.dialog {
    ret closePageWithMotion(
      world: world
      uiSystems: uiSystems
      host: host
      pageRoot: presented.pageRoot
    )
  }
  if componentHas(this: world.appearSeens, entityId: presented.pageRoot) is false {
    ret false
  }
  componentSet(this: world.leavings, entityId: host, data: Leaving {})
  blurSubtree(world: world, root: host)
  if isNone(this: presented.scrim) is false {
    leaveWith(
      world: world
      uiSystems: uiSystems
      entityId: presented.scrim
      delaySeconds: 0.0
      onEnd: AnimationEnd.stay
    )
  }
  let latest: Float = leaveChildren(world: world, uiSystems: uiSystems, parent: presented.pageRoot)
  leaveWith(
    world: world
    uiSystems: uiSystems
    entityId: presented.pageRoot
    delaySeconds: latest
    onEnd: AnimationEnd.stay
  )
  # The host itself does not move: it waits for what is under it, then goes with it
  animationLeave(
    uiSystems: uiSystems
    entityId: host
    to: AnimationPose {}
    motion: "quick"
    opacityMotion: "quick"
    delaySeconds: 0.0
    onEnd: AnimationEnd.destroySubtree
  )
  ret true
}

# A full page goes back out the way it came, unless its arrival is still waiting: then no one has
# run it
func closePageWithMotion(
  world: mod UiWorld
  uiSystems: mod UiSystems
  host: view EntityId
  pageRoot: view EntityId
) ret Bool {
  let kind: PageTransitionKind = presentedPageKind(world: world, pageRoot: pageRoot)
  if kind is PageTransitionKind.none or animationCommandWaiting(
    uiSystems: uiSystems
    entityId: pageRoot
  ) {
    ret false
  }
  let motion: String = presentedPageMotion(world: world, kind: kind, pageRoot: pageRoot)
  componentSet(this: world.leavings, entityId: host, data: Leaving {})
  pageLeave(
    world: world
    uiSystems: uiSystems
    root: pageRoot
    to: presentedPagePoses(world: world, kind: kind, back: true).leaveTo
    motion: motion
    seconds: pageSecondsNamed(world: world, name: motion)
    onEnd: AnimationEnd.stay
  )
  animationLeave(
    uiSystems: uiSystems
    entityId: host
    to: AnimationPose {}
    motion: "quick"
    opacityMotion: "quick"
    delaySeconds: 0.0
    onEnd: AnimationEnd.destroySubtree
  )
  ret true
}

# Close the presented page whose host is `host`. To the app it is closed at once: it is no longer
# presented, and its node ids are gone. Its entities go now, or when its motion ends.
func closePresentedPage(world: mod UiWorld, uiSystems: mod UiSystems, host: view EntityId) {
  if componentHas(this: world.leavings, entityId: host) {
    ret
  }
  var pageId: String = ""
  var moving: Bool = false
  let wasTop: Bool = topPresentedPage(world: world) is host
  if let presented: PresentedPage = componentCopy(this: world.presentedPages, entityId: host) {
    pageId = "{presented.pageId}"
    componentRemove(this: world.presentedPages, entityId: host)
    moving = closeWithMotion(
      world: world
      uiSystems: uiSystems
      host: host
      presented: presented
    )
  }
  if moving is false {
    destroyEntitySubtree(world: world, uiSystems: uiSystems, root: host)
  }
  # The dialog under it comes back
  if wasTop {
    let top: EntityId = topPresentedPage(world: world)
    if isNone(this: top) is false {
      let under: view PresentedPage = componentView(this: world.presentedPages, entityId: top)
      if under.presentation is PagePresentation.dialog and animationPoseOf(
        uiSystems: uiSystems
        entityId: under.pageRoot
      ).scale is not 1.0 {
        animationTo(
          uiSystems: uiSystems
          entityId: under.pageRoot
          to: AnimationPose {}
          motion: "smooth"
          opacityMotion: "fadeIn"
          delaySeconds: 0.0
        )
      }
    }
  }
  if pageId.length() > 0 {
    let prefix: String = pageScopedKey(pageId: pageId, nodeId: "")
    let keys: List(String) = world.nodeIds.keys()
    loop let key: view String in keys {
      if key.startsWith(prefix: prefix) {
        world.nodeIds.remove(k: key)
      }
    }
  }
}

# Is anything presented?
func presentedPageCount(world: view UiWorld) ret Int {
  ret componentCount(this: world.presentedPages)
}

# Run on a frame with UI actions, after the app has read them: a dialog
# whose own control fired one closes (DialogOptions.closeOnAction). True
# when one closed.
func dialogSystem(world: mod UiWorld, uiSystems: mod UiSystems) ret Bool {
  if componentCount(this: world.presentedPages) is 0 or eventCount(this: world.uiActions) is 0 {
    ret false
  }
  var closing: List(EntityId) = List.create(EntityId, cap: 1)
  loop var i: Int = 0, i < componentCount(this: world.presentedPages), ++i {
    let host: EntityId = componentEntityAt(this: world.presentedPages, i: i)
    let presented: view PresentedPage = queryViewAt(table: world.presentedPages, denseIndex: i)
    if presented.closeOnAction {
      loop var a: Int = 0, a < eventCount(this: world.uiActions), ++a {
        let action: UiAction = eventAt(this: world.uiActions, i: a)
        if dialogInside(uiSystems: uiSystems, entityId: action.entityId, ancestor: host) {
          closing.add(value: host)
          a = eventCount(this: world.uiActions)
        }
      }
    }
  }
  loop let host: view EntityId in closing {
    closePresentedPage(world: world, uiSystems: uiSystems, host: host)
  }
  ret closing.length > 0
}

# Run after layout: a dialog placed `at` a fraction of the screen's height
# gets its card's middle there, kept between the margins inside the safe
# area (its slot's box less its padding and safe insets), by a runtime
# offset (no relayout). Needs no window: the slot's laid-out box and its
# safe insets say where the screen is. True when a card moved (run the
# transform pass again).
func dialogPlaceSystem(world: mod UiWorld, uiSystems: mod UiSystems) ret Bool {
  var moved: Bool = false
  loop var i: Int = 0, i < componentCount(this: world.presentedPages), ++i {
    let presented: PresentedPage = componentCopyAtDefault(this: world.presentedPages, i: i)
    if presented.placement is DialogPlacement.at and presented.presentation is PagePresentation.dialog {
      if dialogPlaceCard(world: world, uiSystems: uiSystems, presented: presented) {
        moved = true
      }
    }
  }
  ret moved
}

func dialogPlaceCard(
  world: mod UiWorld
  uiSystems: mod UiSystems
  presented: view PresentedPage
) ret Bool {
  let slot: EntityId = presented.slot
  let card: EntityId = presented.pageRoot
  if componentHas(this: uiSystems.layout.computedRects, entityId: slot) is false or componentHas(
    this: uiSystems.layout.computedRects
    entityId: card
  ) is false {
    ret false
  }
  let slotBox: view ComputedRect = componentView(
    this: uiSystems.layout.computedRects
    entityId: slot
  )
  let cardHeight: Float = componentView(this: uiSystems.layout.computedRects, entityId: card).size.y
  var safeTop: Float = 0.0
  var safeBottom: Float = 0.0
  if componentHas(this: uiSystems.safeArea.safeInsets, entityId: slot) {
    let insets: view SafeInsets = componentView(this: uiSystems.safeArea.safeInsets, entityId: slot)
    safeTop = insets.insets.t
    safeBottom = insets.insets.b
  }
  # The region the card may use, and where centering put it
  let top: Float = slotBox.position.y + presented.margin + safeTop
  let bottom: Float = slotBox.position.y + slotBox.size.y - presented.margin - safeBottom
  let centered: Float = (top + bottom) * 0.5
  var wanted: Float = slotBox.position.y + slotBox.size.y * presented.at
  if wanted + cardHeight * 0.5 > bottom {
    wanted = bottom - cardHeight * 0.5
  }
  if wanted - cardHeight * 0.5 < top {
    wanted = top + cardHeight * 0.5
  }
  let offset: Float = wanted - centered
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: card) {
    if componentView(this: uiSystems.transform2d.runtimeOffsets, entityId: card).delta.y is offset {
      ret false
    }
  }
  componentSet(
    this: uiSystems.transform2d.runtimeOffsets
    entityId: card
    data: RuntimeOffset { delta: Vec2 { x: 0.0, y: offset } }
  )
  ret true
}
