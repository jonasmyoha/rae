# fitSystem — post-layout art-direction pass (#212,
# rae/docs/ui-coordinate-and-responsive-layout.md §10 S6).
#
# Two components, both applied AFTER layoutSystem and BEFORE
# transformSystem:
#
#   Aspect{ratio}     — lock height to resolved width: h = w / ratio.
#                       Post-layout, so siblings do NOT reflow around
#                       the corrected height (fixed-aspect media, not
#                       a general layout constraint).
#   Overflow{scaleToFitY, minScale} — a column whose laid-out content is
#                       taller than it shrinks, content and all, about
#                       its top center (its TransformFx), not below
#                       minScale.
#   ScaleToFit{mode}  — uniform-scale a FIXED-DESIGN subtree so the
#                       tagged entity's authored Rect (design size in
#                       du) fits its parent's content box, centered.
#                       Contain letterboxes, Cover crops (parent
#                       should clip for Cover), FitHeight scales to the
#                       height and crops or pillarboxes the sides.
#
# Idempotency contract: the pass recomputes every touched
# ComputedRect from AUTHORED components (Rect, Padding), never from
# a previous pass's output — so it can run every frame after
# ifDirty regardless of whether layout re-ran. Writes are
# change-gated (compare, then componentMod only on a real change) so
# an idle frame bumps no table generation and systemIfDirty
# still skips.
#
# ScaleToFit subtree contract: the tagged entity AND its descendants
# use authored fixed Rects (absolute placement, `Layout: None`-style).
# Each descendant's ComputedRect is rewritten to `authored Rect * s`;
# descendants without an authored Rect are left alone (and will look
# unscaled). Text inside a scaled subtree renders at its style's font
# size — glyphs don't scale; keep boards to sprites/shapes.
open ecs/ComponentTable
open ecs/Query
open ui/Components
open ui/UiSystems
open ui/safeAreaSystem/SafeAreaSystem
import Math

# 0.01 du ≈ 1/300 pt: far below one physical pixel at any DPR, so
# gating on it can't suppress a visible change.
func fitDiffers(a: view Float, b: view Float) ret Bool {
  var d: Float = a - b
  if d < 0.0 {
    d = 0.0 - d
  }
  ret d > 0.01
}

# Change-gated ComputedRect write. Only touches entities layout has
# already produced a ComputedRect for.
func fitWriteRect(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
  w: view Float
  h: view Float
) {
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false {
    ret
  }
  let cur: view ComputedRect = componentView(
    this: uiSystems.layout.computedRects
    entityId: entityId
  )
  var dirty: Bool = false
  if fitDiffers(a: cur.position.x, b: x) {
    dirty = true
  }
  if fitDiffers(a: cur.position.y, b: y) {
    dirty = true
  }
  if fitDiffers(a: cur.size.x, b: w) {
    dirty = true
  }
  if fitDiffers(a: cur.size.y, b: h) {
    dirty = true
  }
  if dirty is false {
    ret
  }
  let cr: mod ComputedRect = componentMod(this: uiSystems.layout.computedRects, entityId: entityId)
  cr.position.x = x
  cr.position.y = y
  cr.size.x = w
  cr.size.y = h
}

# The stage being fitted, in its parent's local coordinates: where the scaled
# stage is, its scale, the visible box (the parent's own box, from 0,0) and
# the screen's safe insets. StageEdge and SafeArea nodes inside the stage are
# placed against it.
type StageFrame {
  x: Float
  y: Float
  w: Float
  h: Float
  scale: Float
  visibleW: Float
  visibleH: Float
  safe: Insets
}

# A box in the stage parent's coordinates
type StageBox {
  left: Float
  top: Float
  right: Float
  bottom: Float
}

# The visible edge a pin measures from (the safe inset taken off when `safe`)
func pinnedEdge(
  pin: view StageEdgePin
  visible: view Float
  inset: view Float
  inward: view Float
) ret Float {
  if pin is StageEdgePin.safe {
    ret visible + inset * inward
  }
  ret visible
}

# `box` placed by its StageEdge: each pinned edge keeps its distance from the
# stage's edge, measured from the visible (or safe) edge; both edges of an
# axis pinned stretch it; bleed covers the visible box
func stageEdgeBox(edge: view StageEdge, frame: view StageFrame, box: view StageBox) ret StageBox {
  if edge.bleed {
    ret StageBox { left: 0.0, top: 0.0, right: frame.visibleW, bottom: frame.visibleH }
  }
  var placed: StageBox = box
  let topEdge: Float = pinnedEdge(
    pin: edge.top
    visible: 0.0
    inset: frame.safe.t
    inward: 1.0
  )
  let bottomEdge: Float = pinnedEdge(
    pin: edge.bottom
    visible: frame.visibleH
    inset: frame.safe.b
    inward: -1.0
  )
  let leftEdge: Float = pinnedEdge(
    pin: edge.left
    visible: 0.0
    inset: frame.safe.l
    inward: 1.0
  )
  let rightEdge: Float = pinnedEdge(
    pin: edge.right
    visible: frame.visibleW
    inset: frame.safe.r
    inward: -1.0
  )
  let height: Float = box.bottom - box.top
  let width: Float = box.right - box.left
  if edge.top is not StageEdgePin.none {
    placed.top = box.top + topEdge - frame.y
    placed.bottom = placed.top + height
  }
  if edge.bottom is not StageEdgePin.none {
    placed.bottom = box.bottom + bottomEdge - (frame.y + frame.h)
    if edge.top is StageEdgePin.none {
      placed.top = placed.bottom - height
    }
  }
  if edge.left is not StageEdgePin.none {
    placed.left = box.left + leftEdge - frame.x
    placed.right = placed.left + width
  }
  if edge.right is not StageEdgePin.none {
    placed.right = box.right + rightEdge - (frame.x + frame.w)
    if edge.left is StageEdgePin.none {
      placed.left = placed.right - width
    }
  }
  ret placed
}

# `box` of a SafeArea node inside a stage, inset wherever the window's unsafe
# bands (its safe insets, on the sides SafeArea.apply asks for, plus `extra`
# in stage units) overlap it: on screen they keep their size whatever the
# stage's scale
func stageSafeBox(area: view SafeArea, frame: view StageFrame, box: view StageBox) ret StageBox {
  let topLimit: Float = frame.safe.t * area.apply.t + area.extra.t * frame.scale
  let bottomLimit: Float = frame.visibleH - frame.safe.b * area.apply.b - area.extra.b * frame.scale
  let leftLimit: Float = frame.safe.l * area.apply.l + area.extra.l * frame.scale
  let rightLimit: Float = frame.visibleW - frame.safe.r * area.apply.r - area.extra.r * frame.scale
  ret StageBox {
    left: Math.max(a: box.left, b: leftLimit)
    top: Math.max(a: box.top, b: topLimit)
    right: Math.min(a: box.right, b: rightLimit)
    bottom: Math.min(a: box.bottom, b: bottomLimit)
  }
}

# Rewrite every descendant's ComputedRect as `authored Rect * s`, placing a
# StageEdge or SafeArea node against the visible window (`frame`). `originX`
# / `originY` is `entityId`'s position in the stage parent's coordinates.
# ComputedRect coordinates are parent-local, so uniform scaling per level
# composes to a uniform subtree scale.
func fitScaleSubtree(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  frame: view StageFrame
  originX: view Float
  originY: view Float
) {
  if componentHas(this: world.childrens, entityId: entityId) is false {
    ret
  }
  let s: Float = frame.scale
  let children: view Children = componentView(this: world.childrens, entityId: entityId)
  loop let cid: EntityId in children.ids {
    var childX: Float = originX
    var childY: Float = originY
    if componentHas(this: world.rects, entityId: cid) {
      let r: view Rect = componentView(this: world.rects, entityId: cid)
      var box: StageBox = {
        left: originX + r.position.x * s
        top: originY + r.position.y * s
        right: originX + (r.position.x + r.size.x) * s
        bottom: originY + (r.position.y + r.size.y) * s
      }
      if componentHas(this: world.stageEdges, entityId: cid) {
        box = stageEdgeBox(
          edge: componentView(this: world.stageEdges, entityId: cid)
          frame: frame
          box: box
        )
      } else if componentHas(this: world.safeAreas, entityId: cid) {
        box = stageSafeBox(
          area: componentView(this: world.safeAreas, entityId: cid)
          frame: frame
          box: box
        )
      }
      fitWriteRect(
        world: world
        uiSystems: uiSystems
        entityId: cid
        x: box.left - originX
        y: box.top - originY
        w: box.right - box.left
        h: box.bottom - box.top
      )
      childX = box.left
      childY = box.top
    }
    fitScaleSubtree(
      world: world
      uiSystems: uiSystems
      entityId: cid
      frame: frame
      originX: childX
      originY: childY
    )
  }
}

# Apply one ScaleToFit entity: compute s against the parent's padded
# content box, center the design rect inside it, scale the subtree.
func fitApplyOne(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  mode: view FitMode
) {
  if componentHas(this: uiSystems.hierarchy.parents, entityId: entityId) is false {
    ret
  }
  let pl: view Parent = componentView(this: uiSystems.hierarchy.parents, entityId: entityId)
  if componentHas(this: uiSystems.layout.computedRects, entityId: pl.parent) is false {
    ret
  }
  if componentHas(this: world.rects, entityId: entityId) is false {
    ret
  }
  let pcr: view ComputedRect = componentView(
    this: uiSystems.layout.computedRects
    entityId: pl.parent
  )
  let design: view Rect = componentView(this: world.rects, entityId: entityId)
  if design.size.x <= 0.0 {
    ret
  }
  if design.size.y <= 0.0 {
    ret
  }
  var padL: Float = 0.0
  var padT: Float = 0.0
  var availW: Float = pcr.size.x
  var availH: Float = pcr.size.y
  if componentHas(this: world.paddings, entityId: pl.parent) {
    let pad: view Padding = componentView(this: world.paddings, entityId: pl.parent)
    padL = pad.insets.l
    padT = pad.insets.t
    availW = availW - pad.insets.l - pad.insets.r
    availH = availH - pad.insets.t - pad.insets.b
  }
  if availW <= 0.0 {
    ret
  }
  if availH <= 0.0 {
    ret
  }
  let sw: Float = availW / design.size.x
  let sh: Float = availH / design.size.y
  var s: Float = sw
  if mode is FitMode.contain {
    if sh < sw {
      s = sh
    }
  }
  if mode is FitMode.cover {
    if sh > sw {
      s = sh
    }
  }
  if mode is FitMode.fitHeight {
    s = sh
  }
  let w: Float = design.size.x * s
  let h: Float = design.size.y * s
  let x: Float = padL + (availW - w) / 2.0
  let y: Float = padT + (availH - h) / 2.0
  fitWriteRect(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    x: x
    y: y
    w: w
    h: h
  )
  let frame: StageFrame = {
    x: x
    y: y
    w: w
    h: h
    scale: s
    visibleW: pcr.size.x
    visibleH: pcr.size.y
    safe: screenSafeInsets(world: world)
  }
  fitScaleSubtree(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    frame: frame
    originX: x
    originY: y
  )
}

# The scale a scaleToFitY column needs: 1 when its laid-out content fits the
# height inside its padding, else that height over the content's, not below
# `minScale` (0: no limit). The content's height is read from the children's
# ComputedRects, which the column's own TransformFx scale does not change, so
# the scale is recomputed from the layout every frame and never compounds.
func overflowColumnScale(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  minScale: view Float
) ret Float {
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false or componentHas(
    this: world.childrens
    entityId: entityId
  ) is false {
    ret 1.0
  }
  let column: view ComputedRect = componentView(
    this: uiSystems.layout.computedRects
    entityId: entityId
  )
  var padTop: Float = 0.0
  var padBottom: Float = 0.0
  if componentHas(this: world.paddings, entityId: entityId) {
    let pad: view Padding = componentView(this: world.paddings, entityId: entityId)
    padTop = pad.insets.t
    padBottom = pad.insets.b
  }
  var bottom: Float = padTop
  let children: view Children = componentView(this: world.childrens, entityId: entityId)
  loop let childId: view EntityId in children.ids {
    var shown: Bool = true
    if componentHas(this: world.actives, entityId: childId) {
      shown = componentView(this: world.actives, entityId: childId).value
    }
    if shown and componentHas(this: uiSystems.layout.computedRects, entityId: childId) {
      let child: view ComputedRect = componentView(
        this: uiSystems.layout.computedRects
        entityId: childId
      )
      if child.position.y + child.size.y > bottom {
        bottom = child.position.y + child.size.y
      }
    }
  }
  let available: Float = column.size.y - padTop - padBottom
  let content: Float = bottom - padTop
  if content <= available or content <= 0.0 or available <= 0.0 {
    ret 1.0
  }
  var scale: Float = available / content
  if scale < minScale {
    scale = minScale
  }
  ret scale
}

# Set every scaleToFitY column's TransformFx to its scale about its top
# center (change-gated: an unchanged scale writes nothing)
func overflowColumnsSystem(world: mod UiWorld, uiSystems: mod UiSystems) {
  loop var i: Int = 0, i < componentCount(this: world.overflows), ++i {
    let entityId: EntityId = componentEntityAt(this: world.overflows, i: i)
    let policy: view OverflowPolicy = queryViewAt(table: world.overflows, denseIndex: i)
    if policy.mode is not OverflowMode.scaleToFitY {
      continue
    }
    let scale: Float = overflowColumnScale(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      minScale: policy.minScale
    )
    if componentHas(this: world.transforms, entityId: entityId) is false {
      if scale is 1.0 {
        continue
      }
      componentSet(this: world.transforms, entityId: entityId, data: defaultTransformFx())
    }
    let fx: view TransformFx = componentView(this: world.transforms, entityId: entityId)
    if fx.scaleX is not scale or fx.scaleY is not scale or fx.pivot.x is not 0.5 or fx.pivot.y is not 0.0 {
      let written: mod TransformFx = componentMod(this: world.transforms, entityId: entityId)
      written.scaleX = scale
      written.scaleY = scale
      written.pivot = Vec2 { x: 0.5, y: 0.0 }
    }
  }
}

# Run both art-direction passes. Call between ifDirty and
# systemIfDirty every frame — cheap when the aspect /
# scale-to-fit tables are empty or nothing changed.
func fitSystem(world: mod UiWorld, uiSystems: mod UiSystems) pub {
  # Aspect ∧ ComputedRect join (#807/#940): only entities that carry BOTH an
  # Aspect and a ComputedRect can be corrected, so query2 walks the smaller of
  # the two tables and probes the other by index instead of scanning every
  # Aspect and re-looking-up its ComputedRect. queryViewAt reads each side
  # by its dense index (no sparse probe, no generation bump); queryModAt writes
  # ONLY on a real change, keeping the same change-gated bump as componentMod.
  let hits: List(Query2Match) = query2(
    tableA: world.aspects
    tableB: uiSystems.layout.computedRects
  )
  loop let row: view Query2Match in hits {
    let a: view Aspect = queryViewAt(table: world.aspects, denseIndex: row.indexA)
    if a.ratio > 0.0 {
      let cur: view ComputedRect = queryViewAt(
        table: uiSystems.layout.computedRects
        denseIndex: row.indexB
      )
      let targetH: Float = cur.size.x / a.ratio
      if fitDiffers(a: cur.size.y, b: targetH) {
        let cr: mod ComputedRect = queryModAt(
          table: uiSystems.layout.computedRects
          denseIndex: row.indexB
        )
        cr.size.y = targetH
      }
    }
  }
  overflowColumnsSystem(world: world, uiSystems: uiSystems)
  var n: Int = componentCount(this: world.scaleToFits)
  var i: Int = 0
  loop i < n {
    let e: EntityId = componentEntityAt(this: world.scaleToFits, i: i)
    let stf: view ScaleToFit = queryViewAt(table: world.scaleToFits, denseIndex: i)
    fitApplyOne(
      world: world
      uiSystems: uiSystems
      entityId: e
      mode: stf.mode
    )
    i = i + 1
  }
}
