# FramesHierarchy — the hierarchy directives of scene frames (#918 split of
# ui/Frames for the 1000-line cap): the `parent` / `order` keys a frame may
# carry, their cycle guard, the derived active hierarchy and its application
# to the page. ui/Frames' applyFrameToPage calls into these after the
# component overlays.
import Json
import ui/RegistryRemove
open ecs/Entity
open ecs/hierarchySystem/HierarchySystem
open ecs/ComponentTable
open ui/Frames

# The two loader-directive keys a frame's node bag may carry.
func isHierarchyDirectiveKey(key: view String) ret Bool {
  if key is "Parent" {
    ret true
  }
  ret key is "order"
}

# True when ANY frame's node bag carries a Parent/order directive —
# the gate that keeps pure-overlay scenes (S3) off the hierarchy
# rebuild path entirely.
func haveHierarchyDirectives(scene: view Scene, frames: view FrameSet) ret Bool {
  let doc: view JsonDoc => scene.doc
  var f: Int = 0
  loop f < frames.count {
    if let nodesIdx: Int = frames.nodesValueIdxs.copyAt(index: f) {
      if nodesIdx >= 0 {
        let nodesVal: JsonValue = Json.jsonValueAt(doc: doc, idx: nodesIdx)
        if nodesVal.kind is JsonKind.object {
          let n: Int = Json.objectLen(this: nodesVal)
          var i: Int = 0
          loop i < n {
            let bag: JsonValue = Json.objectValueAt(doc: doc, this: nodesVal, idx: i)
            if bagHasKey(doc: doc, bag: bag, key: "Parent") {
              ret true
            }
            if bagHasKey(doc: doc, bag: bag, key: "order") {
              ret true
            }
            i = i + 1
          }
        }
      }
    }
    f = f + 1
  }
  ret false
}

# Would setting `nodeIdx`'s parent to `candidateParent` create a
# cycle? Walks the candidate's ancestor chain in the CURRENT parent
# map; also trips defensively if the walk exceeds nodeCount hops
# (a pre-existing cycle upstream).
func hierarchyWouldCycle(
  parentIdxs: view List(Int)
  nodeIdx: view Int
  candidateParent: view Int
  nodeCount: view Int
) ret Bool {
  var cur: Int = candidateParent
  var steps: Int = 0
  loop cur >= 0 {
    if cur is nodeIdx {
      ret true
    }
    if steps > nodeCount {
      ret true
    }
    var next: Int = -1
    if let parentValue: Int = parentIdxs.copyAt(index: cur) {
      next = parentValue
    }
    cur = next
    steps = steps + 1
  }
  ret false
}

# Re-derive the ACTIVE hierarchy of the page-scoped instance from the
# authored scene plus frame `frameIdx`'s Parent/order directives, then
# rewrite the instance's Children/Parent components. `frameIdx < 0`
# (or a directive-free frame) restores the authored hierarchy — the
# derivation always starts from authored, which is what makes frame
# switching reversible with stable entity identity.
#
# Sort keys: authored children get their authored position (0,1,2…);
# a directive with `order: o` gets `o - 0.5` (+ a per-directive
# epsilon for declared-order stability), landing BEFORE the authored
# child at index o; a Parent directive without `order` appends.
func deriveActiveHierarchy(
  world: mod UiWorld
  scene: view Scene
  frames: view FrameSet
  frameIdx: view Int
  pageId: view String
) {
  let doc: view JsonDoc => scene.doc
  let nodeCount: Int = scene.nodes.length
  let rootIdx: Int = sceneNodeIndex(this: scene, nodeId: scene.rootNodeId)
  if rootIdx < 0 {
    ret
  }

  # Raw entity value per scene node (-1 = not mounted in this page).
  let entityVals: List(Int) = List.create(Int, cap: nodeCount)
  var e: Int = 0
  loop e < nodeCount {
    let node: view SceneNode => nodeAt(this: scene, idx: e)
    var raw: Int = -1
    if let entityRaw: Int = findNodeInPage(world: world, pageId: pageId, nodeId: node.nodeId) {
      raw = entityRaw
    }
    entityVals.add(value: raw)
    e = e + 1
  }

  # Authored parent map + within-parent sort keys.
  let parentIdxs: List(Int) = List.create(Int, cap: nodeCount)
  let sortKeys: List(Float) = List.create(Float, cap: nodeCount)
  var z: Int = 0
  loop z < nodeCount {
    parentIdxs.add(value: -1)
    sortKeys.add(value: 0.0)
    z = z + 1
  }
  var a: Int = 0
  loop a < nodeCount {
    let node: view SceneNode => nodeAt(this: scene, idx: a)
    let kn: Int = node.childrenIds.length
    var q: Int = 0
    loop q < kn {
      if let childId: String = node.childrenIds.copyAt(index: q) {
        let childIdx: Int = sceneNodeIndex(this: scene, nodeId: childId)
        if childIdx >= 0 {
          parentIdxs.set(index: childIdx, value: a)
          sortKeys.set(index: childIdx, value: q.toFloat())
        }
      }
      q = q + 1
    }
    a = a + 1
  }

  # Apply the active frame's directives in declared order.
  if frameIdx >= 0 {
    var nodesIdx: Int = -1
    if let value: Int = frames.nodesValueIdxs.copyAt(index: frameIdx) {
      nodesIdx = value
    }
    if nodesIdx >= 0 {
      let nodesVal: JsonValue = Json.jsonValueAt(doc: doc, idx: nodesIdx)
      if nodesVal.kind is JsonKind.object {
        let dn: Int = Json.objectLen(this: nodesVal)
        var d: Int = 0
        loop d < dn {
          let dirNodeId: String = Json.objectKeyAt(doc: doc, this: nodesVal, idx: d)
          let bag: JsonValue = Json.objectValueAt(doc: doc, this: nodesVal, idx: d)
          applyHierarchyDirective(
            scene: scene
            doc: doc
            bag: bag
            dirNodeId: dirNodeId
            rootIdx: rootIdx
            nodeCount: nodeCount
            seq: d
            parentIdxs: parentIdxs
            sortKeys: sortKeys
          )
          d = d + 1
        }
      }
    }
  }

  # #726: rebuild the active hierarchy through HierarchySystem — the UI sets only
  # Parent, and setParent maintains the derived Children cache. Since this is a
  # full rebuild, first DETACH every mounted non-root node (clears its Parent and
  # unlinks it from its parent's Children); then the loop below re-links each node
  # under its active parent. Detach-first guarantees a clean rebuild: a node that
  # got reordered, orphaned, or unmounted this frame never lingers in a stale
  # Children list. The scene root keeps its OUTER-hierarchy Parent (rootIdx is
  # never a scene child, so it is skipped here and never re-linked below).
  var detachIdx: Int = 0
  loop detachIdx < nodeCount {
    if detachIdx is not rootIdx {
      var detachRaw: Int = -1
      if let value: Int = entityVals.copyAt(index: detachIdx) {
        detachRaw = value
      }
      if detachRaw >= 0 {
        let detachEntity: EntityId = id(v: detachRaw)
        if componentHas(this: world.parents, entity: detachEntity) {
          setParent(
            parents: world.parents
            childrens: world.childrens
            child: detachEntity
            parent: noEntity()
          )
        }
      }
    }
    detachIdx = detachIdx + 1
  }

  var b: Int = 0
  loop b < nodeCount {
    var parentRaw: Int = -1
    if let value: Int = entityVals.copyAt(index: b) {
      parentRaw = value
    }
    if parentRaw >= 0 {
      let parentEntity: EntityId = id(v: parentRaw)
      # Gather b's mounted children, selection-sorted by sort key.
      let unsorted: List(Int) = List.create(Int, cap: 8)
      var c: Int = 0
      loop c < nodeCount {
        if parentIdxs.copyAt(index: c) is b {
          if entityVals.copyAt(index: c) >= 0 {
            unsorted.add(value: c)
          }
        }
        c = c + 1
      }
      let childCount: Int = unsorted.length
      if childCount > 0 {
        let used: List(Int) = List.create(Int, cap: childCount)
        var w: Int = 0
        loop w < childCount {
          used.add(value: 0)
          w = w + 1
        }
        var t: Int = 0
        loop t < childCount {
          var bestSlot: Int = -1
          var bestKey: Float = 0.0
          var u: Int = 0
          loop u < childCount {
            if used.copyAt(index: u) is 0 {
              if let candIdx: Int = unsorted.copyAt(index: u) {
                if let candKey: Float = sortKeys.copyAt(index: candIdx) {
                  var better: Bool = false
                  if bestSlot < 0 {
                    better = true
                  } else {
                    if candKey < bestKey {
                      better = true
                    }
                  }
                  if better {
                    bestSlot = u
                    bestKey = candKey
                  }
                }
              }
            }
            u = u + 1
          }
          used.set(index: bestSlot, value: 1)
          var childNodeIdx: Int = -1
          if let value: Int = unsorted.copyAt(index: bestSlot) {
            childNodeIdx = value
          }
          var childEntityRaw: Int = -1
          if let value: Int = entityVals.copyAt(index: childNodeIdx) {
            childEntityRaw = value
          }
          let childEntity: EntityId = id(v: childEntityRaw)
          # #726: link via setParent. The children are visited in sort-key order,
          # so setParent's append rebuilds the derived Children cache in exactly
          # that order — matching the old hand-built, hand-sorted list.
          setParent(
            parents: world.parents
            childrens: world.childrens
            child: childEntity
            parent: parentEntity
          )
          t = t + 1
        }
      }
    }
    b = b + 1
  }
}

# Consume one node bag's Parent/order directives, mutating the active
# parent/sort-key maps. Rejections (unknown parent, scene root as
# target node, cycle) log and leave the maps untouched.
func applyHierarchyDirective(
  scene: view Scene
  doc: view JsonDoc
  bag: view JsonValue
  dirNodeId: view String
  rootIdx: view Int
  nodeCount: view Int
  seq: view Int
  parentIdxs: mod List(Int)
  sortKeys: mod List(Float)
) {
  let nodeIdx: Int = sceneNodeIndex(this: scene, nodeId: dirNodeId)
  if nodeIdx < 0 {
    ret
  }

  var newParentIdx: Int = -1
  var hasParentDirective: Bool = false
  let parentFieldIdx: Int = Json.field(doc: doc, this: bag, key: "Parent")
  if parentFieldIdx >= 0 {
    hasParentDirective = true
    let pv: JsonValue = Json.jsonValueAt(doc: doc, idx: parentFieldIdx)
    let noName: String = ""
    let parentName: String = Json.jsonString(this: pv, fallback: noName)
    newParentIdx = sceneNodeIndex(this: scene, nodeId: parentName)
    if newParentIdx < 0 {
      log("[frames] Parent directive on '{dirNodeId}' names unknown node '{parentName}' — skipped")
      ret
    }
  }

  var orderVal: Int = -1
  let orderFieldIdx: Int = Json.field(doc: doc, this: bag, key: "order")
  if orderFieldIdx >= 0 {
    let ov: JsonValue = Json.jsonValueAt(doc: doc, idx: orderFieldIdx)
    let noOrder: Int = -1
    orderVal = Json.jsonInt(this: ov, fallback: noOrder)
  }

  if hasParentDirective is false {
    if orderVal < 0 {
      ret
    }
  }

  if nodeIdx is rootIdx {
    log("[frames] hierarchy directive on scene root '{dirNodeId}' — skipped")
    ret
  }

  if hasParentDirective {
    if hierarchyWouldCycle(
      parentIdxs: parentIdxs
      nodeIdx: nodeIdx
      candidateParent: newParentIdx
      nodeCount: nodeCount
    ) {
      log("[frames] Parent directive on '{dirNodeId}' would create a cycle — skipped")
      ret
    }
    parentIdxs.set(index: nodeIdx, value: newParentIdx)
  }

  # Position within the (possibly new) parent: before the authored
  # child at index `order`, or appended past all authored children.
  var key: Float = 1000000.0 + seq.toFloat()
  if orderVal >= 0 {
    key = orderVal.toFloat() - 0.5 + seq.toFloat() * 0.0001
  }
  sortKeys.set(index: nodeIdx, value: key)
}
