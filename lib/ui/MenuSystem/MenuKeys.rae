# The keys of an open menu: the arrows, Home and End, Return, Escape, and typing to find a row.
import Keys
import Sdl3
open text/NameOrder
open ui/TypedText
open ui/Ecs
open ui/MenuComponents
open ui/UiSystems

# The keys pressed this frame
type MenuKeys {
  up: Bool = false
  down: Bool = false
  left: Bool = false
  right: Bool = false
  home: Bool = false
  end: Bool = false
  choose: Bool = false
  escape: Bool = false
  # What was typed (UTF-8)
  text: String = ""
}

# This frame's from the keyboard. With the window's text input off (Gpu2dTextInput.setTextInput),
# the letters and digits by their key.
func menuKeysFromDevice() ret MenuKeys {
  let keys: MenuKeys = {
    up: Sdl3.isKeyPressed(key: Keys.keyUp)
    down: Sdl3.isKeyPressed(key: Keys.keyDown)
    left: Sdl3.isKeyPressed(key: Keys.keyLeft)
    right: Sdl3.isKeyPressed(key: Keys.keyRight)
    home: Sdl3.isKeyPressed(key: Keys.keyHome)
    end: Sdl3.isKeyPressed(key: Keys.keyEnd)
    choose: Sdl3.isKeyPressed(key: Keys.keyEnter) or Sdl3.isKeyPressed(key: Keys.keyKeypadEnter)
    escape: Sdl3.isKeyPressed(key: Keys.keyEscape)
    text: typedText()
  }
  ret keys
}

# The level the keys work in: the submenu while a row of it is focused
func menuKeyLevel(world: view UiWorld) ret Int {
  if menuFocusOf(world: world, level: 1) >= 0 {
    ret 1
  }
  ret 0
}

func stepMenuKeys(
  world: mod UiWorld
  uiSystems: mod UiSystems
  keys: view MenuKeys
  now: view Float64
) {
  let level: Int = menuKeyLevel(world: world)
  let focus: Int = menuFocusOf(world: world, level: level)
  if keys.escape {
    if level is 1 {
      closeSubmenu(world: world, uiSystems: uiSystems)
    } else {
      closeMenu(world: world, uiSystems: uiSystems)
    }
    ret
  }
  if keys.choose {
    chooseMenuRow(
      world: world
      uiSystems: uiSystems
      level: level
      row: focus
      byKey: true
    )
    ret
  }
  if keys.right and level is 0 {
    openSubmenu(
      world: world
      uiSystems: uiSystems
      row: focus
      focusFirst: true
    )
    ret
  }
  if keys.left and level is 1 {
    closeSubmenu(world: world, uiSystems: uiSystems)
    ret
  }
  var target: Int = -1
  if keys.down {
    target = nextMenuRow(
      world: world
      level: level
      from: focus
      step: 1
    )
  } else if keys.up {
    target = nextMenuRow(
      world: world
      level: level
      from: focus
      step: -1
    )
  } else if keys.home {
    target = nextMenuRow(
      world: world
      level: level
      from: -1
      step: 1
    )
  } else if keys.end {
    target = nextMenuRow(
      world: world
      level: level
      from: -1
      step: -1
    )
  } else if keys.text.length() > 0 {
    target = typedMenuRow(
      world: world
      level: level
      text: keys.text
      now: now
    )
  }
  if target < 0 {
    ret
  }
  if level is 0 and target is not submenuRow(world: world) {
    closeSubmenu(world: world, uiSystems: uiSystems)
  }
  # the keys have it now, until the pointer moves
  world.menu.waiting = false
  focusMenuRow(world: world, level: level, row: target)
}

# The row whose text starts with what has been typed (case and accents do not count), or -1. The
# first letter looks after the focused row, so typing it again (after the pause) goes to the next.
func typedMenuRow(
  world: mod UiWorld
  level: view Int
  text: view String
  now: view Float64
) ret Int {
  if now - world.menu.typedSeconds > menuTypeSeconds {
    world.menu.typed = ""
  }
  let first: Bool = world.menu.typed.length() is 0
  world.menu.typedSeconds = now
  world.menu.typed = world.menu.typed.concat(other: text)
  let fold: NameFold = createNameFold()
  let wanted: String = foldedText(fold: fold, text: world.menu.typed)
  var count: Int = 0
  if let found: view MenuLevel = world.menu.levels.viewAt(index: level) {
    count = found.rows.length
  }
  var start: Int = menuFocusOf(world: world, level: level)
  if first or start < 0 {
    start = start + 1
  }
  loop var step: Int = 0, step < count, ++step {
    let row: Int = (start + step) % count
    if menuRowEnabled(world: world, level: level, row: row) {
      if let item: view MenuItem = world.menu.request.items.viewAt(
        index: menuItemIndex(world: world, level: level, row: row)
      ) {
        if foldedText(fold: fold, text: item.text).startsWith(prefix: wanted) {
          ret row
        }
      }
    }
  }
  ret -1
}
