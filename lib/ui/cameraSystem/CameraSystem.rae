# cameraSystem — a `Camera2D` on a page or layer root becomes the root's
# TransformFx scale (about the origin) and RuntimeOffset, the two
# transform-pass inputs a scroll already uses; the stock transform, render
# and input systems then carry an inherited scale through every descendant
# (box, glyphs, clips, hit tests). Runs in the ui Pipeline right before
# transform. Compare-before-write: a camera that did not move bumps neither
# table, so an idle frame stays idle. The camera OWNS the root's scale and
# pivot; a root's own alpha / visible / rotation are kept.
open ui/Ecs
open ui/Components
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ui/UiSystems

func cameraFxMatches(fx: view TransformFx, zoom: view Float) ret Bool {
  ret fx.scaleX is zoom and fx.scaleY is zoom and fx.pivot.x is 0.0 and fx.pivot.y is 0.0
}

func cameraSystem(world: mod UiWorld, uiSystems: mod UiSystems) {
  let count: Int = componentCount(this: world.cameras)
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: world.cameras, i: i)
    let camera: view Camera2D => queryViewAt(table: world.cameras, denseIndex: i)
    if componentHas(this: world.transforms, entityId: entityId) is false {
      componentSet(this: world.transforms, entityId: entityId, data: defaultTransformFx())
    }
    # Compared through a view; written through componentMod only on a change,
    # because componentMod marks the table changed and this runs every frame.
    if cameraFxMatches(
      fx: componentView(this: world.transforms, entityId: entityId)
      zoom: camera.zoom
    ) is false {
      let fx: mod TransformFx => componentMod(this: world.transforms, entityId: entityId)
      fx.scaleX = camera.zoom
      fx.scaleY = camera.zoom
      fx.pivot = Vec2 { x: 0.0, y: 0.0 }
      fx.anchor = Vec2 { x: 0.0, y: 0.0 }
    }
    var current: Vec2 = { x: 0.0, y: 0.0 }
    var hasOffset: Bool = false
    if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId) {
      current = componentView(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId).delta
      hasOffset = true
    }
    if hasOffset is false or current.x is not camera.offsetX or current.y is not camera.offsetY {
      let offset: RuntimeOffset = { delta: Vec2 { x: camera.offsetX, y: camera.offsetY } }
      componentSet(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId, data: own offset)
    }
  }
}
