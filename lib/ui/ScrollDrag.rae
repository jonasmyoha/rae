# ScrollDrag — `updateScrollRoot`'s runtime state per ScrollRoot
# (ui/ScrollRootSystem), never authored or serialized:
#
# - `dragging`: a press on the root is being tracked; `active` once it has
#   moved past the activation distance along the axis, so it IS a drag (the
#   content follows the finger and the press is claimed: its release clicks
#   nothing, ui/InputSystem); `pressPointer` / `lastPointer`: where the press
#   was and the pointer last was, along the axis; `pressAcross`: where the press
#   was across it;
# - `d0`..`d2`: the last three damped drag deltas, from which the lift
#   velocity is picked;
# - `wheelIdleSeconds`: seconds since the last wheel (or trackpad) event. The
#   spring and the momentum wait while it is small, so they do not fight a
#   trackpad's own momentum events, which keep arriving after the lift;
# - `pinnedToEnd`: an end-anchored root (ScrollAnchor.end) holds its end in
#   view: set when it is mounted with no remembered position and when it
#   comes to rest at its end, cleared by a drag or the wheel.
type ScrollDrag {
  dragging: Bool
  lastPointer: Float
  d0: Float
  d1: Float
  d2: Float
  active: Bool = false
  pressPointer: Float = 0.0
  pressAcross: Float = 0.0
  # At rest, as of these stamps (updateScrollRoots): nothing to step while they are the same
  restGeometry: Int = -1
  restStamp: Int = -1
  wheelIdleSeconds: Float = 1000.0
  pinnedToEnd: Bool = false
}
