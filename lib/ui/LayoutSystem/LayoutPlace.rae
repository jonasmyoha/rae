# Compute-phase placement for the two-phase layout (RUICS § 7), split out of
# LayoutSystem.rae to stay under the 1000-line file cap. Top-down placement
# over the cached parent-before-child depth order (#713/#731): `seedRoot`
# seeds each root's ComputedRect, `placeChildren` + the
# `place{Horizontal,Vertical,Stack}` helpers resolve and write every active
# child's ComputedRect, and `computeLinear` drives the forward walk.
#
# Coordinate space is local-to-parent (see LayoutSystem.rae). The shared
# helpers (resolveOwnSize, applyConstraints*, entity* accessors,
# activeChildren, layoutActive) live in LayoutSystem.rae and are cross-file
# visible.
import core
open ecs/component_table
open ecs/HierarchySystem/HierarchySystem

# Write `entity`'s ComputedRect from a parent-relative position (plus its
# own Offset, a post-layout shift) and its already-resolved own size. This
# is what the placement helpers now do for each child instead of recursing:
# the depth-order compute loop reaches that child later and places ITS
# children in turn (#731).
func writeComputedRect(
  world: mod UiWorld
  entity: view EntityId
  localX: view Float
  localY: view Float
  ownW: view Float
  ownH: view Float
) {
  let off: Vec2 = entityOffset(world: world, entity: entity)
  let cr: ComputedRect = {
    position: { x: localX + off.x, y: localY + off.y }
    size: { x: ownW, y: ownH }
  }
  componentSet(this: world.computedRects, entity: entity, data: cr)
}

# Resolve and write a layout ROOT's own ComputedRect: size from the world
# layout extent, x from the ExtentAnchor. Roots have no parent to place
# them, so the compute loop seeds them on arrival before placing children.
func seedRoot(world: mod UiWorld, entity: view EntityId) {
  let resolved: Vec2 = resolveOwnSize(
    world: world
    entity: entity
    parentAvailW: world.layoutW
    parentAvailH: world.layoutH
    hasParentAvail: true
  )
  var rootW: Float = resolved.x
  var rootX: Float = 0.0
  let anchor: HExtent = rootExtentAnchor(world: world, entity: entity)
  if anchor is HExtent.fill {
    rootW = world.layoutW
  }
  if anchor is HExtent.center {
    let slack: Float = world.layoutW - rootW
    if slack > 0.0 {
      rootX = slack / 2.0
    }
  }
  writeComputedRect(world: world, entity: entity, localX: rootX, localY: 0.0, ownW: rootW, ownH: resolved.y)
}

# Place `entity`'s active children into its content box. `entity`'s own
# ComputedRect is already written (by its parent's placement, or seedRoot for
# a root); its size IS the resolved own size the old recursion threaded down
# as ownW/ownH. Children get their ComputedRects here; the depth-order loop
# visits each later to place THEIR children (#731).
func placeChildren(world: mod UiWorld, entity: view EntityId) {
  let kids: List(EntityId) = activeChildren(world: world, entity: entity)
  let n: Int = kids.length
  if n is 0 {
    ret
  }

  var ownW: Float = 0.0
  var ownH: Float = 0.0
  if componentHas(this: world.computedRects, entity: entity) {
    let cr: ComputedRect = componentGet(this: world.computedRects, entity: entity)
    ownW = cr.size.x
    ownH = cr.size.y
  }

  let layout: Layout = entityLayout(world: world, entity: entity)
  let pad: Insets = entityPadding(world: world, entity: entity)
  let contentX: Float = pad.l
  let contentY: Float = pad.t
  var contentW: Float = ownW - pad.l - pad.r
  var contentH: Float = ownH - pad.t - pad.b
  if contentW < 0.0 {
    contentW = 0.0
  }
  if contentH < 0.0 {
    contentH = 0.0
  }

  if layout.kind is LayoutType.horizontal {
    placeHorizontal(
      world: world
      kids: kids
      contentX: contentX
      contentY: contentY
      contentW: contentW
      contentH: contentH
      gap: layout.gap
      alignMain: layout.alignMain
      alignCross: layout.alignCross
    )
    ret
  }
  if layout.kind is LayoutType.vertical {
    placeVertical(
      world: world
      kids: kids
      contentX: contentX
      contentY: contentY
      contentW: contentW
      contentH: contentH
      gap: layout.gap
      alignMain: layout.alignMain
      alignCross: layout.alignCross
    )
    ret
  }
  if layout.kind is LayoutType.stack {
    placeStack(
      world: world
      kids: kids
      contentX: contentX
      contentY: contentY
      contentW: contentW
      contentH: contentH
    )
    ret
  }
  # None: each child uses its authored Rect.x/y as relative position
  # inside the parent's padded content box.
  var i: Int = 0
  loop i < n {
    let cid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
    let crect: Rect = entityRect(world: world, entity: cid)
    let resolved: Vec2 = resolveOwnSize(
      world: world
      entity: cid
      parentAvailW: contentW
      parentAvailH: contentH
      hasParentAvail: true
    )
    writeComputedRect(
      world: world
      entity: cid
      localX: contentX + crect.position.x
      localY: contentY + crect.position.y
      ownW: resolved.x
      ownH: resolved.y
    )
    i = i + 1
  }
}

# -----------------------------------------------------------------
# Container-specific placement
# -----------------------------------------------------------------

func placeHorizontal(
  world: mod UiWorld
  kids: view List(EntityId)
  contentX: view Float
  contentY: view Float
  contentW: view Float
  contentH: view Float
  gap: view Float
  alignMain: AlignKind
  alignCross: AlignKind
) {
  let n: Int = kids.length
  # Pass 1: sum widths of fixed/hug children, count Fill children.
  var fixedSum: Float = 0.0
  var fillCount: Int = 0
  var i: Int = 0
  loop i < n {
    let cid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
    let size: Size = entitySize(world: world, entity: cid)
    if size.w.mode is SizeMode.fill {
      fillCount = fillCount + 1
    } else {
      let r: Vec2 = resolveOwnSize(
        world: world
        entity: cid
        parentAvailW: contentW
        parentAvailH: contentH
        hasParentAvail: true
      )
      fixedSum = fixedSum + r.x
    }
    i = i + 1
  }
  var gapTotal: Float = gap * (n - 1).toFloat()
  if gapTotal < 0.0 {
    gapTotal = 0.0
  }
  var remaining: Float = contentW - fixedSum - gapTotal
  if remaining < 0.0 {
    remaining = 0.0
  }
  var fillSize: Float = 0.0
  if fillCount > 0 {
    fillSize = remaining / fillCount.toFloat()
  }

  # alignMain distributes the leftover main-axis slack when no child is
  # `Fill` (Fills already consume slack, so alignment is a no-op then).
  #   Start         — slack on the right (default)
  #   Center        — half slack on each side
  #   End           — slack on the left
  #   SpaceBetween  — slack split evenly between children, on top of
  #                   the configured `gap` (no slack at the ends)
  var startOffset: Float = 0.0
  var extraGap: Float = 0.0
  if fillCount is 0 {
    if alignMain is AlignKind.center {
      startOffset = remaining / 2.0
    }
    if alignMain is AlignKind.end {
      startOffset = remaining
    }
    if alignMain is AlignKind.spaceBetween {
      if n > 1 {
        extraGap = remaining / (n - 1).toFloat()
      }
    }
  }

  # Pass 2: place children in order with gaps between.
  var cursorX: Float = contentX + startOffset
  var j: Int = 0
  loop j < n {
    let cid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: j)
    let size: Size = entitySize(world: world, entity: cid)
    var childW: Float = 0.0
    if size.w.mode is SizeMode.fill {
      childW = fillSize
    } else {
      let r: Vec2 = resolveOwnSize(
        world: world
        entity: cid
        parentAvailW: contentW
        parentAvailH: contentH
        hasParentAvail: true
      )
      childW = r.x
    }
    childW = applyConstraintsW(world: world, entity: cid, w: childW)
    var childH: Float = 0.0
    if size.h.mode is SizeMode.fill {
      childH = contentH
    } else {
      let r: Vec2 = resolveOwnSize(
        world: world
        entity: cid
        parentAvailW: contentW
        parentAvailH: contentH
        hasParentAvail: true
      )
      childH = r.y
    }
    childH = applyConstraintsH(world: world, entity: cid, h: childH)

    var crossY: Float = contentY
    if alignCross is AlignKind.center {
      crossY = contentY + (contentH - childH) / 2.0
    }
    if alignCross is AlignKind.end {
      crossY = contentY + contentH - childH
    }

    writeComputedRect(
      world: world
      entity: cid
      localX: cursorX
      localY: crossY
      ownW: childW
      ownH: childH
    )
    cursorX = cursorX + childW + gap + extraGap
    j = j + 1
  }
}

func placeVertical(
  world: mod UiWorld
  kids: view List(EntityId)
  contentX: view Float
  contentY: view Float
  contentW: view Float
  contentH: view Float
  gap: view Float
  alignMain: AlignKind
  alignCross: AlignKind
) {
  let n: Int = kids.length
  var fixedSum: Float = 0.0
  var fillCount: Int = 0
  var i: Int = 0
  loop i < n {
    let cid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
    let size: Size = entitySize(world: world, entity: cid)
    if size.h.mode is SizeMode.fill {
      fillCount = fillCount + 1
    } else {
      let r: Vec2 = resolveOwnSize(
        world: world
        entity: cid
        parentAvailW: contentW
        parentAvailH: contentH
        hasParentAvail: true
      )
      fixedSum = fixedSum + r.y
    }
    i = i + 1
  }
  var gapTotal: Float = gap * (n - 1).toFloat()
  if gapTotal < 0.0 {
    gapTotal = 0.0
  }
  var remaining: Float = contentH - fixedSum - gapTotal
  if remaining < 0.0 {
    remaining = 0.0
  }
  var fillSize: Float = 0.0
  if fillCount > 0 {
    fillSize = remaining / fillCount.toFloat()
  }

  # See `placeHorizontal` — same `alignMain` distribution, vertical axis.
  var startOffset: Float = 0.0
  var extraGap: Float = 0.0
  if fillCount is 0 {
    if alignMain is AlignKind.center {
      startOffset = remaining / 2.0
    }
    if alignMain is AlignKind.end {
      startOffset = remaining
    }
    if alignMain is AlignKind.spaceBetween {
      if n > 1 {
        extraGap = remaining / (n - 1).toFloat()
      }
    }
  }

  var cursorY: Float = contentY + startOffset
  var j: Int = 0
  loop j < n {
    let cid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: j)
    let size: Size = entitySize(world: world, entity: cid)
    var childH: Float = 0.0
    if size.h.mode is SizeMode.fill {
      childH = fillSize
    } else {
      let r: Vec2 = resolveOwnSize(
        world: world
        entity: cid
        parentAvailW: contentW
        parentAvailH: contentH
        hasParentAvail: true
      )
      childH = r.y
    }
    childH = applyConstraintsH(world: world, entity: cid, h: childH)
    var childW: Float = 0.0
    if size.w.mode is SizeMode.fill {
      childW = contentW
    } else {
      let r: Vec2 = resolveOwnSize(
        world: world
        entity: cid
        parentAvailW: contentW
        parentAvailH: contentH
        hasParentAvail: true
      )
      childW = r.x
    }
    childW = applyConstraintsW(world: world, entity: cid, w: childW)

    var crossX: Float = contentX
    if alignCross is AlignKind.center {
      crossX = contentX + (contentW - childW) / 2.0
    }
    if alignCross is AlignKind.end {
      crossX = contentX + contentW - childW
    }

    writeComputedRect(
      world: world
      entity: cid
      localX: crossX
      localY: cursorY
      ownW: childW
      ownH: childH
    )
    cursorY = cursorY + childH + gap + extraGap
    j = j + 1
  }
}

func placeStack(
  world: mod UiWorld
  kids: view List(EntityId)
  contentX: view Float
  contentY: view Float
  contentW: view Float
  contentH: view Float
) {
  let n: Int = kids.length
  var i: Int = 0
  loop i < n {
    let cid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
    let resolved: Vec2 = resolveOwnSize(
      world: world
      entity: cid
      parentAvailW: contentW
      parentAvailH: contentH
      hasParentAvail: true
    )
    let childW: Float = applyConstraintsW(world: world, entity: cid, w: resolved.x)
    let childH: Float = applyConstraintsH(world: world, entity: cid, h: resolved.y)

    # Default Stack alignment is centre on both axes; the per-child
    # `Align` overrides it.
    var alignX: AlignKind = AlignKind.center
    var alignY: AlignKind = AlignKind.center
    if componentHas(this: world.aligns, entity: cid) {
      let a: Align = componentGet(this: world.aligns, entity: cid)
      if a.hasX {
        alignX = a.x
      }
      if a.hasY {
        alignY = a.y
      }
    }

    var cx: Float = contentX
    if alignX is AlignKind.center {
      cx = contentX + (contentW - childW) / 2.0
    }
    if alignX is AlignKind.end {
      cx = contentX + contentW - childW
    }
    var cy: Float = contentY
    if alignY is AlignKind.center {
      cy = contentY + (contentH - childH) / 2.0
    }
    if alignY is AlignKind.end {
      cy = contentY + contentH - childH
    }

    writeComputedRect(
      world: world
      entity: cid
      localX: cx
      localY: cy
      ownW: childW
      ownH: childH
    )
    i = i + 1
  }
}

# -----------------------------------------------------------------
# Compute — top-down placement over the parent-before-child depth
# order (#713/#731). Each root seeds its own ComputedRect on arrival
# (size from the world layout extent, x from the ExtentAnchor — see
# rae/docs/ui-coordinate-and-responsive-layout.md); every node then
# places its active children, whose ComputedRects are read when the
# loop reaches them. Roots are gated on `rects` to match the old
# root condition (alive, no Parent, has Rect).
# -----------------------------------------------------------------

func computeLinear(world: mod UiWorld) {
  let order: view List(EntityId) => depthOrder(state: world.hierarchyOrder, parents: world.parents, childrens: world.childrens)
  loop var i: Int = 0, i < order.length, ++i {
    if let entity: EntityId = order.copyAt(index: i) {
      if layoutActive(world: world, entity: entity) {
        if componentHas(this: world.parents, entity: entity) is false {
          if componentHas(this: world.rects, entity: entity) {
            seedRoot(world: world, entity: entity)
          }
        }
        placeChildren(world: world, entity: entity)
      }
    }
  }
  # Standalone roots (no Parent, no Children) are absent from the order.
  let alive: view List(EntityId) => world.allocator.alive
  loop var k: Int = 0, k < alive.length, ++k {
    let entity: EntityId = rae_ext_rae_buf_get(buf: alive.data, index: k)
    if componentHas(this: world.parents, entity: entity) is false {
      if componentHas(this: world.childrens, entity: entity) is false {
        if componentHas(this: world.rects, entity: entity) {
          if layoutActive(world: world, entity: entity) {
            seedRoot(world: world, entity: entity)
          }
        }
      }
    }
  }
}
