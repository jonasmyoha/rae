# lib/ui — the UI component registry FLAGS (#730): which components persist.
#
# ONE place declares, for every UI component, whether it is AUTHORED (persisted:
# registered `serialize`) or DERIVED (a cache some system rebuilds every pass:
# registered WITHOUT `serialize`). The generic serializer in lib/ecs/serialize.rae
# reads this — a derived table is skipped by the registry, not by a type
# annotation and not by a per-component switch.
#
# Scope note (#730 decision): this registry drives the MACHINE snapshot
# (worldToJson/worldFromJson, #768). The human-authored .raescene format (enum
# strings, theme tokens like "gap":"spaceM", flat {x,y,w,h}) is a different,
# hand-friendly grammar and keeps its loader in registry.rae
# (applyComponentByName); that loader is not a serializer and is not replaced.
# The full machine round-trip additionally waits on the compiler parsing enums in
# `fromJson` (#767) — until then a snapshot of a component with an enum field
# reloads that field as 0.
import core
open ecs/registry

# Keyed by the UiWorld FIELD name (#768): the machine snapshot
# (ui/serialize.rae worldToJson/worldFromJson) drives its registry lookups
# with fieldName(table), so the registry must register each table under that
# same field name (`rects`, not `Rect`). Every authored table is registered
# `serialize`; a derived cache (rebuilt by a system) is registered with no
# flags so the snapshot skips it. This is a bijection with UiWorld's
# ComponentTable fields — one entry per table, no more.
func createUiComponentRegistry() ret ComponentRegistry {
  var reg: ComponentRegistry = createComponentRegistry()
  # ----- authored: geometry / layout -----
  registerComponent(reg: reg, name: "rects", flags: serialize)
  registerComponent(reg: reg, name: "sizes", flags: serialize)
  registerComponent(reg: reg, name: "layouts", flags: serialize)
  registerComponent(reg: reg, name: "paddings", flags: serialize)
  registerComponent(reg: reg, name: "margins", flags: serialize)
  registerComponent(reg: reg, name: "safeAreas", flags: serialize)
  registerComponent(reg: reg, name: "aligns", flags: serialize)
  registerComponent(reg: reg, name: "offsets", flags: serialize)
  registerComponent(reg: reg, name: "constraints", flags: serialize)
  registerComponent(reg: reg, name: "overflows", flags: serialize)
  registerComponent(reg: reg, name: "extentAnchors", flags: serialize)
  # ----- authored: visual / interaction -----
  registerComponent(reg: reg, name: "transforms", flags: serialize)
  registerComponent(reg: reg, name: "sprites", flags: serialize)
  registerComponent(reg: reg, name: "texts", flags: serialize)
  registerComponent(reg: reg, name: "textShadows", flags: serialize)
  registerComponent(reg: reg, name: "styleOverrides", flags: serialize)
  registerComponent(reg: reg, name: "shapes", flags: serialize)
  registerComponent(reg: reg, name: "shadows", flags: serialize)
  registerComponent(reg: reg, name: "opacities", flags: serialize)
  registerComponent(reg: reg, name: "pointerEvents", flags: serialize)
  registerComponent(reg: reg, name: "hitAreas", flags: serialize)
  registerComponent(reg: reg, name: "onClicks", flags: serialize)
  registerComponent(reg: reg, name: "buttons", flags: serialize)
  registerComponent(reg: reg, name: "actives", flags: serialize)
  registerComponent(reg: reg, name: "editorVisibles", flags: serialize bitor editorOnly)
  registerComponent(reg: reg, name: "editorLockeds", flags: serialize bitor editorOnly)
  registerComponent(reg: reg, name: "heroWidgets", flags: serialize)
  registerComponent(reg: reg, name: "cornerRadiuses", flags: serialize)
  registerComponent(reg: reg, name: "hoverScales", flags: serialize)
  registerComponent(reg: reg, name: "gradientFills", flags: serialize)
  registerComponent(reg: reg, name: "backdropImages", flags: serialize)
  registerComponent(reg: reg, name: "opticalAligns", flags: serialize)
  registerComponent(reg: reg, name: "layerRoots", flags: serialize)
  registerComponent(reg: reg, name: "layerRefs", flags: serialize)
  registerComponent(reg: reg, name: "debugAnchors", flags: serialize)
  registerComponent(reg: reg, name: "pageRoots", flags: serialize)
  registerComponent(reg: reg, name: "scrollStates", flags: serialize)
  registerComponent(reg: reg, name: "widgetIds", flags: serialize)
  registerComponent(reg: reg, name: "widgetStates", flags: serialize)
  registerComponent(reg: reg, name: "dataDependencies", flags: serialize)
  registerComponent(reg: reg, name: "actionBindings", flags: serialize)
  registerComponent(reg: reg, name: "refreshRegions", flags: serialize)
  registerComponent(reg: reg, name: "stateStyles", flags: serialize)
  registerComponent(reg: reg, name: "aspects", flags: serialize)
  registerComponent(reg: reg, name: "scaleToFits", flags: serialize)
  # ----- authored: identity / metadata -----
  registerComponent(reg: reg, name: "names", flags: serialize)
  registerComponent(reg: reg, name: "primaryTypes", flags: serialize)
  registerComponent(reg: reg, name: "nodeIdComponents", flags: serialize)
  registerComponent(reg: reg, name: "sceneScopes", flags: serialize)
  registerComponent(reg: reg, name: "runtimeOnlys", flags: serialize)
  # ----- authored: dynamic / data binding -----
  registerComponent(reg: reg, name: "sceneInstances", flags: serialize)
  registerComponent(reg: reg, name: "imageSourceResolvers", flags: serialize)
  registerComponent(reg: reg, name: "textBindings", flags: serialize)
  registerComponent(reg: reg, name: "maskShapes", flags: serialize)
  registerComponent(reg: reg, name: "dataRequests", flags: serialize)
  registerComponent(reg: reg, name: "listViews", flags: serialize)
  # ----- authored: effects -----
  registerComponent(reg: reg, name: "backgroundPans", flags: serialize)
  registerComponent(reg: reg, name: "carousels", flags: serialize)
  registerComponent(reg: reg, name: "smokeFxs", flags: serialize)
  registerComponent(reg: reg, name: "animFrames", flags: serialize)
  registerComponent(reg: reg, name: "animTriggers", flags: serialize)
  registerComponent(reg: reg, name: "wobbleFxs", flags: serialize)
  # ----- hierarchy (#769): Children (ORDERED) is AUTHORITATIVE and persists —
  # sibling order is real layout/paint information; Parent is the derived
  # reverse index rebuilt by rebuildParentsFromChildren after a load. -----
  registerComponent(reg: reg, name: "childrens", flags: serialize)
  registerComponent(reg: reg, name: "parents", flags: 0)
  # ----- DERIVED caches: rebuilt every pass by a system, never persisted -----
  registerComponent(reg: reg, name: "measuredSizes", flags: 0)
  registerComponent(reg: reg, name: "computedRects", flags: 0)
  registerComponent(reg: reg, name: "localTransforms", flags: 0)
  registerComponent(reg: reg, name: "worldTransforms", flags: 0)
  registerComponent(reg: reg, name: "worldVisuals", flags: 0)
  registerComponent(reg: reg, name: "runtimeOffsets", flags: 0)
  registerComponent(reg: reg, name: "layoutScales", flags: 0)
  registerComponent(reg: reg, name: "safeInsets", flags: 0)
  registerComponent(reg: reg, name: "animStates", flags: 0)
  registerComponent(reg: reg, name: "visualBounds", flags: 0)
  registerComponent(reg: reg, name: "interactions", flags: 0)
  registerComponent(reg: reg, name: "scrollPanels", flags: 0)
  ret reg
}
