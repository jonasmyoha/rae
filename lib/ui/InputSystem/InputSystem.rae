# Generic ECS pointer input for GPU2D/SDL3 applications.
#
# Hit testing follows reverse paint order and emits semantic action ids from
# OnClick components. Applications use `uiPointerCaptured` to give UI controls
# priority over world/camera input without hard-coding widget identities.
#
# The scroll wheel is ROUTED, not broadcast: each frame `updateUiInput` hands
# the wheel to exactly one consumer — the nearest vertical `ScrollRoot` or `WheelTarget`
# (ui/InputComponents) on the path to the topmost node under the pointer, the sideways
# scroll to the nearest sideways `ScrollRoot` or `WheelTarget` — and
# systems take their share with `uiWheelFor(input, entityId)`. A world camera
# behind the UI is the fallback consumer and takes `uiWheelUnclaimed(input)`:
# the notch only when no UI consumed it and the pointer is not over UI.
# Reading `Gpu2d.wheelMove()` directly from two systems made one wheel notch
# both scroll a list and zoom the canvas beside it.
#
# Every finger presses buttons, not only the pointer's. SDL makes the pointer
# of the FIRST finger on a touch screen only, so a second finger (a thumb
# tapping a button while the other holds a joystick) made no click. Each
# finger that is not the pointer's fires the OnClick action of the node under
# it as it comes down, once per press (`sendFingerPresses`); the pointer's own
# finger clicks through the pointer, on release, as the mouse does, so it is
# counted once.
#
# A click has a count (UiAction.clicks: 2 for a double click, by the system's interval), and an
# OnClick's actionIdDouble / actionIdTriple is sent instead of its actionId when it has one; the
# first click of a double click sends its actionId at once. The secondary button (or Control-click
# on macOS, or a finger held still) sends the action of the nearest OnSecondaryClick
# (PointerButtons.rae).
open ui/Ecs
open ui/AnimationComponents
open ui/Components
open ui/DragComponents
open ui/Layer
open ui/UiLayers
import Gpu2d
import Gpu2dGestures
import Gpu2dWheel
import Math
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open ui/UiSystems
open ui/ZOrder
open ui/ButtonSystem
open ui/InputKind
open ui/DesignUnits
open ui/ScrollDrag
open ui/Transform
import Device

type UiPointerState {
  x: Float
  y: Float
  down: Bool
  pressed: Bool
  released: Bool
  # The device behind it: a finger gets the touch-sized target and no hover
  kind: InputKind
  # Which click of a series the last press is, by the system's double-click interval (1, 2 a
  # double click, 3...; 0, as a scripted pointer may leave it, counts as 1)
  clicks: Int = 0
  # The other two buttons (PointerButtons.rae)
  middle: UiButtonState = {}
  secondary: UiButtonState = {}
}

# UI action events are no longer a list on UiInput (#943): they live in the
# `uiActions` EventQueue resource on UiWorld — produced here, drained by the
# app's UI dispatch. UiInput now carries only pointer + hover/press tracking.
# The axis a trackpad's gesture scrolls scroll roots along
enum UiWheelAxis { both, x, y }

type UiInput {
  pointer: UiPointerState
  hoveredEntityId: EntityId
  pressedEntityId: EntityId
  wheel: Float
  wheelTarget: EntityId
  # The pointer is over UI that paints or takes clicks but consumes no wheel
  # (a panel background, a button): nothing under it gets the notch, and in
  # particular not the world behind the UI (uiWheelUnclaimed).
  wheelBlocked: Bool
  # The kind of the last pointer event, so a whole screen can switch density
  # (as iPadOS and Windows do when the keyboard comes off)
  lastInputKind: InputKind
  # The smallest side a finger's target gets, in the UI's layout units: 44 pt
  # in design units (ui/DesignUnits) by default. A program whose scenes are not
  # yet in design units (example 106, until [ui coords 2d/7]) sets it in its
  # own units, and uiUnitsFromPoints scales every distance by it.
  touchTargetSize: Float
  # Whether the device has a hovering pointer, kept current every frame
  deviceWatch: DeviceWatch
  # The finger SDL makes the pointer of (Gpu2d.touchId), -1 while none is
  # down: its press is the pointer's, not one more finger's
  pointerFingerId: Int = -1
  # This frame's sideways scroll (positive to the right), routed to `wheelXTarget`, and trackpad
  # pinch (scale change, 1 none), routed with the wheel to `wheelTarget`
  wheelX: Float = 0.0
  wheelXTarget: EntityId = noEntity()
  # The scroll came in fractions (a trackpad): its gesture keeps its axis (stepWheelAxis)
  wheelPrecise: Bool = false
  wheelAxis: UiWheelAxis = UiWheelAxis.both
  wheelSeconds: Float64 = -1.0
  wheelSumX: Float = 0.0
  wheelSumY: Float = 0.0
  pinch: Float = 1.0
  # Two fingers on a touch screen (uiTwoFingerStep): whether two are down, how far their middle
  # moved sideways this frame, how much their spread grew (1 none), and where their middle is
  twoFingers: Bool = false
  twoFingerShiftX: Float = 0.0
  twoFingerScale: Float = 1.0
  twoFingerX: Float = 0.0
  twoFingerY: Float = 0.0
  twoFingerSpread: Float = 0.0
  # The time of this frame (updateUiInput sets it; a script that tests a long press sets its own)
  nowSeconds: Float64 = 0.0
  # The primary press that counts as the secondary button until it is let go (Control-click)
  controlClick: Bool = false
  longPress: UiLongPress = {}
  # How many clicks the press being held is, on the node it is on (uiCountPress)
  pressClicks: Int = 1
  clickEntityId: EntityId = noEntity()
  clickBase: Int = 0
}

# Two fingers this frame at (x0, y0) and (x1, y1) (`count` the fingers down): their middle's move
# and their spread's change since the last frame they were both down
func uiTwoFingerStep(
  input: mod UiInput
  count: view Int
  x0: view Float
  y0: view Float
  x1: view Float
  y1: view Float
) {
  input.twoFingerShiftX = 0.0
  input.twoFingerScale = 1.0
  if count < 2 {
    input.twoFingers = false
    ret
  }
  let middleX: Float = (x0 + x1) / 2.0
  let middleY: Float = (y0 + y1) / 2.0
  let spread: Float = Math.sqrt(x: (x1 - x0) * (x1 - x0) + (y1 - y0) * (y1 - y0))
  if input.twoFingers and input.twoFingerSpread > 1.0 {
    input.twoFingerShiftX = middleX - input.twoFingerX
    input.twoFingerScale = spread / input.twoFingerSpread
  }
  input.twoFingers = true
  input.twoFingerX = middleX
  input.twoFingerY = middleY
  input.twoFingerSpread = spread
}

func createUiInput() pub ret UiInput {
  ret UiInput {
    pointer: UiPointerState {
      x: 0.0
      y: 0.0
      down: false
      pressed: false
      released: false
      kind: InputKind.mouse
    }
    hoveredEntityId: noEntity()
    pressedEntityId: noEntity()
    wheel: 0.0
    wheelTarget: noEntity()
    wheelBlocked: false
    lastInputKind: InputKind.mouse
    touchTargetSize: minTouchTargetDu
    deviceWatch: Device.createDeviceWatch()
  }
}

func uiEntityActive(world: view UiWorld, entityId: view EntityId) ret Bool {
  # A leaving node and its subtree take no hits (ui/AnimationComponents)
  if componentHas(this: world.leavings, entityId: entityId) {
    ret false
  }
  if componentHas(this: world.actives, entityId: entityId) {
    let active: view Active = componentView(this: world.actives, entityId: entityId)
    ret active.value
  }
  ret true
}

func uiPointInEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  ret uiPointInEntityTarget(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    x: x
    y: y
    targetSize: 0.0
  )
}

# `uiPointInEntity` with the entity's rectangle grown to at least
# `targetSize` on each side (InputKind.pointInTarget); 0 is the precise test
func uiPointInEntityTarget(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
  targetSize: view Float
) ret Bool {
  if uiEntityActive(world: world, entityId: entityId) is false {
    ret false
  }
  if componentHas(this: uiSystems.transform2d.worldTransforms, entityId: entityId) is false {
    ret false
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false {
    ret false
  }
  let wt: view WorldTransform2D = componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  )
  if worldVisualOf(world: world, uiSystems: uiSystems, entityId: entityId).visible is false {
    ret false
  }
  let cr: view ComputedRect = componentView(
    this: uiSystems.layout.computedRects
    entityId: entityId
  )
  let rect: WorldRect = worldRectOf(wt: wt, cr: cr)
  ret pointInTarget(
    x: x
    y: y
    left: rect.x
    top: rect.y
    width: rect.w
    height: rect.h
    targetSize: targetSize
  )
}

# `uiPointInEntityTarget`, where the entity is not cut off there by an ancestor that clips: what is
# not painted takes no click
func uiPointOnEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
  targetSize: view Float
) ret Bool {
  ret uiPointInEntityTarget(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    x: x
    y: y
    targetSize: targetSize
  ) and uiPointInClips(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    x: x
    y: y
  )
}

func uiHitTestEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
  targetSize: view Float
) ret EntityId {
  unsafe {
    if uiEntityActive(world: world, entityId: entityId) is false {
      ret noEntity()
    }
    # a LayerScope's tagged nodes are on top of the rest of its subtree: tested first
    if componentHas(this: world.layerScopes, entityId: entityId) {
      let tagged: List(EntityId) = scopedTaggedNodes(
        world: world
        uiSystems: uiSystems
        scope: entityId
      )
      loop var t: Int = tagged.length - 1, t >= 0, --t {
        let hit: EntityId = uiHitTestEntity(
          world: world
          uiSystems: uiSystems
          entityId: tagged.copyAtFallback(index: t, fallback: noEntity())
          x: x
          y: y
          targetSize: targetSize
        )
        if isNone(this: hit) is false {
          ret hit
        }
      }
    }
    if componentHas(this: world.childrens, entityId: entityId) {
      let children: view Children = componentView(this: world.childrens, entityId: entityId)
      var i: Int = children.ids.length - 1
      loop i >= 0 {
        let child: EntityId = orderedChildAt(
          world: world
          parentEntityId: entityId
          children: children
          i: i
        )
        # a raised node (ui/Layer isRaisedNode) is tested with its layer's roots instead, a
        # LayerScope's tagged node with its scope above
        if isRaisedNode(world: world, uiSystems: uiSystems, entityId: child) is false and not isScopedTagged(
          world: world
          uiSystems: uiSystems
          entityId: child
        ) {
          let hit: EntityId = uiHitTestEntity(
            world: world
            uiSystems: uiSystems
            entityId: child
            x: x
            y: y
            targetSize: targetSize
          )
          if isNone(this: hit) is false {
            ret hit
          }
        }
        i = i - 1
      }
    }
    # (a ValueSlider's track takes its press, a finger's grown to the touch target: ui/valueSystem)
    if componentHas(this: world.onClicks, entityId: entityId) or customPaintHits(
      world: world
      entityId: entityId
    ) or pressSinkHits(world: world, entityId: entityId) or componentHas(
      this: world.valueSliders
      entityId: entityId
    ) {
      if uiPointOnEntity(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        x: x
        y: y
        targetSize: hitGrowth(world: world, entityId: entityId, targetSize: targetSize)
      ) {
        ret entityId
      }
    }
    ret noEntity()
  }
}

func uiHitTest(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
) ret EntityId {
  ret uiHitTestTarget(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
    targetSize: 0.0
  )
}

# The topmost clickable entity under (x, y), each grown to at least
# `targetSize` on each side (0: the precise test). The hit index answers when it
# is current (ui/InputSystem/HitIndexQuery; updateUiInput syncs it each frame),
# looking only at the nodes near the point; otherwise the tree is walked.
func uiHitTestTarget(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
  targetSize: view Float
) ret EntityId {
  var hit: EntityId = noEntity()
  if hitIndexCurrent(world: world, uiSystems: uiSystems) {
    hit = hitIndexTest(
      world: world
      uiSystems: uiSystems
      x: x
      y: y
      targetSize: targetSize
    )
  } else {
    hit = uiHitTestWalk(
      world: world
      uiSystems: uiSystems
      x: x
      y: y
      targetSize: targetSize
    )
  }
  # a shown dialog-layer root holds every press under it (DialogLayerHold)
  ret dialogLayerHolds(world: world, uiSystems: uiSystems, hit: hit)
}

# The hit test by walking every root's tree in reverse paint order
func uiHitTestWalk(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
  targetSize: view Float
) ret EntityId {
  unsafe {
    let roots: List(EntityId) = rootsInPaintOrder(world: world, uiSystems: uiSystems)
    var i: Int = roots.length - 1
    loop i >= 0 {
      let root: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: i)
      let shown: Bool = isRaisedNode(world: world, uiSystems: uiSystems, entityId: root) is false or raisedNodeShown(
        uiSystems: uiSystems
        entityId: root
      )
      if shown {
        let hit: EntityId = uiHitTestEntity(
          world: world
          uiSystems: uiSystems
          entityId: root
          x: x
          y: y
          targetSize: targetSize
        )
        if isNone(this: hit) is false {
          ret hit
        }
      }
      i = i - 1
    }
    ret noEntity()
  }
}

# One frame of pointer input from the device: the pointer, the wheel and
# the other fingers. `updateUiInputWith` is the same frame from a scripted
# pointer.
func updateUiInput(input: mod UiInput, world: mod UiWorld, uiSystems: mod UiSystems) pub {
  # Keeps `canHover` current: a trackpad case attached or removed
  Device.deviceChanged(watch: input.deviceWatch)
  input.nowSeconds = Gpu2d.nowSeconds()
  let pointer: UiPointerState = devicePointer(input: input)
  var wheel: Float = Gpu2d.wheelMove()
  input.wheelX = Gpu2dGestures.wheelMoveX()
  let wheelKind: Int = Gpu2dWheel.wheelKind()
  if wheelKind is not Gpu2dWheel.wheelKindNone {
    input.wheelPrecise = wheelKind is Gpu2dWheel.wheelKindPrecise
  }
  if shiftedWheel(wheel: wheel, wheelX: input.wheelX) {
    # Shift+wheel is sideways (macOS makes it so itself)
    input.wheelX = -wheel
    wheel = 0.0
  }
  input.pinch = Gpu2dGestures.pinchScale()
  let fingers: Int = Gpu2d.touchCount()
  if fingers >= 2 {
    uiTwoFingerStep(
      input: input
      count: fingers
      x0: Gpu2d.touchX(index: 0)
      y0: Gpu2d.touchY(index: 0)
      x1: Gpu2d.touchX(index: 1)
      y1: Gpu2d.touchY(index: 1)
    )
  } else {
    uiTwoFingerStep(
      input: input
      count: fingers
      x0: 0.0
      y0: 0.0
      x1: 0.0
      y1: 0.0
    )
  }
  stepUiInput(
    input: input
    world: world
    uiSystems: uiSystems
    pointer: pointer
    wheel: wheel
    deviceFingers: true
  )
}

# One frame of pointer input from `pointer` and `wheel` instead of the
# device: what a headless self-test feeds, so a scripted finger goes through
# the same hit test, press tracking, drag claim and release click as a real
# one (uiPointerScriptFrame makes the frames of a script). The device's
# other fingers are not read.
func updateUiInputWith(
  input: mod UiInput
  world: mod UiWorld
  uiSystems: mod UiSystems
  pointer: view UiPointerState
  wheel: view Float
) {
  stepUiInput(
    input: input
    world: world
    uiSystems: uiSystems
    pointer: pointer
    wheel: wheel
    deviceFingers: false
  )
}

# A scripted pointer frame: the pointer at (x, y), down or up, of `kind`;
# pressed and released follow from `previous` (the frame before)
func uiPointerScriptFrame(
  previous: view UiPointerState
  x: view Float
  y: view Float
  down: view Bool
  kind: view InputKind
) ret UiPointerState {
  ret UiPointerState {
    x: x
    y: y
    down: down
    pressed: down and previous.down is false
    released: down is false and previous.down
    kind: kind
  }
}

# How far a press on a scroll root must move along its axis before it is a
# drag, in points (iOS's pan gesture threshold)
const scrollActivationPoints: Float = 10.0

# A distance of `points` in the UI's layout units: design units
# (ui/DesignUnits), times the input's touch target size over its 44 pt in du
# (1 unless a program lays out in units of its own). Every input distance
# given in points (a drag threshold, a wheel step, an edge swipe) goes
# through here.
func uiUnitsFromPoints(input: view UiInput, points: view Float) ret Float {
  ret duFromPoints(points: points) * input.touchTargetSize / minTouchTargetDu
}

# The activation distance in the UI's layout units
func scrollActivationUnits(input: view UiInput) ret Float {
  ret uiUnitsFromPoints(input: input, points: scrollActivationPoints)
}

# Whether a scroll root's drag has claimed the press (ui/ScrollRootSystem):
# its drag is active, or the pointer has moved past the activation distance
# along its axis since the press (a flick whose move and lift land in one
# frame). A claimed press has no pressed entity and its release clicks
# nothing.
# The ValueSlider whose track the pointer is on, by the hit test (a finger's grown to the touch
# target; nothing when a dialog or another node covers it): the slider itself or the one around
# the node hit. None for no slider.
func uiValueSliderAt(
  world: view UiWorld
  uiSystems: view UiSystems
  input: view UiInput
) ret EntityId {
  var at: EntityId = uiHitTestFor(
    world: world
    uiSystems: uiSystems
    x: input.pointer.x
    y: input.pointer.y
    kind: input.pointer.kind
    touchTargetSize: input.touchTargetSize
  )
  loop var depth: Int = 0, depth < 32 and isNone(this: at) is false, ++depth {
    if componentHas(this: world.valueSliders, entityId: at) {
      ret at
    }
    if componentHas(this: uiSystems.hierarchy.parents, entityId: at) is false {
      ret noEntity()
    }
    at = componentView(this: uiSystems.hierarchy.parents, entityId: at).parent
  }
  ret noEntity()
}

func uiPressClaimed(input: view UiInput, world: view UiWorld) ret Bool {
  # A drag has it (ui/DragSystem)
  if world.drag.phase is UiDragPhase.dragging {
    ret true
  }
  # A swipe from the edge has it (ui/PageTransitionSystem/EdgeSwipe)
  if world.edgeSwipe.phase is EdgeSwipePhase.active {
    ret true
  }
  # Or it has just moved far enough, in the frame it may also lift
  if world.edgeSwipe.phase is EdgeSwipePhase.watching {
    let alongX: Float = input.pointer.x - world.edgeSwipe.pressX
    var alongY: Float = input.pointer.y - world.edgeSwipe.pressY
    if alongY < 0.0 {
      alongY = -alongY
    }
    if alongX > scrollActivationUnits(input: input) and alongX > alongY {
      ret true
    }
  }
  let count: Int = componentCount(this: world.scrollDrags)
  loop var i: Int = 0, i < count, ++i {
    let rootEntityId: EntityId = componentEntityAt(this: world.scrollDrags, i: i)
    let drag: view ScrollDrag = componentView(this: world.scrollDrags, entityId: rootEntityId)
    if drag.active {
      ret true
    }
    if drag.dragging and componentHas(this: world.scrollRoots, entityId: rootEntityId) {
      var along: Float = input.pointer.y
      if componentView(this: world.scrollRoots, entityId: rootEntityId).axis is ScrollAxis.x {
        along = input.pointer.x
      }
      var moved: Float = along - drag.pressPointer
      if moved < 0.0 {
        moved = -moved
      }
      if moved > scrollActivationUnits(input: input) {
        ret true
      }
    }
  }
  ret false
}

func stepUiInput(
  input: mod UiInput
  world: mod UiWorld
  uiSystems: mod UiSystems
  pointer: view UiPointerState
  wheel: view Float
  deviceFingers: view Bool
) {
  # Recycle last frame's action channel: frameAdvance swaps in the empty spare so
  # this frame's input produces into a clean queue (the old clearUiActions).
  frameAdvance(this: world.uiActions)
  # the hit index made current for this frame's hit tests
  hitIndexSync(world: world, uiSystems: uiSystems)
  # Clear last frame's per-entity marks before recomputing (previous hovered +
  # pressed are the only two that can carry an Interaction).
  buttonInteractionClear(world: world, uiSystems: uiSystems, entityId: input.hoveredEntityId)
  buttonInteractionClear(world: world, uiSystems: uiSystems, entityId: input.pressedEntityId)

  let x: Float = pointer.x
  let y: Float = pointer.y
  let pressed: Bool = pointer.pressed
  let released: Bool = pointer.released
  let kind: InputKind = pointer.kind
  input.pointer = pointer
  input.lastInputKind = kind
  input.hoveredEntityId = uiHitTestFor(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
    kind: kind
    touchTargetSize: input.touchTargetSize
  )
  routeUiWheel(
    input: input
    world: world
    uiSystems: uiSystems
    wheel: wheel
  )
  if pressed {
    input.pressedEntityId = input.hoveredEntityId
    uiCountPress(input: input, clicks: pointer.clicks)
  }
  # a drag took the press: no pressed look, and no click on its release
  if pressed is false and isNone(this: input.pressedEntityId) is false and uiPressClaimed(
    input: input
    world: world
  ) {
    input.pressedEntityId = noEntity()
  }
  uiSecondaryStep(input: input, world: world, uiSystems: uiSystems)
  if deviceFingers {
    sendFingerPresses(input: input, world: world, uiSystems: uiSystems)
  }
  if released {
    if isNone(this: input.hoveredEntityId) is false {
      # a PressSink takes the press and fires nothing
      if input.hoveredEntityId is input.pressedEntityId and componentHas(
        this: world.onClicks
        entityId: input.hoveredEntityId
      ) {
        let click: view OnClick = componentView(
          this: world.onClicks
          entityId: input.hoveredEntityId
        )
        eventSend(
          this: world.uiActions
          value: UiAction {
            entityId: input.hoveredEntityId
            actionId: uiClickActionId(click: click, clicks: input.pressClicks)
            clicks: input.pressClicks
          }
        )
      }
    }
    input.pressedEntityId = noEntity()
  }

  # Project this frame's hovered/pressed refs onto the entities as components.
  # Hover is marked only for a pointer that hovers (InputKind.showsHover). A PressSink
  # without an OnClick takes the press but is never hovered or pressed to look at.
  if showsHover(kind: kind, canHover: input.deviceWatch.facts.canHover) {
    buttonInteractionMark(
      world: world
      uiSystems: uiSystems
      entityId: interactionTarget(world: world, entityId: input.hoveredEntityId)
      hovered: true
      pressed: false
    )
  }
  buttonInteractionMark(
    world: world
    uiSystems: uiSystems
    entityId: interactionTarget(world: world, entityId: input.pressedEntityId)
    hovered: false
    pressed: true
  )
}

# `entityId`, or none for a PressSink that is not also clickable: it shows no hover or press
func interactionTarget(world: view UiWorld, entityId: view EntityId) ret EntityId {
  if isNone(this: entityId) is false and componentHas(this: world.onClicks, entityId: entityId) is false and pressSinkHits(
    world: world
    entityId: entityId
  ) {
    ret noEntity()
  }
  ret entityId
}

# Fire the OnClick action under every finger that came down this frame, but
# the pointer's: the finger that comes down as the pointer is pressed by a
# touch (SDL makes it of the first finger, whose events come first) is the
# pointer's, until it is lifted.
func sendFingerPresses(input: mod UiInput, world: mod UiWorld, uiSystems: view UiSystems) {
  if input.pointerFingerId >= 0 and fingerDown(id: input.pointerFingerId) is false {
    input.pointerFingerId = -1
  }
  loop var i: Int = 0, i < Gpu2d.touchCount(), ++i {
    if Gpu2d.touchPressed(index: i) {
      if input.pointerFingerId < 0 and input.pointer.pressed and input.pointer.kind is InputKind.touch {
        input.pointerFingerId = Gpu2d.touchId(index: i)
      } else {
        let hit: EntityId = uiHitTestFor(
          world: world
          uiSystems: uiSystems
          x: Gpu2d.touchX(index: i)
          y: Gpu2d.touchY(index: i)
          kind: InputKind.touch
          touchTargetSize: input.touchTargetSize
        )
        if isNone(this: hit) is false and componentHas(this: world.onClicks, entityId: hit) {
          let click: view OnClick = componentView(this: world.onClicks, entityId: hit)
          eventSend(
            this: world.uiActions
            value: UiAction { entityId: hit, actionId: click.actionId }
          )
        }
      }
    }
  }
}

# Is the finger `id` still on the screen?
func fingerDown(id: view Int) ret Bool {
  loop var i: Int = 0, i < Gpu2d.touchCount(), ++i {
    if Gpu2d.touchId(index: i) is id {
      ret true
    }
  }
  ret false
}

# The entity a pointer of `kind` hits: the precise rectangle first, so a
# finger between two small controls takes the one it is on; then, for a
# finger only, the touch-sized targets (`touchTargetSize` on each side)
func uiHitTestFor(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
  kind: view InputKind
  touchTargetSize: view Float
) ret EntityId {
  let precise: EntityId = uiHitTest(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
  )
  if isNone(this: precise) is false or kind is not InputKind.touch {
    ret precise
  }
  ret uiHitTestTarget(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
    targetSize: targetSizeFor(kind: kind, touchTargetUnits: touchTargetSize)
  )
}

# Drop the in-progress press and anything already queued, so a release cannot
# turn into a click. Used when an overlay drawn OUTSIDE this world took the
# press — the debug overlay sits over the side panel in 110 and 113, and without
# this the same click would work the button underneath it too.
func suppressUiPress(input: mod UiInput, world: mod UiWorld) {
  eventClear(this: world.uiActions)
  input.pressedEntityId = noEntity()
  input.longPress.phase = UiLongPressPhase.idle
  input.wheel = 0.0
  input.wheelTarget = noEntity()
  input.wheelX = 0.0
  input.wheelXTarget = noEntity()
  input.wheelBlocked = false
}

func uiPointerCaptured(input: view UiInput) pub ret Bool {
  if isNone(this: input.hoveredEntityId) is false {
    ret true
  }
  if isNone(this: input.pressedEntityId) is false {
    ret true
  }
  ret false
}
