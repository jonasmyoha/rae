# TextFieldSystem — typing into the scene's TextFields (ui/BindingComponents).
#
# - A tap on a field (a UiAction this frame whose entity carries a TextField)
#   gives it focus; a tap anywhere else, or Return, takes focus away. The focus
#   is the `focused` flag on the field, so at most one field has it.
# - While a field has focus, OS text input is on (on a phone that shows the
#   keyboard): the frame's typed characters are added and each Backspace
#   removes the last character (a whole UTF-8 sequence).
# - Return sends the field's `actionId` as a UiAction with no entity, the same
#   action a button with that id sends; `textFieldTextFor` reads the text and
#   `clearTextFieldsFor` empties the field once the app has used it.
# - Each field's first Text child shows its text, or its placeholder while it
#   is empty and has no focus. The caret is not a character in that text: the
#   renderer draws it after the text (ui/RenderSystem/RenderCaret) while
#   `caretVisible`, which blinks every `caretBlinkSeconds` from the last edit or
#   focus change. `textFieldDeadlineSeconds` is when it next changes, for the
#   event loop's wait.
# - `keyboardHeight` is the on-screen keyboard's height in points (0 when none
#   is shown, always 0 on a desktop), so a layout can keep a field above it.
# - The focused field has a caret and a selection (text/TextEdit, kept in
#   TextFieldSystem.edit): the caret starts at the text's end and moves by
#   Left, Right, Home and End, by words with Alt or Ctrl, to the ends with
#   Command, and by a press or a drag (ui/TextFieldPointerSystem). Shift with
#   each selects, Cmd+A selects all. Typing, paste, Backspace and Delete act
#   on the selection; with Alt or Ctrl the deleting keys take a word, with
#   Command the line to that end. Cmd+Z undoes, Shift+Cmd+Z or Ctrl+Y redoes,
#   until the focus moves. setTextFieldSelection sets it from code.
# - While a menu is open (ui/MenuSystem) the keys are the menu's.
# - Cmd+V (Ctrl+V) pastes the clipboard's text at the caret
#   with its line breaks dropped, as every field is one line; Cmd+C
#   copies and Cmd+X cuts the selection, or with none the field's whole text. The clipboard is the
#   system's (Gpu2dTextInput.clipboardText), or a scripted one a test fills
#   with setTextFieldClipboard: the scripted step "put this on the clipboard,
#   then paste" is that plus a frame with `paste`.
# - On iOS a press held still on the focused field shows the system edit menu
#   (textFieldMenuSystem): Paste when the clipboard has text, Copy and Cut when
#   the field has some. The item picked arrives as the next frame's paste /
#   copy / cut (readTextInputFrame polls Gpu2dTextInput.editMenuChoice).
import Gpu2dTextInput
import Sdl3
open Keys
open text/TextEdit
open ui/Ecs
open ui/Components
open ui/BindingComponents
open ui/DesignUnits
open ui/UiSystems
open ecs/Entity
open ecs/Event
open ecs/ComponentTable

# Half a blink: the caret shows for this long, then hides for as long
const caretBlinkSeconds: Float64 = 0.53

# What the keyboard and the pointer did this frame
type TextInputFrame {
  # the UTF-8 characters typed since the last poll
  typed: String
  backspaces: Int
  enter: Bool
  # a tap ended this frame, on anything or on nothing
  tapped: Bool
  # Cmd/Ctrl + V, C, X pressed this frame
  paste: Bool = false
  copy: Bool = false
  cut: Bool = false
  # A move of the caret, and whether it selects (Shift)
  move: TextMove = TextMove.none
  extend: Bool = false
  selectAll: Bool = false
  # Forward deletes, and what they and the backspaces take: a character, a word, all to that end
  deletes: Int = 0
  deleteWord: Bool = false
  deleteLine: Bool = false
  undo: Bool = false
  redo: Bool = false
}

# The caret's move by the arrow, Home and End keys (held ones repeat)
func readTextMove(word: view Bool, line: view Bool) ret TextMove {
  if Sdl3.isKeyTyped(key: keyHome) {
    ret TextMove.start
  }
  if Sdl3.isKeyTyped(key: keyEnd) {
    ret TextMove.end
  }
  if Sdl3.isKeyTyped(key: keyLeft) {
    if line {
      ret TextMove.start
    }
    if word {
      ret TextMove.wordLeft
    }
    ret TextMove.left
  }
  if Sdl3.isKeyTyped(key: keyRight) {
    if line {
      ret TextMove.end
    }
    if word {
      ret TextMove.wordRight
    }
    ret TextMove.right
  }
  ret TextMove.none
}

# This frame's typing from the window (Gpu2dTextInput and the SDL keys);
# `tapped` is the app's own pointer state
func readTextInputFrame(tapped: view Bool) ret TextInputFrame {
  var backspaces: Int = 0
  if Sdl3.isKeyTyped(key: keyBackspace) {
    backspaces = 1
  }
  var deletes: Int = 0
  if Sdl3.isKeyTyped(key: keyDelete) {
    deletes = 1
  }
  let line: Bool = Sdl3.isKeyDown(key: keyLGui) or Sdl3.isKeyDown(key: keyRGui)
  let word: Bool = Sdl3.isKeyDown(key: keyLAlt) or Sdl3.isKeyDown(key: keyRAlt) or Sdl3.isKeyDown(
    key: keyLCtrl
  ) or Sdl3.isKeyDown(key: keyRCtrl)
  let shift: Bool = Sdl3.isKeyDown(key: keyLShift) or Sdl3.isKeyDown(key: keyRShift)
  # the command key: Command on the Mac, Ctrl elsewhere (either works)
  let command: Bool = Sdl3.isKeyDown(key: keyLGui) or Sdl3.isKeyDown(key: keyRGui) or Sdl3.isKeyDown(
    key: keyLCtrl
  ) or Sdl3.isKeyDown(key: keyRCtrl)
  # the item picked in the edit menu (iOS), read once
  let menuChoice: Int = Gpu2dTextInput.editMenuChoice()
  ret TextInputFrame {
    typed: Gpu2dTextInput.textInput()
    backspaces: backspaces
    enter: Sdl3.isKeyPressed(key: keyEnter)
    tapped: tapped
    paste: (command and Sdl3.isKeyPressed(key: keyV)) or menuChoice is 1
    copy: (command and Sdl3.isKeyPressed(key: keyC)) or menuChoice is 2
    cut: (command and Sdl3.isKeyPressed(key: keyX)) or menuChoice is 3
    move: readTextMove(word: word, line: line)
    extend: shift
    selectAll: command and Sdl3.isKeyPressed(key: keyA)
    deletes: deletes
    deleteWord: word
    deleteLine: line
    undo: command and not shift and Sdl3.isKeyTyped(key: keyZ)
    redo: command and ((shift and Sdl3.isKeyTyped(key: keyZ)) or Sdl3.isKeyTyped(key: keyY))
  }
}

# Make the text field system's clipboard a scripted one holding `text` (a
# test, a self-test): paste, copy and cut then use it, and the system
# clipboard is never read or changed
func setTextFieldClipboard(textFieldSystem: mod TextFieldSystem, text: view String) {
  textFieldSystem.clipboardScripted = true
  textFieldSystem.clipboardText = "{text}"
}

# The clipboard's text: the scripted one, else the system's
func textFieldClipboard(textFieldSystem: view TextFieldSystem) ret String {
  if textFieldSystem.clipboardScripted {
    ret "{textFieldSystem.clipboardText}"
  }
  ret Gpu2dTextInput.clipboardText()
}

func putOnTextFieldClipboard(textFieldSystem: mod TextFieldSystem, text: view String) {
  if textFieldSystem.clipboardScripted {
    textFieldSystem.clipboardText = "{text}"
    ret
  }
  let put: Bool = Gpu2dTextInput.setClipboardText(text: text)
}

# `text` on one line: every line break (CR, LF) dropped
func withoutLineBreaks(text: view String) ret String {
  ret text.replace(old: "\r", new: "").replace(old: "\n", new: "")
}

# The field that has focus, or noEntity()
func focusedTextFieldEntityId(world: view UiWorld) ret EntityId {
  let count: Int = componentCount(this: world.textFields)
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: world.textFields, i: i)
    if componentView(this: world.textFields, entityId: entityId).focused {
      ret entityId
    }
  }
  ret noEntity()
}

# Give `entityId` the focus (noEntity() for none), taking it from every other
# field. True when it moved.
func focusTextField(world: mod UiWorld, entityId: view EntityId) ret Bool {
  var changed: Bool = false
  let count: Int = componentCount(this: world.textFields)
  loop var i: Int = 0, i < count, ++i {
    let fieldEntityId: EntityId = componentEntityAt(this: world.textFields, i: i)
    let wanted: Bool = fieldEntityId is entityId and componentHas(
      this: world.leavings
      entityId: entityId
    ) is false
    if componentView(this: world.textFields, entityId: fieldEntityId).focused is not wanted {
      componentMod(this: world.textFields, entityId: fieldEntityId).focused = wanted
      changed = true
    }
  }
  ret changed
}

# The focused field's edit made current: a new one, with the caret at the text's end, when the focus
# is on another field than before or the field's text was set by something else
func syncTextFieldEdit(
  world: view UiWorld
  textFieldSystem: mod TextFieldSystem
  fieldEntityId: view EntityId
) {
  let field: view TextField = componentView(this: world.textFields, entityId: fieldEntityId)
  if fieldEntityId is textFieldSystem.editEntityId and field.text is textFieldSystem.edit.text {
    ret
  }
  textFieldSystem.edit = createTextEdit(text: field.text)
  textFieldSystem.editEntityId = fieldEntityId
  textFieldSystem.scroll = 0.0
}

# Focus `entityId`'s field with its text from `start` to `end` selected (byte offsets, moved to
# whole
# characters), the caret at `end`: a rename selects a name without its extension so. False when it
# is no text field.
func setTextFieldSelection(
  world: mod UiWorld
  textFieldSystem: mod TextFieldSystem
  entityId: view EntityId
  start: view Int
  end: view Int
) ret Bool {
  if componentHas(this: world.textFields, entityId: entityId) is false {
    ret false
  }
  let moved: Bool = focusTextField(world: world, entityId: entityId)
  syncTextFieldEdit(world: world, textFieldSystem: textFieldSystem, fieldEntityId: entityId)
  selectText(edit: textFieldSystem.edit, start: start, end: end)
  ret true
}

# The selection of the focused field as byte offsets, its start and end the same when nothing is
# selected; none when no field has focus
func textFieldSelection(
  world: view UiWorld
  textFieldSystem: view TextFieldSystem
) ret opt TextSpan {
  let focused: EntityId = focusedTextFieldEntityId(world: world)
  if isNone(this: focused) {
    ret none
  }
  if focused is not textFieldSystem.editEntityId {
    let end: Int = componentView(this: world.textFields, entityId: focused).text.length()
    ret TextSpan { start: end, end: end }
  }
  ret TextSpan {
    start: selectionStart(edit: textFieldSystem.edit)
    end: selectionEnd(edit: textFieldSystem.edit)
  }
}

# What a deleting key takes: one character, or with a modifier a word or all to that end
func deletingMove(input: view TextInputFrame, forward: view Bool) ret TextMove {
  if forward {
    if input.deleteLine {
      ret TextMove.end
    }
    if input.deleteWord {
      ret TextMove.wordRight
    }
    ret TextMove.right
  }
  if input.deleteLine {
    ret TextMove.start
  }
  if input.deleteWord {
    ret TextMove.wordLeft
  }
  ret TextMove.left
}

# This frame's keys and clipboard on the focused field; true when its text, caret or selection
# changed
func editTextField(
  world: mod UiWorld
  textFieldSystem: mod TextFieldSystem
  fieldEntityId: view EntityId
  input: view TextInputFrame
  now: view Float64
) ret Bool {
  syncTextFieldEdit(world: world, textFieldSystem: textFieldSystem, fieldEntityId: fieldEntityId)
  let caret: Int = textFieldSystem.edit.caret
  let anchor: Int = textFieldSystem.edit.anchor
  var changed: Bool = false
  if input.undo {
    changed = undoEdit(edit: textFieldSystem.edit) or changed
  }
  if input.redo {
    changed = redoEdit(edit: textFieldSystem.edit) or changed
  }
  if input.selectAll {
    selectText(edit: textFieldSystem.edit, start: 0, end: textFieldSystem.edit.text.length())
  }
  moveCaret(edit: textFieldSystem.edit, move: input.move, extend: input.extend)
  loop var i: Int = 0, i < input.backspaces, ++i {
    changed = deleteBy(
      edit: textFieldSystem.edit
      move: deletingMove(input: input, forward: false)
      now: now
    ) or changed
  }
  loop var i: Int = 0, i < input.deletes, ++i {
    changed = deleteBy(
      edit: textFieldSystem.edit
      move: deletingMove(input: input, forward: true)
      now: now
    ) or changed
  }
  if input.typed.length() > 0 {
    changed = replaceSelection(
      edit: textFieldSystem.edit
      text: input.typed
      kind: TextEditKind.typed
      now: now
    ) or changed
  }
  if input.copy or input.cut {
    # the selection, or with none the whole text
    var taken: String = selectedText(edit: textFieldSystem.edit)
    if taken.length() is 0 {
      taken = "{textFieldSystem.edit.text}"
      if input.cut {
        selectText(edit: textFieldSystem.edit, start: 0, end: taken.length())
      }
    }
    if taken.length() > 0 {
      putOnTextFieldClipboard(textFieldSystem: textFieldSystem, text: taken)
    }
    if input.cut {
      changed = replaceSelection(
        edit: textFieldSystem.edit
        text: ""
        kind: TextEditKind.other
        now: now
      ) or changed
    }
  }
  if input.paste {
    let pasted: String = withoutLineBreaks(
      text: textFieldClipboard(textFieldSystem: textFieldSystem)
    )
    if pasted.length() > 0 {
      changed = replaceSelection(
        edit: textFieldSystem.edit
        text: pasted
        kind: TextEditKind.other
        now: now
      ) or changed
    }
  }
  if changed {
    let text: String = "{textFieldSystem.edit.text}"
    componentMod(this: world.textFields, entityId: fieldEntityId).text = text
  }
  ret changed or textFieldSystem.edit.caret is not caret or textFieldSystem.edit.anchor is not anchor
}

# Focus from this frame's taps, then typing into the focused field; Return
# sends its action into `actions`. Then OS text input follows the focus, the
# Text children show the fields and the caret's blink phase is updated. True
# when something on screen changed (a field, the focus, the caret's blink).
func textFieldSystem(
  world: mod UiWorld
  textFieldSystem: mod TextFieldSystem
  actions: mod EventQueue(UiAction)
  input: view TextInputFrame
  now: view Float64
) ret Bool {
  var changed: Bool = false
  # the focus: a tap on a field takes it there, a tap elsewhere drops it
  var tappedField: EntityId = noEntity()
  var tappedSomething: Bool = input.tapped
  var tappedOnGone: Bool = false
  loop var i: Int = 0, i < eventCount(this: actions), ++i {
    let action: UiAction = eventAt(this: actions, i: i)
    if isNone(this: action.entityId) is false {
      tappedSomething = true
      if isAlive(world: world, entityId: action.entityId) is false {
        # a row of a menu that closed by it
        tappedOnGone = true
      } else if componentHas(this: world.textFields, entityId: action.entityId) {
        tappedField = action.entityId
      }
    }
  }
  # a press that moves a field's caret (TextFieldPointerSystem) gave it the focus already, and may
  # end outside it; a menu's presses are the menu's
  let keepsFocus: Bool = isNone(this: textFieldSystem.press.fieldEntityId) is false or tappedOnGone or world.menu.open
  if tappedSomething and keepsFocus is false and tappedField is not focusedTextFieldEntityId(
    world: world
  ) {
    changed = focusTextField(world: world, entityId: tappedField) or changed
  }
  # the typing
  let focused: EntityId = focusedTextFieldEntityId(world: world)
  textFieldSystem.tookKeys = isNone(this: focused) is false
  if isNone(this: focused) is false and world.menu.open is false {
    changed = editTextField(
      world: world
      textFieldSystem: textFieldSystem
      fieldEntityId: focused
      input: input
      now: now
    ) or changed
    let field: mod TextField = componentMod(this: world.textFields, entityId: focused)
    if input.enter {
      if field.actionId.length() > 0 {
        eventSend(
          this: actions
          value: UiAction { entityId: noEntity(), actionId: "{field.actionId}" }
        )
      }
      field.focused = false
      changed = true
    }
  }
  if isNone(this: focused) {
    # an edit ends with its focus
    textFieldSystem.editEntityId = noEntity()
  }
  let stillFocused: Bool = isNone(this: focusedTextFieldEntityId(world: world)) is false
  if stillFocused is not textFieldSystem.textInputOn {
    textFieldSystem.textInputOn = stillFocused
    Gpu2dTextInput.setTextInput(active: stillFocused)
  }
  # the OS reports points; layout is in design units
  textFieldSystem.keyboardHeight = duFromPoints(points: Gpu2dTextInput.keyboardHeight())
  if changed {
    # an edit or a focus change shows the caret at once
    textFieldSystem.caretEpoch = now
  }
  changed = textFieldViewSystem(world: world, textFieldSystem: textFieldSystem) or changed
  changed = updateCaretBlink(world: world, textFieldSystem: textFieldSystem, now: now) or changed
  ret changed
}

# The field's visible line: its first child that carries a Text
func textFieldLineEntityId(world: view UiWorld, fieldEntityId: view EntityId) ret EntityId {
  if componentHas(this: world.childrens, entityId: fieldEntityId) is false {
    ret noEntity()
  }
  let children: view Children = componentView(this: world.childrens, entityId: fieldEntityId)
  loop let child: view EntityId in children.ids {
    if componentHas(this: world.texts, entityId: child) {
      ret child
    }
  }
  ret noEntity()
}

# Write each field's Text child: its text, or its placeholder while it is
# empty and has no focus. Remembers the focused field's line for the caret.
# True when a Text changed.
func textFieldViewSystem(world: mod UiWorld, textFieldSystem: mod TextFieldSystem) ret Bool {
  var changed: Bool = false
  textFieldSystem.caretLineEntityId = noEntity()
  let count: Int = componentCount(this: world.textFields)
  loop var i: Int = 0, i < count, ++i {
    let fieldEntityId: EntityId = componentEntityAt(this: world.textFields, i: i)
    let line: EntityId = textFieldLineEntityId(world: world, fieldEntityId: fieldEntityId)
    if isNone(this: line) {
      continue
    }
    let field: view TextField = componentView(this: world.textFields, entityId: fieldEntityId)
    if field.focused {
      textFieldSystem.caretLineEntityId = line
    }
    # compared in place first: building the shown text and style to compare was two Strings per
    # field per frame
    if not textFieldLineCurrent(world: world, field: field, line: line) {
      var shown: String = "{field.text}"
      var styleId: String = "{field.textStyleId}"
      if field.text.length() is 0 and field.focused is false {
        shown = "{field.placeholder}"
        styleId = "{field.placeholderStyleId}"
      }
      let text: mod Text = componentMod(this: world.texts, entityId: line)
      text.text = shown
      text.styleId = styleId
      changed = true
    }
  }
  ret changed
}

# The field's line already shows what it should: its text in its style, or the placeholder in the
# placeholder's style when it is empty and not focused
func textFieldLineCurrent(
  world: view UiWorld
  field: view TextField
  line: view EntityId
) ret Bool {
  let current: view Text = componentView(this: world.texts, entityId: line)
  if field.text.length() is 0 and field.focused is false {
    ret current.text is field.placeholder and current.styleId is field.placeholderStyleId
  }
  ret current.text is field.text and current.styleId is field.textStyleId
}

# The caret shows in the first half of each blink from `caretEpoch`. True
# when it changed.
func updateCaretBlink(
  world: view UiWorld
  textFieldSystem: mod TextFieldSystem
  now: view Float64
) ret Bool {
  var visible: Bool = false
  # no caret while something is selected
  if isNone(this: textFieldSystem.caretLineEntityId) is false and not (textFieldSystem.editEntityId is focusedTextFieldEntityId(
    world: world
  ) and hasSelection(edit: textFieldSystem.edit)) {
    let phase: Int = ((now - textFieldSystem.caretEpoch) / caretBlinkSeconds) as Int
    visible = phase % 2 is 0
  }
  if visible is textFieldSystem.caretVisible {
    ret false
  }
  textFieldSystem.caretVisible = visible
  ret true
}

# Seconds until the caret next blinks, 0 when no field has focus (the
# heartbeat convention of ui/EventLoop.nextWaitTimeoutSeconds): the longest an
# event loop may wait while a field has focus
func textFieldDeadlineSeconds(textFieldSystem: view TextFieldSystem, now: view Float64) ret Float {
  if isNone(this: textFieldSystem.caretLineEntityId) {
    ret 0.0
  }
  let elapsed: Float64 = now - textFieldSystem.caretEpoch
  let phase: Int = (elapsed / caretBlinkSeconds) as Int
  let remaining: Float = ((phase + 1) as Float64 * caretBlinkSeconds - elapsed) as Float
  if remaining < 0.001 {
    ret 0.001
  }
  ret remaining
}

# The text of the field whose action is `actionId` ("" when none)
func textFieldTextFor(world: view UiWorld, actionId: view String) ret String {
  let count: Int = componentCount(this: world.textFields)
  loop var i: Int = 0, i < count, ++i {
    let field: view TextField = componentView(
      this: world.textFields
      entityId: componentEntityAt(this: world.textFields, i: i)
    )
    if field.actionId is actionId {
      ret "{field.text}"
    }
  }
  ret ""
}

# Empty every field whose action is `actionId` (the app has used its text).
# True when one changed.
func clearTextFieldsFor(world: mod UiWorld, actionId: view String) ret Bool {
  var changed: Bool = false
  let count: Int = componentCount(this: world.textFields)
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: world.textFields, i: i)
    if componentView(this: world.textFields, entityId: entityId).actionId is actionId {
      let field: mod TextField = componentMod(this: world.textFields, entityId: entityId)
      if field.text.length() > 0 {
        field.text = ""
        changed = true
      }
    }
  }
  ret changed
}
