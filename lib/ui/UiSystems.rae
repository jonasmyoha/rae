# The lib UI systems that OWN their derived tables (docs/ecs-systems-own-
# their-tables.md §3.1): what a system derives lives on the system, not on
# the world. `UiWorld` keeps the authored shared tables (many readers, no
# better owner), the hierarchy's authoritative `Children`, the resources and
# the allocator; these structs keep what one pass computes for the others.
#
# `UiSystems` is the aggregate an app (or app3d/UiShell) owns next to its
# world and hands to the pipeline and to every function that reads a derived
# table — `mod` for the owner writing, `view` for a reader. It grows in the
# second half of the split (Transform2dSystem, AnimationSystem, ButtonSystem).
open ui/Components
open ui/BindingComponents
open ui/InputComponents
import ecs/Transform
open ecs/Hierarchy
open ecs/Entity
open ecs/Queue
open ui/animationSystem/AnimationRules
open ui/listMotionSystem/ListMotionRules
open ui/animationSystem/AnimationTracks
open ecs/ComponentTable

# layoutSystem's output: measured sizes, the font measure of Hug text leaves,
# the computed rects, and the per-subtree layout scale.
type LayoutSystem {
  measuredSizes: ComponentTable(MeasuredSize)
  measuredTexts: ComponentTable(MeasuredText)
  computedRects: ComponentTable(ComputedRect)
  layoutScales: ComponentTable(LayoutScale)
}

# textFieldSystem's state (ui/textFieldSystem): where the caret is drawn and
# whether it shows in this blink phase, when the phase started, whether OS
# text input is on, and the height of the on-screen keyboard in points (0
# when none is shown) so a layout can keep a field above it. The focus itself
# is data on the TextField.
type TextFieldSystem {
  caretLineEntityId: EntityId
  caretVisible: Bool
  caretEpoch: Float64
  textInputOn: Bool
  keyboardHeight: Float
  # The clipboard paste, copy and cut use: the system one, or a scripted one
  # (`scripted` true, then `clipboardText` is the clipboard) that a test or a
  # self-test fills with setTextFieldClipboard, never touching the system's
  clipboardScripted: Bool = false
  clipboardText: String = ""
  # A press held on the focused field (textFieldMenuSystem): where and when
  # it began, and whether its edit menu has been shown; menuShows counts the
  # menus shown (a test reads it)
  pressTracking: Bool = false
  pressStartSec: Float64 = 0.0
  pressX: Float = 0.0
  pressY: Float = 0.0
  pressMenuShown: Bool = false
  menuShows: Int = 0
}

# safeAreaSystem's output: the resolved insets per SafeArea node.
type SafeAreaSystem {
  safeInsets: ComponentTable(SafeInsets)
}

# The hierarchy's DERIVED half: `Parent` per child, rebuilt from the
# authoritative `Children` on the world.
type HierarchySystem {
  parents: ComponentTable(Parent)
}

# transformSystem's output: the local and world 2D transforms, the world
# visual (opacity / visibility chain) and the runtime offsets systems write.
# Spelled with the dimension: Transform3dSystem is the 3D sibling to come.
type Transform2dSystem {
  localTransforms: ComponentTable(Transform2D)
  worldTransforms: ComponentTable(WorldTransform2D)
  worldVisuals: ComponentTable(WorldVisual)
  runtimeOffsets: ComponentTable(RuntimeOffset)
}

# The effect systems' per-entity runtime state (#1005).
type AnimationSystem {
  animStates: ComponentTable(AnimState)
  smokeStates: ComponentTable(SmokeState)
  carouselStates: ComponentTable(CarouselState)
  # What is moving, and the result the transform pass folds in (animationSystem/AnimationTracks)
  tracks: ComponentTable(AnimationTrack)
  poses: ComponentTable(AnimationPose)
  commands: Queue(AnimationCommand)
  settings: AnimationSettings
  # Updates run, for the test that an idle UI runs none, and the clock of the last one
  updates: Int = 0
  # The tables animationTriggers last looked at: what moved since says whether to look again
  triggerGeneration: Int = -1
  # AnimateLayout: each marked node's last laid-out place, and what that was laid out for
  layoutPlaces: ComponentTable(LayoutPlace)
  layoutGeneration: Int = -1
  layoutWidth: Float = 0.0
  layoutHeight: Float = 0.0
  # AnimateText: each marked node's last text, and the old text still being drawn
  textSeens: ComponentTable(TextSeen)
  textGhosts: ComponentTable(TextGhost)
  textGeneration: Int = -1
  # listMotionSystem: what each animated list last showed
  listMotions: ComponentTable(ListMotionState)
  # SharedElements: the nodes doing a shared element's work
  sharedNodes: ComponentTable(SharedNode)
  sharedSeens: ComponentTable(SharedSeen)
  lastFrameNs: Int = 0
}

# The button system (buttonSystem/): the per-entity pointer state it derives
# (hovered / pressed) — its style swap and hover scale read it from here.
# #729: per-entity pointer interaction state, maintained by the input system
# (InputSystem/updateUiInput). `hovered` = the pointer is over this entity;
# `pressed` = the press that is currently down started on this entity. The pointer
# POSITION and the action-event queue stay singleton on `UiInput` (a pointer is one
# device — that is not per-entity state), but WHICH entity is hovered/pressed is,
# so it lives here as a component render/style systems can read directly instead of
# threading a single hovered/pressed EntityId through every call.
type Interaction {
  hovered: Bool
  pressed: Bool
}

# How far a node's hover paint (a hover `Shadow`) has faded in: 0 at rest, 1
# fully hovered. Runtime state the ButtonSystem seeds and eases
# (buttonHoverFadeUpdate) so a glow fades in and out instead of switching on the
# frame the pointer arrives; never authored.
type HoverFade {
  amount: Float
}

type ButtonSystem {
  interactions: ComponentTable(Interaction)
  hoverFades: ComponentTable(HoverFade)
}

# A touch stick's state (touchStickSystem): shown, its base in design units
# (middle, radius, the zone a press must start in), the finger it owns (-1
# none), its value -1..1 (x right, y forward = up the screen) and the knob's
# offset from the middle
type TouchStickState {
  shown: Bool
  centerX: Float
  centerY: Float
  radius: Float
  zoneRadius: Float
  active: Bool
  grabbedId: Int
  valueX: Float
  valueY: Float
  knobDX: Float
  knobDY: Float
}

func createTouchStickState() ret TouchStickState {
  ret TouchStickState {
    shown: false
    centerX: 0.0
    centerY: 0.0
    radius: 0.0
    zoneRadius: 0.0
    active: false
    grabbedId: -1
    valueX: 0.0
    valueY: 0.0
    knobDX: 0.0
    knobDY: 0.0
  }
}

# touchStickSystem's output: each TouchStick node's state
type TouchStickSystem {
  states: ComponentTable(TouchStickState)
}

type UiSystems {
  layout: LayoutSystem
  safeArea: SafeAreaSystem
  touchStick: TouchStickSystem
  hierarchy: HierarchySystem
  transform2d: Transform2dSystem
  animation: AnimationSystem
  button: ButtonSystem
  textField: TextFieldSystem
}

func createUiSystems() ret UiSystems {
  ret UiSystems {
    layout: LayoutSystem {
      measuredSizes: ComponentTable.create(MeasuredSize)
      measuredTexts: ComponentTable.create(MeasuredText)
      computedRects: ComponentTable.create(ComputedRect)
      layoutScales: ComponentTable.create(LayoutScale)
    }
    safeArea: SafeAreaSystem { safeInsets: ComponentTable.create(SafeInsets) }
    touchStick: TouchStickSystem { states: ComponentTable.create(TouchStickState) }
    hierarchy: HierarchySystem { parents: ComponentTable.create(Parent) }
    transform2d: Transform2dSystem {
      localTransforms: ComponentTable.create(Transform2D)
      worldTransforms: ComponentTable.create(WorldTransform2D)
      worldVisuals: ComponentTable.create(WorldVisual)
      runtimeOffsets: ComponentTable.create(RuntimeOffset)
    }
    animation: AnimationSystem {
      animStates: ComponentTable.create(AnimState)
      smokeStates: ComponentTable.create(SmokeState)
      carouselStates: ComponentTable.create(CarouselState)
      tracks: ComponentTable.create(AnimationTrack)
      poses: ComponentTable.create(AnimationPose)
      commands: createQueue(AnimationCommand)
      layoutPlaces: ComponentTable.create(LayoutPlace)
      textSeens: ComponentTable.create(TextSeen)
      textGhosts: ComponentTable.create(TextGhost)
      listMotions: ComponentTable.create(ListMotionState)
      sharedNodes: ComponentTable.create(SharedNode)
      sharedSeens: ComponentTable.create(SharedSeen)
      settings: animationSettingsFromEnv()
    }
    button: ButtonSystem {
      interactions: ComponentTable.create(Interaction)
      hoverFades: ComponentTable.create(HoverFade)
    }
    textField: TextFieldSystem {
      caretLineEntityId: noEntity()
      caretVisible: false
      caretEpoch: 0.0
      textInputOn: false
      keyboardHeight: 0.0
      clipboardScripted: false
      clipboardText: ""
    }
  }
}

# Drop every row of `entityId` from the systems' tables — the world's
# destroyEntity does the same for its own; the two together are "gone".
func clearUiSystemsEntity(uiSystems: mod UiSystems, entityId: view EntityId) {
  componentRemove(this: uiSystems.layout.measuredSizes, entityId: entityId)
  componentRemove(this: uiSystems.layout.measuredTexts, entityId: entityId)
  componentRemove(this: uiSystems.layout.computedRects, entityId: entityId)
  componentRemove(this: uiSystems.layout.layoutScales, entityId: entityId)
  componentRemove(this: uiSystems.safeArea.safeInsets, entityId: entityId)
  componentRemove(this: uiSystems.hierarchy.parents, entityId: entityId)
  componentRemove(this: uiSystems.transform2d.localTransforms, entityId: entityId)
  componentRemove(this: uiSystems.transform2d.worldTransforms, entityId: entityId)
  componentRemove(this: uiSystems.transform2d.worldVisuals, entityId: entityId)
  componentRemove(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId)
  componentRemove(this: uiSystems.animation.animStates, entityId: entityId)
  componentRemove(this: uiSystems.animation.smokeStates, entityId: entityId)
  componentRemove(this: uiSystems.animation.carouselStates, entityId: entityId)
  componentRemove(this: uiSystems.animation.tracks, entityId: entityId)
  componentRemove(this: uiSystems.animation.poses, entityId: entityId)
  componentRemove(this: uiSystems.animation.layoutPlaces, entityId: entityId)
  componentRemove(this: uiSystems.animation.textSeens, entityId: entityId)
  componentRemove(this: uiSystems.animation.textGhosts, entityId: entityId)
  componentRemove(this: uiSystems.animation.listMotions, entityId: entityId)
  componentRemove(this: uiSystems.animation.sharedNodes, entityId: entityId)
  componentRemove(this: uiSystems.animation.sharedSeens, entityId: entityId)
  componentRemove(this: uiSystems.button.interactions, entityId: entityId)
  componentRemove(this: uiSystems.button.hoverFades, entityId: entityId)
}
