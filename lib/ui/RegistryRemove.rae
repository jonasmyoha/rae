# removeComponentByName — the removal half of the dynamic component
# registry (sibling of registry.rae's applyComponentByName; separate
# file only because registry.rae sits at the 1000-line cap).
#
# Dispatches a component NAME onto componentRemove for the matching
# ComponentTable. Used by the frame-overlay system (ui/frames):
# reset-to-base must strip components an earlier frame overlay added
# that the node's base bag doesn't carry, and a frame's "remove"
# directive strips base components for that frame. componentRemove is
# a no-op when the entity doesn't carry the component, so callers
# never need a componentHas guard.
#
# Keep the name list in sync with applyComponentByName — a name that
# can be applied dynamically must be removable dynamically too.
# Unknown names are silently ignored (same policy as apply).
open ecs/ComponentTable

func removeComponentByName(world: mod UiWorld, entityId: view EntityId, name: view String) {
  if name is "Rect" {
    componentRemove(this: world.rects, entityId: entityId)
    ret
  }
  if name is "Size" {
    componentRemove(this: world.sizes, entityId: entityId)
    ret
  }
  if name is "Layout" {
    componentRemove(this: world.layouts, entityId: entityId)
    ret
  }
  if name is "Padding" {
    componentRemove(this: world.paddings, entityId: entityId)
    ret
  }
  if name is "Margin" {
    componentRemove(this: world.margins, entityId: entityId)
    ret
  }
  if name is "Align" {
    componentRemove(this: world.aligns, entityId: entityId)
    ret
  }
  if name is "Offset" {
    componentRemove(this: world.offsets, entityId: entityId)
    ret
  }
  if name is "Sprite" {
    componentRemove(this: world.sprites, entityId: entityId)
    ret
  }
  if name is "Text" {
    componentRemove(this: world.texts, entityId: entityId)
    ret
  }
  if name is "Shape" {
    componentRemove(this: world.shapes, entityId: entityId)
    ret
  }
  if name is "Active" {
    componentRemove(this: world.actives, entityId: entityId)
    ret
  }
  if name is "Opacity" {
    componentRemove(this: world.opacities, entityId: entityId)
    ret
  }
  if name is "OnClick" {
    componentRemove(this: world.onClicks, entityId: entityId)
    ret
  }
  if name is "Button" {
    componentRemove(this: world.buttons, entityId: entityId)
    ret
  }
  if name is "Name" {
    componentRemove(this: world.names, entityId: entityId)
    ret
  }
  if name is "PrimaryType" {
    componentRemove(this: world.primaryTypes, entityId: entityId)
    ret
  }
  if name is "NodeId" {
    componentRemove(this: world.nodeIdComponents, entityId: entityId)
    ret
  }
  if name is "SceneInstance" {
    componentRemove(this: world.sceneInstances, entityId: entityId)
    ret
  }
  if name is "TextBinding" {
    componentRemove(this: world.textBindings, entityId: entityId)
    ret
  }
  if name is "MaskShape" {
    componentRemove(this: world.maskShapes, entityId: entityId)
    ret
  }
  if name is "HeroWidget" {
    componentRemove(this: world.heroWidgets, entityId: entityId)
    ret
  }
  if name is "CornerRadius" {
    componentRemove(this: world.cornerRadiuses, entityId: entityId)
    ret
  }
  if name is "GradientFill" {
    componentRemove(this: world.gradientFills, entityId: entityId)
    ret
  }
  if name is "BackdropImage" {
    componentRemove(this: world.backdropImages, entityId: entityId)
    ret
  }
  if name is "OpticalAlign" {
    componentRemove(this: world.opticalAligns, entityId: entityId)
    ret
  }
  if name is "SafeArea" {
    componentRemove(this: world.safeAreas, entityId: entityId)
    ret
  }
  if name is "LayerRoot" {
    componentRemove(this: world.layerRoots, entityId: entityId)
    ret
  }
  if name is "DebugAnchor" {
    componentRemove(this: world.debugAnchors, entityId: entityId)
    ret
  }
  if name is "PageRoot" {
    componentRemove(this: world.pageRoots, entityId: entityId)
    ret
  }
  if name is "ScrollRoot" {
    componentRemove(this: world.scrollRoots, entityId: entityId)
    ret
  }
  if name is "WheelTarget" {
    componentRemove(this: world.wheelTargets, entityId: entityId)
    ret
  }
  if name is "ScrollState" {
    componentRemove(this: world.scrollStates, entityId: entityId)
    ret
  }
  if name is "WidgetId" {
    componentRemove(this: world.widgetIds, entityId: entityId)
    ret
  }
  if name is "WidgetState" {
    componentRemove(this: world.widgetStates, entityId: entityId)
    ret
  }
  if name is "DataDependency" {
    componentRemove(this: world.dataDependencies, entityId: entityId)
    ret
  }
  if name is "ActionBinding" {
    componentRemove(this: world.actionBindings, entityId: entityId)
    ret
  }
  if name is "RefreshRegion" {
    componentRemove(this: world.refreshRegions, entityId: entityId)
    ret
  }
  if name is "Aspect" {
    componentRemove(this: world.aspects, entityId: entityId)
    ret
  }
  if name is "ScaleToFit" {
    componentRemove(this: world.scaleToFits, entityId: entityId)
    ret
  }
}
