# PaintOnTop — a runtime marker: the renderer paints this entity, with its
# subtree, after its siblings, over them (ui/animationSystem hoverPaintRank).
# A row lifted out of a list (ui/listReorderSystem) carries it. Never
# authored or serialized.
type PaintOnTop {
  value: Bool = true
  # The system that set it also gave the entity a Shadow it had none of (a
  # lifted row's): that shadow goes when the marker goes
  addedShadow: Bool = false
}
