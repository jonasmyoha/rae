# ThemeParse — the theme JSON parsers (#918 split of ui/ThemeResolved for the
# 1000-line cap): parseTheme's sections (container / palette / float maps /
# padding / shadows / text), the `extends` chain resolution with its cycle
# guard, the small field readers and the resolved-theme dump used by the
# debug tooling. ui/ThemeResolved owns the ResolvedTheme type and the lookups.
import Json
import ui/Scene
open ui/ThemeResolved

# Load a ResolvedTheme from the theme sections of a parsed Scene's
# JsonDoc. A scene without theme sections yields an empty theme with
# ok=true (every section is optional). ok=false only when the scene
# itself failed to parse.
func parseTheme(scene: view Scene) pub ret ResolvedTheme {
  var out: ResolvedTheme = createResolvedTheme()
  parseThemeInto(out: out, scene: scene)
  ret out
}

# Append `scene`'s token sections onto an existing table (#1008): every lookup
# is first-match, so parsing scenes in resolution order — the page, then each
# `import` depth-first — makes the nearest declaration of a token win. A
# `text` style's `extends` chain resolves within its own file only.
func parseThemeInto(out: mod ResolvedTheme, scene: view Scene) {
  # Gate on the JSON parsing, NOT full-scene validation: a dedicated
  # Theme.raescene has no `nodes`/`root`, so parseScene leaves
  # scene.ok=false while still populating scene.doc. The theme sections
  # are all optional; a doc that parsed is enough.
  let doc: view JsonDoc => scene.doc
  if doc.ok is false {
    ret
  }
  let root: JsonValue = Json.root(doc: doc)

  parseThemePalette(out: out, doc: doc, root: root)
  parseThemeFloatMap(
    out: out
    doc: doc
    root: root
    section: "space"
    target: 0
  )
  parseThemeFloatMap(
    out: out
    doc: doc
    root: root
    section: "radius"
    target: 1
  )
  parseThemePadding(out: out, doc: doc, root: root)
  parseThemeShadows(out: out, doc: doc, root: root)
  parseThemeText(out: out, doc: doc, root: root)
  parseThemeContainer(out: out, doc: doc, root: root)

  out.ok = true
}

# Parse the optional `container` section (#237, M6). Each entry:
#   "primaryButton": { "background": "accent", "radius": "radiusPill",
#                      "padding": "cardPadding", "text": "buttonLabel" }
# All four fields are token/style/slot NAMES resolved later (at scene
# deserialise for bg/radius/padding, at paint for text) — never baked.
# Missing fields default to "" (that facet is left to the node).
func parseThemeContainer(out: mod ResolvedTheme, doc: view JsonDoc, root: view JsonValue) {
  let idx: Int = Json.field(doc: doc, this: root, key: "container")
  if idx < 0 {
    ret
  }
  let sec: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  if sec.kind is not JsonKind.object {
    ret
  }
  let n: Int = Json.objectLen(this: sec)
  var i: Int = 0
  loop i < n {
    let name: String = Json.objectKeyAt(doc: doc, this: sec, idx: i)
    let val: JsonValue = Json.objectValueAt(doc: doc, this: sec, idx: i)
    let bg: String = themeReadStringField(
      doc: doc
      obj: val
      key: "background"
      fallback: ""
    )
    let rad: String = themeReadStringField(
      doc: doc
      obj: val
      key: "radius"
      fallback: ""
    )
    let pad: String = themeReadStringField(
      doc: doc
      obj: val
      key: "padding"
      fallback: ""
    )
    let txt: String = themeReadStringField(
      doc: doc
      obj: val
      key: "text"
      fallback: ""
    )
    out.containerNames.add(value: name)
    out.containerBgSlots.add(value: bg)
    out.containerRadiusTokens.add(value: rad)
    out.containerPadTokens.add(value: pad)
    out.containerTextStyles.add(value: txt)
    i = i + 1
  }
}

func parseThemePalette(out: mod ResolvedTheme, doc: view JsonDoc, root: view JsonValue) {
  let idx: Int = Json.field(doc: doc, this: root, key: "palette")
  if idx < 0 {
    ret
  }
  let sec: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  if sec.kind is not JsonKind.object {
    ret
  }
  let n: Int = Json.objectLen(this: sec)
  var i: Int = 0
  loop i < n {
    let slot: String = Json.objectKeyAt(doc: doc, this: sec, idx: i)
    let val: JsonValue = Json.objectValueAt(doc: doc, this: sec, idx: i)
    let r: Int = themeReadIntField(
      doc: doc
      obj: val
      key: "r"
      fallback: 0
    )
    let g: Int = themeReadIntField(
      doc: doc
      obj: val
      key: "g"
      fallback: 0
    )
    let b: Int = themeReadIntField(
      doc: doc
      obj: val
      key: "b"
      fallback: 0
    )
    let a: Int = themeReadIntField(
      doc: doc
      obj: val
      key: "a"
      fallback: 255
    )
    out.palNames.add(value: slot)
    out.palR.add(value: r)
    out.palG.add(value: g)
    out.palB.add(value: b)
    out.palA.add(value: a)
    i = i + 1
  }
}

# `target`: 0 = space, 1 = radius. Both are name -> Float du maps.
func parseThemeFloatMap(
  out: mod ResolvedTheme
  doc: view JsonDoc
  root: view JsonValue
  section: view String
  target: view Int
) {
  let idx: Int = Json.field(doc: doc, this: root, key: section)
  if idx < 0 {
    ret
  }
  let sec: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  if sec.kind is not JsonKind.object {
    ret
  }
  let n: Int = Json.objectLen(this: sec)
  var i: Int = 0
  loop i < n {
    let name: String = Json.objectKeyAt(doc: doc, this: sec, idx: i)
    let val: JsonValue = Json.objectValueAt(doc: doc, this: sec, idx: i)
    let v: Float = Json.jsonFloat(this: val, fallback: 0.0)
    if target is 0 {
      out.spaceNames.add(value: name)
      out.spaceVals.add(value: v)
    } else {
      out.radiusNames.add(value: name)
      out.radiusVals.add(value: v)
    }
    i = i + 1
  }
}

func parseThemePadding(out: mod ResolvedTheme, doc: view JsonDoc, root: view JsonValue) {
  let idx: Int = Json.field(doc: doc, this: root, key: "padding")
  if idx < 0 {
    ret
  }
  let sec: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  if sec.kind is not JsonKind.object {
    ret
  }
  let n: Int = Json.objectLen(this: sec)
  var i: Int = 0
  loop i < n {
    let name: String = Json.objectKeyAt(doc: doc, this: sec, idx: i)
    let val: JsonValue = Json.objectValueAt(doc: doc, this: sec, idx: i)
    out.padNames.add(value: name)
    out.padL.add(value: themeReadFloatField(
      doc: doc
      obj: val
      key: "l"
      fallback: 0.0
    ))
    out.padT.add(value: themeReadFloatField(
      doc: doc
      obj: val
      key: "t"
      fallback: 0.0
    ))
    out.padR.add(value: themeReadFloatField(
      doc: doc
      obj: val
      key: "r"
      fallback: 0.0
    ))
    out.padB.add(value: themeReadFloatField(
      doc: doc
      obj: val
      key: "b"
      fallback: 0.0
    ))
    i = i + 1
  }
}

func parseThemeShadows(out: mod ResolvedTheme, doc: view JsonDoc, root: view JsonValue) {
  let idx: Int = Json.field(doc: doc, this: root, key: "shadow")
  if idx < 0 {
    ret
  }
  let sec: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  if sec.kind is not JsonKind.object {
    ret
  }
  let n: Int = Json.objectLen(this: sec)
  var i: Int = 0
  loop i < n {
    let name: String = Json.objectKeyAt(doc: doc, this: sec, idx: i)
    # Resolve the extends chain, root-first, for this shadow token.
    let chain: List(Int) = themeResolveChain(
      doc: doc
      section: sec
      name: name
      kind: "shadow"
    )
    var r: Int = 0
    var g: Int = 0
    var b: Int = 0
    var a: Int = 255
    var offX: Float = 0.0
    var offY: Float = 0.0
    var soft: Float = 1.0
    var c: Int = 0
    loop c < chain.length {
      if let bagIdx: Int = chain.copyAt(index: c) {
        let bag: JsonValue = Json.jsonValueAt(doc: doc, idx: bagIdx)
        let colIdx: Int = Json.field(doc: doc, this: bag, key: "color")
        if colIdx >= 0 {
          let col: JsonValue = Json.jsonValueAt(doc: doc, idx: colIdx)
          if col.kind is JsonKind.object {
            r = themeReadIntField(
              doc: doc
              obj: col
              key: "r"
              fallback: r
            )
            g = themeReadIntField(
              doc: doc
              obj: col
              key: "g"
              fallback: g
            )
            b = themeReadIntField(
              doc: doc
              obj: col
              key: "b"
              fallback: b
            )
            a = themeReadIntField(
              doc: doc
              obj: col
              key: "a"
              fallback: a
            )
          }
        }
        offX = themeReadFloatField(
          doc: doc
          obj: bag
          key: "offsetX"
          fallback: offX
        )
        offY = themeReadFloatField(
          doc: doc
          obj: bag
          key: "offsetY"
          fallback: offY
        )
        soft = themeReadFloatField(
          doc: doc
          obj: bag
          key: "softness"
          fallback: soft
        )
      }
      c = c + 1
    }
    out.shadowNames.add(value: name)
    out.shadowR.add(value: r)
    out.shadowG.add(value: g)
    out.shadowB.add(value: b)
    out.shadowA.add(value: a)
    out.shadowOffX.add(value: offX)
    out.shadowOffY.add(value: offY)
    out.shadowSoft.add(value: soft)
    i = i + 1
  }
}

func parseThemeText(out: mod ResolvedTheme, doc: view JsonDoc, root: view JsonValue) {
  let idx: Int = Json.field(doc: doc, this: root, key: "text")
  if idx < 0 {
    ret
  }
  let sec: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  if sec.kind is not JsonKind.object {
    ret
  }
  let n: Int = Json.objectLen(this: sec)
  var i: Int = 0
  loop i < n {
    let name: String = Json.objectKeyAt(doc: doc, this: sec, idx: i)
    let chain: List(Int) = themeResolveChain(
      doc: doc
      section: sec
      name: name
      kind: "text"
    )
    # Accumulator defaults (§3 "every field has a default").
    var font: String = "body"
    var size: Float = 43.373494
    var weight: Float = 400.0
    var lineHeight: Float = 1.0
    var tracking: Float = 0.0
    var colorSlot: String = "textPrimary"
    var colR: Int = 0
    var colG: Int = 0
    var colB: Int = 0
    var colA: Int = 255
    var shadowName: String = ""
    var align: Int = themeAlignStart
    var c: Int = 0
    loop c < chain.length {
      if let bagIdx: Int = chain.copyAt(index: c) {
        let bag: JsonValue = Json.jsonValueAt(doc: doc, idx: bagIdx)
        # Strings
        let fontIdx: Int = Json.field(doc: doc, this: bag, key: "font")
        if fontIdx >= 0 {
          let fv: JsonValue = Json.jsonValueAt(doc: doc, idx: fontIdx)
          let empty: String = ""
          font = Json.jsonString(this: fv, fallback: empty)
        }
        size = themeReadFloatField(
          doc: doc
          obj: bag
          key: "size"
          fallback: size
        )
        weight = themeReadFloatField(
          doc: doc
          obj: bag
          key: "weight"
          fallback: weight
        )
        lineHeight = themeReadFloatField(
          doc: doc
          obj: bag
          key: "lineHeight"
          fallback: lineHeight
        )
        tracking = themeReadFloatField(
          doc: doc
          obj: bag
          key: "tracking"
          fallback: tracking
        )
        # color: string slot OR inline object.
        let colIdx: Int = Json.field(doc: doc, this: bag, key: "color")
        if colIdx >= 0 {
          let col: JsonValue = Json.jsonValueAt(doc: doc, idx: colIdx)
          if col.kind is JsonKind.string {
            let empty2: String = ""
            colorSlot = Json.jsonString(this: col, fallback: empty2)
          } else {
            if col.kind is JsonKind.object {
              colorSlot = ""
              colR = themeReadIntField(
                doc: doc
                obj: col
                key: "r"
                fallback: colR
              )
              colG = themeReadIntField(
                doc: doc
                obj: col
                key: "g"
                fallback: colG
              )
              colB = themeReadIntField(
                doc: doc
                obj: col
                key: "b"
                fallback: colB
              )
              colA = themeReadIntField(
                doc: doc
                obj: col
                key: "a"
                fallback: colA
              )
            }
          }
        }
        # shadow token name (string).
        let shIdx: Int = Json.field(doc: doc, this: bag, key: "shadow")
        if shIdx >= 0 {
          let sh: JsonValue = Json.jsonValueAt(doc: doc, idx: shIdx)
          let empty3: String = ""
          shadowName = Json.jsonString(this: sh, fallback: empty3)
        }
        # align keyword.
        let alIdx: Int = Json.field(doc: doc, this: bag, key: "align")
        if alIdx >= 0 {
          let al: JsonValue = Json.jsonValueAt(doc: doc, idx: alIdx)
          let empty4: String = ""
          let alStr: String = Json.jsonString(this: al, fallback: empty4)
          align = themeParseAlign(text: alStr, fallback: align)
        }
      }
      c = c + 1
    }
    out.textNames.add(value: name)
    out.textFonts.add(value: font)
    out.textSizes.add(value: size)
    out.textWeights.add(value: weight)
    out.textLineHeights.add(value: lineHeight)
    out.textTrackings.add(value: tracking)
    out.textColorSlots.add(value: colorSlot)
    out.textColorR.add(value: colR)
    out.textColorG.add(value: colG)
    out.textColorB.add(value: colB)
    out.textColorA.add(value: colA)
    out.textShadowNames.add(value: shadowName)
    out.textAligns.add(value: align)
    i = i + 1
  }
}

# Resolve `name`'s single-parent `extends` chain within `section`,
# returning the pool value-indices ROOT-FIRST so a caller applying
# them in order gets child-wins semantics. Depth capped at
# themeMaxExtendsDepth; unknown parent / cycle logs and truncates.
# `kind` is only used for the diagnostic text.
func themeResolveChain(
  doc: view JsonDoc
  section: view JsonValue
  name: view String
  kind: view String
) ret List(Int) {
  # child-first while walking up, reversed at the end.
  let up: List(Int) = List.create(Int, cap: 4)
  let seen: List(String) = List.create(String, cap: 4)
  var curName: String = "{name}"
  var steps: Int = 0
  var walking: Bool = true
  loop walking {
    let idx: Int = Json.field(doc: doc, this: section, key: curName)
    if idx < 0 {
      # Only an error if we got here by following an extends link;
      # the top-level name should always exist.
      if steps > 0 {
        log("[theme] {kind} style '{name}' extends unknown '{curName}' — chain truncated")
      }
      walking = false
    } else {
      up.add(value: idx)
      # Fresh copy — curName is a `var` we reassign below; adding it
      # directly would let the list alias a heap we then drop.
      let seenCopy: String = "{curName}"
      seen.add(value: seenCopy)
      let bag: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
      let extIdx: Int = Json.field(doc: doc, this: bag, key: "extends")
      var parentName: String = ""
      if extIdx >= 0 {
        let extVal: JsonValue = Json.jsonValueAt(doc: doc, idx: extIdx)
        let empty: String = ""
        parentName = Json.jsonString(this: extVal, fallback: empty)
      }
      if parentName.length() is 0 {
        walking = false
      } else if themeSeenName(seen: seen, name: parentName) {
        log("[theme] {kind} style '{name}' extends chain has a cycle at '{parentName}' — truncated")
        walking = false
      } else if steps + 1 > themeMaxExtendsDepth {
        log("[theme] {kind} style '{name}' extends deeper than {themeMaxExtendsDepth} — truncated")
        walking = false
      } else {
        steps = steps + 1
        curName = "{parentName}"
      }
    }
  }
  ret themeReverseIntList(src: up)
}

func themeSeenName(seen: view List(String), name: view String) ret Bool {
  var i: Int = 0
  loop i < seen.length {
    if let entry: String = seen.copyAt(index: i) {
      if entry is name {
        ret true
      }
    }
    i = i + 1
  }
  ret false
}

func themeReverseIntList(src: view List(Int)) ret List(Int) {
  let out: List(Int) = List.create(Int, cap: src.length)
  var i: Int = src.length - 1
  loop i >= 0 {
    if let value: Int = src.copyAt(index: i) {
      out.add(value: value)
    }
    i = i - 1
  }
  ret out
}

func themeParseAlign(text: view String, fallback: view Int) ret Int {
  if text is "start" {
    ret themeAlignStart
  }
  if text is "center" {
    ret themeAlignCenter
  }
  if text is "end" {
    ret themeAlignEnd
  }
  ret fallback
}

# Read an Int field from a JSON object, or fallback if absent.
func themeReadIntField(
  doc: view JsonDoc
  obj: view JsonValue
  key: view String
  fallback: view Int
) ret Int {
  let idx: Int = Json.field(doc: doc, this: obj, key: key)
  if idx < 0 {
    ret fallback
  }
  let v: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  ret Json.jsonInt(this: v, fallback: fallback)
}

func themeReadFloatField(
  doc: view JsonDoc
  obj: view JsonValue
  key: view String
  fallback: view Float
) ret Float {
  let idx: Int = Json.field(doc: doc, this: obj, key: key)
  if idx < 0 {
    ret fallback
  }
  let v: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  ret Json.jsonFloat(this: v, fallback: fallback)
}

func themeReadStringField(
  doc: view JsonDoc
  obj: view JsonValue
  key: view String
  fallback: view String
) ret String {
  let idx: Int = Json.field(doc: doc, this: obj, key: key)
  if idx < 0 {
    ret "{fallback}"
  }
  let v: JsonValue = Json.jsonValueAt(doc: doc, idx: idx)
  ret Json.jsonString(this: v, fallback: fallback)
}

# -----------------------------------------------------------------
# Debug dump — prints the fully-flattened theme, so "what IS
# miniMuted, actually?" is one call away (§4 mitigation).
# -----------------------------------------------------------------
func themeDumpResolved(theme: view ResolvedTheme) pub {
  unsafe {
    log(
      "[theme] resolved: {theme.palNames.length} palette / {theme.spaceNames.length} space / {theme.radiusNames.length} radius / {theme.padNames.length} padding / {theme.shadowNames.length} shadow / {theme.textNames.length} text"
    )
    var i: Int = 0
    loop i < theme.palNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.palNames.data, index: i)
      var r: Int = 0
      var g: Int = 0
      var b: Int = 0
      var a: Int = 0
      if let palRVal: Int = theme.palR.copyAt(index: i) {
        r = palRVal
      }
      if let palGVal: Int = theme.palG.copyAt(index: i) {
        g = palGVal
      }
      if let palBVal: Int = theme.palB.copyAt(index: i) {
        b = palBVal
      }
      if let palAVal: Int = theme.palA.copyAt(index: i) {
        a = palAVal
      }
      log("[theme]   palette {n} = {r},{g},{b},{a}")
      i = i + 1
    }
    i = 0
    loop i < theme.spaceNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.spaceNames.data, index: i)
      var v: Float = 0.0
      if let spaceVal: Float = theme.spaceVals.copyAt(index: i) {
        v = spaceVal
      }
      log("[theme]   space {n} = {v}")
      i = i + 1
    }
    i = 0
    loop i < theme.radiusNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.radiusNames.data, index: i)
      var v: Float = 0.0
      if let radiusVal: Float = theme.radiusVals.copyAt(index: i) {
        v = radiusVal
      }
      log("[theme]   radius {n} = {v}")
      i = i + 1
    }
    i = 0
    loop i < theme.padNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.padNames.data, index: i)
      var l: Float = 0.0
      var t: Float = 0.0
      var r: Float = 0.0
      var b: Float = 0.0
      if let padLVal: Float = theme.padL.copyAt(index: i) {
        l = padLVal
      }
      if let padTVal: Float = theme.padT.copyAt(index: i) {
        t = padTVal
      }
      if let padRVal: Float = theme.padR.copyAt(index: i) {
        r = padRVal
      }
      if let padBVal: Float = theme.padB.copyAt(index: i) {
        b = padBVal
      }
      log("[theme]   padding {n} = {l},{t},{r},{b}")
      i = i + 1
    }
    i = 0
    loop i < theme.shadowNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.shadowNames.data, index: i)
      var r: Int = 0
      var g: Int = 0
      var b: Int = 0
      var a: Int = 0
      var ox: Float = 0.0
      var oy: Float = 0.0
      var sf: Float = 0.0
      if let shadowRVal: Int = theme.shadowR.copyAt(index: i) {
        r = shadowRVal
      }
      if let shadowGVal: Int = theme.shadowG.copyAt(index: i) {
        g = shadowGVal
      }
      if let shadowBVal: Int = theme.shadowB.copyAt(index: i) {
        b = shadowBVal
      }
      if let shadowAVal: Int = theme.shadowA.copyAt(index: i) {
        a = shadowAVal
      }
      if let shadowOffXVal: Float = theme.shadowOffX.copyAt(index: i) {
        ox = shadowOffXVal
      }
      if let shadowOffYVal: Float = theme.shadowOffY.copyAt(index: i) {
        oy = shadowOffYVal
      }
      if let shadowSoftVal: Float = theme.shadowSoft.copyAt(index: i) {
        sf = shadowSoftVal
      }
      log("[theme]   shadow {n} = rgba {r},{g},{b},{a} off {ox},{oy} soft {sf}")
      i = i + 1
    }
    i = 0
    loop i < theme.textNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.textNames.data, index: i)
      let font: String = rae_ext_rae_buf_get(buf: theme.textFonts.data, index: i)
      let slot: String = rae_ext_rae_buf_get(buf: theme.textColorSlots.data, index: i)
      let sh: String = rae_ext_rae_buf_get(buf: theme.textShadowNames.data, index: i)
      var sz: Float = 0.0
      var al: Int = 0
      if let textSizeVal: Float = theme.textSizes.copyAt(index: i) {
        sz = textSizeVal
      }
      if let textAlignVal: Int = theme.textAligns.copyAt(index: i) {
        al = textAlignVal
      }
      if slot.length() > 0 {
        log("[theme]   text {n} = font {font} size {sz} color slot:{slot} shadow '{sh}' align {al}")
      } else {
        var cr: Int = 0
        var cg: Int = 0
        var cb: Int = 0
        var ca: Int = 0
        if let textColorRVal: Int = theme.textColorR.copyAt(index: i) {
          cr = textColorRVal
        }
        if let textColorGVal: Int = theme.textColorG.copyAt(index: i) {
          cg = textColorGVal
        }
        if let textColorBVal: Int = theme.textColorB.copyAt(index: i) {
          cb = textColorBVal
        }
        if let textColorAVal: Int = theme.textColorA.copyAt(index: i) {
          ca = textColorAVal
        }
        log(
          "[theme]   text {n} = font {font} size {sz} color inline:{cr},{cg},{cb},{ca} shadow '{sh}' align {al}"
        )
      }
      i = i + 1
    }
  }
}

# ================================================================
# Scene-deserialiser token lookups (#233, Theme M3 / #764).
#
# Radius/padding/container tokens live in the theme (Theme.raescene) and scene
# deserialisation needs them at parse time. These used to be a set of flattened
# module-global lists (`g_active*`) populated once at boot by setActiveThemeTokens
# — a redundant SECOND copy of the ResolvedTheme they were filled from. #764
# removes that copy: the deserialiser now resolves directly against the world's
# `theme.resolved` (a ResolvedTheme), threaded from the dispatcher that already
# holds the UiWorld. Space and radius tokens reuse themeSpaceValue/themeRadiusValue
# above; container + padding get the ResolvedTheme-parameterised lookups below.
# ================================================================
