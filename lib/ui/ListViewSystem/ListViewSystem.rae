# listViewSystem — virtualised rows for the `ListView` component (#945).
#
# A `ListView` entity carries a `ListView` (the layout/binding spec), a
# `ScrollState` (the scroll offset), and a sibling `ListViewData` (the rows). The
# system keeps only a WINDOW of live row entities as the ListView's children —
# the rows spanning the viewport plus `overscanRows` each side — and RECYCLES
# them on scroll: the pooled row entities persist across scroll ticks, and each
# tick only re-points a slot at its new data row (re-applying the bindings) and
# moves it, growing or shrinking the pool only when the window SIZE changes. So a
# 10k-row list costs O(window) live entities, not O(rows).
#
# A row is either a SUB-SCENE or a bindings-only skeleton (#964):
#   * `ListView.itemSceneId` names a scene in the host's `SceneRegistry`: each
#     pooled row root mounts that scene once (its root node IS the row root),
#     under a per-row nodeId page (`listRow<index>`) so the bindings can find
#     the authored nodes by id. Recycling re-binds, never re-mounts.
#   * Otherwise each distinct binding `nodeId` becomes one bare child of the
#     row, created in binding order so slot k == distinctNodeIds[k].
# A binding writes one component field of one row node from the row's
# `itemField` value (prefix + value + suffix). Scene rows accept every
# `SceneOverride` target — `Text.text` / `Text.styleId`, `Sprite.textureKey` /
# `Sprite.tint`, `OnClick.actionId`, `Active.value` (a "true"/"false" cell, the
# placeholder/media-state switch) — written in place and only when the value
# changed, so an unchanged row costs no table generation bump. Skeleton rows
# support `Text.text` and `OnClick.actionId`.
#
# Scrolling: `ScrollState.y` on the ListView entity is the source of truth. The
# system applies it as the entity's `RuntimeOffset` (a transform-time
# translation, so a scroll step never reruns layout) and positions the pooled
# rows at their content offset (`dataIndex * pitch`) via `Offset`.
#
# FLOW mode (#996, `ListView.mode: "Flow"`): every data row is a live child
# and the container's own authored `Layout` places them — a `Grid` with
# `columns` (a cover grid), a `Horizontal` strip (recently played), a
# `Vertical` stack (a track list). Rows are keyed (`itemKeyField`, else the
# index): a rebind reuses the row entity whose key AND sub-scene match and
# only re-applies its bindings, creates the rows that are new, destroys the
# ones that went, and rewrites the child order to the data order — so entity
# ids, hover state and hero captures survive a data change. The sub-scene
# per row comes from `rowScenes[row[rowKindField]]`, else `itemSceneId`, so
# one grid mixes tile kinds. Nothing scrolls here: a flow list lives inside
# the page's scroll root.
open ui/Ecs
import ui/Components
open ui/ClickTargets
open ui/SceneInstance
import ui/SceneLoader
open ecs/Entity
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open ui/RegistryGeneric
open ui/UiSystems
open ui/ListMotionSystem
open ui/ListWindow

# The nodeId page a pooled row's sub-scene is mounted under, so several rows
# of the same scene coexist in `world.nodeIds`.
func listViewRowPage(rowRoot: view EntityId) ret String {
  ret "listRow{rowRoot.index}"
}

# Does this ListView build its rows from a registered sub-scene?
func listViewUsesScene(lv: view ListView, scenes: view SceneRegistry) ret Bool {
  if lv.itemSceneId.length() is 0 {
    ret false
  }
  ret sceneRegistryHas(reg: scenes, key: lv.itemSceneId)
}

# The ordered, de-duplicated node ids the bindings target — one child node per
# id, created in this order so a pooled row's k-th child always maps to
# distinctNodeIds[k] on every recycle.
func listViewDistinctNodeIds(lv: view ListView) ret List(String) {
  unsafe {
    var out: List(String) = List.create(String, cap: 4)
    let n: Int = lv.bindings.length
    var i: Int = 0
    loop i < n {
      let b: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: i)
      var seen: Bool = false
      var j: Int = 0
      loop j < out.length {
        if let existing: view String = out.viewAt(index: j) {
          if existing is b.nodeId {
            seen = true
          }
        }
        j = j + 1
      }
      if seen is false {
        out.add(value: "{b.nodeId}")
      }
      i = i + 1
    }
    ret out
  }
}

# Index of `nodeId` within the distinct list (its child slot in a row), or none.
func listViewNodeSlot(distinct: view List(String), nodeId: view String) ret opt Int {
  var i: Int = 0
  loop i < distinct.length {
    if let existing: view String = distinct.viewAt(index: i) {
      if existing is nodeId {
        ret i
      }
    }
    i = i + 1
  }
  ret none
}

# Build one pooled row entity. Sub-scene rows mount the item scene onto the
# row root (once — recycling only re-binds); skeleton rows get one bare child
# per distinct binding nodeId, in distinct order so slot k == distinctNodeIds[k].
func listViewBuildRow(
  world: mod UiWorld
  uiSystems: mod UiSystems
  listEntityId: view EntityId
  lv: view ListView
  distinct: view List(String)
  scenes: view SceneRegistry
) ret EntityId {
  let rowRoot: EntityId = createEntity(world: world)
  # The row's placement is the list's: it FILLS the list's computed content
  # width (so a `Size: Fill` list, a resize or a panel toggle re-widths the
  # rows through layout, #71098456) and is one item high. (A sub-scene's
  # ROOT placement components are skipped on mount, as for any scene
  # instance — the host positions the instance.)
  var rowW: Float = 0.0
  if componentHas(this: world.rects, entityId: listEntityId) {
    rowW = componentView(this: world.rects, entityId: listEntityId).size.x
  }
  let r: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: rowW, y: lv.itemHeight } }
  componentSet(this: world.rects, entityId: rowRoot, data: r)
  let size: Size = {
    w: SizeAxis { mode: SizeMode.fill, min: -1, max: -1 }
    h: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
  }
  componentSet(this: world.sizes, entityId: rowRoot, data: size)
  if let idx: Int = sceneRegistryIndex(reg: scenes, key: lv.itemSceneId) {
    let scene: view Scene = sceneRegistryGet(reg: scenes, idx: idx)
    let overrides: List(SceneOverride) = emptyOverrides()
    mountSceneInstanceIntoPage(
      world: world
      uiSystems: uiSystems
      mountEntityId: rowRoot
      scene: scene
      overrides: overrides
      pageId: listViewRowPage(rowRoot: rowRoot)
    )
    # the row scene's own SceneInstance nodes (an avatar in a row), in the row's page, so the
    # bindings applied next find their nodes
    SceneLoader.resolveSceneInstancesUnder(
      world: world
      uiSystems: uiSystems
      registry: scenes
      rootEntityId: rowRoot
      pageId: listViewRowPage(rowRoot: rowRoot)
    )
    ret rowRoot
  }
  var k: Int = 0
  loop k < distinct.length {
    let child: EntityId = createEntity(world: world)
    setParent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: child
      parent: rowRoot
    )
    k = k + 1
  }
  ret rowRoot
}

# Re-point a pooled row at data row `row` (number `dataIndex`), positioned at content-Y `topY`.
# A row still bound to the same data row of the same list and data (ListRowBound) keeps its
# bindings as they are.
func listViewApplyRow(
  world: mod UiWorld
  uiSystems: mod UiSystems
  listEntityId: view EntityId
  rowRoot: view EntityId
  lv: view ListView
  distinct: view List(String)
  row: view ListViewRow
  dataIndex: view Int
  topY: view Float
  sceneRow: view Bool
) {
  unsafe {
    var moved: Bool = true
    if componentHas(this: world.offsets, entityId: rowRoot) {
      let cur: view Offset = componentView(this: world.offsets, entityId: rowRoot)
      moved = cur.delta.y is not topY
    }
    if moved {
      let off: Offset = { delta: Vec2 { x: 0.0, y: topY } }
      componentSet(this: world.offsets, entityId: rowRoot, data: off)
    }
    let bound: ListRowBound = {
      dataIndex: dataIndex
      dataGeneration: componentModStamp(this: world.listViewDatas, entityId: listEntityId)
      listGeneration: componentModStamp(this: world.listViews, entityId: listEntityId)
    }
    if componentHas(this: uiSystems.listRows.rowsBound, entityId: rowRoot) {
      let last: view ListRowBound = componentView(
        this: uiSystems.listRows.rowsBound
        entityId: rowRoot
      )
      if last.dataIndex is bound.dataIndex and last.dataGeneration is bound.dataGeneration and last.listGeneration is bound.listGeneration {
        ret
      }
    }
    if sceneRow {
      # a binding whose node this row's scene lacks (another kind of tile) has nothing to write;
      # the scene is mounted when the row is built, so that stays so
      let sn: Int = lv.bindings.length
      var sb: Int = 0
      loop sb < sn {
        let binding: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: sb)
        let unusedFound: Bool = listViewApplySceneBinding(
          world: world
          rowRoot: rowRoot
          binding: binding
          row: row
        )
        sb = sb + 1
      }
      componentSet(this: uiSystems.listRows.rowsBound, entityId: rowRoot, data: bound)
      ret
    }
    # Snapshot this row's child ids (distinct-order) so binding writes don't
    # alias the childrens table while it is being read.
    var kids: List(EntityId) = List.create(EntityId, cap: distinct.length)
    if componentHas(this: world.childrens, entityId: rowRoot) {
      let ch: view Children = componentView(this: world.childrens, entityId: rowRoot)
      var i: Int = 0
      loop i < ch.ids.length {
        kids.add(value: rae_ext_rae_buf_get(buf: ch.ids.data, index: i))
        i = i + 1
      }
    }
    let bn: Int = lv.bindings.length
    var b: Int = 0
    loop b < bn {
      let binding: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: b)
      if let slot: Int = listViewNodeSlot(distinct: distinct, nodeId: binding.nodeId) {
        if slot < kids.length {
          let child: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: slot)
          listViewApplyBinding(
            world: world
            child: child
            binding: binding
            row: row
          )
        }
      }
      b = b + 1
    }
    componentSet(this: uiSystems.listRows.rowsBound, entityId: rowRoot, data: bound)
  }
}

# The topmost row a virtual list of `count` rows keeps live (ui/ListWindow listFirstRow)
func listViewFirstRow(lv: view ListView, scrollY: view Float, count: view Int) ret Int {
  ret listFirstRow(lv: lv, scrollY: scrollY, count: count)
}

# One ListView entity: reconcile its pooled row window to the current scroll.
func listViewSyncEntity(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  scenes: view SceneRegistry
) {
  unsafe {
    # A real COPY: this pass destroys surplus rows and builds new ones, which
    # adds and removes rows across the world's tables and can move the ListView
    # table's storage, while the list's definition is used all the way through.
    # A view of the row would not survive that.
    var lv: ListView = ListView.default()
    if let listView: ListView = componentCopy(this: world.listViews, entityId: entityId) {
      lv = own listView
    }
    let sceneRow: Bool = listViewUsesScene(lv: lv, scenes: scenes)
    var scrollY: Float = 0.0
    if componentHas(this: world.scrollStates, entityId: entityId) {
      scrollY = componentView(this: world.scrollStates, entityId: entityId).y
    }
    # The scroll is a runtime translation of the whole list (transform-time,
    # never a relayout); the rows sit at their content offsets below.
    var scrolled: Bool = true
    if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId) {
      let cur: view RuntimeOffset = componentView(
        this: uiSystems.transform2d.runtimeOffsets
        entityId: entityId
      )
      scrolled = cur.delta.y is not scrollY
    }
    if scrolled {
      let ro: RuntimeOffset = { delta: Vec2 { x: 0.0, y: scrollY } }
      componentSet(this: uiSystems.transform2d.runtimeOffsets, entityId: entityId, data: ro)
    }
    var count: Int = listRowCount(world: world, list: entityId)
    let wanted: ListRange = listWindowWanted(
      world: world
      uiSystems: uiSystems
      list: entityId
      count: count
    )
    var first: Int = wanted.first
    var target: Int = wanted.count
    # a windowed list has the rows it was given
    let windowed: Bool = listIsWindowed(world: world, list: entityId)
    let dataFirst: Int = listDataFirst(world: world, list: entityId)
    if windowed {
      var held: Int = 0
      if componentHas(this: world.listViewDatas, entityId: entityId) {
        held = componentView(this: world.listViewDatas, entityId: entityId).rows.length
      }
      if first < dataFirst {
        target = target - (dataFirst - first)
        first = dataFirst
      }
      if first + target > dataFirst + held {
        target = dataFirst + held - first
      }
      if target < 0 {
        target = 0
      }
      if target is 0 {
        count = 0
      }
      # and no motion (a sideways change of all its data neither)
      componentRemove(this: world.listChanges, entityId: entityId)
    }

    let distinct: List(String) = listViewDistinctNodeIds(lv: lv)

    let plan: ListRowsPlan = listMotionBeforeRows(
      world: world
      uiSystems: uiSystems
      listEntityId: entityId
      listView: lv
      first: first
      target: target
    )

    # Snapshot the current pool (the ListView's row-root children), but its ghosts.
    var pool: List(EntityId) = List.create(EntityId, cap: target + 2)
    if componentHas(this: world.childrens, entityId: entityId) {
      let ch: view Children = componentView(this: world.childrens, entityId: entityId)
      var i: Int = 0
      loop i < ch.ids.length {
        let child: EntityId = rae_ext_rae_buf_get(buf: ch.ids.data, index: i)
        if componentHas(this: world.leavings, entityId: child) is false {
          pool.add(value: child)
        }
        i = i + 1
      }
    }

    # Shrink: destroy surplus rows from the tail.
    var poolCount: Int = pool.length
    loop poolCount > target {
      let victim: EntityId = rae_ext_rae_buf_get(buf: pool.data, index: poolCount - 1)
      destroyEntitySubtree(world: world, uiSystems: uiSystems, root: victim)
      poolCount = poolCount - 1
    }
    # Grow: build fresh rows and parent them under the ListView.
    loop poolCount < target {
      let rowRoot: EntityId = listViewBuildRow(
        world: world
        uiSystems: uiSystems
        listEntityId: entityId
        lv: lv
        distinct: distinct
        scenes: scenes
      )
      setParent(
        parents: uiSystems.hierarchy.parents
        childrens: world.childrens
        child: rowRoot
        parent: entityId
      )
      poolCount = poolCount + 1
    }

    listMotionPlaceRows(
      world: world
      listEntityId: entityId
      plan: plan
      target: target
    )

    # Re-snapshot the pool (post grow/shrink) in stable child order, then
    # re-point each slot at its data row.
    var rows2: List(EntityId) = List.create(EntityId, cap: target)
    if componentHas(this: world.childrens, entityId: entityId) {
      let ch: view Children = componentView(this: world.childrens, entityId: entityId)
      var i: Int = 0
      loop i < ch.ids.length {
        let child: EntityId = rae_ext_rae_buf_get(buf: ch.ids.data, index: i)
        if componentHas(this: world.leavings, entityId: child) is false {
          rows2.add(value: child)
        }
        i = i + 1
      }
    }
    if count is 0 {
      listMotionAfterRows(
        world: world
        uiSystems: uiSystems
        listEntityId: entityId
        listView: lv
        first: first
      )
      ret
    }
    let data: view ListViewData = componentView(this: world.listViewDatas, entityId: entityId)
    let pitch: Float = lv.itemHeight + lv.itemGap
    var s: Int = 0
    loop s < target and s < rows2.length {
      let dataIdx: Int = first + s
      let row: ListViewRow = rae_ext_rae_buf_get(buf: data.rows.data, index: dataIdx - dataFirst)
      let rowRoot: EntityId = rae_ext_rae_buf_get(buf: rows2.data, index: s)
      let topY: Float = dataIdx.toFloat() * pitch
      listViewApplyRow(
        world: world
        uiSystems: uiSystems
        listEntityId: entityId
        rowRoot: rowRoot
        lv: lv
        distinct: distinct
        row: row
        dataIndex: dataIdx
        topY: topY
        sceneRow: sceneRow
      )
      s = s + 1
    }
    listMotionAfterRows(
      world: world
      uiSystems: uiSystems
      listEntityId: entityId
      listView: lv
      first: first
    )
  }
}

# ----- flow mode (#996) ------------------------------------------------------

# The sub-scene id a row mounts: its kind's entry in `rowScenes`, else the
# list's `itemSceneId`.
func listViewRowSceneId(lv: view ListView, row: view ListViewRow) ret String {
  if lv.rowKindField.length() > 0 {
    let kind: String = listRowValue(row: row, key: lv.rowKindField)
    if kind.length() > 0 {
      loop let entry: view ListViewRowScene in lv.rowScenes {
        if entry.kind is kind {
          ret "{entry.sceneId}"
        }
      }
    }
  }
  ret "{lv.itemSceneId}"
}

# The identity of data row `index`: its `itemKeyField` cell, or the index when
# the list has no key column (or the cell is empty).
func listViewRowKeyOf(lv: view ListView, row: view ListViewRow, index: view Int) ret String {
  if lv.itemKeyField.length() > 0 {
    let key: String = listRowValue(row: row, key: lv.itemKeyField)
    if key.length() > 0 {
      ret key
    }
  }
  ret "{index}"
}

# What a list's last reconcile saw (ListSyncSeen): the same again means its rows already show its
# data at its scroll, so the pass (its definition copied, each row's key and value built and
# matched) is not run. Read after the pass, so a pass that moved rows runs once more and rests.
func listSyncSeenNow(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  scenes: view SceneRegistry
) ret ListSyncSeen {
  var scrollY: Float = 0.0
  if componentHas(this: world.scrollStates, entityId: entityId) {
    scrollY = componentView(this: world.scrollStates, entityId: entityId).y
  }
  var visible: Int = 0
  if componentView(this: world.listViews, entityId: entityId).mode is ListViewMode.virtual {
    visible = listVisibleRows(world: world, uiSystems: uiSystems, list: entityId)
  }
  ret ListSyncSeen {
    listGeneration: componentModStamp(this: world.listViews, entityId: entityId)
    dataGeneration: componentModStamp(this: world.listViewDatas, entityId: entityId)
    windowStamp: componentModStamp(this: world.listWindows, entityId: entityId)
    visible: visible
    childrenGeneration: componentTableGeneration(this: world.childrens)
    leaving: componentCount(this: world.leavings)
    motionGeneration: componentTableGeneration(this: world.listReorderDrags) + componentTableGeneration(
      this: uiSystems.animation.listMotions
    )
    rowSize: listViewFlowRowSize(
      world: world
      uiSystems: uiSystems
      listEntityId: entityId
      lv: componentView(this: world.listViews, entityId: entityId)
    )
    scrollY: scrollY
    scenes: scenes.ids.length
  }
}

func listSyncSeenSame(a: view ListSyncSeen, b: view ListSyncSeen) ret Bool {
  ret a.listGeneration is b.listGeneration and a.dataGeneration is b.dataGeneration and a.windowStamp is b.windowStamp and a.visible is b.visible and a.childrenGeneration is b.childrenGeneration and a.leaving is b.leaving and a.motionGeneration is b.motionGeneration and a.rowSize.x is b.rowSize.x and a.rowSize.y is b.rowSize.y and a.scrollY is b.scrollY and a.scenes is b.scenes
}

# One ListView reconciled (flow or windowed), unless nothing it reads changed since it last was
# and no list change is waiting
func listViewSyncChanged(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  scenes: view SceneRegistry
) {
  if not listViewNeedsSync(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    scenes: scenes
  ) {
    ret
  }
  # the empty, loading or error scene in the rows' place (ListViewPlaceholder), else the rows
  if listViewSyncPlaceholder(
    world: world
    uiSystems: uiSystems
    list: entityId
    scenes: scenes
  ) {
    # nothing more: the list shows no rows while it does
  } else if componentView(this: world.listViews, entityId: entityId).mode is ListViewMode.flow {
    listViewSyncFlow(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      scenes: scenes
    )
  } else {
    listViewSyncEntity(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      scenes: scenes
    )
  }
  let seen: ListSyncSeen = listSyncSeenNow(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    scenes: scenes
  )
  componentSet(this: uiSystems.listRows.listsSeen, entityId: entityId, data: seen)
}

# The list changed since its last reconcile, or has had none, or a list change waits
func listViewNeedsSync(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  scenes: view SceneRegistry
) ret Bool {
  if componentHas(this: world.listChanges, entityId: entityId) {
    ret true
  }
  if not componentHas(this: uiSystems.listRows.listsSeen, entityId: entityId) {
    ret true
  }
  let now: ListSyncSeen = listSyncSeenNow(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    scenes: scenes
  )
  ret not listSyncSeenSame(
    a: componentView(this: uiSystems.listRows.listsSeen, entityId: entityId)
    b: now
  )
}

# Virtualise every ListView in the world (#945). Run after input/scroll,
# before layout, so the current window's rows are laid out this frame.
# `scenes` supplies the item sub-scenes (`ListView.itemSceneId`); pass an empty
# registry for bindings-only rows.
func listViewSystem(world: mod UiWorld, uiSystems: mod UiSystems, scenes: view SceneRegistry) pub {
  unsafe {
    let n: Int = componentCount(this: world.listViews)
    # Nothing to do (the idle frame): no list changed, and nothing is collected
    var anyChanged: Bool = false
    loop var l: Int = 0, l < n and not anyChanged, ++l {
      anyChanged = listViewNeedsSync(
        world: world
        uiSystems: uiSystems
        entityId: componentEntityAt(this: world.listViews, i: l)
        scenes: scenes
      )
    }
    if not anyChanged {
      ret
    }
    # Collect entity ids first: syncing mutates childrens/entities, which must
    # not alias the listViews table iteration.
    var entities: List(EntityId) = List.create(EntityId, cap: n)
    var i: Int = 0
    loop i < n {
      entities.add(value: componentEntityAt(this: world.listViews, i: i))
      i = i + 1
    }
    var e: Int = 0
    loop e < entities.length {
      let entityId: EntityId = rae_ext_rae_buf_get(buf: entities.data, index: e)
      listViewSyncChanged(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        scenes: scenes
      )
      e = e + 1
    }
  }
}
