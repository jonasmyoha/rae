# RenderText — the legacy raylib text painter (#918 split of legacyRaylib/Render
# for the 1000-line cap): the resolved text style's size / colour / shadow /
# alignment lookups and paintText itself. legacyRaylib/Render's paintEntity
# calls paintText for every text node.
open Raylib
import ui/legacyRaylib/Msdf
import ui/legacyRaylib/Draw
import ui/IconCodepoints
import ui/Theme
import ui/Layer
import ui/AnimationSystem/AnimationSystem
open ecs/ComponentTable
open Gpu2dCanvas
open ui/legacyRaylib/Render

# Resolve a Text node's font size / colour from its style id. Phase 1e
# uses a small built-in stylesheet for the music player; once Phase
# 1f's `Style` component lands, this routes through that table instead.
func textStyleSize(styleId: view String) ret Float {
  let h1: String = "h1"
  let h2: String = "h2"
  let body: String = "body"
  let caption: String = "caption"
  let miniTitle: String = "miniTitle"
  let miniMuted: String = "miniMuted"
  let topBarTitle: String = "topBarTitle"
  let albumCaption: String = "albumCaption"
  let pillLabel: String = "pillLabel"
  let trackTitle: String = "trackTitle"
  let trackMuted: String = "trackMuted"
  if styleId is h1 {
    ret 78.0722891566265
  }
  if styleId is h2 {
    ret 60.722891566265055
  }
  if styleId is caption {
    ret 34.69879518072289
  }
  if styleId is miniTitle {
    ret 39.03614457831325
  }
  if styleId is miniMuted {
    ret 30.361445783132528
  }
  if styleId is topBarTitle {
    ret 39.03614457831325
  }
  let pageTitle: String = "pageTitle"
  if styleId is pageTitle {
    ret 60.722891566265055
  }
  if styleId is albumCaption {
    ret 30.361445783132528
  }
  if styleId is pillLabel {
    ret 39.03614457831325
  }
  if styleId is trackTitle {
    ret 43.373493975903614
  }
  if styleId is trackMuted {
    ret 30.361445783132528
  }
  let tabActive: String = "tabActive"
  if styleId is tabActive {
    ret 30.361445783132528
  }
  let tabInactive: String = "tabInactive"
  if styleId is tabInactive {
    ret 30.361445783132528
  }
  # Styles owned by lib/ui/debug.rae's reusable in-app debug UI. The
  # "D" letter sits inside a 22 px circle, so the glyph is sized to
  # leave a small breathing margin; the menu label sits at 16 pt to
  # match iOS's default setting-row text.
  let debugButton: String = "debugButton"
  if styleId is debugButton {
    ret 30.361445783132528
  }
  let debugMenuLabel: String = "debugMenuLabel"
  if styleId is debugMenuLabel {
    ret 34.69879518072289
  }
  # Right-aligned 16 pt label used by NowPlaying's TimeTotal node so
  # the duration text sits flush against the progress bar's right edge.
  if styleId is "timeTotal" {
    ret 34.69879518072289
  }
  # Game proto1 menu.* styleIds — authored in pixi's textStyles.ts for
  # the 1080-wide canvas. Hosts that scale-to-fit (Camera2D zoom = 0.5)
  # see these at half-size. Pixi sizes pulled from
  # game-proto1-pixi/src/ui/ruics/textStyles.ts.
  if styleId is "menu.playLabel" {
    ret 216.0
  }
  if styleId is "menu.title" {
    ret 72.0
  }
  if styleId is "menu.titleLevel" {
    ret 72.0
  }
  if styleId is "menu.shopPrice" {
    ret 72.0
  }
  if styleId is "menu.levelLabelLarge" {
    ret 68.0
  }
  if styleId is "menu.crownCountLabel" {
    ret 62.0
  }
  if styleId is "menu.dialogCloseIcon" {
    ret 58.0
  }
  if styleId is "menu.playerName" {
    ret 56.0
  }
  if styleId is "menu.playerNameLevelYellow" {
    ret 56.0
  }
  if styleId is "menu.musicIcon" {
    ret 52.0
  }
  if styleId is "menu.coinLabel" {
    ret 50.0
  }
  if styleId is "menu.chestEmpty" {
    ret 48.0
  }
  if styleId is "menu.settingsHint" {
    ret 48.0
  }
  if styleId is "menu.collectionCardDescription" {
    ret 48.0
  }
  if styleId is "menu.progressLabelLarge" {
    ret 46.0
  }
  if styleId is "menu.settingsAction" {
    ret 44.0
  }
  if styleId is "menu.chestTimer" {
    ret 42.0
  }
  if styleId is "menu.chestTapCta" {
    ret 42.0
  }
  if styleId is "menu.tabLabel" {
    ret 40.0
  }
  if styleId is "menu.chestTapCtaTop" {
    ret 38.0
  }
  if styleId is "menu.settingsCopyright" {
    ret 38.0
  }
  if styleId is "menu.oddsBody" {
    ret 34.0
  }
  ret 43.373493975903614
}

func textStyleColor(styleId: view String, chain255: view Int, active: view Theme) ret Color {
  # Style id → theme palette mapping (light/dark flips for free).
  let mute: String = "muted"
  let caption: String = "caption"
  let primary: String = "primary"
  let miniTitle: String = "miniTitle"
  let miniMuted: String = "miniMuted"
  let topBarTitle: String = "topBarTitle"
  let albumCaption: String = "albumCaption"
  let pillLabelLight: String = "pillLabel"
  let trackTitle: String = "trackTitle"
  let trackMuted: String = "trackMuted"
  let tabActive: String = "tabActive"
  let tabInactive: String = "tabInactive"

  if styleId is mute {
    ret toRaylibColor(color: colorByName(theme: active, name: "textMuted"), chain255: chain255)
  }
  if styleId is caption {
    ret toRaylibColor(color: colorByName(theme: active, name: "textMuted"), chain255: chain255)
  }
  if styleId is primary {
    ret toRaylibColor(color: colorByName(theme: active, name: "textPrimary"), chain255: chain255)
  }
  if styleId is topBarTitle {
    ret toRaylibColor(color: colorByName(theme: active, name: "textPrimary"), chain255: chain255)
  }
  let pageTitle: String = "pageTitle"
  if styleId is pageTitle {
    ret toRaylibColor(color: colorByName(theme: active, name: "textPrimary"), chain255: chain255)
  }
  if styleId is albumCaption {
    ret toRaylibColor(color: colorByName(theme: active, name: "textMuted"), chain255: chain255)
  }
  if styleId is trackTitle {
    ret toRaylibColor(color: colorByName(theme: active, name: "textPrimary"), chain255: chain255)
  }
  if styleId is trackMuted {
    ret toRaylibColor(color: colorByName(theme: active, name: "textMuted"), chain255: chain255)
  }
  if styleId is tabActive {
    ret toRaylibColor(color: colorByName(theme: active, name: "textPrimary"), chain255: chain255)
  }
  if styleId is tabInactive {
    ret toRaylibColor(color: colorByName(theme: active, name: "textMuted"), chain255: chain255)
  }
  # "On surfaceAlt" styles read accentText for theme-correct contrast.
  if styleId is miniTitle {
    ret toRaylibColor(color: colorByName(theme: active, name: "accentText"), chain255: chain255)
  }
  if styleId is miniMuted {
    # Theme-aware muted color for text on the mini-player pill
    # (background = `surfaceAlt`). In the light theme that's a
    # pale cyan needing dark muted text; in dark theme it's a
    # darker green needing light muted text. The
    # `accentTextMuted` token carries the right value for each.
    ret toRaylibColor(
      color: colorByName(theme: active, name: "accentTextMuted")
      chain255: chain255
    )
  }
  # Pill labels sit on top of the `$accent` shape — `$accentText`
  # is the dual.
  if styleId is pillLabelLight {
    ret toRaylibColor(color: colorByName(theme: active, name: "accentText"), chain255: chain255)
  }
  # Debug-UI styles (theme-independent — see lib/ui/debug.rae).
  let debugButton: String = "debugButton"
  if styleId is debugButton {
    let dark: RgbaColor = { r: 24, g: 24, b: 28, a: 255 }
    ret toRaylibColor(color: dark, chain255: chain255)
  }
  let debugMenuLabel: String = "debugMenuLabel"
  if styleId is debugMenuLabel {
    let light: RgbaColor = { r: 246, g: 246, b: 248, a: 255 }
    ret toRaylibColor(color: light, chain255: chain255)
  }
  # Caption-class right-aligned time label — matches `caption` colour.
  if styleId is "timeTotal" {
    ret toRaylibColor(color: colorByName(theme: active, name: "textMuted"), chain255: chain255)
  }
  # Fallback: treat unknown style ids as primary text.
  ret toRaylibColor(color: colorByName(theme: active, name: "textPrimary"), chain255: chain255)
}

# Horizontally-centered styles: the renderer measures the glyph run
# and offsets the draw position so the text sits in the middle of its
# rect. Most styles stay left-aligned because the layout system
# already places the rect itself; the explicit-center styles below are
# for cases where the rect is wider than the text (e.g. tab labels
# that share a fixed-width container with a centred icon above).
func isCentered(styleId: view String) ret Bool {
  let tabActive: String = "tabActive"
  if styleId is tabActive {
    ret true
  }
  let tabInactive: String = "tabInactive"
  if styleId is tabInactive {
    ret true
  }
  # Debug button: the "D" glyph sits centred inside the amber circle.
  # `pageTitle` also centers — every top-level screen's title bar.
  let debugButton: String = "debugButton"
  if styleId is debugButton {
    ret true
  }
  let pageTitle: String = "pageTitle"
  if styleId is pageTitle {
    ret true
  }
  ret false
}

# Mobile UI's playing widgets (now-playing + mini-player titles/artists)
# get a soft drop-shadow so they read against album-cover backgrounds.
func textStyleHasShadow(styleId: view String) ret Bool {
  if styleId is "h1" {
    ret true
  }
  if styleId is "muted" {
    ret true
  }
  if styleId is "miniTitle" {
    ret true
  }
  if styleId is "miniMuted" {
    ret true
  }
  ret false
}

# NowPlaying's TimeTotal label needs to sit flush against the progress
# bar's right edge — its containing SpaceBetween row leaves a gap.
func isRightAligned(styleId: view String) ret Bool {
  if styleId is "timeTotal" {
    ret true
  }
  ret false
}

func paintText(
  world: view UiWorld
  entity: view EntityId
  wt: view WorldTransform2D
  cr: view ComputedRect
  chain255: view Int
) {
  unsafe {
    let tx: view Text => componentView(this: world.texts, entity: entity)
    let txt: String = tx.text
    if txt.length() is 0 {
      ret
    }
    let size: Float = textStyleSize(styleId: tx.styleId)
    let col: Color = textStyleColor(
      styleId: tx.styleId
      chain255: chain255
      active: world.theme.active
    )
    var drawX: Float = wt.position.x
    var drawY: Float = wt.position.y
    # Alignment: styleId (legacy) or Align component (Center / End).
    var centerX: Bool = isCentered(styleId: tx.styleId)
    var centerY: Bool = isCentered(styleId: tx.styleId)
    var rightAlignX: Bool = isRightAligned(styleId: tx.styleId)
    if componentHas(this: world.aligns, entity: entity) {
      let al: Align = componentGet(this: world.aligns, entity: entity)
      if al.hasX {
        if al.x is AlignKind.center {
          centerX = true
        }
        if al.x is AlignKind.end {
          rightAlignX = true
        }
      }
      if al.hasY {
        if al.y is AlignKind.center {
          centerY = true
        }
      }
    }
    if centerX or rightAlignX or centerY {
      let measured: Int = measureTextWithFont(
        slot: defaultFontSlot
        text: txt
        fontSize: size
        spacing: 1.0
      )
      if centerX {
        drawX = wt.position.x + (cr.size.x - measured.toFloat()) / 2.0
      }
      if rightAlignX {
        drawX = wt.position.x + cr.size.x - measured.toFloat()
      }
      if centerY {
        drawY = wt.position.y + (cr.size.y - size) / 2.0
      }
    }
    if isUiMsdfEnabled(world: world) {
      # Shadow gate: in `shadowStylesOnly` mode (mobile UI) only opt-in
      # styles shadow; otherwise (game proto1) all text does.
      let applyShadow: Bool = (world.msdfState.shadowStylesOnly is false) or textStyleHasShadow(
        styleId: tx.styleId
      )
      paintMsdfDispatch(
        world: world
        text: txt
        x: drawX
        y: drawY
        sizePx: size
        color: col
        chain255: chain255
        applyShadow: applyShadow
      )
      ret
    }
    if textStyleHasShadow(styleId: tx.styleId) {
      var shadowOff: Float = size * 0.06
      if shadowOff < 1.0 {
        shadowOff = 1.0
      }
      if shadowOff > 3.0 {
        shadowOff = 3.0
      }
      var blurRadius: Float = size * 0.09
      if blurRadius < 1.5 {
        blurRadius = 1.5
      }
      if blurRadius > 4.0 {
        blurRadius = 4.0
      }
      # Centre weight 0.30, edge weight 0.10 (sum ≈ 1.1 matches old density).
      let cx: Float = drawX + shadowOff
      let cy: Float = drawY + shadowOff
      let aBase: Int = chain255 * 90 / 255
      let aCtr: Int = aBase * 30 / 100
      let aEdge: Int = aBase * 10 / 100
      let shadowCtr: Color = { r: 0, g: 0, b: 0, a: aCtr }
      let shadowEdge: Color = { r: 0, g: 0, b: 0, a: aEdge }
      let d: Float = blurRadius * 0.7071
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx
        y: cy
        fontSize: size
        spacing: 1.0
        color: shadowCtr
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx
        y: cy - blurRadius
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx + d
        y: cy - d
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx + blurRadius
        y: cy
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx + d
        y: cy + d
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx
        y: cy + blurRadius
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx - d
        y: cy + d
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx - blurRadius
        y: cy
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
      drawTextWithFont(
        slot: defaultFontSlot
        text: txt
        x: cx - d
        y: cy - d
        fontSize: size
        spacing: 1.0
        color: shadowEdge
      )
    }
    drawTextWithFont(
      slot: defaultFontSlot
      text: txt
      x: drawX
      y: drawY
      fontSize: size
      spacing: 1.0
      color: col
    )
  }
}
