# Backend-agnostic UI window/input/frame seam (QUEUE #142 M4).
#
# Apps own a `backend: UiBackend` (see ui/draw) and pass it into each of these
# calls for window lifecycle, input, frame begin/end, and idle waits.
# The gpu2d backend owns an SDL3/WebGPU window; the raylib backend preserves
# the current GLFW/raylib behavior.
open Raylib
import core
import Raylib
import Gpu2d
import ui/Components
import ui/legacyRaylib/Draw

func uiRaylibColor(c: view RgbaColor) ret Color {
  ret Color { r: c.r, g: c.g, b: c.b, a: c.a }
}

func colorChannel(v: view Int) ret Float {
  ret v.toFloat() / 255.0
}

func uiInitWindow(backend: view UiBackend, width: view Int, height: view Int, title: view String) pub {
  if backend is UiBackend.gpu2d {
    Gpu2d.initWindow(width: width, height: height, title: title)
    ret
  }
  initWindow(width: width, height: height, title: title)
}

func uiSetConfigFlags(backend: view UiBackend, flags: view Int) pub {
  if backend is UiBackend.raylib {
    setConfigFlags(flags: flags)
  }
}

func uiSetRaylibLogLevel(backend: view UiBackend, level: view Int) pub {
  # gpu2d can still use raylib's image decoder as a fallback for legacy JPG
  # assets, so keep raylib's own INFO spam suppressed on both backends.
  raylibSetLogLevel(level: level)
}

func uiSetDesignResolution(backend: view UiBackend, width: view Float, height: view Float, fit: view Int) pub {
  if backend is UiBackend.gpu2d {
    Gpu2d.setDesignResolution(width: width, height: height, fit: fit)
  }
}

func uiWindowShouldClose(backend: view UiBackend) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.pollClose()
  }
  ret windowShouldClose()
}

func uiCloseWindow(backend: view UiBackend) pub {
  if backend is UiBackend.gpu2d {
    Gpu2d.closeWindow()
    ret
  }
  closeWindow()
}

func uiBeginFrame(backend: view UiBackend, clear: view RgbaColor) pub {
  if backend is UiBackend.gpu2d {
    Gpu2d.beginFrame(
      r: colorChannel(v: clear.r),
      g: colorChannel(v: clear.g),
      b: colorChannel(v: clear.b),
      a: colorChannel(v: clear.a))
    ret
  }
  beginDrawing()
  clearBackground(color: uiRaylibColor(c: clear))
}

func uiEndFrame(backend: view UiBackend) pub {
  if backend is UiBackend.gpu2d {
    Gpu2d.endFrame()
    ret
  }
  endDrawing()
}

func uiWaitEvents(backend: view UiBackend, timeoutSec: view Float) pub {
  if backend is UiBackend.gpu2d {
    Gpu2d.waitEvents(timeoutSec: timeoutSec)
    ret
  }
  waitEventsTimeout(seconds: timeoutSec)
}

# Epoch seconds — Float64: an f32 epoch (~1.7e9) quantises to ~128s, so
# two calls in one frame return the SAME value and every delta is 0.0.
func uiNowSeconds(backend: view UiBackend) pub ret Float64 {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.nowSeconds()
  }
  ret getTime()
}

func uiWindowWidth(backend: view UiBackend) pub ret Float {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.designWidth()
  }
  ret getScreenWidth().toFloat()
}

func uiWindowHeight(backend: view UiBackend) pub ret Float {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.designHeight()
  }
  ret getScreenHeight().toFloat()
}

func uiFramebufferWidth(backend: view UiBackend) pub ret Int {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.windowWidth()
  }
  ret getRenderWidth()
}

func uiFramebufferHeight(backend: view UiBackend) pub ret Int {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.windowHeight()
  }
  ret getRenderHeight()
}

func uiDpr(backend: view UiBackend) pub ret Float {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.dpr()
  }
  let logical: Int = getScreenWidth()
  if logical <= 0 {
    ret 1.0
  }
  ret getRenderWidth().toFloat() / logical.toFloat()
}

func uiPointerX(backend: view UiBackend) pub ret Float {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.pointerX()
  }
  ret getMouseX().toFloat()
}

func uiPointerY(backend: view UiBackend) pub ret Float {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.pointerY()
  }
  ret getMouseY().toFloat()
}

func uiPointerDown(backend: view UiBackend) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.pointerDown()
  }
  ret isMouseButtonDown(button: 0)
}

func uiWheelMove(backend: view UiBackend) pub ret Float {
  if backend is UiBackend.gpu2d {
    ret Gpu2d.wheelMove()
  }
  ret getMouseWheelMove()
}

func uiIsWindowResized(backend: view UiBackend) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret false
  }
  ret isWindowResized()
}

func uiSetWindowPosition(backend: view UiBackend, x: view Int, y: view Int) pub {
  if backend is UiBackend.raylib {
    setWindowPosition(x: x, y: y)
  }
}

func uiSetWindowSize(backend: view UiBackend, width: view Int, height: view Int) pub {
  if backend is UiBackend.raylib {
    setWindowSize(width: width, height: height)
  }
}

func uiSetMouseScale(backend: view UiBackend, scaleX: view Float, scaleY: view Float) pub {
  if backend is UiBackend.raylib {
    setMouseScale(scaleX: scaleX, scaleY: scaleY)
  }
}

func uiInstallWindowCloseWaker(backend: view UiBackend) pub {
  if backend is UiBackend.raylib {
    installWindowCloseWaker()
  }
}

func uiInstallMouseButtonHook(backend: view UiBackend) pub {
  if backend is UiBackend.raylib {
    installMouseButtonHook()
  }
}

func uiDisableAppNap(backend: view UiBackend) pub {
  if backend is UiBackend.raylib {
    disableAppNap()
  }
}

func uiIsKeyPressed(backend: view UiBackend, key: view Int) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret false
  }
  ret isKeyPressed(key: key)
}

func uiPointerButtonDown(backend: view UiBackend, button: view Int) pub ret Bool {
  if backend is UiBackend.gpu2d {
    if button is 0 {
      ret Gpu2d.pointerDown()
    }
    ret false
  }
  ret isMouseButtonDown(button: button)
}

func uiPointerButtonPressed(backend: view UiBackend, button: view Int) pub ret Bool {
  if backend is UiBackend.gpu2d {
    if button is 0 {
      ret Gpu2d.pointerPressed()
    }
    ret false
  }
  ret isMouseButtonPressed(button: button)
}

func uiPointerButtonReleased(backend: view UiBackend, button: view Int) pub ret Bool {
  if backend is UiBackend.gpu2d {
    if button is 0 {
      ret Gpu2d.pointerReleased()
    }
    ret false
  }
  ret isMouseButtonReleased(button: button)
}

func uiMouseHookActive(backend: view UiBackend) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret false
  }
  ret mouseHookActive()
}

func uiMouseHookDrainPressed(backend: view UiBackend) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret false
  }
  ret mouseHookDrainPressed()
}

func uiMouseHookDrainReleased(backend: view UiBackend) pub ret Bool {
  if backend is UiBackend.gpu2d {
    ret false
  }
  ret mouseHookDrainReleased()
}

func uiCurrentMonitor(backend: view UiBackend) pub ret Int {
  if backend is UiBackend.gpu2d {
    ret 0
  }
  ret getCurrentMonitor()
}

func uiMonitorHeight(backend: view UiBackend, monitor: view Int) pub ret Int {
  if backend is UiBackend.gpu2d {
    ret uiFramebufferHeight(backend: backend)
  }
  ret getMonitorHeight(monitor: monitor)
}

func uiMonitorRefreshRate(backend: view UiBackend, monitor: view Int) pub ret Int {
  if backend is UiBackend.gpu2d {
    ret 60
  }
  ret getMonitorRefreshRate(monitor: monitor)
}
