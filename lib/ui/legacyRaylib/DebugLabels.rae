# DebugLabels — the legacy raylib debug overlay's per-frame drawing (#918 split
# of legacyRaylib/Debug for the 1000-line cap): the FPS / memory formatters,
# the debug labels, the heartbeat and updateAndRenderDebugOverlay, the
# per-frame entry that records the frame and draws them. legacyRaylib/Debug
# keeps the DebugSystem state, the menu overlay and its actions.
open Raylib
import ui/Components
import ui/Ecs
import ui/Theme
import ui/legacyRaylib/Window
open ecs/ComponentTable
open ui/legacyRaylib/Debug

# Format `kb` (in KB) into a `"X.Y MB"` string. The raw value is too
# noisy to read directly; rounding to one decimal of MB matches what
# Activity Monitor / `ps -o rss` displays for a typical mobile-UI app.
func formatMemMB(kb: view Int) ret String {
  # Multiply by 10 before dividing so we keep one decimal place without
  # importing the math module. 5520 KB -> 5520*10 / 1024 = 53 -> "5.3 MB".
  let tenths: Int = (kb * 10) / 1024
  let whole: Int = tenths / 10
  let frac: Int = tenths - whole * 10
  ret "{whole}.{frac} MB"
}

func formatFps(fps: view Float) ret String {
  # Round to nearest integer. Sub-1 fps and weird startup values just
  # show "0" / "1" — that's fine for an at-a-glance read-out.
  var rounded: Int = (fps + 0.5).toInt()
  if rounded < 0 {
    rounded = 0
  }
  ret "fps: {rounded}"
}

# Draw the two text lines (FPS + mem) anchored just BELOW the debug
# button. Called from `updateAndRenderDebugOverlay` when labels are on.
# These are drawn outside the ECS so they don't intercept clicks.
#
# Alignment follows the button's screen position: a button in the
# left half of the screen left-aligns labels under it; a button in
# the right half right-aligns them so they hang off the button's
# right edge instead of running off-screen. Right-alignment needs a
# per-line text measurement because each line has a different width.
func drawDebugLabels(backend: view UiBackend, debug: view DebugSystem) {
  unsafe {
    let fpsText: String = formatFps(fps: debug.lastFps)
    let memText: String = "mem: {formatMemMB(kb: debug.lastRssKb)}"

    # Stack the labels vertically below the button. Each line is ~16 px
    # tall at fontSize 14. The first line starts just under the button's
    # bottom edge.
    let fontSize: Float = 14.0
    let lineH: Float = 16.0
    let gap: Float = 4.0
    let bottomEdge: Float = debug.buttonY + debug.buttonSize
    let fpsY: Float = bottomEdge + gap
    let memY: Float = fpsY + lineH + 2.0

    # Pick alignment based on which half of the screen the button is
    # in. Centre point of the button vs. centre point of the screen.
    let buttonCx: Float = debug.buttonX + debug.buttonSize * 0.5
    let screenCx: Float = debug.screenW * 0.5
    let rightAligned: Bool = buttonCx > screenCx
    var fpsX: Float = debug.buttonX
    var memX: Float = debug.buttonX
    if rightAligned {
      # Right edge of the button — labels grow LEFT from here.
      let rightEdge: Float = debug.buttonX + debug.buttonSize
      let spacing: Float = 1.0
      let fpsW: Int = measureTextWithFont(
        slot: 0
        text: fpsText
        fontSize: fontSize
        spacing: spacing
      )
      let memW: Int = measureTextWithFont(
        slot: 0
        text: memText
        fontSize: fontSize
        spacing: spacing
      )
      fpsX = rightEdge - fpsW.toFloat()
      memX = rightEdge - memW.toFloat()
    }

    # Use the host's loaded font slot 0 (Roboto in 98_mobile_ui). Falls
    # back to raylib's default font if no slot is loaded — see
    # `lib/raylib.rae` notes on `drawTextWithFont`.
    let col: Color = { r: 255, g: 191, b: 0, a: 255 }
    drawTextWithFont(
      slot: 0
      text: fpsText
      x: fpsX
      y: fpsY
      fontSize: fontSize
      spacing: 1.0
      color: col
    )
    drawTextWithFont(
      slot: 0
      text: memText
      x: memX
      y: memY
      fontSize: fontSize
      spacing: 1.0
      color: col
    )

    # Third line, only when input-outline debug mode is on: mouse
    # button bitfield (bit 0 = left, bit 1 = right, bit 2 = middle).
    # Useful next to the outline overlay when chasing why a click is
    # or isn't reaching a target — at a glance you see the button
    # state the input layer is actually polling.
    if debug.showInputOutlines {
      var lb: Int = 0
      if uiPointerButtonDown(backend: backend, button: 0) {
        lb = 1
      }
      var rb: Int = 0
      if uiPointerButtonDown(backend: backend, button: 1) {
        rb = 2
      }
      var mb: Int = 0
      if uiPointerButtonDown(backend: backend, button: 2) {
        mb = 4
      }
      let buttons: Int = lb + rb + mb
      let buttonText: String = "button: {buttons}"
      let buttonY: Float = memY + lineH + 2.0
      var buttonX: Float = debug.buttonX
      if rightAligned {
        let rightEdge: Float = debug.buttonX + debug.buttonSize
        let buttonW: Int = measureTextWithFont(
          slot: 0
          text: buttonText
          fontSize: fontSize
          spacing: 1.0
        )
        buttonX = rightEdge - buttonW.toFloat()
      }
      drawTextWithFont(
        slot: 0
        text: buttonText
        x: buttonX
        y: buttonY
        fontSize: fontSize
        spacing: 1.0
        color: col
      )
    }
  }
}

# Per-frame entry point. Records the frame timestamp (for FPS), reads
# RSS, and draws the labels if enabled. Call this AFTER renderSystem
# (and after any hero overlay) so the labels paint on top of the host
# UI. The button itself is drawn by renderSystem because it lives in
# the ECS world.
func updateAndRenderDebugOverlay(backend: view UiBackend, debug: mod DebugSystem, now: view Float64, didRealWork: view Bool) pub {
  recordDebugFrame(debug: debug, now: now, didRealWork: didRealWork)
  if debug.showLabels {
    drawDebugLabels(backend: backend, debug: debug)
    drawDebugHeartbeat(debug: debug, didRealWork: didRealWork)
  }
}

# 4×4 amber square that crawls left-to-right along the top edge of
# the screen. ADVANCES only on frames the host reports as "real
# work" (e.g. dirty-detection said the ECS world actually changed
# this frame). On idle/cached frames the square stays put — so the
# motion of the square mirrors the rate of meaningful per-frame
# work, not the raw frame rate. A frozen square with a non-zero
# FPS label means "the loop is running but the dirty-detection
# is short-circuiting everything"; a moving square means the
# host is actually re-rendering changed content.
#
# Wraps off-screen at the right and re-enters from x=-4 so the
# motion is smooth. Gated by the FPS/mem labels toggle.
func drawDebugHeartbeat(debug: mod DebugSystem, didRealWork: view Bool) {
  unsafe {
    if didRealWork {
      debug.heartbeatX = debug.heartbeatX + 1.0
      if debug.heartbeatX > debug.screenW {
        debug.heartbeatX = -4.0
      }
    }
    let amber: Color = { r: 255, g: 191, b: 0, a: 255 }
    drawRectangle(
      x: debug.heartbeatX
      y: 0.0
      width: 4.0
      height: 4.0
      color: amber
    )
  }
}
