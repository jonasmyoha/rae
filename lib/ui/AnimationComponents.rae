# The authored components of UI animation (docs/ui-animation-design.md section 4, and
# docs/ui-scene-format.md), and the two runtime tables that go with them.
#
# A field not written takes the default here. `motion` and `opacityMotion` name motion tokens.
open ecs/Entity

# How a node arrives. The numbers say where it starts from; it ends at its normal place. It plays
# when the node is mounted and when it comes to be shown again. The start pose applies before the
# first paint, so a node never flashes at its end place.
type Appear {
  motion: String = "lively"
  opacityMotion: String = "fadeIn"
  opacity: Float = 0.0
  scale: Float = 1.0
  x: Float = 0.0
  y: Float = 16.0
  rotation: Float = 0.0
  delaySeconds: Float = 0.0
}

# How a node leaves. The numbers say where it ends. See setActiveAnimated and destroyAnimated.
type Disappear {
  motion: String = "quick"
  opacityMotion: String = "fadeOut"
  opacity: Float = 0.0
  scale: Float = 0.96
  x: Float = 0.0
  y: Float = 0.0
  rotation: Float = 0.0
}

enum StaggerFrom { start, end, center, none }

# On a parent or a list: its children's Appear and Disappear start one after another. `maxSeconds`
# caps the total, so a long list never makes a person wait: the step shrinks to fit. It counts
# visible children only, and a child outside its parent's box starts at once.
type Stagger {
  stepSeconds: Float = 0.028
  maxSeconds: Float = 0.22
  appearFrom: StaggerFrom = StaggerFrom.end
  disappearFrom: StaggerFrom = StaggerFrom.start
}

# When layout moves this node, it glides from its old place to the new one. Layout runs once and
# gets the true places; later frames run no layout. Only position glides; size changes at once.
type AnimateLayout {
  motion: String = "smooth"
}

enum AnimateTextKind { fade, roll }

enum RollFrom { below, above }

# When its text changes, the old text goes as the new one comes: `fade`, or `roll` for a clock
# or a counter, where the new text comes from `rollFrom`. The old text is only drawn, so layout
# never sees it.
type AnimateText {
  kind: AnimateTextKind = AnimateTextKind.fade
  rollFrom: RollFrom = RollFrom.below
  motion: String = "quick"
}

# How a page comes and goes, on a page's root (lib/ui/pageTransitionSystem). `motion` "" is the
# kind's own.
enum PageTransitionKind {
  push
  sibling
  zoom
  sheet
  fade
  none
}

type PageTransition {
  kind: PageTransitionKind = PageTransitionKind.fade
  motion: String = ""
}

# A node that is on two pages with one `key` (lib/ui/animationSystem/SharedElements). `stay`: at one
# place it does not move with the page. `morph`: it moves and resizes from the old node's rectangle.
enum SharedMode { stay, morph }

type SharedElement {
  key: String
  mode: SharedMode = SharedMode.morph
  motion: String = "smooth"
}

enum EdgeSwipePhase { idle, watching, active }

# RESOURCE on the world: a press at the left edge that may be a swipe
# (ui/pageTransitionSystem/EdgeSwipe)
type EdgeSwipeState {
  phase: EdgeSwipePhase = EdgeSwipePhase.idle
  pressX: Float = 0.0
  pressY: Float = 0.0
  startX: Float = 0.0
  lastX: Float = 0.0
  d0: Float = 0.0
  d1: Float = 0.0
  d2: Float = 0.0
}

enum ListChangeDirection { forward, back }

# RUNTIME: the data this list is getting replaces all of it (ui/listMotionSystem, listRowsChange)
type ListChange {
  direction: ListChangeDirection
}

# RUNTIME: a node on its way out. It stays drawn and takes no hits and no focus. It stays laid out
# too, unless a list has given its place to the rows arriving there.
type Leaving {
  holdsPlace: Bool = true
}

# RUNTIME: animationTriggers' record of a node with one of the components above: whether it was
# shown when last looked at, and, for the one pass that finds arrivals, its place among them
type AppearSeen {
  shown: Bool = false
  arrived: Bool = false
  staggered: Bool = false
  staggerSeconds: Float = 0.0
}

# A node asked to leave or to come back, for animationTriggers (setActiveAnimated, destroyAnimated)
type AnimationRequest {
  entityId: EntityId
  active: Bool
  destroy: Bool
}
