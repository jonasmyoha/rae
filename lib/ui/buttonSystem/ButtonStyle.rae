# ButtonStyle — the button system's STYLE phase (buttonSystem/, docs/ecs-
# systems-own-their-tables.md §3.1): the visual half of the data-oriented
# widget model (see components.rae: WidgetId / WidgetState / DataDependency /
# ActionBinding / StateStyle).
#
# Apps flip WidgetState flags (selected / enabled / loading / error)
# from their data-sync systems; this system walks the StateStyle table
# once per frame and applies the matching visual variant to the
# widget's Sprite / Text / Opacity. No app code patches sprites or
# text styles imperatively for stateful widgets.
#
# Change-detection discipline: componentMod bumps the table generation
# eagerly, which would defeat idle frame-skipping if taken every
# frame. Every apply below therefore compares through componentView
# first and only takes the mod borrow when a value actually differs.
#
# Implementation note: StateStyle is never copied out by value —
# helpers read through short-lived `componentView` borrows and return
# plain Strings / colors. Struct-by-value returns of String-bearing
# types are a known compiler hazard (inner-String ownership gap).
import ui/Theme
open ecs/ComponentTable

# ----- variant readers (fresh scalar/String copies, no struct copy) --
func styleWantSpriteKey(
  world: view UiWorld
  entityId: view EntityId
  selected: view Bool
) ret String {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  if selected {
    ret "{style.spriteKeySelected}"
  }
  ret "{style.spriteKey}"
}

func styleWantTint(
  world: view UiWorld
  entityId: view EntityId
  selected: view Bool
) ret RgbaColor {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  # A non-empty slot references the active theme (#237); else the literal.
  if selected {
    if style.tintSelectedSlot.length() > 0 {
      ret uiThemeColor(theme: world.theme, name: style.tintSelectedSlot)
    }
    ret style.tintSelected
  }
  if style.tintSlot.length() > 0 {
    ret uiThemeColor(theme: world.theme, name: style.tintSlot)
  }
  ret style.tint
}

func styleHasTint(world: view UiWorld, entityId: view EntityId) ret Bool {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  ret style.hasTint
}

func styleWantTextStyle(
  world: view UiWorld
  entityId: view EntityId
  selected: view Bool
) ret String {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  if selected {
    ret "{style.textStyleSelected}"
  }
  ret "{style.textStyle}"
}

func styleDisabledAlpha(world: view UiWorld, entityId: view EntityId) ret Float {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  ret style.disabledAlpha
}

func styleLoadingAlpha(world: view UiWorld, entityId: view EntityId) ret Float {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  ret style.loadingAlpha
}

func styleErrorAlpha(world: view UiWorld, entityId: view EntityId) ret Float {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  ret style.errorAlpha
}

func styleWantShapeFill(
  world: view UiWorld
  entityId: view EntityId
  selected: view Bool
) ret RgbaColor {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  # A non-empty slot references the active theme (#237); else the literal.
  if selected {
    if style.shapeFillSelectedSlot.length() > 0 {
      ret uiThemeColor(theme: world.theme, name: style.shapeFillSelectedSlot)
    }
    ret style.shapeFillSelected
  }
  if style.shapeFillSlot.length() > 0 {
    ret uiThemeColor(theme: world.theme, name: style.shapeFillSlot)
  }
  ret style.shapeFill
}

func styleHasShapeFill(world: view UiWorld, entityId: view EntityId) ret Bool {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  ret style.hasShapeFill
}

func styleWantOffset(world: view UiWorld, entityId: view EntityId, selected: view Bool) ret Vec2 {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  if selected {
    ret style.offsetSelected
  }
  ret style.offset
}

func styleHasOffset(world: view UiWorld, entityId: view EntityId) ret Bool {
  let style: view StateStyle => componentView(this: world.stateStyles, entityId: entityId)
  ret style.hasOffset
}

# ----- read-side checks (view borrows only) --------------------------
func spriteKeyDiffers(world: view UiWorld, entityId: view EntityId, wantKey: view String) ret Bool {
  if wantKey.length() is 0 {
    ret false
  }
  if componentHas(this: world.sprites, entityId: entityId) is false {
    ret false
  }
  let cur: view Sprite => componentView(this: world.sprites, entityId: entityId)
  ret cur.textureKey is wantKey is false
}

func spriteTintDiffers(
  world: view UiWorld
  entityId: view EntityId
  wantTint: view RgbaColor
) ret Bool {
  if componentHas(this: world.sprites, entityId: entityId) is false {
    ret false
  }
  let cur: view Sprite => componentView(this: world.sprites, entityId: entityId)
  ret equals(a: cur.tint, b: wantTint) is false
}

func textStyleDiffers(
  world: view UiWorld
  entityId: view EntityId
  wantStyle: view String
) ret Bool {
  if wantStyle.length() is 0 {
    ret false
  }
  if componentHas(this: world.texts, entityId: entityId) is false {
    ret false
  }
  let cur: view Text => componentView(this: world.texts, entityId: entityId)
  ret cur.styleId is wantStyle is false
}

func shapeFillDiffers(
  world: view UiWorld
  entityId: view EntityId
  wantFill: view RgbaColor
) ret Bool {
  if componentHas(this: world.shapes, entityId: entityId) is false {
    ret false
  }
  let cur: view Shape => componentView(this: world.shapes, entityId: entityId)
  ret equals(a: cur.fill, b: wantFill) is false
}

func offsetDiffers(world: view UiWorld, entityId: view EntityId, wantOffset: view Vec2) ret Bool {
  if componentHas(this: world.offsets, entityId: entityId) is false {
    ret true
  }
  let cur: view Offset => componentView(this: world.offsets, entityId: entityId)
  if cur.delta.x is not wantOffset.x {
    ret true
  }
  ret cur.delta.y is not wantOffset.y
}

# ----- per-visual apply (mod borrow only when a check said "differs")
func applySpriteStyle(world: mod UiWorld, entityId: view EntityId, selected: view Bool) {
  var wantKey: String = styleWantSpriteKey(world: world, entityId: entityId, selected: selected)
  let wantTint: RgbaColor = styleWantTint(world: world, entityId: entityId, selected: selected)
  let keyChange: Bool = spriteKeyDiffers(world: world, entityId: entityId, wantKey: wantKey)
  var tintChange: Bool = false
  if styleHasTint(world: world, entityId: entityId) {
    tintChange = spriteTintDiffers(world: world, entityId: entityId, wantTint: wantTint)
  }
  if keyChange is false and tintChange is false {
    ret
  }
  let sp: mod Sprite => componentMod(this: world.sprites, entityId: entityId)
  if keyChange {
    sp.textureKey = own wantKey
  }
  if tintChange {
    sp.tint = wantTint
    # A StateStyle tint is a state color (e.g. liked=coral), not a theme
    # slot — clear any scene-authored slot so paint uses this literal
    # rather than re-resolving the slot against the active theme (#235).
    sp.tintSlot = ""
  }
}

func applyTextStyle(world: mod UiWorld, entityId: view EntityId, selected: view Bool) {
  var wantStyle: String = styleWantTextStyle(world: world, entityId: entityId, selected: selected)
  if textStyleDiffers(world: world, entityId: entityId, wantStyle: wantStyle) is false {
    ret
  }
  let t: mod Text => componentMod(this: world.texts, entityId: entityId)
  t.styleId = own wantStyle
}

func applyShapeStyle(world: mod UiWorld, entityId: view EntityId, selected: view Bool) {
  if styleHasShapeFill(world: world, entityId: entityId) is false {
    ret
  }
  let wantFill: RgbaColor = styleWantShapeFill(world: world, entityId: entityId, selected: selected)
  if shapeFillDiffers(world: world, entityId: entityId, wantFill: wantFill) is false {
    ret
  }
  let sh: mod Shape => componentMod(this: world.shapes, entityId: entityId)
  sh.fill = wantFill
  # State fill overrides the scene slot — clear it (see applySpriteStyle, #235).
  sh.fillSlot = ""
}

func applyOffsetStyle(world: mod UiWorld, entityId: view EntityId, selected: view Bool) {
  if styleHasOffset(world: world, entityId: entityId) is false {
    ret
  }
  let wantOffset: Vec2 = styleWantOffset(world: world, entityId: entityId, selected: selected)
  if offsetDiffers(world: world, entityId: entityId, wantOffset: wantOffset) is false {
    ret
  }
  let off: Offset = { delta: wantOffset }
  componentSet(this: world.offsets, entityId: entityId, data: off)
}

# Widget state dims through the Opacity component. Only engages when
# at least one state asks for it (< 1.0), so widgets that drive Opacity
# elsewhere are untouched by default.
func applyStateOpacity(
  world: mod UiWorld
  entityId: view EntityId
  enabled: view Bool
  loading: view Bool
  error: view Bool
) {
  let disabledAlpha: Float = styleDisabledAlpha(world: world, entityId: entityId)
  let loadingAlpha: Float = styleLoadingAlpha(world: world, entityId: entityId)
  let errorAlpha: Float = styleErrorAlpha(world: world, entityId: entityId)
  if disabledAlpha >= 1.0 and loadingAlpha >= 1.0 and errorAlpha >= 1.0 {
    ret
  }
  var want: Float = 1.0
  if error {
    want = errorAlpha
  } else if loading {
    want = loadingAlpha
  } else if enabled is false {
    want = disabledAlpha
  }
  if componentHas(this: world.opacities, entityId: entityId) is false {
    if want is 1.0 {
      ret
    }
    let o: Opacity = { value: want }
    componentSet(this: world.opacities, entityId: entityId, data: o)
    ret
  }
  let cur: view Opacity => componentView(this: world.opacities, entityId: entityId)
  if cur.value is want {
    ret
  }
  let o: mod Opacity => componentMod(this: world.opacities, entityId: entityId)
  o.value = want
}

# ----- the system -----------------------------------------------------
func buttonStyleUpdate(world: mod UiWorld) {
  let n: Int = componentCount(this: world.stateStyles)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: world.stateStyles, i: i)
    var selected: Bool = false
    var enabled: Bool = true
    var loading: Bool = false
    var error: Bool = false
    if componentHas(this: world.widgetStates, entityId: entityId) {
      let ws: view WidgetState => componentView(this: world.widgetStates, entityId: entityId)
      selected = ws.selected
      enabled = ws.enabled
      loading = ws.loading
      error = ws.error
    }
    applySpriteStyle(world: world, entityId: entityId, selected: selected)
    applyTextStyle(world: world, entityId: entityId, selected: selected)
    applyShapeStyle(world: world, entityId: entityId, selected: selected)
    applyOffsetStyle(world: world, entityId: entityId, selected: selected)
    applyStateOpacity(
      world: world
      entityId: entityId
      enabled: enabled
      loading: loading
      error: error
    )
    i = i + 1
  }
}
