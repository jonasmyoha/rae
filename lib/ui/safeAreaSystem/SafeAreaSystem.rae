# Safe-area system — the responsive-layout counterpart to the layout
# pass. It runs once per frame *before* `layoutSystem` and writes a
# `SafeInsets` (in design units) onto every entity that opts in via a
# `SafeArea` component. `entityPadding` in layout.rae then folds those
# insets into the node's effective padding, so the notch / home-
# indicator reserve is structural rather than a hand-tuned constant.
#
# The insets are supplied by the caller already resolved to design
# units — device presets live in `lib/ui/devicePresets.rae` and the
# app converts a preset's point-space insets into layout-extent
# fractions before calling this. Keeping the system inset-agnostic
# means it has no dependency on the windowing backend or on any
# particular Viewport shape.
#
# The world's reserved insets (setReservedInsets: a band a host keeps for its
# own bar) are added to them, so every SafeArea node lays out inside both the
# screen's safe area and the host's band.
#
# See rae/docs/ui-viewport-and-safe-area-plan.md (Phase 1, item 2).
import Gpu2d
open ecs/ComponentTable
open ui/UiSystems

func safeAreaSystem(world: mod UiWorld, uiSystems: mod UiSystems, insets: view Insets) {
  # the screen's insets plus the host's reserved band
  let total: Insets = {
    l: insets.l + world.reservedInsets.l
    t: insets.t + world.reservedInsets.t
    r: insets.r + world.reservedInsets.r
    b: insets.b + world.reservedInsets.b
  }
  unsafe {
    let alive: view List(EntityId) = world.allocator.alive
    let n: Int = alive.length
    var i: Int = 0
    loop i < n {
      let e: EntityId = rae_ext_rae_buf_get(buf: alive.data, index: i)
      if componentHas(this: world.safeAreas, entityId: e) {
        # Idempotent: only write when the entity has no SafeInsets yet or
        # its stored value differs. `SafeInsets` is not a layout dirty
        # input (see layout.rae ifDirty), so an unconditional
        # write would be invisible to the dirty-check anyway — but this
        # keeps the component generation stable so any future tracking,
        # and the render caches, stay clean at idle.
        var changed: Bool = true
        if componentHas(this: uiSystems.safeArea.safeInsets, entityId: e) {
          let cur: view SafeInsets = componentView(this: uiSystems.safeArea.safeInsets, entityId: e)
          if equals(a: cur.insets, b: total) {
            changed = false
          }
        }
        if changed {
          let payload: SafeInsets = {
            insets: Insets { l: total.l, t: total.t, r: total.r, b: total.b }
          }
          componentSet(this: uiSystems.safeArea.safeInsets, entityId: e, data: payload)
        }
      }
      i = i + 1
    }
  }
}

# The OS's safe-area insets now (design units; 0 without a window)
func osSafeInsets() ret Insets {
  ret Insets {
    l: Gpu2d.safeLeft()
    t: Gpu2d.safeTop()
    r: Gpu2d.safeRight()
    b: Gpu2d.safeBottom()
  }
}

# The step a layout pass starts with (runUiSystems, runScheduledUiSystems):
# every node that asks for the safe area gets the screen's insets, the
# simulated ones while the world has them, else the OS's
func feedSafeArea(world: mod UiWorld, uiSystems: mod UiSystems) {
  if world.safeInsetsSimulated {
    let simulated: Insets = world.simulatedSafeInsets
    safeAreaSystem(world: world, uiSystems: uiSystems, insets: simulated)
  } else {
    safeAreaSystem(world: world, uiSystems: uiSystems, insets: osSafeInsets())
  }
}

# Lay the UI out as if the screen's safe area were `insets` (a device
# simulator, a layout test), until clearSimulatedSafeInsets
func setSimulatedSafeInsets(world: mod UiWorld, insets: view Insets) {
  world.simulatedSafeInsets = Insets { l: insets.l, t: insets.t, r: insets.r, b: insets.b }
  world.safeInsetsSimulated = true
}

func clearSimulatedSafeInsets(world: mod UiWorld) {
  world.safeInsetsSimulated = false
}

# Keep a band for the host on top of the safe area (`insets` in the world's
# layout units: points for a world laid out in points), as a host that draws
# its own bar along the top of every screen does. Every SafeArea node then
# lays out inside both. The next safe-area step writes the new insets, which
# reruns the layout (the layout step reads the safe insets' generation);
# zero insets give the band back.
func setReservedInsets(world: mod UiWorld, insets: view Insets) {
  world.reservedInsets = Insets { l: insets.l, t: insets.t, r: insets.r, b: insets.b }
}

func reservedInsets(world: view UiWorld) ret Insets {
  ret Insets {
    l: world.reservedInsets.l
    t: world.reservedInsets.t
    r: world.reservedInsets.r
    b: world.reservedInsets.b
  }
}
