# listViewSystem — virtualised rows for the `ListView` component (#945).
#
# A `ListView` entity carries a `ListView` (the layout/binding spec), a
# `ScrollState` (the scroll offset), and a sibling `ListViewData` (the rows). The
# system keeps only a WINDOW of live row entities as the ListView's children —
# the rows spanning the viewport plus `overscanRows` each side — and RECYCLES
# them on scroll: the pooled row entities persist across scroll ticks, and each
# tick only re-points a slot at its new data row (re-applying the bindings) and
# moves it, growing or shrinking the pool only when the window SIZE changes. So a
# 10k-row list costs O(window) live entities, not O(rows).
#
# A row is either a SUB-SCENE or a bindings-only skeleton (#964):
#   * `ListView.itemSceneId` names a scene in the host's `SceneRegistry`: each
#     pooled row root mounts that scene once (its root node IS the row root),
#     under a per-row nodeId page (`listRow<index>`) so the bindings can find
#     the authored nodes by id. Recycling re-binds, never re-mounts.
#   * Otherwise each distinct binding `nodeId` becomes one bare child of the
#     row, created in binding order so slot k == distinctNodeIds[k].
# A binding writes one component field of one row node from the row's
# `itemField` value (prefix + value + suffix). Scene rows accept every
# `SceneOverride` target — `Text.text` / `Text.styleId`, `Sprite.textureKey` /
# `Sprite.tint`, `OnClick.actionId`, `Active.value` (a "true"/"false" cell, the
# placeholder/media-state switch) — written in place and only when the value
# changed, so an unchanged row costs no table generation bump. Skeleton rows
# support `Text.text` and `OnClick.actionId`.
#
# Scrolling: `ScrollState.y` on the ListView entity is the source of truth. The
# system applies it as the entity's `RuntimeOffset` (a transform-time
# translation, so a scroll step never reruns layout) and positions the pooled
# rows at their content offset (`dataIndex * pitch`) via `Offset`.
#
# FLOW mode (#996, `ListView.mode: "Flow"`): every data row is a live child
# and the container's own authored `Layout` places them — a `Grid` with
# `columns` (a cover grid), a `Horizontal` strip (recently played), a
# `Vertical` stack (a track list). Rows are keyed (`itemKeyField`, else the
# index): a rebind reuses the row entity whose key AND sub-scene match and
# only re-applies its bindings, creates the rows that are new, destroys the
# ones that went, and rewrites the child order to the data order — so entity
# ids, hover state and hero captures survive a data change. The sub-scene
# per row comes from `rowScenes[row[rowKindField]]`, else `itemSceneId`, so
# one grid mixes tile kinds. Nothing scrolls here: a flow list lives inside
# the page's scroll root.
open ui/Ecs
import ui/Components
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open ui/RegistryGeneric
open ui/UiSystems

# The nodeId page a pooled row's sub-scene is mounted under, so several rows
# of the same scene coexist in `world.nodeIds`.
func listViewRowPage(rowRoot: view EntityId) ret String {
  ret "listRow{rowRoot.index}"
}

# Does this ListView build its rows from a registered sub-scene?
func listViewUsesScene(lv: view ListView, scenes: view SceneRegistry) ret Bool {
  if lv.itemSceneId.length() is 0 {
    ret false
  }
  ret sceneRegistryHas(reg: scenes, key: lv.itemSceneId)
}

# Look up a row cell by field key. The row stores parallel keys/values lists
# (Components.rae ListViewRow); scan keys and return the matching value, or "".
func listRowValue(row: view ListViewRow, key: view String) ret String {
  unsafe {
    let n: Int = row.keys.length
    var i: Int = 0
    loop i < n {
      let k: String = rae_ext_rae_buf_get(buf: row.keys.data, index: i)
      if k is key {
        ret "{rae_ext_rae_buf_get(buf: row.values.data, index: i)}"
      }
      i = i + 1
    }
    ret ""
  }
}

# The ordered, de-duplicated node ids the bindings target — one child node per
# id, created in this order so a pooled row's k-th child always maps to
# distinctNodeIds[k] on every recycle.
func listViewDistinctNodeIds(lv: view ListView) ret List(String) {
  unsafe {
    let out: List(String) = List.create(String, cap: 4)
    let n: Int = lv.bindings.length
    var i: Int = 0
    loop i < n {
      let b: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: i)
      var seen: Bool = false
      var j: Int = 0
      loop j < out.length {
        if let existing: String = out.copyAt(index: j) {
          if existing is b.nodeId {
            seen = true
          }
        }
        j = j + 1
      }
      if seen is false {
        out.add(value: "{b.nodeId}")
      }
      i = i + 1
    }
    ret out
  }
}

# Index of `nodeId` within the distinct list (its child slot in a row), or -1.
func listViewNodeSlot(distinct: view List(String), nodeId: view String) ret Int {
  var i: Int = 0
  loop i < distinct.length {
    if let existing: String = distinct.copyAt(index: i) {
      if existing is nodeId {
        ret i
      }
    }
    i = i + 1
  }
  ret -1
}

# Write one binding onto its child entity from the row's data.
func listViewApplyBinding(
  world: mod UiWorld
  child: view EntityId
  binding: view ListViewBinding
  row: view ListViewRow
) {
  let raw: String = listRowValue(row: row, key: binding.itemField)
  let value: String = "{binding.prefix}{raw}{binding.suffix}"
  let textName: String = "Text"
  let onClickName: String = "OnClick"
  if binding.componentName is textName {
    let t: Text = { text: value, styleId: "", wrapWidthMode: WrapWidthMode.none }
    componentSet(this: world.texts, entity: child, data: t)
    ret
  }
  if binding.componentName is onClickName {
    let click: OnClick = {
      actionId: value
      actionIdDouble: ""
      actionIdTriple: ""
      maxDelayMs: 250
    }
    componentSet(this: world.onClicks, entity: child, data: click)
    ret
  }
}

# Is the binding's target already holding `value`? Compared BEFORE the write so
# an unchanged row does not bump a table generation (and so trigger a relayout)
# on every frame.
func listViewSceneBindingCurrent(
  world: view UiWorld
  entity: view EntityId
  binding: view ListViewBinding
  value: view String
) ret Bool {
  let textName: String = "Text"
  let spriteName: String = "Sprite"
  let onClickName: String = "OnClick"
  let activeName: String = "Active"
  if binding.componentName is textName {
    if componentHas(this: world.texts, entity: entity) is false {
      ret true
    }
    let cur: view Text => componentView(this: world.texts, entity: entity)
    let textField: String = "text"
    if binding.fieldName is textField {
      ret cur.text is value
    }
    ret cur.styleId is value
  }
  if binding.componentName is spriteName {
    if componentHas(this: world.sprites, entity: entity) is false {
      ret true
    }
    let cur: view Sprite => componentView(this: world.sprites, entity: entity)
    let textureField: String = "textureKey"
    if binding.fieldName is textureField {
      ret cur.textureKey is value
    }
    ret false
  }
  if binding.componentName is onClickName {
    if componentHas(this: world.onClicks, entity: entity) is false {
      ret true
    }
    let cur: view OnClick => componentView(this: world.onClicks, entity: entity)
    ret cur.actionId is value
  }
  if binding.componentName is activeName {
    if componentHas(this: world.actives, entity: entity) is false {
      ret false
    }
    let cur: Active = componentGet(this: world.actives, entity: entity)
    let trueStr: String = "true"
    ret cur.value is (value is trueStr)
  }
  let heroName: String = "HeroWidget"
  if binding.componentName is heroName {
    if componentHas(this: world.heroWidgets, entity: entity) is false {
      ret false
    }
    let cur: HeroWidget = componentGet(this: world.heroWidgets, entity: entity)
    ret cur.key is value
  }
  let widgetIdName: String = "WidgetId"
  if binding.componentName is widgetIdName {
    if componentHas(this: world.widgetIds, entity: entity) is false {
      ret false
    }
    let cur: WidgetId = componentGet(this: world.widgetIds, entity: entity)
    if binding.fieldName is "id" {
      ret cur.id is value
    }
    ret cur.kind is value
  }
  let cornerName: String = "CornerRadius"
  if binding.componentName is cornerName {
    let wanted: Float = value.toFloat()
    if componentHas(this: world.cornerRadiuses, entity: entity) is false {
      ret wanted <= 0.0
    }
    let cur: CornerRadius = componentGet(this: world.cornerRadiuses, entity: entity)
    ret cur.radius is wanted
  }
  let widgetStateName: String = "WidgetState"
  if binding.componentName is widgetStateName {
    if componentHas(this: world.widgetStates, entity: entity) is false {
      ret false
    }
    let cur: WidgetState = componentGet(this: world.widgetStates, entity: entity)
    let trueStr: String = "true"
    let wanted: Bool = value is trueStr
    if binding.fieldName is "enabled" {
      ret cur.enabled is wanted
    }
    if binding.fieldName is "selected" {
      ret cur.selected is wanted
    }
    if binding.fieldName is "loading" {
      ret cur.loading is wanted
    }
    ret cur.error is wanted
  }
  let shapeName: String = "Shape"
  if binding.componentName is shapeName {
    if componentHas(this: world.shapes, entity: entity) is false {
      ret true
    }
    let cur: view Shape => componentView(this: world.shapes, entity: entity)
    if binding.fieldName is "fillSlot" {
      ret cur.fillSlot is value
    }
    if binding.fieldName is "radius" {
      ret cur.radius is value.toFloat()
    }
    if let kind: ShapeKind = enumFromName(ShapeKind, name: authoredEnumName(text: value)) {
      ret cur.kind is kind
    }
    ret true
  }
  let gradientName: String = "GradientFill"
  if binding.componentName is gradientName {
    if componentHas(this: world.gradientFills, entity: entity) is false {
      ret true
    }
    let current: view GradientFill => componentView(this: world.gradientFills, entity: entity)
    if binding.fieldName is "fromSlot" {
      ret current.fromSlot is value
    }
    if binding.fieldName is "toSlot" {
      ret current.toSlot is value
    }
    ret true
  }
  let stateStyleName: String = "StateStyle"
  if binding.componentName is stateStyleName {
    if componentHas(this: world.stateStyles, entity: entity) is false {
      ret false
    }
    let cur: view StateStyle => componentView(this: world.stateStyles, entity: entity)
    let wanted: Float = value.toFloat()
    if binding.fieldName is "disabledAlpha" {
      ret cur.disabledAlpha is wanted
    }
    if binding.fieldName is "loadingAlpha" {
      ret cur.loadingAlpha is wanted
    }
    ret cur.errorAlpha is wanted
  }
  let paddingName: String = "Padding"
  if binding.componentName is paddingName {
    if componentHas(this: world.paddings, entity: entity) is false {
      ret false
    }
    let cur: Padding = componentGet(this: world.paddings, entity: entity)
    let wanted: Float = value.toFloat()
    if binding.fieldName is "l" {
      ret cur.insets.l is wanted
    }
    if binding.fieldName is "t" {
      ret cur.insets.t is wanted
    }
    if binding.fieldName is "r" {
      ret cur.insets.r is wanted
    }
    ret cur.insets.b is wanted
  }
  ret true
}

# Write one binding onto a sub-scene row: resolve the authored node inside this
# row's page and apply it as a SceneOverride (the same in-place field writes
# scene instances use), skipping writes that would not change anything.
func listViewApplySceneBinding(
  world: mod UiWorld
  rowRoot: view EntityId
  binding: view ListViewBinding
  row: view ListViewRow
) {
  let raw: String = listRowValue(row: row, key: binding.itemField)
  let value: String = "{binding.prefix}{raw}{binding.suffix}"
  let page: String = listViewRowPage(rowRoot: rowRoot)
  var index: Int = -1
  if let found: Int = findNodeInPage(world: world, pageId: page, nodeId: binding.nodeId) {
    index = found
  } else {
    ret
  }
  let target: EntityId = nodeEntity(world: world, index: index)
  if listViewSceneBindingCurrent(
    world: world
    entity: target
    binding: binding
    value: value
  ) {
    ret
  }
  let override: SceneOverride = {
    nodeId: "{binding.nodeId}"
    componentName: "{binding.componentName}"
    fieldName: "{binding.fieldName}"
    valueString: value
  }
  applyOverride(world: world, entity: target, override: override)
}

# Build one pooled row entity. Sub-scene rows mount the item scene onto the
# row root (once — recycling only re-binds); skeleton rows get one bare child
# per distinct binding nodeId, in distinct order so slot k == distinctNodeIds[k].
func listViewBuildRow(
  world: mod UiWorld
  uiSystems: view UiSystems
  listEntity: view EntityId
  lv: view ListView
  distinct: view List(String)
  scenes: view SceneRegistry
) ret EntityId {
  let rowRoot: EntityId = createEntity(world: world)
  # The row's placement is the list's: it FILLS the list's computed content
  # width (so a `Size: Fill` list, a resize or a panel toggle re-widths the
  # rows through layout, #71098456) and is one item high. (A sub-scene's
  # ROOT placement components are skipped on mount, as for any scene
  # instance — the host positions the instance.)
  var rowW: Float = 0.0
  if componentHas(this: world.rects, entity: listEntity) {
    rowW = componentGet(this: world.rects, entity: listEntity).size.x
  }
  let r: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: rowW, y: lv.itemHeight } }
  componentSet(this: world.rects, entity: rowRoot, data: r)
  let size: Size = {
    w: SizeAxis { mode: SizeMode.fill, min: -1, max: -1 }
    h: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
  }
  componentSet(this: world.sizes, entity: rowRoot, data: size)
  if listViewUsesScene(lv: lv, scenes: scenes) {
    let idx: Int = sceneRegistryIndex(reg: scenes, key: lv.itemSceneId)
    let scene: view Scene => sceneRegistryGet(reg: scenes, idx: idx)
    let overrides: List(SceneOverride) = emptyOverrides()
    mountSceneInstanceIntoPage(
      world: world
      uiSystems: uiSystems
      mountEntity: rowRoot
      scene: scene
      overrides: overrides
      pageId: listViewRowPage(rowRoot: rowRoot)
    )
    ret rowRoot
  }
  var k: Int = 0
  loop k < distinct.length {
    let child: EntityId = createEntity(world: world)
    setParent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: child
      parent: rowRoot
    )
    k = k + 1
  }
  ret rowRoot
}

# Re-point a pooled row at data row `row`, positioned at content-Y `topY`.
func listViewApplyRow(
  world: mod UiWorld
  rowRoot: view EntityId
  lv: view ListView
  distinct: view List(String)
  row: view ListViewRow
  topY: view Float
  sceneRow: view Bool
) {
  unsafe {
    var moved: Bool = true
    if componentHas(this: world.offsets, entity: rowRoot) {
      let cur: Offset = componentGet(this: world.offsets, entity: rowRoot)
      moved = cur.delta.y is not topY
    }
    if moved {
      let off: Offset = { delta: Vec2 { x: 0.0, y: topY } }
      componentSet(this: world.offsets, entity: rowRoot, data: off)
    }
    if sceneRow {
      let sn: Int = lv.bindings.length
      var sb: Int = 0
      loop sb < sn {
        let binding: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: sb)
        listViewApplySceneBinding(
          world: world
          rowRoot: rowRoot
          binding: binding
          row: row
        )
        sb = sb + 1
      }
      ret
    }
    # Snapshot this row's child ids (distinct-order) so binding writes don't
    # alias the childrens table while it is being read.
    let kids: List(EntityId) = List.create(EntityId, cap: distinct.length)
    if componentHas(this: world.childrens, entity: rowRoot) {
      let ch: view Children => componentView(this: world.childrens, entity: rowRoot)
      var i: Int = 0
      loop i < ch.ids.length {
        kids.add(value: rae_ext_rae_buf_get(buf: ch.ids.data, index: i))
        i = i + 1
      }
    }
    let bn: Int = lv.bindings.length
    var b: Int = 0
    loop b < bn {
      let binding: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: b)
      let slot: Int = listViewNodeSlot(distinct: distinct, nodeId: binding.nodeId)
      if slot >= 0 and slot < kids.length {
        let child: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: slot)
        listViewApplyBinding(
          world: world
          child: child
          binding: binding
          row: row
        )
      }
      b = b + 1
    }
  }
}

# Topmost data-row index to build for a scroll offset, with `overscanRows` of
# lead-in above the viewport. scrollY <= 0 (content scrolled up).
func listViewFirstRow(lv: view ListView, scrollY: view Float, count: view Int) ret Int {
  let pitch: Float = lv.itemHeight + lv.itemGap
  if pitch <= 0.0 {
    ret 0
  }
  var top: Float = 0.0 - scrollY
  if top < 0.0 {
    top = 0.0
  }
  var first: Int = (top / pitch).toInt() - lv.overscanRows
  if first < 0 {
    first = 0
  }
  if first > count {
    first = count
  }
  ret first
}

# How many rows to keep live: the viewport count plus a buffer each side (and
# one extra for a partially-visible bottom row).
func listViewWindowCount(lv: view ListView) ret Int {
  ret lv.visibleItemCount + lv.overscanRows * 2 + 1
}

# One ListView entity: reconcile its pooled row window to the current scroll.
func listViewSyncEntity(
  world: mod UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  scenes: view SceneRegistry
) {
  unsafe {
    let lv: ListView = componentGet(this: world.listViews, entity: entity)
    let sceneRow: Bool = listViewUsesScene(lv: lv, scenes: scenes)
    var scrollY: Float = 0.0
    if componentHas(this: world.scrollStates, entity: entity) {
      scrollY = componentGet(this: world.scrollStates, entity: entity).y
    }
    # The scroll is a runtime translation of the whole list (transform-time,
    # never a relayout); the rows sit at their content offsets below.
    var scrolled: Bool = true
    if componentHas(this: uiSystems.transform2d.runtimeOffsets, entity: entity) {
      let cur: RuntimeOffset = componentGet(
        this: uiSystems.transform2d.runtimeOffsets
        entity: entity
      )
      scrolled = cur.delta.y is not scrollY
    }
    if scrolled {
      let ro: RuntimeOffset = { delta: Vec2 { x: 0.0, y: scrollY } }
      componentSet(this: uiSystems.transform2d.runtimeOffsets, entity: entity, data: ro)
    }
    var count: Int = 0
    if componentHas(this: world.listViewDatas, entity: entity) {
      let data: ListViewData = componentGet(this: world.listViewDatas, entity: entity)
      count = data.rows.length
    }

    let first: Int = listViewFirstRow(lv: lv, scrollY: scrollY, count: count)
    let windowCount: Int = listViewWindowCount(lv: lv)
    var last: Int = first + windowCount - 1
    if last > count - 1 {
      last = count - 1
    }
    var target: Int = 0
    if last >= first {
      target = last - first + 1
    }

    let distinct: List(String) = listViewDistinctNodeIds(lv: lv)

    # Snapshot the current pool (the ListView's row-root children).
    let pool: List(EntityId) = List.create(EntityId, cap: windowCount + 2)
    if componentHas(this: world.childrens, entity: entity) {
      let ch: view Children => componentView(this: world.childrens, entity: entity)
      var i: Int = 0
      loop i < ch.ids.length {
        pool.add(value: rae_ext_rae_buf_get(buf: ch.ids.data, index: i))
        i = i + 1
      }
    }

    # Shrink: destroy surplus rows from the tail.
    var poolCount: Int = pool.length
    loop poolCount > target {
      let victim: EntityId = rae_ext_rae_buf_get(buf: pool.data, index: poolCount - 1)
      destroyEntitySubtree(world: world, uiSystems: uiSystems, root: victim)
      poolCount = poolCount - 1
    }
    # Grow: build fresh rows and parent them under the ListView.
    loop poolCount < target {
      let rowRoot: EntityId = listViewBuildRow(
        world: world
        uiSystems: uiSystems
        listEntity: entity
        lv: lv
        distinct: distinct
        scenes: scenes
      )
      setParent(
        parents: uiSystems.hierarchy.parents
        childrens: world.childrens
        child: rowRoot
        parent: entity
      )
      poolCount = poolCount + 1
    }

    # Re-snapshot the pool (post grow/shrink) in stable child order, then
    # re-point each slot at its data row.
    let rows2: List(EntityId) = List.create(EntityId, cap: target)
    if componentHas(this: world.childrens, entity: entity) {
      let ch: view Children => componentView(this: world.childrens, entity: entity)
      var i: Int = 0
      loop i < ch.ids.length {
        rows2.add(value: rae_ext_rae_buf_get(buf: ch.ids.data, index: i))
        i = i + 1
      }
    }
    if count is 0 {
      ret
    }
    let data: ListViewData = componentGet(this: world.listViewDatas, entity: entity)
    let pitch: Float = lv.itemHeight + lv.itemGap
    var s: Int = 0
    loop s < target and s < rows2.length {
      let dataIdx: Int = first + s
      let row: ListViewRow = rae_ext_rae_buf_get(buf: data.rows.data, index: dataIdx)
      let rowRoot: EntityId = rae_ext_rae_buf_get(buf: rows2.data, index: s)
      let topY: Float = dataIdx.toFloat() * pitch
      listViewApplyRow(
        world: world
        rowRoot: rowRoot
        lv: lv
        distinct: distinct
        row: row
        topY: topY
        sceneRow: sceneRow
      )
      s = s + 1
    }
  }
}

# ----- flow mode (#996) ------------------------------------------------------

# The sub-scene id a row mounts: its kind's entry in `rowScenes`, else the
# list's `itemSceneId`.
func listViewRowSceneId(lv: view ListView, row: view ListViewRow) ret String {
  if lv.rowKindField.length() > 0 {
    let kind: String = listRowValue(row: row, key: lv.rowKindField)
    if kind.length() > 0 {
      loop let entry: view ListViewRowScene in lv.rowScenes {
        if entry.kind is kind {
          ret "{entry.sceneId}"
        }
      }
    }
  }
  ret "{lv.itemSceneId}"
}

# The identity of data row `index`: its `itemKeyField` cell, or the index when
# the list has no key column (or the cell is empty).
func listViewRowKeyOf(lv: view ListView, row: view ListViewRow, index: view Int) ret String {
  if lv.itemKeyField.length() > 0 {
    let key: String = listRowValue(row: row, key: lv.itemKeyField)
    if key.length() > 0 {
      ret key
    }
  }
  ret "{index}"
}

# A flow row's size. The container's INNER width (its laid-out ComputedRect,
# else its authored Rect, else the page extent, minus its Padding) is the
# reference: with `fitToColumns` the
# side is that width split by the Grid layout's columns and gap (a cover
# grid's tile); otherwise the row is `itemWidth` wide (0 = the inner width, a
# full-width track row) and `itemHeight` tall (0 = square).
func listViewFlowRowSize(
  world: view UiWorld
  uiSystems: view UiSystems
  listEntity: view EntityId
  lv: view ListView
) ret Vec2 {
  # The laid-out width is authoritative once layout has run; before the first
  # layout (the mount that fills the list) the authored Rect stands in, so the
  # rows exist for that first layout pass and are resized on the next frame.
  var containerW: Float = 0.0
  if componentHas(this: uiSystems.layout.computedRects, entity: listEntity) {
    containerW = componentGet(this: uiSystems.layout.computedRects, entity: listEntity).size.x
  }
  if containerW <= 0.0 and componentHas(this: world.rects, entity: listEntity) {
    containerW = componentGet(this: world.rects, entity: listEntity).size.x
  }
  if containerW <= 0.0 {
    containerW = world.layoutW
  }
  if componentHas(this: world.paddings, entity: listEntity) {
    let pad: Padding = componentGet(this: world.paddings, entity: listEntity)
    containerW = containerW - pad.insets.l - pad.insets.r
  }
  var w: Float = lv.itemWidth
  var h: Float = lv.itemHeight
  if lv.fitToColumns {
    var cols: Int = 1
    var gap: Float = 0.0
    if componentHas(this: world.layouts, entity: listEntity) {
      let layout: Layout = componentGet(this: world.layouts, entity: listEntity)
      if layout.columns > 1 {
        cols = layout.columns
      }
      gap = layout.columnGap
    }
    let side: Float = (containerW - gap * (cols - 1).toFloat()) / cols.toFloat()
    w = side
    h = side
  }
  if w <= 0.0 {
    w = containerW
  }
  if h <= 0.0 {
    h = w
  }
  ret Vec2 { x: w, y: h }
}

# Build one flow row: the row root, sized, with its sub-scene mounted under
# the row's own nodeId page and its identity recorded for the next rebind.
func listViewBuildFlowRow(
  world: mod UiWorld
  uiSystems: view UiSystems
  lv: view ListView
  sceneId: view String
  key: view String
  size: view Vec2
  scenes: view SceneRegistry
) ret EntityId {
  let rowRoot: EntityId = createEntity(world: world)
  let identity: ListViewRowKey = { key: "{key}", sceneId: "{sceneId}" }
  componentSet(this: world.listViewRowKeys, entity: rowRoot, data: identity)
  if sceneId.length() > 0 and sceneRegistryHas(reg: scenes, key: sceneId) {
    let idx: Int = sceneRegistryIndex(reg: scenes, key: sceneId)
    let scene: view Scene => sceneRegistryGet(reg: scenes, idx: idx)
    # The row root IS the scene's root (#990, host-less): its authored
    # placement — `Size`, `Align`, `Layout` — applies, the container's
    # Layout places it, and only its Rect is the list's row size.
    let overrides: List(SceneOverride) = emptyOverrides()
    mountSceneInstanceImpl(
      world: world
      uiSystems: uiSystems
      mountEntity: rowRoot
      scene: scene
      overrides: overrides
      pageId: listViewRowPage(rowRoot: rowRoot)
      keepRootPlacement: true
    )
  } else {
    # No sub-scene: one bare child per distinct binding node id (skeleton row).
    let distinct: List(String) = listViewDistinctNodeIds(lv: lv)
    var k: Int = 0
    loop k < distinct.length {
      let child: EntityId = createEntity(world: world)
      setParent(
        parents: uiSystems.hierarchy.parents
        childrens: world.childrens
        child: child
        parent: rowRoot
      )
      k = k + 1
    }
  }
  let r: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: size.x, y: size.y } }
  componentSet(this: world.rects, entity: rowRoot, data: r)
  ret rowRoot
}

# One flow-mode ListView: reconcile its child rows to the data rows by key.
func listViewSyncFlow(
  world: mod UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  scenes: view SceneRegistry
) {
  unsafe {
    let lv: ListView = componentGet(this: world.listViews, entity: entity)
    var count: Int = 0
    if componentHas(this: world.listViewDatas, entity: entity) {
      count = componentGet(this: world.listViewDatas, entity: entity).rows.length
    }
    # Snapshot the current rows (children carrying a ListViewRowKey).
    let existing: List(EntityId) = List.create(EntityId, cap: count + 4)
    if componentHas(this: world.childrens, entity: entity) {
      let ch: view Children => componentView(this: world.childrens, entity: entity)
      var i: Int = 0
      loop i < ch.ids.length {
        let child: EntityId = rae_ext_rae_buf_get(buf: ch.ids.data, index: i)
        if componentHas(this: world.listViewRowKeys, entity: child) {
          existing.add(value: child)
        }
        i = i + 1
      }
    }
    let reused: List(Bool) = List.create(Bool, cap: existing.length)
    loop let unused: view EntityId in existing {
      reused.add(value: false)
    }
    let size: Vec2 = listViewFlowRowSize(
      world: world
      uiSystems: uiSystems
      listEntity: entity
      lv: lv
    )
    let ordered: List(EntityId) = List.create(EntityId, cap: count)
    let distinct: List(String) = listViewDistinctNodeIds(lv: lv)
    var d: Int = 0
    loop d < count {
      let data: ListViewData = componentGet(this: world.listViewDatas, entity: entity)
      let row: ListViewRow = rae_ext_rae_buf_get(buf: data.rows.data, index: d)
      let key: String = listViewRowKeyOf(lv: lv, row: row, index: d)
      let sceneId: String = listViewRowSceneId(lv: lv, row: row)
      # Reuse the row entity built for this key + scene, if it is still here.
      var rowRoot: EntityId = noEntity()
      var e: Int = 0
      loop e < existing.length and isNone(this: rowRoot) {
        if reused.copyAtFallback(index: e, fallback: true) is false {
          let candidate: EntityId = rae_ext_rae_buf_get(buf: existing.data, index: e)
          let identity: ListViewRowKey = componentGet(
            this: world.listViewRowKeys
            entity: candidate
          )
          if identity.key is key and identity.sceneId is sceneId {
            rowRoot = candidate
            reused.set(index: e, value: true)
          }
        }
        e = e + 1
      }
      if isNone(this: rowRoot) {
        rowRoot = listViewBuildFlowRow(
          world: world
          uiSystems: uiSystems
          lv: lv
          sceneId: sceneId
          key: key
          size: size
          scenes: scenes
        )
        setParent(
          parents: uiSystems.hierarchy.parents
          childrens: world.childrens
          child: rowRoot
          parent: entity
        )
      } else if componentHas(this: world.rects, entity: rowRoot) {
        # The container may have been resized since the row was built.
        let cur: Rect = componentGet(this: world.rects, entity: rowRoot)
        if cur.size.x is not size.x or cur.size.y is not size.y {
          let r: Rect = { position: cur.position, size: { x: size.x, y: size.y } }
          componentSet(this: world.rects, entity: rowRoot, data: r)
        }
      }
      ordered.add(value: rowRoot)
      let sceneRow: Bool = sceneId.length() > 0 and sceneRegistryHas(reg: scenes, key: sceneId)
      listViewApplyFlowRow(
        world: world
        rowRoot: rowRoot
        lv: lv
        distinct: distinct
        row: row
        sceneRow: sceneRow
      )
      d = d + 1
    }
    # Destroy the rows whose key went away.
    var e2: Int = 0
    loop e2 < existing.length {
      if reused.copyAtFallback(index: e2, fallback: true) is false {
        let victim: EntityId = rae_ext_rae_buf_get(buf: existing.data, index: e2)
        destroyEntitySubtree(world: world, uiSystems: uiSystems, root: victim)
      }
      e2 = e2 + 1
    }
    # Children order = data order (any non-row children keep their place
    # ahead of the rows). Compare through a `view` first and take the `mod`
    # borrow only when the order actually changed: componentMod bumps the
    # Children generation eagerly, so an unconditional borrow would re-dirty
    # layout every frame even when nothing moved (an idle busy-loop).
    if componentHas(this: world.childrens, entity: entity) {
      let currentIds: List(EntityId) = List.create(EntityId, cap: 8)
      let kept: List(EntityId) = List.create(EntityId, cap: 8)
      let chv: view Children => componentView(this: world.childrens, entity: entity)
      var i: Int = 0
      loop i < chv.ids.length {
        let child: EntityId = rae_ext_rae_buf_get(buf: chv.ids.data, index: i)
        currentIds.add(value: child)
        if componentHas(this: world.listViewRowKeys, entity: child) is false {
          kept.add(value: child)
        }
        i = i + 1
      }
      loop let rowRoot: view EntityId in ordered {
        kept.add(value: rowRoot)
      }
      var same: Bool = kept.length is currentIds.length
      if same {
        var k: Int = 0
        loop k < kept.length {
          let a: EntityId = rae_ext_rae_buf_get(buf: kept.data, index: k)
          let b: EntityId = rae_ext_rae_buf_get(buf: currentIds.data, index: k)
          if a is not b {
            same = false
          }
          k = k + 1
        }
      }
      if same is false {
        let ch: mod Children => componentMod(this: world.childrens, entity: entity)
        ch.ids = kept
      }
    }
  }
}

# Apply a flow row's bindings (no positioning: the container's Layout does that).
func listViewApplyFlowRow(
  world: mod UiWorld
  rowRoot: view EntityId
  lv: view ListView
  distinct: view List(String)
  row: view ListViewRow
  sceneRow: view Bool
) {
  unsafe {
    let bn: Int = lv.bindings.length
    if sceneRow {
      var sb: Int = 0
      loop sb < bn {
        let binding: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: sb)
        listViewApplySceneBinding(
          world: world
          rowRoot: rowRoot
          binding: binding
          row: row
        )
        sb = sb + 1
      }
      ret
    }
    let kids: List(EntityId) = List.create(EntityId, cap: distinct.length)
    if componentHas(this: world.childrens, entity: rowRoot) {
      let ch: view Children => componentView(this: world.childrens, entity: rowRoot)
      var i: Int = 0
      loop i < ch.ids.length {
        kids.add(value: rae_ext_rae_buf_get(buf: ch.ids.data, index: i))
        i = i + 1
      }
    }
    var b: Int = 0
    loop b < bn {
      let binding: ListViewBinding = rae_ext_rae_buf_get(buf: lv.bindings.data, index: b)
      let slot: Int = listViewNodeSlot(distinct: distinct, nodeId: binding.nodeId)
      if slot >= 0 and slot < kids.length {
        let child: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: slot)
        listViewApplyBinding(
          world: world
          child: child
          binding: binding
          row: row
        )
      }
      b = b + 1
    }
  }
}

# Virtualise every ListView in the world (#945). Run after input/scroll,
# before layout, so the current window's rows are laid out this frame.
# `scenes` supplies the item sub-scenes (`ListView.itemSceneId`); pass an empty
# registry for bindings-only rows.
func listViewSystem(world: mod UiWorld, uiSystems: view UiSystems, scenes: view SceneRegistry) pub {
  unsafe {
    let n: Int = componentCount(this: world.listViews)
    # Collect entity ids first: syncing mutates childrens/entities, which must
    # not alias the listViews table iteration.
    let entities: List(EntityId) = List.create(EntityId, cap: n)
    var i: Int = 0
    loop i < n {
      entities.add(value: componentEntityAt(this: world.listViews, i: i))
      i = i + 1
    }
    var e: Int = 0
    loop e < entities.length {
      let entity: EntityId = rae_ext_rae_buf_get(buf: entities.data, index: e)
      let lv: ListView = componentGet(this: world.listViews, entity: entity)
      if lv.mode is ListViewMode.flow {
        listViewSyncFlow(
          world: world
          uiSystems: uiSystems
          entity: entity
          scenes: scenes
        )
      } else {
        listViewSyncEntity(
          world: world
          uiSystems: uiSystems
          entity: entity
          scenes: scenes
        )
      }
      e = e + 1
    }
  }
}
