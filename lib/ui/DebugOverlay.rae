# A shared debug overlay: the amber button, readouts and dialog from example
# 106, in a form any app can add in three lines.
#
#     var dbg: DebugOverlay = createDebugOverlay(button: true, fps: true,
#                                                memory: true, heartbeat: true)
#     ...
#     let dbgTook: Bool = updateDebugOverlay(debugOverlay: dbg, screenW: w, screenH: h,
#                                            now: now, didRealWork: rendered)
#     ...
#     drawDebugOverlay(debugOverlay: dbg, font: font)         # LAST, so it is on top
#
# WHY TWO CALLS AND NOT ONE. The overlay has to read the pointer BEFORE the app
# hit-tests its own UI, or a click on the debug button also hits whatever is
# underneath — in 110 and 113 the top right corner is inside the side panel. It
# has to DRAW after everything else, or the 3D scene paints over it. Those are
# opposite ends of a frame, so they are two calls. `updateDebugOverlay` returns
# true when it took the pointer, and the app skips its own hit test that frame.
#
# IMMEDIATE MODE, NOT ECS. Example 106 builds its debug UI out of ECS entities,
# which works there because it owns its layer order. A shared overlay cannot
# assume anything about the host's z-order — 110 and 113 draw a 3D scene, then a
# UI world, then a log overlay — so this draws itself straight to gpu2d after
# all of that. Drawn last is topmost, with nothing to configure.
#
# The amber is 106's: it reads as instrumentation rather than as part of the app.
import Sys
import Gpu2d
import Gpu2dText
import SdfText

# 0xAARRGGBB.
const debugAmber: Int = 0xFFFFBF00
const debugPanelFill: Int = 0xF0181820
const debugPanelBorder: Int = 0x60FFBF00
const debugBackdrop: Int = 0xA0000000
const debugOnFill: Int = 0xFF34C759
const debugOffFill: Int = 0xC0787880
# The letter on the amber disc.
const debugInk: Int = 0xFF101014

# Text is measured rather than laid out: the SDF font here has no width query, so
# widths come from the same 0.52-of-size-per-character estimate example 106 uses
# for its right-aligned readouts. Good enough to right-align a short number, and
# the alternative is threading a metrics API through for two labels.
const debugGlyphWidthRatio: Float = 0.52

type DebugOverlay {
  # What the app opted into. The dialog toggles these same fields, so what it
  # shows is the live state rather than a second copy of it.
  wantButton: Bool
  wantFps: Bool
  wantMemory: Bool
  wantHeartbeat: Bool

  open: Bool

  screenW: Float
  screenH: Float
  buttonSize: Float
  margin: Float

  # Absolute epoch stamps, and Float64 DELIBERATELY: in f32 at epoch magnitude
  # two consecutive frames round to the same value (~128 s apart), the window
  # spans zero and the readout sits at 0 fps forever.
  frameTimes: List(Float64)
  fpsWindowSec: Float
  lastFps: Float

  lastRssKb: Int
  # Resident size is a syscall; sampling it every frame to move a label that
  # changes by kilobytes is waste in a loop built to idle at ~0% CPU.
  rssSampledAt: Float64

  heartbeatX: Float

  # Opt-in custom readout: an app sets this each frame (setDebugOverlayLine) and it is
  # drawn in yellow under the fps/mem lines. Empty = nothing drawn. Generic — any app can
  # surface a live debug string (a countdown, a state name, a value) here.
  customLine: String
}

func createDebugOverlay(button: view Bool, fps: view Bool, memory: view Bool,
                        heartbeat: view Bool) ret DebugOverlay {
  ret DebugOverlay {
    wantButton: button
    wantFps: fps
    wantMemory: memory
    wantHeartbeat: heartbeat
    open: false
    screenW: 0.0
    screenH: 0.0
    buttonSize: 20.0
    margin: 12.0
    customLine: ""
    frameTimes: createList(Float64, cap: 256)
    fpsWindowSec: 2.0
    lastFps: 0.0
    lastRssKb: 0
    rssSampledAt: 0.0
    heartbeatX: 0.0
  }
}

func debugTextWidth(text: view String, sizePx: view Float) ret Float {
  ret text.length().toFloat() * sizePx * debugGlyphWidthRatio
}

func debugButtonX(debugOverlay: view DebugOverlay) ret Float {
  ret debugOverlay.screenW - debugOverlay.buttonSize - debugOverlay.margin
}

func debugPointInRect(px: view Float, py: view Float, x: view Float, y: view Float,
                      w: view Float, h: view Float) ret Bool {
  if px < x or px > x + w {
    ret false
  }
  if py < y or py > y + h {
    ret false
  }
  ret true
}

# ----- sampling -------------------------------------------------------

func debugPruneFrames(debugOverlay: mod DebugOverlay, now: view Float64) {
  let times: mod List(Float64) => debugOverlay.frameTimes
  loop times.length > 1 {
    let cutoff: Float = (now - times.copyAt(index: 0)) as Float
    if cutoff <= debugOverlay.fpsWindowSec {
      ret
    }
    times.remove(index: 0)
  }
}

# Frames per second over a moving window rather than 1/dt: a single slow frame
# should not make the readout jump, and the number is there to show a trend.
func debugRecordFrame(debugOverlay: mod DebugOverlay, now: view Float64, didRealWork: view Bool) {
  if didRealWork {
    let times: mod List(Float64) => debugOverlay.frameTimes
    times.add(value: now)
    debugPruneFrames(debugOverlay: debugOverlay, now: now)
  }
  let n: Int = debugOverlay.frameTimes.length
  var fps: Float = 0.0
  if n > 1 {
    let span: Float = (debugOverlay.frameTimes.copyAt(index: n - 1) - debugOverlay.frameTimes.copyAt(index: 0)) as Float
    if span > 0.0 {
      fps = (n - 1).toFloat() / span
    }
  }
  debugOverlay.lastFps = fps
  if (now - debugOverlay.rssSampledAt) as Float >= 0.5 {
    debugOverlay.lastRssKb = processRssKb()
    debugOverlay.rssSampledAt = now
  }
}

func debugOverlayFps(debugOverlay: view DebugOverlay) ret Float {
  ret debugOverlay.lastFps
}

func memKb(debugOverlay: view DebugOverlay) ret Int {
  ret debugOverlay.lastRssKb
}

# Set the yellow custom readout drawn under fps/mem (empty String clears it). An app calls
# this each frame to surface a live debug value (a countdown, a mode name, a number).
func setDebugOverlayLine(debugOverlay: mod DebugOverlay, text: own String) {
  debugOverlay.customLine = text
}

# ----- input ----------------------------------------------------------

# Returns true when the overlay took the pointer, so the caller can skip its own
# hit test for this frame.
func updateDebugOverlay(debugOverlay: mod DebugOverlay, screenW: view Float, screenH: view Float,
                        now: view Float64, didRealWork: view Bool) ret Bool {
  debugOverlay.screenW = screenW
  debugOverlay.screenH = screenH
  debugRecordFrame(debugOverlay: debugOverlay, now: now, didRealWork: didRealWork)

  if Gpu2d.pointerPressed() is false {
    ret false
  }
  if debugOverlay.wantButton is false {
    ret false
  }

  let px: Float = Gpu2d.pointerX()
  let py: Float = Gpu2d.pointerY()
  if debugPointInRect(px: px, py: py, x: debugButtonX(debugOverlay: debugOverlay), y: debugOverlay.margin,
                      w: debugOverlay.buttonSize, h: debugOverlay.buttonSize) {
    debugOverlay.open = debugOverlay.open is false
    ret true
  }
  if debugOverlay.open is false {
    ret false
  }
  ret debugDialogPress(debugOverlay: debugOverlay, px: px, py: py)
}

# The dialog is a fixed stack of rows, so hit testing is the same arithmetic the
# drawing uses. Both derive from `debugDialogRowY` rather than repeating it.
const debugDialogW: Float = 260.0
const debugDialogRowH: Float = 38.0
const debugDialogTitleH: Float = 44.0
const debugDialogRows: Int = 3

func debugDialogX(debugOverlay: view DebugOverlay) ret Float {
  ret debugOverlay.screenW - debugDialogW - debugOverlay.margin
}

func debugDialogY(debugOverlay: view DebugOverlay) ret Float {
  ret debugOverlay.margin + debugOverlay.buttonSize + 8.0
}

func debugDialogH() ret Float {
  ret debugDialogTitleH + debugDialogRowH * debugDialogRows.toFloat() + 12.0
}

func debugDialogRowY(debugOverlay: view DebugOverlay, index: view Int) ret Float {
  ret debugDialogY(debugOverlay: debugOverlay) + debugDialogTitleH + index.toFloat() * debugDialogRowH
}

func debugDialogPress(debugOverlay: mod DebugOverlay, px: view Float, py: view Float) ret Bool {
  let x: Float = debugDialogX(debugOverlay: debugOverlay)
  if debugPointInRect(px: px, py: py, x: x, y: debugDialogY(debugOverlay: debugOverlay),
                      w: debugDialogW, h: debugDialogH()) is false {
    # A press anywhere else closes it, which is what a transient debug panel
    # should do — and it still counts as taken, or the same click would also
    # reach the app underneath.
    debugOverlay.open = false
    ret true
  }
  if debugPointInRect(px: px, py: py, x: x, y: debugDialogRowY(debugOverlay: debugOverlay, index: 0),
                      w: debugDialogW, h: debugDialogRowH) {
    debugOverlay.wantFps = debugOverlay.wantFps is false
    ret true
  }
  if debugPointInRect(px: px, py: py, x: x, y: debugDialogRowY(debugOverlay: debugOverlay, index: 1),
                      w: debugDialogW, h: debugDialogRowH) {
    debugOverlay.wantMemory = debugOverlay.wantMemory is false
    ret true
  }
  if debugPointInRect(px: px, py: py, x: x, y: debugDialogRowY(debugOverlay: debugOverlay, index: 2),
                      w: debugDialogW, h: debugDialogRowH) {
    debugOverlay.wantHeartbeat = debugOverlay.wantHeartbeat is false
    ret true
  }
  ret true
}

# ----- formatting -----------------------------------------------------

func formatDebugFps(fps: view Float) ret String {
  var rounded: Int = (fps + 0.5).toInt()
  if rounded < 0 {
    rounded = 0
  }
  ret "fps: {rounded}"
}

# One decimal, computed in integers: megabytes to one place is the resolution
# that makes a leak visible without the number twitching every frame.
func formatDebugMem(kb: view Int) ret String {
  let tenths: Int = (kb * 10 + 512) / 1024
  let whole: Int = tenths / 10
  let frac: Int = tenths - whole * 10
  ret "mem: {whole}.{frac} MB"
}

# ----- drawing --------------------------------------------------------

func drawDebugToggleRow(debugOverlay: view DebugOverlay, font: view SdfFont, index: view Int,
                        label: view String, on: view Bool) {
  let x: Float = debugDialogX(debugOverlay: debugOverlay)
  let y: Float = debugDialogRowY(debugOverlay: debugOverlay, index: index)
  Gpu2dText.drawText(font: font, text: label, x: x + 16.0, y: y + 24.0,
                      sizePx: 14.0, color: debugAmber)
  var fill: Int = debugOffFill
  if on {
    fill = debugOnFill
  }
  let pillW: Float = 38.0
  let pillH: Float = 20.0
  let pillX: Float = x + debugDialogW - pillW - 16.0
  let pillY: Float = y + (debugDialogRowH - pillH) * 0.5
  Gpu2d.drawBox(x: pillX, y: pillY, w: pillW, h: pillH, radius: pillH * 0.5,
                fill: fill, borderWidth: 0.0, border: 0x00000000)
  var knobX: Float = pillX + 2.0
  if on {
    knobX = pillX + pillW - pillH + 2.0
  }
  Gpu2d.drawBox(x: knobX, y: pillY + 2.0, w: pillH - 4.0, h: pillH - 4.0,
                radius: (pillH - 4.0) * 0.5, fill: 0xFFFFFFFF,
                borderWidth: 0.0, border: 0x00000000)
}

func drawDebugDialog(debugOverlay: view DebugOverlay, font: view SdfFont) {
  let x: Float = debugDialogX(debugOverlay: debugOverlay)
  let y: Float = debugDialogY(debugOverlay: debugOverlay)
  Gpu2d.drawBox(x: x, y: y, w: debugDialogW, h: debugDialogH(), radius: 10.0,
                fill: debugPanelFill, borderWidth: 1.0, border: debugPanelBorder)
  Gpu2dText.drawText(font: font, text: "Debug", x: x + 16.0, y: y + 28.0,
                      sizePx: 16.0, color: debugAmber)
  drawDebugToggleRow(debugOverlay: debugOverlay, font: font, index: 0, label: "FPS", on: debugOverlay.wantFps)
  drawDebugToggleRow(debugOverlay: debugOverlay, font: font, index: 1, label: "Memory", on: debugOverlay.wantMemory)
  drawDebugToggleRow(debugOverlay: debugOverlay, font: font, index: 2, label: "Update indicator",
                     on: debugOverlay.wantHeartbeat)
}

# A square that steps across the top of the screen once per frame that did real
# work. It is the cheapest possible answer to "is this thing repainting when it
# should not be" — a still square means an idle app, a moving one means work.
func drawDebugHeartbeat(debugOverlay: mod DebugOverlay, didRealWork: view Bool) {
  if didRealWork {
    debugOverlay.heartbeatX = debugOverlay.heartbeatX + 2.0
    if debugOverlay.heartbeatX > debugOverlay.screenW {
      debugOverlay.heartbeatX = 0.0 - 8.0
    }
  }
  Gpu2d.drawBox(x: debugOverlay.heartbeatX, y: 0.0, w: 8.0, h: 8.0, radius: 0.0,
                fill: debugAmber, borderWidth: 0.0, border: 0x00000000)
}

# Example 106's mark: a FILLED amber disc with a black D. Solid amber carries
# the "instrumentation, not part of the app" reading on its own, where an
# outlined button competed with whatever it happened to sit over.
func drawDebugButton(debugOverlay: view DebugOverlay, font: view SdfFont) {
  let x: Float = debugButtonX(debugOverlay: debugOverlay)
  # Open INVERTS rather than recolours: the same two colours, so the state is
  # unmistakable without introducing a third.
  var disc: Int = debugAmber
  var glyph: Int = debugInk
  if debugOverlay.open {
    disc = debugInk
    glyph = debugAmber
  }
  Gpu2d.drawBox(x: x, y: debugOverlay.margin, w: debugOverlay.buttonSize, h: debugOverlay.buttonSize,
                radius: debugOverlay.buttonSize * 0.5, fill: disc,
                borderWidth: 0.0, border: 0x00000000)
  let glyphSize: Float = debugOverlay.buttonSize * 0.66
  let glyphW: Float = debugTextWidth(text: "D", sizePx: glyphSize)
  # drawText places the PEN, and the glyph starts a little to the right of it.
  # Centring on the pen alone leaves the letter visibly off-centre on a disc this
  # small — measured at 10px of gap on the left against 5px on the right.
  let bearing: Float = glyphSize * 0.09
  let gx: Float = x + (debugOverlay.buttonSize - glyphW) * 0.5 - bearing
  let gy: Float = debugOverlay.margin + debugOverlay.buttonSize * 0.5 + glyphSize * 0.36
  Gpu2dText.drawText(font: font, text: "D", x: gx, y: gy,
                      sizePx: glyphSize, color: glyph)
}

func drawDebugReadouts(debugOverlay: view DebugOverlay, font: view SdfFont) {
  let fontSize: Float = 14.0
  let lineH: Float = 18.0
  let rightEdge: Float = debugButtonX(debugOverlay: debugOverlay) + debugOverlay.buttonSize
  var y: Float = debugOverlay.margin + debugOverlay.buttonSize + 8.0 + fontSize
  if debugOverlay.open {
    # The dialog occupies that space; put the readouts under it rather than
    # behind it.
    y = debugDialogY(debugOverlay: debugOverlay) + debugDialogH() + 8.0 + fontSize
  }
  if debugOverlay.wantFps {
    let text: String = formatDebugFps(fps: debugOverlay.lastFps)
    Gpu2dText.drawText(font: font, text: text,
                        x: rightEdge - debugTextWidth(text: text, sizePx: fontSize),
                        y: y, sizePx: fontSize, color: debugAmber)
    y = y + lineH
  }
  if debugOverlay.wantMemory {
    let text: String = formatDebugMem(kb: debugOverlay.lastRssKb)
    Gpu2dText.drawText(font: font, text: text,
                        x: rightEdge - debugTextWidth(text: text, sizePx: fontSize),
                        y: y, sizePx: fontSize, color: debugAmber)
    y = y + lineH
  }
  # Opt-in custom line under the fps/mem readouts — same amber as the rest.
  if debugOverlay.customLine.length() > 0 {
    Gpu2dText.drawText(font: font, text: debugOverlay.customLine,
                        x: rightEdge - debugTextWidth(text: debugOverlay.customLine, sizePx: fontSize),
                        y: y, sizePx: fontSize, color: debugAmber)
  }
}

# Call LAST in the frame. Everything here paints straight to gpu2d, so whatever
# is drawn after it wins — which is the whole reason this is not an ECS layer.
func drawDebugOverlay(debugOverlay: mod DebugOverlay, font: view SdfFont,
                      didRealWork: view Bool) {
  if debugOverlay.wantHeartbeat {
    drawDebugHeartbeat(debugOverlay: debugOverlay, didRealWork: didRealWork)
  }
  if debugOverlay.wantButton {
    drawDebugButton(debugOverlay: debugOverlay, font: font)
  }
  drawDebugReadouts(debugOverlay: debugOverlay, font: font)
  if debugOverlay.open {
    drawDebugDialog(debugOverlay: debugOverlay, font: font)
  }
}
