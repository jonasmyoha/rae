# A shared debug overlay: the amber button, readouts and dialog from example
# 106, in a form any app can add in three lines.
#
#     var dbg: DebugOverlay = createDebugOverlay(button: true, fps: true,
#                                                memory: true, heartbeat: false)
#     ...
#     let dbgTook: Bool = updateDebugOverlay(debugOverlay: dbg, screenW: w, screenH: h,
#                                            now: now, didRealWork: rendered)
#     ...
#     drawDebugOverlay(debugOverlay: dbg, font: font)         # LAST, so it is on top
#
# WHY TWO CALLS AND NOT ONE. The overlay has to read the pointer BEFORE the app
# hit-tests its own UI, or a click on the debug button also hits whatever is
# underneath — in 110 and 113 the top right corner is inside the side panel. It
# has to DRAW after everything else, or the 3D scene paints over it. Those are
# opposite ends of a frame, so they are two calls. `updateDebugOverlay` returns
# true when it took the pointer, and the app skips its own hit test that frame.
#
# ONE WIDGET FOR EVERY APP. The UI apps (106, 121) and the 3D examples all use
# this widget. It holds debug readouts only: an app's own settings belong in
# the app's own UI.
#
# IMMEDIATE MODE, NOT ECS. A shared overlay cannot assume anything about the
# host's z-order — 110 and 113 draw a 3D scene, then a UI world, then a log
# overlay — so this draws itself straight to gpu2d after all of that. Drawn
# last is topmost, with nothing to configure.
#
# The amber is 106's: it reads as instrumentation rather than as part of the app.
#
# SIZE. The sizes are points (design units), the unit of every Rae UI; a user
# zoom (ui/UiZoom) makes them bigger with the rest of the UI.
#
# PLACEMENT. The button sits in the window's top-right corner, or where the app
# puts it (placeDebugOverlay). A UI app whose scene marks a slot with a
# `DebugAnchor` node lets ui/DebugPlacement put it there each frame. The dialog
# and the readouts open toward the middle of the window and are kept inside it,
# `margin` in from its edges, wherever the button is. Under a top bar the
# readouts can go in one line beside the button, level with it
# (setDebugOverlayReadoutsBeside), so they stay inside the bar instead of
# covering the screen's first row.
#
# PERFORMANCE. The dialog's "Performance" row opens the perf HUD (ui/PerfHud, ui/PerfHudDraw)
# where the readouts were: its first row is the same fps and memory, then frame times, threads,
# audio, memory and a save button. An app that has a Profiler passes it once a frame after
# Profile.tick (debugOverlayPerf), which gives the HUD its threads, audio and saving.
# `RAE_PERF_HUD=1` opens it at launch.
import Math
import Sys
import Gpu2d
import Gpu2dText
import SdfText
open Gpu2dCanvas
open gpu/FramePacer
open ui/PerfHud
open ui/PerfHudDraw

# 0xAARRGGBB.
const debugAmber: Int = 0xFFFFBF00

const debugPanelFill: Int = 0xF0181820

const debugPanelBorder: Int = 0x60FFBF00

const debugBackdrop: Int = 0xA0000000

const debugOnFill: Int = 0xFF34C759

const debugOffFill: Int = 0xC0787880

# The button's size and its margin from the window's edges, in points
const debugButtonPoints: Float = 20.0

const debugMarginPoints: Float = 12.0

# The letter on the amber disc.
const debugInk: Int = 0xFF101014

# The "D" on the button is centered with a 0.52-of-size width estimate (its
# bearing is tuned against it); the readouts are measured with the font.
const debugGlyphWidthRatio: Float = 0.52

type DebugOverlay {
  # What the app opted into. The dialog toggles these same fields, so what it
  # shows is the live state rather than a second copy of it.
  wantButton: Bool
  wantFps: Bool
  wantMemory: Bool
  wantHeartbeat: Bool
  open: Bool
  screenW: Float
  screenH: Float
  buttonSize: Float
  margin: Float
  # The readouts in one line beside the button, level with it, instead of
  # stacked under it (setDebugOverlayReadoutsBeside)
  readoutsBeside: Bool
  # Where the button's top-right corner sits, when the app places it (an app
  # whose own chrome holds that corner puts the widget under it): 0 = the
  # window's top-right corner, `margin` in from each edge
  anchorRight: Float
  anchorTop: Float

  # Absolute epoch stamps, and Float64 DELIBERATELY: in f32 at epoch magnitude
  # two consecutive frames round to the same value (~128 s apart), the window
  # spans zero and the readout sits at 0 fps forever.
  frameTimes: List(Float64)
  fpsWindowSeconds: Float
  lastFps: Float
  lastRssKb: Int
  # Resident size is a syscall; sampling it every frame to move a label that
  # changes by kilobytes is waste in a loop built to idle at ~0% CPU.
  rssSampledAt: Float64
  heartbeatX: Float

  # Opt-in custom readout: an app sets this each frame (setDebugOverlayLine) and it is
  # drawn in yellow under the fps/mem lines. Empty = nothing drawn. Generic — any app can
  # surface a live debug string (a countdown, a state name, a value) here.
  customLine: String
  # the perf HUD the dialog's "Performance" row opens
  perfHud: PerfHud
}

# `heartbeat` is the "Update indicator": a square that steps across the top of
# the window on every frame that did real work. Turn it on only for an app
# that idles when nothing changes (a UI app, such as the UI editor), where a
# moving square means a repaint that should not have happened. An app that
# renders every frame (a game, a 3D scene) leaves it off: the square would
# just move all the time. It can still be switched on in the widget's dialog.
#
# `RAE_DEBUG_OVERLAY=0` in the environment creates the widget with everything
# off, whatever the app asked for — a clean frame for screenshots and
# references without a per-app flag. Any other value (or unset) is the app's
# own choice.
func createDebugOverlay(
  button: view Bool
  fps: view Bool
  memory: view Bool
  heartbeat: view Bool
) ret DebugOverlay {
  let hidden: Bool = Sys.getEnv(name: "RAE_DEBUG_OVERLAY") is "0"
  ret DebugOverlay {
    wantButton: button and not hidden
    wantFps: fps and not hidden
    wantMemory: memory and not hidden
    wantHeartbeat: heartbeat and not hidden
    open: false
    screenW: 0.0
    screenH: 0.0
    buttonSize: debugButtonPoints
    margin: debugMarginPoints
    readoutsBeside: false
    anchorRight: 0.0
    anchorTop: 0.0
    customLine: ""
    frameTimes: List.create(Float64, cap: 256)
    fpsWindowSeconds: 2.0
    lastFps: 0.0
    lastRssKb: 0
    rssSampledAt: 0.0
    heartbeatX: 0.0
    perfHud: perfHudOpenedBy(open: Sys.getEnv(name: "RAE_PERF_HUD") is "1" and not hidden)
  }
}

func perfHudOpenedBy(open: view Bool) ret PerfHud {
  var perfHud: PerfHud = createPerfHud()
  setPerfHudOpen(perfHud: perfHud, open: open)
  ret perfHud
}

# The app's profiler for the perf HUD, once a frame after Profile.tick: while the HUD is open it
# reads the profiler's capture (starting a rolling one of the last 10 s) for its threads, the
# audio block's share and its save button; closed, it ends the capture it started
func debugOverlayPerf(debugOverlay: mod DebugOverlay, profiler: mod Profiler) {
  perfHudStep(perfHud: debugOverlay.perfHud, profiler: profiler)
}

# The perf HUD is open: its graph moves with time, so an app that idles when nothing changes
# keeps drawing frames while it is (feed this into the loop's "animating" flag)
func debugOverlayAnimating(debugOverlay: view DebugOverlay) ret Bool {
  ret debugOverlay.perfHud.open
}

func debugTextWidth(text: view String, sizePx: view Float) ret Float {
  ret text.length().toFloat() * sizePx * debugGlyphWidthRatio
}

# Draw the readouts in one line beside the button, level with it ("60 fps
# 177 MB"): toward the middle of the window, so a button in a top bar keeps
# them inside the bar. False (the default) stacks them under the button.
func setDebugOverlayReadoutsBeside(debugOverlay: mod DebugOverlay, beside: view Bool) {
  debugOverlay.readoutsBeside = beside
}

# `x` moved so that `width` from it stays inside the window, `margin` in from
# both edges (a box wider than that starts at the left margin). Before the
# first update the window's width is unknown and `x` is kept.
func debugClampX(debugOverlay: view DebugOverlay, x: view Float, width: view Float) ret Float {
  if debugOverlay.screenW <= 0.0 {
    ret x
  }
  var clamped: Float = x
  let highest: Float = debugOverlay.screenW - debugOverlay.margin - width
  if clamped > highest {
    clamped = highest
  }
  if clamped < debugOverlay.margin {
    clamped = debugOverlay.margin
  }
  ret clamped
}

# The right edge and the top of the widget: the app's anchor, else the
# window's top-right corner.
func debugRight(debugOverlay: view DebugOverlay) ret Float {
  if debugOverlay.anchorRight > 0.0 {
    ret debugOverlay.anchorRight
  }
  ret debugOverlay.screenW - debugOverlay.margin
}

func debugTop(debugOverlay: view DebugOverlay) ret Float {
  if debugOverlay.anchorTop > 0.0 {
    ret debugOverlay.anchorTop
  }
  ret debugOverlay.margin
}

# Put the widget's top-right corner at (`right`, `top`) — under the app's own
# chrome, say; (0, 0) puts it back in the window's corner.
func placeDebugOverlay(debugOverlay: mod DebugOverlay, right: view Float, top: view Float) {
  debugOverlay.anchorRight = right
  debugOverlay.anchorTop = top
}

func debugButtonX(debugOverlay: view DebugOverlay) ret Float {
  ret debugRight(debugOverlay: debugOverlay) - debugOverlay.buttonSize
}

func debugPointInRect(
  px: view Float
  py: view Float
  x: view Float
  y: view Float
  w: view Float
  h: view Float
) ret Bool {
  if px < x or px > x + w {
    ret false
  }
  if py < y or py > y + h {
    ret false
  }
  ret true
}

# ----- sampling -------------------------------------------------------
func debugPruneFrames(debugOverlay: mod DebugOverlay, now: view Float64) {
  let times: mod List(Float64) = debugOverlay.frameTimes
  loop times.length > 1 {
    let cutoff: Float = (now - times.copyAt(index: 0)) as Float
    if cutoff <= debugOverlay.fpsWindowSeconds {
      ret
    }
    times.remove(index: 0)
  }
}

# Frames per second over a moving window rather than 1/dt, as the frame
# loop's steady rate: one over the MEDIAN frame interval in the window. A
# display-locked loop reads 60 (or 30), not 59 (or 29) because a few frames in
# the window were late, and a single slow frame does not make it jump.
func debugRecordFrame(debugOverlay: mod DebugOverlay, now: view Float64, didRealWork: view Bool) {
  if didRealWork {
    let times: mod List(Float64) = debugOverlay.frameTimes
    times.add(value: now)
    debugPruneFrames(debugOverlay: debugOverlay, now: now)
  }
  var fps: Float = 0.0
  let median: Float = debugMedianInterval(times: debugOverlay.frameTimes)
  if median > 0.0 {
    fps = 1.0 / median
  }
  debugOverlay.lastFps = fps
  if (now - debugOverlay.rssSampledAt) as Float >= 0.5 {
    debugOverlay.lastRssKb = processRssKb()
    debugOverlay.rssSampledAt = now
  }
}

func debugOverlayFps(debugOverlay: view DebugOverlay) ret Float {
  ret debugOverlay.lastFps
}

func memKb(debugOverlay: view DebugOverlay) ret Int {
  ret debugOverlay.lastRssKb
}

# Set the yellow custom readout drawn under fps/mem (empty String clears it). An app calls
# this each frame to surface a live debug value (a countdown, a mode name, a number).
func setDebugOverlayLine(debugOverlay: mod DebugOverlay, text: own String) {
  debugOverlay.customLine = text
}

# ----- input ----------------------------------------------------------

# Returns true when the overlay took the pointer, so the caller can skip its own
# hit test for this frame.
func updateDebugOverlay(
  debugOverlay: mod DebugOverlay
  screenW: view Float
  screenH: view Float
  now: view Float64
  didRealWork: view Bool
) ret Bool {
  debugOverlay.screenW = screenW
  debugOverlay.screenH = screenH
  debugRecordFrame(debugOverlay: debugOverlay, now: now, didRealWork: didRealWork)

  if Gpu2d.pointerPressed() is false {
    ret false
  }
  if debugOverlay.wantButton is false {
    ret false
  }

  let px: Float = Gpu2d.pointerX()
  let py: Float = Gpu2d.pointerY()
  if debugPointInRect(
    px: px
    py: py
    x: debugButtonX(debugOverlay: debugOverlay)
    y: debugTop(debugOverlay: debugOverlay)
    w: debugOverlay.buttonSize
    h: debugOverlay.buttonSize
  ) {
    debugOverlay.open = debugOverlay.open is false
    ret true
  }
  if debugOverlay.perfHud.perfHudPress(px: px, py: py) {
    ret true
  }
  if debugOverlay.open is false {
    ret false
  }
  ret debugDialogPress(debugOverlay: debugOverlay, px: px, py: py)
}

# The dialog is a fixed stack of rows, so hit
# testing is the same arithmetic the drawing uses. Both derive from
# `debugDialogRowY` rather than repeating it. Sizes are points times the scale.
const debugDialogW: Float = 260.0

const debugDialogRowH: Float = 38.0

const debugDialogTitleH: Float = 44.0

# The dialog's rows: FPS, Memory, Update indicator, Performance
const debugDialogRows: Int = 4

func debugDialogWidth(debugOverlay: view DebugOverlay) ret Float {
  ret debugDialogW
}

func debugDialogRowHeight(debugOverlay: view DebugOverlay) ret Float {
  ret debugDialogRowH
}

# Does the widget open to the right? A button in the left half of the window
# (an app placed it there) opens its dialog and readouts toward the middle,
# starting at its left edge; otherwise they end at its right edge.
func debugOpensRight(debugOverlay: view DebugOverlay) ret Bool {
  ret debugButtonX(debugOverlay: debugOverlay) + debugOverlay.buttonSize * 0.5 < debugOverlay.screenW * 0.5
}

# The dialog's left edge: at the button's left edge when the widget opens to
# the right, else ending at its right edge; kept inside the window
func debugDialogX(debugOverlay: view DebugOverlay) ret Float {
  let width: Float = debugDialogWidth(debugOverlay: debugOverlay)
  var x: Float = debugRight(debugOverlay: debugOverlay) - width
  if debugOpensRight(debugOverlay: debugOverlay) {
    x = debugButtonX(debugOverlay: debugOverlay)
  }
  ret debugClampX(debugOverlay: debugOverlay, x: x, width: width)
}

# The readouts' text size
func debugReadoutSize(debugOverlay: view DebugOverlay) ret Float {
  ret 14.0
}

# Where a readout line starts: at the button's left edge when the widget opens
# to the right, else right-aligned to its right edge, measured with `font`;
# kept inside the window
func debugReadoutX(
  debugOverlay: view DebugOverlay
  font: view SdfFont
  text: view String
  sizePx: view Float
) ret Float {
  let width: Float = Gpu2dText.measureText(font: font, text: text, sizePx: sizePx)
  var x: Float = debugButtonX(debugOverlay: debugOverlay) + debugOverlay.buttonSize - width
  if debugOpensRight(debugOverlay: debugOverlay) {
    x = debugButtonX(debugOverlay: debugOverlay)
  }
  ret debugClampX(debugOverlay: debugOverlay, x: x, width: width)
}

# The one-line readouts (setDebugOverlayReadoutsBeside): "60 fps 177 MB" and
# the app's custom line, those that are switched on; "" for none
func formatDebugBeside(debugOverlay: view DebugOverlay) ret String {
  var line: String = ""
  if debugOverlay.wantFps {
    line = "{displayFps(fps: debugOverlay.lastFps)} fps"
  }
  if debugOverlay.wantMemory {
    let megabytes: Int = (debugOverlay.lastRssKb + 512) / 1024
    if line.length() > 0 {
      line = "{line} "
    }
    line = "{line}{megabytes} MB"
  }
  if debugOverlay.customLine.length() > 0 {
    if line.length() > 0 {
      line = "{line} "
    }
    line = "{line}{debugOverlay.customLine}"
  }
  ret line
}

# Where the one-line readouts start: a gap from the button on the side toward
# the middle of the window (left of a button in the right half), kept inside
# the window
func debugBesideX(
  debugOverlay: view DebugOverlay
  font: view SdfFont
  text: view String
) ret Float {
  let width: Float = Gpu2dText.measureText(
    font: font
    text: text
    sizePx: debugReadoutSize(debugOverlay: debugOverlay)
  )
  let gap: Float = 8.0
  var x: Float = debugButtonX(debugOverlay: debugOverlay) - gap - width
  if debugOpensRight(debugOverlay: debugOverlay) {
    x = debugButtonX(debugOverlay: debugOverlay) + debugOverlay.buttonSize + gap
  }
  ret debugClampX(debugOverlay: debugOverlay, x: x, width: width)
}

# The one-line readouts' baseline: their text centered on the button's middle
func debugBesideBaseline(debugOverlay: view DebugOverlay) ret Float {
  ret debugTop(debugOverlay: debugOverlay) + debugOverlay.buttonSize * 0.5 + debugReadoutSize(
    debugOverlay: debugOverlay
  ) * 0.36
}

func debugDialogY(debugOverlay: view DebugOverlay) ret Float {
  ret debugTop(debugOverlay: debugOverlay) + debugOverlay.buttonSize + 8.0
}

func debugDialogH(debugOverlay: view DebugOverlay) ret Float {
  ret (debugDialogTitleH + 12.0) + debugDialogRowHeight(debugOverlay: debugOverlay) * debugDialogRows.toFloat()
}

func debugDialogRowY(debugOverlay: view DebugOverlay, index: view Int) ret Float {
  ret debugDialogY(debugOverlay: debugOverlay) + debugDialogTitleH + index.toFloat() * debugDialogRowHeight(
    debugOverlay: debugOverlay
  )
}

# Flip row `index`
func debugToggleRow(debugOverlay: mod DebugOverlay, index: view Int) {
  if index is 0 {
    debugOverlay.wantFps = debugOverlay.wantFps is false
  } else if index is 1 {
    debugOverlay.wantMemory = debugOverlay.wantMemory is false
  } else if index is 2 {
    debugOverlay.wantHeartbeat = debugOverlay.wantHeartbeat is false
  } else if index is 3 {
    setPerfHudOpen(perfHud: debugOverlay.perfHud, open: not debugOverlay.perfHud.open)
  }
}

func debugDialogPress(debugOverlay: mod DebugOverlay, px: view Float, py: view Float) ret Bool {
  let x: Float = debugDialogX(debugOverlay: debugOverlay)
  if debugPointInRect(
    px: px
    py: py
    x: x
    y: debugDialogY(debugOverlay: debugOverlay)
    w: debugDialogWidth(debugOverlay: debugOverlay)
    h: debugDialogH(debugOverlay: debugOverlay)
  ) is false {
    # A press anywhere else closes it, which is what a transient debug panel
    # should do — and it still counts as taken, or the same click would also
    # reach the app underneath.
    debugOverlay.open = false
    ret true
  }
  loop var index: Int = 0, index < debugDialogRows, ++index {
    if debugPointInRect(
      px: px
      py: py
      x: x
      y: debugDialogRowY(debugOverlay: debugOverlay, index: index)
      w: debugDialogWidth(debugOverlay: debugOverlay)
      h: debugDialogRowHeight(debugOverlay: debugOverlay)
    ) {
      debugToggleRow(debugOverlay: debugOverlay, index: index)
      ret true
    }
  }
  ret true
}

# The median of the intervals between `times` (seconds; 0 with fewer than two).
func debugMedianInterval(times: view List(Float64)) ret Float {
  if times.length < 2 {
    ret 0.0
  }
  var intervals: List(Float) = List.create(Float, cap: times.length - 1)
  loop var i: Int = 1, i < times.length, ++i {
    let interval: Float = (times.copyAt(index: i) - times.copyAt(index: i - 1)) as Float
    # Insertion keeps the list sorted (a window holds a few hundred at most)
    var at: Int = intervals.length
    loop at > 0 and intervals.copyAtFallback(index: at - 1, fallback: 0.0) > interval {
      at = at - 1
    }
    intervals.insert(index: at, value: interval)
  }
  let count: Int = intervals.length
  if count % 2 is 1 {
    ret intervals.copyAtFallback(index: count / 2, fallback: 0.0)
  }
  ret (intervals.copyAtFallback(index: count / 2 - 1, fallback: 0.0) + intervals.copyAtFallback(
    index: count / 2
    fallback: 0.0
  )) * 0.5
}

# ----- formatting -----------------------------------------------------
# The fps the readout shows: a value within 3% (and at least 1.5 fps) of a
# common display rate shows AS that rate. A display-paced app measures 59.4 or
# 29.8 from frame-timing jitter, and "59" all the time reads like a missed
# frame when nothing was missed; a real drop (55, 45) still shows as itself.
func displayFps(fps: view Float) ret Int {
  if fps <= 0.0 {
    ret 0
  }
  let rates: List(Int) = List(Int) {
    24
    30
    48
    60
    72
    90
    120
    144
    165
    240
  }
  loop let rate: Int in rates {
    var tolerance: Float = rate.toFloat() * 0.03
    if tolerance < 1.5 {
      tolerance = 1.5
    }
    let distance: Float = fps - rate.toFloat()
    if distance <= tolerance and distance >= -tolerance {
      ret rate
    }
  }
  ret (fps + 0.5).toInt()
}

func formatDebugFps(fps: view Float) ret String {
  ret "fps: {displayFps(fps: fps)}"
}

# One decimal, computed in integers: megabytes to one place is the resolution
# that makes a leak visible without the number twitching every frame.
func formatDebugMem(kb: view Int) ret String {
  let tenths: Int = (kb * 10 + 512) / 1024
  let whole: Int = tenths / 10
  let frac: Int = tenths - whole * 10
  ret "mem: {whole}.{frac} MB"
}

# ----- drawing --------------------------------------------------------
func drawDebugToggleRow(
  debugOverlay: view DebugOverlay
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  index: view Int
  label: view String
  on: view Bool
) {
  let x: Float = debugDialogX(debugOverlay: debugOverlay)
  let y: Float = debugDialogRowY(debugOverlay: debugOverlay, index: index)
  Gpu2dText.drawText(
    canvas: canvas
    font: font
    text: label
    x: x + 16.0
    y: y + 24.0
    sizePx: 14.0
    color: debugAmber
  )
  var fill: Int = debugOffFill
  if on {
    fill = debugOnFill
  }
  let pillW: Float = 38.0
  let pillH: Float = 20.0
  let inset: Float = 2.0
  let pillX: Float = x + debugDialogWidth(debugOverlay: debugOverlay) - pillW - 16.0
  let pillY: Float = y + (debugDialogRowHeight(debugOverlay: debugOverlay) - pillH) * 0.5
  Gpu2d.drawBox(
    canvas: canvas
    x: pillX
    y: pillY
    w: pillW
    h: pillH
    radius: pillH * 0.5
    fill: fill
    borderWidth: 0.0
    border: 0x00000000
  )
  var knobX: Float = pillX + inset
  if on {
    knobX = pillX + pillW - pillH + inset
  }
  Gpu2d.drawBox(
    canvas: canvas
    x: knobX
    y: pillY + inset
    w: pillH - inset * 2.0
    h: pillH - inset * 2.0
    radius: (pillH - inset * 2.0) * 0.5
    fill: 0xFFFFFFFF
    borderWidth: 0.0
    border: 0x00000000
  )
}

func drawDebugDialog(debugOverlay: view DebugOverlay, canvas: mod Gpu2dCanvas, font: view SdfFont) {
  let x: Float = debugDialogX(debugOverlay: debugOverlay)
  let y: Float = debugDialogY(debugOverlay: debugOverlay)
  Gpu2d.drawBox(
    canvas: canvas
    x: x
    y: y
    w: debugDialogWidth(debugOverlay: debugOverlay)
    h: debugDialogH(debugOverlay: debugOverlay)
    radius: 10.0
    fill: debugPanelFill
    borderWidth: 1.0
    border: debugPanelBorder
  )
  Gpu2dText.drawText(
    canvas: canvas
    font: font
    text: "Debug"
    x: x + 16.0
    y: y + 28.0
    sizePx: 16.0
    color: debugAmber
  )
  drawDebugToggleRow(
    debugOverlay: debugOverlay
    canvas: canvas
    font: font
    index: 0
    label: "FPS"
    on: debugOverlay.wantFps
  )
  drawDebugToggleRow(
    debugOverlay: debugOverlay
    canvas: canvas
    font: font
    index: 1
    label: "Memory"
    on: debugOverlay.wantMemory
  )
  drawDebugToggleRow(
    debugOverlay: debugOverlay
    canvas: canvas
    font: font
    index: 2
    label: "Update indicator"
    on: debugOverlay.wantHeartbeat
  )
  drawDebugToggleRow(
    debugOverlay: debugOverlay
    canvas: canvas
    font: font
    index: 3
    label: "Performance"
    on: debugOverlay.perfHud.open
  )
}

# A square that steps across the top of the screen once per frame that did real
# work. It is the cheapest possible answer to "is this thing repainting when it
# should not be" — a still square means an idle app, a moving one means work.
func drawDebugHeartbeat(
  debugOverlay: mod DebugOverlay
  canvas: mod Gpu2dCanvas
  didRealWork: view Bool
) {
  let size: Float = 8.0
  if didRealWork {
    debugOverlay.heartbeatX = debugOverlay.heartbeatX + 2.0
    if debugOverlay.heartbeatX > debugOverlay.screenW {
      debugOverlay.heartbeatX = -size
    }
  }
  Gpu2d.drawBox(
    canvas: canvas
    x: debugOverlay.heartbeatX
    y: 0.0
    w: size
    h: size
    radius: 0.0
    fill: debugAmber
    borderWidth: 0.0
    border: 0x00000000
  )
}

# Example 106's mark: a FILLED amber disc with a black D. Solid amber carries
# the "instrumentation, not part of the app" reading on its own, where an
# outlined button competed with whatever it happened to sit over.
func drawDebugButton(debugOverlay: view DebugOverlay, canvas: mod Gpu2dCanvas, font: view SdfFont) {
  let x: Float = debugButtonX(debugOverlay: debugOverlay)
  # Open INVERTS rather than recolors: the same two colors, so the state is
  # unmistakable without introducing a third.
  var disc: Int = debugAmber
  var glyph: Int = debugInk
  if debugOverlay.open {
    disc = debugInk
    glyph = debugAmber
  }
  Gpu2d.drawBox(
    canvas: canvas
    x: x
    y: debugTop(debugOverlay: debugOverlay)
    w: debugOverlay.buttonSize
    h: debugOverlay.buttonSize
    radius: debugOverlay.buttonSize * 0.5
    fill: disc
    borderWidth: 0.0
    border: 0x00000000
  )
  let glyphSize: Float = debugOverlay.buttonSize * 0.66
  let glyphW: Float = debugTextWidth(text: "D", sizePx: glyphSize)
  # drawText places the PEN, and the glyph starts a little to the right of it.
  # Centering on the pen alone leaves the letter visibly off-center on a disc this
  # small — measured at 10px of gap on the left against 5px on the right.
  let bearing: Float = glyphSize * 0.09
  let gx: Float = x + (debugOverlay.buttonSize - glyphW) * 0.5 - bearing
  let gy: Float = debugTop(debugOverlay: debugOverlay) + debugOverlay.buttonSize * 0.5 + glyphSize * 0.36
  Gpu2dText.drawText(
    canvas: canvas
    font: font
    text: "D"
    x: gx
    y: gy
    sizePx: glyphSize
    color: glyph
  )
}

func drawDebugReadouts(
  debugOverlay: view DebugOverlay
  canvas: mod Gpu2dCanvas
  font: view SdfFont
) {
  let fontSize: Float = debugReadoutSize(debugOverlay: debugOverlay)
  if debugOverlay.readoutsBeside {
    let line: String = formatDebugBeside(debugOverlay: debugOverlay)
    if line.length() > 0 {
      Gpu2dText.drawText(
        canvas: canvas
        font: font
        text: line
        x: debugBesideX(debugOverlay: debugOverlay, font: font, text: line)
        y: debugBesideBaseline(debugOverlay: debugOverlay)
        sizePx: fontSize
        color: debugAmber
      )
    }
    ret
  }
  let lineH: Float = 18.0
  let gap: Float = 8.0
  var y: Float = debugTop(debugOverlay: debugOverlay) + debugOverlay.buttonSize + gap + fontSize
  if debugOverlay.open {
    # The dialog occupies that space; put the readouts under it rather than
    # behind it.
    y = debugDialogY(debugOverlay: debugOverlay) + debugDialogH(debugOverlay: debugOverlay) + gap + fontSize
  }
  if debugOverlay.wantFps {
    let text: String = formatDebugFps(fps: debugOverlay.lastFps)
    Gpu2dText.drawText(
      canvas: canvas
      font: font
      text: text
      x: debugReadoutX(
        debugOverlay: debugOverlay
        font: font
        text: text
        sizePx: fontSize
      )
      y: y
      sizePx: fontSize
      color: debugAmber
    )
    y = y + lineH
  }
  if debugOverlay.wantMemory {
    let text: String = formatDebugMem(kb: debugOverlay.lastRssKb)
    Gpu2dText.drawText(
      canvas: canvas
      font: font
      text: text
      x: debugReadoutX(
        debugOverlay: debugOverlay
        font: font
        text: text
        sizePx: fontSize
      )
      y: y
      sizePx: fontSize
      color: debugAmber
    )
    y = y + lineH
  }
  # Opt-in custom line under the fps/mem readouts — same amber as the rest.
  if debugOverlay.customLine.length() > 0 {
    Gpu2dText.drawText(
      canvas: canvas
      font: font
      text: debugOverlay.customLine
      x: debugReadoutX(
        debugOverlay: debugOverlay
        font: font
        text: debugOverlay.customLine
        sizePx: fontSize
      )
      y: y
      sizePx: fontSize
      color: debugAmber
    )
  }
}

# The perf HUD where the readouts were: under the button, or under the dialog while it is open;
# toward the middle of the window and kept inside it
func drawDebugPerfHud(debugOverlay: mod DebugOverlay, canvas: mod Gpu2dCanvas, font: view SdfFont) {
  let perfHud: mod PerfHud = debugOverlay.perfHud
  perfHudCountAllocations(perfHud: perfHud)
  perfHudSampleFrame(perfHud: perfHud, pacer: canvas.framePacer)
  perfHudPeriod(perfHud: perfHud, now: frameClock(), nowNanoseconds: nowNs())
  # 380 points, or the window's width inside its margins when that is less (a phone)
  var width: Float = perfHudWidth()
  if debugOverlay.screenW > 0.0 {
    width = Math.min(a: width, b: debugOverlay.screenW - debugOverlay.margin * 2.0)
  }
  var x: Float = debugRight(debugOverlay: debugOverlay) - width
  if debugOpensRight(debugOverlay: debugOverlay) {
    x = debugButtonX(debugOverlay: debugOverlay)
  }
  x = debugClampX(debugOverlay: debugOverlay, x: x, width: width)
  var y: Float = debugDialogY(debugOverlay: debugOverlay)
  if debugOverlay.open {
    y = y + debugDialogH(debugOverlay: debugOverlay) + 8.0
  }
  drawPerfHud(
    perfHud: perfHud
    canvas: canvas
    font: font
    x: x
    y: y
    width: width
    now: frameClock()
    headline: "{displayFps(fps: debugOverlay.lastFps)} fps  {formatDebugMem(
      kb: debugOverlay.lastRssKb
    )}"
    rssKb: debugOverlay.lastRssKb
  )
  perfHudDrawn(perfHud: perfHud)
}

# Call LAST in the frame. Everything here paints straight to gpu2d, so whatever
# is drawn after it wins — which is the whole reason this is not an ECS layer.
func drawDebugOverlay(
  debugOverlay: mod DebugOverlay
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  didRealWork: view Bool
) {
  if debugOverlay.wantHeartbeat {
    drawDebugHeartbeat(debugOverlay: debugOverlay, canvas: canvas, didRealWork: didRealWork)
  }
  if debugOverlay.wantButton {
    drawDebugButton(debugOverlay: debugOverlay, canvas: canvas, font: font)
  }
  perfHudPacer(perfHud: debugOverlay.perfHud, pacer: canvas.framePacer)
  if debugOverlay.perfHud.open {
    drawDebugPerfHud(debugOverlay: debugOverlay, canvas: canvas, font: font)
  } else {
    drawDebugReadouts(debugOverlay: debugOverlay, canvas: canvas, font: font)
  }
  if debugOverlay.open {
    drawDebugDialog(debugOverlay: debugOverlay, canvas: canvas, font: font)
  }
}
