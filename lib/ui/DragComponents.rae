# The data of drags (ui/DragSystem): their authored components, the drag of a UiWorld, a resource on
# it, and its events.
open ecs/Entity
open ui/Components
open ui/BindingComponents

# On a node: a press on it, held and moved, asks the program for a drag (a DragEvent `begin`).
# `kind`
# is the program's word for it. With `touch` a finger held still does too; without, a finger
# scrolls.
#
#     "Row": { "DragSource": { "kind": "file" }, "DropTarget": { "kinds": "files" } }
type DragSource {
  kind: String = ""
  touch: Bool = false
  # How far (points) a press moves before it is a drag
  startPoints: Float = 5.0
  # How long a finger is held still before it drags (seconds); a finger that moves first scrolls.
  # 0: a finger drags as soon as it moves `startPoints`, as a mouse does (a source not in a scroll)
  holdSeconds: Float = 0.4
  # The node itself follows the pointer while it is dragged (its offset from the pointer kept, its
  # RuntimeOffset moved) instead of a label, raised into `followLayer` (a LayerTag) and put back
  # where it was when the drag ends
  follow: Bool = false
  followLayer: String = "hud"
}

# On a node: drags of these kinds (with spaces between) can be let go on it; "files" and "text" are
# what the OS drops. A drag that a node does not take is its ancestors'.
type DropTarget {
  kinds: String = ""
}

# What letting go does: nothing, or the thing is moved or copied there
enum DragEffect { refused, move, copyThere }

# What is dragged
type UiDragPayload {
  kind: String = ""
  # What the program drags: paths, ids, text
  values: List(String) = {}
  # What is drawn at the pointer
  label: String = ""
  icon: String = ""
  mayMove: Bool = true
  mayCopy: Bool = true
  # The node it began on (noEntity() for the OS's), and a number of the program's
  source: EntityId = noEntity()
  note: Int = 0
}

enum UiDragPhase {
  idle
  # on a DragSource, not moved far enough yet
  pressed
  # `begin` was sent: the program starts it (startDrag) in this frame, or it is none
  asked
  dragging
}

# The drag of a world
type UiDrag {
  phase: UiDragPhase = UiDragPhase.idle
  payload: UiDragPayload = {}
  # It is the OS's
  external: Bool = false
  # The node pressed, where and when
  source: EntityId = noEntity()
  pressX: Float = 0.0
  pressY: Float = 0.0
  pressSeconds: Float64 = 0.0
  # Where it is, the DropTarget under it, and what letting go would do there: what the keys say,
  # which
  # a program changes or refuses (setDragEffect)
  x: Float = 0.0
  y: Float = 0.0
  target: EntityId = noEntity()
  wanted: DragEffect = DragEffect.refused
  effect: DragEffect = DragEffect.refused
  # The keys ask for a move also where it would be a copy
  moveAsked: Bool = false
  # It was there when the frame began: the frame's keys are its
  tookKeys: Bool = false
  # Its label's node, its time of the last frame, and the root a modal may cover
  label: EntityId = noEntity()
  seconds: Float64 = 0.0
  root: EntityId = noEntity()
  # The pointer's last places (x, y, seconds since the drag began: three floats each), for the
  # release velocity over the last 0.1 s
  samples: List(Float) = {}
  # A DragSource with `follow`: the node that follows, its RuntimeOffset and LayerTag before (to
  # put back), and whether it had them
  follower: EntityId = noEntity()
  followerOffset: Vec2 = Vec2 { x: 0.0, y: 0.0 }
  followerHadOffset: Bool = false
  followerLayer: LayerTag = { id: "" }
  followerHadLayer: Bool = false
}

enum DragEventKind { begin, over, drop, canceled }

# `begin`: a press on the DragSource `source` moved: startDrag, or it is none. `over`: another
# target
# (noEntity() none) is under the drag. `drop`: it was let go on `target`. `canceled`: it was not.
type DragEvent {
  kind: DragEventKind
  source: EntityId = noEntity()
  target: EntityId = noEntity()
  payload: UiDragPayload = {}
  external: Bool = false
  # What the keys say letting go does, and whether they ask for a move
  wanted: DragEffect = DragEffect.refused
  moveAsked: Bool = false
  x: Float = 0.0
  y: Float = 0.0
  # `drop` and `canceled`: how fast the pointer moved, points per second over the last 0.1 s
  # (a fling's or a sling's speed)
  velocityX: Float = 0.0
  velocityY: Float = 0.0
}
