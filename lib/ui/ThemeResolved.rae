# Theme M0 — resolved theme loader (#230,
# rae/docs/ui-theme-system.md §3-§5, M0).
#
# A theme is DATA, not code, and lives in a `.raescene` as top-level
# sections next to `nodes` — exactly parallel to how S3/S5 put
# `frames`/`states` there. NO new file format: this reads the theme
# sections out of an already-parsed Scene's flat-pool JsonDoc.
#
#   "palette": { "<slot>": {r,g,b,a}, … }          semantic colors
#   "space":   { "<token>": <du> , … }             spacing scale
#   "radius":  { "<token>": <du> , … }             corner-radius presets
#   "padding": { "<token>": {l,t,r,b}, … }         inset presets
#   "shadow":  { "<token>": { color,offsetX,offsetY,softness, extends? } }
#   "text":    { "<style>": { font,size,weight,lineHeight,tracking,
#                             color,shadow,align, extends? } }
#
# `color` on a text style is either a palette SLOT NAME (string,
# resolved against the palette at use — the seam that later makes
# theme switching a repaint, M5) or an inline {r,g,b,a} object (for
# one-offs like the debug panel's literal ink).
#
# STYLE INHERITANCE (§4): text styles and shadow tokens may carry
# `"extends": "<other>"` — single parent, FLATTENED HERE at load
# (child fields win). Runtime never walks a chain. Depth is capped at
# 4; an unknown parent or a cycle is a loud error (logged) and the
# chain is truncated there, mirroring the scene-loader diagnostic
# tone. Flatten-at-load keeps ResolvedTheme free of recursion and
# StringMaps.
#
# STORAGE (§3): parallel PRIMITIVE lists (the FrameSet discipline —
# no StringMap in structs on Live, no List(struct)-by-index). Tens of
# entries, so linear name lookup is fine; per-frame consumers should
# cache by id (the VisualBounds pattern, #219).
#
# M0 scope: load + flatten + dump. NOTHING consumes ResolvedTheme yet
# — M1 points the text resolver at it.
import Json
import ui/Scene
open ui/ThemeParse

const themeMaxExtendsDepth: Int = 4

# Align codes stored in textAligns: 0 start, 1 center, 2 end.
const themeAlignStart: Int = 0

const themeAlignCenter: Int = 1

const themeAlignEnd: Int = 2

# Padding token result — a plain 4-float struct so this module needs
# no ui/components dependency (which would drag EntityId-using types
# into the emit graph). registry maps it to the ECS Insets.
type ThemeInsets {
  l: Float
  t: Float
  r: Float
  b: Float
}

type ResolvedTheme {
  # palette: slot name -> rgba (parallel r/g/b/a).
  palNames: List(String)
  palR: List(Int)
  palG: List(Int)
  palB: List(Int)
  palA: List(Int)
  # space + radius: token name -> du value.
  spaceNames: List(String)
  spaceVals: List(Float)
  radiusNames: List(String)
  radiusVals: List(Float)
  # padding: token -> insets.
  padNames: List(String)
  padL: List(Float)
  padT: List(Float)
  padR: List(Float)
  padB: List(Float)
  # shadow tokens (flattened): color rgba + offset + softness.
  shadowNames: List(String)
  shadowR: List(Int)
  shadowG: List(Int)
  shadowB: List(Int)
  shadowA: List(Int)
  shadowOffX: List(Float)
  shadowOffY: List(Float)
  shadowSoft: List(Float)
  # text styles (flattened).
  textNames: List(String)
  textFonts: List(String)
  textSizes: List(Float)
  textWeights: List(Float)
  textLineHeights: List(Float)
  textTrackings: List(Float)
  # colorSlot "" => use inline textColor{R,G,B,A}; else resolve slot.
  textColorSlots: List(String)
  textColorR: List(Int)
  textColorG: List(Int)
  textColorB: List(Int)
  textColorA: List(Int)
  # "" => no shadow.
  textShadowNames: List(String)
  textAligns: List(Int)
  # container/button styles (#237, M6): composite bundles that reference
  # other tokens. Each entry names a background palette slot, a radius
  # token, a padding token, and a text style — the "five visual
  # components on a node" collapsed to one `"ContainerStyle": "name"`.
  containerNames: List(String)
  containerBgSlots: List(String)
  containerRadiusTokens: List(String)
  containerPadTokens: List(String)
  containerTextStyles: List(String)
  ok: Bool
}

func createResolvedTheme() pub ret ResolvedTheme {
  ret ResolvedTheme {
    palNames: List.create(String, cap: 12)
    palR: List.create(Int, cap: 12)
    palG: List.create(Int, cap: 12)
    palB: List.create(Int, cap: 12)
    palA: List.create(Int, cap: 12)
    spaceNames: List.create(String, cap: 8)
    spaceVals: List.create(Float, cap: 8)
    radiusNames: List.create(String, cap: 8)
    radiusVals: List.create(Float, cap: 8)
    padNames: List.create(String, cap: 8)
    padL: List.create(Float, cap: 8)
    padT: List.create(Float, cap: 8)
    padR: List.create(Float, cap: 8)
    padB: List.create(Float, cap: 8)
    shadowNames: List.create(String, cap: 8)
    shadowR: List.create(Int, cap: 8)
    shadowG: List.create(Int, cap: 8)
    shadowB: List.create(Int, cap: 8)
    shadowA: List.create(Int, cap: 8)
    shadowOffX: List.create(Float, cap: 8)
    shadowOffY: List.create(Float, cap: 8)
    shadowSoft: List.create(Float, cap: 8)
    textNames: List.create(String, cap: 32)
    textFonts: List.create(String, cap: 32)
    textSizes: List.create(Float, cap: 32)
    textWeights: List.create(Float, cap: 32)
    textLineHeights: List.create(Float, cap: 32)
    textTrackings: List.create(Float, cap: 32)
    textColorSlots: List.create(String, cap: 32)
    textColorR: List.create(Int, cap: 32)
    textColorG: List.create(Int, cap: 32)
    textColorB: List.create(Int, cap: 32)
    textColorA: List.create(Int, cap: 32)
    textShadowNames: List.create(String, cap: 32)
    textAligns: List.create(Int, cap: 32)
    containerNames: List.create(String, cap: 8)
    containerBgSlots: List.create(String, cap: 8)
    containerRadiusTokens: List.create(String, cap: 8)
    containerPadTokens: List.create(String, cap: 8)
    containerTextStyles: List.create(String, cap: 8)
    ok: false
  }
}

# -----------------------------------------------------------------
# Lookups (linear; tens of entries). Consumers that resolve per frame
# should cache the index/result by id.
# -----------------------------------------------------------------
func themeSpaceValue(
  theme: view ResolvedTheme
  name: view String
  fallback: view Float
) pub ret Float {
  unsafe {
    var i: Int = 0
    loop i < theme.spaceNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.spaceNames.data, index: i)
      if n is name {
        if let value: Float = theme.spaceVals.copyAt(index: i) {
          ret value
        }
      }
      i = i + 1
    }
    ret fallback
  }
}

func themeRadiusValue(
  theme: view ResolvedTheme
  name: view String
  fallback: view Float
) pub ret Float {
  unsafe {
    var i: Int = 0
    loop i < theme.radiusNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.radiusNames.data, index: i)
      if n is name {
        if let value: Float = theme.radiusVals.copyAt(index: i) {
          ret value
        }
      }
      i = i + 1
    }
    ret fallback
  }
}

func themePaletteIndex(theme: view ResolvedTheme, slot: view String) pub ret Int {
  unsafe {
    var i: Int = 0
    loop i < theme.palNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.palNames.data, index: i)
      if n is slot {
        ret i
      }
      i = i + 1
    }
    ret -1
  }
}

func themeTextStyleIndex(theme: view ResolvedTheme, styleId: view String) pub ret Int {
  unsafe {
    var i: Int = 0
    loop i < theme.textNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.textNames.data, index: i)
      if n is styleId {
        ret i
      }
      i = i + 1
    }
    ret -1
  }
}

func themeShadowIndex(theme: view ResolvedTheme, name: view String) pub ret Int {
  unsafe {
    var i: Int = 0
    loop i < theme.shadowNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.shadowNames.data, index: i)
      if n is name {
        ret i
      }
      i = i + 1
    }
    ret -1
  }
}

# -----------------------------------------------------------------
# Parse
# -----------------------------------------------------------------

# Index of a container style in the ResolvedTheme's container table, or -1. The
# field getters below read the parallel lists at that index (#237, M6).
func themeContainerIndex(theme: view ResolvedTheme, name: view String) pub ret Int {
  var i: Int = 0
  loop i < theme.containerNames.length {
    if let n: String = theme.containerNames.copyAt(index: i) {
      if n is name {
        ret i
      }
    }
    i = i + 1
  }
  ret 0 - 1
}

func themeContainerBgSlotAt(theme: view ResolvedTheme, index: view Int) pub ret String {
  if let slot: String = theme.containerBgSlots.copyAt(index: index) {
    ret "{slot}"
  }
  ret ""
}

func themeContainerRadiusTokenAt(theme: view ResolvedTheme, index: view Int) pub ret String {
  if let token: String = theme.containerRadiusTokens.copyAt(index: index) {
    ret "{token}"
  }
  ret ""
}

func themeContainerPadTokenAt(theme: view ResolvedTheme, index: view Int) pub ret String {
  if let token: String = theme.containerPadTokens.copyAt(index: index) {
    ret "{token}"
  }
  ret ""
}

# Resolve a padding token name to its insets against `theme`, or a zero fallback
# (logged) when undefined. Returns ThemeInsets (not the ECS Insets) to keep this
# module free of the ui/components dependency.
func themePaddingInsets(theme: view ResolvedTheme, name: view String) pub ret ThemeInsets {
  unsafe {
    var i: Int = 0
    loop i < theme.padNames.length {
      let n: String = rae_ext_rae_buf_get(buf: theme.padNames.data, index: i)
      if n is name {
        var l: Float = 0.0
        var t: Float = 0.0
        var r: Float = 0.0
        var b: Float = 0.0
        if let padLVal: Float = theme.padL.copyAt(index: i) {
          l = padLVal
        }
        if let padTVal: Float = theme.padT.copyAt(index: i) {
          t = padTVal
        }
        if let padRVal: Float = theme.padR.copyAt(index: i) {
          r = padRVal
        }
        if let padBVal: Float = theme.padB.copyAt(index: i) {
          b = padBVal
        }
        ret ThemeInsets { l: l, t: t, r: r, b: b }
      }
      i = i + 1
    }
    log("[scene] unknown padding token '{name}' - using zero insets")
    ret ThemeInsets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  }
}

# #764: element-wise copy the SCENE-DESERIALISER token subsets (space / radius /
# padding / container) from a source ResolvedTheme into `dst`. Used by
# seedWorldTheme to populate a fresh UiWorld's `theme.resolved` from the app's
# owned ResolvedTheme — a deep copy (fresh list elements), never a shallow
# heap-pointer aliasing. Only these four subsets are copied because they are the
# only parts the deserialiser reads off the world; palette colours resolve against
# `theme.active` and text styles against the Gpu2dUi's own ResolvedTheme. Mirrors
# the old setActiveThemeTokens, retargeted from module globals to `dst`. Idempotent
# via `dst.ok`: a world seeded once is not re-copied.
func applyResolvedTokens(dst: mod ResolvedTheme, src: view ResolvedTheme) pub {
  if dst.ok {
    ret
  }
  # #899: `rae_ext_rae_buf_get` returns a shallow alias of `src`'s String
  # storage; adding that alias directly to `dst` would leave `dst` and `src`
  # sharing the same heap, and dropping both frees it twice (the same shape
  # as the Files.rae `listDirByExt` bug). `copyAt` + `if let` is the safe
  # accessor already used by the container loop below: unwrapping the
  # optional deep-copies the String payload, so `dst` owns independent
  # storage.
  var i: Int = 0
  loop i < src.spaceNames.length {
    if let n: String = src.spaceNames.copyAt(index: i) {
      if let value: Float = src.spaceVals.copyAt(index: i) {
        dst.spaceNames.add(value: n)
        dst.spaceVals.add(value: value)
      }
    }
    i = i + 1
  }
  i = 0
  loop i < src.radiusNames.length {
    if let n: String = src.radiusNames.copyAt(index: i) {
      if let value: Float = src.radiusVals.copyAt(index: i) {
        dst.radiusNames.add(value: n)
        dst.radiusVals.add(value: value)
      }
    }
    i = i + 1
  }
  i = 0
  loop i < src.padNames.length {
    if let n: String = src.padNames.copyAt(index: i) {
      var l: Float = 0.0
      var t: Float = 0.0
      var r: Float = 0.0
      var b: Float = 0.0
      if let padLVal: Float = src.padL.copyAt(index: i) {
        l = padLVal
      }
      if let padTVal: Float = src.padT.copyAt(index: i) {
        t = padTVal
      }
      if let padRVal: Float = src.padR.copyAt(index: i) {
        r = padRVal
      }
      if let padBVal: Float = src.padB.copyAt(index: i) {
        b = padBVal
      }
      dst.padNames.add(value: n)
      dst.padL.add(value: l)
      dst.padT.add(value: t)
      dst.padR.add(value: r)
      dst.padB.add(value: b)
    }
    i = i + 1
  }
  i = 0
  loop i < src.containerNames.length {
    if let containerName: String = src.containerNames.copyAt(index: i) {
      dst.containerNames.add(value: containerName)
    }
    if let containerBgSlot: String = src.containerBgSlots.copyAt(index: i) {
      dst.containerBgSlots.add(value: containerBgSlot)
    }
    if let containerRadiusToken: String = src.containerRadiusTokens.copyAt(index: i) {
      dst.containerRadiusTokens.add(value: containerRadiusToken)
    }
    if let containerPadToken: String = src.containerPadTokens.copyAt(index: i) {
      dst.containerPadTokens.add(value: containerPadToken)
    }
    if let containerTextStyle: String = src.containerTextStyles.copyAt(index: i) {
      dst.containerTextStyles.add(value: containerTextStyle)
    }
    i = i + 1
  }
  dst.ok = true
}
