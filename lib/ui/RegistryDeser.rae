# RegistryDeser — the per-component JSON deserializers of the scene component
# registry (#918 split of ui/Registry for the 1000-line cap): the enum-name
# parsers (parseSizeMode / parseLayoutType / ...), the value decoders (deserVec2
# / deserRgba / deserRect / ...) and one `deser<Component>` per registered
# component. ui/Registry's applyComponentByName dispatches to these by name.
open ui/RegistryOpt
open ui/ContainerStyle
import Json
import ui/Theme
import ui/Spacing
import ui/ThemeResolved
open ecs/ComponentTable
open ui/Registry
open ui/RegistryValues

func deserLayout(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Layout {
  let typeStr: String = optString(
    doc: doc
    container: val
    key: "type"
    fallback: "None"
  )
  let alignMainStr: String = optString(
    doc: doc
    container: val
    key: "alignMain"
    fallback: "Start"
  )
  let alignCrossStr: String = optString(
    doc: doc
    container: val
    key: "alignCross"
    fallback: "Start"
  )
  ret Layout {
    kind: parseLayoutType(text: typeStr)
    gap: optFloatOrToken(
      doc: doc
      theme: theme
      container: val
      key: "gap"
      fallback: 0.0
    )
    alignMain: parseAlignKind(text: alignMainStr)
    alignCross: parseAlignKind(text: alignCrossStr)
    columns: optInt(
      doc: doc
      container: val
      key: "columns"
      fallback: 0
    )
    rowGap: optFloatOrToken(
      doc: doc
      theme: theme
      container: val
      key: "rowGap"
      fallback: 0.0
    )
    columnGap: optFloatOrToken(
      doc: doc
      theme: theme
      container: val
      key: "columnGap"
      fallback: 0.0
    )
  }
}

func deserPadding(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Padding {
  # A padding token names a whole Insets preset (#233):
  # `"Padding": "screenEdgePadding"`. A JSON object still gives
  # explicit per-side insets (each side may itself be a space token).
  let empty: String = ""
  let asStr: String = Json.jsonString(this: val, fallback: empty)
  if asStr.length() > 0 {
    let ti: ThemeInsets = themePaddingInsets(theme: theme.resolved, name: asStr)
    ret Padding { insets: Insets { l: ti.l, t: ti.t, r: ti.r, b: ti.b } }
  }
  ret Padding { insets: deserInsets(doc: doc, theme: theme, val: val) }
}

func deserMargin(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Margin {
  ret Margin { insets: deserInsets(doc: doc, theme: theme, val: val) }
}

func deserAlign(doc: view JsonDoc, val: view JsonValue) ret Align {
  let xIdx: Int = Json.field(doc: doc, this: val, key: "x")
  let yIdx: Int = Json.field(doc: doc, this: val, key: "y")
  var xK: AlignKind = AlignKind.start
  var yK: AlignKind = AlignKind.start
  if xIdx >= 0 {
    let xv: JsonValue = Json.jsonValueAt(doc: doc, idx: xIdx)
    let s: String = Json.jsonString(this: xv, fallback: "Start")
    xK = parseAlignKind(text: s)
  }
  if yIdx >= 0 {
    let yv: JsonValue = Json.jsonValueAt(doc: doc, idx: yIdx)
    let s: String = Json.jsonString(this: yv, fallback: "Start")
    yK = parseAlignKind(text: s)
  }
  ret Align { x: xK, y: yK, hasX: xIdx >= 0, hasY: yIdx >= 0 }
}

func deserOffset(doc: view JsonDoc, val: view JsonValue) ret Offset {
  ret Offset { delta: deserVec2(doc: doc, val: val) }
}

func deserSprite(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Sprite {
  let s: Sprite = defaultSprite()
  s.textureKey = optString(
    doc: doc
    container: val
    key: "textureKey"
    fallback: ""
  )
  let scaleModeStr: String = optString(
    doc: doc
    container: val
    key: "scaleMode"
    fallback: "Fit"
  )
  s.scaleMode = parseScaleMode(text: scaleModeStr)
  let tintIdx: Int = Json.field(doc: doc, this: val, key: "tint")
  if tintIdx >= 0 {
    let tv: JsonValue = Json.jsonValueAt(doc: doc, idx: tintIdx)
    s.tint = deserRgba(doc: doc, theme: theme, val: tv)
    # Record the palette slot (empty for a literal object) so the
    # renderer can re-resolve on a live theme switch (#235).
    let emptySlot: String = ""
    s.tintSlot = Json.jsonString(this: tv, fallback: emptySlot)
  }
  ret s
}

func deserText(doc: view JsonDoc, val: view JsonValue) ret Text {
  let txt: String = optString(
    doc: doc
    container: val
    key: "text"
    fallback: ""
  )
  let style: String = optString(
    doc: doc
    container: val
    key: "styleId"
    fallback: ""
  )
  let wrapStr: String = optString(
    doc: doc
    container: val
    key: "wrapWidthMode"
    fallback: "None"
  )
  # `own`: each local is consumed by the returned struct, no further
  # uses. Avoids the wasted Phase 2 deep-copy + auto-drop pair that
  # would otherwise allocate one extra heap per field per call.
  ret Text { text: own txt, styleId: own style, wrapWidthMode: parseWrapWidthMode(text: wrapStr) }
}

# Sparse tier-2 style override (#236, theme §7). Parsed from the
# `styleOverride` sub-object of a Text bag. Only the keys present patch
# the resolved style — `size` (Float du) and `color` (literal RGBA
# object OR a palette slot string, mirroring deserRgba). Absent keys
# leave their `has*` flag false so the base style value shows through.
func deserStyleOverride(
  doc: view JsonDoc
  theme: view UiTheme
  val: view JsonValue
) ret StyleOverride {
  var so: StyleOverride = defaultStyleOverride()
  let sizeIdx: Int = Json.field(doc: doc, this: val, key: "size")
  if sizeIdx >= 0 {
    so.hasSize = true
    so.size = optFloat(
      doc: doc
      container: val
      key: "size"
      fallback: 0.0
    )
  }
  let colorIdx: Int = Json.field(doc: doc, this: val, key: "color")
  if colorIdx >= 0 {
    so.hasColor = true
    let cv: JsonValue = Json.jsonValueAt(doc: doc, idx: colorIdx)
    so.color = deserRgba(doc: doc, theme: theme, val: cv)
    let emptySlot: String = ""
    so.colorSlot = Json.jsonString(this: cv, fallback: emptySlot)
  }
  ret so
}

func deserTextShadow(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret TextShadow {
  var shadow: TextShadow = defaultTextShadow()
  shadow.offset.x = optFloat(
    doc: doc
    container: val
    key: "offsetX"
    fallback: 0.0
  )
  shadow.offset.y = optFloat(
    doc: doc
    container: val
    key: "offsetY"
    fallback: 0.0
  )
  shadow.softness = optFloat(
    doc: doc
    container: val
    key: "softness"
    fallback: 1.0
  )
  let colorIdx: Int = Json.field(doc: doc, this: val, key: "color")
  if colorIdx >= 0 {
    let cv: JsonValue = Json.jsonValueAt(doc: doc, idx: colorIdx)
    shadow.color = deserRgba(doc: doc, theme: theme, val: cv)
  }
  ret shadow
}

func deserShape(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret Shape {
  let kindStr: String = optString(
    doc: doc
    container: val
    key: "kind"
    fallback: "Rect"
  )
  let s: Shape = defaultShape()
  s.kind = parseShapeKind(text: kindStr)
  s.strokeWidth = optFloat(
    doc: doc
    container: val
    key: "strokeWidth"
    fallback: 0.0
  )
  s.radius = optRadiusOrToken(
    doc: doc
    theme: theme
    container: val
    key: "radius"
    fallback: 0.0
  )
  let fillIdx: Int = Json.field(doc: doc, this: val, key: "fill")
  if fillIdx >= 0 {
    let fv: JsonValue = Json.jsonValueAt(doc: doc, idx: fillIdx)
    s.fill = deserRgba(doc: doc, theme: theme, val: fv)
    let emptyFill: String = ""
    s.fillSlot = Json.jsonString(this: fv, fallback: emptyFill)
  }
  let strokeIdx: Int = Json.field(doc: doc, this: val, key: "stroke")
  if strokeIdx >= 0 {
    let sv: JsonValue = Json.jsonValueAt(doc: doc, idx: strokeIdx)
    s.stroke = deserRgba(doc: doc, theme: theme, val: sv)
    let emptyStroke: String = ""
    s.strokeSlot = Json.jsonString(this: sv, fallback: emptyStroke)
  }
  ret s
}

func deserActive(doc: view JsonDoc, val: view JsonValue) ret Active {
  ret Active { value: optBool(
    doc: doc
    container: val
    key: "value"
    fallback: true
  ) }
}

