func deserHeroWidget(doc: view JsonDoc, val: view JsonValue) ret HeroWidget {
  # `key` is reserved in Rae, so it can't appear directly after a
  # type-prefixed struct literal in `ret`. Bind to a typed local first.
  let k: String = optString(
    doc: doc
    container: val
    key: "key"
    fallback: ""
  )
  let r: HeroWidget = { key: own k }
  ret r
}

func deserCornerRadius(
  doc: view JsonDoc
  theme: view UiTheme
  val: view JsonValue
) ret CornerRadius {
  let r: Float = optRadiusOrToken(
    doc: doc
    theme: theme
    container: val
    key: "radius"
    fallback: 0.0
  )
  ret CornerRadius { radius: r }
}

func deserBackdropImage(doc: view JsonDoc, val: view JsonValue) ret BackdropImage {
  let k: String = optString(
    doc: doc
    container: val
    key: "textureKey"
    fallback: ""
  )
  ret BackdropImage { textureKey: own k }
}

func deserGradientFill(
  doc: view JsonDoc
  theme: view UiTheme
  val: view JsonValue
) ret GradientFill {
  let fromIdx: Int = Json.field(doc: doc, this: val, key: "from")
  let toIdx: Int = Json.field(doc: doc, this: val, key: "to")
  let zero: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  var fromCol: RgbaColor = zero
  var toCol: RgbaColor = zero
  if fromIdx >= 0 {
    fromCol = deserRgba(doc: doc, theme: theme, val: Json.jsonValueAt(doc: doc, idx: fromIdx))
  }
  if toIdx >= 0 {
    toCol = deserRgba(doc: doc, theme: theme, val: Json.jsonValueAt(doc: doc, idx: toIdx))
  }
  let angle: Float = optFloat(
    doc: doc
    container: val
    key: "angle"
    fallback: 90.0
  )
  ret GradientFill { from: fromCol, to: toCol, angle: angle }
}

func deserOpticalAlign(doc: view JsonDoc, val: view JsonValue) ret OpticalAlign {
  let enabled: Bool = optBool(
    doc: doc
    container: val
    key: "enabled"
    fallback: true
  )
  let centerX: Bool = optBool(
    doc: doc
    container: val
    key: "centerX"
    fallback: true
  )
  let centerY: Bool = optBool(
    doc: doc
    container: val
    key: "centerY"
    fallback: true
  )
  let biasX: Float = optFloat(
    doc: doc
    container: val
    key: "biasX"
    fallback: 0.0
  )
  let biasY: Float = optFloat(
    doc: doc
    container: val
    key: "biasY"
    fallback: 0.0
  )
  ret OpticalAlign {
    enabled: enabled
    centerX: centerX
    centerY: centerY
    bias: Vec2 { x: biasX, y: biasY }
  }
}

func deserSafeArea(doc: view JsonDoc, theme: view UiTheme, val: view JsonValue) ret SafeArea {
  # `apply` is a per-edge multiplier (default 1.0 = fully honour the
  # device inset on that edge; 0.0 = ignore it). `extra` is an
  # additive per-edge gutter in design units. Both reuse the standard
  # Insets shape so a scene author can write partial objects.
  let enabled: Bool = optBool(
    doc: doc
    container: val
    key: "enabled"
    fallback: true
  )
  var apply: Insets = { l: 1.0, t: 1.0, r: 1.0, b: 1.0 }
  let applyIdx: Int = Json.field(doc: doc, this: val, key: "apply")
  if applyIdx >= 0 {
    apply = deserInsets(doc: doc, theme: theme, val: Json.jsonValueAt(doc: doc, idx: applyIdx))
  }
  var extra: Insets = { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  let extraIdx: Int = Json.field(doc: doc, this: val, key: "extra")
  if extraIdx >= 0 {
    extra = deserInsets(doc: doc, theme: theme, val: Json.jsonValueAt(doc: doc, idx: extraIdx))
  }
  ret SafeArea { enabled: enabled, apply: apply, extra: extra }
}

func deserLayerRoot(doc: view JsonDoc, val: view JsonValue) ret LayerRoot {
  let id: String = optString(
    doc: doc
    container: val
    key: "id"
    fallback: ""
  )
  let ord: Int = optInt(
    doc: doc
    container: val
    key: "order"
    fallback: 0
  )
  ret LayerRoot { id: own id, order: ord }
}

func deserDebugAnchor(doc: view JsonDoc, val: view JsonValue) ret DebugAnchor {
  # `DebugAnchor` is a presence-tag — its mere existence on an entity
  # (plus a `Rect` on the same entity) is what `addDebugLayer` looks
  # for. The `value` field is just a placeholder so Rae's nonzero-field
  # struct requirement is satisfied; nothing reads it.
  ret DebugAnchor { value: true }
}

