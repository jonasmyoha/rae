    observedRevision: rev
    dirty: dirty
  }
}

func deserPrimaryType(doc: view JsonDoc, val: view JsonValue) ret PrimaryType {
  ret PrimaryType { typeName: optString(
    doc: doc
    container: val
    key: "typeName"
    fallback: ""
  ) }
}

func deserNodeId(doc: view JsonDoc, val: view JsonValue) ret NodeId {
  # `id` is a reserved keyword in Rae, so it can't appear after a
  # type-prefixed struct literal in `ret`. Drop the type prefix by
  # binding to a typed local first, then return the local.
  let nid: String = optString(
    doc: doc
    container: val
    key: "id"
    fallback: ""
  )
  let r: NodeId = { id: own nid }
  ret r
}

func deserSceneInstance(doc: view JsonDoc, val: view JsonValue) ret SceneInstance {
  # Reads the RUICS SceneInstance shape:
  #   { "sceneId": "child-scene-id",
  #     "params": { "overrides": [
  #       { "nodeId": "X", "component": "Y", "field": "Z", "value": "..." }
  #     ] } }
  # `params.overrides` is a flat array of {nodeId, component, field,
  # value} quadruples. Captured into four parallel String lists so a
  # `componentGet(world.sceneInstances, e)` round-trip doesn't have to
  # copy a List-of-structs (the C backend's struct-by-list-index
  # path still corrupts those).
  let sid: String = optString(
    doc: doc
    container: val
    key: "sceneId"
    fallback: ""
  )
  let nodeIds: List(String) = List.create(String, cap: 0)
  let components: List(String) = List.create(String, cap: 0)
  let fields: List(String) = List.create(String, cap: 0)
  let values: List(String) = List.create(String, cap: 0)

  let paramsIdx: Int = Json.field(doc: doc, this: val, key: "params")
  if paramsIdx >= 0 {
    let paramsVal: JsonValue = Json.jsonValueAt(doc: doc, idx: paramsIdx)
    let overridesIdx: Int = Json.field(doc: doc, this: paramsVal, key: "overrides")
    if overridesIdx >= 0 {
      let arr: JsonValue = Json.jsonValueAt(doc: doc, idx: overridesIdx)
      let n: Int = Json.arrayLen(this: arr)
      var i: Int = 0
      loop i < n {
        let elem: JsonValue = Json.arrayAt(doc: doc, this: arr, idx: i)
        let empty: String = ""
        let n2: String = optString(
          doc: doc
          container: elem
          key: "nodeId"
          fallback: empty
        )
        let c2: String = optString(
          doc: doc
          container: elem
          key: "component"
          fallback: empty
        )
        let f2: String = optString(
          doc: doc
          container: elem
          key: "field"
          fallback: empty
        )
        let v2: String = optString(
          doc: doc
          container: elem
          key: "value"
          fallback: empty
        )
        nodeIds.add(value: n2)
        components.add(value: c2)
        fields.add(value: f2)
        values.add(value: v2)
        i = i + 1
      }
    }
  }

  ret SceneInstance {
    sceneId: own sid
    overrideNodeIds: own nodeIds
    overrideComponents: own components
    overrideFields: own fields
    overrideValues: own values
  }
}

func deserTextBinding(doc: view JsonDoc, val: view JsonValue) ret TextBinding {
  # `key` is also a reserved keyword. Same workaround.
  let formatStr: String = optString(
    doc: doc
    container: val
    key: "format"
    fallback: "Plain"
  )
  let bk: String = optString(
    doc: doc
    container: val
    key: "key"
    fallback: ""
  )
  let bp: String = optString(
    doc: doc
    container: val
    key: "prefix"
    fallback: ""
  )
  let bs: String = optString(
    doc: doc
    container: val
    key: "suffix"
    fallback: ""
  )
  let bf: TextFormat = parseTextFormat(text: formatStr)
  let r: TextBinding = { key: own bk, format: bf, prefix: own bp, suffix: own bs }
  ret r
}

func deserMaskShape(doc: view JsonDoc, val: view JsonValue) ret MaskShape {
  let kindStr: String = optString(
    doc: doc
    container: val
    key: "kind"
    fallback: "Circle"
  )
  ret MaskShape {
    kind: parseMaskKind(text: kindStr)
    sourceNodeId: optString(
      doc: doc
      container: val
      key: "sourceNodeId"
      fallback: ""
    )
    radius: optFloat(
      doc: doc
      container: val
      key: "radius"
      fallback: 0.0
    )
  }
}

# -----------------------------------------------------------------
# applyComponentByName: dispatch a (name, val) onto the right
# ComponentTable on the world.
# -----------------------------------------------------------------

# ListView (#945): the virtualised-list spec. Shape:
#   { "itemSceneId": "row", "itemKeyField": "id",
#     "itemHeight": 56, "itemGap": 8, "visibleItemCount": 10, "overscanRows": 4,
#     "loadingSceneId": "", "emptySceneId": "", "errorSceneId": "",
#     "bindings": [ { "nodeId": "title", "component": "Text", "field": "text",
#                     "itemField": "trackName", "prefix": "", "suffix": "" } ] }
# `bindings` is an array of {nodeId, component, field, itemField, prefix, suffix};
# each becomes a ListViewBinding. listViewSystem windows the rows and applies the
# bindings per row.
func deserListView(doc: view JsonDoc, val: view JsonValue) ret ListView {
  let empty: String = ""
  let itemSceneId: String = optString(
    doc: doc
    container: val
    key: "itemSceneId"
    fallback: empty
  )
  let itemKeyField: String = optString(
    doc: doc
    container: val
    key: "itemKeyField"
    fallback: empty
  )
  let itemHeight: Float = optFloat(
    doc: doc
    container: val
    key: "itemHeight"
    fallback: 0.0
  )
  let itemGap: Float = optFloat(
    doc: doc
    container: val
    key: "itemGap"
    fallback: 0.0
  )
  let visibleItemCount: Int = optInt(
    doc: doc
    container: val
    key: "visibleItemCount"
    fallback: 0
  )
  let overscanRows: Int = optInt(
    doc: doc
    container: val
    key: "overscanRows"
    fallback: 0
  )
  let loadingSceneId: String = optString(
    doc: doc
    container: val
    key: "loadingSceneId"
    fallback: empty
  )
  let emptySceneId: String = optString(
    doc: doc
    container: val
    key: "emptySceneId"
    fallback: empty
  )
  let errorSceneId: String = optString(
    doc: doc
    container: val
    key: "errorSceneId"
    fallback: empty
  )
  let bindings: List(ListViewBinding) = List.create(ListViewBinding, cap: 4)
  let bindingsIdx: Int = Json.field(doc: doc, this: val, key: "bindings")
  if bindingsIdx >= 0 {
    let arr: JsonValue = Json.jsonValueAt(doc: doc, idx: bindingsIdx)
    let n: Int = Json.arrayLen(this: arr)
    var i: Int = 0
    loop i < n {
      let elem: JsonValue = Json.arrayAt(doc: doc, this: arr, idx: i)
      let b: ListViewBinding = {
        nodeId: optString(
          doc: doc
          container: elem
          key: "nodeId"
          fallback: empty
        )
        componentName: optString(
          doc: doc
          container: elem
          key: "component"
          fallback: empty
        )
        fieldName: optString(
          doc: doc
          container: elem
          key: "field"
          fallback: empty
        )
        itemField: optString(
          doc: doc
          container: elem
          key: "itemField"
          fallback: empty
        )
        prefix: optString(
          doc: doc
          container: elem
          key: "prefix"
          fallback: empty
        )
        suffix: optString(
          doc: doc
          container: elem
          key: "suffix"
          fallback: empty
        )
      }
      bindings.add(value: b)
      i = i + 1
    }
  }
  ret ListView {
    itemSceneId: itemSceneId
    itemKeyField: itemKeyField
    itemHeight: itemHeight
    itemGap: itemGap
    visibleItemCount: visibleItemCount
    overscanRows: overscanRows
    bindings: bindings
    loadingSceneId: loadingSceneId
    emptySceneId: emptySceneId
    errorSceneId: errorSceneId
  }
}
