# ui/TouchStick — the authored touch joystick component (its system is
# lib/ui/touchStickSystem).

# A touch joystick on this node (lib/ui/touchStickSystem): its base is the
# node's laid-out box (the circle inside it), its knob the node's first
# child, moved to follow the finger. A finger pressing within `zoneShare`
# times the base's radius of its middle belongs to the stick until it lifts;
# anywhere else it is the camera's. Shown and hidden like any node (a touch
# frame shows it on a phone).
type TouchStick {
  zoneShare: Float = 1.7
}
