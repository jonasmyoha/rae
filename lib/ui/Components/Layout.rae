# ui/Components: the authored geometry and layout components.

# -----------------------------------------------------------------
# Authored components (persisted in .raescene)
# -----------------------------------------------------------------

# Geometry / layout

# Authored absolute placement. #724: geometry is carried as two Vec2 (top-left
# `position` and `size` extent) instead of loose x/y/w/h floats, so the same
# vector helpers apply to a rect's corner and its extent. The .raescene wire
# format stays flat {x,y,w,h} — the registry fixup bridges it to these fields (#961).
type Rect {
  position: Vec2
  size: Vec2
}

type Size {
  w: SizeAxis
  h: SizeAxis
}

type Layout {
  kind: LayoutType
  gap: Float
  alignMain: AlignKind
  alignCross: AlignKind
  columns: Int
  rowGap: Float
  columnGap: Float
}

type Padding {
  insets: Insets
}

type Margin {
  insets: Insets
}

type SafeArea {
  enabled: Bool = true
  apply: Insets = Insets { l: 1.0, t: 1.0, r: 1.0, b: 1.0 }
  extra: Insets
}

# Art direction (§10 S6). FitMode mirrors CSS object-fit vocabulary:
# contain letterboxes (whole content visible), cover crops (content
# fills the box), fitHeight scales to the box's height whatever its width
# (the sides are cropped on a narrow box and pillarboxed on a wide one: a
# game table that always shows its full height).
enum FitMode { contain, cover, fitHeight }

# Post-layout aspect lock: height is derived from resolved width as
# `h = w / ratio` (ratio = w/h). Applied by fitSystem AFTER layout,
# so siblings do not reflow around the corrected height.
type Aspect {
  ratio: Float = 1.0
}

# Uniform-scale a fixed-design subtree to fit its parent's box,
# centered. The tagged entity and every descendant must carry
# authored fixed Rects (absolute placement) — fitSystem recomputes
# each ComputedRect as `authored Rect * s` so the pass is idempotent.
type ScaleToFit {
  mode: FitMode
}

# A node inside a ScaleToFit stage placed against the visible window instead of
# the stage (fitSystem). Each edge may be pinned: `visible` keeps the node's
# distance from that stage edge but measures it from the visible edge (the
# stage's parent box); `safe` measures it from the visible edge less the
# window's safe inset (the notch, the home bar). Pinning both opposite edges
# stretches the node between them. `bleed` makes the node cover the whole
# visible box (a background that fills pillarbox bars or the cropped band).
enum StageEdgePin { none, visible, safe }

type StageEdge {
  bleed: Bool = false
  top: StageEdgePin = StageEdgePin.none
  bottom: StageEdgePin = StageEdgePin.none
  left: StageEdgePin = StageEdgePin.none
  right: StageEdgePin = StageEdgePin.none
}

type Align {
  x: AlignKind
  y: AlignKind
  hasX: Bool
  hasY: Bool
}

type Offset {
  delta: Vec2
}

# A node's size bounds. Each clamps only when its `has*` is set; a scene sets it by writing the
# bound (`"maxW": 430`), or by writing the `has*` key itself, which then decides.
type Constraints {
  minW: Float
  maxW: Float
  minH: Float
  maxH: Float
  hasMinW: Bool
  hasMaxW: Bool
  hasMinH: Bool
  hasMaxH: Bool
}

# What a node does with content that does not fit (authored `Overflow`, or
# `OverflowPolicy`): `clip` cuts it at the node's box; `scaleToFitY` (Pixi's
# column rule) shrinks a column whose laid-out content is taller than it,
# uniformly about its top center, down to `minScale` (0: no limit). The
# column then owns its TransformFx scale and pivot (fitSystem).
type OverflowPolicy {
  mode: OverflowMode
  minScale: Float = 0.0
}

# Extent-relative horizontal placement for a layout root. See HExtent.
# Only meaningful on parentless roots (the layout entry point reads it);
# ignored on child entities, which are placed by their parent's layout.
type ExtentAnchor {
  h: HExtent
}
