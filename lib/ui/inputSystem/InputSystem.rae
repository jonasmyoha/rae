# Generic ECS pointer input for GPU2D/SDL3 applications.
#
# Hit testing follows reverse paint order and emits semantic action ids from
# OnClick components. Applications use `uiPointerCaptured` to give UI controls
# priority over world/camera input without hard-coding widget identities.
#
# The scroll wheel is ROUTED, not broadcast: each frame `updateUiInput` hands
# the wheel to exactly one consumer — the nearest `ScrollRoot` or `WheelTarget`
# (ui/InputComponents) on the path to the topmost node under the pointer — and
# systems take their share with `uiWheelFor(input, entityId)`. Reading
# `Gpu2d.wheelMove()` directly from two systems made one wheel notch both
# scroll a list and zoom the canvas beside it.
open ui/Ecs
open ui/Components
open ui/Layer
import Gpu2d
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open ui/UiSystems
open ui/buttonSystem/ButtonSystem

type UiPointerState {
  x: Float
  y: Float
  down: Bool
  pressed: Bool
  released: Bool
}

# UI action events are no longer a list on UiInput (#943): they live in the
# `uiActions` EventQueue resource on UiWorld — produced here, drained by the
# app's UI dispatch. UiInput now carries only pointer + hover/press tracking.
type UiInput {
  pointer: UiPointerState
  hoveredEntityId: EntityId
  pressedEntityId: EntityId
  wheel: Float
  wheelTarget: EntityId
}

func createUiInput() pub ret UiInput {
  ret UiInput {
    pointer: UiPointerState {
      x: 0.0
      y: 0.0
      down: false
      pressed: false
      released: false
    }
    hoveredEntityId: noEntity()
    pressedEntityId: noEntity()
    wheel: 0.0
    wheelTarget: noEntity()
  }
}

func uiEntityActive(world: view UiWorld, entityId: view EntityId) ret Bool {
  if componentHas(this: world.actives, entityId: entityId) {
    let active: Active = componentGet(this: world.actives, entityId: entityId)
    ret active.value
  }
  ret true
}

func uiPointInEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  if uiEntityActive(world: world, entityId: entityId) is false {
    ret false
  }
  if componentHas(this: uiSystems.transform2d.worldTransforms, entityId: entityId) is false {
    ret false
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false {
    ret false
  }
  let wt: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  )
  if worldVisualOf(world: world, uiSystems: uiSystems, entityId: entityId).visible is false {
    ret false
  }
  let cr: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entityId: entityId)
  if x < wt.position.x {
    ret false
  }
  if y < wt.position.y {
    ret false
  }
  if x > wt.position.x + cr.size.x * wt.scale.x {
    ret false
  }
  if y > wt.position.y + cr.size.y * wt.scale.y {
    ret false
  }
  ret true
}

func uiHitTestEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret EntityId {
  unsafe {
    if uiEntityActive(world: world, entityId: entityId) is false {
      ret noEntity()
    }
    if componentHas(this: world.childrens, entityId: entityId) {
      let children: view Children => componentView(this: world.childrens, entityId: entityId)
      var i: Int = children.ids.length - 1
      loop i >= 0 {
        let child: EntityId = rae_ext_rae_buf_get(buf: children.ids.data, index: i)
        let hit: EntityId = uiHitTestEntity(
          world: world
          uiSystems: uiSystems
          entityId: child
          x: x
          y: y
        )
        if isNone(this: hit) is false {
          ret hit
        }
        i = i - 1
      }
    }
    if componentHas(this: world.onClicks, entityId: entityId) {
      if uiPointInEntity(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        x: x
        y: y
      ) {
        ret entityId
      }
    }
    ret noEntity()
  }
}

func uiHitTest(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
) pub ret EntityId {
  unsafe {
    let roots: List(EntityId) = collectPaintableRoots(world: world, uiSystems: uiSystems)
    var i: Int = roots.length - 1
    loop i >= 0 {
      let root: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: i)
      if componentHas(this: world.layerRoots, entityId: root) is false {
        let hit: EntityId = uiHitTestEntity(
          world: world
          uiSystems: uiSystems
          entityId: root
          x: x
          y: y
        )
        if isNone(this: hit) is false {
          ret hit
        }
      }
      i = i - 1
    }
    ret noEntity()
  }
}

# One subtree's answer to "who takes the wheel here?". `blocked`: the pointer
# landed on something painted or interactive in this subtree, so nodes painted
# BELOW it (earlier siblings, lower roots) must not see the wheel. `target`: the
# consumer on the path to that node, or none.
type UiWheelRoute {
  blocked: Bool
  target: EntityId
}

func uiWheelConsumerAt(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  if componentHas(this: world.wheelTargets, entityId: entityId) {
    ret uiPointInEntity(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      x: x
      y: y
    )
  }
  if componentHas(this: world.scrollRoots, entityId: entityId) {
    ret uiPointInScrollWindow(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      x: x
      y: y
    )
  }
  ret false
}

# The window a ScrollRoot scrolls inside: its parent's box when it has a laid-out
# parent (the clipped viewport around a Hug content), else its own. The root
# itself is the node that MOVES, so the pointer can be in the window below a
# short list, or above a list scrolled past the top, without being in the root.
func uiPointInScrollWindow(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  if componentHas(this: uiSystems.hierarchy.parents, entityId: entityId) {
    let parent: EntityId = componentGet(this: uiSystems.hierarchy.parents, entityId: entityId).parent
    if componentHas(this: uiSystems.layout.computedRects, entityId: parent) {
      ret uiPointInEntity(
        world: world
        uiSystems: uiSystems
        entityId: parent
        x: x
        y: y
      )
    }
  }
  ret uiPointInEntity(
    world: world
    uiSystems: uiSystems
    entityId: entityId
    x: x
    y: y
  )
}

func uiWheelRouteEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
) ret UiWheelRoute {
  unsafe {
    if uiEntityActive(world: world, entityId: entityId) is false {
      ret UiWheelRoute { blocked: false, target: noEntity() }
    }
    let inside: Bool = uiPointInEntity(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      x: x
      y: y
    )
    # A clipping node hides whatever of its subtree lies outside it: rows
    # scrolled out of a panel must not catch the wheel over the panel above.
    if inside is false and componentHas(this: world.overflows, entityId: entityId) {
      if componentGet(this: world.overflows, entityId: entityId).mode is OverflowMode.clip {
        ret UiWheelRoute { blocked: false, target: noEntity() }
      }
    }
    var route: UiWheelRoute = { blocked: false, target: noEntity() }
    if componentHas(this: world.childrens, entityId: entityId) {
      let children: view Children => componentView(this: world.childrens, entityId: entityId)
      var i: Int = children.ids.length - 1
      loop i >= 0 and route.blocked is false and isNone(this: route.target) {
        let child: EntityId = rae_ext_rae_buf_get(buf: children.ids.data, index: i)
        route = uiWheelRouteEntity(
          world: world
          uiSystems: uiSystems
          entityId: child
          x: x
          y: y
        )
        i = i - 1
      }
    }
    if isNone(this: route.target) {
      if uiWheelConsumerAt(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        x: x
        y: y
      ) {
        ret UiWheelRoute { blocked: true, target: entityId }
      }
    }
    if route.blocked is false and inside {
      if componentHas(this: world.shapes, entityId: entityId) or componentHas(
        this: world.onClicks
        entityId: entityId
      ) {
        route.blocked = true
      }
    }
    ret route
  }
}

# The wheel consumer under (x, y): walk the roots in reverse paint order and
# stop at the first subtree that has one or that paints over the point.
func uiWheelRoute(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
) ret EntityId {
  unsafe {
    let roots: List(EntityId) = collectPaintableRoots(world: world, uiSystems: uiSystems)
    var i: Int = roots.length - 1
    loop i >= 0 {
      let root: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: i)
      if componentHas(this: world.layerRoots, entityId: root) is false {
        let route: UiWheelRoute = uiWheelRouteEntity(
          world: world
          uiSystems: uiSystems
          entityId: root
          x: x
          y: y
        )
        if route.blocked or isNone(this: route.target) is false {
          ret route.target
        }
      }
      i = i - 1
    }
    ret noEntity()
  }
}

# Hand this frame's `wheel` delta to the consumer under `input.pointer`. Called
# by `updateUiInput` with the device's delta; a headless driver calls it with a
# scripted one, so a test goes through the same routing as a real notch.
func routeUiWheel(
  input: mod UiInput
  world: view UiWorld
  uiSystems: view UiSystems
  wheel: view Float
) {
  input.wheel = wheel
  input.wheelTarget = noEntity()
  if wheel is not 0.0 {
    input.wheelTarget = uiWheelRoute(
      world: world
      uiSystems: uiSystems
      x: input.pointer.x
      y: input.pointer.y
    )
  }
}

func updateUiInput(input: mod UiInput, world: mod UiWorld, uiSystems: mod UiSystems) pub {
  # Recycle last frame's action channel: frameAdvance swaps in the empty spare so
  # this frame's input produces into a clean queue (the old clearUiActions).
  frameAdvance(this: world.uiActions)
  # Clear last frame's per-entity marks before recomputing (previous hovered +
  # pressed are the only two that can carry an Interaction).
  buttonInteractionClear(world: world, uiSystems: uiSystems, entityId: input.hoveredEntityId)
  buttonInteractionClear(world: world, uiSystems: uiSystems, entityId: input.pressedEntityId)

  let x: Float = Gpu2d.pointerX()
  let y: Float = Gpu2d.pointerY()
  let pressed: Bool = Gpu2d.pointerPressed()
  let released: Bool = Gpu2d.pointerReleased()
  input.pointer = UiPointerState {
    x: x
    y: y
    down: Gpu2d.pointerDown()
    pressed: pressed
    released: released
  }
  input.hoveredEntityId = uiHitTest(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
  )
  routeUiWheel(
    input: input
    world: world
    uiSystems: uiSystems
    wheel: Gpu2d.wheelMove()
  )
  if pressed {
    input.pressedEntityId = input.hoveredEntityId
  }
  if released {
    if isNone(this: input.hoveredEntityId) is false {
      if input.hoveredEntityId is input.pressedEntityId {
        let click: OnClick = componentGet(this: world.onClicks, entityId: input.hoveredEntityId)
        eventSend(
          this: world.uiActions
          value: UiAction { entityId: input.hoveredEntityId, actionId: click.actionId }
        )
      }
    }
    input.pressedEntityId = noEntity()
  }

  # Project this frame's hovered/pressed refs onto the entities as components.
  buttonInteractionMark(
    world: world
    uiSystems: uiSystems
    entityId: input.hoveredEntityId
    hovered: true
    pressed: false
  )
  buttonInteractionMark(
    world: world
    uiSystems: uiSystems
    entityId: input.pressedEntityId
    hovered: false
    pressed: true
  )
}

# Drop the in-progress press and anything already queued, so a release cannot
# turn into a click. Used when an overlay drawn OUTSIDE this world took the
# press — the debug overlay sits over the side panel in 110 and 113, and without
# this the same click would work the button underneath it too.
func suppressUiPress(input: mod UiInput, world: mod UiWorld) {
  eventClear(this: world.uiActions)
  input.pressedEntityId = noEntity()
  input.wheel = 0.0
  input.wheelTarget = noEntity()
}

func uiPointerCaptured(input: view UiInput) pub ret Bool {
  if isNone(this: input.hoveredEntityId) is false {
    ret true
  }
  if isNone(this: input.pressedEntityId) is false {
    ret true
  }
  ret false
}

# This frame's wheel delta if it was routed to `entityId`, else 0. The one way a
# system reads the wheel: a canvas zooms by `uiWheelFor(input, canvas)`, a list
# scrolls by `uiWheelFor(input, list)`, and at most one of them is non-zero.
func uiWheelFor(input: view UiInput, entityId: view EntityId) ret Float {
  if isNone(this: entityId) or input.wheelTarget is not entityId {
    ret 0.0
  }
  ret input.wheel
}
