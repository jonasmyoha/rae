# Generic ECS pointer input for GPU2D/SDL3 applications.
#
# Hit testing follows reverse paint order and emits semantic action ids from
# OnClick components. Applications use `uiPointerCaptured` to give UI controls
# priority over world/camera input without hard-coding widget identities.
open ui/Ecs
open ui/Layer
import Gpu2d
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open ui/UiSystems
open ui/buttonSystem/ButtonSystem

type UiPointerState {
  x: Float
  y: Float
  down: Bool
  pressed: Bool
  released: Bool
}

# UI action events are no longer a list on UiInput (#943): they live in the
# `uiActions` EventQueue resource on UiWorld — produced here, drained by the
# app's UI dispatch. UiInput now carries only pointer + hover/press tracking.
type UiInput {
  pointer: UiPointerState
  hoveredEntity: EntityId
  pressedEntity: EntityId
}

func createUiInput() pub ret UiInput {
  ret UiInput {
    pointer: UiPointerState {
      x: 0.0
      y: 0.0
      down: false
      pressed: false
      released: false
    }
    hoveredEntity: noEntity()
    pressedEntity: noEntity()
  }
}

func uiEntityActive(world: view UiWorld, entity: view EntityId) ret Bool {
  if componentHas(this: world.actives, entity: entity) {
    let active: Active = componentGet(this: world.actives, entity: entity)
    ret active.value
  }
  ret true
}

func uiPointInEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  if uiEntityActive(world: world, entity: entity) is false {
    ret false
  }
  if componentHas(this: uiSystems.transform2d.worldTransforms, entity: entity) is false {
    ret false
  }
  if componentHas(this: uiSystems.layout.computedRects, entity: entity) is false {
    ret false
  }
  let wt: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entity: entity
  )
  if worldVisualOf(world: world, uiSystems: uiSystems, entity: entity).visible is false {
    ret false
  }
  let cr: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: entity)
  if x < wt.position.x {
    ret false
  }
  if y < wt.position.y {
    ret false
  }
  if x > wt.position.x + cr.size.x * wt.scale.x {
    ret false
  }
  if y > wt.position.y + cr.size.y * wt.scale.y {
    ret false
  }
  ret true
}

func uiHitTestEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  x: view Float
  y: view Float
) ret EntityId {
  unsafe {
    if uiEntityActive(world: world, entity: entity) is false {
      ret noEntity()
    }
    if componentHas(this: world.childrens, entity: entity) {
      let children: view Children => componentView(this: world.childrens, entity: entity)
      var i: Int = children.ids.length - 1
      loop i >= 0 {
        let child: EntityId = rae_ext_rae_buf_get(buf: children.ids.data, index: i)
        let hit: EntityId = uiHitTestEntity(
          world: world
          uiSystems: uiSystems
          entity: child
          x: x
          y: y
        )
        if isNone(this: hit) is false {
          ret hit
        }
        i = i - 1
      }
    }
    if componentHas(this: world.onClicks, entity: entity) {
      if uiPointInEntity(
        world: world
        uiSystems: uiSystems
        entity: entity
        x: x
        y: y
      ) {
        ret entity
      }
    }
    ret noEntity()
  }
}

func uiHitTest(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
) pub ret EntityId {
  unsafe {
    let roots: List(EntityId) = collectPaintableRoots(world: world, uiSystems: uiSystems)
    var i: Int = roots.length - 1
    loop i >= 0 {
      let root: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: i)
      if componentHas(this: world.layerRoots, entity: root) is false {
        let hit: EntityId = uiHitTestEntity(
          world: world
          uiSystems: uiSystems
          entity: root
          x: x
          y: y
        )
        if isNone(this: hit) is false {
          ret hit
        }
      }
      i = i - 1
    }
    ret noEntity()
  }
}

func updateUiInput(input: mod UiInput, world: mod UiWorld, uiSystems: mod UiSystems) pub {
  # Recycle last frame's action channel: frameAdvance swaps in the empty spare so
  # this frame's input produces into a clean queue (the old clearUiActions).
  frameAdvance(this: world.uiActions)
  # Clear last frame's per-entity marks before recomputing (previous hovered +
  # pressed are the only two that can carry an Interaction).
  buttonInteractionClear(world: world, uiSystems: uiSystems, entity: input.hoveredEntity)
  buttonInteractionClear(world: world, uiSystems: uiSystems, entity: input.pressedEntity)

  let x: Float = Gpu2d.pointerX()
  let y: Float = Gpu2d.pointerY()
  let pressed: Bool = Gpu2d.pointerPressed()
  let released: Bool = Gpu2d.pointerReleased()
  input.pointer = UiPointerState {
    x: x
    y: y
    down: Gpu2d.pointerDown()
    pressed: pressed
    released: released
  }
  input.hoveredEntity = uiHitTest(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
  )
  if pressed {
    input.pressedEntity = input.hoveredEntity
  }
  if released {
    if isNone(this: input.hoveredEntity) is false {
      if input.hoveredEntity is input.pressedEntity {
        let click: OnClick = componentGet(this: world.onClicks, entity: input.hoveredEntity)
        eventSend(
          this: world.uiActions
          value: UiAction { entity: input.hoveredEntity, actionId: click.actionId }
        )
      }
    }
    input.pressedEntity = noEntity()
  }

  # Project this frame's hovered/pressed refs onto the entities as components.
  buttonInteractionMark(
    world: world
    uiSystems: uiSystems
    entity: input.hoveredEntity
    hovered: true
    pressed: false
  )
  buttonInteractionMark(
    world: world
    uiSystems: uiSystems
    entity: input.pressedEntity
    hovered: false
    pressed: true
  )
}

# Drop the in-progress press and anything already queued, so a release cannot
# turn into a click. Used when an overlay drawn OUTSIDE this world took the
# press — the debug overlay sits over the side panel in 110 and 113, and without
# this the same click would work the button underneath it too.
func suppressUiPress(input: mod UiInput, world: mod UiWorld) {
  eventClear(this: world.uiActions)
  input.pressedEntity = noEntity()
}

func uiPointerCaptured(input: view UiInput) pub ret Bool {
  if isNone(this: input.hoveredEntity) is false {
    ret true
  }
  if isNone(this: input.pressedEntity) is false {
    ret true
  }
  ret false
}
