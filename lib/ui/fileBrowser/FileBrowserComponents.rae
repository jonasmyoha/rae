# The file browser's data (docs/file-browser-design.md §4). A browser is an entity (the node it is
# in),
# a column is an entity (the root of its scene); a file on the disk never is. The tables are on
# FileBrowserSystems, which an app owns next to its UiWorld.
import FileNotify
import Files
open Channel
open Signal
open collections/StringMap
open ecs/ComponentTable
open ecs/Entity
open ecs/Event
open ui/SelectionComponents
open ui/fileBrowser/FileKinds
open ui/fileBrowser/FolderListing
open ui/fileBrowser/OperationThread

enum BrowserSource { disk, app }

# What Return does on a row
enum BrowserReturnKey { rename, open }

type BrowserOptions {
  order: EntryOrder = {}
  showHidden: Bool = false
  # Lowercase, without dots; none for any. Folders always show.
  extensions: List(String) = {}
  returnKey: BrowserReturnKey = BrowserReturnKey.rename
  # May it go above its root
  allowAboveRoot: Bool = false
  # false: look and pick only
  allowOperations: Bool = true
  showBar: Bool = true
  showPreview: Bool = true
  # Files opened often get a tint (the app's counts, countOpened)
  openCountTint: Bool = false
  columnWidth: Float = 220.0
  previewWidth: Float = 260.0
  # none: it is walked by its bar and by the program only
  selection: ListSelectMode = ListSelectMode.multiple
  rowHeight: Float = 24.0
  source: BrowserSource = BrowserSource.disk
}

# A browser written in a scene, on the node it is to fill (its options by their names; the order's
# fields too):
#
#     "Files": { "FileBrowser": { "root": "~/Projects", "showHidden": true, "orderBy": "modified" }
#     }
#
# fileBrowserUpdate opens it, and opens it anew when the component is changed.
type FileBrowser {
  root: String = "~"
  orderBy: EntryOrderBy = EntryOrderBy.name
  descending: Bool = false
  foldersFirst: Bool = true
  showHidden: Bool = false
  extensions: List(String) = {}
  selection: ListSelectMode = ListSelectMode.multiple
  returnKey: BrowserReturnKey = BrowserReturnKey.rename
  allowAboveRoot: Bool = false
  allowOperations: Bool = true
  showBar: Bool = true
  showPreview: Bool = true
  openCountTint: Bool = false
  columnWidth: Float = 220.0
  previewWidth: Float = 260.0
  rowHeight: Float = 24.0
  source: BrowserSource = BrowserSource.disk
}

# The authored browsers, alone in a struct: the components a scene may name (applyComponentInto)
type AuthoredBrowsers {
  fileBrowsers: ComponentTable(FileBrowser)
}

# Which selection was looked at: a column's, by how often it and the column's entries had changed
type SelectionSeen {
  column: EntityId = noEntity()
  selected: Int = -1
  entries: Int = -1
}

type OpenBrowser {
  root: String
  options: BrowserOptions
  # Its nodes: the mounted scene, the strip that scrolls and its window, the bar's parts
  scene: EntityId = noEntity()
  strip: EntityId = noEntity()
  stripWindow: EntityId = noEntity()
  bar: EntityId = noEntity()
  back: EntityId = noEntity()
  forward: EntityId = noEntity()
  trail: EntityId = noEntity()
  # what its operations' rows are in
  operations: EntityId = noEntity()
  pathBox: EntityId = noEntity()
  pathField: EntityId = noEntity()
  # The action the path field sends on Return
  pathAction: String = ""
  # Its columns, left to right
  columns: List(EntityId) = {}
  # Their widths by place, 0 for the option's
  widths: List(Float) = {}
  # The column to be scrolled into view (its place; one past the last: the preview's), -1 none
  reveal: Int = -1
  # The column whose selected folder opens at `openAt` (below 0 none does)
  openAt: Float64 = -1.0
  openColumn: EntityId = noEntity()
  # What the app was told, and what the bar shows
  toldFolder: String = ""
  toldPaths: List(String) = {}
  # The selection looked at last
  seen: SelectionSeen = {}
  barShown: String = ""
  # The change of its authored component that it was opened from (-1: opened by the program)
  authoredStamp: Int = -1
}

enum ColumnState {
  listing
  ready
  noPermission
  gone
  notAnswering
  outside
  failed
}

type FileColumn {
  browser: EntityId
  place: Int
  folder: String
  state: ColumnState = ColumnState.listing
  # Its listing: the number of the request, when it was asked, whether another must follow, and
  # whether it ever had an answer
  generation: Int = 0
  askedSeconds: Float64 = 0.0
  stale: Bool = true
  listed: Bool = false
  # Its nodes
  body: EntityId = noEntity()
  list: EntityId = noEntity()
  divider: EntityId = noEntity()
  stateBox: EntityId = noEntity()
  # The entry whose column is open to the right, and what is to be selected when the rows come (or
  # the first of them)
  openChild: String = ""
  wantSelected: List(String) = {}
  wantFirst: Bool = false
  # the entry whose name is to be edited when the rows come
  wantRename: String = ""
  wantScroll: Float = 0.0
  # Counts up with each change of its entries; what the rows were made from
  entriesStamp: Int = 0
  rowsStamp: Int = -1
  # Its own path on the disk, with symlinks followed ("" not known yet)
  realFolder: String = ""
  # When the folder was changed last, before its listing read it (folderStamp)
  modified: Int = -1
  # The volume it is on (0 not known)
  device: Int = 0
  # What its state box shows
  stateShown: String = "-"
}

# The entries shown, in order
type ColumnEntries {
  entries: List(FileEntry) = {}
}

type FolderMemory {
  scroll: Float = 0.0
  selected: List(String) = {}
}

type BrowserHistory {
  # Folders the browser was at, and which it is at now
  folders: List(String) = {}
  at: Int = -1
  memory: StringMap(FolderMemory)
  # Folders of `memory`, the one kept longest first
  kept: List(String) = {}
}

# What a preview shows
type PreviewContent {
  # "" nothing
  stamp: String = ""
  path: String = ""
  name: String = ""
  kind: String = ""
  icon: String = ""
  size: String = ""
  changed: String = ""
  bytes: Int = 0
  modifiedMs: Int = 0
  picture: Bool = false
  byProgram: Bool = false
}

type BrowserPreview {
  # The preview column's node, and what it shows ("" nothing)
  node: EntityId = noEntity()
  shown: String = ""
  # What it was made from
  content: PreviewContent = {}
  seen: SelectionSeen = {}
  # The large preview's node, and what it shows
  large: EntityId = noEntity()
  largeShown: String = ""
}

# A part of the trail: the folder a click on it goes to
type TrailPart {
  browser: EntityId
  folder: String
}

# The column of a list, and the browser of a button or a field
type ListOfColumn {
  column: EntityId
}

enum BrowserButton { back, forward, trail, retry }

type ButtonOfBrowser {
  browser: EntityId
  button: BrowserButton
  # the column of a Retry button
  column: EntityId = noEntity()
}

# ----- listing -----------------------------------------------------------------
# A listing's thread
type FolderJob {
  generation: Int
  task: opt Task(Int)
}

type ListingJobs {
  answers: Channel(FolderAnswer)
  jobs: List(FolderJob) = {}
  waiting: List(FolderRequest) = {}
  nextGeneration: Int = 1
}

# A folder watched, and when a change was last acted on
type FolderWatch {
  folder: String
  notify: FileNotify.FileNotify
  lastSeconds: Float64 = -10.0
  changed: Bool = false
}

# The shown folders no notification comes for, and the thread that looks when they changed
type FolderPolling {
  answers: Channel(FolderStamps)
  folders: List(String) = {}
  # The thread, when one runs
  jobs: List(FolderJob) = {}
  # The window had the focus; when to look next while it has
  focused: Bool = false
  nextSeconds: Float64 = 0.0
}

# ----- operations ------------------------------------------------------------------
enum OperationJobState {
  waiting
  running
  # in the way of something: an answer is needed
  asking
  # what it was to trash has no trash: delete for good?
  deleting
  # over, with something to be told
  notice
}

type OperationJob {
  number: Int
  # who asked, and the folder what it makes is selected in ("" none)
  browser: EntityId
  folder: String
  kind: OperationKind
  # its items
  count: Int
  operation: FileOperation
  byVolume: Bool = false
  state: OperationJobState = OperationJobState.waiting
  undoing: Bool = false
  redoing: Bool = false
  startedSeconds: Float64 = 0.0
  # how far it is
  index: Int = 0
  bytesDone: Int = 0
  bytesTotal: Int = 0
  # asking: what would be put there, and what has the name
  source: String = ""
  target: String = ""
  # deleting: what has no trash
  paths: List(String) = {}
  # notice
  message: String = ""
  commands: Channel(OperationCommand)
  signal: Signal
  task: opt Task(Int) = none
}

# What undoes one operation
type UndoRecord {
  steps: List(UndoStep) = {}
}

# The dialog of the operation that asks
type OperationQuestion {
  node: EntityId = noEntity()
  number: Int = 0
  # what it asks
  asked: String = ""
  # the answer is for all of its items
  forAll: Bool = false
}

type FileOperations {
  # What every operation is held to (an app's own trash folder, a limit)
  rules: OperationRules
  updates: Channel(OperationUpdate)
  jobs: List(OperationJob) = {}
  lastNumber: Int = 0
  # the last is the newest
  undo: List(UndoRecord) = {}
  redo: List(UndoRecord) = {}
  # what was copied last
  clipboard: List(String) = {}
  question: OperationQuestion = {}
}

# A row at the bottom of a browser: an operation's progress, or what did not work
type OperationRow {
  number: Int
  stop: EntityId
  shown: String = ""
}

# A name being edited, on its column
type RenameEdit {
  name: String
  node: EntityId
  field: EntityId
  # what the field sends on Return
  action: String
}

# An item an app adds to the context menu, where it fits: one file or folder (`extensions`
# lowercase,
# without dots, none for any), several of them, or a column's empty space. Choosing it sends
# BrowserMenuChosen.
type BrowserMenuItem {
  id: String = ""
  text: String = ""
  icon: String = ""
  shortcut: String = ""
  enabled: Bool = true
  files: Bool = true
  folders: Bool = false
  extensions: List(String) = {}
  several: Bool = false
  background: Bool = false
}

# ----- events --------------------------------------------------------------------

# The deepest column's folder
type FolderOpened {
  browser: EntityId
  folder: String
}

type FileActivated {
  browser: EntityId
  paths: List(String)
}

type SelectionChanged {
  browser: EntityId
  paths: List(String)
}

# A browser with the `app` source wants a folder's entries (setColumnEntries)
type EntriesRequested {
  browser: EntityId
  folder: String
}

# An operation needs an answer (answerOperation): a name is taken, or (kind delete) what was to be
# trashed has no trash. The browser asks by a dialog; a program may answer instead.
type OperationAsked {
  browser: EntityId
  number: Int
  kind: OperationKind
  source: String = ""
  target: String = ""
}

# An operation is over: what came of each of its items. `undone`: it was an undo or a redo.
type OperationDone {
  browser: EntityId
  number: Int
  kind: OperationKind
  results: List(ItemResult) = {}
  undone: Bool = false
}

# A browser with the `app` source asks the program for an operation
type OperationRequested {
  browser: EntityId
  kind: OperationKind
  paths: List(String) = {}
  folder: String = ""
  name: String = ""
}

# Paths were dropped on a browser, by a drag or (`external`) by the OS; the operation is begun
type FilesDropped {
  browser: EntityId
  folder: String
  paths: List(String) = {}
  external: Bool = false
  moved: Bool = false
}

# One of the app's own menu items was chosen
type BrowserMenuChosen {
  browser: EntityId
  itemId: String
  folder: String
  paths: List(String) = {}
}

type FileBrowserSystems {
  authored: AuthoredBrowsers
  browsers: ComponentTable(OpenBrowser)
  columns: ComponentTable(FileColumn)
  entries: ComponentTable(ColumnEntries)
  history: ComponentTable(BrowserHistory)
  previews: ComponentTable(BrowserPreview)
  trailParts: ComponentTable(TrailPart)
  columnOfList: ComponentTable(ListOfColumn)
  buttons: ComponentTable(ButtonOfBrowser)
  renames: ComponentTable(RenameEdit)
  operationRows: ComponentTable(OperationRow)
  # resources, shared by every browser of the app
  listing: ListingJobs
  watches: List(FolderWatch) = {}
  polling: FolderPolling
  # columns came or went since the watches were set up
  watchesStale: Bool = false
  browsersMade: Int = 0
  kinds: List(FileKind)
  # the app's own items of the context menu
  menuItems: List(BrowserMenuItem) = {}
  operations: FileOperations
  # Escape is an edited name's
  escapeHeld: Bool = false
  # A drag over the browsers (ui/fileBrowser/FileDragSystem): the row or the column marked, the
  # folder it
  # is held on and when that opens, and the browser whose own entries are dragged
  dropRow: EntityId = noEntity()
  dropColumn: EntityId = noEntity()
  dragOpenFolder: String = ""
  dragOpenAt: Float64 = -1.0
  dragBrowser: EntityId = noEntity()
  openCounts: StringMap(Int)
  openCountsStamp: Int = 0
  now: Float64 = 0.0
  folderOpened: EventQueue(FolderOpened)
  fileActivated: EventQueue(FileActivated)
  selectionChanged: EventQueue(SelectionChanged)
  entriesRequested: EventQueue(EntriesRequested)
  operationAsked: EventQueue(OperationAsked)
  operationDone: EventQueue(OperationDone)
  operationRequested: EventQueue(OperationRequested)
  browserMenuChosen: EventQueue(BrowserMenuChosen)
  filesDropped: EventQueue(FilesDropped)
}

func createFileBrowsers() ret FileBrowserSystems {
  ret FileBrowserSystems {
    authored: AuthoredBrowsers { fileBrowsers: ComponentTable.create(FileBrowser) }
    polling: FolderPolling { answers: createChannel(FolderStamps) }
    browsers: ComponentTable.create(OpenBrowser)
    columns: ComponentTable.create(FileColumn)
    entries: ComponentTable.create(ColumnEntries)
    history: ComponentTable.create(BrowserHistory)
    previews: ComponentTable.create(BrowserPreview)
    trailParts: ComponentTable.create(TrailPart)
    columnOfList: ComponentTable.create(ListOfColumn)
    buttons: ComponentTable.create(ButtonOfBrowser)
    renames: ComponentTable.create(RenameEdit)
    operationRows: ComponentTable.create(OperationRow)
    operations: FileOperations {
      rules: Files.operationRules()
      updates: createChannel(OperationUpdate)
    }
    listing: ListingJobs { answers: createChannel(FolderAnswer) }
    kinds: defaultFileKinds()
    openCounts: createStringMap(Int, cap: 64)
    folderOpened: createEventQueue(FolderOpened)
    fileActivated: createEventQueue(FileActivated)
    selectionChanged: createEventQueue(SelectionChanged)
    entriesRequested: createEventQueue(EntriesRequested)
    operationAsked: createEventQueue(OperationAsked)
    operationDone: createEventQueue(OperationDone)
    operationRequested: createEventQueue(OperationRequested)
    browserMenuChosen: createEventQueue(BrowserMenuChosen)
    filesDropped: createEventQueue(FilesDropped)
  }
}

# This frame's keys of the browser that has them (the rows' own are ui/ListSelectionSystem's;
# browserKeysFromDevice reads them)
type BrowserKeys {
  # Cmd with O or Down, Up, [ and ], and with Shift and the period
  open: Bool = false
  parent: Bool = false
  back: Bool = false
  forward: Bool = false
  hidden: Bool = false
  space: Bool = false
  escape: Bool = false
  # Return: the answer of the dialog that changes nothing
  confirm: Bool = false
  # Cmd with Shift and N, D, C, V, Alt and V, Backspace, Z, Shift and Z
  newFolder: Bool = false
  duplicate: Bool = false
  copyFiles: Bool = false
  paste: Bool = false
  pasteMove: Bool = false
  trash: Bool = false
  undo: Bool = false
  redo: Bool = false
}

# What an app saves of a browser (fileBrowserState), and gives back (restoreFileBrowser)
type FileBrowserState {
  folder: String = ""
  selected: List(String) = {}
  widths: List(Float) = {}
  order: EntryOrder = {}
  showHidden: Bool = false
}
