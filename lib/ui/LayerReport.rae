# ui/LayerReport — what is drawn in which layer, as text (docs/ui-layers-design.md §12): every
# layer of a window's stack in paint order, with its order and flags, then what is in it: each
# world's roots (their z, whether they show anything) and the program's draws (their kind, z,
# area, whether they hit-test, block input or are hidden). For a debug page, a log line or a test.
#
#   log(layerReport(stack: stack, contributions: contributions))
#
# The contributions are read as the last refresh left them (refreshLayerContribution).
open ecs/Entity
open ui/UiLayers

# A layer's flags as words ("modal, dismissOnOutsideTap"), "" for none
func layerFlagsText(layer: view UiLayer) ret String {
  var text: String = ""
  if layer.modal {
    text = "{text}, modal"
  }
  if layer.dismissOnOutsideTap {
    text = "{text}, dismissOnOutsideTap"
  }
  if layer.hidesBelow {
    text = "{text}, hidesBelow"
  }
  if layer.safeArea {
    text = "{text}, safeArea"
  }
  if layer.isolated {
    text = "{text}, isolated"
  }
  if layer.shows is LayerShows.gameMode {
    text = "{text}, game mode only"
  } else if layer.shows is LayerShows.editorMode {
    text = "{text}, editor mode only"
  }
  if layer.opacity is not 1.0 {
    text = "{text}, opacity {layer.opacity}"
  }
  if layer.offsetX is not 0.0 or layer.offsetY is not 0.0 {
    text = "{text}, offset {layer.offsetX},{layer.offsetY}"
  }
  if text.length() > 2 {
    ret text.sub(start: 2, len: text.length() - 2)
  }
  ret ""
}

func drawKindText(kind: view LayerDrawKind) ret String {
  if kind is LayerDrawKind.worldLabels {
    ret "world labels"
  }
  if kind is LayerDrawKind.logStrip {
    ret "log strip"
  }
  if kind is LayerDrawKind.debugReadout {
    ret "debug readout"
  }
  ret "app"
}

# One draw as text
func layerDrawText(index: view Int, draw: view LayerDraw) ret String {
  var text: String = "draw {index}: {drawKindText(kind: draw.kind)}"
  if draw.kind is LayerDrawKind.app {
    text = "{text} {draw.appKind}"
  }
  text = "{text}, z {draw.z}"
  if draw.areaW > 0.0 and draw.areaH > 0.0 {
    text = "{text}, area {draw.areaX},{draw.areaY} {draw.areaW}x{draw.areaH}"
  }
  if draw.hit {
    text = "{text}, a surface"
  }
  if draw.modal {
    text = "{text}, modal"
  }
  if not draw.active {
    text = "{text}, hidden"
  }
  ret text
}

# One line of the report: a layer (its order, name and flags), or what is in one (a world's root,
# with its node, or a draw)
type LayerReportRow {
  text: String
  # the layer's id, on every row (-1 on the header and the notes)
  layer: Int = -1
  isLayer: Bool = false
  # the root's node; none on a layer, a draw or a note
  entityId: EntityId = { index: -1, generation: 0 }
  # the draw's index in the stack (-1 on anything else)
  draw: Int = -1
}

# Every layer in paint order and what is in it, a row each: the header, then each layer (marked
# empty when nothing is in it) followed by its draws and its roots, then a note per world with
# roots on a layer the stack has not. Its text is layerReport's.
func layerReportRows(
  stack: view LayerStack
  contributions: view List(LayerContribution)
) ret List(LayerReportRow) {
  var rows: List(LayerReportRow) = {}
  rows.add(
    value: LayerReportRow {
      text: "layers, bottom first ({stack.layers.length}, {stack.worlds.length} worlds, {stack.draws.length} draws, generation {stack.generation}):"
    }
  )
  loop var position: Int = 0, position < stack.layers.length, ++position {
    let layer: UiLayer = stack.layers.copyAtFallback(
      index: position
      fallback: UiLayer { name: "", order: 0 }
    )
    let flags: String = layerFlagsText(layer: layer)
    var line: String = "{layer.order} {layer.name}"
    if flags.length() > 0 {
      line = "{line} ({flags})"
    }
    let layerRow: Int = rows.length
    rows.add(value: LayerReportRow { text: line, layer: layer.id, isLayer: true })
    var items: Int = 0
    loop let index: view Int in stack.drawOrder {
      if let draw: view LayerDraw = stack.draws.viewAt(index: index) {
        if draw.layer is layer.id {
          rows.add(
            value: LayerReportRow {
              text: "  {layerDrawText(index: index, draw: draw)}"
              layer: layer.id
              draw: index
            }
          )
          items = items + 1
        }
      }
    }
    loop let contribution: view LayerContribution in contributions {
      loop let entry: view LayerEntry in contribution.entries {
        if entry.layer is layer.id {
          var shown: String = "shown"
          if not entry.shown {
            shown = "hidden"
          }
          rows.add(
            value: LayerReportRow {
              text: "  world {contribution.worldKey} root {entry.entityId.index}.{entry.entityId.generation}, z {entry.z}, {shown}"
              layer: layer.id
              entityId: entry.entityId
            }
          )
          items = items + 1
        }
      }
    }
    if items is 0 {
      if let row: mod LayerReportRow = rows.modAt(index: layerRow) {
        row.text = "{row.text}: empty"
      }
    }
  }
  loop let contribution: view LayerContribution in contributions {
    if contribution.unknownLayers > 0 {
      rows.add(
        value: LayerReportRow {
          text: "world {contribution.worldKey}: {contribution.unknownLayers} roots name a layer the stack has not (painted in hud)"
        }
      )
    }
  }
  ret rows
}

# Every layer in paint order and what is in it, one line each (layerReportRows' text)
func layerReport(stack: view LayerStack, contributions: view List(LayerContribution)) ret String {
  var text: String = ""
  loop let row: view LayerReportRow in layerReportRows(stack: stack, contributions: contributions) {
    if text.length() > 0 {
      text = "{text}\n{row.text}"
    } else {
      text = "{row.text}"
    }
  }
  ret text
}
