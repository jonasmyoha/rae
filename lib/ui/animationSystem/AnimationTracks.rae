# animationSystem's tracks (docs/ui-animation-design.md section 5): what is moving, and the only
# writer of AnimationPose. Others ask through the inbox with animationPlay, animationTo and
# animationLeave. A command on an entity with a track retargets it from its current value and
# velocity, which is what makes everything interruptible.
#
# Each channel runs on its own, and a track ends when all of them are at rest. Its pose then goes
# too, unless it ended somewhere other than the node's place. With no command and no track
# animationRun returns at once: an idle UI runs no animation code, and the host's wait sees
# animationInFlight false.
import ReduceMotion
import Sys
open ecs/ComponentTable
open ecs/Entity
open ecs/Queue
open ecs/hierarchySystem/HierarchySystem
open ui/Components
open ui/Ecs
open ui/ScenePolicy
open ui/ThemeResolved
open ui/UiSystems
open ui/animationSystem/AnimationRules
open ui/animationSystem/AnimationTriggers
open ui/animationSystem/LoopMotion

# Each world steps by the real frame time, but never more than this: a long frame slows a motion and
# never skips it
const animationMaxStep: Float = 0.05

# No time passes on a motion's first frame, so its start pose is what the first paint shows
const animationFirstStep: Float = 0.0

# The motion an unknown name falls back to, after its diagnostic
const animationFallbackMotion: String = "smooth"

enum AnimationPhase { appearing, moving, leaving }

# What happens to the node when its track ends
enum AnimationEnd { stay, deactivate, destroy, destroySubtree }

type AnimationTrack {
  opacity: AnimationChannel
  scale: AnimationChannel
  x: AnimationChannel
  y: AnimationChannel
  rotation: AnimationChannel
  stretchY: AnimationChannel
  delayLeft: Float
  phase: AnimationPhase
  onEnd: AnimationEnd
  # A finger has it: it does not step, and only pageTransitionDrag moves it
  paused: Bool = false
}

type AnimationCommand {
  entityId: EntityId
  # Start from this pose; else from where the node is now
  hasFrom: Bool
  from: AnimationPose
  to: AnimationPose
  motion: String
  opacityMotion: String
  delaySeconds: Float
  phase: AnimationPhase
  onEnd: AnimationEnd
  # A layout glide: add (glideX, glideY) to where the node is now, and spring x and y back
  isGlide: Bool = false
  glideX: Float = 0.0
  glideY: Float = 0.0
  # Above 0: the opacity motion's curve takes this long (a page's fade hangs on its transition's
  # length)
  opacitySeconds: Float = 0.0
  # Above 0: the Appear of the nodes under this one wait this long (a page's share of its
  # transition)
  appearsWait: Float = 0.0
  # A fling (animationFling): the track starts at `from` even if one is running, at this speed
  hasVelocity: Bool = false
  velocity: AnimationVelocity = {}
}

# The settings a run was started with
func animationSettingsFromEnv() ret AnimationSettings {
  var settings: AnimationSettings = parseAnimationSettings(
    animation: Sys.getEnv(name: "RAE_ANIMATION")
    hold: Sys.getEnv(name: "RAE_ANIMATION_HOLD")
  )
  applyReduceMotionEnv(settings: settings, value: Sys.getEnv(name: "RAE_REDUCE_MOTION"))
  ret settings
}

# True while something moves or waits to start. A held animation is not in flight: it has stopped,
# and a test may take its picture.
func animationInFlight(world: view UiWorld, uiSystems: view UiSystems) ret Bool {
  if world.animationRequests.length > 0 or queueIsEmpty(this: uiSystems.animation.commands) is false {
    ret true
  }
  ret uiSystems.animation.settings.hold < 0.0 and (componentCount(
    this: uiSystems.animation.sharedNodes
  ) > 0 or componentCount(this: uiSystems.animation.tracks) > 0 or componentCount(
    this: uiSystems.animation.textGhosts
  ) > 0 or componentCount(this: uiSystems.animation.focusFades) > 0 or componentCount(
    this: uiSystems.animation.loopRuns
  ) > 0)
}

# Arrive at normal place and look from pose `from`, after `delaySeconds`
func animationPlay(
  uiSystems: mod UiSystems
  entityId: view EntityId
  from: view AnimationPose
  motion: view String
  opacityMotion: view String
  delaySeconds: view Float
) {
  enqueue(
    this: uiSystems.animation.commands
    value: AnimationCommand {
      entityId: entityId
      hasFrom: true
      from: from
      to: AnimationPose {}
      motion: motion
      opacityMotion: opacityMotion
      delaySeconds: delaySeconds
      phase: AnimationPhase.appearing
      onEnd: AnimationEnd.stay
    }
  )
}

# Move from where the node is now to pose `to`, and stay there
func animationTo(
  uiSystems: mod UiSystems
  entityId: view EntityId
  to: view AnimationPose
  motion: view String
  opacityMotion: view String
  delaySeconds: view Float
) {
  enqueue(
    this: uiSystems.animation.commands
    value: AnimationCommand {
      entityId: entityId
      hasFrom: false
      from: AnimationPose {}
      to: to
      motion: motion
      opacityMotion: opacityMotion
      delaySeconds: delaySeconds
      phase: AnimationPhase.moving
      onEnd: AnimationEnd.stay
    }
  )
}

# Move from where the node is now to pose `to`, then do `onEnd` to it
func animationLeave(
  uiSystems: mod UiSystems
  entityId: view EntityId
  to: view AnimationPose
  motion: view String
  opacityMotion: view String
  delaySeconds: view Float
  onEnd: view AnimationEnd
) {
  enqueue(
    this: uiSystems.animation.commands
    value: AnimationCommand {
      entityId: entityId
      hasFrom: false
      from: AnimationPose {}
      to: to
      motion: motion
      opacityMotion: opacityMotion
      delaySeconds: delaySeconds
      phase: AnimationPhase.leaving
      onEnd: onEnd
    }
  )
}

# A node a finger let go: from pose `from`, where the finger left it, at `velocity`, the finger's
# speed in pose units a second, toward `to`, then `onEnd`. A spring carries the speed on, so the
# node
# does not stop and start again, and it may pass `to` and come back if it is fast. A curve, such as
# an
# opacity fade, runs its own way from `from`. `AnimationEnd.stay` keeps the node where it ends, as a
# card that springs back; any other end is a leave, as a card swiped away. A host's own gesture code
# calls this, as pageTransitionDrag does for a page.
func animationFling(
  uiSystems: mod UiSystems
  entityId: view EntityId
  from: view AnimationPose
  to: view AnimationPose
  velocity: view AnimationVelocity
  motion: view String
  opacityMotion: view String
  onEnd: view AnimationEnd
) {
  var phase: AnimationPhase = AnimationPhase.moving
  if onEnd is not AnimationEnd.stay {
    phase = AnimationPhase.leaving
  }
  enqueue(
    this: uiSystems.animation.commands
    value: AnimationCommand {
      entityId: entityId
      hasFrom: true
      from: from
      to: to
      motion: motion
      opacityMotion: opacityMotion
      delaySeconds: 0.0
      phase: phase
      onEnd: onEnd
      hasVelocity: true
      velocity: velocity
    }
  )
}

# A fling's start on a track: where the finger left it, and the finger's speed
func animationFlingStart(track: mod AnimationTrack, command: view AnimationCommand) {
  channelFlingStart(
    channel: track.opacity
    current: command.from.opacity
    velocity: command.velocity.opacity
  )
  channelFlingStart(
    channel: track.scale
    current: command.from.scale
    velocity: command.velocity.scale
  )
  channelFlingStart(channel: track.x, current: command.from.x, velocity: command.velocity.x)
  channelFlingStart(channel: track.y, current: command.from.y, velocity: command.velocity.y)
  channelFlingStart(
    channel: track.rotation
    current: command.from.rotation
    velocity: command.velocity.rotation
  )
  channelFlingStart(
    channel: track.stretchY
    current: command.from.stretchY
    velocity: command.velocity.stretchY
  )
}

func channelFlingStart(channel: mod AnimationChannel, current: view Float, velocity: view Float) {
  channel.current = current
  channel.start = current
  channel.elapsed = 0.0
  channel.velocity = velocity
}

# The node just moved by layout: it keeps looking where it was, shifted by (dx, dy), and springs
# back.
# Its other channels carry on: a glide can start in the middle of an Appear.
func animationGlide(
  uiSystems: mod UiSystems
  entityId: view EntityId
  dx: view Float
  dy: view Float
  motion: view String
) {
  enqueue(
    this: uiSystems.animation.commands
    value: AnimationCommand {
      entityId: entityId
      hasFrom: false
      from: AnimationPose {}
      to: AnimationPose {}
      motion: motion
      opacityMotion: motion
      delaySeconds: 0.0
      phase: AnimationPhase.moving
      onEnd: AnimationEnd.stay
      isGlide: true
      glideX: dx
      glideY: dy
    }
  )
}

func animationApplyGlide(
  uiSystems: mod UiSystems
  entityId: view EntityId
  command: view AnimationCommand
  motion: view MotionToken
) {
  if componentHas(this: uiSystems.animation.tracks, entityId: entityId) {
    let track: mod AnimationTrack = componentMod(
      this: uiSystems.animation.tracks
      entityId: entityId
    )
    track.x.current = track.x.current + command.glideX
    track.y.current = track.y.current + command.glideY
    channelRetarget(channel: track.x, target: track.x.target, motion: motion)
    channelRetarget(channel: track.y, target: track.y.target, motion: motion)
    ret
  }
  let rest: AnimationPose = animationPoseOf(uiSystems: uiSystems, entityId: entityId)
  var start: AnimationPose = rest
  start.x = start.x + command.glideX
  start.y = start.y + command.glideY
  let glide: AnimationCommand = {
    entityId: entityId
    hasFrom: true
    from: start
    to: rest
    motion: command.motion
    opacityMotion: command.motion
    delaySeconds: 0.0
    phase: AnimationPhase.moving
    onEnd: AnimationEnd.stay
  }
  componentSet(
    this: uiSystems.animation.tracks
    entityId: entityId
    data: trackFromCommand(
      command: glide
      start: start
      motion: motion
      opacityMotion: motion
    )
  )
}

# A motion token was edited: everything running on it now runs on this one, from where it is
func animationMotionChanged(uiSystems: mod UiSystems, token: view MotionToken) {
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.tracks), ++i {
    let track: mod AnimationTrack = componentMod(
      this: uiSystems.animation.tracks
      entityId: componentEntityAt(this: uiSystems.animation.tracks, i: i)
    )
    channelMotionChanged(channel: track.opacity, token: token)
    channelMotionChanged(channel: track.scale, token: token)
    channelMotionChanged(channel: track.x, token: token)
    channelMotionChanged(channel: track.y, token: token)
    channelMotionChanged(channel: track.rotation, token: token)
    channelMotionChanged(channel: track.stretchY, token: token)
  }
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.textGhosts), ++i {
    let ghost: mod TextGhost = componentMod(
      this: uiSystems.animation.textGhosts
      entityId: componentEntityAt(this: uiSystems.animation.textGhosts, i: i)
    )
    channelMotionChanged(channel: ghost.progress, token: token)
  }
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.sharedNodes), ++i {
    let shared: mod SharedNode = componentMod(
      this: uiSystems.animation.sharedNodes
      entityId: componentEntityAt(this: uiSystems.animation.sharedNodes, i: i)
    )
    channelMotionChanged(channel: shared.progress, token: token)
  }
}

# The node stops moving, and is at its place: a list has given its entity to another row
func animationDropMotion(uiSystems: mod UiSystems, entityId: view EntityId) {
  componentRemove(this: uiSystems.animation.tracks, entityId: entityId)
  componentRemove(this: uiSystems.animation.poses, entityId: entityId)
}

# Whether a command for this node has not been taken yet. A host that runs no animation never takes
# it.
func animationCommandWaiting(uiSystems: view UiSystems, entityId: view EntityId) ret Bool {
  loop var i: Int = 0, i < queueCount(this: uiSystems.animation.commands), ++i {
    if queueAt(this: uiSystems.animation.commands, i: i).entityId is entityId {
      ret true
    }
  }
  ret false
}

# Every Appear under `root` waits this much longer. The first paint already shows each node's start
# pose, so the page does not flash in its final look.
func animationDelayAppears(
  world: view UiWorld
  uiSystems: mod UiSystems
  root: view EntityId
  delay: view Float
) {
  var subtree: List(EntityId) = List.create(EntityId, cap: 32)
  collectSubtree(childrens: world.childrens, node: root, out: subtree)
  loop let entityId: view EntityId in subtree {
    if entityId is not root and componentHas(this: uiSystems.animation.tracks, entityId: entityId) {
      let track: mod AnimationTrack = componentMod(
        this: uiSystems.animation.tracks
        entityId: entityId
      )
      if track.phase is AnimationPhase.appearing {
        track.delayLeft = track.delayLeft + delay
      }
    }
  }
}

# A motion token by name: an unknown one is a scene diagnostic, then the fallback, never silent
func animationMotionNamed(
  world: mod UiWorld
  entityId: view EntityId
  name: view String
) ret MotionToken {
  if let token: MotionToken = themeMotion(theme: world.theme.resolved, name: name) {
    ret token
  }
  reportSceneDiagnostic(
    diagnostics: world.sceneDiagnostics
    sceneId: ""
    nodeId: "{entityId.index}"
    kind: SceneDiagnosticKind.unknownToken
    name: name
    message: "no motion token named {name}; using {animationFallbackMotion}"
  )
  if let token: MotionToken = themeMotion(
    theme: world.theme.resolved
    name: animationFallbackMotion
  ) {
    ret token
  }
  ret MotionToken {}
}

func poseOfTrack(track: view AnimationTrack) ret AnimationPose {
  ret AnimationPose {
    opacity: track.opacity.current
    scale: track.scale.current
    x: track.x.current
    y: track.y.current
    rotation: track.rotation.current
    stretchY: track.stretchY.current
  }
}

func animationPoseOf(uiSystems: view UiSystems, entityId: view EntityId) ret AnimationPose {
  if componentHas(this: uiSystems.animation.poses, entityId: entityId) {
    let pose: view AnimationPose = componentView(
      this: uiSystems.animation.poses
      entityId: entityId
    )
    ret pose
  }
  ret AnimationPose {}
}

# The track a command starts: from its `from` pose, or from where the node is
func trackFromCommand(
  command: view AnimationCommand
  start: view AnimationPose
  motion: view MotionToken
  opacityMotion: view MotionToken
) ret AnimationTrack {
  ret AnimationTrack {
    opacity: createChannel(
      current: start.opacity
      target: command.to.opacity
      motion: opacityMotion
      restDistance: animationRestRatio
    )
    scale: createChannel(
      current: start.scale
      target: command.to.scale
      motion: motion
      restDistance: animationRestRatio
    )
    x: createChannel(
      current: start.x
      target: command.to.x
      motion: motion
      restDistance: animationRestPixels
    )
    y: createChannel(
      current: start.y
      target: command.to.y
      motion: motion
      restDistance: animationRestPixels
    )
    rotation: createChannel(
      current: start.rotation
      target: command.to.rotation
      motion: motion
      restDistance: animationRestRatio
    )
    stretchY: createChannel(
      current: start.stretchY
      target: command.to.stretchY
      motion: motion
      restDistance: animationRestRatio
    )
    delayLeft: command.delaySeconds
    phase: command.phase
    onEnd: command.onEnd
  }
}

# Whether anything under a node is still moving: a leaving parent waits for its staggered children,
# and a closing dialog's host for the card inside its slot
func animationChildMoving(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  if componentHas(this: world.childrens, entityId: entityId) is false {
    ret false
  }
  let children: view Children = componentView(this: world.childrens, entityId: entityId)
  loop var i: Int = 0, i < children.ids.length, ++i {
    let child: EntityId = children.ids.copyAtFallback(index: i, fallback: noEntity())
    if componentHas(this: uiSystems.animation.tracks, entityId: child) or animationChildMoving(
      world: world
      uiSystems: uiSystems
      entityId: child
    ) {
      ret true
    }
  }
  ret false
}

# The real end of a track: its end action, and the pose goes unless the node stays somewhere else
func animationFinish(
  world: mod UiWorld
  uiSystems: mod UiSystems
  entityId: view EntityId
  onEnd: view AnimationEnd
  pose: view AnimationPose
) {
  componentRemove(this: uiSystems.animation.tracks, entityId: entityId)
  componentRemove(this: world.leavings, entityId: entityId)
  if onEnd is AnimationEnd.stay and poseIsRest(pose: pose) is false {
    componentSet(this: uiSystems.animation.poses, entityId: entityId, data: pose)
    ret
  }
  componentRemove(this: uiSystems.animation.poses, entityId: entityId)
  if onEnd is AnimationEnd.deactivate {
    componentSet(this: world.actives, entityId: entityId, data: Active { value: false })
    # Everything under it from a staggered leave: it is hidden now, and at rest for next time
    var subtree: List(EntityId) = List.create(EntityId, cap: 16)
    collectSubtree(childrens: world.childrens, node: entityId, out: subtree)
    loop let under: view EntityId in subtree {
      componentRemove(this: uiSystems.animation.tracks, entityId: under)
      componentRemove(this: uiSystems.animation.poses, entityId: under)
    }
  } else if onEnd is AnimationEnd.destroy {
    unlinkFromCurrent(
      parents: uiSystems.hierarchy.parents
      childrens: world.childrens
      child: entityId
    )
    destroyEntity(world: world, entityId: entityId)
  } else if onEnd is AnimationEnd.destroySubtree {
    destroyEntitySubtree(world: world, uiSystems: uiSystems, root: entityId)
  }
}

func animationStill(channel: mod AnimationChannel, leaving: view Bool) {
  if leaving {
    channel.target = channel.current
  } else {
    channel.current = channel.target
  }
  channel.start = channel.current
  channel.velocity = 0.0
}

# With reduced motion only fades run. What moves does not: a node leaving stays where it is, and any
# other is at its place at once. Something that would have arrived by moving fades in instead, and
# something that would have left by moving fades out. A delay would only make a person wait.
func animationReduceTrack(
  world: mod UiWorld
  entityId: view EntityId
  track: mod AnimationTrack
  command: view AnimationCommand
) {
  let leaving: Bool = command.phase is AnimationPhase.leaving
  let moved: Bool = track.x.current is not track.x.target or track.y.current is not track.y.target or track.scale.current is not track.scale.target or track.rotation.current is not track.rotation.target or track.stretchY.current is not track.stretchY.target
  animationStill(channel: track.x, leaving: leaving)
  animationStill(channel: track.y, leaving: leaving)
  animationStill(channel: track.scale, leaving: leaving)
  animationStill(channel: track.rotation, leaving: leaving)
  animationStill(channel: track.stretchY, leaving: leaving)
  track.delayLeft = 0.0
  if moved and command.hasFrom and leaving is false {
    track.opacity.current = 0.0
    track.opacity.target = 1.0
  }
  if moved and leaving and command.onEnd is not AnimationEnd.stay {
    track.opacity.target = 0.0
  }
  var name: String = "fadeOut"
  if track.opacity.target > track.opacity.current {
    name = "fadeIn"
  }
  channelRetarget(
    channel: track.opacity
    target: track.opacity.target
    motion: animationMotionNamed(world: world, entityId: entityId, name: name)
  )
  track.opacity.velocity = 0.0
}

func animationApplyCommand(
  world: mod UiWorld
  uiSystems: mod UiSystems
  command: view AnimationCommand
) {
  let entityId: EntityId = command.entityId
  if isAlive(world: world, entityId: entityId) is false {
    ret
  }
  let motion: MotionToken = animationMotionNamed(
    world: world
    entityId: entityId
    name: command.motion
  )
  var opacityMotion: MotionToken = animationMotionNamed(
    world: world
    entityId: entityId
    name: command.opacityMotion
  )
  if command.opacitySeconds > 0.0 {
    opacityMotion.kind = MotionKind.curve
    opacityMotion.seconds = command.opacitySeconds
    # This length is the command's own, so an edit of the token does not change it
    opacityMotion.name = ""
  }
  let settings: AnimationSettings = uiSystems.animation.settings
  if command.isGlide and (settings.off or settings.reduceMotion) {
    ret
  }
  if settings.off {
    animationFinish(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      onEnd: command.onEnd
      pose: command.to
    )
    ret
  }
  if command.isGlide {
    animationApplyGlide(
      uiSystems: uiSystems
      entityId: entityId
      command: command
      motion: motion
    )
  } else if componentHas(this: uiSystems.animation.tracks, entityId: entityId) {
    let track: mod AnimationTrack = componentMod(
      this: uiSystems.animation.tracks
      entityId: entityId
    )
    channelRetarget(channel: track.opacity, target: command.to.opacity, motion: opacityMotion)
    channelRetarget(channel: track.scale, target: command.to.scale, motion: motion)
    channelRetarget(channel: track.x, target: command.to.x, motion: motion)
    channelRetarget(channel: track.y, target: command.to.y, motion: motion)
    channelRetarget(channel: track.rotation, target: command.to.rotation, motion: motion)
    channelRetarget(channel: track.stretchY, target: command.to.stretchY, motion: motion)
    track.delayLeft = command.delaySeconds
    track.phase = command.phase
    track.onEnd = command.onEnd
  } else {
    var start: AnimationPose = animationPoseOf(uiSystems: uiSystems, entityId: entityId)
    if command.hasFrom {
      start = command.from
    }
    componentSet(
      this: uiSystems.animation.tracks
      entityId: entityId
      data: trackFromCommand(
        command: command
        start: start
        motion: motion
        opacityMotion: opacityMotion
      )
    )
  }
  if command.hasVelocity {
    animationFlingStart(
      track: componentMod(this: uiSystems.animation.tracks, entityId: entityId)
      command: command
    )
  }
  if settings.reduceMotion {
    let reduced: mod AnimationTrack = componentMod(
      this: uiSystems.animation.tracks
      entityId: entityId
    )
    animationReduceTrack(
      world: world
      entityId: entityId
      track: reduced
      command: command
    )
  }
  # The start pose before the first paint, so a node never flashes at its end place; under a hold,
  # the stopped middle of the way
  let moved: mod AnimationTrack = componentMod(this: uiSystems.animation.tracks, entityId: entityId)
  if settings.hold >= 0.0 {
    channelHold(channel: moved.opacity, share: settings.hold)
    channelHold(channel: moved.scale, share: settings.hold)
    channelHold(channel: moved.x, share: settings.hold)
    channelHold(channel: moved.y, share: settings.hold)
    channelHold(channel: moved.rotation, share: settings.hold)
    channelHold(channel: moved.stretchY, share: settings.hold)
  }
  componentSet(this: uiSystems.animation.poses, entityId: entityId, data: poseOfTrack(track: moved))
}

# A focus fade that has arrived is done: at rest the painter reads the field's focus
func animationStepFocusFades(uiSystems: mod UiSystems, deltaTime: view Float) {
  var done: List(EntityId) = List.create(EntityId, cap: 1)
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.focusFades), ++i {
    let entityId: EntityId = componentEntityAt(this: uiSystems.animation.focusFades, i: i)
    let fade: mod FocusFade = componentMod(this: uiSystems.animation.focusFades, entityId: entityId)
    if channelStep(channel: fade.progress, deltaTime: deltaTime) {
      done.add(value: entityId)
    }
  }
  loop let entityId: view EntityId in done {
    componentRemove(this: uiSystems.animation.focusFades, entityId: entityId)
  }
}

func animationStepTextGhosts(uiSystems: mod UiSystems, deltaTime: view Float) {
  var done: List(EntityId) = List.create(EntityId, cap: 2)
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.textGhosts), ++i {
    let entityId: EntityId = componentEntityAt(this: uiSystems.animation.textGhosts, i: i)
    let ghost: mod TextGhost = componentMod(
      this: uiSystems.animation.textGhosts
      entityId: entityId
    )
    if channelStep(channel: ghost.progress, deltaTime: deltaTime) {
      done.add(value: entityId)
    }
  }
  loop let entityId: view EntityId in done {
    componentRemove(this: uiSystems.animation.textGhosts, entityId: entityId)
  }
}

# A morph's corner radius goes from the old node's to its own, as seen: the pose's scale is taken
# back
# out, as the painter scales a radius with its node. A shared node is done when it and its page are
# at rest.
func animationStepSharedNodes(world: mod UiWorld, uiSystems: mod UiSystems, deltaTime: view Float) {
  if componentCount(this: uiSystems.animation.sharedNodes) is 0 {
    ret
  }
  var done: List(EntityId) = List.create(EntityId, cap: 2)
  loop var i: Int = 0, i < componentCount(this: uiSystems.animation.sharedNodes), ++i {
    let entityId: EntityId = componentEntityAt(this: uiSystems.animation.sharedNodes, i: i)
    let arrived: Bool = animationStepSharedProgress(
      uiSystems: uiSystems
      entityId: entityId
      deltaTime: deltaTime
    )
    let shared: SharedNode = sharedNodeCopy(uiSystems: uiSystems, entityId: entityId)
    if shared.fromRadius is not shared.toRadius {
      animationWriteRadius(
        world: world
        entityId: entityId
        fromRadius: shared.fromRadius
        toRadius: shared.toRadius
        progress: shared.progress.current
        scale: animationPoseOf(uiSystems: uiSystems, entityId: entityId).scale
      )
    }
    let moving: Bool = componentHas(this: uiSystems.animation.tracks, entityId: entityId) or (isNone(
      this: shared.pageRoot
    ) is false and componentHas(this: uiSystems.animation.tracks, entityId: shared.pageRoot))
    if arrived and not moving {
      done.add(value: entityId)
    }
  }
  loop let entityId: view EntityId in done {
    let shared: SharedNode = sharedNodeCopy(uiSystems: uiSystems, entityId: entityId)
    if shared.fromRadius is not shared.toRadius {
      componentSet(
        this: world.cornerRadiuses
        entityId: entityId
        data: CornerRadius { radius: shared.toRadius }
      )
    }
    if shared.key.length() > 0 {
      log("[hero] done key={shared.key}")
    }
    componentRemove(this: uiSystems.animation.sharedNodes, entityId: entityId)
  }
}

func sharedNodeCopy(uiSystems: view UiSystems, entityId: view EntityId) ret SharedNode {
  let shared: view SharedNode = componentView(
    this: uiSystems.animation.sharedNodes
    entityId: entityId
  )
  ret shared
}

func animationStepSharedProgress(
  uiSystems: mod UiSystems
  entityId: view EntityId
  deltaTime: view Float
) ret Bool {
  let shared: mod SharedNode = componentMod(
    this: uiSystems.animation.sharedNodes
    entityId: entityId
  )
  ret channelStep(channel: shared.progress, deltaTime: deltaTime)
}

func animationWriteRadius(
  world: mod UiWorld
  entityId: view EntityId
  fromRadius: view Float
  toRadius: view Float
  progress: view Float
  scale: view Float
) {
  if scale <= 0.0 {
    ret
  }
  let seen: Float = fromRadius + (toRadius - fromRadius) * progress
  componentSet(
    this: world.cornerRadiuses
    entityId: entityId
    data: CornerRadius { radius: seen / scale }
  )
}

# One update: drain the inbox, then step every track by `deltaTime` s
func animationSystem(world: mod UiWorld, uiSystems: mod UiSystems, deltaTime: view Float) {
  uiSystems.animation.updates = uiSystems.animation.updates + 1
  let commandCount: Int = queueCount(this: uiSystems.animation.commands)
  # Read as motion starts, so a change in the system's settings counts from the next motion on
  if commandCount > 0 and uiSystems.animation.settings.reduceMotionFixed is false {
    uiSystems.animation.settings.reduceMotion = ReduceMotion.reduceMotionEnabled()
  }
  loop var i: Int = 0, i < commandCount, ++i {
    let command: AnimationCommand = queueAt(this: uiSystems.animation.commands, i: i)
    animationApplyCommand(world: world, uiSystems: uiSystems, command: command)
  }
  # After them all: the Appear of a page's nodes are in the same batch as the page
  loop var i: Int = 0, i < commandCount, ++i {
    let command: AnimationCommand = queueAt(this: uiSystems.animation.commands, i: i)
    if command.appearsWait > 0.0 and isAlive(world: world, entityId: command.entityId) {
      animationDelayAppears(
        world: world
        uiSystems: uiSystems
        root: command.entityId
        delay: command.appearsWait
      )
    }
  }
  clearQueue(this: uiSystems.animation.commands)
  if uiSystems.animation.settings.hold >= 0.0 {
    ret
  }
  var step: Float = deltaTime
  if step > animationMaxStep {
    step = animationMaxStep
  }
  step = step / uiSystems.animation.settings.slow
  var ended: List(EntityId) = List.create(EntityId, cap: 8)
  let trackCount: Int = componentCount(this: uiSystems.animation.tracks)
  loop var i: Int = 0, i < trackCount, ++i {
    let entityId: EntityId = componentEntityAt(this: uiSystems.animation.tracks, i: i)
    let track: mod AnimationTrack = componentMod(
      this: uiSystems.animation.tracks
      entityId: entityId
    )
    var left: Float = step
    if track.paused {
      left = 0.0
    } else if track.delayLeft > 0.0 {
      track.delayLeft = track.delayLeft - left
      left = -track.delayLeft
    }
    if track.delayLeft <= 0.0 and not track.paused {
      track.delayLeft = 0.0
      # All five, with no early stop: each channel runs on its own
      let opacityDone: Bool = channelStep(channel: track.opacity, deltaTime: left)
      let scaleDone: Bool = channelStep(channel: track.scale, deltaTime: left)
      let xDone: Bool = channelStep(channel: track.x, deltaTime: left)
      let yDone: Bool = channelStep(channel: track.y, deltaTime: left)
      let rotationDone: Bool = channelStep(channel: track.rotation, deltaTime: left)
      let stretchDone: Bool = channelStep(channel: track.stretchY, deltaTime: left)
      componentSet(
        this: uiSystems.animation.poses
        entityId: entityId
        data: poseOfTrack(track: track)
      )
      if opacityDone and scaleDone and xDone and yDone and rotationDone and stretchDone {
        let waits: Bool = track.phase is AnimationPhase.leaving and animationChildMoving(
          world: world
          uiSystems: uiSystems
          entityId: entityId
        )
        if not waits {
          ended.add(value: entityId)
        }
      }
    }
  }
  animationStepTextGhosts(uiSystems: uiSystems, deltaTime: step)
  animationStepFocusFades(uiSystems: uiSystems, deltaTime: step)
  animationStepSharedNodes(world: world, uiSystems: uiSystems, deltaTime: step)
  # the loops last: a running loop's pose is its own, over any track's (LoopMotion)
  loopStep(world: world, uiSystems: uiSystems, step: step)
  loop let entityId: view EntityId in ended {
    let track: view AnimationTrack = componentView(
      this: uiSystems.animation.tracks
      entityId: entityId
    )
    let onEnd: AnimationEnd = track.onEnd
    let pose: AnimationPose = poseOfTrack(track: track)
    animationFinish(
      world: world
      uiSystems: uiSystems
      entityId: entityId
      onEnd: onEnd
      pose: pose
    )
  }
}

# The `animation` Pipeline entry, between fit and transform: an update by the real frame time when
# something is in flight, and nothing at all, not even a read of the clock, when not
func animationRun(world: mod UiWorld, uiSystems: mod UiSystems) {
  animationTriggers(world: world, uiSystems: uiSystems)
  if animationInFlight(world: world, uiSystems: uiSystems) is false {
    uiSystems.animation.lastFrameNs = 0
    ret
  }
  let now: Int = nowNs()
  var step: Float = animationFirstStep
  if uiSystems.animation.lastFrameNs > 0 {
    step = (now - uiSystems.animation.lastFrameNs).toFloat() / 1000000000.0
  }
  uiSystems.animation.lastFrameNs = now
  animationSystem(world: world, uiSystems: uiSystems, deltaTime: step)
}
