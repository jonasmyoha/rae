# BindingComponents — authored components whose VALUE comes from app state
# and whose behaviour is a per-app system (docs/ecs-general-architecture.md).
# A page's layout lives entirely in its .raescene; what a scene cannot
# express — a live count, a data list, a text field's query, a bottom
# anchor — is one of these components on the node, decoded from JSON by the
# reflected registry like any other UiWorld table, and driven every frame by
# the system named in its comment. Split out of ui/Components.rae (the
# renderer/layout vocabulary) at the 1,000-line cap (#978).
open ui/Components

# ----- data-binding components for the profile page (#974) -----------------
#
# The page's layout lives entirely in its .raescene; these two components are
# what a scene cannot express — a value that comes from app state — and a
# per-frame system drives every instance (docs/ecs-general-architecture.md).

# Which live library count a `ProfileStat` node shows. Authored as the member
# name: `"ProfileStat": { "stat": "albums" }`.
enum ProfileStatKind { albums, tracks, listeningHours }

# A Text node whose `text` is a live count from the app's media library. The
# number never lives in the scene; `profileStatsSystem` writes `Text.text` on
# the same entity when the count changes (a pure data binding, no layout).
type ProfileStat {
  stat: ProfileStatKind
}

# An avatar slot whose photo may not be loaded yet. Authored on a Stack
# container with two children: the photo (the child whose `Sprite.textureKey`
# equals `textureKey`) and an authored placeholder. `avatarSystem` activates
# the photo once the texture registry holds the key and the placeholder
# otherwise, so a download that lands later is an `Active` toggle on two
# children — not a page rebuild.
type AvatarSource {
  textureKey: String
}

# ----- data-list container: a grid of album-cover tiles (#975) -------------

# ----- data lists: ONE producer component for every list (#996) -----------
#
# A list a screen shows is an authored `ListView` (lib/ui, flow mode) on the
# container node plus this `ListSource` naming which app data feeds it. The
# app's `listSourceSystem` computes the source's current key (a revision, a
# query, a collection key) and, when it moved past `builtKey`, writes the
# host's `ListViewData` from ONE producer per source; the lib `listViewSystem`
# materialises the rows (keyed, in place). Nothing else about a list is code:
# the row sub-scenes, the columns, the tile size and every per-row binding
# are in the scene.
enum ListSourceKind {
  home
  library
  searchTracks
  searchAlbums
  albumTracks
  sheet
  recent
}

# the user's library albums
# the Liked playlist tile, then the library albums
# catalogue tracks matching the page's SearchField query
# catalogue albums matching the query
# the songs of the collection the Album page shows
# the open bottom sheet's actions
# the newest plays of the history, for the Home strip
type ListSource {
  source: ListSourceKind
  builtKey: String
}

# ----- search page: a text field and its result list (#976) ----------------

# A single-line text field authored as a container whose first Text child is
# the visible line. `query` is the live typed text (the field system appends
# the frame's typed characters and applies backspaces while the field's page
# is active); the Text child shows `query` in `textStyleId`, or `placeholder`
# in `placeholderStyleId` while the query is empty. `emptyStateNodeId` names
# the page node shown while the query is empty (the sibling search-results
# list host shows the rest of the time).
type SearchField {
  query: String
  placeholder: String
  textStyleId: String = "primary"
  placeholderStyleId: String = "muted"
  emptyStateNodeId: String = "EmptyState"
}

# ----- history page: the play-history list binding (#977) -------------------

# Authored next to a `ListView` on the History page's list host. The rows are
# the app's play history, so the scene cannot carry them: `historyListSystem`
# writes the host's `ListViewData` from the history whenever its revision
# moves past `builtRevision` (-1 on a fresh mount), shows the host while
# there are entries and the page's `emptyStateNodeId` node otherwise. The
# list re-binds in place — a new play no longer re-mounts the page.
type HistoryList {
  emptyStateNodeId: String = "EmptyState"
  builtRevision: Int = -1
}

# A node shown only while the play history has entries (the Home page's
# "Recently played" header and strip): `hasHistorySystem` writes `Active`
# from the history, so an empty history collapses the section in layout.
type HasHistory {
  builtRevision: Int = -1
}

# ----- dock: bottom anchoring, layer membership, nav-tab state (#978) ------

# Pins the entity's bottom edge to the layout extent's bottom: the anchor
# system writes `Offset.y = layoutH - Rect.h - bottomInset` (the safe-area
# home-indicator inset the app supplies) whenever either changes. What the
# bottom dock needs instead of an authored Offset, which cannot know the
# window height.
type AnchorBottom {
  enabled: Bool = true
}

# Names the paint/hit-test layer an entity belongs to, by the layer id the
# app created ("dock", "back-button", ...). `LayerRef` holds an EntityId a
# scene cannot spell; the layer-tag system resolves the id once per entity.
type LayerTag {
  id: String
}

# The screen a nav tab selects. `navTabsSystem` compares it to the app's
# current tab and writes the active/inactive icon tint and label style onto
# the tab's Sprite and Text children — so the bar never re-mounts on switch.
type NavTab {
  screen: String
}

# ----- album page (#979) ----------------------------------------------------

# The album/playlist header block: `albumHeaderSystem` writes the caption,
# title and artist texts and points the hero cover's Sprite (and HeroWidget
# key) at the collection the app is showing, whenever the collection key it
# derives from app state moves past `builtKey`.
type AlbumHeader {
  captionNodeId: String = "HeroCaption"
  titleNodeId: String = "HeroTitle"
  artistNodeId: String = "HeroArtist"
  coverNodeId: String = "HeroThumb"
  builtKey: String
}

# ----- now-playing page (#979) ----------------------------------------------

# A progress track whose FIRST child is the fill: the playback system writes
# the fill's width as `track width x progress` (Rect and ComputedRect, only
# when it changed) — the app's existing `applyPlaybackToWorld`, now driven
# by this component instead of a page node-id lookup.
# ----- bottom sheet: the action-sheet overlay binding (#980) ----------------
# Authored on the sheet's layer root. `bottomSheetSystem` shows/hides the root
# from `BottomSheetState.visible` and sizes the `panelNodeId` panel's Rect
# from its row count; the rows themselves are the panel's `ListView` +
# `ListSource { source: sheet }` (#996).
type BottomSheet {
  panelNodeId: String = "Panel"
  rowHeight: Float = 121.44578313253011
}

# ----- playback widgets: the data bindings the dock and Now Playing share (#981)
# Each is authored on the node it drives; the matching system runs every frame
# from `refreshMountedUi` (and once at mount) and writes only on a change of
# its observed revision / key, so the same components serve the dock's
# mini-player and the Now Playing page.
# Play/pause glyph: the Sprite key follows `PlaybackState.isPlaying` and the
# WidgetState.selected flag mirrors it (`revision` observed).
type PlaybackIcon {
  builtRevision: Int = -1
}

# Now-playing cover: the Sprite key follows the playing track's art
# (`nowPlayingRevision` observed); seeded from the browsed album at mount.
# Its authored `CornerRadius` follows the rounded-covers setting like every
# other cover: the system keeps the authored radius (`roundedRadius`) and
# removes / restores the component as the setting flips (`builtRounded`:
# -1 unseen, 0 square, 1 rounded).
type PlaybackCover {
  builtRevision: Int = -1
  builtRounded: Int = -1
  roundedRadius: Float
}

# Heart / like button: WidgetState.selected follows the liked playlist
# membership of the browsed track; the outline/filled StateStyle is
# installed by the system (StateStyle is a runtime table).
type LikedHeart {
  styled: Bool = false
}

# Track text: `field` is "title" or "artist" (the Text follows the browsed
# album + track, `builtKey` = stem|index), or "timeNow" / "timeTotal" (the
# M:SS playback position / duration, written whenever the second changes).
type TrackText {
  field: String = "title"
  builtKey: String
}

type ProgressBar {
  enabled: Bool = true
}
