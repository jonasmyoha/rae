# BindingComponents — authored components whose VALUE comes from app state
# and whose behaviour is a per-app system (docs/ecs-general-architecture.md).
# A page's layout lives entirely in its .raescene; what a scene cannot
# express — a live count, a data list, a text field's query, a bottom
# anchor — is one of these components on the node, decoded from JSON by the
# reflected registry like any other UiWorld table, and driven every frame by
# the system named in its comment. Split out of ui/Components.rae (the
# renderer/layout vocabulary) at the 1,000-line cap (#978).
open ui/Components

# ----- data-list container: a grid of album-cover tiles (#975) -------------

# ----- data lists: ONE producer component for every list (#996) -----------
#
# A list a screen shows is an authored `ListView` (lib/ui, flow mode) on the
# container node plus this `ListSource` naming which app data feeds it. The
# app's `listSourceSystem` computes the source's current key (a revision, a
# query, a collection key) and, when it moved past `builtKey`, writes the
# host's `ListViewData` from ONE producer per source; the lib `listViewSystem`
# materialises the rows (keyed, in place). Nothing else about a list is code:
# the row sub-scenes, the columns, the tile size and every per-row binding
# are in the scene.
enum ListSourceKind {
  home
  library
  searchTracks
  searchAlbums
  albumTracks
  sheet
  recent
}

# the user's library albums
# the Liked playlist tile, then the library albums
# catalogue tracks matching the page's SearchField query
# catalogue albums matching the query
# the songs of the collection the Album page shows
# the open bottom sheet's actions
# the newest plays of the history, for the Home strip
type ListSource {
  source: ListSourceKind
  builtKey: String
}

# ----- search page: a text field and its result list (#976) ----------------

# A single-line text field authored as a container whose first Text child is
# the visible line. `query` is the live typed text (the field system appends
# the frame's typed characters and applies backspaces while the field's page
# is active); the Text child shows `query` in `textStyleId`, or `placeholder`
# in `placeholderStyleId` while the query is empty. `emptyStateNodeId` names
# the page node shown while the query is empty (the sibling search-results
# list host shows the rest of the time).
type SearchField {
  query: String
  placeholder: String
  textStyleId: String = "primary"
  placeholderStyleId: String = "muted"
}

# Shown only while a page-level list is EMPTY (the History page's "nothing
# played yet" block, the Search page's "Recent" stub before a query). Authored
# on the empty node; `emptyStateSystem` sets its `Active` from `key`:
#   "history" -> the play history has no entries
#   "search"  -> the page's SearchField query is blank
enum EmptyStateKind { history, search }

type EmptyState {
  kind: EmptyStateKind
}

# ----- dock: bottom anchoring, layer membership, nav-tab state (#978) ------

# Pins the entity's bottom edge to the layout extent's bottom: the anchor
# system writes `Offset.y = layoutH - Rect.h - bottomInset` (the safe-area
# home-indicator inset the app supplies) whenever either changes. What the
# bottom dock needs instead of an authored Offset, which cannot know the
# window height.
type AnchorBottom {
  enabled: Bool = true
}

# Names the paint/hit-test layer an entity belongs to, by the layer id the
# app created ("dock", "back-button", ...). `LayerRef` holds an EntityId a
# scene cannot spell; the layer-tag system resolves the id once per entity.
type LayerTag {
  id: String
}

# ----- bottom sheet: the action-sheet overlay binding (#980) ----------------
# Authored on the sheet's layer root. `bottomSheetSystem` shows/hides the root
# from `BottomSheetState.visible` and sizes the `panelNodeId` panel's Rect
# from its row count; the rows themselves are the panel's `ListView` +
# `ListSource { source: sheet }` (#996).
# On the sheet's overlay ROOT: `bottomSheetSystem` toggles its `Active` from
# `BottomSheetState.visible`. The panel that grows with the action count is a
# separate `SheetPanel` on the panel node.
type BottomSheet {
}

# On the bottom sheet's PANEL node: `bottomSheetSystem` sizes it to
# `rowHeight * actionCount` plus the panel's padding + gaps.
type SheetPanel {
  rowHeight: Float = 121.44578313253011
}

# ----- now-playing page (#979) ----------------------------------------------

# A progress track whose FIRST child is the fill: the playback system writes
# the fill's width as `track width x progress` (Rect and ComputedRect, only
# when it changed) — the app's existing `applyPlaybackToWorld`, now driven
# by this component instead of a page node-id lookup.
type ProgressBar {
  enabled: Bool = true
}

# A hero (shared-element) transition in flight: a runtime entity in the
# overlay layer — a plain `Sprite` + `CornerRadius` root the ordinary paint
# path draws — that flies from the source hero's rect to the destination's
# while the destination (`target`) is hidden. `heroTransitionSystem`
# (ui/animationSystem/HeroTransitionSystem) advances it every frame with an
# ease and, at `duration`, reveals the target and destroys the entity.
# Never authored: `spawnHeroTransition` creates it from two `HeroWidget`
# entities that share a key.
type HeroTransition {
  key: String
  target: EntityId
  fromX: Float
  fromY: Float
  fromW: Float
  fromH: Float
  fromRadius: Float
  toX: Float
  toY: Float
  toW: Float
  toH: Float
  toRadius: Float
  startedAt: Float64
  duration: Float
}

# A camera on a page or layer ROOT (#11920833): zoom about the root's origin
# and a translation, in the parent's units. The lib cameraSystem (ui/
# cameraSystem, in the Pipeline before transform) derives the root's
# TransformFx scale and RuntimeOffset from it, so ANY app zooms or pans a page
# by writing one component — the editor's wheel/drag, a map, a photo view.
# Default identity: `"Camera2D": {}` is a no-op until something writes it.
type Camera2D {
  zoom: Float = 1.0
  offsetX: Float = 0.0
  offsetY: Float = 0.0
}
