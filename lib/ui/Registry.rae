# Component registry — the bridge between component *names* (the strings used
# as `.raescene` JSON keys) and the UiWorld tables they load into.
#
# In RUICS this is a runtime-mutable `Map<string, ComponentSpec>` with closures
# attached. Rae has no first-class function references — and, since #961, needs
# none: the registry IS the world. `applyComponentByName` is one compile-time
# loop over `fields(mod world)` (docs/compile-time-reflection.md): for each
# `ComponentTable(any)` field the authored key is matched against the table's
# component type name (`typeName(table)`, plus the one alias `Overflow` ->
# `OverflowPolicy`), and a match decodes the JSON object structurally into
# `T.default()` field by field (ui/RegistryGeneric.decodeComponent). Adding a
# component is ONE field on UiWorld; its authored grammar is its Rae fields.
#
# Two explicit blocks remain, and they are the whole exception list:
#   * `ContainerStyle` runs BEFORE the loop — it names no table, it expands a
#     theme bundle into Shape + Padding (#237).
#   * A short fixup block runs AFTER the generic decode for the handful of
#     authored shapes that are not field-structural: Rect's {x,y,w,h},
#     Layout's `type` key, the flattened insets of Padding/Margin (and
#     Padding's token form), Offset's
#     {x,y}, TextShadow's offsetX/offsetY (+ its lint), OpticalAlign's
#     biasX/biasY, Align's presence flags, the palette-slot mirrors on
#     Sprite/Shape, Text's namespaced `styleOverride`, the sourceKey/fieldKey
#     spellings of DataDependency/RefreshRegion, and the two array-valued
#     fields (SceneInstance overrides, ListView bindings).
#
# Runtime / derived tables (ComputedRect, Parent, WorldTransform2D, ...) are
# EXCLUDED from the loop by name: they are never authored, and an authored key
# naming one is a hard error, as is a key naming no table at all (#941).
open ui/RegistryOpt
open ui/ScenePolicy
open ui/RegistryGeneric
open ui/RegistryValues
open ui/ContainerStyle
import Json
import Sys
import ui/Theme
import ui/ThemeResolved
open ecs/ComponentTable

# The world's tables that are derived or runtime state, never authored. This
# runtime list serves the vocabulary and the diagnostic; the loader's loop
# repeats it as literal `typeName(table) is not "..."` tests so that it folds
# per table (docs/compile-time-reflection.md, constant `if`) — keep the two
# in step.
func isRuntimeTable(name: view String) ret Bool {
  let runtime: List(String) = [
    "Children"
    "MeasuredSize"
    "ComputedRect"
    "Transform2D"
    "WorldTransform2D"
    "WorldVisual"
    "RuntimeOffset"
    "LayoutScale"
    "SafeInsets"
    "Parent"
    "AnimState"
    "VisualBounds"
    "ScrollPanelState"
    "Interaction"
    "StateStyle"
    "ListViewData"
    "StyleOverride"
  ]
  var i: Int = 0
  loop i < runtime.length() {
    if let entry: view String => runtime.viewAt(index: i) {
      if entry is name {
        ret true
      }
    }
    i = i + 1
  }
  ret false
}

# The authored spelling of a table's component type. One alias today: the
# clip policy is authored as `Overflow` and stored as `OverflowPolicy`.
func authoredNameOf(typeName: view String) ret String {
  let overflowPolicy: String = "OverflowPolicy"
  if typeName is overflowPolicy {
    ret "Overflow"
  }
  ret "{typeName}"
}

# The authored component vocabulary, derived from the world's tables: every
# non-runtime table under its authored name, plus the table-less
# `ContainerStyle`. Order is UiWorld field order.
func registeredComponentNames(world: view UiWorld) ret List(String) {
  var names: List(String) = List.create(String, cap: 64)
  loop let table: view ComponentTable(any) in fields(world) {
    if isRuntimeTable(name: typeName(table)) is false {
      names.add(value: authoredNameOf(typeName: typeName(table)))
    }
  }
  names.add(value: "ContainerStyle")
  ret names
}

# The runtime / derived tables (#996, for tooling): the names a scene must NOT
# author — the loader refuses them under `fail` and reports them as
# runtimeOnlyComponent under `report`. Order is UiWorld field order.
func runtimeOnlyComponentNames(world: view UiWorld) ret List(String) {
  var names: List(String) = List.create(String, cap: 32)
  loop let table: view ComponentTable(any) in fields(world) {
    if isRuntimeTable(name: typeName(table)) {
      names.add(value: "{typeName(table)}")
    }
  }
  ret names
}

func isKnownComponent(world: view UiWorld, name: view String) ret Bool {
  let known: List(String) = registeredComponentNames(world: world)
  var i: Int = 0
  loop i < known.length() {
    if let entry: view String => known.viewAt(index: i) {
      if entry is name {
        ret true
      }
    }
    i = i + 1
  }
  ret false
}

func registeredComponentCount(world: view UiWorld) ret Int {
  ret registeredComponentNames(world: world).length()
}

# The palette-slot name an authored colour was written as ("" for a literal —
# an {r,g,b,a} object or a `#rrggbb[aa]` hex string, #996), kept beside the
# resolved colour so the renderer can re-resolve on a live theme switch (#235).
func slotNameOf(doc: view JsonDoc, val: view JsonValue, key: view String) ret String {
  let idx: Int = Json.field(doc: doc, this: val, key: key)
  let empty: String = ""
  if idx < 0 {
    ret empty
  }
  let name: String = Json.jsonString(this: Json.jsonValueAt(doc: doc, idx: idx), fallback: empty)
  if name.startsWith(prefix: "#") {
    ret empty
  }
  ret name
}

func applyComponentByName(
  world: mod UiWorld
  entity: view EntityId
  name: view String
  doc: view JsonDoc
  val: view JsonValue
  sceneId: view String
  nodeId: view String
) {
  # Composite style reference (#237, M6): a bare string naming a theme
  # container style. Expands into the concrete Shape + Padding the bundle
  # references (see ui/ContainerStyle). No table of its own.
  let containerStyle: String = "ContainerStyle"
  if name is containerStyle {
    let empty: String = ""
    let styleName: String = Json.jsonString(this: val, fallback: empty)
    applyContainerStyle(world: world, entity: entity, name: styleName)
    ret
  }

  # The generic path: find the table whose component the key names, decode
  # the object structurally into it.
  var applied: Bool = false
  loop let table: mod ComponentTable(any) in fields(world) {
    # The same list as isRuntimeTable, spelled as literal tests so it folds:
    # `typeName(table)` is a literal per table, so this `if` is decided at
    # compile time and an excluded table instantiates no decoder at all.
    if typeName(table) is not "Children" and typeName(table) is not "MeasuredSize" and typeName(
      table
    ) is not "ComputedRect" and typeName(table) is not "Transform2D" and typeName(table) is not "WorldTransform2D" and typeName(
      table
    ) is not "WorldVisual" and typeName(table) is not "RuntimeOffset" and typeName(table) is not "LayoutScale" and typeName(
      table
    ) is not "SafeInsets" and typeName(table) is not "Parent" and typeName(table) is not "AnimState" and typeName(
      table
    ) is not "VisualBounds" and typeName(table) is not "ScrollPanelState" and typeName(table) is not "Interaction" and typeName(
      table
    ) is not "StateStyle" and typeName(table) is not "ListViewData" and typeName(table) is not "StyleOverride" {
      if name is authoredNameOf(typeName: typeName(table)) {
        decodeComponent(
          table: table
          entity: entity
          doc: doc
          val: val
          theme: world.theme
          diagnostics: world.sceneDiagnostics
          sceneId: sceneId
          nodeId: nodeId
        )
        applied = true
      }
    }
  }
  if applied {
    applyAuthoredFixups(
      world: world
      entity: entity
      name: name
      doc: doc
      val: val
      sceneId: sceneId
      nodeId: nodeId
    )
    ret
  }

  # No table matched. For an app's OWN scenes a `.raescene` component the
  # loader cannot apply is a CORRECTNESS BUG, not a thing to swallow (#941):
  # fail loudly, naming the scene, node and component. A tool opening OTHER
  # people's scenes sets `world.scenePolicy.unknownComponents = report`
  # (#996): the same two cases become a SceneDiagnostic and the node mounts
  # with the components it has. The two cases, so the author knows which:
  #   - the name is a world table that is derived / runtime state, never
  #     authored (ComputedRect, Parent, ...) -> "not authorable";
  #   - the name is no component at all (a typo, or a non-UI component such
  #     as a 3D `Transform3d` in a UI scene) -> "not registered".
  let report: Bool = world.scenePolicy.unknownComponents is UnknownComponentPolicy.report
  if isRuntimeTable(name: name) {
    if report {
      reportSceneDiagnostic(
        diagnostics: world.sceneDiagnostics
        sceneId: sceneId
        nodeId: nodeId
        kind: SceneDiagnosticKind.runtimeOnlyComponent
        name: name
        message: "{name} is a runtime/derived table and cannot be authored"
      )
      ret
    }
    log(
      "[scene] {sceneId} node {nodeId}: component {name} is a runtime/derived table and cannot be authored"
    )
  } else {
    if report {
      reportSceneDiagnostic(
        diagnostics: world.sceneDiagnostics
        sceneId: sceneId
        nodeId: nodeId
        kind: SceneDiagnosticKind.unknownComponent
        name: name
        message: "{name} is not a registered component"
      )
      ret
    }
    log("[scene] {sceneId} node {nodeId}: component {name} is not registered")
  }
  exit(code: 1)
}

# The authored shapes that are not field-structural, patched onto the
# generically decoded component. Each arm is the difference between the JSON
# grammar and the Rae fields, nothing more.
func applyAuthoredFixups(
  world: mod UiWorld
  entity: view EntityId
  name: view String
  doc: view JsonDoc
  val: view JsonValue
  sceneId: view String
  nodeId: view String
) {
  if name is "Rect" {
    # {x, y, w, h} -> position / size.
    let rect: mod Rect => componentMod(this: world.rects, entity: entity)
    rect.position.x = optFloat(
      doc: doc
      container: val
      key: "x"
      fallback: 0.0
    )
    rect.position.y = optFloat(
      doc: doc
      container: val
      key: "y"
      fallback: 0.0
    )
    rect.size.x = optFloat(
      doc: doc
      container: val
      key: "w"
      fallback: 0.0
    )
    rect.size.y = optFloat(
      doc: doc
      container: val
      key: "h"
      fallback: 0.0
    )
    ret
  }
  if name is "Layout" {
    # The layout kind is authored as `type` (RUICS vocabulary), not `kind`.
    let layout: mod Layout => componentMod(this: world.layouts, entity: entity)
    if Json.field(doc: doc, this: val, key: "type") >= 0 {
      layout.kind = parseLayoutType(text: optString(
        doc: doc
        container: val
        key: "type"
        fallback: ""
      ))
    }
    ret
  }
  if name is "Padding" {
    # A padding token names a whole Insets preset (#233):
    # `"Padding": "screenEdgePadding"`; an object gives the four sides
    # flattened at the top level (each side may itself be a space token).
    let padding: mod Padding => componentMod(this: world.paddings, entity: entity)
    let empty: String = ""
    let asStr: String = Json.jsonString(this: val, fallback: empty)
    if asStr.length() > 0 {
      let ti: ThemeInsets = themePaddingInsets(theme: world.theme.resolved, name: asStr)
      padding.insets = Insets { l: ti.l, t: ti.t, r: ti.r, b: ti.b }
    } else {
      padding.insets = deserInsets(
        doc: doc
        theme: world.theme
        val: val
        diagnostics: world.sceneDiagnostics
        sceneId: sceneId
        nodeId: nodeId
      )
    }
    ret
  }
  if name is "Margin" {
    let margin: mod Margin => componentMod(this: world.margins, entity: entity)
    margin.insets = deserInsets(
      doc: doc
      theme: world.theme
      val: val
      diagnostics: world.sceneDiagnostics
      sceneId: sceneId
      nodeId: nodeId
    )
    ret
  }
  if name is "Offset" {
    let offset: mod Offset => componentMod(this: world.offsets, entity: entity)
    offset.delta = deserVec2(doc: doc, val: val)
    ret
  }
  if name is "Align" {
    # Presence flags: an axis the author did not name stays "unset".
    let align: mod Align => componentMod(this: world.aligns, entity: entity)
    align.hasX = Json.field(doc: doc, this: val, key: "x") >= 0
    align.hasY = Json.field(doc: doc, this: val, key: "y") >= 0
    ret
  }
  if name is "TextShadow" {
    # Lint (#232, theme §7): a raw per-entity TextShadow is the last-resort
    # override, not the authoring path. A shadow that any two nodes share
    # belongs in a theme `shadow` token referenced by a text style.
    log(
      "[scene] raw TextShadow authored on entity {entity.index} - prefer a theme shadow token on the text style (see docs/ui-theme-system.md sec 7)"
    )
    let shadow: mod TextShadow => componentMod(this: world.textShadows, entity: entity)
    shadow.offset.x = optFloat(
      doc: doc
      container: val
      key: "offsetX"
      fallback: 0.0
    )
    shadow.offset.y = optFloat(
      doc: doc
      container: val
      key: "offsetY"
      fallback: 0.0
    )
    ret
  }
  if name is "OpticalAlign" {
    let optical: mod OpticalAlign => componentMod(this: world.opticalAligns, entity: entity)
    optical.bias.x = optFloat(
      doc: doc
      container: val
      key: "biasX"
      fallback: 0.0
    )
    optical.bias.y = optFloat(
      doc: doc
      container: val
      key: "biasY"
      fallback: 0.0
    )
    ret
  }
  if name is "Sprite" {
    let sprite: mod Sprite => componentMod(this: world.sprites, entity: entity)
    sprite.tintSlot = slotNameOf(doc: doc, val: val, key: "tint")
    ret
  }
  if name is "Shape" {
    let shape: mod Shape => componentMod(this: world.shapes, entity: entity)
    shape.fillSlot = slotNameOf(doc: doc, val: val, key: "fill")
    shape.strokeSlot = slotNameOf(doc: doc, val: val, key: "stroke")
    ret
  }
  if name is "Text" {
    # Tier-2 partial style override (#236): namespaced inside the Text bag,
    # stored as a sparse component only when authored. The base styleId is
    # always kept — the override annotates the link to the theme.
    let soIdx: Int = Json.field(doc: doc, this: val, key: "styleOverride")
    if soIdx >= 0 {
      let sov: JsonValue = Json.jsonValueAt(doc: doc, idx: soIdx)
      componentSet(
        this: world.styleOverrides
        entity: entity
        data: deserStyleOverride(
          doc: doc
          theme: world.theme
          val: sov
          diagnostics: world.sceneDiagnostics
          sceneId: sceneId
          nodeId: nodeId
        )
      )
    }
    ret
  }
  if name is "DataDependency" {
    # Authored as sourceKey / fieldKey; the ids are enum members spelled the
    # same way, so the lookup is the compile-time member table.
    let dep: mod DataDependency => componentMod(this: world.dataDependencies, entity: entity)
    dep.resource = dataResourceIdFromString(name: optString(
      doc: doc
      container: val
      key: "sourceKey"
      fallback: ""
    ))
    dep.field = dataFieldIdFromString(name: optString(
      doc: doc
      container: val
      key: "fieldKey"
      fallback: ""
    ))
    ret
  }
  if name is "RefreshRegion" {
    let region: mod RefreshRegion => componentMod(this: world.refreshRegions, entity: entity)
    region.resource = dataResourceIdFromString(name: optString(
      doc: doc
      container: val
      key: "sourceKey"
      fallback: ""
    ))
    ret
  }
  if name is "SceneInstance" {
    let instance: mod SceneInstance => componentMod(this: world.sceneInstances, entity: entity)
    deserSceneInstanceOverrides(instance: instance, doc: doc, val: val)
    ret
  }
  if name is "ListView" {
    let listView: mod ListView => componentMod(this: world.listViews, entity: entity)
    listView.bindings = deserListViewBindings(doc: doc, val: val)
    ret
  }
}
