# Terrain splat pipeline (#533) — split out of gbuffer.rae.
#
# The ground tiles use their own pipeline and bind group: the shader ignores the
# per-draw colour and samples a biome field per vertex, so one mesh shows
# grass / sand / mud / rock / water. That is a terrain concern, not a G-buffer
# primitive, and gbuffer.rae is at the compiler's hard 1000-line cap.
open Gbuffer
open GbufferResources
open GbufferRecord
open Scene3d
open Math3d
open webgpu/Webgpu
open WorldBiome
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds

# Force a terrain-pipeline rebuild on the next draw. The island radius is baked
# into the composed shader as a const (islandParamsWgsl), so growing the island
# (#41) must recompose it. The old pipeline and its bind group are RETIRED here
# (#912: manager-owned, released once nothing in flight uses them — a resizing
# island no longer leaks a pipeline per grow). The bind group is auto-layouted
# from the OLD pipeline and is invalid against the new one (wgpu auto-layouts
# are pipeline-exclusive), so it rebuilds too — gen -1 never matches gbTerrainTexGen.
func resetTerrainPipeline(cache: mod GbufferCache, resources: mod GpuResources) pub {
  retireBindGroup(resources: resources, id: cache.terrainBind)
  releaseExternalIds(resources: resources, list: cache.terrainAdopted)
  retireRenderPipeline(resources: resources, id: cache.terrainPipeline)
  cache.terrainBind = noBindGroupId()
  cache.terrainPipeline = noRenderPipelineId()
  cache.terrainPipeMade = false
  cache.terrainBindGen = 0 - 1
}

# Textured terrain (#9 grass, extended to a material ARRAY in #14). The material
# array is a C asset upload (rae_gb_terrain_array_*) whose 2d-array view is read
# through rae_gb_terrain_array_view and adopted into the bind group; the repeat
# sampler is a manager sampler and the blend a plain cache field (#912). The
# generation bumps when the array is (re)created so the bind group rebinds it.
# One texture_2d_array, one layer per material — see terrainLayers below and
# lib/terrain_splat.wgsl.
func gbTerrainArrayView() unsafe extern("rae_gb_terrain_array_view") ret Ptr

func nativeGbTerrainTexGen() unsafe extern("rae_gb_terrain_tex_gen") ret Int

func gbTerrainTexGen() ret Int {
  unsafe {
    ret nativeGbTerrainTexGen()
  }
}

func nativeGbTerrainArrayInit(
  w: Int
  h: Int
  layers: Int
) unsafe extern("rae_gb_terrain_array_init")

func gbTerrainArrayInit(w: copy Int, h: copy Int, layers: copy Int) {
  unsafe {
    nativeGbTerrainArrayInit(w: w, h: h, layers: layers)
  }
}

func nativeGbTerrainArrayWrite(
  layer: Int
  pixels: view Buffer(Int)
  w: Int
  h: Int
) unsafe extern("rae_gb_terrain_array_write")

func gbTerrainArrayWrite(
  layer: copy Int
  pixels: view Buffer(Int)
  w: copy Int
  h: copy Int
) {
  unsafe {
    nativeGbTerrainArrayWrite(
      layer: layer
      pixels: pixels
      w: w
      h: h
    )
  }
}

# Layers of the material array, indexed to match lib/terrain_splat.wgsl:
# 0 grass, 1 sand, 2 road, 3 water. (Rock has no plate-harvestable ground tile,
# so it stays procedural — see the fragment shader.)
func terrainLayers() pub ret Int {
  ret 4
}

# Create the material array (all tiles are the same size). The game calls this
# once, then uploads each layer with terrainUploadLayer and turns the blend on
# with terrainSetBlend. Init installs the 2d-array view + bumps the generation so
# the bind group rebinds it.
func terrainInitArray(w: copy Int, h: copy Int) pub {
  gbTerrainArrayInit(w: w, h: h, layers: terrainLayers())
}

# Upload one material layer (packed RGBA, order R,G,B,A per pixel — the format
# decodePng+swap produces). Does not rebind: the view already points at this
# texture, so the new layer content is visible immediately.
func terrainUploadLayer(
  layer: copy Int
  pixels: view Buffer(Int)
  w: copy Int
  h: copy Int
) pub {
  gbTerrainArrayWrite(
    layer: layer
    pixels: pixels
    w: w
    h: h
  )
}

func terrainSetBlend(cache: mod GbufferCache, blend: copy Float) pub {
  cache.terrainBlend = blend
}

# Sampler + a 1x1 white fallback ARRAY, so the terrain bind group always has valid
# resources at binding(2)/(3) even for an app that never uploads tiles (blend is 0
# there, so the fallback is sampled but never visible). One white texel per layer.
func ensureTerrainTexDefaults(cache: mod GbufferCache, resources: mod GpuResources) {
  if not isValidSampler(resources: resources, id: cache.terrainSampler) {
    if let sampler: SamplerId = createSamplerWith(
      resources: resources
      addressMode: WGPUAddressMode_Repeat
    ) {
      cache.terrainSampler = sampler
    }
  }
  unsafe {
    if gbTerrainArrayView() is webgpuNull() {
      gbTerrainArrayInit(w: 1, h: 1, layers: terrainLayers())
      var one: List(Int) = List.create(Int, cap: 1)
      one.add(value: 4294967295)  # 0xFFFFFFFF, opaque white
      var l: Int = 0
      loop l < terrainLayers() {
        gbTerrainArrayWrite(
          layer: l
          pixels: one.data
          w: 1
          h: 1
        )
        l = l + 1
      }
    }
  }
}

func nativeSysFileExists(path: String) unsafe extern("rae_ext_rae_sys_exists") ret Bool

func sysFileExists(path: copy String) ret Bool {
  unsafe {
    ret nativeSysFileExists(path: path)
  }
}

# The grade-calibrated RAE_TERRAIN_* palette, PER APP (#13). An app that ships its
# own calibrated copy at assets/terrain_palette.wgsl (which the iOS bundle carries
# too) overrides the shared lib default; anything else — example 114 on neutral
# ACES — uses the default. This is what keeps the game's grade-specific numbers
# out of the shared lib: the two apps are no longer bound to one calibration.
func terrainPaletteWgsl(cache: view GbufferCache) ret String {
  if cache.terrainPalettePath.length() > 0 and sysFileExists(path: cache.terrainPalettePath) {
    ret gbReadWgsl(path: cache.terrainPalettePath)
  }
  if sysFileExists(path: "assets/terrain_palette.wgsl") {
    ret gbReadWgsl(path: "assets/terrain_palette.wgsl")
  }
  ret gbReadWgsl(path: "lib/terrain_palette.wgsl")
}

# Point the terrain at an app's own palette file by path — for an app whose
# cwd is not its project root (the examples run from the repo root, so the
# cwd-relative `assets/terrain_palette.wgsl` lookup cannot find theirs). Call
# before the first terrain draw; the pipeline composes the palette once.
func terrainSetPalette(cache: mod GbufferCache, resources: mod GpuResources, path: view String) {
  cache.terrainPalettePath = "{path}"
  resetTerrainPipeline(cache: cache, resources: resources)
}

# Compose the terrain-splat shader from the aligned WGSL files (noise + biome +
# palette + terrain), read once at pipeline build. See lib/terrain_splat.wgsl /
# #533. The palette is composed BEFORE terrain_detail so its RAE_TERRAIN_*
# constants are in scope for the material ramps.
func terrainSplatWgsl(cache: view GbufferCache) ret String {
  let islandSrc: String = islandParamsWgsl()
  let noiseSrc: String = gbReadWgsl(path: "lib/noise.wgsl")
  let biomeSrc: String = gbReadWgsl(path: "lib/world_biome.wgsl")
  let paletteSrc: String = terrainPaletteWgsl(cache: cache)
  let detailSrc: String = gbReadWgsl(path: "lib/terrain_detail.wgsl")
  let terrSrc: String = gbReadWgsl(path: "lib/terrain_splat.wgsl")
  ret islandSrc.concat(other: noiseSrc).concat(other: "\n").concat(other: biomeSrc).concat(
    other: "\n"
  ).concat(other: paletteSrc).concat(other: "\n").concat(other: detailSrc).concat(other: "\n").concat(
    other: terrSrc
  )
}

func ensureTerrainPipeline(cache: mod GbufferCache, resources: mod GpuResources) {
  if not cache.terrainPipeMade {
    cache.terrainPipeMade = true
    let composed: String = terrainSplatWgsl(cache: cache)
    cache.terrainPipeline = createGbufferPipeline(
      resources: resources
      wgsl: composed
      stride: 32
      attributes: gbufferStaticAttributes()
    )
  }
  # A bind group from the TERRAIN pipeline's own layout (wgpu auto-layouts are
  # pipeline-exclusive, so the static bind group can't be reused) — frame uniform
  # @0, draws storage @1, and (#9) the terrain tile @2 + its sampler @3. Rebuilt
  # only when the tile generation changes (or the bind is not usable yet: the
  # first call can precede the frame buffers), so the steady state pays nothing.
  ensureTerrainTexDefaults(cache: cache, resources: resources)
  let gen: Int = gbTerrainTexGen()
  if gen is cache.terrainBindGen and bindGroupIsUsable(resources: resources, id: cache.terrainBind) {
    ret
  }
  cache.terrainBindGen = gen
  retireBindGroup(resources: resources, id: cache.terrainBind)
  cache.terrainBind = noBindGroupId()
  releaseExternalIds(resources: resources, list: cache.terrainAdopted)
  # The frame uniform + draws buffers are the cache's own manager buffers
  # (#906); only the C material array's view is adopted.
  if not isValidBuffer(resources: resources, id: cache.frameUniform) {
    ret
  }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
  entries.add(value: bufferRef(id: cache.frameUniform))
  entries.add(value: bufferRef(id: cache.draws))
  unsafe {
    entries.add(
      value: adoptTextureViewRef(
        resources: resources
        adopted: cache.terrainAdopted
        handle: gbTerrainArrayView()
      )
    )
  }
  entries.add(value: samplerRef(id: cache.terrainSampler))
  var made: Bool = false
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.terrainPipeline
    entries: entries
  ) {
    cache.terrainBind = bind
    made = true
  }
  if not made {
    releaseExternalIds(resources: resources, list: cache.terrainAdopted)
  }
}

# Draw one ground-tile mesh with the biome-splat pipeline (#533): its shader
# ignores the per-draw colour and samples the biome field per vertex, so the
# ground shows grass/sand/mud/rock/water. Restores the static pipeline after so a
# following static draw is unaffected. Same DrawU/vertex layout as the static path.
# `time` rides in the DrawU record's LAST slot, the one the skinned path calls
# paletteBase. Terrain is never skinned, so the slot is dead weight here, and the
# alternative -- adding a field to the shared frame uniform -- would touch every
# pipeline for the benefit of one. The water in terrain_splat.wgsl reads it as
# d.params.w. Documented at both ends so nobody wires a joint palette to a clock.
# #745: takes composed model matrices directly (Quat-friendly), not a Euler
# Transform3d — the caller builds them with transform3dToMatrix from the entity's
# Quat Transform3D, so no Euler Vec3 rotation survives on the terrain path.
func drawTerrainMesh(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: copy Int
  model: view Mat4
  prevModel: view Mat4
  roughness: copy Float
  time: copy Float
) pub {
  unsafe {
    ensureTerrainPipeline(cache: cache, resources: resources)
    if gbMeshReady(cache: cache, resources: resources, mesh: mesh) is 0 {
      ret
    }
    let base: Int = gbDrawCount(cache: cache)
    if base >= gbufferMaxDraws {
      ret
    }
    ensureDrawScratch(cache: cache)
    packInstanceRecord(
      records: cache.drawScratch
      slot: 0
      model: model
      prevModel: prevModel
      r: 1.0
      g: 1.0
      b: 1.0
      metallic: 0.0
      roughness: roughness
      emissive: 0.0
      toon: 0
      paletteBase: 0
    )
    # paletteBase is an Int in the record API; the clock needs sub-second
    # resolution, so it is written straight into the float slot instead.
    cache.drawScratch.set(index: 39, value: time)
    # #9: slot 32 (albedoMetallic.x, which the terrain shader ignores for colour)
    # carries the global texture-blend amount. 0 until an app uploads a tile, so
    # the shader's textured-grass term is identity for every other terrain user.
    cache.drawScratch.set(index: 32, value: cache.terrainBlend)
    gbIssueInstanced(
      cache: cache
      resources: resources
      pipeline: cache.terrainPipeline
      bind: cache.terrainBind
      vbuf: gbMeshVbuf(cache: cache, resources: resources, mesh: mesh)
      ibuf: gbMeshIbuf(cache: cache, resources: resources, mesh: mesh)
      icount: gbMeshIcount(cache: cache, mesh: mesh)
      base: base
      count: 1
      records: cache.drawScratch.data
    )
  }
}

# Retire the terrain pass's manager objects (renderer shutdown).
func terrainShutdown(cache: mod GbufferCache, resources: mod GpuResources) pub {
  retireBindGroup(resources: resources, id: cache.terrainBind)
  releaseExternalIds(resources: resources, list: cache.terrainAdopted)
  retireRenderPipeline(resources: resources, id: cache.terrainPipeline)
  retireSampler(resources: resources, id: cache.terrainSampler)
  cache.terrainBind = noBindGroupId()
  cache.terrainPipeline = noRenderPipelineId()
  cache.terrainSampler = noSamplerId()
  cache.terrainPipeMade = false
  cache.terrainBindGen = 0 - 1
}
