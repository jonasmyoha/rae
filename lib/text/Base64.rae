# Base64 (RFC 4648 §4, the standard alphabet with `=` padding) in plain Rae,
# for the WebSocket handshake and data URIs (docs/server-benchmarks-design.md
# §9 G5).
#
# Decoding is strict: the length must be a multiple of 4, `=` may appear only
# as the last one or two characters, and any other character (whitespace
# included) is an error. The unused bits of the last character are not
# checked, as most decoders do.
const base64Alphabet: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

# Append the base64 of `count` bytes of `bytes` from `start` to `output`.
# The output grows once (`addDefaults`) and each character is `set` at an
# index kept here: an `add` per character made every write wait on the last
# one's length update.
func appendBase64(
  output: mod List(UInt8)
  bytes: view List(UInt8)
  start: view Int
  count: view Int
) {
  var position: Int = output.length
  output.addDefaults(count: (count + 2) / 3 * 4)
  var i: Int = start
  let end: Int = start + count
  loop i + 3 <= end {
    let first: Int = bytes.copyAtFallback(index: i, fallback: 0) as Int
    let second: Int = bytes.copyAtFallback(index: i + 1, fallback: 0) as Int
    let third: Int = bytes.copyAtFallback(index: i + 2, fallback: 0) as Int
    let group: Int = (first shl 16) bitor (second shl 8) bitor third
    output.set(
      index: position
      value: base64Alphabet.byteAt(index: (group shr 18) bitand 63) as UInt8
    )
    output.set(
      index: position + 1
      value: base64Alphabet.byteAt(index: (group shr 12) bitand 63) as UInt8
    )
    output.set(
      index: position + 2
      value: base64Alphabet.byteAt(index: (group shr 6) bitand 63) as UInt8
    )
    output.set(index: position + 3, value: base64Alphabet.byteAt(index: group bitand 63) as UInt8)
    position = position + 4
    i = i + 3
  }
  let left: Int = end - i
  if left is 0 {
    ret
  }
  var group: Int = bytes.copyAtFallback(index: i, fallback: 0) as Int shl 16
  if left is 2 {
    group = group bitor (bytes.copyAtFallback(index: i + 1, fallback: 0) as Int shl 8)
  }
  output.set(
    index: position
    value: base64Alphabet.byteAt(index: (group shr 18) bitand 63) as UInt8
  )
  output.set(
    index: position + 1
    value: base64Alphabet.byteAt(index: (group shr 12) bitand 63) as UInt8
  )
  var thirdCharacter: UInt8 = 61
  if left is 2 {
    thirdCharacter = base64Alphabet.byteAt(index: (group shr 6) bitand 63) as UInt8
  }
  output.set(index: position + 2, value: thirdCharacter)
  output.set(index: position + 3, value: 61)
}

# The base64 of `bytes`
func base64Encode(bytes: view List(UInt8)) ret String {
  var output: List(UInt8) = List.create(UInt8, cap: (bytes.length + 2) / 3 * 4)
  appendBase64(
    output: output
    bytes: bytes
    start: 0
    count: bytes.length
  )
  ret fromBytes(bytes: output, start: 0, count: output.length)
}

# The base64 of the bytes of `text` (its UTF-8)
func base64EncodeText(text: view String) ret String {
  let count: Int = text.length()
  var bytes: List(UInt8) = List.create(UInt8, cap: count)
  loop var i: Int = 0, i < count, ++i {
    bytes.add(value: text.byteAt(index: i) as UInt8)
  }
  ret base64Encode(bytes: bytes)
}

# The 6-bit value of a base64 character, -1 for any other byte
func base64Value(character: view Int) ret Int {
  if character >= 65 and character <= 90 {
    ret character - 65
  }
  if character >= 97 and character <= 122 {
    ret character - 71
  }
  if character >= 48 and character <= 57 {
    ret character + 4
  }
  if character is 43 {
    ret 62
  }
  if character is 47 {
    ret 63
  }
  ret -1
}

# Each byte's 6-bit value, -1 for a byte that is not a base64 character: a
# table, because the `base64Value` branches mispredict on encoded data
func base64DecodeTable() ret List(Int) {
  var table: List(Int) = List.create(Int, cap: 256)
  loop var character: Int = 0, character < 256, ++character {
    table.add(value: base64Value(character: character))
  }
  ret table
}

# Decode `text` onto the end of `output`. False (and `output` as it was)
# when `text` is not valid base64. The output grows once (`addDefaults`) and
# each byte is `set` at an index kept here. Every group but the last is
# decoded without a padding test (only the last may hold `=`), and checked
# once for an invalid character.
func appendBase64Decoded(output: mod List(UInt8), text: view String) ret Bool {
  let length: Int = text.length()
  if length % 4 is not 0 {
    ret false
  }
  if length is 0 {
    ret true
  }
  let before: Int = output.length
  var padding: Int = 0
  if text.byteAt(index: length - 1) is 61 {
    padding = 1
    if text.byteAt(index: length - 2) is 61 {
      padding = 2
    }
  }
  output.addDefaults(count: length / 4 * 3 - padding)
  let table: List(Int) = base64DecodeTable()
  let lastGroup: Int = length - 4
  var position: Int = before
  var i: Int = 0
  loop i < lastGroup {
    let first: Int = table.copyAtFallback(index: text.byteAt(index: i), fallback: -1)
    let second: Int = table.copyAtFallback(index: text.byteAt(index: i + 1), fallback: -1)
    let third: Int = table.copyAtFallback(index: text.byteAt(index: i + 2), fallback: -1)
    let fourth: Int = table.copyAtFallback(index: text.byteAt(index: i + 3), fallback: -1)
    if (first bitor second bitor third bitor fourth) < 0 {
      output.truncate(len: before)
      ret false
    }
    let group: Int = (first shl 18) bitor (second shl 12) bitor (third shl 6) bitor fourth
    output.set(index: position, value: ((group shr 16) bitand 255) as UInt8)
    output.set(index: position + 1, value: ((group shr 8) bitand 255) as UInt8)
    output.set(index: position + 2, value: (group bitand 255) as UInt8)
    position = position + 3
    i = i + 4
  }
  # The last group: `=` only as its last one or two characters
  let first: Int = table.copyAtFallback(index: text.byteAt(index: lastGroup), fallback: -1)
  let second: Int = table.copyAtFallback(index: text.byteAt(index: lastGroup + 1), fallback: -1)
  var third: Int = table.copyAtFallback(index: text.byteAt(index: lastGroup + 2), fallback: -1)
  var fourth: Int = table.copyAtFallback(index: text.byteAt(index: lastGroup + 3), fallback: -1)
  if padding >= 1 {
    fourth = 0
  }
  if padding is 2 {
    third = 0
  }
  if (first bitor second bitor third bitor fourth) < 0 {
    output.truncate(len: before)
    ret false
  }
  let group: Int = (first shl 18) bitor (second shl 12) bitor (third shl 6) bitor fourth
  output.set(index: position, value: ((group shr 16) bitand 255) as UInt8)
  if padding < 2 {
    output.set(index: position + 1, value: ((group shr 8) bitand 255) as UInt8)
  }
  if padding < 1 {
    output.set(index: position + 2, value: (group bitand 255) as UInt8)
  }
  ret true
}

# The bytes `text` encodes, or none when it is not valid base64
func base64Decode(text: view String) ret opt List(UInt8) {
  var output: List(UInt8) = List.create(UInt8, cap: text.length() / 4 * 3)
  if appendBase64Decoded(output: output, text: text) {
    ret output
  }
  ret none
}
