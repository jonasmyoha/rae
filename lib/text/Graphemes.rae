# Graphemes — the characters a person sees, in a UTF-8 text: a letter with its combining marks, an
# emoji made of several code points, a flag, a Korean syllable (the extended grapheme clusters of
# Unicode 17's UAX #29, without its rule for Indic conjuncts). A caret moves from one boundary to
# the next, and Backspace takes away one whole.
#
#     let end: Int = nextGrapheme(text: name, at: 0)         # byte offsets
#     let last: Int = previousGrapheme(text: name, at: name.length())
open text/NameOrder

# What joins to the character before it (combining marks, variation selectors, skin tones, tags)
const joiningRanges: String = ""

# The pictures (Extended_Pictographic)
const pictureRanges: String = ""

# What joins to the character after it
const prependRanges: String = "0060000605006dd006dd0070f0070f0089000891008e2008e200d4e00d4e110bd110bd110cd110cd111c2111c31193f1193f119411194111a3a11a3a11a8411a8911d4611d46"

enum GraphemeClass {
  other
  carriageReturn
  lineFeed
  control
  joining
  joiner
  prepend
  region
  picture
  hangulL
  hangulV
  hangulT
  hangulLv
  hangulLvt
}

func hexDigit(byte: view Int) ret Int {
  if byte >= 97 {
    ret byte - 87
  }
  ret byte - 48
}

# The number of 5 hexadecimal digits at `at`
func hexNumber(table: view String, at: view Int) ret Int {
  var number: Int = 0
  loop var i: Int = 0, i < 5, ++i {
    number = number * 16 + hexDigit(byte: table.byteAt(index: at + i))
  }
  ret number
}

# Is `code` in one of the sorted ranges of `table` (each 10 digits, its first and last)?
func inRanges(table: view String, code: view Int) ret Bool {
  var low: Int = 0
  var high: Int = table.length() / 10
  loop low < high {
    let middle: Int = (low + high) / 2
    if code > hexNumber(table: table, at: middle * 10 + 5) {
      low = middle + 1
    } else if code < hexNumber(table: table, at: middle * 10) {
      high = middle
    } else {
      ret true
    }
  }
  ret false
}

func graphemeClass(code: view Int) ret GraphemeClass {
  if code < 128 {
    if code is 13 {
      ret GraphemeClass.carriageReturn
    }
    if code is 10 {
      ret GraphemeClass.lineFeed
    }
    if code < 32 or code is 127 {
      ret GraphemeClass.control
    }
    ret GraphemeClass.other
  }
  if code < 160 or code is 173 {
    ret GraphemeClass.control
  }
  if code is 0x200D {
    ret GraphemeClass.joiner
  }
  if code is 0x200B or (code >= 0x200E and code <= 0x200F) or (code >= 0x2028 and code <= 0x202E) or (code >= 0x2060 and code <= 0x206F) or code is 0xFEFF {
    ret GraphemeClass.control
  }
  if code >= 0x1F1E6 and code <= 0x1F1FF {
    ret GraphemeClass.region
  }
  if code >= 0xAC00 and code <= 0xD7A3 {
    if (code - 0xAC00) % 28 is 0 {
      ret GraphemeClass.hangulLv
    }
    ret GraphemeClass.hangulLvt
  }
  if (code >= 0x1100 and code <= 0x115F) or (code >= 0xA960 and code <= 0xA97C) {
    ret GraphemeClass.hangulL
  }
  if (code >= 0x1160 and code <= 0x11A7) or (code >= 0xD7B0 and code <= 0xD7C6) {
    ret GraphemeClass.hangulV
  }
  if (code >= 0x11A8 and code <= 0x11FF) or (code >= 0xD7CB and code <= 0xD7FB) {
    ret GraphemeClass.hangulT
  }
  if inRanges(table: joiningRanges, code: code) {
    ret GraphemeClass.joining
  }
  if inRanges(table: pictureRanges, code: code) {
    ret GraphemeClass.picture
  }
  if inRanges(table: prependRanges, code: code) {
    ret GraphemeClass.prepend
  }
  ret GraphemeClass.other
}

# Where the character at `at` (a boundary) ends: the next boundary, the text's end at most
func nextGrapheme(text: view String, at: view Int) ret Int {
  let length: Int = text.length()
  if at >= length {
    ret length
  }
  let first: CodePoint = codePointAt(text: text, at: at)
  var previous: GraphemeClass = graphemeClass(code: first.code)
  var end: Int = at + first.length
  # a picture, and what joins to it, so far; then a joiner right after that
  var picture: Bool = previous is GraphemeClass.picture
  var pictureJoiner: Bool = false
  var regions: Int = 0
  if previous is GraphemeClass.region {
    regions = 1
  }
  loop end < length {
    let point: CodePoint = codePointAt(text: text, at: end)
    let next: GraphemeClass = graphemeClass(code: point.code)
    if breaksBetween(
      previous: previous
      next: next
      pictureJoiner: pictureJoiner
      regions: regions
    ) {
      ret end
    }
    pictureJoiner = picture and next is GraphemeClass.joiner
    if next is not GraphemeClass.joining {
      picture = next is GraphemeClass.picture
    }
    if next is GraphemeClass.region {
      regions = regions + 1
    } else {
      regions = 0
    }
    previous = next
    end = end + point.length
  }
  ret length
}

func breaksBetween(
  previous: view GraphemeClass
  next: view GraphemeClass
  pictureJoiner: view Bool
  regions: view Int
) ret Bool {
  if previous is GraphemeClass.carriageReturn and next is GraphemeClass.lineFeed {
    ret false
  }
  if previous is GraphemeClass.carriageReturn or previous is GraphemeClass.lineFeed or previous is GraphemeClass.control {
    ret true
  }
  if next is GraphemeClass.carriageReturn or next is GraphemeClass.lineFeed or next is GraphemeClass.control {
    ret true
  }
  if next is GraphemeClass.joining or next is GraphemeClass.joiner or previous is GraphemeClass.prepend {
    ret false
  }
  if previous is GraphemeClass.hangulL {
    if next is GraphemeClass.hangulL or next is GraphemeClass.hangulV or next is GraphemeClass.hangulLv or next is GraphemeClass.hangulLvt {
      ret false
    }
  }
  if previous is GraphemeClass.hangulLv or previous is GraphemeClass.hangulV {
    if next is GraphemeClass.hangulV or next is GraphemeClass.hangulT {
      ret false
    }
  }
  if (previous is GraphemeClass.hangulLvt or previous is GraphemeClass.hangulT) and next is GraphemeClass.hangulT {
    ret false
  }
  if next is GraphemeClass.picture and pictureJoiner {
    ret false
  }
  if next is GraphemeClass.region and previous is GraphemeClass.region {
    ret regions % 2 is 0
  }
  ret true
}

# The boundary before `at`, 0 at least
func previousGrapheme(text: view String, at: view Int) ret Int {
  let end: Int = graphemeBoundary(text: text, at: at)
  if end < at {
    ret end
  }
  if at <= 0 {
    ret 0
  }
  ret graphemeBoundary(text: text, at: at - 1)
}

# `at`, or the boundary before it where it is inside a character
func graphemeBoundary(text: view String, at: view Int) ret Int {
  if at <= 0 {
    ret 0
  }
  if at >= text.length() {
    ret text.length()
  }
  # from an ASCII letter or sign before it, which always starts a character, or the text's start
  var start: Int = at
  loop start > 0 and not startsForSure(text: text, at: start) {
    start = start - 1
  }
  loop true {
    let end: Int = nextGrapheme(text: text, at: start)
    if end > at {
      ret start
    }
    start = end
  }
  ret start
}

# An ASCII character (no control) after another, or after the text's start
func startsForSure(text: view String, at: view Int) ret Bool {
  if at is 0 {
    ret true
  }
  let byte: Int = text.byteAt(index: at)
  let before: Int = text.byteAt(index: at - 1)
  ret byte >= 32 and byte < 127 and before >= 32 and before < 127
}
