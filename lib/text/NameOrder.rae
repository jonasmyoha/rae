type CodePoint {
  code: Int
  # in bytes
  length: Int
}

# The code point at byte `at`; a byte that starts no UTF-8 character is itself
func codePointAt(text: view String, at: view Int) ret CodePoint {
  let first: Int = text.byteAt(index: at)
  if first < 128 {
    ret CodePoint { code: first, length: 1 }
  }
  var length: Int = 0
  var code: Int = 0
  if first >= 194 and first < 224 {
    length = 2
    code = first - 192
  } else if first >= 224 and first < 240 {
    length = 3
    code = first - 224
  } else if first >= 240 and first < 245 {
    length = 4
    code = first - 240
  }
  if length is 0 or at + length > text.length() {
    ret CodePoint { code: first, length: 1 }
  }
  loop var i: Int = 1, i < length, ++i {
    let next: Int = text.byteAt(index: at + i)
    if next < 128 or next >= 192 {
      ret CodePoint { code: first, length: 1 }
    }
    code = code * 64 + next - 128
  }
  ret CodePoint { code: code, length: length }
}

func foldTable(lines: view List(String), start: view Int) ret List(Int) {
  var table: List(Int) = {}
  loop let line: view String in lines {
    var at: Int = 0
    loop at < line.length() {
      let point: CodePoint = codePointAt(text: line, at: at)
      if point.code is 46 {
        table.add(value: start + table.length)
      } else {
        table.add(value: point.code)
      }
      at = at + point.length
    }
  }
  ret table
}

func createNameFold() ret NameFold {
  ret NameFold {
    latin: foldTable(lines: latinFolds(), start: latinStart)
    greekCyrillic: foldTable(lines: greekCyrillicFolds(), start: greekStart)
    extended: foldTable(lines: extendedFolds(), start: extendedStart)
  }
}

# A code point's folded letter; 0 for a combining mark
func foldCode(fold: view NameFold, code: view Int) ret Int {
  if code < 128 {
    if code >= 65 and code <= 90 {
      ret code + 32
    }
    ret code
  }
  if code >= marksStart and code < greekStart {
    ret 0
  }
  if code >= latinStart and code < latinStart + fold.latin.length {
    ret fold.latin.copyAtFallback(index: code - latinStart, fallback: code)
  }
  if code >= greekStart and code < greekStart + fold.greekCyrillic.length {
    ret fold.greekCyrillic.copyAtFallback(index: code - greekStart, fallback: code)
  }
  if code >= extendedStart and code < extendedStart + fold.extended.length {
    ret fold.extended.copyAtFallback(index: code - extendedStart, fallback: code)
  }
  ret code
}

func appendUtf8(bytes: mod List(UInt8), code: view Int) {
  if code < 128 {
    bytes.add(value: code as UInt8)
  } else if code < 2048 {
    bytes.add(value: (192 + code / 64) as UInt8)
    bytes.add(value: (128 + code % 64) as UInt8)
  } else if code < 65536 {
    bytes.add(value: (224 + code / 4096) as UInt8)
    bytes.add(value: (128 + code / 64 % 64) as UInt8)
    bytes.add(value: (128 + code % 64) as UInt8)
  } else {
    bytes.add(value: (240 + code / 262144) as UInt8)
    bytes.add(value: (128 + code / 4096 % 64) as UInt8)
    bytes.add(value: (128 + code / 64 % 64) as UInt8)
    bytes.add(value: (128 + code % 64) as UInt8)
  }
}

# `text` folded (case and accents), for finding a part or the start of a name
func foldedText(fold: view NameFold, text: view String) ret String {
  var bytes: List(UInt8) = List.create(UInt8, cap: text.length() + 4)
  var at: Int = 0
  loop at < text.length() {
    let point: CodePoint = codePointAt(text: text, at: at)
    let code: Int = foldCode(fold: fold, code: point.code)
    if code > 0 {
      appendUtf8(bytes: bytes, code: code)
    }
    at = at + point.length
  }
  ret String.fromBytes(bytes: bytes, start: 0, count: bytes.length)
}

# A number longer than this many digits is ordered by its first ones
const longestNumber: Int = 200

# The key of `name`: folded, each run of digits as "0", how many digits it has (leading zeros
# left out) and the digits, so a longer number is a larger one. Only to be compared: its bytes are
# not always UTF-8.
func nameKey(fold: view NameFold, name: view String) ret String {
  let length: Int = name.length()
  var bytes: List(UInt8) = List.create(UInt8, cap: length + 8)
  var at: Int = 0
  loop at < length {
    let byte: Int = name.byteAt(index: at)
    if byte >= 48 and byte <= 57 {
      var start: Int = at
      loop at < length and name.byteAt(index: at) >= 48 and name.byteAt(index: at) <= 57 {
        at = at + 1
      }
      loop start < at - 1 and name.byteAt(index: start) is 48 {
        start = start + 1
      }
      var digits: Int = at - start
      if digits > longestNumber {
        digits = longestNumber
      }
      bytes.add(value: 48)
      bytes.add(value: (digits + 1) as UInt8)
      loop var i: Int = 0, i < digits, ++i {
        bytes.add(value: name.byteAt(index: start + i) as UInt8)
      }
    } else {
      let point: CodePoint = codePointAt(text: name, at: at)
      let code: Int = foldCode(fold: fold, code: point.code)
      if code > 0 {
        appendUtf8(bytes: bytes, code: code)
      }
      at = at + point.length
    }
  }
  ret String.fromBytes(bytes: bytes, start: 0, count: bytes.length)
}

# The order of two names: < 0, 0 or > 0. For a few names; a long list makes its keys once.
func compareNames(fold: view NameFold, a: view String, b: view String) ret Int {
  let byKey: Int = nameKey(fold: fold, name: a).compare(other: nameKey(fold: fold, name: b))
  if byKey is not 0 {
    ret byKey
  }
  ret a.compare(other: b)
}
