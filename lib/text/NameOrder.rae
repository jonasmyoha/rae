# NameOrder — the order of names as people read them (docs/file-browser-design.md §3).
#
#     let fold: NameFold = createNameFold()
#     let key: String = nameKey(fold: fold, name: "File 10.txt")
#
# Two names are compared by the bytes of their keys (String.compare), made once per name:
#   - case does not count, and neither do accents: a letter is its base letter, whether the accent
#     is part of it (é) or a mark after it (e and U+0301; macOS stores either). Names that differ
#     only so have one key: put the plain one first by comparing the names' own bytes next.
#   - a run of digits is a number: "file2" comes before "file10", and "file02" has file2's key.
#
# Letters are folded in Latin, Greek and Cyrillic (U+00C0..024F, 0370..052F, 1E00..1FFF, from the
# Unicode canonical decompositions); everything else goes by its code point. No language's own
# rules (Swedish å after z) are applied. A name that is not UTF-8 (Linux allows it) is ordered by
# its bytes.

# The folded letter of each code point of the three blocks, 0 for a mark that is dropped
type NameFold {
  latin: List(Int)
  greekCyrillic: List(Int)
  extended: List(Int)
}

const latinStart: Int = 192

const greekStart: Int = 880

const extendedStart: Int = 7680

# The combining marks U+0300..036F
const marksStart: Int = 768

# One character per code point from a block's start, 64 a line; "." is the letter itself
