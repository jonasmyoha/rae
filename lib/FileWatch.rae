# Polling file watcher. A primitive that detects on-disk mtime changes;
# what to do about a change (re-parse scene JSON, recompile bytecode,
# swap a function table, reload a shader, ...) is the caller's job.
#
# The classic use case is *data hot reload* — see `examples/98_mobile_ui`
# (live `.raescene` editing) and `examples/99_data_hot_reload` (any
# config file) — but the same primitive could equally back a *code
# hot reload* trigger by pointing it at `.rae` sources.
#
# How callers wire it in:
#   1. Build a `List(String)` of paths to watch.
#   2. Call `fileWatch.createFileWatcher(paths, enabled, intervalSec)` once after
#      the paths are known. The snapshot records each file's mtime so
#      the first check is quiet.
#   3. Once per frame, call `fileWatch.checkForChanges(watcher, getTime())`.
#      It is throttled by `intervalSec`, so calling every frame is cheap —
#      most calls early-return. Where the OS delivers file notifications
#      (lib/FileNotify.rae) a notification also makes it look at once, and
#      wakes a blocked event loop to do so: an idle app needs no timer.
#   4. When it returns `true`, the caller does whatever reload makes
#      sense: re-parse a JSON file, recompile, etc.
#   5. An event loop asks `fileWatcherNeedsPolling` whether it must wake on a
#      timer for this watcher (lib/ui/EventLoop.rae's `pollWatcher`): only
#      when notifications are unavailable.
#
open FileNotify

type WatchEntry {
  path: String
  # Epoch seconds — Float64 so a ~1.7e9 timestamp keeps sub-second
  # resolution (f32 would quantise it to ~128s and never detect a change).
  lastMtime: Float64
}

type FileWatcher {
  enabled: Bool
  entries: List(WatchEntry)
  intervalSec: Float
  lastCheck: Float64
  notify: FileNotify
}

# Take a snapshot of the current mtimes for every path. Subsequent
# `checkForChanges` calls compare against this baseline, so the first
# poll after construction does not spuriously fire.
func createFileWatcher(
  paths: view List(String)
  enabled: view Bool
  intervalSec: view Float
) ret FileWatcher {
  let entries: List(WatchEntry) = List.create(WatchEntry, cap: paths.length)
  var i: Int = 0
  loop i < paths.length {
    if let p: String = paths.copyAt(index: i) {
      let mt: Float64 = fileModTime(path: p)
      let entry: WatchEntry = { path: p, lastMtime: mt }
      entries.add(value: entry)
    }
    i = i + 1
  }
  let notify: FileNotify = createFileNotify()
  if enabled {
    watchPaths(notify: notify, paths: paths)
  }
  ret FileWatcher {
    enabled: enabled
    entries: entries
    intervalSec: intervalSec
    lastCheck: -intervalSec
    notify: notify
  }
}

func watchPaths(notify: view FileNotify, paths: view List(String)) {
  loop var i: Int = 0, i < paths.length, ++i {
    if let path: String = paths.copyAt(index: i) {
      fileNotifyWatch(fileNotify: notify, path: path)
    }
  }
}

# Whether an event loop must wake on a timer so this watcher sees edits:
# true only when it is on and the OS gives no notifications.
func fileWatcherNeedsPolling(watcher: view FileWatcher) ret Bool {
  ret watcher.enabled and fileNotifyActive(fileNotify: watcher.notify) is false
}

# Returns true if any watched file's mtime changed since the previous
# check. Throttled — calls within `intervalSec` of the last check are free
# (return false) unless an OS notification arrived since. On
# `true`, the stored mtimes are refreshed (and the notifications re-armed,
# since the file there now may be a new inode) so the next call is quiet
# until the next on-disk edit.
func checkForChanges(watcher: mod FileWatcher, now: view Float64) ret Bool {
  if watcher.enabled is false {
    ret false
  }
  let notified: Bool = fileNotifyTakeChanged(fileNotify: watcher.notify)
  if notified is false and now - watcher.lastCheck < watcher.intervalSec {
    ret false
  }
  watcher.lastCheck = now
  var changed: Bool = false
  loop var i: Int = 0, i < watcher.entries.length, ++i {
    # Update the mtime in place: rebuilding the entry copied its path and
    # the raw buffer write over the old entry leaked the old one.
    if let entry: mod WatchEntry => watcher.entries.modAt(index: i) {
      let mt: Float64 = fileModTime(path: entry.path)
      if mt is not entry.lastMtime {
        entry.lastMtime = mt
        changed = true
      }
    }
  }
  if changed {
    fileNotifyClear(fileNotify: watcher.notify)
    loop var j: Int = 0, j < watcher.entries.length, ++j {
      if let entry: view WatchEntry => watcher.entries.viewAt(index: j) {
        fileNotifyWatch(fileNotify: watcher.notify, path: entry.path)
      }
    }
  }
  ret changed
}
