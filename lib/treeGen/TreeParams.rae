# treeGen/TreeParams — what one generated tree is made from: a seed and a
# set of numbers (docs/reference-tree-plan.md). The ranges come from
# reference crop T02, a brown-trunked broadleaf tree with small leaves; the
# kind is named for how it looks, `warmBroadleaf`. Written new: nothing here
# comes from the lib's older tree code.
import Math

type TreeParams {
  seed: Int
  # The whole tree's height (m)
  height: Float
  # The trunk's radius at its base, above the root flare (m): T02's trunk is
  # about 1/17 of the tree's height thick there (measured on the crop)
  baseRadius: Float
  # Where the trunk forks into its two leaders, as a part of the height
  forkHeight: Float
  # The trunk's radius at the fork as a part of its base radius
  forkThickness: Float
  # The compass direction the main leader leans to (radians, 0: +x). The
  # tree's "right": the side branches are placed relative to it.
  forkAzimuth: Float
  # How far the trunk's S-curve swings sideways, as a part of the height
  trunkSway: Float
  # A single bow of the trunk's upper part toward the main leader's side
  # (negative: away from it), as a part of the height
  trunkBow: Float
  # The main leader's lean from upright, and the second leader's (radians)
  mainLean: Float
  secondLean: Float
  # The main leader's length as a part of the height
  mainLength: Float
  # The second leader's length as a part of the main one's, its radius as a
  # part of the trunk's at the fork, and its compass turn from the main one
  # (radians; 0: the same side, pi: the opposite side)
  secondLength: Float
  secondThickness: Float
  secondTurn: Float
  # How much both leaders turn toward upright at each step (negative: away)
  leaderBend: Float
  # The side branches: how many (4 to 6), where on the tree they start (a
  # part of the height), their angle from upright (radians) and their
  # length as a part of the height
  branchCount: Int
  branchFrom: Float
  branchTo: Float
  branchAngleMin: Float
  branchAngleMax: Float
  branchLength: Float
  # The side branches placed by hand (from a trace of the reference): when
  # there are any, they are the tree's side branches instead of the
  # branchCount random ones above
  branchSpots: List(BranchSpot)
  # The thinnest a tip gets (m)
  tipRadius: Float
  # A side branch's radius at its base, as a part of its parent's there
  limbThickness: Float
  # A limb's radius at its tip as a part of its base radius (0: down to
  # tipRadius; 0.55: nearly even all along)
  limbEndThickness: Float
  # How much a limb turns toward upright, and wanders, at each of its steps
  # (0: dead straight)
  limbBend: Float
  limbWander: Float
  # Kinks: at each step a limb may turn by a few degrees at once and then run
  # straight again, as a real branch changes direction where it once grew a
  # side shoot. The chance per step, and the turn's range (radians).
  limbKinkChance: Float
  limbKinkMin: Float
  limbKinkMax: Float
}

# One side branch placed by hand
type BranchSpot {
  # Where it starts, as a part of the tree's height
  height: Float
  # The limb it grows from: 0 the trunk, 1 the main leader, 2 the second
  parent: Int
  # Its compass turn from the main leader's direction (radians; 0: the main
  # leader's side, pi: the other side)
  turn: Float
  # Its angle from upright (radians) and its length (a part of the height)
  angle: Float
  length: Float
  # How much it turns toward upright at each step (negative: it flattens)
  bend: Float
}

# A deterministic random number source: one tree per seed, the same on every
# machine
type TreeRandom {
  state: Int
}

func createTreeRandom(seed: view Int) ret TreeRandom {
  ret TreeRandom { state: (seed * 7919 + 104729) % 2147483648 }
}

# The next number in 0..1
func nextUnit(random: mod TreeRandom) ret Float {
  random.state = (random.state * 1103515245 + 12345) % 2147483648
  ret random.state.toFloat() / 2147483648.0
}

# The next number between `low` and `high`
func nextBetween(random: mod TreeRandom, low: view Float, high: view Float) ret Float {
  ret low + (high - low) * nextUnit(random: random)
}

func degrees(value: view Float) ret Float {
  ret value * 3.141592653589793 / 180.0
}

# The T02 tree, built from the be trace of crop T02
# (looks-development treeReference/traces/T02.js; the tree's height is the
# trace's base to its highest tip, 468 crop pixels). 12.5 m; a slim trunk,
# straight to 40% of its height, then bowing gently to the left and thinning
# to 61% of its base radius at a fork at 79%; two leaders both leaning
# right, the main one 9 degrees, the thinner second one 28; four short side
# branches in the top third: low right off the trunk (66%, 40 degrees), low
# left (70%, 38 degrees), then off the main leader high left (81%, 48
# degrees) and a top one going up left (89%, 20 degrees). The low ones
# flatten a little toward their tips, the top one turns upright. Right is
# +x. The seed moves every part a little and turns each branch up to 20
# degrees out of the picture's plane.
func warmBroadleafParams(seed: view Int) ret TreeParams {
  var params: TreeParams = stoutBroadleafParams(seed: seed)
  var random: TreeRandom = createTreeRandom(seed: seed + 31)
  params.height = 12.5
  params.baseRadius = params.height / 52.0
  params.forkHeight = nextBetween(random: random, low: 0.77, high: 0.8)
  params.forkThickness = 0.61
  params.forkAzimuth = 0.0
  params.trunkSway = 0.003
  params.trunkBow = -nextBetween(random: random, low: 0.012, high: 0.018)
  params.mainLean = degrees(value: nextBetween(random: random, low: 7.0, high: 11.0))
  params.mainLength = nextBetween(random: random, low: 0.13, high: 0.15)
  params.secondLean = degrees(value: nextBetween(random: random, low: 25.0, high: 31.0))
  params.secondLength = nextBetween(random: random, low: 0.85, high: 0.97)
  params.secondThickness = 0.55
  params.secondTurn = nextBetween(random: random, low: -0.3, high: 0.3)
  params.leaderBend = -0.008
  params.limbThickness = 0.4
  params.limbEndThickness = 0.5
  params.limbWander = 0.006
  # No kinks: sharp turns with straight runs between them read as broken,
  # not organic (step 3 round 3)
  params.limbKinkChance = 0.0
  var spots: List(BranchSpot) = List.create(BranchSpot, cap: 4)
  spots.add(value: tracedSpot(
    random: random
    height: 0.655
    parent: 0
    side: 0.0
    angle: 40.0
    length: 0.165
    bend: -0.018
  ))
  spots.add(value: tracedSpot(
    random: random
    height: 0.7
    parent: 0
    side: 3.1415927
    angle: 38.0
    length: 0.137
    bend: -0.018
  ))
  spots.add(value: tracedSpot(
    random: random
    height: 0.81
    parent: 1
    side: 3.1415927
    angle: 48.0
    length: 0.075
    bend: -0.015
  ))
  spots.add(value: tracedSpot(
    random: random
    height: 0.89
    parent: 1
    side: 3.1415927
    angle: 20.0
    length: 0.12
    bend: 0.02
  ))
  params.branchSpots = own spots
  ret params
}

# A traced branch (`side` 0: the main leader's side, pi: the other; `angle`
# in degrees), moved a little by the seed: its height, angle and length, and
# a turn of up to 20 degrees out of the picture's plane
func tracedSpot(
  random: mod TreeRandom
  height: view Float
  parent: view Int
  side: view Float
  angle: view Float
  length: view Float
  bend: view Float
) ret BranchSpot {
  ret BranchSpot {
    height: height + nextBetween(random: random, low: -0.012, high: 0.012)
    parent: parent
    turn: side + nextBetween(random: random, low: -0.35, high: 0.35)
    angle: degrees(value: angle + nextBetween(random: random, low: -3.0, high: 3.0))
    length: length * nextBetween(random: random, low: 0.9, high: 1.1)
    bend: bend
  }
}

# A variation kept from step 3's first round: the same tree with a thick
# trunk (1/17 of the height), thick branches tapering to points, and more
# curved limbs. Not T02, but a good-looking tree of its own.
func stoutBroadleafParams(seed: view Int) ret TreeParams {
  var random: TreeRandom = createTreeRandom(seed: seed + 17)
  let forkHeight: Float = nextBetween(random: random, low: 0.56, high: 0.64)
  let mainLean: Float = degrees(value: nextBetween(random: random, low: 6.0, high: 14.0))
  ret TreeParams {
    seed: seed
    height: 13.5
    baseRadius: 13.5 / 34.0
    forkHeight: forkHeight
    forkThickness: 0.76
    forkAzimuth: nextUnit(random: random) * 6.2831853
    trunkSway: nextBetween(random: random, low: 0.01, high: 0.018)
    trunkBow: 0.0
    mainLean: mainLean
    secondLean: degrees(value: nextBetween(random: random, low: 30.0, high: 40.0))
    # up to the tree's height
    mainLength: (1.0 - forkHeight) / Math.cos(x: mainLean) * 0.94
    secondLength: nextBetween(random: random, low: 0.62, high: 0.8)
    secondThickness: 0.7
    secondTurn: 3.1415927 + nextBetween(random: random, low: -0.4, high: 0.4)
    leaderBend: 0.025
    branchCount: 4 + Math.min(a: 2, b: (nextUnit(random: random) * 3.0).toInt())
    branchFrom: 0.46
    branchTo: 0.86
    branchAngleMin: degrees(value: 35.0)
    branchAngleMax: degrees(value: 60.0)
    branchLength: 0.22
    branchSpots: List.create(BranchSpot, cap: 0)
    tipRadius: 0.02
    limbThickness: 0.62
    limbEndThickness: 0.0
    limbBend: 0.03
    limbWander: 0.05
    limbKinkChance: 0.0
    limbKinkMin: 0.0
    limbKinkMax: 0.0
  }
}
