# treeGen/TracedLimb — one limb (its center line and radii) or one leaf mass
# (an ellipsoid) of a tree traced from a reference picture, already in meters
# (docs/reference-tree-plan.md steps 3 and 4; lib/treeGen/TracedT02.rae
# holds T02's).
import Vec3

type TracedLimb {
  points: List(Vec3)
  radii: List(Float)
  # the limb it grows from (-1: none, the trunk)
  parent: Int
  # 0 the trunk, 1 a leader, 2 a side branch
  order: Int
}

# One leaf mass of a traced tree: an ellipsoid, in meters
type TracedClump {
  center: Vec3
  # its half sizes: across the picture (x), in depth (y) and up (z)
  radii: Vec3
  # the underside's height as a part of the top's (a flatter underside)
  underside: Float
  # its turn in the picture (radians, clockwise as seen from the trace's
  # camera)
  turn: Float
  # the limb it belongs to
  parent: Int
  # which side of the trunk it was traced on: -1 wholly in front of it, 0 at
  # it, 1 wholly behind it
  side: Int
}
