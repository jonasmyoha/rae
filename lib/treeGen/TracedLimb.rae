# treeGen/TracedLimb — one limb of a tree traced from a reference picture:
# its centre line and radii, already in metres (docs/reference-tree-plan.md
# step 3; lib/treeGen/TracedT02.rae holds T02's).
import Vec3

type TracedLimb {
  points: List(Vec3)
  radii: List(Float)
  # the limb it grows from (-1: none, the trunk)
  parent: Int
  # 0 the trunk, 1 a leader, 2 a side branch
  order: Int
}
