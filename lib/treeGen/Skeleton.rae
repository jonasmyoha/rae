# treeGen/Skeleton — a tree's wood as a set of limbs, each a curve of points
# with a radius at every point (docs/reference-tree-plan.md step 3). Grown
# from TreeParams: a tapered, gently curved trunk with a root flare, a fork
# into two unequal leaders below the crown, and side branches: placed by
# hand from a trace of the reference, or 4 to 6 random ones at 35 to 60
# degrees from upright. Written new.
import Math
import Vec3
open treeGen/TreeParams
open treeGen/TracedLimb
open treeGen/LimbJoin
open treeGen/BranchDetail

# One limb: the points of its centre line from base to tip, and its radius
# at each. `parent` is the limb it grows from (-1 for the trunk); `order` is
# 0 for the trunk, 1 for the two leaders, 2 for a side branch.
type Limb {
  points: List(Vec3)
  radii: List(Float)
  parent: Int
  order: Int
}

type TreeSkeleton {
  limbs: List(Limb)
  # Where the trunk forks (world, the tree's foot at the origin)
  forkPoint: Vec3
  # The leaf masses (a traced tree's; none for a generated one so far)
  clumps: List(TracedClump) = List.create(TracedClump, cap: 0)
}

func upVector() ret Vec3 {
  ret Vec3.create(x: 0.0, y: 0.0, z: 1.0)
}

# A direction `angle` radians from upright, toward the compass `azimuth`
func tiltedDirection(angle: view Float, azimuth: view Float) ret Vec3 {
  ret Vec3.create(
    x: Math.sin(x: angle) * Math.cos(x: azimuth)
    y: Math.sin(x: angle) * Math.sin(x: azimuth)
    z: Math.cos(x: angle)
  )
}

# The angle of a direction from upright (radians)
func angleFromUpright(direction: view Vec3) ret Float {
  ret Math.acos(x: Math.max(a: -1.0, b: Math.min(a: 1.0, b: Vec3.vnorm(a: direction).z)))
}

# The trunk, from just under the ground to the fork: an S-curve that swings
# one way and back, a root flare at the foot, tapering to the fork
func growTrunk(params: view TreeParams, random: mod TreeRandom) ret Limb {
  let forkZ: Float = params.height * params.forkHeight
  let azimuth: Float = nextUnit(random: random) * 6.2831853
  let swing: Vec3 = Vec3.create(x: Math.cos(x: azimuth), y: Math.sin(x: azimuth), z: 0.0)
  let across: Vec3 = Vec3.create(x: -swing.y, y: swing.x, z: 0.0)
  let amplitude: Float = params.trunkSway * params.height
  let forkRadius: Float = params.baseRadius * params.forkThickness
  let steps: Int = 18
  var points: List(Vec3) = List.create(Vec3, cap: steps + 1)
  var radii: List(Float) = List.create(Float, cap: steps + 1)
  loop var i: Int = 0, i <= steps, ++i {
    let t: Float = i.toFloat() / steps.toFloat()
    let z: Float = -0.25 + (forkZ + 0.25) * t
    # one full swing and back, with a little sideways drift
    let side: Float = amplitude * Math.sin(x: t * 6.2831853 * 0.75)
    let drift: Float = amplitude * 0.45 * Math.sin(x: t * 3.1415927)
    points.add(
      value: Vec3.vadd(
        a: Vec3.create(x: 0.0, y: 0.0, z: z)
        b: Vec3.vadd(a: Vec3.vscale(a: swing, s: side), b: Vec3.vscale(a: across, s: drift))
      )
    )
    let height: Float = Math.max(a: 0.0, b: z)
    let flare: Float = 1.0 + 0.28 * Math.exp(x: -height / 0.4)
    radii.add(value: (params.baseRadius + (forkRadius - params.baseRadius) * t) * flare)
  }
  ret Limb { points: own points, radii: own radii, parent: -1, order: 0 }
}

# A limb grown from `start` along `direction` for `length` metres: each
# step turns a little toward upright (`rise`) and wanders a little
# (`wander`); the radius goes from `baseRadius` to `tipRadius`
func growLimb(
  start: view Vec3
  direction: view Vec3
  length: view Float
  baseRadius: view Float
  tipRadius: view Float
  rise: view Float
  wander: view Float
  kink: view LimbKinks
  parent: view Int
  order: view Int
  random: mod TreeRandom
  kinkRandom: mod TreeRandom
) ret Limb {
  let steps: Int = 14
  let step: Float = length / steps.toFloat()
  var points: List(Vec3) = List.create(Vec3, cap: steps + 1)
  var radii: List(Float) = List.create(Float, cap: steps + 1)
  var point: Vec3 = start
  var heading: Vec3 = Vec3.vnorm(a: direction)
  loop var i: Int = 0, i <= steps, ++i {
    let t: Float = i.toFloat() / steps.toFloat()
    points.add(value: point)
    # thins faster near the tip
    radii.add(value: tipRadius + (baseRadius - tipRadius) * Math.pow(base: 1.0 - t, exp: 0.8))
    let jitter: Vec3 = Vec3.create(
      x: nextBetween(random: random, low: -1.0, high: 1.0)
      y: nextBetween(random: random, low: -1.0, high: 1.0)
      z: nextBetween(random: random, low: -0.5, high: 0.5)
    )
    heading = Vec3.vnorm(
      a: Vec3.vadd(
        a: heading
        b: Vec3.vadd(a: Vec3.vscale(a: upVector(), s: rise), b: Vec3.vscale(a: jitter, s: wander))
      )
    )
    # now and then a small kink: a turn of a few degrees about a random axis
    # across the limb
    # (its own random numbers, so adding kinks leaves the tree's layout as it
    # was)
    if i > 0 and i < steps - 1 and nextUnit(random: kinkRandom) < kink.chance {
      let around: Float = nextUnit(random: kinkRandom) * 6.2831853
      let across: Vec3 = kinkAxis(heading: heading, around: around)
      let angle: Float = nextBetween(random: kinkRandom, low: kink.minAngle, high: kink.maxAngle)
      heading = Vec3.vnorm(
        a: Vec3.vadd(
          a: Vec3.vscale(a: heading, s: Math.cos(x: angle))
          b: Vec3.vscale(a: across, s: Math.sin(x: angle))
        )
      )
    }
    point = Vec3.vadd(a: point, b: Vec3.vscale(a: heading, s: step))
  }
  ret Limb { points: own points, radii: own radii, parent: parent, order: order }
}

# How a limb kinks (TreeParams limbKink*)
type LimbKinks {
  chance: Float
  minAngle: Float
  maxAngle: Float
}

func limbKinks(params: view TreeParams) ret LimbKinks {
  ret LimbKinks {
    chance: params.limbKinkChance
    minAngle: params.limbKinkMin
    maxAngle: params.limbKinkMax
  }
}

# A unit direction at right angles to `heading`, `around` radians round it
func kinkAxis(heading: view Vec3, around: view Float) ret Vec3 {
  var other: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  if Math.abs(value: heading.z) > 0.9 {
    other = Vec3.create(x: 1.0, y: 0.0, z: 0.0)
  }
  let first: Vec3 = Vec3.vnorm(a: Vec3.vcross(a: heading, b: other))
  let second: Vec3 = Vec3.vcross(a: heading, b: first)
  ret Vec3.vadd(
    a: Vec3.vscale(a: first, s: Math.cos(x: around))
    b: Vec3.vscale(a: second, s: Math.sin(x: around))
  )
}

# A limb's radius at its tip: a part of its base radius, never under the
# params' thinnest tip
func limbTip(params: view TreeParams, baseRadius: view Float) ret Float {
  ret Math.max(a: params.tipRadius, b: baseRadius * params.limbEndThickness)
}

# The point of `limb` nearest the height `z`, its index
func indexAtHeight(limb: view Limb, z: view Float) ret Int {
  var best: Int = 0
  var bestDistance: Float = 1000000000.0
  loop var i: Int = 0, i < limb.points.length, ++i {
    let distance: Float = Math.abs(value: limb.points.copyAtDefault(index: i).z - z)
    if distance < bestDistance {
      bestDistance = distance
      best = i
    }
  }
  ret best
}

# The tree's wood for `params`: the trunk (limb 0), the main and the second
# leader (1, 2), then the side branches
func growSkeleton(params: view TreeParams) ret TreeSkeleton {
  if params.tracedLimbs.length > 0 {
    ret tracedSkeleton(params: params)
  }
  var random: TreeRandom = createTreeRandom(seed: params.seed)
  var kinkRandom: TreeRandom = createTreeRandom(seed: params.seed + 7777)
  var limbs: List(Limb) = List.create(Limb, cap: 3 + params.branchCount)
  let trunk: Limb = growTrunk(params: params, random: random)
  let forkPoint: Vec3 = trunk.points.copyAtDefault(index: trunk.points.length - 1)
  let forkRadius: Float = trunk.radii.copyAtDefault(index: trunk.radii.length - 1)
  limbs.add(value: trunk)
  # The two leaders: the main one nearly upright, the second one thinner,
  # shorter and leaning further, `secondTurn` round the compass from it
  let azimuth: Float = params.forkAzimuth
  let mainLength: Float = params.height * params.mainLength
  limbs.add(value: growLimb(
    start: forkPoint
    direction: tiltedDirection(angle: params.mainLean, azimuth: azimuth)
    length: mainLength
    baseRadius: forkRadius * 0.94
    tipRadius: limbTip(params: params, baseRadius: forkRadius * 0.94)
    rise: params.leaderBend
    wander: params.limbWander * 0.7
    kink: limbKinks(params: params)
    parent: 0
    order: 1
    random: random
    kinkRandom: kinkRandom
  ))
  limbs.add(value: growLimb(
    start: forkPoint
    direction: tiltedDirection(angle: params.secondLean, azimuth: azimuth + params.secondTurn)
    length: mainLength * params.secondLength
    baseRadius: forkRadius * params.secondThickness
    tipRadius: limbTip(params: params, baseRadius: forkRadius * params.secondThickness)
    rise: params.leaderBend
    wander: params.limbWander * 0.8
    kink: limbKinks(params: params)
    parent: 0
    order: 1
    random: random
    kinkRandom: kinkRandom
  ))
  # The side branches, up the trunk's top and the leaders, longer low
  # down. They fan out to the two sides of the fork by turns (all round the
  # compass, some point along the view and read as sticks pressed to a
  # leader), each from the wood on its own side, so none cross.
  let fanStart: Int = (nextUnit(random: random) * 2.0).toInt()
  loop var b: Int = 0, b < params.branchCount, ++b {
    let along: Float = (b.toFloat() + nextBetween(random: random, low: 0.2, high: 0.8)) / params.branchCount.toFloat()
    let z: Float = params.height * (params.branchFrom + (params.branchTo - params.branchFrom) * along)
    let secondSide: Bool = (b + fanStart) % 2 is 1
    # below the fork from the trunk; above it from the leader on the
    # branch's side (the main one above the second leader's top)
    var parentIndex: Int = 1
    if z < forkPoint.z - 0.3 {
      parentIndex = 0
    } else if secondSide and z < limbs.copyAtDefault(index: 2).points.copyAtDefault(index: 14).z {
      parentIndex = 2
    }
    let angle: Float = nextBetween(
      random: random
      low: params.branchAngleMin
      high: params.branchAngleMax
    )
    # up to 45 degrees off the fork's plane
    var side: Float = 0.0
    if secondSide {
      side = params.secondTurn
    }
    let branchAzimuth: Float = azimuth + side + nextBetween(random: random, low: -0.8, high: 0.8)
    let length: Float = params.height * params.branchLength * (1.15 - 0.55 * along) * nextBetween(
      random: random
      low: 0.85
      high: 1.15
    )
    addSideBranch(
      limbs: limbs
      params: params
      z: z
      parentIndex: parentIndex
      angle: angle
      azimuth: branchAzimuth
      length: length
      rise: params.limbBend
      random: random
      kinkRandom: kinkRandom
    )
  }
  ret TreeSkeleton { limbs: own limbs, forkPoint: forkPoint }
}

# One side branch from limb `parentIndex` at height `z`, `angle` from
# upright toward the compass `azimuth`, as thick as limbThickness of its
# parent there
func addSideBranch(
  limbs: mod List(Limb)
  params: view TreeParams
  z: view Float
  parentIndex: view Int
  angle: view Float
  azimuth: view Float
  length: view Float
  rise: view Float
  random: mod TreeRandom
  kinkRandom: mod TreeRandom
) {
  let parent: Limb = limbs.copyAtDefault(index: parentIndex)
  let at: Int = Math.max(a: 2, b: indexAtHeight(limb: parent, z: z))
  let base: Vec3 = parent.points.copyAtDefault(index: at)
  let parentRadius: Float = parent.radii.copyAtDefault(index: at)
  let branchRadius: Float = Math.max(
    a: params.tipRadius * 2.0
    b: parentRadius * params.limbThickness
  )
  limbs.add(value: growLimb(
    start: base
    direction: tiltedDirection(angle: angle, azimuth: azimuth)
    length: length
    baseRadius: branchRadius
    tipRadius: limbTip(params: params, baseRadius: branchRadius)
    rise: rise
    wander: params.limbWander
    kink: limbKinks(params: params)
    parent: parentIndex
    order: 2
    random: random
    kinkRandom: kinkRandom
  ))
}

# The wood of a traced tree: the trace's limbs, each leader and branch
# turned out of the trace's plane by the seed. The turn moves a limb's
# points only along the depth (y), in proportion to how far each is to the
# side of the limb's base, so from the trace's camera the tree still covers
# the trace; a limb's children move with the point they grow from.
func tracedSkeleton(params: view TreeParams) ret TreeSkeleton {
  var random: TreeRandom = createTreeRandom(seed: params.seed)
  var limbs: List(Limb) = List.create(Limb, cap: params.tracedLimbs.length)
  loop let traced: view TracedLimb in params.tracedLimbs {
    let turn: Float = nextBetween(random: random, low: -1.0, high: 1.0) * params.tracedDepthTurn
    var points: List(Vec3) = List.create(Vec3, cap: traced.points.length)
    let start: Vec3 = traced.points.copyAtDefault(index: 0)
    var shift: Float = 0.0
    if traced.parent >= 0 {
      # where the parent, already turned, passes the limb's base
      let parent: Limb = limbs.copyAtDefault(index: traced.parent)
      let at: Int = indexAtHeight(limb: parent, z: start.z)
      shift = parent.points.copyAtDefault(index: at).y
    }
    loop let point: view Vec3 in traced.points {
      var turned: Vec3 = point
      if traced.order > 0 {
        turned.y = shift + (point.x - start.x) * Math.tan(x: turn)
      }
      points.add(value: turned)
    }
    limbs.add(
      value: Limb {
        points: own points
        radii: traced.radii
        parent: traced.parent
        order: traced.order
      }
    )
  }
  # where the trunk forks, before a leader that carries it on is joined
  # onto it
  let trace: Limb = limbs.copyAtDefault(index: 0)
  let forkPoint: Vec3 = trace.points.copyAtDefault(index: trace.points.length - 1)
  let joined: JoinedLimbs = joinContinuations(limbs: limbs)
  limbs = joined.limbs
  # a leaf mass at the trunk moves in depth with the point of its limb it is
  # level with, so it stays on its branch; one traced wholly in front of or
  # behind the trunk stays there
  var clumps: List(TracedClump) = List.create(TracedClump, cap: params.tracedClumps.length)
  loop let traced: view TracedClump in params.tracedClumps {
    var clump: TracedClump = traced
    if traced.parent >= 0 and traced.parent < joined.index.length {
      clump.parent = joined.index.copyAtDefault(index: traced.parent)
    } else {
      clump.parent = -1
    }
    if traced.side is 0 and clump.parent >= 0 {
      let parent: Limb = limbs.copyAtDefault(index: clump.parent)
      let at: Int = indexAtHeight(limb: parent, z: traced.centre.z)
      clump.centre.y = traced.centre.y + parent.points.copyAtDefault(index: at).y
    }
    clumps.add(value: clump)
  }
  # the wood made to work as a branch does (BranchDetail): parents thinner
  # after their children, leaders and branches thinning to fine tips, side
  # branches along them ending in the leaf masses
  thinAfterChildren(limbs: limbs)
  taperToTips(limbs: limbs, forkZ: forkPoint.z)
  capChildren(limbs: limbs)
  addSideBranches(
    limbs: limbs
    clumps: clumps
    forkZ: forkPoint.z
    random: random
  )
  # a mass that no limb's tip reaches yet gets a twig from its branch
  # (order 3), so every mass hangs on wood; the leaves hide it. Twigs are straight and
  # start at or below their mass, so they grow up. A twig from a limb's tip
  # going on nearly the limb's way carries the limb on, so it is joined
  # onto the limb (one tube, no seam), once per limb; any other leaves the
  # limb at an angle, thinner than the limb, so it comes out of the bark.
  let woodCount: Int = limbs.length
  var extended: List(Bool) = List.create(Bool, cap: woodCount)
  loop var i: Int = 0, i < woodCount, ++i {
    extended.add(value: false)
  }
  loop let clump: view TracedClump in clumps {
    if clump.parent < 0 or clump.parent >= woodCount or clumpHasTip(limbs: limbs, clump: clump) {
      continue
    }
    # a mass below its whole limb hangs on the trunk instead, so no twig
    # grows down
    var parentIndex: Int = clump.parent
    var nearest: Int = nearestPointIndex(
      limb: limbs.copyAtDefault(index: parentIndex)
      target: clump.centre
    )
    if nearest < 0 {
      parentIndex = 0
      nearest = Math.max(
        a: 0
        b: nearestPointIndex(limb: limbs.copyAtDefault(index: 0), target: clump.centre)
      )
    }
    var parent: Limb = limbs.copyAtDefault(index: parentIndex)
    let distance: Float = Vec3.vlen(
      a: Vec3.vsub(a: parent.points.copyAtDefault(index: nearest), b: clump.centre)
    )
    let parentRadius: Float = parent.radii.copyAtDefault(index: nearest)
    let last: Int = parent.points.length - 1
    # the mass nearly straight ahead of the tip (within 25 degrees of the
    # limb's way), so the joined twig carries the limb on with only a slight
    # turn
    let ahead: Float = Vec3.vdot(
      a: endDirection(limb: parent)
      b: Vec3.vnorm(a: Vec3.vsub(a: clump.centre, b: parent.points.copyAtDefault(index: last)))
    )
    if nearest is last and not extended.copyAtDefault(index: parentIndex) and ahead > 0.9 {
      let twig: Limb = twigTo(
        parent: parent
        parentIndex: parentIndex
        target: clump.centre
        nearest: nearest
        baseRadius: parentRadius
      )
      loop var k: Int = 1, k < twig.points.length, ++k {
        parent.points.add(value: twig.points.copyAtDefault(index: k))
        parent.radii.add(value: twig.radii.copyAtDefault(index: k))
      }
      limbs.set(index: parentIndex, value: parent)
      extended.set(index: parentIndex, value: true)
    } else {
      # from the side, never from the last stretch of the limb, so the wood
      # does not turn at a point
      let side: Int = Math.min(a: nearest, b: (0.85 * last.toFloat()).toInt())
      limbs.add(value: twigTo(
        parent: parent
        parentIndex: parentIndex
        target: clump.centre
        nearest: side
        baseRadius: Math.min(a: parent.radii.copyAtDefault(index: side) * 0.5, b: 0.04)
      ))
    }
  }
  ret TreeSkeleton { limbs: own limbs, forkPoint: forkPoint, clumps: own clumps }
}

# The index of the point of `limb` nearest to `target`
func nearestPointIndex(limb: view Limb, target: view Vec3) ret Int {
  # the nearest point at or below the target, so the twig grows up to it;
  # -1 when the whole limb is above it
  var nearest: Int = -1
  var nearestDistance: Float = 1000000.0
  loop var i: Int = 0, i < limb.points.length, ++i {
    let point: Vec3 = limb.points.copyAtDefault(index: i)
    let distance: Float = Vec3.vlen(a: Vec3.vsub(a: point, b: target))
    if point.z <= target.z and distance < nearestDistance {
      nearestDistance = distance
      nearest = i
    }
  }
  ret nearest
}

# A thin straight twig from point `nearest` of `parent` to `target`,
# `baseRadius` thick there, thinning to 1.8 cm (thick enough to carry its
# leaves)
func twigTo(
  parent: view Limb
  parentIndex: view Int
  target: view Vec3
  nearest: view Int
  baseRadius: view Float
) ret Limb {
  let start: Vec3 = parent.points.copyAtDefault(index: nearest)
  let steps: Int = 5
  var points: List(Vec3) = List.create(Vec3, cap: steps + 1)
  var radii: List(Float) = List.create(Float, cap: steps + 1)
  # never thicker at its end than at its start (a thin parent's twig)
  let tipRadius: Float = Math.min(a: 0.018, b: baseRadius)
  loop var i: Int = 0, i <= steps, ++i {
    let t: Float = i.toFloat() / steps.toFloat()
    points.add(value: Vec3.vadd(a: start, b: Vec3.vscale(a: Vec3.vsub(a: target, b: start), s: t)))
    radii.add(value: baseRadius + (tipRadius - baseRadius) * t)
  }
  ret Limb { points: own points, radii: own radii, parent: parentIndex, order: 3 }
}
