# treeGen/LeafImage — the picture on every leaf card of the T02 tree
# (docs/reference-tree-plan.md step 5): a short twig of small, pointed
# leaflets, painted once as 512 x 512 linear RGBA pixels with see-through
# gaps (installed with SurfaceImages.setSurfaceImagePixels: a PNG written by
# Image.savePng is RGB only and would lose the gaps). T02's
# leaves are small; a card carries a little spray of them, so a leaf mass of
# cards breaks up into many separate leaves. The picture is nearly white
# with soft tone changes: each card's own green (LeafCards) multiplies it.
# Written new.
import Math
open SurfaceImages

const leafImageSize: Int = 512

# One leaflet: where it starts, its direction (radians, 0 = +x, y down in
# the picture), its length and its half width, in pixels
type Leaflet {
  x: Float
  y: Float
  angle: Float
  length: Float
  halfWidth: Float
}

# The twig: a stem from the lower left to the upper right with leaflets in
# pairs along it and one at the tip
func leaflets() ret List(Leaflet) {
  var result: List(Leaflet) = List.create(Leaflet, cap: 13)
  let stemAngle: Float = -0.72
  let pairs: Int = 6
  loop var i: Int = 0, i < pairs, ++i {
    let along: Float = 70.0 + i.toFloat() * 52.0
    let x: Float = 70.0 + along * Math.cos(x: stemAngle)
    let y: Float = 450.0 + along * Math.sin(x: stemAngle)
    # the leaflets get a little smaller toward the tip
    let size: Float = 1.0 - 0.06 * i.toFloat()
    result.add(value: Leaflet {
      x: x
      y: y
      angle: stemAngle - 1.0 - 0.08 * i.toFloat()
      length: 120.0 * size
      halfWidth: 30.0 * size
    })
    result.add(value: Leaflet {
      x: x
      y: y
      angle: stemAngle + 1.0 + 0.08 * i.toFloat()
      length: 116.0 * size
      halfWidth: 29.0 * size
    })
  }
  let tipAlong: Float = 70.0 + pairs.toFloat() * 52.0
  result.add(value: Leaflet {
    x: 70.0 + tipAlong * Math.cos(x: stemAngle)
    y: 450.0 + tipAlong * Math.sin(x: stemAngle)
    angle: stemAngle
    length: 96.0
    halfWidth: 25.0
  })
  ret result
}

# How much of pixel (x, y) a leaflet covers (0..1, soft at the edge), and
# its tone there: lighter along the midrib, darker toward the edge and base
func leafletCover(leaflet: view Leaflet, x: view Float, y: view Float) ret Float {
  let dx: Float = x - leaflet.x
  let dy: Float = y - leaflet.y
  let along: Float = dx * Math.cos(x: leaflet.angle) + dy * Math.sin(x: leaflet.angle)
  let across: Float = -dx * Math.sin(x: leaflet.angle) + dy * Math.cos(x: leaflet.angle)
  if along <= 0.0 or along >= leaflet.length {
    ret 0.0
  }
  let t: Float = along / leaflet.length
  # widest a third of the way out, pointed at both ends
  let width: Float = leaflet.halfWidth * Math.pow(
    base: Math.sin(x: 3.1415927 * Math.pow(base: t, exp: 0.75))
    exp: 0.9
  )
  ret Math.clamp(val: (width - Math.abs(value: across)) / 1.5 + 0.5, low: 0.0, high: 1.0)
}

func leafletTone(leaflet: view Leaflet, x: view Float, y: view Float) ret Float {
  let dx: Float = x - leaflet.x
  let dy: Float = y - leaflet.y
  let along: Float = dx * Math.cos(x: leaflet.angle) + dy * Math.sin(x: leaflet.angle)
  let across: Float = -dx * Math.sin(x: leaflet.angle) + dy * Math.cos(x: leaflet.angle)
  let side: Float = Math.clamp(
    val: Math.abs(value: across) / leaflet.halfWidth
    low: 0.0
    high: 1.0
  )
  let t: Float = Math.clamp(val: along / leaflet.length, low: 0.0, high: 1.0)
  # a thin light midrib, the half on one side of it a little darker (the
  # leaflet folds along it)
  let midrib: Float = Math.clamp(val: 1.0 - Math.abs(value: across) / 2.5, low: 0.0, high: 1.0)
  var tone: Float = 0.9 - 0.18 * side * side + 0.08 * t
  if across < 0.0 {
    tone = tone * 0.88
  }
  ret Math.clamp(val: tone + 0.12 * midrib, low: 0.0, high: 1.0)
}

# The stem: a thin line along the twig
func stemCover(x: view Float, y: view Float) ret Float {
  let stemAngle: Float = -0.72
  let dx: Float = x - 70.0
  let dy: Float = y - 450.0
  let along: Float = dx * Math.cos(x: stemAngle) + dy * Math.sin(x: stemAngle)
  let across: Float = -dx * Math.sin(x: stemAngle) + dy * Math.cos(x: stemAngle)
  if along < -20.0 or along > 400.0 {
    ret 0.0
  }
  ret Math.clamp(val: (3.0 - Math.abs(value: across)) / 1.5 + 0.5, low: 0.0, high: 1.0)
}

# The picture's pixels: linear RGBA floats, row by row from the top
func leafPixels() ret List(Float) {
  let all: List(Leaflet) = leaflets()
  var pixels: List(Float) = List.create(Float, cap: leafImageSize * leafImageSize * 4)
  loop var row: Int = 0, row < leafImageSize, ++row {
    loop var column: Int = 0, column < leafImageSize, ++column {
      let x: Float = column.toFloat() + 0.5
      let y: Float = row.toFloat() + 0.5
      var cover: Float = 0.0
      var tone: Float = 0.0
      loop let leaflet: view Leaflet in all {
        let here: Float = leafletCover(leaflet: leaflet, x: x, y: y)
        if here > cover {
          cover = here
          tone = leafletTone(leaflet: leaflet, x: x, y: y)
        }
      }
      let stem: Float = stemCover(x: x, y: y)
      if stem > cover {
        cover = stem
        tone = 0.55
      }
      pixels.add(value: surfaceLinear(value: tone * 0.96))
      pixels.add(value: surfaceLinear(value: tone))
      pixels.add(value: surfaceLinear(value: tone * 0.86))
      pixels.add(value: cover)
    }
  }
  ret pixels
}
