# treeGen/LeafImage — the pictures on the T02 tree's leaf cards
# (docs/reference-tree-plan.md step 5), painted the way a painter's scatter
# brush stamps leaves: separate, simple almond-shaped leaves scattered over a
# dab, each pointing roughly outward with a wide jitter, each sized and
# toned a little differently, painted one over the other. Each leaf is a
# flat dab of one tone, no gradient, no midrib and no stem:
# a twig of paired leaflets was rejected as reading like a fern.
#
# Three stamps (layers), so neighboring cards differ. Painted once as
# 512 x 512 linear RGBA pixels with see-through gaps (installed with
# SurfaceImages.setSurfaceImagePixels: a PNG from Image.savePng is RGB only
# and would lose the gaps). Nearly white: each card's green (LeafCards)
# multiplies it. The leaf's outline, size and count come from the tree's
# kind (TreeKind.LeafKind). Written new.
import Math
open SurfaceImages
open treeGen/TreeParams
open treeGen/TreeKind

const leafImageSize: Int = 512

# The number of different stamps
const leafImageLayers: Int = 3

# One leaf of a stamp: its base, its direction (radians, 0 = +x, y down in
# the picture), its length and half width (pixels), and its tone
type StampLeaf {
  x: Float
  y: Float
  angle: Float
  length: Float
  halfWidth: Float
  tone: Float
}

# The leaves of stamp `layer` (T02: 14 to 18) scattered over a disc round
# the center, like a scatter brush's dab (not on a ring, which reads as a
# flower), each pointing outward with a wide angle jitter
func stampLeaves(leafKind: view LeafKind, layer: view Int) ret List(StampLeaf) {
  var random: TreeRandom = createTreeRandom(seed: leafKind.seed + layer * 37)
  let count: Int = leafKind.countMin + (nextUnit(random: random) * leafKind.countSpread.toFloat()).toInt()
  var result: List(StampLeaf) = List.create(StampLeaf, cap: count)
  let center: Float = leafImageSize.toFloat() * 0.5
  loop var i: Int = 0, i < count, ++i {
    # the leaf's middle anywhere in the disc (evenly over its area)
    let around: Float = nextUnit(random: random) * 6.2831853
    let reach: Float = leafKind.reach * Math.sqrt(x: nextUnit(random: random))
    let middleX: Float = center + reach * Math.cos(x: around)
    let middleY: Float = center + reach * Math.sin(x: around)
    let angle: Float = around + nextBetween(
      random: random
      low: -leafKind.angleJitter
      high: leafKind.angleJitter
    )
    let length: Float = nextBetween(
      random: random
      low: leafKind.lengthMin
      high: leafKind.lengthMax
    )
    result.add(value: StampLeaf {
      x: middleX - 0.5 * length * Math.cos(x: angle)
      y: middleY - 0.5 * length * Math.sin(x: angle)
      angle: angle
      length: length
      halfWidth: length * nextBetween(
        random: random
        low: leafKind.widthMin
        high: leafKind.widthMax
      )
      tone: nextBetween(random: random, low: 0.7, high: 1.0)
    })
  }
  ret result
}

# How much of the pixel the leaf covers (0..1, soft at the edge), by the
# leaf's outline
func leafCover(
  outline: view LeafOutline
  leaf: view StampLeaf
  along: view Float
  across: view Float
) ret Float {
  if outline is LeafOutline.heart {
    ret heartCover(leaf: leaf, along: along, across: across)
  }
  if outline is LeafOutline.lobed {
    ret lobedCover(leaf: leaf, along: along, across: across)
  }
  if outline is LeafOutline.threeLobed {
    ret threeLobedCover(leaf: leaf, along: along, across: across)
  }
  if outline is LeafOutline.deepLobed {
    ret deepLobedCover(leaf: leaf, along: along, across: across)
  }
  if outline is LeafOutline.fan {
    ret fanCover(leaf: leaf, along: along, across: across)
  }
  ret almondCover(leaf: leaf, along: along, across: across)
}

# A heart: widest at about a third of its length, where two round lobes
# swell from the stalk, then narrowing to a short point; a notch cut into
# the base between the lobes
func heartCover(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  if along <= 0.0 or along >= leaf.length {
    ret 0.0
  }
  let t: Float = along / leaf.length
  var shape: Float = 0.0
  if t < 0.35 {
    shape = Math.sqrt(x: Math.sin(x: 1.5707963 * t / 0.35))
  } else {
    shape = Math.pow(base: Math.sin(x: 1.5707963 * (1.0 - t) / 0.65), exp: 0.8)
  }
  let width: Float = leaf.halfWidth * shape
  # the notch: up to a tenth of the length deep on the midline, nothing
  # beyond a third of the half width out
  let notch: Float = 0.1 * leaf.length * Math.max(
    a: 0.0
    b: 1.0 - Math.abs(value: across) / (0.35 * leaf.halfWidth)
  )
  let side: Float = (width - Math.abs(value: across)) / 1.5 + 0.5
  let base: Float = (along - notch) / 1.5 + 0.5
  ret Math.clamp(val: Math.min(a: side, b: base), low: 0.0, high: 1.0)
}

# A maple leaf: round its middle (half way along), five pointed lobes at 0
# and +-72 and +-144 degrees from the tip's direction, reaching the half
# width; between them the edge comes in to about half of it, and toward
# the stalk (180 degrees) it is cut in. Use a half width of half the length.
func lobedCover(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  let x: Float = along - leaf.length * 0.5
  let distance: Float = Math.sqrt(x: x * x + across * across)
  let angle: Float = Math.atan2(y: across, x: x)
  let lobe: Float = Math.pow(base: Math.abs(value: Math.cos(x: 2.5 * angle)), exp: 2.0)
  let reach: Float = leaf.halfWidth * (0.52 + 0.48 * lobe)
  ret Math.clamp(val: (reach - distance) / 1.5 + 0.5, low: 0.0, high: 1.0)
}

# A red maple leaf: round its middle, three pointed lobes at 0 and +-60
# degrees from the tip's direction reaching the half width, the rest of the
# edge (toward the stalk) at about half of it. Use a half width of half the
# length.
func threeLobedCover(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  let x: Float = along - leaf.length * 0.5
  let distance: Float = Math.sqrt(x: x * x + across * across)
  let angle: Float = Math.atan2(y: across, x: x)
  var lobe: Float = 0.0
  if Math.abs(value: angle) < 1.3 {
    lobe = Math.pow(base: Math.abs(value: Math.cos(x: 3.0 * angle)), exp: 2.0)
  }
  let reach: Float = leaf.halfWidth * (0.5 + 0.5 * lobe)
  ret Math.clamp(val: (reach - distance) / 1.5 + 0.5, low: 0.0, high: 1.0)
}

# A Japanese maple leaf: round its middle, seven narrow pointed lobes about
# 51 degrees apart (the one toward the stalk left out), cut in to a quarter
# of the half width between them. Use a half width of half the length.
func deepLobedCover(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  let x: Float = along - leaf.length * 0.5
  let distance: Float = Math.sqrt(x: x * x + across * across)
  let angle: Float = Math.atan2(y: across, x: x)
  var lobe: Float = 0.0
  if Math.abs(value: angle) < 2.75 {
    lobe = Math.pow(base: Math.abs(value: Math.cos(x: 3.5 * angle)), exp: 4.0)
  }
  let reach: Float = leaf.halfWidth * (0.25 + 0.75 * lobe)
  ret Math.clamp(val: (reach - distance) / 1.5 + 0.5, low: 0.0, high: 1.0)
}

# A ginkgo leaf: a thin stalk over the first quarter of the length, then a
# wedge from there opening 46 degrees either side to a curved edge at the
# full length, notched in its middle. Use a half width of about 0.55 of
# the length.
func fanCover(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  if along <= 0.0 or along >= leaf.length {
    ret 0.0
  }
  let apex: Float = leaf.length * 0.25
  let stalk: Float = Math.clamp(
    val: (1.6 - Math.abs(value: across)) / 1.5 + 0.5
    low: 0.0
    high: 1.0
  ) * Math.clamp(val: (apex + 6.0 - along) / 1.5 + 0.5, low: 0.0, high: 1.0)
  let x: Float = along - apex
  let distance: Float = Math.sqrt(x: x * x + across * across)
  let angle: Float = Math.atan2(y: across, x: x)
  let notch: Float = 1.0 - 0.22 * Math.exp(x: -(angle / 0.1) * (angle / 0.1))
  let edge: Float = (leaf.length - apex) * notch
  let inside: Float = Math.min(
    a: (edge - distance) / 1.5 + 0.5
    b: (0.8 - Math.abs(value: angle)) * distance / 1.5 + 0.5
  )
  ret Math.max(a: stalk, b: Math.clamp(val: inside, low: 0.0, high: 1.0))
}

# An almond: widest a little below the middle, rounded at the base, pointed
# at the tip
func almondCover(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  if along <= 0.0 or along >= leaf.length {
    ret 0.0
  }
  let t: Float = along / leaf.length
  let width: Float = leaf.halfWidth * Math.pow(
    base: Math.sin(x: 3.1415927 * Math.pow(base: t, exp: 0.8))
    exp: 0.75
  )
  ret Math.clamp(val: (width - Math.abs(value: across)) / 1.5 + 0.5, low: 0.0, high: 1.0)
}

# The leaf's painted tone: one flat tone per leaf, like a brush dab
# (gradients are bad); the leaves of a stamp differ in tone
func leafShade(leaf: view StampLeaf, along: view Float, across: view Float) ret Float {
  ret leaf.tone
}

# Stamp `layer`'s pixels: linear RGBA floats, row by row from the top. The
# leaves are painted in order, each over the ones before it, each visiting
# only the pixels of its own bounding box.
func leafLayerPixels(leafKind: view LeafKind, layer: view Int) ret List(Float) {
  let leaves: List(StampLeaf) = stampLeaves(leafKind: leafKind, layer: layer)
  let count: Int = leafImageSize * leafImageSize
  var tones: List(Float) = List.create(Float, cap: count)
  var alphas: List(Float) = List.create(Float, cap: count)
  # the gaps get a light leaf tone, not black: the smaller mip levels
  # average them into the leaves' edges, and black there showed as dark
  # fringes round every crown seen from afar
  loop var i: Int = 0, i < count, ++i {
    tones.add(value: 0.8)
    alphas.add(value: 0.0)
  }
  loop let leaf: view StampLeaf in leaves {
    let cosine: Float = Math.cos(x: leaf.angle)
    let sine: Float = Math.sin(x: leaf.angle)
    let tipX: Float = leaf.x + leaf.length * cosine
    let tipY: Float = leaf.y + leaf.length * sine
    let left: Int = Math.max(a: 0, b: (Math.min(a: leaf.x, b: tipX) - leaf.halfWidth - 2.0).toInt())
    let right: Int = Math.min(
      a: leafImageSize - 1
      b: (Math.max(a: leaf.x, b: tipX) + leaf.halfWidth + 2.0).toInt()
    )
    let top: Int = Math.max(a: 0, b: (Math.min(a: leaf.y, b: tipY) - leaf.halfWidth - 2.0).toInt())
    let bottom: Int = Math.min(
      a: leafImageSize - 1
      b: (Math.max(a: leaf.y, b: tipY) + leaf.halfWidth + 2.0).toInt()
    )
    loop var row: Int = top, row <= bottom, ++row {
      loop var column: Int = left, column <= right, ++column {
        let dx: Float = column.toFloat() + 0.5 - leaf.x
        let dy: Float = row.toFloat() + 0.5 - leaf.y
        let along: Float = dx * cosine + dy * sine
        let across: Float = -dx * sine + dy * cosine
        let cover: Float = leafCover(
          outline: leafKind.outline
          leaf: leaf
          along: along
          across: across
        )
        if cover > 0.0 {
          # this leaf over what is already painted
          let index: Int = row * leafImageSize + column
          let below: Float = tones.copyAtDefault(index: index)
          tones.set(
            index: index
            value: leafShade(leaf: leaf, along: along, across: across) * cover + below * (1.0 - cover)
          )
          alphas.set(
            index: index
            value: cover + alphas.copyAtDefault(index: index) * (1.0 - cover)
          )
        }
      }
    }
  }
  var pixels: List(Float) = List.create(Float, cap: count * 4)
  loop var i: Int = 0, i < count, ++i {
    let tone: Float = tones.copyAtDefault(index: i)
    pixels.add(value: surfaceLinear(value: tone * 0.97))
    pixels.add(value: surfaceLinear(value: tone))
    pixels.add(value: surfaceLinear(value: tone * 0.88))
    pixels.add(value: alphas.copyAtDefault(index: i))
  }
  ret pixels
}

# Every stamp, one list of pixels per layer
func leafImageLayerPixels(leafKind: view LeafKind) ret List(List(Float)) {
  var layers: List(List(Float)) = List.create(List(Float), cap: leafImageLayers)
  loop var layer: Int = 0, layer < leafImageLayers, ++layer {
    layers.add(value: leafLayerPixels(leafKind: leafKind, layer: layer))
  }
  ret layers
}
