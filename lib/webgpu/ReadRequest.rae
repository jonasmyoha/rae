# Internal lifecycle pilot: this ordinary Rae owner proves create/drop around
# the existing callback-owned native request. Raw state stays behind the unsafe
# boundary; public copying borrows a whole List and never exposes its data Ptr.
open webgpu/Readback

type ReadRequest {
  nativeRequest: Ptr
  byteCount: UInt64
}

type ReadRange {
  offset: UInt64
  size: UInt64
}

# Construction fails for allocation errors and ranges rejected synchronously by
# the native bridge. This check does not poll the device; asynchronous mapping
# failures are reported later by poll.
func create(buffer: copy Ptr, range: view ReadRange) ret opt ReadRequest {
  unsafe {
    let nativeRequest: Ptr = startRead(buffer: buffer, offset: range.offset, size: range.size)
    if readStartStatus(request: nativeRequest) is -1 {
      releaseRead(request: nativeRequest)
      ret none
    }
    ret ReadRequest { nativeRequest: nativeRequest, byteCount: range.size }
  }
}

# The owner reference is released exactly once. A pending callback keeps its
# independent native reference until the context delivers it after cancellation.
func drop(this: mod ReadRequest) {
  unsafe {
    this.nativeRequest = releaseRead(request: this.nativeRequest)
  }
}

# Polls platform events once with wait: 0 through the existing bridge.
func poll(this: view ReadRequest) ret Int {
  unsafe {
    ret pollRead(request: this.nativeRequest)
  }
}

# Copies only a completed full range into the List's initialized elements. The
# native call borrows data only for this call; no pointer survives List growth.
func copyTo(T: type, this: view ReadRequest, destination: mod List(T)) ret Bool {
  # Native code treats this capacity as authoritative. Reject visibly corrupt
  # List metadata before deriving it, and cast before multiplication so signed
  # Int overflow cannot turn a small negative value into a huge capacity.
  if destination.length < 0 or destination.cap < destination.length {
    ret false
  }
  let elementCount: UInt64 = destination.length as UInt64
  let elementSize: UInt64 = sizeof(T) as UInt64
  if elementSize > 0 and elementCount > (18446744073709551615 / elementSize) {
    ret false
  }
  let capacity: UInt64 = elementCount * elementSize
  unsafe {
    ret copyRead(request: this.nativeRequest, destination: destination.data, capacity: capacity) is 1
  }
}
