# WebGPU context bootstrap (#501) — hand-written, not generated.
#
# The instance/adapter/device REQUEST is async (callback-driven) and any
# platform surface configuration is genuinely platform C, so that one-time
# bootstrap stays in the runtime (compiler/runtime/runtime_webgpu.c). These
# externs hand the resulting handles to Rae as opaque Ptr, so every downstream
# resource call (createBuffer / queueWriteBuffer / beginRenderPass / …) is made
# from Rae over the generated bindings in webgpu.rae — never a C shim.
#
# The symbols are declared in rae_runtime.h (guarded by RAE_HAS_WEBGPU), which
# the generated C always includes, so no cheader is needed here.

# Create the instance/adapter/device/queue once (idempotent). Returns 1 on
# success, 0 if no GPU is available. Call before any accessor below.
func webgpuBootstrap() unsafe extern("rae_wgpu_ctx_bootstrap") ret Int

# Handles from the bootstrap, as opaque Ptr. Valid only after webgpuBootstrap()
# returned 1. Feed these straight into the generated wgpu* bindings.
func webgpuDevice() unsafe extern("rae_wgpu_ctx_device") ret Ptr

func webgpuQueue() unsafe extern("rae_wgpu_ctx_queue") ret Ptr

func webgpuAdapter() unsafe extern("rae_wgpu_ctx_adapter") ret Ptr

func webgpuInstance() unsafe extern("rae_wgpu_ctx_instance") ret Ptr

# Advance the device event queue (map/submit callbacks). wait != 0 blocks until
# there is work; wait == 0 polls. Needed until Rae can pass callbacks to C.
func webgpuPoll(wait: Int) unsafe extern("rae_wgpu_ctx_poll")

# Per-submission completion (#938). `watch` registers a work-done callback for
# the index `wgpuQueueSubmitForIndex` returned; `done` pumps callbacks without
# blocking and answers for that index. `wgpuDevicePoll`'s own return value
# means the whole queue is empty, which is NOT the same question.
func webgpuWatchSubmission(index: UInt64) unsafe extern("rae_wgpu_watch_submission")

func webgpuSubmissionDone(index: UInt64) unsafe extern("rae_wgpu_submission_done") ret UInt32

# A null opaque pointer, for WebGPU params that take an optional pointer/array
# (e.g. dynamicOffsets when the count is 0). Rae has no null-Ptr literal yet.
func webgpuNull() unsafe extern("rae_wgpu_null_ptr") ret Ptr

# 1 if the device got the GPU timestamp-query features at creation (#528), else 0.
# Timestamp timing is skipped when this is 0 (adapter didn't offer them).
func webgpuHaveTimestamp() unsafe extern("rae_wgpu_have_timestamp") ret Int

# rg11b10ufloat-renderable: an HDR target at 4 bytes/pixel instead of 8 (#370).
func webgpuHaveRg11b10() unsafe extern("rae_wgpu_have_rg11b10") ret Int

# Blocking read of a MapRead buffer's [0,size) bytes into `dst` (#528). The map
# callback must be C (Rae can't synthesize a function pointer yet); everything
# else is done from Rae. Returns 1 on success. `dst` is typically a List's .data.
func webgpuMapRead(buffer: Ptr, size: UInt64, dst: Ptr) unsafe extern("rae_wgpu_map_read") ret Int
