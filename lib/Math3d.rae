# math3d — 4x4 matrices + small vector helpers for the gpu3d renderer.
#
# A matrix is a `Mat4`: 16 floats BY VALUE, COLUMN-MAJOR (WGSL mat4x4
# layout), element (row r, column c) at index c*4 + r. mat4Mul composes so
# that `mat4Mul(a: A, b: B)` applies B first, then A (A*B, like math).
#
# ALLOCATION-FREE. These were `List(Float)` until #354, which meant every
# matrix was a heap allocation: `modelMatrix` alone cost eight alloc/free
# pairs per object per frame, and it runs twice per drawn instance (current
# and previous transform, for motion vectors). A Mat4 is now a value —
# `Array(Float, cap: 16)` wrapped in a struct — so it lives in registers or
# on the stack, copies with a struct assignment, and never touches the
# allocator. See docs/value-aggregates-and-ownership.md.
#
# WORLD CONVENTION: right-handed, **Z-up**, matching Blender — +X right,
# +Y forward (into the scene), +Z up. This is the project-wide mandate in
# `docs/coordinate-system.md` ("New 3D code MUST use Z-up Blender
# conventions"), NOT the graphics-default Y-up. Yaw rotates about +Z,
# pitch about +X. Cameras are specified as position + target + worldUp
# (+Z) and the basis is derived exactly as that doc prescribes.
#
# Only the PROJECTION knows about the graphics API: it maps the Z-up
# right-handed view space into WebGPU clip space (z in [0, 1]). The
# host API's up-axis preference never leaks into Rae world space.
import Math
open Vec3

# A 4x4 matrix, 16 floats by value, column-major.
type Mat4 {
  m: Array(Float, cap: 16)
}

# An affine transform without the constant fourth row (0,0,0,1). Three
# columns of four, still column-major, so the upper 3x3 rotation/scale and
# the translation column keep their Mat4 positions. Worth having because a
# skinning palette or an instance buffer ships 25% fewer floats across the
# render boundary, and the missing row is implied.
type Mat3x4 {
  m: Array(Float, cap: 12)
}

func mat4Zero() pub ret Mat4 {
  ret Mat4 { m: Array(Float, cap: 16) }
}

func mat4Identity() pub ret Mat4 {
  var m: Mat4 = mat4Zero()
  m.m.set(index: 0, value: 1.0)
  m.m.set(index: 5, value: 1.0)
  m.m.set(index: 10, value: 1.0)
  m.m.set(index: 15, value: 1.0)
  ret m
}

func mat4Get(m: view Mat4, i: view Int) pub ret Float {
  ret m.m.copyAtFallback(index: i, fallback: 0.0)
}

# Drop the implied (0,0,0,1) row: keep the first three entries of each
# column. Column c of the Mat4 starts at c*4; of the Mat3x4 at c*3.
func mat4ToMat3x4(a: view Mat4) pub ret Mat3x4 {
  var o: Mat3x4 = { m: Array(Float, cap: 12) }
  var c: Int = 0
  loop c < 4 {
    o.m.set(index: c * 3, value: a.m.copyAtFallback(index: c * 4, fallback: 0.0))
    o.m.set(index: c * 3 + 1, value: a.m.copyAtFallback(index: c * 4 + 1, fallback: 0.0))
    o.m.set(index: c * 3 + 2, value: a.m.copyAtFallback(index: c * 4 + 2, fallback: 0.0))
    c = c + 1
  }
  ret o
}

# Restore the implied row. The inverse of mat4ToMat3x4 for any affine
# matrix; for a non-affine one the dropped row was not (0,0,0,1) and this
# does not round-trip.
func mat3x4ToMat4(a: view Mat3x4) pub ret Mat4 {
  var o: Mat4 = mat4Zero()
  var c: Int = 0
  loop c < 4 {
    o.m.set(index: c * 4, value: a.m.copyAtFallback(index: c * 3, fallback: 0.0))
    o.m.set(index: c * 4 + 1, value: a.m.copyAtFallback(index: c * 3 + 1, fallback: 0.0))
    o.m.set(index: c * 4 + 2, value: a.m.copyAtFallback(index: c * 3 + 2, fallback: 0.0))
    c = c + 1
  }
  o.m.set(index: 15, value: 1.0)
  ret o
}

# out = a * b (apply b first, then a).
func mat4Mul(a: view Mat4, b: view Mat4) pub ret Mat4 {
  var out: Mat4 = mat4Zero()
  var c: Int = 0
  loop c < 4 {
    var r: Int = 0
    loop r < 4 {
      var sum: Float = 0.0
      var k: Int = 0
      loop k < 4 {
        sum = sum + a.m.copyAtFallback(index: k * 4 + r, fallback: 0.0) * b.m.copyAtFallback(
          index: c * 4 + k
          fallback: 0.0
        )
        k = k + 1
      }
      out.m.set(index: c * 4 + r, value: sum)
      r = r + 1
    }
    c = c + 1
  }
  ret out
}

func mat4Translate(x: view Float, y: view Float, z: view Float) pub ret Mat4 {
  var m: Mat4 = mat4Identity()
  m.m.set(index: 12, value: x)
  m.m.set(index: 13, value: y)
  m.m.set(index: 14, value: z)
  ret m
}

func mat4Scale(s: view Float) pub ret Mat4 {
  var m: Mat4 = mat4Identity()
  m.m.set(index: 0, value: s)
  m.m.set(index: 5, value: s)
  m.m.set(index: 10, value: s)
  ret m
}

# Non-uniform scale. NOTE: gpu3d transforms normals by the model matrix
# directly, so a non-uniform scale skews lighting — see the inverse-
# transpose normal-matrix follow-up before relying on this for shaded
# geometry.
func mat4ScaleXYZ(x: view Float, y: view Float, z: view Float) pub ret Mat4 {
  var m: Mat4 = mat4Identity()
  m.m.set(index: 0, value: x)
  m.m.set(index: 5, value: y)
  m.m.set(index: 10, value: z)
  ret m
}

func mat4RotateX(angle: view Float) pub ret Mat4 {
  var m: Mat4 = mat4Identity()
  let c: Float = Math.cos(x: angle)
  let s: Float = Math.sin(x: angle)
  m.m.set(index: 5, value: c)
  m.m.set(index: 6, value: s)
  m.m.set(index: 9, value: 0.0 - s)
  m.m.set(index: 10, value: c)
  ret m
}

func mat4RotateY(angle: view Float) pub ret Mat4 {
  var m: Mat4 = mat4Identity()
  let c: Float = Math.cos(x: angle)
  let s: Float = Math.sin(x: angle)
  m.m.set(index: 0, value: c)
  m.m.set(index: 2, value: 0.0 - s)
  m.m.set(index: 8, value: s)
  m.m.set(index: 10, value: c)
  ret m
}

func mat4RotateZ(angle: view Float) pub ret Mat4 {
  var m: Mat4 = mat4Identity()
  let c: Float = Math.cos(x: angle)
  let s: Float = Math.sin(x: angle)
  m.m.set(index: 0, value: c)
  m.m.set(index: 1, value: s)
  m.m.set(index: 4, value: 0.0 - s)
  m.m.set(index: 5, value: c)
  ret m
}

# Right-handed perspective, WebGPU depth range [0,1].
# Reverse-Z projection: near maps to 1, far maps to 0 — the opposite of
# mat4Perspective above.
#
# WHY. A float depth buffer has most of its precision near 0, and standard
# Z puts the near plane there, where the projection is already densest.
# The two effects fight and most of the buffer's precision is wasted on
# geometry a metre from the camera. Reverse-Z lines the float's dense
# region up with the far plane, where the projection is sparse, and the
# two cancel almost exactly — the classic result is that depth precision
# becomes nearly uniform for free.
#
# This is a SEPARATE function rather than a change to mat4Perspective on
# purpose. The forward frame and every pass reading its depth assume the
# standard convention; flipping it globally would silently invert every
# depth comparison in renderer3d. A caller opts in, and its pipeline must
# then clear depth to 0.0 and compare with Greater.
func mat4PerspectiveReverseZ(
  fovYDeg: view Float
  aspect: view Float
  near: view Float
  far: view Float
) pub ret Mat4 {
  var m: Mat4 = mat4Zero()
  let f: Float = 1.0 / Math.tan(x: fovYDeg * 0.008726646259971648)  # deg->rad, /2
  m.m.set(index: 0, value: f / aspect)
  m.m.set(index: 5, value: f)
  m.m.set(index: 10, value: near / (far - near))
  m.m.set(index: 11, value: 0.0 - 1.0)
  m.m.set(index: 14, value: far * near / (far - near))
  ret m
}

func mat4Perspective(
  fovYDeg: view Float
  aspect: view Float
  near: view Float
  far: view Float
) pub ret Mat4 {
  var m: Mat4 = mat4Zero()
  let f: Float = 1.0 / Math.tan(x: fovYDeg * 0.008726646259971648)  # deg->rad, /2
  m.m.set(index: 0, value: f / aspect)
  m.m.set(index: 5, value: f)
  m.m.set(index: 10, value: far / (near - far))
  m.m.set(index: 11, value: 0.0 - 1.0)
  m.m.set(index: 14, value: far * near / (near - far))
  ret m
}

# Right-handed orthographic projection matching mat4Perspective's
# conventions: view space looks down -Z, clip depth is WebGPU's [0,1].
#
# Used for directional-light shadow cascades. Note that reverse-Z is
# deliberately NOT offered here: reverse-Z buys precision from the float
# exponent against perspective's 1/z, and ortho depth is linear, so it
# would buy nothing while risking a convention mismatch with the main
# pass (docs/shadow-system-design.md §3).
func mat4Ortho(
  left: view Float
  right: view Float
  bottom: view Float
  top: view Float
  near: view Float
  far: view Float
) pub ret Mat4 {
  var m: Mat4 = mat4Zero()
  let rl: Float = right - left
  let tb: Float = top - bottom
  let nf: Float = near - far
  if rl is 0.0 or tb is 0.0 or nf is 0.0 {
    ret mat4Identity()
  }
  m.m.set(index: 0, value: 2.0 / rl)
  m.m.set(index: 5, value: 2.0 / tb)
  m.m.set(index: 10, value: 1.0 / nf)
  m.m.set(index: 12, value: 0.0 - (right + left) / rl)
  m.m.set(index: 13, value: 0.0 - (top + bottom) / tb)
  m.m.set(index: 14, value: near / nf)
  m.m.set(index: 15, value: 1.0)
  ret m
}

# Transform a point by a matrix (w assumed 1, result de-homogenised only
# for the affine case this is used in). Column-major, so the x row reads
# m[0], m[4], m[8], m[12].
# General 4x4 inverse by cofactors (column-major, like every Mat4 here). A
# singular matrix (determinant ~0) returns the identity rather than garbage —
# a caller reconstructing world positions from clip space gets a visible
# no-op instead of NaNs. Used by the underwater pass (#855) to invert the
# frame's view-projection on the CPU.
func mat4Inverse(a: view Mat4) pub ret Mat4 {
  let m0: Float = a.m.copyAtFallback(index: 0, fallback: 0.0)
  let m1: Float = a.m.copyAtFallback(index: 1, fallback: 0.0)
  let m2: Float = a.m.copyAtFallback(index: 2, fallback: 0.0)
  let m3: Float = a.m.copyAtFallback(index: 3, fallback: 0.0)
  let m4: Float = a.m.copyAtFallback(index: 4, fallback: 0.0)
  let m5: Float = a.m.copyAtFallback(index: 5, fallback: 0.0)
  let m6: Float = a.m.copyAtFallback(index: 6, fallback: 0.0)
  let m7: Float = a.m.copyAtFallback(index: 7, fallback: 0.0)
  let m8: Float = a.m.copyAtFallback(index: 8, fallback: 0.0)
  let m9: Float = a.m.copyAtFallback(index: 9, fallback: 0.0)
  let m10: Float = a.m.copyAtFallback(index: 10, fallback: 0.0)
  let m11: Float = a.m.copyAtFallback(index: 11, fallback: 0.0)
  let m12: Float = a.m.copyAtFallback(index: 12, fallback: 0.0)
  let m13: Float = a.m.copyAtFallback(index: 13, fallback: 0.0)
  let m14: Float = a.m.copyAtFallback(index: 14, fallback: 0.0)
  let m15: Float = a.m.copyAtFallback(index: 15, fallback: 0.0)
  var inv: Mat4 = mat4Zero()
  inv.m.set(
    index: 0
    value: m5 * m10 * m15 - m5 * m11 * m14 - m9 * m6 * m15 + m9 * m7 * m14 + m13 * m6 * m11 - m13 * m7 * m10
  )
  inv.m.set(
    index: 4
    value: 0.0 - m4 * m10 * m15 + m4 * m11 * m14 + m8 * m6 * m15 - m8 * m7 * m14 - m12 * m6 * m11 + m12 * m7 * m10
  )
  inv.m.set(
    index: 8
    value: m4 * m9 * m15 - m4 * m11 * m13 - m8 * m5 * m15 + m8 * m7 * m13 + m12 * m5 * m11 - m12 * m7 * m9
  )
  inv.m.set(
    index: 12
    value: 0.0 - m4 * m9 * m14 + m4 * m10 * m13 + m8 * m5 * m14 - m8 * m6 * m13 - m12 * m5 * m10 + m12 * m6 * m9
  )
  inv.m.set(
    index: 1
    value: 0.0 - m1 * m10 * m15 + m1 * m11 * m14 + m9 * m2 * m15 - m9 * m3 * m14 - m13 * m2 * m11 + m13 * m3 * m10
  )
  inv.m.set(
    index: 5
    value: m0 * m10 * m15 - m0 * m11 * m14 - m8 * m2 * m15 + m8 * m3 * m14 + m12 * m2 * m11 - m12 * m3 * m10
  )
  inv.m.set(
    index: 9
    value: 0.0 - m0 * m9 * m15 + m0 * m11 * m13 + m8 * m1 * m15 - m8 * m3 * m13 - m12 * m1 * m11 + m12 * m3 * m9
  )
  inv.m.set(
    index: 13
    value: m0 * m9 * m14 - m0 * m10 * m13 - m8 * m1 * m14 + m8 * m2 * m13 + m12 * m1 * m10 - m12 * m2 * m9
  )
  inv.m.set(
    index: 2
    value: m1 * m6 * m15 - m1 * m7 * m14 - m5 * m2 * m15 + m5 * m3 * m14 + m13 * m2 * m7 - m13 * m3 * m6
  )
  inv.m.set(
    index: 6
    value: 0.0 - m0 * m6 * m15 + m0 * m7 * m14 + m4 * m2 * m15 - m4 * m3 * m14 - m12 * m2 * m7 + m12 * m3 * m6
  )
  inv.m.set(
    index: 10
    value: m0 * m5 * m15 - m0 * m7 * m13 - m4 * m1 * m15 + m4 * m3 * m13 + m12 * m1 * m7 - m12 * m3 * m5
  )
  inv.m.set(
    index: 14
    value: 0.0 - m0 * m5 * m14 + m0 * m6 * m13 + m4 * m1 * m14 - m4 * m2 * m13 - m12 * m1 * m6 + m12 * m2 * m5
  )
  inv.m.set(
    index: 3
    value: 0.0 - m1 * m6 * m11 + m1 * m7 * m10 + m5 * m2 * m11 - m5 * m3 * m10 - m9 * m2 * m7 + m9 * m3 * m6
  )
  inv.m.set(
    index: 7
    value: m0 * m6 * m11 - m0 * m7 * m10 - m4 * m2 * m11 + m4 * m3 * m10 + m8 * m2 * m7 - m8 * m3 * m6
  )
  inv.m.set(
    index: 11
    value: 0.0 - m0 * m5 * m11 + m0 * m7 * m9 + m4 * m1 * m11 - m4 * m3 * m9 - m8 * m1 * m7 + m8 * m3 * m5
  )
  inv.m.set(
    index: 15
    value: m0 * m5 * m10 - m0 * m6 * m9 - m4 * m1 * m10 + m4 * m2 * m9 + m8 * m1 * m6 - m8 * m2 * m5
  )
  let det: Float = m0 * inv.m.copyAtFallback(index: 0, fallback: 0.0) + m1 * inv.m.copyAtFallback(
    index: 4
    fallback: 0.0
  ) + m2 * inv.m.copyAtFallback(index: 8, fallback: 0.0) + m3 * inv.m.copyAtFallback(
    index: 12
    fallback: 0.0
  )
  if Math.abs(value: det) < 0.000000000001 {
    ret mat4Identity()
  }
  let scale: Float = 1.0 / det
  var i: Int = 0
  loop i < 16 {
    inv.m.set(index: i, value: inv.m.copyAtFallback(index: i, fallback: 0.0) * scale)
    i = i + 1
  }
  ret inv
}

func mat4TransformPoint(m: view Mat4, p: view Vec3) pub ret Vec3 {
  ret Vec3.create(
    x: m.m.copyAtFallback(index: 0, fallback: 0.0) * p.x + m.m.copyAtFallback(
      index: 4
      fallback: 0.0
    ) * p.y + m.m.copyAtFallback(index: 8, fallback: 0.0) * p.z + m.m.copyAtFallback(
      index: 12
      fallback: 0.0
    )
    y: m.m.copyAtFallback(index: 1, fallback: 0.0) * p.x + m.m.copyAtFallback(
      index: 5
      fallback: 0.0
    ) * p.y + m.m.copyAtFallback(index: 9, fallback: 0.0) * p.z + m.m.copyAtFallback(
      index: 13
      fallback: 0.0
    )
    z: m.m.copyAtFallback(index: 2, fallback: 0.0) * p.x + m.m.copyAtFallback(
      index: 6
      fallback: 0.0
    ) * p.y + m.m.copyAtFallback(index: 10, fallback: 0.0) * p.z + m.m.copyAtFallback(
      index: 14
      fallback: 0.0
    )
  )
}

# Right-handed Z-up look-at view matrix (docs/coordinate-system.md §Camera):
#   forward = normalize(target - position)
#   right   = normalize(cross(forward, worldUp))
#   up      = cross(right, forward)
# Pass worldUp = (0, 0, 1) for the standard Blender convention. A degenerate
# look (forward parallel to worldUp) falls back to an alternate up reference
# so the basis stays finite, as the doc requires.
#
# View space keeps the camera looking down its own -Z (what the WebGPU
# projection below expects), so the third basis row is -forward.
func mat4LookAt(
  eyeX: view Float
  eyeY: view Float
  eyeZ: view Float
  atX: view Float
  atY: view Float
  atZ: view Float
  upX: view Float
  upY: view Float
  upZ: view Float
) pub ret Mat4 {
  # forward = normalize(target - eye) — the direction the camera looks.
  var fx: Float = atX - eyeX
  var fy: Float = atY - eyeY
  var fz: Float = atZ - eyeZ
  let flen: Float = Math.sqrt(x: fx * fx + fy * fy + fz * fz)
  fx = fx / flen
  fy = fy / flen
  fz = fz / flen
  # right = normalize(cross(forward, worldUp))
  var rx: Float = fy * upZ - fz * upY
  var ry: Float = fz * upX - fx * upZ
  var rz: Float = fx * upY - fy * upX
  var rlen: Float = Math.sqrt(x: rx * rx + ry * ry + rz * rz)
  if rlen < 0.000001 {
    # Degenerate: looking straight along worldUp. Use +Y as the alternate
    # up reference (Blender front-view fallback) and rebuild `right`.
    rx = fy * 0.0 - fz * 1.0
    ry = fz * 0.0 - fx * 0.0
    rz = fx * 1.0 - fy * 0.0
    rlen = Math.sqrt(x: rx * rx + ry * ry + rz * rz)
  }
  rx = rx / rlen
  ry = ry / rlen
  rz = rz / rlen
  # up = cross(right, forward)
  let ux: Float = ry * fz - rz * fy
  let uy: Float = rz * fx - rx * fz
  let uz: Float = rx * fy - ry * fx
  var m: Mat4 = mat4Zero()
  m.m.set(index: 0, value: rx)
  m.m.set(index: 1, value: ux)
  m.m.set(index: 2, value: 0.0 - fx)
  m.m.set(index: 4, value: ry)
  m.m.set(index: 5, value: uy)
  m.m.set(index: 6, value: 0.0 - fy)
  m.m.set(index: 8, value: rz)
  m.m.set(index: 9, value: uz)
  m.m.set(index: 10, value: 0.0 - fz)
  m.m.set(index: 12, value: 0.0 - (rx * eyeX + ry * eyeY + rz * eyeZ))
  m.m.set(index: 13, value: 0.0 - (ux * eyeX + uy * eyeY + uz * eyeZ))
  m.m.set(index: 14, value: fx * eyeX + fy * eyeY + fz * eyeZ)
  m.m.set(index: 15, value: 1.0)
  ret m
}

# Z-up orbit camera position from yaw/pitch/distance around a target.
# Yaw is about +Z (0 puts the camera on -Y, Blender front view); positive
# pitch raises the camera toward +Z.
func orbitEye(
  targetX: view Float
  targetY: view Float
  targetZ: view Float
  yaw: view Float
  pitch: view Float
  dist: view Float
) pub ret Vec3 {
  let cp: Float = Math.cos(x: pitch)
  ret Vec3.create(
    x: targetX + dist * cp * Math.sin(x: yaw)
    y: targetY - dist * cp * Math.cos(x: yaw)
    z: targetZ + dist * Math.sin(x: pitch)
  )
}
