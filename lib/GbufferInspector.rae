# gbuffer_inspector — the G-buffer channel inspector (#503).
#
# Split out of gbuffer.rae to keep both files under the 1000-line cap. It is a
# self-contained fullscreen pass that writes one G-buffer channel into the
# presentable target, built entirely in Rae over the WebGPU bindings. Since
# #904 its pipeline, 16-byte uniform and bind group are typed IDs in the
# DeferredRenderer-owned manager (the G-buffer views it samples are adopted as
# externals per targets generation); the pass itself is opened through
# GbufferPasses' fullscreen helpers and submitted on the shared queue.
open Gbuffer
open Gpu2dCanvas
open GbufferPasses
open GbufferFullscreen
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds

# C exposes the inspector WGSL and the presentable format/view.
func gbViewWgsl() unsafe extern("rae_gb_view_wgsl") ret Buffer(Any)

# #764: the inspector's state was module-level globals; it is per-frame state a
# deferred renderer owns, so it lives in ViewPassCache on RenderPasses. #904:
# the objects are manager IDs; `adopted` holds the views bound at `bindGen`.
type ViewPassCache {
  pipeMade: Bool
  pipeline: RenderPipelineId
  uniform: BufferId
  bindGroup: BindGroupId
  adopted: List(ExternalId)
  bindGen: Int
  args: ArgWriter
}

func createViewPassCache() ret ViewPassCache {
  ret ViewPassCache {
    pipeMade: false
    pipeline: noRenderPipelineId()
    uniform: noBufferId()
    bindGroup: noBindGroupId()
    adopted: List.create(ExternalId, cap: 4)
    bindGen: 0 - 1
    args: createArgs(uniform: true)
  }
}

# Inspector pipeline: a fullscreen triangle (no vertex buffers, no cull) writing
# to the presentable format, plus its 16-byte uniform (mode, zNear, zFar).
func ensureViewPipeline(cache: mod ViewPassCache, resources: mod GpuResources) {
  if cache.pipeMade {
    ret
  }
  cache.pipeMade = true
  unsafe {
    cache.pipeline = createFullscreenPipeline(
      resources: resources
      wgsl: gbViewWgsl()
      format: g2dFormat() as Int32
    )
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 16
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
}

# Inspector bind group: the uniform + the four G-buffer views. Rebuilt after a
# resize — the targets-generation counter changing forces a fresh bind.
func ensureViewBind(cache: mod ViewPassCache, resources: mod GpuResources) {
  let gen: Int = gbTargetsGen()
  if not (gen is cache.bindGen) {
    cache.bindGen = gen
    retireBindGroup(resources: resources, id: cache.bindGroup)
    cache.bindGroup = noBindGroupId()
    releaseExternalIds(resources: resources, list: cache.adopted)
  }
  if bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    ret
  }
  if not gbTargetsBorrowed() {
    ret
  }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 5)
  entries.add(value: bufferRef(id: cache.uniform))
  unsafe {
    entries.add(
      value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewA())
    )
    entries.add(
      value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewB())
    )
    entries.add(
      value: adoptTextureViewRef(resources: resources, adopted: cache.adopted, handle: gbViewC())
    )
    entries.add(
      value: adoptTextureViewRef(
        resources: resources
        adopted: cache.adopted
        handle: gbViewDepth()
      )
    )
  }
  var made: Bool = false
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.pipeline
    entries: entries
  ) {
    cache.bindGroup = bind
    made = true
  }
  if not made {
    releaseExternalIds(resources: resources, list: cache.adopted)
  }
}

# Write one G-buffer channel into the presentable target with a fullscreen pass.
func debugView(
  cache: mod ViewPassCache
  resources: mod GpuResources
  canvas: mod Gpu2dCanvas
  mode: copy Int
  zNear: copy Float
  zFar: copy Float
) pub {
  if not canvasEnsureOffscreen(canvas: canvas) {
    ret
  }
  ensureViewPipeline(cache: cache, resources: resources)
  ensureViewBind(cache: cache, resources: resources)
  if not bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    ret
  }

  # Uniform packed by the writer held on the cache (allocated once) to keep the
  # path zero-alloc.
  resetArgs(writer: cache.args)
  pushVec4F(
    writer: cache.args
    x: mode.toFloat()
    y: zNear
    z: zFar
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: cache.args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )
  unsafe {
    runFullscreen(
      resources: resources
      pipeline: cache.pipeline
      bind: cache.bindGroup
      target: canvasOffscreenView(canvas: canvas)
    )
  }
}

# Paint the chosen channel into the frame (see gbuffer.view*).
func inspect(
  cache: mod ViewPassCache
  resources: mod GpuResources
  canvas: mod Gpu2dCanvas
  mode: view Int
  zNear: view Float
  zFar: view Float
) pub {
  debugView(
    cache: cache
    resources: resources
    canvas: canvas
    mode: mode
    zNear: zNear
    zFar: zFar
  )
}

# Retire the inspector's manager objects (renderer shutdown).
func inspectorShutdown(cache: mod ViewPassCache, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: cache.bindGroup)
  releaseExternalIds(resources: resources, list: cache.adopted)
  retireRenderPipeline(resources: resources, id: cache.pipeline)
  retireBuffer(resources: resources, id: cache.uniform)
  cache = createViewPassCache()
}
