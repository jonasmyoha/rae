# renderer_deferred — the deferred frame, declared as a render graph.
#
# Track B (#356). This is NOT a port of the forward prototype in
# renderer3d.rae. That one computes lighting inside each material's
# fragment shader, so shading cost scales with (objects x lights) and every
# lit pixel is shaded whether or not it survives depth. The deferred frame
# separates the two: the G-buffer pass writes surface attributes once per
# visible pixel, and lighting reads them once per pixel regardless of how
# many objects contributed.
#
# The frame is:
#
#   gbuffer -> depthPyramid -> lighting -> composite -> present
#
# but that order is NEVER written down. Passes are declared deliberately
# out of order below and the sequence is DERIVED from which resources each
# one reads and writes — the same property 553 pins for the forward frame.
# Getting this wrong is a class of bug that otherwise shows up as a subtly
# wrong image rather than an error.
#
# WHY THE DEPTH PYRAMID IS IN THE SLICE. It is not decoration: a mip chain
# of depth is what Hi-Z occlusion culling and SSAO's coarse steps both
# read, and the reference engine shares one pyramid between them rather
# than building two. Declaring it now means the slice's dependency edges
# are the real ones, so when culling arrives it slots in rather than
# reshaping the frame.
#
# ALLOCATION-FREE PER OBJECT is the acceptance criterion (#356), which is
# why transforms flow through the #354 value types: a Mat4 is 16 floats by
# value and modelMatrix no longer allocates, so a frame's per-object data
# path touches the allocator zero times.
import core
import gpu2d
import math3d
import gbuffer
open rendergraph
open math3d
open scene3d
open gbuffer

# ----- pass tags ------------------------------------------------------
# Distinct from renderer3d's tags: these identify passes of the deferred
# frame, and the two frames are separate graphs that never mix.
const tagGbuffer: Int = 10      # writes surface attributes, no lighting
const tagDepthPyramid: Int = 11 # mip chain of depth, for Hi-Z + SSAO
const tagSsaoD: Int = 15        # screen-space AO from G-buffer depth+normal (#387)
const tagLighting: Int = 12     # reads the G-buffer, writes radiance
const tagComposite: Int = 13    # radiance -> the frame's colour target
const tagPresentD: Int = 14     # resolve/present
const tagUiOverlayD: Int = 16   # load-preserving 2D UI painted over the composited frame (#389)
const tagTaaD: Int = 17         # temporal resolve (#390); HDR in, HDR out

type DeferredRenderer {
  graph: RenderGraph
  gbufferPass: Int
  pyramidPass: Int
  lightingPass: Int
  compositePass: Int
  presentPass: Int
  uiPass: Int       # -1 when the frame has no UI overlay
  hasUi: Bool
  # Which channel the composite paints. `viewLit` is the real frame; the
  # others are the G-buffer inspector (lib/gbuffer.rae), which is permanent
  # equipment in a deferred renderer rather than temporary scaffolding.
  debugView: Int
}

# Declare the deferred frame. Pass declaration order here is deliberately
# scrambled — present first, gbuffer last — so that a regression to
# insertion order is visible immediately in the derived sequence.
# ONE builder, parameterised. renderer3d.rae has two near-identical copies
# of its graph (with and without the UI overlay) and they have to be kept
# in step by hand; this does not repeat that.
func buildDeferredGraph(withUi: view Bool) ret DeferredRenderer {
  var g: RenderGraph = createRenderGraph()

  # --- resources ---
  # sceneColor is External: the target gpu2d owns and presents.
  let colorId: Int = addResource(g: g, name: "sceneColor", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeExternal)

  # The G-buffer (#366). Three attachments plus depth, 16 bytes/pixel, with
  # attributes packed ACROSS the targets rather than one per target: A holds
  # the octahedral normal and a shading mode, B albedo and roughness, C
  # motion, metallic and occlusion-or-emissive. Named A/B/C rather than by
  # content precisely because no target holds one thing — a name like
  # "gNormal" would be a lie about where roughness lives.
  let albedoId: Int = addResource(g: g, name: "gbufferA", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let normalId: Int = addResource(g: g, name: "gbufferB", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let materialId: Int = addResource(g: g, name: "gbufferC", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  let depthId: Int = addResource(g: g, name: "gDepth", kind: resDepth, format: 0, sizing: sizeFull, lifetime: lifeTransient)

  # Hi-Z / coarse-trace source. Half-res because the top mip is gDepth
  # itself; this is the chain below it.
  let pyramidId: Int = addResource(g: g, name: "depthPyramid", kind: resTexture2d, format: 0, sizing: sizeHalf, lifetime: lifeTransient)

  # Linear HDR radiance. Everything radiometric happens here; only
  # composite writes the presentable target.
  let litId: Int = addResource(g: g, name: "litColor", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  # AO is full-resolution for now. It is low-frequency and belongs at half
  # res with a depth-aware upsample, which is a tier knob rather than a
  # correctness question — declared truthfully as Full until it moves.
  let aoId: Int = addResource(g: g, name: "aoTex", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifeTransient)
  # PERSISTENT, not transient: the history is read NEXT frame, which is
  # the lifetime class #331 put in graph v1 so temporal techniques could
  # be declared truthfully instead of hidden in C statics.
  let taaId: Int = addResource(g: g, name: "taaColor", kind: resTexture2d, format: 0, sizing: sizeFull, lifetime: lifePersistent)

  # --- passes, declared backwards on purpose ---
  let present: Int = addPass(g: g, name: "present", kind: passRaster, tag: tagPresentD)
  let composite: Int = addPass(g: g, name: "composite", kind: passRaster, tag: tagComposite)
  let lighting: Int = addPass(g: g, name: "lighting", kind: passRaster, tag: tagLighting)
  let ssaoP: Int = addPass(g: g, name: "ssao", kind: passRaster, tag: tagSsaoD)
  let taaP: Int = addPass(g: g, name: "taa", kind: passRaster, tag: tagTaaD)
  let pyramid: Int = addPass(g: g, name: "depthPyramid", kind: passCompute, tag: tagDepthPyramid)
  let gbuffer: Int = addPass(g: g, name: "gbuffer", kind: passRaster, tag: tagGbuffer)

  # --- edges: these, and only these, determine the order ---
  passWrites(g: g, pass: gbuffer, resource: albedoId, access: accAttachmentWrite)
  passWrites(g: g, pass: gbuffer, resource: normalId, access: accAttachmentWrite)
  passWrites(g: g, pass: gbuffer, resource: materialId, access: accAttachmentWrite)
  passWrites(g: g, pass: gbuffer, resource: depthId, access: accAttachmentWrite)

  # The pyramid is built from finished depth, so it must follow gbuffer.
  passReads(g: g, pass: pyramid, resource: depthId, access: accSampledRead)
  passWrites(g: g, pass: pyramid, resource: pyramidId, access: accStorageWrite)

  # Lighting consumes every G-buffer attachment plus the pyramid, and is
  # the only writer of radiance.
  # SSAO reads what the G-buffer wrote and lighting reads the AO, so the
  # graph derives gbuffer -> ssao -> lighting with nobody stating it.
  passReads(g: g, pass: ssaoP, resource: normalId, access: accSampledRead)
  passReads(g: g, pass: ssaoP, resource: depthId, access: accSampledRead)
  passWrites(g: g, pass: ssaoP, resource: aoId, access: accAttachmentWrite)
  passReads(g: g, pass: lighting, resource: aoId, access: accSampledRead)
  passReads(g: g, pass: lighting, resource: albedoId, access: accSampledRead)
  passReads(g: g, pass: lighting, resource: normalId, access: accSampledRead)
  passReads(g: g, pass: lighting, resource: materialId, access: accSampledRead)
  passReads(g: g, pass: lighting, resource: depthId, access: accSampledRead)
  passReads(g: g, pass: lighting, resource: pyramidId, access: accStorageRead)
  passWrites(g: g, pass: lighting, resource: litId, access: accAttachmentWrite)

  # TAA reads radiance and the motion the G-buffer packed, and writes the
  # history the composite then reads — so the graph derives
  # lighting -> taa -> composite.
  passReads(g: g, pass: taaP, resource: litId, access: accSampledRead)
  passReads(g: g, pass: taaP, resource: materialId, access: accSampledRead)
  passWrites(g: g, pass: taaP, resource: taaId, access: accAttachmentWrite)

  # Composite is the only writer of the presentable target.
  passReads(g: g, pass: composite, resource: taaId, access: accSampledRead)
  passWrites(g: g, pass: composite, resource: colorId, access: accAttachmentWrite)

  # The UI overlay MODIFIES the composited target rather than writing it:
  # it loads the finished 3D image and paints over it. Declaring that as a
  # second write would be rejected as two writers; declaring it as a plain
  # read would not order it after composite. `passModifies` is the only
  # honest statement, and the graph derives composite -> ui -> present.
  var ui: Int = 0 - 1
  if withUi {
    ui = addPass(g: g, name: "uiOverlay", kind: passRaster, tag: tagUiOverlayD)
    passModifies(g: g, pass: ui, resource: colorId, access: accAttachmentRead)
  }

  passReads(g: g, pass: present, resource: colorId, access: accSampledRead)

  ret DeferredRenderer {
    graph: g,
    gbufferPass: gbuffer,
    pyramidPass: pyramid,
    lightingPass: lighting,
    compositePass: composite,
    presentPass: present,
    uiPass: ui,
    hasUi: withUi,
    debugView: viewLit
  }
}

# See the note on renderer3d.rae's version: same name, so migrating an
# example flips the word with no edit at the call site.
func rendererPathName() pub ret String {
  ret "deferred"
}

func createDeferredRenderer() pub ret DeferredRenderer {
  ret buildDeferredGraph(withUi: false)
}

# Deferred frame with a load-preserving 2D UI overlay between composite
# and present (#389). Examples 110 and 113 both need this before they can
# leave the forward path.
func createDeferredRendererWithUi() pub ret DeferredRenderer {
  ret buildDeferredGraph(withUi: true)
}

# Choose which channel the composite pass paints (see gbuffer.view*).
func setDebugView(r: mod DeferredRenderer, mode: view Int) pub {
  r.debugView = mode
}

func compileDeferred(r: mod DeferredRenderer) pub ret Int {
  ret compile(g: r.graph)
}

func describeDeferred(r: view DeferredRenderer) pub ret String {
  ret describe(g: r.graph)
}

# Execute one deferred frame.
#
# The loop walks `r.graph.order` — the sequence the graph DERIVED from the
# resource edges — and switches on the pass tag. There is no written
# ordering here to disagree with the declaration: adding an edge in
# createDeferredRenderer changes what runs when, and this function does not
# need editing for that to take effect. Rae has no first-class function
# references, so dispatch is a tag switch, the same pattern renderer3d and
# lib/ui/registry.rae use; the graph never inspects a tag, so that
# constraint stays out of it.
#
# Every declared pass now executes. The depth pyramid is the one whose
# CONSUMER is still missing — Hi-Z culling and a deferred SSAO are what
# will read it — so it is built and unread for now. That is a real pass
# doing real work early, not a placeholder: building it now is what lets
# those techniques arrive as consumers of an existing resource instead of
# as a reshaping of the frame.
func renderDeferredFrame(r: view DeferredRenderer, scene: view Scene3d, camera: view Camera3d, light: view Light3d, aspect: view Float) pub {
  var i: Int = 0
  loop i < r.graph.order.length {
    renderDeferredPass(r: r, tag: deferredTagAt(r: r, i: i), scene: scene,
                       camera: camera, light: light, aspect: aspect)
    i = i + 1
  }
}

# ----- app-driven dispatch (#389) -------------------------------------
# A UI overlay needs lib/ui types, and a renderer must not depend on the
# UI layer. So an app that has a UI walks the DERIVED order itself and
# dispatches every non-UI tag through the helper below — order still comes
# from the graph; only the switch moves to where the UI knowledge is.
# Same seam renderer3d.rae opened for the forward frame.

func deferredOrderLength(r: view DeferredRenderer) pub ret Int {
  ret r.graph.order.length
}

func deferredTagAt(r: view DeferredRenderer, i: view Int) pub ret Int {
  let p: Int = r.graph.order.at(index: i)
  ret r.graph.passes.at(index: p).tag
}

# Run one pass of the deferred frame. Handles every tag EXCEPT the UI
# overlay, which the caller owns.
#
# PRESENT IS THE ONE TAG THAT DIFFERS WITH A UI. gpu2d.beginFrameLoad
# opens a 2D pass on the same offscreen the composite just wrote, and
# gpu2d.endFrame is what presents it — so calling the renderer's own
# present as well would present twice. With a UI, present belongs to
# gpu2d; without one, it belongs here.
func renderDeferredPass(r: view DeferredRenderer, tag: view Int, scene: view Scene3d,
                        camera: view Camera3d, light: view Light3d, aspect: view Float) pub {
  if tag is tagGbuffer {
    beginPass(camera: camera, light: light, aspect: aspect)
    gbuffer.renderScene(scene: scene)
    endPass()
  }
  if tag is tagDepthPyramid {
    buildDepthPyramid()
  }
  if tag is tagSsaoD {
    ssaoPass(camera: camera)
  }
  if tag is tagLighting {
    lightingPass(camera: camera, light: light)
  }
  if tag is tagTaaD {
    taaPass()
  }
  if tag is tagComposite {
    if r.debugView is viewLit {
      compositePass(exposure: light.exposure)
    } else {
      inspect(mode: r.debugView, zNear: camera.nearZ, zFar: camera.farZ)
    }
  }
  if tag is tagPresentD {
    if r.hasUi {
      gpu2d.endFrame()
    } else {
      presentFrame()
    }
  }
}

# How many instances the G-buffer pass submitted last frame.
func deferredDrawCount(r: view DeferredRenderer) pub ret Int {
  ret passDrawCount()
}

# Mip levels in the depth pyramid built by the last frame.
func deferredPyramidMips(r: view DeferredRenderer) pub ret Int {
  ret depthPyramidMips()
}
