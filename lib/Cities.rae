# Cities — a table of well-known cities (capitals, the largest cities and
# well-known places on every continent and many islands, 381 in all) and the
# great-circle nearest to a place: the settings panel names where on Earth
# the scene's latitude and longitude are ("near Helsinki, Finland, 12 km";
# docs/seasons-and-weather-design.md §6). The coordinates are the city
# centers to about a kilometer (two decimals of a degree). Written new.
import Math

# A city: its name, its country (or territory) and where it is, degrees
# north and east
type City {
  name: String
  country: String
  latitude: Float
  longitude: Float
}

# The Earth's mean radius (km)
const cityEarthRadiusKm: Float = 6371.0

# The great-circle distance (km) between two places, degrees north and east
# (the haversine form: accurate at every distance in 32-bit floats)
func cityDistanceKm(
  fromLatitude: view Float
  fromLongitude: view Float
  toLatitude: view Float
  toLongitude: view Float
) ret Float {
  let toRadians: Float = 0.017453292519943295
  let halfLatitude: Float = Math.sin(x: (toLatitude - fromLatitude) * toRadians * 0.5)
  let halfLongitude: Float = Math.sin(x: (toLongitude - fromLongitude) * toRadians * 0.5)
  let h: Float = halfLatitude * halfLatitude + Math.cos(x: fromLatitude * toRadians) * Math.cos(
    x: toLatitude * toRadians
  ) * halfLongitude * halfLongitude
  ret 2.0 * cityEarthRadiusKm * Math.asin(x: Math.sqrt(x: Math.clamp(val: h, low: 0.0, high: 1.0)))
}

# The nearest city to a place and how far it is (km)
type NearCity {
  city: City
  distanceKm: Float
}

# The city of the table nearest to (`latitude`, `longitude`), degrees north
# and east
func nearestCity(latitude: view Float, longitude: view Float) ret NearCity {
  var best: NearCity = {
    city: { name: "", country: "", latitude: 0.0, longitude: 0.0 }
    distanceKm: 100000.0
  }
  loop let city: view City in cities() {
    let distance: Float = cityDistanceKm(
      fromLatitude: latitude
      fromLongitude: longitude
      toLatitude: city.latitude
      toLongitude: city.longitude
    )
    if distance < best.distanceKm {
      best = { city: city, distanceKm: distance }
    }
  }
  ret best
}

# "near Helsinki, Finland, 12 km" for a place
func nearCityText(latitude: view Float, longitude: view Float) ret String {
  let near: NearCity = nearestCity(latitude: latitude, longitude: longitude)
  ret "near {near.city.name}, {near.city.country}, {(near.distanceKm + 0.5).toInt()} km"
}

