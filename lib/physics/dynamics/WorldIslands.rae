# Islands and solver sets of a world (b3CreateIsland, b3DestroyIsland,
# b3MergeIslands, b3LinkContact, b3UnlinkContact of Box3D's island.c;
# b3DestroySolverSet, b3WakeSolverSet, b3TrySleepIsland of solver_set.c; the
# island helpers of body.c, at 9f998c8). Box3D's order of array moves is kept
# exactly; checked against the oracle in fixtures 954, 957 and 984. A
# joint's links, its transfers and merged sleeping sets are WorldJointSets.
open physics/container/IdPool
open physics/container/Bitset
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/Contact
open physics/dynamics/Joint
open physics/dynamics/ConstraintGraph
open physics/dynamics/SolverSet
open physics/dynamics/Island
open physics/dynamics/World
open physics/dynamics/WorldGraph

# b3CreateIsland: a new empty island in set `setIndex`. Returns its id.
func createIsland(world: mod PhysicsWorld, setIndex: view Int) ret Int {
  let islandId: Int = allocId(pool: world.islandIdPool)
  if islandId is world.islands.length {
    world.islands.add(value: emptyIsland())
  }
  var localIndex: Int = 0
  if let set: mod SolverSet => world.solverSets.modAt(index: setIndex) {
    localIndex = set.islandSims.length
    set.islandSims.add(value: islandId)
  }
  world.islands.set(
    index: islandId
    value: Island {
      setIndex: setIndex
      localIndex: localIndex
      islandId: islandId
      constraintRemoveCount: 0
      bodies: List.create(Int, cap: 4)
      contacts: List.create(ContactLink, cap: 4)
      joints: List.create(JointLink, cap: 4)
    }
  )
  ret islandId
}

# b3DestroyIsland: free an (empty) island, filling its slot in its set with
# the set's last island.
func destroyIsland(world: mod PhysicsWorld, islandId: view Int) {
  if world.splitIslandId is islandId {
    world.splitIslandId = -1
  }
  var setIndex: Int = 0
  var localIndex: Int = 0
  if let island: view Island => world.islands.viewAt(index: islandId) {
    setIndex = island.setIndex
    localIndex = island.localIndex
  }
  if let set: mod SolverSet => world.solverSets.modAt(index: setIndex) {
    let lastIndex: Int = set.islandSims.length - 1
    let movedIslandId: Int = set.islandSims.copyAtDefault(index: lastIndex)
    set.islandSims.set(index: localIndex, value: movedIslandId)
    if let moved: mod Island => world.islands.modAt(index: movedIslandId) {
      moved.localIndex = localIndex
    }
    set.islandSims.removeLast()
  }
  if let freed: mod Island => world.islands.modAt(index: islandId) {
    freed.bodies.clear()
    freed.contacts.clear()
    freed.joints.clear()
    freed.constraintRemoveCount = 0
    freed.localIndex = -1
    freed.islandId = -1
    freed.setIndex = -1
  }
  freeId(pool: world.islandIdPool, id: islandId)
}

# The body count of island `islandId`, read through a view.
func islandBodyCount(world: view PhysicsWorld, islandId: view Int) ret Int {
  if let island: view Island => world.islands.viewAt(index: islandId) {
    ret island.bodies.length
  }
  ret 0
}

# b3MergeIslands: move the smaller island's bodies, contacts and joints into the
# bigger one (A on a tie) and destroy it. Returns the island that survives.
func mergeIslands(world: mod PhysicsWorld, islandIdA: view Int, islandIdB: view Int) ret Int {
  if islandIdA is islandIdB {
    ret islandIdA
  }
  if islandIdA is -1 {
    ret islandIdB
  }
  if islandIdB is -1 {
    ret islandIdA
  }
  var bigIslandId: Int = islandIdA
  var smallIslandId: Int = islandIdB
  # Keep the biggest island to reduce cache misses
  if islandBodyCount(world: world, islandId: islandIdA) < islandBodyCount(
    world: world
    islandId: islandIdB
  ) {
    bigIslandId = islandIdB
    smallIslandId = islandIdA
  }
  # The small island's lists, moved out (the loops below change the world)
  # and given back before it is destroyed, which keeps their buffers
  var smallBodies: List(Int) = List.create(Int, cap: 0)
  var smallContacts: List(ContactLink) = List.create(ContactLink, cap: 0)
  var smallJoints: List(JointLink) = List.create(JointLink, cap: 0)
  var smallRemoveCount: Int = 0
  if let small: mod Island => world.islands.modAt(index: smallIslandId) {
    smallBodies = own small.bodies
    smallContacts = own small.contacts
    smallJoints = own small.joints
    smallRemoveCount = small.constraintRemoveCount
  }

  # Move bodies from the smaller island to the larger island
  loop var i: Int = 0, i < smallBodies.length, ++i {
    let bodyId: Int = smallBodies.copyAtDefault(index: i)
    var bodyIndex: Int = 0
    if let big: mod Island => world.islands.modAt(index: bigIslandId) {
      bodyIndex = big.bodies.length
      big.bodies.add(value: bodyId)
    }
    if let body: mod Body => world.bodies.modAt(index: bodyId) {
      body.islandId = bigIslandId
      body.islandIndex = bodyIndex
    }
  }

  # Migrate contacts from the smaller island to the larger island
  loop var i: Int = 0, i < smallContacts.length, ++i {
    let link: ContactLink = smallContacts.copyAtDefault(index: i)
    var contactIndex: Int = 0
    if let big: mod Island => world.islands.modAt(index: bigIslandId) {
      contactIndex = big.contacts.length
      big.contacts.add(value: link)
    }
    if let contact: mod Contact => world.contacts.modAt(index: link.contactId) {
      contact.islandId = bigIslandId
      contact.islandIndex = contactIndex
    }
  }

  # Migrate joints from the smaller island to the larger island
  loop var i: Int = 0, i < smallJoints.length, ++i {
    let link: JointLink = smallJoints.copyAtDefault(index: i)
    var jointIndex: Int = 0
    if let big: mod Island => world.islands.modAt(index: bigIslandId) {
      jointIndex = big.joints.length
      big.joints.add(value: link)
    }
    if let joint: mod Joint => world.joints.modAt(index: link.jointId) {
      joint.islandId = bigIslandId
      joint.islandIndex = jointIndex
    }
  }

  # Track removed constraints
  if let big: mod Island => world.islands.modAt(index: bigIslandId) {
    big.constraintRemoveCount = big.constraintRemoveCount + smallRemoveCount
  }
  if let small: mod Island => world.islands.modAt(index: smallIslandId) {
    small.bodies = own smallBodies
    small.contacts = own smallContacts
    small.joints = own smallJoints
  }
  destroyIsland(world: world, islandId: smallIslandId)
  ret bigIslandId
}

# b3AddContactToIsland
func addContactToIsland(world: mod PhysicsWorld, islandId: view Int, contactId: view Int) {
  let contact: ContactSummary = contactSummaryOf(world: world, contactId: contactId)
  var islandIndex: Int = 0
  if let island: mod Island => world.islands.modAt(index: islandId) {
    islandIndex = island.contacts.length
    island.contacts.add(
      value: ContactLink {
        contactId: contactId
        bodyIdA: contact.bodyIdA
        bodyIdB: contact.bodyIdB
      }
    )
  }
  if let target: mod Contact => world.contacts.modAt(index: contactId) {
    target.islandId = islandId
    target.islandIndex = islandIndex
  }
}

# b3LinkContact: a contact that started touching joins (and merges) its
# bodies' islands, waking a sleeping body touched by an awake one.
func linkContact(world: mod PhysicsWorld, contactId: view Int) {
  let contact: ContactSummary = contactSummaryOf(world: world, contactId: contactId)
  let bodyIdA: Int = contact.bodyIdA
  let bodyIdB: Int = contact.bodyIdB

  # Wake body B if body A is awake and body B is sleeping, and the reverse
  let setA: Int = bodyAt(world: world, bodyId: bodyIdA).setIndex
  let setB: Int = bodyAt(world: world, bodyId: bodyIdB).setIndex
  if setA is awakeSet and setB >= firstSleepingSet {
    wakeSolverSet(world: world, setIndex: setB)
  }
  let wokenSetA: Int = bodyAt(world: world, bodyId: bodyIdA).setIndex
  let wokenSetB: Int = bodyAt(world: world, bodyId: bodyIdB).setIndex
  if wokenSetB is awakeSet and wokenSetA >= firstSleepingSet {
    wakeSolverSet(world: world, setIndex: wokenSetA)
  }

  # Static bodies have no island. Merging destroys one of the islands.
  let finalIslandId: Int = mergeIslands(
    world: world
    islandIdA: bodyAt(world: world, bodyId: bodyIdA).islandId
    islandIdB: bodyAt(world: world, bodyId: bodyIdB).islandId
  )
  addContactToIsland(world: world, islandId: finalIslandId, contactId: contactId)
}

# b3UnlinkContact: a contact that stopped touching (or is destroyed) leaves
# its island, which becomes a split candidate.
func unlinkContact(world: mod PhysicsWorld, contactId: view Int) {
  let contact: ContactSummary = contactSummaryOf(world: world, contactId: contactId)
  let islandId: Int = contact.islandId
  let removeIndex: Int = contact.islandIndex
  var movedContactId: Int = -1
  if let island: mod Island => world.islands.modAt(index: islandId) {
    let lastIndex: Int = island.contacts.length - 1
    if removeIndex is not lastIndex {
      let moved: ContactLink = island.contacts.copyAtDefault(index: lastIndex)
      island.contacts.set(index: removeIndex, value: moved)
      movedContactId = moved.contactId
    }
    island.contacts.removeLast()
    island.constraintRemoveCount = island.constraintRemoveCount + 1
  }
  if movedContactId is not -1 {
    # Fix the island index of the contact swapped into the hole
    if let moved: mod Contact => world.contacts.modAt(index: movedContactId) {
      moved.islandIndex = removeIndex
    }
  }
  if let target: mod Contact => world.contacts.modAt(index: contactId) {
    target.islandId = -1
    target.islandIndex = -1
  }
}

# b3CreateIslandForBody: an island of its own for a new body.
func createIslandForBody(world: mod PhysicsWorld, setIndex: view Int, bodyId: view Int) {
  let islandId: Int = createIsland(world: world, setIndex: setIndex)
  if let island: mod Island => world.islands.modAt(index: islandId) {
    island.bodies.add(value: bodyId)
  }
  if let body: mod Body => world.bodies.modAt(index: bodyId) {
    body.islandId = islandId
    body.islandIndex = 0
  }
}

# b3RemoveBodyFromIsland: take the body out of its island (the island's last
# body fills its slot), destroying the island when it empties.
func removeBodyFromIsland(world: mod PhysicsWorld, bodyId: view Int) {
  let body: Body = bodyAt(world: world, bodyId: bodyId)
  if body.islandId is -1 {
    ret
  }
  let islandId: Int = body.islandId
  var remaining: Int = 0
  if let island: mod Island => world.islands.modAt(index: islandId) {
    let localIndex: Int = body.islandIndex
    let movedBodyId: Int = island.bodies.copyAtDefault(index: island.bodies.length - 1)
    island.bodies.set(index: localIndex, value: movedBodyId)
    island.bodies.removeLast()
    remaining = island.bodies.length
    if let moved: mod Body => world.bodies.modAt(index: movedBodyId) {
      moved.islandIndex = localIndex
    }
  }
  if remaining is 0 {
    destroyIsland(world: world, islandId: islandId)
  }
  if let removed: mod Body => world.bodies.modAt(index: bodyId) {
    removed.islandId = -1
    removed.islandIndex = -1
  }
}

# b3DestroySolverSet: free a set slot.
func destroySolverSet(world: mod PhysicsWorld, setIndex: view Int) {
  world.solverSets.set(index: setIndex, value: emptySolverSet(setIndex: -1))
  freeId(pool: world.solverSetIdPool, id: setIndex)
}

# Remove entry `localIndex` of set `setIndex`'s contact list by moving the
# last one into it, fixing the moved contact's local index
# (b3RemoveNonTouchingContact's swap).
func removeSetContact(world: mod PhysicsWorld, setIndex: view Int, localIndex: view Int) {
  var movedContactId: Int = -1
  if let set: mod SolverSet => world.solverSets.modAt(index: setIndex) {
    let lastIndex: Int = set.contactIndices.length - 1
    if localIndex is not lastIndex {
      movedContactId = set.contactIndices.copyAtDefault(index: lastIndex)
      set.contactIndices.set(index: localIndex, value: movedContactId)
    }
    set.contactIndices.removeLast()
  }
  if movedContactId is not -1 {
    if let moved: mod Contact => world.contacts.modAt(index: movedContactId) {
      moved.localIndex = localIndex
    }
  }
}

# Append contact `contactId` to set `setIndex`'s contact list.
func addSetContact(world: mod PhysicsWorld, setIndex: view Int, contactId: view Int) ret Int {
  var localIndex: Int = 0
  if let set: mod SolverSet => world.solverSets.modAt(index: setIndex) {
    localIndex = set.contactIndices.length
    set.contactIndices.add(value: contactId)
  }
  ret localIndex
}

# b3WakeSolverSet: move a sleeping set's bodies (velocities reset to rest),
# its touching contacts (into the constraint graph) and its islands to the
# awake set, then free it. The bodies' non-touching contacts that sat in the
# disabled set move to the awake set. Islands are not merged.
func wakeSolverSet(world: mod PhysicsWorld, setIndex: view Int) {
  let sleeping: SolverSet = world.solverSets.copyAtDefault(index: setIndex)
  loop let sim: view BodySim in sleeping.bodySims {
    var flags: Int = 0
    var localIndex: Int = 0
    if let awake: view SolverSet => world.solverSets.viewAt(index: awakeSet) {
      localIndex = awake.bodySims.length
    }
    if let body: mod Body => world.bodies.modAt(index: sim.bodyId) {
      body.setIndex = awakeSet
      body.localIndex = localIndex
      # Reset the sleep timer
      body.sleepTime = 0.0
      flags = body.flags
    }
    if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
      awake.bodySims.add(value: sim)
      var state: BodyState = identityBodyState()
      state.flags = flags
      awake.bodyStates.add(value: state)
    }

    # Move non-touching contacts from the disabled set to the awake set.
    let encodedBodySimIndex: Int = localIndex
    var contactKey: Int = bodyAt(world: world, bodyId: sim.bodyId).headContactKey
    loop contactKey is not -1 {
      let edgeIndex: Int = contactKey bitand 1
      let contactId: Int = contactKey shr 1
      let contact: Contact = world.contacts.copyAtDefault(index: contactId)
      contactKey = contactEdge(contact: contact, edgeIndex: edgeIndex).nextKey
      if contact.setIndex is not disabledSet {
        # An awake non-touching contact needs its body sim index fixed here
        if contact.setIndex is awakeSet {
          if let target: mod Contact => world.contacts.modAt(index: contactId) {
            setEncodedBodySim(contact: target, edgeIndex: edgeIndex, encoded: encodedBodySimIndex)
          }
        }
        continue
      }
      let oldLocalIndex: Int = contact.localIndex
      let newLocalIndex: Int = addSetContact(world: world, setIndex: awakeSet, contactId: contactId)
      if let target: mod Contact => world.contacts.modAt(index: contactId) {
        target.setIndex = awakeSet
        target.localIndex = newLocalIndex
        setEncodedBodySim(contact: target, edgeIndex: edgeIndex, encoded: encodedBodySimIndex)
      }
      removeSetContact(world: world, setIndex: disabledSet, localIndex: oldLocalIndex)
    }
  }

  # Transfer touching contacts from the sleeping set to the constraint graph
  loop var i: Int = 0, i < sleeping.contactIndices.length, ++i {
    let contactId: Int = sleeping.contactIndices.copyAtDefault(index: i)
    addContactToGraph(world: world, contactId: contactId)
    if let target: mod Contact => world.contacts.modAt(index: contactId) {
      target.setIndex = awakeSet
    }
  }

  # Transfer the joints from the sleeping set to the constraint graph
  loop let jointSim: view JointSim in sleeping.jointSims {
    addJointToGraph(world: world, jointId: jointSim.jointId, sim: jointSim)
    if let joint: mod Joint => world.joints.modAt(index: jointSim.jointId) {
      joint.setIndex = awakeSet
    }
  }

  # Transfer the islands (usually one: joints can put sleeping islands in
  # one set)
  loop var i: Int = 0, i < sleeping.islandSims.length, ++i {
    let islandId: Int = sleeping.islandSims.copyAtDefault(index: i)
    var localIndex: Int = 0
    if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
      localIndex = awake.islandSims.length
      awake.islandSims.add(value: islandId)
    }
    if let island: mod Island => world.islands.modAt(index: islandId) {
      island.setIndex = awakeSet
      island.localIndex = localIndex
    }
  }
  destroySolverSet(world: world, setIndex: setIndex)
}

# b3WakeBody: wake the body's sleeping set; true if it was asleep.
func wakeBody(world: mod PhysicsWorld, bodyId: view Int) ret Bool {
  let setIndex: Int = bodyAt(world: world, bodyId: bodyId).setIndex
  if setIndex >= firstSleepingSet {
    wakeSolverSet(world: world, setIndex: setIndex)
    ret true
  }
  ret false
}

# b3TrySleepIsland: put an awake island to sleep in a new solver set: its
# bodies, its touching contacts (out of the constraint graph) and the island
# itself move there; the bodies' non-touching contacts move to the disabled
# set once neither body is awake. Not while a split is pending.
func trySleepIsland(world: mod PhysicsWorld, islandId: view Int) {
  var removeCount: Int = 0
  var bodyCount: Int = 0
  if let island: view Island => world.islands.viewAt(index: islandId) {
    removeCount = island.constraintRemoveCount
    bodyCount = island.bodies.length
  }
  if removeCount > 0 and bodyCount > 1 {
    ret
  }
  # The island's lists, moved out (the loops below change the world) and
  # given back before the island moves
  var island: Island = emptyIsland()
  if let source: mod Island => world.islands.modAt(index: islandId) {
    island.localIndex = source.localIndex
    island.bodies = own source.bodies
    island.contacts = own source.contacts
    island.joints = own source.joints
  }

  let sleepSetId: Int = allocId(pool: world.solverSetIdPool)
  if sleepSetId is world.solverSets.length {
    world.solverSets.add(value: emptySolverSet(setIndex: -1))
  }
  world.solverSets.set(index: sleepSetId, value: emptySolverSet(setIndex: sleepSetId))

  # Move the awake bodies to the sleeping set (this shuffles the awake set)
  loop var i: Int = 0, i < island.bodies.length, ++i {
    let bodyId: Int = island.bodies.copyAtDefault(index: i)
    # The body move event says the body fell asleep (it may be forced
    # asleep before it ever moved)
    let moveIndex: Int = bodyAt(world: world, bodyId: bodyId).bodyMoveIndex
    if moveIndex is not -1 {
      if let event: mod BodyMoveEvent => world.bodyMoveEvents.modAt(index: moveIndex) {
        event.fellAsleep = true
      }
      if let movedBody: mod Body => world.bodies.modAt(index: bodyId) {
        movedBody.bodyMoveIndex = -1
      }
    }
    let awakeBodyIndex: Int = bodyAt(world: world, bodyId: bodyId).localIndex
    var sleepBodyIndex: Int = 0
    var movedBodyId: Int = -1
    if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
      let sim: BodySim = awake.bodySims.copyAtDefault(index: awakeBodyIndex)
      if let sleepSet: mod SolverSet => world.solverSets.modAt(index: sleepSetId) {
        sleepBodyIndex = sleepSet.bodySims.length
        sleepSet.bodySims.add(value: sim)
      }
      let lastIndex: Int = awake.bodySims.length - 1
      if awakeBodyIndex is not lastIndex {
        let movedSim: BodySim = awake.bodySims.copyAtDefault(index: lastIndex)
        awake.bodySims.set(index: awakeBodyIndex, value: movedSim)
        movedBodyId = movedSim.bodyId
      }
      awake.bodySims.removeLast()
      # Destroy the state, no need to clone
      let lastState: Int = awake.bodyStates.length - 1
      if awakeBodyIndex is not lastState {
        awake.bodyStates.set(
          index: awakeBodyIndex
          value: awake.bodyStates.copyAtDefault(index: lastState)
        )
      }
      awake.bodyStates.removeLast()
    }
    if movedBodyId is not -1 {
      # Fix the local index of the moved body
      var movedIslandId: Int = -1
      if let moved: mod Body => world.bodies.modAt(index: movedBodyId) {
        moved.localIndex = awakeBodyIndex
        movedIslandId = moved.islandId
      }
      if movedIslandId is not islandId {
        refreshBodyContactIndices(world: world, bodyId: movedBodyId)
      }
    }
    if let body: mod Body => world.bodies.modAt(index: bodyId) {
      body.setIndex = sleepSetId
      body.localIndex = sleepBodyIndex
    }

    # Move non-touching contacts to the disabled set. They may join sleeping
    # islands with no clear owner.
    var contactKey: Int = bodyAt(world: world, bodyId: bodyId).headContactKey
    loop contactKey is not -1 {
      let contactId: Int = contactKey shr 1
      let edgeIndex: Int = contactKey bitand 1
      let contact: Contact = world.contacts.copyAtDefault(index: contactId)
      contactKey = contactEdge(contact: contact, edgeIndex: edgeIndex).nextKey
      if contact.colorIndex is not -1 {
        # Touching: moved separately below
        continue
      }
      if let target: mod Contact => world.contacts.modAt(index: contactId) {
        setEncodedBodySim(contact: target, edgeIndex: edgeIndex, encoded: -1)
      }
      # The other body may still be awake; when it falls asleep it moves the
      # contact to the disabled set.
      let otherBodyId: Int = contactEdge(contact: contact, edgeIndex: edgeIndex bitxor 1).bodyId
      if bodyAt(world: world, bodyId: otherBodyId).setIndex is awakeSet {
        continue
      }
      let localIndex: Int = contact.localIndex
      let disabledIndex: Int = addSetContact(
        world: world
        setIndex: disabledSet
        contactId: contactId
      )
      if let target: mod Contact => world.contacts.modAt(index: contactId) {
        target.setIndex = disabledSet
        target.localIndex = disabledIndex
      }
      removeSetContact(world: world, setIndex: awakeSet, localIndex: localIndex)
    }
  }

  # Move the touching contacts to the sleeping set (this shuffles the graph)
  loop var i: Int = 0, i < island.contacts.length, ++i {
    let contactId: Int = island.contacts.copyAtDefault(index: i).contactId
    let contact: Contact = world.contacts.copyAtDefault(index: contactId)
    let colorIndex: Int = contact.colorIndex
    var movedId: Int = -1
    if let color: mod GraphColor => world.constraintGraph.colors.modAt(index: colorIndex) {
      # Remove the bodies from the colour (a static body's bit has no effect)
      if colorIndex is not overflowIndex {
        clearBit(bitset: color.bodySet, bitIndex: contact.edgeA.bodyId)
        clearBit(bitset: color.bodySet, bitIndex: contact.edgeB.bodyId)
      }
    }
    let sleepContactIndex: Int = addSetContact(
      world: world
      setIndex: sleepSetId
      contactId: contactId
    )
    if let color: mod GraphColor => world.constraintGraph.colors.modAt(index: colorIndex) {
      movedId = removeSwapColorContact(
        color: color
        localIndex: contact.localIndex
        scalarList: (contact.flags bitand simMeshContact) is not 0 or colorIndex is overflowIndex
      )
    }
    if movedId is not -1 {
      if let moved: mod Contact => world.contacts.modAt(index: movedId) {
        moved.localIndex = contact.localIndex
      }
    }
    if let target: mod Contact => world.contacts.modAt(index: contactId) {
      target.setIndex = sleepSetId
      target.colorIndex = -1
      target.localIndex = sleepContactIndex
      target.encodedBodySimA = sleepBodySimIndex(encodedBodySimIndex: target.encodedBodySimA)
      target.encodedBodySimB = sleepBodySimIndex(encodedBodySimIndex: target.encodedBodySimB)
    }
  }

  # Move the joints (this shuffles the graph)
  loop var i: Int = 0, i < island.joints.length, ++i {
    let jointId: Int = island.joints.copyAtDefault(index: i).jointId
    let joint: Joint = world.joints.copyAtDefault(index: jointId)
    let colorIndex: Int = joint.colorIndex
    let localIndex: Int = joint.localIndex
    var movedId: Int = -1
    var sleepJointIndex: Int = 0
    if let color: mod GraphColor => world.constraintGraph.colors.modAt(index: colorIndex) {
      let awakeJointSim: JointSim = color.jointSims.copyAtDefault(index: localIndex)
      if colorIndex is not overflowIndex {
        # Might clear a bit for a static body, which has no effect
        clearBit(bitset: color.bodySet, bitIndex: joint.edgeA.bodyId)
        clearBit(bitset: color.bodySet, bitIndex: joint.edgeB.bodyId)
      }
      if let sleepSet: mod SolverSet => world.solverSets.modAt(index: sleepSetId) {
        sleepJointIndex = sleepSet.jointSims.length
        sleepSet.jointSims.add(value: awakeJointSim)
      }
      let lastIndex: Int = color.jointSims.length - 1
      if localIndex is not lastIndex {
        let moved: JointSim = color.jointSims.copyAtDefault(index: lastIndex)
        color.jointSims.set(index: localIndex, value: moved)
        movedId = moved.jointId
      }
      color.jointSims.removeLast()
    }
    if movedId is not -1 {
      if let moved: mod Joint => world.joints.modAt(index: movedId) {
        moved.localIndex = localIndex
      }
    }
    if let target: mod Joint => world.joints.modAt(index: jointId) {
      target.setIndex = sleepSetId
      target.colorIndex = -1
      target.localIndex = sleepJointIndex
    }
  }

  # Move the island
  let islandIndex: Int = island.localIndex
  if let source: mod Island => world.islands.modAt(index: islandId) {
    source.bodies = own island.bodies
    source.contacts = own island.contacts
    source.joints = own island.joints
  }
  if let sleepSet: mod SolverSet => world.solverSets.modAt(index: sleepSetId) {
    sleepSet.islandSims.add(value: islandId)
  }
  var movedIslandId: Int = -1
  if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    let lastIndex: Int = awake.islandSims.length - 1
    if islandIndex is not lastIndex {
      movedIslandId = awake.islandSims.copyAtDefault(index: lastIndex)
      awake.islandSims.set(index: islandIndex, value: movedIslandId)
    }
    awake.islandSims.removeLast()
  }
  if movedIslandId is not -1 {
    if let moved: mod Island => world.islands.modAt(index: movedIslandId) {
      moved.localIndex = islandIndex
    }
  }
  if let target: mod Island => world.islands.modAt(index: islandId) {
    target.setIndex = sleepSetId
    target.localIndex = 0
  }
  if world.splitIslandId is islandId {
    world.splitIslandId = -1
  }
}

# b3IslandFindParent: the root of `node`, halving the path on the way.
func findIslandRoot(parents: mod List(Int), node: view Int) ret Int {
  var current: Int = node
  loop parents.copyAtDefault(index: current) is not current {
    let grandParent: Int = parents.copyAtDefault(index: parents.copyAtDefault(index: current))
    parents.set(index: current, value: grandParent)
    current = grandParent
  }
  ret current
}

# b3IslandUnion: connect the components of `node1` and `node2` by rank,
# carrying their contact counts.
func unionIslandNodes(
  parents: mod List(Int)
  ranks: mod List(Int)
  contactCounts: mod List(Int)
  node1: view Int
  node2: view Int
) {
  let root1: Int = findIslandRoot(parents: parents, node: node1)
  let root2: Int = findIslandRoot(parents: parents, node: node2)
  if root1 is root2 {
    ret
  }
  let rank1: Int = ranks.copyAtDefault(index: root1)
  let rank2: Int = ranks.copyAtDefault(index: root2)
  if rank1 < rank2 {
    parents.set(index: root1, value: root2)
    contactCounts.set(
      index: root2
      value: contactCounts.copyAtDefault(index: root2) + contactCounts.copyAtDefault(index: root1)
    )
  } else if rank1 > rank2 {
    parents.set(index: root2, value: root1)
    contactCounts.set(
      index: root1
      value: contactCounts.copyAtDefault(index: root1) + contactCounts.copyAtDefault(index: root2)
    )
  } else {
    parents.set(index: root2, value: root1)
    ranks.set(index: root1, value: rank1 + 1)
    contactCounts.set(
      index: root1
      value: contactCounts.copyAtDefault(index: root1) + contactCounts.copyAtDefault(index: root2)
    )
  }
}

# b3SplitIsland: split island `baseId` into its connected components
# (union-find over its contacts and joints; static bodies connect nothing). The new
# islands are created in the order of their first body, then the base
# island is destroyed.
func splitIsland(world: mod PhysicsWorld, baseId: view Int) {
  let base: Island = world.islands.copyAtDefault(index: baseId)
  let baseBodyCount: Int = base.bodies.length
  let parents: List(Int) = List.create(Int, cap: baseBodyCount)
  let ranks: List(Int) = List.create(Int, cap: baseBodyCount)
  let contactCounts: List(Int) = List.create(Int, cap: baseBodyCount)
  loop var i: Int = 0, i < baseBodyCount, ++i {
    parents.add(value: i)
    ranks.add(value: 0)
    contactCounts.add(value: 0)
  }

  # Union over the contacts, counting them per component
  loop let link: view ContactLink in base.contacts {
    let islandIndexA: Int = bodyAt(world: world, bodyId: link.bodyIdA).islandIndex
    let islandIndexB: Int = bodyAt(world: world, bodyId: link.bodyIdB).islandIndex
    if islandIndexA is not -1 and islandIndexB is not -1 {
      unionIslandNodes(
        parents: parents
        ranks: ranks
        contactCounts: contactCounts
        node1: islandIndexA
        node2: islandIndexB
      )
      let root: Int = findIslandRoot(parents: parents, node: islandIndexA)
      contactCounts.set(index: root, value: contactCounts.copyAtDefault(index: root) + 1)
    } else {
      var islandIndex: Int = islandIndexA
      if islandIndexA is -1 {
        islandIndex = islandIndexB
      }
      let root: Int = findIslandRoot(parents: parents, node: islandIndex)
      contactCounts.set(index: root, value: contactCounts.copyAtDefault(index: root) + 1)
    }
  }

  # Union over the joints (Box3D counts them per component only to size the
  # new islands' arrays)
  loop let link: view JointLink in base.joints {
    let islandIndexA: Int = bodyAt(world: world, bodyId: link.bodyIdA).islandIndex
    let islandIndexB: Int = bodyAt(world: world, bodyId: link.bodyIdB).islandIndex
    if islandIndexA is not -1 and islandIndexB is not -1 {
      unionIslandNodes(
        parents: parents
        ranks: ranks
        contactCounts: contactCounts
        node1: islandIndexA
        node2: islandIndexB
      )
    }
  }

  # Flatten the parents and count the components
  var componentCount: Int = 0
  loop var i: Int = 0, i < baseBodyCount, ++i {
    let root: Int = findIslandRoot(parents: parents, node: i)
    parents.set(index: i, value: root)
    if root is i {
      componentCount = componentCount + 1
    }
  }

  # Still fully connected: no split needed
  if componentCount is 1 {
    if let island: mod Island => world.islands.modAt(index: baseId) {
      island.constraintRemoveCount = 0
    }
    ret
  }

  # The new island of each root body, in body order
  let rootMap: List(Int) = List.create(Int, cap: baseBodyCount)
  loop var i: Int = 0, i < baseBodyCount, ++i {
    rootMap.add(value: -1)
  }
  var islandCount: Int = 0
  loop var i: Int = 0, i < baseBodyCount, ++i {
    let rootIndex: Int = parents.copyAtDefault(index: i)
    if rootMap.copyAtDefault(index: rootIndex) is -1 {
      rootMap.set(index: rootIndex, value: islandCount)
      islandCount = islandCount + 1
    }
  }
  let islandIds: List(Int) = List.create(Int, cap: islandCount)
  loop var i: Int = 0, i < islandCount, ++i {
    islandIds.add(value: createIsland(world: world, setIndex: awakeSet))
  }

  # Assign the bodies to the new islands
  loop var i: Int = 0, i < baseBodyCount, ++i {
    let bodyId: Int = base.bodies.copyAtDefault(index: i)
    let root: Int = findIslandRoot(parents: parents, node: i)
    let newIslandId: Int = islandIds.copyAtDefault(index: rootMap.copyAtDefault(index: root))
    var bodyIndex: Int = 0
    if let island: mod Island => world.islands.modAt(index: newIslandId) {
      bodyIndex = island.bodies.length
      island.bodies.add(value: bodyId)
    }
    if let body: mod Body => world.bodies.modAt(index: bodyId) {
      body.islandId = newIslandId
      body.islandIndex = bodyIndex
    }
  }

  # Assign the contacts to the island of their bodies (static bodies have
  # no island)
  loop let link: view ContactLink in base.contacts {
    var targetIslandId: Int = bodyAt(world: world, bodyId: link.bodyIdA).islandId
    if targetIslandId is -1 {
      targetIslandId = bodyAt(world: world, bodyId: link.bodyIdB).islandId
    }
    var contactIndex: Int = 0
    if let island: mod Island => world.islands.modAt(index: targetIslandId) {
      contactIndex = island.contacts.length
      island.contacts.add(value: link)
    }
    if let contact: mod Contact => world.contacts.modAt(index: link.contactId) {
      contact.islandId = targetIslandId
      contact.islandIndex = contactIndex
    }
  }

  # Assign the joints to the island of their bodies
  loop let link: view JointLink in base.joints {
    var targetIslandId: Int = bodyAt(world: world, bodyId: link.bodyIdA).islandId
    if targetIslandId is -1 {
      targetIslandId = bodyAt(world: world, bodyId: link.bodyIdB).islandId
    }
    var jointIndex: Int = 0
    if let island: mod Island => world.islands.modAt(index: targetIslandId) {
      jointIndex = island.joints.length
      island.joints.add(value: link)
    }
    if let joint: mod Joint => world.joints.modAt(index: link.jointId) {
      joint.islandId = targetIslandId
      joint.islandIndex = jointIndex
    }
  }

  # Destroy the base island
  destroyIsland(world: world, islandId: baseId)
}
