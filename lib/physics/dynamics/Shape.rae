# A shape attached to a body (b3Shape of Box3D's shape.h and the geometry
# dispatch of shape.c at 9f998c8): its kind, its geometry, material, filter
# and broad-phase proxy. Box3D keeps the geometry in a union; here the shape
# carries a sphere, a capsule, for a hull the index of its data in the
# world's hull list (Box3D points into a shared hull database), and for a
# mesh, a height field or a compound the index of its data in the world's
# list of those with its local bounds (so the box cases need none of them).
# Box3D's operation order is kept exactly; checked bit for bit against the
# oracle in fixture 954.
import Math
open Vec3
open physics/Constants
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/TransformMath
open physics/math/AabbMath
open physics/geometry/QueryTypes
open physics/geometry/Sphere
open physics/geometry/Capsule
open physics/geometry/Hull
open physics/collision/ShapePair
open physics/dynamics/WorldTypes

# B3_AABB_MARGIN_FRACTION
const aabbMarginFraction: Float = 0.125

type PhysicsShape {
  # -1 for a free slot
  id: Int
  bodyId: Int
  # The body's shape list
  prevShapeId: Int
  nextShapeId: Int
  sensorIndex: Int
  proxyKey: Int
  shapeType: ShapeType
  density: Float
  explosionScale: Float
  aabbMargin: Float
  # The world box with the speculative margin
  aabb: Aabb
  localCentroid: Vec3
  materialCount: Int
  material: SurfaceMaterial
  filter: Filter
  flags: Int
  generation: Int
  # The geometry of the shape's kind
  sphere: Sphere
  capsule: Capsule
  hullIndex: Int
  # A compound's child hulls and meshes are copied into the world's lists:
  # these are then the indices of its first child hull and mesh
  meshIndex: Int
  heightFieldIndex: Int
  compoundIndex: Int
  # A compound's own copy of its material table (b3Shape.materials); empty
  # for every other shape, whose one material is `material`
  materials: List(SurfaceMaterial)
  # The local bounds b3ComputeMeshAABB / b3ComputeHeightFieldAABB transform
  # (a mesh's scaled bounds, a height field's aabb)
  localBounds: Aabb
}

func zeroShape() ret PhysicsShape {
  ret PhysicsShape {
    id: 0
    bodyId: 0
    prevShapeId: 0
    nextShapeId: 0
    sensorIndex: 0
    proxyKey: 0
    shapeType: ShapeType.capsule
    density: 0.0
    explosionScale: 0.0
    aabbMargin: 0.0
    aabb: Aabb { lowerBound: zeroVector(), upperBound: zeroVector() }
    localCentroid: zeroVector()
    materialCount: 0
    material: SurfaceMaterial {
      friction: 0.0
      restitution: 0.0
      rollingResistance: 0.0
      tangentVelocity: zeroVector()
      userMaterialId: 0
      customColor: 0
    }
    filter: Filter { categoryBits: 0, maskBits: 0, groupIndex: 0 }
    flags: 0
    generation: 0
    sphere: Sphere { center: zeroVector(), radius: 0.0 }
    capsule: Capsule { center1: zeroVector(), center2: zeroVector(), radius: 0.0 }
    hullIndex: -1
    meshIndex: -1
    heightFieldIndex: -1
    compoundIndex: -1
    materials: List.create(SurfaceMaterial, cap: 0)
    localBounds: Aabb { lowerBound: zeroVector(), upperBound: zeroVector() }
  }
}

# b3ComputeShapeMargin: the extra room of a moving shape's fat box, an
# eighth of its size, at most maxAabbMargin.
func computeShapeMargin(
  shape: view PhysicsShape
  hulls: view List(Hull)
  lengthUnitsPerMeter: view Float
) ret Float {
  let capMargin: Float = maxAabbMargin(lengthUnitsPerMeter: lengthUnitsPerMeter)
  var margin: Float = 0.0
  match shape.shapeType {
    case ShapeType.sphere {
      margin = shape.sphere.radius
    }
    case ShapeType.capsule {
      margin = 0.5 * distance(from: shape.capsule.center2, to: shape.capsule.center1) + shape.capsule.radius
    }
    case ShapeType.hull {
      if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
        var maxExtentSquared: Float = 0.0
        loop let point: view Vec3 in hull.points {
          let squared: Float = distanceSquared(from: point, to: hull.center)
          maxExtentSquared = maxFloat(left: maxExtentSquared, right: squared)
        }
        margin = Math.sqrt(x: maxExtentSquared)
      }
    }
    # Static-only shapes: never consumed, so the cap
    case ShapeType.mesh {
      ret capMargin
    }
    case ShapeType.height {
      ret capMargin
    }
    case ShapeType.compound {
      ret capMargin
    }
  }
  ret minFloat(left: capMargin, right: aabbMarginFraction * margin)
}

# b3GetShapeCentroid
func shapeCentroid(shape: view PhysicsShape, hulls: view List(Hull)) ret Vec3 {
  match shape.shapeType {
    case ShapeType.capsule {
      ret lerp(from: shape.capsule.center1, to: shape.capsule.center2, alpha: 0.5)
    }
    case ShapeType.sphere {
      ret shape.sphere.center
    }
    case ShapeType.hull {
      if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
        ret hull.center
      }
      ret zeroVector()
    }
    case ShapeType.mesh {
      ret center(box: meshAabb(shape: shape, transform: transformIdentity()))
    }
    case ShapeType.height {
      ret center(box: meshAabb(shape: shape, transform: transformIdentity()))
    }
    case ShapeType.compound {
      ret center(box: meshAabb(shape: shape, transform: transformIdentity()))
    }
  }
}

# b3ComputeMeshAABB / b3ComputeHeightFieldAABB / b3ComputeCompoundAABB of a
# mesh, height or compound shape: its local bounds, transformed.
func meshAabb(shape: view PhysicsShape, transform: view Transform) ret Aabb {
  ret transformAabb(transform: transform, box: shape.localBounds)
}

# The extent of a mesh or compound shape about `localCenter`: the nearer
# corner's distance, the farther corner's offset (b3ComputeShapeExtent).
func localBoundsExtent(shape: view PhysicsShape, localCenter: view Vec3) ret ShapeExtent {
  let box: Aabb = meshAabb(shape: shape, transform: transformIdentity())
  let r1: Float = length(vector: subtract(left: box.lowerBound, right: localCenter))
  let r2: Float = length(vector: subtract(left: box.upperBound, right: localCenter))
  let farthest: Vec3 = farthestPointOnAabb(box: box, point: localCenter)
  ret ShapeExtent {
    minExtent: minFloat(left: r1, right: r2)
    maxExtent: abs(vector: subtract(left: farthest, right: localCenter))
  }
}

# b3GetShapeMaterials(shape)[0]: a compound's first table material, else
# the shape's material.
func firstShapeMaterial(shape: view PhysicsShape) ret SurfaceMaterial {
  if shape.materials.length > 0 {
    ret shape.materials.copyAtDefault(index: 0)
  }
  ret shape.material
}

# b3FarthestPointOnAABB
func farthestPointOnAabb(box: view Aabb, point: view Vec3) ret Vec3 {
  var x: Float = box.upperBound.x
  if point.x - box.lowerBound.x > box.upperBound.x - point.x {
    x = box.lowerBound.x
  }
  var y: Float = box.upperBound.y
  if point.y - box.lowerBound.y > box.upperBound.y - point.y {
    y = box.lowerBound.y
  }
  var z: Float = box.upperBound.z
  if point.z - box.lowerBound.z > box.upperBound.z - point.z {
    z = box.lowerBound.z
  }
  ret Vec3 { x: x, y: y, z: z }
}

# b3ComputeShapeAABB
func computeShapeAabb(
  shape: view PhysicsShape
  hulls: view List(Hull)
  transform: view Transform
) ret Aabb {
  match shape.shapeType {
    case ShapeType.capsule {
      ret computeCapsuleAabb(capsule: shape.capsule, transform: transform)
    }
    case ShapeType.sphere {
      ret computeSphereAabb(sphere: shape.sphere, transform: transform)
    }
    case ShapeType.hull {
      if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
        ret computeHullAabb(hull: hull, transform: transform)
      }
      ret Aabb { lowerBound: transform.position, upperBound: transform.position }
    }
    case ShapeType.mesh {
      ret meshAabb(shape: shape, transform: transform)
    }
    case ShapeType.height {
      ret meshAabb(shape: shape, transform: transform)
    }
    case ShapeType.compound {
      ret meshAabb(shape: shape, transform: transform)
    }
  }
}

# b3ComputeFatShapeAABB (single precision): the box grown by `extra`.
func computeFatShapeAabb(
  shape: view PhysicsShape
  hulls: view List(Hull)
  transform: view Transform
  extra: view Float
) ret Aabb {
  let grow: Vec3 = { x: extra, y: extra, z: extra }
  var box: Aabb = computeShapeAabb(shape: shape, hulls: hulls, transform: transform)
  box.lowerBound = subtract(left: box.lowerBound, right: grow)
  box.upperBound = add(left: box.upperBound, right: grow)
  ret box
}

# b3ComputeShapeMass
func computeShapeMass(shape: view PhysicsShape, hulls: view List(Hull)) ret MassData {
  match shape.shapeType {
    case ShapeType.capsule {
      ret computeCapsuleMass(capsule: shape.capsule, density: shape.density)
    }
    case ShapeType.sphere {
      ret computeSphereMass(sphere: shape.sphere, density: shape.density)
    }
    case ShapeType.hull {
      if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
        ret computeHullMass(hull: hull, density: shape.density)
      }
      ret zeroMassData()
    }
    case ShapeType.mesh {
      ret zeroMassData()
    }
    case ShapeType.height {
      ret zeroMassData()
    }
    case ShapeType.compound {
      ret zeroMassData()
    }
  }
}

func zeroMassData() ret MassData {
  ret MassData {
    mass: 0.0
    center: zeroVector()
    inertia: Matrix3 { columnX: zeroVector(), columnY: zeroVector(), columnZ: zeroVector() }
  }
}

# b3ComputeShapeExtent: the shape's inner radius and its box half extents
# about `localCenter`.
func computeShapeExtent(
  shape: view PhysicsShape
  hulls: view List(Hull)
  localCenter: view Vec3
) ret ShapeExtent {
  match shape.shapeType {
    case ShapeType.capsule {
      let radius: Float = shape.capsule.radius
      let center1: Vec3 = subtract(left: shape.capsule.center1, right: localCenter)
      let center2: Vec3 = subtract(left: shape.capsule.center2, right: localCenter)
      let grow: Vec3 = { x: radius, y: radius, z: radius }
      ret ShapeExtent {
        minExtent: radius
        maxExtent: add(
          left: max(left: abs(vector: center1), right: abs(vector: center2))
          right: grow
        )
      }
    }
    case ShapeType.sphere {
      let radius: Float = shape.sphere.radius
      let offset: Vec3 = abs(vector: subtract(left: shape.sphere.center, right: localCenter))
      let grow: Vec3 = { x: radius, y: radius, z: radius }
      ret ShapeExtent { minExtent: radius, maxExtent: add(left: offset, right: grow) }
    }
    case ShapeType.hull {
      if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
        ret computeHullExtent(hull: hull, origin: localCenter)
      }
      ret ShapeExtent { minExtent: 0.0, maxExtent: zeroVector() }
    }
    case ShapeType.mesh {
      # Needed for kinematic mesh sleeping
      ret localBoundsExtent(shape: shape, localCenter: localCenter)
    }
    case ShapeType.height {
      ret ShapeExtent { minExtent: 0.0, maxExtent: zeroVector() }
    }
    case ShapeType.compound {
      # Not needed, but for completeness
      ret localBoundsExtent(shape: shape, localCenter: localCenter)
    }
  }
}

# makeShapeProxy's points written into `points` (cleared first, so a caller
# can reuse one list); returns the proxy's radius.
func shapeProxyPoints(
  shape: view PhysicsShape
  hulls: view List(Hull)
  points: mod List(Vec3)
) ret Float {
  points.clear()
  if shape.shapeType is ShapeType.capsule {
    points.add(value: shape.capsule.center1)
    points.add(value: shape.capsule.center2)
    ret shape.capsule.radius
  }
  if shape.shapeType is ShapeType.sphere {
    points.add(value: shape.sphere.center)
    ret shape.sphere.radius
  }
  if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
    loop let point: view Vec3 in hull.points {
      points.add(value: point)
    }
  }
  ret 0.0
}

# b3MakeShapeProxy
func makeShapeProxy(shape: view PhysicsShape, hulls: view List(Hull)) ret ShapeProxy {
  if shape.shapeType is ShapeType.capsule {
    let points: List(Vec3) = { shape.capsule.center1, shape.capsule.center2 }
    ret makeProxy(points: points, radius: shape.capsule.radius)
  }
  if shape.shapeType is ShapeType.sphere {
    let points: List(Vec3) = { shape.sphere.center }
    ret makeProxy(points: points, radius: shape.sphere.radius)
  }
  if let hull: view Hull => hulls.viewAt(index: shape.hullIndex) {
    ret makeProxy(points: hull.points, radius: 0.0)
  }
  let empty: List(Vec3) = List.create(Vec3, cap: 0)
  ret makeProxy(points: empty, radius: 0.0)
}
