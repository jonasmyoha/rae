# Joints (b3Joint, b3JointEdge, b3JointSim and b3JointEvent of Box3D's
# joint.h and types.h at 9f998c8): a constraint
# between two bodies. A Joint is the world's record (its set, colour, island
# and its links in both bodies' joint lists); a JointSim is the solver's
# data, living in the solver set or graph colour the joint is in. Box3D keeps
# the per-kind data in a union; here a JointSim carries one record per kind
# and its `jointType` says which one is live (the records are in JointData,
# the definitions in JointDefs). Each kind is solved in its own module.
open Vec2
open Vec3
open Quat
open physics/Constants
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/QuatMath
open physics/math/MatrixMath
open physics/math/TransformMath
open physics/dynamics/WorldTypes
open physics/dynamics/ContactConstraints
open physics/dynamics/JointData

# b3JointType
enum JointType {
  parallelJoint
  distanceJoint
  filterJoint
  motorJoint
  prismaticJoint
  revoluteJoint
  sphericalJoint
  weldJoint
  wheelJoint
}

# Box3D's numbering of b3JointType
func jointTypeCode(jointType: view JointType) ret Int {
  match jointType {
    case JointType.parallelJoint {
      ret 0
    }
    case JointType.distanceJoint {
      ret 1
    }
    case JointType.filterJoint {
      ret 2
    }
    case JointType.motorJoint {
      ret 3
    }
    case JointType.prismaticJoint {
      ret 4
    }
    case JointType.revoluteJoint {
      ret 5
    }
    case JointType.sphericalJoint {
      ret 6
    }
    case JointType.weldJoint {
      ret 7
    }
    case JointType.wheelJoint {
      ret 8
    }
  }
}

# A joint handle (b3JointId)
type JointId {
  index1: Int
  world0: Int
  generation: Int
}

# One of a joint's two links in its bodies' joint lists (b3JointEdge). A
# joint key is the joint id times two plus the edge index.
type JointEdge {
  bodyId: Int
  prevKey: Int
  nextKey: Int
}

# b3Joint
type Joint {
  # The solver set; -1 for a free slot
  setIndex: Int
  # The graph colour while awake, else -1
  colorIndex: Int
  # The index in the set's or colour's joint sims
  localIndex: Int
  edgeA: JointEdge
  edgeB: JointEdge
  # -1 for a free slot
  jointId: Int
  islandId: Int
  islandIndex: Int
  drawScale: Float
  jointType: JointType
  generation: Int
  collideConnected: Bool
}

# A joint of an island, with its two bodies, so splitting an island never
# needs the joint itself (b3JointLink).
type JointLink {
  jointId: Int
  bodyIdA: Int
  bodyIdB: Int
}

# b3JointSim: the common solver data and the live kind's record.
type JointSim {
  jointId: Int
  bodyIdA: Int
  bodyIdB: Int
  jointType: JointType
  # The joint frames, local to the body origins
  localFrameA: Transform
  localFrameB: Transform
  invMassA: Float
  invMassB: Float
  invIA: Matrix3
  invIB: Matrix3
  constraintHertz: Float
  constraintDampingRatio: Float
  constraintSoftness: Softness
  forceThreshold: Float
  torqueThreshold: Float
  fixedRotation: Bool
  distanceJoint: DistanceJointData
  revoluteJoint: RevoluteJointData
  prismaticJoint: PrismaticJointData
  wheelJoint: WheelJointData
  sphericalJoint: SphericalJointData
  motorJoint: MotorJointData
  parallelJoint: ParallelJointData
  weldJoint: WeldJointData
}

# b3JointEvent: an awake joint whose force or torque reached its threshold.
type JointEvent {
  jointId: JointId
}

func zeroJointEdge() ret JointEdge {
  ret JointEdge { bodyId: 0, prevKey: 0, nextKey: 0 }
}

# `(b3Joint){ 0 }`
func zeroJoint() ret Joint {
  ret Joint {
    setIndex: 0
    colorIndex: 0
    localIndex: 0
    edgeA: zeroJointEdge()
    edgeB: zeroJointEdge()
    jointId: 0
    islandId: 0
    islandIndex: 0
    drawScale: 0.0
    jointType: JointType.parallelJoint
    generation: 0
    collideConnected: false
  }
}

# `memset( jointSim, 0, sizeof( b3JointSim ) )`
func zeroJointSim() ret JointSim {
  ret JointSim {
    jointId: 0
    bodyIdA: 0
    bodyIdB: 0
    jointType: JointType.parallelJoint
    localFrameA: zeroTransform()
    localFrameB: zeroTransform()
    invMassA: 0.0
    invMassB: 0.0
    invIA: matrixZero()
    invIB: matrixZero()
    constraintHertz: 0.0
    constraintDampingRatio: 0.0
    constraintSoftness: zeroSoftnessValue()
    forceThreshold: 0.0
    torqueThreshold: 0.0
    fixedRotation: false
    distanceJoint: zeroDistanceJointData()
    revoluteJoint: zeroRevoluteJointData()
    prismaticJoint: zeroPrismaticJointData()
    wheelJoint: zeroWheelJointData()
    sphericalJoint: zeroSphericalJointData()
    motorJoint: zeroMotorJointData()
    parallelJoint: zeroParallelJointData()
    weldJoint: zeroWeldJointData()
  }
}

# `joint->edges[edgeIndex]`
func jointEdge(joint: view Joint, edgeIndex: view Int) ret JointEdge {
  if edgeIndex is 0 {
    ret joint.edgeA
  }
  ret joint.edgeB
}

func setJointEdgePrev(joint: mod Joint, edgeIndex: view Int, prevKey: view Int) {
  if edgeIndex is 0 {
    joint.edgeA.prevKey = prevKey
  } else {
    joint.edgeB.prevKey = prevKey
  }
}

func setJointEdgeNext(joint: mod Joint, edgeIndex: view Int, nextKey: view Int) {
  if edgeIndex is 0 {
    joint.edgeA.nextKey = nextKey
  } else {
    joint.edgeB.nextKey = nextKey
  }
}
