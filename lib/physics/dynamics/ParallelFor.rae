# b3ParallelFor of Box3D's parallel_for.c at 9f998c8: how `itemCount` items
# split into blocks. Rae has no function values, so each parallel site runs
# its own loop: a parallelLoop over the world's chunk slots (one TaskContext
# each), where chunk c runs the contiguous blocks `chunkFirstBlock(c)` up to
# `chunkFirstBlock(c + 1)` in order, as Box3D's tasks run one block each.
# The chunks' results are merged in chunk order, so the step is the same at
# every worker count. With one worker the same chunks run as a plain loop.

# Blocks per worker (Box3D's measured optimum)
const blocksPerWorker: Int = 32

# The block size of `itemCount` items at least `minRange` per block.
func parallelForBlockSize(itemCount: view Int, minRange: view Int, workerCount: view Int) ret Int {
  let maxBlockCount: Int = blocksPerWorker * workerCount
  if itemCount <= minRange * maxBlockCount {
    ret minRange
  }
  ret (itemCount + maxBlockCount - 1) / maxBlockCount
}

func parallelForBlockCount(itemCount: view Int, blockSize: view Int) ret Int {
  if itemCount <= 0 {
    ret 0
  }
  ret (itemCount + blockSize - 1) / blockSize
}

func parallelForBlockStart(blockIndex: view Int, blockSize: view Int) ret Int {
  ret blockIndex * blockSize
}

func parallelForBlockEnd(blockIndex: view Int, blockSize: view Int, itemCount: view Int) ret Int {
  let end: Int = blockIndex * blockSize + blockSize
  if end > itemCount {
    ret itemCount
  }
  ret end
}

# The first block of chunk `chunk` when `chunkCount` chunks share
# `blockCount` blocks in contiguous runs (chunk `chunkCount` gives the end).
func chunkFirstBlock(chunk: view Int, chunkCount: view Int, blockCount: view Int) ret Int {
  ret chunk * blockCount / chunkCount
}
