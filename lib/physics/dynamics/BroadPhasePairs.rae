# Broad-phase pair finding (b3UpdateBroadPhasePairs and its helpers of
# Box3D's broad_phase.c at 9f998c8): the dynamic tree is collided with
# itself (from the sibling pairs with a moved node) and with the static and
# kinematic trees (from breadth-first seeds), candidate pairs pass the pair
# set and b3ShouldCreatePair in batches, and the new pair keys are sorted
# and handed to contact creation. Box3D's traversal and task structure is
# kept: the cross and self pair tasks run block by block as worker 0
# (ParallelFor), each worker gathering into its task context's pair keys.
# Checked bit for bit against the oracle in fixture 956.
#
# A compound shape (static only, so met in the static cross pass) expands
# into one pair per child its box overlaps (b3EmitCompoundPairs). Not here
# yet: the custom filter callback (Rae has no function values; the ECS
# layer, P8, decides its form).
open physics/Constants
open physics/math/AabbMath
open physics/math/TransformMath
open physics/geometry/Compound
open physics/broadPhase/DynamicTree
open physics/broadPhase/DynamicTreeQuery
open physics/broadPhase/DynamicTreeRebuild
open physics/broadPhase/BroadPhase
open physics/broadPhase/PairSet
open physics/container/QuickSort
open physics/collision/ShapePair
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/Shape
open physics/dynamics/World
open physics/dynamics/PairContext
open physics/dynamics/WorldBodies
open physics/dynamics/WorldContacts
open physics/dynamics/ParallelFor

const staticTree: Int = 0

const kinematicTree: Int = 1

const dynamicTree: Int = 2

# b3GatherMovedSiblings: the sibling pairs (below the root) where either
# sibling moved.
func gatherMovedSiblings(tree: view DynamicTree, pairIndices: mod List(Int)) ret Int {
  pairIndices.clear()
  var pair: Int = 2
  loop pair < tree.nodeEnd {
    let flags: Int = treeNode(tree: tree, index: pair).flagIndex bitor treeNode(
      tree: tree
      index: pair + 1
    ).flagIndex
    if (flags bitand movedNode) is not 0 {
      pairIndices.add(value: pair)
    }
    pair = pair + 2
  }
  ret pairIndices.length
}

# b3ShouldCreatePair: the shape pair gauntlet.
func shouldCreatePair(world: view PhysicsWorld, shapeIdA: view Int, shapeIdB: view Int) ret Bool {
  let shapeA: PhysicsShape = world.shapes.copyAtDefault(index: shapeIdA)
  let shapeB: PhysicsShape = world.shapes.copyAtDefault(index: shapeIdB)
  # Are the shapes on the same body?
  if shapeA.bodyId is shapeB.bodyId {
    ret false
  }
  # Sensors are handled elsewhere
  if shapeA.sensorIndex is not -1 or shapeB.sensorIndex is not -1 {
    ret false
  }
  if shouldShapesCollide(filterA: shapeA.filter, filterB: shapeB.filter) is false {
    ret false
  }
  # Does a joint override collision?
  let bodyA: Body = bodyAt(world: world, bodyId: shapeA.bodyId)
  let bodyB: Body = bodyAt(world: world, bodyId: shapeB.bodyId)
  ret shouldBodiesCollide(world: world, bodyA: bodyA, bodyB: bodyB)
}

# b3EmitCompoundPairs: the other shape's box pulled into the compound's
# frame, a key per child it overlaps that has no contact yet; the whole
# batch is dropped when the pair fails the gauntlet.
func emitCompoundPairs(
  world: view PhysicsWorld
  context: mod PairContext
  compoundShapeId: view Int
  otherShapeId: view Int
) {
  let compoundShape: PhysicsShape = world.shapes.copyAtDefault(index: compoundShapeId)
  let otherProxyKey: Int = world.shapes.copyAtDefault(index: otherShapeId).proxyKey
  var otherBox: Aabb = { lowerBound: zeroVector(), upperBound: zeroVector() }
  if let tree: view DynamicTree => world.broadPhase.trees.viewAt(
    index: proxyType(proxyKey: otherProxyKey)
  ) {
    otherBox = treeProxyAabb(tree: tree, proxyId: proxyId(proxyKey: otherProxyKey))
  }
  # The query bounds are float world space, so the demoted transform is the
  # matching float frame
  let compoundTransform: Transform = bodyTransformOf(
    world: world
    body: bodyAt(world: world, bodyId: compoundShape.bodyId)
  )
  let localBox: Aabb = transformAabb(transform: invert(transform: compoundTransform), box: otherBox)
  let startCount: Int = context.pairKeys.length
  if let compound: view CompoundData => world.compounds.viewAt(index: compoundShape.compoundIndex) {
    let children: List(Int) = queryCompound(compound: compound, bounds: localBox)
    loop let childIndex: view Int in children {
      let key: UInt64 = shapePairKey(
        shape1: compoundShapeId
        shape2: otherShapeId
        child: childIndex
      )
      if pairSetContains(set: world.broadPhase.pairSet, key: key) is false {
        context.pairKeys.add(value: key)
      }
    }
  }
  if context.pairKeys.length > startCount and shouldCreatePair(
    world: world
    shapeIdA: compoundShapeId
    shapeIdB: otherShapeId
  ) is false {
    loop context.pairKeys.length > startCount {
      context.pairKeys.removeLast()
    }
  }
}

# b3FlushCandidatePairs: a compound pair expands per child (its key is not
# known yet); the rest are culled when they already have a contact and kept
# when they pass the gauntlet. (Box3D culls the whole batch, then filters
# it; one pass keeps the same order.)
func flushCandidatePairs(world: view PhysicsWorld, context: mod PairContext) {
  # The context's plain list, moved out (emitCompoundPairs takes the
  # context) and back at the end
  var plain: List(CandidatePair) = own context.plain
  plain.clear()
  loop let candidate: view CandidatePair in context.batch {
    if context.checkCompounds {
      let compoundA: Bool = shapeTypeOf(world: world, shapeId: candidate.shapeIdA) is ShapeType.compound
      let compoundB: Bool = shapeTypeOf(world: world, shapeId: candidate.shapeIdB) is ShapeType.compound
      if compoundA {
        # Compound against compound is not supported
        emitCompoundPairs(
          world: world
          context: context
          compoundShapeId: candidate.shapeIdA
          otherShapeId: candidate.shapeIdB
        )
        continue
      }
      if compoundB {
        emitCompoundPairs(
          world: world
          context: context
          compoundShapeId: candidate.shapeIdB
          otherShapeId: candidate.shapeIdA
        )
        continue
      }
    }
    plain.add(value: candidate)
  }
  # As Box3D: prefetch the batch's pair set slots, cull the existing pairs
  # (prefetching the shapes of the rest), then filter
  loop let candidate: view CandidatePair in plain {
    prefetchPairSetSlot(
      set: world.broadPhase.pairSet
      key: shapePairKey(shape1: candidate.shapeIdA, shape2: candidate.shapeIdB, child: 0)
    )
  }
  var survivors: List(CandidatePair) = own context.survivors
  survivors.clear()
  loop let candidate: view CandidatePair in plain {
    let key: UInt64 = shapePairKey(shape1: candidate.shapeIdA, shape2: candidate.shapeIdB, child: 0)
    if pairSetContains(set: world.broadPhase.pairSet, key: key) is false {
      world.shapes.prefetch(index: candidate.shapeIdA)
      world.shapes.prefetch(index: candidate.shapeIdB)
      survivors.add(value: candidate)
    }
  }
  loop let candidate: view CandidatePair in survivors {
    if shouldCreatePair(world: world, shapeIdA: candidate.shapeIdA, shapeIdB: candidate.shapeIdB) {
      # The pair passed the gauntlet. A new contact will be created.
      context.pairKeys.add(
        value: shapePairKey(shape1: candidate.shapeIdA, shape2: candidate.shapeIdB, child: 0)
      )
    }
  }
  context.batch.clear()
  context.plain = own plain
  context.survivors = own survivors
}

# The type of shape `shapeId`, read through a view (a shape copy would copy
# its material list).
func shapeTypeOf(world: view PhysicsWorld, shapeId: view Int) ret ShapeType {
  if let shape: view PhysicsShape => world.shapes.viewAt(index: shapeId) {
    ret shape.shapeType
  }
  ret ShapeType.capsule
}

# b3AddCandidatePair: in shape id order.
func addCandidatePair(
  world: view PhysicsWorld
  context: mod PairContext
  shapeIdA: view Int
  shapeIdB: view Int
) {
  context.batch.add(
    value: CandidatePair {
      shapeIdA: minInt(left: shapeIdA, right: shapeIdB)
      shapeIdB: maxInt(left: shapeIdA, right: shapeIdB)
    }
  )
  if context.batch.length is candidateBatch {
    flushCandidatePairs(world: world, context: context)
  }
}

# b3TestPair: did either move, and if so do they overlap?
func testNodePair(nodeA: view TreeNode, nodeB: view TreeNode) ret Bool {
  if ((nodeA.flagIndex bitor nodeB.flagIndex) bitand movedNode) is 0 {
    ret false
  }
  ret overlapNode(box: nodeA.aabb, node: nodeB)
}

# b3CollideProxyAndSubtree: a leaf against the subtree below sibling pair
# `pair` of `tree`.
func collideProxyAndSubtree(
  world: view PhysicsWorld
  context: mod PairContext
  proxy: view TreeNode
  tree: view DynamicTree
  pair: view Int
) {
  let proxyMark: Int = proxy.flagIndex bitand movedNode
  # A leaf's height field is its shape index
  let shapeId: Int = proxy.height
  context.proxyStack.clear()
  context.proxyStack.add(value: pair)
  loop context.proxyStack.length > 0 {
    let top: Int = context.proxyStack.copyAtDefault(index: context.proxyStack.length - 1)
    context.proxyStack.removeLast()
    loop var i: Int = 0, i < 2, ++i {
      let node: TreeNode = treeNode(tree: tree, index: top + i)
      if ((node.flagIndex bitor proxyMark) bitand movedNode) is 0 {
        continue
      }
      if overlapNode(box: proxy.aabb, node: node) is false {
        continue
      }
      if isLeafNode(node: node) {
        addCandidatePair(
          world: world
          context: context
          shapeIdA: shapeId
          shapeIdB: node.height
        )
      } else if context.proxyStack.length < treeStackSize {
        context.proxyStack.add(value: leftChild(node: node))
      }
    }
  }
}

# b3VisitPair: a node of tree A against a node of tree B.
func visitPair(
  world: view PhysicsWorld
  context: mod PairContext
  treeA: view DynamicTree
  treeB: view DynamicTree
  nodeA: view TreeNode
  nodeB: view TreeNode
) {
  if testNodePair(nodeA: nodeA, nodeB: nodeB) is false {
    ret
  }
  let leafA: Bool = isLeafNode(node: nodeA)
  let leafB: Bool = isLeafNode(node: nodeB)
  if leafA and leafB {
    addCandidatePair(
      world: world
      context: context
      shapeIdA: nodeA.height
      shapeIdB: nodeB.height
    )
  } else if leafA {
    collideProxyAndSubtree(
      world: world
      context: context
      proxy: nodeA
      tree: treeB
      pair: leftChild(node: nodeB)
    )
  } else if leafB {
    collideProxyAndSubtree(
      world: world
      context: context
      proxy: nodeB
      tree: treeA
      pair: leftChild(node: nodeA)
    )
  } else if context.crossStack.length < treeStackSize {
    context.crossStack.add(
      value: IndexPair { pairA: leftChild(node: nodeA), pairB: leftChild(node: nodeB) }
    )
  }
}

# b3CollideCrossPairs: the subtree under `subtreeA` against the one under
# `subtreeB`, possibly in the same tree. Only pairs across the two
# subtrees, so self collision from sibling pairs makes no duplicates.
func collideCrossPairs(
  world: view PhysicsWorld
  context: mod PairContext
  treeA: view DynamicTree
  treeB: view DynamicTree
  subtreeA: view TreeNode
  subtreeB: view TreeNode
) {
  context.crossStack.clear()
  # Seed the stack.
  visitPair(
    world: world
    context: context
    treeA: treeA
    treeB: treeB
    nodeA: subtreeA
    nodeB: subtreeB
  )
  loop context.crossStack.length > 0 {
    let top: IndexPair = context.crossStack.copyAtDefault(index: context.crossStack.length - 1)
    context.crossStack.removeLast()
    loop var i: Int = 0, i < 2, ++i {
      loop var j: Int = 0, j < 2, ++j {
        let nodeA: TreeNode = treeNode(tree: treeA, index: top.pairA + i)
        let nodeB: TreeNode = treeNode(tree: treeB, index: top.pairB + j)
        visitPair(
          world: world
          context: context
          treeA: treeA
          treeB: treeB
          nodeA: nodeA
          nodeB: nodeB
        )
      }
    }
  }
}

# b3SelfPairsTask: moved sibling pairs `startIndex` to `endIndex` of the
# dynamic tree, each pair's subtrees against each other.
func selfPairsTask(
  world: view PhysicsWorld
  context: mod PairContext
  siblingIndices: view List(Int)
  startIndex: view Int
  endIndex: view Int
) {
  if let tree: view DynamicTree => world.broadPhase.trees.viewAt(index: dynamicTree) {
    loop var i: Int = startIndex, i < endIndex, ++i {
      let nodeIndex: Int = siblingIndices.copyAtDefault(index: i)
      let left: TreeNode = treeNode(tree: tree, index: nodeIndex)
      let right: TreeNode = treeNode(tree: tree, index: nodeIndex + 1)
      collideCrossPairs(
        world: world
        context: context
        treeA: tree
        treeB: tree
        subtreeA: left
        subtreeB: right
      )
    }
  }
  flushCandidatePairs(world: world, context: context)
}

# b3GatherCrossSeeds: a breadth-first search across two trees from their
# roots until the queue would hold B3_CROSS_SEED_COUNT pairs; the pairs left
# are the seeds of the cross pair tasks.
func gatherCrossSeeds(
  treeA: view DynamicTree
  treeB: view DynamicTree
  seeds: mod List(NodePair)
  queue: mod List(NodePair)
) ret Int {
  let queueSize: Int = 2 * crossSeedCount
  let mask: Int = queueSize - 1
  let rootA: TreeNode = treeNode(tree: treeA, index: rootNode)
  let rootB: TreeNode = treeNode(tree: treeB, index: rootNode)
  queue.clear()
  loop var i: Int = 0, i < queueSize, ++i {
    queue.add(value: NodePair { nodeA: rootA, nodeB: rootB })
  }
  var head: Int = 0
  var tail: Int = 0
  if testNodePair(nodeA: rootA, nodeB: rootB) {
    queue.set(index: tail bitand mask, value: NodePair { nodeA: rootA, nodeB: rootB })
    tail = tail + 1
  }
  var seedCount: Int = 0
  loop head < tail and seedCount + (tail - head) + 3 < crossSeedCount {
    let pair: NodePair = queue.copyAtDefault(index: head bitand mask)
    head = head + 1
    if isLeafNode(node: pair.nodeA) or isLeafNode(node: pair.nodeB) {
      seeds.add(value: pair)
      seedCount = seedCount + 1
      continue
    }
    let childA: Int = leftChild(node: pair.nodeA)
    let childB: Int = leftChild(node: pair.nodeB)
    # Nodes have two children each, so four combinations.
    loop var i: Int = 0, i < 2, ++i {
      loop var j: Int = 0, j < 2, ++j {
        let nodeA: TreeNode = treeNode(tree: treeA, index: childA + i)
        let nodeB: TreeNode = treeNode(tree: treeB, index: childB + j)
        if testNodePair(nodeA: nodeA, nodeB: nodeB) {
          queue.set(index: tail bitand mask, value: NodePair { nodeA: nodeA, nodeB: nodeB })
          tail = tail + 1
        }
      }
    }
  }
  loop head < tail {
    seeds.add(value: queue.copyAtDefault(index: head bitand mask))
    seedCount = seedCount + 1
    head = head + 1
  }
  ret seedCount
}

# b3CrossPairsTask: seeds `startIndex` to `endIndex`. The static seeds come
# first, then the kinematic ones; the batch is flushed between the two.
func crossPairsTask(
  world: view PhysicsWorld
  context: mod PairContext
  seeds: view List(NodePair)
  staticSeedCount: view Int
  startIndex: view Int
  endIndex: view Int
) {
  if let dynamicNodes: view DynamicTree => world.broadPhase.trees.viewAt(index: dynamicTree) {
    if let staticNodes: view DynamicTree => world.broadPhase.trees.viewAt(index: staticTree) {
      let staticEnd: Int = minInt(left: endIndex, right: staticSeedCount)
      context.checkCompounds = world.compoundShapeCount > 0
      loop var i: Int = startIndex, i < staticEnd, ++i {
        let seed: NodePair = seeds.copyAtDefault(index: i)
        collideCrossPairs(
          world: world
          context: context
          treeA: dynamicNodes
          treeB: staticNodes
          subtreeA: seed.nodeA
          subtreeB: seed.nodeB
        )
      }
    }
    flushCandidatePairs(world: world, context: context)
    context.checkCompounds = false
    if let kinematicNodes: view DynamicTree => world.broadPhase.trees.viewAt(index: kinematicTree) {
      loop var i: Int = maxInt(left: startIndex, right: staticSeedCount), i < endIndex, ++i {
        let seed: NodePair = seeds.copyAtDefault(index: i)
        collideCrossPairs(
          world: world
          context: context
          treeA: dynamicNodes
          treeB: kinematicNodes
          subtreeA: seed.nodeA
          subtreeB: seed.nodeB
        )
      }
    }
    flushCandidatePairs(world: world, context: context)
  }
}

# The cross and self pair tasks over their blocks, as worker 0, into
# `context` (b3ParallelFor of both tasks).
func findPairs(world: view PhysicsWorld, context: mod PairContext) {
  # The context's working lists, moved out (the tasks below take the
  # context too) and back at the end
  var siblingIndices: List(Int) = own context.siblingIndices
  var seeds: List(NodePair) = own context.seeds
  var seedQueue: List(NodePair) = own context.seedQueue
  seeds.clear()
  var dynamicMoveCount: Int = 0
  var staticSeedCount: Int = 0
  var kinematicSeedCount: Int = 0
  if let tree: view DynamicTree => world.broadPhase.trees.viewAt(index: dynamicTree) {
    # The sibling pairs of the dynamic body tree that have moved
    dynamicMoveCount = gatherMovedSiblings(tree: tree, pairIndices: siblingIndices)
    # Seeds for colliding against the static and kinematic trees
    if let other: view DynamicTree => world.broadPhase.trees.viewAt(index: staticTree) {
      staticSeedCount = gatherCrossSeeds(
        treeA: tree
        treeB: other
        seeds: seeds
        queue: seedQueue
      )
    }
    if let other: view DynamicTree => world.broadPhase.trees.viewAt(index: kinematicTree) {
      kinematicSeedCount = gatherCrossSeeds(
        treeA: tree
        treeB: other
        seeds: seeds
        queue: seedQueue
      )
    }
  }
  let crossMoveCount: Int = staticSeedCount + kinematicSeedCount

  # The dynamic body tree against the static and kinematic trees
  let crossBlockSize: Int = parallelForBlockSize(
    itemCount: crossMoveCount
    minRange: 1
    workerCount: world.workerCount
  )
  let crossBlocks: Int = parallelForBlockCount(itemCount: crossMoveCount, blockSize: crossBlockSize)
  loop var block: Int = 0, block < crossBlocks, ++block {
    crossPairsTask(
      world: world
      context: context
      seeds: seeds
      staticSeedCount: staticSeedCount
      startIndex: parallelForBlockStart(blockIndex: block, blockSize: crossBlockSize)
      endIndex: parallelForBlockEnd(
        blockIndex: block
        blockSize: crossBlockSize
        itemCount: crossMoveCount
      )
    )
  }

  # The dynamic body tree against itself
  let selfBlockSize: Int = parallelForBlockSize(
    itemCount: dynamicMoveCount
    minRange: 64
    workerCount: world.workerCount
  )
  let selfBlocks: Int = parallelForBlockCount(itemCount: dynamicMoveCount, blockSize: selfBlockSize)
  loop var block: Int = 0, block < selfBlocks, ++block {
    selfPairsTask(
      world: world
      context: context
      siblingIndices: siblingIndices
      startIndex: parallelForBlockStart(blockIndex: block, blockSize: selfBlockSize)
      endIndex: parallelForBlockEnd(
        blockIndex: block
        blockSize: selfBlockSize
        itemCount: dynamicMoveCount
      )
    )
  }
  context.siblingIndices = own siblingIndices
  context.seeds = own seeds
  context.seedQueue = own seedQueue
}

# Whether a tree's root is marked moved (b3HasTreeMoved), and whether it
# needs a rebuild (b3NeedsRebuild).
func hasTreeMoved(world: view PhysicsWorld, treeIndex: view Int) ret Bool {
  if let tree: view DynamicTree => world.broadPhase.trees.viewAt(index: treeIndex) {
    ret isMovedNode(node: treeNode(tree: tree, index: rootNode))
  }
  ret false
}

func needsRebuild(world: view PhysicsWorld, treeIndex: view Int) ret Bool {
  if let tree: view DynamicTree => world.broadPhase.trees.viewAt(index: treeIndex) {
    ret isMovedNode(node: treeNode(tree: tree, index: rootNode)) or tree.dfsOrdered is false
  }
  ret false
}

# b3UpdateBroadPhasePairs: find the new shape pairs, rebuild the dynamic and
# kinematic trees, and create a contact for each new pair in key order.
# The pair keys handed to contact creation, in that order, are left in
# world.createdPairKeys.
func updateBroadPhasePairs(world: mod PhysicsWorld) {
  # Allocates only when a step creates contacts
  # The world's list, moved out and back (cleared: this step's keys only)
  var created: List(UInt64) = own world.createdPairKeys
  created.clear()
  var needUpdate: Bool = hasTreeMoved(world: world, treeIndex: staticTree)
  needUpdate = needUpdate or needsRebuild(world: world, treeIndex: kinematicTree)
  needUpdate = needUpdate or needsRebuild(world: world, treeIndex: dynamicTree)
  if needUpdate is false {
    world.createdPairKeys = own created
    ret
  }

  loop var i: Int = 0, i < world.taskContexts.length, ++i {
    if let taskContext: mod TaskContext => world.taskContexts.modAt(index: i) {
      taskContext.pairKeys.clear()
    }
  }

  # Generate pairs by querying the dynamic body tree against itself and
  # against the kinematic and static trees.
  # The world's pair context, moved out for the search and back
  var context: PairContext = own world.pairContext
  resetPairContext(context: context)
  findPairs(world: world, context: context)
  if let taskContext: mod TaskContext => world.taskContexts.modAt(index: 0) {
    # (An index loop: a view loop over List(UInt64) emits invalid C, #97861858.)
    loop var i: Int = 0, i < context.pairKeys.length, ++i {
      taskContext.pairKeys.add(value: context.pairKeys.copyAtDefault(index: i))
    }
  }
  world.pairContext = own context

  if let tree: mod DynamicTree => world.broadPhase.trees.modAt(index: staticTree) {
    clearMoved(tree: tree)
  }

  # Update stale trees (b3EnqueueTreeUpdate: inline with one worker).
  if let tree: mod DynamicTree => world.broadPhase.trees.modAt(index: dynamicTree) {
    let dynamicLeaves: Int = rebuildTree(tree: tree, fullBuild: false)
  }
  if let tree: mod DynamicTree => world.broadPhase.trees.modAt(index: kinematicTree) {
    let kinematicLeaves: Int = rebuildTree(tree: tree, fullBuild: false)
  }

  # Pairs arrive in a deterministic order, scrambled relative to body and
  # shape order. Sorting them improves solver performance and makes contact
  # order independent of tree structure.
  # Allocates only when new pairs were found
  # The world's list, moved out and back at the end
  var pairKeys: List(UInt64) = own world.sortedPairKeys
  pairKeys.clear()
  loop let taskContext: view TaskContext in world.taskContexts {
    loop var i: Int = 0, i < taskContext.pairKeys.length, ++i {
      pairKeys.add(value: taskContext.pairKeys.copyAtDefault(index: i))
    }
  }
  # The world's sort stack (QSORT's ranges), reused every step
  var noCompanion: List(Int) = List.create(Int, cap: 0)
  quickSortWithStack(
    T: UInt64
    values: pairKeys
    companion: noCompanion
    stack: world.pairSortStack
  )

  let shapeShift: UInt64 = (64 - shapePower) as UInt64
  let secondShift: UInt64 = (64 - 2 * shapePower) as UInt64
  let shapeBits: UInt64 = shapeMask() as UInt64
  let childBits: UInt64 = childMask() as UInt64
  loop var i: Int = 0, i < pairKeys.length, ++i {
    let key: UInt64 = pairKeys.copyAtDefault(index: i)
    # The traversal is cross subtree and the seeds are disjoint, so a
    # duplicate key is a bug; skip it rather than add it twice.
    if i > 0 and key is pairKeys.copyAtDefault(index: i - 1) {
      continue
    }
    let shapeIdA: Int = ((key shr shapeShift) bitand shapeBits) as Int
    let shapeIdB: Int = ((key shr secondShift) bitand shapeBits) as Int
    let childIndex: Int = (key bitand childBits) as Int
    createContact(
      world: world
      shapeIdA: shapeIdA
      shapeIdB: shapeIdB
      childIndex: childIndex
    )
    created.add(value: key)
  }
  world.sortedPairKeys = own pairKeys
  world.createdPairKeys = own created
}
