# The physics world (b3World of Box3D's physics_world.h and b3CreateWorld of
# physics_world.c at 9f998c8). Everything a world owns is a field of this
# one value, passed `mod` to whatever changes it: Box3D's global world
# registry, length scale and allocators become fields here, and there are no
# globals (AGENTS.md).
open Vec3
open physics/Constants
open physics/math/Scalar
open physics/math/AabbMath
open physics/math/TransformMath
open physics/geometry/Hull
open physics/geometry/Mesh
open physics/geometry/MeshQuery
open physics/geometry/HeightField
open physics/geometry/Compound
open physics/broadPhase/BroadPhase
open physics/container/IdPool
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/Shape
open physics/dynamics/SolverSet
open physics/dynamics/Island
open physics/dynamics/Contact
open physics/dynamics/Joint
open physics/dynamics/StepContext
open physics/dynamics/PairContext
open physics/dynamics/JointData
open physics/dynamics/ConstraintGraph
open physics/collision/Manifold
open physics/collision/HullScratch
open physics/container/Bitset
open physics/dynamics/Events

# One worker's scratch for a step (b3TaskContext of Box3D's
# physics_world.h). A world has one per worker; single-threaded, one. The
# solver's parts join it in P4c (Box3D's narrow-phase statistics counters
# are not kept).
type TaskContext {
  # The pair keys the worker's pair-finding tasks found
  pairKeys: List(UInt64)
  # The contacts whose touching state changed in the narrow phase, by id
  contactStateBitSet: Bitset
  # The narrow phase's manifold buffer (Box3D's per-worker arena)
  localManifold: LocalManifold
  # The mesh contacts' per-triangle manifold buffer
  meshManifold: LocalManifold
  # The hull narrow phase's working lists (Box3D keeps them on the stack)
  hullScratch: HullScratch
  # Body finalization: the awake islands (by local index) and the
  # sleepiest island that needs splitting first
  awakeIslandBitSet: Bitset
  splitIslandId: Int
  splitSleepTime: Float
  # The joints whose force or torque reached a threshold, by id
  jointStateBitSet: Bitset
  # The contacts with a hit event candidate, by id
  hitEventBitSet: Bitset
  hasHitEvents: Bool
  # Sensors crossed in continuous collision
  sensorHits: List(SensorHit)
  # The sensors whose overlaps changed, by sensor index (Box3D's sensor
  # task context)
  sensorEventBits: Bitset
}

# A body that moved in the last step (b3BodyMoveEvent)
type BodyMoveEvent {
  transform: Transform
  bodyId: BodyId
  fellAsleep: Bool
}

func createTaskContext() ret TaskContext {
  ret TaskContext {
    pairKeys: List.create(UInt64, cap: 16)
    contactStateBitSet: createBitset(bitCapacity: 1024)
    localManifold: createLocalManifold(capacity: maxManifoldPoints)
    meshManifold: createLocalManifold(capacity: maxClipPoints)
    hullScratch: createHullScratch()
    awakeIslandBitSet: createBitset(bitCapacity: 256)
    splitIslandId: -1
    splitSleepTime: 0.0
    jointStateBitSet: createBitset(bitCapacity: 64)
    hitEventBitSet: createBitset(bitCapacity: 1024)
    hasHitEvents: false
    sensorHits: List.create(SensorHit, cap: 4)
    sensorEventBits: createBitset(bitCapacity: 128)
  }
}

type PhysicsWorld {
  worldId: Int
  broadPhase: BroadPhase
  bodyIdPool: IdPool
  bodies: List(Body)
  solverSetIdPool: IdPool
  solverSets: List(SolverSet)
  islandIdPool: IdPool
  islands: List(Island)
  shapeIdPool: IdPool
  shapes: List(PhysicsShape)
  # The fat box of each shape's broad-phase proxy, by shape id
  fatAabbs: List(Aabb)
  # The hull data of hull shapes (Box3D's hull database)
  hulls: List(Hull)
  # The content hash of each hull (HullContent), to share equal hulls
  hullHashes: List(UInt64)
  # The step's context, kept between steps so its lists keep their capacity
  # (stepWorld moves it out for the step and back)
  stepContext: StepContext
  # The awake contact ids the narrow phase visits (Collide.collide's list)
  collideContactIds: List(Int)
  # The pair finding's working state (BroadPhasePairs moves it out per step)
  pairContext: PairContext
  # Working lists: the island sleep's island ids, the new pair keys sorted
  sleepIslandIds: List(Int)
  sortedPairKeys: List(UInt64)
  # The pair keys of the contacts the last broad-phase update created
  createdPairKeys: List(UInt64)
  # Continuous collision's working lists: the sensor hits with their
  # fractions, and the tree query stack
  continuousSensorHits: List(SensorHit)
  continuousFractions: List(Float)
  continuousQueryStack: List(Int)
  # The mesh data and scale of mesh shapes (Box3D's shapes point at the
  # caller's b3MeshData)
  meshes: List(Mesh)
  # The data of height shapes (Box3D's shapes point at the caller's
  # b3HeightFieldData)
  heightFields: List(HeightFieldData)
  # The data of compound shapes, and how many compound shapes exist (pair
  # finding expands compounds only while there are any)
  compounds: List(CompoundData)
  compoundShapeCount: Int
  contactIdPool: IdPool
  contacts: List(Contact)
  # Joints, by joint id
  joints: List(Joint)
  jointEvents: List(JointEvent)
  constraintGraph: ConstraintGraph
  bodyMoveEvents: List(BodyMoveEvent)
  sensors: List(Sensor)
  contactBeginEvents: List(ContactBeginTouchEvent)
  contactHitEvents: List(ContactHitEvent)
  sensorBeginEvents: List(SensorBeginTouchEvent)
  # End events are double buffered: a step's list is read after it, while
  # destroying things between steps adds to the next one's
  contactEndEvents0: List(ContactEndTouchEvent)
  contactEndEvents1: List(ContactEndTouchEvent)
  sensorEndEvents0: List(SensorEndTouchEvent)
  sensorEndEvents1: List(SensorEndTouchEvent)
  endEventArrayIndex: Int
  inverseH: Float
  inverseDt: Float
  jointIdPool: IdPool
  # The joint kinds' records (Box3D's union in b3JointSim)
  jointData: JointKindData
  stepIndex: Int
  splitIslandId: Int
  gravity: Vec3
  hitEventThreshold: Float
  restitutionThreshold: Float
  restitutionIterations: Int
  enableRestitutionPropagation: Bool
  maxLinearSpeed: Float
  contactSpeed: Float
  contactHertz: Float
  contactDampingRatio: Float
  contactRecycleDistance: Float
  enableSleep: Bool
  locked: Bool
  enableWarmStarting: Bool
  enableContinuous: Bool
  enableSpeculative: Bool
  workerCount: Int
  taskContexts: List(TaskContext)
  lengthUnitsPerMeter: Float
}

# b3CreateWorld: an empty world with its static, disabled and awake sets.
func createWorld(def: view WorldDef) ret PhysicsWorld {
  var world: PhysicsWorld = {
    worldId: 0
    broadPhase: createBroadPhase(staticShapeCount: 0, dynamicShapeCount: 0, contactCount: 0)
    bodyIdPool: createIdPool()
    bodies: List.create(Body, cap: 16)
    solverSetIdPool: createIdPool()
    solverSets: List.create(SolverSet, cap: 8)
    islandIdPool: createIdPool()
    islands: List.create(Island, cap: 16)
    shapeIdPool: createIdPool()
    shapes: List.create(PhysicsShape, cap: 16)
    fatAabbs: List.create(Aabb, cap: 16)
    hulls: List.create(Hull, cap: 4)
    hullHashes: List.create(UInt64, cap: 4)
    stepContext: createStepContext()
    collideContactIds: List.create(Int, cap: 64)
    pairContext: createPairContext()
    sleepIslandIds: List.create(Int, cap: 16)
    sortedPairKeys: List.create(UInt64, cap: 16)
    createdPairKeys: List.create(UInt64, cap: 16)
    continuousSensorHits: List.create(SensorHit, cap: 4)
    continuousFractions: List.create(Float, cap: 4)
    continuousQueryStack: List.create(Int, cap: 32)
    meshes: List.create(Mesh, cap: 0)
    heightFields: List.create(HeightFieldData, cap: 0)
    compounds: List.create(CompoundData, cap: 0)
    compoundShapeCount: 0
    contactIdPool: createIdPool()
    contacts: List.create(Contact, cap: 16)
    joints: List.create(Joint, cap: 4)
    jointEvents: List.create(JointEvent, cap: 4)
    constraintGraph: createGraph(bodyCapacity: 16)
    bodyMoveEvents: List.create(BodyMoveEvent, cap: 16)
    sensors: List.create(Sensor, cap: 4)
    contactBeginEvents: List.create(ContactBeginTouchEvent, cap: 4)
    contactHitEvents: List.create(ContactHitEvent, cap: 4)
    sensorBeginEvents: List.create(SensorBeginTouchEvent, cap: 4)
    contactEndEvents0: List.create(ContactEndTouchEvent, cap: 4)
    contactEndEvents1: List.create(ContactEndTouchEvent, cap: 4)
    sensorEndEvents0: List.create(SensorEndTouchEvent, cap: 4)
    sensorEndEvents1: List.create(SensorEndTouchEvent, cap: 4)
    endEventArrayIndex: 0
    inverseH: 0.0
    inverseDt: 0.0
    jointIdPool: createIdPool()
    jointData: createJointKindData()
    stepIndex: 0
    splitIslandId: -1
    gravity: def.gravity
    hitEventThreshold: def.hitEventThreshold
    restitutionThreshold: def.restitutionThreshold
    restitutionIterations: clampInt(value: def.restitutionIterations, lower: 0, upper: 63)
    enableRestitutionPropagation: def.enableRestitutionPropagation
    maxLinearSpeed: def.maximumLinearSpeed
    contactSpeed: def.contactSpeed
    contactHertz: def.contactHertz
    contactDampingRatio: def.contactDampingRatio
    contactRecycleDistance: contactRecycleDistance(lengthUnitsPerMeter: def.lengthUnitsPerMeter)
    enableSleep: def.enableSleep
    locked: false
    enableWarmStarting: true
    enableContinuous: def.enableContinuous
    enableSpeculative: true
    workerCount: 1
    taskContexts: List.create(TaskContext, cap: 1)
    lengthUnitsPerMeter: def.lengthUnitsPerMeter
  }
  loop var i: Int = 0, i < world.workerCount, ++i {
    world.taskContexts.add(value: createTaskContext())
  }
  # The static, disabled and awake sets (ids 0, 1, 2)
  loop var i: Int = 0, i < 3, ++i {
    let setIndex: Int = allocId(pool: world.solverSetIdPool)
    world.solverSets.add(value: emptySolverSet(setIndex: setIndex))
  }
  ret world
}

# A copy of body `bodyId`.
func bodyAt(world: view PhysicsWorld, bodyId: view Int) ret Body {
  ret world.bodies.copyAtDefault(index: bodyId)
}

# A copy of the sim of `body`.
func bodySimOf(world: view PhysicsWorld, body: view Body) ret BodySim {
  if let set: view SolverSet => world.solverSets.viewAt(index: body.setIndex) {
    ret set.bodySims.copyAtDefault(index: body.localIndex)
  }
  ret zeroBodySim()
}

# The bookkeeping fields of contact `contactId`, read through a view: a
# Contact copy would copy its manifold list.
type ContactSummary {
  bodyIdA: Int
  bodyIdB: Int
  flags: Int
  manifoldCount: Int
  islandId: Int
  islandIndex: Int
}

func contactSummaryOf(world: view PhysicsWorld, contactId: view Int) ret ContactSummary {
  if let contact: view Contact => world.contacts.viewAt(index: contactId) {
    ret ContactSummary {
      bodyIdA: contact.edgeA.bodyId
      bodyIdB: contact.edgeB.bodyId
      flags: contact.flags
      manifoldCount: contact.manifolds.length
      islandId: contact.islandId
      islandIndex: contact.islandIndex
    }
  }
  ret ContactSummary {
    bodyIdA: 0
    bodyIdB: 0
    flags: 0
    manifoldCount: 0
    islandId: 0
    islandIndex: 0
  }
}

# Read one element of solver set `setIndex` through a view: copying the set
# (`world.solverSets.copyAtDefault(index:)`) would copy every list in it.
func setBodySimAt(world: view PhysicsWorld, setIndex: view Int, localIndex: view Int) ret BodySim {
  if let set: view SolverSet => world.solverSets.viewAt(index: setIndex) {
    ret set.bodySims.copyAtDefault(index: localIndex)
  }
  ret zeroBodySim()
}

func setBodyStateAt(
  world: view PhysicsWorld
  setIndex: view Int
  localIndex: view Int
) ret BodyState {
  if let set: view SolverSet => world.solverSets.viewAt(index: setIndex) {
    ret set.bodyStates.copyAtDefault(index: localIndex)
  }
  ret identityBodyState()
}

# The number of bodies, contacts and islands in solver set `setIndex`.
func setBodyCount(world: view PhysicsWorld, setIndex: view Int) ret Int {
  if let set: view SolverSet => world.solverSets.viewAt(index: setIndex) {
    ret set.bodySims.length
  }
  ret 0
}

func setContactCount(world: view PhysicsWorld, setIndex: view Int) ret Int {
  if let set: view SolverSet => world.solverSets.viewAt(index: setIndex) {
    ret set.contactIndices.length
  }
  ret 0
}

func setIslandCount(world: view PhysicsWorld, setIndex: view Int) ret Int {
  if let set: view SolverSet => world.solverSets.viewAt(index: setIndex) {
    ret set.islandSims.length
  }
  ret 0
}

# Solver set `setIndex`'s island list copied into `islandSims` (cleared
# first; only that list is read).
func copySetIslandSims(world: view PhysicsWorld, setIndex: view Int, islandSims: mod List(Int)) {
  islandSims.clear()
  if let set: view SolverSet => world.solverSets.viewAt(index: setIndex) {
    loop let islandId: view Int in set.islandSims {
      islandSims.add(value: islandId)
    }
  }
}

# Write back the sim of `body`.
func setBodySim(world: mod PhysicsWorld, body: view Body, sim: view BodySim) {
  if let set: mod SolverSet => world.solverSets.modAt(index: body.setIndex) {
    set.bodySims.set(index: body.localIndex, value: sim)
  }
}

# b3GetBodyState: an awake body's state (others have none).
func hasBodyState(body: view Body) ret Bool {
  ret body.setIndex is awakeSet
}

func bodyStateOf(world: view PhysicsWorld, body: view Body) ret BodyState {
  if let set: view SolverSet => world.solverSets.viewAt(index: awakeSet) {
    ret set.bodyStates.copyAtDefault(index: body.localIndex)
  }
  ret identityBodyState()
}

func setBodyState(world: mod PhysicsWorld, body: view Body, state: view BodyState) {
  if let set: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    set.bodyStates.set(index: body.localIndex, value: state)
  }
}

# b3GetBodyTransform
func bodyTransformOf(world: view PhysicsWorld, body: view Body) ret Transform {
  ret bodySimOf(world: world, body: body).transform
}

# The body behind a handle (b3GetBodyFullId; the generation must match).
func bodyIndexOf(bodyId: view BodyId) ret Int {
  ret bodyId.index1 - 1
}

# b3MakeBodyId
func makeBodyId(world: view PhysicsWorld, bodyIndex: view Int) ret BodyId {
  ret BodyId {
    index1: bodyIndex + 1
    world0: world.worldId
    generation: bodyAt(world: world, bodyId: bodyIndex).generation
  }
}

# b3Body_IsValid
func isBodyIdValid(world: view PhysicsWorld, bodyId: view BodyId) ret Bool {
  let index: Int = bodyId.index1 - 1
  if index < 0 or index >= world.bodies.length {
    ret false
  }
  let body: Body = bodyAt(world: world, bodyId: index)
  ret body.setIndex is not -1 and body.generation is bodyId.generation
}

# b3Shape_IsValid
func isShapeIdValid(world: view PhysicsWorld, shapeId: view ShapeId) ret Bool {
  let index: Int = shapeId.index1 - 1
  if index < 0 or index >= world.shapes.length {
    ret false
  }
  let shape: PhysicsShape = world.shapes.copyAtDefault(index: index)
  ret shape.id is not -1 and shape.generation is shapeId.generation
}

# b3RefreshBodyContactIndices: after a body's sim moved, the encoded sim
# index its contacts hold.
func refreshBodyContactIndices(world: mod PhysicsWorld, bodyId: view Int) {
  let body: Body = bodyAt(world: world, bodyId: bodyId)
  let encoded: Int = encodeBodySimIndex(body: body)
  var contactKey: Int = body.headContactKey
  loop contactKey is not -1 {
    let edgeIndex: Int = contactKey bitand 1
    let contactId: Int = contactKey shr 1
    if let contact: mod Contact => world.contacts.modAt(index: contactId) {
      contactKey = contactEdge(contact: contact, edgeIndex: edgeIndex).nextKey
      setEncodedBodySim(contact: contact, edgeIndex: edgeIndex, encoded: encoded)
    }
  }
}

# A contact's flags and local index, read without copying the contact.
func contactFlags(world: view PhysicsWorld, contactId: view Int) ret Int {
  if let contact: view Contact => world.contacts.viewAt(index: contactId) {
    ret contact.flags
  }
  ret 0
}

func contactLocalIndex(world: view PhysicsWorld, contactId: view Int) ret Int {
  if let contact: view Contact => world.contacts.viewAt(index: contactId) {
    ret contact.localIndex
  }
  ret -1
}

# Add an end event to the current end buffer.
func pushContactEndEvent(world: mod PhysicsWorld, event: view ContactEndTouchEvent) {
  if world.endEventArrayIndex is 0 {
    world.contactEndEvents0.add(value: event)
  } else {
    world.contactEndEvents1.add(value: event)
  }
}

func pushSensorEndEvent(world: mod PhysicsWorld, event: view SensorEndTouchEvent) {
  if world.endEventArrayIndex is 0 {
    world.sensorEndEvents0.add(value: event)
  } else {
    world.sensorEndEvents1.add(value: event)
  }
}

# A shape's handle (b3ShapeId)
func makeShapeId(world: view PhysicsWorld, shapeIndex: view Int) ret ShapeId {
  ret ShapeId {
    index1: shapeIndex + 1
    world0: world.worldId
    generation: world.shapes.copyAtDefault(index: shapeIndex).generation
  }
}
