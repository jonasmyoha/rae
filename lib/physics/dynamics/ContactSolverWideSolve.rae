# The wide convex contact solver, part 2 (b3WarmStartContacts_Convex,
# b3PushContacts_Convex, b3SolveContacts_Convex and
# b3ApplyRestitution_Convex of Box3D's contact_solver.c at 9f998c8, its
# scalar path): the iterations over a colour's wide constraints, which start
# at `first` of the step's list. Box3D's operation order is kept exactly;
# checked against the oracle in fixture 958.
open physics/Constants
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/FloatWide
open physics/dynamics/ContactConstraints
open physics/dynamics/StepContext
open physics/dynamics/ContactSolverWide

# Apply impulse `impulse` at `anchorA` / `anchorB` (b3MulSubMVW / b3MulAddMVW
# of the angular and b3MulSubSVW / b3MulAddSVW of the linear velocities).
func applyWideImpulse(
  bodyA: mod BodyStateWide
  bodyB: mod BodyStateWide
  constraint: view ContactConstraintWide
  anchorA: view Vec3Wide
  anchorB: view Vec3Wide
  impulse: view Vec3Wide
) {
  bodyA.angularVelocity = mulSubSym3Wide(
    base: bodyA.angularVelocity
    matrix: constraint.invIA
    vector: crossWide(left: anchorA, right: impulse)
  )
  bodyA.linearVelocity = mulSubVectorWide(
    base: bodyA.linearVelocity
    scale: constraint.invMassA
    vector: impulse
  )
  bodyB.angularVelocity = mulAddSym3Wide(
    base: bodyB.angularVelocity
    matrix: constraint.invIB
    vector: crossWide(left: anchorB, right: impulse)
  )
  bodyB.linearVelocity = mulAddVectorWide(
    base: bodyB.linearVelocity
    scale: constraint.invMassB
    vector: impulse
  )
}

# b3WarmStartContacts_Convex
func warmStartContactsWide(
  states: mod List(BodyState)
  constraints: view List(ContactConstraintWide)
  first: view Int
  block: view SolverBlock
) {
  loop var i: Int = block.startIndex, i < block.startIndex + block.count, ++i {
    if let constraint: view ContactConstraintWide => constraints.viewAt(index: first + i) {
      var bodyA: BodyStateWide = gatherBodies(states: states, indices: constraint.indexA)
      var bodyB: BodyStateWide = gatherBodies(states: states, indices: constraint.indexB)
      let pointCount: Int = widePointCount(constraint: constraint)
      let zero: FloatWide = zeroWide()
      var totalNormalImpulse: FloatWide = zero
      var momentA: Vec3Wide = zeroVectorWide()
      var momentB: Vec3Wide = zeroVectorWide()
      loop var j: Int = 0, j < pointCount, ++j {
        if let constraintPoint: view ContactConstraintPointWide => constraint.points.viewAt(
          index: j
        ) {
          let normalImpulse: FloatWide = constraintPoint.normalImpulse
          totalNormalImpulse = addWide(left: totalNormalImpulse, right: normalImpulse)
          momentA = mulAddVectorWide(
            base: momentA
            scale: normalImpulse
            vector: constraintPoint.anchorA
          )
          momentB = mulAddVectorWide(
            base: momentB
            scale: normalImpulse
            vector: constraintPoint.anchorB
          )
        }
      }
      let normal: Vec3Wide = constraint.normal
      var frictionImpulse: Vec3Wide = scaleVectorWide(
        scale: constraint.frictionImpulse.x
        vector: constraint.tangent1
      )
      frictionImpulse = mulAddVectorWide(
        base: frictionImpulse
        scale: constraint.frictionImpulse.y
        vector: constraint.tangent2
      )
      let linearImpulse: Vec3Wide = mulAddVectorWide(
        base: frictionImpulse
        scale: totalNormalImpulse
        vector: normal
      )
      let twistImpulse: Vec3Wide = scaleVectorWide(scale: constraint.twistImpulse, vector: normal)
      var angularImpulseA: Vec3Wide = addVectorWide(
        left: addVectorWide(
          left: crossWide(left: momentA, right: normal)
          right: crossWide(left: constraint.centerA, right: frictionImpulse)
        )
        right: twistImpulse
      )
      var angularImpulseB: Vec3Wide = addVectorWide(
        left: addVectorWide(
          left: crossWide(left: momentB, right: normal)
          right: crossWide(left: constraint.centerB, right: frictionImpulse)
        )
        right: twistImpulse
      )
      if allZeroWide(value: constraint.rollingResistance) is false {
        angularImpulseA = addVectorWide(left: angularImpulseA, right: constraint.rollingImpulse)
        angularImpulseB = addVectorWide(left: angularImpulseB, right: constraint.rollingImpulse)
      }
      bodyA.angularVelocity = mulSubSym3Wide(
        base: bodyA.angularVelocity
        matrix: constraint.invIA
        vector: angularImpulseA
      )
      bodyA.linearVelocity = mulSubVectorWide(
        base: bodyA.linearVelocity
        scale: constraint.invMassA
        vector: linearImpulse
      )
      bodyB.angularVelocity = mulAddSym3Wide(
        base: bodyB.angularVelocity
        matrix: constraint.invIB
        vector: angularImpulseB
      )
      bodyB.linearVelocity = mulAddVectorWide(
        base: bodyB.linearVelocity
        scale: constraint.invMassB
        vector: linearImpulse
      )
      scatterBodies(states: states, indices: constraint.indexA, body: bodyA)
      scatterBodies(states: states, indices: constraint.indexB, body: bodyB)
    }
  }
}

# The current separation of point `constraintPoint` from local normals (shared by push
# and solve).
func wideSeparation(
  constraintPoint: view ContactConstraintPointWide
  normalSeparation: view FloatWide
  normalA: view Vec3Wide
  normalB: view Vec3Wide
) ret FloatWide {
  ret addWide(
    left: addWide(
      left: normalSeparation
      right: subtractWide(
        left: dotWide(left: normalB, right: constraintPoint.anchorB)
        right: dotWide(left: normalA, right: constraintPoint.anchorA)
      )
    )
    right: constraintPoint.baseSeparation
  )
}

# The relative normal velocity at a point.
func wideNormalVelocity(
  bodyA: view BodyStateWide
  bodyB: view BodyStateWide
  anchorA: view Vec3Wide
  anchorB: view Vec3Wide
  normal: view Vec3Wide
) ret FloatWide {
  let vrA: Vec3Wide = addVectorWide(
    left: bodyA.linearVelocity
    right: crossWide(left: bodyA.angularVelocity, right: anchorA)
  )
  let vrB: Vec3Wide = addVectorWide(
    left: bodyB.linearVelocity
    right: crossWide(left: bodyB.angularVelocity, right: anchorB)
  )
  ret dotWide(left: subtractVectorWide(left: vrB, right: vrA), right: normal)
}

# b3PushContacts_Convex: non-penetration with the soft bias, stiffer for a
# lane with a static body; no friction, no restitution.
func pushContactsWide(
  states: mod List(BodyState)
  constraints: mod List(ContactConstraintWide)
  first: view Int
  block: view SolverBlock
  context: view StepContext
  contactSpeed: view Float
) {
  let inverseH: FloatWide = splatWide(value: context.inverseH)
  let negativeContactSpeed: FloatWide = splatWide(value: -contactSpeed)
  let one: FloatWide = splatWide(value: 1.0)
  let dynamicBiasRate: FloatWide = splatWide(
    value: context.contactSoftness.massScale * context.contactSoftness.biasRate
  )
  let dynamicMassScale: FloatWide = splatWide(value: context.contactSoftness.massScale)
  let dynamicImpulseScale: FloatWide = splatWide(value: context.contactSoftness.impulseScale)
  let staticBiasRate: FloatWide = splatWide(
    value: context.staticSoftness.massScale * context.staticSoftness.biasRate
  )
  let staticMassScale: FloatWide = splatWide(value: context.staticSoftness.massScale)
  let staticImpulseScale: FloatWide = splatWide(value: context.staticSoftness.impulseScale)
  loop var wideIndex: Int = block.startIndex, wideIndex < block.startIndex + block.count, ++wideIndex {
    if let constraint: mod ContactConstraintWide => constraints.modAt(index: first + wideIndex) {
      let pointCount: Int = widePointCount(constraint: constraint)
      var bodyA: BodyStateWide = gatherBodies(states: states, indices: constraint.indexA)
      var bodyB: BodyStateWide = gatherBodies(states: states, indices: constraint.indexB)
      let softMask: Mask4 = softMaskWide(indexA: constraint.indexA, indexB: constraint.indexB)
      let biasRate: FloatWide = blendWide(
        left: dynamicBiasRate
        right: staticBiasRate
        mask: softMask
      )
      let massScale: FloatWide = blendWide(
        left: dynamicMassScale
        right: staticMassScale
        mask: softMask
      )
      let impulseScale: FloatWide = blendWide(
        left: dynamicImpulseScale
        right: staticImpulseScale
        mask: softMask
      )
      let dp: Vec3Wide = subtractVectorWide(left: bodyB.deltaPosition, right: bodyA.deltaPosition)
      # The normals in local space reduce the transform math
      let normalSeparation: FloatWide = dotWide(left: constraint.normal, right: dp)
      let normalA: Vec3Wide = inverseRotateVectorWide(
        quat: bodyA.deltaRotation
        vector: constraint.normal
      )
      let normalB: Vec3Wide = inverseRotateVectorWide(
        quat: bodyB.deltaRotation
        vector: constraint.normal
      )
      loop var pointIndex: Int = 0, pointIndex < pointCount, ++pointIndex {
        if let constraintPoint: mod ContactConstraintPointWide => constraint.points.modAt(
          index: pointIndex
        ) {
          let separation: FloatWide = wideSeparation(
            constraintPoint: constraintPoint
            normalSeparation: normalSeparation
            normalA: normalA
            normalB: normalB
          )
          # Speculative bias when separated, else the soft constraint bias
          let separated: Mask4 = greaterThanWide(left: separation, right: zeroWide())
          let specBias: FloatWide = multiplyWide(left: separation, right: inverseH)
          let overlapBias: FloatWide = maxWide(
            left: multiplyWide(left: biasRate, right: separation)
            right: negativeContactSpeed
          )
          let velocityBias: FloatWide = blendWide(
            left: overlapBias
            right: specBias
            mask: separated
          )
          let pointMassScale: FloatWide = blendWide(left: massScale, right: one, mask: separated)
          let pointImpulseScale: FloatWide = blendWide(
            left: impulseScale
            right: zeroWide()
            mask: separated
          )
          let vn: FloatWide = wideNormalVelocity(
            bodyA: bodyA
            bodyB: bodyB
            anchorA: constraintPoint.anchorA
            anchorB: constraintPoint.anchorB
            normal: constraint.normal
          )
          let negImpulse: FloatWide = addWide(
            left: multiplyWide(
              left: constraintPoint.normalMass
              right: addWide(
                left: multiplyWide(left: pointMassScale, right: vn)
                right: velocityBias
              )
            )
            right: multiplyWide(left: pointImpulseScale, right: constraintPoint.normalImpulse)
          )
          let newImpulse: FloatWide = maxWide(
            left: subtractWide(left: constraintPoint.normalImpulse, right: negImpulse)
            right: zeroWide()
          )
          let deltaImpulse: FloatWide = subtractWide(
            left: newImpulse
            right: constraintPoint.normalImpulse
          )
          constraintPoint.normalImpulse = newImpulse
          let impulse: Vec3Wide = scaleVectorWide(scale: deltaImpulse, vector: constraint.normal)
          applyWideImpulse(
            bodyA: bodyA
            bodyB: bodyB
            constraint: constraint
            anchorA: constraintPoint.anchorA
            anchorB: constraintPoint.anchorB
            impulse: impulse
          )
        }
      }
      scatterBodies(states: states, indices: constraint.indexA, body: bodyA)
      scatterBodies(states: states, indices: constraint.indexB, body: bodyB)
    }
  }
}

# b3SolveContacts_Convex: normal, rolling resistance, twist and friction.
func solveContactsWide(
  states: mod List(BodyState)
  constraints: mod List(ContactConstraintWide)
  first: view Int
  block: view SolverBlock
  inverseHValue: view Float
) {
  let inverseH: FloatWide = splatWide(value: inverseHValue)
  let one: FloatWide = splatWide(value: 1.0)
  let epsilon: FloatWide = splatWide(value: floatEpsilon)
  loop var wideIndex: Int = block.startIndex, wideIndex < block.startIndex + block.count, ++wideIndex {
    if let constraint: mod ContactConstraintWide => constraints.modAt(index: first + wideIndex) {
      let pointCount: Int = widePointCount(constraint: constraint)
      var bodyA: BodyStateWide = gatherBodies(states: states, indices: constraint.indexA)
      var bodyB: BodyStateWide = gatherBodies(states: states, indices: constraint.indexB)
      let dp: Vec3Wide = subtractVectorWide(left: bodyB.deltaPosition, right: bodyA.deltaPosition)
      let normalSeparation: FloatWide = dotWide(left: constraint.normal, right: dp)
      let normalA: Vec3Wide = inverseRotateVectorWide(
        quat: bodyA.deltaRotation
        vector: constraint.normal
      )
      let normalB: Vec3Wide = inverseRotateVectorWide(
        quat: bodyB.deltaRotation
        vector: constraint.normal
      )
      var totalNormalImpulse: FloatWide = zeroWide()
      var totalTwistLimit: FloatWide = zeroWide()
      loop var pointIndex: Int = 0, pointIndex < pointCount, ++pointIndex {
        if let constraintPoint: mod ContactConstraintPointWide => constraint.points.modAt(
          index: pointIndex
        ) {
          let separation: FloatWide = wideSeparation(
            constraintPoint: constraintPoint
            normalSeparation: normalSeparation
            normalA: normalA
            normalB: normalB
          )
          # Speculative bias, positive if separated and zero if overlapped
          let velocityBias: FloatWide = maxWide(
            left: zeroWide()
            right: multiplyWide(left: separation, right: inverseH)
          )
          let vn: FloatWide = wideNormalVelocity(
            bodyA: bodyA
            bodyB: bodyB
            anchorA: constraintPoint.anchorA
            anchorB: constraintPoint.anchorB
            normal: constraint.normal
          )
          let negImpulse: FloatWide = multiplyWide(
            left: constraintPoint.normalMass
            right: addWide(left: vn, right: velocityBias)
          )
          let newImpulse: FloatWide = maxWide(
            left: subtractWide(left: constraintPoint.normalImpulse, right: negImpulse)
            right: zeroWide()
          )
          let deltaImpulse: FloatWide = subtractWide(
            left: newImpulse
            right: constraintPoint.normalImpulse
          )
          constraintPoint.normalImpulse = newImpulse
          constraintPoint.totalNormalImpulse = addWide(
            left: constraintPoint.totalNormalImpulse
            right: newImpulse
          )
          totalNormalImpulse = addWide(left: totalNormalImpulse, right: newImpulse)
          totalTwistLimit = addWide(
            left: totalTwistLimit
            right: multiplyWide(left: constraintPoint.leverArm, right: newImpulse)
          )
          let impulse: Vec3Wide = scaleVectorWide(scale: deltaImpulse, vector: constraint.normal)
          applyWideImpulse(
            bodyA: bodyA
            bodyB: bodyB
            constraint: constraint
            anchorA: constraintPoint.anchorA
            anchorB: constraintPoint.anchorB
            impulse: impulse
          )
        }
      }

      # Rolling resistance
      if allZeroWide(value: constraint.rollingResistance) is false {
        # A/B flipped to negate
        var rollingDelta: Vec3Wide = multiplySym3Wide(
          matrix: constraint.rollingMass
          vector: subtractVectorWide(left: bodyA.angularVelocity, right: bodyB.angularVelocity)
        )
        let oldRolling: Vec3Wide = constraint.rollingImpulse
        constraint.rollingImpulse = addVectorWide(left: oldRolling, right: rollingDelta)
        let maxRolling: FloatWide = multiplyWide(
          left: constraint.rollingResistance
          right: totalNormalImpulse
        )
        let rollingLengthSquared: FloatWide = dotWide(
          left: constraint.rollingImpulse
          right: constraint.rollingImpulse
        )
        let rollingMask: Mask4 = greaterThanWide(
          left: rollingLengthSquared
          right: mulAddWide(base: epsilon, left: maxRolling, right: maxRolling)
        )
        # No approximate reciprocal square root: cross-platform determinism
        let rollingNormalize: FloatWide = divideWide(
          left: maxRolling
          right: addWide(left: sqrtWide(value: rollingLengthSquared), right: epsilon)
        )
        var rollingScale: FloatWide = blendWide(
          left: one
          right: rollingNormalize
          mask: rollingMask
        )
        # Zero rolling resistance gives no impulse
        rollingScale = blendWide(
          left: zeroWide()
          right: rollingScale
          mask: greaterThanWide(left: constraint.rollingResistance, right: zeroWide())
        )
        constraint.rollingImpulse = scaleVectorWide(
          scale: rollingScale
          vector: constraint.rollingImpulse
        )
        rollingDelta = subtractVectorWide(left: constraint.rollingImpulse, right: oldRolling)
        bodyA.angularVelocity = mulSubSym3Wide(
          base: bodyA.angularVelocity
          matrix: constraint.invIA
          vector: rollingDelta
        )
        bodyB.angularVelocity = mulAddSym3Wide(
          base: bodyB.angularVelocity
          matrix: constraint.invIB
          vector: rollingDelta
        )
      }

      # Central twist friction
      let twistSpeed: FloatWide = dotWide(
        left: constraint.normal
        right: subtractVectorWide(left: bodyB.angularVelocity, right: bodyA.angularVelocity)
      )
      let maxLambda: FloatWide = multiplyWide(left: constraint.friction, right: totalTwistLimit)
      var twistDelta: FloatWide = negateWide(
        value: multiplyWide(left: constraint.twistMass, right: twistSpeed)
      )
      let oldTwist: FloatWide = constraint.twistImpulse
      constraint.twistImpulse = symClampWide(
        value: addWide(left: oldTwist, right: twistDelta)
        limit: maxLambda
      )
      twistDelta = subtractWide(left: constraint.twistImpulse, right: oldTwist)
      let twist: Vec3Wide = scaleVectorWide(scale: twistDelta, vector: constraint.normal)
      bodyA.angularVelocity = mulSubSym3Wide(
        base: bodyA.angularVelocity
        matrix: constraint.invIA
        vector: twist
      )
      bodyB.angularVelocity = mulAddSym3Wide(
        base: bodyB.angularVelocity
        matrix: constraint.invIB
        vector: twist
      )

      # Central friction
      let tangent1: Vec3Wide = constraint.tangent1
      let tangent2: Vec3Wide = constraint.tangent2
      let rA: Vec3Wide = constraint.centerA
      let rB: Vec3Wide = constraint.centerB
      let vrA: Vec3Wide = addVectorWide(
        left: bodyA.linearVelocity
        right: crossWide(left: bodyA.angularVelocity, right: rA)
      )
      let vrB: Vec3Wide = addVectorWide(
        left: bodyB.linearVelocity
        right: crossWide(left: bodyB.angularVelocity, right: rB)
      )
      let vr: Vec3Wide = subtractVectorWide(left: vrB, right: vrA)
      let vt: Vec2Wide = {
        x: subtractWide(
          left: dotWide(left: vr, right: tangent1)
          right: constraint.tangentVelocity1
        )
        y: subtractWide(
          left: dotWide(left: vr, right: tangent2)
          right: constraint.tangentVelocity2
        )
      }
      var frictionDelta: Vec2Wide = multiplySym2Wide(matrix: constraint.tangentMass, vector: vt)
      frictionDelta = Vec2Wide {
        x: negateWide(value: frictionDelta.x)
        y: negateWide(value: frictionDelta.y)
      }
      var newFriction: Vec2Wide = addVector2Wide(
        left: constraint.frictionImpulse
        right: frictionDelta
      )
      let maxFriction: FloatWide = multiplyWide(
        left: constraint.friction
        right: totalNormalImpulse
      )
      let frictionLengthSquared: FloatWide = addWide(
        left: multiplyWide(left: newFriction.x, right: newFriction.x)
        right: multiplyWide(left: newFriction.y, right: newFriction.y)
      )
      # The max impulse can be zero
      let frictionMask: Mask4 = greaterThanWide(
        left: frictionLengthSquared
        right: multiplyWide(left: maxFriction, right: maxFriction)
      )
      let frictionNormalize: FloatWide = divideWide(
        left: maxFriction
        right: addWide(left: sqrtWide(value: frictionLengthSquared), right: epsilon)
      )
      let frictionScale: FloatWide = blendWide(
        left: one
        right: frictionNormalize
        mask: frictionMask
      )
      newFriction = Vec2Wide {
        x: multiplyWide(left: frictionScale, right: newFriction.x)
        y: multiplyWide(left: frictionScale, right: newFriction.y)
      }
      frictionDelta = Vec2Wide {
        x: subtractWide(left: newFriction.x, right: constraint.frictionImpulse.x)
        y: subtractWide(left: newFriction.y, right: constraint.frictionImpulse.y)
      }
      constraint.frictionImpulse = newFriction
      let impulse: Vec3Wide = addVectorWide(
        left: scaleVectorWide(scale: frictionDelta.x, vector: tangent1)
        right: scaleVectorWide(scale: frictionDelta.y, vector: tangent2)
      )
      applyWideImpulse(
        bodyA: bodyA
        bodyB: bodyB
        constraint: constraint
        anchorA: rA
        anchorB: rB
        impulse: impulse
      )
      scatterBodies(states: states, indices: constraint.indexA, body: bodyA)
      scatterBodies(states: states, indices: constraint.indexB, body: bodyB)
    }
  }
}

# b3ApplyRestitution_Convex: Poisson kinetic restitution, which never adds
# energy.
func applyRestitutionWide(
  states: mod List(BodyState)
  constraints: mod List(ContactConstraintWide)
  first: view Int
  block: view SolverBlock
  inverseHValue: view Float
  threshold: view Float
  propagate: view Bool
) {
  let inverseH: FloatWide = splatWide(value: inverseHValue)
  let negRestitutionThreshold: FloatWide = splatWide(value: -threshold)
  let zero: FloatWide = zeroWide()
  loop var wideIndex: Int = block.startIndex, wideIndex < block.startIndex + block.count, ++wideIndex {
    if let constraint: mod ContactConstraintWide => constraints.modAt(index: first + wideIndex) {
      if propagate is false and allZeroWide(value: constraint.restitution) {
        continue
      }
      let pointCount: Int = widePointCount(constraint: constraint)
      var bodyA: BodyStateWide = gatherBodies(states: states, indices: constraint.indexA)
      var bodyB: BodyStateWide = gatherBodies(states: states, indices: constraint.indexB)
      let restitutionMask: Mask4 = greaterThanWide(left: constraint.restitution, right: zero)
      let dp: Vec3Wide = subtractVectorWide(left: bodyB.deltaPosition, right: bodyA.deltaPosition)
      let rotationA: Matrix3Wide = matrixFromQuatWide(quat: bodyA.deltaRotation)
      let rotationB: Matrix3Wide = matrixFromQuatWide(quat: bodyB.deltaRotation)
      loop var pointIndex: Int = 0, pointIndex < pointCount, ++pointIndex {
        if let constraintPoint: mod ContactConstraintPointWide => constraint.points.modAt(
          index: pointIndex
        ) {
          let rA: Vec3Wide = constraintPoint.anchorA
          let rB: Vec3Wide = constraintPoint.anchorB
          var normalMass: FloatWide = constraintPoint.normalMass
          if propagate is false {
            normalMass = blendWide(
              left: zero
              right: constraintPoint.normalMass
              mask: restitutionMask
            )
          }
          let compressionImpulse: FloatWide = subtractWide(
            left: constraintPoint.totalNormalImpulse
            right: constraintPoint.restitutionImpulse
          )
          let armed: Mask4 = andWide(
            left: andWide(
              left: restitutionMask
              right: lessThanWide(
                left: constraintPoint.relativeVelocity
                right: negRestitutionThreshold
              )
            )
            right: greaterThanWide(left: compressionImpulse, right: zero)
          )
          let rsA: Vec3Wide = multiplyMatrixWide(matrix: rotationA, vector: rA)
          let rsB: Vec3Wide = multiplyMatrixWide(matrix: rotationB, vector: rB)
          let ds: Vec3Wide = addVectorWide(
            left: dp
            right: subtractVectorWide(left: rsB, right: rsA)
          )
          let separation: FloatWide = addWide(
            left: dotWide(left: constraint.normal, right: ds)
            right: constraintPoint.baseSeparation
          )
          let specBias: FloatWide = maxWide(
            left: zero
            right: multiplyWide(left: separation, right: inverseH)
          )
          let velocityBias: FloatWide = blendWide(
            left: specBias
            right: multiplyWide(
              left: constraint.restitution
              right: constraintPoint.relativeVelocity
            )
            mask: armed
          )
          let vn: FloatWide = wideNormalVelocity(
            bodyA: bodyA
            bodyB: bodyB
            anchorA: rA
            anchorB: rB
            normal: constraint.normal
          )
          let negImpulse: FloatWide = multiplyWide(
            left: normalMass
            right: addWide(left: vn, right: velocityBias)
          )
          let newImpulse: FloatWide = maxWide(
            left: subtractWide(left: constraintPoint.normalImpulse, right: negImpulse)
            right: zero
          )
          var impulse: FloatWide = subtractWide(
            left: newImpulse
            right: constraintPoint.normalImpulse
          )
          let approachImpulse: FloatWide = minWide(
            left: maxWide(
              left: negateWide(value: multiplyWide(left: normalMass, right: vn))
              right: zero
            )
            right: maxWide(left: impulse, right: zero)
          )
          let allowance: FloatWide = subtractWide(
            left: multiplyWide(
              left: constraint.restitution
              right: addWide(left: compressionImpulse, right: approachImpulse)
            )
            right: constraintPoint.restitutionImpulse
          )
          let maxImpulse: FloatWide = addWide(
            left: approachImpulse
            right: maxWide(left: allowance, right: zero)
          )
          impulse = blendWide(
            left: impulse
            right: minWide(left: impulse, right: maxImpulse)
            mask: armed
          )
          constraintPoint.normalImpulse = addWide(
            left: constraintPoint.normalImpulse
            right: impulse
          )
          constraintPoint.restitutionImpulse = addWide(
            left: constraintPoint.restitutionImpulse
            right: subtractWide(left: impulse, right: approachImpulse)
          )
          constraintPoint.totalNormalImpulse = addWide(
            left: constraintPoint.totalNormalImpulse
            right: impulse
          )
          let push: Vec3Wide = scaleVectorWide(scale: impulse, vector: constraint.normal)
          applyWideImpulse(
            bodyA: bodyA
            bodyB: bodyB
            constraint: constraint
            anchorA: rA
            anchorB: rB
            impulse: push
          )
        }
      }
      scatterBodies(states: states, indices: constraint.indexA, body: bodyA)
      scatterBodies(states: states, indices: constraint.indexB, body: bodyB)
    }
  }
}
