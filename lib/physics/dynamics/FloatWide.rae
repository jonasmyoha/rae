# Four-lane floats for the contact solver (b3FloatW and its operations, the
# scalar path of Box3D's simd.h, and the wide vector, quaternion and matrix
# helpers of contact_solver.c, at 9f998c8). A wide float is a struct of four
# Floats; every operation works lane by lane in Box3D's scalar order, so the
# solver is bit-exact against the scalar oracle. Masks are 0/1 lane values
# as in Box3D's scalar path. A future Float4 SIMD type (docs/
# physics-performance-plan.md §2) replaces this module, not the solver.
import Math
open Vec3
open Quat

type FloatWide {
  x: Float
  y: Float
  z: Float
  w: Float
}

type Vec2Wide {
  x: FloatWide
  y: FloatWide
}

type Vec3Wide {
  x: FloatWide
  y: FloatWide
  z: FloatWide
}

type QuatWide {
  vector: Vec3Wide
  scalar: FloatWide
}

# Symmetric 2x2 and 3x3 matrices: the upper triangle
type SymMatrix2Wide {
  cxx: FloatWide
  cxy: FloatWide
  cyy: FloatWide
}

type SymMatrix3Wide {
  cxx: FloatWide
  cxy: FloatWide
  cxz: FloatWide
  cyy: FloatWide
  cyz: FloatWide
  czz: FloatWide
}

type Matrix3Wide {
  columnX: Vec3Wide
  columnY: Vec3Wide
  columnZ: Vec3Wide
}

func zeroWide() ret FloatWide {
  ret FloatWide { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
}

func splatWide(value: view Float) ret FloatWide {
  ret FloatWide { x: value, y: value, z: value, w: value }
}

func setWide(
  x: view Float
  y: view Float
  z: view Float
  w: view Float
) ret FloatWide {
  ret FloatWide { x: x, y: y, z: z, w: w }
}

# Lane `lane` (0-3)
func laneOf(value: view FloatWide, lane: view Int) ret Float {
  if lane is 0 {
    ret value.x
  } else if lane is 1 {
    ret value.y
  } else if lane is 2 {
    ret value.z
  }
  ret value.w
}

func negateWide(value: view FloatWide) ret FloatWide {
  ret FloatWide { x: -value.x, y: -value.y, z: -value.z, w: -value.w }
}

func absLane(value: view Float) ret Float {
  if value < 0.0 {
    ret -value
  }
  ret value
}

func absWide(value: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: absLane(value: value.x)
    y: absLane(value: value.y)
    z: absLane(value: value.z)
    w: absLane(value: value.w)
  }
}

func addWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: left.x + right.x
    y: left.y + right.y
    z: left.z + right.z
    w: left.w + right.w
  }
}

func subtractWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: left.x - right.x
    y: left.y - right.y
    z: left.z - right.z
    w: left.w - right.w
  }
}

func multiplyWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: left.x * right.x
    y: left.y * right.y
    z: left.z * right.z
    w: left.w * right.w
  }
}

func divideWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: left.x / right.x
    y: left.y / right.y
    z: left.z / right.z
    w: left.w / right.w
  }
}

func sqrtWide(value: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: Math.sqrt(x: value.x)
    y: Math.sqrt(x: value.y)
    z: Math.sqrt(x: value.z)
    w: Math.sqrt(x: value.w)
  }
}

# a + b * c (b3MulAddW)
func mulAddWide(base: view FloatWide, left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: base.x + left.x * right.x
    y: base.y + left.y * right.y
    z: base.z + left.z * right.z
    w: base.w + left.w * right.w
  }
}

func minLane(left: view Float, right: view Float) ret Float {
  if left <= right {
    ret left
  }
  ret right
}

func maxLane(left: view Float, right: view Float) ret Float {
  if left >= right {
    ret left
  }
  ret right
}

func minWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: minLane(left: left.x, right: right.x)
    y: minLane(left: left.y, right: right.y)
    z: minLane(left: left.z, right: right.z)
    w: minLane(left: left.w, right: right.w)
  }
}

func maxWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: maxLane(left: left.x, right: right.x)
    y: maxLane(left: left.y, right: right.y)
    z: maxLane(left: left.z, right: right.z)
    w: maxLane(left: left.w, right: right.w)
  }
}

func symClampLane(value: view Float, limit: view Float) ret Float {
  var result: Float = value
  if (value <= limit) is false {
    result = limit
  }
  if result <= -limit {
    result = -limit
  }
  ret result
}

# Clamp `value` to [-limit, limit] (b3SymClampW)
func symClampWide(value: view FloatWide, limit: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: symClampLane(value: value.x, limit: limit.x)
    y: symClampLane(value: value.y, limit: limit.y)
    z: symClampLane(value: value.z, limit: limit.z)
    w: symClampLane(value: value.w, limit: limit.w)
  }
}

func maskLane(condition: view Bool) ret Float {
  if condition {
    ret 1.0
  }
  ret 0.0
}

func andWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: maskLane(condition: left.x is not 0.0 and right.x is not 0.0)
    y: maskLane(condition: left.y is not 0.0 and right.y is not 0.0)
    z: maskLane(condition: left.z is not 0.0 and right.z is not 0.0)
    w: maskLane(condition: left.w is not 0.0 and right.w is not 0.0)
  }
}

func orWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: maskLane(condition: left.x is not 0.0 or right.x is not 0.0)
    y: maskLane(condition: left.y is not 0.0 or right.y is not 0.0)
    z: maskLane(condition: left.z is not 0.0 or right.z is not 0.0)
    w: maskLane(condition: left.w is not 0.0 or right.w is not 0.0)
  }
}

func greaterThanWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: maskLane(condition: left.x > right.x)
    y: maskLane(condition: left.y > right.y)
    z: maskLane(condition: left.z > right.z)
    w: maskLane(condition: left.w > right.w)
  }
}

func lessThanWide(left: view FloatWide, right: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: maskLane(condition: left.x < right.x)
    y: maskLane(condition: left.y < right.y)
    z: maskLane(condition: left.z < right.z)
    w: maskLane(condition: left.w < right.w)
  }
}

func allZeroWide(value: view FloatWide) ret Bool {
  ret value.x is 0.0 and value.y is 0.0 and value.z is 0.0 and value.w is 0.0
}

func anyTrueWide(mask: view FloatWide) ret Bool {
  ret mask.x is not 0.0 or mask.y is not 0.0 or mask.z is not 0.0 or mask.w is not 0.0
}

func blendLane(left: view Float, right: view Float, mask: view Float) ret Float {
  if mask is not 0.0 {
    ret right
  }
  ret left
}

# Lane-wise `mask ? right : left` (b3BlendW)
func blendWide(left: view FloatWide, right: view FloatWide, mask: view FloatWide) ret FloatWide {
  ret FloatWide {
    x: blendLane(left: left.x, right: right.x, mask: mask.x)
    y: blendLane(left: left.y, right: right.y, mask: mask.y)
    z: blendLane(left: left.z, right: right.z, mask: mask.z)
    w: blendLane(left: left.w, right: right.w, mask: mask.w)
  }
}

# b3SoftMaskW: lanes where either body is static (index 0)
func softMaskWide(indexA: view Array(Int, cap: 4), indexB: view Array(Int, cap: 4)) ret FloatWide {
  ret FloatWide {
    x: maskLane(
      condition: indexA.copyAtFallback(index: 0, fallback: 0) is 0 or indexB.copyAtFallback(
        index: 0
        fallback: 0
      ) is 0
    )
    y: maskLane(
      condition: indexA.copyAtFallback(index: 1, fallback: 0) is 0 or indexB.copyAtFallback(
        index: 1
        fallback: 0
      ) is 0
    )
    z: maskLane(
      condition: indexA.copyAtFallback(index: 2, fallback: 0) is 0 or indexB.copyAtFallback(
        index: 2
        fallback: 0
      ) is 0
    )
    w: maskLane(
      condition: indexA.copyAtFallback(index: 3, fallback: 0) is 0 or indexB.copyAtFallback(
        index: 3
        fallback: 0
      ) is 0
    )
  }
}

# --- Wide vectors ---
func zeroVectorWide() ret Vec3Wide {
  ret Vec3Wide { x: zeroWide(), y: zeroWide(), z: zeroWide() }
}

func splatVectorWide(vector: view Vec3) ret Vec3Wide {
  ret Vec3Wide {
    x: splatWide(value: vector.x)
    y: splatWide(value: vector.y)
    z: splatWide(value: vector.z)
  }
}

# s * a (b3MulSVW)
func scaleVectorWide(scale: view FloatWide, vector: view Vec3Wide) ret Vec3Wide {
  ret Vec3Wide {
    x: multiplyWide(left: scale, right: vector.x)
    y: multiplyWide(left: scale, right: vector.y)
    z: multiplyWide(left: scale, right: vector.z)
  }
}

# a - s * b (b3MulSubSVW)
func mulSubVectorWide(
  base: view Vec3Wide
  scale: view FloatWide
  vector: view Vec3Wide
) ret Vec3Wide {
  ret Vec3Wide {
    x: subtractWide(left: base.x, right: multiplyWide(left: scale, right: vector.x))
    y: subtractWide(left: base.y, right: multiplyWide(left: scale, right: vector.y))
    z: subtractWide(left: base.z, right: multiplyWide(left: scale, right: vector.z))
  }
}

# a + s * b (b3MulAddSVW)
func mulAddVectorWide(
  base: view Vec3Wide
  scale: view FloatWide
  vector: view Vec3Wide
) ret Vec3Wide {
  ret Vec3Wide {
    x: addWide(left: base.x, right: multiplyWide(left: scale, right: vector.x))
    y: addWide(left: base.y, right: multiplyWide(left: scale, right: vector.y))
    z: addWide(left: base.z, right: multiplyWide(left: scale, right: vector.z))
  }
}

func subtractVectorWide(left: view Vec3Wide, right: view Vec3Wide) ret Vec3Wide {
  ret Vec3Wide {
    x: subtractWide(left: left.x, right: right.x)
    y: subtractWide(left: left.y, right: right.y)
    z: subtractWide(left: left.z, right: right.z)
  }
}

func addVectorWide(left: view Vec3Wide, right: view Vec3Wide) ret Vec3Wide {
  ret Vec3Wide {
    x: addWide(left: left.x, right: right.x)
    y: addWide(left: left.y, right: right.y)
    z: addWide(left: left.z, right: right.z)
  }
}

func dotWide(left: view Vec3Wide, right: view Vec3Wide) ret FloatWide {
  ret addWide(
    left: addWide(
      left: multiplyWide(left: left.x, right: right.x)
      right: multiplyWide(left: left.y, right: right.y)
    )
    right: multiplyWide(left: left.z, right: right.z)
  )
}

func crossWide(left: view Vec3Wide, right: view Vec3Wide) ret Vec3Wide {
  ret Vec3Wide {
    x: subtractWide(
      left: multiplyWide(left: left.y, right: right.z)
      right: multiplyWide(left: left.z, right: right.y)
    )
    y: subtractWide(
      left: multiplyWide(left: left.z, right: right.x)
      right: multiplyWide(left: left.x, right: right.z)
    )
    z: subtractWide(
      left: multiplyWide(left: left.x, right: right.y)
      right: multiplyWide(left: left.y, right: right.x)
    )
  }
}

# a + b (b3AddV2W)
func addVector2Wide(left: view Vec2Wide, right: view Vec2Wide) ret Vec2Wide {
  ret Vec2Wide {
    x: addWide(left: left.x, right: right.x)
    y: addWide(left: left.y, right: right.y)
  }
}

# m * a (b3MulMV2W)
func multiplySym2Wide(matrix: view SymMatrix2Wide, vector: view Vec2Wide) ret Vec2Wide {
  ret Vec2Wide {
    x: addWide(
      left: multiplyWide(left: matrix.cxx, right: vector.x)
      right: multiplyWide(left: matrix.cxy, right: vector.y)
    )
    y: addWide(
      left: multiplyWide(left: matrix.cxy, right: vector.x)
      right: multiplyWide(left: matrix.cyy, right: vector.y)
    )
  }
}

# m * a (b3MulMVW)
func multiplySym3Wide(matrix: view SymMatrix3Wide, vector: view Vec3Wide) ret Vec3Wide {
  ret Vec3Wide {
    x: addWide(
      left: multiplyWide(left: matrix.cxx, right: vector.x)
      right: addWide(
        left: multiplyWide(left: matrix.cxy, right: vector.y)
        right: multiplyWide(left: matrix.cxz, right: vector.z)
      )
    )
    y: addWide(
      left: multiplyWide(left: matrix.cxy, right: vector.x)
      right: addWide(
        left: multiplyWide(left: matrix.cyy, right: vector.y)
        right: multiplyWide(left: matrix.cyz, right: vector.z)
      )
    )
    z: addWide(
      left: multiplyWide(left: matrix.cxz, right: vector.x)
      right: addWide(
        left: multiplyWide(left: matrix.cyz, right: vector.y)
        right: multiplyWide(left: matrix.czz, right: vector.z)
      )
    )
  }
}

# a - m * b (b3MulSubMVW)
func mulSubSym3Wide(
  base: view Vec3Wide
  matrix: view SymMatrix3Wide
  vector: view Vec3Wide
) ret Vec3Wide {
  let product: Vec3Wide = multiplySym3Wide(matrix: matrix, vector: vector)
  ret subtractVectorWide(left: base, right: product)
}

# a + m * b (b3MulAddMVW)
func mulAddSym3Wide(
  base: view Vec3Wide
  matrix: view SymMatrix3Wide
  vector: view Vec3Wide
) ret Vec3Wide {
  let product: Vec3Wide = multiplySym3Wide(matrix: matrix, vector: vector)
  ret addVectorWide(left: base, right: product)
}

# b3AddSymW
func addSym3Wide(left: view SymMatrix3Wide, right: view SymMatrix3Wide) ret SymMatrix3Wide {
  ret SymMatrix3Wide {
    cxx: addWide(left: left.cxx, right: right.cxx)
    cxy: addWide(left: left.cxy, right: right.cxy)
    cxz: addWide(left: left.cxz, right: right.cxz)
    cyy: addWide(left: left.cyy, right: right.cyy)
    cyz: addWide(left: left.cyz, right: right.cyz)
    czz: addWide(left: left.czz, right: right.czz)
  }
}

func zeroSym3Wide() ret SymMatrix3Wide {
  ret SymMatrix3Wide {
    cxx: zeroWide()
    cxy: zeroWide()
    cxz: zeroWide()
    cyy: zeroWide()
    cyz: zeroWide()
    czz: zeroWide()
  }
}

# b3InvertSymW: zero where the determinant is (nearly) zero
func invertSym3Wide(matrix: view SymMatrix3Wide, minDeterminant: view Float) ret SymMatrix3Wide {
  let cxx: FloatWide = subtractWide(
    left: multiplyWide(left: matrix.cyy, right: matrix.czz)
    right: multiplyWide(left: matrix.cyz, right: matrix.cyz)
  )
  let cxy: FloatWide = subtractWide(
    left: multiplyWide(left: matrix.cxz, right: matrix.cyz)
    right: multiplyWide(left: matrix.cxy, right: matrix.czz)
  )
  let cxz: FloatWide = subtractWide(
    left: multiplyWide(left: matrix.cxy, right: matrix.cyz)
    right: multiplyWide(left: matrix.cxz, right: matrix.cyy)
  )
  let cyy: FloatWide = subtractWide(
    left: multiplyWide(left: matrix.cxx, right: matrix.czz)
    right: multiplyWide(left: matrix.cxz, right: matrix.cxz)
  )
  let cyz: FloatWide = subtractWide(
    left: multiplyWide(left: matrix.cxy, right: matrix.cxz)
    right: multiplyWide(left: matrix.cxx, right: matrix.cyz)
  )
  let czz: FloatWide = subtractWide(
    left: multiplyWide(left: matrix.cxx, right: matrix.cyy)
    right: multiplyWide(left: matrix.cxy, right: matrix.cxy)
  )
  let determinant: FloatWide = addWide(
    left: multiplyWide(left: matrix.cxx, right: cxx)
    right: addWide(
      left: multiplyWide(left: matrix.cxy, right: cxy)
      right: multiplyWide(left: matrix.cxz, right: cxz)
    )
  )
  let valid: FloatWide = greaterThanWide(
    left: absWide(value: determinant)
    right: splatWide(value: minDeterminant)
  )
  let inverseDeterminant: FloatWide = blendWide(
    left: zeroWide()
    right: divideWide(left: splatWide(value: 1.0), right: determinant)
    mask: valid
  )
  ret SymMatrix3Wide {
    cxx: multiplyWide(left: inverseDeterminant, right: cxx)
    cxy: multiplyWide(left: inverseDeterminant, right: cxy)
    cxz: multiplyWide(left: inverseDeterminant, right: cxz)
    cyy: multiplyWide(left: inverseDeterminant, right: cyy)
    cyz: multiplyWide(left: inverseDeterminant, right: cyz)
    czz: multiplyWide(left: inverseDeterminant, right: czz)
  }
}

# b3PerpW: a unit vector perpendicular to `vector`
func perpWide(vector: view Vec3Wide, minLengthSquared: view Float) ret Vec3Wide {
  let zero: FloatWide = zeroWide()
  let half: FloatWide = splatWide(value: 0.5)
  let mask: FloatWide = orWide(
    left: lessThanWide(left: vector.x, right: negateWide(value: half))
    right: greaterThanWide(left: vector.x, right: half)
  )
  let perpendicular: Vec3Wide = {
    x: blendWide(left: zero, right: vector.y, mask: mask)
    y: blendWide(left: vector.z, right: negateWide(value: vector.x), mask: mask)
    z: blendWide(left: negateWide(value: vector.y), right: zero, mask: mask)
  }
  let lengthSquared: FloatWide = dotWide(left: perpendicular, right: perpendicular)
  let valid: FloatWide = greaterThanWide(
    left: lengthSquared
    right: splatWide(value: minLengthSquared)
  )
  let inverseLength: FloatWide = blendWide(
    left: zero
    right: divideWide(left: splatWide(value: 1.0), right: sqrtWide(value: lengthSquared))
    mask: valid
  )
  ret scaleVectorWide(scale: inverseLength, vector: perpendicular)
}

# b3MakeMatrixFromQuatW
func matrixFromQuatWide(quat: view QuatWide) ret Matrix3Wide {
  let x2: FloatWide = addWide(left: quat.vector.x, right: quat.vector.x)
  let y2: FloatWide = addWide(left: quat.vector.y, right: quat.vector.y)
  let z2: FloatWide = addWide(left: quat.vector.z, right: quat.vector.z)
  let xx2: FloatWide = multiplyWide(left: quat.vector.x, right: x2)
  let yy2: FloatWide = multiplyWide(left: quat.vector.y, right: y2)
  let zz2: FloatWide = multiplyWide(left: quat.vector.z, right: z2)
  let xy2: FloatWide = multiplyWide(left: quat.vector.x, right: y2)
  let xz2: FloatWide = multiplyWide(left: quat.vector.x, right: z2)
  let yz2: FloatWide = multiplyWide(left: quat.vector.y, right: z2)
  let xw2: FloatWide = multiplyWide(left: quat.scalar, right: x2)
  let yw2: FloatWide = multiplyWide(left: quat.scalar, right: y2)
  let zw2: FloatWide = multiplyWide(left: quat.scalar, right: z2)
  let one: FloatWide = splatWide(value: 1.0)
  ret Matrix3Wide {
    columnX: Vec3Wide {
      x: subtractWide(left: one, right: addWide(left: yy2, right: zz2))
      y: addWide(left: xy2, right: zw2)
      z: subtractWide(left: xz2, right: yw2)
    }
    columnY: Vec3Wide {
      x: subtractWide(left: xy2, right: zw2)
      y: subtractWide(left: one, right: addWide(left: xx2, right: zz2))
      z: addWide(left: yz2, right: xw2)
    }
    columnZ: Vec3Wide {
      x: addWide(left: xz2, right: yw2)
      y: subtractWide(left: yz2, right: xw2)
      z: subtractWide(left: one, right: addWide(left: xx2, right: yy2))
    }
  }
}

# b3MulM3VW
func multiplyMatrixWide(matrix: view Matrix3Wide, vector: view Vec3Wide) ret Vec3Wide {
  ret Vec3Wide {
    x: addWide(
      left: multiplyWide(left: matrix.columnX.x, right: vector.x)
      right: addWide(
        left: multiplyWide(left: matrix.columnY.x, right: vector.y)
        right: multiplyWide(left: matrix.columnZ.x, right: vector.z)
      )
    )
    y: addWide(
      left: multiplyWide(left: matrix.columnX.y, right: vector.x)
      right: addWide(
        left: multiplyWide(left: matrix.columnY.y, right: vector.y)
        right: multiplyWide(left: matrix.columnZ.y, right: vector.z)
      )
    )
    z: addWide(
      left: multiplyWide(left: matrix.columnX.z, right: vector.x)
      right: addWide(
        left: multiplyWide(left: matrix.columnY.z, right: vector.y)
        right: multiplyWide(left: matrix.columnZ.z, right: vector.z)
      )
    )
  }
}

# b3InvRotateVectorW
func inverseRotateVectorWide(quat: view QuatWide, vector: view Vec3Wide) ret Vec3Wide {
  let once: Vec3Wide = crossWide(left: quat.vector, right: vector)
  let twice: Vec3Wide = {
    x: addWide(left: once.x, right: once.x)
    y: addWide(left: once.y, right: once.y)
    z: addWide(left: once.z, right: once.z)
  }
  let crossed: Vec3Wide = crossWide(left: quat.vector, right: twice)
  ret Vec3Wide {
    x: addWide(
      left: subtractWide(left: vector.x, right: multiplyWide(left: quat.scalar, right: twice.x))
      right: crossed.x
    )
    y: addWide(
      left: subtractWide(left: vector.y, right: multiplyWide(left: quat.scalar, right: twice.y))
      right: crossed.y
    )
    z: addWide(
      left: subtractWide(left: vector.z, right: multiplyWide(left: quat.scalar, right: twice.z))
      right: crossed.z
    )
  }
}
