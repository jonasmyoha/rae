# Continuous collision of fast bodies (b3ContinuousQueryCallback and
# b3SolveContinuous of Box3D's solver.c, b3MakeShapeProxy and the convex
# path of b3ShapeTimeOfImpact of shape.c, b3MakeRelativeSweep of body.h, at
# 9f998c8): a fast body is swept against the static tree (a bullet also
# against the kinematic and dynamic trees) and moved back to its first time
# of impact. Box3D's query callback becomes an explicit query loop. Sensor
# hits (P4d) are here; mesh, height-field and compound targets sweep triangle
# by triangle (TriangleTimeOfImpact). The pre-solve callback and custom
# filter (P8) are not here yet.
open Vec3
open Quat
open physics/Constants
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/QuatMath
open physics/math/TransformMath
open physics/math/AabbMath
open physics/geometry/QueryTypes
open physics/geometry/Hull
open physics/collision/ShapeCast
open physics/collision/TimeOfImpact
open physics/collision/ShapePair
open physics/broadPhase/DynamicTree
open physics/broadPhase/DynamicTreeQuery
open physics/broadPhase/DynamicTreeRebuild
open physics/broadPhase/BroadPhase
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/Shape
open physics/dynamics/TriangleTimeOfImpact
open physics/geometry/Compound
open physics/dynamics/SolverSet
open physics/dynamics/World
open physics/dynamics/WorldBodies
open physics/dynamics/Events

# b3MakeRelativeSweep: a body's sweep over the step relative to `base`.
func makeRelativeSweep(sim: view BodySim, base: view Vec3) ret Sweep {
  ret Sweep {
    localCenter: sim.localCenter
    center1: subtractPositions(left: sim.center0, right: base)
    center2: subtractPositions(left: sim.center, right: base)
    rotation1: sim.rotation0
    rotation2: sim.transform.rotation
  }
}

# b3ShapeTimeOfImpact: shape B (convex, the fast one) against shape A,
# whose mesh, height-field and compound cases sweep triangle by triangle
# (TriangleTimeOfImpact).
func shapeTimeOfImpact(
  world: view PhysicsWorld
  shapeA: view PhysicsShape
  shapeB: view PhysicsShape
  sweepA: view Sweep
  sweepB: view Sweep
  maxFraction: view Float
  proxyPoints: mod ProxyPoints
) ret ToiOutput {
  let lengthUnitsPerMeter: Float = world.lengthUnitsPerMeter
  if shapeA.shapeType is ShapeType.compound {
    if let compound: view CompoundData => world.compounds.viewAt(index: shapeA.compoundIndex) {
      ret compoundTimeOfImpact(
        shapeA: shapeA
        compound: compound
        shapeB: shapeB
        hulls: world.hulls
        meshes: world.meshes
        heightFields: world.heightFields
        sweepA: sweepA
        sweepB: sweepB
        maxFraction: maxFraction
        lengthUnitsPerMeter: lengthUnitsPerMeter
      )
    }
  }
  if shapeA.shapeType is ShapeType.height or shapeA.shapeType is ShapeType.mesh {
    ret meshTimeOfImpact(
      shapeA: shapeA
      shapeB: shapeB
      hulls: world.hulls
      meshes: world.meshes
      heightFields: world.heightFields
      sweepA: sweepA
      sweepB: sweepB
      maxFraction: maxFraction
      lengthUnitsPerMeter: lengthUnitsPerMeter
    )
  }
  # The proxies' points go in the lent lists, moved into the query and back
  let radiusA: Float = shapeProxyPoints(
    shape: shapeA
    hulls: world.hulls
    points: proxyPoints.pointsA
  )
  let radiusB: Float = shapeProxyPoints(
    shape: shapeB
    hulls: world.hulls
    points: proxyPoints.pointsB
  )
  var input: ToiInput = {
    proxyA: ShapeProxy { points: own proxyPoints.pointsA, radius: radiusA }
    proxyB: ShapeProxy { points: own proxyPoints.pointsB, radius: radiusB }
    sweepA: sweepA
    sweepB: sweepB
    maxFraction: maxFraction
  }
  let output: ToiOutput = timeOfImpact(input: input, lengthUnitsPerMeter: lengthUnitsPerMeter)
  proxyPoints.pointsA = own input.proxyA.points
  proxyPoints.pointsB = own input.proxyB.points
  ret output
}

# B2_MAX_CONTINUOUS_SENSOR_HITS
const maxContinuousSensorHits: Int = 8

# The sensors a fast body's sweep crossed, with their impact fractions
type ContinuousHits {
  hits: List(SensorHit)
  fractions: List(Float)
}

# The point lists of a time-of-impact query's two proxies, lent by the
# world and reused (Box3D's proxies are fixed arrays).
type ProxyPoints {
  pointsA: List(Vec3)
  pointsB: List(Vec3)
}

# b3ContinuousQueryCallback for one candidate shape: the earlier impact
# fraction, if `shapeId` is hit sooner than `fraction`.
func continuousCandidate(
  world: view PhysicsWorld
  fastShape: view PhysicsShape
  fastSim: view BodySim
  shapeId: view Int
  sweep: view Sweep
  base: view Vec3
  fraction: view Float
  sensorHits: mod ContinuousHits
  proxyPoints: mod ProxyPoints
) ret Float {
  # Skip the same shape and the same body
  if shapeId is fastShape.id {
    ret fraction
  }
  let shape: PhysicsShape = world.shapes.copyAtDefault(index: shapeId)
  if shape.bodyId is fastShape.bodyId {
    ret fraction
  }
  # Skip sensors unless both shapes want sensor events
  let isSensor: Bool = shape.sensorIndex is not -1
  if isSensor and ((shape.flags bitand enableSensorEventsFlag) is 0 or (fastShape.flags bitand enableSensorEventsFlag) is 0) {
    ret fraction
  }
  # Skip filtered shapes
  if shouldShapesCollide(filterA: fastShape.filter, filterB: shape.filter) is false {
    ret fraction
  }
  let body: Body = bodyAt(world: world, bodyId: shape.bodyId)
  let bodySim: BodySim = bodySimOf(world: world, body: body)
  # Skip bullets
  if (body.flags bitand isBulletFlag) is not 0 {
    ret fraction
  }
  # Skip filtered bodies
  let fastBody: Body = bodyAt(world: world, bodyId: fastSim.bodyId)
  if shouldBodiesCollide(world: world, bodyA: fastBody, bodyB: body) is false {
    ret fraction
  }
  let sweepA: Sweep = makeRelativeSweep(sim: bodySim, base: base)
  # Time of impact versus the shape (every shape type)
  let output: ToiOutput = shapeTimeOfImpact(
    world: world
    shapeA: shape
    shapeB: fastShape
    sweepA: sweepA
    sweepB: sweep
    maxFraction: fraction
    proxyPoints: proxyPoints
  )
  if isSensor {
    # Only a sensor hit sooner than the current solid hit counts
    if output.fraction <= fraction and sensorHits.hits.length < maxContinuousSensorHits {
      sensorHits.hits.add(value: SensorHit { sensorId: shape.id, visitorId: fastShape.id })
      sensorHits.fractions.add(value: output.fraction)
    }
    ret fraction
  }
  if 0.0 < output.fraction and output.fraction < fraction {
    ret output.fraction
  }
  ret fraction
}

# Query tree `treeIndex` for continuous collision candidates.
func queryContinuous(
  world: view PhysicsWorld
  treeIndex: view Int
  box: view Aabb
  fastShape: view PhysicsShape
  fastSim: view BodySim
  sweep: view Sweep
  base: view Vec3
  fraction: view Float
  sensorHits: mod ContinuousHits
  queryStack: mod List(Int)
  proxyPoints: mod ProxyPoints
) ret Float {
  var result: Float = fraction
  if let tree: view DynamicTree => world.broadPhase.trees.viewAt(index: treeIndex) {
    # The caller's stack, lent to the query and taken back below
    var query: TreeQuery = beginTreeQueryWith(
      tree: tree
      box: box
      maskBits: allBits
      requireAllBits: false
      stack: own queryStack
    )
    var proxyId: Int = nextTreeQueryProxy(tree: tree, query: query)
    loop proxyId is not -1 {
      let shapeId: Int = shapeIndexOf(userData: treeUserData(tree: tree, proxyId: proxyId))
      result = continuousCandidate(
        world: world
        fastShape: fastShape
        fastSim: fastSim
        shapeId: shapeId
        sweep: sweep
        base: base
        fraction: result
        sensorHits: sensorHits
        proxyPoints: proxyPoints
      )
      proxyId = nextTreeQueryProxy(tree: tree, query: query)
    }
    queryStack = own query.stack
  }
  ret result
}

# Mark a shape's proxy moved with its new fat box (b3BroadPhase_MarkProxyMoved).
func markShapeProxyMoved(world: mod PhysicsWorld, proxyKey: view Int, box: view Aabb) {
  if let tree: mod DynamicTree => world.broadPhase.trees.modAt(index: proxyType(proxyKey: proxyKey)) {
    markProxyMoved(tree: tree, proxyId: proxyId(proxyKey: proxyKey), box: box)
  }
}

# Record a moved proxy in chunk `chunk`'s list; applyMovedProxies marks it
# after the parallel section. (Box3D marks the tree from the workers with
# atomics. Deferring gives the same tree: a mark only sets the leaf's box
# and moved flags, and nothing in finalization or continuous collision
# queries the trees it marks - non-bullets sweep against the static tree.)
func deferProxyMoved(
  world: mod PhysicsWorld
  chunk: view Int
  proxyKey: view Int
  box: view Aabb
) {
  if let taskContext: mod TaskContext => world.taskContexts.modAt(index: chunk) {
    taskContext.movedProxies.add(value: MovedProxy { proxyKey: proxyKey, box: box })
  }
}

# Mark every chunk's moved proxies, in chunk order, and clear the lists.
func applyMovedProxies(world: mod PhysicsWorld) {
  loop var chunk: Int = 0, chunk < world.taskContexts.length, ++chunk {
    var moved: List(MovedProxy) = List.create(MovedProxy, cap: 0)
    if let taskContext: mod TaskContext => world.taskContexts.modAt(index: chunk) {
      moved = own taskContext.movedProxies
    }
    loop var i: Int = 0, i < moved.length, ++i {
      if let proxy: view MovedProxy => moved.viewAt(index: i) {
        markShapeProxyMoved(world: world, proxyKey: proxy.proxyKey, box: proxy.box)
      }
    }
    moved.clear()
    if let taskContext: mod TaskContext => world.taskContexts.modAt(index: chunk) {
      taskContext.movedProxies = own moved
    }
  }
}

# The fat box of shape `shapeId` after `box` moved; a non-bullet marks its
# proxy moved, a bullet asks for its bounds to be enlarged later. Returns
# whether the bullet bounds need enlarging.
func refreshFatBox(
  world: mod PhysicsWorld
  chunk: view Int
  shapeId: view Int
  box: view Aabb
  isBullet: view Bool
) ret Bool {
  let fatBox: Aabb = world.fatAabbs.copyAtDefault(index: shapeId)
  if contains(outer: fatBox, inner: box) {
    ret false
  }
  let shape: PhysicsShape = world.shapes.copyAtDefault(index: shapeId)
  let inflated: Aabb = inflate(box: box, extension: shape.aabbMargin)
  world.fatAabbs.set(index: shapeId, value: inflated)
  # Regular bodies mark the hierarchy moved; bullets are handled later
  if isBullet {
    ret true
  }
  deferProxyMoved(
    world: world
    chunk: chunk
    proxyKey: shape.proxyKey
    box: inflated
  )
  ret false
}

# b3SolveContinuous: continuous collision of awake sim `simIndex` against
# static shapes (a bullet also against kinematic and dynamic ones).
# Its working lists and results are chunk `chunk`'s TaskContext's.
func solveContinuous(
  world: mod PhysicsWorld
  simIndex: view Int
  dt: view Float
  chunk: view Int
) {
  var fastSim: BodySim = setBodySimAt(world: world, setIndex: awakeSet, localIndex: simIndex)
  # Re-center the sweep on the fast body (float precision far from the origin)
  let base: Vec3 = fastSim.center0
  let sweep: Sweep = makeRelativeSweep(sim: fastSim, base: base)
  let xf2: Transform = {
    position: subtract(
      left: sweep.center2
      right: rotateVector(quat: sweep.rotation2, vector: sweep.localCenter)
    )
    rotation: sweep.rotation2
  }
  let fastBody: Body = bodyAt(world: world, bodyId: fastSim.bodyId)
  var fraction: Float = 1.0
  # The chunk's working lists, moved out for the sweep and back at the end
  var sensorHits: ContinuousHits = {
    hits: List.create(SensorHit, cap: 0)
    fractions: List.create(Float, cap: 0)
  }
  var queryStack: List(Int) = List.create(Int, cap: 0)
  var proxyPoints: ProxyPoints = {
    pointsA: List.create(Vec3, cap: 0)
    pointsB: List.create(Vec3, cap: 0)
  }
  if let taskContext: mod TaskContext => world.taskContexts.modAt(index: chunk) {
    sensorHits.hits = own taskContext.continuousHits
    sensorHits.fractions = own taskContext.continuousFractions
    queryStack = own taskContext.continuousQueryStack
    proxyPoints.pointsA = own taskContext.toiPointsA
    proxyPoints.pointsB = own taskContext.toiPointsB
  }
  sensorHits.hits.clear()
  sensorHits.fractions.clear()
  let isBullet: Bool = (fastSim.flags bitand isBulletFlag) is not 0

  var shapeId: Int = fastBody.headShapeId
  loop shapeId is not -1 {
    var fastShape: PhysicsShape = world.shapes.copyAtDefault(index: shapeId)
    let nextShapeId: Int = fastShape.nextShapeId
    let box1: Aabb = fastShape.aabb
    # xf2 is relative to the base, so translate the box back to world space
    let box2: Aabb = offsetAabb(
      localBox: computeShapeAabb(shape: fastShape, hulls: world.hulls, transform: xf2)
      origin: base
    )
    # Stored to avoid computing it again when there is no impact
    if let stored: mod PhysicsShape => world.shapes.modAt(index: shapeId) {
      stored.aabb = box2
    }
    fastShape.aabb = box2
    # No continuous collision for meshes or sensors
    let skip: Bool = fastShape.shapeType is ShapeType.mesh or fastShape.shapeType is ShapeType.height or fastShape.sensorIndex is not -1
    if skip is false {
      let sweptBox: Aabb = union(first: box1, second: box2)
      fraction = queryContinuous(
        world: world
        treeIndex: 0
        box: sweptBox
        fastShape: fastShape
        fastSim: fastSim
        sweep: sweep
        base: base
        fraction: fraction
        sensorHits: sensorHits
        queryStack: queryStack
        proxyPoints: proxyPoints
      )
      if isBullet {
        fraction = queryContinuous(
          world: world
          treeIndex: 1
          box: sweptBox
          fastShape: fastShape
          fastSim: fastSim
          sweep: sweep
          base: base
          fraction: fraction
          sensorHits: sensorHits
          queryStack: queryStack
          proxyPoints: proxyPoints
        )
        fraction = queryContinuous(
          world: world
          treeIndex: 2
          box: sweptBox
          fastShape: fastShape
          fastSim: fastSim
          sweep: sweep
          base: base
          fraction: fraction
          sensorHits: sensorHits
          queryStack: queryStack
          proxyPoints: proxyPoints
        )
      }
    }
    shapeId = nextShapeId
  }

  let speculative: Float = speculativeDistance(lengthUnitsPerMeter: world.lengthUnitsPerMeter)
  var enlargeBullet: Bool = false
  if fraction < 1.0 {
    # The time of impact: back to world space by re-adding the base
    let q: Quat = nlerp(from: sweep.rotation1, to: sweep.rotation2, alpha: fraction)
    let c: Vec3 = lerp(from: sweep.center1, to: sweep.center2, alpha: fraction)
    let origin: Vec3 = subtract(left: c, right: rotateVector(quat: q, vector: sweep.localCenter))
    let transform: Transform = {
      position: offsetPosition(position: base, delta: origin)
      rotation: q
    }
    let center: Vec3 = offsetPosition(position: base, delta: c)
    fastSim.transform = transform
    fastSim.center = center
    fastSim.rotation0 = q
    fastSim.center0 = center
    fastSim.flags = fastSim.flags bitor hadTimeOfImpactFlag

    # The lost time loses gravity (other forces and torques are ignored)
    if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
      if let state: mod BodyState => awake.bodyStates.modAt(index: simIndex) {
        let v: Vec3 = state.linearVelocity
        let timeLoss: Float = (1.0 - fraction) * dt
        var dv: Vec3 = scale(scale: -timeLoss * fastSim.gravityScale, vector: world.gravity)
        if (state.flags bitand lockLinearX) is not 0 {
          dv.x = 0.0
        }
        if (state.flags bitand lockLinearY) is not 0 {
          dv.y = 0.0
        }
        if (state.flags bitand lockLinearZ) is not 0 {
          dv.z = 0.0
        }
        state.linearVelocity = add(left: v, right: dv)
      }
    }
    # The move event was written before the impact
    if let event: mod BodyMoveEvent => world.bodyMoveEvents.modAt(index: simIndex) {
      event.transform = transform
    }

    # The shapes' boxes at the interpolated transform
    var nextId: Int = fastBody.headShapeId
    loop nextId is not -1 {
      let shape: PhysicsShape = world.shapes.copyAtDefault(index: nextId)
      let box: Aabb = computeFatShapeAabb(
        shape: shape
        hulls: world.hulls
        transform: transform
        extra: speculative
      )
      if let stored: mod PhysicsShape => world.shapes.modAt(index: nextId) {
        stored.aabb = box
      }
      enlargeBullet = refreshFatBox(
        world: world
        chunk: chunk
        shapeId: nextId
        box: box
        isBullet: isBullet
      ) or enlargeBullet
      nextId = shape.nextShapeId
    }
  } else {
    # No time of impact: advance the body
    fastSim.rotation0 = fastSim.transform.rotation
    fastSim.center0 = fastSim.center
    var nextId: Int = fastBody.headShapeId
    loop nextId is not -1 {
      let shape: PhysicsShape = world.shapes.copyAtDefault(index: nextId)
      # The shape's box is still valid from above
      enlargeBullet = refreshFatBox(
        world: world
        chunk: chunk
        shapeId: nextId
        box: shape.aabb
        isBullet: isBullet
      ) or enlargeBullet
      nextId = shape.nextShapeId
    }
  }
  if enlargeBullet {
    fastSim.flags = fastSim.flags bitor enlargeBulletBoundsFlag
  }
  # The sensor hits before the solid hit, for serial processing
  loop var i: Int = 0, i < sensorHits.hits.length, ++i {
    if sensorHits.fractions.copyAtDefault(index: i) < fraction {
      if let taskContext: mod TaskContext => world.taskContexts.modAt(index: chunk) {
        taskContext.sensorHits.add(value: sensorHits.hits.copyAtDefault(index: i))
      }
    }
  }
  if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    awake.bodySims.set(index: simIndex, value: fastSim)
  }
  if let taskContext: mod TaskContext => world.taskContexts.modAt(index: chunk) {
    taskContext.continuousHits = own sensorHits.hits
    taskContext.continuousFractions = own sensorHits.fractions
    taskContext.continuousQueryStack = own queryStack
    taskContext.toiPointsA = own proxyPoints.pointsA
    taskContext.toiPointsB = own proxyPoints.pointsB
  }
}
