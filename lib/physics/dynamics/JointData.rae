type WeldJointData {
  linearHertz: Float
  linearDampingRatio: Float
  angularHertz: Float
  angularDampingRatio: Float
  linearSpring: Softness
  angularSpring: Softness
  linearImpulse: Vec3
  angularImpulse: Vec3
  indexA: Int
  indexB: Int
  frameA: Transform
  frameB: Transform
