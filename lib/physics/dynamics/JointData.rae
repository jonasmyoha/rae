func zeroParallelJointData() ret ParallelJointData {
  ret ParallelJointData {
    hertz: 0.0
    dampingRatio: 0.0
    maxTorque: 0.0
    perpImpulse: Vec2 { x: 0.0, y: 0.0 }
    perpAxisX: zeroVector()
    perpAxisY: zeroVector()
    quatA: Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    quatB: Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    indexA: 0
    indexB: 0
    softness: zeroSoftnessValue()
  }
}

