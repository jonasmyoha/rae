# b3SphericalJoint. The body indices are Int32 as Box3D's ints are, so the
# record is 260 bytes like C's: at 272 the joint grid's solve pass (about
# 10 MB of joints and body states) no longer fit the 12 MB L2 reliably and ran
# 1.1-2 ms per step slower depending on which pages the heap handed out.
type SphericalJointData {
  linearImpulse: Vec3
  springImpulse: Vec3
  motorImpulse: Vec3
  lowerTwistImpulse: Float
  upperTwistImpulse: Float
  swingImpulse: Float
  hertz: Float
  dampingRatio: Float
  maxMotorTorque: Float
  motorVelocity: Vec3
  lowerTwistAngle: Float
  upperTwistAngle: Float
  coneAngle: Float
  targetRotation: Quat
  indexA: Int32
  indexB: Int32
  frameA: Transform
  frameB: Transform
  deltaCenter: Vec3
  swingAxis: Vec3
  twistJacobian: Vec3
  rotationMass: Matrix3
  swingMass: Float
  twistMass: Float
  springSoftness: Softness
  enableSpring: Bool
  enableMotor: Bool
  enableConeLimit: Bool
  enableTwistLimit: Bool
}

# `(b3SphericalJoint){ 0 }`
func zeroSphericalJointData() ret SphericalJointData {
  ret SphericalJointData {
    linearImpulse: zeroVector()
    springImpulse: zeroVector()
    motorImpulse: zeroVector()
    lowerTwistImpulse: 0.0
    upperTwistImpulse: 0.0
    swingImpulse: 0.0
    hertz: 0.0
    dampingRatio: 0.0
    maxMotorTorque: 0.0
    motorVelocity: zeroVector()
    lowerTwistAngle: 0.0
    upperTwistAngle: 0.0
    coneAngle: 0.0
    targetRotation: Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 }
    indexA: 0
    indexB: 0
    frameA: zeroTransform()
    frameB: zeroTransform()
    deltaCenter: zeroVector()
    swingAxis: zeroVector()
    twistJacobian: zeroVector()
    rotationMass: matrixZero()
    swingMass: 0.0
    twistMass: 0.0
    springSoftness: zeroSoftnessValue()
    enableSpring: false
    enableMotor: false
    enableConeLimit: false
    enableTwistLimit: false
  }
}

