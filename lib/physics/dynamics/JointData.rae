  angularMass: Matrix3
}

# `(b3WeldJoint){ 0 }`
func zeroWeldJointData() ret WeldJointData {
  ret WeldJointData {
    linearHertz: 0.0
    linearDampingRatio: 0.0
    angularHertz: 0.0
    angularDampingRatio: 0.0
    linearSpring: zeroSoftnessValue()
    angularSpring: zeroSoftnessValue()
    linearImpulse: zeroVector()
    angularImpulse: zeroVector()
    indexA: 0
    indexB: 0
    frameA: zeroTransform()
    frameB: zeroTransform()
    deltaCenter: zeroVector()
    angularMass: matrixZero()
  }
}

# The joint kinds' records, one list per kind (Box3D's union in
# b3JointSim): a joint's record is `<kind>Joints[dataIndex]`, where
# `dataIndex` is on its JointSim and Joint. The record stays in place while
# the joint's sim moves between solver sets and colours, so the sim the
# solver streams is the common part only. A freed slot is reused by the next
# joint of the same kind.
type JointKindData {
  distanceJoints: List(DistanceJointData)
  revoluteJoints: List(RevoluteJointData)
  prismaticJoints: List(PrismaticJointData)
  wheelJoints: List(WheelJointData)
  sphericalJoints: List(SphericalJointData)
  motorJoints: List(MotorJointData)
  parallelJoints: List(ParallelJointData)
  weldJoints: List(WeldJointData)
  freeDistanceSlots: List(Int)
  freeRevoluteSlots: List(Int)
  freePrismaticSlots: List(Int)
  freeWheelSlots: List(Int)
  freeSphericalSlots: List(Int)
  freeMotorSlots: List(Int)
  freeParallelSlots: List(Int)
  freeWeldSlots: List(Int)
}

func createJointKindData() ret JointKindData {
  ret JointKindData {
    distanceJoints: List.create(DistanceJointData, cap: 4)
    revoluteJoints: List.create(RevoluteJointData, cap: 4)
    prismaticJoints: List.create(PrismaticJointData, cap: 4)
    wheelJoints: List.create(WheelJointData, cap: 4)
    sphericalJoints: List.create(SphericalJointData, cap: 4)
    motorJoints: List.create(MotorJointData, cap: 4)
    parallelJoints: List.create(ParallelJointData, cap: 4)
    weldJoints: List.create(WeldJointData, cap: 4)
    freeDistanceSlots: List.create(Int, cap: 4)
    freeRevoluteSlots: List.create(Int, cap: 4)
    freePrismaticSlots: List.create(Int, cap: 4)
    freeWheelSlots: List.create(Int, cap: 4)
    freeSphericalSlots: List.create(Int, cap: 4)
    freeMotorSlots: List.create(Int, cap: 4)
    freeParallelSlots: List.create(Int, cap: 4)
    freeWeldSlots: List.create(Int, cap: 4)
  }
}

# Store `record` in a free slot of `records` (or a new one); its index.
func addJointRecord(
  T: type
  records: mod List(T)
  freeSlots: mod List(Int)
  record: view T
) ret Int {
  if freeSlots.length > 0 {
    let slot: Int = freeSlots.copyAtDefault(index: freeSlots.length - 1)
    freeSlots.remove(index: freeSlots.length - 1)
    records.set(index: slot, value: record)
    ret slot
  }
  records.add(value: record)
  ret records.length - 1
}
