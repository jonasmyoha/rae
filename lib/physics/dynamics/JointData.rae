# The solver records of the joint kinds (b3DistanceJoint, b3RevoluteJoint,
# b3PrismaticJoint, b3WheelJoint, b3SphericalJoint, b3MotorJoint,
# b3ParallelJoint and b3WeldJoint of Box3D's joint.h at 9f998c8) and their
# zero values. A JointSim (Joint) carries one of each; its `jointType` says
# which one is live.
open Vec2
open Vec3
open Quat
open physics/Constants
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/QuatMath
open physics/math/MatrixMath
open physics/math/TransformMath
open physics/dynamics/WorldTypes
open physics/dynamics/ContactConstraints

# b3DistanceJoint
type DistanceJointData {
  length: Float
  hertz: Float
  dampingRatio: Float
  lowerSpringForce: Float
  upperSpringForce: Float
  minLength: Float
  maxLength: Float
  maxMotorForce: Float
  motorSpeed: Float
  impulse: Float
  lowerImpulse: Float
  upperImpulse: Float
  motorImpulse: Float
  indexA: Int
  indexB: Int
  anchorA: Vec3
  anchorB: Vec3
  deltaCenter: Vec3
  distanceSoftness: Softness
  axialMass: Float
  enableSpring: Bool
  enableLimit: Bool
  enableMotor: Bool
}

# b3RevoluteJoint
type RevoluteJointData {
  linearImpulse: Vec3
  perpImpulse: Vec2
  springImpulse: Float
  motorImpulse: Float
  lowerImpulse: Float
  upperImpulse: Float
  hertz: Float
  dampingRatio: Float
  maxMotorTorque: Float
  motorSpeed: Float
  targetAngle: Float
  lowerAngle: Float
  upperAngle: Float
  indexA: Int
  indexB: Int
  frameA: Transform
  frameB: Transform
  rotationAxisZ: Vec3
  perpAxisX: Vec3
  perpAxisY: Vec3
  deltaCenter: Vec3
  deltaAngle: Float
  axialMass: Float
  springSoftness: Softness
  enableSpring: Bool
  enableMotor: Bool
  enableLimit: Bool
}

# b3PrismaticJoint
type PrismaticJointData {
  perpImpulse: Vec2
  angularImpulse: Vec3
  springImpulse: Float
  motorImpulse: Float
  lowerImpulse: Float
  upperImpulse: Float
  hertz: Float
  dampingRatio: Float
  maxMotorForce: Float
  motorSpeed: Float
  targetTranslation: Float
  lowerTranslation: Float
  upperTranslation: Float
  indexA: Int
  indexB: Int
  frameA: Transform
  frameB: Transform
  jointAxis: Vec3
  perpAxisY: Vec3
  perpAxisZ: Vec3
  deltaCenter: Vec3
  deltaAngle: Float
  rotationMass: Matrix3
  springSoftness: Softness
  enableSpring: Bool
  enableLimit: Bool
  enableMotor: Bool
}

# b3WheelJoint
type WheelJointData {
  linearImpulse: Vec2
  angularImpulse: Vec2
  spinImpulse: Float
  maxSpinTorque: Float
  spinSpeed: Float
  suspensionSpringImpulse: Float
  lowerSuspensionImpulse: Float
  upperSuspensionImpulse: Float
  lowerSuspensionLimit: Float
  upperSuspensionLimit: Float
  suspensionHertz: Float
  suspensionDampingRatio: Float
  steeringSpringImpulse: Float
  lowerSteeringImpulse: Float
  upperSteeringImpulse: Float
  lowerSteeringLimit: Float
  upperSteeringLimit: Float
  targetSteeringAngle: Float
  maxSteeringTorque: Float
  steeringHertz: Float
  steeringDampingRatio: Float
  indexA: Int
  indexB: Int
  frameA: Transform
  frameB: Transform
  deltaCenter: Vec3
  spinMass: Float
  suspensionMass: Float
  steeringMass: Float
  suspensionSoftness: Softness
  steeringSoftness: Softness
  enableSpinMotor: Bool
  enableSuspensionSpring: Bool
  enableSuspensionLimit: Bool
  enableSteering: Bool
  enableSteeringLimit: Bool
  enableSteeringMotor: Bool
}

func zeroSoftnessValue() ret Softness {
  ret Softness { biasRate: 0.0, massScale: 0.0, impulseScale: 0.0 }
}

func zeroTransform() ret Transform {
  ret Transform { position: zeroVector(), rotation: Quat { x: 0.0, y: 0.0, z: 0.0, w: 0.0 } }
}

# `(b3DistanceJoint){ 0 }`
func zeroDistanceJointData() ret DistanceJointData {
  ret DistanceJointData {
    length: 0.0
    hertz: 0.0
    dampingRatio: 0.0
    lowerSpringForce: 0.0
    upperSpringForce: 0.0
    minLength: 0.0
    maxLength: 0.0
    maxMotorForce: 0.0
    motorSpeed: 0.0
    impulse: 0.0
    lowerImpulse: 0.0
    upperImpulse: 0.0
    motorImpulse: 0.0
    indexA: 0
    indexB: 0
    anchorA: zeroVector()
    anchorB: zeroVector()
    deltaCenter: zeroVector()
    distanceSoftness: zeroSoftnessValue()
    axialMass: 0.0
    enableSpring: false
    enableLimit: false
    enableMotor: false
  }
}

# `(b3RevoluteJoint){ 0 }`
func zeroRevoluteJointData() ret RevoluteJointData {
  ret RevoluteJointData {
    linearImpulse: zeroVector()
    perpImpulse: Vec2 { x: 0.0, y: 0.0 }
    springImpulse: 0.0
    motorImpulse: 0.0
    lowerImpulse: 0.0
    upperImpulse: 0.0
    hertz: 0.0
    dampingRatio: 0.0
    maxMotorTorque: 0.0
    motorSpeed: 0.0
    targetAngle: 0.0
    lowerAngle: 0.0
    upperAngle: 0.0
    indexA: 0
    indexB: 0
    frameA: zeroTransform()
    frameB: zeroTransform()
    rotationAxisZ: zeroVector()
    perpAxisX: zeroVector()
    perpAxisY: zeroVector()
    deltaCenter: zeroVector()
    deltaAngle: 0.0
    axialMass: 0.0
    springSoftness: zeroSoftnessValue()
    enableSpring: false
    enableMotor: false
    enableLimit: false
  }
}

# `(b3PrismaticJoint){ 0 }`
func zeroPrismaticJointData() ret PrismaticJointData {
  ret PrismaticJointData {
    perpImpulse: Vec2 { x: 0.0, y: 0.0 }
    angularImpulse: zeroVector()
    springImpulse: 0.0
    motorImpulse: 0.0
    lowerImpulse: 0.0
    upperImpulse: 0.0
    hertz: 0.0
    dampingRatio: 0.0
    maxMotorForce: 0.0
    motorSpeed: 0.0
    targetTranslation: 0.0
    lowerTranslation: 0.0
    upperTranslation: 0.0
    indexA: 0
    indexB: 0
    frameA: zeroTransform()
    frameB: zeroTransform()
    jointAxis: zeroVector()
    perpAxisY: zeroVector()
    perpAxisZ: zeroVector()
    deltaCenter: zeroVector()
    deltaAngle: 0.0
    rotationMass: matrixZero()
    springSoftness: zeroSoftnessValue()
    enableSpring: false
    enableLimit: false
    enableMotor: false
  }
}

# `(b3WheelJoint){ 0 }`
func zeroWheelJointData() ret WheelJointData {
  ret WheelJointData {
    linearImpulse: Vec2 { x: 0.0, y: 0.0 }
    angularImpulse: Vec2 { x: 0.0, y: 0.0 }
    spinImpulse: 0.0
    maxSpinTorque: 0.0
    spinSpeed: 0.0
    suspensionSpringImpulse: 0.0
    lowerSuspensionImpulse: 0.0
    upperSuspensionImpulse: 0.0
    lowerSuspensionLimit: 0.0
    upperSuspensionLimit: 0.0
    suspensionHertz: 0.0
    suspensionDampingRatio: 0.0
    steeringSpringImpulse: 0.0
    lowerSteeringImpulse: 0.0
    upperSteeringImpulse: 0.0
    lowerSteeringLimit: 0.0
    upperSteeringLimit: 0.0
    targetSteeringAngle: 0.0
    maxSteeringTorque: 0.0
    steeringHertz: 0.0
    steeringDampingRatio: 0.0
    indexA: 0
    indexB: 0
    frameA: zeroTransform()
    frameB: zeroTransform()
    deltaCenter: zeroVector()
    spinMass: 0.0
    suspensionMass: 0.0
    steeringMass: 0.0
    suspensionSoftness: zeroSoftnessValue()
    steeringSoftness: zeroSoftnessValue()
    enableSpinMotor: false
    enableSuspensionSpring: false
    enableSuspensionLimit: false
    enableSteering: false
    enableSteeringLimit: false
    enableSteeringMotor: false
  }
}
