# Running the solver's stages (b3ComputeBlockCount, b3InitBlocks,
# b3InitStage, b3ExecuteBlock and b3ExecuteMainStage of Box3D's solver.c at
# 9f998c8; docs/physics-performance-plan.md §8). This is the ONE module that
# knows how stages are executed. Box3D keeps its workers in one task for the
# step and syncs them through atomic block claims and completion counts;
# Rae runs each stage as one parallelLoop over its blocks
# (docs/parallel-stages-design.md, Option C), the stage sequence being the
# ordinary loop in Solver.runSolverStages. The join at the end of each
# parallelLoop is the stage barrier, so no claims or counts are kept.
open Vec3
open physics/Constants
open physics/dynamics/JointSolver
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/SolverSet
open physics/dynamics/World
open physics/dynamics/ConstraintGraph
open physics/dynamics/StepContext
open physics/dynamics/BodyIntegration
open physics/dynamics/ContactSolver
open physics/dynamics/ContactSolverWide
open physics/dynamics/ContactSolverWideSolve

# b3ComputeBlockCount
func computeBlockCount(
  itemCount: view Int
  minSize: view Int
  maxBlockCount: view Int
) ret BlockDim {
  if itemCount is 0 {
    ret BlockDim { size: 0, count: 0 }
  }
  var size: Int = minSize
  if itemCount > minSize * maxBlockCount {
    size = (itemCount + maxBlockCount - 1) / maxBlockCount
  }
  ret BlockDim { size: size, count: (itemCount + size - 1) / size }
}

# b3InitBlocks: `dim.count` blocks over `itemCount` items, appended to the
# block pool with a zero sync index. Returns the first block's index.
func initBlocks(
  context: mod StepContext
  dim: view BlockDim
  itemCount: view Int
  blockType: view SolverBlockType
  colorIndex: view Int
) ret Int {
  let first: Int = context.syncBlocks.length
  loop var i: Int = 0, i < dim.count, ++i {
    var count: Int = dim.size
    # The last block may not be full
    if i is dim.count - 1 {
      count = itemCount - (dim.count - 1) * dim.size
    }
    context.syncBlocks.add(
      value: SyncBlock {
        block: SolverBlock {
          startIndex: i * dim.size
          count: count
          blockType: blockType
          colorIndex: colorIndex
        }
        syncIndex: 0
      }
    )
  }
  ret first
}

# b3InitStage
func initStage(
  context: mod StepContext
  stageType: view SolverStageType
  blockStart: view Int
  blockCount: view Int
  colorIndex: view Int
) {
  context.stages.add(value: SolverStage {
    stageType: stageType
    blockStart: blockStart
    blockCount: blockCount
    colorIndex: colorIndex
    completionCount: 0
  })
}

# b3ExecuteBlock: run one block of a stage. What a block reports for the
# whole step (restitution, joint thresholds, hit events) goes to TaskContext
# slot `slot`: the block's index in its stage, below chunkSlotsPerWorker *
# workerCount for every block that reports (Solver.solve's maxBlockCount;
# a colour stage starts with its joint blocks).
func executeBlock(
  world: mod PhysicsWorld
  context: mod StepContext
  stageType: view SolverStageType
  block: view SolverBlock
  slot: view Int
) {
  let wide: Bool = block.blockType is SolverBlockType.graphWideContactBlock
  let joint: Bool = block.blockType is SolverBlockType.graphJointBlock
  var first: Int = 0
  if block.colorIndex >= 0 and block.colorIndex < context.colorWideStarts.length {
    if wide {
      first = context.colorWideStarts.copyAtDefault(index: block.colorIndex)
    } else {
      first = context.colorContactStarts.copyAtDefault(index: block.colorIndex)
    }
  }
  match stageType {
    case SolverStageType.prepareJoints {
      prepareJointsBlock(world: world, context: context, block: block)
    }
    case SolverStageType.prepareWideContacts {
      if prepareContactsWide(world: world, context: context, block: block) {
        setSlotRestitution(world: world, slot: slot)
      }
    }
    case SolverStageType.prepareContacts {
      if prepareContactsScalar(world: world, context: context, block: block) {
        setSlotRestitution(world: world, slot: slot)
      }
    }
    case SolverStageType.integrateVelocities {
      let gravity: Vec3 = world.gravity
      if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
        integrateVelocities(
          sims: awake.bodySims
          states: awake.bodyStates
          block: block
          gravity: gravity
          h: context.h
        )
      }
    }
    case SolverStageType.warmStart {
      if joint {
        warmStartJointsBlock(world: world, block: block)
      }
      if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
        if wide {
          warmStartContactsWide(
            states: awake.bodyStates
            constraints: context.wideConstraints
            first: first
            block: block
          )
        } else if joint is false {
          warmStartContactsScalar(
            states: awake.bodyStates
            constraints: context.contactConstraints
            manifolds: context.manifoldConstraints
            first: first
            block: block
          )
        }
      }
    }
    case SolverStageType.solve {
      if joint {
        solveJointsBlock(
          world: world
          context: context
          block: block
          useBias: true
          slot: slot
        )
      }
      let contactSpeed: Float = world.contactSpeed
      if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
        if wide {
          pushContactsWide(
            states: awake.bodyStates
            constraints: context.wideConstraints
            first: first
            block: block
            context: context
            contactSpeed: contactSpeed
          )
        } else if joint is false {
          pushContactsScalar(
            states: awake.bodyStates
            constraints: context.contactConstraints
            manifolds: context.manifoldConstraints
            first: first
            block: block
            inverseH: context.inverseH
            contactSpeed: contactSpeed
          )
        }
      }
    }
    case SolverStageType.integratePositions {
      let maxAngularSpeed: Float = maxRotation() * context.inverseDt
      if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
        integratePositions(
          states: awake.bodyStates
          block: block
          h: context.h
          maxLinearSpeed: context.maxLinearVelocity
          maxAngularSpeed: maxAngularSpeed
        )
      }
    }
    case SolverStageType.relax {
      if joint {
        solveJointsBlock(
          world: world
          context: context
          block: block
          useBias: false
          slot: slot
        )
      }
      if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
        if wide {
          solveContactsWide(
            states: awake.bodyStates
            constraints: context.wideConstraints
            first: first
            block: block
            inverseHValue: context.inverseH
          )
        } else if joint is false {
          solveContactsScalar(
            states: awake.bodyStates
            constraints: context.contactConstraints
            manifolds: context.manifoldConstraints
            first: first
            block: block
            inverseH: context.inverseH
          )
        }
      }
    }
    case SolverStageType.restitution {
      let threshold: Float = world.restitutionThreshold
      let propagate: Bool = world.enableRestitutionPropagation
      if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
        if wide {
          applyRestitutionWide(
            states: awake.bodyStates
            constraints: context.wideConstraints
            first: first
            block: block
            inverseHValue: context.inverseH
            threshold: threshold
            propagate: propagate
          )
        } else if block.blockType is SolverBlockType.graphContactBlock {
          applyRestitutionScalar(
            states: awake.bodyStates
            constraints: context.contactConstraints
            manifolds: context.manifoldConstraints
            first: first
            block: block
            inverseH: context.inverseH
            threshold: threshold
            propagate: propagate
          )
        }
      }
    }
    case SolverStageType.storeWideImpulses {
      storeImpulsesWide(
        world: world
        context: context
        block: block
        slot: slot
      )
    }
    case SolverStageType.storeImpulses {
      var hitContacts: List(Int) = List.create(Int, cap: 0)
      storeImpulsesScalar(
        contacts: world.contacts
        constraints: context.contactConstraints
        manifolds: context.manifoldConstraints
        block: block
        negHitThreshold: -world.hitEventThreshold
        hitContacts: hitContacts
      )
      flagHitContacts(world: world, hitContacts: hitContacts, slot: slot)
    }
  }
}

func setSlotRestitution(world: mod PhysicsWorld, slot: view Int) {
  if let taskContext: mod TaskContext => world.taskContexts.modAt(index: slot) {
    taskContext.anyRestitution = true
  }
}

# b3ExecuteMainStage: run a stage's blocks. A single block, or a world with
# one worker, runs them inline in order; otherwise they are one
# parallelLoop. `syncBits` is kept for the stage record (Box3D's sync
# protocol needs it; the join replaces it here).
func executeMainStage(
  world: mod PhysicsWorld
  context: mod StepContext
  stageIndex: view Int
  syncBits: view Int
) {
  let stage: SolverStage = context.stages.copyAtDefault(index: stageIndex)
  if stage.blockCount is 0 {
    ret
  }
  context.syncBits = syncBits
  let slotCount: Int = world.taskContexts.length
  if stage.blockCount is 1 or world.workerCount is 1 {
    loop var blockOffset: Int = 0, blockOffset < stage.blockCount, ++blockOffset {
      runStageBlock(
        world: world
        context: context
        stage: stage
        blockOffset: blockOffset
        slotCount: slotCount
      )
    }
    ret
  }
  parallelLoop var blockOffset: Int = 0, blockOffset < stage.blockCount, ++blockOffset {
    # The blocks of a stage touch disjoint data: a colour's constraints
    # share no dynamic body (the graph colouring), a body stage visits each
    # body once, and a block's reports go to its own TaskContext slot
    unsafe {
      runStageBlock(
        world: world
        context: context
        stage: stage
        blockOffset: blockOffset
        slotCount: slotCount
      )
    }
  }
}

# Block `blockOffset` of `stage`, reporting into slot blockOffset (wrapped
# to the slot count for the block kinds that never report).
func runStageBlock(
  world: mod PhysicsWorld
  context: mod StepContext
  stage: view SolverStage
  blockOffset: view Int
  slotCount: view Int
) {
  let block: SolverBlock = context.syncBlocks.copyAtDefault(index: stage.blockStart + blockOffset).block
  executeBlock(
    world: world
    context: context
    stageType: stage.stageType
    block: block
    slot: blockOffset % slotCount
  )
}
