# A simulation island (b3Island of Box3D's island.h at 9f998c8): bodies that
# are (or were) connected by constraints, which sleep and wake together.
open physics/dynamics/Joint

# A touching contact of an island, with its two bodies, so splitting an
# island never needs the contact itself (b3ContactLink).
type ContactLink {
  contactId: Int
  bodyIdA: Int
  bodyIdB: Int
}

type Island {
  setIndex: Int
  localIndex: Int
  # -1 for a free slot
  islandId: Int
  # Constraints removed since the last split, which makes it a split candidate
  constraintRemoveCount: Int
  bodies: List(Int)
  # The touching contacts; they may connect to static bodies outside it
  contacts: List(ContactLink)
  # The joints; they may connect to static bodies outside it
  joints: List(JointLink)
}

func emptyIsland() ret Island {
  ret Island {
    setIndex: 0
    localIndex: 0
    islandId: 0
    constraintRemoveCount: 0
    bodies: List.create(Int, cap: 0)
    contacts: List.create(ContactLink, cap: 0)
    joints: List.create(JointLink, cap: 0)
  }
}
