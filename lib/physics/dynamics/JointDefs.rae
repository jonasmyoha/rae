# The joint definitions (b3JointDef and the per-kind definitions of Box3D's
# types.h at 9f998c8) and their defaults (joint.c): what a create function
# takes.
open Vec2
open Vec3
open Quat
open physics/Constants
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/QuatMath
open physics/math/MatrixMath
open physics/math/TransformMath
open physics/dynamics/WorldTypes
open physics/dynamics/ContactConstraints

# b3JointDef: what every joint kind's definition starts with.
type JointDef {
  bodyIdA: BodyId
  bodyIdB: BodyId
  localFrameA: Transform
  localFrameB: Transform
  forceThreshold: Float
  torqueThreshold: Float
  constraintHertz: Float
  constraintDampingRatio: Float
  drawScale: Float
  collideConnected: Bool
}

# b3DistanceJointDef
type DistanceJointDef {
  base: JointDef
  length: Float
  enableSpring: Bool
  lowerSpringForce: Float
  upperSpringForce: Float
  hertz: Float
  dampingRatio: Float
  enableLimit: Bool
  minLength: Float
  maxLength: Float
  enableMotor: Bool
  maxMotorForce: Float
  motorSpeed: Float
}

# b3RevoluteJointDef
type RevoluteJointDef {
  base: JointDef
  targetAngle: Float
  enableSpring: Bool
  hertz: Float
  dampingRatio: Float
  enableLimit: Bool
  lowerAngle: Float
  upperAngle: Float
  enableMotor: Bool
  maxMotorTorque: Float
  motorSpeed: Float
}

# b3PrismaticJointDef
type PrismaticJointDef {
  base: JointDef
  enableSpring: Bool
  hertz: Float
  dampingRatio: Float
  targetTranslation: Float
  enableLimit: Bool
  lowerTranslation: Float
  upperTranslation: Float
  enableMotor: Bool
  maxMotorForce: Float
  motorSpeed: Float
}

# b3WheelJointDef
type WheelJointDef {
  base: JointDef
  enableSuspensionSpring: Bool
  suspensionHertz: Float
  suspensionDampingRatio: Float
  enableSuspensionLimit: Bool
  lowerSuspensionLimit: Float
  upperSuspensionLimit: Float
  enableSpinMotor: Bool
  maxSpinTorque: Float
  spinSpeed: Float
  enableSteering: Bool
  steeringHertz: Float
  steeringDampingRatio: Float
  targetSteeringAngle: Float
  maxSteeringTorque: Float
  enableSteeringLimit: Bool
  lowerSteeringLimit: Float
  upperSteeringLimit: Float
}

func identityFrame() ret Transform {
  ret Transform { position: zeroVector(), rotation: quatIdentity() }
}

# b3DefaultJointDef
func defaultJointDef(lengthUnitsPerMeter: view Float) ret JointDef {
  ret JointDef {
    bodyIdA: BodyId { index1: 0, world0: 0, generation: 0 }
    bodyIdB: BodyId { index1: 0, world0: 0, generation: 0 }
    localFrameA: identityFrame()
    localFrameB: identityFrame()
    forceThreshold: floatMax
    torqueThreshold: floatMax
    constraintHertz: 60.0
    constraintDampingRatio: 2.0
    drawScale: lengthUnitsPerMeter
    collideConnected: false
  }
}

# b3DefaultDistanceJointDef
func defaultDistanceJointDef(lengthUnitsPerMeter: view Float) ret DistanceJointDef {
  ret DistanceJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    length: 1.0
    enableSpring: false
    lowerSpringForce: -floatMax
    upperSpringForce: floatMax
    hertz: 0.0
    dampingRatio: 0.0
    enableLimit: false
    minLength: 0.0
    maxLength: huge(lengthUnitsPerMeter: lengthUnitsPerMeter)
    enableMotor: false
    maxMotorForce: 0.0
    motorSpeed: 0.0
  }
}

# b3DefaultRevoluteJointDef
func defaultRevoluteJointDef(lengthUnitsPerMeter: view Float) ret RevoluteJointDef {
  ret RevoluteJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    targetAngle: 0.0
    enableSpring: false
    hertz: 0.0
    dampingRatio: 0.0
    enableLimit: false
    lowerAngle: 0.0
    upperAngle: 0.0
    enableMotor: false
    maxMotorTorque: 0.0
    motorSpeed: 0.0
  }
}

# b3DefaultPrismaticJointDef
func defaultPrismaticJointDef(lengthUnitsPerMeter: view Float) ret PrismaticJointDef {
  ret PrismaticJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    enableSpring: false
    hertz: 0.0
    dampingRatio: 0.0
    targetTranslation: 0.0
    enableLimit: false
    lowerTranslation: 0.0
    upperTranslation: 0.0
    enableMotor: false
    maxMotorForce: 0.0
    motorSpeed: 0.0
  }
}

# b3DefaultWheelJointDef
func defaultWheelJointDef(lengthUnitsPerMeter: view Float) ret WheelJointDef {
  ret WheelJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    enableSuspensionSpring: true
    suspensionHertz: 1.0
    suspensionDampingRatio: 0.7
    enableSuspensionLimit: false
    lowerSuspensionLimit: 0.0
    upperSuspensionLimit: 0.0
    enableSpinMotor: false
    maxSpinTorque: 0.0
    spinSpeed: 0.0
    enableSteering: false
    steeringHertz: 1.0
    steeringDampingRatio: 0.7
    targetSteeringAngle: 0.0
    maxSteeringTorque: 0.0
    enableSteeringLimit: false
    lowerSteeringLimit: 0.0
    upperSteeringLimit: 0.0
  }
}

# b3SphericalJointDef
type SphericalJointDef {
  base: JointDef
  enableSpring: Bool
  hertz: Float
  dampingRatio: Float
  targetRotation: Quat
  enableConeLimit: Bool
  coneAngle: Float
  enableTwistLimit: Bool
  lowerTwistAngle: Float
  upperTwistAngle: Float
  enableMotor: Bool
  maxMotorTorque: Float
  motorVelocity: Vec3
}

# b3DefaultSphericalJointDef
func defaultSphericalJointDef(lengthUnitsPerMeter: view Float) ret SphericalJointDef {
  ret SphericalJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    enableSpring: false
    hertz: 0.0
    dampingRatio: 0.0
    targetRotation: quatIdentity()
    enableConeLimit: false
    coneAngle: 0.0
    enableTwistLimit: false
    lowerTwistAngle: 0.0
    upperTwistAngle: 0.0
    enableMotor: false
    maxMotorTorque: 0.0
    motorVelocity: zeroVector()
  }
}

# b3MotorJointDef
type MotorJointDef {
  base: JointDef
  linearVelocity: Vec3
  maxVelocityForce: Float
  angularVelocity: Vec3
  maxVelocityTorque: Float
  linearHertz: Float
  linearDampingRatio: Float
  maxSpringForce: Float
  angularHertz: Float
  angularDampingRatio: Float
  maxSpringTorque: Float
}

# b3DefaultMotorJointDef
func defaultMotorJointDef(lengthUnitsPerMeter: view Float) ret MotorJointDef {
  ret MotorJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    linearVelocity: zeroVector()
    maxVelocityForce: 0.0
    angularVelocity: zeroVector()
    maxVelocityTorque: 0.0
    linearHertz: 0.0
    linearDampingRatio: 0.0
    maxSpringForce: 0.0
    angularHertz: 0.0
    angularDampingRatio: 0.0
    maxSpringTorque: 0.0
  }
}

# b3ParallelJointDef
type ParallelJointDef {
  base: JointDef
  hertz: Float
  dampingRatio: Float
  maxTorque: Float
}

# b3DefaultParallelJointDef
func defaultParallelJointDef(lengthUnitsPerMeter: view Float) ret ParallelJointDef {
  ret ParallelJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    hertz: 1.0
    dampingRatio: 1.0
    maxTorque: floatMax
  }
}

# b3WeldJointDef
type WeldJointDef {
  base: JointDef
  linearHertz: Float
  angularHertz: Float
  linearDampingRatio: Float
  angularDampingRatio: Float
}

# b3DefaultWeldJointDef
func defaultWeldJointDef(lengthUnitsPerMeter: view Float) ret WeldJointDef {
  ret WeldJointDef {
    base: defaultJointDef(lengthUnitsPerMeter: lengthUnitsPerMeter)
    linearHertz: 0.0
    angularHertz: 0.0
    linearDampingRatio: 0.0
    angularDampingRatio: 0.0
  }
}
