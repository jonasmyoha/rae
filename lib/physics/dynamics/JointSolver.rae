# The joint solver's dispatch (b3PrepareJoint, b3WarmStartJoint,
# b3SolveJoint, the *_Overflow functions and b3GetJointReaction of Box3D's
# joint.c at 9f998c8): every stage switches on the joint's kind, an
# exhaustive match (the filter joint's arms are empty: it has no
# constraint). Checked against the oracle in fixture 984.
open Vec3
open Quat
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/QuatMath
open physics/math/TransformMath
open physics/dynamics/WorldTypes
open physics/dynamics/Body
open physics/dynamics/Joint
open physics/dynamics/JointData
open physics/dynamics/SolverSet
open physics/dynamics/ConstraintGraph
open physics/dynamics/StepContext
open physics/container/Bitset
open physics/dynamics/World
open physics/dynamics/RevoluteJoint
open physics/dynamics/DistanceJoint
open physics/dynamics/PrismaticJoint
open physics/dynamics/WheelJoint
open physics/dynamics/SphericalJoint
open physics/dynamics/MotorJoint
open physics/dynamics/ParallelJoint
open physics/dynamics/WeldJoint

# The sim of body `bodyId` wherever it lives, and its awake index (-1 when
# not awake), for a joint's prepare.
type JointBody {
  sim: BodySim
  awakeIndex: Int
}

func jointBodyOf(world: view PhysicsWorld, bodyId: view Int) ret JointBody {
  let body: Body = bodyAt(world: world, bodyId: bodyId)
  var awakeIndex: Int = -1
  if body.setIndex is awakeSet {
    awakeIndex = body.localIndex
  }
  if let set: view SolverSet => world.solverSets.viewAt(index: body.setIndex) {
    ret JointBody {
      sim: set.bodySims.copyAtDefault(index: body.localIndex)
      awakeIndex: awakeIndex
    }
  }
  ret JointBody { sim: zeroBodySim(), awakeIndex: awakeIndex }
}

# b3PrepareJoint: the constraint softness (its hertz clamped by the step to
# reduce jitter), then the kind's prepare.
func prepareJoint(
  base: mod JointSim
  data: mod JointKindData
  bodyA: view JointBody
  bodyB: view JointBody
  context: view StepContext
) {
  let hertz: Float = minFloat(left: base.constraintHertz, right: 0.25 * context.inverseH)
  base.constraintSoftness = makeSoft(hertz: hertz, zeta: base.constraintDampingRatio, h: context.h)
  match base.jointType {
    case JointType.parallelJoint {
      if let joint: mod ParallelJointData => data.parallelJoints.modAt(index: base.dataIndex) {
        prepareParallelJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.distanceJoint {
      if let joint: mod DistanceJointData => data.distanceJoints.modAt(index: base.dataIndex) {
        prepareDistanceJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.filterJoint {
    }
    case JointType.motorJoint {
      if let joint: mod MotorJointData => data.motorJoints.modAt(index: base.dataIndex) {
        prepareMotorJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.prismaticJoint {
      if let joint: mod PrismaticJointData => data.prismaticJoints.modAt(index: base.dataIndex) {
        preparePrismaticJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.revoluteJoint {
      if let joint: mod RevoluteJointData => data.revoluteJoints.modAt(index: base.dataIndex) {
        prepareRevoluteJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.sphericalJoint {
      if let joint: mod SphericalJointData => data.sphericalJoints.modAt(index: base.dataIndex) {
        prepareSphericalJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.weldJoint {
      if let joint: mod WeldJointData => data.weldJoints.modAt(index: base.dataIndex) {
        prepareWeldJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
    case JointType.wheelJoint {
      if let joint: mod WheelJointData => data.wheelJoints.modAt(index: base.dataIndex) {
        prepareWheelJoint(
          base: base
          joint: joint
          simA: bodyA.sim
          simB: bodyB.sim
          indexA: bodyA.awakeIndex
          indexB: bodyB.awakeIndex
          h: context.h
          enableWarmStarting: context.enableWarmStarting
        )
      }
    }
  }
}

# b3WarmStartJoint
func warmStartJoint(base: view JointSim, data: view JointKindData, states: mod List(BodyState)) {
  match base.jointType {
    case JointType.parallelJoint {
      if let joint: view ParallelJointData => data.parallelJoints.viewAt(index: base.dataIndex) {
        warmStartParallelJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.distanceJoint {
      if let joint: view DistanceJointData => data.distanceJoints.viewAt(index: base.dataIndex) {
        warmStartDistanceJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.filterJoint {
    }
    case JointType.motorJoint {
      if let joint: view MotorJointData => data.motorJoints.viewAt(index: base.dataIndex) {
        warmStartMotorJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.prismaticJoint {
      if let joint: view PrismaticJointData => data.prismaticJoints.viewAt(index: base.dataIndex) {
        warmStartPrismaticJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.revoluteJoint {
      if let joint: view RevoluteJointData => data.revoluteJoints.viewAt(index: base.dataIndex) {
        warmStartRevoluteJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.sphericalJoint {
      if let joint: view SphericalJointData => data.sphericalJoints.viewAt(index: base.dataIndex) {
        warmStartSphericalJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.weldJoint {
      if let joint: view WeldJointData => data.weldJoints.viewAt(index: base.dataIndex) {
        warmStartWeldJoint(base: base, joint: joint, states: states)
      }
    }
    case JointType.wheelJoint {
      if let joint: view WheelJointData => data.wheelJoints.viewAt(index: base.dataIndex) {
        warmStartWheelJoint(base: base, joint: joint, states: states)
      }
    }
  }
}

# b3SolveJoint
func solveJoint(
  base: mod JointSim
  data: mod JointKindData
  states: mod List(BodyState)
  h: view Float
  inverseH: view Float
  useBias: view Bool
) {
  match base.jointType {
    case JointType.parallelJoint {
      if let joint: mod ParallelJointData => data.parallelJoints.modAt(index: base.dataIndex) {
        solveParallelJoint(
          base: base
          joint: joint
          states: states
          h: h
        )
      }
    }
    case JointType.distanceJoint {
      if let joint: mod DistanceJointData => data.distanceJoints.modAt(index: base.dataIndex) {
        solveDistanceJoint(
          base: base
          joint: joint
          states: states
          h: h
          inverseH: inverseH
          useBias: useBias
        )
      }
    }
    case JointType.filterJoint {
    }
    case JointType.motorJoint {
      if let joint: mod MotorJointData => data.motorJoints.modAt(index: base.dataIndex) {
        solveMotorJoint(
          base: base
          joint: joint
          states: states
          h: h
        )
      }
    }
    case JointType.prismaticJoint {
      if let joint: mod PrismaticJointData => data.prismaticJoints.modAt(index: base.dataIndex) {
        solvePrismaticJoint(
          base: base
          joint: joint
          states: states
          h: h
          inverseH: inverseH
          useBias: useBias
        )
      }
    }
    case JointType.revoluteJoint {
      if let joint: mod RevoluteJointData => data.revoluteJoints.modAt(index: base.dataIndex) {
        solveRevoluteJoint(
          base: base
          joint: joint
          states: states
          h: h
          inverseH: inverseH
          useBias: useBias
        )
      }
    }
    case JointType.sphericalJoint {
      if let joint: mod SphericalJointData => data.sphericalJoints.modAt(index: base.dataIndex) {
        solveSphericalJoint(
          base: base
          joint: joint
          states: states
          h: h
          inverseH: inverseH
          useBias: useBias
        )
      }
    }
    case JointType.weldJoint {
      if let joint: mod WeldJointData => data.weldJoints.modAt(index: base.dataIndex) {
        solveWeldJoint(
          base: base
          joint: joint
          states: states
          h: h
          inverseH: inverseH
          useBias: useBias
        )
      }
    }
    case JointType.wheelJoint {
      if let joint: mod WheelJointData => data.wheelJoints.modAt(index: base.dataIndex) {
        solveWheelJoint(
          base: base
          joint: joint
          states: states
          h: h
          inverseH: inverseH
          useBias: useBias
        )
      }
    }
  }
}

# b3GetJointReaction: the joint's force and torque magnitudes.
type JointReaction {
  force: Float
  torque: Float
}

func jointReaction(
  sim: view JointSim
  world: view PhysicsWorld
  invTimeStep: view Float
) ret JointReaction {
  var linearImpulse: Float = 0.0
  var angularImpulse: Float = 0.0
  match sim.jointType {
    case JointType.parallelJoint {
      let joint: ParallelJointData = world.jointData.parallelJoints.copyAtDefault(
        index: sim.dataIndex
      )
      let impulse: Vec3 = { x: joint.perpImpulse.x, y: joint.perpImpulse.y, z: 0.0 }
      angularImpulse = length(vector: impulse)
    }
    case JointType.distanceJoint {
      let joint: DistanceJointData = world.jointData.distanceJoints.copyAtDefault(
        index: sim.dataIndex
      )
      linearImpulse = absFloat(
        value: joint.impulse + joint.lowerImpulse - joint.upperImpulse + joint.motorImpulse
      )
    }
    case JointType.filterJoint {
    }
    case JointType.motorJoint {
      let joint: MotorJointData = world.jointData.motorJoints.copyAtDefault(index: sim.dataIndex)
      linearImpulse = length(
        vector: add(left: joint.linearVelocityImpulse, right: joint.linearSpringImpulse)
      )
      angularImpulse = length(
        vector: add(left: joint.angularVelocityImpulse, right: joint.angularSpringImpulse)
      )
    }
    case JointType.prismaticJoint {
      let joint: PrismaticJointData = world.jointData.prismaticJoints.copyAtDefault(
        index: sim.dataIndex
      )
      let impulse: Vec3 = {
        x: joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse
        y: joint.perpImpulse.x
        z: joint.perpImpulse.y
      }
      linearImpulse = length(vector: impulse)
      angularImpulse = length(vector: joint.angularImpulse)
    }
    case JointType.revoluteJoint {
      let joint: RevoluteJointData = world.jointData.revoluteJoints.copyAtDefault(
        index: sim.dataIndex
      )
      linearImpulse = length(vector: joint.linearImpulse)
      let impulse: Vec3 = {
        x: joint.perpImpulse.x
        y: joint.perpImpulse.y
        z: joint.motorImpulse + joint.lowerImpulse - joint.upperImpulse
      }
      angularImpulse = length(vector: impulse)
    }
    case JointType.sphericalJoint {
      let joint: SphericalJointData = world.jointData.sphericalJoints.copyAtDefault(
        index: sim.dataIndex
      )
      linearImpulse = length(vector: joint.linearImpulse)
      let transformA: Transform = bodyTransformOf(
        world: world
        body: bodyAt(world: world, bodyId: sim.bodyIdA)
      )
      let transformB: Transform = bodyTransformOf(
        world: world
        body: bodyAt(world: world, bodyId: sim.bodyIdB)
      )
      let quatA: Quat = multiply(left: transformA.rotation, right: sim.localFrameA.rotation)
      let quatB: Quat = multiply(left: transformB.rotation, right: sim.localFrameB.rotation)
      # The cone axis is the z-axis of body A
      let coneAxis: Vec3 = rotateVector(quat: quatA, vector: axisZ())
      let twistAxis: Vec3 = rotateVector(quat: quatB, vector: axisZ())
      let swingAxis: Vec3 = normalize(vector: cross(left: coneAxis, right: twistAxis))
      var impulse: Vec3 = add(left: joint.springImpulse, right: joint.motorImpulse)
      impulse = mulAdd(
        base: impulse
        scale: joint.lowerTwistImpulse - joint.upperTwistImpulse
        vector: twistAxis
      )
      impulse = mulAdd(base: impulse, scale: joint.swingImpulse, vector: swingAxis)
      angularImpulse = length(vector: impulse)
    }
    case JointType.weldJoint {
      let joint: WeldJointData = world.jointData.weldJoints.copyAtDefault(index: sim.dataIndex)
      linearImpulse = length(vector: joint.linearImpulse)
      angularImpulse = length(vector: joint.angularImpulse)
    }
    case JointType.wheelJoint {
      let joint: WheelJointData = world.jointData.wheelJoints.copyAtDefault(index: sim.dataIndex)
      let axialImpulse: Float = joint.suspensionSpringImpulse + joint.lowerSuspensionImpulse - joint.upperSuspensionImpulse
      let impulse: Vec3 = { x: joint.linearImpulse.x, y: joint.linearImpulse.y, z: axialImpulse }
      linearImpulse = length(vector: impulse)
      angularImpulse = absFloat(value: joint.spinImpulse)
    }
  }
  ret JointReaction { force: linearImpulse * invTimeStep, torque: angularImpulse * invTimeStep }
}

# Prepare joint sim `localIndex` of colour `colorIndex` in place: its
# bodies are read first, then the sim and its kind's record are prepared
# where they live (a JointSim copied out and set back cost a copy each way).
func prepareColorJoint(
  world: mod PhysicsWorld
  colorIndex: view Int
  localIndex: view Int
  context: view StepContext
) {
  var bodyIdA: Int = 0
  var bodyIdB: Int = 0
  if let color: view GraphColor => world.constraintGraph.colors.viewAt(index: colorIndex) {
    if let sim: view JointSim => color.jointSims.viewAt(index: localIndex) {
      bodyIdA = sim.bodyIdA
      bodyIdB = sim.bodyIdB
    }
  }
  let bodyA: JointBody = jointBodyOf(world: world, bodyId: bodyIdA)
  let bodyB: JointBody = jointBodyOf(world: world, bodyId: bodyIdB)
  if let color: mod GraphColor => world.constraintGraph.colors.modAt(index: colorIndex) {
    if let sim: mod JointSim => color.jointSims.modAt(index: localIndex) {
      prepareJoint(
        base: sim
        data: world.jointData
        bodyA: bodyA
        bodyB: bodyB
        context: context
      )
    }
  }
}

# b3PrepareJoints_Overflow
func prepareJointsOverflow(world: mod PhysicsWorld, context: view StepContext) {
  var count: Int = 0
  if let color: view GraphColor => world.constraintGraph.colors.viewAt(index: overflowIndex) {
    count = color.jointSims.length
  }
  loop var i: Int = 0, i < count, ++i {
    prepareColorJoint(
      world: world
      colorIndex: overflowIndex
      localIndex: i
      context: context
    )
  }
}

# b3WarmStartJoints_Overflow
func warmStartJointsOverflow(world: mod PhysicsWorld) {
  if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    if let color: view GraphColor => world.constraintGraph.colors.viewAt(index: overflowIndex) {
      loop let sim: view JointSim in color.jointSims {
        warmStartJoint(base: sim, data: world.jointData, states: awake.bodyStates)
      }
    }
  }
}

# b3SolveJoints_Overflow
func solveJointsOverflow(world: mod PhysicsWorld, context: view StepContext, useBias: view Bool) {
  if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    if let color: mod GraphColor => world.constraintGraph.colors.modAt(index: overflowIndex) {
      loop var i: Int = 0, i < color.jointSims.length, ++i {
        if let sim: mod JointSim => color.jointSims.modAt(index: i) {
          solveJoint(
            base: sim
            data: world.jointData
            states: awake.bodyStates
            h: context.h
            inverseH: context.inverseH
            useBias: useBias
          )
        }
      }
    }
  }
}

# b3PrepareJointsTask: joints `block.startIndex` to `+ block.count` of the
# flat range over the active colours, each found by the span table.
func prepareJointsBlock(
  world: mod PhysicsWorld
  context: view StepContext
  block: view SolverBlock
) {
  var index: Int = block.startIndex
  let endIndex: Int = block.startIndex + block.count
  # The colour of the start index
  var spanIndex: Int = 0
  loop context.jointPrepareSpans.copyAtDefault(index: spanIndex + 1).start <= index {
    spanIndex = spanIndex + 1
  }
  loop index < endIndex {
    let span: PrepareSpan = context.jointPrepareSpans.copyAtDefault(index: spanIndex)
    let colorEndIndex: Int = minInt(
      left: context.jointPrepareSpans.copyAtDefault(index: spanIndex + 1).start
      right: endIndex
    )
    loop index < colorEndIndex {
      let localIndex: Int = index - span.start
      prepareColorJoint(
        world: world
        colorIndex: span.colorIndex
        localIndex: localIndex
        context: context
      )
      index = index + 1
    }
    spanIndex = spanIndex + 1
  }
}

# b3WarmStartJointsTask: a block of a colour's joints.
func warmStartJointsBlock(world: mod PhysicsWorld, block: view SolverBlock) {
  if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    if let color: view GraphColor => world.constraintGraph.colors.viewAt(index: block.colorIndex) {
      loop var i: Int = block.startIndex, i < block.startIndex + block.count, ++i {
        if let sim: view JointSim => color.jointSims.viewAt(index: i) {
          warmStartJoint(base: sim, data: world.jointData, states: awake.bodyStates)
        }
      }
    }
  }
}

# b3SolveJointsTask: a block of a colour's joints; with the bias, an awake
# joint whose force or torque reaches its threshold is flagged for a joint
# event (worker 0's bits). The threshold check runs after the block is
# solved, so the reaction can read the world: a joint's impulses do not
# change after its own solve, and the body transforms are only moved by
# finalize, so the values are the ones Box3D checks right after each solve.
func solveJointsBlock(
  world: mod PhysicsWorld
  context: view StepContext
  block: view SolverBlock
  useBias: view Bool
) {
  # Whether any joint of the block has a threshold: most have none, and
  # then the second pass is skipped (Box3D checks inline after each solve)
  var anyThreshold: Bool = false
  if let awake: mod SolverSet => world.solverSets.modAt(index: awakeSet) {
    if let color: mod GraphColor => world.constraintGraph.colors.modAt(index: block.colorIndex) {
      loop var i: Int = block.startIndex, i < block.startIndex + block.count, ++i {
        if let sim: mod JointSim => color.jointSims.modAt(index: i) {
          solveJoint(
            base: sim
            data: world.jointData
            states: awake.bodyStates
            h: context.h
            inverseH: context.inverseH
            useBias: useBias
          )
          if sim.forceThreshold < floatMax or sim.torqueThreshold < floatMax {
            anyThreshold = true
          }
        }
      }
    }
  }
  if useBias is false or anyThreshold is false {
    ret
  }
  loop var i: Int = block.startIndex, i < block.startIndex + block.count, ++i {
    # Read the joint through a view (a JointSim copy is large), then flag it
    var report: Bool = false
    var jointId: Int = -1
    if let color: view GraphColor => world.constraintGraph.colors.viewAt(index: block.colorIndex) {
      if let sim: view JointSim => color.jointSims.viewAt(index: i) {
        if sim.forceThreshold < floatMax or sim.torqueThreshold < floatMax {
          jointId = sim.jointId
          var flagged: Bool = false
          if let taskContext: view TaskContext => world.taskContexts.viewAt(index: 0) {
            flagged = getBit(bitset: taskContext.jointStateBitSet, bitIndex: jointId)
          }
          if flagged is false {
            let reaction: JointReaction = jointReaction(
              sim: sim
              world: world
              invTimeStep: context.inverseH
            )
            # A zero threshold reports every awake joint
            report = reaction.force >= sim.forceThreshold or reaction.torque >= sim.torqueThreshold
          }
        }
      }
    }
    if report {
      if let taskContext: mod TaskContext => world.taskContexts.modAt(index: 0) {
        setBit(bitset: taskContext.jointStateBitSet, bitIndex: jointId)
      }
    }
  }
}

# The joint events of a step (b3Solve's report): the flagged joints, by id.
func reportJointEvents(world: mod PhysicsWorld) {
  # The workers' bits OR-ed into worker 0's (moved out and given back)
  var stateBits: Bitset = emptyBitset()
  if let first: mod TaskContext => world.taskContexts.modAt(index: 0) {
    stateBits = own first.jointStateBitSet
  }
  loop var i: Int = 1, i < world.taskContexts.length, ++i {
    if let other: view TaskContext => world.taskContexts.viewAt(index: i) {
      inPlaceUnion(setA: stateBits, setB: other.jointStateBitSet)
    }
  }
  let bitCount: Int = stateBits.blockCount * 64
  loop var jointId: Int = 0, jointId < bitCount, ++jointId {
    if getBit(bitset: stateBits, bitIndex: jointId) {
      world.jointEvents.add(
        value: JointEvent {
          jointId: JointId {
            index1: jointId + 1
            world0: world.worldId
            generation: world.joints.copyAtDefault(index: jointId).generation
          }
        }
      )
    }
  }
  if let first: mod TaskContext => world.taskContexts.modAt(index: 0) {
    first.jointStateBitSet = own stateBits
  }
}
