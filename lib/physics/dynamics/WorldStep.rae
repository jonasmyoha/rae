# Stepping a world (b3World_Step of Box3D's physics_world.c at 9f998c8):
# find new pairs, update the contacts (the narrow phase), then solve the
# constraints and finalize the bodies. Checked against the oracle in
# fixtures 958 and 959. Box3D's capacity statistics are not kept.
open physics/math/Scalar
open physics/dynamics/WorldTypes
open physics/dynamics/World
open physics/dynamics/Events
open physics/dynamics/BroadPhasePairs
open physics/dynamics/Collide
open physics/dynamics/StepContext
open physics/dynamics/Solver
open physics/dynamics/Sensors

# b3World_Step: advance the world by `timeStep` in `subStepCount` sub-steps.
func stepWorld(world: mod PhysicsWorld, timeStep: view Float, subStepCount: view Int) {
  world.locked = true

  # Prepare to capture events; a caller must not see stale ones after an
  # early return
  world.bodyMoveEvents.clear()
  world.sensorBeginEvents.clear()
  world.contactBeginEvents.clear()
  world.contactHitEvents.clear()
  world.jointEvents.clear()

  # Update the collision pairs and create contacts
  updateBroadPhasePairs(world: world)

  # The world's context, moved out for the step (solve takes the world and
  # the context) and back at the end; reset, its lists keep their capacity
  var context: StepContext = own world.stepContext
  resetStepContext(context: context)
  context.dt = timeStep
  context.subStepCount = maxInt(left: 1, right: subStepCount)
  if timeStep > 0.0 {
    context.inverseDt = 1.0 / timeStep
    context.h = timeStep / context.subStepCount.toFloat()
    context.inverseH = context.subStepCount.toFloat() * context.inverseDt
  } else {
    context.inverseDt = 0.0
    context.h = 0.0
    context.inverseH = 0.0
  }
  world.inverseH = context.inverseH
  world.inverseDt = context.inverseDt

  # Hertz values get reduced for large time steps
  let contactHertz: Float = minFloat(left: world.contactHertz, right: 0.125 * context.inverseH)
  context.contactSoftness = makeSoft(
    hertz: contactHertz
    zeta: world.contactDampingRatio
    h: context.h
  )
  context.staticSoftness = makeSoft(
    hertz: 2.0 * contactHertz
    zeta: 0.5 * world.contactDampingRatio
    h: context.h
  )
  context.maxLinearVelocity = world.maxLinearSpeed
  context.enableWarmStarting = world.enableWarmStarting

  # The narrow phase: update the contacts
  collide(world: world)

  # Integrate velocities, solve the velocity constraints, integrate positions
  if timeStep > 0.0 {
    solve(world: world, context: context)
  }

  world.stepContext = own context

  # Update the sensors
  overlapSensors(world: world)

  # Swap the end event buffers
  world.endEventArrayIndex = 1 - world.endEventArrayIndex
  if world.endEventArrayIndex is 0 {
    world.sensorEndEvents0.clear()
    world.contactEndEvents0.clear()
  } else {
    world.sensorEndEvents1.clear()
    world.contactEndEvents1.clear()
  }
  world.locked = false
}

# The events of the last step (b3World_GetContactEvents,
# b3World_GetSensorEvents, b3World_GetBodyEvents): the end events come from
# the buffer the step just finished with.
type ContactEvents {
  beginEvents: List(ContactBeginTouchEvent)
  endEvents: List(ContactEndTouchEvent)
  hitEvents: List(ContactHitEvent)
}

type SensorEvents {
  beginEvents: List(SensorBeginTouchEvent)
  endEvents: List(SensorEndTouchEvent)
}

func getContactEvents(world: view PhysicsWorld) ret ContactEvents {
  var endEvents: List(ContactEndTouchEvent) = world.contactEndEvents1
  if world.endEventArrayIndex is 1 {
    endEvents = world.contactEndEvents0
  }
  ret ContactEvents {
    beginEvents: world.contactBeginEvents
    endEvents: endEvents
    hitEvents: world.contactHitEvents
  }
}

func getSensorEvents(world: view PhysicsWorld) ret SensorEvents {
  var endEvents: List(SensorEndTouchEvent) = world.sensorEndEvents1
  if world.endEventArrayIndex is 1 {
    endEvents = world.sensorEndEvents0
  }
  ret SensorEvents { beginEvents: world.sensorBeginEvents, endEvents: endEvents }
}

func getBodyEvents(world: view PhysicsWorld) ret List(BodyMoveEvent) {
  ret world.bodyMoveEvents
}
