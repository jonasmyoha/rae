# Quicksort as Box3D uses it (qsort.h at 9f998c8, Alexey Tourbin's
# [Sedgewick 1978] quicksort). The macro takes LESS and SWAP over indices;
# here the values are a List of an ordered type and LESS is `<`. The exact
# sequence of comparisons and swaps is kept, because the order it leaves
# equal keys in is part of the simulation result.
#
# qsort.h is Copyright (c) 2013, 2017 Alexey Tourbin, under the MIT license
# (the same terms as Box3D's, lib/physics/LICENSE-box3d.md).

# Q_THRESH: below this size a subfile is insertion sorted.
const quickSortThreshold: Int = 16

# A pushed subfile [left, right].
type SortRange {
  left: Int
  right: Int
}

func lessAt(
  T: type
  values: view List(T)
  first: view Int
  second: view Int
) ret Bool {
  ret values.copyAtDefault(index: first) < values.copyAtDefault(index: second)
}

func swapAt(
  T: type
  values: mod List(T)
  first: view Int
  second: view Int
  companion: mod List(Int)
) {
  let held: T = values.copyAtDefault(index: first)
  values.set(index: first, value: values.copyAtDefault(index: second))
  values.set(index: second, value: held)
  # The companion's items move with the values (Box3D's SWAP of a whole
  # struct sorted by one of its fields)
  if companion.length > 0 {
    let heldItem: Int = companion.copyAtDefault(index: first)
    companion.set(index: first, value: companion.copyAtDefault(index: second))
    companion.set(index: second, value: heldItem)
  }
}

# Q_SORT3: sort three elements in place.
func sortThree(
  T: type
  values: mod List(T)
  first: view Int
  second: view Int
  third: view Int
  companion: mod List(Int)
) {
  if lessAt(
    T: T
    values: values
    first: second
    second: first
  ) {
    if lessAt(
      T: T
      values: values
      first: third
      second: second
    ) {
      swapAt(
        T: T
        values: values
        first: first
        second: third
        companion: companion
      )
    } else {
      swapAt(
        T: T
        values: values
        first: first
        second: second
        companion: companion
      )
      if lessAt(
        T: T
        values: values
        first: third
        second: second
      ) {
        swapAt(
          T: T
          values: values
          first: second
          second: third
          companion: companion
        )
      }
    }
  } else if lessAt(
    T: T
    values: values
    first: third
    second: second
  ) {
    swapAt(
      T: T
      values: values
      first: second
      second: third
      companion: companion
    )
    if lessAt(
      T: T
      values: values
      first: second
      second: first
    ) {
      swapAt(
        T: T
        values: values
        first: first
        second: second
        companion: companion
      )
    }
  }
}

# Q_INSERTION_SORT over [left, right].
func insertionSort(
  T: type
  values: mod List(T)
  left: view Int
  right: view Int
  companion: mod List(Int)
) {
  loop var i: Int = left + 1, i <= right, ++i {
    var j: Int = i
    loop j > left and lessAt(
      T: T
      values: values
      first: j
      second: j - 1
    ) {
      swapAt(
        T: T
        values: values
        first: j
        second: j - 1
        companion: companion
      )
      j = j - 1
    }
  }
}

# QSORT over all of `values`.
func quickSort(T: type, values: mod List(T)) {
  let noCompanion: List(Int) = List.create(Int, cap: 0)
  quickSortWithCompanion(T: T, values: values, companion: noCompanion)
}

# QSORT over all of `values`, LESS on `values` alone; `companion` (empty, or
# as long as `values`) is permuted the same way.
func quickSortWithCompanion(T: type, values: mod List(T), companion: mod List(Int)) {
  var stack: List(SortRange) = List.create(SortRange, cap: 48)
  quickSortWithStack(
    T: T
    values: values
    companion: companion
    stack: stack
  )
}

# quickSortWithCompanion with the caller's range stack (cleared first), for
# a caller that sorts every step and keeps the stack's buffer.
func quickSortWithStack(
  T: type
  values: mod List(T)
  companion: mod List(Int)
  stack: mod List(SortRange)
) {
  stack.clear()
  if values.length <= 1 {
    ret
  }
  var left: Int = 0
  var right: Int = values.length - 1
  loop true {
    if right - left + 1 >= quickSortThreshold {
      # Q_PARTITION around the median of the second, middle and last items
      let middle: Int = left + ((right - left) shr 1)
      sortThree(
        T: T
        values: values
        first: left + 1
        second: middle
        third: right
        companion: companion
      )
      swapAt(
        T: T
        values: values
        first: left
        second: middle
        companion: companion
      )
      var i: Int = left + 1
      var j: Int = right
      loop true {
        i = i + 1
        loop lessAt(
          T: T
          values: values
          first: i
          second: left
        ) {
          i = i + 1
        }
        j = j - 1
        loop lessAt(
          T: T
          values: values
          first: left
          second: j
        ) {
          j = j - 1
        }
        if i >= j {
          break
        }
        swapAt(
          T: T
          values: values
          first: i
          second: j
          companion: companion
        )
      }
      i = j + 1
      swapAt(
        T: T
        values: values
        first: left
        second: j
        companion: companion
      )
      j = j - 1
      # Q_SUBFILES: the larger subfile is pushed, the smaller is next
      var left1: Int = i
      var right1: Int = right
      var left2: Int = left
      var right2: Int = j
      if j - left >= right - i {
        left1 = left
        right1 = j
        left2 = i
        right2 = right
      }
      if left2 is right2 {
        left = left1
        right = right1
      } else {
        stack.add(value: SortRange { left: left1, right: right1 })
        left = left2
        right = right2
      }
    } else {
      insertionSort(
        T: T
        values: values
        left: left
        right: right
        companion: companion
      )
      if stack.length is 0 {
        break
      }
      let range: SortRange = stack.copyAtDefault(index: stack.length - 1)
      stack.removeLast()
      left = range.left
      right = range.right
    }
  }
}
