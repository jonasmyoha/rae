# Spawning and despawning physics entities, and the static venue
# (docs/physics-design.md §5.3 item 6 and §5.5). A body or shape is mapped
# to its entity the moment it is created; despawnRigidBody destroys the body
# (with its shapes, contacts and joints) BEFORE the caller clears the
# entity's components and frees the entity, so a recycled entity index
# never owns a live body.
open Vec3
open Quat
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open physics/math/QuatMath
open physics/math/TransformMath
open physics/geometry/QueryTypes
open physics/geometry/Hull
open physics/geometry/BoxHull
open physics/geometry/Mesh
open physics/dynamics/WorldTypes
open physics/dynamics/World
open physics/dynamics/WorldBodies
open physics/dynamics/WorldShapes
open physics/ecs/Physics
open physics/ecs/PhysicsComponents

# Create a body for `entityId` from `def` and give the entity its RigidBody;
# its Transform3D takes the body's pose (its scale kept, or 1).
func spawnRigidBody(
  physics: mod Physics
  rigidBodies: mod ComponentTable(RigidBody)
  transforms: mod ComponentTable(Transform3D)
  entityId: view EntityId
  def: view BodyDef
) ret BodyId {
  let bodyId: BodyId = createBody(world: physics.world, def: def)
  setMappedEntity(entities: physics.bodyEntities, index: bodyId.index1 - 1, entityId: entityId)
  if componentHas(this: transforms, entityId: entityId) {
    let transform: mod Transform3D => componentMod(this: transforms, entityId: entityId)
    transform.position = def.position
    transform.rotation = def.rotation
  } else {
    var transform: Transform3D = createTransform3D()
    transform.position = def.position
    transform.rotation = def.rotation
    componentSet(this: transforms, entityId: entityId, data: transform)
  }
  componentSet(
    this: rigidBodies
    entityId: entityId
    data: RigidBody {
      bodyId: bodyId
      bodyType: def.bodyType
      syncedTransformStamp: componentModStamp(this: transforms, entityId: entityId)
    }
  )
  ret bodyId
}

# Map a new shape to `entityId` and add it to the entity's Collider.
func recordCollider(
  physics: mod Physics
  colliders: mod ComponentTable(Collider)
  entityId: view EntityId
  shapeId: view ShapeId
) {
  setMappedEntity(entities: physics.shapeEntities, index: shapeId.index1 - 1, entityId: entityId)
  if componentHas(this: colliders, entityId: entityId) {
    let collider: mod Collider => componentMod(this: colliders, entityId: entityId)
    collider.shapeIds.add(value: shapeId)
  } else {
    let shapeIds: List(ShapeId) = List.create(ShapeId, cap: 1)
    shapeIds.add(value: shapeId)
    componentSet(this: colliders, entityId: entityId, data: Collider { shapeIds: shapeIds })
  }
}

# The body of a spawned entity (nullBodyId when it has none).
func entityBodyId(rigidBodies: view ComponentTable(RigidBody), entityId: view EntityId) ret BodyId {
  if componentHas(this: rigidBodies, entityId: entityId) {
    ret componentView(this: rigidBodies, entityId: entityId).bodyId
  }
  ret nullBodyId()
}

# A sphere on the entity's body.
func addSphereCollider(
  physics: mod Physics
  rigidBodies: view ComponentTable(RigidBody)
  colliders: mod ComponentTable(Collider)
  entityId: view EntityId
  def: view ShapeDef
  sphere: view Sphere
) ret ShapeId {
  let shapeId: ShapeId = createSphereShape(
    world: physics.world
    bodyId: entityBodyId(rigidBodies: rigidBodies, entityId: entityId)
    def: def
    sphere: sphere
  )
  recordCollider(
    physics: physics
    colliders: colliders
    entityId: entityId
    shapeId: shapeId
  )
  ret shapeId
}

# A capsule on the entity's body.
func addCapsuleCollider(
  physics: mod Physics
  rigidBodies: view ComponentTable(RigidBody)
  colliders: mod ComponentTable(Collider)
  entityId: view EntityId
  def: view ShapeDef
  capsule: view Capsule
) ret ShapeId {
  let shapeId: ShapeId = createCapsuleShape(
    world: physics.world
    bodyId: entityBodyId(rigidBodies: rigidBodies, entityId: entityId)
    def: def
    capsule: capsule
  )
  recordCollider(
    physics: physics
    colliders: colliders
    entityId: entityId
    shapeId: shapeId
  )
  ret shapeId
}

# A convex hull on the entity's body.
func addHullCollider(
  physics: mod Physics
  rigidBodies: view ComponentTable(RigidBody)
  colliders: mod ComponentTable(Collider)
  entityId: view EntityId
  def: view ShapeDef
  hull: view Hull
) ret ShapeId {
  let shapeId: ShapeId = createHullShape(
    world: physics.world
    bodyId: entityBodyId(rigidBodies: rigidBodies, entityId: entityId)
    def: def
    hull: hull
  )
  recordCollider(
    physics: physics
    colliders: colliders
    entityId: entityId
    shapeId: shapeId
  )
  ret shapeId
}

# A box of half extents (hx, hy, hz) placed by `transform` on the entity's
# body.
func addBoxCollider(
  physics: mod Physics
  rigidBodies: view ComponentTable(RigidBody)
  colliders: mod ComponentTable(Collider)
  entityId: view EntityId
  def: view ShapeDef
  halfExtents: view Vec3
  transform: view Transform
) ret ShapeId {
  let hull: Hull = makeTransformedBoxHull(
    hx: halfExtents.x
    hy: halfExtents.y
    hz: halfExtents.z
    transform: transform
    lengthUnitsPerMeter: physics.world.lengthUnitsPerMeter
  )
  ret addHullCollider(
    physics: physics
    rigidBodies: rigidBodies
    colliders: colliders
    entityId: entityId
    def: def
    hull: hull
  )
}

# Forget the entities of a collider's shapes.
func unmapShapes(physics: mod Physics, collider: view Collider) {
  loop let shapeId: view ShapeId in collider.shapeIds {
    setMappedEntity(
      entities: physics.shapeEntities
      index: shapeId.index1 - 1
      entityId: noEntity()
    )
  }
}

# Destroy the entity's body (and with it its shapes, contacts and joints)
# and drop its RigidBody and Collider. Call it BEFORE clearing the entity's
# other components and freeing it.
func despawnRigidBody(
  physics: mod Physics
  rigidBodies: mod ComponentTable(RigidBody)
  colliders: mod ComponentTable(Collider)
  entityId: view EntityId
) {
  if componentHas(this: colliders, entityId: entityId) {
    unmapShapes(physics: physics, collider: componentView(this: colliders, entityId: entityId))
    componentRemove(this: colliders, entityId: entityId)
  }
  if componentHas(this: rigidBodies, entityId: entityId) {
    let bodyId: BodyId = componentView(this: rigidBodies, entityId: entityId).bodyId
    destroyBody(world: physics.world, bodyId: bodyId)
    setMappedEntity(entities: physics.bodyEntities, index: bodyId.index1 - 1, entityId: noEntity())
    componentRemove(this: rigidBodies, entityId: entityId)
  }
}

# The static body the venue's shapes go on, created on first use.
func venueBody(physics: mod Physics) ret BodyId {
  if physics.venueBodyId.index1 is 0 {
    physics.venueBodyId = createBody(
      world: physics.world
      def: defaultBodyDef(lengthUnitsPerMeter: physics.world.lengthUnitsPerMeter)
    )
  }
  ret physics.venueBodyId
}

# The stride of Mesh3d's interleaved vertices: position, normal, uv.
const renderVertexStride: Int = 8

# A static venue collider from a render mesh's arrays (lib/Mesh3d's
# MeshData: interleaved vertices `verts`, `vertCount` of them, and
# `indices`; VenueMesh.addVenueMesh takes the MeshData itself): its
# positions placed by `transform`, its triangles as they are, welded and
# with the edges identified (so bodies slide over the triangle seams). None
# if the mesh has no triangles.
func addVenueTriangles(
  physics: mod Physics
  verts: view List(Float)
  vertCount: view Int
  renderIndices: view List(Int)
  transform: view Transform
  def: view ShapeDef
) ret opt ShapeId {
  let vertices: List(Vec3) = List.create(Vec3, cap: vertCount)
  loop var i: Int = 0, i < vertCount, ++i {
    let base: Int = i * renderVertexStride
    let local: Vec3 = {
      x: verts.copyAtDefault(index: base)
      y: verts.copyAtDefault(index: base + 1)
      z: verts.copyAtDefault(index: base + 2)
    }
    vertices.add(value: transformPoint(transform: transform, point: local))
  }
  let indices: List(Int) = List.create(Int, cap: renderIndices.length)
  loop let index: view Int in renderIndices {
    indices.add(value: index)
  }
  let meshDef: MeshDef = {
    vertices: vertices
    indices: indices
    materialIndices: List.create(Int, cap: 0)
    weldTolerance: 0.001
    weldVertices: true
    useMedianSplit: false
    identifyEdges: true
    clockWiseWinding: false
  }
  if let data: PhysicsMeshData = createMesh(
    def: meshDef
    lengthUnitsPerMeter: physics.world.lengthUnitsPerMeter
  ) {
    let shapeId: ShapeId = createMeshShape(
      world: physics.world
      bodyId: venueBody(physics: physics)
      def: def
      mesh: data
      scale: Vec3 { x: 1.0, y: 1.0, z: 1.0 }
    )
    physics.venueShapeIds.add(value: shapeId)
    ret shapeId
  }
  ret none
}

# A hand-placed static venue box (where a gameplay edge matters).
func addVenueBox(
  physics: mod Physics
  def: view ShapeDef
  halfExtents: view Vec3
  transform: view Transform
) ret ShapeId {
  let hull: Hull = makeTransformedBoxHull(
    hx: halfExtents.x
    hy: halfExtents.y
    hz: halfExtents.z
    transform: transform
    lengthUnitsPerMeter: physics.world.lengthUnitsPerMeter
  )
  let shapeId: ShapeId = createHullShape(
    world: physics.world
    bodyId: venueBody(physics: physics)
    def: def
    hull: hull
  )
  physics.venueShapeIds.add(value: shapeId)
  ret shapeId
}
