# GbufferBloom — the deferred renderer's bloom (render-perf-8), the render
# graph's `bloom` step between the anti-aliasing and the composite.
#
# A chain of half-size levels in the lit HDR format (rg11b10ufloat where it
# renders): the first level is the composite's source (the anti-aliased
# scene or the TAA result) downsampled with 13 taps, a Karis average against
# fireflies and the soft-knee threshold (bloom_prefilter.wgsl); each next
# level halves it again (bloom_down.wgsl), down to at most bloomMaxLevels
# levels (the smallest mips add nothing visible). Then back up: every level
# is its own downsample plus the level below upsampled with a tent
# (bloom_up.wgsl), into a second set of textures, so no blend state is
# needed. The top of that is what the composite adds, times the intensity,
# before exposure and tone mapping (deferred_composite.wgsl).
#
# An app turns it on with setBloom (RendererDeferred). Off, the pass returns
# at once and allocates nothing, and the composite skips the sample.
import Sys
open Gbuffer
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds
open gpu/GpuTextures
open GbufferResources
open GbufferTargets
open GbufferFullscreen
open GbufferPasses

# Half size, then halved up to five more times: 1/2 .. 1/64 of the scene
const bloomMaxLevels: Int = 6

# A level whose shorter side would drop below this is not made
const bloomMinSide: Int = 8

# What an app sets. The threshold and knee are in the EXPOSED scene's units
# (what the composite tone-maps, 1.0 is about white): below threshold - knee
# nothing glows, above threshold + knee everything above the threshold does.
# The intensity scales the glow the composite adds.
type BloomSettings {
  enabled: Bool
  threshold: Float
  knee: Float
  intensity: Float
}

func defaultBloomSettings() ret BloomSettings {
  ret BloomSettings { enabled: false, threshold: 1.0, knee: 0.5, intensity: 0.2 }
}

type BloomPassCache {
  settings: BloomSettings
  # RAE_BLOOM=1 / 0 forces bloom on / off over the app's setting (screenshot
  # comparisons); -1 when unset
  envOverride: Int
  objectsMade: Bool
  prefilterPipeline: RenderPipelineId
  downPipeline: RenderPipelineId
  upPipeline: RenderPipelineId
  uniform: BufferId
  sampler: SamplerId
  args: ArgWriter
  # The chain, made for the targets of generation `targetsGen`
  levels: Int
  down: List(TextureId)
  downViews: List(TextureViewId)
  up: List(TextureId)
  upViews: List(TextureViewId)
  targetsGen: Int
  # Bumped each time the chain is (re)made
  gen: Int
  # Per composite source slot (TAA 0/1, lit 2, anti-aliased 3)
  prefilterBinds: List(BindGroupId)
  # Per level: down[i] reads down[i - 1] (index 0 unused), up[i] reads
  # down[i] and the level below
  downBinds: List(BindGroupId)
  upBinds: List(BindGroupId)
}

func bloomOverrideFromEnv() ret Int {
  let text: String = Sys.getEnv(name: "RAE_BLOOM")
  if text is "1" {
    ret 1
  }
  if text is "0" {
    ret 0
  }
  ret -1
}

func bloomEnabled(cache: view BloomPassCache) ret Bool {
  if cache.envOverride >= 0 {
    ret cache.envOverride is 1
  }
  ret cache.settings.enabled
}

func createBloomPassCache() ret BloomPassCache {
  ret BloomPassCache {
    settings: defaultBloomSettings()
    envOverride: bloomOverrideFromEnv()
    objectsMade: false
    prefilterPipeline: noRenderPipelineId()
    downPipeline: noRenderPipelineId()
    upPipeline: noRenderPipelineId()
    uniform: noBufferId()
    sampler: noSamplerId()
    args: createArgs(uniform: true)
    levels: 0
    down: fillTextureIds(count: bloomMaxLevels)
    downViews: fillTextureViewIds(count: bloomMaxLevels)
    up: fillTextureIds(count: bloomMaxLevels)
    upViews: fillTextureViewIds(count: bloomMaxLevels)
    targetsGen: -1
    gen: 0
    prefilterBinds: fillBindGroupIds(count: 4)
    downBinds: fillBindGroupIds(count: bloomMaxLevels)
    upBinds: fillBindGroupIds(count: bloomMaxLevels)
  }
}

func ensureBloomObjects(
  cache: mod BloomPassCache
  resources: mod GpuResources
  format: copy Int32
) {
  if cache.objectsMade {
    ret
  }
  cache.objectsMade = true
  let prefilterShader: Shader = shader(files: ["lib/bloom_common.wgsl", "lib/bloom_prefilter.wgsl"])
  let downShader: Shader = shader(files: ["lib/bloom_common.wgsl", "lib/bloom_down.wgsl"])
  let upShader: Shader = shader(files: ["lib/bloom_common.wgsl", "lib/bloom_up.wgsl"])
  cache.prefilterPipeline = createFullscreenPipeline(
    resources: resources
    shader: prefilterShader
    format: format
  )
  cache.downPipeline = createFullscreenPipeline(
    resources: resources
    shader: downShader
    format: format
  )
  cache.upPipeline = createFullscreenPipeline(
    resources: resources
    shader: upShader
    format: format
  )
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 16
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
  if let sampler: SamplerId = createSampler(resources: resources) {
    cache.sampler = sampler
  }
}

func bloomPipelinesValid(cache: view BloomPassCache, resources: view GpuResources) ret Bool {
  ret isValidRenderPipeline(resources: resources, id: cache.prefilterPipeline) and isValidRenderPipeline(
    resources: resources
    id: cache.downPipeline
  ) and isValidRenderPipeline(resources: resources, id: cache.upPipeline)
}

func retireBloomBinds(cache: mod BloomPassCache, resources: mod GpuResources) {
  retireBindGroupIds(resources: resources, list: cache.prefilterBinds)
  retireBindGroupIds(resources: resources, list: cache.downBinds)
  retireBindGroupIds(resources: resources, list: cache.upBinds)
}

func retireBloomChain(cache: mod BloomPassCache, resources: mod GpuResources) {
  retireBloomBinds(cache: cache, resources: resources)
  retireTextureViewIds(resources: resources, list: cache.downViews)
  retireTextureIds(resources: resources, list: cache.down)
  retireTextureViewIds(resources: resources, list: cache.upViews)
  retireTextureIds(resources: resources, list: cache.up)
  cache.levels = 0
  cache.targetsGen = -1
}

# The chain for the current targets: made on the first frame bloom is on and
# again after a resize (the targets' generation changed).
func ensureBloomChain(
  cache: mod BloomPassCache
  resources: mod GpuResources
  targets: view DeferredTargets
) ret Bool {
  if cache.targetsGen is targets.gen and cache.levels > 0 {
    ret true
  }
  retireBloomChain(cache: cache, resources: resources)
  let usage: UInt64 = WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
  var width: Int = (targets.width + 1) / 2
  var height: Int = (targets.height + 1) / 2
  var levels: Int = 0
  var ok: Bool = true
  loop levels < bloomMaxLevels and width >= bloomMinSide and height >= bloomMinSide and ok {
    var downTexture: TextureId = noTextureId()
    var downView: TextureViewId = noTextureViewId()
    var upTexture: TextureId = noTextureId()
    var upView: TextureViewId = noTextureViewId()
    ok = makeTarget(
      resources: resources
      width: width
      height: height
      format: targets.litFormat
      usage: usage
      texture: downTexture
      textureView: downView
    ) and makeTarget(
      resources: resources
      width: width
      height: height
      format: targets.litFormat
      usage: usage
      texture: upTexture
      textureView: upView
    )
    cache.down.set(index: levels, value: downTexture)
    cache.downViews.set(index: levels, value: downView)
    cache.up.set(index: levels, value: upTexture)
    cache.upViews.set(index: levels, value: upView)
    levels = levels + 1
    width = (width + 1) / 2
    height = (height + 1) / 2
  }
  if not ok or levels < 2 {
    retireBloomChain(cache: cache, resources: resources)
    ret false
  }
  cache.levels = levels
  cache.targetsGen = targets.gen
  cache.gen = cache.gen + 1
  ret true
}

func bloomBind(
  resources: mod GpuResources
  pipeline: view RenderPipelineId
  entries: view List(ResourceRef)
) ret BindGroupId {
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: pipeline
    entries: entries
  ) {
    ret bind
  }
  ret noBindGroupId()
}

func bloomViewRef(views: view List(TextureViewId), index: copy Int) ret ResourceRef {
  ret textureViewRef(id: views.copyAtFallback(index: index, fallback: noTextureViewId()))
}

func bloomBindAt(list: view List(BindGroupId), index: copy Int) ret BindGroupId {
  ret list.copyAtFallback(index: index, fallback: noBindGroupId())
}

func ensureBloomBinds(
  cache: mod BloomPassCache
  resources: mod GpuResources
  targets: view DeferredTargets
  sourceIndex: copy Int
) {
  if not bindGroupIsUsable(
    resources: resources
    id: bloomBindAt(list: cache.prefilterBinds, index: sourceIndex)
  ) {
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: cache.uniform))
    entries.add(value: compositeSourceRef(targets: targets))
    entries.add(value: samplerRef(id: cache.sampler))
    cache.prefilterBinds.set(
      index: sourceIndex
      value: bloomBind(resources: resources, pipeline: cache.prefilterPipeline, entries: entries)
    )
  }
  loop var i: Int = 1, i < cache.levels, ++i {
    if not bindGroupIsUsable(resources: resources, id: bloomBindAt(list: cache.downBinds, index: i)) {
      var entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
      entries.add(value: bloomViewRef(views: cache.downViews, index: i - 1))
      entries.add(value: samplerRef(id: cache.sampler))
      cache.downBinds.set(
        index: i
        value: bloomBind(resources: resources, pipeline: cache.downPipeline, entries: entries)
      )
    }
  }
  loop var i: Int = 0, i < cache.levels - 1, ++i {
    if not bindGroupIsUsable(resources: resources, id: bloomBindAt(list: cache.upBinds, index: i)) {
      var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
      entries.add(value: bloomViewRef(views: cache.downViews, index: i))
      # The lowest up step reads the smallest downsample; the others read
      # the up level below
      if i is cache.levels - 2 {
        entries.add(value: bloomViewRef(views: cache.downViews, index: i + 1))
      } else {
        entries.add(value: bloomViewRef(views: cache.upViews, index: i + 1))
      }
      entries.add(value: samplerRef(id: cache.sampler))
      cache.upBinds.set(
        index: i
        value: bloomBind(resources: resources, pipeline: cache.upPipeline, entries: entries)
      )
    }
  }
}

func bloomBindsUsable(
  cache: view BloomPassCache
  resources: view GpuResources
  sourceIndex: copy Int
) ret Bool {
  if not bindGroupIsUsable(
    resources: resources
    id: bloomBindAt(list: cache.prefilterBinds, index: sourceIndex)
  ) {
    ret false
  }
  loop var i: Int = 1, i < cache.levels, ++i {
    if not bindGroupIsUsable(resources: resources, id: bloomBindAt(list: cache.downBinds, index: i)) {
      ret false
    }
  }
  loop var i: Int = 0, i < cache.levels - 1, ++i {
    if not bindGroupIsUsable(resources: resources, id: bloomBindAt(list: cache.upBinds, index: i)) {
      ret false
    }
  }
  ret true
}

func bloomTargetView(
  views: view List(TextureViewId)
  index: copy Int
  resources: view GpuResources
) ret Ptr {
  unsafe {
    ret textureViewHandle(
      resources: resources
      id: views.copyAtFallback(index: index, fallback: noTextureViewId())
    )
  }
}

# The render graph's bloom step. Records prefilter, downs and ups into the
# frame's post recording and tells the composite (targets.bloom*) what to add.
func bloomPass(
  cache: mod BloomPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  exposure: view Float
) {
  targets.bloomWritten = false
  if not bloomEnabled(cache: cache) {
    ret
  }
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  ensureBloomObjects(cache: cache, resources: resources, format: targets.litFormat)
  if not bloomPipelinesValid(cache: cache, resources: resources) {
    ret
  }
  if not ensureBloomChain(cache: cache, resources: resources, targets: targets) {
    ret
  }
  let sourceIndex: Int = compositeSourceIndex(targets: targets)
  ensureBloomBinds(
    cache: cache
    resources: resources
    targets: targets
    sourceIndex: sourceIndex
  )
  if not bloomBindsUsable(cache: cache, resources: resources, sourceIndex: sourceIndex) {
    ret
  }
  resetArgs(writer: cache.args)
  pushVec4F(
    writer: cache.args
    x: cache.settings.threshold
    y: cache.settings.knee
    z: exposure
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: cache.args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )
  unsafe {
    let encoder: Ptr = postEncoder(targets: targets, resources: resources)
    runFullscreenInBatch(
      encoder: encoder
      resources: resources
      pipeline: cache.prefilterPipeline
      bind: bloomBindAt(list: cache.prefilterBinds, index: sourceIndex)
      target: bloomTargetView(views: cache.downViews, index: 0, resources: resources)
    )
    loop var i: Int = 1, i < cache.levels, ++i {
      runFullscreenInBatch(
        encoder: encoder
        resources: resources
        pipeline: cache.downPipeline
        bind: bloomBindAt(list: cache.downBinds, index: i)
        target: bloomTargetView(views: cache.downViews, index: i, resources: resources)
      )
    }
    var i: Int = cache.levels - 2
    loop i >= 0 {
      runFullscreenInBatch(
        encoder: encoder
        resources: resources
        pipeline: cache.upPipeline
        bind: bloomBindAt(list: cache.upBinds, index: i)
        target: bloomTargetView(views: cache.upViews, index: i, resources: resources)
      )
      i = i - 1
    }
  }
  targets.bloomView = cache.upViews.copyAtFallback(index: 0, fallback: noTextureViewId())
  targets.bloomIntensity = cache.settings.intensity
  targets.bloomGen = cache.gen
  targets.bloomWritten = true
}

func bloomPassShutdown(cache: mod BloomPassCache, resources: mod GpuResources) {
  retireBloomChain(cache: cache, resources: resources)
  retireRenderPipeline(resources: resources, id: cache.prefilterPipeline)
  retireRenderPipeline(resources: resources, id: cache.downPipeline)
  retireRenderPipeline(resources: resources, id: cache.upPipeline)
  retireBuffer(resources: resources, id: cache.uniform)
  retireSampler(resources: resources, id: cache.sampler)
  let settings: BloomSettings = cache.settings
  cache = createBloomPassCache()
  cache.settings = settings
}
