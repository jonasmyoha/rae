    nativeG3dPresentFrame(texture: texture, width: width, height: height)
  }
}

# TAA (#514): C ensures the pipeline/bind, uploads the blend params, flips
# history-valid and returns the current history slot (or -1); Rae encodes the
# fullscreen resolve into taa_view[cur].
