func g3dTonemapPending() ret Int {
  unsafe {
    ret nativeG3dTonemapPending()
  }
}

# #920: present copies the canvas-owned offscreen texture (borrowed here).
func nativeG3dPresentFrame(
  texture: Ptr
  width: Int
  height: Int
) unsafe extern("rae_g3d_present_frame")

func g3dPresentFrame(texture: copy Ptr, width: copy Int, height: copy Int) {
