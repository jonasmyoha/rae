# Gpu3dNative — the C-ABI accessor layer of Gpu3d (#918 split for the
# 1000-line cap): every `native*` extern and the thin `g3d*` / mesh / shadow /
# skin wrappers that hand the Rae passes their C-owned handles (views,
# pipelines, bind groups, buffers, counters). Nothing here is app-facing; the
# frame API (beginScene / draw / end / submit, the passes) stays in Gpu3d.
open Shadow3d
import GbufferShadow
open Sky
import Math
open Vec3
open Scene3d
open Math3d
open ecs/Entity  # #793: World3d shadow path reads entities/components
open ecs/ComponentTable
open webgpu/Webgpu
open webgpu/Context
open Gpu3d

# Frame prepare (#514): C packs+uploads the per-frame uniform and returns 1 when
# the device/targets are ready; the render pass is then built in Rae below.
func nativeG3dFramePrepare(
  frame: view Buffer(Float)
  count: Int
) unsafe extern("rae_g3d_frame_prepare") ret Int

func g3dFramePrepare(frame: view Buffer(Float), count: copy Int) ret Int {
  unsafe {
    ret nativeG3dFramePrepare(frame: frame, count: count)
  }
}

# Forward target-view + pipeline handle accessors (ungated platform ABI,
# mirroring the deferred rae_gb_* accessors).
func g3dHdrView() unsafe extern("rae_g3d_hdr_view") ret Ptr

func g3dNormalView() unsafe extern("rae_g3d_normal_view") ret Ptr

func g3dVelocityView() unsafe extern("rae_g3d_velocity_view") ret Ptr

func g3dAmbientView() unsafe extern("rae_g3d_ambient_view") ret Ptr

func g3dDepthView() unsafe extern("rae_g3d_depth_view") ret Ptr

func g3dPipeline() unsafe extern("rae_g3d_pipeline") ret Ptr

func g3dBind() unsafe extern("rae_g3d_bind") ret Ptr

# Hand the Rae-built encoder + render pass back to C so the still-C end/submit
# path (and metaballs/skinned draws) encode into them.
func g3dSetFrame(enc: Ptr, pass: Ptr) unsafe extern("rae_g3d_set_frame")

# Forward mesh draw (#514): C does the shared CPU bookkeeping (validate mesh +
# draw limit, pack the 40-float record, return the firstInstance slot or -1);
# Rae encodes the instanced DrawIndexed below.
func nativeG3dPushDrawRecord(
  mesh: Int
  model: view Mat4
  prevModel: view Mat4
  r: Float
  g: Float
  b: Float
  metallic: Float
  emR: Float
  emG: Float
  emB: Float
  roughness: Float
) unsafe extern("rae_g3d_push_draw_record") ret Int

func g3dPushDrawRecord(
  mesh: copy Int
  model: view Mat4
  prevModel: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  metallic: copy Float
  emR: copy Float
  emG: copy Float
  emB: copy Float
  roughness: copy Float
) ret Int {
  unsafe {
    ret nativeG3dPushDrawRecord(
      mesh: mesh
      model: model
      prevModel: prevModel
      r: r
      g: g
      b: b
      metallic: metallic
      emR: emR
      emG: emG
      emB: emB
      roughness: roughness
    )
  }
}

# The current scene pass (set by beginForward via g3dSetFrame). draw() reads it
# to encode; the still-C end/submit/skinned path reads the same global.
func g3dPass() unsafe extern("rae_g3d_pass") ret Ptr

# Metaball cluster (#514): C ensures the SDF pipeline, takes a per-frame group
# slot, packs+uploads the balls/colors/params, and returns the slot (or -1);
# Rae encodes the SDF fullscreen draw and restores the geometry pipeline/bind.
func nativeG3dPushMetaballCluster(
  packedBalls: view Buffer(Float)
  count: Int
  packedColors: view Buffer(Float)
  smoothing: Float
  metallic: Float
  roughness: Float
  emR: Float
  emG: Float
  emB: Float
) unsafe extern("rae_g3d_push_metaball_cluster") ret Int

func g3dPushMetaballCluster(
  packedBalls: view Buffer(Float)
  count: copy Int
  packedColors: view Buffer(Float)
  smoothing: copy Float
  metallic: copy Float
  roughness: copy Float
  emR: copy Float
  emG: copy Float
  emB: copy Float
) ret Int {
  unsafe {
    ret nativeG3dPushMetaballCluster(
      packedBalls: packedBalls
      count: count
      packedColors: packedColors
      smoothing: smoothing
      metallic: metallic
      roughness: roughness
      emR: emR
      emG: emG
      emB: emB
    )
  }
}

func g3dSdfPipeline() unsafe extern("rae_g3d_sdf_pipeline") ret Ptr

func g3dSdfBind(slot: Int) unsafe extern("rae_g3d_sdf_bind") ret Ptr

# Scene-pass finish primitives (#514): Rae ends the pass + finishes the command
