# Sky (#514): C ensures the pipeline, packs+uploads the sky uniform (with the
# Hosek table Rae pushed), returns 1 to proceed / 0 to skip; Rae encodes the
# fullscreen sky draw into the scene pass and restores the geometry pipeline.
func g3dSkyPrepare(
  skyKind: Float
  turbidity: Float
  skyExposure: Float
  sunSizeRad: Float
  sunX: Float
  sunY: Float
  sunZ: Float
  sunR: Float
  sunG: Float
  sunB: Float
  zenR: Float
  zenG: Float
  zenB: Float
  bands: Float
  horR: Float
  horG: Float
  horB: Float
  discI: Float
  clearR: Float
  clearG: Float
  clearB: Float
) unsafe extern("rae_g3d_sky_prepare") ret Int

func g3dSkyPipeline() unsafe extern("rae_g3d_sky_pipeline") ret Ptr

func g3dSkyBind() unsafe extern("rae_g3d_sky_bind") ret Ptr

# ----- shadows (#382) -------------------------------------------------
# Cascaded shadow maps for the sun. The cascade FIT is in lib/shadow3d.rae
# (pure arithmetic, unit-tested); these only move it to the GPU and
# rasterise the casters.
# The shadow-map feed (cascade uniforms + draw queue) is bookkeeping, not a pass
# encoder — the shadow render itself is in Rae (GbufferShadow.shadowEnd, #504).
# So these bind the shadow-map C helpers under the rae_sm_* prefix (#514), the
# same prefix the shadow accessors already use.
func shadowBegin(
  cascades: view Buffer(Float)
  count: Int
  resolution: Int
  splits: view Buffer(Float)
  texelWorld: view Buffer(Float)
  depthRange: view Buffer(Float)
) unsafe extern("rae_sm_begin")

func nativeShadowDraw(
  mesh: Int
  vbuf: Ptr
  ibuf: Ptr
  icount: Int
  model: view Mat4
) unsafe extern("rae_sm_queue_mesh")

func shadowDraw(
  mesh: copy Int
  vbuf: copy Ptr
  ibuf: copy Ptr
  icount: copy Int
  model: view Mat4
) {
  unsafe {
    nativeShadowDraw(
      mesh: mesh
      vbuf: vbuf
      ibuf: ibuf
      icount: icount
      model: model
    )
  }
}

# #921: a skinned caster by its SkinStore handles; `palette` is the store's
# palette buffer, borrowed by the C shadow pass for its skin bind.
func nativeShadowDrawSkinned(
  mesh: Int
  vbuf: Ptr
  ibuf: Ptr
  icount: Int
  palette: Ptr
  model: view Mat4
  paletteBase: Int
) unsafe extern("rae_sm_queue_skinned")

func shadowDrawSkinned(
  mesh: copy Int
  vbuf: copy Ptr
  ibuf: copy Ptr
  icount: copy Int
  palette: copy Ptr
  model: view Mat4
  paletteBase: copy Int
) unsafe {
  unsafe {
    nativeShadowDrawSkinned(
      mesh: mesh
      vbuf: vbuf
      ibuf: ibuf
      icount: icount
      palette: palette
      model: model
      paletteBase: paletteBase
    )
  }
}

func nativeShadowMetaballs(
  packedBalls: view Buffer(Float)
  count: Int
  smoothing: Float
) unsafe extern("rae_sm_record_metaballs")

func nativeShadowDrawCount() unsafe extern("rae_sm_draw_count") ret Int

func shadowDrawCount() ret Int {
  unsafe {
    ret nativeShadowDrawCount()
  }
}

func nativeShadowShutdown() unsafe extern("rae_sm_shutdown")

func shadowShutdown() {
  unsafe {
    nativeShadowShutdown()
  }
}

# ----- skinned meshes (#374) ------------------------------------------
# A second vertex format and pipeline for skeletally animated geometry.
# Separate from the static path because a ground plane should not carry
# joint indices it can never read — see runtime_gpu3d_skin.c. #921: the
# meshes + the palette are the renderer's SkinStore; C keeps the forward
# skin pipeline and its per-draw record buffer.
# Skinned draw (#514): C validates the draw limit, uploads the per-draw record
# and returns the firstInstance slot (or -1); Rae encodes the instanced
# DrawIndexed. `palette` is the SkinStore's palette handle (#921), borrowed for
# the C skin bind (rebuilt when it changes).
func nativeG3dPushSkinnedDraw(
  mesh: Int
  model: view Mat4
  r: Float
  g: Float
  b: Float
  metallic: Float
  roughness: Float
  palette: Ptr
) unsafe extern("rae_g3d_push_skinned_draw") ret Int

func g3dPushSkinnedDraw(
  mesh: copy Int
  model: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  metallic: copy Float
  roughness: copy Float
  palette: copy Ptr
) unsafe ret Int {
  unsafe {
    ret nativeG3dPushSkinnedDraw(
      mesh: mesh
      model: model
      r: r
      g: g
      b: b
      metallic: metallic
      roughness: roughness
      palette: palette
    )
  }
}

func g3dSkinPipeline() unsafe extern("rae_g3d_skin_pipeline") ret Ptr

func g3dSkinBind() unsafe extern("rae_g3d_skin_bind") ret Ptr

