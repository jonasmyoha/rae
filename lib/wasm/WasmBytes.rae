# WasmBytes — byte work for lib/wasm that needs no engine: NUL-terminated
# names for the C glue, zeroed buffers, and reading a module's custom
# sections (docs/wasm-embedding.md) and the `rae.interface` requests
# (docs/wasm-interfaces.md §3, §4) from its bytes.
import Json
import String

func wasmBytesZ(text: view String) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: text.length() + 1)
  loop var i: Int = 0, i < text.length(), ++i {
    bytes.add(value: text.byteAt(index: i) as UInt8)
  }
  bytes.add(value: 0)
  ret bytes
}

func wasmZeroBytes(count: view Int) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: count)
  loop var i: Int = 0, i < count, ++i {
    bytes.add(value: 0)
  }
  ret bytes
}

# An unsigned LEB128 number at `position`: its value and the position after
# it; `ok` false when it runs past the bytes or is longer than 5 bytes
type WasmLeb {
  value: Int
  next: Int
  ok: Bool
}

func wasmReadLeb(bytes: view List(UInt8), position: view Int) ret WasmLeb {
  var value: Int = 0
  var shift: Int = 0
  var at: Int = position
  loop shift < 35 {
    if at >= bytes.length {
      ret WasmLeb { value: 0, next: at, ok: false }
    }
    let byte: Int = bytes.copyAtFallback(index: at, fallback: 0) as Int
    at = at + 1
    value = value bitor ((byte bitand 127) shl shift)
    if (byte bitand 128) is 0 {
      ret WasmLeb { value: value, next: at, ok: true }
    }
    shift = shift + 7
  }
  ret WasmLeb { value: 0, next: at, ok: false }
}

# The text of the custom section `name` in a module's bytes, "" when there is
# none. Read here, in Rae, from the bytes: after the 8-byte header every
# section is an id byte, a LEB128 size and its contents, and a custom section
# (id 0) starts with its name. (WAMR answers custom sections only when built
# with them, which this build is not.)
func wasmCustomSectionText(bytes: view List(UInt8), name: view String) ret String {
  var position: Int = 8
  loop position < bytes.length {
    let id: Int = bytes.copyAtFallback(index: position, fallback: 0) as Int
    let size: WasmLeb = wasmReadLeb(bytes: bytes, position: position + 1)
    let end: Int = size.next + size.value
    if size.ok is false or end > bytes.length {
      ret ""
    }
    if id is 0 {
      let nameLength: WasmLeb = wasmReadLeb(bytes: bytes, position: size.next)
      let payload: Int = nameLength.next + nameLength.value
      if nameLength.ok and payload <= end {
        let found: String = String.fromBytes(
          bytes: bytes
          start: nameLength.next
          count: nameLength.value
        )
        if found is name {
          ret String.fromBytes(bytes: bytes, start: payload, count: end - payload)
        }
      }
    }
    position = end
  }
  ret ""
}

# The `requests` of a `rae.interface` section's text, or none when there is no
# section (a module not built by Rae) or it does not parse
func wasmInterfaceRequests(interfaceText: view String) ret opt List(String) {
  if interfaceText.length() is 0 {
    ret none
  }
  let doc: JsonDoc = Json.parseJson(source: interfaceText)
  if doc.ok is false {
    ret none
  }
  var requests: List(String) = List.create(String, cap: 4)
  let index: Int = Json.field(doc: doc, this: Json.root(doc: doc), key: "requests")
  if index >= 0 {
    let array: JsonValue = Json.jsonValueAt(doc: doc, idx: index)
    loop var i: Int = 0, i < Json.arrayLen(this: array), ++i {
      requests.add(
        value: Json.jsonString(this: Json.arrayAt(doc: doc, this: array, idx: i), fallback: "")
      )
    }
  }
  ret requests
}
