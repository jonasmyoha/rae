# Readiness polling over many sockets (docs/server-benchmarks-design.md §9 G2,
# §1.2): which of the watched sockets can be read or written now.
#
# The policy is Rae over the one-call shims in lib/net/NetSystem.rae: what an
# interest change means, retrying a wait a signal interrupted, and turning raw
# events into `Readiness` values. The API is the same whatever the kernel
# mechanism: kqueue on Apple and the BSDs, epoll on a Linux kernel (decision
# F8); elsewhere a poller answers `unsupported`.
#
# epoll keeps ONE interest mask per descriptor, where kqueue keeps one per
# direction. So an epoll poller is two queues: one for reading, one for
# writing, the writing queue watched inside the reading one (an epoll queue is
# itself readable when it has events). Watching or forgetting a direction is
# then one change on that direction's queue, exactly as with kqueue, and no
# table of masks has to be kept (closing a socket leaves both queues).
#
# A PollerWaker (`pollerAddWaker`) lets another thread end a wait early:
# `pollerWake` is one thread-safe system call (a kqueue user event, or an
# eventfd on Linux), and the wait reports it as a Readiness that is `woken`.
#
# A wait allocates nothing: the poller owns its raw-event buffer, made once,
# and `pollWait` refills the caller's `List(Readiness)` (cleared, its capacity
# kept). A socket watched for both reading and writing can appear twice in one
# wait, once per direction.
open net/NetSystem
open net/Tcp

type Poller {
  # The kernel queue's handle, -1 when there is none (epoll: the read queue)
  handle: Int
  # epoll only: the write queue, watched inside `handle`; -1 otherwise
  writeHandle: Int
  status: NetStatus
  # (handle, filter, flags) per raw event of the last wait
  rawEvents: List(Int)
  # The waker's handle: the eventfd (epoll) or the user event's ident
  # (kqueue); -1 while the poller has none
  wakeHandle: Int = -1
}

# What wakes a poller from another thread: a copy is handed to each worker,
# which calls `pollerWake` with it. Only valid while its poller is open.
type PollerWaker {
  # kqueue: the poller's queue; -1 on epoll
  queue: Int
  # kqueue: the user event's ident; epoll: the eventfd
  handle: Int
}

# The ident of a poller's user event (kqueue keeps user events apart from
# socket events by filter, so any number is free)
const pollerWakeIdent: Int = 1

# One socket that can make progress now
type Readiness {
  socketId: SocketId
  # Data (or a connection, on a listener) is waiting to be read
  readable: Bool
  # The send buffer has room
  writable: Bool
  # The peer closed its side: a read answers what is left, then endOfStream
  closed: Bool
  # The kernel reported an error for this socket
  failed: Bool
  # Not a socket: the poller's waker was woken (`socketId` is no socket)
  woken: Bool = false
}

func noPoller(status: view NetStatus) ret Poller {
  ret Poller { handle: -1, writeHandle: -1, status: status, rawEvents: {} }
}

# A new poller watching nothing. Its `status` says why there is none.
func createPoller() ret Poller {
  when hasKqueue {
    unsafe {
      let code: Int = systemPollerCreate()
      if code < 0 {
        ret noPoller(status: netStatusFromCode(code: code))
      }
      let closeOnExec: Int = systemSetCloseOnExec(handle: code)
      let maxEvents: Int = netConstant(which: pollMaxWaitEvents)
      ret Poller {
        handle: code
        writeHandle: -1
        status: NetStatus.ok
        rawEvents: List.create(Int, cap: maxEvents * 3)
      }
    }
  } else when hasEpoll {
    unsafe {
      let readQueue: Int = systemEpollCreate()
      if readQueue < 0 {
        ret noPoller(status: netStatusFromCode(code: readQueue))
      }
      let writeQueue: Int = systemEpollCreate()
      if writeQueue < 0 {
        let closed: Int = systemClose(handle: readQueue)
        ret noPoller(status: netStatusFromCode(code: writeQueue))
      }
      let nested: Int = systemEpollControl(
        queue: readQueue
        operation: netConstant(which: epollAdd)
        handle: writeQueue
        events: netConstant(which: epollIn)
      )
      if nested < 0 {
        let closedRead: Int = systemClose(handle: readQueue)
        let closedWrite: Int = systemClose(handle: writeQueue)
        ret noPoller(status: netStatusFromCode(code: nested))
      }
      let maxEvents: Int = netConstant(which: pollMaxWaitEvents)
      ret Poller {
        handle: readQueue
        writeHandle: writeQueue
        status: NetStatus.ok
        rawEvents: List.create(Int, cap: maxEvents * 3)
      }
    }
  }
  ret noPoller(status: NetStatus.unsupported)
}

# One interest change in one direction, retried if a signal interrupted it:
# `reading` picks the direction, `adding` whether to watch or forget it
func changeInterest(
  poller: view Poller
  socketId: view SocketId
  reading: view Bool
  adding: view Bool
) ret NetStatus {
  if poller.handle < 0 {
    ret poller.status
  }
  when hasKqueue {
    var filter: Int = pollFilterWrite
    if reading {
      filter = pollFilterRead
    }
    var change: Int = pollChangeDelete
    if adding {
      change = pollChangeAdd
    }
    unsafe {
      loop {
        let code: Int = systemPollerChange(
          queue: poller.handle
          handle: socketId.handle
          filter: netConstant(which: filter)
          flags: netConstant(which: change)
        )
        if code >= 0 {
          ret NetStatus.ok
        }
        if not isError(code: code, which: errorInterrupted) {
          ret netStatusFromCode(code: code)
        }
      }
    }
  } else when hasEpoll {
    # The direction's own queue; reading also wants the peer's hang-up
    var queue: Int = poller.writeHandle
    var events: Int = netConstant(which: epollOut)
    if reading {
      queue = poller.handle
      events = netConstant(which: epollIn) bitor netConstant(which: epollReadHangUp)
    }
    var operation: Int = netConstant(which: epollDelete)
    if adding {
      operation = netConstant(which: epollAdd)
    }
    unsafe {
      loop {
        let code: Int = systemEpollControl(
          queue: queue
          operation: operation
          handle: socketId.handle
          events: events
        )
        # Watched already in this direction: as with kqueue's EV_ADD, fine
        if code >= 0 or (adding and isError(code: code, which: errorExists)) {
          ret NetStatus.ok
        }
        if not isError(code: code, which: errorInterrupted) {
          ret netStatusFromCode(code: code)
        }
      }
    }
  }
  ret NetStatus.unsupported
}

# Give the poller a waker (once; a second call answers the same waker).
# `handle` -1 in the answer means it has none (`poller.status` or the
# platform says why).
func pollerAddWaker(poller: mod Poller) ret PollerWaker {
  if poller.handle < 0 {
    ret PollerWaker { queue: -1, handle: -1 }
  }
  when hasKqueue {
    if poller.wakeHandle < 0 {
      unsafe {
        loop {
          let code: Int = systemPollerChange(
            queue: poller.handle
            handle: pollerWakeIdent
            filter: netConstant(which: pollFilterUser)
            flags: netConstant(which: pollChangeAddClear)
          )
          if code >= 0 {
            poller.wakeHandle = pollerWakeIdent
            break
          }
          if not isError(code: code, which: errorInterrupted) {
            ret PollerWaker { queue: -1, handle: -1 }
          }
        }
      }
    }
    ret PollerWaker { queue: poller.handle, handle: poller.wakeHandle }
  } else when hasEpoll {
    if poller.wakeHandle < 0 {
      unsafe {
        let eventHandle: Int = systemEventFdCreate()
        if eventHandle < 0 {
          ret PollerWaker { queue: -1, handle: -1 }
        }
        let added: Int = systemEpollControl(
          queue: poller.handle
          operation: netConstant(which: epollAdd)
          handle: eventHandle
          events: netConstant(which: epollIn)
        )
        if added < 0 {
          let closed: Int = systemClose(handle: eventHandle)
          ret PollerWaker { queue: -1, handle: -1 }
        }
        poller.wakeHandle = eventHandle
      }
    }
    ret PollerWaker { queue: -1, handle: poller.wakeHandle }
  }
  ret PollerWaker { queue: -1, handle: -1 }
}

# End the poller's wait now (or make its next wait return at once), from any
# thread: one system call. Several wakes before a wait are reported once.
func pollerWake(waker: view PollerWaker) ret NetStatus {
  if waker.handle < 0 {
    ret NetStatus.unsupported
  }
  when hasKqueue {
    unsafe {
      let code: Int = systemPollerTrigger(queue: waker.queue, ident: waker.handle)
      if code < 0 {
        ret netStatusFromCode(code: code)
      }
    }
    ret NetStatus.ok
  } else when hasEpoll {
    unsafe {
      let code: Int = systemEventFdSignal(handle: waker.handle)
      if code < 0 {
        ret netStatusFromCode(code: code)
      }
    }
    ret NetStatus.ok
  }
  ret NetStatus.unsupported
}

# A Readiness for the waker
func wokenReadiness() ret Readiness {
  ret Readiness {
    socketId: SocketId { handle: -1 }
    readable: false
    writable: false
    closed: false
    failed: false
    woken: true
  }
}

# Watch `socketId` for reading, writing or both (a direction not asked for is
# left as it was)
func pollerWatch(
  poller: view Poller
  socketId: view SocketId
  readable: view Bool
  writable: view Bool
) ret NetStatus {
  if readable {
    let status: NetStatus = changeInterest(
      poller: poller
      socketId: socketId
      reading: true
      adding: true
    )
    if status is not NetStatus.ok {
      ret status
    }
  }
  if writable {
    ret changeInterest(
      poller: poller
      socketId: socketId
      reading: false
      adding: true
    )
  }
  ret NetStatus.ok
}

# Stop watching `socketId` in the given directions. Closing a socket removes
# it from the poller on its own; this is for a socket that stays open.
func pollerForget(
  poller: view Poller
  socketId: view SocketId
  readable: view Bool
  writable: view Bool
) ret NetStatus {
  var status: NetStatus = NetStatus.ok
  if readable {
    status = changeInterest(
      poller: poller
      socketId: socketId
      reading: true
      adding: false
    )
  }
  if writable {
    let writeStatus: NetStatus = changeInterest(
      poller: poller
      socketId: socketId
      reading: false
      adding: false
    )
    if status is NetStatus.ok {
      status = writeStatus
    }
  }
  ret status
}

# Wait up to `timeoutMs` (negative: until something is ready) and refill
# `ready` with the sockets that can make progress. `ok` with an empty list
# means the time ran out. A wait a signal interrupted is waited again.
func pollWait(poller: mod Poller, ready: mod List(Readiness), timeoutMs: view Int) ret NetStatus {
  ready.clear()
  if poller.handle < 0 {
    ret poller.status
  }
  when hasKqueue {
    let count: Int = kqueueWait(poller: poller, timeoutMs: timeoutMs)
    if count < 0 {
      ret netStatusFromCode(code: count)
    }
    let readFilter: Int = netConstant(which: pollFilterRead)
    let writeFilter: Int = netConstant(which: pollFilterWrite)
    let endOfFile: Int = netConstant(which: pollFlagEndOfFile)
    let errorFlag: Int = netConstant(which: pollFlagError)
    let userFilter: Int = netConstant(which: pollFilterUser)
    loop var i: Int = 0, i < count, ++i {
      let handle: Int = poller.rawEvents.copyAtFallback(index: i * 3, fallback: -1)
      let filter: Int = poller.rawEvents.copyAtFallback(index: i * 3 + 1, fallback: 0)
      let flags: Int = poller.rawEvents.copyAtFallback(index: i * 3 + 2, fallback: 0)
      if filter is userFilter {
        ready.add(value: wokenReadiness())
        continue
      }
      ready.add(value: Readiness {
        socketId: SocketId { handle: handle }
        readable: filter is readFilter
        writable: filter is writeFilter
        closed: (flags bitand endOfFile) is not 0
        failed: (flags bitand errorFlag) is not 0
      })
    }
    ret NetStatus.ok
  } else when hasEpoll {
    # The read queue reports its sockets and, when the write queue has events,
    # the write queue itself: then take those without waiting
    let count: Int = epollWait(poller: poller, queue: poller.handle, timeoutMs: timeoutMs)
    if count < 0 {
      ret netStatusFromCode(code: count)
    }
    var writesPending: Bool = false
    loop var i: Int = 0, i < count, ++i {
      let handle: Int = poller.rawEvents.copyAtFallback(index: i * 3, fallback: -1)
      if handle is poller.writeHandle {
        writesPending = true
      } else if handle is poller.wakeHandle {
        # reset the eventfd, so the next wait sleeps again
        unsafe {
          let drained: Int = systemEventFdDrain(handle: handle)
        }
        ready.add(value: wokenReadiness())
      } else {
        addEpollReadiness(
          ready: ready
          handle: handle
          events: poller.rawEvents.copyAtFallback(index: i * 3 + 1, fallback: 0)
          writeQueue: false
        )
      }
    }
    if writesPending {
      let writes: Int = epollWait(poller: poller, queue: poller.writeHandle, timeoutMs: 0)
      if writes < 0 {
        ret netStatusFromCode(code: writes)
      }
      loop var i: Int = 0, i < writes, ++i {
        addEpollReadiness(
          ready: ready
          handle: poller.rawEvents.copyAtFallback(index: i * 3, fallback: -1)
          events: poller.rawEvents.copyAtFallback(index: i * 3 + 1, fallback: 0)
          writeQueue: true
        )
      }
    }
    ret NetStatus.ok
  }
  ret NetStatus.unsupported
}

# One kqueue wait into the raw-event buffer, retried after a signal: the
# event count, or a negated errno
func kqueueWait(poller: mod Poller, timeoutMs: view Int) ret Int {
  let maxEvents: Int = poller.rawEvents.cap / 3
  var count: Int = 0
  when hasKqueue {
    unsafe {
      loop {
        count = systemPollerWait(
          queue: poller.handle
          events: poller.rawEvents.data
          maxEvents: maxEvents
          timeoutMs: timeoutMs
        )
        if count >= 0 or not isError(code: count, which: errorInterrupted) {
          break
        }
      }
    }
  }
  if count < 0 {
    poller.rawEvents.length = 0
    ret count
  }
  poller.rawEvents.length = count * 3
  ret count
}

# One epoll wait on `queue` into the raw-event buffer, retried after a signal:
# the event count, or a negated errno
func epollWait(poller: mod Poller, queue: view Int, timeoutMs: view Int) ret Int {
  let maxEvents: Int = poller.rawEvents.cap / 3
  var count: Int = 0
  when hasEpoll {
    unsafe {
      loop {
        count = systemEpollWait(
          queue: queue
          events: poller.rawEvents.data
          maxEvents: maxEvents
          timeoutMs: timeoutMs
        )
        if count >= 0 or not isError(code: count, which: errorInterrupted) {
          break
        }
      }
    }
  }
  if count < 0 {
    poller.rawEvents.length = 0
    ret count
  }
  poller.rawEvents.length = count * 3
  ret count
}

# One epoll event as a Readiness. A hang-up or an error makes a read-queue
# socket readable too, so its owner reads and meets the end of the stream or
# the error, as a kqueue EOF read event does.
func addEpollReadiness(
  ready: mod List(Readiness)
  handle: view Int
  events: view Int
  writeQueue: view Bool
) {
  let hangUp: Int = netConstant(which: epollReadHangUp) bitor netConstant(which: epollHangUp)
  let failed: Bool = (events bitand netConstant(which: epollError)) is not 0
  let closed: Bool = (events bitand hangUp) is not 0
  ready.add(value: Readiness {
    socketId: SocketId { handle: handle }
    readable: not writeQueue
    writable: writeQueue
    closed: closed
    failed: failed
  })
}

# Release the kernel queue (the sockets it watched stay open). A wait on the
# closed poller answers `failed`.
func closePoller(poller: mod Poller) {
  if poller.handle >= 0 {
    unsafe {
      let code: Int = systemClose(handle: poller.handle)
    }
    poller.handle = -1
  }
  if poller.writeHandle >= 0 {
    unsafe {
      let code: Int = systemClose(handle: poller.writeHandle)
    }
    poller.writeHandle = -1
  }
  # epoll's waker is an eventfd of its own; kqueue's user event goes with
  # the queue
  when hasEpoll {
    if poller.wakeHandle >= 0 {
      unsafe {
        let code: Int = systemClose(handle: poller.wakeHandle)
      }
    }
  }
  poller.wakeHandle = -1
  poller.status = NetStatus.failed
}
