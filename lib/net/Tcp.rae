# TCP sockets (docs/server-benchmarks-design.md §9 G1 and §1.2, decision F1).
#
# A socket is a value handle (`SocketId`), stored and passed like any other
# id. Every operation that can fail answers a `NetStatus` with its result —
# never an errno, never a C address struct. Every socket is non-blocking: when
# an operation would have to wait it answers `wouldBlock`, and the caller waits
# for readiness (one socket: `socketWaitReadable`; many: the poller).
#
# This module is the POLICY, in Rae, over the one-call-per-function system
# shim in lib/net/NetSystem.rae (AGENTS.md "Runtime C rule"): the listen
# sequence, retrying a call a signal interrupted, connect with a timeout, the
# options a server always wants (SO_REUSEADDR on listeners; TCP_NODELAY,
# close-on-exec and no SIGPIPE on connections, so a write to a closed peer is
# `connectionReset`, not a dead process) and what each error means.
#
# A SocketId is a handle, not the connection: closing it is explicit
# (`socketClose`), as with every other runtime handle. macOS and Linux;
# elsewhere every call answers `unsupported`.
open net/NetSystem
open net/ByteBuffer

type SocketId {
  handle: Int
}

enum NetStatus {
  ok
  wouldBlock
  endOfStream
  addressInUse
  connectionRefused
  connectionReset
  invalidAddress
  tooManyOpen
  unsupported
  failed
}

# A socket, or why there is none (`socketId` is `noSocket()` unless `ok`)
type SocketResult {
  socketId: SocketId
  status: NetStatus
}

# How many bytes a read or write moved, and its status
type IoResult {
  bytes: Int
  status: NetStatus
}

# How many addresses a name may resolve to that we try (IPv4 and IPv6, a few
# interfaces)
const maxAddressRecords: Int = 8

func noSocket() ret SocketId {
  ret SocketId { handle: -1 }
}

func socketIsValid(socketId: view SocketId) ret Bool {
  ret socketId.handle >= 0
}

# What a failed shim answer (< 0: a negated errno or a marker) means
func netStatusFromCode(code: view Int) ret NetStatus {
  if code >= 0 {
    ret NetStatus.ok
  }
  if code is netConstant(which: unsupportedCode) {
    ret NetStatus.unsupported
  }
  if code is netConstant(which: resolveFailedCode) {
    ret NetStatus.invalidAddress
  }
  if isError(code: code, which: errorTryAgain) or isError(code: code, which: errorWouldBlock) or isError(
    code: code
    which: errorInProgress
  ) {
    ret NetStatus.wouldBlock
  }
  if isError(code: code, which: errorAddressInUse) {
    ret NetStatus.addressInUse
  }
  if isError(code: code, which: errorConnectionRefused) {
    ret NetStatus.connectionRefused
  }
  if isError(code: code, which: errorConnectionReset) or isError(code: code, which: errorBrokenPipe) {
    ret NetStatus.connectionReset
  }
  if isError(code: code, which: errorAddressNotAvailable) or isError(
    code: code
    which: errorFamilyNotSupported
  ) {
    ret NetStatus.invalidAddress
  }
  if isError(code: code, which: errorTooManyFilesProcess) or isError(
    code: code
    which: errorTooManyFilesSystem
  ) {
    ret NetStatus.tooManyOpen
  }
  ret NetStatus.failed
}

func failedSocket(status: view NetStatus) ret SocketResult {
  ret SocketResult { socketId: noSocket(), status: status }
}

func ioResultFromCode(code: view Int) ret IoResult {
  if code >= 0 {
    ret IoResult { bytes: code, status: NetStatus.ok }
  }
  ret IoResult { bytes: 0, status: netStatusFromCode(code: code) }
}

# Turn on non-blocking mode: answers 0 or the failing call's code
func setNonBlocking(handle: view Int) ret Int {
  unsafe {
    let flags: Int = systemGetFileFlags(handle: handle)
    if flags < 0 {
      ret flags
    }
    ret systemSetFileFlags(
      handle: handle
      flags: flags bitor netConstant(which: fileFlagNonBlocking)
    )
  }
}

# The options every connected socket gets: small replies go out at once (no
# Nagle delay), no SIGPIPE where the OS has a socket option for it (Linux
# avoids it per send instead), and not inherited by child processes. They
# are best effort: a failure leaves the socket usable.
func prepareConnected(handle: view Int) {
  unsafe {
    let noDelay: Int = systemSetIntOption(
      handle: handle
      level: netConstant(which: protocolTcp)
      option: netConstant(which: optionTcpNoDelay)
      value: 1
    )
    let noSigPipe: Int = netConstant(which: optionNoSigPipe)
    if noSigPipe >= 0 {
      let set: Int = systemSetIntOption(
        handle: handle
        level: netConstant(which: optionLevelSocket)
        option: noSigPipe
        value: 1
      )
    }
    let closeOnExec: Int = systemSetCloseOnExec(handle: handle)
  }
}

func closeHandle(handle: view Int) {
  unsafe {
    let closed: Int = systemClose(handle: handle)
  }
}

# Listen on `host` ("" = every local address, "127.0.0.1" = this machine
# only) and `port` (0 picks a free port; `socketLocalPort` says which). Tries
# each address the name resolves to: socket, reuse the address (a restarted
# server can rebind at once), close-on-exec, bind, listen, non-blocking.
func tcpListen(host: view String, port: view Int, backlog: view Int) ret SocketResult {
  if port < 0 or port > 65535 {
    ret failedSocket(status: NetStatus.invalidAddress)
  }
  var records: List(UInt8) = List.create(
    UInt8
    cap: maxAddressRecords * netConstant(which: addressRecordBytes)
  )
  var status: NetStatus = NetStatus.invalidAddress
  unsafe {
    let count: Int = systemResolve(
      host: host
      port: port
      passive: true
      records: records.data
      maxRecords: maxAddressRecords
    )
    if count < 0 {
      ret failedSocket(status: netStatusFromCode(code: count))
    }
    var queueLength: Int = backlog
    if queueLength <= 0 {
      queueLength = netConstant(which: listenBacklogMax)
    }
    loop var index: Int = 0, index < count, ++index {
      let handle: Int = systemSocketFor(records: records.data, index: index)
      if handle < 0 {
        status = netStatusFromCode(code: handle)
        continue
      }
      let reuse: Int = systemSetIntOption(
        handle: handle
        level: netConstant(which: optionLevelSocket)
        option: netConstant(which: optionReuseAddress)
        value: 1
      )
      let closeOnExec: Int = systemSetCloseOnExec(handle: handle)
      var code: Int = systemBindTo(handle: handle, records: records.data, index: index)
      if code is 0 {
        code = systemListen(handle: handle, backlog: queueLength)
      }
      if code is 0 {
        code = setNonBlocking(handle: handle)
      }
      if code < 0 {
        status = netStatusFromCode(code: code)
        closeHandle(handle: handle)
        continue
      }
      ret SocketResult { socketId: { handle: handle }, status: NetStatus.ok }
    }
  }
  ret failedSocket(status: status)
}

# Accept one pending connection; `wouldBlock` when none is waiting. A peer
# that gave up before it was accepted is not the listener's failure: that is
# `wouldBlock` too, and the caller goes on.
func tcpAccept(listenerSocketId: view SocketId) ret SocketResult {
  unsafe {
    loop {
      let handle: Int = systemAccept(handle: listenerSocketId.handle)
      if handle >= 0 {
        if setNonBlocking(handle: handle) < 0 {
          closeHandle(handle: handle)
          ret failedSocket(status: NetStatus.failed)
        }
        prepareConnected(handle: handle)
        ret SocketResult { socketId: { handle: handle }, status: NetStatus.ok }
      }
      if isError(code: handle, which: errorInterrupted) {
        continue
      }
      if isError(code: handle, which: errorConnectionAborted) {
        ret failedSocket(status: NetStatus.wouldBlock)
      }
      ret failedSocket(status: netStatusFromCode(code: handle))
    }
  }
  ret failedSocket(status: NetStatus.failed)
}

# Connect to `host`:`port`, waiting up to `timeoutMs` for the connection
# (`wouldBlock` when it did not complete in time). Tries each address: a
# non-blocking connect, then a wait until the socket is writable, then its
# pending error says whether it connected. The socket it answers is
# non-blocking like every other.
func tcpConnect(host: view String, port: view Int, timeoutMs: view Int) ret SocketResult {
  if port < 0 or port > 65535 {
    ret failedSocket(status: NetStatus.invalidAddress)
  }
  var records: List(UInt8) = List.create(
    UInt8
    cap: maxAddressRecords * netConstant(which: addressRecordBytes)
  )
  var status: NetStatus = NetStatus.connectionRefused
  unsafe {
    let count: Int = systemResolve(
      host: host
      port: port
      passive: false
      records: records.data
      maxRecords: maxAddressRecords
    )
    if count < 0 {
      ret failedSocket(status: netStatusFromCode(code: count))
    }
    loop var index: Int = 0, index < count, ++index {
      let handle: Int = systemSocketFor(records: records.data, index: index)
      if handle < 0 {
        status = netStatusFromCode(code: handle)
        continue
      }
      if setNonBlocking(handle: handle) < 0 {
        status = NetStatus.failed
        closeHandle(handle: handle)
        continue
      }
      let code: Int = systemConnectTo(handle: handle, records: records.data, index: index)
      if code < 0 {
        # An interrupted connect carries on in the background, like one in
        # progress
        if not isError(code: code, which: errorInProgress) and not isError(
          code: code
          which: errorInterrupted
        ) {
          status = netStatusFromCode(code: code)
          closeHandle(handle: handle)
          continue
        }
        let ready: Int = systemPollOne(
          handle: handle
          events: netConstant(which: pollWritable)
          timeoutMs: timeoutMs
        )
        if ready <= 0 {
          status = NetStatus.wouldBlock
          closeHandle(handle: handle)
          continue
        }
        let pending: Int = systemSocketError(handle: handle)
        if pending is not 0 {
          var pendingCode: Int = pending
          if pending > 0 {
            pendingCode = -pending
          }
          status = netStatusFromCode(code: pendingCode)
          closeHandle(handle: handle)
          continue
        }
      }
      prepareConnected(handle: handle)
      ret SocketResult { socketId: { handle: handle }, status: NetStatus.ok }
    }
  }
  ret failedSocket(status: status)
}

# Read up to `maxBytes` and APPEND them to `bytes` (growing it if needed).
# `endOfStream` when the peer closed; `wouldBlock` when nothing is there yet.
func socketRead(socketId: view SocketId, bytes: mod List(UInt8), maxBytes: view Int) ret IoResult {
  if maxBytes <= 0 {
    ret IoResult { bytes: 0, status: NetStatus.failed }
  }
  loop bytes.cap - bytes.length < maxBytes {
    bytes.grow()
  }
  unsafe {
    loop {
      let code: Int = systemReceive(
        handle: socketId.handle
        buffer: bytes.data
        offset: bytes.length
        maxBytes: maxBytes
      )
      if code > 0 {
        bytes.length = bytes.length + code
        ret IoResult { bytes: code, status: NetStatus.ok }
      }
      if code is 0 {
        ret IoResult { bytes: 0, status: NetStatus.endOfStream }
      }
      if isError(code: code, which: errorInterrupted) {
        continue
      }
      ret ioResultFromCode(code: code)
    }
  }
  ret IoResult { bytes: 0, status: NetStatus.failed }
}

# Write `count` bytes of `bytes` from `start`. It may write fewer when the
# socket's send buffer is full; `bytes` says how many went out.
func socketWrite(
  socketId: view SocketId
  bytes: view List(UInt8)
  start: view Int
  count: view Int
) ret IoResult {
  if start < 0 or count < 0 or start + count > bytes.length {
    ret IoResult { bytes: 0, status: NetStatus.failed }
  }
  if count is 0 {
    ret IoResult { bytes: 0, status: NetStatus.ok }
  }
  unsafe {
    loop {
      let code: Int = systemSend(
        handle: socketId.handle
        buffer: bytes.data
        offset: start
        count: count
        flags: netConstant(which: sendFlagNoSignal)
      )
      if isError(code: code, which: errorInterrupted) {
        continue
      }
      ret ioResultFromCode(code: code)
    }
  }
  ret IoResult { bytes: 0, status: NetStatus.failed }
}

# Write a String's bytes (small messages; bulk data goes through bytes)
func socketWriteText(socketId: view SocketId, text: view String) ret IoResult {
  if text.length() is 0 {
    ret IoResult { bytes: 0, status: NetStatus.ok }
  }
  unsafe {
    loop {
      let code: Int = systemSendText(
        handle: socketId.handle
        text: text
        flags: netConstant(which: sendFlagNoSignal)
      )
      if isError(code: code, which: errorInterrupted) {
        continue
      }
      ret ioResultFromCode(code: code)
    }
  }
  ret IoResult { bytes: 0, status: NetStatus.failed }
}

# Read up to `maxBytes` onto the end of `buffer` (room is made by compacting
# its consumed front first, growing only when that is not enough)
func socketReadBuffer(
  socketId: view SocketId
  buffer: mod ByteBuffer
  maxBytes: view Int
) ret IoResult {
  if maxBytes <= 0 {
    ret IoResult { bytes: 0, status: NetStatus.failed }
  }
  byteBufferReserve(buffer: buffer, count: maxBytes)
  ret socketRead(socketId: socketId, bytes: buffer.bytes, maxBytes: maxBytes)
}

# Write as much of `buffer`'s unread bytes as the socket takes, and consume
# what went out (the rest stays for the next writable moment)
func socketWriteBuffer(socketId: view SocketId, buffer: mod ByteBuffer) ret IoResult {
  let result: IoResult = socketWrite(
    socketId: socketId
    bytes: buffer.bytes
    start: buffer.start
    count: byteBufferLength(buffer: buffer)
  )
  if result.status is NetStatus.ok {
    consume(buffer: buffer, count: result.bytes)
  }
  ret result
}

# Wait until the socket has data or its peer closed: true, or false after
# `timeoutMs` (-1 waits for ever). For one socket; many use the poller.
func socketWaitReadable(socketId: view SocketId, timeoutMs: view Int) ret Bool {
  if socketId.handle < 0 {
    ret false
  }
  unsafe {
    loop {
      let ready: Int = systemPollOne(
        handle: socketId.handle
        events: netConstant(which: pollReadable)
        timeoutMs: timeoutMs
      )
      if isError(code: ready, which: errorInterrupted) {
        continue
      }
      ret ready > 0
    }
  }
  ret false
}

# The local port the socket is bound to; -1 when it has none
func socketLocalPort(socketId: view SocketId) ret Int {
  if socketId.handle < 0 {
    ret -1
  }
  unsafe {
    let port: Int = systemLocalPort(handle: socketId.handle)
    if port < 0 {
      ret -1
    }
    ret port
  }
}

func socketClose(socketId: view SocketId) {
  if socketId.handle < 0 {
    ret
  }
  closeHandle(handle: socketId.handle)
}

# Bytes `start` .. `start + count` of `bytes` as a String
func textFromBytes(bytes: view List(UInt8), start: view Int, count: view Int) ret String {
  if start < 0 or count <= 0 or start + count > bytes.length {
    ret ""
  }
  unsafe {
    ret systemBytesToText(buffer: bytes.data, offset: start, count: count)
  }
}
