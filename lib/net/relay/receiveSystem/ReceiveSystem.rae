# The relay's receive system: drains the UDP socket each frame. A forward
# packet from a known peer goes straight on to the other side of its
# session, rewritten in place (the destination peer id becomes the source
# peer id) and never read past its header: the hot path allocates nothing
# and copies nothing. Control packets become RelayRequestEvents for the
# session system; a keep-alive marks its peer as heard and is answered.
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open net/Tcp
open net/Udp
open net/Wire
open net/relay/RelayWire
open net/relay/RelayServer

# The most datagrams one frame takes (the rest wait for the next frame)
const maxDatagramsPerFrame: Int = 4096

func receiveSystem(server: mod RelayServer) {
  loop var count: Int = 0, count < maxDatagramsPerFrame, ++count {
    let datagram: Datagram = udpReceive(
      udpSocket: server.udpSocket
      bytes: server.inbox
      maxBytes: relayDatagramBytes
    )
    if datagram.status is NetStatus.wouldBlock {
      ret
    }
    if datagram.status is NetStatus.ok {
      takeDatagram(server: server, from: datagram.peer)
    } else {
      server.stats.packetsDropped = server.stats.packetsDropped + 1
    }
  }
}

func dropped(server: mod RelayServer) {
  server.stats.packetsDropped = server.stats.packetsDropped + 1
}

# A client that talks as a peer, from an address with no peer: it went silent
# for the timeout and does not know. It is told, so it can join again. One byte,
# so a forged source address gains nothing by it.
func answerForgotten(server: mod RelayServer, from: view NetAddress) {
  dropped(server: server)
  relayWriteKind(packet: server.outbox, kind: relayKindForgotten)
  sendOutbox(server: server, address: from)
}

# One datagram in `server.inbox`, from `from`
func takeDatagram(server: mod RelayServer, from: view NetAddress) {
  let length: Int = server.inbox.length
  if length < 1 {
    dropped(server: server)
    ret
  }
  let kind: Int = readU8(bytes: server.inbox, offset: 0)
  let peerEntityId: EntityId = peerAt(server: server, address: from)
  if kind is relayKindForward {
    if isNone(this: peerEntityId) {
      answerForgotten(server: server, from: from)
      ret
    }
    forward(server: server, peerEntityId: peerEntityId)
    ret
  }
  if kind is relayKindKeepAlive {
    if isNone(this: peerEntityId) {
      answerForgotten(server: server, from: from)
      ret
    }
    let peer: mod RelayPeer = componentMod(this: server.peers, entityId: peerEntityId)
    peer.lastHeardNs = server.frameNs
    # Answered, so a quiet client knows the relay is still there
    relayWriteKind(packet: server.outbox, kind: relayKindKeepAlive)
    sendOutbox(server: server, address: from)
    ret
  }
  var request: RelayRequestEvent = {
    kind: kind
    address: from
    requestId: 0
    peerEntityId: peerEntityId
    tokenHigh: 0
    tokenLow: 0
    relayOnly: false
    device: deviceUnknown
    mayOpen: false
  }
  if kind is relayKindLeave {
    if isNone(this: peerEntityId) {
      dropped(server: server)
      ret
    }
  } else if kind is relayKindOpen and length >= 5 {
    request.requestId = readU32(bytes: server.inbox, offset: 1)
    request.relayOnly = length >= 6 and readU8(bytes: server.inbox, offset: 5) is not 0
    if length >= 7 {
      request.device = readU8(bytes: server.inbox, offset: 6)
    }
    # A peer asking again gets its own session back, ticket or not (the session
    # system): the HMAC is only worth computing for a stranger
    request.mayOpen = server.config.openSecret.length is 0 or (isNone(this: peerEntityId) and relayOpenTicketValid(
      secret: server.config.openSecret
      bytes: server.inbox
      start: 7
      count: length - 7
      nowSeconds: relayWallSeconds()
    ))
  } else if kind is relayKindJoin and length >= 5 + relayTokenBytes {
    request.requestId = readU32(bytes: server.inbox, offset: 1)
    request.tokenHigh = readHalf(bytes: server.inbox, offset: 5)
    request.tokenLow = readHalf(bytes: server.inbox, offset: 13)
    request.relayOnly = length >= 6 + relayTokenBytes and readU8(
      bytes: server.inbox
      offset: 5 + relayTokenBytes
    ) is not 0
    if length >= 7 + relayTokenBytes {
      request.device = readU8(bytes: server.inbox, offset: 6 + relayTokenBytes)
    }
  } else {
    dropped(server: server)
    ret
  }
  # A WebSocket peer has no address another peer could reach
  if isWebSocketPeerAddress(address: from) {
    request.relayOnly = true
  }
  eventSend(this: server.requests, value: request)
}

# Pass a forward packet on: host -> the named player, player -> its host
func forward(server: mod RelayServer, peerEntityId: view EntityId) {
  let length: Int = server.inbox.length
  if isNone(this: peerEntityId) or length < forwardHeaderBytes {
    dropped(server: server)
    ret
  }
  let peer: mod RelayPeer = componentMod(this: server.peers, entityId: peerEntityId)
  peer.lastHeardNs = server.frameNs
  let sourcePeerId: Int = peer.peerId
  let sessionEntityId: EntityId = peer.sessionEntityId
  var destinationPeerId: Int = readU32(bytes: server.inbox, offset: 1)
  if sourcePeerId is not hostPeerId {
    # A player reaches only its host
    if destinationPeerId is not hostPeerId {
      dropped(server: server)
      ret
    }
  } else if destinationPeerId is hostPeerId {
    dropped(server: server)
    ret
  }
  let targetEntityId: EntityId = peerInSession(
    server: server
    sessionEntityId: sessionEntityId
    peerId: destinationPeerId
  )
  if not componentHas(this: server.peers, entityId: targetEntityId) {
    dropped(server: server)
    ret
  }
  let target: view RelayPeer = componentView(this: server.peers, entityId: targetEntityId)
  # The destination's id becomes the source's: the receiver learns who sent
  # it, never from where
  server.inbox.set(index: 1, value: ((sourcePeerId shr 24) bitand 255) as UInt8)
  server.inbox.set(index: 2, value: ((sourcePeerId shr 16) bitand 255) as UInt8)
  server.inbox.set(index: 3, value: ((sourcePeerId shr 8) bitand 255) as UInt8)
  server.inbox.set(index: 4, value: (sourcePeerId bitand 255) as UInt8)
  let sent: Bool = relaySendBytes(
    server: server
    bytes: server.inbox
    start: 0
    count: length
    address: target.address
  )
  if sent {
    server.stats.packetsForwarded = server.stats.packetsForwarded + 1
    server.stats.bytesForwarded = server.stats.bytesForwarded + length - forwardHeaderBytes
  } else {
    dropped(server: server)
  }
}
