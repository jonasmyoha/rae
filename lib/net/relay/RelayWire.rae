# The relay's packets (lib/net/relay): what a host or player and the relay
# say to each other over UDP. Shared by the relay (RelayServer and its
# systems) and its clients (RelayClient).
#
# Every packet starts with its kind (1 byte). The ones a client sends:
#   open      host -> relay   request id (4)
#   join      player -> relay request id (4), session token (16)
#   forward   client -> relay destination peer id (4), payload
#   keepAlive client -> relay (nothing)
#   leave     client -> relay (nothing)
# The ones the relay sends:
#   opened    relay -> host   request id (4), session token (16)
#   joined    relay -> player request id (4), peer id (4)
#   refused   relay -> client request id (4), reason (1)
#   forward   relay -> client source peer id (4), payload
#   peerLeft  relay -> host   peer id (4)
#   closed    relay -> player (nothing): the session ended
#   introduce relay -> both   peer id (4), secret (8), address (23): the
#             other side's public address, to try a direct path
# And the ones that travel the direct path, client to client:
#   punch     secret (8), sender's peer id (4)
#   punchAck  secret (8), sender's peer id (4)
#   direct    sender's peer id (4), payload (a forward that skipped the relay)
#
# open and join may end with two more bytes: relay only (1: this side's
# address is never given to the other side, so no direct path is tried),
# then the device (deviceDesktop, deviceMobile) for the host-migration rule.
#   hostChanged relay -> all  the promoted player's former peer id (4)
#
# An open may end, after those two bytes, with a signed ticket (below): what a
# relay given a secret requires (docs/relay.md, "Who may open a session").
#
# The host is peer 0; players are 1, 2, ... in the order they joined. A
# player forwards only to the host, the host to any of its players. The
# payload is opaque to the relay (a sealed lib/net/Connection packet), and a
# client sees only peer ids, never another client's address.
open net/Wire
open net/Udp
open crypto/SecureRandom
open crypto/Sha256
open crypto/CryptoBytes
open String

const relayKindOpen: Int = 201

const relayKindOpened: Int = 202

const relayKindJoin: Int = 203

const relayKindJoined: Int = 204

const relayKindRefused: Int = 205

const relayKindForward: Int = 206

const relayKindKeepAlive: Int = 207

const relayKindLeave: Int = 208

const relayKindPeerLeft: Int = 209

const relayKindClosed: Int = 210

const relayKindIntroduce: Int = 211

const relayKindPunch: Int = 212

const relayKindPunchAck: Int = 213

const relayKindDirect: Int = 214

# relay -> every peer of a session whose host went: the promoted player's
# former peer id (4); it is peer 0 from now on
const relayKindHostChanged: Int = 215

# What a client runs on (the last byte of open / join): the host-migration
# rule prefers a desktop
const deviceUnknown: Int = 0

# The path a client upgrades to WebSocket on (a peer that cannot send UDP)
const relayWebSocketPath: String = "/relay"

const deviceDesktop: Int = 1

const deviceMobile: Int = 2

# Refusal reasons
const refusedUnknownSession: Int = 1

const refusedSessionFull: Int = 2

const refusedRelayFull: Int = 3

# This relay requires a ticket to open a session, and there was none, or it was
# wrong or expired
const refusedOpenTicket: Int = 4

# The session token's size, and the forward header's (kind, peer id)
const relayTokenBytes: Int = 16

const forwardHeaderBytes: Int = 5

# An address in an introduce packet: family (1), high (8), low (8), port
# (2), scope id (4)
const addressBytes: Int = 23

# introduce: kind, peer id, secret, address
const introduceBytes: Int = 13 + addressBytes

# punch / punchAck: kind, secret, peer id
const punchBytes: Int = 13

# The host's peer id
const hostPeerId: Int = 0

# The largest datagram either side reads (a 1200-byte protocol packet plus
# the forward header, with room to spare)
const relayDatagramBytes: Int = 2048

func relayWriteRequest(packet: mod List(UInt8), kind: view Int, requestId: view Int) {
  packet.clear()
  writeU8(bytes: packet, value: kind)
  writeU32(bytes: packet, value: requestId)
}

func relayWriteKind(packet: mod List(UInt8), kind: view Int) {
  packet.clear()
  writeU8(bytes: packet, value: kind)
}

# The forward header for `peerId`, ahead of a payload the caller appends
func relayWriteForwardHeader(packet: mod List(UInt8), peerId: view Int) {
  packet.clear()
  writeU8(bytes: packet, value: relayKindForward)
  writeU32(bytes: packet, value: peerId)
}

# The 16 token bytes as 32 lowercase hex digits (to pass a token on: a join
# code, a command line)
func relayTokenText(token: view List(UInt8)) ret String {
  var text: String = ""
  loop var i: Int = 0, i < token.length, ++i {
    let byte: Int = readU8(bytes: token, offset: i)
    text = "{text}{tokenHexDigit(value: byte shr 4)}{tokenHexDigit(value: byte bitand 15)}"
  }
  ret text
}

func tokenHexDigit(value: view Int) ret String {
  if value < 10 {
    ret "{value}"
  }
  if value is 10 {
    ret "a"
  }
  if value is 11 {
    ret "b"
  }
  if value is 12 {
    ret "c"
  }
  if value is 13 {
    ret "d"
  }
  if value is 14 {
    ret "e"
  }
  ret "f"
}

func tokenHexValue(code: view Int) ret Int {
  if code >= 48 and code <= 57 {
    ret code - 48
  }
  if code >= 97 and code <= 102 {
    ret code - 87
  }
  if code >= 65 and code <= 70 {
    ret code - 55
  }
  ret -1
}

# The token written as 32 hex digits into `token` (replacing its contents):
# false when the text is not 32 hex digits
func relayTokenFromText(text: view String, token: mod List(UInt8)) ret Bool {
  token.clear()
  if text.length() is not relayTokenBytes * 2 {
    ret false
  }
  loop var i: Int = 0, i < relayTokenBytes, ++i {
    let high: Int = tokenHexValue(code: text.byteAt(index: 2 * i))
    let low: Int = tokenHexValue(code: text.byteAt(index: 2 * i + 1))
    if high < 0 or low < 0 {
      token.clear()
      ret false
    }
    token.add(value: (high * 16 + low) as UInt8)
  }
  ret true
}

# The 8-byte big-endian value at `offset` (a secret, an address half)
func readU64(bytes: view List(UInt8), offset: view Int) ret Int {
  ret (readU32(bytes: bytes, offset: offset) shl 32) bitor readU32(bytes: bytes, offset: offset + 4)
}

func writeU64(bytes: mod List(UInt8), value: view Int) {
  writeU32(bytes: bytes, value: value shr 32)
  writeU32(bytes: bytes, value: value)
}

func relayWriteAddress(packet: mod List(UInt8), address: view NetAddress) {
  var family: Int = 0
  if address.family is AddressFamily.ipv4 {
    family = 4
  } else if address.family is AddressFamily.ipv6 {
    family = 6
  }
  writeU8(bytes: packet, value: family)
  writeU64(bytes: packet, value: address.high)
  writeU64(bytes: packet, value: address.low)
  writeU16(bytes: packet, value: address.port)
  writeU32(bytes: packet, value: address.scopeId)
}

func relayReadAddress(bytes: view List(UInt8), offset: view Int) ret NetAddress {
  let family: Int = readU8(bytes: bytes, offset: offset)
  var addressFamily: AddressFamily = AddressFamily.none
  if family is 4 {
    addressFamily = AddressFamily.ipv4
  } else if family is 6 {
    addressFamily = AddressFamily.ipv6
  }
  ret NetAddress {
    family: addressFamily
    high: readU64(bytes: bytes, offset: offset + 1)
    low: readU64(bytes: bytes, offset: offset + 9)
    port: readU16(bytes: bytes, offset: offset + 17)
    scopeId: readU32(bytes: bytes, offset: offset + 19)
  }
}

# ----- invites ------------------------------------------------------------------
#
# An invite is what a host gives its players (as text, a QR code, a link):
# the relay token, which the relay sees, and a session key, which it never
# does, as "<token>-<key>" in hex. A player sends only the token to the
# relay and puts the key in its ConnectionConfig.sessionKey, so the host's
# and the player's handshake proves both ends have it (lib/net/PacketSeal):
# a relay that swaps in its own keys is refused (docs/relay.md, "Invites").
# A bare token is an invite with no key (no authentication).
const relaySessionKeyBytes: Int = 16

# A fresh random session key (empty when the system has no random source)
func newRelaySessionKey() ret List(UInt8) {
  var key: List(UInt8) = List.create(UInt8, cap: relaySessionKeyBytes)
  key.addDefaults(count: relaySessionKeyBytes)
  if not secureRandomFill(bytes: key, start: 0, count: relaySessionKeyBytes) {
    key.clear()
  }
  ret key
}

func relayInviteText(token: view List(UInt8), sessionKey: view List(UInt8)) ret String {
  if sessionKey.length is 0 {
    ret relayTokenText(token: token)
  }
  ret "{relayTokenText(token: token)}-{relayTokenText(token: sessionKey)}"
}

# Split an invite into its token and its session key (empty for a bare
# token): false when it is not an invite
func relayInviteParts(
  text: view String
  token: mod List(UInt8)
  sessionKey: mod List(UInt8)
) ret Bool {
  sessionKey.clear()
  let tokenDigits: Int = relayTokenBytes * 2
  if text.length() is tokenDigits {
    ret relayTokenFromText(text: text, token: token)
  }
  if text.length() is not tokenDigits + 1 + relaySessionKeyBytes * 2 or text.byteAt(
    index: tokenDigits
  ) is not 45 {
    ret false
  }
  if not relayTokenFromText(text: text.sub(start: 0, len: tokenDigits), token: token) {
    ret false
  }
  ret relayTokenFromText(
    text: text.sub(start: tokenDigits + 1, len: relaySessionKeyBytes * 2)
    token: sessionKey
  )
}

# ----- open tickets --------------------------------------------------------------
#
# What lets a host open a session on a relay that was given a secret. A backend
# that holds the same secret issues one for a host it trusts, and the host sends
# it in its open. Its bytes:
#   expires at (8: seconds since 1970), HMAC-SHA256 (32), ticket (the rest)
# The HMAC is under the secret, over the expiry and the ticket in that order. The
# ticket is the backend's own bytes (a game id, an account); the relay reads
# nothing in it. These two functions are pure, so a backend can call them, and
# one in another language can do the same from this description.
const openTicketExpiryBytes: Int = 8

const openTicketMacBytes: Int = 32

const openTicketHeaderBytes: Int = openTicketExpiryBytes + openTicketMacBytes

# The largest backend ticket: a signed one must fit a datagram with room to spare
const openTicketMaxBytes: Int = 256

# The HMAC of a signed ticket's expiry and ticket: `count` bytes from `start`
func openTicketMac(
  secret: view List(UInt8)
  bytes: view List(UInt8)
  start: view Int
  count: view Int
) ret List(UInt8) {
  var signed: List(UInt8) = List.create(UInt8, cap: count)
  appendCopy(
    destination: signed
    source: bytes
    start: start
    count: openTicketExpiryBytes
  )
  appendCopy(
    destination: signed
    source: bytes
    start: start + openTicketHeaderBytes
    count: count - openTicketHeaderBytes
  )
  ret hmacSha256(key: secret, message: signed)
}

# A signed ticket under `secret`: `ticket`, good until `expiresAtSeconds` (seconds
# since 1970). Empty when `ticket` is over openTicketMaxBytes.
func relayIssueOpenTicket(
  secret: view List(UInt8)
  ticket: view List(UInt8)
  expiresAtSeconds: view Int
) ret List(UInt8) {
  var signed: List(UInt8) = List.create(UInt8, cap: openTicketHeaderBytes + ticket.length)
  if ticket.length > openTicketMaxBytes {
    ret signed
  }
  writeU64(bytes: signed, value: expiresAtSeconds)
  signed.addDefaults(count: openTicketMacBytes)
  appendCopy(
    destination: signed
    source: ticket
    start: 0
    count: ticket.length
  )
  let mac: List(UInt8) = openTicketMac(
    secret: secret
    bytes: signed
    start: 0
    count: signed.length
  )
  loop var i: Int = 0, i < openTicketMacBytes, ++i {
    signed.set(index: openTicketExpiryBytes + i, value: mac.copyAtFallback(index: i, fallback: 0))
  }
  ret signed
}

# Whether the `count` bytes of `bytes` from `start` are a ticket signed under
# `secret` and not expired at `nowSeconds`. The HMAC is checked first and in
# constant time, so a wrong ticket learns nothing.
func relayOpenTicketValid(
  secret: view List(UInt8)
  bytes: view List(UInt8)
  start: view Int
  count: view Int
  nowSeconds: view Int
) ret Bool {
  if count < openTicketHeaderBytes or count > openTicketHeaderBytes + openTicketMaxBytes {
    ret false
  }
  if start < 0 or start + count > bytes.length {
    ret false
  }
  var sent: List(UInt8) = List.create(UInt8, cap: openTicketMacBytes)
  appendCopy(
    destination: sent
    source: bytes
    start: start + openTicketExpiryBytes
    count: openTicketMacBytes
  )
  let expected: List(UInt8) = openTicketMac(
    secret: secret
    bytes: bytes
    start: start
    count: count
  )
  if not bytesEqual(a: sent, b: expected) {
    ret false
  }
  ret nowSeconds < readU64(bytes: bytes, offset: start)
}
