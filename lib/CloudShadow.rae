# CloudShadow — the clouds' shadow on the ground (docs/cloud-rendering-research.md
# §8.2): a small map of how much of the key light the cloud layer lets
# through, over the clouds' plane round the eye, drawn each frame from the
# same field the sky draws (lib/cloud_shadow.wgsl, sky_hosek.wgsl
# skyCloudSunThrough). Every shaded surface multiplies its sunlight by it
# (deferred_shade.wgsl cloudSunLight), so the clouds' shadows lie on the land
# and move with the wind; its average, in its last row, dims the sky's
# light under the clouds (cloudSkyLight). It is the one map every cloud tier
# writes: a later tier draws into the same texture.
#
# drawFrameClouds draws it right after the light uniform is uploaded
# (GbufferPasses lightingPassSky, ForwardMain beginForwardMain), with the
# slab tier's passes (lib/CloudSlab) when the deferred frame draws them: one
# recording of their own, submitted before the pass that reads them. Each
# pass carries its own timestamps (lib/CloudTiming): that is the clouds' GPU
# time lib/CloudTier's fallback reads. The map itself is one fullscreen pass
# over cloudShadowTexels x (cloudShadowTexels + 1) texels.
open gpu/GpuResources
open gpu/GpuRender
open gpu/GpuLifetime
open gpu/GpuTextures
open gpu/GpuIds
open webgpu/Webgpu
open webgpu/Context
open GbufferFullscreen
open CloudSlab
open CloudTiming
open Math3d

# The map's side in texels (cloud_shadow.wgsl cloudShadowTexels); one more
# row holds the average
const cloudShadowTexels: Int = 256

type CloudShadowMap {
  texture: TextureId = noTextureId()
  textureView: TextureViewId = noTextureViewId()
  pipeline: RenderPipelineId = noRenderPipelineId()
  bind: BindGroupId = noBindGroupId()
  # the light uniform the bind reads (it is made again for another one)
  boundUniform: BufferId = noBufferId()
  # the 1 x 1 target of the timing's start pass (lib/CloudTiming)
  startTexture: TextureId = noTextureId()
  startView: TextureViewId = noTextureViewId()
  # the slab tier's clouds (lib/CloudSlab)
  slab: CloudSlab = CloudSlab {}
  # the cloud passes' own GPU time, and the submissions still running
  timing: CloudTiming = createCloudTiming()
  inFlight: List(SubmissionId) = List.create(SubmissionId, cap: 4)
}

func createCloudShadowMap() ret CloudShadowMap {
  unsafe {
    ret CloudShadowMap {}
  }
}

# The map's texture and pipeline, made once; false while they cannot be made
func ensureCloudShadow(map: mod CloudShadowMap, resources: mod GpuResources) ret Bool {
  if not isValidTextureView(resources: resources, id: map.textureView) {
    if let texture: TextureId = createTexture(
      resources: resources
      width: cloudShadowTexels
      height: cloudShadowTexels + 1
      format: WGPUTextureFormat_RG16Float
      usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
    ) {
      map.texture = texture
      if let made: TextureViewId = createTextureView(resources: resources, texture: texture) {
        map.textureView = made
      }
    }
  }
  if not isValidRenderPipeline(resources: resources, id: map.pipeline) {
    let mapShader: Shader = shader(
      files: ["lib/sky_hosek.wgsl", "lib/deferred_uniforms.wgsl", "lib/cloud_shadow.wgsl"]
    )
    map.pipeline = createFullscreenPipeline(
      resources: resources
      shader: mapShader
      format: WGPUTextureFormat_RG16Float
    )
  }
  ret isValidTextureView(resources: resources, id: map.textureView) and isValidRenderPipeline(
    resources: resources
    id: map.pipeline
  )
}

# Draw the map from the light uniform `lightUniform` (the clouds, the key
# light's way and the eye): recorded into `encoder`, or its own submission
# when `encoder` is null
func drawCloudShadow(
  map: mod CloudShadowMap
  resources: mod GpuResources
  lightUniform: view BufferId
  encoder: copy Ptr
) {
  if not ensureCloudShadow(map: map, resources: resources) {
    ret
  }
  if not (map.boundUniform is lightUniform) {
    let retired: Bool = retireBindGroup(resources: resources, id: map.bind)
    map.bind = noBindGroupId()
    map.boundUniform = lightUniform
  }
  if not bindGroupIsUsable(resources: resources, id: map.bind) {
    var entries: List(ResourceRef) = List.create(ResourceRef, cap: 1)
    entries.add(value: bufferRef(id: lightUniform))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: map.pipeline
      entries: entries
    ) {
      map.bind = bind
    }
  }
  if not bindGroupIsUsable(resources: resources, id: map.bind) {
    ret
  }
  unsafe {
    # the start pass: one texel, which waits for the work ahead of the clouds
    # so the passes after it are timed alone (lib/CloudTiming)
    let startWrites: Ptr = cloudTimingPass(cloudTiming: map.timing, name: "cloud start")
    if startWrites is not webgpuNull() {
      if not isValidTextureView(resources: resources, id: map.startView) {
        if let made: TextureId = createTexture(
          resources: resources
          width: 1
          height: 1
          format: WGPUTextureFormat_RG16Float
          usage: WGPUTextureUsage_RenderAttachment
        ) {
          map.startTexture = made
          if let madeView: TextureViewId = createTextureView(resources: resources, texture: made) {
            map.startView = madeView
          }
        }
      }
      runFullscreenInBatchTimed(
        encoder: encoder
        resources: resources
        pipeline: map.pipeline
        bind: map.bind
        target: textureViewHandle(resources: resources, id: map.startView)
        timestampWrites: startWrites
      )
    }
    runFullscreenInBatchTimed(
      encoder: encoder
      resources: resources
      pipeline: map.pipeline
      bind: map.bind
      target: textureViewHandle(resources: resources, id: map.textureView)
      timestampWrites: cloudTimingPass(cloudTiming: map.timing, name: "cloud shadow")
    )
  }
}

# This frame's cloud passes, from the light uniform `lightUniform` just
# uploaded: the shadow map, and for a deferred frame (`deferred`) the slab's
# textures for a lit target of `litWidth` x `litHeight` (the lighting pass
# binds them) and, when `slabTier`, its passes, with the frame's unjittered
# `viewProj`. One recording of their own, each pass timed (lib/CloudTiming).
func drawFrameClouds(
  map: mod CloudShadowMap
  resources: mod GpuResources
  lightUniform: view BufferId
  viewProj: view Mat4
  litWidth: view Int
  litHeight: view Int
  deferred: view Bool
  slabTier: view Bool
  volumetric: view Bool
  steps: view Int
) {
  pollSubmissions(inFlight: map.inFlight, resources: resources)
  cloudTimingBegin(cloudTiming: map.timing, resources: resources)
  var slabReady: Bool = false
  if deferred {
    slabReady = ensureCloudSlab(
      slab: map.slab
      resources: resources
      litWidth: litWidth
      litHeight: litHeight
    )
  }
  if var recording: Recording = beginRecording(resources: resources) {
    unsafe {
      let encoder: Ptr = recording.encoder
      drawCloudShadow(
        map: map
        resources: resources
        lightUniform: lightUniform
        encoder: encoder
      )
      if slabReady and slabTier {
        drawCloudSlab(
          slab: map.slab
          resources: resources
          lightUniform: lightUniform
          viewProj: viewProj
          encoder: encoder
          cloudTiming: map.timing
          volumetric: volumetric
          steps: steps
        )
      }
    }
    # the end pass (lib/CloudTiming): one texel after the clouds' passes
    unsafe {
      let endWrites: Ptr = cloudTimingPass(cloudTiming: map.timing, name: "cloud end")
      if endWrites is not webgpuNull() and isValidTextureView(
        resources: resources
        id: map.startView
      ) {
        runFullscreenInBatchTimed(
          encoder: recording.encoder
          resources: resources
          pipeline: map.pipeline
          bind: map.bind
          target: textureViewHandle(resources: resources, id: map.startView)
          timestampWrites: endWrites
        )
      }
    }
    cloudTimingResolve(cloudTiming: map.timing, recording: recording, resources: resources)
    if let submitted: SubmissionId = submit(resources: resources, recording: recording) {
      map.inFlight.add(value: submitted)
      cloudTimingSubmitted(cloudTiming: map.timing, submission: submitted)
    } else {
      cloudTimingSubmitted(cloudTiming: map.timing, submission: noSubmissionId())
    }
  }
}

# The map's GPU objects (renderer shutdown)
func retireCloudShadow(map: mod CloudShadowMap, resources: mod GpuResources) {
  retireCloudSlab(slab: map.slab, resources: resources)
  releaseCloudTiming(cloudTiming: map.timing, resources: resources)
  let bindRetired: Bool = retireBindGroup(resources: resources, id: map.bind)
  let pipelineRetired: Bool = retireRenderPipeline(resources: resources, id: map.pipeline)
  let viewRetired: Bool = retireTextureView(resources: resources, id: map.textureView)
  let startViewRetired: Bool = retireTextureView(resources: resources, id: map.startView)
  let startRetired: Bool = retireTexture(resources: resources, id: map.startTexture)
  let textureRetired: Bool = retireTexture(resources: resources, id: map.texture)
  map = createCloudShadowMap()
}
