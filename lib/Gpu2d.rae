# 0 on platforms without insets. Lay HUD + UI chrome inside these.
func nativeSafeTop() unsafe extern("rae_ext_Gpu2d_safeTop") ret Float
func safeTop() ret Float {
  unsafe { ret nativeSafeTop() }
