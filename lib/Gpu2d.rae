# Per-frame mouse-wheel / trackpad delta (positive = scrolled up), matching
# raylib's getMouseWheelMove semantics.
func nativeWheelMove() unsafe extern("rae_ext_Gpu2d_wheelMove") ret Float

func wheelMove() ret Float {
  unsafe {
    ret nativeWheelMove()
  }
}

# Desktop cursor kind. 0=arrow, 1=pointer/hand, 2=text, 3=horizontal resize,
# 4=vertical resize, 5=crosshair, 6=not-allowed.
func nativeSetMouseCursor(kind: Int) unsafe extern("rae_ext_Gpu2d_setMouseCursor")

func setMouseCursor(kind: copy Int) {
  unsafe {
    nativeSetMouseCursor(kind: kind)
  }
}

# Monotonic wall-clock seconds since process start (for scroll/animation timing).
# Epoch seconds. Float64 deliberately: as f32 two calls one frame apart
# return the SAME value (~1.7e9 has ~128s granularity), so every frame delta
# would be exactly 0.0. See docs/primitive-types.md.
func nativeNowSeconds() unsafe extern("rae_ext_Gpu2d_nowSeconds") ret Float64

func nowSeconds() ret Float64 {
  unsafe {
    ret nativeNowSeconds()
  }
}

# --- Idle wait (hybrid loop) ---------------------------------------------
# Block up to `timeoutSec` for the next OS event (returns immediately if one is
# already queued), without dequeuing it — the following pollClose drains it.
# Park here when idle so the app sits at ~0% CPU; busy-render (timeout 0) while
# animating. See docs/ui-render-loop-performance.md.
func nativeWaitEvents(timeoutSec: Float) unsafe extern("rae_ext_Gpu2d_waitEvents")

func waitEvents(timeoutSec: copy Float) {
  unsafe {
    nativeWaitEvents(timeoutSec: timeoutSec)
  }
}

# Release the surface + window. The wgpu device stays cached for reuse.
func nativeCloseWindow() unsafe extern("rae_ext_Gpu2d_closeWindow")

func closeWindow() {
  unsafe {
    nativeCloseWindow()
  }
}

# --- Frame ---------------------------------------------------------------
# The frame command lifecycle is Rae (#504/#910/#915): the canvas opens a
# manager Recording + a pass over the adopted offscreen target, endFrame
# flushes the batches, submits it tracked and hands the platform present /
# screenshot tail back to C. C keeps the present-flag reset (g2dFrameReset),
# owns the persistent offscreen colour target and does the present tail.
func nativeG2dFrameReset() unsafe extern("rae_g2d_frame_reset")

func g2dFrameReset() {
  unsafe {
    nativeG2dFrameReset()
  }
}

# Present (#920): C copies the canvas's offscreen texture into the surface
# drawable, presents and polls (skipped while the window is dark — no drawable
# is acquired), and in a headless run reads the texture back for the
# RAE_GPU2D_SCREENSHOT capture. The texture is the canvas's; C only borrows it.
func nativeG2dPresent(texture: Ptr, width: Int, height: Int) unsafe extern("rae_g2d_present")

func g2dPresent(canvas: view Gpu2dCanvas) {
  unsafe {
    let texture: Ptr = canvasOffscreenTexture(canvas: canvas)
    if texture is webgpuNull() {
      ret
    }
    nativeG2dPresent(texture: texture, width: canvas.offscreenWidth, height: canvas.offscreenHeight)
  }
}

func nativeG2dTick() unsafe extern("rae_g2d_tick")

func g2dTick() {
  unsafe {
    nativeG2dTick()
  }
}

# Acquire the offscreen target and begin a render pass that clears it to the
# given linear RGBA colour (components 0..1). Must be paired with endFrame.
# #915: the frame is a manager Recording on the canvas — its pass stays open
# for the flushes, endFrame submits it through the manager (tracked).
func beginFrame(
  canvas: mod Gpu2dCanvas
  r: copy Float
  g: copy Float
  b: copy Float
  a: copy Float
) {
  g2dFrameReset()
  canvasFrameBegin(canvas: canvas)
  canvasOpenFrame(
    canvas: canvas
    clear: true
    r: r
    g: g
    b: b
    a: a
  )
}

# Begin a 2D/UI overlay pass that preserves the persistent offscreen color
# target produced by a preceding renderer pass. Pair with endFrame; this is the
# only pass that should screenshot/present the composed frame.
func beginFrameLoad(canvas: mod Gpu2dCanvas) {
  g2dFrameReset()
  canvasFrameBegin(canvas: canvas)
  canvasOpenFrame(
    canvas: canvas
    clear: false
    r: 0.0
    g: 0.0
    b: 0.0
    a: 0.0
  )
}

# Finish the render pass, submit the frame through the manager, present it
# (C: copy the offscreen target into the surface drawable + present + poll,
# still platform glue) and retire the frame's per-run objects behind the
# tracked submission.
func endFrame(canvas: mod Gpu2dCanvas) {
  # Advance the deterministic clock every frame, even one with no drawable yet.
  g2dTick()
  if not canvasFrameActive(canvas: canvas) {
    ret
  }
  flush(canvas: canvas)
  canvasCloseFrame(canvas: canvas)
  g2dPresent(canvas: canvas)
  boxFrameEnd(canvas: canvas)
}

# True when the most recent endFrame copied to a surface drawable and presented.
# Startup can render offscreen before the OS has a drawable; apps that skip idle
# frames should keep their first frame dirty until this reports true.
func nativeLastPresentOk() unsafe extern("rae_ext_Gpu2d_lastPresentOk") ret Bool

func lastPresentOk() ret Bool {
  unsafe {
    ret nativeLastPresentOk()
  }
}

# Flush queued primitives into the active render pass without ending the
# frame. Use this when painter order must be preserved across primitive
# pipelines (for example: image, then later shape, then text). Order within a
# flush: boxes (the Rae box pass, #907), then images (#908), then text (#909).
func flush(canvas: mod Gpu2dCanvas) {
  canvasFlush(canvas: canvas)
}

# --- 2D primitives (#110, Box uber-shader) -------------------------------
# Submit primitives between beginFrame and endFrame; they are batched and
# drawn in one instanced draw at endFrame, in submission order (painter's).
# Colours are 0xAARRGGBB — alpha in the top byte; use 0xFF...... for opaque.
# Coordinates and sizes are in physical pixels (see windowWidth/windowHeight).
# Rounded corners and borders are antialiased analytically (no MSAA).

# Filled axis-aligned rectangle.
# The primitives are queued on the app's Gpu2dCanvas (#913) — the CPU batch
# and its GPU pass both live there; these are the Gpu2d-spelled entry points.
func drawRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  color: copy Int
) {
  canvasDrawRect(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    color: color
  )
}

# Filled rounded rectangle (uniform corner radius).
func drawRoundedRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  color: copy Int
) {
  canvasDrawRoundedRect(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    color: color
  )
}

# Rounded rectangle with a fill and a stroked border `borderWidth` px wide
# (drawn inset from the edge). radius 0 gives a sharp-cornered box.
func drawBox(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  fill: copy Int
  borderWidth: copy Float
  border: copy Int
) {
  canvasDrawBox(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    fill: fill
    borderWidth: borderWidth
    border: border
  )
}

# Filled rounded rectangle with a linear gradient. `angleDeg` follows the UI
# GradientFill convention: 0 = left-to-right, 90 = top-to-bottom.
func drawGradientRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  from: copy Int
  to: copy Int
  angleDeg: copy Float
) {
  canvasDrawGradientRect(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    from: from
    to: to
    angleDeg: angleDeg
  )
}

# Antialiased line from (x0,y0) to (x1,y1), `thickness` units wide, with
# rounded caps (a rotated capsule). Works at any angle.
func drawLine(
  canvas: mod Gpu2dCanvas
  x0: copy Float
  y0: copy Float
  x1: copy Float
  y1: copy Float
  thickness: copy Float
  color: copy Int
) {
  canvasDrawLine(
    canvas: canvas
    x0: x0
    y0: y0
    x1: x1
    y1: y1
    thickness: thickness
    color: color
  )
}

# --- Clipping (#144, axis-aligned scissor) -------------------------------
# Push a rectangular clip region (design units); subsequent draws are
# clipped to it until the matching popClipRect. Clips nest — a pushed rect
# intersects the current one — so a rounded card can hold a clipped scroll
# list. Implemented as a render-pass scissor per contiguous same-clip run of
# draws, preserving the box→image→text batch order. `popClipRect` restores
# the previous region; an unmatched pop clears to no-clip. The stack lives on
# the canvas (#915).
func pushClipRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
) {
  canvasPushClip(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: 0.0
  )
}

# Rounded clip (#118): same as pushClipRect but the corners are rounded by
# `radius` (design units). The box pipeline rounds the corners via a
# fragment-shader SDF; the axis-aligned scissor still bounds every pipeline
# to the clip bbox. Use for a rounded card that contains a scroll list.
func pushClipRoundedRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
) {
  canvasPushClip(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
  )
}

func popClipRect(canvas: mod Gpu2dCanvas) {
  canvasPopClip(canvas: canvas)
}

# --- Images (#143, textured rounded quads) -------------------------------
# Since #908 the images live on the app-owned Gpu2dCanvas (decoded by C, the
# textures + draws are manager objects there); these are the Gpu2d-spelled
# entry points over it. Decode a PNG/JPEG file and upload it as a GPU texture;
# returns a 1-based handle (0 on failure). Load once, at startup; the texture
# is cached for the canvas's lifetime.
func loadImage(canvas: mod Gpu2dCanvas, path: copy String) ret Int {
  ret canvasLoadImage(canvas: canvas, path: path)
}

# Device-free decode probe (#228): runs loadImage's exact decode +
# error policy (magic-sniff dispatch, one decoder per format) without
# uploading a texture, so decode behaviour is testable headless and
# assets can be validated from tooling. 1 = decodes, 0 = failed
# (with the standard stderr line). Compiled target only.
func nativeDecodeImageProbe(path: String) unsafe extern("rae_ext_Gpu2d_decodeImageProbe") ret Int

func decodeImageProbe(path: copy String) ret Int {
  unsafe {
    ret nativeDecodeImageProbe(path: path)
  }
}

# Decode+upload `path` and register it under `key` (returns the handle, 0 on
# failure). Lets a renderer resolve a Sprite.textureKey to an image without a
# Rae-side map. drawImageKey draws a registered key; hasImageKey tests one.
func loadImageKey(canvas: mod Gpu2dCanvas, key: copy String, path: copy String) ret Int {
  ret canvasLoadImageKey(canvas: canvas, key: key, path: path)
}

# Register an image straight from RGBA pixels generated in Rae (#539) — no file.
# `pixels` is one packed int per pixel: r | g<<8 | b<<16 | a<<24 (order R,G,B,A).
func registerImageRgba(
  canvas: mod Gpu2dCanvas
  key: copy String
  pixels: view Buffer(Int)
  w: copy Int
  h: copy Int
) pub ret Int {
  let handle: Int = canvasRegisterImageRgba(
    canvas: canvas
    pixels: pixels
    width: w
    height: h
  )
  if handle > 0 {
    canvasRegisterImageKey(canvas: canvas, key: key, handle: handle)
  }
  ret handle
}

func hasImageKey(canvas: view Gpu2dCanvas, key: copy String) ret Bool {
  ret canvasHasImageKey(canvas: canvas, key: key)
}

func drawImageKey(
  canvas: mod Gpu2dCanvas
  key: copy String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
) {
  canvasDrawImageKey(
    canvas: canvas
    key: key
    x: x
    y: y
    w: w
    h: h
    radius: radius
    tint: tint
  )
}

# Draw a registered image with ScaleMode semantics:
# 0 = fit, 1 = fill/cover-crop, 2 = stretch.
func drawImageKeyScaled(
  canvas: mod Gpu2dCanvas
  key: copy String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
  scaleMode: copy Int
) {
  canvasDrawImageKeyScaled(
    canvas: canvas
    key: key
    x: x
    y: y
    w: w
    h: h
    radius: radius
    tint: tint
    scaleMode: scaleMode
  )
}

# Draw image `handle` into the rect at (x,y) sized w×h, with optional corner
# `radius`. `tint` is 0xAARRGGBB applied multiplicatively — 0xFFFFFFFF draws
# the image unchanged; a solid color tints a white/alpha icon to that color.
# Submitted between beginFrame/endFrame; drawn above boxes, below text.
func drawImage(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
) {
  canvasDrawImage(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
  )
}

# --- Text (#111, MSDF glyph quads) ---------------------------------------
# Low-level: submit one MSDF glyph quad on the canvas. Screen rect is
# (sx0,sy0)-(sx1,sy1) in design units; UV rect is (u0,v0)-(u1,v1) NORMALISED
# into the atlas; `atlas` is the SdfText.loadAtlas handle (1-based); `pxRange`
# is the screen-space px range (atlas pxRange * onScreenSize / atlasGlyphSize);
# colour is 0xAARRGGBB. Layout helper: lib/Gpu2dText.rae drawText.
func drawGlyph(
  canvas: mod Gpu2dCanvas
  sx0: copy Float
  sy0: copy Float
  sx1: copy Float
  sy1: copy Float
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
  atlas: copy Int
  pxRange: copy Float
  color: copy Int
) {
  canvasDrawGlyph(
    canvas: canvas
    sx0: sx0
    sy0: sy0
    sx1: sx1
    sy1: sy1
    u0: u0
    v0: v0
    u1: u1
    v1: v1
    atlas: atlas
    pxRange: pxRange
    color: color
  )
}

# With an outline (width px + colour) and softness (edge falloff px; 1 = crisp).
func drawGlyphEx(
  canvas: mod Gpu2dCanvas
  sx0: copy Float
  sy0: copy Float
  sx1: copy Float
  sy1: copy Float
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
  atlas: copy Int
  pxRange: copy Float
  color: copy Int
  outlineWidth: copy Float
  outlineColor: copy Int
  softness: copy Float
) {
  canvasDrawGlyphEx(
    canvas: canvas
    sx0: sx0
    sy0: sy0
    sx1: sx1
    sy1: sy1
    u0: u0
    v0: v0
    u1: u1
    v1: v1
    atlas: atlas
    pxRange: pxRange
    color: color
    outlineWidth: outlineWidth
    outlineColor: outlineColor
    softness: softness
  )
}
