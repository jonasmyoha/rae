# GPU 2D renderer — WebGPU render path (QUEUE #109, docs/webgpu-2d-ui-renderer.md).
#
# Unlike lib/gpu.rae (compute → readback) this OWNS the window surface and
# presents on the GPU: SDL3 creates the window + Metal layer, wgpu-native wraps
# it as a surface, and frames are rendered + presented directly (no CPU
# framebuffer round-trip). The SAME WGSL/API target the browser later
# (WebGPU-everywhere); this is the native (wgpu-native) side.
#
# Tier 0 slice: window + clear-colour present. Pipelines/instanced quads (the
# Box uber-shader, #110) and text (#111) build on top of this surface.
#
# Implemented in the RAE_HAS_WEBGPU + RAE_HAS_SDL3 block of
# compiler/runtime/rae_runtime.c. Compiled-target only; needs wgpu-native + SDL3.
# Importing this module links both. Window globals are shared with lib/sdl3.rae,
# so sdl3 input functions (getMouseX/isKeyDown/…) work against this window.
open Gpu2dCanvas
open webgpu/Webgpu
open webgpu/Context

# --- Window + surface ----------------------------------------------------
# Open a GPU-presenting window (Metal layer wrapped as a wgpu surface) and
# configure its swapchain. Replaces sdl3.initWindow for the GPU render path —
# do not also call sdl3.initWindow (that one attaches an SDL_Renderer that
# fights wgpu for the drawable).
func nativeInitWindow(width: Int, height: Int, title: String) unsafe extern("rae_ext_Gpu2d_initWindow")
func initWindow(width: copy Int, height: copy Int, title: copy String) {
  unsafe { nativeInitWindow(width: width, height: height, title: title) }
}

# Pump the OS event queue; returns true once the user has asked to close the
# window (or a headless time budget elapsed). Call once per frame.
func nativePollClose() unsafe extern("rae_ext_Gpu2d_pollClose") ret Bool
func pollClose() ret Bool {
  unsafe { ret nativePollClose() }
}

# Drawable size in physical pixels (HiDPI-aware; may exceed the logical size).
func nativeWindowWidth() unsafe extern("rae_ext_Gpu2d_windowWidth") ret Int
func windowWidth() ret Int {
  unsafe { ret nativeWindowWidth() }
}
func nativeWindowHeight() unsafe extern("rae_ext_Gpu2d_windowHeight") ret Int
func windowHeight() ret Int {
  unsafe { ret nativeWindowHeight() }
}
func nativeSetWindowPosition(x: Int, y: Int) unsafe extern("rae_ext_Gpu2d_setWindowPosition")
func setWindowPosition(x: copy Int, y: copy Int) {
  unsafe { nativeSetWindowPosition(x: x, y: y) }
}
func nativeSetWindowSize(w: Int, h: Int) unsafe extern("rae_ext_Gpu2d_setWindowSize")
func setWindowSize(w: copy Int, h: copy Int) {
  unsafe { nativeSetWindowSize(w: w, h: h) }
}
func nativeWindowPositionX() unsafe extern("rae_ext_Gpu2d_windowPositionX") ret Int
func windowPositionX() ret Int {
  unsafe { ret nativeWindowPositionX() }
}
func nativeWindowPositionY() unsafe extern("rae_ext_Gpu2d_windowPositionY") ret Int
func windowPositionY() ret Int {
  unsafe { ret nativeWindowPositionY() }
}
# True once after the OS reports a window resize (edge-triggered; the flag
# is cleared on read). The app recomputes its viewport/extent and rebuilds.
func nativeWindowResized() unsafe extern("rae_ext_Gpu2d_windowResized") ret Bool
func windowResized() ret Bool {
  unsafe { ret nativeWindowResized() }
}
# One-shot, like windowResized: reading it clears it. Persisting where the user
# put the window is built ON these in Rae (lib/ui/WindowGeometry.rae), not down
# in the runtime.
func nativeWindowMoved() unsafe extern("rae_ext_Gpu2d_windowMoved") ret Bool
func windowMoved() ret Bool {
  unsafe { ret nativeWindowMoved() }
}
# False while the window is hidden / minimized / occluded (app switched away or
# fully covered). Apps should skip their render and park in waitEvents when this
# is false: rendering while dark wastes power and, on macOS, leaks GPU memory
# (the Metal layer stops recycling drawables while backgrounded). Not edge-
# triggered — reflects the current state every call.
func nativeWindowVisible() unsafe extern("rae_g2d_window_visible") ret Bool
func windowVisible() ret Bool {
  unsafe { ret nativeWindowVisible() }
}

# The universal per-frame render decision, so no app has to hand-roll it. Render
# this frame only if the app wants to AND the window is actually visible. NEVER
# render while hidden/minimized/occluded: it wastes power and, on macOS, leaks
# GPU memory — the Metal drawable pool stops recycling while backgrounded, so
# every frame allocates a fresh drawable and the deferred pipeline's driver
# allocations pile up (measured 170MB -> 1.4GB across a few app switches). The
# app passes its own "something changed" signal and branches: render, else park
# in waitEvents. Folding the visibility rule in here is what stops that rule from
# being a per-app footgun — the engine present path refuses to present while dark
# as a hard backstop, but skipping the whole render is what avoids the waste.
func shouldRenderFrame(appNeedsRender: view Bool) ret Bool {
  if windowVisible() is false { ret false }
  ret appNeedsRender
}

# Busy-loop convenience for apps that render every frame (games, always-on
# animation): render this frame only if the window is visible. When hidden it
# PARKS briefly and returns false, so `if Gpu2d.renderGate() { ...render... }`
# gets both the macOS backgrounded-render leak fix AND avoids a busy spin, with
# no else branch. Event-driven loops that already compute a needsRender should
# use shouldRenderFrame + their own waitEvents instead.
func renderGate() ret Bool {
  if windowVisible() { ret true }
  waitEvents(timeoutSec: 0.25)
  ret false
}

# --- Coordinate system (#112) --------------------------------------------
# Draw coordinates are in DESIGN units. By default 1 unit = 1 physical pixel
# (identity). Call setDesignResolution to author against a fixed virtual
# canvas that is scaled to fit the window — DPI-independent and resolution-
# independent, the Figma-style shared design-unit model
# (docs/ui-coordinate-and-responsive-layout.md). Three layers:
#   design units  --(scale + offset / fit)-->  physical px  --> clip space.
# fit: 0 = fit (contain, letterboxed), 1 = fill (cover, cropped), 2 = stretch.
# Pass width/height <= 0 to return to identity (physical-pixel) coordinates.
func nativeSetDesignResolution(width: Float, height: Float, fit: Int) unsafe extern("rae_ext_Gpu2d_setDesignResolution")
func setDesignResolution(width: copy Float, height: copy Float, fit: copy Int) {
  unsafe { nativeSetDesignResolution(width: width, height: height, fit: fit) }
}

# Current design-canvas size in design units (the window's physical size when
# no design resolution is set). Lay out against these.
func nativeDesignWidth() unsafe extern("rae_ext_Gpu2d_designWidth") ret Float
func designWidth() ret Float {
  unsafe { ret nativeDesignWidth() }
}
func nativeDesignHeight() unsafe extern("rae_ext_Gpu2d_designHeight") ret Float
func designHeight() ret Float {
  unsafe { ret nativeDesignHeight() }
}

# Device pixel ratio: physical pixels per logical point (2.0 on retina).
func nativeDpr() unsafe extern("rae_ext_Gpu2d_dpr") ret Float
func dpr() ret Float {
  unsafe { ret nativeDpr() }
}

# --- Input (valid after pollClose each frame) ----------------------------
# pollClose records mouse/keyboard/wheel state while it pumps the event queue,
# so these read this frame's input. Coordinates are in DESIGN units (the same
# space drawRect etc. take), so hit-testing lines up with what was drawn.
func nativePointerX() unsafe extern("rae_ext_Gpu2d_pointerX") ret Float
func pointerX() ret Float {
  unsafe { ret nativePointerX() }
}
func nativePointerY() unsafe extern("rae_ext_Gpu2d_pointerY") ret Float
func pointerY() ret Float {
  unsafe { ret nativePointerY() }
}
# Multitouch (#526): active finger count + per-finger position in design units.
# On desktop this is 0 (use the mouse pointer); on iOS every touch is reported so
# a UI can drive a joystick with one finger and the camera with another.
func nativeTouchCount() unsafe extern("rae_ext_Gpu2d_touchCount") ret Int
func touchCount() ret Int {
  unsafe { ret nativeTouchCount() }
}
func nativeTouchX(index: Int) unsafe extern("rae_ext_Gpu2d_touchX") ret Float
