# Per-frame mouse-wheel / trackpad delta (positive = scrolled up), matching
# raylib's getMouseWheelMove semantics.
func nativeWheelMove() unsafe extern("rae_ext_Gpu2d_wheelMove") ret Float
func wheelMove() ret Float {
  unsafe { ret nativeWheelMove() }
}
# Desktop cursor kind. 0=arrow, 1=pointer/hand, 2=text, 3=horizontal resize,
# 4=vertical resize, 5=crosshair, 6=not-allowed.
func nativeSetMouseCursor(kind: Int) unsafe extern("rae_ext_Gpu2d_setMouseCursor")
func setMouseCursor(kind: copy Int) {
  unsafe { nativeSetMouseCursor(kind: kind) }
}
# Monotonic wall-clock seconds since process start (for scroll/animation timing).
# Epoch seconds. Float64 deliberately: as f32 two calls one frame apart
# return the SAME value (~1.7e9 has ~128s granularity), so every frame delta
# would be exactly 0.0. See docs/primitive-types.md.
func nativeNowSeconds() unsafe extern("rae_ext_Gpu2d_nowSeconds") ret Float64
func nowSeconds() ret Float64 {
  unsafe { ret nativeNowSeconds() }
}

# --- Idle wait (hybrid loop) ---------------------------------------------
# Block up to `timeoutSec` for the next OS event (returns immediately if one is
# already queued), without dequeuing it — the following pollClose drains it.
# Park here when idle so the app sits at ~0% CPU; busy-render (timeout 0) while
# animating. See docs/ui-render-loop-performance.md.
func nativeWaitEvents(timeoutSec: Float) unsafe extern("rae_ext_Gpu2d_waitEvents")
func waitEvents(timeoutSec: copy Float) {
  unsafe { nativeWaitEvents(timeoutSec: timeoutSec) }
}

# Release the surface + window. The wgpu device stays cached for reuse.
func nativeCloseWindow() unsafe extern("rae_ext_Gpu2d_closeWindow")
func closeWindow() {
  unsafe { nativeCloseWindow() }
}

# --- Frame ---------------------------------------------------------------
# The frame command lifecycle runs here in Rae (#504): create the encoder +
# offscreen render pass, and on end flush the batched primitives, submit, and
# hand the platform present/screenshot tail back to C. C keeps the per-frame
# batch-counter reset (g2dFrameReset), owns the persistent offscreen colour
# target (g2dOffView), packs primitives (flush), and does the present tail.
func nativeG2dFrameReset() unsafe extern("rae_g2d_frame_reset")
func g2dFrameReset() {
  unsafe { nativeG2dFrameReset() }
}
func g2dSetFrame(enc: Ptr, pass: Ptr) unsafe extern("rae_g2d_set_frame")
func g2dPass() unsafe extern("rae_g2d_pass_get") ret Ptr
func g2dEncoder() unsafe extern("rae_g2d_encoder_get") ret Ptr
func nativeG2dFrameActive() unsafe extern("rae_g2d_frame_active") ret Int
func g2dFrameActive() ret Int {
  unsafe { ret nativeG2dFrameActive() }
}
func nativeG2dPresentCleanup() unsafe extern("rae_g2d_present_and_cleanup")
func g2dPresentCleanup() {
  unsafe { nativeG2dPresentCleanup() }
}
func nativeG2dTick() unsafe extern("rae_g2d_tick")
func g2dTick() {
  unsafe { nativeG2dTick() }
}
func g2dOffView() unsafe extern("rae_g2d_off_view") ret Ptr
func nativeG2dOffViewReady() unsafe extern("rae_g2d_off_view_ready") ret Int
func g2dOffViewReady() ret Int {
  unsafe { ret nativeG2dOffViewReady() }
}
func g2dSubmit(cmd: Ptr) unsafe extern("rae_gb_submit")

# Shared: create the command encoder and begin the offscreen colour pass with
# the given load op + clear colour, then hand the encoder/pass to C so flush()
# and the present tail see the live frame.
func g2dOpenPass(loadOp: copy Int32, r: copy Float, g: copy Float, b: copy Float, a: copy Float) {
  unsafe {
    let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
    let att: WGPURenderPassColorAttachment = {
      view_: g2dOffView(), depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
      loadOp: loadOp, storeOp: WGPUStoreOp_Store,
      clearValue: { r: r as Float64, g: g as Float64, b: b as Float64, a: a as Float64 }
    }
    # Pure per-call scratch (#764: was a module-level global). Its .data is the C
    # array the pass descriptor points at; WebGPU copies the attachments during
    # BeginRenderPass below, so the local only needs to outlive that call. set() is
    # a no-op past the length, so grow to one slot first (as gbuffer.rae does).
    var g2dColorAtts: List(WGPURenderPassColorAttachment) = List.create(WGPURenderPassColorAttachment, cap: 1)
    loop g2dColorAtts.length < 1 { g2dColorAtts.add(value: { depthSlice: 0 as UInt32 }) }
    g2dColorAtts.set(index: 0, value: att)
    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 1 as UInt64,
      colorAttachments: g2dColorAtts.data
    }
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    g2dSetFrame(enc: enc, pass: pass)
  }
}

# Acquire the next surface texture and begin a render pass that clears it to
# the given linear RGBA colour (components 0..1). Must be paired with endFrame.
func beginFrame(r: copy Float, g: copy Float, b: copy Float, a: copy Float) {
  g2dFrameReset()
  if g2dOffViewReady() is 0 { ret }
  g2dOpenPass(loadOp: WGPULoadOp_Clear, r: r, g: g, b: b, a: a)
}

# Begin a 2D/UI overlay pass that preserves the persistent offscreen color
# target produced by a preceding renderer pass. Pair with endFrame; this is the
# only pass that should screenshot/present the composed frame.
func beginFrameLoad() {
  g2dFrameReset()
  if g2dOffViewReady() is 0 { ret }
  g2dOpenPass(loadOp: WGPULoadOp_Load, r: 0.0, g: 0.0, b: 0.0, a: 0.0)
}

# Finish the render pass, submit the command buffer, and present the frame.
# `box` is the app-owned 2D box pass (#907): the frame's queued primitives are
# drawn from its manager before images and text, and its per-frame objects are
# retired after the submit.
func endFrame(canvas: mod Gpu2dCanvas) {
  unsafe {
    # Advance the deterministic clock every frame, even one with no drawable yet.
    g2dTick()
    if g2dFrameActive() is 0 { ret }
    flush(canvas: canvas)
    let pass: Ptr = g2dPass()
    let enc: Ptr = g2dEncoder()
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
    let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
    g2dSubmit(cmd: cmd)
    wgpuCommandBufferRelease(commandBuffer: cmd)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
    wgpuCommandEncoderRelease(commandEncoder: enc)
    g2dPresentCleanup()
    boxFrameEnd(canvas: canvas)
  }
}

# True when the most recent endFrame copied to a surface drawable and presented.
# Startup can render offscreen before the OS has a drawable; apps that skip idle
# frames should keep their first frame dirty until this reports true.
func nativeLastPresentOk() unsafe extern("rae_ext_Gpu2d_lastPresentOk") ret Bool
func lastPresentOk() ret Bool {
  unsafe { ret nativeLastPresentOk() }
}

# Flush queued primitives into the active render pass without ending the
# frame. Use this when painter order must be preserved across primitive
# pipelines (for example: image, then later shape, then text). Order within a
# flush: boxes (the Rae box pass, #907), then images (#908), then text (C).
func nativeFlush() unsafe extern("rae_ext_Gpu2d_flush")
func flush(canvas: mod Gpu2dCanvas) {
  g2dPrepareFlush(imagesPending: canvas.imageCommandHandles.length)
  boxFlush(canvas: canvas)
  imageFlush(canvas: canvas)
  unsafe { nativeFlush() }
}

# --- 2D primitives (#110, Box uber-shader) -------------------------------
# Submit primitives between beginFrame and endFrame; they are batched and
# drawn in one instanced draw at endFrame, in submission order (painter's).
# Colours are 0xAARRGGBB — alpha in the top byte; use 0xFF...... for opaque.
# Coordinates and sizes are in physical pixels (see windowWidth/windowHeight).
# Rounded corners and borders are antialiased analytically (no MSAA).

# Filled axis-aligned rectangle.
func nativeDrawRect(x: Float, y: Float, w: Float, h: Float, color: Int) unsafe extern("rae_ext_Gpu2d_drawRect")
func drawRect(x: copy Float, y: copy Float, w: copy Float, h: copy Float, color: copy Int) {
  unsafe { nativeDrawRect(x: x, y: y, w: w, h: h, color: color) }
}

# Filled rounded rectangle (uniform corner radius).
func nativeDrawRoundedRect(x: Float, y: Float, w: Float, h: Float, radius: Float, color: Int) unsafe extern("rae_ext_Gpu2d_drawRoundedRect")
func drawRoundedRect(x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, color: copy Int) {
  unsafe { nativeDrawRoundedRect(x: x, y: y, w: w, h: h, radius: radius, color: color) }
}

# Rounded rectangle with a fill and a stroked border `borderWidth` px wide
# (drawn inset from the edge). radius 0 gives a sharp-cornered box.
func nativeDrawBox(x: Float, y: Float, w: Float, h: Float, radius: Float, fill: Int, borderWidth: Float, border: Int) unsafe extern("rae_ext_Gpu2d_drawBox")
func drawBox(x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, fill: copy Int, borderWidth: copy Float, border: copy Int) {
  unsafe { nativeDrawBox(x: x, y: y, w: w, h: h, radius: radius, fill: fill, borderWidth: borderWidth, border: border) }
}

# Filled rounded rectangle with a linear gradient. `angleDeg` follows the UI
# GradientFill convention: 0 = left-to-right, 90 = top-to-bottom.
func nativeDrawGradientRect(x: Float, y: Float, w: Float, h: Float, radius: Float, from: Int, to: Int, angleDeg: Float) unsafe extern("rae_ext_Gpu2d_drawGradientRect")
func drawGradientRect(x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, from: copy Int, to: copy Int, angleDeg: copy Float) {
  unsafe { nativeDrawGradientRect(x: x, y: y, w: w, h: h, radius: radius, from: from, to: to, angleDeg: angleDeg) }
}

# Antialiased line from (x0,y0) to (x1,y1), `thickness` units wide, with
# rounded caps (a rotated capsule). Works at any angle.
func nativeDrawLine(x0: Float, y0: Float, x1: Float, y1: Float, thickness: Float, color: Int) unsafe extern("rae_ext_Gpu2d_drawLine")
func drawLine(x0: copy Float, y0: copy Float, x1: copy Float, y1: copy Float, thickness: copy Float, color: copy Int) {
  unsafe { nativeDrawLine(x0: x0, y0: y0, x1: x1, y1: y1, thickness: thickness, color: color) }
}

# --- Clipping (#144, axis-aligned scissor) -------------------------------
# Push a rectangular clip region (design units); subsequent draws are
# clipped to it until the matching popClipRect. Clips nest — a pushed rect
# intersects the current one — so a rounded card can hold a clipped scroll
# list. Implemented as a render-pass scissor per contiguous same-clip run of
# draws, preserving the box→image→text batch order. `popClipRect` restores
# the previous region; an unmatched pop clears to no-clip. (The rounded /
# per-instance clip variant is #118.)
func nativePushClipRect(x: Float, y: Float, w: Float, h: Float) unsafe extern("rae_ext_Gpu2d_pushClipRect")
func pushClipRect(x: copy Float, y: copy Float, w: copy Float, h: copy Float) {
  unsafe { nativePushClipRect(x: x, y: y, w: w, h: h) }
}
# Rounded clip (#118): same as pushClipRect but the corners are rounded by
# `radius` (design units). The box pipeline rounds the corners via a
# fragment-shader SDF; the axis-aligned scissor still bounds every pipeline
# to the clip bbox. Use for a rounded card that contains a scroll list.
func nativePushClipRoundedRect(x: Float, y: Float, w: Float, h: Float, radius: Float) unsafe extern("rae_ext_Gpu2d_pushClipRoundedRect")
func pushClipRoundedRect(x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float) {
  unsafe { nativePushClipRoundedRect(x: x, y: y, w: w, h: h, radius: radius) }
}
func nativePopClipRect() unsafe extern("rae_ext_Gpu2d_popClipRect")
func popClipRect() {
  unsafe { nativePopClipRect() }
}

# --- Images (#143, textured rounded quads) -------------------------------
# Since #908 the images live on the app-owned Gpu2dCanvas (decoded by C, the
# textures + draws are manager objects there); these are the Gpu2d-spelled
# entry points over it. Decode a PNG/JPEG file and upload it as a GPU texture;
# returns a 1-based handle (0 on failure). Load once, at startup; the texture
# is cached for the canvas's lifetime.
func loadImage(canvas: mod Gpu2dCanvas, path: copy String) ret Int {
  ret canvasLoadImage(canvas: canvas, path: path)
}

# Device-free decode probe (#228): runs loadImage's exact decode +
# error policy (magic-sniff dispatch, one decoder per format) without
# uploading a texture, so decode behaviour is testable headless and
# assets can be validated from tooling. 1 = decodes, 0 = failed
# (with the standard stderr line). Compiled target only.
func nativeDecodeImageProbe(path: String) unsafe extern("rae_ext_Gpu2d_decodeImageProbe") ret Int
func decodeImageProbe(path: copy String) ret Int {
  unsafe { ret nativeDecodeImageProbe(path: path) }
}

# Decode+upload `path` and register it under `key` (returns the handle, 0 on
# failure). Lets a renderer resolve a Sprite.textureKey to an image without a
# Rae-side map. drawImageKey draws a registered key; hasImageKey tests one.
func loadImageKey(canvas: mod Gpu2dCanvas, key: copy String, path: copy String) ret Int {
  ret canvasLoadImageKey(canvas: canvas, key: key, path: path)
}
# Register an image straight from RGBA pixels generated in Rae (#539) — no file.
# `pixels` is one packed int per pixel: r | g<<8 | b<<16 | a<<24 (order R,G,B,A).
func registerImageRgba(canvas: mod Gpu2dCanvas, key: copy String, pixels: view Buffer(Int), w: copy Int, h: copy Int) pub ret Int {
  let handle: Int = canvasRegisterImageRgba(canvas: canvas, pixels: pixels, width: w, height: h)
  if handle > 0 { canvasRegisterImageKey(canvas: canvas, key: key, handle: handle) }
  ret handle
}
func hasImageKey(canvas: view Gpu2dCanvas, key: copy String) ret Bool {
  ret canvasHasImageKey(canvas: canvas, key: key)
}
func drawImageKey(canvas: mod Gpu2dCanvas, key: copy String, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, tint: copy Int) {
  canvasDrawImageKey(canvas: canvas, key: key, x: x, y: y, w: w, h: h, radius: radius, tint: tint)
}
# Draw a registered image with ScaleMode semantics:
# 0 = fit, 1 = fill/cover-crop, 2 = stretch.
func drawImageKeyScaled(canvas: mod Gpu2dCanvas, key: copy String, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, tint: copy Int, scaleMode: copy Int) {
  canvasDrawImageKeyScaled(canvas: canvas, key: key, x: x, y: y, w: w, h: h, radius: radius, tint: tint, scaleMode: scaleMode)
}

# Draw image `handle` into the rect at (x,y) sized w×h, with optional corner
# `radius`. `tint` is 0xAARRGGBB applied multiplicatively — 0xFFFFFFFF draws
# the image unchanged; a solid color tints a white/alpha icon to that color.
# Submitted between beginFrame/endFrame; drawn above boxes, below text.
func drawImage(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, handle: copy Int, tint: copy Int) {
  canvasDrawImage(canvas: canvas, x: x, y: y, w: w, h: h, radius: radius, handle: handle, tint: tint)
}

# --- Text (#111, MSDF glyph quads) ---------------------------------------
# Low-level: submit one MSDF glyph quad. Screen rect is (sx0,sy0)-(sx1,sy1)
# in pixels; UV rect is (u0,v0)-(u1,v1) NORMALISED into the atlas; `atlas` is
# the SdfText.loadAtlas handle (1-based); `pxRange` is the screen-space px
# range (atlas pxRange * onScreenSize / atlasGlyphSize); colour is 0xAARRGGBB.
# One atlas/font per frame. Layout helper: lib/gpu2dText.rae drawText.
func drawGlyph(sx0: Float, sy0: Float, sx1: Float, sy1: Float,
               u0: Float, v0: Float, u1: Float, v1: Float,
               atlas: Int, pxRange: Float, color: Int) unsafe extern

# Glyph with an outline: `outlineWidth` px of `outlineColor` (0xAARRGGBB) grown
# outward from the glyph edge (MSDF dilation), body composited over it. Used by
# lib/gpu2dText.drawTextEx for outlined + shadowed text.
func drawGlyphEx(sx0: Float, sy0: Float, sx1: Float, sy1: Float,
                 u0: Float, v0: Float, u1: Float, v1: Float,
                 atlas: Int, pxRange: Float, color: Int,
                 outlineWidth: Float, outlineColor: Int, softness: Float) unsafe extern
