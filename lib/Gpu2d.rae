func nativeSafeBottom() unsafe extern("rae_ext_Gpu2d_safeBottom") ret Float

func safeBottom() ret Float {
  unsafe {
    ret nativeSafeBottom()
  }
}

func nativeSafeLeft() unsafe extern("rae_ext_Gpu2d_safeLeft") ret Float

func safeLeft() ret Float {
  unsafe {
    ret nativeSafeLeft()
  }
}

func nativeSafeRight() unsafe extern("rae_ext_Gpu2d_safeRight") ret Float

func safeRight() ret Float {
  unsafe {
    ret nativeSafeRight()
  }
}

# Left mouse button held this frame.
func nativePointerDown() unsafe extern("rae_ext_Gpu2d_pointerDown") ret Bool

func pointerDown() ret Bool {
  unsafe {
    ret nativePointerDown()
  }
}

func nativePointerPressed() unsafe extern("rae_ext_Gpu2d_pointerPressed") ret Bool

func pointerPressed() ret Bool {
