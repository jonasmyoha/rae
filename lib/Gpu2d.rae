  unsafe { ret nativeTouchX(index: index) }
}
func nativeTouchY(index: Int) unsafe extern("rae_ext_Gpu2d_touchY") ret Float
func touchY(index: copy Int) ret Float {
  unsafe { ret nativeTouchY(index: index) }
}
# Stable finger id (grab a finger at press, hold it for the whole drag) + whether
# it went down this frame (edge). id is -1 out of range.
func nativeTouchId(index: Int) unsafe extern("rae_ext_Gpu2d_touchId") ret Int
func touchId(index: copy Int) ret Int {
  unsafe { ret nativeTouchId(index: index) }
}
func nativeTouchPressed(index: Int) unsafe extern("rae_ext_Gpu2d_touchPressed") ret Bool
func touchPressed(index: copy Int) ret Bool {
  unsafe { ret nativeTouchPressed(index: index) }
}
