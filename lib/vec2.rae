# vec2 — a 2D vector value type, mirroring lib/vec3.rae's API shape.
#
# Named fields rather than `Array(Float, cap: 2)`: a vector's components
# have meanings, and `v.x` reads better than `v[0]` at every call site.
# Both are equally allocation-free, so the choice is purely about which
# reads better — Array earns its place where the count is large and the
# elements are homogeneous (a matrix, a palette), not here.
#
#   import vec2
#   let a: Vec2 = { x: 1.0, y: 0.0 }
#   let b: Vec2 = vec2.vadd(a: a, b: vec2.create(x: 0.0, y: 1.0))

import math

type Vec2 {
    x: Float
    y: Float
}

func create(x: view Float, y: view Float) ret Vec2 {
    ret Vec2 { x: x, y: y }
}

func vadd(a: view Vec2, b: view Vec2) ret Vec2 {
    ret Vec2 { x: a.x + b.x, y: a.y + b.y }
}

func vsub(a: view Vec2, b: view Vec2) ret Vec2 {
    ret Vec2 { x: a.x - b.x, y: a.y - b.y }
}

func vscale(a: view Vec2, s: view Float) ret Vec2 {
    ret Vec2 { x: a.x * s, y: a.y * s }
}

# Component-wise multiply.
func vmul(a: view Vec2, b: view Vec2) ret Vec2 {
    ret Vec2 { x: a.x * b.x, y: a.y * b.y }
}

func vneg(a: view Vec2) ret Vec2 {
    ret Vec2 { x: 0.0 - a.x, y: 0.0 - a.y }
}

func vdot(a: view Vec2, b: view Vec2) ret Float {
    ret a.x * b.x + a.y * b.y
}

# The z component of the 3D cross product — the signed area of the
# parallelogram. Positive when b is counter-clockwise from a.
func vcross(a: view Vec2, b: view Vec2) ret Float {
    ret a.x * b.y - a.y * b.x
}

func vlenSq(a: view Vec2) ret Float {
    ret a.x * a.x + a.y * a.y
}

func vlen(a: view Vec2) ret Float {
    ret math.sqrt(x: vec2.vlenSq(a: a))
}

func vnorm(a: view Vec2) ret Vec2 {
    let l: Float = vec2.vlen(a: a)
    ret Vec2 { x: a.x / l, y: a.y / l }
}
