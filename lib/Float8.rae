func nativeGreaterOrEqual(
  a: view Float8
  b: view Float8
) realtime unsafe extern("rae_f8_greater_or_equal") ret Mask8

func nativeEqual(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_equal") ret Mask8

