  mask: view Mask8
  ifTrue: view Float8
  ifFalse: view Float8
) unsafe extern("rae_f8_select") ret Float8

func nativeBoth(a: view Mask8, b: view Mask8) unsafe extern("rae_m8_both") ret Mask8

func nativeEither(a: view Mask8, b: view Mask8) unsafe extern("rae_m8_either") ret Mask8

