func nativeLowering() realtime unsafe extern("rae_f8_lowering") ret Int

# The lowering this program was compiled with: "avx2", "neon", "sse2",
# "wasm" (the last three: two Float4 registers) or "scalar"
func lowering() ret String {
  var code: Int = 0
  unsafe {
    code = nativeLowering()
  }
  if code is 4 {
    ret "avx2"
  }
  if code is 1 {
    ret "neon"
  }
  if code is 2 {
    ret "sse2"
  }
  if code is 3 {
    ret "wasm"
  }
  ret "scalar"
}

# Every lane `value`.
func splat(value: view Float) ret Float8 {
  unsafe {
    ret nativeSplat(value: value)
  }
}

# a + b, lane by lane
func add(a: view Float8, b: view Float8) ret Float8 {
  unsafe {
    ret nativeAdd(a: a, b: b)
  }
}

# a - b, lane by lane
func sub(a: view Float8, b: view Float8) ret Float8 {
  unsafe {
    ret nativeSub(a: a, b: b)
  }
}

# a * b, lane by lane
func mul(a: view Float8, b: view Float8) ret Float8 {
  unsafe {
    ret nativeMul(a: a, b: b)
  }
}

# a / b, lane by lane
func div(a: view Float8, b: view Float8) ret Float8 {
  unsafe {
    ret nativeDiv(a: a, b: b)
  }
}

# a * b + c: a multiply, then an add (two roundings, never fused)
func mulAdd(a: view Float8, b: view Float8, c: view Float8) ret Float8 {
  unsafe {
    ret nativeMulAdd(a: a, b: b, c: c)
  }
}

# The square root of each lane
func sqrt(value: view Float8) ret Float8 {
  unsafe {
    ret nativeSqrt(value: value)
  }
}

# -value: the sign bit flipped
func negate(value: view Float8) ret Float8 {
  unsafe {
    ret nativeNegate(value: value)
  }
}

# value < 0 ? -value : value (keeps -0 and a NaN's sign)
func abs(value: view Float8) ret Float8 {
  unsafe {
    ret nativeAbs(value: value)
  }
}

# a <= b ? a : b, lane by lane
func min(a: view Float8, b: view Float8) ret Float8 {
  unsafe {
    ret nativeMin(a: a, b: b)
  }
}

# a >= b ? a : b, lane by lane
func max(a: view Float8, b: view Float8) ret Float8 {
  unsafe {
    ret nativeMax(a: a, b: b)
  }
}

# value clamped to [-limit, limit] (min with limit, then max with -limit)
func clampSymmetric(value: view Float8, limit: view Float8) ret Float8 {
  unsafe {
    ret nativeClampSymmetric(value: value, limit: limit)
  }
}

# A lane is true where a < b (false where either is a NaN)
func less(a: view Float8, b: view Float8) ret Mask8 {
  unsafe {
    ret nativeLess(a: a, b: b)
  }
}

# A lane is true where a > b (false where either is a NaN)
func greater(a: view Float8, b: view Float8) ret Mask8 {
  unsafe {
    ret nativeGreater(a: a, b: b)
  }
}

# A lane is true where a <= b (false where either is a NaN)
func lessOrEqual(a: view Float8, b: view Float8) ret Mask8 {
  unsafe {
    ret nativeLessOrEqual(a: a, b: b)
  }
}

# A lane is true where a >= b (false where either is a NaN)
func greaterOrEqual(a: view Float8, b: view Float8) ret Mask8 {
  unsafe {
    ret nativeGreaterOrEqual(a: a, b: b)
  }
}

# A lane is true where a == b (false where either is a NaN)
func equal(a: view Float8, b: view Float8) ret Mask8 {
  unsafe {
    ret nativeEqual(a: a, b: b)
  }
}

# mask ? ifTrue : ifFalse, bit by bit
func select(mask: view Mask8, ifTrue: view Float8, ifFalse: view Float8) ret Float8 {
  unsafe {
    ret nativeSelect(mask: mask, ifTrue: ifTrue, ifFalse: ifFalse)
  }
}

# a and b, bit by bit
func both(a: view Mask8, b: view Mask8) ret Mask8 {
  unsafe {
    ret nativeBoth(a: a, b: b)
  }
}

# a or b, bit by bit
func either(a: view Mask8, b: view Mask8) ret Mask8 {
  unsafe {
    ret nativeEither(a: a, b: b)
  }
}

# Every bit flipped
func invert(mask: view Mask8) ret Mask8 {
  unsafe {
    ret nativeInvert(mask: mask)
  }
}

# Whether any lane is true
func anyLane(mask: view Mask8) ret Bool {
  unsafe {
    ret nativeAnyLane(mask: mask)
  }
}

# Whether every lane is true
func allLanes(mask: view Mask8) ret Bool {
  unsafe {
    ret nativeAllLanes(mask: mask)
  }
}

# ((((((lane0 + lane1) + lane2) + lane3) + lane4) + lane5) + lane6) + lane7
func sum(value: view Float8) ret Float {
  unsafe {
    ret nativeSum(value: value)
  }
}

# The smallest lane, taken in lane order with min's rule
func horizontalMin(value: view Float8) ret Float {
  unsafe {
    ret nativeHorizontalMin(value: value)
  }
}

# The largest lane, taken in lane order with max's rule
func horizontalMax(value: view Float8) ret Float {
  unsafe {
    ret nativeHorizontalMax(value: value)
  }
}

# The eight Floats from `index` on, or none unless index + 7 < from.length.
func load(from: view List(Float), index: view Int) ret opt Float8 {
  if index < 0 or index + 7 >= from.length {
    ret none
  }
  unsafe {
    ret nativeLoad(data: from.data, index: index)
  }
}

# Writes the eight lanes to `into` from `index` on. Out of range (unless
# index + 7 < into.length) it is ignored with a warning, like List.set.
func store(into: mod List(Float), index: view Int, value: view Float8) {
  if index < 0 or index + 7 >= into.length {
    runtimeWarning(message: "Float8.store: index {index} is out of range for length {into.length}")
    ret
  }
  unsafe {
    nativeStore(data: into.data, index: index, value: value)
  }
}

# ----- the masked tail (docs/float4-design.md §9) ---------------------------

# How many lanes from `start` on are in a list of `length` elements, at most
# `count` and at most eight (0 when start is outside the list)
func lanesInRange(start: view Int, count: view Int, length: view Int) ret Int {
  if start < 0 or start >= length or count <= 0 {
    ret 0
  }
  var lanes: Int = count
  if lanes > 8 {
    lanes = 8
  }
  if start + lanes > length {
    lanes = length - start
  }
  ret lanes
}

# The first `count` Floats of `list` from `start` on, the other lanes 0.0.
# Only elements inside the list are read.
func loadPartial(list: view List(Float), start: view Int, count: view Int) ret Float8 {
  let lanes: Int = lanesInRange(start: start, count: count, length: list.length)
  if lanes is 0 {
    ret splat(value: 0.0)
  }
  unsafe {
    ret nativeLoadPartial(data: list.data, index: start, count: lanes)
  }
}

# Writes the first `count` lanes of `value` to `into` from `start` on. A lane
# that would land past the list's end is not written, with a warning.
func storePartial(
  into: mod List(Float)
  start: view Int
  value: view Float8
  count: view Int
) {
  let lanes: Int = lanesInRange(start: start, count: count, length: into.length)
  var asked: Int = count
  if asked > 8 {
    asked = 8
  }
  if lanes < asked {
    runtimeWarning(
      message: "Float8.storePartial: {asked} lanes from {start} do not fit a length of {into.length}"
    )
  }
  if lanes is 0 {
    ret
  }
  unsafe {
    nativeStorePartial(
      data: into.data
      index: start
      value: value
      count: lanes
    )
  }
}

# The number of the last true lane of `mask`, counted from 1 (0: none)
func lastTrueLane(mask: view Mask8) ret Int {
  let lanes: List(UInt32) = {
    mask.bits0
    mask.bits1
    mask.bits2
    mask.bits3
    mask.bits4
    mask.bits5
    mask.bits6
    mask.bits7
  }
  loop var lane: Int = 8, lane > 0, --lane {
    if lanes.copyAtFallback(index: lane - 1, fallback: 0 as UInt32) is not 0 {
      ret lane
    }
  }
  ret 0
}

# Writes the lanes of `value` whose `mask` lane is true to `into` from
# `start` on. A true lane past the list's end is not written, with a warning.
func storeMasked(
  into: mod List(Float)
  start: view Int
  value: view Float8
  mask: view Mask8
) {
  let lanes: Int = lanesInRange(start: start, count: 8, length: into.length)
  if lanes < lastTrueLane(mask: mask) {
    runtimeWarning(
      message: "Float8.storeMasked: a true lane from {start} is past a length of {into.length}"
    )
  }
  if lanes is 0 {
    ret
  }
  unsafe {
    nativeStoreMasked(
      data: into.data
      index: start
      value: value
      mask: mask
      count: lanes
    )
  }
}

# The mask whose first `count` lanes are true (all bits set), the rest false
func firstLanes(count: view Int) ret Mask8 {
  let allBits: UInt32 = 4294967295
  let noBits: UInt32 = 0
  var mask: Mask8 = {
    bits0: noBits
    bits1: noBits
    bits2: noBits
    bits3: noBits
    bits4: noBits
    bits5: noBits
    bits6: noBits
    bits7: noBits
  }
  if count > 0 {
    mask.bits0 = allBits
  }
  if count > 1 {
    mask.bits1 = allBits
  }
  if count > 2 {
    mask.bits2 = allBits
  }
  if count > 3 {
    mask.bits3 = allBits
  }
  if count > 4 {
    mask.bits4 = allBits
  }
  if count > 5 {
    mask.bits5 = allBits
  }
  if count > 6 {
    mask.bits6 = allBits
  }
  if count > 7 {
    mask.bits7 = allBits
  }
  ret mask
}

# ---- vector math: sin, cos, exp, naturalLog, tanh ---------------------------
# For a synth and DSP. The polynomials are Cephes' single-precision ones
# (Stephen L. Moshier, Cephes Math Library: sinf.c, cosf.c, expf.c, logf.c,
# tanhf.c). The range reduction is written with the operations above only:
# there is no lane-integer or bit operation, so a whole number is found by the
# 1.5 * 2^23 rounding trick, 2^n is a product of power-of-two factors and a
# logarithm's exponent is found by scaling by powers of two. Every step is
# exact IEEE arithmetic or one of the bit-exact operations above, so each lane
# gives the same bits on every lowering as the scalar definition
# (`--float4-scalar`, which forces Float8 to its scalar definitions too), as the rest of this
# module does.
#
# Maximum error against the Float64 functions rounded to Float, measured by
# fixture 1418_float_simd_math over a sweep of each range:
#   sin, cos     |x| <= 2 pi      2 ulp
#   sin, cos     |x| <= 8192      absolute 0.00000012 (ulp grows near zeros)
#   exp          -87 .. 88        1 ulp
#   naturalLog   x > 0            1 ulp
#   tanh         all x            1 ulp
# Beyond |x| = 8192 sin and cos lose accuracy (the reduction keeps about 24
# bits of x / (pi / 2)); exp gives +inf above 88.72 and 0 below -103.97;
# naturalLog gives -inf at 0 and NaN below it. NaN stays NaN in every one.

# The nearest whole number (ties to even) for |value| < 2^22, exactly:
# adding 1.5 * 2^23 leaves no fraction bits, subtracting it gives the rounded
# value back
func roundToWhole(value: view Float8) ret Float8 {
  let magic: Float8 = Float8.splat(value: 12582912.0)
  ret Float8.sub(a: Float8.add(a: value, b: magic), b: magic)
}

# The largest whole number not above `value` (|value| < 2^22)
func floorToWhole(value: view Float8) ret Float8 {
  let rounded: Float8 = roundToWhole(value: value)
  let above: Mask8 = Float8.greater(a: rounded, b: value)
  ret Float8.select(
    mask: above
    ifTrue: Float8.sub(a: rounded, b: Float8.splat(value: 1.0))
    ifFalse: rounded
  )
}

# 2^power exactly, for power in -126 .. 127 (its bits)
func twoToThe(power: view Int) ret Float {
  ret Math.floatFromBits(bits: (127 + power) * 8388608)
}

# a * b + c as two operations (no fused multiply-add: same bits everywhere)
func madd(a: view Float8, b: view Float8, c: view Float) ret Float8 {
  ret Float8.add(a: Float8.mul(a: a, b: b), b: Float8.splat(value: c))
}

# sin and cos of r in [-pi/4, pi/4] (Cephes sinf / cosf polynomials)
func sinKernel(r: view Float8) ret Float8 {
  let z: Float8 = Float8.mul(a: r, b: r)
  var p: Float8 = madd(a: Float8.splat(value: -0.00019515295891), b: z, c: 0.0083321608736)
  p = madd(a: p, b: z, c: -0.16666654611)
  ret Float8.add(a: Float8.mul(a: Float8.mul(a: p, b: z), b: r), b: r)
}

func cosKernel(r: view Float8) ret Float8 {
  let z: Float8 = Float8.mul(a: r, b: r)
  var p: Float8 = madd(
    a: Float8.splat(value: 0.00002443315711809948)
    b: z
    c: -0.001388731625493765
  )
  p = madd(a: p, b: z, c: 0.04166664568298827)
  let tail: Float8 = Float8.mul(a: Float8.mul(a: p, b: z), b: z)
  ret Float8.add(
    a: Float8.sub(a: Float8.splat(value: 1.0), b: Float8.mul(a: z, b: Float8.splat(value: 0.5)))
    b: tail
  )
}

# x = k * pi/2 + r with r in [-pi/4, pi/4] (Cody and Waite: pi/2 in three
# parts, each product exact), and the quadrant (k + shift) mod 4
type QuarterTurns8 {
  r: Float8
  quadrant: Float8
}

func reduceQuarterTurns(value: view Float8, shift: view Float) ret QuarterTurns8 {
  let turns: Float8 = roundToWhole(
    value: Float8.mul(a: value, b: Float8.splat(value: 0.636619772367581))
  )
  var r: Float8 = Float8.sub(a: value, b: Float8.mul(a: turns, b: Float8.splat(value: 1.5703125)))
  r = Float8.sub(a: r, b: Float8.mul(a: turns, b: Float8.splat(value: 0.0004837512969970703125)))
  r = Float8.sub(a: r, b: Float8.mul(a: turns, b: Float8.splat(value: 0.0000000754978995489188216)))
  let shifted: Float8 = Float8.add(a: turns, b: Float8.splat(value: shift))
  let quarter: Float8 = Float8.mul(a: shifted, b: Float8.splat(value: 0.25))
  let quadrant: Float8 = Float8.sub(
    a: shifted
    b: Float8.mul(a: floorToWhole(value: quarter), b: Float8.splat(value: 4.0))
  )
  ret QuarterTurns8 { r: r, quadrant: quadrant }
}

# sin by quadrant: 0 sin r, 1 cos r, 2 -sin r, 3 -cos r
func quadrantSin(r: view Float8, quadrant: view Float8) ret Float8 {
  let sine: Float8 = sinKernel(r: r)
  let cosine: Float8 = cosKernel(r: r)
  let odd: Mask8 = Float8.either(
    a: Float8.equal(a: quadrant, b: Float8.splat(value: 1.0))
    b: Float8.equal(a: quadrant, b: Float8.splat(value: 3.0))
  )
  let value: Float8 = Float8.select(mask: odd, ifTrue: cosine, ifFalse: sine)
  let negative: Mask8 = Float8.greaterOrEqual(a: quadrant, b: Float8.splat(value: 2.0))
  ret Float8.select(mask: negative, ifTrue: Float8.negate(value: value), ifFalse: value)
}

# Each lane's sine (radians)
func sin(value: view Float8) ret Float8 {
  let reduced: QuarterTurns8 = reduceQuarterTurns(value: value, shift: 0.0)
  let result: Float8 = quadrantSin(r: reduced.r, quadrant: reduced.quadrant)
  # sin(-0) is -0
  ret Float8.select(
    mask: Float8.equal(a: value, b: Float8.splat(value: 0.0))
    ifTrue: value
    ifFalse: result
  )
}

# Each lane's cosine (radians): sin a quarter turn on
func cos(value: view Float8) ret Float8 {
  let reduced: QuarterTurns8 = reduceQuarterTurns(value: value, shift: 1.0)
  ret quadrantSin(r: reduced.r, quadrant: reduced.quadrant)
}

# 2^n for whole n in -126 .. 127: 2^|n| as a product of power-of-two
# factors, and for a negative n its reciprocal (exact: a power of two)
func powerOfTwo(n: view Float8) ret Float8 {
  let zero: Float8 = Float8.splat(value: 0.0)
  let one: Float8 = Float8.splat(value: 1.0)
  var left: Float8 = Float8.abs(value: n)
  var result: Float8 = one
  var step: Float = 64.0
  loop step >= 1.0 {
    let has: Mask8 = Float8.greaterOrEqual(a: left, b: Float8.splat(value: step))
    left = Float8.sub(
      a: left
      b: Float8.select(mask: has, ifTrue: Float8.splat(value: step), ifFalse: zero)
    )
    let factor: Float8 = Float8.splat(value: twoToThe(power: step as Int))
    result = Float8.mul(a: result, b: Float8.select(mask: has, ifTrue: factor, ifFalse: one))
    step = step * 0.5
  }
  ret Float8.select(
    mask: Float8.less(a: n, b: zero)
    ifTrue: Float8.div(a: one, b: result)
    ifFalse: result
  )
}

# Each lane's e^x (Cephes expf)
func exp(value: view Float8) ret Float8 {
  let x: Float8 = Float8.min(
    a: Float8.max(a: value, b: Float8.splat(value: -103.97))
    b: Float8.splat(value: 88.73)
  )
  let n: Float8 = roundToWhole(value: Float8.mul(a: x, b: Float8.splat(value: 1.44269504088896341)))
  var r: Float8 = Float8.sub(a: x, b: Float8.mul(a: n, b: Float8.splat(value: 0.693359375)))
  r = Float8.sub(a: r, b: Float8.mul(a: n, b: Float8.splat(value: -0.000212194440)))
  let z: Float8 = Float8.mul(a: r, b: r)
  var p: Float8 = madd(a: Float8.splat(value: 0.00019875691500), b: r, c: 0.0013981999507)
  p = madd(a: p, b: r, c: 0.0083334519073)
  p = madd(a: p, b: r, c: 0.041665795894)
  p = madd(a: p, b: r, c: 0.16666665459)
  p = madd(a: p, b: r, c: 0.50000001201)
  let er: Float8 = Float8.add(
    a: Float8.add(a: Float8.mul(a: p, b: z), b: r)
    b: Float8.splat(value: 1.0)
  )
  # n runs from -150 to 128: below -100 apply 2^(n + 64) and then 2^-64, at
  # 128 apply 2^127 and then 2, so the one rounding is the last product
  let low: Mask8 = Float8.less(a: n, b: Float8.splat(value: -100.0))
  let high: Mask8 = Float8.greater(a: n, b: Float8.splat(value: 127.0))
  let shift: Float8 = Float8.select(
    mask: low
    ifTrue: Float8.splat(value: 64.0)
    ifFalse: Float8.select(
      mask: high
      ifTrue: Float8.splat(value: -1.0)
      ifFalse: Float8.splat(value: 0.0)
    )
  )
  let last: Float8 = Float8.select(
    mask: low
    ifTrue: Float8.splat(value: twoToThe(power: -64))
    ifFalse: Float8.select(
      mask: high
      ifTrue: Float8.splat(value: 2.0)
      ifFalse: Float8.splat(value: 1.0)
    )
  )
  let scaled: Float8 = Float8.mul(
    a: Float8.mul(a: er, b: powerOfTwo(n: Float8.add(a: n, b: shift)))
    b: last
  )
  let over: Mask8 = Float8.greater(a: value, b: Float8.splat(value: 88.7228))
  let under: Mask8 = Float8.less(a: value, b: Float8.splat(value: -103.972))
  let infinity: Float8 = Float8.splat(value: Math.floatFromBits(bits: 0x7F800000))
  let bounded: Float8 = Float8.select(mask: over, ifTrue: infinity, ifFalse: scaled)
  # a NaN lane stays NaN
  let finite: Float8 = Float8.select(
    mask: under
    ifTrue: Float8.splat(value: 0.0)
    ifFalse: bounded
  )
  ret Float8.select(mask: Float8.equal(a: value, b: value), ifTrue: finite, ifFalse: value)
}

# Each lane's natural logarithm (Cephes logf): x = m * 2^e with m in
# [sqrt(1/2), sqrt(2)), found by scaling by powers of two
func naturalLog(value: view Float8) ret Float8 {
  let zero: Float8 = Float8.splat(value: 0.0)
  var m: Float8 = value
  var e: Float8 = zero
  var step: Float = 64.0
  loop step >= 1.0 {
    let big: Mask8 = Float8.greaterOrEqual(
      a: m
      b: Float8.splat(value: twoToThe(power: step as Int))
    )
    m = Float8.select(
      mask: big
      ifTrue: Float8.mul(a: m, b: Float8.splat(value: twoToThe(power: -(step as Int))))
      ifFalse: m
    )
    e = Float8.add(
      a: e
      b: Float8.select(mask: big, ifTrue: Float8.splat(value: step), ifFalse: zero)
    )
    step = step * 0.5
  }
  # small values, denormals too (down to 2^-149): 64 twice, then halving
  var down: Float = 64.0
  var rounds: Int = 0
  loop down >= 1.0 {
    let small: Mask8 = Float8.both(
      a: Float8.less(a: m, b: Float8.splat(value: twoToThe(power: 1 - (down as Int))))
      b: Float8.greater(a: m, b: zero)
    )
    m = Float8.select(
      mask: small
      ifTrue: Float8.mul(a: m, b: Float8.splat(value: twoToThe(power: down as Int)))
      ifFalse: m
    )
    e = Float8.sub(
      a: e
      b: Float8.select(mask: small, ifTrue: Float8.splat(value: down), ifFalse: zero)
    )
    rounds = rounds + 1
    if rounds is not 1 {
      down = down * 0.5
    }
  }
  # m is in [1, 2) now; to [sqrt(1/2), sqrt(2)) around 1
  let high: Mask8 = Float8.greater(a: m, b: Float8.splat(value: 1.41421356))
  m = Float8.select(mask: high, ifTrue: Float8.mul(a: m, b: Float8.splat(value: 0.5)), ifFalse: m)
  e = Float8.add(
    a: e
    b: Float8.select(mask: high, ifTrue: Float8.splat(value: 1.0), ifFalse: zero)
  )
  let f: Float8 = Float8.sub(a: m, b: Float8.splat(value: 1.0))
  let z: Float8 = Float8.mul(a: f, b: f)
  var p: Float8 = madd(a: Float8.splat(value: 0.070376836292), b: f, c: -0.11514610310)
  p = madd(a: p, b: f, c: 0.11676998740)
  p = madd(a: p, b: f, c: -0.12420140846)
  p = madd(a: p, b: f, c: 0.14249322787)
  p = madd(a: p, b: f, c: -0.16668057665)
  p = madd(a: p, b: f, c: 0.20000714765)
  p = madd(a: p, b: f, c: -0.24999993993)
  p = madd(a: p, b: f, c: 0.33333331174)
  var y: Float8 = Float8.mul(a: Float8.mul(a: p, b: z), b: f)
  y = Float8.add(a: y, b: Float8.mul(a: e, b: Float8.splat(value: -0.000212194440)))
  y = Float8.sub(a: y, b: Float8.mul(a: z, b: Float8.splat(value: 0.5)))
  var result: Float8 = Float8.add(
    a: Float8.add(a: f, b: y)
    b: Float8.mul(a: e, b: Float8.splat(value: 0.693359375))
  )
  # 0 gives -inf, a negative value NaN, +inf stays +inf, NaN stays NaN
  let infinity: Float8 = Float8.splat(value: Math.floatFromBits(bits: 0x7F800000))
  result = Float8.select(
    mask: Float8.equal(a: value, b: zero)
    ifTrue: Float8.negate(value: infinity)
    ifFalse: result
  )
  result = Float8.select(
    mask: Float8.less(a: value, b: zero)
    ifTrue: Float8.splat(value: Math.floatFromBits(bits: 0x7FC00000))
    ifFalse: result
  )
  result = Float8.select(
    mask: Float8.equal(a: value, b: infinity)
    ifTrue: infinity
    ifFalse: result
  )
  ret Float8.select(mask: Float8.equal(a: value, b: value), ifTrue: result, ifFalse: value)
}

# Each lane's tanh (Cephes tanhf): a polynomial below 0.625, 1 - 2 / (e^2x + 1)
# above (x at most 10, where it rounds to +-1)
func tanh(value: view Float8) ret Float8 {
  let x: Float8 = Float8.abs(value: value)
  let z: Float8 = Float8.mul(a: value, b: value)
  var p: Float8 = madd(a: Float8.splat(value: -0.00570498872745), b: z, c: 0.0206390887954)
  p = madd(a: p, b: z, c: -0.0537397155531)
  p = madd(a: p, b: z, c: 0.133314422036)
  p = madd(a: p, b: z, c: -0.333332819422)
  let near: Float8 = Float8.add(a: Float8.mul(a: Float8.mul(a: p, b: z), b: value), b: value)
  let e2: Float8 = exp(
    value: Float8.mul(
      a: Float8.min(a: x, b: Float8.splat(value: 10.0))
      b: Float8.splat(value: 2.0)
    )
  )
  let one: Float8 = Float8.splat(value: 1.0)
  let far: Float8 = Float8.sub(
    a: one
    b: Float8.div(a: Float8.splat(value: 2.0), b: Float8.add(a: e2, b: one))
  )
  let signedFar: Float8 = Float8.select(
    mask: Float8.less(a: value, b: Float8.splat(value: 0.0))
    ifTrue: Float8.negate(value: far)
    ifFalse: far
  )
  let result: Float8 = Float8.select(
    mask: Float8.less(a: x, b: Float8.splat(value: 0.625))
    ifTrue: near
    ifFalse: signedFar
  )
  # NaN stays NaN and tanh(-0) is -0
  let number: Float8 = Float8.select(
    mask: Float8.equal(a: value, b: value)
    ifTrue: result
    ifFalse: value
  )
  ret Float8.select(
    mask: Float8.equal(a: value, b: Float8.splat(value: 0.0))
    ifTrue: value
    ifFalse: number
  )
}
