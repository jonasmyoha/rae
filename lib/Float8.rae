# Float8 — eight Float lanes for SIMD code (docs/float4-design.md §10).
#
#   import Float8
#   let half: Float8 = Float8.splat(value: 0.5)
#   let scaled: Float8 = Float8.mulAdd(a: values, b: half, c: half)  # a * b + c
#   let small: Mask8 = Float8.less(a: scaled, b: half)
#
# Float4's API and rules at twice the width: the same named functions, the
# same scalar definitions, the same bits on every lowering. One Float8 is one
# AVX2 register on an x86-64 build that targets AVX2, and two NEON / SSE2 /
# wasm SIMD128 registers (two Float4 operations) everywhere else
# (compiler/runtime/runtime_float8.h). Fixture 1088_float8_bit_exact checks
# every function against its scalar definition (1089 with --float4-scalar).
# Use Float8 where a kernel's data comes in eights and the target is AVX2; on
# a 128-bit machine it is Float4 twice, no faster (§10's measurement).
#
# Lanes read like fields (`values.lane3`). Mask8 is a comparison's result: a
# lane is true when any of its bits is set. Not in the prelude.
import Math

type Float8 {
  lane0: Float
  lane1: Float
  lane2: Float
  lane3: Float
  lane4: Float
  lane5: Float
  lane6: Float
  lane7: Float
}

type Mask8 {
  bits0: UInt32
  bits1: UInt32
  bits2: UInt32
  bits3: UInt32
  bits4: UInt32
  bits5: UInt32
  bits6: UInt32
  bits7: UInt32
}

func nativeSplat(value: Float) realtime unsafe extern("rae_f8_splat") ret Float8

func nativeAdd(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_add") ret Float8

func nativeSub(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_sub") ret Float8

func nativeMul(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_mul") ret Float8

func nativeDiv(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_div") ret Float8

func nativeMin(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_min") ret Float8

func nativeMax(a: view Float8, b: view Float8) realtime unsafe extern("rae_f8_max") ret Float8

func nativeMulAdd(
  a: view Float8
  b: view Float8
  c: view Float8
) realtime unsafe extern("rae_f8_mul_add") ret Float8

func nativeSqrt(value: view Float8) realtime unsafe extern("rae_f8_sqrt") ret Float8

func nativeNegate(value: view Float8) realtime unsafe extern("rae_f8_negate") ret Float8

