# Reusable GPU instancing (grass epic #485) — Rae over the WebGPU bindings.
#
# The deferred G-buffer pipeline already reads its per-object data from a storage
# buffer indexed by @builtin(instance_index) (landed with #502), and drawRecords
# already issues ONE DrawIndexed(instanceCount = N). This module wraps that into a
# general, mesh-agnostic instancing API — an "instance buffer handle" reusable by
# vegetation, rocks, particles, crowds — so callers never touch DrawU float
# offsets or the draws buffer directly.
#
# Lifecycle (mirrors walker_grass's field, generalised):
#   let batch = createInstanceBatch(mesh: rockMesh, capacity: 64)   # once
#   resetInstanceBatch(batch: batch)                                # each frame
#   addInstanceTransform(batch: batch, transform: t, prevTransform: pt, material: m)
#   ...
#   drawInstances(batch: batch)                                     # one draw
#
# Zero per-frame allocation: `records` is sized once and refilled with set()
# (packInstanceRecord), never add() — so an instanced field stays inside the
# walker's zero-alloc frame budget (test 573).
open Gbuffer
open SkinStore
open GbufferSkinned
open GbufferRecord
open gpu/GpuResources
open Scene3d
open Math3d
# Per-character palette uploads go straight over the WebGPU bindings (#547).
open webgpu/Webgpu
open webgpu/Context

# A caller-owned batch of DrawU records for one mesh + a running fill count.
# `records` holds capacity * instanceRecordFloats floats (pre-filled with 0.0).
type InstanceBatch {
  meshId: Int
  capacity: Int
  count: Int
  records: List(Float)
}

# Build a batch for `mesh` that can hold up to `capacity` instances. Allocates
# the record buffer ONCE; per-frame use never grows it.
func createInstanceBatch(mesh: view MeshHandle, capacity: copy Int) pub ret InstanceBatch {
  let floatCount: Int = capacity * instanceRecordFloats
  let records: List(Float) = List.create(Float, cap: floatCount)
  var floatIndex: Int = 0
  loop floatIndex < floatCount {
    records.add(value: 0.0)
    floatIndex = floatIndex + 1
  }
  ret InstanceBatch { meshId: mesh.id, capacity: capacity, count: 0, records: records }
}

# Point an existing batch at a different mesh (same record capacity). Handy when
# a pool of batches is reused across meshes; does not touch the record buffer.
func setInstanceBatchMesh(batch: mod InstanceBatch, mesh: view MeshHandle) pub {
  batch.meshId = mesh.id
}

# Start a fresh frame: drop the running count. The record buffer keeps its
# storage; addInstance overwrites slots in place.
func resetInstanceBatch(batch: mod InstanceBatch) pub {
  batch.count = 0
}

# An emitter stores ONE emissive scalar (see drawInstance): the brightest
# emission component is the intensity, since a saturated single-channel emitter
# would wash out under luminance.
func instanceEmissive(material: view Material3d) ret Float {
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  ret emissive
}

# Append one instance from ready-made model matrices. `prevModel` feeds TAA
# motion vectors; pass the same matrix as `model` for a static instance. Silently
# drops instances past `capacity` (a fixed-size field must not overrun its buffer).
func addInstance(
  batch: mod InstanceBatch
  model: view Mat4
  prevModel: view Mat4
  material: view Material3d
) pub {
  if batch.count >= batch.capacity {
    ret
  }
  packInstanceRecord(
    records: batch.records
    slot: batch.count
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: instanceEmissive(material: material)
    toon: toonFlag(material: material)
    paletteBase: 0
  )
  batch.count = batch.count + 1
}

# The palette buffer is slot-major: character `slot` starts at vec4 index
# `slot * jointCount * 3` (3 vec4 rows per joint). This is what the skinned
# shader wants in `d.params.w`, and matches uploadPaletteSlot's byte offset.
func characterPaletteBase(slot: view Int, jointCount: view Int) pub ret Int {
  ret slot * jointCount * 3
}

# ---------------------------------------------------------------------------
# Palette arena — ANY NUMBER OF SKELETONS, each with its own joint count.
#
# `characterPaletteBase(slot, jointCount)` above derives the base from a slot
# index, which silently assumes every character in the world shares one
# jointCount. That holds for a crowd of clones and breaks the moment a second
# skeleton of a different size shows up.
#
# The arena instead hands out explicit vec4-row offsets. Reserve a block per
# skeleton-instance, upload the pose at that base, and pass the same base as the
# draw's `paletteBase`. Different joint counts pack end to end with no gaps and
# no shared stride.
#
#   var arena: PaletteArena = createPaletteArena()   # once
#   resetPaletteArena(arena: arena)                  # each frame
#   let base: Int = paletteReserve(arena: arena, jointCount: jc)
#   uploadPaletteAt(rows: pose, jointCount: jc, baseRow: base)
#   ... drawSkinnedInstance(..., paletteBase: base)
#
# The old slot API stays; existing callers are untouched.
type PaletteArena {
  cursor: Int  # next free vec4 row
  capacity: Int  # total vec4 rows in the shared palette buffer
  overflow: Bool  # set once a reserve did not fit, so callers can report it
}

# One joint occupies three vec4 rows (an affine transform).
const paletteRowsPerJoint: Int = 3

func createPaletteArena() pub ret PaletteArena {
  # The palette buffer's size is the SkinStore's constant (#921), so the
  # capacity is known before the first upload.
  ret PaletteArena { cursor: 0, capacity: skinPaletteRows, overflow: false }
}

# Call once per frame, before reserving. Poses are rewritten every frame, so the
# arena is a bump allocator that resets rather than a freelist.
func resetPaletteArena(arena: mod PaletteArena) pub {
  arena.cursor = 0
  arena.overflow = false
}

# Reserve room for one posed skeleton. Returns the vec4 row to upload at and to
# pass as `paletteBase`, or -1 when the shared buffer is full.
func paletteReserve(arena: mod PaletteArena, jointCount: copy Int) pub ret Int {
  if jointCount <= 0 {
    ret 0 - 1
  }
  let need: Int = jointCount * paletteRowsPerJoint
  if arena.cursor + need > arena.capacity {
    arena.overflow = true
    ret 0 - 1
  }
  let base: Int = arena.cursor
  arena.cursor = arena.cursor + need
  ret base
}

# Upload one posed skeleton at an explicit vec4 row offset (from paletteReserve)
# into the cache's palette buffer (#921). `rows` is jointCount * 12 Floats —
# three vec4 rows per joint.
func uploadPaletteAt(
  cache: mod GbufferCache
  resources: mod GpuResources
  rows: view List(Float)
  jointCount: copy Int
  baseRow: copy Int
) pub {
  let wrote: Bool = skinStoreWritePalette(
    store: cache.skins
    resources: resources
    rows: rows
    jointCount: jointCount
    baseRow: baseRow
  )
}

# Upload one character's joint palette into the shared skin palette buffer at a
# per-character SLOT (#547), directly over the WebGPU bindings — the #502 pattern
# the draws buffer already uses. `rows` is jointCount * 12 Floats (three vec4 rows
# per joint). Slot 0 is the base palette uploadPalette writes; slots 1..N-1 hold
# the other characters so ONE instanced skinned draw can give each a distinct
# pose (the instance's paletteBase = characterPaletteBase(slot, jointCount)).
# The buffer is the cache's SkinStore palette, created by the first write.
func uploadPaletteSlot(
  cache: mod GbufferCache
  resources: mod GpuResources
  rows: view List(Float)
  jointCount: copy Int
  slot: copy Int
) pub {
  let wrote: Bool = skinStoreWritePalette(
    store: cache.skins
    resources: resources
    rows: rows
    jointCount: jointCount
    baseRow: characterPaletteBase(slot: slot, jointCount: jointCount)
  )
}

# Append one SKINNED instance that samples its OWN joint palette (#547): the same
# record as addInstance plus `paletteBase` — the instance's start offset into the
# shared skin palette buffer, from characterPaletteBase(slot, jointCount). The
# palette for that slot must already be uploaded (uploadPaletteSlot). Used to draw
# a crowd of characters in ONE instanced skinned draw where each holds a
# different pose.
func addSkinnedInstance(
  batch: mod InstanceBatch
  model: view Mat4
  prevModel: view Mat4
  material: view Material3d
  paletteBase: copy Int
) pub {
  if batch.count >= batch.capacity {
    ret
  }
  packInstanceRecord(
    records: batch.records
    slot: batch.count
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: instanceEmissive(material: material)
    toon: toonFlag(material: material)
    paletteBase: paletteBase
  )
  batch.count = batch.count + 1
}

# Append one instance from typed transforms — the common case for scene props.
func addInstanceTransform(
  batch: mod InstanceBatch
  transform: view Transform3d
  prevTransform: view Transform3d
  material: view Material3d
) pub {
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  addInstance(
    batch: batch
    model: model
    prevModel: prevModel
    material: material
  )
}

# BRICK-tagged instance (#62): identical to addInstance, but flags the non-skinned
# G-buffer fragment shader to paint PROCEDURAL MASONRY (big staggered bricks +
# recessed mortar + analytic seam bumps) over the instance's base colour. The flag
# rides in params.w — the paletteBase slot, which is unused on the non-skinned path
# (it only matters to the skinned shader). Every non-brick draw passes 0, so bodies,
# boats, props and all other instanced geometry are byte-identical.
func addInstanceBrick(
  batch: mod InstanceBatch
  model: view Mat4
  prevModel: view Mat4
  material: view Material3d
) pub {
  if batch.count >= batch.capacity {
    ret
  }
  packInstanceRecord(
    records: batch.records
    slot: batch.count
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: instanceEmissive(material: material)
    toon: toonFlag(material: material)
    paletteBase: 1
  )
  batch.count = batch.count + 1
}

func addInstanceTransformBrick(
  batch: mod InstanceBatch
  transform: view Transform3d
  prevTransform: view Transform3d
  material: view Material3d
) pub {
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  addInstanceBrick(
    batch: batch
    model: model
    prevModel: prevModel
    material: material
  )
}

# ROOF-TILE-tagged instance (#63): the brick sibling with flag 2 (params.w = 2),
# which the fragment shader paints as rounded FISH-SCALE roof shingles — distinct
# from the wall brick (flag 1). Same paletteBase-slot trick; non-tagged draws pass 0.
func addInstanceTile(
  batch: mod InstanceBatch
  model: view Mat4
  prevModel: view Mat4
  material: view Material3d
) pub {
  if batch.count >= batch.capacity {
    ret
  }
  packInstanceRecord(
    records: batch.records
    slot: batch.count
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: instanceEmissive(material: material)
    toon: toonFlag(material: material)
    paletteBase: 2
  )
  batch.count = batch.count + 1
}

func addInstanceTransformTile(
  batch: mod InstanceBatch
  transform: view Transform3d
  prevTransform: view Transform3d
  material: view Material3d
) pub {
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  addInstanceTile(
    batch: batch
    model: model
    prevModel: prevModel
    material: material
  )
}

# EMBLEM-tagged instance (#131): the non-skinned fragment shader paints a procedural unit
# BADGE (a white roundel + symbol) from the mesh UV, over the instance's base colour. `code`
# rides in params.w (the paletteBase slot, unused on the non-skinned path) and selects the
# symbol (>=10 triggers the emblem; 10 archer, 11 infantry, 12 cavalry). Non-emblem draws
# pass 0, so all other geometry is byte-identical.
func addInstanceEmblem(
  batch: mod InstanceBatch
  model: view Mat4
  prevModel: view Mat4
  material: view Material3d
  code: copy Int
) pub {
  if batch.count >= batch.capacity {
    ret
  }
  packInstanceRecord(
    records: batch.records
    slot: batch.count
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: instanceEmissive(material: material)
    toon: toonFlag(material: material)
    paletteBase: code
  )
  batch.count = batch.count + 1
}

func addInstanceTransformEmblem(
  batch: mod InstanceBatch
  transform: view Transform3d
  prevTransform: view Transform3d
  material: view Material3d
  code: copy Int
) pub {
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  addInstanceEmblem(
    batch: batch
    model: model
    prevModel: prevModel
    material: material
    code: code
  )
}

# Draw the whole batch in one instanced DrawIndexed. Must be called inside the
# geometry pass (between Gbuffer.begin and Gbuffer.end), like any other draw.
func drawInstances(
  cache: mod GbufferCache
  resources: mod GpuResources
  batch: view InstanceBatch
) pub {
  if batch.count <= 0 {
    ret
  }
  drawRecords(
    cache: cache
    resources: resources
    mesh: batch.meshId
    records: batch.records.data
    count: batch.count
  )
}

# Draw the batch as one instanced SKINNED DrawIndexed. All copies share the one
# joint palette (one pose) — see drawSkinnedRecords. Set the batch mesh to the
# skinned part being drawn (setInstanceBatchMesh) before calling; a multi-part
# character is one drawSkinnedInstances per part.
func drawSkinnedInstances(
  cache: mod GbufferCache
  resources: mod GpuResources
  batch: view InstanceBatch
) pub {
  if batch.count <= 0 {
    ret
  }
  drawSkinnedRecords(
    cache: cache
    resources: resources
    mesh: batch.meshId
    records: batch.records.data
    count: batch.count
  )
}
