# Weather — cloud cover, precipitation and humidity at a place and an hour
# (docs/seasons-and-weather-design.md §5): a small model, deterministic from
# a seed and the date, no simulation.
#
# - A front: a slow noise in time (three scales: about 60, 20 and 7 hours),
#   so the weather changes over hours and days, never jumps. Fronts travel
#   east at weatherFrontSpeed: a place east of another gets its weather
#   later.
# - The wet season (weatherWetness, 0 .. 1): the tropics rain in their
#   summer, the subtropics (the Mediterranean) in their winter, the high
#   latitudes about evenly, a little more in summer.
# - Cloud cover (0 .. 1) rises with the front, sooner in a wet season;
#   precipitation (mm of water an hour) falls under the thickest cover;
#   humidity (0 .. 1) follows the cloud and the rain; the storm (0 .. 1) is
#   the front at its peak, strongest on a summer day (a thunder day).
# - The clouds' kind (weatherCloudType, docs/cloud-rendering-research.md
#   §8.5): fair-weather cumulus on a warm afternoon, stratus under a front,
#   towers on a thunder day; cirrus streaks ahead of a rising front; how
#   high the clouds' base is, and the size of their shapes.
# - How dark the clouds are comes from the rain and the storm, not from the
#   cover (weatherCloudDarkness): a full cover with no rain is a bright,
#   white-gray sky, and rain or a storm darkens it.
#
# - The wind (lib/WeatherWind, docs/leaf-particles-design.md §2.1): its
#   speed (m/s), direction and gustiness from the season, the front's
#   passage, the hour and the latitude's prevailing wind.
#
# lib/Climate takes the weather's precipitation for its snow and lets
# clouds and rain cool the day (climateWeatherAir); the walkers dim the
# sun and the sky by the cover (app3d/SettingsSky) and drive lib/Wind from
# the weather's wind (windSettingsFromWeather).
import Math
open WeatherWind

type Weather {
  cloud: Float = 0.0
  precipitation: Float = 0.0
  humidity: Float = 0.5
  front: Float = 0.5
  # how stormy (0 .. 1): the front at its peak, a thunder day in summer;
  # what darkens the clouds besides the rain (weatherCloudDarkness)
  storm: Float = 0.0
  # what kind the clouds are (0 stratus, an even sheet .. 0.5 stratocumulus
  # .. 1 cumulus, separate rounded puffs; the cloud map's type channel of
  # docs/cloud-rendering-research.md §2.2), how much thin high cirrus there
  # is (0 .. 1), the height of the clouds' base (m) and the size of their
  # shapes (1: the type's own)
  cloudType: Float = 0.6
  cirrus: Float = 0.0
  cloudHeight: Float = 1200.0
  cloudScale: Float = 1.0
  # the mean wind at 10 m (m/s), the direction it blows toward (radians,
  # 0 toward east (+x), counter-clockwise, as lib/Wind) and its gustiness
  # (0 .. 1)
  windSpeed: Float = 5.0
  windAngle: Float = 0.6
  gustiness: Float = 0.6
}

# The seed every place shares unless an app sets its own
const weatherDefaultSeed: Int = 7

# How fast fronts travel east (km an hour)
const weatherFrontSpeed: Float = 40.0

const weatherPi: Float = 3.14159265

# A smooth noise in time: 0 .. 1, a new value every `period` hours, eased
# between them
func weatherNoise(seed: view Int, hours: view Float, period: view Float) ret Float {
  let t: Float = hours / period
  let whole: Float = Math.floor(x: t)
  let u: Float = t - whole
  let ease: Float = u * u * (3.0 - 2.0 * u)
  let index: Int = whole.toInt()
  ret weatherHash(seed: seed, index: index) * (1.0 - ease) + weatherHash(
    seed: seed
    index: index + 1
  ) * ease
}

func weatherHash(seed: view Int, index: view Int) ret Float {
  let mixed: Float = Math.sin(x: index.toFloat() * 12.9898 + seed.toFloat() * 78.233) * 43758.5453
  ret mixed - Math.floor(x: mixed)
}

# The hours since the start of the year 2000 (about): the front's clock
func weatherHours(year: view Int, dayOfYear: view Int, hour: view Float) ret Float {
  ret ((year - 2000) * 366 + dayOfYear).toFloat() * 24.0 + hour
}

# How wet the season is at `latitude` on day `dayOfYear` (0 .. 1)
func weatherWetness(latitude: view Float, dayOfYear: view Int) ret Float {
  # +1 at the local midsummer, -1 at midwinter
  var summer: Float = Math.cos(x: (dayOfYear.toFloat() - 196.0) / 365.25 * 2.0 * weatherPi)
  if latitude < 0.0 {
    summer = -summer
  }
  let away: Float = Math.abs(value: latitude)
  let tropical: Float = 0.5 + 0.4 * summer
  let subtropical: Float = 0.42 - 0.34 * summer
  let northern: Float = 0.6 + 0.1 * summer
  let toSubtropics: Float = weatherRamp(from: 18.0, to: 26.0, value: away)
  let toNorth: Float = weatherRamp(from: 42.0, to: 50.0, value: away)
  let low: Float = tropical + (subtropical - tropical) * toSubtropics
  ret low + (northern - low) * toNorth
}

func weatherRamp(from: view Float, to: view Float, value: view Float) ret Float {
  let t: Float = Math.clamp(val: (value - from) / (to - from), low: 0.0, high: 1.0)
  ret t * t * (3.0 - 2.0 * t)
}

# The weather at `latitude`, `longitude` (degrees) on day `dayOfYear` of
# `year` at `hour` (the scene's clock), from `seed`
func weatherAt(
  seed: view Int
  latitude: view Float
  longitude: view Float
  year: view Int
  dayOfYear: view Int
  hour: view Float
) ret Weather {
  # a front reaches a place east of another later
  let eastKm: Float = longitude * 111.2 * Math.cos(x: latitude * weatherPi / 180.0)
  let hours: Float = weatherHours(year: year, dayOfYear: dayOfYear, hour: hour) - eastKm / weatherFrontSpeed
  let front: Float = weatherFront(seed: seed, hours: hours)
  let wet: Float = weatherWetness(latitude: latitude, dayOfYear: dayOfYear)
  let cloud: Float = weatherRamp(from: 0.54 - 0.3 * wet, to: 0.82 - 0.2 * wet, value: front)
  var precipitation: Float = 0.0
  if cloud > 0.8 {
    precipitation = (cloud - 0.8) / 0.2 * 0.35 * (0.4 + wet)
  }
  let storm: Float = weatherStorm(front: front, latitude: latitude, dayOfYear: dayOfYear)
  let cloudType: Float = weatherCloudType(
    front: front
    storm: storm
    warmth: weatherWarmth(latitude: latitude, dayOfYear: dayOfYear)
    hour: hour
  )
  let wind: WeatherWind = weatherWindAt(
    seed: seed
    latitude: latitude
    dayOfYear: dayOfYear
    hour: hour
    hours: hours
    cloud: cloud
    precipitation: precipitation
  )
  ret Weather {
    cloud: cloud
    precipitation: precipitation
    humidity: Math.clamp(
      val: 0.4 + 0.3 * cloud + 0.2 * wet + 0.1 * Math.min(a: precipitation, b: 1.0)
      low: 0.0
      high: 1.0
    )
    front: front
    storm: storm
    cloudType: cloudType
    cirrus: weatherCirrus(
      seed: seed
      hours: hours
      front: front
      cloud: cloud
    )
    cloudHeight: weatherCloudHeight(cloudType: cloudType, storm: storm)
    cloudScale: 1.0
    windSpeed: wind.speed
    windAngle: wind.angle
    gustiness: wind.gustiness
  }
}

# How warm the season is at `latitude` on day `dayOfYear` (0 the depth of
# winter .. 1 the height of summer, about 15 July in the north)
func weatherWarmth(latitude: view Float, dayOfYear: view Int) ret Float {
  var summer: Float = Math.cos(x: (dayOfYear.toFloat() - 196.0) / 365.25 * 2.0 * weatherPi)
  if latitude < 0.0 {
    summer = -summer
  }
  ret 0.5 + 0.5 * summer
}

# How stormy it is (0 .. 1): the front's peak (0.8 to 0.95, the top of its
# rise), most in the local summer (a thunder day), a third of that in the
# winter
func weatherStorm(front: view Float, latitude: view Float, dayOfYear: view Int) ret Float {
  let warmth: Float = weatherWarmth(latitude: latitude, dayOfYear: dayOfYear)
  ret weatherRamp(from: 0.8, to: 0.95, value: front) * (0.35 + 0.65 * warmth)
}

# What kind the clouds are (0 stratus .. 1 cumulus) at `hour` (the place's
# clock): the sun heating the ground lifts cumulus in the afternoon (from
# about 10:00, gone by 21:00), more in summer (`warmth`, weatherWarmth); a
# front spreads a stratus sheet (from 0.6, all of it by 0.85); a storm
# builds towers again (cumulonimbus)
func weatherCloudType(
  front: view Float
  storm: view Float
  warmth: view Float
  hour: view Float
) ret Float {
  let afternoon: Float = weatherRamp(from: 9.0, to: 13.0, value: hour) * (1.0 - weatherRamp(
    from: 17.0
    to: 21.0
    value: hour
  ))
  let fair: Float = 0.35 + 0.65 * afternoon * (0.4 + 0.6 * warmth)
  let frontal: Float = weatherRamp(from: 0.6, to: 0.85, value: front)
  let sheet: Float = fair + (0.08 - fair) * frontal
  ret Math.clamp(val: Math.max(a: sheet, b: storm), low: 0.0, high: 1.0)
}

# How much thin high cirrus there is (0 .. 1): it runs ahead of a front, so
# it shows while the front is still rising (the front 8 hours later is
# higher than now) and the sky is not yet covered (`cloud`)
func weatherCirrus(
  seed: view Int
  hours: view Float
  front: view Float
  cloud: view Float
) ret Float {
  let rise: Float = weatherFront(seed: seed, hours: hours + 8.0) - front
  ret weatherRamp(from: 0.02, to: 0.12, value: rise) * (1.0 - weatherRamp(
    from: 0.6
    to: 0.95
    value: cloud
  ))
}

# The height of the clouds' base (m) for their kind: a stratus sheet low
# (about 500 m), cumulus higher (about 1400 m), a storm's base lower again
# under its rain
func weatherCloudHeight(cloudType: view Float, storm: view Float) ret Float {
  ret (500.0 + 900.0 * Math.clamp(val: cloudType, low: 0.0, high: 1.0)) * (1.0 - 0.3 * Math.clamp(
    val: storm
    low: 0.0
    high: 1.0
  ))
}

# The front (0 .. 1) at `hours` (weatherHours, shifted by the place's
# longitude): three slow noises
func weatherFront(seed: view Int, hours: view Float) ret Float {
  ret 0.55 * weatherNoise(seed: seed, hours: hours, period: 60.0) + 0.3 * weatherNoise(
    seed: seed + 11
    hours: hours
    period: 20.0
  ) + 0.15 * weatherNoise(seed: seed + 23, hours: hours, period: 7.0)
}

# The weather in a word or two, for the settings panel: "clear", "cloudy",
# "overcast", "rain 1.2 mm/h" (or "snow" when `air` is below freezing)
func weatherName(weather: view Weather, air: view Float) ret String {
  if weather.precipitation > 0.05 {
    let tenths: Int = (weather.precipitation * 10.0 + 0.5).toInt()
    if air < 0.5 {
      ret "snow {tenths / 10}.{tenths % 10} mm/h"
    }
    ret "rain {tenths / 10}.{tenths % 10} mm/h"
  }
  if weather.cloud > 0.75 {
    ret "overcast"
  }
  if weather.cloud > 0.3 {
    ret "cloudy"
  }
  ret "clear"
}

# How near the air is to its dew point, as a factor on a scene's mist
# density (1: the scene's own light haze, up to 6: a thick morning mist):
# humid air, cooled toward dawn (coolest about 05:00 local), more in
# autumn (`autumn`: the slow temperature falling between 2 and 12 °C), and
# gone by midday as the air warms
func weatherMistFactor(weather: view Weather, localHour: view Float, autumn: view Bool) ret Float {
  let cool: Float = 0.5 + 0.5 * Math.cos(x: (localHour - 5.0) / 24.0 * 2.0 * weatherPi)
  var dew: Float = weather.humidity + 0.18 * cool
  if autumn {
    dew = dew + 0.08
  }
  let midday: Float = weatherRamp(from: 9.0, to: 12.0, value: localHour) * (1.0 - weatherRamp(
    from: 17.0
    to: 21.0
    value: localHour
  ))
  ret 1.0 + 5.0 * weatherRamp(from: 0.74, to: 0.95, value: dew) * (1.0 - midday)
}

# The clouds' darkness (0 white .. 1 the dark gray of a storm): the rain
# (up to 0.45 by 0.5 mm/h) and the storm (up to 0.5), and only a little
# from the cover (up to 0.12 as it closes), so a full cover with no rain
# is a bright, white-gray layer
func weatherCloudDarkness(weather: view Weather) ret Float {
  ret Math.min(
    a: 0.12 * weatherRamp(from: 0.8, to: 1.0, value: weather.cloud) + 0.45 * Math.min(
      a: weather.precipitation / 0.5
      b: 1.0
    ) + 0.5 * Math.clamp(val: weather.storm, low: 0.0, high: 1.0)
    b: 1.0
  )
}

# How wet the ground is (0 dry .. 1 wet) at a place at `hour` of day
# `dayOfYear` (the place's clock): wet while it rains and drying over the
# hour after the rain stopped, the weather's last hour sampled in quarters.
# Snow (`air` below freezing) does not wet it.
func weatherGroundWet(
  seed: view Int
  latitude: view Float
  longitude: view Float
  year: view Int
  dayOfYear: view Int
  hour: view Float
  air: view Float
) ret Float {
  if air < 0.5 {
    ret 0.0
  }
  var wet: Float = 0.0
  loop var step: Int = 0, step <= 4, ++step {
    let ago: Float = step.toFloat() * 0.25
    let weather: Weather = weatherAt(
      seed: seed
      latitude: latitude
      longitude: longitude
      year: year
      dayOfYear: dayOfYear
      hour: hour - ago
    )
    if weather.precipitation > 0.05 {
      wet = Math.max(a: wet, b: 1.0 - ago)
    }
  }
  ret wet
}
