# GbufferPassesNative — the C-ABI accessor layer of the post passes (#918
# split of GbufferPasses for the 1000-line cap; #923 shrank it to what is still
# C): the deferred prepare (device + surface up, the shadow cascade defaults
# the lighting bind samples), the WGSL sources the Rae pipelines are built
# from, the dynamic render scale (#530) and the shadow inputs the lighting
# pass adopts until #925 moves the cascades. The targets, uniforms, pipelines
# and per-frame state are the Rae DeferredTargets (GbufferTargets.rae).
import String
open Gbuffer
open Scene3d
open Vec3
open Sky
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds
open GbufferPasses

# 1 when the device + surface are up; also makes sure the shadow cascade
# defaults exist (the lighting bind samples the array even when no shadow
# pass ran — wgpu aborts on a null binding rather than returning an error).
func nativeGbDeferredPrepare() unsafe extern("rae_gb_deferred_prepare") ret Int

# The pass WGSL sources stay C string constants; read as NUL-terminated C
# strings and copied into a String for the manager's createRenderPipeline.
func gbCompositeWgsl() unsafe extern("rae_gb_composite_wgsl") ret Buffer(Any)

func gbAoWgsl() unsafe extern("rae_gb_ao_wgsl") ret Buffer(Any)

func gbLightWgsl() unsafe extern("rae_gb_light_wgsl") ret Buffer(Any)

func gbTaaWgsl() unsafe extern("rae_gb_taa_wgsl") ret Buffer(Any)

func gbPyrFromDepthWgsl() unsafe extern("rae_gb_pyr_from_depth_wgsl") ret Buffer(Any)

func gbPyrReduceWgsl() unsafe extern("rae_gb_pyr_reduce_wgsl") ret Buffer(Any)

# Dynamic resolution (#530): the current render scale (the upscale sampler is
# a manager sampler on the composite cache).
func nativeGbRenderScale() unsafe extern("rae_gb_render_scale") ret Float64

func gbRenderScale() ret Float64 {
  unsafe {
    ret nativeGbRenderScale()
  }
}
