# Renderer-owned, cutout sRGB image array for static mesh materials.
# Install once before drawing; Material3d.colorTextureLayer indexes this array.
# A renderer with no images uses a single white texel. No per-frame uploads.
import Image
open SurfaceImagePixels
import Math
open gpu/GpuResources
open gpu/GpuTextures
open gpu/GpuIds
open gpu/GpuRender
open webgpu/Webgpu
open webgpu/Context

# The most material images one renderer's array holds. The array is made
# with exactly as many layers as pictures are loaded, so the cap costs
# nothing by itself; each loaded layer is about 1.4 MB of GPU memory (512 x
# 512 RGBA8 with its mip levels). WebGPU guarantees 256 layers per array
# (maxTextureArrayLayers); the shaders ask the array for its layer count.
# Was 16 until example 143's forest filled it and the T02 trees' bark
# picture was refused.
const surfaceImageMaxLayers: Int = 64

# A layer named `made:<name>` in `paths` is a picture made in memory
# (rendererAddSurfaceImagePixels): its linear RGBA pixels are kept in
# madePixels, at the same index as its name in madeNames, so the array can
# be rebuilt with it when another image is added.
const surfaceMadePrefix: String = "made:"

type SurfaceImages {
  paths: List(String) = List.create(String, cap: 0)
  madeNames: List(String) = List.create(String, cap: 0)
  madePixels: List(List(Float)) = List.create(List(Float), cap: 0)
  texture: TextureId = noTextureId()
  textureView: TextureViewId = noTextureViewId()
  sampler: SamplerId = noSamplerId()
  generation: Int = 0
  # true: `paths` holds images queued since the array was last built
  # (RendererImages.rendererQueueSurfaceImage); the array is rebuilt once
  # before it is next used
  stale: Bool = false
}

func retireSurfaceImages(images: mod SurfaceImages, resources: mod GpuResources) {
  retireTextureView(resources: resources, id: images.textureView)
  retireTexture(resources: resources, id: images.texture)
  retireSampler(resources: resources, id: images.sampler)
  let generation: Int = images.generation + 1
  images = SurfaceImages { generation: generation }
}

func surfaceLinear(value: view Float) ret Float {
  if value <= 0.04045 {
    ret value / 12.92
  }
  ret Math.pow(base: (value + 0.055) / 1.055, exp: 2.4)
}

func surfaceEncoded(value: view Float) ret UInt8 {
  var encoded: Float = value * 12.92
  if value > 0.0031308 {
    encoded = 1.055 * Math.pow(base: value, exp: 1.0 / 2.4) - 0.055
  }
  ret Math.clamp(val: encoded * 255.0 + 0.5, low: 0.0, high: 255.0).toInt() as UInt8
}

# The list is borrowed only during the synchronous queue copy. All dimensions
# come from the array created by setSurfaceImages below, never caller metadata.
func uploadSurfaceLevel(
  images: view SurfaceImages
  resources: view GpuResources
  pixels: view List(Float)
  size: view Int
  layer: view Int
  level: view Int
) {
  var bytes: List(UInt8) = List.create(UInt8, cap: size * size * 4)
  loop var pixel: Int = 0, pixel < size * size, ++pixel {
    loop var channel: Int = 0, channel < 3, ++channel {
      bytes.add(value: surfaceEncoded(value: pixels.copyAtDefault(index: pixel * 4 + channel)))
    }
    bytes.add(
      value: (Math.clamp(val: pixels.copyAtDefault(index: pixel * 4 + 3), low: 0.0, high: 1.0) * 255.0 + 0.5).toInt() as UInt8
    )
  }
  unsafe {
    let destination: WGPUTexelCopyTextureInfo = {
      texture: textureHandle(resources: resources, id: images.texture)
      mipLevel: level as UInt32
      origin: { x: 0, y: 0, z: layer as UInt32 }
      aspect: WGPUTextureAspect_All
    }
    let layout: WGPUTexelCopyBufferLayout = {
      bytesPerRow: (size * 4) as UInt32
      rowsPerImage: size as UInt32
    }
    let extent: WGPUExtent3D = {
      width: size as UInt32
      height: size as UInt32
      depthOrArrayLayers: 1
    }
    wgpuQueueWriteTexture(
      queue: webgpuQueue()
      destination: destination
      data: bytes.data
      dataSize: bytes.length as UInt64
      dataLayout: layout
      writeSize: extent
    )
  }
}

# Load bounded square RGBA PNG layers, generate box-filtered mips in linear light,
# and use hardware sRGB decoding. Failure leaves the previous array intact.
func setSurfaceImages(
  images: mod SurfaceImages
  resources: mod GpuResources
  paths: view List(String)
) ret Bool {
  if paths.length > surfaceImageMaxLayers {
    log("surface images support at most {surfaceImageMaxLayers} layers per renderer")
    ret false
  }
  let size: Int = 512
  var decoded: List(List(Float)) = List.create(List(Float), cap: paths.length)
  loop let path: view String in paths {
    if path.startsWith(prefix: surfaceMadePrefix) {
      var found: Bool = false
      loop var made: Int = 0, made < images.madeNames.length, ++made {
        if images.madeNames.copyAtDefault(index: made) is path {
          if let pixels: view List(Float) = images.madePixels.viewAt(index: made) {
            decoded.add(value: pixels)
            found = true
          }
        }
      }
      if not found {
        log("surface image {path} was made in memory but its pixels are gone")
        ret false
      }
      continue
    }
    var width: Int = 0
    var height: Int = 0
    let pixels: Buffer(Int) = Image.loadPng(path: path, width: width, height: height)
    if width is not size or height is not size {
      log("surface image must be a 512 x 512 PNG: {path}")
      ret false
    }
    var linear: List(Float) = List.create(Float, cap: size * size * 4)
    loop var pixel: Int = 0, pixel < size * size, ++pixel {
      var packed: Int = 0
      unsafe {
        packed = rae_ext_rae_buf_get(Int, buf: pixels, index: pixel)
      }
      linear.add(value: surfaceLinear(value: ((packed / 65536) % 256).toFloat() / 255.0))
      linear.add(value: surfaceLinear(value: ((packed / 256) % 256).toFloat() / 255.0))
      linear.add(value: surfaceLinear(value: (packed % 256).toFloat() / 255.0))
      linear.add(value: ((packed / 16777216) % 256).toFloat() / 255.0)
    }
    decoded.add(value: own linear)
  }
  ret uploadSurfaceImages(
    images: images
    resources: resources
    paths: paths
    decoded: own decoded
    size: size
  )
}

# Install pictures made in memory (one list per layer: `size` x `size`
# pixels of linear RGBA floats, alpha 0..1), e.g. a picture painted in Rae
# with see-through parts, which a PNG written by Image.savePng (RGB only)
# cannot carry. `size` is a power of two.
func setSurfaceImagePixels(
  images: mod SurfaceImages
  resources: mod GpuResources
  layers: view List(List(Float))
  size: view Int
) ret Bool {
  if layers.length > surfaceImageMaxLayers {
    log("surface images support at most {surfaceImageMaxLayers} layers per renderer")
    ret false
  }
  var decoded: List(List(Float)) = List.create(List(Float), cap: layers.length)
  loop let layer: view List(Float) in layers {
    if layer.length is not size * size * 4 {
      log("a surface image layer must have {size} x {size} RGBA pixels")
      ret false
    }
    decoded.add(value: layer)
  }
  ret uploadSurfaceImages(
    images: images
    resources: resources
    paths: List.create(String, cap: 0)
    decoded: own decoded
    size: size
  )
}

# The texture array, its mip levels, view and sampler for decoded layers
func uploadSurfaceImages(
  images: mod SurfaceImages
  resources: mod GpuResources
  paths: view List(String)
  decoded: own List(List(Float))
  size: view Int
) ret Bool {
  var imageSize: Int = size
  var levels: Int = 1
  var side: Int = size
  loop side > 1 {
    side = side / 2
    levels = levels + 1
  }
  if decoded.length is 0 {
    imageSize = 1
    levels = 1
    let white: List(Float) = { 1.0, 1.0, 1.0, 1.0 }
    decoded.add(value: white)
  }
  var candidate: SurfaceImages = {
    paths: paths
    madeNames: images.madeNames
    madePixels: images.madePixels
    generation: images.generation + 1
  }
  if let texture: TextureId = createTextureArrayMipped(
    resources: resources
    width: imageSize
    height: imageSize
    layers: decoded.length
    format: WGPUTextureFormat_RGBA8UnormSrgb
    usage: WGPUTextureUsage_CopyDst + WGPUTextureUsage_TextureBinding
    mipLevels: levels
  ) {
    candidate.texture = texture
  } else {
    ret false
  }
  loop var layer: Int = 0, layer < decoded.length, ++layer {
    var pixels: List(Float) = decoded.copyAtDefault(index: layer)
    var side: Int = imageSize
    loop var level: Int = 0, level < levels, ++level {
      uploadSurfaceLevel(
        images: candidate
        resources: resources
        pixels: pixels
        size: side
        layer: layer
        level: level
      )
      if side > 1 {
        pixels = surfaceDownsample(pixels: pixels, side: side)
        side = side / 2
      }
    }
  }
  if let textureView: TextureViewId = createTextureViewRange(
    resources: resources
    texture: candidate.texture
    range: {
      baseMip: 0
      mipCount: levels
      baseLayer: 0
      layerCount: decoded.length
      dimension: WGPUTextureViewDimension_2DArray
    }
  ) {
    candidate.textureView = textureView
  }
  if let sampler: SamplerId = createSamplerMipped(
    resources: resources
    addressMode: WGPUAddressMode_Repeat
  ) {
    candidate.sampler = sampler
  }
  if not isValidTextureView(resources: resources, id: candidate.textureView) or not isValidSampler(
    resources: resources
    id: candidate.sampler
  ) {
    retireSurfaceImages(images: candidate, resources: resources)
    ret false
  }
  retireSurfaceImages(images: images, resources: resources)
  images = own candidate
  ret true
}

# Build the array with the images queued since it was last built, once
func flushSurfaceImages(images: mod SurfaceImages, resources: mod GpuResources) {
  if not images.stale {
    ret
  }
  let paths: List(String) = images.paths
  if not setSurfaceImages(images: images, resources: resources, paths: paths) {
    log("could not build the queued material images ({paths.length} layers)")
  }
  images.stale = false
}

func surfaceImageEntries(
  images: mod SurfaceImages
  resources: mod GpuResources
  entries: mod List(ResourceRef)
) {
  if images.stale {
    flushSurfaceImages(images: images, resources: resources)
  }
  if not isValidTextureView(resources: resources, id: images.textureView) {
    setSurfaceImages(images: images, resources: resources, paths: List.create(String, cap: 0))
  }
  entries.add(value: textureViewRef(id: images.textureView))
  entries.add(value: samplerRef(id: images.sampler))
}
