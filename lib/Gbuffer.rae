# + the frame uniform, draws buffer and joint palette. The palette comes up
# asynchronously, so a readiness check defers creation until it exists.
func gbSkinPalette() unsafe extern("rae_gb_skin_palette") ret Ptr
func nativeGbSkinPaletteSize() unsafe extern("rae_gb_skin_palette_size") ret Int
