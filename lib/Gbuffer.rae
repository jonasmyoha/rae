# gbuffer — the deferred frame's geometry pass (#356, Track B).
#
# This module is to `renderer_deferred` what `gpu3d` is to `renderer3d`:
# the GPU seam. `renderer_deferred` owns the frame graph and dispatches
# passes; this owns the typed encoding of one of them.
#
# WHAT MAKES IT DEFERRED. The pass writes surface ATTRIBUTES — albedo,
# world normal, metallic/roughness, depth — and performs no lighting at
# all. Lighting later reads those attributes once per pixel, so its cost
# stops scaling with the number of objects that contributed. That is the
# entire reason the frame is being rebuilt this way; a version of this
# module that shaded here would be the forward renderer wearing a new
# name.
#
# WHY THE G-BUFFER IS PACKED THE WAY IT IS (#366). Three targets plus
# depth, 16 bytes per pixel, with channels packed ACROSS targets rather
# than grouped by meaning — bandwidth is the point, and an unused channel
# is bandwidth spent on nothing:
#
#   A  oct(normal).xy at 10 bits, reserved, 2-bit shading mode
#   B  albedo.rgb, roughness
#   C  motion.xy, metallic, occlusion-or-emissive
#
# Octahedral normals are what make it fit: a unit vector has two degrees of
# freedom, so three channels waste one. The 10-bit depth is not incidental
# — 8-bit octahedral bands visibly on smooth surfaces.
#
# World position is still not stored: it reconstructs from depth, which is
# written anyway, so storing it would be three redundant channels.
#
# ALLOCATION-FREE PER OBJECT (#356's acceptance criterion). Transforms
# flow through `Mat4` from lib/math3d.rae — 16 Floats by value, an
# `Array(Float, cap: 16)` that lives on the stack. `beginPass` builds the
# view-projection from value types and hands it over by view; `drawInstance`
# builds a model matrix the same way. Neither touches the allocator, and
# test 573 asserts that by counting allocations across a many-object frame
# rather than trusting this paragraph.
#
# WORLD CONVENTION: right-handed Z-up (Blender), per
# docs/coordinate-system.md — the same as the forward path.
import Math
import String
open SkyHosek
open Vec3
open Scene3d
open Sky
open Math3d
open GbufferRecord
open ecs/Entity  # #793: World3d render path reads entities/components
open ecs/ComponentTable
# The instanced draw path (#502) runs in Rae directly on the WebGPU bindings.
# `open webgpu/webgpu` also makes the sibling enum/flag consts (e.g.
# WGPUIndexFormat_Uint32) resolvable as bare cheader-backed references; do NOT
# `open webgpu/webgpu_enums` — importing that module emits every enum value as a
# C definition, colliding with the real enumerators from the cheader.
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuRenderTransfer
open gpu/GpuIds
open Gpu2dCanvas
open MeshStore
open GbufferNative
open GbufferResources

# ----- geometry-pass begin (#503, manager-owned since #906) -------------------
# The frame is the GbufferCache's: manager targets (rebuilt to the offscreen
# size), a manager frame uniform + draws buffer, and a manager Recording per
# frame whose multi-attachment pass (3 G-buffer colour views + depth) every
# draw records into; end() submits it TRACKED (the cache polls its in-flight
# submissions). C computes the frame-derived uniform data (TAA jitter, previous
# view-projection) into the Rae buffer and BORROWS the four views for the
# post passes that are still C (read through gbViewA..gbViewDepth below).
func gbViewA() unsafe extern("rae_gb_view_a") ret Ptr

func gbViewB() unsafe extern("rae_gb_view_b") ret Ptr

func gbViewC() unsafe extern("rae_gb_view_c") ret Ptr

func gbViewDepth() unsafe extern("rae_gb_view_depth") ret Ptr

# True while C holds the borrowed target views (between the first begin and
# the renderer's shutdown) — what the still-C post passes read.
func gbTargetsBorrowed() ret Bool {
  unsafe {
    ret gbViewDepth() is not webgpuNull()
  }
}

func g2dFormat() ret Int {
  unsafe {
    ret nativeG2dFormat()
  }
}

func gbTargetsGen() ret Int {
  unsafe {
    ret nativeGbTargetsGen()
  }
}

# #764: the G-buffer geometry pass caches — the "have I made the pipelines /
# buffers / static+skin binds" flags, plus the reused attachment arrays and the
# per-draw instance-record scratch (all zero-alloc, #573) — were module-level
# globals. They are per-frame state a deferred renderer owns, so they live in a
# GbufferCache on RenderPasses, threaded from DeferredRenderer through beginPass /
# renderSceneWorld and the draw entry points.
# #912: the geometry pass's objects are typed IDs in the DeferredRenderer-owned
# manager — the static / skin / terrain pipelines and their bind groups.
# #906: so are the frame itself — the four targets (A, B, C, depth) + views,
# the frame uniform, the draws buffer with its per-frame cursor, and the open
# frame's Recording / raw pass + the tracked in-flight submissions. Only the
# skin palette (C, until #921) is still adopted in `adopted`.
type GbufferCache {
  targets: List(TextureId)  # A, B, C, depth (index 0..3)
  targetViews: List(TextureViewId)
  targetWidth: Int
  targetHeight: Int
  targetsGen: Int  # bumped per rebuild; the post passes re-fit on it
  frameUniform: BufferId
  draws: BufferId
  frameFloats: List(Float)  # the frame uniform's 36 floats, C-computed
  drawCount: Int  # the draws-buffer cursor, reset per begin
  recording: opt Recording  # the open frame's manager recording
  pass: Ptr  # the open geometry pass (null between frames)
  inFlight: List(SubmissionId)
  pipelinesMade: Bool
  staticPipeline: RenderPipelineId
  skinPipeline: RenderPipelineId
  staticBind: BindGroupId
  skinBind: BindGroupId
  adopted: List(ExternalId)
  drawScratch: List(Float)
  # terrain-splat pass pipeline/bind cache (#764: was gbuffer_terrain gTerrain* globals)
  terrainPipeMade: Bool
  terrainBindGen: Int
  terrainPipeline: RenderPipelineId
  terrainBind: BindGroupId
  terrainSampler: SamplerId
  terrainAdopted: List(ExternalId)
  terrainBlend: Float
  meshes: MeshStore  # #905: the static mesh store (vertex/index buffers per MeshHandle)
}

func createGbufferCache() pub ret GbufferCache {
  unsafe {
    ret GbufferCache {
      targets: fillTextureIds(count: gbufferTargetCount)
      targetViews: fillTextureViewIds(count: gbufferTargetCount)
      targetWidth: 0
      targetHeight: 0
      targetsGen: 0
      frameUniform: noBufferId()
      draws: noBufferId()
      frameFloats: List.create(Float, cap: gbufferFrameFloats)
      drawCount: 0
      recording: none
      pass: webgpuNull()
      inFlight: List.create(SubmissionId, cap: 4)
      pipelinesMade: false
      staticPipeline: noRenderPipelineId()
      skinPipeline: noRenderPipelineId()
      staticBind: noBindGroupId()
      skinBind: noBindGroupId()
      adopted: List.create(ExternalId, cap: 6)
      drawScratch: List.create(Float, cap: instanceRecordFloats)
      terrainPipeMade: false
      terrainBindGen: 0 - 1
      terrainPipeline: noRenderPipelineId()
      terrainBind: noBindGroupId()
      terrainSampler: noSamplerId()
      terrainAdopted: List.create(ExternalId, cap: 4)
      terrainBlend: 0.0
      meshes: createMeshStore()
    }
  }
}

func gbReadWgsl(path: copy String) ret String {
  unsafe {
    ret nativeGbReadWgsl(path: path)
  }
}

# The static vertex layout: position, normal, uv.
func gbufferStaticAttributes() pub ret List(VertexAttributeSpec) {
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 3)
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0, location: 0 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12, location: 1 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24, location: 2 })
  ret attributes
}

func begin(
  cache: mod GbufferCache
  resources: mod GpuResources
  viewProj: view Mat4
  clearR: copy Float
  clearG: copy Float
  clearB: copy Float
) pub {
  if gbPrepare() is 0 {
    ret
  }
  if gbufferFrameActive(cache: cache) {
    ret
  }
  ensurePipelines(cache: cache, resources: resources)
  ensureTargets(cache: cache, resources: resources)
  if not gbufferTargetsReady(cache: cache, resources: resources) {
    ret
  }
  ensureGbBuffers(cache: cache, resources: resources)
  ensureStaticBind(cache: cache, resources: resources)
  if not uploadFrameUniform(
    cache: cache
    resources: resources
    viewProj: viewProj
    clearR: clearR
    clearG: clearG
    clearB: clearB
  ) {
    ret
  }
  cache.drawCount = 0
  # A: octahedral normal + shading mode. (0.5, 0.5) decodes to +Z, mode 0 = lit.
  # B: albedo, cleared to the sky/background colour.
  # C: material/motion. Motion clears to the biased zero (no movement).
  # Depth: reverse-Z, so the far plane clears to 0 (#367).
  let motionZero: Float = gbMotionZero()
  var targets: RenderTargetSet = createRenderTargetSet(clear: true)
  addColorTarget(
    targets: targets
    colorView: gbufferTargetRef(cache: cache, index: gbufferTargetA)
    r: 0.5
    g: 0.5
    b: 0.0
    a: 0.0
  )
  addColorTarget(
    targets: targets
    colorView: gbufferTargetRef(cache: cache, index: gbufferTargetB)
    r: clearR
    g: clearG
    b: clearB
    a: 1.0
  )
  addColorTarget(
    targets: targets
    colorView: gbufferTargetRef(cache: cache, index: gbufferTargetC)
    r: motionZero
    g: motionZero
    b: 0.0
    a: 1.0
  )
  setDepthTarget(
    targets: targets
    depthView: gbufferTargetRef(cache: cache, index: gbufferTargetDepth)
    clear: true
    clearValue: 0.0
    readOnly: false
  )
  if let recording: Recording = beginRecording(resources: resources) {
    var opened: Recording = own recording
    unsafe {
      cache.pass = beginRenderPassMulti(recording: opened, resources: resources, targets: targets)
    }
    cache.recording = own opened
  }
  # Every draw binds its own pipeline + group (gbIssueInstanced), so the pass
  # opens with nothing bound; the C-prepared SDF draw binds its own too.
  if gbufferFrameActive(cache: cache) {
    gbSetFrameOpen(open: 1)
  }
}

# The frame uniform's data is C math (jitter + previous view-projection,
# remembered there for the still-C post passes); Rae uploads it into its
# manager buffer.
func uploadFrameUniform(
  cache: mod GbufferCache
  resources: mod GpuResources
  viewProj: view Mat4
  clearR: copy Float
  clearG: copy Float
  clearB: copy Float
) ret Bool {
  loop cache.frameFloats.length < gbufferFrameFloats {
    cache.frameFloats.add(value: 0.0)
  }
  unsafe {
    if gbFrameData(
      viewProj: viewProj
      clearR: clearR
      clearG: clearG
      clearB: clearB
      w: cache.targetWidth
      h: cache.targetHeight
      out: cache.frameFloats.data
    ) is 0 {
      ret false
    }
    ret writeBufferFromPtr(
      resources: resources
      id: cache.frameUniform
      offset: 0
      data: cache.frameFloats.data
      size: gbufferFrameFloats * 4
    )
  }
}

func gbufferFrameActive(cache: view GbufferCache) ret Bool {
  unsafe {
    ret cache.pass is not webgpuNull()
  }
}

# Shared tail of every G-buffer draw (#502/#503): upload `count` DrawU records
# (already at `records`) into the draws storage buffer at slot `base`, bind the
# given pipeline / bind group / mesh buffers, and issue one instanced
# DrawIndexed. Every draw — static, skinned, instanced — funnels through here,
# so the whole encoding lives in Rae over the generated bindings, no C shim.
func gbIssueInstanced(
  cache: mod GbufferCache
  resources: mod GpuResources
  pipeline: view RenderPipelineId
  bind: view BindGroupId
  vbuf: copy Ptr
  ibuf: copy Ptr
  icount: copy Int
  base: copy Int
  count: copy Int
  records: copy Ptr
) {
  unsafe {
    let strideBytes: Int = instanceRecordFloats * 4
    if not writeBufferFromPtr(
      resources: resources
      id: cache.draws
      offset: base * strideBytes
      data: records
      size: count * strideBytes
    ) {
      ret
    }
    if recordDrawIndexedInPass(
      resources: resources
      pass: cache.pass
      pipeline: pipeline
      bindGroup: bind
      vertexBuffer: vbuf
      indexBuffer: ibuf
      indexCount: icount
      instanceCount: count
      firstInstance: base
    ) {
      gbAdvanceDraws(cache: cache, count: count)
    }
  }
}

# Instanced G-buffer draw (grass epic #485, ported to Rae #502): one draw for
# `count` copies of a mesh. `records` is `count` * instanceRecordFloats fully
# built DrawU entries (model, prevModel, colour, packed params), assembled in
# Rae by swayModel + packInstanceRecord below. Rae uploads the records straight
# into the draws storage buffer and issues one instanced DrawIndexed on the
# static pipeline — no C shim. A skinned draw may have left its pipeline bound,
# so gbIssueInstanced re-binds the static one.
func drawRecords(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: copy Int
  records: copy Ptr
  count: copy Int
) pub {
  unsafe {
    if gbMeshReady(cache: cache, resources: resources, mesh: mesh) is 0 {
      ret
    }
    let base: Int = gbDrawCount(cache: cache)
    let remaining: Int = gbufferMaxDraws - base
    var n: Int = count
    if n > remaining {
      n = remaining
    }
    if n <= 0 {
      ret
    }
    gbIssueInstanced(
      cache: cache
      resources: resources
      pipeline: cache.staticPipeline
      bind: cache.staticBind
      vbuf: gbMeshVbuf(cache: cache, resources: resources, mesh: mesh)
      ibuf: gbMeshIbuf(cache: cache, resources: resources, mesh: mesh)
      icount: gbMeshIcount(cache: cache, mesh: mesh)
      base: base
      count: n
      records: records
    )
  }
}

# The draws-buffer cursor (#906, was C's gb_draw_count): every G-buffer draw
# — static, skinned, instanced, terrain, sprite, grass, transparent — writes
# its DrawU records at the cursor and advances it; begin() resets it.
func gbDrawCount(cache: view GbufferCache) ret Int {
  ret cache.drawCount
}

func gbAdvanceDraws(cache: mod GbufferCache, count: copy Int) {
  if count <= 0 {
    ret
  }
  cache.drawCount = cache.drawCount + count
  if cache.drawCount > gbufferMaxDraws {
    cache.drawCount = gbufferMaxDraws
  }
}

# #905: mesh lookups go to the cache's MeshStore. "Ready to draw" also needs
# the geometry pass open (the C rae_gb_mesh_ready folded that in).
func gbMeshReady(cache: view GbufferCache, resources: view GpuResources, mesh: copy Int) ret Int {
  if not gbufferFrameActive(cache: cache) {
    ret 0
  }
  if meshStoreReady(store: cache.meshes, resources: resources, mesh: mesh) {
    ret 1
  }
  ret 0
}

func gbMeshVbuf(
  cache: view GbufferCache
  resources: view GpuResources
  mesh: copy Int
) unsafe ret Ptr {
  unsafe {
    ret meshStoreVbufHandle(store: cache.meshes, resources: resources, mesh: mesh)
  }
}

func gbMeshIbuf(
  cache: view GbufferCache
  resources: view GpuResources
  mesh: copy Int
) unsafe ret Ptr {
  unsafe {
    ret meshStoreIbufHandle(store: cache.meshes, resources: resources, mesh: mesh)
  }
}

func gbMeshIcount(cache: view GbufferCache, mesh: copy Int) ret Int {
  ret meshStoreIndexCount(store: cache.meshes, mesh: mesh)
}

# Skin bind group creation (#503): built in Rae from the skin pipeline's layout
# + the frame uniform, draws buffer and joint palette. The palette comes up
# asynchronously, so a readiness check defers creation until it exists.
func gbSkinPalette() unsafe extern("rae_gb_skin_palette") ret Ptr

func gbSkinPaletteSize() ret Int {
  unsafe {
    ret nativeGbSkinPaletteSize()
  }
}

func gbSkinPaletteReady() ret Int {
  unsafe {
    ret nativeGbSkinPaletteReady()
  }
}

func drawMetaballs(
  cache: view GbufferCache
  packedBalls: copy Ptr
  count: copy Int
  packedColors: copy Ptr
  smoothing: copy Float
  camX: copy Float
  camY: copy Float
  camZ: copy Float
  metallic: copy Float
  roughness: copy Float
  emR: copy Float
  emG: copy Float
  emB: copy Float
) pub {
  unsafe {
    let gi: Int = gbSdfPrepare(
      packedBalls: packedBalls
      count: count
      packedColors: packedColors
      smoothing: smoothing
      camX: camX
      camY: camY
      camZ: camZ
      metallic: metallic
      roughness: roughness
      emR: emR
      emG: emG
      emB: emB
    )
    if gi < 0 {
      ret
    }
    let pass: Ptr = cache.pass
    if pass is webgpuNull() {
      ret
    }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: gbSdfPipeline())
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: gbSdfBind(gi: gi)
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
    wgpuRenderPassEncoderDraw(
      renderPassEncoder: pass
      vertexCount: 3 as UInt32
      instanceCount: 1 as UInt32
      firstVertex: 0 as UInt32
      firstInstance: 0 as UInt32
    )
    # No restore: every G-buffer draw binds its own pipeline + group (#912).
  }
}

# #920: present copies the canvas-owned offscreen texture (borrowed by C).
func nativePresent(texture: Ptr, width: Int, height: Int) unsafe extern("rae_ext_Gbuffer_present")

func present(canvas: mod Gpu2dCanvas) {
  unsafe {
    nativePresent(
      texture: canvasOffscreenTexture(canvas: canvas)
      width: canvas.offscreenWidth
      height: canvas.offscreenHeight
    )
  }
}

func nativeShutdown() unsafe extern("rae_ext_Gbuffer_shutdown")

func shutdown() {
  unsafe {
    nativeShutdown()
  }
}

# ----- G-buffer inspector modes ---------------------------------------
# Permanent equipment, not scaffolding: when a lit image is wrong the
# first question is always WHICH attribute is wrong, and that cannot be
# answered without looking at the channels directly.
const viewLit: Int = 0  # the composed/lit image (once lighting lands)

const viewAlbedo: Int = 1

const viewNormal: Int = 2

const viewMaterial: Int = 3  # r = metallic, g = roughness, b = occlusion/emissive

const viewDepth: Int = 4  # linearised for display

# Start the geometry pass. `aspect` is width/height of the target.
#
# The view-projection is built here from value types and passed by view:
# mat4LookAt, mat4Perspective and mat4Mul all return `Mat4` by value, so
# the whole chain is stack traffic. The forward path packs an equivalent
# block into a List(Float) — one allocation per frame — which this
# deliberately does not inherit.
func beginPass(
  cache: mod GbufferCache
  resources: mod GpuResources
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
) pub {
  let worldUp: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let viewM: Mat4 = mat4LookAt(
    eyeX: camera.position.x
    eyeY: camera.position.y
    eyeZ: camera.position.z
    atX: camera.target.x
    atY: camera.target.y
    atZ: camera.target.z
    upX: worldUp.x
    upY: worldUp.y
    upZ: worldUp.z
  )
  # Reverse-Z (#367): near maps to 1, far to 0, which is what the geometry
  # pass's Greater depth test and 0.0 clear expect. The forward frame keeps
  # mat4Perspective — the two conventions must not be mixed.
  let proj: Mat4 = mat4PerspectiveReverseZ(
    fovYDeg: camera.fovYDeg
    aspect: aspect
    near: camera.nearZ
    far: camera.farZ
  )
  let viewProj: Mat4 = mat4Mul(a: proj, b: viewM)
  begin(
    cache: cache
    resources: resources
    viewProj: viewProj
    clearR: light.clearColor.x
    clearG: light.clearColor.y
    clearB: light.clearColor.z
  )
}

# Reusable one-record scratch for the single-draw paths (#503), so a static or
# skinned draw builds its DrawU entry without allocating per call — the grass
# path reuses a caller-owned List the same way. Grown to instanceRecordFloats
# once, on the first draw that actually runs (never in a headless/no-device
# build, where the readiness checks below return first). Never resized after, so
# .data stays stable.
func ensureDrawScratch(cache: mod GbufferCache) {
  unsafe {
    loop cache.drawScratch.length < instanceRecordFloats {
      cache.drawScratch.add(value: 0.0)
    }
  }
}

# One static mesh instance into the G-buffer (#503, was the C `draw`). Builds the
# single DrawU record in Rae (packInstanceRecord) and issues it through the same
# Rae upload+draw path as the instanced grass — the static pipeline reads
# draws[instance_index], so one record at firstInstance=base is this draw.
func draw(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: copy Int
  model: view Mat4
  prevModel: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  metallic: copy Float
  roughness: copy Float
  emissive: copy Float
  toon: copy Int
) pub {
  unsafe {
    if gbMeshReady(cache: cache, resources: resources, mesh: mesh) is 0 {
      ret
    }
    let base: Int = gbDrawCount(cache: cache)
    if base >= gbufferMaxDraws {
      ret
    }
    ensureDrawScratch(cache: cache)
    packInstanceRecord(
      records: cache.drawScratch
      slot: 0
      model: model
      prevModel: prevModel
      r: r
      g: g
      b: b
      metallic: metallic
      roughness: roughness
      emissive: emissive
      toon: toon
      paletteBase: 0
    )
    gbIssueInstanced(
      cache: cache
      resources: resources
      pipeline: cache.staticPipeline
      bind: cache.staticBind
      vbuf: gbMeshVbuf(cache: cache, resources: resources, mesh: mesh)
      ibuf: gbMeshIbuf(cache: cache, resources: resources, mesh: mesh)
      icount: gbMeshIcount(cache: cache, mesh: mesh)
      base: base
      count: 1
      records: cache.drawScratch.data
    )
  }
}

# One skinned mesh instance (#503, was the C `drawSkinned`). Same DrawU record
# and G-buffer layout as a static draw; only the pipeline differs (the skin
# vertex stage poses the mesh by the joint palette). After issuing, the static
# pipeline/bind are restored so a following static draw is unaffected.
func drawSkinned(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: copy Int
  model: view Mat4
  prevModel: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  metallic: copy Float
  roughness: copy Float
  emissive: copy Float
  toon: copy Int
) pub {
  unsafe {
    ensureSkinBind(cache: cache, resources: resources)
    if gbSkinReady(mesh: mesh) is 0 {
      ret
    }
    let base: Int = gbDrawCount(cache: cache)
    if base >= gbufferMaxDraws {
      ret
    }
    ensureDrawScratch(cache: cache)
    packInstanceRecord(
      records: cache.drawScratch
      slot: 0
      model: model
      prevModel: prevModel
      r: r
      g: g
      b: b
      metallic: metallic
      roughness: roughness
      emissive: emissive
      toon: toon
      paletteBase: 0
    )
    gbIssueInstanced(
      cache: cache
      resources: resources
      pipeline: cache.skinPipeline
      bind: cache.skinBind
      vbuf: gbSkinVbuf(mesh: mesh)
      ibuf: gbSkinIbuf(mesh: mesh)
      icount: gbSkinIcount(mesh: mesh)
      base: base
      count: 1
      records: cache.drawScratch.data
    )
  }
}

# Instanced SKINNED draw (grass epic #485): `count` copies of one skinned mesh
# in a single DrawIndexed. Every copy is posed by the ONE shared joint palette
# (the skin path has no per-instance palette), so all copies share the same pose
# — the per-instance `model` in each DrawU only places/orients the copy. Used for
# crowds playing the same animation. `records` is `count` DrawU entries built by
# packInstanceRecord, exactly like drawRecords. Restores the static pipeline after,
# as drawSkinned does.
func drawSkinnedRecords(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: copy Int
  records: copy Ptr
  count: copy Int
) pub {
  unsafe {
    ensureSkinBind(cache: cache, resources: resources)
    if gbSkinReady(mesh: mesh) is 0 {
      ret
    }
    let base: Int = gbDrawCount(cache: cache)
    let remaining: Int = gbufferMaxDraws - base
    var n: Int = count
    if n > remaining {
      n = remaining
    }
    if n <= 0 {
      ret
    }
    gbIssueInstanced(
      cache: cache
      resources: resources
      pipeline: cache.skinPipeline
      bind: cache.skinBind
      vbuf: gbSkinVbuf(mesh: mesh)
      ibuf: gbSkinIbuf(mesh: mesh)
      icount: gbSkinIcount(mesh: mesh)
      base: base
      count: n
      records: records
    )
  }
}

func drawInstance(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: view MeshHandle
  transform: view Transform3d
  prevTransform: view Transform3d
  material: view Material3d
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  # Emissive is ONE scalar, not a colour: an emitter's base colour is the
  # colour it emits, so the G-buffer stores intensity and lighting tints it
  # by albedo. The brightest component is the intensity — using luminance
  # would dim a saturated single-channel emitter to near nothing.
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  draw(
    cache: cache
    resources: resources
    mesh: mesh.id
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: emissive
    toon: toonFlag(material: material)
  )
}

# Queue a SKINNED mesh (#391). Same materials and the same G-buffer
# layout as a static draw; the difference is only that the vertex stage
# poses the mesh by the joint palette first. The palette is uploaded once
# per frame by Gpu3d.uploadPalette and shared by every pipeline that
# reads it.
func drawSkinnedInstance(
  cache: mod GbufferCache
  resources: mod GpuResources
  mesh: view MeshHandle
  model: view Mat4
  prevModel: view Mat4
  material: view Material3d
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  drawSkinned(
    cache: cache
    resources: resources
    mesh: mesh.id
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emissive: emissive
    toon: toonFlag(material: material)
  )
}

# Finish and submit the geometry pass (#503; a manager submission since #906):
# end the pass, record the pass's own pipelines + bind groups as uses (so the
# TRACKED submission pins them — retiring one afterwards is deferred until the
# GPU is done), submit, poll earlier frames. The single-command-buffer
# gbSubmit stays for the raw-encoder passes (shadow, transparent, fullscreen).
func gbSubmit(cmd: Ptr) unsafe extern("rae_gb_submit")

func end(cache: mod GbufferCache, resources: mod GpuResources) pub {
  if not gbufferFrameActive(cache: cache) {
    ret
  }
  unsafe {
    endRenderPass(pass: cache.pass)
    cache.pass = webgpuNull()
  }
  gbSetFrameOpen(open: 0)
  if let recording: mod Recording => cache.recording {
    recordRenderPipelineUse(recording: recording, resources: resources, id: cache.staticPipeline)
    recordRenderPipelineUse(recording: recording, resources: resources, id: cache.skinPipeline)
    recordRenderPipelineUse(recording: recording, resources: resources, id: cache.terrainPipeline)
    recordBindGroupUse(recording: recording, resources: resources, id: cache.staticBind)
    recordBindGroupUse(recording: recording, resources: resources, id: cache.skinBind)
    recordBindGroupUse(recording: recording, resources: resources, id: cache.terrainBind)
    let tracked: opt SubmissionId = trackSubmission(
      inFlight: cache.inFlight
      resources: resources
      recording: recording
    )
  }
  cache.recording = none
  pollSubmissions(inFlight: cache.inFlight, resources: resources)
}

func endPass(cache: mod GbufferCache, resources: mod GpuResources) pub {
  end(cache: cache, resources: resources)
}

# How many instances the last pass actually submitted. Lets a caller (or a
# test) distinguish "drew nothing" from "drew and the image is wrong".
func passDrawCount(cache: view GbufferCache) pub ret Int {
  ret cache.drawCount
}

func presentFrame(canvas: mod Gpu2dCanvas) pub {
  present(canvas: canvas)
}

# ----- the passes that consume the G-buffer ---------------------------

# Reduce depth into a MIN mip chain. Min, not average: the question a
# pyramid answers is "is anything in this region closer than my bounding
# box", and that is the nearest depth. An averaged chain would cull
# visible geometry. Hi-Z culling and a deferred SSAO are the intended
# readers.
# buildDepthPyramid moved to gbufferPasses.rae (#504).

# One fullscreen evaluation of the BRDF over the whole G-buffer. This is
# the payoff of the split: the cost is per pixel, not per object-pixel, so
# it no longer matters how many objects contributed to a pixel — only that
# one of them won the depth test.
# Screen-space AO for the deferred frame (#387). Runs between the depth
# pyramid and lighting; lighting samples the result and applies it to the
# INDIRECT term only.
# ssaoPass moved to gbufferPasses.rae (#504).

# Temporal resolve (#390). Reads the radiance lighting wrote plus last
# frame's history, reprojected through the G-buffer's motion channel;
# composite then reads the resolved image. Runs on HDR, before tonemap,
# so accumulation stays linear.
# taaPass moved to gbufferPasses.rae (#504).

# Light the frame from a bound SKY rather than from the light's authored
# ambient (#399).
#
# The sky is the single source of the environment: the values below are
# the ones it reports, so the ambient the scene receives and the sky it
# stands under cannot drift apart. Under SkyKind.none those values ARE
# the light's own anchors, so this is bit-identical to lightingPass and
# is the whole reason M0 can claim to change nothing.
#
# The sun still comes from Light3d. Extraction (#403) is what moves it,
# and moving it before there is anything to extract from would just mean
# copying the same numbers through a second place.

# Exposure + ACES + gamma, radiance -> the presentable target. The tone
# curve is deliberately identical to the forward frame's: the two should
# differ in how radiance is computed, not in how it is displayed, or
# comparing them proves nothing.
# compositePass moved to gbufferPasses.rae (#504).

# Mip levels in the pyramid; 0 before the first build. Lets a caller
# confirm the chain was built rather than silently skipped.
func depthPyramidMips() pub ret Int {
  ret pyramidMips()
}

func shutdownAll() pub {
  deferredShutdown()
  shutdown()
}

# Retire the geometry pass's manager objects (renderer shutdown, BEFORE the C
# shutdown releases the adopted palette buffer): drain the in-flight frames,
# then the binds, pipelines, frame buffers and targets (C forgets its borrowed
# views). The terrain objects are GbufferTerrain's; the renderer shutdown
# retires them there.
func gbufferShutdown(cache: mod GbufferCache, resources: mod GpuResources) pub {
  if gbufferFrameActive(cache: cache) {
    end(cache: cache, resources: resources)
  }
  drainSubmissions(inFlight: cache.inFlight, resources: resources)
  retireBindGroup(resources: resources, id: cache.staticBind)
  retireBindGroup(resources: resources, id: cache.skinBind)
  releaseExternalIds(resources: resources, list: cache.adopted)
  retireRenderPipeline(resources: resources, id: cache.staticPipeline)
  retireRenderPipeline(resources: resources, id: cache.skinPipeline)
  retireBuffer(resources: resources, id: cache.frameUniform)
  retireBuffer(resources: resources, id: cache.draws)
  retireTargets(cache: cache, resources: resources)
  cache.staticBind = noBindGroupId()
  cache.skinBind = noBindGroupId()
  cache.staticPipeline = noRenderPipelineId()
  cache.skinPipeline = noRenderPipelineId()
  cache.frameUniform = noBufferId()
  cache.draws = noBufferId()
  cache.pipelinesMade = false
}
