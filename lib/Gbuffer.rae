# One G-buffer attachment: a 2D texture (render target + sampleable) and its
# full view. mipLevelCount/sampleCount are 1, so an explicit single-mip 2D view
# is the default view — equivalent to the null-descriptor the C path used.
func makeTarget(idx: copy Int, w: copy Int, h: copy Int, format: copy Int32) {
  unsafe {
    let td: WGPUTextureDescriptor = {
      usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding,
      dimension: WGPUTextureDimension_2D,
      size: { width: w as UInt32, height: h as UInt32, depthOrArrayLayers: 1 as UInt32 },
      format: format, mipLevelCount: 1 as UInt32, sampleCount: 1 as UInt32
    }
    let tex: Ptr = wgpuDeviceCreateTexture(device: webgpuDevice(), descriptor: td)
    let vd: WGPUTextureViewDescriptor = {
      format: format, dimension: WGPUTextureViewDimension_2D,
      baseMipLevel: 0 as UInt32, mipLevelCount: 1 as UInt32,
      baseArrayLayer: 0 as UInt32, arrayLayerCount: 1 as UInt32,
      aspect: WGPUTextureAspect_All
    }
    let texView: Ptr = wgpuTextureCreateView(texture: tex, descriptor: vd)
    gbSetTarget(idx: idx, tex: tex, texView: texView)
  }
}

# (Re)create the three colour targets + depth when the offscreen size changes.
func ensureTargets() {
  let w: Int = gbOffscreenW()
  let h: Int = gbOffscreenH()
  if w <= 0 { ret }
  if h <= 0 { ret }
  if gbTargetsMatch(w: w, h: h) is 1 { ret }
  gbReleaseTargets()
  makeTarget(idx: 0, w: w, h: h, format: WGPUTextureFormat_RGB10A2Unorm)
  makeTarget(idx: 1, w: w, h: h, format: WGPUTextureFormat_RGBA8Unorm)
  makeTarget(idx: 2, w: w, h: h, format: WGPUTextureFormat_RGBA8Unorm)
  makeTarget(idx: 3, w: w, h: h, format: WGPUTextureFormat_Depth32Float)
  gbCommitTargets(w: w, h: h)
}
