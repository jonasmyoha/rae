# into the C global via the setter so draws and begin() see it.
func gbFrameUbuf() unsafe extern("rae_gb_frame_ubuf") ret Ptr
func nativeGbFrameBytes() unsafe extern("rae_gb_frame_bytes") ret Int
func gbFrameBytes() ret Int {
  unsafe { ret nativeGbFrameBytes() }
}
func nativeGbDrawsSize() unsafe extern("rae_gb_draws_size") ret Int
func gbDrawsSize() ret Int {
  unsafe { ret nativeGbDrawsSize() }
}


# Create the frame uniform + draws storage buffers once, over the bindings, and
# store them back into C so the frame-uniform upload, draws and bind groups use
# them. Distinct flag bits, so `+` is the flag union.
# #764: the G-buffer geometry pass caches — the "have I made the pipelines /
# buffers / static+skin binds" flags, plus the reused attachment arrays and the
# per-draw instance-record scratch (all zero-alloc, #573) — were module-level
# globals. They are per-frame state a deferred renderer owns, so they live in a
# GbufferCache on RenderPasses, threaded from DeferredRenderer through beginPass /
# renderSceneWorld and the draw entry points.
# #912: the geometry pass's objects are typed IDs in the DeferredRenderer-owned
# manager — the static / skin / terrain pipelines and their bind groups —
# with the frame uniform, draws buffer and skin palette (still C-stored, created
# here or by the skin uploader) adopted as externals in `adopted`.
type GbufferCache {
  buffersMade: Bool
  colorAtts: List(WGPURenderPassColorAttachment)
  depthAtt: List(WGPURenderPassDepthStencilAttachment)
  pipelinesMade: Bool
  staticPipeline: RenderPipelineId
  skinPipeline: RenderPipelineId
  staticBind: BindGroupId
  skinBind: BindGroupId
  adopted: List(ExternalId)
  drawScratch: List(Float)
  # terrain-splat pass pipeline/bind cache (#764: was gbuffer_terrain gTerrain* globals)
  terrainPipeMade: Bool
  terrainBindGen: Int
  terrainPipeline: RenderPipelineId
  terrainBind: BindGroupId
  terrainSampler: SamplerId
  terrainAdopted: List(ExternalId)
  terrainBlend: Float
}

func createGbufferCache() pub ret GbufferCache {
  unsafe {
    ret GbufferCache {
      buffersMade: false,
      colorAtts: List.create(WGPURenderPassColorAttachment, cap: 3),
      depthAtt: List.create(WGPURenderPassDepthStencilAttachment, cap: 1),
      pipelinesMade: false,
      staticPipeline: noRenderPipelineId(), skinPipeline: noRenderPipelineId(),
      staticBind: noBindGroupId(), skinBind: noBindGroupId(),
      adopted: List.create(ExternalId, cap: 6),
      drawScratch: List.create(Float, cap: instanceRecordFloats),
      terrainPipeMade: false, terrainBindGen: 0 - 1,
      terrainPipeline: noRenderPipelineId(), terrainBind: noBindGroupId(),
      terrainSampler: noSamplerId(), terrainAdopted: List.create(ExternalId, cap: 4),
      terrainBlend: 0.0
    }
  }
}

func ensureGbBuffers(cache: mod GbufferCache) {
  unsafe {
    if cache.buffersMade { ret }
    cache.buffersMade = true
    let uDesc: WGPUBufferDescriptor = {
      usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst,
      size: gbFrameBytes() as UInt64
    }
    gbSetFrameUbuf(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: uDesc))
    let sDesc: WGPUBufferDescriptor = {
      usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst,
      size: gbDrawsSize() as UInt64
    }
    gbSetDrawsBuffer(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: sDesc))
  }
}


# Create the static geometry bind group once (frame uniform @0, draws storage
# @1 — both created once and surviving resizes, adopted here). Safe to call
# only after gbPrepare returned 1 and the buffers exist.
func ensureStaticBind(cache: mod GbufferCache, resources: mod GpuResources) {
  if bindGroupIsUsable(resources: resources, id: cache.staticBind) { ret }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
  unsafe {
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbFrameUbuf()))
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbDrawsBuffer()))
  }
  var made: Bool = false
  if let bind: BindGroupId = createRenderBindGroup(resources: resources, pipeline: cache.staticPipeline, entries: entries) {
    cache.staticBind = bind
    made = true
  }
  # A failed build drops this attempt's adoptions so a retry does not accumulate slots.
  if not made { releaseExternalIds(resources: resources, list: cache.adopted) }
}


# Placeholder entries carry one explicit (zeroed) field — an empty {} is not a
# valid C initializer. They are rewritten in full by begin() every frame.
func ensureGbAttachments(cache: mod GbufferCache) {
  loop cache.colorAtts.length < 3 { cache.colorAtts.add(value: { depthSlice: 0 as UInt32 }) }
  loop cache.depthAtt.length < 1 { cache.depthAtt.add(value: { depthReadOnly: 0 as UInt32 }) }
}

# ----- render pipelines + WGSL shader modules (#503) -------------------------
# The shaders stay as source: C exposes the WGSL text + entry-point names, Rae
# builds the modules and pipelines over the bindings.
func gbWgsl() unsafe extern("rae_gb_wgsl") ret Buffer(Any)
func gbSkinWgsl() unsafe extern("rae_gb_skin_wgsl") ret Buffer(Any)
func nativeGbReadWgsl(path: String) unsafe extern("rae_ext_rae_sys_read_file") ret String
func gbReadWgsl(path: copy String) ret String {
  unsafe { ret nativeGbReadWgsl(path: path) }
}


# One G-buffer render pipeline spec: the shared 3 colour targets + reverse-Z
# depth (write, Greater), back-face culled, over the caller's vertex layout.
# The static and terrain pipelines use the 32-byte layout; skin adds the joint
# indices/weights (80 bytes).
func gbufferPipelineSpec(stride: copy Int, attributes: own List(VertexAttributeSpec)) pub ret RenderPipelineSpec {
  let colorFormats: List(Int32) = List.create(Int32, cap: 3)
  colorFormats.add(value: WGPUTextureFormat_RGB10A2Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  ret RenderPipelineSpec {
    vertexStride: stride, attributes: own attributes, colorFormats: own colorFormats,
    alphaBlend: false, depthFormat: WGPUTextureFormat_Depth32Float, depthWrite: true,
    depthCompare: WGPUCompareFunction_Greater, cullMode: WGPUCullMode_Back
  }
}

# The static vertex layout: position, normal, uv.
func gbufferStaticAttributes() pub ret List(VertexAttributeSpec) {
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 3)
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0, location: 0 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12, location: 1 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24, location: 2 })
  ret attributes
}

# A G-buffer pipeline from WGSL source (entry points vs / fs) — the manager
# owns it; an invalid ID comes back when creation failed.
func createGbufferPipeline(resources: mod GpuResources, wgsl: view String, stride: copy Int, attributes: own List(VertexAttributeSpec)) pub ret RenderPipelineId {
  if let pipeline: RenderPipelineId = createRenderPipeline(resources: resources, wgsl: wgsl, vertexEntry: "vs", fragmentEntry: "fs", spec: gbufferPipelineSpec(stride: stride, attributes: attributes)) {
    ret pipeline
  }
  ret noRenderPipelineId()
}

func ensurePipelines(cache: mod GbufferCache, resources: mod GpuResources) {
  if cache.pipelinesMade { ret }
  cache.pipelinesMade = true
  var staticSource: String = ""
  var skinSource: String = ""
  unsafe {
    staticSource = String.fromCStr(s: gbWgsl())
    skinSource = String.fromCStr(s: gbSkinWgsl())
  }
  cache.staticPipeline = createGbufferPipeline(resources: resources, wgsl: staticSource, stride: 32, attributes: gbufferStaticAttributes())
  let skinAttributes: List(VertexAttributeSpec) = gbufferStaticAttributes()
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 32, location: 3 })
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 48, location: 4 })
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 64, location: 5 })
  cache.skinPipeline = createGbufferPipeline(resources: resources, wgsl: skinSource, stride: 80, attributes: skinAttributes)
}

func begin(cache: mod GbufferCache, resources: mod GpuResources, viewProj: view Mat4, clearR: copy Float, clearG: copy Float, clearB: copy Float) pub {
  unsafe {
    if gbPrepare() is 0 { ret }
    ensurePipelines(cache: cache, resources: resources)
    ensureTargets()
    if gbTargetsReady() is 0 { ret }
    ensureGbBuffers(cache: cache)
    ensureStaticBind(cache: cache, resources: resources)
    if gbFrameUniform(viewProj: viewProj, clearR: clearR, clearG: clearG, clearB: clearB) is 0 { ret }
    ensureGbAttachments(cache: cache)

    let undefinedSlice: UInt32 = WGPU_DEPTH_SLICE_UNDEFINED as UInt32
    let motionZero: Float64 = gbMotionZero() as Float64

    # A: octahedral normal + shading mode. (0.5, 0.5) decodes to +Z, mode 0 = lit.
    let attA: WGPURenderPassColorAttachment = {
      view_: gbViewA(), depthSlice: undefinedSlice,
      loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
      clearValue: { r: 0.5, g: 0.5, b: 0.0, a: 0.0 }
    }
    # B: albedo, cleared to the sky/background colour.
    let attB: WGPURenderPassColorAttachment = {
      view_: gbViewB(), depthSlice: undefinedSlice,
      loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
      clearValue: { r: clearR as Float64, g: clearG as Float64, b: clearB as Float64, a: 1.0 }
    }
    # C: material/motion. Motion clears to the biased zero (no movement).
    let attC: WGPURenderPassColorAttachment = {
      view_: gbViewC(), depthSlice: undefinedSlice,
      loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
      clearValue: { r: motionZero, g: motionZero, b: 0.0, a: 1.0 }
    }
    cache.colorAtts.set(index: 0, value: attA)
    cache.colorAtts.set(index: 1, value: attB)
    cache.colorAtts.set(index: 2, value: attC)

    # Depth: reverse-Z, so the far plane clears to 0 (#367).
    let depthAtt: WGPURenderPassDepthStencilAttachment = {
      view_: gbViewDepth(),
      depthLoadOp: WGPULoadOp_Clear, depthStoreOp: WGPUStoreOp_Store,
      depthClearValue: 0.0
    }
    cache.depthAtt.set(index: 0, value: depthAtt)

    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 3 as UInt64,
      colorAttachments: cache.colorAtts.data,
      depthStencilAttachment: cache.depthAtt.data
    }
    let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    # Every draw binds its own pipeline + group (gbIssueInstanced), so the pass
    # opens with nothing bound; the C-prepared SDF draw binds its own too.
    gbSetFrame(enc: enc, pass: pass)
  }
}

# Shared tail of every G-buffer draw (#502/#503): upload `count` DrawU records
# (already at `records`) into the draws storage buffer at slot `base`, bind the
# given pipeline / bind group / mesh buffers, and issue one instanced
# DrawIndexed. Every draw — static, skinned, instanced — funnels through here,
# so the whole encoding lives in Rae over the generated bindings, no C shim.
func gbIssueInstanced(resources: mod GpuResources, pass: copy Ptr, pipeline: view RenderPipelineId, bind: view BindGroupId,
                      vbuf: copy Ptr, ibuf: copy Ptr, icount: copy Int,
                      base: copy Int, count: copy Int, records: copy Ptr) {
  unsafe {
    let strideBytes: Int = instanceRecordFloats * 4
    wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: gbDrawsBuffer(),
      bufferOffset: (base * strideBytes) as UInt64, data: records,
      size: (count * strideBytes) as UInt64)
    if recordDrawIndexedInPass(resources: resources, pass: pass, pipeline: pipeline, bindGroup: bind,
         vertexBuffer: vbuf, indexBuffer: ibuf, indexCount: icount, instanceCount: count, firstInstance: base) {
      gbAdvanceDraws(count: count)
    }
  }
}

# Instanced G-buffer draw (grass epic #485, ported to Rae #502): one draw for
# `count` copies of a mesh. `records` is `count` * instanceRecordFloats fully
# built DrawU entries (model, prevModel, colour, packed params), assembled in
# Rae by swayModel + packInstanceRecord below. Rae uploads the records straight
# into the draws storage buffer and issues one instanced DrawIndexed on the
# static pipeline — no C shim. A skinned draw may have left its pipeline bound,
# so gbIssueInstanced re-binds the static one.
func drawRecords(cache: mod GbufferCache, resources: mod GpuResources, mesh: copy Int, records: copy Ptr, count: copy Int) pub {
  unsafe {
    if gbMeshReady(mesh: mesh) is 0 { ret }
    let base: Int = gbDrawCount()
    let remaining: Int = gbMaxDraws() - base
    var n: Int = count
    if n > remaining { n = remaining }
    if n <= 0 { ret }
    gbIssueInstanced(resources: resources, pass: gbPass(), pipeline: cache.staticPipeline, bind: cache.staticBind,
      vbuf: gbMeshVbuf(mesh: mesh), ibuf: gbMeshIbuf(mesh: mesh),
      icount: gbMeshIcount(mesh: mesh), base: base, count: n, records: records)
  }
}

