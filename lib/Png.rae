# PNG container (encode + decode) in pure Rae, on top of the Rae DEFLATE/zlib
# codec (lib/compress). Owns the small/bounded half of the PNG problem — the
# signature, IHDR/IDAT/IEND chunks, CRC-32, and the five row filters — while
# DEFLATE does the real work (docs/png-and-deflate-strategy.md).
#
# Pixels are packed Ints, 0xAARRGGBB: low 24 bits RGB, top byte alpha (the same
# layout the Image API's loadPng returns). Pure computation: Live + Compiled.
open compress/Zlib
open compress/Checksums

# --- byte helpers -----------------------------------------------------------
func pushBE32(out: mod List(Int), value: view Int) {
  out.add(value: (value shr 24) bitand 255)
  out.add(value: (value shr 16) bitand 255)
  out.add(value: (value shr 8) bitand 255)
  out.add(value: value bitand 255)
}

func pngIntAt(data: view List(Int), index: view Int) ret Int {
  if let value: Int = data.copyAt(index: index) {
    ret value
  }
  ret 0
}

func readBE32(data: view List(Int), pos: view Int) ret Int {
  ret (pngIntAt(data: data, index: pos) shl 24) bitor (pngIntAt(data: data, index: pos + 1) shl 16) bitor (pngIntAt(
    data: data
    index: pos + 2
  ) shl 8) bitor pngIntAt(data: data, index: pos + 3)
}

# Write a PNG chunk: length, 4-byte type, data, CRC-32 over (type + data).
func writeChunk(
  out: mod List(Int)
  t0: view Int
  t1: view Int
  t2: view Int
  t3: view Int
  data: view List(Int)
) {
  pushBE32(out: out, value: data.length)
  # CRC is over the type bytes followed by the data.
  var crcIn: List(Int) = List.create(Int, cap: data.length + 4)
  crcIn.add(value: t0)
  crcIn.add(value: t1)
  crcIn.add(value: t2)
  crcIn.add(value: t3)
  var i: Int = 0
  loop let value: Int in data {
    crcIn.add(value: value)
  }
  out.add(value: t0)
  out.add(value: t1)
  out.add(value: t2)
  out.add(value: t3)
  i = 0
  loop let value: Int in data {
    out.add(value: value)
  }
  pushBE32(out: out, value: crc32(data: crcIn, len: crcIn.length))
}

# --- encode -----------------------------------------------------------------

# Signed byte cost (treat 0..255 as -128..127) — the metric for picking a row
# filter (minimum sum of absolute differences, the standard PNG heuristic).
func signedAbs(b: view Int) ret Int {
  if b >= 128 {
    ret 256 - b
  }
  ret b
}

# Encode packed-Int pixels (row-major, top-down) to PNG bytes. `hasAlpha` selects
# RGBA (color type 6, reads the 0xAA byte) vs RGB (color type 2, low 24 bits).
# Each scanline is filtered with whichever of the five PNG filters minimizes the
# sum of absolute signed bytes (adaptive filtering — the usual size heuristic).
func encodePng(
  pixels: view List(Int)
  width: view Int
  height: view Int
  hasAlpha: view Bool
) ret List(Int) {
  var channels: Int = 3
  var colorType: Int = 2
  if hasAlpha {
    channels = 4
    colorType = 6
  }
  let stride: Int = width * channels

  var raw: List(Int) = List.create(Int, cap: height * (1 + stride))
  var prevRow: List(Int) = List.create(Int, cap: stride)  # previous row, raw (unfiltered) bytes
  var havePrev: Bool = false
  var y: Int = 0
  loop y < height {
    # Extract this row's raw bytes.
    var cur: List(Int) = List.create(Int, cap: stride)
    var x: Int = 0
    loop x < width {
      let p: Int = pngIntAt(data: pixels, index: y * width + x)
      cur.add(value: (p shr 16) bitand 255)
      cur.add(value: (p shr 8) bitand 255)
      cur.add(value: p bitand 255)
      if hasAlpha {
        cur.add(value: (p shr 24) bitand 255)
      }
      x = x + 1
    }
    # Try the five filters, keep the one with the smallest signed-abs sum.
    var best: List(Int) = List.create(Int, cap: stride)
    var bestType: Int = 0
    var bestCost: Int = -1
    var ft: Int = 0
    loop ft <= 4 {
      var cand: List(Int) = List.create(Int, cap: stride)
      var cost: Int = 0
      var i: Int = 0
      loop i < stride {
        var a: Int = 0
        if i >= channels {
          a = pngIntAt(data: cur, index: i - channels)
        }
        var b: Int = 0
        if havePrev {
          b = pngIntAt(data: prevRow, index: i)
        }
        var c: Int = 0
        if havePrev and i >= channels {
          c = pngIntAt(data: prevRow, index: i - channels)
        }
        var v: Int = pngIntAt(data: cur, index: i)
        if ft is 1 {
          v = pngIntAt(data: cur, index: i) - a
        }
        if ft is 2 {
          v = pngIntAt(data: cur, index: i) - b
        }
        if ft is 3 {
          v = pngIntAt(data: cur, index: i) - ((a + b) / 2)
        }
        if ft is 4 {
          v = pngIntAt(data: cur, index: i) - paeth(a: a, b: b, c: c)
        }
        v = v bitand 255
        cand.add(value: v)
        cost = cost + signedAbs(b: v)
        i = i + 1
      }
      if bestCost < 0 or cost < bestCost {
        bestCost = cost
        bestType = ft
        best.clear()
        loop let value: Int in cand {
          best.add(value: value)
        }
      }
      ft = ft + 1
    }
    raw.add(value: bestType)
    loop let value: Int in best {
      raw.add(value: value)
    }
    # This row's RAW bytes become prevRow for the next iteration.
    prevRow.clear()
    loop let value: Int in cur {
      prevRow.add(value: value)
    }
    havePrev = true
    y = y + 1
  }

  var out: List(Int) = List.create(Int, cap: raw.length / 2 + 64)
  # Signature.
  out.add(value: 137)
  out.add(value: 80)
  out.add(value: 78)
  out.add(value: 71)
  out.add(value: 13)
  out.add(value: 10)
  out.add(value: 26)
  out.add(value: 10)
  # IHDR.
  var ihdr: List(Int) = List.create(Int, cap: 13)
  pushBE32(out: ihdr, value: width)
  pushBE32(out: ihdr, value: height)
  ihdr.add(value: 8)  # bit depth
  ihdr.add(value: colorType)
  ihdr.add(value: 0)  # compression
  ihdr.add(value: 0)  # filter method
  ihdr.add(value: 0)  # interlace
  writeChunk(
    out: out
    t0: 73
    t1: 72
    t2: 68
    t3: 82
    data: ihdr
  )
  # "IHDR"
  # IDAT (zlib-compressed filtered scanlines).
  let idat: List(Int) = compress(data: raw, value: raw.length)
  writeChunk(
    out: out
    t0: 73
    t1: 68
    t2: 65
    t3: 84
    data: idat
  )
  # "IDAT"
  # IEND (empty).
  let iend: List(Int) = List.create(Int, cap: 1)
  writeChunk(
    out: out
    t0: 73
    t1: 69
    t2: 78
    t3: 68
    data: iend
  )
  # "IEND"
  ret out
}

# --- decode -----------------------------------------------------------------
func absI(x: view Int) ret Int {
  if x < 0 {
    ret 0 - x
  }
  ret x
}

# Paeth predictor (RFC 2083 / PNG spec).
func paeth(a: view Int, b: view Int, c: view Int) ret Int {
  let p: Int = a + b - c
  let pa: Int = absI(x: p - a)
  let pb: Int = absI(x: p - b)
  let pc: Int = absI(x: p - c)
  if pa <= pb and pa <= pc {
    ret a
  }
  if pb <= pc {
    ret b
  }
  ret c
}

# Decode a PNG byte stream to packed-Int pixels (0xAARRGGBB). Writes dimensions
# through the mods; on failure width is set to 0. Every color type (gray, RGB, palette,
# gray + alpha, RGBA) at every bit depth (1, 2, 4, 8, 16: a 16-bit sample keeps its high byte),
# with a tRNS chunk's transparency, all five row filters; no interlacing.
func decodePng(
  png: view List(Int)
  len: view Int
  width: mod Int
  height: mod Int
) ret List(Int) {
  width = 0
  height = 0
  let empty: List(Int) = List.create(Int, cap: 1)
  if len < 8 {
    ret empty
  }

  var w: Int = 0
  var h: Int = 0
  var colorType: Int = 6
  var depth: Int = 8
  var interlaced: Bool = false
  var idat: List(Int) = List.create(Int, cap: len)
  # the palette (0xRRGGBB a color) and its alphas (tRNS), and a gray or RGB key color (tRNS)
  var palette: List(Int) = {}
  var paletteAlpha: List(Int) = {}
  var keyColor: Int = -1

  var pos: Int = 8  # skip the 8-byte signature
  loop pos + 8 <= len {
    let clen: Int = readBE32(data: png, pos: pos)
    let t0: Int = pngIntAt(data: png, index: pos + 4)
    let t1: Int = pngIntAt(data: png, index: pos + 5)
    let t2: Int = pngIntAt(data: png, index: pos + 6)
    let t3: Int = pngIntAt(data: png, index: pos + 7)
    let dstart: Int = pos + 8
    if t0 is 73 and t1 is 72 and t2 is 68 and t3 is 82 {
      # IHDR
      w = readBE32(data: png, pos: dstart)
      h = readBE32(data: png, pos: dstart + 4)
      depth = pngIntAt(data: png, index: dstart + 8)
      colorType = pngIntAt(data: png, index: dstart + 9)
      interlaced = pngIntAt(data: png, index: dstart + 12) is not 0
    } else if t0 is 73 and t1 is 68 and t2 is 65 and t3 is 84 {
      # IDAT
      loop var k: Int = 0, k < clen, ++k {
        idat.add(value: pngIntAt(data: png, index: dstart + k))
      }
    } else if t0 is 80 and t1 is 76 and t2 is 84 and t3 is 69 {
      # PLTE
      loop var k: Int = 0, k + 2 < clen, k += 3 {
        palette.add(
          value: (pngIntAt(data: png, index: dstart + k) shl 16) bitor (pngIntAt(
            data: png
            index: dstart + k + 1
          ) shl 8) bitor pngIntAt(data: png, index: dstart + k + 2)
        )
      }
    } else if t0 is 116 and t1 is 82 and t2 is 78 and t3 is 83 {
      # tRNS: an alpha a palette entry, or the one gray / RGB color that is transparent
      if colorType is 3 {
        loop var k: Int = 0, k < clen, ++k {
          paletteAlpha.add(value: pngIntAt(data: png, index: dstart + k))
        }
      } else if colorType is 0 and clen >= 2 {
        keyColor = readBE16(data: png, pos: dstart)
      } else if colorType is 2 and clen >= 6 {
        keyColor = (readBE16(data: png, pos: dstart) shl 32) bitor (readBE16(
          data: png
          pos: dstart + 2
        ) shl 16) bitor readBE16(data: png, pos: dstart + 4)
      }
    } else if t0 is 73 and t1 is 69 and t2 is 78 and t3 is 68 {
      pos = len  # IEND -> stop
    }
    if pos < len {
      pos = dstart + clen + 4  # skip data + CRC
    }
  }
  if w <= 0 or h <= 0 or interlaced {
    ret empty
  }

  var channels: Int = 1
  if colorType is 2 {
    channels = 3
  } else if colorType is 4 {
    channels = 2
  } else if colorType is 6 {
    channels = 4
  }
  let bitsPerPixel: Int = channels * depth
  # bytes a row, and the distance a filter looks back (at least one byte)
  let stride: Int = (w * bitsPerPixel + 7) / 8
  var filterStep: Int = bitsPerPixel / 8
  if filterStep < 1 {
    filterStep = 1
  }
  # Inflate the IDAT zlib stream into filtered scanlines.
  let raw: List(Int) = decompress(data: idat, value: idat.length)

  # Unfilter into a flat byte buffer `recon` (stride bytes per row, no filter byte).
  var recon: List(Int) = List.create(Int, cap: h * stride)
  var rp: Int = 0  # read cursor in `raw`
  var y: Int = 0
  loop y < h {
    let ftype: Int = pngIntAt(data: raw, index: rp)
    rp = rp + 1
    var i: Int = 0
    loop i < stride {
      let cur: Int = pngIntAt(data: raw, index: rp + i)
      var a: Int = 0
      if i >= filterStep {
        a = pngIntAt(data: recon, index: y * stride + i - filterStep)
      }
      var b: Int = 0
      if y > 0 {
        b = pngIntAt(data: recon, index: (y - 1) * stride + i)
      }
      var c: Int = 0
      if y > 0 and i >= filterStep {
        c = pngIntAt(data: recon, index: (y - 1) * stride + i - filterStep)
      }
      var val: Int = cur
      if ftype is 1 {
        val = cur + a
      }
      if ftype is 2 {
        val = cur + b
      }
      if ftype is 3 {
        val = cur + ((a + b) / 2)
      }
      if ftype is 4 {
        val = cur + paeth(a: a, b: b, c: c)
      }
      recon.add(value: val bitand 255)
      i = i + 1
    }
    rp = rp + stride
    y = y + 1
  }

  # Pack to 0xAARRGGBB.
  var pixels: List(Int) = List.create(Int, cap: w * h)
  loop var py: Int = 0, py < h, ++py {
    let row: Int = py * stride
    loop var px: Int = 0, px < w, ++px {
      var r: Int = 0
      var g: Int = 0
      var bl: Int = 0
      var al: Int = 255
      if colorType is 3 {
        let index: Int = pngSample(
          data: recon
          row: row
          sample: px
          depth: depth
        )
        let color: Int = palette.copyAtFallback(index: index, fallback: 0)
        r = (color shr 16) bitand 255
        g = (color shr 8) bitand 255
        bl = color bitand 255
        al = paletteAlpha.copyAtFallback(index: index, fallback: 255)
      } else if colorType is 0 or colorType is 4 {
        let gray: Int = pngSample(
          data: recon
          row: row
          sample: px * channels
          depth: depth
        )
        let level: Int = pngLevel(value: gray, depth: depth)
        r = level
        g = level
        bl = level
        if colorType is 4 {
          al = pngLevel(
            value: pngSample(
              data: recon
              row: row
              sample: px * channels + 1
              depth: depth
            )
            depth: depth
          )
        } else if gray is keyColor {
          al = 0
        }
      } else {
        r = pngLevel(
          value: pngSample(
            data: recon
            row: row
            sample: px * channels
            depth: depth
          )
          depth: depth
        )
        g = pngLevel(
          value: pngSample(
            data: recon
            row: row
            sample: px * channels + 1
            depth: depth
          )
          depth: depth
        )
        bl = pngLevel(
          value: pngSample(
            data: recon
            row: row
            sample: px * channels + 2
            depth: depth
          )
          depth: depth
        )
        if colorType is 6 {
          al = pngLevel(
            value: pngSample(
              data: recon
              row: row
              sample: px * channels + 3
              depth: depth
            )
            depth: depth
          )
        } else if keyColor >= 0 {
          let raw16: Int = (pngSample(
            data: recon
            row: row
            sample: px * channels
            depth: depth
          ) shl 32) bitor (pngSample(
            data: recon
            row: row
            sample: px * channels + 1
            depth: depth
          ) shl 16) bitor pngSample(
            data: recon
            row: row
            sample: px * channels + 2
            depth: depth
          )
          if raw16 is keyColor {
            al = 0
          }
        }
      }
      pixels.add(value: (al shl 24) bitor (r shl 16) bitor (g shl 8) bitor bl)
    }
  }
  width = w
  height = h
  ret pixels
}

# Sample number `sample` of a row (its samples packed at `depth` bits, from the high bit; a
# 16-bit sample is two bytes)
func pngSample(
  data: view List(Int)
  row: view Int
  sample: view Int
  depth: view Int
) ret Int {
  if depth is 8 {
    ret pngIntAt(data: data, index: row + sample)
  }
  if depth is 16 {
    ret (pngIntAt(data: data, index: row + sample * 2) shl 8) bitor pngIntAt(
      data: data
      index: row + sample * 2 + 1
    )
  }
  let bit: Int = sample * depth
  let byte: Int = pngIntAt(data: data, index: row + bit / 8)
  let shift: Int = 8 - depth - bit % 8
  ret (byte shr shift) bitand ((1 shl depth) - 1)
}

# A sample as an 8-bit level: a 16-bit one's high byte, a 1-, 2- or 4-bit one stretched to 0..255
func pngLevel(value: view Int, depth: view Int) ret Int {
  if depth is 16 {
    ret value shr 8
  }
  if depth is 8 {
    ret value
  }
  ret value * 255 / ((1 shl depth) - 1)
}

func readBE16(data: view List(Int), pos: view Int) ret Int {
  ret (pngIntAt(data: data, index: pos) shl 8) bitor pngIntAt(data: data, index: pos + 1)
}
