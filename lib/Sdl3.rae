# SDL3 desktop platform layer — the Compiled-target windowing/present backend this
# project actually ships on (with WebGPU for 3D). One window per process (the window/
# renderer/texture handles live in the runtime), so the API is handle-free: init, upload
# a packed-0xRRGGBB framebuffer, present, poll for quit.
#
# (`lib/raylib.rae` is a SEPARATE, LEGACY backend, off by default — compiled only when
# RAE_HAS_RAYLIB is defined, which no real build does; SDL3 is the one in use.)
#
# Implemented in the RAE_HAS_SDL3 block of compiler/runtime/rae_runtime.c; the build links
# libSDL3 when an example imports this module. Compiled-target only — the Live VM has no
# SDL bindings.

# Create the window + renderer at this pixel size. The framebuffer texture is
# created lazily by sdlUpdatePixels (which may differ from the window size and
# is stretched to fill it).
func initWindow(width: Int, height: Int, title: String) unsafe extern

# Cap the present rate (frames/sec). 0 disables the cap. sdlPresent sleeps the
# remainder of each frame so an idle/finished render doesn't spin at 100% CPU.
func setTargetFPS(fps: Int) unsafe extern

# Pump the event queue; returns true once the user asks to close the window
# (window close button, Escape, or Cmd-Q).
func shouldClose() unsafe extern ret Bool

# Upload a w x h packed-0xRRGGBB framebuffer (e.g. a List(Int)'s .data) into the
# streaming texture, (re)creating it if the size changed since last call — so an
# example can switch framebuffer resolution at runtime. The texture stretches to
# fill the window on present.
func updatePixels(pixels: view Buffer(Int), w: Int, h: Int) unsafe extern

# Draw the texture to the window and present this frame.
func present() unsafe extern

# Update the window title bar (status text — there is no drawText here).
func setTitle(title: String) unsafe extern

# Tear down the texture, renderer, window, and SDL.
func closeWindow() unsafe extern

# --- Input ---------------------------------------------------------------
# isKeyDown / isKeyPressed take a RAW SDL_Scancode (named list in lib/keys.rae: keyW = 26,
# keyLShift = 225, keyRight = 79, …). No translation — the value goes straight to SDL,
# indexing SDL's keyboard-state array by scancode. SDL3 (+ WebGPU) is the backend.

# Current window (renderer output) size in pixels. The window is resizable;
# poll these to detect a resize and re-render at the new size.
func windowWidth() unsafe extern ret Int
func windowHeight() unsafe extern ret Int

# Mouse position in window pixels (top-left origin).
func getMouseX() unsafe extern ret Int
func getMouseY() unsafe extern ret Int

# Mouse button held this frame: 0 = left, 1 = right, 2 = middle.
func isMouseButtonDown(button: Int) unsafe extern ret Bool

# Keyboard: down = held this frame (level); pressed = went down on this frame
# (edge, false on auto-repeat). Poll once per frame after sdl3.shouldClose().
func isKeyDown(key: Int) unsafe extern ret Bool
func isKeyPressed(key: Int) unsafe extern ret Bool
