# crypto/P256 — ECDSA on NIST P-256 (secp256r1), in Rae (crypto/Ecdsa's arithmetic): verify (a JWS
# ES256 signature, an App Store transaction, a passkey) and sign with RFC 6979's deterministic nonce
# (so tests can make their own keys and signatures, and a server can sign). ES256 is SHA-256 and the
# 64-byte r || s form; DER signatures (X.509's) convert to and from it (ecdsaSignatureToDer,
# p256SignatureFromDer).
open crypto/Ecdsa
open crypto/Sha256

func p256Curve() ret EcCurve {
  ret ecCurve(
    p: "ffffffff00000001000000000000000000000000ffffffffffffffffffffffff"
    n: "ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551"
    b: "5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b"
    gx: "6b17d1f2e12c4247f8bce6e563a440f277037d812deb33a0f4a13945d898c296"
    gy: "4fe342e2fe1a7f9b8ee7eb4a7c0f9e162bce33576b315ececbb6406837bf51f5"
    size: 32
  )
}

# Whether `signature` (64 bytes r || s) signs `hash` for `publicKey` (65 bytes 04 x y, or 64)
func p256Verify(
  publicKey: view List(UInt8)
  hash: view List(UInt8)
  signature: view List(UInt8)
) ret Bool {
  ret ecdsaVerify(
    curve: p256Curve()
    publicKey: publicKey
    hash: hash
    signature: signature
  )
}

# The public key (65 bytes, 0x04 || x || y) of a private key (32 bytes, 1 .. n-1); none otherwise
func p256PublicKey(privateKey: view List(UInt8)) ret opt List(UInt8) {
  ret ecdsaPublicKey(curve: p256Curve(), privateKey: privateKey)
}

type P256KeyPair {
  privateKey: List(UInt8)
  publicKey: List(UInt8)
}

# A new key pair from the system's secure random source
func p256NewKeyPair() ret P256KeyPair {
  let curve: EcCurve = p256Curve()
  let privateKey: List(UInt8) = ecdsaNewPrivateKey(curve: curve)
  if let publicKey: List(UInt8) = ecdsaPublicKey(curve: curve, privateKey: privateKey) {
    ret P256KeyPair { privateKey: privateKey, publicKey: publicKey }
  }
  ret P256KeyPair { privateKey: {}, publicKey: {} }
}

# The signature (64 bytes r || s) of `hash` with `privateKey` (32 bytes), its nonce RFC 6979's (HMAC
# over the hash's function: SHA-256 for a 32-byte hash); empty for a private key out of range
func p256Sign(privateKey: view List(UInt8), hash: view List(UInt8)) ret List(UInt8) {
  ret ecdsaSign(curve: p256Curve(), privateKey: privateKey, hash: hash)
}

# ES256 (JWS): SHA-256 of the message, signed or verified, the signature 64 bytes r || s
func es256Sign(privateKey: view List(UInt8), message: view List(UInt8)) ret List(UInt8) {
  ret p256Sign(privateKey: privateKey, hash: sha256(bytes: message))
}

func es256Verify(
  publicKey: view List(UInt8)
  message: view List(UInt8)
  signature: view List(UInt8)
) ret Bool {
  ret p256Verify(publicKey: publicKey, hash: sha256(bytes: message), signature: signature)
}

# A DER signature as 64 bytes r || s; none when it is not strict DER or a number is too long
func p256SignatureFromDer(der: view List(UInt8)) ret opt List(UInt8) {
  ret ecdsaSignatureFromDer(der: der, size: 32)
}

# p256Verify with a DER signature
func p256VerifyDer(
  publicKey: view List(UInt8)
  hash: view List(UInt8)
  signature: view List(UInt8)
) ret Bool {
  ret ecdsaVerifyDer(
    curve: p256Curve()
    publicKey: publicKey
    hash: hash
    signature: signature
  )
}
