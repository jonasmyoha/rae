# The starting hash: the fractional parts of the square roots of the first 8 primes (SHA-512), of
# the 9th to 16th (SHA-384)
func sha512Start() ret List(UInt64) {
  ret List(UInt64) {
    7640891576956012808
    13503953896175478587
    4354685564936845355
    11912009170470909681
    5840696475078001361
    11170449401992604703
    2270897969802886507
    6620516959819538809
  }
}

func sha384Start() ret List(UInt64) {
  ret List(UInt64) {
    14680500436340154072
    7105036623409894663
    10473403895298186519
    1526699215303891257
    7436329637833083697
    10282925794625328401
    15784041429090275239
    5167115440072839076
  }
}

func sha512Rotate(value: view UInt64, count: view Int) ret UInt64 {
  ret (value shr count) bitor (value shl (64 - count))
}

# One 128-byte block at `offset` into `hash`
func sha512Block(
  hash: mod List(UInt64)
  schedule: mod List(UInt64)
  constants: view List(UInt64)
  bytes: view List(UInt8)
  offset: view Int
) {
  loop var i: Int = 0, i < 16, ++i {
    var word: UInt64 = 0
    loop var j: Int = 0, j < 8, ++j {
      word = (word shl 8) bitor (bytes.copyAtDefault(index: offset + i * 8 + j) as UInt64)
    }
    schedule.set(index: i, value: word)
  }
  loop var i: Int = 16, i < 80, ++i {
    let w15: UInt64 = schedule.copyAtDefault(index: i - 15)
    let w2: UInt64 = schedule.copyAtDefault(index: i - 2)
    let s0: UInt64 = sha512Rotate(value: w15, count: 1) bitxor sha512Rotate(value: w15, count: 8) bitxor (w15 shr 7)
    let s1: UInt64 = sha512Rotate(value: w2, count: 19) bitxor sha512Rotate(value: w2, count: 61) bitxor (w2 shr 6)
    schedule.set(
      index: i
      value: schedule.copyAtDefault(index: i - 16) + s0 + schedule.copyAtDefault(index: i - 7) + s1
    )
  }
  var a: UInt64 = hash.copyAtDefault(index: 0)
  var b: UInt64 = hash.copyAtDefault(index: 1)
  var c: UInt64 = hash.copyAtDefault(index: 2)
  var d: UInt64 = hash.copyAtDefault(index: 3)
  var e: UInt64 = hash.copyAtDefault(index: 4)
  var f: UInt64 = hash.copyAtDefault(index: 5)
  var g: UInt64 = hash.copyAtDefault(index: 6)
  var h: UInt64 = hash.copyAtDefault(index: 7)
  loop var i: Int = 0, i < 80, ++i {
    let sum1: UInt64 = sha512Rotate(value: e, count: 14) bitxor sha512Rotate(value: e, count: 18) bitxor sha512Rotate(
      value: e
      count: 41
    )
    let choose: UInt64 = (e bitand f) bitxor ((bitnot e) bitand g)
    let temporary1: UInt64 = h + sum1 + choose + constants.copyAtDefault(index: i) + schedule.copyAtDefault(
      index: i
    )
    let sum0: UInt64 = sha512Rotate(value: a, count: 28) bitxor sha512Rotate(value: a, count: 34) bitxor sha512Rotate(
      value: a
      count: 39
    )
    let majority: UInt64 = (a bitand b) bitxor (a bitand c) bitxor (b bitand c)
    let temporary2: UInt64 = sum0 + majority
    h = g
    g = f
    f = e
    e = d + temporary1
    d = c
    c = b
    b = a
    a = temporary1 + temporary2
  }
  let finals: List(UInt64) = {
    a
    b
    c
    d
    e
    f
    g
    h
  }
  loop var i: Int = 0, i < 8, ++i {
    hash.set(index: i, value: hash.copyAtDefault(index: i) + finals.copyAtDefault(index: i))
  }
}

# The SHA-512 family's digest of `bytes` from `start`, cut to `size` bytes
func sha512Family(
  bytes: view List(UInt8)
  start: view List(UInt64)
  size: view Int
) ret List(UInt8) {
  var hash: List(UInt64) = start
  var schedule: List(UInt64) = List.create(UInt64, cap: 80)
  loop var i: Int = 0, i < 80, ++i {
    schedule.add(value: 0)
  }
  let constants: List(UInt64) = sha512Constants()
  # the message, a 1 bit, zeros, and its length in bits as 128 bits: a whole number of blocks
  var padded: List(UInt8) = List.create(UInt8, cap: bytes.length + 144)
  loop let byte: UInt8 in bytes {
    padded.add(value: byte)
  }
  padded.add(value: 128)
  loop padded.length % 128 is not 112 {
    padded.add(value: 0)
  }
  loop var i: Int = 0, i < 8, ++i {
    padded.add(value: 0)
  }
  let bits: Int = bytes.length * 8
  loop var i: Int = 7, i >= 0, --i {
    padded.add(value: ((bits shr (i * 8)) bitand 255) as UInt8)
  }
  loop var block: Int = 0, block < padded.length / 128, ++block {
    sha512Block(
      hash: hash
      schedule: schedule
      constants: constants
      bytes: padded
      offset: block * 128
    )
  }
  var digest: List(UInt8) = List.create(UInt8, cap: size)
  loop var i: Int = 0, i < size, ++i {
    let word: UInt64 = hash.copyAtDefault(index: i / 8)
    digest.add(value: ((word shr ((7 - i % 8) * 8)) bitand 255) as UInt8)
  }
  ret digest
}

func sha512(bytes: view List(UInt8)) ret List(UInt8) {
  ret sha512Family(bytes: bytes, start: sha512Start(), size: 64)
}

func sha384(bytes: view List(UInt8)) ret List(UInt8) {
  ret sha512Family(bytes: bytes, start: sha384Start(), size: 48)
}

# HMAC (RFC 2104) over the SHA-512 family's 128-byte block: `size` 64 is HMAC-SHA-512, 48
# HMAC-SHA-384
func hmacSha512Family(
  key: view List(UInt8)
  message: view List(UInt8)
  size: view Int
) ret List(UInt8) {
  var start: List(UInt64) = sha512Start()
  if size is 48 {
    start = sha384Start()
  }
  var block: List(UInt8) = List.create(UInt8, cap: 128)
  if key.length > 128 {
    loop let byte: UInt8 in sha512Family(bytes: key, start: start, size: size) {
      block.add(value: byte)
    }
  } else {
    loop let byte: UInt8 in key {
      block.add(value: byte)
    }
  }
  loop block.length < 128 {
    block.add(value: 0)
  }
  var inner: List(UInt8) = List.create(UInt8, cap: 128 + message.length)
  loop let byte: UInt8 in block {
    inner.add(value: ((byte as Int) bitxor 54) as UInt8)
  }
  loop let byte: UInt8 in message {
    inner.add(value: byte)
  }
  let innerHash: List(UInt8) = sha512Family(bytes: inner, start: start, size: size)
  var outer: List(UInt8) = List.create(UInt8, cap: 128 + size)
  loop let byte: UInt8 in block {
    outer.add(value: ((byte as Int) bitxor 92) as UInt8)
  }
  loop let byte: UInt8 in innerHash {
    outer.add(value: byte)
  }
  ret sha512Family(bytes: outer, start: start, size: size)
}

func hmacSha512(key: view List(UInt8), message: view List(UInt8)) ret List(UInt8) {
  ret hmacSha512Family(key: key, message: message, size: 64)
}

func hmacSha384(key: view List(UInt8), message: view List(UInt8)) ret List(UInt8) {
  ret hmacSha512Family(key: key, message: message, size: 48)
}
