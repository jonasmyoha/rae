# SHA-1 (RFC 3174), for the WebSocket handshake (docs/server-benchmarks-design.md
# §9 G5). SHA-1 is broken for collision resistance: use it where a protocol
# requires it (Sec-WebSocket-Accept, Git object names), never to protect
# anything.
#
# Where the platform has a hardware SHA-1 (CommonCrypto on Apple, with the
# CPU's SHA instructions), `sha1` uses it: 16 MB in 7 ms on an M1 Max. The
# Rae implementation below (`portableSha1Range`, 100 ms) is the reference
# and the portable fallback for every other platform (AGENTS.md: the faster
# native implementation wins). The choice is a compile-time `when`: on other
# platforms the CommonCrypto binding does not exist at all.
#
# The 32-bit words live in Int and are masked back to 32 bits after every
# operation that can overflow them.
const sha1WordMask: Int = 4294967295

type Sha1State {
  h0: Int
  h1: Int
  h2: Int
  h3: Int
  h4: Int
}

func createSha1State() ret Sha1State {
  ret Sha1State {
    h0: 1732584193
    h1: 4023233417
    h2: 2562383102
    h3: 271733878
    h4: 3285377520
  }
}

func rotateLeft(value: view Int, count: view Int) ret Int {
  ret ((value shl count) bitor (value shr (32 - count))) bitand sha1WordMask
}

# Process the 64-byte block of `bytes` that starts at `offset`. The 80-word
# message schedule is a local fixed-size Array: its index checks are against
# a constant, so the C compiler drops them, where a List in the state made
# every word store reload the list (a store of an Int may change its length).
func sha1Block(state: mod Sha1State, bytes: view List(UInt8), offset: view Int) {
  var words: Array(Int, cap: 80) = Array(Int, cap: 80)
  loop var t: Int = 0, t < 16, ++t {
    let at: Int = offset + t * 4
    let word: Int = (bytes.copyAtFallback(index: at, fallback: 0) as Int shl 24) bitor (bytes.copyAtFallback(
      index: at + 1
      fallback: 0
    ) as Int shl 16) bitor (bytes.copyAtFallback(index: at + 2, fallback: 0) as Int shl 8) bitor bytes.copyAtFallback(
      index: at + 3
      fallback: 0
    ) as Int
    words.set(index: t, value: word)
  }
  loop var t: Int = 16, t < 80, ++t {
    let mixed: Int = words.copyAtFallback(index: t - 3, fallback: 0) bitxor words.copyAtFallback(
      index: t - 8
      fallback: 0
    ) bitxor words.copyAtFallback(index: t - 14, fallback: 0) bitxor words.copyAtFallback(
      index: t - 16
      fallback: 0
    )
    words.set(index: t, value: rotateLeft(value: mixed, count: 1))
  }
  var a: Int = state.h0
  var b: Int = state.h1
  var c: Int = state.h2
  var d: Int = state.h3
  var e: Int = state.h4
  # The four rounds of 20, each its own loop so no step tests which round it
  # is in
  loop var t: Int = 0, t < 20, ++t {
    let mixed: Int = (b bitand c) bitor ((b bitxor sha1WordMask) bitand d)
    let next: Int = (rotateLeft(value: a, count: 5) + mixed + e + 1518500249 + words.copyAtFallback(
      index: t
      fallback: 0
    )) bitand sha1WordMask
    e = d
    d = c
    c = rotateLeft(value: b, count: 30)
    b = a
    a = next
  }
  loop var t: Int = 20, t < 40, ++t {
    let mixed: Int = b bitxor c bitxor d
    let next: Int = (rotateLeft(value: a, count: 5) + mixed + e + 1859775393 + words.copyAtFallback(
      index: t
      fallback: 0
    )) bitand sha1WordMask
    e = d
    d = c
    c = rotateLeft(value: b, count: 30)
    b = a
    a = next
  }
  loop var t: Int = 40, t < 60, ++t {
    let mixed: Int = (b bitand c) bitor (b bitand d) bitor (c bitand d)
    let next: Int = (rotateLeft(value: a, count: 5) + mixed + e + 2400959708 + words.copyAtFallback(
      index: t
      fallback: 0
    )) bitand sha1WordMask
    e = d
    d = c
    c = rotateLeft(value: b, count: 30)
    b = a
    a = next
  }
  loop var t: Int = 60, t < 80, ++t {
    let mixed: Int = b bitxor c bitxor d
    let next: Int = (rotateLeft(value: a, count: 5) + mixed + e + 3395469782 + words.copyAtFallback(
      index: t
      fallback: 0
    )) bitand sha1WordMask
    e = d
    d = c
    c = rotateLeft(value: b, count: 30)
    b = a
    a = next
  }
  state.h0 = (state.h0 + a) bitand sha1WordMask
  state.h1 = (state.h1 + b) bitand sha1WordMask
  state.h2 = (state.h2 + c) bitand sha1WordMask
  state.h3 = (state.h3 + d) bitand sha1WordMask
  state.h4 = (state.h4 + e) bitand sha1WordMask
}

func appendWord(digest: mod List(UInt8), word: view Int) {
  digest.add(value: ((word shr 24) bitand 255) as UInt8)
  digest.add(value: ((word shr 16) bitand 255) as UInt8)
  digest.add(value: ((word shr 8) bitand 255) as UInt8)
  digest.add(value: (word bitand 255) as UInt8)
}

# Where the platform has a hardware SHA-1: CommonCrypto on Apple
# (docs/platform-conditional-code.md, a capability defined next to its user)
const hasCommonCrypto: Bool = Target.isApple

when hasCommonCrypto {
  # One call into CommonCrypto: 1, or -1 for an input over 4 GB (CC_LONG is
  # 32 bits), which then takes the Rae path
  func commonCryptoSha1(
    bytes: Buffer(UInt8)
    offset: Int
    count: Int
    digest: Buffer(UInt8)
  ) unsafe extern("rae_ext_Sha1_commonCrypto") ret Int
}

# The 20-byte SHA-1 digest of `count` bytes of `bytes` from `start`: the
# platform's hardware SHA-1 where there is one, the Rae implementation
# elsewhere
func sha1Range(bytes: view List(UInt8), start: view Int, count: view Int) ret List(UInt8) {
  when hasCommonCrypto {
    if start >= 0 and count >= 0 and start + count <= bytes.length {
      var digest: List(UInt8) = List.create(UInt8, cap: 20)
      loop var i: Int = 0, i < 20, ++i {
        digest.add(value: 0)
      }
      var answered: Int = -1
      unsafe {
        answered = commonCryptoSha1(
          bytes: bytes.data
          offset: start
          count: count
          digest: digest.data
        )
      }
      if answered is 1 {
        ret digest
      }
    }
  }
  ret portableSha1Range(bytes: bytes, start: start, count: count)
}

# The same digest computed in Rae: the reference implementation, and the
# fallback on platforms without a native SHA-1
func portableSha1Range(bytes: view List(UInt8), start: view Int, count: view Int) ret List(UInt8) {
  var state: Sha1State = createSha1State()
  var whole: Int = 0
  if count > 0 {
    whole = count - count % 64
  }
  var block: Int = 0
  if start is 0 {
    # The full blocks straight from the input
    loop block < whole {
      sha1Block(state: state, bytes: bytes, offset: block)
      block = block + 64
    }
  }
  # The rest (all of it when `start` is not 0), then the padding: 0x80,
  # zeros, and the message length in bits, big-endian, in 64 bits
  var tail: List(UInt8) = List.create(UInt8, cap: 128)
  loop var i: Int = start + block, i < start + count, ++i {
    tail.add(value: bytes.copyAtFallback(index: i, fallback: 0))
  }
  tail.add(value: 128)
  loop tail.length % 64 is not 56 {
    tail.add(value: 0)
  }
  let bits: Int = count * 8
  loop var k: Int = 0, k < 8, ++k {
    tail.add(value: ((bits shr (56 - k * 8)) bitand 255) as UInt8)
  }
  var offset: Int = 0
  loop offset < tail.length {
    sha1Block(state: state, bytes: tail, offset: offset)
    offset = offset + 64
  }
  var digest: List(UInt8) = List.create(UInt8, cap: 20)
  appendWord(digest: digest, word: state.h0)
  appendWord(digest: digest, word: state.h1)
  appendWord(digest: digest, word: state.h2)
  appendWord(digest: digest, word: state.h3)
  appendWord(digest: digest, word: state.h4)
  ret digest
}

# The 20-byte SHA-1 digest of `bytes`
func sha1(bytes: view List(UInt8)) ret List(UInt8) {
  ret sha1Range(bytes: bytes, start: 0, count: bytes.length)
}

# The 20-byte SHA-1 digest of the bytes of `text` (its UTF-8)
func sha1Text(text: view String) ret List(UInt8) {
  let count: Int = text.length()
  var bytes: List(UInt8) = List.create(UInt8, cap: count)
  loop var i: Int = 0, i < count, ++i {
    bytes.add(value: text.byteAt(index: i) as UInt8)
  }
  ret sha1(bytes: bytes)
}

# Bytes as lowercase hex ("a9993e36…"), the way digests are written
func hexText(bytes: view List(UInt8)) ret String {
  let digits: String = "0123456789abcdef"
  var out: List(UInt8) = List.create(UInt8, cap: bytes.length * 2)
  loop var i: Int = 0, i < bytes.length, ++i {
    let byte: Int = bytes.copyAtFallback(index: i, fallback: 0) as Int
    out.add(value: digits.byteAt(index: byte shr 4) as UInt8)
    out.add(value: digits.byteAt(index: byte bitand 15) as UInt8)
  }
  ret fromBytes(bytes: out, start: 0, count: out.length)
}
