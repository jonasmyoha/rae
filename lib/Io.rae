# IO utilities for Rae.
#
# `log`/`logS` (console output) moved to lib/core.rae as bare-callable core
# essentials. This module keeps line/char input, reached via the `io` namespace
# (Io.readLine() / Io.readChar()).
# One line from stdin as read, its newline included; empty at end of input
func rae_io_read_line_raw() unsafe extern ret String

# `text` cut to its first `length` bytes in place, without a copy
func rae_ext_rae_str_shorten(text: mod String, length: Int) unsafe extern

# A String's length and one of its bytes (-1 past the end). Io is loaded by
# itself too, without lib/String, so it uses the primitives directly.
func rae_ext_rae_str_len(s: String) unsafe extern ret Int

func rae_ext_rae_str_byte_at(s: String, index: Int) unsafe extern ret Int

func rae_io_read_char() unsafe extern ret Char32

# The next line of stdin without its line ending (a "\n", or "\r\n"); a last
# line with no newline is read whole. Empty at end of input.
func readLine() ret String {
  unsafe {
    var line: String = rae_io_read_line_raw()
    var length: Int = rae_ext_rae_str_len(s: line)
    if rae_ext_rae_str_byte_at(s: line, index: length - 1) is 10 {
      length = length - 1
    }
    if rae_ext_rae_str_byte_at(s: line, index: length - 1) is 13 {
      length = length - 1
    }
    rae_ext_rae_str_shorten(text: line, length: length)
    ret line
  }
}

func readChar() ret Char32 {
  unsafe {
    ret rae_io_read_char()
  }
}
