# PushNotification — notifications a server sends to this device (docs/push-notifications.md):
# a chest ready, a friend's message, a turn in a match. The server side, which sends them
# through APNs, is the app's.
#
#     localNotificationAsk()                         # the permission is LocalNotification's
#     var pushNotifications: PushNotifications = createPushNotifications()  # on the World or App
#     pushNotificationRegister()                     # at launch: asks for the device token
#     ...                                            # each frame:
#     if let token: String = pushNotificationToken() { ...send it to the server once... }
#     if let push: PushNotification = nextPushNotification(pushNotifications: pushNotifications) {
#       ...push.payload is the server's JSON; push.tapped when its tap opened the app...
#     }
#
# The token comes some time after the register call, and can change: read it again at each
# launch. A notification that arrives while the app is in the foreground comes with `tapped`
# false and shows nothing on screen; one the person tapped (in the background, or one that
# launched the app) comes with `tapped` true, as AppLinks gives the link that opened the app.
# Each comes once, whole, in the order they came, and wakes the frame loop (EventLoop.wake).
#
# On iOS this is APNs (runtime_push_notification.h; the app needs the aps-environment
# entitlement, which tools/ios/gen-ios.sh writes). Android (FCM) is not there yet: it, the
# Mac and the web register nothing and receive nothing. In a headless run (RAE_UI_HEADLESS,
# RAE_SDL_HEADLESS_MS or RAE_HEADLESS_FRAMES set) the register call logs `[push] register`
# and gives a simulated token (RAE_PUSH_TOKEN, or `simulated-push-token`). Everywhere,
# RAE_PUSH_OPENED=<json> stands in for a tap that launched the app, and simulatePushNotification
# for one that arrives, so the same code path runs in a test.
import Sys
cheader "runtime_push_notification.h"

const hasPushNotifications: Bool = Target.os is Os.ios

func rae_ext_PushNotification_take() unsafe extern("rae_ext_PushNotification_take") ret String

func rae_ext_PushNotification_token() unsafe extern("rae_ext_PushNotification_token") ret String

func rae_ext_PushNotification_error() unsafe extern("rae_ext_PushNotification_error") ret String

func rae_ext_PushNotification_simulate(
  payload: String
  tapped: Bool
) unsafe extern("rae_ext_PushNotification_simulate")

func rae_ext_PushNotification_simulateToken(
  token: String
) unsafe extern("rae_ext_PushNotification_simulateToken")

when hasPushNotifications {
  func rae_ext_PushNotification_register() mainThread unsafe extern("rae_ext_PushNotification_register") ret
    Int

}

# The token a headless run gives when RAE_PUSH_TOKEN is not set
const simulatedPushToken: String = "simulated-push-token"

# One notification the server sent
type PushNotification {
  # what the server sent, as JSON (on iOS the whole userInfo, with its "aps")
  payload: String
  # true when the person tapped it, which opened or brought back the app
  tapped: Bool
}

type PushNotifications {
  # the RAE_PUSH_OPENED stand-in has been read: it is one tap, once
  standInRead: Bool = false
}

func createPushNotifications() ret PushNotifications {
  ret PushNotifications {}
}

# A headless run, by the window's own definition (lib/Gpu2d headlessRequested)
func pushNotificationHeadless() ret Bool {
  ret Sys.getEnv(name: "RAE_UI_HEADLESS").length() > 0 or Sys.getEnv(name: "RAE_SDL_HEADLESS_MS").length() > 0 or Sys.getEnv(
    name: "RAE_HEADLESS_FRAMES"
  ).length() > 0
}

# Ask for this device's token; it comes later, through pushNotificationToken. True when the
# system was asked (headless: false, and the simulated token is there at once).
func pushNotificationRegister() ret Bool {
  if pushNotificationHeadless() {
    log("[push] register")
    let fromEnvironment: String = Sys.getEnv(name: "RAE_PUSH_TOKEN")
    if fromEnvironment.length() > 0 {
      simulatePushToken(token: fromEnvironment)
    } else {
      simulatePushToken(token: simulatedPushToken)
    }
    ret false
  }
  when hasPushNotifications {
    unsafe {
      ret rae_ext_PushNotification_register() is 1
    }
  } else {
    ret false
  }
}

# This device's token (hex on iOS), for the server to send to; none until it has come
func pushNotificationToken() ret opt String {
  unsafe {
    let token: String = rae_ext_PushNotification_token()
    if token.length() > 0 {
      ret token
    }
  }
  ret none
}

# Why the last registration failed (no entitlement, no network, the simulator), or none
func pushNotificationError() ret opt String {
  unsafe {
    let error: String = rae_ext_PushNotification_error()
    if error.length() > 0 {
      ret error
    }
  }
  ret none
}

# A notification in the system's place, for a test
func simulatePushNotification(payload: view String, tapped: view Bool) {
  unsafe {
    rae_ext_PushNotification_simulate(payload: payload, tapped: tapped)
  }
}

# A token in the system's place, for a test
func simulatePushToken(token: view String) {
  unsafe {
    rae_ext_PushNotification_simulateToken(token: token)
  }
}

# The next notification that arrived or was tapped, or none: one per call
func nextPushNotification(pushNotifications: mod PushNotifications) ret opt PushNotification {
  if not pushNotifications.standInRead {
    pushNotifications.standInRead = true
    let standIn: String = Sys.getEnv(name: "RAE_PUSH_OPENED")
    if standIn.length() > 0 {
      simulatePushNotification(payload: standIn, tapped: true)
    }
  }
  unsafe {
    let taken: String = rae_ext_PushNotification_take()
    if taken.length() > 0 {
      ret PushNotification {
        payload: taken.sub(start: 1, len: taken.length() - 1)
        tapped: taken.startsWith(prefix: "t")
      }
    }
  }
  ret none
}
