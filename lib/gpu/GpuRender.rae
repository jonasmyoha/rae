# gpu/GpuRender — render support for the manager (#903): render pipelines,
# render bind groups over an ORDERED entry list, adopted external handles, and
# indexed-draw recording over gpu/GpuLifetime's Recording. Pure Rae over the
# generated bindings; the same owner, validation, pinning and deferred-release
# rules as the compute surface. This is the "render-pipeline surface" #870
# deferred, so a render surface such as water's can be manager-owned.
#
# Adopted externals: `adoptExternalBuffer` / `adoptExternalTextureView` give an
# `ExternalId` over a native handle the manager REFERENCES — it can be bound,
# attached and pinned like any dependency — but NEVER owns: the manager never
# releases it (the adopter does), and `releaseExternal` only frees the slot.
# This is how the legacy gbuffer's per-frame resources (frame uniform, depth and
# lit views, mesh buffers) are bound without migrating the whole renderer. The
# adopter guarantees the handle stays valid while adopted (re-adopt when the
# gbuffer's targets generation changes), which is why adoption is `unsafe`.
#
# Rae-side validation is a safety property here as in #870: wgpu-native aborts
# the process on a WebGPU validation error, so usages, formats, alignment and
# liveness are refused in Rae before wgpu sees them.
open webgpu/Context
open webgpu/Webgpu
open webgpu/WebgpuEnums
open webgpu/WebgpuTypes
open gpu/GpuResources
open gpu/GpuLifetime

type RenderPipelineId {
  managerTag: Int
  slot: Int
  generation: Int
}

type ExternalId {
  managerTag: Int
  slot: Int
  generation: Int
}

const externalBuffer: Int = 0
const externalTextureView: Int = 1
# #904: the deferred post-passes bind C-owned samplers and build bind groups
# over C-owned pipelines (lighting / taa / depth pyramid), so those are
# adoptable too. A pipeline external is a LAYOUT source and a draw pipeline,
# never a bind entry.
const externalRenderPipeline: Int = 2
const externalSampler: Int = 3

# ----- resource references (ordered bind entries and attachments) --------

const refBuffer: Int = 0
const refTextureView: Int = 1
const refSampler: Int = 2
const refExternal: Int = 3
# A placeholder entry: consumes a binding number without binding anything, for
# a layout whose entry point leaves a binding unused (wgpu derives layouts from
# the bindings an entry point actually touches).
const refSkip: Int = 4

# One reference to a manager resource or an adopted external, used for bind
# entries (in binding order) and for attachments / vertex / index buffers.
type ResourceRef {
  refKind: Int
  managerTag: Int
  slot: Int
  generation: Int
}

func bufferRef(id: view BufferId) ret ResourceRef {
  ret ResourceRef { refKind: refBuffer, managerTag: id.managerTag, slot: id.slot, generation: id.generation }
}

func textureViewRef(id: view TextureViewId) ret ResourceRef {
  ret ResourceRef { refKind: refTextureView, managerTag: id.managerTag, slot: id.slot, generation: id.generation }
}

func samplerRef(id: view SamplerId) ret ResourceRef {
  ret ResourceRef { refKind: refSampler, managerTag: id.managerTag, slot: id.slot, generation: id.generation }
}

func externalRef(id: view ExternalId) ret ResourceRef {
  ret ResourceRef { refKind: refExternal, managerTag: id.managerTag, slot: id.slot, generation: id.generation }
}

func skipRef() ret ResourceRef {
  ret ResourceRef { refKind: refSkip, managerTag: 0, slot: 0 - 1, generation: 0 }
}

func noRef() ret ResourceRef {
  ret ResourceRef { refKind: refBuffer, managerTag: 0, slot: 0 - 1, generation: 0 }
}

# The slot-table kind a reference pins and validates against.
func refDepKind(ref: view ResourceRef) ret Int {
  if ref.refKind is refBuffer { ret kindBuffer }
  if ref.refKind is refTextureView { ret kindTextureView }
  if ref.refKind is refSampler { ret kindSampler }
  ret kindExternal
}

func isValidRef(resources: view GpuResources, ref: view ResourceRef) ret Bool {
  if ref.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: tableFor(resources: resources, kind: refDepKind(ref: ref)), capacity: resources.capacity, slot: ref.slot, generation: ref.generation)
}

# An external's sub-kind (buffer or texture view); -1 when not an external.
func externalKind(resources: view GpuResources, ref: view ResourceRef) ret Int {
  if ref.refKind is not refExternal { ret 0 - 1 }
  ret intAt(list: resources.externals.nativeIndex, index: ref.slot)
}

func refIsBuffer(resources: view GpuResources, ref: view ResourceRef) ret Bool {
  if ref.refKind is refBuffer { ret true }
  ret externalKind(resources: resources, ref: ref) is externalBuffer
}

func refIsTextureView(resources: view GpuResources, ref: view ResourceRef) ret Bool {
  if ref.refKind is refTextureView { ret true }
  ret externalKind(resources: resources, ref: ref) is externalTextureView
}

# The raw native handle behind a reference — an unchecked pointer, so this is
# unsafe and only used inside unsafe blocks after validation.
func refHandle(resources: view GpuResources, ref: view ResourceRef) unsafe ret Ptr {
  unsafe { ret slotHandle(table: tableFor(resources: resources, kind: refDepKind(ref: ref)), slot: ref.slot) }
}

# The authoritative native size of a buffer reference (manager or external).
func refBufferSize(resources: view GpuResources, ref: view ResourceRef) ret Int {
  if refIsBuffer(resources: resources, ref: ref) is false { ret 0 - 1 }
  unsafe { ret wgpuBufferGetSize(buffer: refHandle(resources: resources, ref: ref)) as Int }
}

func refBufferUsage(resources: view GpuResources, ref: view ResourceRef) ret UInt64 {
  if refIsBuffer(resources: resources, ref: ref) is false { ret 0 as UInt64 }
  unsafe { ret wgpuBufferGetUsage(buffer: refHandle(resources: resources, ref: ref)) }
}

# Records a reference (and a manager view's parent texture, indirectly) as a
# dependency in the arena.
func appendRefDep(resources: mod GpuResources, ref: view ResourceRef) {
  appendDep(resources: resources, kind: refDepKind(ref: ref), slot: ref.slot, generation: ref.generation)
  if ref.refKind is refTextureView {
    let parent: Int = intAt(list: resources.textureViews.parentSlot, index: ref.slot)
    if parent >= 0 {
      appendDep(resources: resources, kind: kindTexture, slot: parent, generation: intAt(list: resources.textureViews.parentGeneration, index: ref.slot))
    }
  }
}

# ----- adopted externals ----------------------------------------------

func isValidExternal(resources: view GpuResources, id: view ExternalId) ret Bool {
  if id.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: resources.externals, capacity: resources.capacity, slot: id.slot, generation: id.generation)
}

func liveExternalCount(resources: view GpuResources) ret Int {
  ret liveCount(table: resources.externals, capacity: resources.capacity)
}

func adoptExternal(resources: mod GpuResources, handle: copy Ptr, subKind: view Int) unsafe ret opt ExternalId {
  let slot: Int = findFreeSlot(table: resources.externals, capacity: resources.capacity)
  if slot < 0 { ret none }
  unsafe {
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.externals, slot: slot, handle: handle)
  }
  resources.externals.nativeIndex.set(index: slot, value: subKind)
  ret ExternalId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.externals, slot: slot) }
}

# Adopts a native buffer the adopter owns and keeps valid while adopted.
func adoptExternalBuffer(resources: mod GpuResources, handle: copy Ptr) unsafe ret opt ExternalId {
  unsafe { ret adoptExternal(resources: resources, handle: handle, subKind: externalBuffer) }
}

# Adopts a native texture view the adopter owns and keeps valid while adopted.
func adoptExternalTextureView(resources: mod GpuResources, handle: copy Ptr) unsafe ret opt ExternalId {
  unsafe { ret adoptExternal(resources: resources, handle: handle, subKind: externalTextureView) }
}

# Adopts a native sampler the adopter owns and keeps valid while adopted.
func adoptExternalSampler(resources: mod GpuResources, handle: copy Ptr) unsafe ret opt ExternalId {
  unsafe { ret adoptExternal(resources: resources, handle: handle, subKind: externalSampler) }
}

# Adopts a native RENDER PIPELINE the adopter owns (a C-created deferred pass
# pipeline): usable as the layout source of createRenderBindGroupExternal and
# as the pipeline of recordDrawInPassExternal.
func adoptExternalRenderPipeline(resources: mod GpuResources, handle: copy Ptr) unsafe ret opt ExternalId {
  unsafe { ret adoptExternal(resources: resources, handle: handle, subKind: externalRenderPipeline) }
}

func isExternalRenderPipeline(resources: view GpuResources, id: view ExternalId) ret Bool {
  if isValidExternal(resources: resources, id: id) is false { ret false }
  ret intAt(list: resources.externals.nativeIndex, index: id.slot) is externalRenderPipeline
}

# Adopt-and-collect helpers for a pass that re-adopts its C-owned inputs every
# targets generation: each adopts `handle`, records the ExternalId in `adopted`
# (so releaseExternalIds can drop the whole generation at once) and returns
# the bind entry for it. A null handle yields a dead reference, so the bind
# group creation fails closed instead of binding nothing.
func adoptBufferRef(resources: mod GpuResources, adopted: mod List(ExternalId), handle: copy Ptr) unsafe ret ResourceRef {
  unsafe {
    if let id: ExternalId = adoptExternalBuffer(resources: resources, handle: handle) {
      adopted.add(value: id)
      ret externalRef(id: id)
    }
  }
  ret noRef()
}

func adoptTextureViewRef(resources: mod GpuResources, adopted: mod List(ExternalId), handle: copy Ptr) unsafe ret ResourceRef {
  unsafe {
    if let id: ExternalId = adoptExternalTextureView(resources: resources, handle: handle) {
      adopted.add(value: id)
      ret externalRef(id: id)
    }
  }
  ret noRef()
}

func adoptSamplerRef(resources: mod GpuResources, adopted: mod List(ExternalId), handle: copy Ptr) unsafe ret ResourceRef {
  unsafe {
    if let id: ExternalId = adoptExternalSampler(resources: resources, handle: handle) {
      adopted.add(value: id)
      ret externalRef(id: id)
    }
  }
  ret noRef()
}

# Releases every external in `list` and empties it (a pass's per-generation
# adoptions, dropped after the bind groups over them were retired).
func releaseExternalIds(resources: mod GpuResources, list: mod List(ExternalId)) {
  loop var i: Int = 0, i < list.length, ++i {
    if let id: ExternalId = list.copyAt(index: i) { releaseExternal(resources: resources, id: id) }
  }
  list.clear()
}

# Drops the reference: the generation bumps (no new use) and the slot frees
# once nothing pins it. The native handle is NOT released — it never was ours.
func releaseExternal(resources: mod GpuResources, id: view ExternalId) ret Bool {
  if isValidExternal(resources: resources, id: id) is false { ret false }
  unsafe { retireSlot(table: resources.externals, slot: id.slot, kind: kindExternal, empty: webgpuNull()) }
  ret true
}

# ----- render pipelines -------------------------------------------------

func isValidRenderPipeline(resources: view GpuResources, id: view RenderPipelineId) ret Bool {
  if id.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: resources.renderPipelines, capacity: resources.capacity, slot: id.slot, generation: id.generation)
}

func liveRenderPipelineCount(resources: view GpuResources) ret Int {
  ret liveCount(table: resources.renderPipelines, capacity: resources.capacity)
}

# One vertex attribute of the single vertex buffer.
type VertexAttributeSpec {
  format: Int32
  offset: Int
  location: Int
}

# What a render pipeline needs beyond its shader: one interleaved vertex buffer
# layout (NO vertex buffer when `attributes` is empty and the vertex shader
# builds geometry from vertex_index, as grass and sprites do), one or more
# colour targets (all alpha-blended when `alphaBlend`, as water's surface is;
# the G-buffer's three targets are unblended), and an optional depth test
# (format 0 = none; water uses read-only reverse-Z: Depth32Float, no write,
# Greater; the geometry pass writes depth).
type RenderPipelineSpec {
  vertexStride: Int
  attributes: List(VertexAttributeSpec)
  colorFormats: List(Int32)
  alphaBlend: Bool
  # With alphaBlend: true, the source colour is already premultiplied by its
  # alpha (One / OneMinusSrcAlpha — the 2D box pass) instead of straight
  # (SrcAlpha / OneMinusSrcAlpha — water, transparents).
  premultiplied: Bool
  depthFormat: Int32
  depthWrite: Bool
  depthCompare: Int32
  cullMode: Int32
}

func createRenderPipeline(resources: mod GpuResources, wgsl: view String, vertexEntry: view String, fragmentEntry: view String, spec: view RenderPipelineSpec) ret opt RenderPipelineId {
  if wgsl.length() is 0 or vertexEntry.length() is 0 or fragmentEntry.length() is 0 { ret none }
  if spec.attributes.length > 0 and spec.vertexStride < 1 { ret none }
  if spec.colorFormats.length < 1 { ret none }
  let slot: Int = findFreeSlot(table: resources.renderPipelines, capacity: resources.capacity)
  if slot < 0 { ret none }
  unsafe {
    let sourceC: Buffer(Any) = wgsl.toCStr()
    var sourceList: List(WGPUShaderSourceWGSL) = List.create(WGPUShaderSourceWGSL, cap: 1)
    sourceList.add(value: { chain: { sType: WGPUSType_ShaderSourceWGSL }, code: { data: sourceC, length: WGPU_STRLEN } })
    let moduleDescriptor: WGPUShaderModuleDescriptor = { nextInChain: sourceList.data }
    let shaderModule: Ptr = wgpuDeviceCreateShaderModule(device: webgpuDevice(), descriptor: moduleDescriptor)
    if shaderModule is webgpuNull() { ret none }
    var attributes: List(WGPUVertexAttribute) = List.create(WGPUVertexAttribute, cap: spec.attributes.length)
    var i: Int = 0
    loop i < spec.attributes.length {
      if let attribute: VertexAttributeSpec = spec.attributes.copyAt(index: i) {
        attributes.add(value: { format: attribute.format, offset: attribute.offset as UInt64, shaderLocation: attribute.location as UInt32 })
      }
      i = i + 1
    }
    var layouts: List(WGPUVertexBufferLayout) = List.create(WGPUVertexBufferLayout, cap: 1)
    var bufferCount: Int = 0
    if attributes.length > 0 {
      layouts.add(value: { stepMode: WGPUVertexStepMode_Vertex, arrayStride: spec.vertexStride as UInt64, attributeCount: attributes.length as UInt64, attributes: attributes.data })
      bufferCount = 1
    }
    var sourceFactor: Int32 = WGPUBlendFactor_SrcAlpha
    if spec.premultiplied { sourceFactor = WGPUBlendFactor_One }
    var blends: List(WGPUBlendState) = List.create(WGPUBlendState, cap: 1)
    blends.add(value: {
      color: { operation: WGPUBlendOperation_Add, srcFactor: sourceFactor, dstFactor: WGPUBlendFactor_OneMinusSrcAlpha }
      alpha: { operation: WGPUBlendOperation_Add, srcFactor: WGPUBlendFactor_One, dstFactor: WGPUBlendFactor_OneMinusSrcAlpha }
    })
    var targets: List(WGPUColorTargetState) = List.create(WGPUColorTargetState, cap: spec.colorFormats.length)
    var target: Int = 0
    loop target < spec.colorFormats.length {
      if let colorFormat: Int32 = spec.colorFormats.copyAt(index: target) {
        if spec.alphaBlend {
          targets.add(value: { format: colorFormat, blend: blends.data, writeMask: WGPUColorWriteMask_All })
        } else {
          targets.add(value: { format: colorFormat, writeMask: WGPUColorWriteMask_All })
        }
      }
      target = target + 1
    }
    let vertexC: Buffer(Any) = vertexEntry.toCStr()
    let fragmentC: Buffer(Any) = fragmentEntry.toCStr()
    var fragments: List(WGPUFragmentState) = List.create(WGPUFragmentState, cap: 1)
    fragments.add(value: { module: shaderModule, entryPoint: { data: fragmentC, length: WGPU_STRLEN }, targetCount: targets.length as UInt64, targets: targets.data })
    var depths: List(WGPUDepthStencilState) = List.create(WGPUDepthStencilState, cap: 1)
    var writeFlag: Int32 = WGPUOptionalBool_False
    if spec.depthWrite { writeFlag = WGPUOptionalBool_True }
    depths.add(value: {
      format: spec.depthFormat
      depthWriteEnabled: writeFlag
      depthCompare: spec.depthCompare
      stencilFront: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep }
      stencilBack: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep }
      stencilReadMask: 4294967295 as UInt32
      stencilWriteMask: 4294967295 as UInt32
    })
    var handle: Ptr = webgpuNull()
    if spec.depthFormat is (0 as Int32) {
      let descriptor: WGPURenderPipelineDescriptor = {
        vertex: { module: shaderModule, entryPoint: { data: vertexC, length: WGPU_STRLEN }, bufferCount: bufferCount as UInt64, buffers: layouts.data }
        primitive: { topology: WGPUPrimitiveTopology_TriangleList, frontFace: WGPUFrontFace_CCW, cullMode: spec.cullMode }
        multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 }
        fragment: fragments.data
      }
      handle = wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: descriptor)
    } else {
      let descriptor: WGPURenderPipelineDescriptor = {
        vertex: { module: shaderModule, entryPoint: { data: vertexC, length: WGPU_STRLEN }, bufferCount: bufferCount as UInt64, buffers: layouts.data }
        primitive: { topology: WGPUPrimitiveTopology_TriangleList, frontFace: WGPUFrontFace_CCW, cullMode: spec.cullMode }
        depthStencil: depths.data
        multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 }
        fragment: fragments.data
      }
      handle = wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: descriptor)
    }
    wgpuShaderModuleRelease(shaderModule: shaderModule)
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.renderPipelines, slot: slot, handle: handle)
  }
  ret RenderPipelineId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.renderPipelines, slot: slot) }
}

func retireRenderPipeline(resources: mod GpuResources, id: view RenderPipelineId) ret Bool {
  if isValidRenderPipeline(resources: resources, id: id) is false { ret false }
  unsafe { retireSlot(table: resources.renderPipelines, slot: id.slot, kind: kindRenderPipeline, empty: webgpuNull()) }
  ret true
}

# ----- bind groups over an ordered entry list ---------------------------

# Appends `entries` (binding i = entry i, skips consume a number) as native
# bind-group entries and as dependencies in the arena. false if any is dead.
func appendOrderedEntries(resources: mod GpuResources, entries: view List(ResourceRef), nativeEntries: mod List(WGPUBindGroupEntry)) ret Bool {
  var i: Int = 0
  loop i < entries.length {
    if let entry: ResourceRef = entries.copyAt(index: i) {
      if entry.refKind is not refSkip {
        if isValidRef(resources: resources, ref: entry) is false { ret false }
        appendRefDep(resources: resources, ref: entry)
        unsafe {
          if refIsBuffer(resources: resources, ref: entry) {
            nativeEntries.add(value: { binding: i as UInt32, buffer: refHandle(resources: resources, ref: entry), size: refBufferSize(resources: resources, ref: entry) as UInt64 })
          } else if refIsTextureView(resources: resources, ref: entry) {
            nativeEntries.add(value: { binding: i as UInt32, textureView: refHandle(resources: resources, ref: entry) })
          } else {
            nativeEntries.add(value: { binding: i as UInt32, sampler: refHandle(resources: resources, ref: entry) })
          }
        }
      }
    }
    i = i + 1
  }
  ret true
}

# Finishes a bind group over `layout` (consumed: released here) whose
# dependencies were appended from `start`: creates the native group, stores
# it in `slot`, pins the dependency slice.
func finishBindGroup(resources: mod GpuResources, slot: view Int, start: view Int, layout: copy Ptr, nativeEntries: view List(WGPUBindGroupEntry)) ret opt BindGroupId {
  let count: Int = resources.depKinds.length - start
  if sliceIsLive(resources: resources, start: start, count: count) is false {
    unsafe { wgpuBindGroupLayoutRelease(bindGroupLayout: layout) }
    ret none
  }
  unsafe {
    let descriptor: WGPUBindGroupDescriptor = { layout: layout, entryCount: nativeEntries.length as UInt64, entries: nativeEntries.data }
    let handle: Ptr = wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: descriptor)
    wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.bindGroups, slot: slot, handle: handle)
  }
  resources.bindGroups.depStart.set(index: slot, value: start)
  resources.bindGroups.depCount.set(index: slot, value: count)
  pinSlice(resources: resources, start: start, count: count)
  ret BindGroupId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.bindGroups, slot: slot) }
}

# Group 0 of `pipeline` with `entries` bound at consecutive binding numbers in
# list order (buffers bound whole). Every entry must be live; the group pins
# each entry (and a manager view's texture) for its lifetime, exactly like the
# compute bind groups, and is a BindGroupId usable by recordDrawIndexed.
func createRenderBindGroup(resources: mod GpuResources, pipeline: view RenderPipelineId, entries: view List(ResourceRef)) ret opt BindGroupId {
  if isValidRenderPipeline(resources: resources, id: pipeline) is false { ret none }
  if entries.length < 1 { ret none }
  let slot: Int = findFreeSlot(table: resources.bindGroups, capacity: resources.capacity)
  if slot < 0 { ret none }
  let start: Int = resources.depKinds.length
  appendDep(resources: resources, kind: kindRenderPipeline, slot: pipeline.slot, generation: pipeline.generation)
  var nativeEntries: List(WGPUBindGroupEntry) = List.create(WGPUBindGroupEntry, cap: entries.length)
  if appendOrderedEntries(resources: resources, entries: entries, nativeEntries: nativeEntries) is false { ret none }
  unsafe {
    let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: slotHandle(table: resources.renderPipelines, slot: pipeline.slot), groupIndex: 0 as UInt32)
    ret finishBindGroup(resources: resources, slot: slot, start: start, layout: layout, nativeEntries: nativeEntries)
  }
}

# Group 0 of an ADOPTED render pipeline (a C-owned deferred pass pipeline)
# with `entries` in binding order; the group pins the external pipeline slot
# like a manager pipeline, so releasing the external behind a live group is
# deferred the same way.
func createRenderBindGroupExternal(resources: mod GpuResources, pipeline: view ExternalId, entries: view List(ResourceRef)) ret opt BindGroupId {
  if isExternalRenderPipeline(resources: resources, id: pipeline) is false { ret none }
  if entries.length < 1 { ret none }
  let slot: Int = findFreeSlot(table: resources.bindGroups, capacity: resources.capacity)
  if slot < 0 { ret none }
  let start: Int = resources.depKinds.length
  appendDep(resources: resources, kind: kindExternal, slot: pipeline.slot, generation: pipeline.generation)
  var nativeEntries: List(WGPUBindGroupEntry) = List.create(WGPUBindGroupEntry, cap: entries.length)
  if appendOrderedEntries(resources: resources, entries: entries, nativeEntries: nativeEntries) is false { ret none }
  unsafe {
    let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: slotHandle(table: resources.externals, slot: pipeline.slot), groupIndex: 0 as UInt32)
    ret finishBindGroup(resources: resources, slot: slot, start: start, layout: layout, nativeEntries: nativeEntries)
  }
}

# The same over a COMPUTE pipeline's group 0: the ordered, mixed-kind (and
# external-capable) counterpart of GpuLifetime.createBindGroup, for layouts
# whose binding order is not buffers-then-views-then-samplers.
func createComputeBindGroupOrdered(resources: mod GpuResources, pipeline: view PipelineId, entries: view List(ResourceRef)) ret opt BindGroupId {
  if isValidPipeline(resources: resources, id: pipeline) is false { ret none }
  if entries.length < 1 { ret none }
  let slot: Int = findFreeSlot(table: resources.bindGroups, capacity: resources.capacity)
  if slot < 0 { ret none }
  let start: Int = resources.depKinds.length
  appendDep(resources: resources, kind: kindPipeline, slot: pipeline.slot, generation: pipeline.generation)
  var nativeEntries: List(WGPUBindGroupEntry) = List.create(WGPUBindGroupEntry, cap: entries.length)
  if appendOrderedEntries(resources: resources, entries: entries, nativeEntries: nativeEntries) is false { ret none }
  unsafe {
    let layout: Ptr = wgpuComputePipelineGetBindGroupLayout(computePipeline: slotHandle(table: resources.pipelines, slot: pipeline.slot), groupIndex: 0 as UInt32)
    ret finishBindGroup(resources: resources, slot: slot, start: start, layout: layout, nativeEntries: nativeEntries)
  }
}

# ----- render targets and draws ----------------------------------------

# A pass target: one colour view (cleared or loaded) and an optional depth view.
type RenderTarget {
  colorView: ResourceRef
  clear: Bool
  clearR: Float
  clearG: Float
  clearB: Float
  clearA: Float
  hasDepth: Bool
  depthView: ResourceRef
  depthReadOnly: Bool
}

func renderTarget(colorView: view ResourceRef, clear: view Bool, r: view Float, g: view Float, b: view Float, a: view Float) ret RenderTarget {
  ret RenderTarget { colorView: colorView, clear: clear, clearR: r, clearG: g, clearB: b, clearA: a, hasDepth: false, depthView: noRef(), depthReadOnly: true }
}

func renderTargetWithDepth(colorView: view ResourceRef, clear: view Bool, r: view Float, g: view Float, b: view Float, a: view Float, depthView: view ResourceRef, depthReadOnly: view Bool) ret RenderTarget {
  ret RenderTarget { colorView: colorView, clear: clear, clearR: r, clearG: g, clearB: b, clearA: a, hasDepth: true, depthView: depthView, depthReadOnly: depthReadOnly }
}

# One render pass with one indexed draw (a water body is exactly this): begin
# the pass on the target, set the pipeline, bind group, vertex and index
# buffers (u32 indices, whole buffers, authoritative native sizes), draw, end.
# Manager buffers must carry Vertex / Index usage; adopted externals are the
# adopter's obligation. Every referenced resource becomes a use of the
# recording, validated again at submit and pinned until completion.
func recordDrawIndexed(recording: mod Recording, resources: view GpuResources, target: view RenderTarget, pipeline: view RenderPipelineId, bindGroup: view BindGroupId, vertexBuffer: view ResourceRef, indexBuffer: view ResourceRef, indexCount: view Int) ret Bool {
  if recordingIsOpen(recording: recording, resources: resources) is false { ret false }
  if isValidRenderPipeline(resources: resources, id: pipeline) is false { ret false }
  if bindGroupIsUsable(resources: resources, id: bindGroup) is false { ret false }
  if indexCount < 1 { ret false }
  if isValidRef(resources: resources, ref: target.colorView) is false or refIsTextureView(resources: resources, ref: target.colorView) is false { ret false }
  if target.hasDepth {
    if isValidRef(resources: resources, ref: target.depthView) is false or refIsTextureView(resources: resources, ref: target.depthView) is false { ret false }
  }
  if isValidRef(resources: resources, ref: vertexBuffer) is false or refIsBuffer(resources: resources, ref: vertexBuffer) is false { ret false }
  if isValidRef(resources: resources, ref: indexBuffer) is false or refIsBuffer(resources: resources, ref: indexBuffer) is false { ret false }
  if vertexBuffer.refKind is refBuffer and hasUsageFlag(usage: refBufferUsage(resources: resources, ref: vertexBuffer), flag: WGPUBufferUsage_Vertex) is false { ret false }
  if indexBuffer.refKind is refBuffer and hasUsageFlag(usage: refBufferUsage(resources: resources, ref: indexBuffer), flag: WGPUBufferUsage_Index) is false { ret false }
  if refBufferSize(resources: resources, ref: indexBuffer) < indexCount * 4 { ret false }
  unsafe {
    var loadOp: Int32 = WGPULoadOp_Load
    if target.clear { loadOp = WGPULoadOp_Clear }
    var colorAttachments: List(WGPURenderPassColorAttachment) = List.create(WGPURenderPassColorAttachment, cap: 1)
    colorAttachments.add(value: {
      view_: refHandle(resources: resources, ref: target.colorView)
      depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32
      loadOp: loadOp
      storeOp: WGPUStoreOp_Store
      clearValue: { r: target.clearR as Float64, g: target.clearG as Float64, b: target.clearB as Float64, a: target.clearA as Float64 }
    })
    var depthAttachments: List(WGPURenderPassDepthStencilAttachment) = List.create(WGPURenderPassDepthStencilAttachment, cap: 1)
    var pass: Ptr = webgpuNull()
    if target.hasDepth {
      if target.depthReadOnly {
        depthAttachments.add(value: { view_: refHandle(resources: resources, ref: target.depthView), depthLoadOp: WGPULoadOp_Undefined, depthStoreOp: WGPUStoreOp_Undefined, depthReadOnly: 1 as UInt32 })
      } else {
        depthAttachments.add(value: { view_: refHandle(resources: resources, ref: target.depthView), depthLoadOp: WGPULoadOp_Load, depthStoreOp: WGPUStoreOp_Store, depthReadOnly: 0 as UInt32 })
      }
      let descriptor: WGPURenderPassDescriptor = { colorAttachmentCount: 1 as UInt64, colorAttachments: colorAttachments.data, depthStencilAttachment: depthAttachments.data }
      pass = wgpuCommandEncoderBeginRenderPass(commandEncoder: recording.encoder, descriptor: descriptor)
    } else {
      let descriptor: WGPURenderPassDescriptor = { colorAttachmentCount: 1 as UInt64, colorAttachments: colorAttachments.data }
      pass = wgpuCommandEncoderBeginRenderPass(commandEncoder: recording.encoder, descriptor: descriptor)
    }
    if pass is webgpuNull() { ret false }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: slotHandle(table: resources.renderPipelines, slot: pipeline.slot))
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32, group: slotHandle(table: resources.bindGroups, slot: bindGroup.slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
    let vertexHandle: Ptr = refHandle(resources: resources, ref: vertexBuffer)
    wgpuRenderPassEncoderSetVertexBuffer(renderPassEncoder: pass, slot: 0 as UInt32, buffer: vertexHandle, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: vertexHandle))
    let indexHandle: Ptr = refHandle(resources: resources, ref: indexBuffer)
    wgpuRenderPassEncoderSetIndexBuffer(renderPassEncoder: pass, buffer: indexHandle, format: WGPUIndexFormat_Uint32, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: indexHandle))
    wgpuRenderPassEncoderDrawIndexed(renderPassEncoder: pass, indexCount: indexCount as UInt32, instanceCount: 1 as UInt32, firstIndex: 0 as UInt32, baseVertex: 0 as Int32, firstInstance: 0 as UInt32)
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  }
  recordUse(recording: recording, kind: kindRenderPipeline, slot: pipeline.slot, generation: pipeline.generation)
  recordUse(recording: recording, kind: kindBindGroup, slot: bindGroup.slot, generation: bindGroup.generation)
  let start: Int = intAt(list: resources.bindGroups.depStart, index: bindGroup.slot)
  let count: Int = intAt(list: resources.bindGroups.depCount, index: bindGroup.slot)
  var i: Int = start
  loop i < start + count {
    recordUse(recording: recording, kind: intAt(list: resources.depKinds, index: i), slot: intAt(list: resources.depSlots, index: i), generation: intAt(list: resources.depGenerations, index: i))
    i = i + 1
  }
  recordUse(recording: recording, kind: refDepKind(ref: target.colorView), slot: target.colorView.slot, generation: target.colorView.generation)
  if target.hasDepth { recordUse(recording: recording, kind: refDepKind(ref: target.depthView), slot: target.depthView.slot, generation: target.depthView.generation) }
  recordUse(recording: recording, kind: refDepKind(ref: vertexBuffer), slot: vertexBuffer.slot, generation: vertexBuffer.generation)
  recordUse(recording: recording, kind: refDepKind(ref: indexBuffer), slot: indexBuffer.slot, generation: indexBuffer.generation)
  ret true
}

# Bytes per texel of the formats the manager copies; -1 for an unknown one
# (refused rather than handed to wgpu, which would abort on a bad row pitch).
func texelBytes(format: view Int32) ret Int {
  if (format is WGPUTextureFormat_RGBA8Unorm) or (format is WGPUTextureFormat_BGRA8Unorm) or (format is WGPUTextureFormat_R32Float) { ret 4 }
  if (format is WGPUTextureFormat_RGBA16Float) or (format is WGPUTextureFormat_RG32Float) { ret 8 }
  if (format is WGPUTextureFormat_RGBA32Float) { ret 16 }
  ret 0 - 1
}

# Copies a 2D texture's level 0 into a buffer laid out row by row with
# `bytesPerRow` (a multiple of 256, at least width * texel size) — the pixel
# readback path for checks, diagnostics and screenshots. Both resources become
# uses of the recording.
func recordCopyTextureToBuffer(recording: mod Recording, resources: view GpuResources, texture: view TextureId, buffer: view BufferId, bytesPerRow: view Int) ret Bool {
  if recordingIsOpen(recording: recording, resources: resources) is false { ret false }
  if isValidTexture(resources: resources, id: texture) is false { ret false }
  let width: Int = textureWidth(resources: resources, id: texture)
  let height: Int = textureHeight(resources: resources, id: texture)
  if width < 1 or height < 1 { ret false }
  var texel: Int = 0 - 1
  unsafe { texel = texelBytes(format: wgpuTextureGetFormat(texture: slotHandle(table: resources.textures, slot: texture.slot))) }
  if texel < 1 { ret false }
  if bytesPerRow - (bytesPerRow / 256) * 256 is not 0 or bytesPerRow < width * texel { ret false }
  if bufferRangeIsValid(resources: resources, id: buffer, offset: 0, size: bytesPerRow * height) is false { ret false }
  if hasUsageFlag(usage: bufferUsage(resources: resources, id: buffer), flag: WGPUBufferUsage_CopyDst) is false { ret false }
  unsafe {
    let source: WGPUTexelCopyTextureInfo = { texture: slotHandle(table: resources.textures, slot: texture.slot), mipLevel: 0 as UInt32, origin: { x: 0 as UInt32, y: 0 as UInt32, z: 0 as UInt32 }, aspect: WGPUTextureAspect_All }
    let destination: WGPUTexelCopyBufferInfo = { layout: { offset: 0 as UInt64, bytesPerRow: bytesPerRow as UInt32, rowsPerImage: height as UInt32 }, buffer: slotHandle(table: resources.buffers, slot: buffer.slot) }
    let size: WGPUExtent3D = { width: width as UInt32, height: height as UInt32, depthOrArrayLayers: 1 as UInt32 }
    wgpuCommandEncoderCopyTextureToBuffer(commandEncoder: recording.encoder, source: source, destination: destination, copySize: size)
  }
  recordUse(recording: recording, kind: kindTexture, slot: texture.slot, generation: texture.generation)
  recordUse(recording: recording, kind: kindBuffer, slot: buffer.slot, generation: buffer.generation)
  ret true
}

# ----- draws into an EXTERNAL render pass ------------------------------------
#
# The legacy gbuffer opens its geometry pass in C; grass and sprites draw INTO
# that pass. These record on a raw pass encoder the caller obtained from the
# renderer (hence `unsafe`: the pass's validity and submission are the
# renderer's), resolving manager IDs with the usual checks. Nothing is pinned
# — the foreign submission is not tracked here — and retiring a used ID after
# the draw is a Release, never a Destroy: wgpu's own command tracking keeps the
# native alive until that command buffer completes.

func recordDrawIndirectInPass(resources: view GpuResources, pass: copy Ptr, pipeline: view RenderPipelineId, bindGroup: view BindGroupId, indirect: view ResourceRef) unsafe ret Bool {
  if isValidRenderPipeline(resources: resources, id: pipeline) is false { ret false }
  if bindGroupIsUsable(resources: resources, id: bindGroup) is false { ret false }
  if isValidRef(resources: resources, ref: indirect) is false or refIsBuffer(resources: resources, ref: indirect) is false { ret false }
  if indirect.refKind is refBuffer and hasUsageFlag(usage: refBufferUsage(resources: resources, ref: indirect), flag: WGPUBufferUsage_Indirect) is false { ret false }
  if refBufferSize(resources: resources, ref: indirect) < 16 { ret false }
  unsafe {
    if pass is webgpuNull() { ret false }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: slotHandle(table: resources.renderPipelines, slot: pipeline.slot))
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32, group: slotHandle(table: resources.bindGroups, slot: bindGroup.slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
    wgpuRenderPassEncoderDrawIndirect(renderPassEncoder: pass, indirectBuffer: refHandle(resources: resources, ref: indirect), indirectOffset: 0 as UInt64)
  }
  ret true
}

func recordDrawInPass(resources: view GpuResources, pass: copy Ptr, pipeline: view RenderPipelineId, bindGroup: view BindGroupId, vertexCount: view Int, instanceCount: view Int, firstVertex: view Int, firstInstance: view Int) unsafe ret Bool {
  if isValidRenderPipeline(resources: resources, id: pipeline) is false { ret false }
  if bindGroupIsUsable(resources: resources, id: bindGroup) is false { ret false }
  if vertexCount < 1 or instanceCount < 1 or firstVertex < 0 or firstInstance < 0 { ret false }
  unsafe {
    if pass is webgpuNull() { ret false }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: slotHandle(table: resources.renderPipelines, slot: pipeline.slot))
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32, group: slotHandle(table: resources.bindGroups, slot: bindGroup.slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
    wgpuRenderPassEncoderDraw(renderPassEncoder: pass, vertexCount: vertexCount as UInt32, instanceCount: instanceCount as UInt32, firstVertex: firstVertex as UInt32, firstInstance: firstInstance as UInt32)
  }
  ret true
}

# recordDrawInPass over an ADOPTED render pipeline (see adoptExternalRenderPipeline).
func recordDrawInPassExternal(resources: view GpuResources, pass: copy Ptr, pipeline: view ExternalId, bindGroup: view BindGroupId, vertexCount: view Int, instanceCount: view Int, firstVertex: view Int, firstInstance: view Int) unsafe ret Bool {
  if isExternalRenderPipeline(resources: resources, id: pipeline) is false { ret false }
  if bindGroupIsUsable(resources: resources, id: bindGroup) is false { ret false }
  if vertexCount < 1 or instanceCount < 1 or firstVertex < 0 or firstInstance < 0 { ret false }
  unsafe {
    if pass is webgpuNull() { ret false }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: slotHandle(table: resources.externals, slot: pipeline.slot))
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32, group: slotHandle(table: resources.bindGroups, slot: bindGroup.slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
    wgpuRenderPassEncoderDraw(renderPassEncoder: pass, vertexCount: vertexCount as UInt32, instanceCount: instanceCount as UInt32, firstVertex: firstVertex as UInt32, firstInstance: firstInstance as UInt32)
  }
  ret true
}

# An instanced indexed draw into a pass the caller opened, over the legacy
# gbuffer's C-owned mesh buffers (raw handles the mesh registry keeps valid for
# the frame — hence unsafe, like the pass encoder). The pipeline and bind group
# are validated manager objects; nothing is pinned (the caller's submission is
# not tracked here), as recordDrawInPass.
func recordDrawIndexedInPass(resources: view GpuResources, pass: copy Ptr, pipeline: view RenderPipelineId, bindGroup: view BindGroupId, vertexBuffer: copy Ptr, indexBuffer: copy Ptr, indexCount: view Int, instanceCount: view Int, firstInstance: view Int) unsafe ret Bool {
  if isValidRenderPipeline(resources: resources, id: pipeline) is false { ret false }
  if bindGroupIsUsable(resources: resources, id: bindGroup) is false { ret false }
  if indexCount < 1 or instanceCount < 1 or firstInstance < 0 { ret false }
  unsafe {
    if pass is webgpuNull() or vertexBuffer is webgpuNull() or indexBuffer is webgpuNull() { ret false }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: slotHandle(table: resources.renderPipelines, slot: pipeline.slot))
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32, group: slotHandle(table: resources.bindGroups, slot: bindGroup.slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
    wgpuRenderPassEncoderSetVertexBuffer(renderPassEncoder: pass, slot: 0 as UInt32, buffer: vertexBuffer, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: vertexBuffer))
    wgpuRenderPassEncoderSetIndexBuffer(renderPassEncoder: pass, buffer: indexBuffer, format: WGPUIndexFormat_Uint32, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: indexBuffer))
    wgpuRenderPassEncoderDrawIndexed(renderPassEncoder: pass, indexCount: indexCount as UInt32, instanceCount: instanceCount as UInt32, firstIndex: 0 as UInt32, baseVertex: 0 as Int32, firstInstance: firstInstance as UInt32)
  }
  ret true
}

# Binds a manager pipeline + bind group in a pass the caller opened without
# drawing — for a pass that the legacy C-driven code expects to find a known
# pipeline bound in (the geometry pass's static pipeline).
func recordBindInPass(resources: view GpuResources, pass: copy Ptr, pipeline: view RenderPipelineId, bindGroup: view BindGroupId) unsafe ret Bool {
  if isValidRenderPipeline(resources: resources, id: pipeline) is false { ret false }
  if bindGroupIsUsable(resources: resources, id: bindGroup) is false { ret false }
  unsafe {
    if pass is webgpuNull() { ret false }
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: slotHandle(table: resources.renderPipelines, slot: pipeline.slot))
    wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32, group: slotHandle(table: resources.bindGroups, slot: bindGroup.slot), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  }
  ret true
}

# Uploads `size` bytes from a raw C pointer into a manager buffer at `offset`
# (the legacy C-batched 2D primitives, #907). Same range/usage validation as
# writeBuffer; the source pointer is the caller's obligation, hence unsafe.
func writeBufferFromPtr(resources: view GpuResources, id: view BufferId, offset: view Int, data: copy Ptr, size: view Int) unsafe ret Bool {
  if size < 1 { ret false }
  if bufferRangeIsValid(resources: resources, id: id, offset: offset, size: size) is false { ret false }
  if hasUsageFlag(usage: bufferUsage(resources: resources, id: id), flag: WGPUBufferUsage_CopyDst) is false { ret false }
  unsafe {
    if data is webgpuNull() { ret false }
    wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: slotHandle(table: resources.buffers, slot: id.slot), bufferOffset: offset as UInt64, data: data, size: size as UInt64)
  }
  ret true
}

# Uploads a whole-texture RGBA8 image (`rows` rows of `bytesPerRow` bytes) into
# a manager texture through the queue: the 2D image pass (#908). The texture
# must be CopyDst and exactly `rows` high; the row size must match its width.
func writeTextureFromPtr(resources: view GpuResources, texture: view TextureId, data: copy Ptr, bytesPerRow: view Int, rows: view Int) unsafe ret Bool {
  if isValidTexture(resources: resources, id: texture) is false { ret false }
  if bytesPerRow < 4 or rows < 1 { ret false }
  if textureHeight(resources: resources, id: texture) is not rows { ret false }
  if textureWidth(resources: resources, id: texture) * 4 is not bytesPerRow { ret false }
  unsafe {
    if data is webgpuNull() { ret false }
    let handle: Ptr = slotHandle(table: resources.textures, slot: texture.slot)
    if hasUsageFlag(usage: wgpuTextureGetUsage(texture: handle), flag: WGPUTextureUsage_CopyDst) is false { ret false }
    let destination: WGPUTexelCopyTextureInfo = { texture: handle, aspect: WGPUTextureAspect_All }
    let layout: WGPUTexelCopyBufferLayout = { bytesPerRow: bytesPerRow as UInt32, rowsPerImage: rows as UInt32 }
    let extent: WGPUExtent3D = { width: (bytesPerRow / 4) as UInt32, height: rows as UInt32, depthOrArrayLayers: 1 as UInt32 }
    wgpuQueueWriteTexture(queue: webgpuQueue(), destination: destination, data: data, dataSize: (bytesPerRow * rows) as UInt64, dataLayout: layout, writeSize: extent)
  }
  ret true
}

# The same from a Rae byte list (procedural RGBA pixels); the list is only
# borrowed for the call, the queue copies it.
func writeTexture(resources: view GpuResources, texture: view TextureId, bytes: view List(UInt8), bytesPerRow: view Int) ret Bool {
  if bytesPerRow < 4 or bytes.length < bytesPerRow { ret false }
  if bytes.length % bytesPerRow is not 0 { ret false }
  unsafe { ret writeTextureFromPtr(resources: resources, texture: texture, data: bytes.data, bytesPerRow: bytesPerRow, rows: bytes.length / bytesPerRow) }
}

# ----- a render pass held open across many in-pass draws (#915) ---------

# Opens a pass on `recording` over `target` and hands the raw pass encoder
# back for the recordDrawInPass / recordBindInPass family; endRenderPass
# closes it. The target views are recorded as uses, so submitting the
# recording pins them. Raw pass handle out, hence unsafe.
func beginRenderPass(recording: mod Recording, resources: mod GpuResources, target: view RenderTarget) unsafe ret Ptr {
  unsafe {
    if recordingIsOpen(recording: recording, resources: resources) is false { ret webgpuNull() }
    if isValidRef(resources: resources, ref: target.colorView) is false or refIsTextureView(resources: resources, ref: target.colorView) is false { ret webgpuNull() }
    if target.hasDepth {
      if isValidRef(resources: resources, ref: target.depthView) is false or refIsTextureView(resources: resources, ref: target.depthView) is false { ret webgpuNull() }
    }
    recordUse(recording: recording, kind: refDepKind(ref: target.colorView), slot: target.colorView.slot, generation: target.colorView.generation)
    if target.hasDepth { recordUse(recording: recording, kind: refDepKind(ref: target.depthView), slot: target.depthView.slot, generation: target.depthView.generation) }
    var loadOp: Int32 = WGPULoadOp_Load
    if target.clear { loadOp = WGPULoadOp_Clear }
    var colorAttachments: List(WGPURenderPassColorAttachment) = List.create(WGPURenderPassColorAttachment, cap: 1)
    colorAttachments.add(value: {
      view_: refHandle(resources: resources, ref: target.colorView)
      depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32
      loadOp: loadOp
      storeOp: WGPUStoreOp_Store
      clearValue: { r: target.clearR as Float64, g: target.clearG as Float64, b: target.clearB as Float64, a: target.clearA as Float64 }
    })
    var depthAttachments: List(WGPURenderPassDepthStencilAttachment) = List.create(WGPURenderPassDepthStencilAttachment, cap: 1)
    if target.hasDepth {
      if target.depthReadOnly {
        depthAttachments.add(value: { view_: refHandle(resources: resources, ref: target.depthView), depthLoadOp: WGPULoadOp_Undefined, depthStoreOp: WGPUStoreOp_Undefined, depthReadOnly: 1 as UInt32 })
      } else {
        depthAttachments.add(value: { view_: refHandle(resources: resources, ref: target.depthView), depthLoadOp: WGPULoadOp_Load, depthStoreOp: WGPUStoreOp_Store, depthReadOnly: 0 as UInt32 })
      }
      let descriptor: WGPURenderPassDescriptor = { colorAttachmentCount: 1 as UInt64, colorAttachments: colorAttachments.data, depthStencilAttachment: depthAttachments.data }
      ret wgpuCommandEncoderBeginRenderPass(commandEncoder: recording.encoder, descriptor: descriptor)
    }
    let descriptor: WGPURenderPassDescriptor = { colorAttachmentCount: 1 as UInt64, colorAttachments: colorAttachments.data }
    ret wgpuCommandEncoderBeginRenderPass(commandEncoder: recording.encoder, descriptor: descriptor)
  }
}

func endRenderPass(pass: copy Ptr) unsafe {
  unsafe {
    if pass is webgpuNull() { ret }
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  }
}

# Records a bind group / render pipeline the in-pass draws used, so the
# recording's submission pins it: retiring it afterwards defers its release
# until the GPU is done with it (the frame's per-run groups, #915).
func recordBindGroupUse(recording: mod Recording, resources: view GpuResources, id: view BindGroupId) {
  if isValidBindGroup(resources: resources, id: id) is false { ret }
  recordUse(recording: recording, kind: kindBindGroup, slot: id.slot, generation: id.generation)
}

func recordRenderPipelineUse(recording: mod Recording, resources: view GpuResources, id: view RenderPipelineId) {
  if isValidRenderPipeline(resources: resources, id: id) is false { ret }
  recordUse(recording: recording, kind: kindRenderPipeline, slot: id.slot, generation: id.generation)
}

# The scissor of an open pass, in framebuffer pixels (clamped by the caller).
func setScissorInPass(pass: copy Ptr, x: copy Int, y: copy Int, width: copy Int, height: copy Int) unsafe {
  unsafe {
    if pass is webgpuNull() { ret }
    wgpuRenderPassEncoderSetScissorRect(renderPassEncoder: pass, x: x as UInt32, y: y as UInt32, width: width as UInt32, height: height as UInt32)
  }
}

