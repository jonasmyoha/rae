# gpu/GpuResources — the instance-owned GPU resource manager (#869) under the
# approved identity contract (docs/gpu-resource-identity-design.md), with the
# #870 lifetime layer's slot bookkeeping (pins, deferred release, dependencies).
#
# Ownership: `GpuResources` owns native WebGPU resources through `create`/`drop`
# and has no `copy`. IDs are copyable identities — three Ints, no pointer — so
# ordinary systems can store, copy and log them freely; copying an ID is an
# ordinary value copy with no native effect. Every kind is a distinct Rae type
# over one layout, so kind confusion is a compile error.
#
# Identity: the manager's `managerTag` comes from an `IdIssuer` the root owns and
# passes explicitly; one issuer never hands out the same tag twice, so two
# managers built from it reject each other's IDs, and a recreated manager never
# accepts an ID of the manager it replaced.
#
# Validation (every safe operation): owner tag -> kind (the Rae type) -> slot
# range -> live slot -> generation -> operation-specific usage/range, where size
# and usage are RE-QUERIED from the native object, never taken from a field a
# caller can write. A rejected ID is a plain false/none.
#
# Lifetime (#870): a slot carries `useCount`, the number of in-flight uses
# (submitted, not yet completed work, and live bind groups that bind it).
# `retire` always bumps the generation — every copy of the ID goes stale at once
# and no NEW use can be acquired — but the native reference is RELEASED only when
# `useCount` is zero; otherwise the slot is `retired` and released when its last
# use completes. Release means dropping this manager's reference (wgpu*Release);
# the manager never calls wgpu*Destroy, so a resource an in-flight submission
# or another native object still references is never destroyed under it.
#
# This module adopts the unsafe boundary: raw handles live behind `unsafe`
# blocks and only the safe wrappers are the public surface.
open webgpu/Context
open webgpu/Webgpu
open webgpu/WebgpuEnums
open webgpu/WebgpuTypes
open webgpu/ReadRequest
open webgpu/Readback

# ----- identities ------------------------------------------------------

type IdIssuer {
  nextTag: Int
}

func create() ret IdIssuer {
  ret IdIssuer { nextTag: 1 }
}

# Tag 0 means "no manager"; issued tags start at 1 and never repeat.
func issue(this: mod IdIssuer) ret Int {
  let tag: Int = this.nextTag
  this.nextTag = this.nextTag + 1
  ret tag
}

type BufferId {
  managerTag: Int
  slot: Int
  generation: Int
}

type TextureId {
  managerTag: Int
  slot: Int
  generation: Int
}

type TextureViewId {
  managerTag: Int
  slot: Int
  generation: Int
}

type SamplerId {
  managerTag: Int
  slot: Int
  generation: Int
}

# ----- slot tables -----------------------------------------------------

const kindBuffer: Int = 0
const kindTexture: Int = 1
const kindTextureView: Int = 2
const kindSampler: Int = 3
const kindPipeline: Int = 4
const kindBindGroup: Int = 5
const kindSubmission: Int = 6
const kindReadback: Int = 7
const kindRenderPipeline: Int = 8
# An adopted external handle: referenced (bound, attached, pinned) but NEVER
# owned or released by the manager — releaseHandle deliberately has no branch.
const kindExternal: Int = 9

# One table per kind. `generations`/`live` are the authoritative slot record;
# `handles` holds the native reference this manager owns. The lifetime fields:
# `useCount` in-flight uses, `retired` retired-but-pinned, `parentSlot`/
# `parentGeneration` an indirect dependency (a view's texture), `nativeIndex`
# a submission's wgpu index, `depStart`/`depCount` a slice of the manager's
# dependency arena (a bind group's bound resources, a submission's uses) and
# `completed` for submissions.
type SlotTable {
  generations: List(Int)
  live: List(Int)
  handles: List(Ptr)
  useCount: List(Int)
  retired: List(Int)
  parentSlot: List(Int)
  parentGeneration: List(Int)
  nativeIndex: List(Int)
  depStart: List(Int)
  depCount: List(Int)
  completed: List(Int)
}

func createIntList(capacity: view Int, value: view Int) ret List(Int) {
  let list: List(Int) = List.create(Int, cap: capacity)
  var i: Int = 0
  loop i < capacity {
    list.add(value: value)
    i = i + 1
  }
  ret list
}

func createSlotTable(capacity: view Int, empty: copy Ptr) ret SlotTable {
  let handles: List(Ptr) = List.create(Ptr, cap: capacity)
  var i: Int = 0
  loop i < capacity {
    unsafe { handles.add(value: empty) }
    i = i + 1
  }
  unsafe {
    ret SlotTable {
      generations: createIntList(capacity: capacity, value: 0)
      live: createIntList(capacity: capacity, value: 0)
      handles: own handles
      useCount: createIntList(capacity: capacity, value: 0)
      retired: createIntList(capacity: capacity, value: 0)
      parentSlot: createIntList(capacity: capacity, value: 0 - 1)
      parentGeneration: createIntList(capacity: capacity, value: 0)
      nativeIndex: createIntList(capacity: capacity, value: 0)
      depStart: createIntList(capacity: capacity, value: 0)
      depCount: createIntList(capacity: capacity, value: 0)
      completed: createIntList(capacity: capacity, value: 0)
    }
  }
}

func intAt(list: view List(Int), index: view Int) ret Int {
  if let value: Int = list.copyAt(index: index) { ret value }
  ret 0
}

# First slot that is neither live nor retired-and-pinned, or -1 (exhaustion).
# A retired slot still holding a pinned handle is not free. Nothing is marked
# here: a create marks the slot live only after the native allocation succeeded.
func findFreeSlot(table: view SlotTable, capacity: view Int) ret Int {
  var slot: Int = 0
  loop slot < capacity {
    if intAt(list: table.live, index: slot) is 0 and intAt(list: table.retired, index: slot) is 0 { ret slot }
    slot = slot + 1
  }
  ret 0 - 1
}

func slotIsLive(table: view SlotTable, capacity: view Int, slot: view Int, generation: view Int) ret Bool {
  if slot < 0 or slot >= capacity { ret false }
  if intAt(list: table.live, index: slot) is 0 { ret false }
  ret intAt(list: table.generations, index: slot) is generation
}

func slotGeneration(table: view SlotTable, slot: view Int) ret Int {
  ret intAt(list: table.generations, index: slot)
}

func liveCount(table: view SlotTable, capacity: view Int) ret Int {
  var count: Int = 0
  var slot: Int = 0
  loop slot < capacity {
    if intAt(list: table.live, index: slot) is 1 { count = count + 1 }
    slot = slot + 1
  }
  ret count
}

func pendingCount(table: view SlotTable, capacity: view Int) ret Int {
  var count: Int = 0
  var slot: Int = 0
  loop slot < capacity {
    if intAt(list: table.retired, index: slot) is 1 { count = count + 1 }
    slot = slot + 1
  }
  ret count
}

# Hands out the raw native handle of a slot: an unchecked pointer, so the
# caller takes the obligation (internal use, always inside unsafe blocks).
func slotHandle(table: view SlotTable, slot: view Int) unsafe ret Ptr {
  unsafe { ret rae_ext_rae_buf_get(V: Ptr, buf: table.handles.data, index: slot) }
}

func storeHandle(table: mod SlotTable, slot: view Int, handle: copy Ptr) {
  unsafe { rae_ext_rae_buf_set(V: Ptr, buf: table.handles.data, index: slot, value: handle) }
  table.live.set(index: slot, value: 1)
  table.retired.set(index: slot, value: 0)
  table.useCount.set(index: slot, value: 0)
  table.completed.set(index: slot, value: 0)
}

func releaseHandle(kind: view Int, handle: copy Ptr) {
  unsafe {
    if kind is kindBuffer { wgpuBufferRelease(buffer: handle) }
    if kind is kindTexture { wgpuTextureRelease(texture: handle) }
    if kind is kindTextureView { wgpuTextureViewRelease(textureView: handle) }
    if kind is kindSampler { wgpuSamplerRelease(sampler: handle) }
    if kind is kindPipeline { wgpuComputePipelineRelease(computePipeline: handle) }
    if kind is kindBindGroup { wgpuBindGroupRelease(bindGroup: handle) }
    if kind is kindRenderPipeline { wgpuRenderPipelineRelease(renderPipeline: handle) }
    if kind is kindReadback {
      let released: Ptr = releaseRead(request: handle)
    }
  }
}

# Releases the manager's native reference and frees the slot. A submission
# owns no native handle (its command buffer was released at submit).
func freeSlot(table: mod SlotTable, slot: view Int, kind: view Int, empty: copy Ptr) {
  unsafe {
    if kind is not kindSubmission {
      let handle: Ptr = slotHandle(table: table, slot: slot)
      if handle is not empty { releaseHandle(kind: kind, handle: handle) }
    }
    rae_ext_rae_buf_set(V: Ptr, buf: table.handles.data, index: slot, value: empty)
  }
  table.live.set(index: slot, value: 0)
  table.retired.set(index: slot, value: 0)
  table.useCount.set(index: slot, value: 0)
}

# Retire: bump the generation so no new use can be acquired, then release now
# if nothing is in flight, else keep the handle until the last use completes.
func retireSlot(table: mod SlotTable, slot: view Int, kind: view Int, empty: copy Ptr) {
  table.generations.set(index: slot, value: slotGeneration(table: table, slot: slot) + 1)
  table.live.set(index: slot, value: 0)
  if intAt(list: table.useCount, index: slot) is 0 {
    unsafe { freeSlot(table: table, slot: slot, kind: kind, empty: empty) }
  } else {
    table.retired.set(index: slot, value: 1)
  }
}

func pinSlot(table: mod SlotTable, slot: view Int) {
  table.useCount.set(index: slot, value: intAt(list: table.useCount, index: slot) + 1)
}

# Drops one use; a retired slot whose last use completed is released here.
func unpinSlot(table: mod SlotTable, slot: view Int, kind: view Int, empty: copy Ptr) {
  let remaining: Int = intAt(list: table.useCount, index: slot) - 1
  if remaining < 0 { ret }
  table.useCount.set(index: slot, value: remaining)
  if remaining is 0 and intAt(list: table.retired, index: slot) is 1 {
    unsafe { freeSlot(table: table, slot: slot, kind: kind, empty: empty) }
  }
}

# Manager shutdown: release every reference this manager still holds, live or
# retired-and-pinned. In-flight GPU work keeps its natives alive through wgpu's
# own submission tracking, and this is a Release, never a Destroy.
func releaseAll(table: mod SlotTable, capacity: view Int, kind: view Int, empty: copy Ptr) ret Int {
  var released: Int = 0
  var slot: Int = 0
  loop slot < capacity {
    if intAt(list: table.live, index: slot) is 1 or intAt(list: table.retired, index: slot) is 1 {
      unsafe { freeSlot(table: table, slot: slot, kind: kind, empty: empty) }
      released = released + 1
    }
    slot = slot + 1
  }
  ret released
}

# A power-of-two usage flag is tested with integer arithmetic (Rae has no
# bitwise operator): the flag's bit is set when (usage / flag) is odd.
func hasUsageFlag(usage: view UInt64, flag: view UInt64) ret Bool {
  let quotient: UInt64 = usage / flag
  ret (quotient - (quotient / 2) * 2) is (1 as UInt64)
}

# ----- the manager -----------------------------------------------------

# The dependency arena holds (kind, slot, generation) triples; a bind group's
# bound resources and a submission's uses are slices of it. It is append-only
# and bounded by the work the manager records between recreations.
type GpuResources {
  managerTag: Int
  capacity: Int
  buffers: SlotTable
  textures: SlotTable
  textureViews: SlotTable
  samplers: SlotTable
  pipelines: SlotTable
  bindGroups: SlotTable
  submissions: SlotTable
  readbacks: SlotTable
  renderPipelines: SlotTable
  externals: SlotTable
  depKinds: List(Int)
  depSlots: List(Int)
  depGenerations: List(Int)
}

# Fails (none) for a nonsensical capacity or when no device is available (the
# app bootstraps the context first).
func create(issuer: mod IdIssuer, capacity: view Int) ret opt GpuResources {
  if capacity < 1 { ret none }
  unsafe {
    let empty: Ptr = webgpuNull()
    if webgpuDevice() is empty { ret none }
    let buffers: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let textures: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let textureViews: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let samplers: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let pipelines: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let bindGroups: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let submissions: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let readbacks: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let renderPipelines: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let externals: SlotTable = createSlotTable(capacity: capacity, empty: empty)
    let tag: Int = issue(this: issuer)
    ret GpuResources {
      managerTag: tag
      capacity: capacity
      buffers: own buffers
      textures: own textures
      textureViews: own textureViews
      samplers: own samplers
      pipelines: own pipelines
      bindGroups: own bindGroups
      submissions: own submissions
      readbacks: own readbacks
      renderPipelines: own renderPipelines
      externals: own externals
      depKinds: List.create(Int, cap: 16)
      depSlots: List.create(Int, cap: 16)
      depGenerations: List.create(Int, cap: 16)
    }
  }
}

# Releases every native reference exactly once, dependents before what they
# reference: bind groups and pipelines, then views, textures, buffers and
# samplers. Submissions hold no native reference. Callback-owned state (a
# pending ReadRequest) is untouched — it owns its own references.
func drop(this: mod GpuResources) {
  unsafe {
    let empty: Ptr = webgpuNull()
    releaseAll(table: this.readbacks, capacity: this.capacity, kind: kindReadback, empty: empty)
    releaseAll(table: this.submissions, capacity: this.capacity, kind: kindSubmission, empty: empty)
    releaseAll(table: this.bindGroups, capacity: this.capacity, kind: kindBindGroup, empty: empty)
    releaseAll(table: this.pipelines, capacity: this.capacity, kind: kindPipeline, empty: empty)
    releaseAll(table: this.renderPipelines, capacity: this.capacity, kind: kindRenderPipeline, empty: empty)
    releaseAll(table: this.textureViews, capacity: this.capacity, kind: kindTextureView, empty: empty)
    releaseAll(table: this.textures, capacity: this.capacity, kind: kindTexture, empty: empty)
    releaseAll(table: this.buffers, capacity: this.capacity, kind: kindBuffer, empty: empty)
    releaseAll(table: this.samplers, capacity: this.capacity, kind: kindSampler, empty: empty)
    # Adopted externals: slots are cleared, the native handles are the adopter's.
    releaseAll(table: this.externals, capacity: this.capacity, kind: kindExternal, empty: empty)
  }
}

func tableFor(resources: view GpuResources, kind: view Int) ret view SlotTable {
  if kind is kindBuffer { ret resources.buffers }
  if kind is kindTexture { ret resources.textures }
  if kind is kindTextureView { ret resources.textureViews }
  if kind is kindSampler { ret resources.samplers }
  if kind is kindPipeline { ret resources.pipelines }
  if kind is kindBindGroup { ret resources.bindGroups }
  if kind is kindReadback { ret resources.readbacks }
  if kind is kindRenderPipeline { ret resources.renderPipelines }
  if kind is kindExternal { ret resources.externals }
  ret resources.submissions
}

func liveBufferCount(resources: view GpuResources) ret Int {
  ret liveCount(table: resources.buffers, capacity: resources.capacity)
}

func liveTextureCount(resources: view GpuResources) ret Int {
  ret liveCount(table: resources.textures, capacity: resources.capacity)
}

func liveTextureViewCount(resources: view GpuResources) ret Int {
  ret liveCount(table: resources.textureViews, capacity: resources.capacity)
}

func liveSamplerCount(resources: view GpuResources) ret Int {
  ret liveCount(table: resources.samplers, capacity: resources.capacity)
}

# Retired resources whose native release is deferred behind in-flight uses.
func pendingReleaseCount(resources: view GpuResources) ret Int {
  ret pendingCount(table: resources.buffers, capacity: resources.capacity)
    + pendingCount(table: resources.textures, capacity: resources.capacity)
    + pendingCount(table: resources.textureViews, capacity: resources.capacity)
    + pendingCount(table: resources.samplers, capacity: resources.capacity)
    + pendingCount(table: resources.pipelines, capacity: resources.capacity)
    + pendingCount(table: resources.bindGroups, capacity: resources.capacity)
}

# ----- validation ------------------------------------------------------

func isValidBuffer(resources: view GpuResources, id: view BufferId) ret Bool {
  if id.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: resources.buffers, capacity: resources.capacity, slot: id.slot, generation: id.generation)
}

func isValidTexture(resources: view GpuResources, id: view TextureId) ret Bool {
  if id.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: resources.textures, capacity: resources.capacity, slot: id.slot, generation: id.generation)
}

func isValidTextureView(resources: view GpuResources, id: view TextureViewId) ret Bool {
  if id.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: resources.textureViews, capacity: resources.capacity, slot: id.slot, generation: id.generation)
}

func isValidSampler(resources: view GpuResources, id: view SamplerId) ret Bool {
  if id.managerTag is not resources.managerTag { ret false }
  ret slotIsLive(table: resources.samplers, capacity: resources.capacity, slot: id.slot, generation: id.generation)
}

# ----- buffers ---------------------------------------------------------

# none on an invalid descriptor (size < 1, no usage), exhaustion (no free
# slot) or a failed native allocation. The slot is consumed only on success.
func createBuffer(resources: mod GpuResources, size: view Int, usage: view UInt64) ret opt BufferId {
  if size < 1 { ret none }
  if usage is (0 as UInt64) { ret none }
  let slot: Int = findFreeSlot(table: resources.buffers, capacity: resources.capacity)
  if slot < 0 { ret none }
  unsafe {
    let descriptor: WGPUBufferDescriptor = { size: size as UInt64, usage: usage }
    let handle: Ptr = wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: descriptor)
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.buffers, slot: slot, handle: handle)
  }
  ret BufferId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.buffers, slot: slot) }
}

# The authoritative size, re-queried from the native buffer. -1 for an invalid ID.
func bufferSize(resources: view GpuResources, id: view BufferId) ret Int {
  if isValidBuffer(resources: resources, id: id) is false { ret 0 - 1 }
  unsafe { ret wgpuBufferGetSize(buffer: slotHandle(table: resources.buffers, slot: id.slot)) as Int }
}

func bufferUsage(resources: view GpuResources, id: view BufferId) ret UInt64 {
  if isValidBuffer(resources: resources, id: id) is false { ret 0 as UInt64 }
  unsafe { ret wgpuBufferGetUsage(buffer: slotHandle(table: resources.buffers, slot: id.slot)) }
}

# Overflow-safe containment of [offset, offset + size) in the authoritative
# native size: both bounds are checked in unsigned space, so no sum can wrap.
func bufferRangeIsValid(resources: view GpuResources, id: view BufferId, offset: view Int, size: view Int) ret Bool {
  if isValidBuffer(resources: resources, id: id) is false { ret false }
  if offset < 0 or size < 0 { ret false }
  let nativeSize: UInt64 = bufferSize(resources: resources, id: id) as UInt64
  let offsetBytes: UInt64 = offset as UInt64
  if offsetBytes > nativeSize { ret false }
  ret (size as UInt64) <= nativeSize - offsetBytes
}

# Copies `bytes` into the buffer through the queue, which consumes the data
# synchronously, so the List is only borrowed for the call. Requires CopyDst
# usage on the NATIVE buffer and the 4-byte alignment WebGPU demands. wgpu only
# stages a queue write until the next submit, and a readback maps the source
# buffer directly (no copy, no submit), so the write is flushed here with an
# empty submit: after `writeBuffer` returns, the bytes are durable for any later
# map or copy. Uses the generated binding, not a renderer C helper.
func writeBuffer(resources: view GpuResources, id: view BufferId, offset: view Int, bytes: view List(UInt8)) ret Bool {
  if bytes.length < 0 or bytes.cap < bytes.length { ret false }
  if bufferRangeIsValid(resources: resources, id: id, offset: offset, size: bytes.length) is false { ret false }
  if offset - (offset / 4) * 4 is not 0 { ret false }
  if bytes.length - (bytes.length / 4) * 4 is not 0 { ret false }
  if hasUsageFlag(usage: bufferUsage(resources: resources, id: id), flag: WGPUBufferUsage_CopyDst) is false { ret false }
  unsafe {
    wgpuQueueWriteBuffer(
      queue: webgpuQueue()
      buffer: slotHandle(table: resources.buffers, slot: id.slot)
      bufferOffset: offset as UInt64
      data: bytes.data
      size: bytes.length as UInt64
    )
    wgpuQueueSubmit(queue: webgpuQueue(), commandCount: 0 as UInt64, commands: webgpuNull())
  }
  ret true
}

# Starts a readback of a validated range. The request retains its own native
# reference to the buffer, so retiring the buffer while a read is pending is
# safe at the native level; #871 gives this a manager-owned ReadbackId.
func readBuffer(resources: view GpuResources, id: view BufferId, offset: view Int, size: view Int) ret opt ReadRequest {
  if bufferRangeIsValid(resources: resources, id: id, offset: offset, size: size) is false { ret none }
  if hasUsageFlag(usage: bufferUsage(resources: resources, id: id), flag: WGPUBufferUsage_MapRead) is false { ret none }
  unsafe {
    ret ReadRequest.create(
      buffer: slotHandle(table: resources.buffers, slot: id.slot)
      range: { offset: offset as UInt64, size: size as UInt64 }
    )
  }
}

func retireBuffer(resources: mod GpuResources, id: view BufferId) ret Bool {
  if isValidBuffer(resources: resources, id: id) is false { ret false }
  unsafe { retireSlot(table: resources.buffers, slot: id.slot, kind: kindBuffer, empty: webgpuNull()) }
  ret true
}

# ----- textures, views, samplers ---------------------------------------

func createTexture(resources: mod GpuResources, width: view Int, height: view Int, format: view Int32, usage: view UInt64) ret opt TextureId {
  if width < 1 or height < 1 { ret none }
  if usage is (0 as UInt64) { ret none }
  let slot: Int = findFreeSlot(table: resources.textures, capacity: resources.capacity)
  if slot < 0 { ret none }
  unsafe {
    let descriptor: WGPUTextureDescriptor = {
      usage: usage
      dimension: WGPUTextureDimension_2D
      size: { width: width as UInt32, height: height as UInt32, depthOrArrayLayers: 1 as UInt32 }
      format: format
      mipLevelCount: 1 as UInt32
      sampleCount: 1 as UInt32
    }
    let handle: Ptr = wgpuDeviceCreateTexture(device: webgpuDevice(), descriptor: descriptor)
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.textures, slot: slot, handle: handle)
  }
  ret TextureId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.textures, slot: slot) }
}

func textureWidth(resources: view GpuResources, id: view TextureId) ret Int {
  if isValidTexture(resources: resources, id: id) is false { ret 0 - 1 }
  unsafe { ret wgpuTextureGetWidth(texture: slotHandle(table: resources.textures, slot: id.slot)) as Int }
}

func textureHeight(resources: view GpuResources, id: view TextureId) ret Int {
  if isValidTexture(resources: resources, id: id) is false { ret 0 - 1 }
  unsafe { ret wgpuTextureGetHeight(texture: slotHandle(table: resources.textures, slot: id.slot)) as Int }
}

func retireTexture(resources: mod GpuResources, id: view TextureId) ret Bool {
  if isValidTexture(resources: resources, id: id) is false { ret false }
  unsafe { retireSlot(table: resources.textures, slot: id.slot, kind: kindTexture, empty: webgpuNull()) }
  ret true
}

# A default 2D view over the whole texture; the format is the texture's own,
# read from the native object. The view records its texture as its indirect
# dependency and keeps its own native reference to it.
func createTextureView(resources: mod GpuResources, texture: view TextureId) ret opt TextureViewId {
  if isValidTexture(resources: resources, id: texture) is false { ret none }
  let slot: Int = findFreeSlot(table: resources.textureViews, capacity: resources.capacity)
  if slot < 0 { ret none }
  unsafe {
    let textureHandle: Ptr = slotHandle(table: resources.textures, slot: texture.slot)
    let descriptor: WGPUTextureViewDescriptor = {
      format: wgpuTextureGetFormat(texture: textureHandle)
      dimension: WGPUTextureViewDimension_2D
      baseMipLevel: 0 as UInt32
      mipLevelCount: 1 as UInt32
      baseArrayLayer: 0 as UInt32
      arrayLayerCount: 1 as UInt32
      aspect: WGPUTextureAspect_All
    }
    let handle: Ptr = wgpuTextureCreateView(texture: textureHandle, descriptor: descriptor)
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.textureViews, slot: slot, handle: handle)
  }
  resources.textureViews.parentSlot.set(index: slot, value: texture.slot)
  resources.textureViews.parentGeneration.set(index: slot, value: texture.generation)
  ret TextureViewId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.textureViews, slot: slot) }
}

func retireTextureView(resources: mod GpuResources, id: view TextureViewId) ret Bool {
  if isValidTextureView(resources: resources, id: id) is false { ret false }
  unsafe { retireSlot(table: resources.textureViews, slot: id.slot, kind: kindTextureView, empty: webgpuNull()) }
  ret true
}

# A default clamp-to-edge, linear sampler.
func createSampler(resources: mod GpuResources) ret opt SamplerId {
  let slot: Int = findFreeSlot(table: resources.samplers, capacity: resources.capacity)
  if slot < 0 { ret none }
  unsafe {
    let descriptor: WGPUSamplerDescriptor = {
      addressModeU: WGPUAddressMode_ClampToEdge
      addressModeV: WGPUAddressMode_ClampToEdge
      addressModeW: WGPUAddressMode_ClampToEdge
      magFilter: WGPUFilterMode_Linear
      minFilter: WGPUFilterMode_Linear
      mipmapFilter: WGPUMipmapFilterMode_Nearest
      lodMinClamp: 0.0
      lodMaxClamp: 32.0
      compare: WGPUCompareFunction_Undefined
      maxAnisotropy: 1 as UInt16
    }
    let handle: Ptr = wgpuDeviceCreateSampler(device: webgpuDevice(), descriptor: descriptor)
    if handle is webgpuNull() { ret none }
    storeHandle(table: resources.samplers, slot: slot, handle: handle)
  }
  ret SamplerId { managerTag: resources.managerTag, slot: slot, generation: slotGeneration(table: resources.samplers, slot: slot) }
}

func retireSampler(resources: mod GpuResources, id: view SamplerId) ret Bool {
  if isValidSampler(resources: resources, id: id) is false { ret false }
  unsafe { retireSlot(table: resources.samplers, slot: id.slot, kind: kindSampler, empty: webgpuNull()) }
  ret true
}
