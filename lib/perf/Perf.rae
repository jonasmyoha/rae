# perf/Perf — the event recorder (docs/perf-tools-design.md §3). Every thread that is measured
# writes small fixed-size events (a zone's begin and end, a counter's value, a mark) into a ring
# of its own; once a frame the main thread drains every ring into the hub's window, which keeps
# the last seconds of events in memory allocated once, with an index of the frames.
#
# The PerfHub is a resource on the App (no globals). A thread is handed its PerfRing, a value
# made at setup on the main thread (perfThreadRing) and passed to the thread like any other
# argument. Names are registered at setup too (perfName) and passed as ids: registering one
# allocates, so doing it in real-time code is the compile error it already is.
#
#     var perf: PerfHub = createPerfHub(settings: defaultPerfSettings())
#     let physicsZone: PerfName = perf.perfName(name: "physics")
#     let mainRing: PerfRing = perf.perfThreadRing(name: "main")
#     ...
#     perfZoneBegin(ring: mainRing, name: physicsZone)      # realtime: no allocation, no lock
#     stepPhysics(...)
#     perfZoneEnd(ring: mainRing, name: physicsZone)
#     perf.perfFrame()                                        # once a frame, on the main thread
#
# A write is one relaxed load of the ring's `on` flag (and nothing more when recording is off),
# a nowNs and one push. A full ring drops the event and counts it; the writer never waits.
#
# The runtime's own work (§4.3) is recorded once a hub installs its runtime table
# (perfInstallRuntime): a zone per parallelLoop on its caller's lane and a zone per chunk on the
# lane of the pool worker that ran it, a task's run on the pool with a flow from its spawn, the
# waits of Task.get, a Task joined at its scope's end and taskScope, a Channel send or receive
# waiting for the channel, a contended runtime lock, and Signal waits and posts. The runtime's C
# (runtime_perf_hooks.c) knows only the calling thread's slot and passes an event code to
# perfRuntimeWrite; the rings and the names are here.
import Math
open Atomic
open collections/SpscRing

enum PerfKind {
  zoneBegin
  zoneEnd
  counter
  mark
  waitBegin
  waitEnd
  gpuSpan
  flow
}

# One event: 32 bytes, so a ring is a plain array (the two 8-byte fields first, so the three
# small ones pack after them with no padding between)
type PerfEvent {
  # nowNs(), the monotonic clock
  time: Int
  # a counter's value, a GPU span's end, a flow's id, a byte count
  value: Int
  kind: PerfKind
  # an id from the hub's name table
  nameId: Int32
  # a frame number, a node index, a chunk index
  extra: Int32
}

# A name, registered once (perfName); what a hot path passes
type PerfName {
  id: Int
}

# A thread's ring: handles only, so it is passed to its thread by value. The thread is its one
# writer; the hub's perfFrame on the main thread is its one reader.
type PerfRing {
  events: SpscRing(PerfEvent)
  on: Atomic(Bool)
  # events the full ring had no room for
  dropped: Atomic(Int)
  # its index in the hub
  index: Int
}

type PerfSettings {
  # how many seconds of events the window keeps
  windowSeconds: Int = 10
  # the window's room, in events (memory: 40 bytes each, allocated once)
  windowEvents: Int = 262144
  # each thread's ring, in events (drained once a frame)
  ringEvents: Int = 16384
  # the frames the index keeps
  frameRecords: Int = 4096
}

func defaultPerfSettings() ret PerfSettings {
  ret PerfSettings {}
}

# A frame in the window: its number, when it started and ended, and its events' range (the
# window's event numbers, counted from the first event ever kept)
type PerfFrameRecord {
  frame: Int
  startNs: Int
  endNs: Int
  firstEvent: Int
  endEvent: Int
}

type PerfHub {
  settings: PerfSettings
  recording: Bool
  names: List(String)
  rings: List(PerfRing)
  ringNames: List(String)
  # the window: a ring of events with the thread each came from; `written` counts every event
  # ever kept, so event n is at n % windowEvents while it is in the window
  window: List(PerfEvent)
  windowRing: List(Int)
  written: Int
  # the oldest event still in the window (by room and by age)
  oldest: Int
  frames: List(PerfFrameRecord)
  frameCount: Int
  frameStartNs: Int
  frameFirstEvent: Int
  # the table the runtime writes through, while installed (perfInstallRuntime)
  runtime: opt PerfRuntimeTable
}

# What the runtime's hooks write through: a ring per thread slot (0 the main thread, 1.. the pool's
# workers, then the slots named threads claim at run time; an unused slot is zero) and the name of
# each event code. Buffers, so the runtime holds
# their addresses.
type PerfRuntimeTable {
  rings: Buffer(PerfRing)
  names: Buffer(Int)
  # the hub's names while the table is installed (boxedNames)
  nameBox: Buffer(List(String))
  # the hub's ring of each named thread's slot (a `spawn thread`, an attached thread), and
  # whether its lane has the thread's name yet
  threadRings: List(Int)
  threadNamed: List(Bool)
}

func createPerfHub(settings: view PerfSettings) ret PerfHub {
  var window: List(PerfEvent) = List.create(PerfEvent, cap: settings.windowEvents)
  window.addDefaults(count: settings.windowEvents)
  var windowRing: List(Int) = List.create(Int, cap: settings.windowEvents)
  windowRing.addDefaults(count: settings.windowEvents)
  var frames: List(PerfFrameRecord) = List.create(PerfFrameRecord, cap: settings.frameRecords)
  frames.addDefaults(count: settings.frameRecords)
  ret PerfHub {
    settings: settings
    recording: true
    names: {}
    rings: {}
    ringNames: {}
    window: window
    windowRing: windowRing
    written: 0
    oldest: 0
    frames: frames
    frameCount: 0
    frameStartNs: nowNs()
    frameFirstEvent: 0
    runtime: none
  }
}

func freePerfHub(hub: mod PerfHub) {
  perfUninstallRuntime(hub: hub)
  loop let ring: PerfRing in hub.rings {
    ring.events.freeSpscRing()
    ring.on.freeAtomic()
    ring.dropped.freeAtomic()
  }
}

# A name's id (the same id for the same name); on the main thread, at setup
func perfName(hub: mod PerfHub, name: view String) ret PerfName {
  if let table: view PerfRuntimeTable = hub.runtime {
    ret PerfName { id: perfNameIdIn(names: boxedNames(box: table.nameBox), name: name) }
  }
  ret PerfName { id: perfNameIdIn(names: hub.names, name: name) }
}

func perfNameIdIn(names: mod List(String), name: view String) ret Int {
  loop var i: Int = 0, i < names.length(), ++i {
    if names.copyAtDefault(index: i) is name {
      ret i
    }
  }
  names.add(value: name)
  ret names.length() - 1
}

# The name of an id ("" for none)
func perfNameText(hub: view PerfHub, nameId: view Int) ret String {
  if let table: view PerfRuntimeTable = hub.runtime {
    ret boxedNames(box: table.nameBox).copyAtDefault(index: nameId)
  }
  ret hub.names.copyAtDefault(index: nameId)
}

# How many names the hub has
func perfNameCount(hub: view PerfHub) ret Int {
  if let table: view PerfRuntimeTable = hub.runtime {
    ret boxedNames(box: table.nameBox).length()
  }
  ret hub.names.length()
}

# The names while a runtime table is installed: in a box whose address the runtime holds, so code
# on the main thread with no hub can add one (perfRuntimeName)
func boxedNames(box: view Buffer(List(String))) ret mod List(String) {
  unsafe {
    ret mod rae_ext_rae_buf_get(buf: box, index: 0)
  }
}

# A ring for the thread called `name`; on the main thread, at setup, then handed to the thread
func perfThreadRing(hub: mod PerfHub, name: view String) ret PerfRing {
  let ring: PerfRing = {
    events: createSpscRing(PerfEvent, capacity: hub.settings.ringEvents)
    on: createAtomic(Bool, value: hub.recording)
    dropped: createAtomic(Int, value: 0)
    index: hub.rings.length()
  }
  hub.rings.add(value: ring)
  hub.ringNames.add(value: name)
  ret ring
}

# Recording on or off for every ring (a write while off is one load and a return)
func perfSetRecording(hub: mod PerfHub, on: view Bool) {
  hub.recording = on
  loop let ring: PerfRing in hub.rings {
    ring.on.store(value: on)
  }
}

# ---- the writes: realtime, any thread, to its own ring ---------------------------------
func perfWrite(
  ring: view PerfRing
  kind: view PerfKind
  name: view PerfName
  value: view Int
  extra: view Int
) realtime {
  if not ring.on.loadRelaxed() {
    ret
  }
  let event: PerfEvent = {
    time: nowNs()
    kind: kind
    nameId: name.id as Int32
    value: value
    extra: extra as Int32
  }
  if not ring.events.push(value: event) {
    let unusedDropped: Int = ring.dropped.fetchAddRelaxed(amount: 1)
  }
}

# An event at a time of its own (a GPU span: `time` its begin, `value` its end, both on nowNs's
# clock, perf/GpuClock)
func perfWriteAt(
  ring: view PerfRing
  kind: view PerfKind
  name: view PerfName
  time: view Int
  value: view Int
  extra: view Int
) realtime {
  if not ring.on.loadRelaxed() {
    ret
  }
  let event: PerfEvent = {
    time: time
    kind: kind
    nameId: name.id as Int32
    value: value
    extra: extra as Int32
  }
  if not ring.events.push(value: event) {
    let unusedDropped: Int = ring.dropped.fetchAddRelaxed(amount: 1)
  }
}

func perfZoneBegin(ring: view PerfRing, name: view PerfName) realtime {
  perfWrite(
    ring: ring
    kind: PerfKind.zoneBegin
    name: name
    value: 0
    extra: 0
  )
}

func perfZoneEnd(ring: view PerfRing, name: view PerfName) realtime {
  perfWrite(
    ring: ring
    kind: PerfKind.zoneEnd
    name: name
    value: 0
    extra: 0
  )
}

func perfCounter(ring: view PerfRing, name: view PerfName, value: view Int) realtime {
  perfWrite(
    ring: ring
    kind: PerfKind.counter
    name: name
    value: value
    extra: 0
  )
}

func perfMark(ring: view PerfRing, name: view PerfName, extra: view Int) realtime {
  perfWrite(
    ring: ring
    kind: PerfKind.mark
    name: name
    value: 0
    extra: extra
  )
}

# ---- the collector: the main thread, once a frame ----------------------------------------
func keepEvent(hub: mod PerfHub, event: view PerfEvent, ringIndex: view Int) {
  let at: Int = hub.written % hub.settings.windowEvents
  hub.window.set(index: at, value: event)
  hub.windowRing.set(index: at, value: ringIndex)
  hub.written = hub.written + 1
  if hub.written - hub.oldest > hub.settings.windowEvents {
    hub.oldest = hub.written - hub.settings.windowEvents
  }
}

# Every ring drained into the window, the frame's record kept, and the events older than the
# window's seconds let go
func perfFrame(hub: mod PerfHub) {
  loop var r: Int = 0, r < hub.rings.length(), ++r {
    let ring: PerfRing = hub.rings.copyAtDefault(index: r)
    loop ring.events.count() > 0 {
      if let event: PerfEvent = ring.events.pop() {
        hub.keepEvent(event: event, ringIndex: r)
      }
    }
  }
  let now: Int = nowNs()
  let record: PerfFrameRecord = {
    frame: hub.frameCount
    startNs: hub.frameStartNs
    endNs: now
    firstEvent: hub.frameFirstEvent
    endEvent: hub.written
  }
  hub.frames.set(index: hub.frameCount % hub.settings.frameRecords, value: record)
  hub.frameCount = hub.frameCount + 1
  hub.frameStartNs = now
  hub.frameFirstEvent = hub.written
  perfNameThreadLanes(hub: hub)
  # older than the window's seconds: let go
  let horizon: Int = now - hub.settings.windowSeconds * 1000000000
  loop hub.oldest < hub.written and hub.perfEventAt(number: hub.oldest).time < horizon {
    hub.oldest = hub.oldest + 1
  }
}

# ---- reading the window ---------------------------------------------------------------------

# The events in the window: numbers perfOldest .. perfWritten - 1
func perfOldest(hub: view PerfHub) ret Int {
  ret hub.oldest
}

func perfWritten(hub: view PerfHub) ret Int {
  ret hub.written
}

func perfEventAt(hub: view PerfHub, number: view Int) ret PerfEvent {
  ret hub.window.copyAtDefault(index: number % hub.settings.windowEvents)
}

# The thread (its ring's index) an event came from
func perfEventRing(hub: view PerfHub, number: view Int) ret Int {
  ret hub.windowRing.copyAtDefault(index: number % hub.settings.windowEvents)
}

# Frame `frame`'s record, while the index keeps it
func perfFrameRecord(hub: view PerfHub, frame: view Int) ret opt PerfFrameRecord {
  if frame < 0 or frame >= hub.frameCount or frame < hub.frameCount - hub.settings.frameRecords {
    ret none
  }
  ret hub.frames.copyAtDefault(index: frame % hub.settings.frameRecords)
}

# Every ring's dropped events so far
func perfDropped(hub: view PerfHub) ret Int {
  var total: Int = 0
  loop let ring: PerfRing in hub.rings {
    total = total + ring.dropped.load()
  }
  ret total
}

# ---- the runtime's work (§4.3) ------------------------------------------------------------------

# The runtime's event codes (runtime_perf_hooks.c), and their names
const perfRuntimeCodes: Int = 13

func perfRuntimeCodeName(code: view Int) ret String {
  if code is 0 {
    ret "parallelLoop"
  }
  if code is 1 {
    ret "chunk"
  }
  if code is 2 {
    ret "Task.get"
  }
  if code is 3 {
    ret "Task join"
  }
  if code is 4 {
    ret "taskScope"
  }
  if code is 5 {
    ret "task"
  }
  if code is 6 {
    ret "spawn"
  }
  if code is 7 {
    ret "Channel"
  }
  if code is 8 {
    ret "lock"
  }
  if code is 9 {
    ret "Signal wait"
  }
  if code is 10 {
    ret "Signal post"
  }
  if code is 11 {
    ret "command buffer"
  }
  ret "realtime rule break"
}

func nativePerfInstall(
  rings: Buffer(PerfRing)
  names: Buffer(Int)
  nameBox: Buffer(List(String))
) unsafe extern("rae_perf_install")

func nativePerfGeneration() unsafe extern("rae_perf_generation") ret Int

func nativePerfNameBox() unsafe extern("rae_perf_name_box") ret Buffer(List(String))

func nativePerfNameBoxReady() unsafe extern("rae_perf_name_box_ready") ret Bool

func nativePerfNamedEvent(
  kind: Int
  nameId: Int
  value: Int
  extra: Int
) unsafe extern("rae_perf_named_event")

func nativePerfUninstall(rings: Buffer(PerfRing)) unsafe extern("rae_perf_uninstall")

func nativePerfSlotCount() unsafe extern("rae_perf_slot_count") ret Int

func nativePerfWorkerCount() unsafe extern("rae_perf_worker_count") ret Int

func nativePerfThreadSlotFirst() unsafe extern("rae_perf_thread_slot_first") ret Int

func nativePerfThreadSlotCount() unsafe extern("rae_perf_thread_slot_count") ret Int

func nativePerfThreadName(index: Int) unsafe extern("rae_perf_thread_name") ret String

# Record the runtime's work into this hub: `mainRing` (this thread's) is slot 0, each worker of
# the pool gets a ring of its own, its lane named "worker <n>", and a few rings wait for named
# threads (a `spawn thread`, named by its function; a thread C attached), whose lanes perfFrame
# names when one claims them. On the main thread, at setup.
func perfInstallRuntime(hub: mod PerfHub, mainRing: view PerfRing) {
  perfUninstallRuntime(hub: hub)
  unsafe {
    let slots: Int = nativePerfSlotCount()
    var rings: Buffer(PerfRing) = rae_ext_rae_buf_alloc(size: slots, elemSize: sizeof(PerfRing))
    rae_ext_rae_buf_zero(
      buf: rings
      start: 0
      count: slots
      elemSize: sizeof(PerfRing)
    )
    rae_ext_rae_buf_set(buf: rings, index: 0, value: mainRing)
    let workers: Int = Math.min(a: nativePerfWorkerCount(), b: slots)
    loop var worker: Int = 1, worker < workers, ++worker {
      let ring: PerfRing = hub.perfThreadRing(name: "worker {worker}")
      rae_ext_rae_buf_set(buf: rings, index: worker, value: ring)
    }
    var threadRings: List(Int) = {}
    var threadNamed: List(Bool) = {}
    let firstThreadSlot: Int = nativePerfThreadSlotFirst()
    loop var thread: Int = 0, thread < nativePerfThreadSlotCount(), ++thread {
      if firstThreadSlot + thread < slots {
        let ring: PerfRing = hub.perfThreadRing(name: "thread {thread + 1}")
        rae_ext_rae_buf_set(buf: rings, index: firstThreadSlot + thread, value: ring)
        threadRings.add(value: ring.index)
        threadNamed.add(value: false)
      }
    }
    var names: Buffer(Int) = rae_ext_rae_buf_alloc(size: perfRuntimeCodes, elemSize: sizeof(Int))
    loop var code: Int = 0, code < perfRuntimeCodes, ++code {
      let name: PerfName = hub.perfName(name: perfRuntimeCodeName(code: code))
      rae_ext_rae_buf_set(buf: names, index: code, value: name.id)
    }
    # the names move into a box the runtime holds while the table is installed
    var boxed: List(String) = {}
    loop let name: String in hub.names {
      boxed.add(value: name)
    }
    var nameBox: Buffer(List(String)) = rae_ext_rae_buf_alloc(
      size: 1
      elemSize: sizeof(List(String))
    )
    rae_ext_rae_buf_set(buf: nameBox, index: 0, value: own boxed)
    hub.runtime = PerfRuntimeTable {
      rings: rings
      names: names
      nameBox: nameBox
      threadRings: threadRings
      threadNamed: threadNamed
    }
    nativePerfInstall(rings: rings, names: names, nameBox: nameBox)
  }
}

# The lanes of the named threads that claimed a slot since the last frame get their names
func perfNameThreadLanes(hub: mod PerfHub) {
  if let table: mod PerfRuntimeTable = hub.runtime {
    loop var thread: Int = 0, thread < table.threadRings.length, ++thread {
      if not table.threadNamed.copyAtDefault(index: thread) {
        unsafe {
          let name: String = nativePerfThreadName(index: thread)
          if name.length() > 0 {
            hub.ringNames.set(index: table.threadRings.copyAtDefault(index: thread), value: name)
            table.threadNamed.set(index: thread, value: true)
          }
        }
      }
    }
  }
}

# The runtime records into this hub no more (its rings stay until freePerfHub)
func perfUninstallRuntime(hub: mod PerfHub) {
  var names: List(String) = {}
  if let table: view PerfRuntimeTable = hub.runtime {
    unsafe {
      nativePerfUninstall(rings: table.rings)
      rae_ext_rae_buf_free(buf: table.rings)
      rae_ext_rae_buf_free(buf: table.names)
      # the names back from the box (this local owns them, so the box's list is freed with it)
      let boxed: List(String) = rae_ext_rae_buf_get(buf: table.nameBox, index: 0)
      loop let name: String in boxed {
        names.add(value: name)
      }
      rae_ext_rae_buf_free(buf: table.nameBox)
    }
  }
  if hub.runtime is not none {
    hub.names = names
  }
  hub.runtime = none
}

# A kind as the runtime's code (perfKindOfCode's inverse)
func perfKindCode(kind: view PerfKind) ret Int {
  if kind is PerfKind.zoneBegin {
    ret 0
  }
  if kind is PerfKind.zoneEnd {
    ret 1
  }
  if kind is PerfKind.counter {
    ret 2
  }
  if kind is PerfKind.mark {
    ret 3
  }
  if kind is PerfKind.waitBegin {
    ret 4
  }
  if kind is PerfKind.waitEnd {
    ret 5
  }
  if kind is PerfKind.gpuSpan {
    ret 6
  }
  ret 7
}

func perfKindOfCode(kind: view Int) realtime ret PerfKind {
  if kind is 0 {
    ret PerfKind.zoneBegin
  }
  if kind is 1 {
    ret PerfKind.zoneEnd
  }
  if kind is 2 {
    ret PerfKind.counter
  }
  if kind is 3 {
    ret PerfKind.mark
  }
  if kind is 4 {
    ret PerfKind.waitBegin
  }
  if kind is 5 {
    ret PerfKind.waitEnd
  }
  if kind is 6 {
    ret PerfKind.gpuSpan
  }
  ret PerfKind.flow
}

# The runtime's hook (runtime_perf_hooks.c rae_perf_event): an event of the thread in `slot`, on
# that thread
func perfRuntimeWrite(
  rings: copy Buffer(PerfRing)
  names: copy Buffer(Int)
  slot: copy Int
  kind: copy Int
  code: copy Int
  value: copy Int
  extra: copy Int
) realtime cExport("rae_perf_runtime_write") {
  unsafe {
    let ring: PerfRing = rae_ext_rae_buf_get(buf: rings, index: slot)
    if ring.events.capacity is 0 {
      ret
    }
    # a code below 0 carries a name id itself (rae_perf_named_event)
    var nameId: Int = -1 - code
    if code >= 0 {
      nameId = rae_ext_rae_buf_get(buf: names, index: code)
    }
    perfWrite(
      ring: ring
      kind: perfKindOfCode(kind: kind)
      name: PerfName { id: nameId }
      value: value
      extra: extra
    )
  }
}

# ---- events from code that has no hub (lib/ecs's schedule) ---------------------------------------

# The installed table's generation, 0 when none is installed: a cached name id (perfRuntimeName) is
# good while this has not moved
func perfRuntimeGeneration() ret Int {
  unsafe {
    ret nativePerfGeneration()
  }
}

# A name's id in the installed hub, from code with no hub; -1 when nothing records or this is not
# the thread that installed it (registering a name allocates)
func perfRuntimeName(name: view String) ret Int {
  unsafe {
    if not nativePerfNameBoxReady() {
      ret -1
    }
    ret perfNameIdIn(names: boxedNames(box: nativePerfNameBox()), name: name)
  }
}

# An event named by a perfRuntimeName id on this thread's lane in the installed hub (nothing when
# none is installed or this thread has no lane)
func perfRuntimeNamedEvent(
  kind: view PerfKind
  nameId: view Int
  value: view Int
  extra: view Int
) {
  if nameId < 0 {
    ret
  }
  unsafe {
    nativePerfNamedEvent(
      kind: perfKindCode(kind: kind)
      nameId: nameId
      value: value
      extra: extra
    )
  }
}

# The runtime's hook for an event at a time of its own (runtime_perf_hooks.c rae_perf_span: a Metal
# command buffer's GPU time, `time` its begin and `value` its end on nowNs's clock)
func perfRuntimeWriteAt(
  rings: copy Buffer(PerfRing)
  names: copy Buffer(Int)
  slot: copy Int
  kind: copy Int
  code: copy Int
  time: copy Int
  value: copy Int
  extra: copy Int
) realtime cExport("rae_perf_runtime_write_at") {
  unsafe {
    let ring: PerfRing = rae_ext_rae_buf_get(buf: rings, index: slot)
    if ring.events.capacity is 0 {
      ret
    }
    var nameId: Int = -1 - code
    if code >= 0 {
      nameId = rae_ext_rae_buf_get(buf: names, index: code)
    }
    perfWriteAt(
      ring: ring
      kind: perfKindOfCode(kind: kind)
      name: PerfName { id: nameId }
      time: time
      value: value
      extra: extra
    )
  }
}
