# math3d — 4x4 matrices + small vector helpers for the gpu3d renderer.
#
# A matrix is a List(Float) of 16 values, COLUMN-MAJOR (WGSL mat4x4
# layout): element (row r, column c) lives at index c*4 + r. All
# constructors return fresh owned lists; mat4Mul composes so that
# `mat4Mul(a: A, b: B)` applies B first, then A (A*B, like math).
#
# WORLD CONVENTION: right-handed, **Z-up**, matching Blender — +X right,
# +Y forward (into the scene), +Z up. This is the project-wide mandate in
# `docs/coordinate-system.md` ("New 3D code MUST use Z-up Blender
# conventions"), NOT the graphics-default Y-up. Yaw rotates about +Z,
# pitch about +X. Cameras are specified as position + target + worldUp
# (+Z) and the basis is derived exactly as that doc prescribes.
#
# Only the PROJECTION knows about the graphics API: it maps the Z-up
# right-handed view space into WebGPU clip space (z in [0, 1]). The
# host API's up-axis preference never leaks into Rae world space.
import core
import math
open vec3

func mat4Identity() pub ret List(Float) {
  let m: List(Float) = createList(Float, cap: 16)
  var i: Int = 0
  loop i < 16 {
    m.add(value: 0.0)
    i = i + 1
  }
  m.set(index: 0, value: 1.0)
  m.set(index: 5, value: 1.0)
  m.set(index: 10, value: 1.0)
  m.set(index: 15, value: 1.0)
  ret m
}

func mat4Get(m: view List(Float), i: view Int) ret Float {
  ret rae_ext_rae_buf_get(buf: m.data, index: i)
}

# out = a * b (apply b first, then a).
func mat4Mul(a: view List(Float), b: view List(Float)) pub ret List(Float) {
  let out: List(Float) = createList(Float, cap: 16)
  var c: Int = 0
  loop c < 4 {
    var r: Int = 0
    loop r < 4 {
      var sum: Float = 0.0
      var k: Int = 0
      loop k < 4 {
        sum = sum + mat4Get(m: a, i: k * 4 + r) * mat4Get(m: b, i: c * 4 + k)
        k = k + 1
      }
      out.add(value: sum)
      r = r + 1
    }
    c = c + 1
  }
  ret out
}

func mat4Translate(x: view Float, y: view Float, z: view Float) pub ret List(Float) {
  let m: List(Float) = mat4Identity()
  m.set(index: 12, value: x)
  m.set(index: 13, value: y)
  m.set(index: 14, value: z)
  ret m
}

func mat4Scale(s: view Float) pub ret List(Float) {
  let m: List(Float) = mat4Identity()
  m.set(index: 0, value: s)
  m.set(index: 5, value: s)
  m.set(index: 10, value: s)
  ret m
}

# Non-uniform scale. NOTE: gpu3d transforms normals by the model matrix
# directly, so a non-uniform scale skews lighting — see the inverse-
# transpose normal-matrix follow-up before relying on this for shaded
# geometry.
func mat4ScaleXYZ(x: view Float, y: view Float, z: view Float) pub ret List(Float) {
  let m: List(Float) = mat4Identity()
  m.set(index: 0, value: x)
  m.set(index: 5, value: y)
  m.set(index: 10, value: z)
  ret m
}

func mat4RotateX(angle: view Float) pub ret List(Float) {
  let m: List(Float) = mat4Identity()
  let c: Float = math.cos(x: angle)
  let s: Float = math.sin(x: angle)
  m.set(index: 5, value: c)
  m.set(index: 6, value: s)
  m.set(index: 9, value: 0.0 - s)
  m.set(index: 10, value: c)
  ret m
}

func mat4RotateY(angle: view Float) pub ret List(Float) {
  let m: List(Float) = mat4Identity()
  let c: Float = math.cos(x: angle)
  let s: Float = math.sin(x: angle)
  m.set(index: 0, value: c)
  m.set(index: 2, value: 0.0 - s)
  m.set(index: 8, value: s)
  m.set(index: 10, value: c)
  ret m
}

func mat4RotateZ(angle: view Float) pub ret List(Float) {
  let m: List(Float) = mat4Identity()
  let c: Float = math.cos(x: angle)
  let s: Float = math.sin(x: angle)
  m.set(index: 0, value: c)
  m.set(index: 1, value: s)
  m.set(index: 4, value: 0.0 - s)
  m.set(index: 5, value: c)
  ret m
}

# Right-handed perspective, WebGPU depth range [0,1].
func mat4Perspective(fovYDeg: view Float, aspect: view Float, near: view Float, far: view Float) pub ret List(Float) {
  let m: List(Float) = createList(Float, cap: 16)
  var i: Int = 0
  loop i < 16 {
    m.add(value: 0.0)
    i = i + 1
  }
  let f: Float = 1.0 / math.tan(x: fovYDeg * 0.008726646259971648)  # deg->rad, /2
  m.set(index: 0, value: f / aspect)
  m.set(index: 5, value: f)
  m.set(index: 10, value: far / (near - far))
  m.set(index: 11, value: 0.0 - 1.0)
  m.set(index: 14, value: far * near / (near - far))
  ret m
}

# Right-handed Z-up look-at view matrix (docs/coordinate-system.md §Camera):
#   forward = normalize(target - position)
#   right   = normalize(cross(forward, worldUp))
#   up      = cross(right, forward)
# Pass worldUp = (0, 0, 1) for the standard Blender convention. A degenerate
# look (forward parallel to worldUp) falls back to an alternate up reference
# so the basis stays finite, as the doc requires.
#
# View space keeps the camera looking down its own -Z (what the WebGPU
# projection below expects), so the third basis row is -forward.
func mat4LookAt(eyeX: view Float, eyeY: view Float, eyeZ: view Float, atX: view Float, atY: view Float, atZ: view Float, upX: view Float, upY: view Float, upZ: view Float) pub ret List(Float) {
  # forward = normalize(target - eye) — the direction the camera looks.
  var fx: Float = atX - eyeX
  var fy: Float = atY - eyeY
  var fz: Float = atZ - eyeZ
  let flen: Float = math.sqrt(x: fx * fx + fy * fy + fz * fz)
  fx = fx / flen
  fy = fy / flen
  fz = fz / flen
  # right = normalize(cross(forward, worldUp))
  var rx: Float = fy * upZ - fz * upY
  var ry: Float = fz * upX - fx * upZ
  var rz: Float = fx * upY - fy * upX
  var rlen: Float = math.sqrt(x: rx * rx + ry * ry + rz * rz)
  if rlen < 0.000001 {
    # Degenerate: looking straight along worldUp. Use +Y as the alternate
    # up reference (Blender front-view fallback) and rebuild `right`.
    rx = fy * 0.0 - fz * 1.0
    ry = fz * 0.0 - fx * 0.0
    rz = fx * 1.0 - fy * 0.0
    rlen = math.sqrt(x: rx * rx + ry * ry + rz * rz)
  }
  rx = rx / rlen
  ry = ry / rlen
  rz = rz / rlen
  # up = cross(right, forward)
  let ux: Float = ry * fz - rz * fy
  let uy: Float = rz * fx - rx * fz
  let uz: Float = rx * fy - ry * fx
  let m: List(Float) = createList(Float, cap: 16)
  m.add(value: rx)
  m.add(value: ux)
  m.add(value: 0.0 - fx)
  m.add(value: 0.0)
  m.add(value: ry)
  m.add(value: uy)
  m.add(value: 0.0 - fy)
  m.add(value: 0.0)
  m.add(value: rz)
  m.add(value: uz)
  m.add(value: 0.0 - fz)
  m.add(value: 0.0)
  m.add(value: 0.0 - (rx * eyeX + ry * eyeY + rz * eyeZ))
  m.add(value: 0.0 - (ux * eyeX + uy * eyeY + uz * eyeZ))
  m.add(value: fx * eyeX + fy * eyeY + fz * eyeZ)
  m.add(value: 1.0)
  ret m
}

# Z-up orbit camera position from yaw/pitch/distance around a target.
# Yaw is about +Z (0 puts the camera on -Y, Blender front view); positive
# pitch raises the camera toward +Z.
func orbitEye(targetX: view Float, targetY: view Float, targetZ: view Float, yaw: view Float, pitch: view Float, dist: view Float) pub ret Vec3 {
  let cp: Float = math.cos(x: pitch)
  ret vec3.create(
    x: targetX + dist * cp * math.sin(x: yaw),
    y: targetY - dist * cp * math.cos(x: yaw),
    z: targetZ + dist * math.sin(x: pitch)
  )
}
