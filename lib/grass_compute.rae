# GPU grass generation (grass epic #486) — Rae over the WebGPU bindings.
#
# A frame-integrated COMPUTE pass writes one DrawU record per blade into a
# storage buffer entirely on the GPU: a grid of blades around the player,
# hash-jittered, dropped onto the terrain via the SAME analytic height field as
# the CPU terrain mesh, swayed by the wind model. No CPU per-blade work and no
# readback (unlike lib/gpu.rae's blocking compute). The instanced grass draw then
# binds that buffer and reads draws[instance_index] on the existing static
# G-buffer pipeline — so no new pipeline or shader is needed for the draw.
#
# The compute pass runs in its OWN command encoder, submitted before the geometry
# pass each frame (the geometry pass's render encoder is already mid-render-pass
# when Rae sees it, so a compute pass cannot share it). The GPU orders the
# compute submit before the later G-buffer submit, so the draw reads fresh data.
#
# The WGSL lives in C (rae_gb_grass_wgsl, like the other renderer shaders);
# everything else — buffers, pipeline, bind groups, dispatch, draw — is Rae.
import core
open webgpu/webgpu
import webgpu/context
open webgpu/context
import profile
import grass_config
import gbuffer
import string
import world_biome

# C shader-source accessors (WGSL text + entry point names).
func grassWgsl() extern("rae_gb_grass_wgsl") ret Ptr
func grassRenderWgsl() extern("rae_gb_grass_render_wgsl") ret Ptr
func grassEntry() extern("rae_gb_grass_entry") ret Ptr
func gbEntryVs() extern("rae_gb_entry_vs") ret Ptr
func gbEntryFs() extern("rae_gb_entry_fs") ret Ptr

# Reused gbuffer ABI-seam accessors (the same C symbols gbuffer.rae binds).
func gbStaticPipeline() extern("rae_gb_static_pipeline") ret Ptr
func gbStaticBind() extern("rae_gb_static_bind") ret Ptr
func gbFrameUbuf() extern("rae_gb_frame_ubuf") ret Ptr
func gbFrameBytes() extern("rae_gb_frame_bytes") ret Int
func gbPass() extern("rae_gb_pass") ret Ptr
func gbSubmit(cmd: Ptr) extern("rae_gb_submit")
func gbMeshReady(mesh: Int) extern("rae_gb_mesh_ready") ret Int
func gbMeshVbuf(mesh: Int) extern("rae_gb_mesh_vbuf") ret Ptr
func gbMeshIbuf(mesh: Int) extern("rae_gb_mesh_ibuf") ret Ptr
func gbMeshIcount(mesh: Int) extern("rae_gb_mesh_icount") ret Int

# Handle store (Rae has no module-level Ptr var; keep them in C like the rest of
# the renderer). Slots: 0=compute pipeline, 1=instance buffer, 2=uniform buffer,
# 3=compute bind group, 4=draw bind group, 5=grass render pipeline,
# 6=indirect draw-args buffer.
func grassSet(index: Int, ptr: Ptr) extern("rae_gb_grass_set")
func grassGet(index: Int) extern("rae_gb_grass_get") ret Ptr

# Blade count MUST be a perfect square: the compute grid is side x side, and the
# shader derives side = sqrt(count). 256 x 256 = 65536 candidate blades; GPU
# culling keeps only the visible subset (indirect draw).
const grassGpuBladeCount: Int = 65536
const grassRecordBytes: Int = 160    # 40 floats per DrawU
const grassUniformBytes: Int = 112   # seven vec4 (GrassU: player/time, count/extent, cam, forward, ground, wind, blade)
const grassIndirectBytes: Int = 16   # 4 u32 DrawIndirect args (vertexCount, instanceCount, ...)
# Vertices per procedural blade: a tapered quad = two triangles (see bladeLocal
# in the render WGSL). No mesh, no vertex/index buffer.
const grassBladeVerts: Int = 6

var gGrassMade: Bool = false
var gGrassDrawBindMade: Bool = false

# Compute-pass source: the shared noise + biome field, then the grass pass
# itself. Mirrors how the terrain splat pipeline composes its shader.
func grassComputeWgsl() ret String {
  let islandSrc: String = world_biome.islandParamsWgsl()
  let noiseSrc: String = gbuffer.gbReadWgsl(path: "lib/noise.wgsl")
  let biomeSrc: String = gbuffer.gbReadWgsl(path: "lib/world_biome.wgsl")
  let grassSrc: String = gbuffer.gbReadWgsl(path: "lib/grass_compute.wgsl")
  ret islandSrc.concat(other: noiseSrc).concat(other: "\n").concat(other: biomeSrc)
    .concat(other: "\n").concat(other: grassSrc)
}

# Force a grass-pipeline rebuild on the next frame — the island radius is baked into
# the composed compute shader, so growing the island (#41) must recompose it.
func resetGrassPipeline() pub {
  gGrassMade = false
  # The draw bind group is auto-layouted from the OLD render pipeline; invalidate it
  # so it rebuilds against the recomposed pipeline (#41 grow).
  gGrassDrawBindMade = false
}

# WGSL text -> shader module (same construction as gbuffer.makeShaderModule; the
# one-element List holds the chained WGPUShaderSourceWGSL for nextInChain).
func grassMakeShaderModule(wgsl: copy Ptr) ret Ptr {
  var srcList: List(WGPUShaderSourceWGSL) = createList(WGPUShaderSourceWGSL, cap: 1)
  srcList.add(value: {
    chain: { sType: WGPUSType_ShaderSourceWGSL },
    code: { data: wgsl, length: WGPU_STRLEN }
  })
  let desc: WGPUShaderModuleDescriptor = { nextInChain: srcList.data }
  ret wgpuDeviceCreateShaderModule(device: webgpuDevice(), descriptor: desc)
}

# The grass RENDER pipeline: same 3 G-buffer colour targets + reverse-Z depth as
# the static pipeline (makeGbPipeline), but with NO vertex buffers — the blade
# geometry is generated in the vertex shader from vertex_index — and no back-face
# cull, since a thin blade is seen from both sides.
func makeGrassPipeline(shaderMod: copy Ptr) ret Ptr {
  var targets: List(WGPUColorTargetState) = createList(WGPUColorTargetState, cap: 3)
  targets.add(value: { format: WGPUTextureFormat_RGB10A2Unorm, writeMask: WGPUColorWriteMask_All })
  targets.add(value: { format: WGPUTextureFormat_RGBA8Unorm, writeMask: WGPUColorWriteMask_All })
  targets.add(value: { format: WGPUTextureFormat_RGBA8Unorm, writeMask: WGPUColorWriteMask_All })
  var frags: List(WGPUFragmentState) = createList(WGPUFragmentState, cap: 1)
  frags.add(value: {
    module: shaderMod, entryPoint: { data: gbEntryFs(), length: WGPU_STRLEN },
    targetCount: 3 as UInt64, targets: targets.data
  })
  var depths: List(WGPUDepthStencilState) = createList(WGPUDepthStencilState, cap: 1)
  depths.add(value: {
    format: WGPUTextureFormat_Depth32Float,
    depthWriteEnabled: WGPUOptionalBool_True,
    depthCompare: WGPUCompareFunction_Greater,
    stencilFront: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilBack: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilReadMask: 4294967295 as UInt32, stencilWriteMask: 4294967295 as UInt32
  })
  let desc: WGPURenderPipelineDescriptor = {
    vertex: {
      module: shaderMod, entryPoint: { data: gbEntryVs(), length: WGPU_STRLEN },
      bufferCount: 0 as UInt64
    },
    primitive: {
      topology: WGPUPrimitiveTopology_TriangleList,
      frontFace: WGPUFrontFace_CCW, cullMode: WGPUCullMode_None
    },
    depthStencil: depths.data,
    multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 },
    fragment: frags.data
  }
  ret wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: desc)
}

# Create the instance buffer, uniform, compute pipeline, compute bind group and
# grass render pipeline once. Safe after the device + static pipeline exist.
func ensureGrassGpu() {
  if gGrassMade { ret }
  gGrassMade = true
  let instBytes: Int = grassGpuBladeCount * grassRecordBytes
  let iDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst,
    size: instBytes as UInt64
  }
  let instances: Ptr = wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: iDesc)
  grassSet(index: 1, ptr: instances)
  let uDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst,
    size: grassUniformBytes as UInt64
  }
  let uniform: Ptr = wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: uDesc)
  grassSet(index: 2, ptr: uniform)
  # Indirect draw-args buffer: the compute atomically bumps instanceCount as it
  # appends visible blades; the draw reads it via DrawIndirect. Needs Indirect
  # (drawn from) + Storage (compute writes) + CopyDst (per-frame reset).
  let indDesc: WGPUBufferDescriptor = {
    # CopySrc (#488): the diagnostics read the atomically-bumped instanceCount back.
    usage: WGPUBufferUsage_Indirect + WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
      + WGPUBufferUsage_CopySrc,
    size: grassIndirectBytes as UInt64
  }
  grassSet(index: 6, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: indDesc))
  # Slot 7: tiny MapRead staging for reading the visible count back (#488).
  let rbDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_CopyDst + WGPUBufferUsage_MapRead, size: grassIndirectBytes as UInt64
  }
  grassSet(index: 7, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: rbDesc))

  # Composed from FILES, not the C string, so the pass shares the one biome and
  # terrain-height definition with everything else that touches the ground.
  # Carrying its own copy is what left blades standing on a height field the
  # terrain had already moved off.
  let grassSrc: String = grassComputeWgsl()
  let grassCbuf: Buffer(Any) = grassSrc.toCStr()
  let shaderMod: Ptr = grassMakeShaderModule(wgsl: grassCbuf)
  let pipeDesc: WGPUComputePipelineDescriptor = {
    compute: { module: shaderMod, entryPoint: { data: grassEntry(), length: WGPU_STRLEN } }
  }
  let pipeline: Ptr = wgpuDeviceCreateComputePipeline(device: webgpuDevice(), descriptor: pipeDesc)
  grassSet(index: 0, ptr: pipeline)

  let cLayout: Ptr = wgpuComputePipelineGetBindGroupLayout(computePipeline: pipeline, groupIndex: 0 as UInt32)
  var cEntries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 3)
  cEntries.add(value: { binding: 0 as UInt32, buffer: uniform, size: grassUniformBytes as UInt64 })
  cEntries.add(value: { binding: 1 as UInt32, buffer: instances, size: instBytes as UInt64 })
  cEntries.add(value: { binding: 2 as UInt32, buffer: grassGet(index: 6), size: grassIndirectBytes as UInt64 })
  let cbDesc: WGPUBindGroupDescriptor = { layout: cLayout, entryCount: 3 as UInt64, entries: cEntries.data }
  grassSet(index: 3, ptr: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: cbDesc))
  wgpuBindGroupLayoutRelease(bindGroupLayout: cLayout)

  let renderMod: Ptr = grassMakeShaderModule(wgsl: grassRenderWgsl())
  grassSet(index: 5, ptr: makeGrassPipeline(shaderMod: renderMod))
  wgpuShaderModuleRelease(shaderModule: renderMod)
}

# The draw bind group needs the frame uniform, which only exists after the first
# beginPass — so build it lazily on first draw, reusing the static pipeline's
# group-0 layout (frame uniform @0, instance storage @1) but pointing binding 1
# at the grass instance buffer instead of the shared draws buffer.
func ensureGrassDrawBind() {
  if gGrassDrawBindMade { ret }
  gGrassDrawBindMade = true
  let instBytes: Int = grassGpuBladeCount * grassRecordBytes
  let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: grassGet(index: 5), groupIndex: 0 as UInt32)
  var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 3)
  entries.add(value: { binding: 0 as UInt32, buffer: gbFrameUbuf(), size: gbFrameBytes() as UInt64 })
  entries.add(value: { binding: 1 as UInt32, buffer: grassGet(index: 1), size: instBytes as UInt64 })
  entries.add(value: { binding: 2 as UInt32, buffer: grassGet(index: 2), size: grassUniformBytes as UInt64 })
  let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 3 as UInt64, entries: entries.data }
  grassSet(index: 4, ptr: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
  wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
}

# Reused per-frame staging, module-level so no per-frame alloc. gGrassUni is the
# 16-float GrassU; gGrassIndReset is the {vertexCount=6, instanceCount=0, 0, 0}
# DrawIndirect args written before each dispatch so the atomic counter starts at 0.
var gGrassUni: List(Float) = createList(Float, cap: 16)
var gGrassIndReset: List(Int32) = createList(Int32, cap: 4)

# Cull tuning: blades within nearKeep of the camera are always kept (so the field
# never holes out at the player's feet); beyond that, a blade survives only if it
# is within the view cone (dot(dirToBlade, forward) >= coneCos). coneCos ~ cos(69)
# is generous so nothing on-screen is clipped early.
const grassNearKeep: Float = 5.0
const grassConeCos: Float = 0.36

# Dispatch the grass generation + CULLING compute for this frame. Centres the
# candidate grid on (playerX, playerY); each survivor (on-terrain, unfaded, inside
# the view cone from the camera) is appended to a compacted list and bumps the
# indirect draw's instanceCount. No readback, no blocking. Call BEFORE the pass.
func grassGenerate(playerX: copy Float, playerY: copy Float, groundZ: copy Float,
                   time: copy Float, dt: copy Float, toon: copy Int,
                   camX: copy Float, camY: copy Float, camZ: copy Float,
                   fwdX: copy Float, fwdY: copy Float, fwdZ: copy Float,
                   settings: view GrassViewSettings) {
  ensureGrassGpu()
  var toonF: Float = 0.0
  if toon is 1 { toonF = 1.0 }
  loop gGrassUni.length < 28 { gGrassUni.add(value: 0.0) }
  gGrassUni.set(index: 0, value: playerX)
  gGrassUni.set(index: 1, value: playerY)
  gGrassUni.set(index: 2, value: groundZ)
  gGrassUni.set(index: 3, value: time)
  gGrassUni.set(index: 4, value: grassGpuBladeCount.toFloat())
  gGrassUni.set(index: 5, value: settings.extent)
  gGrassUni.set(index: 6, value: toonF)
  gGrassUni.set(index: 7, value: dt)
  gGrassUni.set(index: 8, value: camX)
  gGrassUni.set(index: 9, value: camY)
  gGrassUni.set(index: 10, value: camZ)
  gGrassUni.set(index: 11, value: grassNearKeep)
  gGrassUni.set(index: 12, value: fwdX)
  gGrassUni.set(index: 13, value: fwdY)
  gGrassUni.set(index: 14, value: fwdZ)
  gGrassUni.set(index: 15, value: grassConeCos)
  gGrassUni.set(index: 16, value: settings.groundColor.x)   # gradient bottom = ground
  gGrassUni.set(index: 17, value: settings.groundColor.y)
  gGrassUni.set(index: 18, value: settings.groundColor.z)
  gGrassUni.set(index: 20, value: settings.windDirX)        # f: wind
  gGrassUni.set(index: 21, value: settings.windDirY)
  gGrassUni.set(index: 22, value: settings.windStrength)
  gGrassUni.set(index: 23, value: settings.windGust)
  gGrassUni.set(index: 24, value: settings.bladeHeightScale) # g: blade + gradient
  gGrassUni.set(index: 25, value: settings.bladeWidthScale)
  gGrassUni.set(index: 26, value: settings.densityScale)
  gGrassUni.set(index: 27, value: settings.tipLighten)
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: grassGet(index: 2), bufferOffset: 0 as UInt64,
    data: gGrassUni.data, size: grassUniformBytes as UInt64)

  # Reset the indirect args so this frame's atomic append counts from 0.
  loop gGrassIndReset.length < 4 { gGrassIndReset.add(value: 0 as Int32) }
  gGrassIndReset.set(index: 0, value: grassBladeVerts as Int32)
  gGrassIndReset.set(index: 1, value: 0 as Int32)
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: grassGet(index: 6), bufferOffset: 0 as UInt64,
    data: gGrassIndReset.data, size: grassIndirectBytes as UInt64)

  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let cpDesc: WGPUComputePassDescriptor = { nextInChain: webgpuNull() }
  let pass: Ptr = wgpuCommandEncoderBeginComputePass(commandEncoder: enc, descriptor: cpDesc)
  wgpuComputePassEncoderSetPipeline(computePassEncoder: pass, pipeline: grassGet(index: 0))
  wgpuComputePassEncoderSetBindGroup(computePassEncoder: pass, groupIndex: 0 as UInt32,
    group: grassGet(index: 3), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  let groups: Int = (grassGpuBladeCount + 63) / 64
  wgpuComputePassEncoderDispatchWorkgroups(computePassEncoder: pass,
    workgroupCountX: groups as UInt32, workgroupCountY: 1 as UInt32, workgroupCountZ: 1 as UInt32)
  wgpuComputePassEncoderEnd(computePassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuComputePassEncoderRelease(computePassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
}

# Draw the whole GPU-generated grass field in one instanced, non-indexed Draw
# inside the G-buffer geometry pass (call between beginPass and endPass). The
# grass render pipeline generates each blade's geometry in-shader from
# vertex_index (no mesh), reading its per-blade transform from the instance
# buffer. Restores the shared static pipeline + bind group after so any following
# static draw is unaffected.
func grassDraw() {
  ensureGrassGpu()
  ensureGrassDrawBind()
  let pass: Ptr = gbPass()
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: grassGet(index: 5))
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: grassGet(index: 4), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  # One indirect draw: instanceCount was written by the culling compute, so only
  # the surviving (visible) blades are drawn.
  wgpuRenderPassEncoderDrawIndirect(renderPassEncoder: pass,
    indirectBuffer: grassGet(index: 6), indirectOffset: 0 as UInt64)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: gbStaticPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: gbStaticBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
}

# Total candidate blades the compute considers each frame (#488 diagnostics).
func grassGeneratedCount() pub ret Int { ret grassGpuBladeCount }

var gGrassRead: List(Int) = createList(Int, cap: 2)

# Read the VISIBLE blade count back (#488): the culling compute atomically bumped
# the indirect draw's instanceCount (u32 #1 of the 4-word args) to the number of
# survivors. Copy the args into a MapRead staging buffer and read it. BLOCKING —
# the map waits for the GPU, so call it throttled (every N frames), not per frame.
# Returns -1 before the grass GPU exists. Also confirms the map readback works on
# this backend (compute-written data, unlike the #528 timestamp path).
func grassReadVisible() pub ret Int {
  if grassGet(index: 7) is webgpuNull() { ret 0 - 1 }
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  wgpuCommandEncoderCopyBufferToBuffer(commandEncoder: enc, source: grassGet(index: 6),
    sourceOffset: 0 as UInt64, destination: grassGet(index: 7), destinationOffset: 0 as UInt64,
    size: grassIndirectBytes as UInt64)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  gbSubmit(cmd: wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc))
  loop gGrassRead.length < 2 { gGrassRead.add(value: 0) }
  let ok: Int = webgpuMapRead(buffer: grassGet(index: 7), size: grassIndirectBytes as UInt64,
    dst: gGrassRead.data)
  if ok is 0 { ret 0 - 1 }
  # args = {vertexCount:u32, instanceCount:u32, ...}; little-endian word 0 packs
  # vertexCount (low) + instanceCount (high), so instanceCount = word0 >> 32.
  let word0: Int = rae_ext_rae_buf_get(V: Int, buf: gGrassRead.data, index: 0)
  ret word0 / 4294967296
}

var gGrassDiagFrame: Int = 0
var gGrassVisibleCache: Int = 0

# Last read visible-blade count (#488). Cheap; refreshed by grassDiagTick.
func grassVisibleCount() pub ret Int { ret gGrassVisibleCache }

# Per-frame grass diagnostics (#488). Only active during a profile capture so the
# blocking readback never stalls normal play, and throttled to every 10th frame
# so even a capture takes at most one grass sync per ~6 wall-frames. Emits
# generated / visible / culled candidate counts as counters — plot them in the
# capture alongside fps and per-pass GPU ms. Call once per frame after
# grassGenerate.
func grassDiagTick() pub {
  if profile.profileCapturing() is false { ret }
  gGrassDiagFrame = gGrassDiagFrame + 1
  if gGrassDiagFrame % 10 is 0 {
    let visible: Int = grassReadVisible()
    if visible >= 0 { gGrassVisibleCache = visible }
  }
  profile.profileCounter(name: "grass.generated", value: grassGpuBladeCount)
  profile.profileCounter(name: "grass.visible", value: gGrassVisibleCache)
  profile.profileCounter(name: "grass.culled", value: grassGpuBladeCount - gGrassVisibleCache)
}
