# Its kind as a word
func eclipseKindName(kind: view EclipseKind) ret String {
  if kind is EclipseKind.total {
    ret "total"
  }
  if kind is EclipseKind.annular {
    ret "annular"
  }
  if kind is EclipseKind.hybrid {
    ret "hybrid"
  }
  ret "partial"
}

# The clock at an eclipse: the date and the local solar time (0..24) at its
# place, which may be the day before or after the universal date
type EclipseClock {
  year: Int
  dayOfYear: Int
  hour: Float
}

func eclipseClock(eclipse: view Eclipse) ret EclipseClock {
  var year: Int = eclipse.year
  var dayOfYear: Int = dayOfYearFromDate(
    date: { year: eclipse.year, month: eclipse.month, day: eclipse.day }
  )
  var hour: Float = eclipse.utHours + eclipse.longitude / 15.0
  if hour >= 24.0 {
    hour = hour - 24.0
    advanceOneDay(year: year, dayOfYear: dayOfYear)
  } else if hour < 0.0 {
    hour = hour + 24.0
    dayOfYear = dayOfYear - 1
    if dayOfYear < 1 {
      year = year - 1
      dayOfYear = daysInYear(year: year)
    }
  }
  ret EclipseClock { year: year, dayOfYear: dayOfYear, hour: hour }
}

# A line about it: "2024-04-08 18:17 UT, total, 25.3N 104.1W"
func eclipseCaption(eclipse: view Eclipse) ret String {
  ret "{eclipseWhen(eclipse: eclipse)}, {eclipseKindName(kind: eclipse.kind)}, {eclipseWhere(
    eclipse: eclipse
  )}"
}

# Its date and time and its place: "2024-04-08 18:17 UT, 25.3N 104.1W"
func eclipseWhenWhere(eclipse: view Eclipse) ret String {
  ret "{eclipseWhen(eclipse: eclipse)}, {eclipseWhere(eclipse: eclipse)}"
}

# "2024-04-08 18:17 UT"
func eclipseWhen(eclipse: view Eclipse) ret String {
  let minutes: Int = (eclipse.utHours * 60.0 + 0.5).toInt()
  ret "{eclipse.year}-{twoDigits(value: eclipse.month)}-{twoDigits(value: eclipse.day)} {twoDigits(
    value: minutes / 60
  )}:{twoDigits(value: minutes % 60)} UT"
}

# "25.3N 104.1W"
func eclipseWhere(eclipse: view Eclipse) ret String {
  var lat: String = "{Math.abs(value: eclipse.latitude)}N"
  if eclipse.latitude < 0.0 {
    lat = "{Math.abs(value: eclipse.latitude)}S"
  }
  var lon: String = "{Math.abs(value: eclipse.longitude)}E"
  if eclipse.longitude < 0.0 {
    lon = "{Math.abs(value: eclipse.longitude)}W"
  }
  ret "{lat} {lon}"
}

func twoDigits(value: view Int) ret String {
  if value < 10 {
    ret "0{value}"
  }
  ret "{value}"
}
