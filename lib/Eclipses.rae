# Eclipses — a list of real solar eclipses to visit: for each, the moment
# of greatest eclipse (universal time) and the place on Earth where it was
# deepest, from the published eclipse tables (NASA's Five Millennium
# Canon). lib/Moon puts the moon over the sun at these moments and places;
# case 1258 checks that it does.
#
# The settings jump to one with eclipseClock: it turns the universal time
# into the local solar time the clock runs on (the longitude's hours), so
# the sky shows the eclipse from that place.
import Math
open Calendar

enum EclipseKind { total, annular, hybrid, partial }

type Eclipse {
  year: Int
  month: Int
  day: Int
  # the moment of greatest eclipse, hours of universal time
  utHours: Float
  kind: EclipseKind
  # where it was deepest (degrees north, east)
  latitude: Float
  longitude: Float
}

