# Moon — the moons in the sky: where each is, how much of it is lit and how
# big it is drawn, for a date, a local solar time, a latitude and a
# longitude; how much light the earth's moon gives; and how much of the sun
# it covers (a solar eclipse).
#
# The earth's moon follows an ephemeris: its orbit's mean elements with the
# main perturbations of its longitude, latitude and distance (the series of
# Paul Schlyter's "How to compute planetary positions"), good to a couple of
# arc minutes, on terrestrial time (delta T by year), and the sun's longitude and distance from the
# same source.
# It is seen from the observer's place, not the earth's center: the
# sidereal time and the moon's parallax (up to a degree) move it, which is
# what makes an eclipse total in one place and partial 500 km away.
#
# The sky's sun comes from lib/Sky (local solar time and a fitted
# declination). Each moon is placed RELATIVE to that sun: its hour angle
# and declination are the sun's plus their differences in the ephemeris. So
# the moon's phase faces the sun the sky shows, and an eclipse covers that
# sun exactly when the ephemeris says it does. The longitude turns local
# solar time into universal time.
#
# Away from the sun the moon is drawn 2.5 times its real size, as games do,
# so its phase reads on a screen; near the sun it shrinks to its real size,
# so an eclipse is total, annular or partial as it really is.
#
# More moons: a MoonBody describes each. The earth's moon is earthMoon();
# invented ones circle on a tilted orbit of their own period, size and
# color (inventedMoons), placed and lit the same way.
#
#   let moon: MoonState = moonForDate(year: 2026, dayOfYear: 290, hour: 22.0,
#     latitudeDeg: 60.17, longitudeDeg: 24.94)
#   moon.direction      the way its light travels (Light3d.sunDir's convention)
#   moon.illumination   0 at new moon .. 1 at full
#   moon.sunCovered     0 .. 1: how much of the sun's disc it hides
#   moon.shadowed       0 .. 1: how much light the earth's shadow takes
#   moonLightLevel(moon: moon)   0 .. 1: the phase, dimmed near the horizon
#                                and in the earth's shadow
import Math
import Vec3
open Calendar
open Sky

const moonPi: Float = 3.14159265358979

# Helsinki, east of Greenwich: the longitude the settings start at, beside
# lib/Sky's default latitude
const moonDefaultLongitudeDeg: Float = 24.94

# The disc's angular radius in the sky (rad) away from the sun: the real
# moon's is about 0.0045, the size of the sun's; it is drawn 2.5 times
# bigger, as games do, so its phase reads on a screen
const moonAngularRadius: Float = 0.0115

# Within this angle of the sun (rad, about 4 degrees) a moon is drawn at its
# real size, and from twice it at its game size
const moonRealSizeWithin: Float = 0.07

# The moon's radius in earth radii, and the sun's angular radius at one
# astronomical unit (rad)
const moonRadiusEarthRadii: Float = 0.2725

const sunAngularRadiusAtOneAu: Float = 0.0046524

type MoonState {
  # The way the moonlight travels: from the moon toward the scene
  direction: Vec3
  # Its height in the sky: the sine of its elevation, below 0 when set
  up: Float
  # The lit fraction of the disc: 0 at new moon, 1 at full
  illumination: Float
  # Growing toward full (true) or shrinking toward new
  waxing: Bool
  # The disc's radius as drawn (rad), its color and its brightness (1 the
  # earth's moon)
  drawRadius: Float = 0.0115
  color: Vec3 = Vec3.create(x: 0.92, y: 0.94, z: 1.0)
  brightness: Float = 1.0
  # Seen from here: the angle between it and the sun (rad), the real
  # angular radii of the two, and how much of the sun's disc it covers
  # (0 .. 1; above 0 is a solar eclipse)
  sunSeparation: Float = 3.14159
  realRadius: Float = 0.0045
  sunRealRadius: Float = 0.00465
  sunCovered: Float = 0.0
  # The earth's shadow on it (a lunar eclipse), as drawn: the way from the
  # shadow's center toward the scene (as direction), the dark core's
  # (umbra) and the half shadow's (penumbra) angular radii (0: no shadow),
  # and how much of its light the shadow takes (0..1)
  shadowDirection: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  umbraRadius: Float = 0.0
  penumbraRadius: Float = 0.0
  shadowed: Float = 0.0
}

# A moon of the sky: the earth's (its ephemeris), or an invented one on a
# circular orbit tilted to the ecliptic
type MoonBody {
  name: String
  earth: Bool = false
  # Its disc as drawn (rad), color and brightness
  angularRadius: Float
  color: Vec3
  brightness: Float = 1.0
  # An invented orbit: the days of one turn against the stars, its ecliptic
  # longitude at J2000 (degrees), its tilt (degrees) and its ascending
  # node's longitude (degrees)
  periodDays: Float = 27.32
  longitudeAtEpoch: Float = 0.0
  inclination: Float = 0.0
  nodeLongitude: Float = 0.0
}

# The earth's moon
func earthMoon() ret MoonBody {
  ret MoonBody {
    name: "Moon"
    earth: true
    angularRadius: moonAngularRadius
    color: Vec3.create(x: 0.92, y: 0.94, z: 1.0)
  }
}

# Two invented moons, unlike the earth's: a small, quick, rust-red one and
# a big, slow, pale blue-green one, on tilted orbits of their own
func inventedMoons() ret List(MoonBody) {
  ret List(MoonBody) {
    {
      name: "Ember"
      angularRadius: 0.0065
      color: Vec3.create(x: 1.0, y: 0.42, z: 0.24)
      brightness: 0.3
      periodDays: 11.7
      longitudeAtEpoch: 40.0
      inclination: 9.0
      nodeLongitude: 70.0
    }
    {
      name: "Tide"
      angularRadius: 0.021
      color: Vec3.create(x: 0.5, y: 0.85, z: 0.95)
      brightness: 0.35
      periodDays: 61.0
      longitudeAtEpoch: 200.0
      inclination: 14.0
      nodeLongitude: 300.0
    }
  }
}

func moonRadians(degrees: view Float) ret Float {
  ret degrees * moonPi / 180.0
}

func moonDegrees(radians: view Float) ret Float {
  ret radians * 180.0 / moonPi
}

# An angle in degrees, wrapped to 0..360 before it loses precision in a Float
func moonWrapDegrees(degrees: view Float64) ret Float {
  let turns: Float64 = Math.floor(x: (degrees / 360.0) as Float) as Float64
  var wrapped: Float64 = degrees - turns * 360.0
  if wrapped < 0.0 {
    wrapped = wrapped + 360.0
  }
  ret wrapped as Float
}

# Days since the J2000.0 epoch (1 January 2000, 12:00 universal time) at
# `utHours` on day `dayOfYear` (1-based) of `year`
func daysSinceJ2000(year: view Int, dayOfYear: view Int, utHours: view Float) ret Float64 {
  var days: Float64 = 0.0
  if year >= 2000 {
    loop var y: Int = 2000, y < year, ++y {
      days = days + daysInYear(year: y) as Float64
    }
  } else {
    loop var y: Int = year, y < 2000, ++y {
      days = days - daysInYear(year: y) as Float64
    }
  }
  ret days + (dayOfYear - 1) as Float64 + (utHours as Float64) / 24.0 - 0.5
}

# Right ascension and declination (rad)
type MoonEquatorial {
  rightAscension: Float
  declination: Float
}

func eclipticToEquatorial(
  longitudeDeg: view Float
  latitudeDeg: view Float
  obliquityDeg: view Float
) ret MoonEquatorial {
  let lambda: Float = moonRadians(degrees: longitudeDeg)
  let beta: Float = moonRadians(degrees: latitudeDeg)
  let epsilon: Float = moonRadians(degrees: obliquityDeg)
  let x: Float = Math.cos(x: beta) * Math.cos(x: lambda)
  let y: Float = Math.cos(x: epsilon) * Math.cos(x: beta) * Math.sin(x: lambda) - Math.sin(
    x: epsilon
  ) * Math.sin(x: beta)
  let z: Float = Math.sin(x: epsilon) * Math.cos(x: beta) * Math.sin(x: lambda) + Math.cos(
    x: epsilon
  ) * Math.sin(x: beta)
  ret MoonEquatorial {
    rightAscension: Math.atan2(y: y, x: x)
    declination: Math.asin(x: Math.clamp(val: z, low: -1.0, high: 1.0))
  }
}

# The direction TOWARD a body at hour angle `hourAngle` and declination
# `declination` (rad), seen from `latitudeDeg`; x east, y north, z up (the
# same geometry as lib/Sky's sunDirForDeclination)
func towardHourAngle(
  hourAngle: view Float
  declination: view Float
  latitudeDeg: view Float
) ret Vec3 {
  let phi: Float = moonRadians(degrees: Math.clamp(val: latitudeDeg, low: -90.0, high: 90.0))
  let cosD: Float = Math.cos(x: declination)
  ret Vec3.create(
    x: -cosD * Math.sin(x: hourAngle)
    y: Math.sin(x: declination) * Math.cos(x: phi) - cosD * Math.sin(x: phi) * Math.cos(
      x: hourAngle
    )
    z: Math.sin(x: declination) * Math.sin(x: phi) + cosD * Math.cos(x: phi) * Math.cos(
      x: hourAngle
    )
  )
}

# The sun from the ephemeris at `days` after J2000: its ecliptic longitude
# (degrees), mean anomaly (degrees) and distance (astronomical units)
type SunEphemeris {
  longitude: Float
  anomaly: Float
  distance: Float
}

func sunEphemeris(days: view Float64) ret SunEphemeris {
  # Schlyter's day count starts 1.5 days before J2000.0
  let d: Float64 = days + 1.5
  let perihelion: Float = moonWrapDegrees(degrees: d * 0.0000470935 + 282.9404)
  let eccentricity: Float = 0.016709 - (d * 0.000000001151) as Float
  let anomaly: Float = moonWrapDegrees(degrees: d * 0.9856002585 + 356.047)
  let m: Float = moonRadians(degrees: anomaly)
  let e: Float = m + eccentricity * Math.sin(x: m) * (1.0 + eccentricity * Math.cos(x: m))
  let xv: Float = Math.cos(x: e) - eccentricity
  let yv: Float = Math.sqrt(x: 1.0 - eccentricity * eccentricity) * Math.sin(x: e)
  ret SunEphemeris {
    longitude: moonWrapDegrees(
      degrees: (moonDegrees(radians: Math.atan2(y: yv, x: xv)) + perihelion) as Float64
    )
    anomaly: anomaly
    distance: Math.sqrt(x: xv * xv + yv * yv)
  }
}

# The moon from the ephemeris at `days` after J2000: its geocentric ecliptic
# longitude and latitude (degrees) and distance (earth radii), with the
# main perturbations
type MoonEphemeris {
  longitude: Float
  latitude: Float
  distance: Float
}

func moonEphemeris(days: view Float64, sun: view SunEphemeris) ret MoonEphemeris {
  let d: Float64 = days + 1.5
  let node: Float = moonWrapDegrees(degrees: d * -0.0529538083 + 125.1228)
  let inclination: Float = moonRadians(degrees: 5.1454)
  let perigee: Float = moonWrapDegrees(degrees: d * 0.1643573223 + 318.0634)
  let eccentricity: Float = 0.0549
  let anomaly: Float = moonWrapDegrees(degrees: d * 13.0649929509 + 115.3654)
  let m: Float = moonRadians(degrees: anomaly)
  # Kepler's equation, a few rounds
  var e: Float = m + eccentricity * Math.sin(x: m) * (1.0 + eccentricity * Math.cos(x: m))
  loop var round: Int = 0, round < 4, ++round {
    e = e - (e - eccentricity * Math.sin(x: e) - m) / (1.0 - eccentricity * Math.cos(x: e))
  }
  let xv: Float = 60.2666 * (Math.cos(x: e) - eccentricity)
  let yv: Float = 60.2666 * Math.sqrt(x: 1.0 - eccentricity * eccentricity) * Math.sin(x: e)
  let v: Float = Math.atan2(y: yv, x: xv)
  let r: Float = Math.sqrt(x: xv * xv + yv * yv)
  let n: Float = moonRadians(degrees: node)
  let vw: Float = v + moonRadians(degrees: perigee)
  let xh: Float = r * (Math.cos(x: n) * Math.cos(x: vw) - Math.sin(x: n) * Math.sin(x: vw) * Math.cos(
    x: inclination
  ))
  let yh: Float = r * (Math.sin(x: n) * Math.cos(x: vw) + Math.cos(x: n) * Math.sin(x: vw) * Math.cos(
    x: inclination
  ))
  let zh: Float = r * Math.sin(x: vw) * Math.sin(x: inclination)
  var longitude: Float = moonDegrees(radians: Math.atan2(y: yh, x: xh))
  var latitude: Float = moonDegrees(radians: Math.atan2(y: zh, x: Math.sqrt(x: xh * xh + yh * yh)))
  var distance: Float = r
  # The perturbations: the sun's and the moon's mean anomalies, the moon's
  # mean elongation and its argument of latitude
  let ms: Float = moonRadians(degrees: sun.anomaly)
  let mm: Float = m
  let sunMeanLongitude: Float = sun.anomaly + moonWrapDegrees(degrees: d * 0.0000470935 + 282.9404)
  let moonMeanLongitude: Float = anomaly + perigee + node
  let dd: Float = moonRadians(degrees: moonMeanLongitude - sunMeanLongitude)
  let f: Float = moonRadians(degrees: moonMeanLongitude - node)
  longitude = longitude - 1.274 * Math.sin(x: mm - 2.0 * dd) + 0.658 * Math.sin(x: 2.0 * dd) - 0.186 * Math.sin(
    x: ms
  ) - 0.059 * Math.sin(x: 2.0 * mm - 2.0 * dd) - 0.057 * Math.sin(x: mm - 2.0 * dd + ms) + 0.053 * Math.sin(
    x: mm + 2.0 * dd
  ) + 0.046 * Math.sin(x: 2.0 * dd - ms) + 0.041 * Math.sin(x: mm - ms) - 0.035 * Math.sin(x: dd) - 0.031 * Math.sin(
    x: mm + ms
  ) - 0.015 * Math.sin(x: 2.0 * f - 2.0 * dd) + 0.011 * Math.sin(x: mm - 4.0 * dd)
  latitude = latitude - 0.173 * Math.sin(x: f - 2.0 * dd) - 0.055 * Math.sin(x: mm - f - 2.0 * dd) - 0.046 * Math.sin(
    x: mm + f - 2.0 * dd
  ) + 0.033 * Math.sin(x: f + 2.0 * dd) + 0.017 * Math.sin(x: 2.0 * mm + f)
  distance = distance - 0.58 * Math.cos(x: mm - 2.0 * dd) - 0.46 * Math.cos(x: 2.0 * dd)
  ret MoonEphemeris { longitude: longitude, latitude: latitude, distance: distance }
}

# Delta T (s): how far terrestrial time runs ahead of universal time in
# `year`, by Espenak and Meeus' polynomial fits (about 50 s in 1980, 64 s
# in 2000, 93 s in 2050, 203 s in 2100; the later years are a forecast)
func deltaTSeconds(year: view Int) ret Float {
  let y: Float = year.toFloat()
  if y < 1986.0 {
    let t: Float = y - 1975.0
    ret 45.45 + 1.067 * t - t * t / 260.0 - t * t * t / 718.0
  }
  if y < 2005.0 {
    let t: Float = y - 2000.0
    ret 63.86 + 0.3345 * t - 0.060374 * t * t + 0.0017275 * t * t * t + 0.000651814 * t * t * t * t + 0.00002373599 * t * t * t * t * t
  }
  if y < 2050.0 {
    let t: Float = y - 2000.0
    ret 62.92 + 0.32217 * t + 0.005589 * t * t
  }
  let u: Float = (y - 1820.0) / 100.0
  ret -20.0 + 32.0 * u * u - 0.5628 * (2150.0 - y)
}

# The obliquity of the ecliptic (degrees) `days` after J2000
func moonObliquity(days: view Float64) ret Float {
  ret 23.4393 - (days * 0.0000003563) as Float
}

# Greenwich mean sidereal time (rad) `days` after J2000
func greenwichSiderealTime(days: view Float64) ret Float {
  ret moonRadians(degrees: moonWrapDegrees(degrees: days * 360.98564736629 + 280.46061837))
}

# The fraction of a disc of radius `sunRadius` hidden by one of radius
# `moonRadius` whose center is `separation` away (rad; all small angles)
func discCovered(sunRadius: view Float, moonRadius: view Float, separation: view Float) ret Float {
  if sunRadius <= 0.0 {
    ret 0.0
  }
  if separation >= sunRadius + moonRadius {
    ret 0.0
  }
  if separation <= moonRadius - sunRadius {
    ret 1.0
  }
  let sunArea: Float = moonPi * sunRadius * sunRadius
  if separation <= sunRadius - moonRadius {
    ret moonPi * moonRadius * moonRadius / sunArea
  }
  # the lens where the two circles overlap
  let r1: Float = sunRadius
  let r2: Float = moonRadius
  let s: Float = separation
  let a1: Float = Math.acos(
    x: Math.clamp(val: (s * s + r1 * r1 - r2 * r2) / (2.0 * s * r1), low: -1.0, high: 1.0)
  )
  let a2: Float = Math.acos(
    x: Math.clamp(val: (s * s + r2 * r2 - r1 * r1) / (2.0 * s * r2), low: -1.0, high: 1.0)
  )
  let k: Float = (-s + r1 + r2) * (s + r1 - r2) * (s - r1 + r2) * (s + r1 + r2)
  let lens: Float = r1 * r1 * a1 + r2 * r2 * a2 - 0.5 * Math.sqrt(x: Math.max(a: k, b: 0.0))
  ret Math.clamp(val: lens / sunArea, low: 0.0, high: 1.0)
}

# The angle (rad) between two directions given as right ascension and
# declination (the haversine form: exact for the small angles of an
# eclipse, where a cosine near 1 loses them in a Float)
func angleBetween(a: view MoonEquatorial, b: view MoonEquatorial) ret Float {
  let halfDec: Float = Math.sin(x: (a.declination - b.declination) * 0.5)
  let halfRa: Float = Math.sin(x: (a.rightAscension - b.rightAscension) * 0.5)
  let h: Float = halfDec * halfDec + Math.cos(x: a.declination) * Math.cos(x: b.declination) * halfRa * halfRa
  ret 2.0 * Math.asin(x: Math.sqrt(x: Math.clamp(val: h, low: 0.0, high: 1.0)))
}

# The earth's shadow at the moon (a lunar eclipse), seen from the earth's
# center: how far the moon's center is from the shadow's (rad), the moon's
# angular radius, the shadow's dark core (umbra) and its half shadow
# (penumbra) there (rad, with the usual 2% for the atmosphere), and where on
# the earth the moon stands overhead (degrees north, east)
type LunarShadow {
  separation: Float
  moonRadius: Float
  umbraRadius: Float
  penumbraRadius: Float
  subLunarLatitude: Float
  subLunarLongitude: Float
}

# How deep the moon is in the umbra: below 0 outside it, 0..1 a partial
# eclipse, 1 and more a total one
func umbralMagnitude(shadow: view LunarShadow) ret Float {
  ret (shadow.umbraRadius + shadow.moonRadius - shadow.separation) / Math.max(
    a: 2.0 * shadow.moonRadius
    b: 0.000001
  )
}

# The shadow `utHours` into day `dayOfYear` of `year` (universal time)
func lunarShadow(year: view Int, dayOfYear: view Int, utHours: view Float) ret LunarShadow {
  let days: Float64 = daysSinceJ2000(year: year, dayOfYear: dayOfYear, utHours: utHours)
  let ephemerisDays: Float64 = days + (deltaTSeconds(year: year) as Float64) / 86400.0
  let sunNow: SunEphemeris = sunEphemeris(days: ephemerisDays)
  let ephemeris: MoonEphemeris = moonEphemeris(days: ephemerisDays, sun: sunNow)
  let obliquity: Float = moonObliquity(days: ephemerisDays)
  let antiSun: MoonEquatorial = eclipticToEquatorial(
    longitudeDeg: sunNow.longitude + 180.0
    latitudeDeg: 0.0
    obliquityDeg: obliquity
  )
  let moon: MoonEquatorial = eclipticToEquatorial(
    longitudeDeg: ephemeris.longitude
    latitudeDeg: ephemeris.latitude
    obliquityDeg: obliquity
  )
  # overhead: the moon's declination, and its hour angle 0 there
  let subLongitude: Float = moonDegrees(
    radians: moon.rightAscension - greenwichSiderealTime(days: days)
  )
  let wrappedLongitude: Float = subLongitude - 360.0 * Math.floor(x: (subLongitude + 180.0) / 360.0)
  ret LunarShadow {
    separation: angleBetween(a: moon, b: antiSun)
    moonRadius: Math.asin(
      x: Math.clamp(
        val: moonRadiusEarthRadii / Math.max(a: ephemeris.distance, b: 1.0)
        low: 0.0
        high: 1.0
      )
    )
    umbraRadius: shadowRadius(moonDistance: ephemeris.distance, sun: sunNow, sunSide: -1.0)
    penumbraRadius: shadowRadius(moonDistance: ephemeris.distance, sun: sunNow, sunSide: 1.0)
    subLunarLatitude: moonDegrees(radians: moon.declination)
    subLunarLongitude: wrappedLongitude
  }
}

# The radius of the earth's shadow at the moon `moonDistance` earth radii
# away (rad): the umbra (`sunSide` -1) or the penumbra (1), the moon's and
# the sun's parallax and the sun's radius, with the usual 2% for the
# atmosphere
func shadowRadius(moonDistance: view Float, sun: view SunEphemeris, sunSide: view Float) ret Float {
  let moonParallax: Float = Math.asin(x: 1.0 / Math.max(a: moonDistance, b: 1.0))
  let sunParallax: Float = 0.0000426 / Math.max(a: sun.distance, b: 0.5)
  let sunRadius: Float = sunAngularRadiusAtOneAu / Math.max(a: sun.distance, b: 0.5)
  ret 1.02 * (moonParallax + sunParallax + sunSide * sunRadius)
}

# The earth's moon at `hour` (local solar time, 0..24) on day `dayOfYear` of
# `year`, seen from `latitudeDeg` north, `longitudeDeg` east
func moonForDate(
  year: view Int
  dayOfYear: view Int
  hour: view Float
  latitudeDeg: view Float
  longitudeDeg: view Float
) ret MoonState {
  ret moonForBody(
    body: earthMoon()
    year: year
    dayOfYear: dayOfYear
    hour: hour
    latitudeDeg: latitudeDeg
    longitudeDeg: longitudeDeg
  )
}

# Moon `body` at `hour` (local solar time) on day `dayOfYear` of `year`,
# seen from `latitudeDeg` north, `longitudeDeg` east
func moonForBody(
  body: view MoonBody
  year: view Int
  dayOfYear: view Int
  hour: view Float
  latitudeDeg: view Float
  longitudeDeg: view Float
) ret MoonState {
  let days: Float64 = daysSinceJ2000(
    year: year
    dayOfYear: dayOfYear
    utHours: hour - longitudeDeg / 15.0
  )
  # The ephemeris runs on terrestrial time, delta T ahead of universal
  # time; the sidereal time on universal time
  let ephemerisDays: Float64 = days + (deltaTSeconds(year: year) as Float64) / 86400.0
  let sunNow: SunEphemeris = sunEphemeris(days: ephemerisDays)
  let obliquity: Float = moonObliquity(days: days)
  let sun: MoonEquatorial = eclipticToEquatorial(
    longitudeDeg: sunNow.longitude
    latitudeDeg: 0.0
    obliquityDeg: obliquity
  )
  var moonLongitude: Float = 0.0
  var moonLatitude: Float = 0.0
  var moon: MoonEquatorial = sun
  var realRadius: Float = body.angularRadius
  # the earth's shadow: none on an invented moon
  var shadow: MoonEquatorial = sun
  var shadowSeparation: Float = moonPi
  var umbraRadius: Float = 0.0
  var penumbraRadius: Float = 0.0
  if body.earth {
    let ephemeris: MoonEphemeris = moonEphemeris(days: ephemerisDays, sun: sunNow)
    moonLongitude = ephemeris.longitude
    moonLatitude = ephemeris.latitude
    let geocentric: MoonEquatorial = eclipticToEquatorial(
      longitudeDeg: moonLongitude
      latitudeDeg: moonLatitude
      obliquityDeg: obliquity
    )
    # seen from the observer, not the earth's center: the parallax (the
    # geocentric latitude, the earth being a little flattened)
    let phi: Float = moonRadians(degrees: latitudeDeg)
    let geocentricPhi: Float = Math.atan(x: 0.99664719 * Math.tan(x: phi))
    let sinParallax: Float = 1.0 / Math.max(a: ephemeris.distance, b: 1.0)
    let localSidereal: Float = greenwichSiderealTime(days: days) + moonRadians(
      degrees: longitudeDeg
    )
    let h: Float = localSidereal - geocentric.rightAscension
    let cosDec: Float = Math.cos(x: geocentric.declination)
    let den: Float = cosDec - Math.cos(x: geocentricPhi) * sinParallax * Math.cos(x: h)
    let shift: Float = Math.atan2(
      y: -Math.cos(x: geocentricPhi) * sinParallax * Math.sin(x: h)
      x: den
    )
    moon = MoonEquatorial {
      rightAscension: geocentric.rightAscension + shift
      declination: Math.atan2(
        y: (Math.sin(x: geocentric.declination) - Math.sin(x: geocentricPhi) * sinParallax) * Math.cos(
          x: shift
        )
        x: den
      )
    }
    # the earth's shadow: opposite the sun, moved by the moon's parallax
    # like the moon, since it falls on the moon
    let antiSun: MoonEquatorial = eclipticToEquatorial(
      longitudeDeg: sunNow.longitude + 180.0
      latitudeDeg: 0.0
      obliquityDeg: obliquity
    )
    shadowSeparation = angleBetween(a: geocentric, b: antiSun)
    shadow = MoonEquatorial {
      rightAscension: antiSun.rightAscension + moon.rightAscension - geocentric.rightAscension
      declination: antiSun.declination + moon.declination - geocentric.declination
    }
    umbraRadius = shadowRadius(moonDistance: ephemeris.distance, sun: sunNow, sunSide: -1.0)
    penumbraRadius = shadowRadius(moonDistance: ephemeris.distance, sun: sunNow, sunSide: 1.0)
    # its real size from here: nearer by about the sine of its height
    let height: Float = Math.sin(x: phi) * Math.sin(x: moon.declination) + Math.cos(x: phi) * Math.cos(
      x: moon.declination
    ) * Math.cos(x: h - shift)
    realRadius = Math.asin(
      x: Math.clamp(
        val: moonRadiusEarthRadii / Math.max(a: ephemeris.distance - height, b: 1.0)
        low: 0.0
        high: 1.0
      )
    )
  } else {
    # an invented moon: a circular orbit tilted to the ecliptic
    let turns: Float64 = (days / (body.periodDays as Float64)) * 360.0
    let alongOrbit: Float = moonWrapDegrees(
      degrees: turns + (body.longitudeAtEpoch - body.nodeLongitude) as Float64
    )
    let a: Float = moonRadians(degrees: alongOrbit)
    let tilt: Float = moonRadians(degrees: body.inclination)
    moonLongitude = moonWrapDegrees(
      degrees: (moonDegrees(
        radians: Math.atan2(y: Math.sin(x: a) * Math.cos(x: tilt), x: Math.cos(x: a))
      ) + body.nodeLongitude) as Float64
    )
    moonLatitude = moonDegrees(radians: Math.asin(x: Math.sin(x: a) * Math.sin(x: tilt)))
    moon = eclipticToEquatorial(
      longitudeDeg: moonLongitude
      latitudeDeg: moonLatitude
      obliquityDeg: obliquity
    )
  }
  let separation: Float = angleBetween(a: moon, b: sun)
  let sunRealRadius: Float = sunAngularRadiusAtOneAu / Math.max(a: sunNow.distance, b: 0.5)
  # Placed relative to the sky's sun: its hour angle (local solar time) and
  # declination (lib/Sky's fit), plus the ephemeris' differences
  let sunHourAngle: Float = (hour - 12.0) * moonPi / 12.0
  let toMoon: Vec3 = towardHourAngle(
    hourAngle: sunHourAngle + sun.rightAscension - moon.rightAscension
    declination: solarDeclinationRad(dayOfYear: dayOfYear) + moon.declination - sun.declination
    latitudeDeg: latitudeDeg
  )
  let toShadow: Vec3 = towardHourAngle(
    hourAngle: sunHourAngle + sun.rightAscension - shadow.rightAscension
    declination: solarDeclinationRad(dayOfYear: dayOfYear) + shadow.declination - sun.declination
    latitudeDeg: latitudeDeg
  )
  # The phase: the angle between the moon and the sun
  let cosElongation: Float = Math.cos(x: separation)
  let apart: Float = moonRadians(degrees: moonLongitude - sunNow.longitude)
  # Drawn at its real size near the sun (an eclipse as it is), its game
  # size away from it
  let away: Float = Math.clamp(
    val: (separation - moonRealSizeWithin) / moonRealSizeWithin
    low: 0.0
    high: 1.0
  )
  var drawRadius: Float = body.angularRadius
  if body.earth {
    drawRadius = realRadius + (body.angularRadius - realRadius) * away * away * (3.0 - 2.0 * away)
  }
  # The shadow drawn at the disc's scale round its center, and the light
  # it takes: half in the penumbra, nearly all in the umbra
  let scale: Float = drawRadius / Math.max(a: realRadius, b: 0.0001)
  let shadowCenter: Vec3 = Vec3.vnorm(
    a: Vec3.vadd(a: toMoon, b: Vec3.vscale(a: Vec3.vsub(a: toShadow, b: toMoon), s: scale))
  )
  let twiceRadius: Float = Math.max(a: 2.0 * realRadius, b: 0.000001)
  let inUmbra: Float = Math.clamp(
    val: (umbraRadius + realRadius - shadowSeparation) / twiceRadius
    low: 0.0
    high: 1.0
  )
  let inPenumbra: Float = Math.clamp(
    val: (penumbraRadius + realRadius - shadowSeparation) / twiceRadius
    low: 0.0
    high: 1.0
  )
  ret MoonState {
    direction: Vec3.create(x: -toMoon.x, y: -toMoon.y, z: -toMoon.z)
    up: toMoon.z
    illumination: (1.0 - cosElongation) * 0.5
    waxing: Math.sin(x: apart) > 0.0
    drawRadius: drawRadius
    color: body.color
    brightness: body.brightness
    sunSeparation: separation
    realRadius: realRadius
    sunRealRadius: sunRealRadius
    sunCovered: discCovered(
      sunRadius: sunRealRadius
      moonRadius: drawRadius
      separation: separation
    )
    shadowDirection: Vec3.vneg(a: shadowCenter)
    umbraRadius: umbraRadius * scale
    penumbraRadius: penumbraRadius * scale
    shadowed: 1.0 - (1.0 - 0.5 * inPenumbra) * (1.0 - 0.98 * inUmbra)
  }
}

# How much light the moon gives, 0..1: its lit fraction (a full moon gives
# far more than a half, so the fraction is raised to 1.5), faded out as it
# sinks to the horizon. 0 while it is set.
func moonLightLevel(moon: view MoonState) ret Float {
  if moon.up <= 0.0 {
    ret 0.0
  }
  let rise: Float = Math.clamp(val: moon.up / 0.15, low: 0.0, high: 1.0)
  let fullness: Float = Math.pow(
    base: Math.clamp(val: moon.illumination, low: 0.0, high: 1.0)
    exp: 1.5
  )
  ret fullness * rise * rise * (3.0 - 2.0 * rise) * (1.0 - moon.shadowed)
}

# The phase as words: "new moon", "waxing crescent", ..., "waning crescent"
func moonPhaseName(moon: view MoonState) ret String {
  let lit: Float = moon.illumination
  if lit < 0.03 {
    ret "new moon"
  }
  if lit > 0.97 {
    ret "full moon"
  }
  var side: String = "waning"
  if moon.waxing {
    side = "waxing"
  }
  if lit < 0.4 {
    ret "{side} crescent"
  }
  if lit < 0.6 {
    if moon.waxing {
      ret "first quarter"
    }
    ret "last quarter"
  }
  ret "{side} gibbous"
}
