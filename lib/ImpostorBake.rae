# ImpostorBake — octahedral impostors baked on the GPU, once, at startup
# (docs/tree-lod-design.md §2.2). Each prop kind (an ImpostorSubject: the
# meshes its near level draws, in the renderer's mesh store, and their
# albedos) becomes one layer of an ImpostorAtlas: its parts drawn into every
# view cell of the layer in one render pass (lib/impostor_bake.wgsl, one
# instanced draw per part, an instance per view), then the coverage-
# preserving mips (ImpostorMips). One submission for every kind; a few
# milliseconds where the CPU picture took seconds.
#
#   var subjects: List(ImpostorSubject) = ...
#   subjects.add(value: impostorSubject(parts: meshData, meshes: handles, albedos: colours))
#   let atlas: ImpostorAtlas = bakeImpostorAtlas(resources: resources, meshes: store,
#   subjects: subjects, settings: defaultImpostorSettings(), cutoff: 0.5)
import Math
import Vec3
open Scene3d
open Mesh3d
open MeshStore
open ImpostorAtlas
open ImpostorMips
open webgpu/Webgpu
open webgpu/Context
open webgpu/WebgpuEnums
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuIds
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuTextures
open gpu/GpuArgs
open gpu/GpuReadback

# A prop kind to bake: `meshes` (uploaded, in the renderer's mesh store) are
# `parts` (their mesh data, the same order, for the bounds), each drawn in
# its albedo. The bounding sphere is centred on the parts' box, a little
# wider than the farthest vertex, so no edge of the prop touches a cell's
# side.
func impostorSubject(
  parts: view List(MeshData)
  meshes: view List(MeshHandle)
  albedos: view List(Vec3)
) ret ImpostorSubject {
  var low: Vec3 = Vec3.create(x: 1000000.0, y: 1000000.0, z: 1000000.0)
  var high: Vec3 = Vec3.create(x: -1000000.0, y: -1000000.0, z: -1000000.0)
  loop let part: view MeshData in parts {
    loop var vertex: Int = 0, vertex < part.vertCount, ++vertex {
      let point: Vec3 = meshPoint(mesh: part, vertex: vertex)
      low = Vec3.create(
        x: Math.min(a: low.x, b: point.x)
        y: Math.min(a: low.y, b: point.y)
        z: Math.min(a: low.z, b: point.z)
      )
      high = Vec3.create(
        x: Math.max(a: high.x, b: point.x)
        y: Math.max(a: high.y, b: point.y)
        z: Math.max(a: high.z, b: point.z)
      )
    }
  }
  if high.x < low.x {
    low = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    high = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  }
  let centre: Vec3 = Vec3.vscale(a: Vec3.vadd(a: low, b: high), s: 0.5)
  var radius: Float = 0.001
  loop let part: view MeshData in parts {
    loop var vertex: Int = 0, vertex < part.vertCount, ++vertex {
      radius = Math.max(
        a: radius
        b: Vec3.vlen(a: Vec3.vsub(a: meshPoint(mesh: part, vertex: vertex), b: centre))
      )
    }
  }
  ret ImpostorSubject {
    meshes: meshes
    albedos: albedos
    centre: centre
    radius: radius * 1.02
    height: Math.max(a: high.z, b: 0.001)
  }
}

# A vertex's position (8 floats per vertex: position, normal, uv)
func meshPoint(mesh: view MeshData, vertex: view Int) ret Vec3 {
  let base: Int = vertex * 8
  ret Vec3.create(
    x: mesh.verts.copyAtFallback(index: base, fallback: 0.0)
    y: mesh.verts.copyAtFallback(index: base + 1, fallback: 0.0)
    z: mesh.verts.copyAtFallback(index: base + 2, fallback: 0.0)
  )
}

# The atlas textures' format and uses: drawn into (level 0), written by the
# mip passes, sampled by the draws, copied out by a check
const impostorFormat: Int32 = WGPUTextureFormat_RGBA8Unorm

func impostorTextureUsage() ret UInt64 {
  ret WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding + WGPUTextureUsage_StorageBinding + WGPUTextureUsage_CopySrc
}

# The view pass's pipeline: the mesh store's vertices (position, normal; 32
# bytes each), two colour targets, a depth test
func impostorBakePipelineSpec() ret RenderPipelineSpec {
  var attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 2)
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0, location: 0 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12, location: 1 })
  var colorFormats: List(Int32) = List.create(Int32, cap: 2)
  colorFormats.add(value: impostorFormat)
  colorFormats.add(value: impostorFormat)
  ret RenderPipelineSpec {
    vertexStride: 32
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: false
    premultiplied: false
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: true
    depthCompare: WGPUCompareFunction_Less
    cullMode: WGPUCullMode_None
    sampleCount: 1
  }
}

# Bake `subjects` into a new atlas, one layer each, with `settings`, the
# mips keeping their coverage under an alpha cut at `cutoff`. Waits for the
# GPU (startup only). An atlas with no layers when the bake failed.
func bakeImpostorAtlas(
  resources: mod GpuResources
  meshes: view MeshStore
  subjects: view List(ImpostorSubject)
  settings: view ImpostorSettings
  cutoff: view Float
) ret ImpostorAtlas {
  var atlas: ImpostorAtlas = noImpostorAtlas()
  if subjects.length < 1 or settings.viewsPerSide < 2 or settings.cellSize < 1 or settings.mips < 1 {
    ret atlas
  }
  let size: Int = impostorAtlasSize(settings: settings)
  if let albedo: TextureId = createTextureArrayMipped(
    resources: resources
    width: size
    height: size
    layers: subjects.length
    format: impostorFormat
    usage: impostorTextureUsage()
    mipLevels: settings.mips
  ) {
    atlas.albedoTexture = albedo
  }
  if let normalDepth: TextureId = createTextureArrayMipped(
    resources: resources
    width: size
    height: size
    layers: subjects.length
    format: impostorFormat
    usage: impostorTextureUsage()
    mipLevels: settings.mips
  ) {
    atlas.normalDepthTexture = normalDepth
  }
  atlas.settings = settings
  atlas.layers = subjects.length
  var scratch: GpuScratch = createGpuScratch()
  var baked: Bool = false
  if isValidTexture(resources: resources, id: atlas.albedoTexture) and isValidTexture(
    resources: resources
    id: atlas.normalDepthTexture
  ) {
    if var recording: Recording = beginRecording(resources: resources) {
      if recordImpostorViews(
        recording: recording
        resources: resources
        meshes: meshes
        subjects: subjects
        atlas: atlas
        scratch: scratch
      ) and recordImpostorMips(
        recording: recording
        resources: resources
        atlas: atlas
        cutoff: cutoff
        scratch: scratch
      ) {
        if let submission: SubmissionId = submit(resources: resources, recording: recording) {
          baked = waitSubmission(resources: resources, id: submission)
          let retired: Bool = retireSubmission(resources: resources, id: submission)
        }
      }
    }
  }
  retireGpuScratch(scratch: scratch, resources: resources)
  if baked {
    baked = bindImpostorAtlas(atlas: atlas, resources: resources, subjects: subjects)
  }
  if not baked {
    log("[impostor] the bake of {subjects.length} props failed")
    retireImpostorAtlas(atlas: atlas, resources: resources)
  }
  ret atlas
}

# The views the draws sample (every layer and level of both textures) and
# the layers' frames over each prop's height
func bindImpostorAtlas(
  atlas: mod ImpostorAtlas
  resources: mod GpuResources
  subjects: view List(ImpostorSubject)
) ret Bool {
  let range: TextureViewRange = {
    baseMip: 0
    mipCount: atlas.settings.mips
    baseLayer: 0
    layerCount: atlas.layers
    dimension: WGPUTextureViewDimension_2DArray
  }
  var frames: ArgWriter = createArgs(uniform: false)
  loop let subject: view ImpostorSubject in subjects {
    pushVec4F(
      writer: frames
      x: subject.centre.x / subject.height
      y: subject.centre.y / subject.height
      z: subject.centre.z / subject.height
      w: subject.radius / subject.height
    )
  }
  if let albedo: TextureViewId = createTextureViewRange(
    resources: resources
    texture: atlas.albedoTexture
    range: range
  ) {
    atlas.binding.albedo = albedo
  }
  if let normalDepth: TextureViewId = createTextureViewRange(
    resources: resources
    texture: atlas.normalDepthTexture
    range: range
  ) {
    atlas.binding.normalDepth = normalDepth
  }
  if let framesBuffer: BufferId = createBuffer(
    resources: resources
    size: atlas.layers * 16
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
  ) {
    atlas.binding.frames = framesBuffer
  }
  atlas.binding.viewsPerSide = atlas.settings.viewsPerSide
  ret isValidTextureView(resources: resources, id: atlas.binding.albedo) and isValidTextureView(
    resources: resources
    id: atlas.binding.normalDepth
  ) and uploadArgs(
    writer: frames
    resources: resources
    buffer: atlas.binding.frames
    offset: 0
  )
}

# Level 0 of every layer: one render pass per layer, each part one draw of
# an instance per view
func recordImpostorViews(
  recording: mod Recording
  resources: mod GpuResources
  meshes: view MeshStore
  subjects: view List(ImpostorSubject)
  atlas: view ImpostorAtlas
  scratch: mod GpuScratch
) ret Bool {
  let views: Int = atlas.settings.viewsPerSide
  let viewCount: Int = views * views
  let size: Int = impostorAtlasSize(settings: atlas.settings)
  var uniform: ArgWriter = createArgs(uniform: true)
  pushVec4F(
    writer: uniform
    x: views.toFloat()
    y: 0.0
    z: 0.0
    w: 0.0
  )
  var parts: ArgWriter = createArgs(uniform: false)
  var frames: ArgWriter = createArgs(uniform: false)
  loop var layer: Int = 0, layer < subjects.length, ++layer {
    if let subject: view ImpostorSubject = subjects.viewAt(index: layer) {
      pushVec4F(
        writer: frames
        x: subject.centre.x
        y: subject.centre.y
        z: subject.centre.z
        w: subject.radius
      )
      loop var part: Int = 0, part < subject.meshes.length, ++part {
        let albedo: Vec3 = subject.albedos.copyAtFallback(
          index: part
          fallback: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
        )
        pushVec4F(
          writer: parts
          x: albedo.x
          y: albedo.y
          z: albedo.z
          w: layer.toFloat()
        )
      }
    }
  }
  let storage: UInt64 = WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
  let uniformBuffer: BufferId = scratchBuffer(
    resources: resources
    scratch: scratch
    size: 16
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  )
  let partsBuffer: BufferId = scratchBuffer(
    resources: resources
    scratch: scratch
    size: argsLength(writer: parts)
    usage: storage
  )
  let framesBuffer: BufferId = scratchBuffer(
    resources: resources
    scratch: scratch
    size: argsLength(writer: frames)
    usage: storage
  )
  if not (uploadArgs(
    writer: uniform
    resources: resources
    buffer: uniformBuffer
    offset: 0
  ) and uploadArgs(
    writer: parts
    resources: resources
    buffer: partsBuffer
    offset: 0
  ) and uploadArgs(
    writer: frames
    resources: resources
    buffer: framesBuffer
    offset: 0
  )) {
    ret false
  }
  var pipeline: RenderPipelineId = noRenderPipelineId()
  if let made: RenderPipelineId = createRenderPipeline(
    resources: resources
    shader: shader(files: ["lib/impostor_octahedral.wgsl", "lib/impostor_bake.wgsl"])
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: impostorBakePipelineSpec()
  ) {
    pipeline = made
    scratch.renderPipelines.add(value: made)
  }
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
  entries.add(value: bufferRef(id: uniformBuffer))
  entries.add(value: bufferRef(id: partsBuffer))
  entries.add(value: bufferRef(id: framesBuffer))
  var bindGroup: BindGroupId = noBindGroupId()
  if let made: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: pipeline
    entries: entries
  ) {
    bindGroup = made
    scratch.bindGroups.add(value: made)
  }
  var depthView: TextureViewId = noTextureViewId()
  if let depth: TextureId = createTexture(
    resources: resources
    width: size
    height: size
    format: WGPUTextureFormat_Depth32Float
    usage: WGPUTextureUsage_RenderAttachment
  ) {
    scratch.textures.add(value: depth)
    if let made: TextureViewId = createTextureView(resources: resources, texture: depth) {
      depthView = made
      scratch.views.add(value: made)
    }
  }
  if not bindGroupIsUsable(resources: resources, id: bindGroup) or not isValidTextureView(
    resources: resources
    id: depthView
  ) {
    ret false
  }
  var firstPart: Int = 0
  loop var layer: Int = 0, layer < subjects.length, ++layer {
    if let subject: view ImpostorSubject = subjects.viewAt(index: layer) {
      let layerRange: TextureViewRange = {
        baseMip: 0
        mipCount: 1
        baseLayer: layer
        layerCount: 1
        dimension: WGPUTextureViewDimension_2D
      }
      let albedoView: TextureViewId = scratchView(
        resources: resources
        scratch: scratch
        texture: atlas.albedoTexture
        range: layerRange
      )
      let normalDepthView: TextureViewId = scratchView(
        resources: resources
        scratch: scratch
        texture: atlas.normalDepthTexture
        range: layerRange
      )
      var targets: RenderTargetSet = createRenderTargetSet(clear: true)
      let albedoAdded: Bool = addColorTarget(
        targets: targets
        colorView: textureViewRef(id: albedoView)
        r: 0.0
        g: 0.0
        b: 0.0
        a: 0.0
      )
      let normalDepthAdded: Bool = addColorTarget(
        targets: targets
        colorView: textureViewRef(id: normalDepthView)
        r: 0.5
        g: 0.5
        b: 1.0
        a: 0.0
      )
      setDepthTarget(
        targets: targets
        depthView: textureViewRef(id: depthView)
        clear: true
        clearValue: 1.0
        readOnly: false
      )
      unsafe {
        let pass: Ptr = beginRenderPassMulti(
          recording: recording
          resources: resources
          targets: targets
        )
        if pass is webgpuNull() {
          ret false
        }
        loop var part: Int = 0, part < subject.meshes.length, ++part {
          let mesh: MeshHandle = subject.meshes.copyAtDefault(index: part)
          let indexCount: Int = meshStoreIndexCount(store: meshes, mesh: mesh.id)
          let vertexBuffer: Ptr = meshStoreVbufHandle(
            store: meshes
            resources: resources
            mesh: mesh.id
          )
          let indexBuffer: Ptr = meshStoreIbufHandle(
            store: meshes
            resources: resources
            mesh: mesh.id
          )
          if indexCount > 0 and vertexBuffer is not webgpuNull() {
            let drawn: Bool = recordDrawIndexedInPass(
              resources: resources
              pass: pass
              pipeline: pipeline
              bindGroup: bindGroup
              vertexBuffer: vertexBuffer
              indexBuffer: indexBuffer
              indexCount: indexCount
              instanceCount: viewCount
              firstInstance: (firstPart + part) * viewCount
            )
            recordMeshUse(recording: recording, meshes: meshes, mesh: mesh)
          }
        }
        endRenderPass(pass: pass)
      }
      firstPart = firstPart + subject.meshes.length
    }
  }
  recordRenderPipelineUse(recording: recording, resources: resources, id: pipeline)
  recordBindGroupUse(recording: recording, resources: resources, id: bindGroup)
  ret true
}

# A mesh's buffers as uses of the recording (pinned until it has run)
func recordMeshUse(recording: mod Recording, meshes: view MeshStore, mesh: view MeshHandle) {
  let vertexBuffer: BufferId = meshStoreVbuf(store: meshes, mesh: mesh.id)
  let indexBuffer: BufferId = meshStoreIbuf(store: meshes, mesh: mesh.id)
  recordUse(
    recording: recording
    kind: kindBuffer
    slot: vertexBuffer.slot
    generation: vertexBuffer.generation
  )
  recordUse(
    recording: recording
    kind: kindBuffer
    slot: indexBuffer.slot
    generation: indexBuffer.generation
  )
}
