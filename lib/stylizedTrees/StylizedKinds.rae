# stylizedTrees/StylizedKinds — the stylized set's trees rebuilt in the T02
# tree's technique (lib/treeGen, docs/stylized-trees-new-technique.md): each
# one a treeGen TreeKind with the old tree's own numbers (height, crown,
# leaf and bark colors, leaf outline), drawn as stylizedTrees/ReferenceTrees
# draws T02 (bark mesh, leaf cards in three tones, near / middle / impostor
# levels). RAE_STYLIZED_OLD=<name>[,<name>...] keeps the old tree instead
# (lime, sugarMaple, redMaple, japaneseMaple, ginkgo, birch, cypress, palm,
# spruce, bush).
# Written new.
import Sys
import Vec3
import RendererDeferred
open ImpostorBake
open app3d/PropField
open treeGen/TreeKind
open treeGen/TreeGrower
open treeGen/TreeParams
open treeSets/TreeSet
open treeGen/WhorlGrower
open stylizedTrees/AutumnKinds

# The lime's grown height (m): the middle of the old lime's 4.8 - 7.2 m
const limeHeight: Float = 6.0

# The grown variety (seed) the stylized set uses for the lime
const limeVariety: Int = 1

# The birch's grown height (m): the old tree's leaves rose to 1.22 times
# its placed 6.5 - 8.5 m (stylizedOldTopRatio), so its top was at 7.9 -
# 10.4 m
const birchHeight: Float = 9.0

const birchVariety: Int = 1

# The cypress's grown height (m): the middle of the old tree's 8 - 11.5 m
const cypressHeight: Float = 9.75

const cypressVariety: Int = 1

# The spruce's grown height (m): the middle of the old tree's 5.5 - 8.5 m
const spruceHeight: Float = 7.0

const spruceVariety: Int = 1

# The palm-style tree's grown height (m): the old one's reference height,
# about the middle of its 5 - 6.5 m (its leaf clusters rise above it, as
# the old ones did, to about 1.3 of it)
const palmHeight: Float = 5.5

const palmVariety: Int = 1

# The bush: a forest kind after the trees' (the ten species and the warm
# broadleaf's varieties), its impostor the atlas layer of the same number.
# It has no species: the walkers place bushes themselves (app3d/WalkerTerrain).
const stylizedBushKind: Int = 15

# The bush's grown height at scale 1 (m): the old bush form's (unit
# geometry, 1 m wide and 0.58 m tall), so the walkers' bush scales (1.5 -
# 2.4) keep the old sizes
const bushHeight: Float = 0.6

const bushVariety: Int = 1

# The small-leaved lime (Tilia cordata), as the old tree looks: one straight
# trunk with a central leader, branches all round it from under a third of
# the height up, a dense rounded crown (the old one's: about 0.85 of the
# height wide, from 0.32 to 1.05 of it) made of many round masses; small heart-shaped leaves in a
# fresh mid green
# (the old spray picture's average times its tint, linear 0.13, 0.25, 0.05);
# gray-brown bark with fine vertical fissures (the old bark's 0.15, 0.11,
# 0.07). Masses fit: a lime's crown reads as packed round clusters.
func limeKind() ret TreeKind {
  ret TreeKind {
    name: "lime"
    measures: {
      height: limeHeight
      forkHeight: 0.45
      baseRadius: 0.2
      forkRadius: 0.12
      bow: 0.008
      bowAt: 0.5
      mainLean: 0.05
      mainLength: 0.5
      mainRadius: 0.9
      secondLean: 0.65
      secondLength: 0.28
      secondRadius: 0.6
      branchCount: 9
      branchLowest: 0.28
      branchHighest: 0.8
      branchAngleMin: 1.0
      branchAngleMax: 1.3
      branchLengthMin: 0.18
      branchLengthMax: 0.3
      branchRadius: 0.5
      massCount: 34
      massRadiusMin: 0.65
      massRadiusMax: 0.95
      crownX: 0.0
      crownZ: 0.235
      crownHalfWidth: 0.3
      crownHalfHeight: 0.245
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.15
      massUpMin: 0.8
      massUpMax: 1.0
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.heart
      countMin: 12
      countSpread: 5
      reach: 160.0
      lengthMin: 70.0
      lengthMax: 100.0
      widthMin: 0.4
      widthMax: 0.48
      angleJitter: 1.2
      seed: 9300
    }
    cardSize: 0.7
    cardLayers: 3.0
    # an olive summer green near the T02 tree's (0.19, 0.23, 0.06), a little
    # fresher: darker and less saturated than the old lime's bright yellow-
    # green, which rendered as plastic lime in 136 and 143
    greens: List(Vec3) {
      Vec3.create(x: 0.2, y: 0.3, z: 0.075)
      Vec3.create(x: 0.235, y: 0.345, z: 0.09)
      Vec3.create(x: 0.165, y: 0.255, z: 0.062)
    }
    bark: { color: Vec3.create(x: 0.17, y: 0.123, z: 0.084), streakDepth: 0.35 }
    # bigger leaf cards stick out further at the middle level: fewer, less
    # grown ones keep its outline within 5% of the near level's
    middleKeep: 3
    middleGrow: 1.7
  }
}

# The silver birch, as the old tree looks: one slender white trunk running
# up through a narrow, tall crown (the old one's: about 0.82 of its height
# unit wide, from 0.24 of it, its leaves rising to 1.22 of it), branches that rise and then droop,
# and the leaves
# hanging below their tips in small, long masses; small oval leaves in a
# fresh green (the old spray picture's average times its tint: linear
# 0.15, 0.29, 0.04); white bark with dark horizontal marks (the old bark
# picture, 0.79 on average with its marks). Masses fit, hanging: a birch
