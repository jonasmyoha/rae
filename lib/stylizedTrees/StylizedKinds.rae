    measures: {
      height: birchHeight
      forkHeight: 0.55
      baseRadius: 0.15
      forkRadius: 0.09
      bow: 0.02
      bowAt: 0.5
      mainLean: 0.04
      mainLength: 0.5
      mainRadius: 0.9
      secondLean: 0.45
      secondLength: 0.3
      secondRadius: 0.55
      branchCount: 11
      branchLowest: 0.18
      branchHighest: 0.85
      branchAngleMin: 0.75
      branchAngleMax: 1.0
      branchLengthMin: 0.15
      branchLengthMax: 0.25
      branchRadius: 0.6
      massCount: 38
      massRadiusMin: 0.5
      massRadiusMax: 0.8
      crownX: 0.0
      crownZ: 0.08
      crownHalfWidth: 0.23
      crownHalfHeight: 0.36
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.7
      massAcrossMax: 0.9
      massUpMin: 1.1
      massUpMax: 1.4
      massDepth: 0.85
      roundCrown: true
      branchDroop: 0.5
      massHang: 0.6
    }
    traced: false
    leaf: {
      outline: LeafOutline.almond
      countMin: 16
      countSpread: 6
      reach: 160.0
      lengthMin: 60.0
      lengthMax: 90.0
      widthMin: 0.36
      widthMax: 0.44
      angleJitter: 1.0
      seed: 10300
    }
    cardSize: 0.75
    cardLayers: 4.5
    # a birch's lighter, yellower olive than the lime's (as the old tree's),
    # not the old bright lime
    greens: List(Vec3) {
      Vec3.create(x: 0.25, y: 0.355, z: 0.1)
      Vec3.create(x: 0.29, y: 0.4, z: 0.115)
      Vec3.create(x: 0.21, y: 0.305, z: 0.085)
    }
    bark: {
      color: Vec3.create(x: 0.88, y: 0.87, z: 0.85)
      streakDepth: 0.85
      marks: BarkMarks.birch
    }
    # long, narrow masses: every 3rd card at 1.7 times the width, so the
    # middle crown does not swell past their thin sides
    middleKeep: 3
    middleGrow: 1.5
  }
}

# The Mediterranean cypress, as the old tree looks: a tall, narrow flame
# (the old one's: about 0.27 of its height wide, from 0.10 to 1.0 of it),
# widest low and drawn to a point; a straight central stem, its branches
# short and steep and hidden; dark blue-green foliage of tiny scale leaves
# (the old spray picture's average times its tint: linear 0.045, 0.115,
# 0.054); brown bark (the old bark's 0.11, 0.08, 0.05). It reads as one
# smooth, dense column, so its masses are wide ones centered on the stem
# and stacked until they merge into one flame with only small bumps on the
# outline, the cards dense (3.5 layers, stamps with few gaps); the crown
# narrows to a point (crownTaper).
func cypressKind() ret TreeKind {
  ret TreeKind {
    name: "cypress"
    measures: {
      height: cypressHeight
      forkHeight: 0.2
      baseRadius: 0.15
      forkRadius: 0.11
      bow: 0.004
      bowAt: 0.5
      mainLean: 0.0
      mainLength: 0.8
      mainRadius: 0.9
      secondLean: 0.3
      secondLength: 0.2
      secondRadius: 0.5
      branchCount: 14
      branchLowest: 0.06
      branchHighest: 0.88
      branchAngleMin: 0.25
      branchAngleMax: 0.45
      branchLengthMin: 0.05
      branchLengthMax: 0.1
      branchRadius: 0.4
      massCount: 34
      massRadiusMin: 0.6
      massRadiusMax: 0.8
      crownX: 0.0
      crownZ: 0.33
      crownHalfWidth: 0.035
      crownHalfHeight: 0.39
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.05
      massUpMin: 1.1
      massUpMax: 1.35
      massDepth: 1.0
      roundCrown: true
      crownTaper: 0.7
    }
    traced: false
    # scale-leaf sprays as narrow leaves, 1.5 times the T02 tree's size
    # (0.16 - 0.24 m: at T02's size they still read too small)
    leaf: {
      outline: LeafOutline.almond
      countMin: 5
      countSpread: 3
      reach: 185.0
      lengthMin: 108.0
      lengthMax: 165.0
      widthMin: 0.18
      widthMax: 0.24
      angleJitter: 0.6
      seed: 10500
    }
    cardSize: 0.75
    cardLayers: 6.0
    # a deep blue-green, a little darker and grayer than the old one (darker
    # still, it read black in the forest's light): a dense column is
    # darkened less by occlusion than a loose crown
    greens: List(Vec3) {
      Vec3.create(x: 0.08, y: 0.17, z: 0.09)
      Vec3.create(x: 0.095, y: 0.195, z: 0.104)
      Vec3.create(x: 0.066, y: 0.145, z: 0.077)
    }
    bark: { color: Vec3.create(x: 0.12, y: 0.085, z: 0.06), streakDepth: 0.35 }
    # one dense flame: no trunk or branch shows inside it, only the trunk
    # under it
    innerWood: false
    # tall, narrow masses: every 3rd card at 1.5 times the width
    middleKeep: 3
    middleGrow: 1.5
  }
}

# The set's "palm" (speciesPalm), as the old tree looks. It is not a palm
# with fronds: its old code (stylizedTrees/Foliage palmWood, palmLeaves)
# is a "palm-style wood", a bending, ringed stem with a whorl of rising
# branches from 0.42 to 0.88 of its height, each ending in a big leafy
# cluster, and one more cluster on top; a rounded crown (the old one's:
# about 1.07 of its height wide, from 0.38 to 1.33 of it) of broad,
# paddle-shaped, light green leaves (its untextured albedo 0.28, 0.42,
# 0.045); dark brown wood (0.13, 0.075, 0.04). Clusters at branch ends are
