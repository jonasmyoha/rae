# stylizedTrees/StylizedKinds — the stylized set's trees rebuilt in the T02
# tree's technique (lib/treeGen, docs/stylized-trees-new-technique.md): each
# one a treeGen TreeKind with the old tree's own numbers (height, crown,
# leaf and bark colors, leaf outline), drawn as stylizedTrees/ReferenceTrees
# draws T02 (bark mesh, leaf cards in three tones, near / middle / impostor
# levels). RAE_STYLIZED_OLD=<name>[,<name>...] keeps the old tree instead
# (lime, sugarMaple, redMaple, japaneseMaple, ginkgo, birch, cypress, palm,
# bush).
# Written new.
import Sys
import Vec3
import RendererDeferred
open ImpostorBake
open app3d/PropField
open treeGen/TreeKind
open treeGen/TreeGrower
open treeGen/TreeParams
open treeSets/TreeSet

# The lime's grown height (m): the middle of the old lime's 4.8 - 7.2 m
const limeHeight: Float = 6.0

# The grown variety (seed) the stylized set uses for the lime
const limeVariety: Int = 1

# The sugar maple's grown height (m): the old tree's reference height, the
# middle of its 4.2 - 6.8 m
const sugarMapleHeight: Float = 5.5

const sugarMapleVariety: Int = 1

# The red maple's grown height (m): the old tree's reference height, the
# middle of its 4.2 - 6.8 m
const redMapleHeight: Float = 5.5

const redMapleVariety: Int = 1

# The Japanese maple's grown height (m): the middle of the old tree's
# 3.2 - 4.8 m
const japaneseMapleHeight: Float = 4.0

const japaneseMapleVariety: Int = 1

# The ginkgo's grown height (m): the old tree's reference height, the
# middle of its 4.2 - 6.8 m
const ginkgoHeight: Float = 5.5

const ginkgoVariety: Int = 1

# The birch's grown height (m): the old tree's leaves rose to 1.22 times
# its placed 6.5 - 8.5 m (stylizedOldTopRatio), so its top was at 7.9 -
# 10.4 m
const birchHeight: Float = 9.0

const birchVariety: Int = 1

# The cypress's grown height (m): the middle of the old tree's 8 - 11.5 m
const cypressHeight: Float = 9.75

const cypressVariety: Int = 1

# The palm-style tree's grown height (m): the old one's reference height,
# about the middle of its 5 - 6.5 m (its leaf clusters rise above it, as
# the old ones did, to about 1.3 of it)
const palmHeight: Float = 5.5

const palmVariety: Int = 1

# The bush: a forest kind after the trees' (the ten species and the warm
# broadleaf's varieties), its impostor the atlas layer of the same number.
# It has no species: the walkers place bushes themselves (app3d/WalkerTerrain).
const stylizedBushKind: Int = 15

# The bush's grown height at scale 1 (m): the old bush form's (unit
# geometry, 1 m wide and 0.58 m tall), so the walkers' bush scales (1.5 -
# 2.4) keep the old sizes
const bushHeight: Float = 0.6

const bushVariety: Int = 1

# The small-leaved lime (Tilia cordata), as the old tree looks: one straight
# trunk with a central leader, branches all round it from under a third of
# the height up, a dense rounded crown (the old one's: about 0.85 of the
# height wide, from 0.32 to 1.05 of it) made of many round masses; small heart-shaped leaves in a
# fresh mid green
# (the old spray picture's average times its tint, linear 0.13, 0.25, 0.05);
# gray-brown bark with fine vertical fissures (the old bark's 0.15, 0.11,
# 0.07). Masses fit: a lime's crown reads as packed round clusters.
func limeKind() ret TreeKind {
  ret TreeKind {
    name: "lime"
    measures: {
      height: limeHeight
      forkHeight: 0.45
      baseRadius: 0.2
      forkRadius: 0.12
      bow: 0.008
      bowAt: 0.5
      mainLean: 0.05
      mainLength: 0.5
      mainRadius: 0.9
      secondLean: 0.65
      secondLength: 0.28
      secondRadius: 0.6
      branchCount: 9
      branchLowest: 0.28
      branchHighest: 0.8
      branchAngleMin: 1.0
      branchAngleMax: 1.3
      branchLengthMin: 0.18
      branchLengthMax: 0.33
      branchRadius: 0.5
      massCount: 34
      massRadiusMin: 0.65
      massRadiusMax: 0.95
      crownX: 0.0
      crownZ: 0.235
      crownHalfWidth: 0.31
      crownHalfHeight: 0.245
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.15
      massUpMin: 0.8
      massUpMax: 1.0
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.heart
      countMin: 16
      countSpread: 6
      reach: 160.0
      lengthMin: 62.0
      lengthMax: 88.0
      widthMin: 0.4
      widthMax: 0.48
      angleJitter: 1.2
      seed: 9300
    }
    cardSize: 0.5
    cardLayers: 3.0
    # the old lime's hue; about 2.4 times its picture's average, because
    # the old toon crown was lit flat and here each mass's shading and the
    # occlusion deep in it take about that much away: in 143 the old crown
    # rendered at linear 0.10, 0.24, 0.04, these cards at a 2.4th of it
    greens: List(Vec3) {
      Vec3.create(x: 0.36, y: 0.68, z: 0.14)
      Vec3.create(x: 0.42, y: 0.76, z: 0.17)
      Vec3.create(x: 0.29, y: 0.57, z: 0.12)
    }
    bark: { color: Vec3.create(x: 0.17, y: 0.123, z: 0.084), streakDepth: 0.35 }
  }
}

# The sugar maple (Acer saccharum) in autumn orange, as the old tree looks:
# a leaning leader forking low, long rising branches spreading into a broad
# oval crown wider than it is tall (the old one's: about 1.07 of the height
# wide, from 0.41 to 1.05 of it), in rounded clusters; five-lobed leaves
# (the old spray picture's average times its tint: linear 0.60, 0.11,
# 0.03); gray-brown bark (the old bark's 0.18, 0.12, 0.09) with long plates.
# Masses fit: the crown reads as rounded clusters, flatter than the lime's.
func sugarMapleKind() ret TreeKind {
  ret TreeKind {
    name: "sugarMaple"
    measures: {
      height: sugarMapleHeight
      forkHeight: 0.5
      baseRadius: 0.22
      forkRadius: 0.13
      bow: 0.015
      bowAt: 0.5
      mainLean: 0.15
      mainLength: 0.46
      mainRadius: 0.85
      secondLean: 0.75
      secondLength: 0.38
      secondRadius: 0.7
      branchCount: 8
      branchLowest: 0.53
      branchHighest: 0.82
      branchAngleMin: 0.95
      branchAngleMax: 1.25
      branchLengthMin: 0.22
      branchLengthMax: 0.36
      branchRadius: 0.5
      massCount: 30
      massRadiusMin: 0.6
      massRadiusMax: 0.9
      crownX: 0.0
      crownZ: 0.27
      crownHalfWidth: 0.35
      crownHalfHeight: 0.14
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 1.0
      massAcrossMax: 1.25
      massUpMin: 0.75
      massUpMax: 0.95
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.lobed
      countMin: 9
      countSpread: 5
      reach: 140.0
      lengthMin: 90.0
      lengthMax: 130.0
      widthMin: 0.5
      widthMax: 0.5
      angleJitter: 1.0
      seed: 9500
    }
    cardSize: 0.55
    cardLayers: 3.0
    # the old orange's hue as it renders (green about 0.22 of red), as
    # bright as red can go and the three tones close: the cards' mass
    # shading and occlusion darken it as they do the lime's greens, and red
    # cannot be raised 2.4 times
    greens: List(Vec3) {
      Vec3.create(x: 0.95, y: 0.21, z: 0.04)
      Vec3.create(x: 1.0, y: 0.235, z: 0.045)
      Vec3.create(x: 0.88, y: 0.19, z: 0.036)
    }
    bark: { color: Vec3.create(x: 0.2, y: 0.14, z: 0.1), streakDepth: 0.4 }
  }
}

# The red maple (Acer rubrum) in scarlet, as the old tree looks: light
# rising branches off a fork high on the trunk carrying a loose rounded
# crown that starts high (the old one's: about 1.1 of the height wide, from
# 0.48 to 1.09 of it), its masses smaller and fewer than the sugar maple's
# with sky between them; three-lobed leaves (the old spray picture's
# average times its tint: linear 0.38, 0.07, 0.05); smooth gray bark (the
# old bark's 0.26, 0.24, 0.22) with faint streaks. Masses fit: the crown
# reads as loose clusters.
func redMapleKind() ret TreeKind {
  ret TreeKind {
    name: "redMaple"
    measures: {
      height: redMapleHeight
      forkHeight: 0.55
      baseRadius: 0.17
      forkRadius: 0.1
      bow: 0.012
      bowAt: 0.5
      mainLean: 0.08
      mainLength: 0.45
      mainRadius: 0.85
      secondLean: 0.6
      secondLength: 0.4
      secondRadius: 0.7
      branchCount: 8
      branchLowest: 0.56
      branchHighest: 0.85
      branchAngleMin: 0.8
      branchAngleMax: 1.1
      branchLengthMin: 0.25
      branchLengthMax: 0.4
      branchRadius: 0.5
      massCount: 22
      massRadiusMin: 0.55
      massRadiusMax: 0.8
      crownX: 0.0
      crownZ: 0.25
      crownHalfWidth: 0.38
      crownHalfHeight: 0.14
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.2
      massUpMin: 0.85
      massUpMax: 1.05
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.threeLobed
      countMin: 10
      countSpread: 5
      reach: 140.0
      lengthMin: 80.0
      lengthMax: 115.0
      widthMin: 0.5
      widthMax: 0.5
      angleJitter: 1.0
      seed: 9700
    }
    cardSize: 0.55
    cardLayers: 3.0
    # the old scarlet's hue, about 2.4 times its picture's average as the
    # lime's greens are (the cards' mass shading and occlusion)
    greens: List(Vec3) {
      Vec3.create(x: 0.9, y: 0.175, z: 0.125)
      Vec3.create(x: 0.98, y: 0.2, z: 0.14)
      Vec3.create(x: 0.8, y: 0.15, z: 0.11)
    }
    bark: { color: Vec3.create(x: 0.29, y: 0.27, z: 0.25), streakDepth: 0.25 }
  }
}

# The Bloodgood Japanese maple in crimson, as the old tree looks: two
# unequal stems joined low and leaning apart, spreading branches carrying
# flat, wide masses in layers, a low crown wider than it is tall (the old
# one's: about 1.2 of the height wide, from 0.35 to 0.97 of it); small,
# deeply cut seven-lobed leaves (the old spray picture's average times its
# tint: linear 0.24, 0.03, 0.06); smooth reddish-brown bark (the old bark's
# 0.16, 0.09, 0.07). Masses fit, flattened: the crown reads as layered
# plates, not round clusters.
func japaneseMapleKind() ret TreeKind {
  ret TreeKind {
    name: "japaneseMaple"
    measures: {
      height: japaneseMapleHeight
      forkHeight: 0.12
      baseRadius: 0.1
      forkRadius: 0.09
      bow: 0.01
      bowAt: 0.5
      mainLean: 0.2
      mainLength: 0.8
      mainRadius: 0.85
      secondLean: 0.38
      secondLength: 0.7
      secondRadius: 0.8
      branchCount: 9
      branchLowest: 0.3
      branchHighest: 0.85
      branchAngleMin: 1.0
      branchAngleMax: 1.35
      branchLengthMin: 0.24
      branchLengthMax: 0.38
      branchRadius: 0.5
      massCount: 26
      massRadiusMin: 0.4
      massRadiusMax: 0.6
      crownX: 0.0
      crownZ: 0.54
      crownHalfWidth: 0.36
      crownHalfHeight: 0.23
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 1.1
      massAcrossMax: 1.35
      massUpMin: 0.5
      massUpMax: 0.65
      massDepth: 1.0
      roundCrown: true
      twoStems: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.deepLobed
      countMin: 14
      countSpread: 7
      reach: 150.0
      lengthMin: 55.0
      lengthMax: 80.0
      widthMin: 0.5
      widthMax: 0.5
      angleJitter: 1.2
      seed: 9900
    }
    cardSize: 0.38
    cardLayers: 3.5
    # the old crimson's hue, about 2.4 times its picture's average as the
    # lime's greens are (the cards' mass shading and occlusion)
    greens: List(Vec3) {
      Vec3.create(x: 0.58, y: 0.075, z: 0.13)
      Vec3.create(x: 0.66, y: 0.09, z: 0.15)
      Vec3.create(x: 0.5, y: 0.06, z: 0.11)
    }
    bark: { color: Vec3.create(x: 0.19, y: 0.1, z: 0.078), streakDepth: 0.25 }
    # flat masses: every 3rd card at 1.6 times the width, so the middle
    # crown does not swell past the masses' thin rims
    middleKeep: 3
    middleGrow: 1.6
  }
}

# The Golden Globe ginkgo in autumn gold, as the old tree looks: a curved
# leader forking into two fans of rising branches, a rounded crown (the old
# one's: about 1.15 of the height wide, from 0.31 to 1.02 of it) of masses
# a little taller than wide; fan-shaped leaves on long stalks (the old
# spray picture's average times its tint: linear 0.78, 0.48, 0.04);
# gray-brown furrowed bark (the old bark's 0.25, 0.20, 0.15). Masses fit:
# the crown reads as a globe of upright clusters.
func ginkgoKind() ret TreeKind {
  ret TreeKind {
    name: "ginkgo"
    measures: {
      height: ginkgoHeight
      forkHeight: 0.38
      baseRadius: 0.19
      forkRadius: 0.12
      bow: 0.03
      bowAt: 0.6
      mainLean: 0.18
      mainLength: 0.6
      mainRadius: 0.85
      secondLean: 0.55
      secondLength: 0.45
      secondRadius: 0.75
      branchCount: 9
      branchLowest: 0.45
      branchHighest: 0.88
      branchAngleMin: 0.7
      branchAngleMax: 1.05
      branchLengthMin: 0.22
      branchLengthMax: 0.36
      branchRadius: 0.5
      massCount: 28
      massRadiusMin: 0.55
      massRadiusMax: 0.8
      crownX: 0.0
      crownZ: 0.31
      crownHalfWidth: 0.4
      crownHalfHeight: 0.2
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.85
      massAcrossMax: 1.05
      massUpMin: 1.0
      massUpMax: 1.2
      massDepth: 0.95
      roundCrown: true
      twoStems: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.fan
      countMin: 12
      countSpread: 6
      reach: 145.0
      lengthMin: 75.0
      lengthMax: 105.0
      widthMin: 0.56
      widthMax: 0.56
      angleJitter: 1.0
      seed: 10100
    }
    cardSize: 0.5
    cardLayers: 3.0
    # the old gold's hue (green 0.62 of red: the sky light in the shade
    # adds green, so the crown renders near the old one's 0.79), as bright
    # as red allows
    greens: List(Vec3) {
      Vec3.create(x: 0.97, y: 0.6, z: 0.05)
      Vec3.create(x: 1.0, y: 0.64, z: 0.055)
      Vec3.create(x: 0.9, y: 0.55, z: 0.045)
    }
    bark: { color: Vec3.create(x: 0.28, y: 0.23, z: 0.17), streakDepth: 0.4 }
    # deep cards darkened less, so the shaded gold stays gold, not olive
    occlusionFloor: 0.8
  }
}

# The silver birch, as the old tree looks: one slender white trunk running
# up through a narrow, tall crown (the old one's: about 0.82 of its height
# unit wide, from 0.24 of it, its leaves rising to 1.22 of it), branches that rise and then droop,
# and the leaves
# hanging below their tips in small, long masses; small oval leaves in a
# fresh green (the old spray picture's average times its tint: linear
# 0.15, 0.29, 0.04); white bark with dark horizontal marks (the old bark
# picture, 0.79 on average with its marks). Masses fit, hanging: a birch
# reads as curtains of leaves off drooping twigs, not round clusters.
func birchKind() ret TreeKind {
  ret TreeKind {
    name: "birch"
    measures: {
      height: birchHeight
      forkHeight: 0.55
      baseRadius: 0.15
      forkRadius: 0.09
      bow: 0.02
      bowAt: 0.5
      mainLean: 0.04
      mainLength: 0.5
      mainRadius: 0.9
      secondLean: 0.45
      secondLength: 0.3
      secondRadius: 0.55
      branchCount: 11
      branchLowest: 0.18
      branchHighest: 0.85
      branchAngleMin: 0.75
      branchAngleMax: 1.0
      branchLengthMin: 0.15
      branchLengthMax: 0.25
      branchRadius: 0.45
      massCount: 30
      massRadiusMin: 0.45
      massRadiusMax: 0.7
      crownX: 0.0
      crownZ: 0.08
      crownHalfWidth: 0.23
      crownHalfHeight: 0.36
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.7
      massAcrossMax: 0.9
      massUpMin: 1.1
      massUpMax: 1.4
      massDepth: 0.85
      roundCrown: true
      branchDroop: 0.5
      massHang: 0.6
    }
    traced: false
    leaf: {
      outline: LeafOutline.almond
      countMin: 18
      countSpread: 7
      reach: 160.0
      lengthMin: 50.0
      lengthMax: 75.0
      widthMin: 0.36
      widthMax: 0.44
      angleJitter: 1.0
      seed: 10300
    }
    cardSize: 0.45
    cardLayers: 3.0
    # the old green's hue, about 2.4 times its picture's average as the
    # lime's (the cards' mass shading and occlusion)
    greens: List(Vec3) {
      Vec3.create(x: 0.36, y: 0.68, z: 0.09)
      Vec3.create(x: 0.42, y: 0.76, z: 0.11)
      Vec3.create(x: 0.3, y: 0.58, z: 0.08)
    }
    bark: {
      color: Vec3.create(x: 0.88, y: 0.87, z: 0.85)
      streakDepth: 0.85
      marks: BarkMarks.birch
    }
    # long, narrow masses: every 3rd card at 1.7 times the width, so the
    # middle crown does not swell past their thin sides
    middleKeep: 3
    middleGrow: 1.7
  }
}

# The Mediterranean cypress, as the old tree looks: a tall, narrow flame
# (the old one's: about 0.27 of its height wide, from 0.10 to 1.0 of it),
# widest low and drawn to a point; a straight central stem, its branches
# short and steep and hidden; dark blue-green foliage of tiny scale leaves
# (the old spray picture's average times its tint: linear 0.045, 0.115,
# 0.054); brown bark (the old bark's 0.11, 0.08, 0.05). It reads as one
# smooth, dense column, so its masses are wide ones centered on the stem
# and stacked until they merge into one flame with only small bumps on the
# outline, the cards dense (3.5 layers, stamps with few gaps); the crown
# narrows to a point (crownTaper).
func cypressKind() ret TreeKind {
  ret TreeKind {
    name: "cypress"
    measures: {
      height: cypressHeight
      forkHeight: 0.2
      baseRadius: 0.15
      forkRadius: 0.11
      bow: 0.004
      bowAt: 0.5
      mainLean: 0.0
      mainLength: 0.8
      mainRadius: 0.9
      secondLean: 0.3
      secondLength: 0.2
      secondRadius: 0.5
      branchCount: 14
      branchLowest: 0.06
      branchHighest: 0.88
      branchAngleMin: 0.25
      branchAngleMax: 0.45
      branchLengthMin: 0.05
      branchLengthMax: 0.1
      branchRadius: 0.4
      massCount: 34
      massRadiusMin: 0.6
      massRadiusMax: 0.8
      crownX: 0.0
      crownZ: 0.33
      crownHalfWidth: 0.035
      crownHalfHeight: 0.39
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.05
      massUpMin: 1.1
      massUpMax: 1.35
      massDepth: 1.0
      roundCrown: true
      crownTaper: 0.7
    }
    traced: false
    # tiny scale leaves: small, narrow and many, in sprays
    leaf: {
      outline: LeafOutline.almond
      countMin: 36
      countSpread: 10
      reach: 185.0
      lengthMin: 35.0
      lengthMax: 55.0
      widthMin: 0.18
      widthMax: 0.24
      angleJitter: 0.6
      seed: 10500
    }
    cardSize: 0.42
    cardLayers: 3.5
    # the old blue-green's hue, about 1.7 times its picture's average:
    # the old cypress rendered dark, and a dense column is darkened less
    # by occlusion than a loose crown
    greens: List(Vec3) {
      Vec3.create(x: 0.075, y: 0.2, z: 0.1)
      Vec3.create(x: 0.09, y: 0.23, z: 0.115)
      Vec3.create(x: 0.062, y: 0.17, z: 0.085)
    }
    bark: { color: Vec3.create(x: 0.12, y: 0.085, z: 0.06), streakDepth: 0.35 }
    # tall, narrow masses: every 3rd card at 1.6 times the width
    middleKeep: 3
    middleGrow: 1.6
  }
}

# The set's "palm" (speciesPalm), as the old tree looks. It is not a palm
# with fronds: its old code (stylizedTrees/Foliage palmWood, palmLeaves)
# is a "palm-style wood", a bending, ringed stem with a whorl of rising
# branches from 0.42 to 0.88 of its height, each ending in a big leafy
# cluster, and one more cluster on top; a rounded crown (the old one's:
# about 1.07 of its height wide, from 0.38 to 1.33 of it) of broad,
# paddle-shaped, light green leaves (its untextured albedo 0.28, 0.42,
# 0.045); dark brown wood (0.13, 0.075, 0.04). Clusters at branch ends are
# masses, so it is grown as one: big masses at the branch tips, short side
# branches all round, the stem bowed, the bark ringed.
func palmKind() ret TreeKind {
  ret TreeKind {
    name: "palm"
    measures: {
      height: palmHeight
      forkHeight: 0.75
      baseRadius: 0.2
      forkRadius: 0.09
      bow: 0.05
      bowAt: 0.6
      mainLean: 0.05
      mainLength: 0.25
      mainRadius: 0.9
      secondLean: 0.5
      secondLength: 0.2
      secondRadius: 0.5
      branchCount: 11
      branchLowest: 0.42
      branchHighest: 0.88
      branchAngleMin: 0.6
      branchAngleMax: 1.05
      branchLengthMin: 0.2
      branchLengthMax: 0.36
      branchRadius: 0.5
      massCount: 15
      massRadiusMin: 0.85
      massRadiusMax: 1.1
      crownX: 0.0
      crownZ: 0.3
      crownHalfWidth: 0.1
      crownHalfHeight: 0.08
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.15
      massUpMin: 0.9
      massUpMax: 1.15
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    # broad paddle leaves, few and large a stamp
    leaf: {
      outline: LeafOutline.almond
      countMin: 8
      countSpread: 5
      reach: 140.0
      lengthMin: 110.0
      lengthMax: 150.0
      widthMin: 0.35
      widthMax: 0.45
      angleJitter: 1.0
      seed: 10700
    }
    cardSize: 0.7
    cardLayers: 3.0
    # the old light green's hue, about 1.8 times its flat albedo (the old
    # crown had no picture and was lit flat; the cards' mass shading and
    # occlusion take about that much away)
    greens: List(Vec3) {
      Vec3.create(x: 0.5, y: 0.74, z: 0.08)
      Vec3.create(x: 0.56, y: 0.82, z: 0.09)
      Vec3.create(x: 0.44, y: 0.66, z: 0.07)
    }
    bark: {
      color: Vec3.create(x: 0.15, y: 0.087, z: 0.046)
      streakDepth: 0.45
      marks: BarkMarks.rings
    }
  }
}

# The walkers' bush, as the old one looks (stylizedTrees/FluffyFoliage's bush
# form): a low mound 1 m wide and 0.58 m tall at scale 1 of flat-colored
# leaf patches (0.28, 0.39, 0.075, untextured). Grown as a short tree kind
# with two stems leaning apart from the ground and no trunk, short side
# branches all round, and a dense, rounded pack of low masses (a sparse one
# read smaller than the old solid mound); small leaves; brown stems.
func bushKind() ret TreeKind {
  ret TreeKind {
    name: "bush"
    measures: {
      height: bushHeight
      forkHeight: 0.05
      baseRadius: 0.03
      forkRadius: 0.025
      bow: 0.02
      bowAt: 0.5
      mainLean: 0.35
      mainLength: 0.55
      mainRadius: 0.9
      secondLean: 0.55
      secondLength: 0.48
      secondRadius: 0.85
      branchCount: 7
      branchLowest: 0.15
      branchHighest: 0.6
      branchAngleMin: 0.9
      branchAngleMax: 1.3
      branchLengthMin: 0.22
      branchLengthMax: 0.34
      branchRadius: 0.6
      massCount: 16
      massRadiusMin: 0.19
      massRadiusMax: 0.25
      crownX: 0.0
      crownZ: 0.32
      crownHalfWidth: 0.24
      crownHalfHeight: 0.12
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 1.0
      massAcrossMax: 1.2
      massUpMin: 0.9
      massUpMax: 1.05
      massDepth: 1.0
      roundCrown: true
      twoStems: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.almond
      countMin: 16
      countSpread: 6
      reach: 160.0
      lengthMin: 60.0
      lengthMax: 90.0
      widthMin: 0.3
      widthMax: 0.38
      angleJitter: 1.0
      seed: 10900
    }
    cardSize: 0.16
    cardLayers: 3.5
    # the old flat green's hue, about 1.7 times it (the old patches were lit
    # flat; the cards' mass shading and occlusion take about that much away)
    greens: List(Vec3) {
      Vec3.create(x: 0.48, y: 0.66, z: 0.13)
      Vec3.create(x: 0.53, y: 0.73, z: 0.14)
      Vec3.create(x: 0.42, y: 0.58, z: 0.11)
    }
    bark: { color: Vec3.create(x: 0.15, y: 0.1, z: 0.06), streakDepth: 0.3 }
  }
}

# Whether the stylized set draws its bushes as the treeGen bush kind
# (RAE_STYLIZED_OLD=bush keeps the old instanced bush form)
func stylizedNewBush() ret Bool {
  ret not stylizedOldRequested(name: "bush")
}

# The bush as `field`'s kind stylizedBushKind (added right after the trees'
# kinds), its impostor picture that layer of the atlas
func addStylizedBushKind(
  field: mod PropField
  renderer: mod DeferredRenderer
  ends: view Vec3
) ret ImpostorSubject {
  let treeKind: TreeKind = bushKind()
  let images: ReferenceImages = referenceImages(renderer: renderer, treeKind: treeKind)
  let subject: ImpostorSubject = addReferenceKind(
    field: field
    renderer: renderer
    treeKind: treeKind
    variety: bushVariety
    layer: stylizedBushKind
    images: images
    ends: ends
  )
  # no trunk body and no grass kept off it: the walkers slow in a bush
  if let propKind: mod PropKind = field.kinds.modAt(index: stylizedBushKind) {
    propKind.hasTrunk = false
  }
  ret subject
}

# Whether RAE_STYLIZED_OLD names `name` (a comma-separated list)
func stylizedOldRequested(name: view String) ret Bool {
  let names: List(String) = Sys.getEnv(name: "RAE_STYLIZED_OLD").split(sep: ",")
  loop let requested: view String in names {
    if requested is name {
      ret true
    }
  }
  ret false
}

# Whether `species` is drawn as a treeGen kind (rebuilt, and not kept old)
func stylizedNewKind(species: view Int) ret Bool {
  if species is speciesBroadleaf {
    ret not stylizedOldRequested(name: "lime")
  }
  if species is speciesOrange {
    ret not stylizedOldRequested(name: "sugarMaple")
  }
  if species is speciesRed {
    ret not stylizedOldRequested(name: "redMaple")
  }
  if species is speciesCrimson {
    ret not stylizedOldRequested(name: "japaneseMaple")
  }
  if species is speciesGold {
    ret not stylizedOldRequested(name: "ginkgo")
  }
  if species is speciesBirch {
    ret not stylizedOldRequested(name: "birch")
  }
  if species is speciesCypress {
    ret not stylizedOldRequested(name: "cypress")
  }
  if species is speciesPalm {
    ret not stylizedOldRequested(name: "palm")
  }
  ret false
}

# The treeGen kind of a rebuilt species (or of the bush, stylizedBushKind)
func stylizedTreeKind(species: view Int) ret TreeKind {
  if species is stylizedBushKind {
    ret bushKind()
  }
  if species is speciesOrange {
    ret sugarMapleKind()
  }
  if species is speciesRed {
    ret redMapleKind()
  }
  if species is speciesCrimson {
    ret japaneseMapleKind()
  }
  if species is speciesGold {
    ret ginkgoKind()
  }
  if species is speciesBirch {
    ret birchKind()
  }
  if species is speciesCypress {
    ret cypressKind()
  }
  if species is speciesPalm {
    ret palmKind()
  }
  ret limeKind()
}

# The grown variety of a rebuilt species (or of the bush)
func stylizedKindVariety(species: view Int) ret Int {
  if species is stylizedBushKind {
    ret bushVariety
  }
  if species is speciesOrange {
    ret sugarMapleVariety
  }
  if species is speciesRed {
    ret redMapleVariety
  }
  if species is speciesCrimson {
    ret japaneseMapleVariety
  }
  if species is speciesGold {
    ret ginkgoVariety
  }
  if species is speciesBirch {
    ret birchVariety
  }
  if species is speciesCypress {
    ret cypressVariety
  }
  if species is speciesPalm {
    ret palmVariety
  }
  ret limeVariety
}

# A species' height at scale 1: a rebuilt one's grown height (over the old
# tree's top ratio), else `oldUnit` (the old tree's)
func stylizedHeightUnit(species: view Int, oldUnit: view Float) ret Float {
  if not stylizedNewKind(species: species) {
    ret oldUnit
  }
  let treeKind: TreeKind = stylizedTreeKind(species: species)
  let params: TreeParams = kindParams(
    treeKind: treeKind
    variety: stylizedKindVariety(species: species)
  )
  ret params.height / stylizedOldTopRatio(species: species)
}

# How far above its placed height the old tree reached (its leaves' top
# over its height unit): about 1 for every old tree but the birch, whose
# leaves rose to 1.22 times it, so a placed birch stood 22% taller than its
# 6.5 - 8.5 m; a rebuilt tree keeps the old one's size
func stylizedOldTopRatio(species: view Int) ret Float {
  if species is speciesBirch {
    ret 1.22
  }
  ret 1.0
}

# Every rebuilt species' height at scale 1 in `species` (the set's species
# list, in the species constants' order) set to its grown height
func setStylizedHeightUnits(species: mod List(TreeSpecies)) {
  loop var index: Int = 0, index < stylizedSpeciesCount, ++index {
    if stylizedNewKind(species: index) {
      if let entry: mod TreeSpecies = species.modAt(index: index) {
        entry.heightUnit = stylizedHeightUnit(species: index, oldUnit: entry.heightUnit)
      }
    }
  }
}

# A rebuilt species as `field`'s kind `species`, its impostor picture layer
# `species` of the atlas the caller bakes from the returned subject
func addStylizedNewKind(
  field: mod PropField
  renderer: mod DeferredRenderer
  species: view Int
  ends: view Vec3
) ret ImpostorSubject {
  let treeKind: TreeKind = stylizedTreeKind(species: species)
  let images: ReferenceImages = referenceImages(renderer: renderer, treeKind: treeKind)
  ret addReferenceKind(
    field: field
    renderer: renderer
    treeKind: treeKind
    variety: stylizedKindVariety(species: species)
    layer: species
    images: images
    ends: ends
  )
}

# `picks` with the umbrella pine's entry split evenly among the warm
# broadleaf's varieties (each a stand of its own variety)
func warmBroadleafPicks(picks: view List(SpeciesPick)) ret List(SpeciesPick) {
  var result: List(SpeciesPick) = List.create(SpeciesPick, cap: picks.length + 4)
  var low: Float = 0.0
  loop let pick: view SpeciesPick in picks {
    if pick.species is speciesUmbrella {
      let share: Float = (pick.upTo - low) / stylizedWarmBroadleafVarieties.toFloat()
      loop var variety: Int = 0, variety < stylizedWarmBroadleafVarieties, ++variety {
        result.add(
          value: {
            upTo: low + share * (variety + 1).toFloat()
            species: speciesWarmBroadleaf + variety
          }
        )
      }
    } else {
      result.add(value: pick)
    }
    low = pick.upTo
  }
  ret result
}
