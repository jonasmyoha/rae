# stylizedTrees/StylizedKinds — the stylized set's trees rebuilt in the T02
# tree's technique (lib/treeGen, docs/stylized-trees-new-technique.md): each
# one a treeGen TreeKind with the old tree's own numbers (height, crown,
# leaf and bark colors, leaf outline), drawn as stylizedTrees/ReferenceTrees
# draws T02 (bark mesh, leaf cards in three tones, near / middle / impostor
# levels). RAE_STYLIZED_OLD=<name>[,<name>...] keeps the old tree instead
# (lime, sugarMaple, redMaple, japaneseMaple). Written new.
import Sys
import Vec3
import RendererDeferred
open ImpostorBake
open app3d/PropField
open treeGen/TreeKind
open treeGen/TreeGrower
open treeGen/TreeParams
open treeSets/TreeSet

# The lime's grown height (m): the middle of the old lime's 4.8 - 7.2 m
const limeHeight: Float = 6.0

# The grown variety (seed) the stylized set uses for the lime
const limeVariety: Int = 1

# The sugar maple's grown height (m): the old tree's reference height, the
# middle of its 4.2 - 6.8 m
const sugarMapleHeight: Float = 5.5

const sugarMapleVariety: Int = 1

# The red maple's grown height (m): the old tree's reference height, the
# middle of its 4.2 - 6.8 m
const redMapleHeight: Float = 5.5

const redMapleVariety: Int = 1

# The Japanese maple's grown height (m): the middle of the old tree's
# 3.2 - 4.8 m
const japaneseMapleHeight: Float = 4.0

const japaneseMapleVariety: Int = 1

# The small-leaved lime (Tilia cordata), as the old tree looks: one straight
# trunk with a central leader, branches all round it from under a third of
# the height up, a dense rounded crown (the old one's: about 0.85 of the
# height wide, from 0.32 to 1.05 of it) made of many round masses; small heart-shaped leaves in a
# fresh mid green
# (the old spray picture's average times its tint, linear 0.13, 0.25, 0.05);
# gray-brown bark with fine vertical fissures (the old bark's 0.15, 0.11,
# 0.07). Masses fit: a lime's crown reads as packed round clusters.
func limeKind() ret TreeKind {
  ret TreeKind {
    name: "lime"
    measures: {
      height: limeHeight
      forkHeight: 0.45
      baseRadius: 0.2
      forkRadius: 0.12
      bow: 0.008
      bowAt: 0.5
      mainLean: 0.05
      mainLength: 0.5
      mainRadius: 0.9
      secondLean: 0.65
      secondLength: 0.28
      secondRadius: 0.6
      branchCount: 9
      branchLowest: 0.28
      branchHighest: 0.8
      branchAngleMin: 1.0
      branchAngleMax: 1.3
      branchLengthMin: 0.18
      branchLengthMax: 0.33
      branchRadius: 0.5
      massCount: 34
      massRadiusMin: 0.65
      massRadiusMax: 0.95
      crownX: 0.0
      crownZ: 0.235
      crownHalfWidth: 0.31
      crownHalfHeight: 0.245
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.15
      massUpMin: 0.8
      massUpMax: 1.0
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.heart
      countMin: 16
      countSpread: 6
      reach: 160.0
      lengthMin: 62.0
      lengthMax: 88.0
      widthMin: 0.4
      widthMax: 0.48
      angleJitter: 1.2
      seed: 9300
    }
    cardSize: 0.5
    cardLayers: 3.0
    # the old lime's hue; about 2.4 times its picture's average, because
    # the old toon crown was lit flat and here each mass's shading and the
    # occlusion deep in it take about that much away: in 143 the old crown
    # rendered at linear 0.10, 0.24, 0.04, these cards at a 2.4th of it
    greens: List(Vec3) {
      Vec3.create(x: 0.36, y: 0.68, z: 0.14)
      Vec3.create(x: 0.42, y: 0.76, z: 0.17)
      Vec3.create(x: 0.29, y: 0.57, z: 0.12)
    }
    bark: { color: Vec3.create(x: 0.17, y: 0.123, z: 0.084), streakDepth: 0.35 }
  }
}

# The sugar maple (Acer saccharum) in autumn orange, as the old tree looks:
# a leaning leader forking low, long rising branches spreading into a broad
# oval crown wider than it is tall (the old one's: about 1.07 of the height
# wide, from 0.41 to 1.05 of it), in rounded clusters; five-lobed leaves
# (the old spray picture's average times its tint: linear 0.60, 0.11,
# 0.03); gray-brown bark (the old bark's 0.18, 0.12, 0.09) with long plates.
# Masses fit: the crown reads as rounded clusters, flatter than the lime's.
func sugarMapleKind() ret TreeKind {
  ret TreeKind {
    name: "sugarMaple"
    measures: {
      height: sugarMapleHeight
      forkHeight: 0.5
      baseRadius: 0.22
      forkRadius: 0.13
      bow: 0.015
      bowAt: 0.5
      mainLean: 0.15
      mainLength: 0.46
      mainRadius: 0.85
      secondLean: 0.75
      secondLength: 0.38
      secondRadius: 0.7
      branchCount: 8
      branchLowest: 0.53
      branchHighest: 0.82
      branchAngleMin: 0.95
      branchAngleMax: 1.25
      branchLengthMin: 0.22
      branchLengthMax: 0.36
      branchRadius: 0.5
      massCount: 30
      massRadiusMin: 0.6
      massRadiusMax: 0.9
      crownX: 0.0
      crownZ: 0.27
      crownHalfWidth: 0.35
      crownHalfHeight: 0.14
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 1.0
      massAcrossMax: 1.25
      massUpMin: 0.75
      massUpMax: 0.95
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.lobed
      countMin: 9
      countSpread: 5
      reach: 140.0
      lengthMin: 90.0
      lengthMax: 130.0
      widthMin: 0.5
      widthMax: 0.5
      angleJitter: 1.0
      seed: 9500
    }
    cardSize: 0.55
    cardLayers: 3.0
    # the old orange's hue as it renders (green about 0.22 of red), as
    # bright as red can go and the three tones close: the cards' mass
    # shading and occlusion darken it as they do the lime's greens, and red
    # cannot be raised 2.4 times
    greens: List(Vec3) {
      Vec3.create(x: 0.95, y: 0.21, z: 0.04)
      Vec3.create(x: 1.0, y: 0.235, z: 0.045)
      Vec3.create(x: 0.88, y: 0.19, z: 0.036)
    }
    bark: { color: Vec3.create(x: 0.2, y: 0.14, z: 0.1), streakDepth: 0.4 }
  }
}

# The red maple (Acer rubrum) in scarlet, as the old tree looks: light
# rising branches off a fork high on the trunk carrying a loose rounded
# crown that starts high (the old one's: about 1.1 of the height wide, from
# 0.48 to 1.09 of it), its masses smaller and fewer than the sugar maple's
# with sky between them; three-lobed leaves (the old spray picture's
# average times its tint: linear 0.38, 0.07, 0.05); smooth gray bark (the
# old bark's 0.26, 0.24, 0.22) with faint streaks. Masses fit: the crown
# reads as loose clusters.
func redMapleKind() ret TreeKind {
  ret TreeKind {
    name: "redMaple"
    measures: {
      height: redMapleHeight
      forkHeight: 0.55
      baseRadius: 0.17
      forkRadius: 0.1
      bow: 0.012
      bowAt: 0.5
      mainLean: 0.08
      mainLength: 0.45
      mainRadius: 0.85
      secondLean: 0.6
      secondLength: 0.4
      secondRadius: 0.7
      branchCount: 8
      branchLowest: 0.56
      branchHighest: 0.85
      branchAngleMin: 0.8
      branchAngleMax: 1.1
      branchLengthMin: 0.25
      branchLengthMax: 0.4
      branchRadius: 0.5
      massCount: 22
      massRadiusMin: 0.55
      massRadiusMax: 0.8
      crownX: 0.0
      crownZ: 0.25
      crownHalfWidth: 0.38
      crownHalfHeight: 0.14
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 0.95
      massAcrossMax: 1.2
      massUpMin: 0.85
      massUpMax: 1.05
      massDepth: 1.0
      roundCrown: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.threeLobed
      countMin: 10
      countSpread: 5
      reach: 140.0
      lengthMin: 80.0
      lengthMax: 115.0
      widthMin: 0.5
      widthMax: 0.5
      angleJitter: 1.0
      seed: 9700
    }
    cardSize: 0.55
    cardLayers: 3.0
    # the old scarlet's hue, about 2.4 times its picture's average as the
    # lime's greens are (the cards' mass shading and occlusion)
    greens: List(Vec3) {
      Vec3.create(x: 0.9, y: 0.175, z: 0.125)
      Vec3.create(x: 0.98, y: 0.2, z: 0.14)
      Vec3.create(x: 0.8, y: 0.15, z: 0.11)
    }
    bark: { color: Vec3.create(x: 0.29, y: 0.27, z: 0.25), streakDepth: 0.25 }
  }
}

# The Bloodgood Japanese maple in crimson, as the old tree looks: two
# unequal stems joined low and leaning apart, spreading branches carrying
# flat, wide masses in layers, a low crown wider than it is tall (the old
# one's: about 1.2 of the height wide, from 0.35 to 0.97 of it); small,
# deeply cut seven-lobed leaves (the old spray picture's average times its
# tint: linear 0.24, 0.03, 0.06); smooth reddish-brown bark (the old bark's
# 0.16, 0.09, 0.07). Masses fit, flattened: the crown reads as layered
# plates, not round clusters.
func japaneseMapleKind() ret TreeKind {
  ret TreeKind {
    name: "japaneseMaple"
    measures: {
      height: japaneseMapleHeight
      forkHeight: 0.12
      baseRadius: 0.1
      forkRadius: 0.09
      bow: 0.01
      bowAt: 0.5
      mainLean: 0.2
      mainLength: 0.8
      mainRadius: 0.85
      secondLean: 0.38
      secondLength: 0.7
      secondRadius: 0.8
      branchCount: 9
      branchLowest: 0.3
      branchHighest: 0.85
      branchAngleMin: 1.0
      branchAngleMax: 1.35
      branchLengthMin: 0.24
      branchLengthMax: 0.38
      branchRadius: 0.5
      massCount: 26
      massRadiusMin: 0.4
      massRadiusMax: 0.6
      crownX: 0.0
      crownZ: 0.54
      crownHalfWidth: 0.36
      crownHalfHeight: 0.23
      shareBehind: 0.0
      shareFront: 0.0
      massAcrossMin: 1.1
      massAcrossMax: 1.35
      massUpMin: 0.5
      massUpMax: 0.65
      massDepth: 1.0
      roundCrown: true
      twoStems: true
    }
    traced: false
    leaf: {
      outline: LeafOutline.deepLobed
      countMin: 14
      countSpread: 7
      reach: 150.0
      lengthMin: 55.0
      lengthMax: 80.0
      widthMin: 0.5
      widthMax: 0.5
      angleJitter: 1.2
      seed: 9900
    }
    cardSize: 0.38
    cardLayers: 3.5
    # the old crimson's hue, about 2.4 times its picture's average as the
    # lime's greens are (the cards' mass shading and occlusion)
    greens: List(Vec3) {
      Vec3.create(x: 0.58, y: 0.075, z: 0.13)
      Vec3.create(x: 0.66, y: 0.09, z: 0.15)
      Vec3.create(x: 0.5, y: 0.06, z: 0.11)
    }
    bark: { color: Vec3.create(x: 0.19, y: 0.1, z: 0.078), streakDepth: 0.25 }
    # flat masses: every 3rd card at 1.6 times the width, so the middle
    # crown does not swell past the masses' thin rims
    middleKeep: 3
    middleGrow: 1.6
  }
}

# Whether RAE_STYLIZED_OLD names `name` (a comma-separated list)
func stylizedOldRequested(name: view String) ret Bool {
  let names: List(String) = Sys.getEnv(name: "RAE_STYLIZED_OLD").split(sep: ",")
  loop let requested: view String in names {
    if requested is name {
      ret true
    }
  }
  ret false
}

# Whether `species` is drawn as a treeGen kind (rebuilt, and not kept old)
func stylizedNewKind(species: view Int) ret Bool {
  if species is speciesBroadleaf {
    ret not stylizedOldRequested(name: "lime")
  }
  if species is speciesOrange {
    ret not stylizedOldRequested(name: "sugarMaple")
  }
  if species is speciesRed {
    ret not stylizedOldRequested(name: "redMaple")
  }
  if species is speciesCrimson {
    ret not stylizedOldRequested(name: "japaneseMaple")
  }
  ret false
}

# The treeGen kind of a rebuilt species
func stylizedTreeKind(species: view Int) ret TreeKind {
  if species is speciesOrange {
    ret sugarMapleKind()
  }
  if species is speciesRed {
    ret redMapleKind()
  }
  if species is speciesCrimson {
    ret japaneseMapleKind()
  }
  ret limeKind()
}

# The grown variety of a rebuilt species
func stylizedKindVariety(species: view Int) ret Int {
  if species is speciesOrange {
    ret sugarMapleVariety
  }
  if species is speciesRed {
    ret redMapleVariety
  }
  if species is speciesCrimson {
    ret japaneseMapleVariety
  }
  ret limeVariety
}

# A species' height at scale 1: a rebuilt one's grown height, else
# `oldUnit` (the old tree's)
func stylizedHeightUnit(species: view Int, oldUnit: view Float) ret Float {
  if not stylizedNewKind(species: species) {
    ret oldUnit
  }
  let treeKind: TreeKind = stylizedTreeKind(species: species)
  let params: TreeParams = kindParams(
    treeKind: treeKind
    variety: stylizedKindVariety(species: species)
  )
  ret params.height
}

# A rebuilt species as `field`'s kind `species`, its impostor picture layer
# `species` of the atlas the caller bakes from the returned subject
func addStylizedNewKind(
  field: mod PropField
  renderer: mod DeferredRenderer
  species: view Int
  ends: view Vec3
) ret ImpostorSubject {
  let treeKind: TreeKind = stylizedTreeKind(species: species)
  let images: ReferenceImages = referenceImages(renderer: renderer, treeKind: treeKind)
  ret addReferenceKind(
    field: field
    renderer: renderer
    treeKind: treeKind
    variety: stylizedKindVariety(species: species)
    layer: species
    images: images
    ends: ends
  )
}

# `picks` with the umbrella pine's entry split evenly among the warm
# broadleaf's varieties (each a stand of its own variety)
func warmBroadleafPicks(picks: view List(SpeciesPick)) ret List(SpeciesPick) {
  var result: List(SpeciesPick) = List.create(SpeciesPick, cap: picks.length + 4)
  var low: Float = 0.0
  loop let pick: view SpeciesPick in picks {
    if pick.species is speciesUmbrella {
      let share: Float = (pick.upTo - low) / stylizedWarmBroadleafVarieties.toFloat()
      loop var variety: Int = 0, variety < stylizedWarmBroadleafVarieties, ++variety {
        result.add(
          value: {
            upTo: low + share * (variety + 1).toFloat()
            species: speciesWarmBroadleaf + variety
          }
        )
      }
    } else {
      result.add(value: pick)
    }
    low = pick.upTo
  }
  ret result
}
