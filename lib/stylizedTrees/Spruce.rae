# Norway spruce, unit height. Broken whorls carry unequal, drooping boughs.
# Curved cutout sprays retain shadows; crown normals keep their lighting broad.
import Math
open Vec3
open Mesh3d
open Noise
open stylizedTrees/Foliage
open stylizedTrees/Birch

type SpruceBough {
  start: Vec3
  angle: Float
  length: Float
  width: Float
  drop: Float
}

func spruceBough(seed: view Int, tier: view Int, branch: view Int) ret SpruceBough {
  let fraction: Float = tier.toFloat() / 8
  let angle: Float = branch.toFloat() * 1.0471976 + tier.toFloat() * 2.399963 + hash2(
    x: tier
    y: branch
    seed: seed
  ) * 0.55
  var length: Float = (0.29 - fraction * 0.255) * (0.76 + hash2(x: branch, y: tier + 19, seed: seed) * 0.30)
  if hash2(x: branch, y: tier + 71, seed: seed) > 0.84 {
    length = length * 0.72
  }
  ret SpruceBough {
    start: Vec3.create(
      x: fraction * 0.012
      y: 0
      z: 0.23 + fraction * 0.72 + (hash2(x: tier, y: branch + 41, seed: seed) - 0.5) * 0.035
    )
    angle: angle
    length: length
    width: length * (0.29 + hash2(x: branch, y: tier + 53, seed: seed) * 0.10)
    drop: length * (0.12 + (1 - fraction) * 0.16)
  }
}

func spruceBoughPoint(bough: view SpruceBough, amount: view Float) ret Vec3 {
  ret vadd(
    a: bough.start
    b: Vec3.create(
      x: Math.cos(x: bough.angle) * bough.length * amount
      y: Math.sin(x: bough.angle) * bough.length * amount
      z: bough.length * 0.32 * Math.sin(x: amount * 3.1415927) - bough.drop * amount * amount
    )
  )
}

# Three curved, intersecting spray strips preserve volume from every side.
# They remain attached to the bough; no camera-facing rotation or leaf normals.
func spruceSpray(
  mesh: mod MeshData
  bough: view SpruceBough
  seed: view Int
  secondary: view Bool
) {
  let direction: Vec3 = vnorm(a: vsub(a: spruceBoughPoint(bough: bough, amount: 1), b: bough.start))
  let side: Vec3 = Vec3.create(x: -Math.sin(x: bough.angle), y: Math.cos(x: bough.angle), z: 0)
  let across: Vec3 = vnorm(a: vcross(a: direction, b: side))
  loop var plane: Int = 0, plane < 3, ++plane {
    let first: Int = mesh.vertCount
    let angle: Float = plane.toFloat() * 1.0471976 + hash2(x: seed, y: 13, seed: 39) * 0.45
    let span: Vec3 = vadd(
      a: vscale(a: side, s: Math.cos(x: angle))
      b: vscale(a: across, s: Math.sin(x: angle))
    )
    loop var ring: Int = 0, ring < 5, ++ring {
      let amount: Float = ring.toFloat() / 4
      let center: Vec3 = spruceBoughPoint(bough: bough, amount: amount)
      loop var edge: Int = 0, edge < 2, ++edge {
        let sign: Float = edge.toFloat() * 2 - 1
        let width: Float = bough.width * 1.6 * (0.92 + hash2(x: plane, y: ring, seed: seed) * 0.16)
        let point: Vec3 = vadd(a: center, b: vscale(a: span, s: width * sign))
        let normal: Vec3 = vnorm(
          a: Vec3.create(
            x: Math.cos(x: bough.angle) * 0.55 + side.x * sign * 0.25
            y: Math.sin(x: bough.angle) * 0.55 + side.y * sign * 0.25
            z: 0.8
          )
        )
        foliageVertex(mesh: mesh, point: point, normal: normal)
        mesh.verts.set(index: mesh.verts.length - 2, value: edge.toFloat())
        mesh.verts.set(index: mesh.verts.length - 1, value: 1.0 - amount)
        mesh.windPivots.add(value: bough.start.x)
        mesh.windPivots.add(value: bough.start.y)
        mesh.windPivots.add(value: bough.start.z)
        var flexibility: Float = 0.10
        if secondary {
          flexibility = 0.32
        }
        mesh.windPivots.add(value: flexibility)
      }
    }
    loop var ring: Int = 0, ring < 4, ++ring {
      let vertex: Int = first + ring * 2
      mesh.indices.add(value: vertex)
      mesh.indices.add(value: vertex + 1)
      mesh.indices.add(value: vertex + 2)
      mesh.indices.add(value: vertex + 1)
      mesh.indices.add(value: vertex + 3)
      mesh.indices.add(value: vertex + 2)
    }
  }
}

# Detail is retained for the shared preset API. Both mesh ranges deliberately
# share this outline; the existing atlas provides the reduced far representation.
func spruceLeaves(seed: view Int, detail: view Int, tone: view Int) ret MeshData {
  var mesh: MeshData = foliageMesh()
  loop var tier: Int = 0, tier < 9, ++tier {
    loop var branch: Int = 0, branch < 6, ++branch {
      if (branch + tier) % 3 is not tone {
        continue
      }
      let bough: SpruceBough = spruceBough(seed: seed, tier: tier, branch: branch)
      spruceSpray(
        mesh: mesh
        bough: bough
        seed: seed + tier * 17 + branch
        secondary: false
      )
      loop var twig: Int = 0, twig < 4, ++twig {
        let along: Float = 0.40 + (twig / 2).toFloat() * 0.25
        var turn: Float = 0.62
        if twig % 2 is 0 {
          turn = -0.62
        }
        let secondary: SpruceBough = {
          start: vadd(
            a: spruceBoughPoint(bough: bough, amount: along)
            b: Vec3.create(
              x: -Math.sin(x: bough.angle) * turn * bough.width
              y: Math.cos(x: bough.angle) * turn * bough.width
              z: 0
            )
          )
          angle: bough.angle + turn
          length: bough.length * 0.46
          width: bough.width * 0.40
          drop: bough.length * (0.16 + hash2(x: twig, y: tier, seed: seed) * 0.10)
        }
        spruceSpray(
          mesh: mesh
          bough: secondary
          seed: seed + twig * 11 + branch
          secondary: true
        )
      }
    }
  }
  # Short upright shoots connect the upper whorls around the leader. Their
  # shared surface remains quiet while fine secondary sprays break its edge.
  loop var tier: Int = 0, tier < 7, ++tier {
    if tier % 3 is tone {
      let fraction: Float = tier.toFloat() / 6
      let leader: SpruceBough = {
        start: Vec3.create(x: fraction * 0.012, y: 0, z: 0.42 + fraction * 0.48)
        angle: tier.toFloat() * 2.399963
        length: 0.025
        width: 0.075 - fraction * 0.058
        drop: -0.105
      }
      spruceSpray(
        mesh: mesh
        bough: leader
        seed: seed + tier * 21
        secondary: false
      )
    }
  }
  ret mesh
}

func spruceWood(seed: view Int) ret MeshData {
  var mesh: MeshData = foliageMesh()
  let trunk: BirchTwig = {
    start: Vec3.create(x: 0, y: 0, z: -0.035)
    middle: Vec3.create(x: 0.005, y: -0.008, z: 0.48)
    end: Vec3.create(x: 0.012, y: 0, z: 1.015)
  }
  birchTube(
    mesh: mesh
    curve: trunk
    radius: 0.024
    sides: 12
    steps: 20
    seed: seed
  )
  loop var tier: Int = 0, tier < 9, ++tier {
    loop var branch: Int = 0, branch < 6, ++branch {
      let bough: SpruceBough = spruceBough(seed: seed, tier: tier, branch: branch)
      let curve: BirchTwig = {
        start: bough.start
        middle: spruceBoughPoint(bough: bough, amount: 0.45)
        end: spruceBoughPoint(bough: bough, amount: 0.90)
      }
      birchTube(
        mesh: mesh
        curve: curve
        radius: 0.006 * (1 - tier.toFloat() * 0.08)
        sides: 5
        steps: 5
        seed: seed + tier * 7 + branch
      )
    }
  }
  # Unit trees become 5.5-8.5 m specimens: repeat fine bark scales vertically
  # instead of stretching a small slice over the whole trunk.
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    let index: Int = vertex * 8 + 7
    mesh.verts.set(index: index, value: mesh.verts.copyAtDefault(index: index) * 14)
  }
  ret mesh
}

func spruceWoodColor() ret Vec3 {
  ret Vec3.create(x: 0.65, y: 0.65, z: 0.65)
}

func spruceLeafColor(tone: view Int) ret Vec3 {
  let variation: Float = 0.94 + tone.toFloat() * 0.045
  ret Vec3.create(x: 0.65 * variation, y: 1.0 * variation, z: 0.75 * variation)
}

func spruceLeafTexture() ret String {
  ret "lib/assets/trees/spruceSpray.png"
}

func spruceBarkTexture() ret String {
  ret "lib/assets/trees/spruceBark.png"
}
