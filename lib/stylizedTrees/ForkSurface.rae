# Bounded Loop subdivision for the joined wood study. Subdivide the welded
# surface before splitting the texture seam, so a branch grows out of its
# parent rather than smoothing two disconnected cylinders.
open Vec3
open Mesh3d
open stylizedTrees/Foliage
open stylizedTrees/SculpturalFork
import Math
open collections/IntMap

type ForkEdge {
  first: Int
  second: Int
  opposites: Vec3
  faces: Int
}

type ForkNeighbors {
  sum: Vec3
  count: Int
  boundarySum: Vec3
  boundaryCount: Int
}

func forkEdgeKey(first: view Int, second: view Int, count: view Int) ret Int {
  ret Math.min(a: first, b: second) * count + Math.max(a: first, b: second)
}

func registerForkEdge(
  edges: mod List(ForkEdge)
  lookup: mod IntMap(Int)
  mesh: view MeshData
  first: view Int
  second: view Int
  opposite: view Int
) ret Int {
  let key: Int = forkEdgeKey(first: first, second: second, count: mesh.vertCount)
  if let index: Int = get(this: lookup, k: key) {
    if let edge: mod ForkEdge = edges.modAt(index: index) {
      edge.opposites = vadd(a: edge.opposites, b: forkPoint(mesh: mesh, index: opposite))
      edge.faces = edge.faces + 1
    }
    ret index
  }
  let index: Int = edges.length
  edges.add(
    value: {
      first: first
      second: second
      opposites: forkPoint(mesh: mesh, index: opposite)
      faces: 1
    }
  )
  set(this: lookup, k: key, value: index)
  ret index
}

func forkTextureMiddle(first: view Float, second: view Float) ret Float {
  var adjusted: Float = second
  if first - second > 0.5 {
    adjusted = second + 1.0
  } else if second - first > 0.5 {
    adjusted = second - 1.0
  }
  var middle: Float = (first + adjusted) * 0.5
  if middle < 0.0 {
    middle = middle + 1.0
  }
  if middle >= 1.0 {
    middle = middle - 1.0
  }
  ret middle
}

func addForkNeighbor(
  neighbors: mod List(ForkNeighbors)
  index: view Int
  point: view Vec3
  boundary: view Bool
) {
  if let entry: mod ForkNeighbors = neighbors.modAt(index: index) {
    entry.sum = vadd(a: entry.sum, b: point)
    entry.count = entry.count + 1
    if boundary {
      entry.boundarySum = vadd(a: entry.boundarySum, b: point)
      entry.boundaryCount = entry.boundaryCount + 1
    }
  }
}

func subdivideForkSurface(mesh: view MeshData) ret MeshData {
  var edges: List(ForkEdge) = List.create(ForkEdge, cap: mesh.indices.length / 2)
  var lookup: IntMap(Int) = createIntMap(Int, cap: mesh.indices.length * 2)
  var triangleEdges: List(Int) = List.create(Int, cap: mesh.indices.length)
  loop var triangleIndex: Int = 0, triangleIndex < mesh.indices.length / 3, ++triangleIndex {
    let triangle: Int = triangleIndex * 3
    loop var corner: Int = 0, corner < 3, ++corner {
      triangleEdges.add(value: registerForkEdge(
        edges: edges
        lookup: lookup
        mesh: mesh
        first: mesh.indices.copyAtDefault(index: triangle + corner)
        second: mesh.indices.copyAtDefault(index: triangle + (corner + 1) % 3)
        opposite: mesh.indices.copyAtDefault(index: triangle + (corner + 2) % 3)
      ))
    }
  }
  var neighbors: List(ForkNeighbors) = List.create(ForkNeighbors, cap: mesh.vertCount)
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    neighbors.add(
      value: {
        sum: Vec3.create(x: 0, y: 0, z: 0)
        count: 0
        boundarySum: Vec3.create(x: 0, y: 0, z: 0)
        boundaryCount: 0
      }
    )
  }
  loop let edge: view ForkEdge in edges {
    addForkNeighbor(
      neighbors: neighbors
      index: edge.first
      point: forkPoint(mesh: mesh, index: edge.second)
      boundary: edge.faces is 1
    )
    addForkNeighbor(
      neighbors: neighbors
      index: edge.second
      point: forkPoint(mesh: mesh, index: edge.first)
      boundary: edge.faces is 1
    )
  }
  var result: MeshData = foliageMesh()
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    let point: Vec3 = forkPoint(mesh: mesh, index: vertex)
    let neighbor: ForkNeighbors = neighbors.copyAtDefault(index: vertex)
    var smoothed: Vec3 = point
    if neighbor.boundaryCount is 2 {
      smoothed = vadd(a: vscale(a: point, s: 0.75), b: vscale(a: neighbor.boundarySum, s: 0.125))
    } else if neighbor.count > 2 {
      var weight: Float = 3.0 / (8.0 * neighbor.count.toFloat())
      if neighbor.count is 3 {
        weight = 3.0 / 16.0
      }
      smoothed = vadd(
        a: vscale(a: point, s: 1.0 - neighbor.count.toFloat() * weight)
        b: vscale(a: neighbor.sum, s: weight)
      )
    }
    forkVertex(
      mesh: result
      point: smoothed
      normal: forkNormal(mesh: mesh, index: vertex)
      u: mesh.verts.copyAtDefault(index: vertex * 8 + 6)
      v: mesh.verts.copyAtDefault(index: vertex * 8 + 7)
    )
  }
  loop let edge: view ForkEdge in edges {
    let ends: Vec3 = vadd(
      a: forkPoint(mesh: mesh, index: edge.first)
      b: forkPoint(mesh: mesh, index: edge.second)
    )
    var point: Vec3 = vscale(a: ends, s: 0.5)
    if edge.faces is 2 {
      point = vadd(a: vscale(a: ends, s: 0.375), b: vscale(a: edge.opposites, s: 0.125))
    }
    forkVertex(
      mesh: result
      point: point
      normal: Vec3.create(x: 0, y: 0, z: 1)
      u: forkTextureMiddle(
        first: mesh.verts.copyAtDefault(index: edge.first * 8 + 6)
        second: mesh.verts.copyAtDefault(index: edge.second * 8 + 6)
      )
      v: (mesh.verts.copyAtDefault(index: edge.first * 8 + 7) + mesh.verts.copyAtDefault(
        index: edge.second * 8 + 7
      )) * 0.5
    )
  }
  loop var triangleIndex: Int = 0, triangleIndex < mesh.indices.length / 3, ++triangleIndex {
    let triangle: Int = triangleIndex * 3
    let first: Int = mesh.indices.copyAtDefault(index: triangle)
    let second: Int = mesh.indices.copyAtDefault(index: triangle + 1)
    let third: Int = mesh.indices.copyAtDefault(index: triangle + 2)
    let firstEdge: Int = mesh.vertCount + triangleEdges.copyAtDefault(index: triangle)
    let secondEdge: Int = mesh.vertCount + triangleEdges.copyAtDefault(index: triangle + 1)
    let thirdEdge: Int = mesh.vertCount + triangleEdges.copyAtDefault(index: triangle + 2)
    let indices: List(Int) = {
      first
      firstEdge
      thirdEdge
      firstEdge
      second
      secondEdge
      thirdEdge
      secondEdge
      third
      firstEdge
      secondEdge
      thirdEdge
    }
    loop let index: Int in indices {
      result.indices.add(value: index)
    }
  }
  ret own result
}

# Recompute area-weighted normals over shared junction vertices, then split
# only the periodic U seam. Both copies retain exactly the same normal.
func finishForkSurface(mesh: mod MeshData) {
  var normals: List(Vec3) = List.create(Vec3, cap: mesh.vertCount)
  var seamCopies: List(Int) = List.create(Int, cap: mesh.vertCount)
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    normals.add(value: Vec3.create(x: 0, y: 0, z: 0))
    seamCopies.add(value: -1)
  }
  loop var triangleIndex: Int = 0, triangleIndex < mesh.indices.length / 3, ++triangleIndex {
    let triangle: Int = triangleIndex * 3
    let first: Vec3 = forkPoint(mesh: mesh, index: mesh.indices.copyAtDefault(index: triangle))
    let second: Vec3 = forkPoint(mesh: mesh, index: mesh.indices.copyAtDefault(index: triangle + 1))
    let third: Vec3 = forkPoint(mesh: mesh, index: mesh.indices.copyAtDefault(index: triangle + 2))
    let normal: Vec3 = vcross(a: vsub(a: second, b: first), b: vsub(a: third, b: first))
    loop var corner: Int = 0, corner < 3, ++corner {
      let index: Int = mesh.indices.copyAtDefault(index: triangle + corner)
      normals.set(index: index, value: vadd(a: normals.copyAtDefault(index: index), b: normal))
    }
  }
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    let normal: Vec3 = vnorm(a: normals.copyAtDefault(index: vertex))
    mesh.verts.set(index: vertex * 8 + 3, value: normal.x)
    mesh.verts.set(index: vertex * 8 + 4, value: normal.y)
    mesh.verts.set(index: vertex * 8 + 5, value: normal.z)
  }
  loop var triangleIndex: Int = 0, triangleIndex < mesh.indices.length / 3, ++triangleIndex {
    let triangle: Int = triangleIndex * 3
    var low: Float = 1
    var high: Float = 0
    loop var corner: Int = 0, corner < 3, ++corner {
      let index: Int = mesh.indices.copyAtDefault(index: triangle + corner)
      let textureU: Float = mesh.verts.copyAtDefault(index: index * 8 + 6)
      low = Math.min(a: low, b: textureU)
      high = Math.max(a: high, b: textureU)
    }
    if high - low > 0.5 {
      loop var corner: Int = 0, corner < 3, ++corner {
        let index: Int = mesh.indices.copyAtDefault(index: triangle + corner)
        let textureU: Float = mesh.verts.copyAtDefault(index: index * 8 + 6)
        if textureU < 0.5 {
          var duplicate: Int = seamCopies.copyAtDefault(index: index)
          if duplicate < 0 {
            duplicate = forkVertex(
              mesh: mesh
              point: forkPoint(mesh: mesh, index: index)
              normal: forkNormal(mesh: mesh, index: index)
              u: textureU + 1.0
              v: mesh.verts.copyAtDefault(index: index * 8 + 7)
            )
            seamCopies.set(index: index, value: duplicate)
          }
          mesh.indices.set(index: triangle + corner, value: duplicate)
        }
      }
    }
  }
}

# Relax only the shoulder of the joined control cage. The tubes away from the
# fork keep their prescribed radius and curve; the neck gets room to emerge.
func relaxForkJunction(mesh: mod MeshData, center: view Vec3, radius: view Float) {
  loop var pass: Int = 0, pass < 5, ++pass {
    var sums: List(Vec3) = List.create(Vec3, cap: mesh.vertCount)
    var counts: List(Int) = List.create(Int, cap: mesh.vertCount)
    loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
      sums.add(value: Vec3.create(x: 0, y: 0, z: 0))
      counts.add(value: 0)
    }
    loop var triangle: Int = 0, triangle < mesh.indices.length / 3, ++triangle {
      loop var corner: Int = 0, corner < 3, ++corner {
        let first: Int = mesh.indices.copyAtDefault(index: triangle * 3 + corner)
        let second: Int = mesh.indices.copyAtDefault(index: triangle * 3 + (corner + 1) % 3)
        sums.set(
          index: first
          value: vadd(a: sums.copyAtDefault(index: first), b: forkPoint(mesh: mesh, index: second))
        )
        sums.set(
          index: second
          value: vadd(a: sums.copyAtDefault(index: second), b: forkPoint(mesh: mesh, index: first))
        )
        counts.set(index: first, value: counts.copyAtDefault(index: first) + 1)
        counts.set(index: second, value: counts.copyAtDefault(index: second) + 1)
      }
    }
    loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
      let point: Vec3 = forkPoint(mesh: mesh, index: vertex)
      let distance: Float = forkDistance(a: point, b: center)
      if distance < radius {
        let fraction: Float = 1.0 - distance / radius
        let weight: Float = 0.65 * fraction * fraction * (3.0 - 2.0 * fraction)
        let average: Vec3 = vscale(
          a: sums.copyAtDefault(index: vertex)
          s: 1.0 / counts.copyAtDefault(index: vertex).toFloat()
        )
        let next: Vec3 = vadd(
          a: vscale(a: point, s: 1.0 - weight)
          b: vscale(a: average, s: weight)
        )
        mesh.verts.set(index: vertex * 8, value: next.x)
        mesh.verts.set(index: vertex * 8 + 1, value: next.y)
        mesh.verts.set(index: vertex * 8 + 2, value: next.z)
      }
    }
  }
}

# A cylindrical U coordinate has singularities at tips and crotches. Give
# these bounded regions separate planar charts with the welded surface normals.
func textureForkPatch(
  mesh: mod MeshData
  center: view Vec3
  tangent: view Vec3
  radius: view Float
) {
  let side: Vec3 = foliageBasis(direction: tangent)
  let across: Vec3 = vnorm(a: vcross(a: tangent, b: side))
  var copies: List(Int) = List.create(Int, cap: mesh.vertCount)
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    copies.add(value: -1)
  }
  loop var triangle: Int = 0, triangle < mesh.indices.length / 3, ++triangle {
    var middle: Vec3 = Vec3.create(x: 0, y: 0, z: 0)
    loop var corner: Int = 0, corner < 3, ++corner {
      middle = vadd(
        a: middle
        b: forkPoint(mesh: mesh, index: mesh.indices.copyAtDefault(index: triangle * 3 + corner))
      )
    }
    let offset: Vec3 = vsub(a: vscale(a: middle, s: 1.0 / 3.0), b: center)
    if vdot(a: offset, b: offset) < radius * radius * 1.69 and Math.abs(
      value: vdot(a: offset, b: tangent)
    ) < radius * 0.4 {
      loop var corner: Int = 0, corner < 3, ++corner {
        let index: Int = mesh.indices.copyAtDefault(index: triangle * 3 + corner)
        var copy: Int = copies.copyAtFallback(index: index, fallback: -1)
        if copy < 0 {
          let point: Vec3 = forkPoint(mesh: mesh, index: index)
          let relative: Vec3 = vsub(a: point, b: center)
          copy = forkVertex(
            mesh: mesh
            point: point
            normal: forkNormal(mesh: mesh, index: index)
            u: 0.5 + vdot(a: relative, b: side) / (radius * 2.6)
            v: 0.5 + vdot(a: relative, b: across) / (radius * 2.6)
          )
          copies.set(index: index, value: copy)
        }
        mesh.indices.set(index: triangle * 3 + corner, value: copy)
      }
    }
  }
}

func compactForkSurface(mesh: view MeshData) ret MeshData {
  var result: MeshData = foliageMesh()
  var indices: List(Int) = List.create(Int, cap: mesh.vertCount)
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    indices.add(value: -1)
  }
  loop let index: Int in mesh.indices {
    var replacement: Int = indices.copyAtDefault(index: index)
    if replacement < 0 {
      replacement = forkVertex(
        mesh: result
        point: forkPoint(mesh: mesh, index: index)
        normal: forkNormal(mesh: mesh, index: index)
        u: mesh.verts.copyAtDefault(index: index * 8 + 6)
        v: mesh.verts.copyAtDefault(index: index * 8 + 7)
      )
      indices.set(index: index, value: replacement)
    }
    result.indices.add(value: replacement)
  }
  ret result
}
