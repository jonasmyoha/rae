# stylizedTrees/StylizedTrees — the stylized tree set, the walkers'
# (docs/tree-sets-design.md): createStylizedTrees is the set's data
# (treeSets/TreeSet), the rest builds its kinds and pictures. Every species
# but the umbrella pine is a treeGen kind (stylizedTrees/StylizedKinds,
# docs/stylized-trees-new-technique.md), as is the bush; the warm
# broadleaf's varieties are the T02 tree (stylizedTrees/ReferenceTrees).
# The umbrella pine keeps Autumn Grove's leaf-patch form (stylizedTrees/
# FluffyFoliage), unit height, its width built into its meshes. Each
# species becomes an app3d/PropField kind at three levels of detail
# (addStylizedForestKinds): near, middle, and an impostor of the near level
# baked on the GPU from every side (lib/ImpostorBake). Used by the walkers
# (136, 137, 143).
import Math
import Sys
import Vec3
import RendererDeferred
open FoliageMesh
open RendererImages
open Noise
open Scene3d
open Mesh3d
open GbufferInstanced
open stylizedTrees/FluffyFoliage
open app3d/PropField
open app3d/PropInstancer
open GbufferSprite
open gpu/GpuResources
open ImpostorAtlas
open ImpostorBake
open treeSets/TreeSet
open treeGen/TreeKind
open stylizedTrees/StylizedKinds

# Stable legacy kind: small-leaved lime (Tilia cordata), never renumbered.
const speciesBroadleaf: Int = 0

const speciesUmbrella: Int = 1

const speciesCypress: Int = 2

const speciesSpruce: Int = 3

# The autumn broadleaves: orange, red, gold and crimson leaves
const speciesOrange: Int = 4

const speciesRed: Int = 5

const speciesGold: Int = 6

const speciesCrimson: Int = 7

const speciesPalm: Int = 8

const speciesBirch: Int = 9

const stylizedSpeciesCount: Int = 10

# The warm broadleaf: the T02 tree from the tree lab (lib/treeGen,
# stylizedTrees/ReferenceTrees), docs/reference-tree-plan.md step 9: five
# kinds after the ten above, the traced tree and the four grown varieties.
# It takes the umbrella pine's (speciesUmbrella) place in the stands
# (2026-10-28: not the lime's); RAE_STYLIZED_UMBRELLA=1 keeps
# the umbrella pine there instead, until the change is accepted.
const speciesWarmBroadleaf: Int = 10

const stylizedWarmBroadleafVarieties: Int = 5

# The height (m) the autumn trees and the palm are built at; a placement
# scales them from it
const autumnReferenceHeight: Float = 5.5

# The stylized set (treeSets/TreeSet): its ten species, in the order of the
# species constants above, and its stands: the leaf-patch broadleaf and
# spruce most, then the autumn trees, the umbrella pine and cypress; among
# the mixed-in trees now and then a palm (a crimson maple or a palm is never
# a stand's main species)
func createStylizedTrees() ret TreeSet {
  var species: List(TreeSpecies) = List(TreeSpecies) {
    { name: "lime", minHeight: 4.8, heightRange: 2.4, heightUnit: 1.0 }
    { name: "umbrella pine", minHeight: 5.6, heightRange: 1.8, heightUnit: 1.0 }
    { name: "cypress", minHeight: 8.0, heightRange: 3.5, heightUnit: 1.0 }
    { name: "spruce", minHeight: 5.5, heightRange: 3.0, heightUnit: 1.0 }
    { name: "sugar maple", minHeight: 4.2, heightRange: 2.6, heightUnit: autumnReferenceHeight }
    { name: "red maple", minHeight: 4.2, heightRange: 2.6, heightUnit: autumnReferenceHeight }
    { name: "ginkgo", minHeight: 4.2, heightRange: 2.6, heightUnit: autumnReferenceHeight }
    { name: "japanese maple", minHeight: 3.2, heightRange: 1.6, heightUnit: autumnReferenceHeight }
    { name: "palm", minHeight: 5.0, heightRange: 1.5, heightUnit: autumnReferenceHeight }
    { name: "birch", minHeight: 6.5, heightRange: 2.0, heightUnit: autumnReferenceHeight }
    { name: "warm broadleaf (T02)", minHeight: 10.0, heightRange: 3.0, heightUnit: referenceTreeHeight }
    { name: "warm broadleaf 1", minHeight: 10.0, heightRange: 3.0, heightUnit: referenceTreeHeight }
    { name: "warm broadleaf 2", minHeight: 10.0, heightRange: 3.0, heightUnit: referenceTreeHeight }
    { name: "warm broadleaf 3", minHeight: 10.0, heightRange: 3.0, heightUnit: referenceTreeHeight }
    { name: "warm broadleaf 4", minHeight: 10.0, heightRange: 3.0, heightUnit: referenceTreeHeight }
  }
  # a rebuilt tree's height at scale 1 is its grown height (StylizedKinds)
  setStylizedHeightUnits(species: species)

  var standPicks: List(SpeciesPick) = List(SpeciesPick) {
    { upTo: 0.12, species: speciesBirch }
    { upTo: 0.26, species: speciesBroadleaf }
    { upTo: 0.40, species: speciesSpruce }
    { upTo: 0.46, species: speciesUmbrella }
    { upTo: 0.56, species: speciesCypress }
    { upTo: 0.67, species: speciesOrange }
    { upTo: 0.78, species: speciesRed }
    { upTo: 1.0, species: speciesGold }
  }
  var mixedPicks: List(SpeciesPick) = List(SpeciesPick) {
    { upTo: 0.12, species: speciesBirch }
    { upTo: 0.26, species: speciesBroadleaf }
    { upTo: 0.40, species: speciesSpruce }
    { upTo: 0.46, species: speciesUmbrella }
    { upTo: 0.56, species: speciesCypress }
    { upTo: 0.67, species: speciesOrange }
    { upTo: 0.78, species: speciesRed }
    { upTo: 0.88, species: speciesGold }
    { upTo: 0.96, species: speciesCrimson }
    { upTo: 1.0, species: speciesPalm }
  }
  # the warm broadleaf takes the umbrella pine's share of the picks
  # (0.40 - 0.46)
  if Sys.getEnv(name: "RAE_STYLIZED_UMBRELLA") is not "1" {
    standPicks = warmBroadleafPicks(picks: standPicks)
    mixedPicks = warmBroadleafPicks(picks: mixedPicks)
  }
  ret TreeSet {
    name: "stylized"
    style: TreeSetStyle.stylized
    species: species
    standSize: 36.0
    mixedShare: 0.3
    standPicks: standPicks
    mixedPicks: mixedPicks
  }
}

# The umbrella pine's leaf-patch form
func treeSpeciesForm(species: view Int) ret FluffyForm {
  ret FluffyForm.umbrella
}

# The umbrella pine's leaves per tone (as Autumn Grove painted them)
func leafColor(form: view FluffyForm, tone: view Int) ret Vec3 {
  let variation: Float = 0.86 + tone.toFloat() * 0.12
  ret Vec3.vscale(a: Vec3.create(x: 0.055, y: 0.19, z: 0.09), s: variation)
}

func foliageMaterial(color: view Vec3) ret Material3d {
  ret Material3d {
    baseColor: color
    metallic: 0.0
    roughness: 1.0
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: true
  }
}

# The umbrella pine's levels of detail: patches per crown cluster, and how
# far each is drawn. Shadows reach 120 m; every level casts them. The near
# level is the crown's outline (stylizedTrees/FluffyFoliage): the coarser
# one is built to cover what it does (docs/tree-lod-design.md §2.1, checked
# by app3d/TreeCoverage, case 1228)
const nearPatches: Int = fluffyOutlinePatches

const midPatches: Int = 14

const nearTreeDistance: Float = 30.0

# How much wider than a unit form the umbrella pine is (PropField scales
# uniformly, so the width is built into its meshes)
const umbrellaWidth: Float = 1.1

# Stretch a mesh across (x and y) by `factor`, its normals the inverse way
func widenMesh(mesh: mod MeshData, factor: view Float) {
  if factor is 1.0 {
    ret
  }
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    if vertex * 4 + 3 < mesh.windPivots.length {
      loop var axis: Int = 0, axis < 2, ++axis {
        let index: Int = vertex * 4 + axis
        mesh.windPivots.set(
          index: index
          value: mesh.windPivots.copyAtFallback(index: index, fallback: 0.0) * factor
        )
      }
    }
    if vertex * 4 + 3 < mesh.leafCards.length {
      loop var axis: Int = 0, axis < 2, ++axis {
        let index: Int = vertex * 4 + axis
        mesh.leafCards.set(index: index, value: mesh.leafCards.copyAtDefault(index: index) * factor)
      }
    }
    let base: Int = vertex * 8
    mesh.verts.set(
      index: base
      value: mesh.verts.copyAtFallback(index: base, fallback: 0.0) * factor
    )
    mesh.verts.set(
      index: base + 1
      value: mesh.verts.copyAtFallback(index: base + 1, fallback: 0.0) * factor
    )
    let normal: Vec3 = Vec3.vnorm(
      a: Vec3.create(
        x: mesh.verts.copyAtFallback(index: base + 3, fallback: 0.0) / factor
        y: mesh.verts.copyAtFallback(index: base + 4, fallback: 0.0) / factor
        z: mesh.verts.copyAtFallback(index: base + 5, fallback: 1.0)
      )
    )
    mesh.verts.set(index: base + 3, value: normal.x)
    mesh.verts.set(index: base + 4, value: normal.y)
    mesh.verts.set(index: base + 5, value: normal.z)
  }
}

# The umbrella pine's wood
func speciesWoodMesh(species: view Int) ret MeshData {
  var wood: MeshData = fluffyWood(form: FluffyForm.umbrella, seed: 73)
  widenMesh(mesh: wood, factor: umbrellaWidth)
  ret wood
}

# The umbrella pine's leaves in one tone at `patches` patches a cluster
func speciesLeavesMesh(species: view Int, tone: view Int, patches: view Int) ret MeshData {
  var crown: MeshData = fluffyLeaves(
    form: FluffyForm.umbrella
    seed: 73
    patchCount: patches
    tone: tone
  )
  widenMesh(mesh: crown, factor: umbrellaWidth)
  loop var vertex: Int = 0, vertex < crown.windPivots.length / 4, ++vertex {
    crown.windPivots.set(index: vertex * 4 + 3, value: 0.55)
  }
  ret crown
}

# The color of the umbrella pine's wood
func speciesWoodColor() ret Vec3 {
  ret Vec3.create(x: 0.13, y: 0.075, z: 0.04)
}

# A level of the umbrella pine as mesh data (also app3d/TreeCoverage's
# parts): its wood, then its leaves in three tones, at `patches` patches
func speciesLevelMeshes(species: view Int, patches: view Int) ret List(MeshData) {
  var meshes: List(MeshData) = List.create(MeshData, cap: 4)
  meshes.add(value: speciesWoodMesh(species: species))
  loop var tone: Int = 0, tone < 3, ++tone {
    meshes.add(value: speciesLeavesMesh(species: species, tone: tone, patches: patches))
  }
  ret meshes
}

# The albedos of a level's meshes, in speciesLevelMeshes' order
func speciesAlbedos(species: view Int) ret List(Vec3) {
  var albedos: List(Vec3) = List.create(Vec3, cap: 4)
  albedos.add(value: speciesWoodColor())
  loop var tone: Int = 0, tone < 3, ++tone {
    albedos.add(value: leafColor(form: FluffyForm.umbrella, tone: tone))
  }
  ret albedos
}

# A level of uploaded meshes, each in the foliage material of its albedo
func speciesLodOf(
  meshes: view List(MeshHandle)
  albedos: view List(Vec3)
  maxDistance: view Float
  castsShadow: view Bool
) ret PropLod {
  var parts: List(PropPart) = List.create(PropPart, cap: meshes.length)
  loop var part: Int = 0, part < meshes.length, ++part {
    # Part 0 is the wood, which stays still; the rest are leaves
    var sway: Float = groveLeafSway
    if part is 0 {
      sway = 0.0
    }
    parts.add(
      value: {
        mesh: meshes.copyAtDefault(index: part)
        material: foliageMaterial(
          color: albedos.copyAtFallback(index: part, fallback: speciesWoodColor())
        )
        sway: sway
      }
    )
  }
  ret PropLod {
    parts: own parts
    maxDistance: maxDistance
    castsShadow: castsShadow
    facesCamera: false
  }
}

# The umbrella pine as a PropField kind: near and middle crowns and its
# impostor (`layer` of the atlas); returns its impostor subject
func addUmbrellaKind(
  field: mod PropField
  renderer: mod DeferredRenderer
  layer: view Int
  midDistance: view Float
  farDistance: view Float
) ret ImpostorSubject {
  # the near level's meshes, made once: drawn near, and baked into the
  # impostor (their bounds frame it)
  let nearMeshes: List(MeshData) = speciesLevelMeshes(
    species: speciesUmbrella
    patches: nearPatches
  )
  let albedos: List(Vec3) = speciesAlbedos(species: speciesUmbrella)
  var nearHandles: List(MeshHandle) = List.create(MeshHandle, cap: nearMeshes.length)
  loop let mesh: view MeshData in nearMeshes {
    nearHandles.add(value: uploadFoliage(renderer: renderer, mesh: mesh))
  }
  var middleHandles: List(MeshHandle) = List.create(MeshHandle, cap: 4)
  middleHandles.add(value: nearHandles.copyAtDefault(index: 0))
  loop var tone: Int = 0, tone < 3, ++tone {
    middleHandles.add(
      value: uploadFoliage(
        renderer: renderer
        mesh: speciesLeavesMesh(species: speciesUmbrella, tone: tone, patches: midPatches)
      )
    )
  }
  let subject: ImpostorSubject = impostorSubject(
    parts: nearMeshes
    meshes: nearHandles
    albedos: albedos
  )
  var lods: List(PropLod) = List.create(PropLod, cap: 3)
  lods.add(value: speciesLodOf(
    meshes: nearHandles
    albedos: albedos
    maxDistance: nearTreeDistance
    castsShadow: true
  ))
  lods.add(value: speciesLodOf(
    meshes: middleHandles
    albedos: albedos
    maxDistance: midDistance
    castsShadow: true
  ))
  lods.add(
    value: {
      parts: List.create(PropPart, cap: 0)
      maxDistance: farDistance
      castsShadow: true
      facesCamera: true
    }
  )
  # the sphere round the unit-height tree at scale 1
  let kind: Int = addPropKind(
    field: field
    kind: { lods: own lods, radius: 0.6 * umbrellaWidth + 0.1, centerHeight: 0.55 }
  )
  setPropKindSprite(
    field: field
    kind: kind
    layer: layer
    height: subject.height
  )
  ret subject
}

# Every tree species as a PropField kind (kind index = species) at three
# levels of detail, then the warm broadleaf's varieties and the bush, and
# their impostors baked into one atlas (a layer each, drawn by the sprite
# pass). `midDistance` is where the middle levels end (keep it inside the
# shadows' reach), `farDistance` where the impostors end.
func addStylizedForestKinds(
  field: mod PropField
  renderer: mod DeferredRenderer
  sprites: mod SpriteCache
  midDistance: view Float
  farDistance: view Float
) {
  RendererDeferred.ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources = renderer.gpuResources {
    spriteSetParams(
      cache: sprites
      resources: resources
      heightK: 1.0
      aspect: spritePictureAspect
      cutoff: spriteCutoff
      time: 0.0
      tilt: 0.0
    )
  }
  var subjects: List(ImpostorSubject) = List.create(ImpostorSubject, cap: stylizedSpeciesCount)
  let warmEnds: Vec3 = referenceLevelEnds(midDistance: midDistance, farDistance: farDistance)
  loop var species: Int = 0, species < stylizedSpeciesCount, ++species {
    # a tree rebuilt in treeGen's technique (StylizedKinds)
    if stylizedNewKind(species: species) {
      subjects.add(value: addStylizedNewKind(
        field: field
        renderer: renderer
        species: species
        ends: warmEnds
      ))
    } else {
      subjects.add(value: addUmbrellaKind(
        field: field
        renderer: renderer
        layer: species
        midDistance: midDistance
        farDistance: farDistance
      ))
    }
  }
  # the warm broadleaf's varieties (ReferenceTrees), their pictures in the
  # same atlas after the ten above
  let warmKind: TreeKind = warmBroadleafKind()
  let warmImages: ReferenceImages = referenceImages(renderer: renderer, treeKind: warmKind)
  loop var variety: Int = 0, variety < stylizedWarmBroadleafVarieties, ++variety {
    subjects.add(value: addReferenceKind(
      field: field
      renderer: renderer
      treeKind: warmKind
      variety: variety
      layer: speciesWarmBroadleaf + variety
      images: warmImages
      ends: warmEnds
    ))
  }
  # the bush (StylizedKinds), a kind after the trees'
  subjects.add(value: addStylizedBushKind(field: field, renderer: renderer, ends: warmEnds))
  # the rebuilt kinds' pictures were queued (referenceImages): build once
  rendererFlushSurfaceImages(renderer: renderer)
  if let resources: mod GpuResources = renderer.gpuResources {
    let atlas: ImpostorAtlas = bakeTexturedImpostorAtlas(
      resources: resources
      meshes: renderer.passes.gbuffer.meshes
      subjects: subjects
      settings: defaultImpostorSettings()
      cutoff: spriteCutoff
      images: renderer.passes.gbuffer.surfaceImages
    )
    setSpriteImpostors(cache: sprites, resources: resources, atlas: atlas)
  }
}

# How much the umbrella pine's leaves move in the wind (lib/wind.wgsl).
# Only the leaves sway: its wood (part 0 of each level) stays still.
const groveLeafSway: Float = 1.0
