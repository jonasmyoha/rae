# stylizedTrees/ReferenceTrees — the T02 tree (lib/treeGen) as a tree set
# of its own, for judging it at every distance before it joins the stylized
# set (docs/reference-tree-plan.md step 7; step 9 adds it to StylizedTrees).
# Its species: 0 the traced T02 tree (treeGen/TreeParams
# warmBroadleafParams, the tree lab's T02 scene), 1-4 the grown varieties
# (treeGen/TreeGrower seeds 1-4, 143's stand).
# Each becomes a PropField kind (addReferenceForestKinds) at the walkers'
# distances: near, the bark and every leaf card (treeGen/TreeLevels: the
# cards in three tones as camera-facing card meshes); middle, the bark and a
# part of the cards (the kind's middleKeep) wider (middleGrow), so the clump layout and the
# covered area stay; far, an impostor baked from the near level.
# RAE_TREE_LEVEL=near|middle|far shows only that level at every distance,
# for comparing the levels from one camera.
import Math
import Sys
import Vec3
import RendererDeferred
open FoliageMesh
open RendererImages
open Scene3d
open Mesh3d
open app3d/PropField
open GbufferSprite
open gpu/GpuResources
open ImpostorAtlas
open ImpostorBake
open treeSets/TreeSet
open treeGen/TreeParams
open treeGen/Skeleton
open treeGen/TreeGrower
open treeGen/BarkMesh
open treeGen/Bark
open treeGen/LeafCards
open treeGen/TreeLevels
open treeGen/TreeKind
open treeGen/ShelfCards

const referenceSpeciesCount: Int = 5

# The grown tree's height (m) at scale 1, about: a placement's scale is its
# height over this
const referenceTreeHeight: Float = 13.5

# A kind's bark picture, painted once
func referenceBarkPath(treeKind: view TreeKind) ret String {
  ret ".rae/treeGen/{treeKind.name}Bark.png"
}

# Where the near level ends (the walkers': StylizedTrees.nearTreeDistance)
const referenceNearDistance: Float = 30.0

# The leaves sway in the wind, the bark (part 0) stays still
const referenceLeafSway: Float = 1.0

# The T02 set: four varieties, each 11.5 to 14 m tall, in stands as the
# walkers plant theirs
func createReferenceTrees() ret TreeSet {
  ret TreeSet {
    name: "reference"
    style: TreeSetStyle.reference
    species: List(TreeSpecies) {
      { name: "T02 traced", minHeight: 11.5, heightRange: 2.5, heightUnit: referenceTreeHeight }
      { name: "T02 1", minHeight: 11.5, heightRange: 2.5, heightUnit: referenceTreeHeight }
      { name: "T02 2", minHeight: 11.5, heightRange: 2.5, heightUnit: referenceTreeHeight }
      { name: "T02 3", minHeight: 11.5, heightRange: 2.5, heightUnit: referenceTreeHeight }
      { name: "T02 4", minHeight: 11.5, heightRange: 2.5, heightUnit: referenceTreeHeight }
    }
    standSize: 36.0
    mixedShare: 0.3
    standPicks: List(SpeciesPick) {
      { upTo: 0.2, species: 0 }
      { upTo: 0.4, species: 1 }
      { upTo: 0.6, species: 2 }
      { upTo: 0.8, species: 3 }
      { upTo: 1.0, species: 4 }
    }
    mixedPicks: List(SpeciesPick) {
      { upTo: 0.2, species: 0 }
      { upTo: 0.4, species: 1 }
      { upTo: 0.6, species: 2 }
      { upTo: 0.8, species: 3 }
      { upTo: 1.0, species: 4 }
    }
  }
}

func referenceLeafMaterial(color: view Vec3, layer: view Int) ret Material3d {
  ret Material3d {
    baseColor: color
    metallic: 0.0
    # as the leaf pass writes them: rough, no sky rim round each card
    roughness: 0.8
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: false
    colorTextureLayer: layer
    rimLight: false
  }
}

# A level of uploaded meshes: part 0 the bark, the rest the leaf tones
func referenceLod(
  meshes: view List(MeshHandle)
  bark: view Material3d
  albedos: view List(Vec3)
  leafLayer: view Int
  maxDistance: view Float
) ret PropLod {
  var parts: List(PropPart) = List.create(PropPart, cap: meshes.length)
  loop var part: Int = 0, part < meshes.length, ++part {
    if part is 0 {
      parts.add(value: { mesh: meshes.copyAtDefault(index: 0), material: bark, sway: 0.0 })
    } else {
      parts.add(
        value: {
          mesh: meshes.copyAtDefault(index: part)
          material: referenceLeafMaterial(
            color: albedos.copyAtFallback(
              index: part - 1
              fallback: Vec3.create(x: 0.2, y: 0.3, z: 0.1)
            )
            layer: leafLayer
          )
          sway: referenceLeafSway
        }
      )
    }
  }
  ret PropLod { parts: own parts, maxDistance: maxDistance, castsShadow: true, facesCamera: false }
}

# The highest point and the farthest reach from the trunk of `meshes` (at
# scale 1)
func referenceBounds(meshes: view List(MeshData)) ret Vec3 {
  var reach: Float = 0.0
  var top: Float = 0.0
  loop let mesh: view MeshData in meshes {
    loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
      let x: Float = mesh.verts.copyAtDefault(index: vertex * 8)
      let y: Float = mesh.verts.copyAtDefault(index: vertex * 8 + 1)
      let z: Float = mesh.verts.copyAtDefault(index: vertex * 8 + 2)
      reach = Math.max(a: reach, b: Math.sqrt(x: x * x + y * y))
      top = Math.max(a: top, b: z)
    }
  }
  ret Vec3.create(x: reach, y: reach, z: top)
}

# The material images a tree kind uses: the bark picture, the leaf stamp
# and the impostor's filled leaf outline (TreeLevels), added once per
# renderer and kind
type ReferenceImages {
  barkLayer: Int
  leafLayer: Int
  impostorLeafLayer: Int
}

# The kind's pictures, queued (RendererImages.rendererQueueSurfaceImage):
# the caller builds them with rendererFlushSurfaceImages once all kinds are
# added, before baking or drawing with them
func referenceImages(renderer: mod DeferredRenderer, treeKind: view TreeKind) ret ReferenceImages {
  let barkPath: String = referenceBarkPath(treeKind: treeKind)
  if not Sys.exists(path: barkPath) {
    let made: Bool = Sys.makeDir(path: ".rae/treeGen")
    let written: Bool = writeBarkImage(barkKind: treeKind.bark, path: barkPath)
  }
  ret ReferenceImages {
    barkLayer: rendererQueueSurfaceImage(renderer: renderer, path: barkPath)
    leafLayer: rendererQueueSurfaceImagePixels(
      renderer: renderer
      name: leafCardImageName(treeKind: treeKind)
      pixels: leafCardImagePixels(leafKind: treeKind.leaf)
    )
    impostorLeafLayer: rendererQueueSurfaceImagePixels(
      renderer: renderer
      name: leafImpostorImageName(treeKind: treeKind)
      pixels: leafImpostorImagePixels(leafKind: treeKind.leaf)
    )
  }
}

# Where a T02 kind's levels end (x near, y middle, z far): the walkers'
# distances, or with RAE_TREE_LEVEL=near|middle|far that level only
func referenceLevelEnds(midDistance: view Float, farDistance: view Float) ret Vec3 {
  let only: String = Sys.getEnv(name: "RAE_TREE_LEVEL")
  if only is "near" {
    ret Vec3.create(x: 100000.0, y: midDistance, z: farDistance)
  }
  if only is "middle" {
    ret Vec3.create(x: 0.0, y: 100000.0, z: farDistance)
  }
  if only is "far" {
    ret Vec3.create(x: 0.0, y: 0.0, z: 100000.0)
  }
  ret Vec3.create(x: referenceNearDistance, y: midDistance, z: farDistance)
}

# The parts of one level of `treeKind`'s variety `variety` (no renderer):
# the bark, then the leaf tones of every `keepEvery`-th card grown `grow`
# times (1, 1.0: the near level), for checks such as level coverage
func referenceLevelParts(
  treeKind: view TreeKind
  variety: view Int
  keepEvery: view Int
  grow: view Float
) ret List(MeshData) {
  let skeleton: TreeSkeleton = growSkeleton(
    params: kindParams(treeKind: treeKind, variety: variety)
  )
  let leaves: KindLeafLevels = kindLeafLevels(
    skeleton: skeleton
    treeKind: treeKind
    variety: variety
    keepEvery: keepEvery
    grow: grow
  )
  var parts: List(MeshData) = List.create(MeshData, cap: 4)
  parts.add(value: kindBarkMesh(skeleton: skeleton, treeKind: treeKind))
  loop let mesh: view MeshData in leaves.middle.meshes {
    parts.add(value: mesh)
  }
  ret parts
}

# The wood a kind shows: the whole skeleton, or a whorled tree's lower
# trunk only (ShelfCards.lowerTrunkSkeleton)
func kindBarkMesh(skeleton: view TreeSkeleton, treeKind: view TreeKind) ret MeshData {
  if treeKind.foliage is TreeFoliage.shelves {
    ret barkMesh(skeleton: lowerTrunkSkeleton(skeleton: skeleton, overlap: 0.4))
  }
  ret barkMesh(skeleton: skeleton)
}

# A kind's leaves at two levels: `near` (every card) and `middle` (every
# `keepEvery`-th, `grow` times as big), and how many cards there are
type KindLeafLevels {
  near: LeafCardLevel
  middle: LeafCardLevel
  count: Int
}

# The leaf levels of `treeKind`'s variety on `skeleton`: masses filled with
# camera-facing cards (LeafCards), or a conifer's shelves (ShelfCards)
func kindLeafLevels(
  skeleton: view TreeSkeleton
  treeKind: view TreeKind
  variety: view Int
  keepEvery: view Int
  grow: view Float
) ret KindLeafLevels {
  let seed: Int = kindCardSeed(treeKind: treeKind, variety: variety)
  if treeKind.foliage is TreeFoliage.shelves {
    let shelves: ShelfCards = shelfCards(skeleton: skeleton, treeKind: treeKind, seed: seed)
    ret KindLeafLevels {
      near: shelfCardLevel(shelves: shelves, keepEvery: 1, grow: 1.0)
      middle: shelfCardLevel(shelves: shelves, keepEvery: keepEvery, grow: grow)
      count: shelves.count
    }
  }
  let cards: LeafCards = leafCards(skeleton: skeleton, treeKind: treeKind, seed: seed)
  ret KindLeafLevels {
    near: leafCardLevel(cards: cards, keepEvery: 1, grow: 1.0)
    middle: leafCardLevel(cards: cards, keepEvery: keepEvery, grow: grow)
    count: cards.count
  }
}

# One variety of tree kind `treeKind` (T02: 0 the traced tree, 1-4 the grown
# ones) as a kind of `field`, its picture layer `layer` of the impostor
# atlas the caller bakes from the returned subject (the stylized set bakes
# it with its own species); `images` the kind's (referenceImages)
func addReferenceKind(
  field: mod PropField
  renderer: mod DeferredRenderer
  treeKind: view TreeKind
  variety: view Int
  layer: view Int
  images: view ReferenceImages
  ends: view Vec3
) ret ImpostorSubject {
  let params: TreeParams = kindParams(treeKind: treeKind, variety: variety)
  let skeleton: TreeSkeleton = growSkeleton(params: params)
  let barkData: MeshData = kindBarkMesh(skeleton: skeleton, treeKind: treeKind)
  let leaves: KindLeafLevels = kindLeafLevels(
    skeleton: skeleton
    treeKind: treeKind
    variety: variety
    keepEvery: treeKind.middleKeep
    grow: treeKind.middleGrow
  )
  let nearLeaves: LeafCardLevel = leaves.near
  let middleLeaves: LeafCardLevel = leaves.middle
  let bark: Material3d = barkMaterial(barkKind: treeKind.bark, layer: images.barkLayer)
  let barkHandle: MeshHandle = uploadFoliage(renderer: renderer, mesh: barkData)
  let barkTriangles: Int = barkData.indices.length / 3
  var nearParts: List(MeshData) = List.create(MeshData, cap: 4)
  nearParts.add(value: barkData)
  var nearHandles: List(MeshHandle) = List.create(MeshHandle, cap: 4)
  nearHandles.add(value: barkHandle)
  loop let mesh: view MeshData in nearLeaves.meshes {
    nearParts.add(value: mesh)
    nearHandles.add(value: uploadFoliage(renderer: renderer, mesh: mesh))
  }
  var middleHandles: List(MeshHandle) = List.create(MeshHandle, cap: 4)
  middleHandles.add(value: barkHandle)
  loop let mesh: view MeshData in middleLeaves.meshes {
    middleHandles.add(value: uploadFoliage(renderer: renderer, mesh: mesh))
  }
  # the impostor: the near level, the bark and the leaves with their
  # pictures
  var albedos: List(Vec3) = List.create(Vec3, cap: 4)
  albedos.add(value: treeKind.bark.color)
  loop let albedo: view Vec3 in nearLeaves.albedos {
    albedos.add(value: albedo)
  }
  var subject: ImpostorSubject = impostorSubject(
    parts: nearParts
    meshes: nearHandles
    albedos: albedos
  )
  subject.cardNormalsToEye = true
  subject.imageLayers = List(Int) {
    images.barkLayer
    images.impostorLeafLayer
    images.impostorLeafLayer
    images.impostorLeafLayer
  }
  var lods: List(PropLod) = List.create(PropLod, cap: 3)
  lods.add(value: referenceLod(
    meshes: nearHandles
    bark: bark
    albedos: nearLeaves.albedos
    leafLayer: images.leafLayer
    maxDistance: ends.x
  ))
  lods.add(value: referenceLod(
    meshes: middleHandles
    bark: bark
    albedos: middleLeaves.albedos
    leafLayer: images.leafLayer
    maxDistance: ends.y
  ))
  lods.add(
    value: {
      parts: List.create(PropPart, cap: 0)
      maxDistance: ends.z
      castsShadow: true
      facesCamera: true
    }
  )
  let bounds: Vec3 = referenceBounds(meshes: nearParts)
  let kind: Int = addPropKind(
    field: field
    kind: {
      lods: own lods
      radius: Math.sqrt(x: bounds.z * bounds.z * 0.25 + bounds.x * bounds.x) + 0.1
      centerHeight: bounds.z * 0.5
    }
  )
  setPropKindSprite(
    field: field
    kind: kind
    layer: layer
    height: subject.height
  )
  # the leaves have no sky rim (referenceLeafMaterial), so neither has the
  # impostor: its rim lit every clump's edge in the sky's color
  setPropKindSpriteRim(field: field, kind: kind, rimLight: false)
  var triangles: Int = barkTriangles
  var middleTriangles: Int = barkTriangles
  loop let mesh: view MeshData in nearLeaves.meshes {
    triangles = triangles + mesh.indices.length / 3
  }
  loop let mesh: view MeshData in middleLeaves.meshes {
    middleTriangles = middleTriangles + mesh.indices.length / 3
  }
  log(
    "[referenceTrees] {treeKind.name} variety {variety}: {leaves.count} leaf cards; {triangles} triangles near, {middleTriangles} middle; {bounds.z} m tall"
  )
  ret subject
}

# Every variety as a PropField kind (kind index = species) at three levels,
# the far one an impostor of the near level (a layer of the atlas baked
# here, drawn by the sprite pass)
func addReferenceForestKinds(
  field: mod PropField
  renderer: mod DeferredRenderer
  sprites: mod SpriteCache
  midDistance: view Float
  farDistance: view Float
) {
  RendererDeferred.ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources = renderer.gpuResources {
    spriteSetParams(
      cache: sprites
      resources: resources
      heightK: 1.0
      aspect: spritePictureAspect
      cutoff: spriteCutoff
      time: 0.0
      tilt: 0.0
    )
  }
  let treeKind: TreeKind = warmBroadleafKind()
  let images: ReferenceImages = referenceImages(renderer: renderer, treeKind: treeKind)
  let ends: Vec3 = referenceLevelEnds(midDistance: midDistance, farDistance: farDistance)
  var subjects: List(ImpostorSubject) = List.create(ImpostorSubject, cap: referenceSpeciesCount)
  loop var species: Int = 0, species < referenceSpeciesCount, ++species {
    subjects.add(value: addReferenceKind(
      field: field
      renderer: renderer
      treeKind: treeKind
      variety: species
      layer: species
      images: images
      ends: ends
    ))
  }
  # the kinds' pictures were queued (referenceImages): build them once
  rendererFlushSurfaceImages(renderer: renderer)
  if let resources: mod GpuResources = renderer.gpuResources {
    let atlas: ImpostorAtlas = bakeTexturedImpostorAtlas(
      resources: resources
      meshes: renderer.passes.gbuffer.meshes
      subjects: subjects
      settings: defaultImpostorSettings()
      cutoff: spriteCutoff
      images: renderer.passes.gbuffer.surfaceImages
    )
    setSpriteImpostors(cache: sprites, resources: resources, atlas: atlas)
  }
}
