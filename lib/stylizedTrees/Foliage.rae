# stylizedTrees/Foliage — the shared helpers of Autumn Grove's foliage
# meshes: a foliage mesh (lib/FoliageMesh's layout, with wind pivots), its
# vertices and faces, a basis round a direction, and tube wood (branches
# and limbs along points). Used by the umbrella pine's leaf-patch form
# (stylizedTrees/FluffyFoliage) and the meadow flowers (lib/procgen). Z-up;
# every generator is deterministic from its seed.
import Math
open Vec3
open Mesh3d
open Noise

func foliageMesh() ret MeshData {
  ret MeshData {
    verts: List.create(Float, cap: 8192)
    indices: List.create(Int, cap: 4096)
    vertCount: 0
  }
}

func foliageVertex(mesh: mod MeshData, point: view Vec3, normal: view Vec3) {
  pushVert(
    verts: mesh.verts
    px: point.x
    py: point.y
    pz: point.z
    nx: normal.x
    ny: normal.y
    nz: normal.z
    u: 0
    value: 0
  )
  mesh.vertCount = mesh.vertCount + 1
}

# Mark a complete rigid leaf patch after its vertices have been generated.
func foliagePivot(mesh: mod MeshData, first: view Int, pivot: view Vec3) {
  loop mesh.windPivots.length < first * 4 {
    mesh.windPivots.add(value: 0.0)
  }
  loop var vertex: Int = first, vertex < mesh.vertCount, ++vertex {
    mesh.windPivots.add(value: pivot.x)
    mesh.windPivots.add(value: pivot.y)
    mesh.windPivots.add(value: pivot.z)
    mesh.windPivots.add(value: 1.0)
  }
}

func foliageFace(
  mesh: mod MeshData
  first: view Vec3
  second: view Vec3
  third: view Vec3
) {
  let normal: Vec3 = vnorm(a: vcross(a: vsub(a: second, b: first), b: vsub(a: third, b: first)))
  let base: Int = mesh.vertCount
  foliageVertex(mesh: mesh, point: first, normal: normal)
  foliageVertex(mesh: mesh, point: second, normal: normal)
  foliageVertex(mesh: mesh, point: third, normal: normal)
  mesh.indices.add(value: base)
  mesh.indices.add(value: base + 1)
  mesh.indices.add(value: base + 2)
}

func foliageBasis(direction: view Vec3) ret Vec3 {
  if Math.abs(value: direction.z) > 0.9 {
    ret vnorm(a: vcross(a: direction, b: Vec3.create(x: 0, y: 1, z: 0)))
  }
  ret vnorm(a: vcross(a: direction, b: Vec3.create(x: 0, y: 0, z: 1)))
}

func foliageBranch(
  mesh: mod MeshData
  start: view Vec3
  end: view Vec3
  radius: view Float
  endRadius: view Float
) {
  let direction: Vec3 = vnorm(a: vsub(a: end, b: start))
  let side: Vec3 = foliageBasis(direction: direction)
  let across: Vec3 = vcross(a: direction, b: side)
  loop var i: Int = 0, i < 9, ++i {
    let angle: Float = i.toFloat() * 6.2831853 / 9
    let next: Float = (i + 1).toFloat() * 6.2831853 / 9
    let radial: Vec3 = vadd(
      a: vscale(a: side, s: Math.cos(x: angle))
      b: vscale(a: across, s: Math.sin(x: angle))
    )
    let nextRadial: Vec3 = vadd(
      a: vscale(a: side, s: Math.cos(x: next))
      b: vscale(a: across, s: Math.sin(x: next))
    )
    let lower: Vec3 = vadd(a: start, b: vscale(a: radial, s: radius))
    let lowerNext: Vec3 = vadd(a: start, b: vscale(a: nextRadial, s: radius))
    let upper: Vec3 = vadd(a: end, b: vscale(a: radial, s: endRadius))
    let upperNext: Vec3 = vadd(a: end, b: vscale(a: nextRadial, s: endRadius))
    foliageFace(
      mesh: mesh
      first: lower
      second: lowerNext
      third: upper
    )
    foliageFace(
      mesh: mesh
      first: upper
      second: lowerNext
      third: upperNext
    )
  }
}

# The direction a path of points runs at point `index`: through its two
# neighbors, one-sided at the ends
func foliageTangentAt(points: view List(Vec3), index: view Int) ret Vec3 {
  let last: Int = points.length - 1
  var before: Int = index - 1
  var after: Int = index + 1
  if before < 0 {
    before = 0
  }
  if after > last {
    after = last
  }
  let from: Vec3 = points.copyAtFallback(index: before, fallback: Vec3.create(x: 0, y: 0, z: 0))
  let to: Vec3 = points.copyAtFallback(index: after, fallback: Vec3.create(x: 0, y: 0, z: 1))
  ret vnorm(a: vsub(a: to, b: from))
}

# A continuous tube along `points` with one radius per point. Each point has one
# ring of `sides` vertices that the segments on both sides share, with smooth
# radial normals, so a limb tapers and bends without a step at any joint. The
# ring's orientation is carried along the path (each ring's side is the previous
# one with its along-the-path part removed), so a bending limb does not twist.
func foliageTube(
  mesh: mod MeshData
  points: view List(Vec3)
  radii: view List(Float)
  sides: view Int
) {
  if points.length < 2 {
    ret
  }
  let first: Int = mesh.vertCount
  var side: Vec3 = foliageBasis(direction: foliageTangentAt(points: points, index: 0))
  loop var i: Int = 0, i < points.length, ++i {
    let tangent: Vec3 = foliageTangentAt(points: points, index: i)
    side = vnorm(a: vsub(a: side, b: vscale(a: tangent, s: vdot(a: side, b: tangent))))
    let across: Vec3 = vcross(a: tangent, b: side)
    let center: Vec3 = points.copyAtFallback(index: i, fallback: Vec3.create(x: 0, y: 0, z: 0))
    let radius: Float = radii.copyAtFallback(index: i, fallback: 0.01)
    loop var k: Int = 0, k < sides, ++k {
      let angle: Float = k.toFloat() * 6.2831853 / sides.toFloat()
      let radial: Vec3 = vadd(
        a: vscale(a: side, s: Math.cos(x: angle))
        b: vscale(a: across, s: Math.sin(x: angle))
      )
      foliageVertex(
        mesh: mesh
        point: vadd(a: center, b: vscale(a: radial, s: radius))
        normal: radial
      )
    }
  }
  loop var i: Int = 0, i < points.length - 1, ++i {
    loop var k: Int = 0, k < sides, ++k {
      let lower: Int = first + i * sides + k
      let lowerNext: Int = first + i * sides + (k + 1) % sides
      mesh.indices.add(value: lower)
      mesh.indices.add(value: lowerNext)
      mesh.indices.add(value: lower + sides)
      mesh.indices.add(value: lower + sides)
      mesh.indices.add(value: lowerNext)
      mesh.indices.add(value: lowerNext + sides)
    }
  }
}

# One limb: a curve that leaves `start` along `direction` and bends upward by
# `rise` of its length, tapering from `startRadius` to `endRadius`
func foliageLimbPoint(
  start: view Vec3
  direction: view Vec3
  length: view Float
  rise: view Float
  t: view Float
) ret Vec3 {
  ret vadd(
    a: vadd(a: start, b: vscale(a: direction, s: length * t))
    b: Vec3.create(x: 0, y: 0, z: rise * length * t * t)
  )
}

func foliageLimb(
  mesh: mod MeshData
  start: view Vec3
  direction: view Vec3
  length: view Float
  rise: view Float
  startRadius: view Float
  endRadius: view Float
  sides: view Int
) {
  var points: List(Vec3) = List.create(Vec3, cap: 6)
  var radii: List(Float) = List.create(Float, cap: 6)
  loop var i: Int = 0, i < 6, ++i {
    let t: Float = i.toFloat() / 5
    points.add(value: foliageLimbPoint(
      start: start
      direction: direction
      length: length
      rise: rise
      t: t
    ))
    radii.add(value: startRadius + (endRadius - startRadius) * t)
  }
  foliageTube(
    mesh: mesh
    points: points
    radii: radii
    sides: sides
  )
}
