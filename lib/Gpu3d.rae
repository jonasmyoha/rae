# gpu3d — raster + bounded SDF backend of the unified 3D renderer.
#
# Renders `scene3d` triangle meshes (MeshRenderer components) with PBR
# lighting through wgpu-native into the same SDL3 window/surface gpu2d
# owns. An app opens the window with Gpu2d.initWindow(...) then drives
# frames with gpu3d. Single-sampled since #333 (MSAA dropped so depth is
# sampleable; TAA #335 takes over antialiasing): the scene pass writes
# linear HDR (rgba16f) plus depth/normal/velocity prepass targets, and the
# tonemap pass (#334) resolves HDR into gpu2d's persistent LDR offscreen,
# so present + RAE_GPU2D_SCREENSHOT + the 2D UI overlay all keep working
# unchanged.
#
# WORLD CONVENTION: right-handed Z-up (Blender) per
# `docs/coordinate-system.md`. Only mat4Perspective knows about WebGPU
# clip space; world space is Z-up everywhere.
#
# API SHAPE: the C ABI underneath is flat float buffers (packed frame
# block, 9 loose material floats per draw) because that is what crosses
# the extern boundary cheaply. That packing is an IMPLEMENTATION DETAIL —
# app code uses the typed `Camera3d`/`Light3d`/`Transform3d`/`Material3d`
# structs from lib/scene3d.rae and this module encodes them. Nobody
# should be counting magic float offsets in application code.
#
# A mesh is interleaved float data — 8 Floats per vertex: position xyz,
# normal xyz, uv — plus a triangle index list. Generate with
# lib/mesh3d.rae or build your own.
#
# Lighting (single uber-shader): Cook-Torrance GGX specular + Lambert
# diffuse, one directional sun, hemisphere ambient (sky/ground), emissive.
# The shader outputs LINEAR radiance; exposure + ACES + gamma happen once,
# in the tonemap pass — never inside material shaders (#334).
#
# KNOWN LIMITATION (queued): normals are transformed by the model matrix
# directly, so NON-UNIFORM scale skews lighting — use uniform scale per
# draw until the inverse-transpose normal matrix lands.
#
# Sphere SdfPrimitive components are submitted as one smooth-union metaball
# group using the first primitive's material. The fragment raymarch pass writes
# depth into the same attachment as meshes, so both geometry types occlude.
# Other SDF shapes and multiple material groups remain follow-up work.
#
# DRAW CAPACITY: the backend accepts at most 4096 mesh draws per frame.
# Additional draws are safely discarded and emit one renderer-lifetime error
# instead of failing silently. `RAE_GPU3D_DRAW_LIMIT=N` can lower the effective
# limit for diagnostics/tests, but cannot raise the hard capacity.
open Shadow3d
# The sun cascade shadow render moved to Rae (#504); endShadowPass calls it.
import GbufferShadow
# The sky the forward background draws (#418). sky.rae does not import this,
# so the dependency runs one way only.
open Sky
import Math
open Vec3
open Scene3d
open Math3d
open ecs/Entity  # #793: World3d shadow path reads entities/components
open ecs/ComponentTable
# The forward render pass is built in Rae over the WebGPU bindings (#514),
# the same way gbuffer.rae builds the deferred geometry pass.
open webgpu/Webgpu
open webgpu/Context
open Gpu2dCanvas
open MeshStore
open SkinStore
open gpu/GpuResources
open Gpu3dNative
open Gpu3dSky

# ----- raw C ABI (implementation detail; prefer the typed API below) ---
# The LDR offscreen the window presents is the app's Gpu2dCanvas's target
# (#920): the passes that write it take the canvas.
func nativeShutdown() unsafe extern("rae_ext_Gpu3d_shutdown")

func shutdown() {
  unsafe {
    nativeShutdown()
  }
}

# ----- frame parameter block (internal encoding) ----------------------
# `begin` takes a packed 36-Float block:
#   [0..15] viewProj (column-major)
#   [16..18] camera position        [19] time (seconds, for shaders)
#   [20..22] sun direction (toward the scene)   [23] exposure
#   [24..26] sun color * intensity
#   [27..29] ambient sky color
#   [30..32] ambient ground color
#   [33..35] clear color
type Frame3d {
  data: List(Float)
}

func createFrame3d() pub ret Frame3d {
  let d: List(Float) = List.create(Float, cap: 36)
  var i: Int = 0
  loop i < 36 {
    d.add(value: 0.0)
    i = i + 1
  }
  ret Frame3d { data: own d }
}

func setViewProj(frame: mod Frame3d, m: view Mat4) {
  var i: Int = 0
  loop i < 16 {
    frame.data.set(index: i, value: m.m[i])
    i = i + 1
  }
}

func setVec3At(frame: mod Frame3d, base: view Int, v: view Vec3) {
  frame.data.set(index: base, value: v.x)
  frame.data.set(index: base + 1, value: v.y)
  frame.data.set(index: base + 2, value: v.z)
}

func setTime(frame: mod Frame3d, t: view Float) pub {
  frame.data.set(index: 19, value: t)
}

# ----- typed renderer seam -------------------------------------------
# Encode a typed camera + light into the flat frame block and start the
# 3D pass. `aspect` is width/height of the target.
# #764: the forward-pass attachment lists (4 colour + 1 depth) and the one-slot
# post-process attachment list were module-level globals. They are pure per-call
# scratch — rebuilt in full every call, holding no state across frames; wgpu
# copies attachment contents at BeginRenderPass, so a local list whose .data stays
# valid for that one call is all the descriptor needs. So they are locals now, not
# a renderer resource (a value that can be a local is not a resource field).

# Encode a fullscreen post-process pass (#514): its own encoder + one-attachment
# render pass writing `target`, a triangle draw with `pipeline`+`bind`, then
# finish+submit — the shared shape of tonemap/taa/ssao, mirroring the deferred
# fullscreen passes. `loadOp` is WGPULoadOp_Clear for passes that overwrite every
# pixel, or WGPULoadOp_Load to blend into the existing target (the SSAO composite).
func fullscreenPostPass(
  target: copy Ptr
  pipeline: copy Ptr
  bind: copy Ptr
  loadOp: copy Int32
) {
  unsafe {
    let att: WGPURenderPassColorAttachment = {
      view_: target
      depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32
      loadOp: loadOp
      storeOp: WGPUStoreOp_Store
      clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 1.0 }
    }
    var postAtt: List(WGPURenderPassColorAttachment) = List.create(
      WGPURenderPassColorAttachment
      cap: 1
    )
    postAtt.add(value: att)
    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 1 as UInt64
      colorAttachments: postAtt.data
    }
    let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: pipeline)
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: bind
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
    wgpuRenderPassEncoderDraw(
      renderPassEncoder: pass
      vertexCount: 3 as UInt32
      instanceCount: 1 as UInt32
      firstVertex: 0 as UInt32
      firstInstance: 0 as UInt32
    )
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
    let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
    g3dSubmitCmd(cmd: cmd)
    wgpuCommandBufferRelease(commandBuffer: cmd)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
    wgpuCommandEncoderRelease(commandEncoder: enc)
  }
}

# Build the forward scene pass in Rae over the WebGPU bindings (#514). C has
# already packed+uploaded the frame uniform (g3dFramePrepare); here we open the
# 4-target + depth render pass and hand the encoder/pass to the C draw path.
# The four targets mirror the old C encoder exactly: HDR (clear = sky/bg colour),
# world normal, velocity, ambient (all clear to zero), depth (standard Z, far =
# 1.0). clearR/G/B are the frame's clearColor (frame[33..35]).
func beginForward(
  frame: view Buffer(Float)
  count: copy Int
  clearR: copy Float
  clearG: copy Float
  clearB: copy Float
) {
  unsafe {
    if g3dFramePrepare(frame: frame, count: count) is 0 {
      ret
    }

    let undefinedSlice: UInt32 = WGPU_DEPTH_SLICE_UNDEFINED as UInt32

    # 0: linear HDR; tonemap writes the offscreen (#334). Clear to the bg colour.
    let att0: WGPURenderPassColorAttachment = {
      view_: g3dHdrView()
      depthSlice: undefinedSlice
      loadOp: WGPULoadOp_Clear
      storeOp: WGPUStoreOp_Store
      clearValue: { r: clearR as Float64, g: clearG as Float64, b: clearB as Float64, a: 1.0 }
    }
    # 1: world normal (sampled by SSAO/GI). Clear to zero.
    let att1: WGPURenderPassColorAttachment = {
      view_: g3dNormalView()
      depthSlice: undefinedSlice
      loadOp: WGPULoadOp_Clear
      storeOp: WGPUStoreOp_Store
      clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    }
    # 2: velocity (sampled by TAA). Clear to zero motion.
    let att2: WGPURenderPassColorAttachment = {
      view_: g3dVelocityView()
      depthSlice: undefinedSlice
      loadOp: WGPULoadOp_Clear
      storeOp: WGPUStoreOp_Store
      clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    }
    # 3: ambient (sampled by the SSAO composite). Clear to zero.
    let att3: WGPURenderPassColorAttachment = {
      view_: g3dAmbientView()
      depthSlice: undefinedSlice
      loadOp: WGPULoadOp_Clear
      storeOp: WGPUStoreOp_Store
      clearValue: { r: 0.0, g: 0.0, b: 0.0, a: 0.0 }
    }
    var colorAtts: List(WGPURenderPassColorAttachment) = List.create(
      WGPURenderPassColorAttachment
      cap: 4
    )
    colorAtts.add(value: att0)
    colorAtts.add(value: att1)
    colorAtts.add(value: att2)
    colorAtts.add(value: att3)

    # Depth: standard Z here (forward), so the far plane clears to 1.0. (#333:
    # stored so it is sampleable by SSAO/TAA.)
    let depthAtt: WGPURenderPassDepthStencilAttachment = {
      view_: g3dDepthView()
      depthLoadOp: WGPULoadOp_Clear
      depthStoreOp: WGPUStoreOp_Store
      depthClearValue: 1.0
    }
    var depthAtts: List(WGPURenderPassDepthStencilAttachment) = List.create(
      WGPURenderPassDepthStencilAttachment
      cap: 1
    )
    depthAtts.add(value: depthAtt)

    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 4 as UInt64
      colorAttachments: colorAtts.data
      depthStencilAttachment: depthAtts.data
    }
    let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dPipeline())
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: g3dBind()
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
    g3dSetFrame(enc: enc, pass: pass)
  }
}

# Forward mesh draw (#514): encode one instanced DrawIndexed into the scene
# pass over the WebGPU bindings. C packs the per-draw record + returns the
# firstInstance slot (shared with metaballs/skinned, flushed by end()); Rae
# binds the mesh buffers and issues the draw. firstInstance = slot lets the
# shader pick its per-draw record, the same trick the deferred path uses.
func draw(
  meshes: view MeshStore
  resources: view GpuResources
  mesh: copy Int
  model: view Mat4
  prevModel: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  metallic: copy Float
  roughness: copy Float
  emR: copy Float
  emG: copy Float
  emB: copy Float
) {
  unsafe {
    let slot: Int = g3dPushDrawRecord(
      mesh: mesh
      model: model
      prevModel: prevModel
      r: r
      g: g
      b: b
      metallic: metallic
      emR: emR
      emG: emG
      emB: emB
      roughness: roughness
    )
    if slot < 0 {
      ret
    }
    let pass: Ptr = g3dPass()
    let vbuf: Ptr = meshStoreVbufHandle(store: meshes, resources: resources, mesh: mesh)
    let ibuf: Ptr = meshStoreIbufHandle(store: meshes, resources: resources, mesh: mesh)
    let icount: Int = meshStoreIndexCount(store: meshes, mesh: mesh)
    if vbuf is webgpuNull() or ibuf is webgpuNull() or icount <= 0 {
      ret
    }
    wgpuRenderPassEncoderSetVertexBuffer(
      renderPassEncoder: pass
      slot: 0 as UInt32
      buffer: vbuf
      offset: 0 as UInt64
      size: wgpuBufferGetSize(buffer: vbuf)
    )
    wgpuRenderPassEncoderSetIndexBuffer(
      renderPassEncoder: pass
      buffer: ibuf
      format: WGPUIndexFormat_Uint32
      offset: 0 as UInt64
      size: wgpuBufferGetSize(buffer: ibuf)
    )
    wgpuRenderPassEncoderDrawIndexed(
      renderPassEncoder: pass
      indexCount: icount as UInt32
      instanceCount: 1 as UInt32
      firstIndex: 0 as UInt32
      baseVertex: 0 as Int32
      firstInstance: slot as UInt32
    )
  }
}

# Forward metaball cluster draw (#514): encode the SDF raymarch fullscreen draw
# into the scene pass. C packs+uploads the cluster and returns its group slot;
# Rae binds the SDF pipeline + that slot's bind group, draws a fullscreen
# triangle, then restores the geometry pipeline/bind so following mesh draws
# use them.
func drawMetaballs(
  packedBalls: view Buffer(Float)
  count: copy Int
  packedColors: view Buffer(Float)
  smoothing: copy Float
  metallic: copy Float
  roughness: copy Float
  emR: copy Float
  emG: copy Float
  emB: copy Float
) {
  unsafe {
    let slot: Int = g3dPushMetaballCluster(
      packedBalls: packedBalls
      count: count
      packedColors: packedColors
      smoothing: smoothing
      metallic: metallic
      roughness: roughness
      emR: emR
      emG: emG
      emB: emB
    )
    if slot < 0 {
      ret
    }
    let pass: Ptr = g3dPass()
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dSdfPipeline())
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: g3dSdfBind(slot: slot)
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
    wgpuRenderPassEncoderDraw(
      renderPassEncoder: pass
      vertexCount: 3 as UInt32
      instanceCount: 1 as UInt32
      firstVertex: 0 as UInt32
      firstInstance: 0 as UInt32
    )
    # Restore the geometry pipeline/bind for subsequent mesh draws.
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dPipeline())
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: g3dBind()
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
  }
}

func beginScene(
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
  time: view Float
) pub {
  var frame: Frame3d = createFrame3d()
  let worldUp: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let viewM: Mat4 = mat4LookAt(
    eyeX: camera.position.x
    eyeY: camera.position.y
    eyeZ: camera.position.z
    atX: camera.target.x
    atY: camera.target.y
    atZ: camera.target.z
    upX: worldUp.x
    upY: worldUp.y
    upZ: worldUp.z
  )
  let proj: Mat4 = mat4Perspective(
    fovYDeg: camera.fovYDeg
    aspect: aspect
    near: camera.nearZ
    far: camera.farZ
  )
  let viewProj: Mat4 = mat4Mul(a: proj, b: viewM)
  setViewProj(frame: frame, m: viewProj)
  setVec3At(frame: frame, base: 16, v: camera.position)
  setTime(frame: frame, t: time)
  setVec3At(frame: frame, base: 20, v: light.sunDir)
  frame.data.set(index: 23, value: light.exposure)
  setVec3At(frame: frame, base: 24, v: light.sunColor)
  setVec3At(frame: frame, base: 27, v: light.ambSky)
  setVec3At(frame: frame, base: 30, v: light.ambGround)
  setVec3At(frame: frame, base: 33, v: light.clearColor)
  beginForward(
    frame: frame.data.data
    count: 36
    clearR: light.clearColor.x
    clearG: light.clearColor.y
    clearB: light.clearColor.z
  )
}

# Build a model matrix from a typed transform: M = T * Rz * Ry * Rx * S.
# Rotation is Euler XYZ radians, right-handed (yaw about +Z, pitch about
# +X) per docs/coordinate-system.md.
func modelMatrix(t: view Transform3d) pub ret Mat4 {
  let s: Mat4 = mat4ScaleXYZ(x: t.scale.x, y: t.scale.y, z: t.scale.z)
  let rx: Mat4 = mat4RotateX(angle: t.rotation.x)
  let ry: Mat4 = mat4RotateY(angle: t.rotation.y)
  let rz: Mat4 = mat4RotateZ(angle: t.rotation.z)
  let tr: Mat4 = mat4Translate(x: t.position.x, y: t.position.y, z: t.position.z)
  let rxs: Mat4 = mat4Mul(a: rx, b: s)
  let ryrxs: Mat4 = mat4Mul(a: ry, b: rxs)
  let rot: Mat4 = mat4Mul(a: rz, b: ryrxs)
  ret mat4Mul(a: tr, b: rot)
}

# Draw one mesh with a typed transform + material. `prevTransform` is
# where the instance was LAST frame; it drives per-object motion vectors
# for TAA (#335). Pass the same transform when an object did not move.
func drawInstance(
  meshes: view MeshStore
  resources: view GpuResources
  mesh: view MeshHandle
  transform: view Transform3d
  prevTransform: view Transform3d
  material: view Material3d
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  let model: Mat4 = modelMatrix(t: transform)
  let prevModel: Mat4 = modelMatrix(t: prevTransform)
  draw(
    meshes: meshes
    resources: resources
    mesh: mesh.id
    model: model
    prevModel: prevModel
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
    emR: material.emission.x
    emG: material.emission.y
    emB: material.emission.z
  )
}

# #793: the World3d twin of renderSceneShadow — the shadow-caster pass over a
# World3d, reading each mesh entity's Transform3d through ECS queries. Lifted
# from 112/114's open-coded renderMeshShadow (#736) into shared lib.
func renderSceneShadowWorld(
  meshes: view MeshStore
  resources: view GpuResources
  world: view World3d
) pub {
  loop var j: Int = 0, j < componentCount(this: world.meshRenderers), ++j {
    let entity: EntityId = componentEntityAt(this: world.meshRenderers, i: j)
    let renderer: MeshRenderer = componentGet(this: world.meshRenderers, entity: entity)
    if renderer.visible {
      let t: Transform3d = componentGet(this: world.transforms, entity: entity)
      drawShadowCaster(
        meshes: meshes
        resources: resources
        mesh: renderer.mesh
        model: modelMatrix(t: t)
      )
    }
  }
}

# #794: the World3d twin of renderScene for the FORWARD path — draws each mesh
# entity's MeshRenderer/Transform3d/PrevTransform/Material3d through ECS queries.
# Mesh-only: the mesh-only 3D examples migrated in #794 (e.g. 113) have no SDF
# entities. Forward-path SDF metaballs from a World3d follow with the SDF example
# migration (#795); the deferred path's renderSceneSdfWorld already covers those.
func renderSceneWorld(
  meshes: view MeshStore
  resources: view GpuResources
  world: view World3d
) pub {
  loop var j: Int = 0, j < componentCount(this: world.meshRenderers), ++j {
    let entity: EntityId = componentEntityAt(this: world.meshRenderers, i: j)
    let renderer: MeshRenderer = componentGet(this: world.meshRenderers, entity: entity)
    if renderer.visible {
      let t: Transform3d = componentGet(this: world.transforms, entity: entity)
      let pt: Transform3d = componentGet(this: world.prevTransforms, entity: entity)
      let m: Material3d = componentGet(this: world.materials, entity: entity)
      drawInstance(
        meshes: meshes
        resources: resources
        mesh: renderer.mesh
        transform: t
        prevTransform: pt
        material: m
      )
    }
  }
}

# Finish the frame (#514, was the C end): close the scene pass, run tonemap if
# the graph did not, then present. Records upload per-draw and passes dispatch
# in graph order, so this is the last thing a forward frame does.
func end(canvas: mod Gpu2dCanvas) pub {
  finishForward()
  if g3dTonemapPending() is not 0 {
    tonemapPass(canvas: canvas)
  }
  unsafe {
    g3dPresentFrame(
      texture: canvasOffscreenTexture(canvas: canvas)
      width: canvas.offscreenWidth
      height: canvas.offscreenHeight
    )
  }
}

func endFrame(canvas: mod Gpu2dCanvas) pub {
  end(canvas: canvas)
}

# Finish and submit the open scene pass over the WebGPU bindings (#514),
# mirroring the deferred renderer's end(): end the render pass, finish the
# command buffer, submit it, release, and clear the C-side frame handles.
# Idempotent — a no-op (returns 0) if the scene pass is already closed, so it is
# safe to call from more than one place (submit, and later the post-process
# wrappers). Records already uploaded per-draw, so nothing bulk-uploads here.
func finishForward() ret Int {
  unsafe {
    if g3dFrameActive() is 0 {
      ret 0
    }
    let pass: Ptr = g3dPass()
    let enc: Ptr = g3dEncoder()
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
    let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
    g3dSubmitCmd(cmd: cmd)
    wgpuCommandBufferRelease(commandBuffer: cmd)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
    wgpuCommandEncoderRelease(commandEncoder: enc)
    g3dClearFrame()
    ret 1
  }
}

# Submit the 3D pass without screenshot or present (#514, was the C submit).
# Follow with Gpu2d.beginFrameLoad(), the ECS UI render pass, and
# Gpu2d.endFrame() so the composed frame is presented exactly once. Poll only
# when something was actually submitted.
func submit() pub {
  unsafe {
    if finishForward() is not 0 {
      webgpuPoll(wait: 0)
    }
  }
}

func endPass() pub {
  submit()
}

# Resolve the linear HDR scene target into the LDR offscreen (#334):
# exposure + ACES + gamma, the frame's LAST radiometric operation. The
# render graph dispatches this between the scene pass and any LDR
# composition (UI overlay, present). Ends the scene pass if still open.
func tonemapPass(canvas: mod Gpu2dCanvas) pub {
  unsafe {
    finishForward()
    let slot: Int = g3dTonemapPrepare()
    if slot < 0 {
      ret
    }
    let target: Ptr = canvasOffscreenView(canvas: canvas)
    if target is webgpuNull() {
      ret
    }
    fullscreenPostPass(
      target: target
      pipeline: g3dTonemapPipeline()
      bind: g3dTonemapBind(slot: slot)
      loadOp: WGPULoadOp_Clear
    )
  }
}

# Ambient occlusion (#337): horizon-search AO with a visibility bitmask,
# generated at half resolution and composited onto the INDIRECT term only.
# Runs before TAA so the half-res noise resolves temporally, and before
# tonemap so it modulates linear radiance.
func ssaoPass() pub {
  unsafe {
    finishForward()
    if g3dSsaoPrepare() is 0 {
      ret
    }
    # Generation: write AO into ao_view (or clear it to unoccluded when AO is off).
    if g3dSsaoEnabled() is not 0 {
      fullscreenPostPass(
        target: g3dAoView()
        pipeline: g3dSsaoPipeline()
        bind: g3dSsaoBind()
        loadOp: WGPULoadOp_Clear
      )
    } else {
      g3dClearAo()
    }
    # Composite: add ambient*AO back into hdrColor (Load — it blends, not overwrites).
    # A debug build paints the raw AO over hdrColor instead.
    if g3dAoDebugOn() is not 0 {
      fullscreenPostPass(
        target: g3dHdrView()
        pipeline: g3dAoDebugPipeline()
        bind: g3dAoDebugBind()
        loadOp: WGPULoadOp_Clear
      )
    } else {
      fullscreenPostPass(
        target: g3dHdrView()
        pipeline: g3dAoApplyPipeline()
        bind: g3dAoApplyBind()
        loadOp: WGPULoadOp_Load
      )
    }
  }
}

# Temporal antialiasing resolve (#335): reproject the previous frame
# through the velocity buffer, clamp it to the current neighbourhood and
# blend. Runs on HDR, BEFORE tonemap, so accumulation stays linear.
func taaPass() pub {
  unsafe {
    finishForward()
    let slot: Int = g3dTaaPrepare()
    if slot < 0 {
      ret
    }
    fullscreenPostPass(
      target: g3dTaaView(slot: slot)
      pipeline: g3dTaaPipeline()
      bind: g3dTaaBind(slot: slot)
      loadOp: WGPULoadOp_Clear
    )
  }
}

# Upload interleaved mesh data and get a typed handle back.
# #905: meshes live in the renderer's MeshStore (DeferredRenderer.passes.
# gbuffer.meshes / Renderer3d.meshes); RendererDeferred.uploadMesh and
# Renderer3d.uploadMesh are the app-facing wrappers over these.
func uploadMesh(
  meshes: mod MeshStore
  resources: mod GpuResources
  verts: view List(Float)
  vertCount: view Int
  indices: view List(Int)
) pub ret MeshHandle {
  ret meshStoreUpload(
    store: meshes
    resources: resources
    verts: verts
    vertCount: vertCount
    indices: indices
  )
}

# Rewrite an existing mesh's vertex data in place; the index buffer and vertex
# count stay as created. For pooled geometry whose shape depends on where in
# the world it currently sits (recycled terrain tiles).
func updateMeshVerts(
  meshes: view MeshStore
  resources: view GpuResources
  mesh: view MeshHandle
  verts: view List(Float)
  vertCount: view Int
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  meshStoreUpdateVerts(
    store: meshes
    resources: resources
    mesh: mesh
    verts: verts
    vertCount: vertCount
  )
}

func shadowMetaballs(packedBalls: view Buffer(Float), count: copy Int, smoothing: copy Float) {
  unsafe {
    nativeShadowMetaballs(packedBalls: packedBalls, count: count, smoothing: smoothing)
  }
}

# Open the shadow pass for a fitted cascade set. Everything drawn between
# this and `endShadowPass` casts.
func beginShadowPass(c: view ShadowCascades) pub {
  unsafe {
    shadowBegin(
      cascades: c.viewProj.data
      count: c.count
      resolution: c.resolution
      splits: c.splitFar.data
      texelWorld: c.texelWorld.data
      depthRange: c.depthRange.data
    )
  }
}

# The shadow queue is C (rae_sm_*, #906); a static caster is queued by its
# buffer handles, borrowed from the store for the pass (#905).
func drawShadowCaster(
  meshes: view MeshStore
  resources: view GpuResources
  mesh: view MeshHandle
  model: view Mat4
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  unsafe {
    shadowDraw(
      mesh: mesh.id
      vbuf: meshStoreVbufHandle(store: meshes, resources: resources, mesh: mesh.id)
      ibuf: meshStoreIbufHandle(store: meshes, resources: resources, mesh: mesh.id)
      icount: meshStoreIndexCount(store: meshes, mesh: mesh.id)
      model: model
    )
  }
}

# `paletteBase` is this caster's start offset into the shared skin palette buffer
# (characterPaletteBase in gbufferInstanced.rae) — the SAME base its G-buffer
# instance uses — so its shadow shows its own pose (#547). 0 for a lone character.
# #921: the caster is queued by its SkinStore buffer handles + the palette
# handle, all borrowed by the C shadow pass for this frame.
func drawShadowCasterSkinned(
  skins: view SkinStore
  resources: view GpuResources
  mesh: view MeshHandle
  model: view Mat4
  paletteBase: copy Int
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  unsafe {
    shadowDrawSkinned(
      mesh: mesh.id
      vbuf: skinStoreVbufHandle(store: skins, resources: resources, mesh: mesh.id)
      ibuf: skinStoreIbufHandle(store: skins, resources: resources, mesh: mesh.id)
      icount: skinStoreIndexCount(store: skins, mesh: mesh.id)
      palette: skinStorePaletteHandle(store: skins, resources: resources)
      model: model
      paletteBase: paletteBase
    )
  }
}

func endShadowPass() pub {
  GbufferShadow.shadowEnd()
}

# How many casters the shadow pass rasterised. Exposed because a shadow
# pass that draws NOTHING still produces a lit, non-blank frame — so a
# screenshot check cannot tell a working pass from a dead one, and only a
# count can (#388).
func shadowCasterCount() pub ret Int {
  ret shadowDrawCount()
}

func skinShutdown() {
  unsafe {
    nativeSkinShutdown()
  }
}

# Skinned mesh uploads and the joint palette live on the renderer objects since
# #921: RendererDeferred.uploadSkinnedMesh / uploadPalette (the GbufferCache's
# SkinStore) and Renderer3d.uploadSkinnedMesh / uploadPalette (the forward one).

# Forward skinned mesh draw (#514): encode one instanced DrawIndexed into the
# scene pass over the SkinStore's buffers (#921). C keeps the forward skin
# pipeline + its per-draw record buffer and BORROWS the palette handle for its
# bind (rebuilt when the handle changes); it returns the slot. Rae binds the
# skinned pipeline/bind + mesh buffers, draws, then restores the geometry
# pipeline/bind (leaving the skinned pipeline bound would feed plain vertices to
# a shader expecting joint attributes).
func drawSkinned(
  skins: view SkinStore
  resources: view GpuResources
  mesh: copy Int
  model: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  metallic: copy Float
  roughness: copy Float
) {
  unsafe {
    if not skinStoreReady(store: skins, resources: resources, mesh: mesh) {
      ret
    }
    let slot: Int = g3dPushSkinnedDraw(
      mesh: mesh
      model: model
      r: r
      g: g
      b: b
      metallic: metallic
      roughness: roughness
      palette: skinStorePaletteHandle(store: skins, resources: resources)
    )
    if slot < 0 {
      ret
    }
    let pass: Ptr = g3dPass()
    let vbuf: Ptr = skinStoreVbufHandle(store: skins, resources: resources, mesh: mesh)
    let ibuf: Ptr = skinStoreIbufHandle(store: skins, resources: resources, mesh: mesh)
    let icount: Int = skinStoreIndexCount(store: skins, mesh: mesh)
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dSkinPipeline())
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: g3dSkinBind()
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
    wgpuRenderPassEncoderSetVertexBuffer(
      renderPassEncoder: pass
      slot: 0 as UInt32
      buffer: vbuf
      offset: 0 as UInt64
      size: wgpuBufferGetSize(buffer: vbuf)
    )
    wgpuRenderPassEncoderSetIndexBuffer(
      renderPassEncoder: pass
      buffer: ibuf
      format: WGPUIndexFormat_Uint32
      offset: 0 as UInt64
      size: wgpuBufferGetSize(buffer: ibuf)
    )
    wgpuRenderPassEncoderDrawIndexed(
      renderPassEncoder: pass
      indexCount: icount as UInt32
      instanceCount: 1 as UInt32
      firstIndex: 0 as UInt32
      baseVertex: 0 as Int32
      firstInstance: slot as UInt32
    )
    # Restore the geometry pipeline/bind for subsequent static draws.
    wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: g3dPipeline())
    wgpuRenderPassEncoderSetBindGroup(
      renderPassEncoder: pass
      groupIndex: 0 as UInt32
      group: g3dBind()
      dynamicOffsetCount: 0 as UInt64
      dynamicOffsets: webgpuNull()
    )
  }
}

func drawSkinnedInstance(
  skins: view SkinStore
  resources: view GpuResources
  mesh: view MeshHandle
  model: view Mat4
  material: view Material3d
) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  drawSkinned(
    skins: skins
    resources: resources
    mesh: mesh.id
    model: model
    r: material.baseColor.x
    g: material.baseColor.y
    b: material.baseColor.z
    metallic: material.metallic
    roughness: material.roughness
  )
}
