# ShadowMaps' casters from instance batches: the records of an InstanceBatch
# (GbufferRecord's DrawU layout) queued as static casters, each with its
# level cross-fade, the fading ones under their own key and pipeline
# (docs/tree-lod-design.md §2.3). Split from ShadowMaps for its size.
open FoliageShadow
open Scene3d
open MeshStore
open gpu/GpuResources
open gpu/GpuIds
open ShadowMaps
open DrawStats
open ShadowMapsSprite
open gpu/GpuRender
open gpu/GpuRenderPass
open webgpu/Context
open gpu/GpuLifetime

# Many static casters of one mesh at once: the first `count` records of
# `records`, `stride` floats each with the model matrix in the first 16 (an
# InstanceBatch's DrawU records). The queue ends up exactly as one
# shadowQueue call per record would leave it, but the models are copied
# straight out of the batch the G-buffer draws, with no per-caster lookup or
# matrix rebuild.
func shadowQueueRecords(
  shadow: mod ShadowCache
  key: copy Int
  vbuf: view BufferId
  ibuf: view BufferId
  icount: copy Int
  records: view List(Float)
  stride: view Int
  count: view Int
) {
  if not shadow.enabled or icount < 1 {
    ret
  }
  # The casters that are not fading first, then the fading ones (their own
  # pipeline), so each kind stays one instanced run
  loop var fading: Int = 0, fading < 2, ++fading {
    loop var record: Int = 0, record < count and shadow.drawCount < shadowMaxDraws, ++record {
      let base: Int = record * stride
      let fades: Bool = records.copyAtFallback(index: base + 40, fallback: 0.0) > 0.0 or records.copyAtFallback(
        index: base + 41
        fallback: 0.0
      ) > 0.5
      if fades is not (fading is 1) {
        continue
      }
      shadowQueueRecord(
        shadow: shadow
        key: key
        vbuf: vbuf
        ibuf: ibuf
        icount: icount
        records: records
        base: base
        fades: fades
      )
    }
  }
}

# One record of shadowQueueRecords: its model and fade into the caster
# floats, a fading one under the fade key
func shadowQueueRecord(
  shadow: mod ShadowCache
  key: copy Int
  vbuf: view BufferId
  ibuf: view BufferId
  icount: copy Int
  records: view List(Float)
  base: copy Int
  fades: copy Bool
) {
  loop var i: Int = 0, i < 16, ++i {
    shadow.modelFloats.add(value: records.copyAtFallback(index: base + i, fallback: 0.0))
  }
  loop var i: Int = 40, i < 44, ++i {
    shadow.modelFloats.add(value: records.copyAtFallback(index: base + i, fallback: 0.0))
  }
  shadow.modelFloats.add(value: records.copyAtFallback(index: base + 39, fallback: 0.0))
  # a leaf card's leaf loss (GbufferRecord setInstanceLeafLoss)
  shadow.modelFloats.add(value: records.copyAtFallback(index: base + 35, fallback: 0.0))
  loop var channel: Int = 0, channel < 2, ++channel {
    shadow.modelFloats.add(value: 0.0)
  }
  var casterKey: Int = key
  if fades {
    casterKey = key + shadowFadeKeyBit
  }
  shadow.paletteBaseRows.add(value: 0 as Int32)
  shadow.casterKeys.add(value: casterKey)
  shadow.casterKinds.add(value: shadow.drawKind as Int)
  shadow.casterVbufs.add(value: vbuf)
  shadow.casterIbufs.add(value: ibuf)
  shadow.casterIcounts.add(value: icount)
  shadow.casterFirstIndices.add(value: 0)
  shadow.drawCount = shadow.drawCount + 1
}

# drawShadowCaster for the first `count` records of an instance batch
# (shadowQueueRecords).
func drawShadowCasterRecords(
  shadow: mod ShadowCache
  meshes: view MeshStore
  resources: view GpuResources
  mesh: view MeshHandle
  records: view List(Float)
  stride: view Int
  count: view Int
) {
  if count < 1 or not meshHandleIsValid(h: mesh) {
    ret
  }
  if not meshStoreReady(store: meshes, resources: resources, mesh: mesh.id) {
    ret
  }
  shadowQueueRecords(
    shadow: shadow
    key: foliageCasterKey(meshes: meshes, mesh: mesh.id)
    vbuf: meshStoreVbuf(store: meshes, mesh: mesh.id)
    ibuf: meshStoreIbuf(store: meshes, mesh: mesh.id)
    icount: meshStoreIndexCount(store: meshes, mesh: mesh.id)
    records: records
    stride: stride
    count: count
  )
}

# The queued casters into one cascade's open pass: INSTANCED batching (#118).
# Whether queued caster `at` joins the run of a caster of `key` drawing
# `indexCount` indices from `firstIndex`: the same mesh and the same range.
func shadowSameDraw(
  shadow: view ShadowCache
  at: copy Int
  key: copy Int
  firstIndex: copy Int
  indexCount: copy Int
) ret Bool {
  ret shadow.casterKeys.copyAtFallback(index: at, fallback: -1) is key and shadow.casterFirstIndices.copyAtFallback(
    index: at
    fallback: 0
  ) is firstIndex and shadow.casterIcounts.copyAtFallback(index: at, fallback: 0) is indexCount
}

# Casters sharing a mesh sit consecutively in the queue (every alive walker
# for one body part) and the model + palette-base buffers are indexed by
# instance_index (the queue position), so a RUN of equal keys is ONE
# DrawIndexed (firstInstance = run start, instanceCount = run length).
func drawShadowCasters(
  shadow: mod ShadowCache
  resources: view GpuResources
  cascade: copy Int
  pass: copy Ptr
) {
  var i: Int = 0
  loop i < shadow.drawCount {
    let key: Int = shadow.casterKeys.copyAtFallback(index: i, fallback: -1)
    let firstIndex: Int = shadow.casterFirstIndices.copyAtFallback(index: i, fallback: 0)
    let indexCount: Int = shadow.casterIcounts.copyAtFallback(index: i, fallback: 0)
    var runEnd: Int = i + 1
    loop runEnd < shadow.drawCount and shadowSameDraw(
      shadow: shadow
      at: runEnd
      key: key
      firstIndex: firstIndex
      indexCount: indexCount
    ) {
      runEnd = runEnd + 1
    }
    var pipeline: RenderPipelineId = shadow.staticPipeline
    var bind: BindGroupId = shadow.staticBinds.copyAtFallback(
      index: cascade
      fallback: noBindGroupId()
    )
    if key >= shadowFoliageKeyBit {
      pipeline = shadow.foliage.pipeline
      bind = shadow.foliage.binds.copyAtFallback(index: cascade, fallback: noBindGroupId())
    } else if key >= shadowFadeKeyBit {
      pipeline = shadow.fadePipeline
      bind = shadow.fadeBinds.copyAtFallback(index: cascade, fallback: noBindGroupId())
    } else if key >= shadowSkinnedKeyBit {
      pipeline = shadow.skinPipeline
      bind = shadow.skinBinds.copyAtFallback(index: cascade, fallback: noBindGroupId())
    }
    unsafe {
      let drawn: Bool = recordDrawIndexedRangeInPass(
        resources: resources
        pass: pass
        pipeline: pipeline
        bindGroup: bind
        vertexBuffer: refHandle(
          resources: resources
          ref: bufferRef(id: shadow.casterVbufs.copyAtFallback(index: i, fallback: noBufferId()))
        )
        indexBuffer: refHandle(
          resources: resources
          ref: bufferRef(id: shadow.casterIbufs.copyAtFallback(index: i, fallback: noBufferId()))
        )
        firstIndex: firstIndex
        indexCount: indexCount
        instanceCount: runEnd - i
        firstInstance: i
      )
      if drawn {
        shadowCountRun(
          shadow: shadow
          cascade: cascade
          first: i
          end: runEnd
          indexCount: indexCount
        )
      }
    }
    i = runEnd
  }
}

# What each cascade drew (lib/DrawStats), one DrawStats a cascade
func createShadowDrawStats() ret List(DrawStats) {
  var stats: List(DrawStats) = List.create(DrawStats, cap: shadowMaxCascades)
  loop var cascade: Int = 0, cascade < shadowMaxCascades, ++cascade {
    stats.add(value: createDrawStats())
  }
  ret stats
}

# Before a frame's casters are queued, and on a frame with shadows off
func shadowResetDrawStats(shadow: mod ShadowCache) {
  shadow.drawKind = DrawKind.other
  loop let stats: mod DrawStats in shadow.drawStats {
    drawStatsReset(stats: stats)
  }
}

# Counts one run of casters drawn into `cascade`, each by its own kind
func shadowCountRun(
  shadow: mod ShadowCache
  cascade: view Int
  first: view Int
  end: view Int
  indexCount: view Int
) {
  loop var at: Int = first, at < end, ++at {
    let kind: Int = shadow.casterKinds.copyAtFallback(index: at, fallback: 0)
    if let stats: mod DrawStats = shadow.drawStats.modAt(index: cascade) {
      drawStatsAdd(
        stats: stats
        kind: kind as DrawKind
        instances: 1
        triangles: indexCount / 3
      )
    }
  }
}

# Counts the billboards drawn into `cascade`: two triangles each
func shadowCountSprites(shadow: mod ShadowCache, cascade: view Int) {
  let count: Int = shadowSpriteCount(shadow: shadow)
  let kind: DrawKind = shadow.spriteDrawKind
  if let stats: mod DrawStats = shadow.drawStats.modAt(index: cascade) {
    drawStatsAdd(
      stats: stats
      kind: kind
      instances: count
      triangles: count * 2
    )
  }
}
