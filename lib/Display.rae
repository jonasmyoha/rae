# The display the app's window is on (docs/platform-conditional-code.md §3.1
# layer 4). Layout works in points; pixels are points times `scale()`, so a
# Retina screen and a 1080p screen get the same layout at the same window size.
#
# The scale changes while the app runs (the window moves to another monitor,
# a monitor is unplugged), so read it when a `Device.DeviceWatch` reports a
# change, never once at startup.
when Target.os is Os.web {
  # window.devicePixelRatio (compiler/runtime/runtime_device.c)
  func browserPixelRatio() unsafe extern("rae_ext_Display_browserPixelRatio") ret Float
} else {
  # SDL_GetWindowDisplayScale of the app's window; 0 without a window
  func windowDisplayScale() unsafe extern("rae_ext_Display_windowDisplayScale") ret Float

  # The display panel under the window (macOS; elsewhere 0 / -1, unknown):
  # its id, its width in points, its modes and which are the panel's own
  func windowPanelDisplay() unsafe extern("rae_ext_Display_windowPanelDisplay") ret Int

  func panelPointsWide(display: Int) unsafe extern("rae_ext_Display_panelPointsWide") ret Float

  func panelModeCount(display: Int) unsafe extern("rae_ext_Display_panelModeCount") ret Int

  func panelNativeModePixelWidth(
    display: Int
    index: Int
  ) unsafe extern("rae_ext_Display_panelNativeModePixelWidth") ret Int
}

# Pixels per point (2.0 on Retina)
func scale() ret Float {
  var reported: Float = 0.0
  when Target.os is Os.web {
    unsafe {
      reported = browserPixelRatio()
    }
  } else {
    unsafe {
      reported = windowDisplayScale()
    }
  }
  ret scaleFrom(reported: reported)
}

# The scale a platform reported, or 1.0 when it reported none (no window yet,
# a headless run)
func scaleFrom(reported: view Float) ret Float {
  if reported > 0.0 {
    ret reported
  }
  ret 1.0
}

# The screen's real pixels per point where the window is: the panel's own
# width in pixels over the display's width in points. In a scaled mode
# ("looks like 3008 x 1692" on a 3840 x 2160 panel: 1.28) it is less than
# the window's drawable pixels per point (2: macOS draws into a larger image
# and shrinks it to the panel); on a Retina laptop at its default it equals
# them. 0 when unknown (not macOS, no window, no native mode marked).
func physicalPixelsPerPoint() ret Float {
  when Target.os is Os.web {
    ret 0.0
  } else {
    var nativeWidth: Int = 0
    var pointsWide: Float = 0.0
    unsafe {
      let display: Int = windowPanelDisplay()
      if display is 0 {
        ret 0.0
      }
      pointsWide = panelPointsWide(display: display)
      let count: Int = panelModeCount(display: display)
      loop var i: Int = 0, i < count, ++i {
        let width: Int = panelNativeModePixelWidth(display: display, index: i)
        if width > nativeWidth {
          nativeWidth = width
        }
      }
    }
    if nativeWidth <= 0 or pointsWide <= 0.0 {
      ret 0.0
    }
    ret nativeWidth.toFloat() / pointsWide
  }
}
