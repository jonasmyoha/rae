# GPU text layout — draw MSDF text through the gpu2d renderer (#111).
#
# This is the GPU sibling of SdfText.sdfDrawText: it does the SAME glyph
# layout (pen advance, plane/atlas bounds, screen-px-range) but emits one
# Gpu2d.drawGlyph instance per glyph instead of CPU-blitting. Kept in a
# SEPARATE module so lib/sdfText.rae stays independent of gpu2d — the
# raytracer's CPU text path must not drag in the wgpu render surface.
#
# Compiled-target only (pulls in gpu2d → wgpu-native + SDL3).
import SdfText
import Gpu2d
open Gpu2dCanvas

# Lay out one run of `text` at baseline (x, y), emitting a glyph quad per
# character with an optional outline (outlineWidth px of outlineColor). Returns
# the pen x advance. drawText / drawTextEx build on this.
func emitRun(
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  text: view String
  x: copy Float
  y: copy Float
  sizePx: copy Float
  color: copy Int
  outlineWidth: copy Float
  outlineColor: copy Int
  softness: copy Float
) ret Float {
  ret emitRange(
    canvas: canvas
    font: font
    text: text
    start: 0
    end: text.length()
    x: x
    y: y
    sizePx: sizePx
    color: color
    outlineWidth: outlineWidth
    outlineColor: outlineColor
    softness: softness
  )
}

# Allocation-free subset emitter used by word wrapping. `end` is exclusive.
func emitRange(
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  text: view String
  start: copy Int
  end: copy Int
  x: copy Float
  y: copy Float
  sizePx: copy Float
  color: copy Int
  outlineWidth: copy Float
  outlineColor: copy Int
  softness: copy Float
) ret Float {
  unsafe {
    let scale: Float = sizePx / font.emSize
    let aw: Float = font.atlasWidth
    let ah: Float = font.atlasHeight
    var pen: Float = x
    var i: Int = start
    loop i < end {
      let cp: Int = text.at(index: i).toInt()
      if let gi: Int = SdfText.sdfGlyphIndex(font: font, cp: cp) {
        let g: SdfGlyph = rae_ext_rae_buf_get(buf: font.glyphs.data, index: gi)
        if g.hasBounds {
          let sx0: Float = pen + g.planeLeft * scale
          let sx1: Float = pen + g.planeRight * scale
          let sy0: Float = y - g.planeTop * scale
          let sy1: Float = y - g.planeBottom * scale
          # atlasBounds are bottom-left origin; flip V to the top-left image,
          # then normalize into [0,1] for the GPU sampler.
          let u0: Float = g.atlasLeft / aw
          let u1: Float = g.atlasRight / aw
          let v0: Float = (ah - g.atlasTop) / ah
          let v1: Float = (ah - g.atlasBottom) / ah
          let glyphH: Float = g.atlasTop - g.atlasBottom
          var spr: Float = 1.0
          if glyphH > 0.0 {
            spr = font.pxRange * (sy1 - sy0) / glyphH
          }
          if spr < 1.0 {
            spr = 1.0
          }
          Gpu2d.drawGlyphEx(
            canvas: canvas
            sx0: sx0
            sy0: sy0
            sx1: sx1
            sy1: sy1
            u0: u0
            v0: v0
            u1: u1
            v1: v1
            atlas: font.atlas
            pxRange: spr
            color: color
            outlineWidth: outlineWidth
            outlineColor: outlineColor
            softness: softness
          )
        }
        pen = pen + g.advance * scale
      }
      i = i + SdfText.sdfUtf8ByteWidth(cp: cp)
    }
    ret pen
  }
}

func glyphAdvance(font: view SdfFont, cp: view Int, sizePx: view Float) ret Float {
  unsafe {
    if let gi: Int = SdfText.sdfGlyphIndex(font: font, cp: cp) {
      let glyph: SdfGlyph = rae_ext_rae_buf_get(buf: font.glyphs.data, index: gi)
      ret glyph.advance * (sizePx / font.emSize)
    }
    ret 0.0
  }
}

# One line of word-wrapped text: the bytes [start, end) are drawn, and the
# next line starts at `next` (past the space or newline the line broke at)
type WrapLine {
  end: Int
  next: Int
}

# Where the line that starts at byte `start` of `text` ends when it may be
# `maxWidth` wide. It breaks at a newline, else at the last space that fits,
# else (a single word wider than the line) at the last character that fits;
# a line holds at least one character.
func nextWrapLine(
  font: view SdfFont
  text: view String
  start: view Int
  sizePx: view Float
  maxWidth: view Float
) ret WrapLine {
  let n: Int = text.length()
  var lastSpace: Int = -1
  var width: Float = 0.0
  var i: Int = start
  loop i < n {
    let cp: Int = text.at(index: i).toInt()
    if cp is 10 {
      ret WrapLine { end: i, next: i + 1 }
    }
    let advance: Float = glyphAdvance(font: font, cp: cp, sizePx: sizePx)
    if cp is 32 {
      lastSpace = i
    }
    if width + advance > maxWidth and i > start {
      if lastSpace >= start {
        ret WrapLine { end: lastSpace, next: lastSpace + 1 }
      }
      ret WrapLine { end: i, next: i }
    }
    width = width + advance
    i = i + SdfText.sdfUtf8ByteWidth(cp: cp)
  }
  ret WrapLine { end: n, next: n }
}

# How many lines drawTextWrappedEx draws `text` in, `maxWidth` wide: a
# layout or a check sizes a wrapped text's box from it (its height is the
# count times the line height)
func wrappedLineCount(
  font: view SdfFont
  text: view String
  sizePx: view Float
  maxWidth: view Float
) ret Int {
  if maxWidth <= 0.0 {
    ret 1
  }
  var lines: Int = 0
  var start: Int = 0
  loop start < text.length() {
    let line: WrapLine = nextWrapLine(
      font: font
      text: text
      start: start
      sizePx: sizePx
      maxWidth: maxWidth
    )
    lines = lines + 1
    start = line.next
  }
  ret lines
}

# Draw allocation-free word-wrapped text, line by line as nextWrapLine breaks
# it. Returns the number of lines drawn (wrappedLineCount's number).
func drawTextWrappedEx(
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  text: view String
  x: copy Float
  y: copy Float
  sizePx: copy Float
  color: copy Int
  maxWidth: copy Float
  lineHeight: copy Float
  outlineWidth: copy Float
  outlineColor: copy Int
) ret Int {
  if maxWidth <= 0.0 {
    emitRun(
      canvas: canvas
      font: font
      text: text
      x: x
      y: y
      sizePx: sizePx
      color: color
      outlineWidth: outlineWidth
      outlineColor: outlineColor
      softness: 1.0
    )
    ret 1
  }
  var baseline: Float = y
  var lines: Int = 0
  var start: Int = 0
  loop start < text.length() {
    let line: WrapLine = nextWrapLine(
      font: font
      text: text
      start: start
      sizePx: sizePx
      maxWidth: maxWidth
    )
    emitRange(
      canvas: canvas
      font: font
      text: text
      start: start
      end: line.end
      x: x
      y: baseline
      sizePx: sizePx
      color: color
      outlineWidth: outlineWidth
      outlineColor: outlineColor
      softness: 1.0
    )
    lines = lines + 1
    baseline = baseline + lineHeight
    start = line.next
  }
  ret lines
}

# Draw `text` with baseline pen at (x, y) in pixels, `sizePx` tall em,
# color 0xAARRGGBB. Submit between Gpu2d.beginFrame and Gpu2d.endFrame.
# Returns the pen x advance (end position), like a text cursor.
func drawText(
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  text: view String
  x: copy Float
  y: copy Float
  sizePx: copy Float
  color: copy Int
) ret Float {
  ret emitRun(
    canvas: canvas
    font: font
    text: text
    x: x
    y: y
    sizePx: sizePx
    color: color
    outlineWidth: 0.0
    outlineColor: 0
    softness: 1.0
  )
}

# Draw `text` with an outline and/or a drop-shadow — the GPU equivalent of
# lib/ui/Msdf.drawMsdfText. `outlineWidth` px of `outlineColor` grow from the
# glyph edge (MSDF dilation). A shadow is drawn first when `shadowColor`'s
# alpha > 0: the run offset by (shadowOffX, shadowOffY), dilated by
# `shadowSoftness` for a softer edge (softness 1 = sharp). Colors 0xAARRGGBB.
func drawTextEx(
  canvas: mod Gpu2dCanvas
  font: view SdfFont
  text: view String
  x: copy Float
  y: copy Float
  sizePx: copy Float
  color: copy Int
  outlineColor: copy Int
  outlineWidth: copy Float
  shadowColor: copy Int
  shadowOffX: copy Float
  shadowOffY: copy Float
  shadowSoftness: copy Float
) ret Float {
  let shadowA: Int = (shadowColor shr 24) bitand 255
  if shadowA > 0 {
    # Soft shadow = a real blurred edge (wide coverage falloff), NOT a
    # dilated hard copy. softness 1 = sharp; larger = softer/blurrier.
    var soft: Float = shadowSoftness
    if soft < 1.0 {
      soft = 1.0
    }
    emitRun(
      canvas: canvas
      font: font
      text: text
      x: x + shadowOffX
      y: y + shadowOffY
      sizePx: sizePx
      color: shadowColor
      outlineWidth: 0.0
      outlineColor: 0
      softness: soft
    )
  }
  ret emitRun(
    canvas: canvas
    font: font
    text: text
    x: x
    y: y
    sizePx: sizePx
    color: color
    outlineWidth: outlineWidth
    outlineColor: outlineColor
    softness: 1.0
  )
}

# Width of `text` in pixels at `sizePx` (delegates to sdf_text).
func measureText(font: view SdfFont, text: view String, sizePx: copy Float) ret Float {
  ret SdfText.sdfMeasureText(font: font, text: text, sizePx: sizePx)
}
