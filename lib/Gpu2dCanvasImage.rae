# Gpu2dCanvasImage — the 2D canvas's image pass (#908; #918 split of
# Gpu2dCanvas for the 1000-line cap): images are decoded by C (stb_image, CPU
# RGBA) and uploaded here into manager textures; the 1-based image handle
# indexes `canvas.images`, the key registry maps a name to a handle
# (ImageRegistry.rae keeps the load / retry / cache policy over it). Each
# queued draw is one 64-byte uniform + one bind group [viewport, uniform,
# view, sampler], cached per draw slot by handle; draws go after the boxes,
# before text (Gpu2dCanvasFrame drives the flush).
import String
import Math
open collections/StringMap
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuRenderPass
open gpu/GpuIds
open Gpu2dCanvas
open Gpu2dCanvasClip
open Gpu2dCanvasFrame

func ensureImagePipeline(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if canvas.imagePipeMade {
    ret
  }
  canvas.imagePipeMade = true
  let imageShader: Shader = shader(files: ["lib/gpu2d_image.wgsl"])
  var format: Int = 0
  unsafe {
    format = nativeG2dBoxFormat()
  }
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    shader: imageShader
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: boxPipelineSpec(format: format as Int32)
  ) {
    canvas.imagePipeline = pipeline
  }
  # Linear, clamp-to-edge (the C image path shared the text sampler's settings).
  if let sampler: SamplerId = createSampler(resources: resources) {
    canvas.imageSampler = sampler
  }
  ensureViewportUniform(canvas: canvas, resources: resources)
}

# Registers an uploaded RGBA8 texture (w x h) as the next 1-based handle.
func registerImageTexture(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  texture: view TextureId
  width: copy Int
  height: copy Int
) ret Int {
  if let textureView: TextureViewId = createTextureView(resources: resources, texture: texture) {
    let image: Gpu2dImage = {
      texture: texture
      textureView: textureView
      width: width
      height: height
    }
    if canvas.imagesFree.length > 0 {
      let handle: Int = canvas.imagesFree.pop()
      canvas.images.set(index: handle - 1, value: image)
      ret handle
    }
    canvas.images.add(value: image)
    ret canvas.images.length
  }
  retireTexture(resources: resources, id: texture)
  ret 0
}

# Decode an image file (C, stb_image) and upload it as an RGBA8 texture.
# Returns the 1-based handle, 0 on failure (the caller renders its placeholder).
func canvasLoadImage(canvas: mod Gpu2dCanvas, path: copy String) ret Int {
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources = canvas.gpuResources {
    unsafe {
      let rgba: Ptr = g2dDecodeImage(path: path)
      if rgba is webgpuNull() {
        ret 0
      }
      let width: Int = g2dDecodedWidth()
      let height: Int = g2dDecodedHeight()
      if let texture: TextureId = createTexture(
        resources: resources
        width: width
        height: height
        format: WGPUTextureFormat_RGBA8Unorm
        usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
      ) {
        if writeTextureFromPtr(
          resources: resources
          texture: texture
          data: rgba
          bytesPerRow: width * 4
          rows: height
        ) {
          handle = registerImageTexture(
            canvas: canvas
            resources: resources
            texture: texture
            width: width
            height: height
          )
        } else {
          retireTexture(resources: resources, id: texture)
        }
      }
      g2dDecodeFree(rgba: rgba)
    }
  }
  ret handle
}

# Register an image from RGBA pixels generated in Rae (#539 procedural
# textures): each Int is one packed pixel r | g<<8 | b<<16 | a<<24 (byte order
# R,G,B,A, matching RGBA8Unorm). Returns a 1-based handle, 0 on failure.
func canvasRegisterImageRgba(
  canvas: mod Gpu2dCanvas
  pixels: view Buffer(Int)
  width: copy Int
  height: copy Int
) ret Int {
  if width <= 0 or height <= 0 {
    ret 0
  }
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources = canvas.gpuResources {
    let count: Int = width * height
    var bytes: List(UInt8) = List.create(UInt8, cap: count * 4)
    unsafe {
      loop var i: Int = 0, i < count, ++i {
        let packed: Int = rae_ext_rae_buf_get(buf: pixels, index: i)
        bytes.add(value: (packed % 256) as UInt8)
        bytes.add(value: ((packed / 256) % 256) as UInt8)
        bytes.add(value: ((packed / 65536) % 256) as UInt8)
        bytes.add(value: ((packed / 16777216) % 256) as UInt8)
      }
    }
    if let texture: TextureId = createTexture(
      resources: resources
      width: width
      height: height
      format: WGPUTextureFormat_RGBA8Unorm
      usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
    ) {
      if writeTexture(
        resources: resources
        texture: texture
        bytes: bytes
        bytesPerRow: width * 4
      ) {
        handle = registerImageTexture(
          canvas: canvas
          resources: resources
          texture: texture
          width: width
          height: height
        )
      } else {
        retireTexture(resources: resources, id: texture)
      }
    }
  }
  ret handle
}

# Register an image from straight-alpha RGBA bytes (four a pixel, rows from the top). Returns a
# 1-based handle, 0 on failure.
func canvasRegisterImageBytes(
  canvas: mod Gpu2dCanvas
  bytes: view List(UInt8)
  width: copy Int
  height: copy Int
) ret Int {
  if width <= 0 or height <= 0 or bytes.length is not width * height * 4 {
    ret 0
  }
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources = canvas.gpuResources {
    if let texture: TextureId = createTexture(
      resources: resources
      width: width
      height: height
      format: WGPUTextureFormat_RGBA8Unorm
      usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
    ) {
      if writeTexture(
        resources: resources
        texture: texture
        bytes: bytes
        bytesPerRow: width * 4
      ) {
        handle = registerImageTexture(
          canvas: canvas
          resources: resources
          texture: texture
          width: width
          height: height
        )
      } else {
        retireTexture(resources: resources, id: texture)
      }
    }
  }
  ret handle
}

# Let go of an image: no draw finds it from here on, and its texture is freed when the GPU is done
# with the frames that drew it. A frame that is being drawn keeps it to its end (what it queued
# before this is still drawn). The handle may be another image's after that.
func canvasReleaseImage(canvas: mod Gpu2dCanvas, handle: copy Int) {
  if canvasImageLive(canvas: canvas, handle: handle) is false {
    ret
  }
  loop let waiting: copy Int in canvas.imagesReleasing {
    if waiting is handle {
      ret
    }
  }
  canvas.imagesReleasing.add(value: handle)
  if not canvasFrameActive(canvas: canvas) and canvas.imageCommandHandles.length is 0 {
    canvasReleaseImages(canvas: canvas)
  }
}

# The image registered under `key` let go of, and the key with it
func canvasReleaseImageKey(canvas: mod Gpu2dCanvas, key: view String) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  canvas.imageKeys.remove(k: key)
  if handle > 0 {
    canvasReleaseImage(canvas: canvas, handle: handle)
  }
}

# Free what canvasReleaseImage let go of, between two frames (its submission holds what it drew).
# The bind groups made for it go too: one that outlived its texture would refuse the next
# submission.
func canvasReleaseImages(canvas: mod Gpu2dCanvas) {
  if canvas.imagesReleasing.length is 0 {
    ret
  }
  if let resources: mod GpuResources = canvas.gpuResources {
    loop let handle: copy Int in canvas.imagesReleasing {
      loop var i: Int = 0, i < canvas.imageBindHandles.length, ++i {
        if canvas.imageBindHandles.copyAtFallback(index: i, fallback: 0) is handle {
          retireBindGroup(
            resources: resources
            id: canvas.imageBinds.copyAtFallback(index: i, fallback: noBindGroupId())
          )
          canvas.imageBinds.set(index: i, value: noBindGroupId())
          canvas.imageBindHandles.set(index: i, value: 0)
        }
      }
      if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
        retireTextureView(resources: resources, id: image.textureView)
        retireTexture(resources: resources, id: image.texture)
      }
      let gone: Gpu2dImage = {
        texture: noTextureId()
        textureView: noTextureViewId()
        width: 0
        height: 0
      }
      canvas.images.set(index: handle - 1, value: gone)
      canvas.imagesFree.add(value: handle)
    }
  }
  canvas.imagesReleasing.clear()
}

# Is there an image under `handle` (not let go of)?
func canvasImageLive(canvas: view Gpu2dCanvas, handle: copy Int) ret Bool {
  if let image: view Gpu2dImage = canvas.images.viewAt(index: handle - 1) {
    ret image.width > 0
  }
  ret false
}

# Name -> handle registry. Re-registering a key updates it.
func canvasRegisterImageKey(canvas: mod Gpu2dCanvas, key: copy String, handle: copy Int) {
  if handle <= 0 {
    ret
  }
  canvas.imageKeys.set(k: key, value: handle)
}

func canvasImageHandleForKey(canvas: view Gpu2dCanvas, key: view String) ret Int {
  if let handle: Int = canvas.imageKeys.get(k: key) {
    ret handle
  }
  ret 0
}

# Decode + upload `path` and register it under `key` (handle, 0 on failure).
func canvasLoadImageKey(canvas: mod Gpu2dCanvas, key: copy String, path: copy String) ret Int {
  let handle: Int = canvasLoadImage(canvas: canvas, path: path)
  canvasRegisterImageKey(canvas: canvas, key: key, handle: handle)
  ret handle
}

# True if `key` resolves to a loaded image (so a renderer can fall back to a
# placeholder / mat: glyph when it doesn't).
func canvasHasImageKey(canvas: view Gpu2dCanvas, key: view String) ret Bool {
  ret canvasImageHandleForKey(canvas: canvas, key: key) > 0
}

func canvasImageCount(canvas: view Gpu2dCanvas) ret Int {
  ret canvas.images.length - canvas.imagesFree.length
}

func tintChannel(color: view Int, shift: view Int) ret Float {
  ret ((color / shift) % 256).toFloat() / 255.0
}

# Queue one image draw for this frame: rect, straight tint (the shader
# premultiplies), radius, uv window, and the clip active now — its rect +
# radius go into the draw's uniform so the image pipeline rounds a clip the
# way the box pipeline does (#1003). The canvas rotation turns the rect's
# center about the pivot and the quad about its center; `tiled` makes the
# shader wrap uv beyond 1.
func queueImage(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
) {
  queueImageEx(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
    u0: u0
    v0: v0
    u1: u1
    v1: v1
    tiled: false
  )
}

# The images queued from here on have their color turned by `hueDegrees` about the gray axis (as
# Pixi's ColorMatrixFilter.hue and the sprite's `hueRotate`: blue art turned 120 is red-ish, -65
# green-ish) and then scaled by `brightness` (1 unchanged), before the tint. One piece of art then
# serves every color. Until canvasClearImageColor, and cleared at every frame start.
func canvasSetImageColor(canvas: mod Gpu2dCanvas, hueDegrees: copy Float, brightness: copy Float) {
  canvas.imageHueRadians = hueDegrees * 3.14159265 / 180.0
  canvas.imageBrightness = brightness
}

func canvasClearImageColor(canvas: mod Gpu2dCanvas) {
  canvas.imageHueRadians = 0.0
  canvas.imageBrightness = 1.0
}

# A straight color as the image shader changes it (gpu2d_image.wgsl imageColor): turned by
# `hueDegrees` about the gray axis (Pixi's hue matrix: the rotation that keeps gray gray, with
# its 1/3 weights), scaled by `brightness`, held to 0..1. Channels 0..1.
type ImageColor {
  r: Float
  g: Float
  b: Float
}

func imageColorOf(
  r: view Float
  g: view Float
  b: view Float
  hueDegrees: view Float
  brightness: view Float
) ret ImageColor {
  let angle: Float = hueDegrees * 3.14159265 / 180.0
  let cosA: Float = Math.cos(x: angle)
  let sinA: Float = Math.sin(x: angle)
  let third: Float = 1.0 / 3.0
  let rootThird: Float = Math.sqrt(x: third)
  let same: Float = cosA + (1.0 - cosA) * third
  let ahead: Float = third * (1.0 - cosA) - rootThird * sinA
  let behind: Float = third * (1.0 - cosA) + rootThird * sinA
  ret ImageColor {
    r: Math.clamp(val: (r * same + g * ahead + b * behind) * brightness, low: 0.0, high: 1.0)
    g: Math.clamp(val: (r * behind + g * same + b * ahead) * brightness, low: 0.0, high: 1.0)
    b: Math.clamp(val: (r * ahead + g * behind + b * same) * brightness, low: 0.0, high: 1.0)
  }
}

func queueImageEx(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
  tiled: copy Bool
) {
  canvasKeepOrder(canvas: canvas, level: 1, atlas: -1)
  if canvasImageLive(canvas: canvas, handle: handle) is false {
    ret
  }
  var drawX: Float = x
  var drawY: Float = y
  if canvas.spinAngle is not 0.0 {
    let center: SpinPoint = spinPoint(canvas: canvas, x: x + w / 2.0, y: y + h / 2.0)
    drawX = center.x - w / 2.0
    drawY = center.y - h / 2.0
  }
  # The stage (Transform.rae), after the rotation: the area's coordinates to
  # the window's points
  let stageScale: Float = canvas.stageScale
  drawX = stageX(canvas: canvas, x: drawX)
  drawY = stageY(canvas: canvas, y: drawY)
  canvas.imageCommands.add(value: drawX)
  canvas.imageCommands.add(value: drawY)
  canvas.imageCommands.add(value: w * stageScale)
  canvas.imageCommands.add(value: h * stageScale)
  # the saturation in force (Gpu2dCanvas Transform.rae): of the tint here, of the texels in the
  # shader (uImg[7].x)
  tint = saturatedColor(color: tint, saturation: canvas.saturation)
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 65536))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 256))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 1))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 16777216) * canvas.layerAlpha)
  canvas.imageCommands.add(value: radius * stageScale)
  canvas.imageCommands.add(value: canvas.spinAngle)
  var tileFlag: Float = 0.0
  if tiled {
    tileFlag = 1.0
  }
  canvas.imageCommands.add(value: tileFlag)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: u0)
  canvas.imageCommands.add(value: v0)
  canvas.imageCommands.add(value: u1 - u0)
  canvas.imageCommands.add(value: v1 - v0)
  let clip: Int = canvas.currentClip
  # the clip's origin and size, radius and enabled (uImg[4], uImg[5].xy); its frame goes last
  loop var part: Int = 0, part < 6, ++part {
    let value: Float = clipShapeFloat(canvas: canvas, clip: clip, part: part)
    canvas.imageCommands.add(value: value)
  }
  # the color change (canvasSetImageColor): the hue turn in radians and the brightness less 1, so
  # an image queued with none is 0, 0 as before
  canvas.imageCommands.add(value: canvas.imageHueRadians)
  canvas.imageCommands.add(value: canvas.imageBrightness - 1.0)
  # uImg[6]: the clip's frame (a design offset from its origin into the node's)
  loop var part: Int = 8, part < 12, ++part {
    let value: Float = clipShapeFloat(canvas: canvas, clip: clip, part: part)
    canvas.imageCommands.add(value: value)
  }
  # uImg[7]: the saturation of the texels
  canvas.imageCommands.add(value: canvas.saturation)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommandHandles.add(value: handle)
  canvas.imageCommandClips.add(value: clip)
}

# The borders of a nine-slice as drawn in a w x h box
type NineSliceBorders {
  left: Float
  top: Float
  right: Float
  bottom: Float
}

# A nine-slice's borders keep their size (in design units, one a source pixel) while two of them
# fit the box; in a smaller box all four shrink together by one scale, s = min(1, w / (left +
# right), h / (top + bottom)), as Pixi's NineSliceSprite and CSS border-image do. So a ribbon
# whose art has 256-px caps, drawn 52 high, keeps its shape: its caps are 52 wide and its middle
# stretches between them.
func nineSliceBorders(
  w: view Float
  h: view Float
  left: view Float
  top: view Float
  right: view Float
  bottom: view Float
) ret NineSliceBorders {
  var scale: Float = 1.0
  if left + right > 0.0 {
    scale = Math.min(a: scale, b: w / (left + right))
  }
  if top + bottom > 0.0 {
    scale = Math.min(a: scale, b: h / (top + bottom))
  }
  scale = Math.max(a: scale, b: 0.0)
  ret NineSliceBorders {
    left: left * scale
    top: top * scale
    right: right * scale
    bottom: bottom * scale
  }
}

# Nine-slice (#1003): the image's `left/top/right/bottom` source pixels are drawn `borderScale`
# DESIGN units each at the destination's edges (1: as many units as pixels; 1/3 for art made at 3
# canvas units a point, laid out in points), the middle stretches: nine sub-rect draws of one
# texture. In a box smaller than two borders they all shrink together (nineSliceBorders).
func canvasDrawImageKeyNineSlice(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  left: copy Float
  top: copy Float
  right: copy Float
  bottom: copy Float
  borderScale: copy Float
  tint: copy Int
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 or handle > canvas.images.length or w <= 0.0 or h <= 0.0 {
    ret
  }
  var imageWidth: Float = 0.0
  var imageHeight: Float = 0.0
  if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
    imageWidth = image.width.toFloat()
    imageHeight = image.height.toFloat()
  }
  if imageWidth <= 0.0 or imageHeight <= 0.0 {
    ret
  }
  # the drawn thickness, before the shrink to fit; the source pixels stay what is sampled
  let scale: Float = Math.max(a: borderScale, b: 0.0)
  let borders: NineSliceBorders = nineSliceBorders(
    w: w
    h: h
    left: left * scale
    top: top * scale
    right: right * scale
    bottom: bottom * scale
  )
  let xs: List(Float) = { x, x + borders.left, x + w - borders.right, x + w }
  let ys: List(Float) = { y, y + borders.top, y + h - borders.bottom, y + h }
  let us: List(Float) = { 0.0, left / imageWidth, 1.0 - right / imageWidth, 1.0 }
  let vs: List(Float) = { 0.0, top / imageHeight, 1.0 - bottom / imageHeight, 1.0 }
  loop var row: Int = 0, row < 3, ++row {
    loop var column: Int = 0, column < 3, ++column {
      let x0: Float = xs.copyAtFallback(index: column, fallback: x)
      let x1: Float = xs.copyAtFallback(index: column + 1, fallback: x)
      let y0: Float = ys.copyAtFallback(index: row, fallback: y)
      let y1: Float = ys.copyAtFallback(index: row + 1, fallback: y)
      if x1 - x0 <= 0.0 or y1 - y0 <= 0.0 {
        continue
      }
      queueImageEx(
        canvas: canvas
        x: x0
        y: y0
        w: x1 - x0
        h: y1 - y0
        radius: 0.0
        handle: handle
        tint: tint
        u0: us.copyAtFallback(index: column, fallback: 0.0)
        v0: vs.copyAtFallback(index: row, fallback: 0.0)
        u1: us.copyAtFallback(index: column + 1, fallback: 1.0)
        v1: vs.copyAtFallback(index: row + 1, fallback: 1.0)
        tiled: false
      )
    }
  }
}

# Tiled (#1003): the image repeats `tileX` x `tileY` times across the rect.
func canvasDrawImageKeyTiled(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
  tileX: copy Float
  tileY: copy Float
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 {
    ret
  }
  queueImageEx(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
    u0: 0.0
    v0: 0.0
    u1: Math.max(a: tileX, b: 0.01)
    v1: Math.max(a: tileY, b: 0.01)
    tiled: true
  )
}

# Queue an image draw (handle from canvasLoadImage). tint is 0xAARRGGBB applied
# multiplicatively (0xFFFFFFFF for the unmodified image); radius rounds the
# corners (design units).
func canvasDrawImage(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
) {
  queueImage(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
    u0: 0.0
    v0: 0.0
    u1: 1.0
    v1: 1.0
  )
}

# Draw a registered image by key (no-op if the key isn't registered).
func canvasDrawImageKey(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle > 0 {
    canvasDrawImage(
      canvas: canvas
      x: x
      y: y
      w: w
      h: h
      radius: radius
      handle: handle
      tint: tint
    )
  }
}

# Draw by key preserving the image's aspect: scaleMode 0 = fit (letterbox
# inside the rect), 1 = fill (center-crop the source), anything else = stretch.
func canvasDrawImageKeyScaled(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
  scaleMode: copy Int
) {
  canvasDrawImageKeyScaledIn(
    canvas: canvas
    key: key
    x: x
    y: y
    w: w
    h: h
    radius: radius
    tint: tint
    scaleMode: scaleMode
    frameScaleX: 1.0
    frameScaleY: 1.0
  )
}

# The same in a box that is a node's own box scaled by (frameScaleX, frameScaleY): the image is
# fitted (or filled) in the node's own box and then scaled with it, so under an uneven scale it is
# squeezed with its node rather than drawn evenly smaller in the squeezed box
func canvasDrawImageKeyScaledIn(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
  scaleMode: copy Int
  frameScaleX: copy Float
  frameScaleY: copy Float
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 or handle > canvas.images.length or w <= 0.0 or h <= 0.0 {
    ret
  }
  var imageWidth: Float = 0.0
  var imageHeight: Float = 0.0
  if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
    imageWidth = image.width.toFloat()
    imageHeight = image.height.toFloat()
  }
  if imageWidth <= 0.0 or imageHeight <= 0.0 {
    canvasDrawImage(
      canvas: canvas
      x: x
      y: y
      w: w
      h: h
      radius: radius
      handle: handle
      tint: tint
    )
    ret
  }
  let imageAspect: Float = imageWidth / imageHeight
  # the aspect of the node's own box: the drawn box with its frame's scales taken out
  var squeeze: Float = 1.0
  if Math.abs(value: frameScaleX) > 0.000001 and Math.abs(value: frameScaleY) > 0.000001 {
    squeeze = Math.abs(value: frameScaleX) / Math.abs(value: frameScaleY)
  }
  let targetAspect: Float = w / h / squeeze
  var drawX: Float = x
  var drawY: Float = y
  var drawW: Float = w
  var drawH: Float = h
  var u0: Float = 0.0
  var v0: Float = 0.0
  var u1: Float = 1.0
  var v1: Float = 1.0
  if scaleMode is 0 {
    # fitted in the node's own box, then squeezed with it
    if imageAspect > targetAspect {
      drawH = w / squeeze / imageAspect
      drawY = y + (h - drawH) * 0.5
    } else {
      drawW = h * imageAspect * squeeze
      drawX = x + (w - drawW) * 0.5
    }
  } else if scaleMode is 1 {
    if imageAspect > targetAspect {
      let visibleW: Float = targetAspect / imageAspect
      u0 = (1.0 - visibleW) * 0.5
      u1 = u0 + visibleW
    } else if imageAspect < targetAspect {
      let visibleH: Float = imageAspect / targetAspect
      v0 = (1.0 - visibleH) * 0.5
      v1 = v0 + visibleH
    }
  }
  queueImage(
    canvas: canvas
    x: drawX
    y: drawY
    w: drawW
    h: drawH
    radius: radius
    handle: handle
    tint: tint
    u0: u0
    v0: v0
    u1: u1
    v1: v1
  )
}

# This draw slot's 64-byte uniform (persistent pool, grown on demand).
func imageUniformAt(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  slot: copy Int
) ret BufferId {
  loop canvas.imageUniforms.length <= slot {
    canvas.imageUniforms.add(value: noBufferId())
    canvas.imageBinds.add(value: noBindGroupId())
    canvas.imageBindHandles.add(value: 0)
  }
  var current: BufferId = noBufferId()
  if let known: BufferId = canvas.imageUniforms.copyAt(index: slot) {
    current = known
  }
  if isValidBuffer(resources: resources, id: current) {
    ret current
  }
  if let buffer: BufferId = createBuffer(
    resources: resources
    size: imageUniformFloats * 4
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    canvas.imageUniforms.set(index: slot, value: buffer)
    ret buffer
  }
  ret noBufferId()
}

# One draw per queued image into the active frame pass, then clear the queue.
# The bind group for a draw slot is rebuilt only when the slot's image handle
# changed (or the pipeline was rebuilt), as the C flush cached it.
func clearImageQueue(canvas: mod Gpu2dCanvas) {
  canvas.imageCommands.clear()
  canvas.imageCommandHandles.clear()
  canvas.imageCommandClips.clear()
}

func imageFlushWith(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if not canvasFrameActive(canvas: canvas) {
    ret
  }
  ensureImagePipeline(canvas: canvas, resources: resources)
  if not isValidRenderPipeline(resources: resources, id: canvas.imagePipeline) {
    clearImageQueue(canvas: canvas)
    ret
  }
  loop var i: Int = 0, i < canvas.imageCommandHandles.length, ++i {
    var handle: Int = 0
    if let known: Int = canvas.imageCommandHandles.copyAt(index: i) {
      handle = known
    }
    if handle >= 1 and handle <= canvas.images.length {
      imageDrawCommand(
        canvas: canvas
        resources: resources
        index: i
        handle: handle
      )
    }
  }
  clearImageQueue(canvas: canvas)
}

func imageDrawCommand(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  index: copy Int
  handle: copy Int
) {
  let i: Int = index
  let slot: Int = canvas.imageDrawCursor
  canvas.imageDrawCursor = slot + 1
  let uniform: BufferId = imageUniformAt(canvas: canvas, resources: resources, slot: slot)
  canvas.imageScratch.clear()
  loop var k: Int = 0, k < imageUniformFloats, ++k {
    var value: Float = 0.0
    if let known: Float = canvas.imageCommands.copyAt(index: i * imageUniformFloats + k) {
      value = known
    }
    canvas.imageScratch.add(value: value)
  }
  unsafe {
    if not writeBufferFromPtr(
      resources: resources
      id: uniform
      offset: 0
      data: canvas.imageScratch.data
      size: imageUniformFloats * 4
    ) {
      ret
    }
  }
  var cachedHandle: Int = 0
  if let known: Int = canvas.imageBindHandles.copyAt(index: slot) {
    cachedHandle = known
  }
  var bind: BindGroupId = noBindGroupId()
  if let known: BindGroupId = canvas.imageBinds.copyAt(index: slot) {
    bind = known
  }
  if cachedHandle is not handle or not bindGroupIsUsable(resources: resources, id: bind) {
    retireBindGroup(resources: resources, id: bind)
    bind = noBindGroupId()
    if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
      var entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
      entries.add(value: bufferRef(id: canvas.viewport))
      entries.add(value: bufferRef(id: uniform))
      entries.add(value: textureViewRef(id: image.textureView))
      entries.add(value: samplerRef(id: canvas.imageSampler))
      if let made: BindGroupId = createRenderBindGroup(
        resources: resources
        pipeline: canvas.imagePipeline
        entries: entries
      ) {
        bind = made
      }
    }
    canvas.imageBinds.set(index: slot, value: bind)
    canvas.imageBindHandles.set(index: slot, value: handle)
  }
  var clip: Int = 0
  if let known: Int = canvas.imageCommandClips.copyAt(index: i) {
    clip = known
  }
  g2dScissor(canvas: canvas, clip: clip)
  unsafe {
    let drawn: Bool = recordDrawInPass(
      resources: resources
      pass: canvas.framePass
      pipeline: canvas.imagePipeline
      bindGroup: bind
      vertexCount: 6
      instanceCount: 1
      firstVertex: 0
      firstInstance: 0
    )
    if drawn {
      canvas.drawCalls = canvas.drawCalls + 1
    }
  }
}
