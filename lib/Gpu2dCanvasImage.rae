# Gpu2dCanvasImage — the 2D canvas's image pass (#908; #918 split of
# Gpu2dCanvas for the 1000-line cap): images are decoded by C (stb_image, CPU
# RGBA) and uploaded here into manager textures; the 1-based image handle
# indexes `canvas.images`, the key registry maps a name to a handle
# (ImageRegistry.rae keeps the load / retry / cache policy over it). Each
# queued draw is one 64-byte uniform + one bind group [viewport, uniform,
# view, sampler], cached per draw slot by handle; draws go after the boxes,
# before text (Gpu2dCanvasFrame drives the flush).
import String
import Math
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuRenderPass
open gpu/GpuIds
open Gpu2dCanvas
open Gpu2dCanvasClip

func ensureImagePipeline(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if canvas.imagePipeMade {
    ret
  }
  canvas.imagePipeMade = true
  var source: String = ""
  unsafe {
    source = nativeG2dBoxReadFile(path: "lib/gpu2d_image.wgsl")
  }
  if source.length() is 0 {
    log(
      "[gpu2d] lib/gpu2d_image.wgsl not readable from the working directory — run from the repo root; 2D images are skipped"
    )
    ret
  }
  var format: Int = 0
  unsafe {
    format = nativeG2dBoxFormat()
  }
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    wgsl: source
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: boxPipelineSpec(format: format as Int32)
  ) {
    canvas.imagePipeline = pipeline
  }
  # Linear, clamp-to-edge (the C image path shared the text sampler's settings).
  if let sampler: SamplerId = createSampler(resources: resources) {
    canvas.imageSampler = sampler
  }
  ensureViewportUniform(canvas: canvas, resources: resources)
}

# Registers an uploaded RGBA8 texture (w x h) as the next 1-based handle.
func registerImageTexture(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  texture: view TextureId
  width: copy Int
  height: copy Int
) ret Int {
  if let textureView: TextureViewId = createTextureView(resources: resources, texture: texture) {
    canvas.images.add(
      value: { texture: texture, textureView: textureView, width: width, height: height }
    )
    ret canvas.images.length
  }
  retireTexture(resources: resources, id: texture)
  ret 0
}

# Decode an image file (C, stb_image) and upload it as an RGBA8 texture.
# Returns the 1-based handle, 0 on failure (the caller renders its placeholder).
func canvasLoadImage(canvas: mod Gpu2dCanvas, path: copy String) ret Int {
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources => canvas.gpuResources {
    unsafe {
      let rgba: Ptr = g2dDecodeImage(path: path)
      if rgba is webgpuNull() {
        ret 0
      }
      let width: Int = g2dDecodedWidth()
      let height: Int = g2dDecodedHeight()
      if let texture: TextureId = createTexture(
        resources: resources
        width: width
        height: height
        format: WGPUTextureFormat_RGBA8Unorm
        usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
      ) {
        if writeTextureFromPtr(
          resources: resources
          texture: texture
          data: rgba
          bytesPerRow: width * 4
          rows: height
        ) {
          handle = registerImageTexture(
            canvas: canvas
            resources: resources
            texture: texture
            width: width
            height: height
          )
        } else {
          retireTexture(resources: resources, id: texture)
        }
      }
      g2dDecodeFree(rgba: rgba)
    }
  }
  ret handle
}

# Register an image from RGBA pixels generated in Rae (#539 procedural
# textures): each Int is one packed pixel r | g<<8 | b<<16 | a<<24 (byte order
# R,G,B,A, matching RGBA8Unorm). Returns a 1-based handle, 0 on failure.
func canvasRegisterImageRgba(
  canvas: mod Gpu2dCanvas
  pixels: view Buffer(Int)
  width: copy Int
  height: copy Int
) ret Int {
  if width <= 0 or height <= 0 {
    ret 0
  }
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources => canvas.gpuResources {
    let count: Int = width * height
    let bytes: List(UInt8) = List.create(UInt8, cap: count * 4)
    unsafe {
      loop var i: Int = 0, i < count, ++i {
        let packed: Int = rae_ext_rae_buf_get(buf: pixels, index: i)
        bytes.add(value: (packed % 256) as UInt8)
        bytes.add(value: ((packed / 256) % 256) as UInt8)
        bytes.add(value: ((packed / 65536) % 256) as UInt8)
        bytes.add(value: ((packed / 16777216) % 256) as UInt8)
      }
    }
    if let texture: TextureId = createTexture(
      resources: resources
      width: width
      height: height
      format: WGPUTextureFormat_RGBA8Unorm
      usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
    ) {
      if writeTexture(
        resources: resources
        texture: texture
        bytes: bytes
        bytesPerRow: width * 4
      ) {
        handle = registerImageTexture(
          canvas: canvas
          resources: resources
          texture: texture
          width: width
          height: height
        )
      } else {
        retireTexture(resources: resources, id: texture)
      }
    }
  }
  ret handle
}

# Name -> handle registry. Re-registering a key updates it.
func canvasRegisterImageKey(canvas: mod Gpu2dCanvas, key: copy String, handle: copy Int) {
  if handle <= 0 {
    ret
  }
  loop var i: Int = 0, i < canvas.imageKeys.length, ++i {
    if let existing: String = canvas.imageKeys.copyAt(index: i) {
      if existing is key {
        canvas.imageKeyHandles.set(index: i, value: handle)
        ret
      }
    }
  }
  canvas.imageKeys.add(value: key)
  canvas.imageKeyHandles.add(value: handle)
}

func canvasImageHandleForKey(canvas: view Gpu2dCanvas, key: view String) ret Int {
  loop var i: Int = 0, i < canvas.imageKeys.length, ++i {
    if let existing: String = canvas.imageKeys.copyAt(index: i) {
      if existing is key {
        if let handle: Int = canvas.imageKeyHandles.copyAt(index: i) {
          ret handle
        }
      }
    }
  }
  ret 0
}

# Decode + upload `path` and register it under `key` (handle, 0 on failure).
func canvasLoadImageKey(canvas: mod Gpu2dCanvas, key: copy String, path: copy String) ret Int {
  let handle: Int = canvasLoadImage(canvas: canvas, path: path)
  canvasRegisterImageKey(canvas: canvas, key: key, handle: handle)
  ret handle
}

# True if `key` resolves to a loaded image (so a renderer can fall back to a
# placeholder / mat: glyph when it doesn't).
func canvasHasImageKey(canvas: view Gpu2dCanvas, key: view String) ret Bool {
  ret canvasImageHandleForKey(canvas: canvas, key: key) > 0
}

func canvasImageCount(canvas: view Gpu2dCanvas) ret Int {
  ret canvas.images.length
}

func tintChannel(color: view Int, shift: view Int) ret Float {
  ret ((color / shift) % 256).toFloat() / 255.0
}

# Queue one image draw for this frame: rect, straight tint (the shader
# premultiplies), radius, uv window, and the clip active now — its rect +
# radius go into the draw's uniform so the image pipeline rounds a clip the
# way the box pipeline does (#1003). The canvas rotation turns the rect's
# centre about the pivot and the quad about its centre; `tiled` makes the
# shader wrap uv beyond 1.
func queueImage(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
) {
  queueImageEx(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
    u0: u0
    v0: v0
    u1: u1
    v1: v1
    tiled: false
  )
}

func queueImageEx(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
  tiled: copy Bool
) {
  if handle < 1 or handle > canvas.images.length {
    ret
  }
  var drawX: Float = x
  var drawY: Float = y
  if canvas.spinAngle is not 0.0 {
    let centre: SpinPoint = spinPoint(canvas: canvas, x: x + w / 2.0, y: y + h / 2.0)
    drawX = centre.x - w / 2.0
    drawY = centre.y - h / 2.0
  }
  canvas.imageCommands.add(value: drawX)
  canvas.imageCommands.add(value: drawY)
  canvas.imageCommands.add(value: w)
  canvas.imageCommands.add(value: h)
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 65536))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 256))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 1))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 16777216))
  canvas.imageCommands.add(value: radius)
  canvas.imageCommands.add(value: canvas.spinAngle)
  var tileFlag: Float = 0.0
  if tiled {
    tileFlag = 1.0
  }
  canvas.imageCommands.add(value: tileFlag)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: u0)
  canvas.imageCommands.add(value: v0)
  canvas.imageCommands.add(value: u1 - u0)
  canvas.imageCommands.add(value: v1 - v0)
  let clip: Int = canvas.currentClip
  let rounded: Bool = not clipIsFull(canvas: canvas, clip: clip) and clipFloatAt(
    list: canvas.clipRadius
    index: clip
  ) > 0.0
  if rounded {
    canvas.imageCommands.add(value: clipFloatAt(list: canvas.clipX, index: clip))
    canvas.imageCommands.add(value: clipFloatAt(list: canvas.clipY, index: clip))
    canvas.imageCommands.add(value: clipFloatAt(list: canvas.clipW, index: clip))
    canvas.imageCommands.add(value: clipFloatAt(list: canvas.clipH, index: clip))
    canvas.imageCommands.add(value: clipFloatAt(list: canvas.clipRadius, index: clip))
    canvas.imageCommands.add(value: 1.0)
  } else {
    loop var k: Int = 0, k < 6, ++k {
      canvas.imageCommands.add(value: 0.0)
    }
  }
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommandHandles.add(value: handle)
  canvas.imageCommandClips.add(value: clip)
}

# Nine-slice (#1003): the image's `left/top/right/bottom` source pixels stay
# that many DESIGN units thick at the destination's edges, the middle
# stretches — nine sub-rect draws of one texture.
func canvasDrawImageKeyNineSlice(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  left: copy Float
  top: copy Float
  right: copy Float
  bottom: copy Float
  tint: copy Int
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 or handle > canvas.images.length or w <= 0.0 or h <= 0.0 {
    ret
  }
  var imageWidth: Float = 0.0
  var imageHeight: Float = 0.0
  if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
    imageWidth = image.width.toFloat()
    imageHeight = image.height.toFloat()
  }
  if imageWidth <= 0.0 or imageHeight <= 0.0 {
    ret
  }
  # Borders never exceed half the destination (a tiny box keeps its corners).
  let borderL: Float = Math.min(a: left, b: w / 2.0)
  let borderR: Float = Math.min(a: right, b: w / 2.0)
  let borderT: Float = Math.min(a: top, b: h / 2.0)
  let borderB: Float = Math.min(a: bottom, b: h / 2.0)
  let xs: List(Float) = { x, x + borderL, x + w - borderR, x + w }
  let ys: List(Float) = { y, y + borderT, y + h - borderB, y + h }
  let us: List(Float) = { 0.0, left / imageWidth, 1.0 - right / imageWidth, 1.0 }
  let vs: List(Float) = { 0.0, top / imageHeight, 1.0 - bottom / imageHeight, 1.0 }
  loop var row: Int = 0, row < 3, ++row {
    loop var column: Int = 0, column < 3, ++column {
      let x0: Float = xs.copyAtFallback(index: column, fallback: x)
      let x1: Float = xs.copyAtFallback(index: column + 1, fallback: x)
      let y0: Float = ys.copyAtFallback(index: row, fallback: y)
      let y1: Float = ys.copyAtFallback(index: row + 1, fallback: y)
      if x1 - x0 <= 0.0 or y1 - y0 <= 0.0 {
        continue
      }
      queueImageEx(
        canvas: canvas
        x: x0
        y: y0
        w: x1 - x0
        h: y1 - y0
        radius: 0.0
        handle: handle
        tint: tint
        u0: us.copyAtFallback(index: column, fallback: 0.0)
        v0: vs.copyAtFallback(index: row, fallback: 0.0)
        u1: us.copyAtFallback(index: column + 1, fallback: 1.0)
        v1: vs.copyAtFallback(index: row + 1, fallback: 1.0)
        tiled: false
      )
    }
  }
}

# Tiled (#1003): the image repeats `tileX` x `tileY` times across the rect.
func canvasDrawImageKeyTiled(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
  tileX: copy Float
  tileY: copy Float
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 {
    ret
  }
  queueImageEx(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
    u0: 0.0
    v0: 0.0
    u1: Math.max(a: tileX, b: 0.01)
    v1: Math.max(a: tileY, b: 0.01)
    tiled: true
  )
}

# Queue an image draw (handle from canvasLoadImage). tint is 0xAARRGGBB applied
# multiplicatively (0xFFFFFFFF for the unmodified image); radius rounds the
# corners (design units).
func canvasDrawImage(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  handle: copy Int
  tint: copy Int
) {
  queueImage(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radius: radius
    handle: handle
    tint: tint
    u0: 0.0
    v0: 0.0
    u1: 1.0
    v1: 1.0
  )
}

# Draw a registered image by key (no-op if the key isn't registered).
func canvasDrawImageKey(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle > 0 {
    canvasDrawImage(
      canvas: canvas
      x: x
      y: y
      w: w
      h: h
      radius: radius
      handle: handle
      tint: tint
    )
  }
}

# Draw by key preserving the image's aspect: scaleMode 0 = fit (letterbox
# inside the rect), 1 = fill (center-crop the source), anything else = stretch.
func canvasDrawImageKeyScaled(
  canvas: mod Gpu2dCanvas
  key: view String
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  tint: copy Int
  scaleMode: copy Int
) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 or handle > canvas.images.length or w <= 0.0 or h <= 0.0 {
    ret
  }
  var imageWidth: Float = 0.0
  var imageHeight: Float = 0.0
  if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
    imageWidth = image.width.toFloat()
    imageHeight = image.height.toFloat()
  }
  if imageWidth <= 0.0 or imageHeight <= 0.0 {
    canvasDrawImage(
      canvas: canvas
      x: x
      y: y
      w: w
      h: h
      radius: radius
      handle: handle
      tint: tint
    )
    ret
  }
  let imageAspect: Float = imageWidth / imageHeight
  let targetAspect: Float = w / h
  var drawX: Float = x
  var drawY: Float = y
  var drawW: Float = w
  var drawH: Float = h
  var u0: Float = 0.0
  var v0: Float = 0.0
  var u1: Float = 1.0
  var v1: Float = 1.0
  if scaleMode is 0 {
    if imageAspect > targetAspect {
      drawH = w / imageAspect
      drawY = y + (h - drawH) * 0.5
    } else {
      drawW = h * imageAspect
      drawX = x + (w - drawW) * 0.5
    }
  } else if scaleMode is 1 {
    if imageAspect > targetAspect {
      let visibleW: Float = targetAspect / imageAspect
      u0 = (1.0 - visibleW) * 0.5
      u1 = u0 + visibleW
    } else if imageAspect < targetAspect {
      let visibleH: Float = imageAspect / targetAspect
      v0 = (1.0 - visibleH) * 0.5
      v1 = v0 + visibleH
    }
  }
  queueImage(
    canvas: canvas
    x: drawX
    y: drawY
    w: drawW
    h: drawH
    radius: radius
    handle: handle
    tint: tint
    u0: u0
    v0: v0
    u1: u1
    v1: v1
  )
}

# This draw slot's 64-byte uniform (persistent pool, grown on demand).
func imageUniformAt(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  slot: copy Int
) ret BufferId {
  loop canvas.imageUniforms.length <= slot {
    canvas.imageUniforms.add(value: noBufferId())
    canvas.imageBinds.add(value: noBindGroupId())
    canvas.imageBindHandles.add(value: 0)
  }
  var current: BufferId = noBufferId()
  if let known: BufferId = canvas.imageUniforms.copyAt(index: slot) {
    current = known
  }
  if isValidBuffer(resources: resources, id: current) {
    ret current
  }
  if let buffer: BufferId = createBuffer(
    resources: resources
    size: imageUniformFloats * 4
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    canvas.imageUniforms.set(index: slot, value: buffer)
    ret buffer
  }
  ret noBufferId()
}

# One draw per queued image into the active frame pass, then clear the queue.
# The bind group for a draw slot is rebuilt only when the slot's image handle
# changed (or the pipeline was rebuilt), as the C flush cached it.
func clearImageQueue(canvas: mod Gpu2dCanvas) {
  canvas.imageCommands.clear()
  canvas.imageCommandHandles.clear()
  canvas.imageCommandClips.clear()
}

func imageFlushWith(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if not canvasFrameActive(canvas: canvas) {
    ret
  }
  ensureImagePipeline(canvas: canvas, resources: resources)
  if not isValidRenderPipeline(resources: resources, id: canvas.imagePipeline) {
    clearImageQueue(canvas: canvas)
    ret
  }
  let bytes: List(UInt8) = List.create(UInt8, cap: imageUniformFloats * 4)
  loop var i: Int = 0, i < canvas.imageCommandHandles.length, ++i {
    var handle: Int = 0
    if let known: Int = canvas.imageCommandHandles.copyAt(index: i) {
      handle = known
    }
    if handle >= 1 and handle <= canvas.images.length {
      imageDrawCommand(
        canvas: canvas
        resources: resources
        index: i
        handle: handle
      )
    }
  }
  clearImageQueue(canvas: canvas)
}

func imageDrawCommand(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  index: copy Int
  handle: copy Int
) {
  let i: Int = index
  let slot: Int = canvas.imageDrawCursor
  canvas.imageDrawCursor = slot + 1
  let uniform: BufferId = imageUniformAt(canvas: canvas, resources: resources, slot: slot)
  canvas.imageScratch.clear()
  loop var k: Int = 0, k < imageUniformFloats, ++k {
    var value: Float = 0.0
    if let known: Float = canvas.imageCommands.copyAt(index: i * imageUniformFloats + k) {
      value = known
    }
    canvas.imageScratch.add(value: value)
  }
  unsafe {
    if not writeBufferFromPtr(
      resources: resources
      id: uniform
      offset: 0
      data: canvas.imageScratch.data
      size: imageUniformFloats * 4
    ) {
      ret
    }
  }
  var cachedHandle: Int = 0
  if let known: Int = canvas.imageBindHandles.copyAt(index: slot) {
    cachedHandle = known
  }
  var bind: BindGroupId = noBindGroupId()
  if let known: BindGroupId = canvas.imageBinds.copyAt(index: slot) {
    bind = known
  }
  if cachedHandle is not handle or not bindGroupIsUsable(resources: resources, id: bind) {
    retireBindGroup(resources: resources, id: bind)
    bind = noBindGroupId()
    if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
      let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
      entries.add(value: bufferRef(id: canvas.viewport))
      entries.add(value: bufferRef(id: uniform))
      entries.add(value: textureViewRef(id: image.textureView))
      entries.add(value: samplerRef(id: canvas.imageSampler))
      if let made: BindGroupId = createRenderBindGroup(
        resources: resources
        pipeline: canvas.imagePipeline
        entries: entries
      ) {
        bind = made
      }
    }
    canvas.imageBinds.set(index: slot, value: bind)
    canvas.imageBindHandles.set(index: slot, value: handle)
  }
  var clip: Int = 0
  if let known: Int = canvas.imageCommandClips.copyAt(index: i) {
    clip = known
  }
  g2dScissor(canvas: canvas, clip: clip)
  unsafe {
    let drawn: Bool = recordDrawInPass(
      resources: resources
      pass: canvas.framePass
      pipeline: canvas.imagePipeline
      bindGroup: bind
      vertexCount: 6
      instanceCount: 1
      firstVertex: 0
      firstInstance: 0
    )
  }
}
