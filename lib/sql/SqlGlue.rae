  stmt: Int
  index: Int
  bytes: Buffer(UInt8)
  offset: Int
  count: Int
) unsafe extern("rae_sql_bind_text") ret Int

func rae_sql_bind_blob(
  stmt: Int
  index: Int
  bytes: Buffer(UInt8)
  offset: Int
  count: Int
) unsafe extern("rae_sql_bind_blob") ret Int

func rae_sql_bind_null(stmt: Int, index: Int) unsafe extern("rae_sql_bind_null") ret Int

func rae_sql_column_count(stmt: Int) unsafe extern("rae_sql_column_count") ret Int

func rae_sql_column_type(stmt: Int, column: Int) unsafe extern("rae_sql_column_type") ret Int

func rae_sql_column_int(stmt: Int, column: Int) unsafe extern("rae_sql_column_int") ret Int

