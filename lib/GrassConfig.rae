# Grass view/camera profiles (#492): reparameterise the ONE GPU grass system for
# different camera setups instead of hard-coding third-person assumptions. The
# same compute + indirect-draw pipeline is fed different numbers, so a top-down
# mode is a config change, not a separate renderer.
#
# GrassViewSettings carries the knobs the compute/render shaders consume via the
# grass uniform (see grassGenerate). Presets ship for THIRD-PERSON (tall, dense,
# detailed close blades) and TOP-DOWN/ISOMETRIC (shorter + wider blades for
# ground coverage from above, larger visible radius, lower density) — the two
# ends of the range #515's top-down vegetation work spans.
#
# NOTE: this is the view/camera-profile half of #492. The biome-REGION half
# (per-region params via ECS + a spatial biome map the compute samples) is a
# separate sub-system, filed as follow-up.
import Math
import Vec3
import Sys

# The blade shapes: preQueue a flat tapered quad, lowPoly a curved
# four-segment blade (the stylized low-poly look the meadow uses), ribbons a
# tuft of curved ribbons, textured crossed cut-out tuft pictures, painted one
# opaque triangle a blade whose look is all in its shading: lit as the ground
# (an up normal), colored by grass_field.wgsl's paint field and palette at its
# root (grassPaintAt, grassPaintColor), dark at the root and light at the tip
enum GrassShape {
  preQueue
  lowPoly
  ribbons
  textured
  painted
}

# One shared capture override; placement and app tuning remain unchanged.
func grassShapeOverride() ret Int {
  let name: String = Sys.getEnv(name: "RAE_GRASS_SHAPE")
  if name is "control" {
    ret 0
  }
  if name is "lowPoly" {
    ret 1
  }
  if name is "ribbons" {
    ret 2
  }
  if name is "textured" {
    ret 3
  }
  if name is "painted" {
    ret 4
  }
  ret -1
}

func grassVertexCount(shape: view Int) ret Int {
  if shape is 0 {
    ret 6
  }
  if shape is 1 {
    ret 24
  }
  if shape is 2 {
    ret 288
  }
  if shape is 4 {
    ret 3
  }
  ret 18
}

type GrassViewSettings {
  shape: GrassShape = GrassShape.textured
  enabled: Bool
  extent: Float  # candidate-grid span / render distance (world units)
  windStrength: Float  # response to the app's shared WindVector
  windGust: Float  # response to its broad traveling gusts
  bladeHeightScale: Float  # scales the per-blade height (top-down wants shorter)
  bladeWidthScale: Float  # scales blade width (top-down wants wider for coverage)
  densityScale: Float  # 0..1 fraction of candidate blades kept
  # 0..1: how far blades lean away from a camera looking down at them (and the
  # painted blade turns its face to it), so they cover the ground seen from
  # above instead of showing their edges and the ground between (0: upright)
  cameraTilt: Float = 0.0
  # A ring of grass instead of a disc: no blades within innerRadius (m) of the
  # middle, and they grow in over innerFade (m) on each side of it, so a nearer
  # field can shrink out where this one grows in (0: a disc)
  innerRadius: Float = 0.0
  innerFade: Float = 3.0
  # Zero preserves uniform placement; one groups blades in broad world-space patches.
  clusterStrength: Float = 0.0
  patchScale: Float = 8.0  # average patch span in world meters
  patchCoverage: Float = 0.72  # broad ground share covered before density thinning
  patchFeather: Float = 0.12  # soft stochastic boundary in noise-value units
  bladeVariation: Float = 1.0  # size/lean/color variation within a patch
  distanceStart: Float = 0.35  # radius share where distance thinning begins
  farDensityScale: Float = 0.22  # candidate share kept at the outer edge
  farWidthScale: Float = 1.28  # modest silhouette compensation for the thinning
  groundColor: Vec3  # gradient bottom = terrain ground color
  tipLighten: Float  # gradient top multiplier (>1 lighter)
  # The ground palette's dry grass and how far the driest soil has gone to
  # it (app3d/GroundPalette; 0: the ground color everywhere)
  dryColor: Vec3 = Vec3.create(x: 0.2, y: 0.15, z: 0.045)
  dryAmount: Float = 0.0
}

# Third-person: the tuned baseline — tall, dense, detailed blades close to camera.
func grassThirdPersonSettings(groundColor: copy Vec3) ret GrassViewSettings {
  ret GrassViewSettings {
    enabled: true
    extent: 40.0
    windStrength: 1.0
    windGust: 1.0
    bladeHeightScale: 1.0
    bladeWidthScale: 1.0
    densityScale: 1.0
    patchScale: 8.0
    patchCoverage: 0.72
    patchFeather: 0.12
    bladeVariation: 1.0
    distanceStart: 0.35
    farDensityScale: 0.22
    farWidthScale: 1.28
    groundColor: groundColor
    tipLighten: 1.8
  }
}

# Top-down / isometric: seen from above, vertical blades project to slivers and the
# ground shows through, so shorten and WIDEN the blades (more top-facing area),
# reach much further, and thin the density since near-camera detail is wasted.
func grassTopDownSettings(groundColor: copy Vec3) ret GrassViewSettings {
  ret GrassViewSettings {
    enabled: true
    extent: 80.0
    windStrength: 0.6
    windGust: 0.8
    bladeHeightScale: 0.7
    bladeWidthScale: 1.4
    densityScale: 0.7
    patchScale: 11.0
    patchCoverage: 0.78
    patchFeather: 0.10
    bladeVariation: 0.8
    distanceStart: 0.25
    farDensityScale: 0.16
    farWidthScale: 1.36
    groundColor: groundColor
    tipLighten: 1.5
  }
}

# A further tier of grass beyond `inner`: a ring from where `inner`'s blades shrink out (the
# compute pass shrinks a field's blades over 60 % to 98 % of its radius) to `reach` (m), its
# blades growing in over that same band, so the two tiers meet with no line. Its blades are
# `widthScale` times as wide, `heightScale` as tall and `densityScale` as many as `inner`'s,
# with its own distance thinning: fewer and wider over its outer part. Call it again on the
# result for a tier further out.
func grassNextRing(
  inner: view GrassViewSettings
  reach: view Float
  widthScale: view Float
  heightScale: view Float
  densityScale: view Float
) ret GrassViewSettings {
  var settings: GrassViewSettings = inner
  let innerReach: Float = inner.extent * 0.5
  settings.extent = reach * 2.0
  settings.innerRadius = innerReach * 0.79
  settings.innerFade = innerReach * 0.19
  settings.bladeWidthScale = inner.bladeWidthScale * widthScale
  settings.bladeHeightScale = inner.bladeHeightScale * heightScale
  settings.densityScale = Math.min(a: 1.0, b: inner.densityScale * densityScale)
  settings.distanceStart = 0.6
  settings.farDensityScale = 0.5
  settings.farWidthScale = 1.6
  ret settings
}

# Shared meadow tuning; apps may change extent and patch scale explicitly.
func grassMeadowSettings(groundColor: copy Vec3) ret GrassViewSettings {
  var settings: GrassViewSettings = grassThirdPersonSettings(groundColor: groundColor)
  # Stylized low-poly blades over the whole grassy ground (not patches):
  # every candidate kept, evenly spread, the tips lighter than the
  # terrain-colored roots
  settings.shape = GrassShape.lowPoly
  settings.bladeHeightScale = 0.55
  settings.bladeWidthScale = 1.8
  settings.densityScale = 1.0
  settings.clusterStrength = 0.0
  settings.patchScale = 7.5
  settings.patchCoverage = 0.58
  settings.patchFeather = 0.10
  settings.bladeVariation = 1.0
  settings.tipLighten = 1.6
  settings.windStrength = 0.48
  settings.windGust = 0.85
  settings.distanceStart = 0.32
  settings.farDensityScale = 0.22
  settings.farWidthScale = 1.25
  ret settings
}
