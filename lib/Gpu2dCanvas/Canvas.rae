# Gpu2dCanvas — the 2D renderer's Rae-owned canvas over the WebGPU bindings:
# the box/primitive pass (#907), the image pass (#908) and, in the sibling
# modules, the text pass (Gpu2dCanvasText.rae, #909) and the frame lifecycle
# (Gpu2dCanvasFrame.rae, #910/#915), on ONE app-owned gpu/GpuResources
# manager. Since #915 the canvas also owns the viewport uniform (the
# design->physical transform C computes from the surface, uploaded per flush),
# the clip stack + per-run scissor and the rounded-clip uniforms; C keeps only
# surface glue (window, offscreen target, present tail, image decode, glyph
# rasterization). Everything the passes CREATE — pipelines, instance buffers,
# image textures + views + sampler, per-draw uniforms and bind groups — is a
# typed ID here, and the draws go into the frame pass the canvas opened with
# recordDrawInPass, the #874 grass pattern.
#
# Box pass: one pipeline (lib/gpu2d_box.wgsl) draws every rect / rounded rect /
# bordered box / gradient / line the frame queued, in contiguous same-clip
# runs (scissor + clip uniform per run). Instance buffers are per flush slot
# within a frame (a later flush must not overwrite what an earlier draw still
# reads) and persist across frames, like the C pool did.
#
# Image pass: images are decoded by C (stb_image, CPU RGBA) and uploaded here
# into manager textures; the 1-based image handle indexes `images`, the key
# registry maps a name to a handle (ImageRegistry.rae keeps the load / retry /
# cache policy over it). Each queued draw is one 64-byte uniform + one bind
# group [viewport, uniform, view, sampler], cached per draw slot by handle
# exactly as the C flush cached them; draws go after the boxes, before text.
#
# Owner: an app (or the deferred renderer for its UI overlay) holds ONE
# Gpu2dCanvas and hands it to Gpu2d.flush / Gpu2d.endFrame and the image API.
import String
import Math
open collections/StringMap
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuRenderPass
open gpu/GpuIds
open gpu/FramePacer
open gpu/Surface
open Gpu2dCanvasFrame
open Gpu2dBindCache
open Gpu2dCanvasTiming
open Gpu2dCanvasImage
open Gpu2dCanvasClip
open Gpu2dCanvasBackdrop
open Gpu2dCanvasCache

func nativeG2dBoxFormat() unsafe extern("rae_g2d_format") ret Int

# The configured surface (#920): ready once the device + surface exist, its
# physical size (the offscreen presentable target the canvas owns is rebuilt
# to it) and the design->physical transform (window size, design resolution +
# fit mode: platform state).
func nativeG2dSurfaceReady() unsafe extern("rae_g2d_surface_ready") ret Int

func nativeG2dSurfaceWidth() unsafe extern("rae_g2d_surface_width") ret Int

func nativeG2dSurfaceHeight() unsafe extern("rae_g2d_surface_height") ret Int

func nativeG2dXform(out: view Buffer(Float)) unsafe extern("rae_g2d_xform")

# The clip stack stays C (behind the stateless pushClipRect/popClipRect, see
# #913): C fills a run's 8-float clip uniform and sets the scissor on the pass
# the canvas hands it.
# CPU image decode stays C (stb_image): a malloc'd RGBA8 buffer + its size,
# freed with g2dDecodeFree once uploaded. A failed decode logs once in C and
# returns null.
func g2dDecodeImage(path: String) unsafe extern("rae_g2d_decode_image") ret Ptr

func nativeG2dDecodedWidth() unsafe extern("rae_g2d_decoded_width") ret Int

func nativeG2dDecodedHeight() unsafe extern("rae_g2d_decoded_height") ret Int

func g2dDecodeFree(rgba: Ptr) unsafe extern("rae_g2d_decode_free")

# The CPU MSDF atlas pixels (SdfText.loadAtlas), read for the atlas upload.
func nativeG2dTextAtlasMax() unsafe extern("rae_g2d_text_atlas_max") ret Int

func sdfAtlasPixels(handle: Int) unsafe extern("rae_sdf_atlas_pixels") ret Ptr

func nativeSdfAtlasWidth(handle: Int) unsafe extern("rae_sdf_atlas_width") ret Int

func nativeSdfAtlasHeight(handle: Int) unsafe extern("rae_sdf_atlas_height") ret Int

func g2dDecodedWidth() ret Int {
  unsafe {
    ret nativeG2dDecodedWidth()
  }
}

func g2dDecodedHeight() ret Int {
  unsafe {
    ret nativeG2dDecodedHeight()
  }
}

func g2dTextAtlasMax() ret Int {
  unsafe {
    ret nativeG2dTextAtlasMax()
  }
}

func sdfAtlasWidth(handle: copy Int) ret Int {
  unsafe {
    ret nativeSdfAtlasWidth(handle: handle)
  }
}

func sdfAtlasHeight(handle: copy Int) ret Int {
  unsafe {
    ret nativeSdfAtlasHeight(handle: handle)
  }
}

# One MSDF atlas on the GPU (uploaded lazily from the C pixels) and its
# per-flush instance buffer pool (slot = flush index in the frame).
type Gpu2dTextAtlas {
  texture: TextureId
  textureView: TextureViewId
  buffers: List(BufferId)
  capacities: List(Int)
  flushIndex: Int
  glyphs: List(Float)  # the queued glyphs, textGlyphFloats each (#915: was the C batch)
  glyphClips: List(Int)  # each glyph's clip index at queue time
}

func emptyTextAtlas() ret Gpu2dTextAtlas {
  ret Gpu2dTextAtlas {
    texture: noTextureId()
    textureView: noTextureViewId()
    buffers: List.create(BufferId, cap: 4)
    capacities: List.create(Int, cap: 4)
    flushIndex: 0
    glyphs: List.create(Float, cap: 64 * textGlyphFloats)
    glyphClips: List.create(Int, cap: 64)
  }
}

# One text glyph = 5 x vec4: rect, uv, color, params(pxRange, outline width,
# softness), outline color.
const textGlyphFloats: Int = 20

# One uploaded image: its manager texture + default view and the size the
# aspect-preserving scaled draw needs.
type Gpu2dImage {
  texture: TextureId
  textureView: TextureViewId
  width: Int
  height: Int
}

type Gpu2dCanvas {
  idIssuer: IdIssuer
  gpuResources: opt GpuResources
  # --- frame (#910/#915) ---
  recording: opt Recording  # the open frame's manager recording (none between frames)
  framePass: Ptr  # the open frame's render pass into the offscreen target
  inFlight: List(SubmissionId)  # submitted frames not yet retired
  framePacer: FramePacer  # waits on the previous frame's GPU work (gpu/FramePacer)
  # What the batch holds since the last flush, for the painter order (canvasKeepOrder):
  # -1 nothing, 0 boxes, 1 images, 2 text, and which font's text (its atlas, -1 none)
  batchLevel: Int = -1
  batchAtlas: Int = -1
  frameTarget: FrameTarget  # the drawable or the offscreen this frame (gpu/Surface)
  backdrop: Gpu2dBackdrop  # BackdropBlur's copy of the frame (Gpu2dCanvasBackdrop)
  caches: Gpu2dCaches  # drawings kept to draw again (Gpu2dCanvasCache)
  gpuTiming: Canvas2dTiming  # the frame pass's GPU time under RAE_GPU2D_TIMING (Gpu2dCanvasTiming)
  # draw calls this frame, and their sum over the frames since the last [gpu2d] draws line
  # (RAE_GPU2D_DRAWS=1, Gpu2dCanvasFrame canvasCountDraws)
  drawCalls: Int = 0
  drawCallSum: Int = 0
  drawCallFrames: Int = 0
  drawCallLog: Int = -1
  # --- the offscreen presentable target (#920: was C's g_g2d_off_tex) ---
  offscreenTexture: TextureId  # RenderAttachment | CopySrc, the surface format, rebuilt on resize
  offscreenView: TextureViewId
  offscreenWidth: Int
  offscreenHeight: Int
  viewport: BufferId  # the 2 x vec4 design->physical transform every 2D pipeline binds at @0
  xform: List(Float)  # its 8 floats (physW, physH, scaleX, scaleY, offX, offY, 0, 0)
  clipUniforms: List(BufferId)  # per-run 32-byte clip uniforms, slot = run index in the frame
  clipCursor: Int
  clipScratch: List(Float)  # one clip uniform's 12 floats, staged for the upload
  # --- clip stack (#915: was C's g_g2d_clips) — design units; [0] = the full sentinel ---
  clipX: List(Float)
  clipY: List(Float)
  clipW: List(Float)
  clipH: List(Float)
  clipRadius: List(Float)
  # each clip's own frame, 8 floats: its origin (design units), its size and the 2x2 that takes
  # a design-unit offset from the origin into its frame; the rounded box is evaluated there
  clipFrames: List(Float)
  clipFull: List(Bool)
  clipStack: List(Int)
  currentClip: Int
  # --- rotation (#1003): every queued box / image / glyph turns by this angle
  # (radians) about the pivot (design units) until it is cleared; 0 = none ---
  spinAngle: Float
  spinPivotX: Float
  spinPivotY: Float
  # every queued image's color turned about the gray axis and scaled until cleared
  # (canvasSetImageColor)
  imageHueRadians: Float = 0.0
  imageBrightness: Float = 1.0
  # --- stage (Transform.rae): every queued draw is scaled by stageScale and
  # moved by (stageX, stageY), after the rotation; 1, 0, 0 = none ---
  stageScale: Float = 1.0
  stageX: Float = 0.0
  stageY: Float = 0.0
  stageStack: List(Float)
  # --- the UI layer being drawn (Transform.rae canvasPushLayer): every queued color's alpha is
  # multiplied by layerAlpha; layerStack keeps the pushed layers' alphas and whether each pushed a
  # stage ---
  layerAlpha: Float = 1.0
  layerStack: List(Float)
  # --- box pass ---
  pipeMade: Bool
  pipeline: RenderPipelineId
  prims: List(Float)  # the queued primitives, boxPrimFloats each (#913: was the C batch)
  primClips: List(Int)  # each primitive's clip index at queue time
  frameBuffers: List(BufferId)  # per-flush instance buffers, slot = flush index in the frame
  frameCapacities: List(Int)  # each slot's capacity in primitives
  flushIndex: Int
  frameBinds: List(BindGroupId)  # this frame's per-run bind groups (the backdrop pass's)
  bindCache: Gpu2dBindCache  # the box and text runs' bind groups, kept across frames
  # --- image pass ---
  imagePipeMade: Bool
  imagePipeline: RenderPipelineId
  imageSampler: SamplerId
  images: List(Gpu2dImage)  # handle = index + 1
  imageKeys: StringMap(Int)  # name -> handle registry
  # handles whose image is gone, used again, and handles to let go of once the frame being drawn is
  # submitted (canvasReleaseImage)
  imagesFree: List(Int)
  imagesReleasing: List(Int)
  imageCommands: List(Float)  # queued draws, 16 floats each = the uImg uniform
  imageCommandHandles: List(Int)
  imageCommandClips: List(Int)
  imageUniforms: List(BufferId)  # per-draw-slot 64-byte uniforms, persistent
  imageBinds: List(BindGroupId)  # per-draw-slot bind groups, cached by handle
  imageBindHandles: List(Int)
  imageDrawCursor: Int  # draw slots used so far this frame
  imageScratch: List(Float)  # one command's 16 floats, staged for the upload
  # --- text pass ---
  textPipeMade: Bool
  textPipeline: RenderPipelineId
  textAtlases: List(Gpu2dTextAtlas)  # index = atlas handle - 1, sized to the C atlas max
}

# Slot budget: a buffer per flush and per image draw (kept and reused by the
# next frames), a bind group per same-clip run. A canvas zoomed in on hundreds
# of nodes flushes before each one's text: 2048 ran out, and every frame after
# drew nothing.
const canvasManagerCapacity: Int = 16384

# rect, tint, params, uv, clip rect, clip params (#1003) — see gpu2d_image.wgsl.
const imageUniformFloats: Int = 28

# One box primitive = 6 x vec4 (std430): rect, radius, fill, border, params, grad.
const boxPrimFloats: Int = 24

func createGpu2dCanvas() ret Gpu2dCanvas {
  unsafe {
    ret Gpu2dCanvas {
      idIssuer: IdIssuer.create()
      gpuResources: none
      recording: none
      framePass: webgpuNull()
      inFlight: List.create(SubmissionId, cap: 4)
      framePacer: createFramePacer()
      frameTarget: createFrameTarget()
      backdrop: createGpu2dBackdrop()
      caches: createGpu2dCaches()
      gpuTiming: createCanvas2dTiming()
      offscreenTexture: noTextureId()
      offscreenView: noTextureViewId()
      offscreenWidth: 0
      offscreenHeight: 0
      viewport: noBufferId()
      xform: List.create(Float, cap: 8)
      clipUniforms: List.create(BufferId, cap: 64)
      clipCursor: 0
      clipScratch: List.create(Float, cap: 12)
      clipX: List.create(Float, cap: 32)
      clipY: List.create(Float, cap: 32)
      clipW: List.create(Float, cap: 32)
      clipH: List.create(Float, cap: 32)
      clipRadius: List.create(Float, cap: 32)
      clipFrames: List.create(Float, cap: 256)
      clipFull: List.create(Bool, cap: 32)
      clipStack: List.create(Int, cap: 32)
      currentClip: 0
      spinAngle: 0.0
      stageStack: {}
      layerStack: {}
      spinPivotX: 0.0
      spinPivotY: 0.0
      pipeMade: false
      pipeline: noRenderPipelineId()
      prims: List.create(Float, cap: 64 * boxPrimFloats)
      primClips: List.create(Int, cap: 64)
      frameBuffers: List.create(BufferId, cap: 8)
      frameCapacities: List.create(Int, cap: 8)
      flushIndex: 0
      frameBinds: List.create(BindGroupId, cap: 64)
      bindCache: createGpu2dBindCache()
      imagePipeMade: false
      imagePipeline: noRenderPipelineId()
      imageSampler: noSamplerId()
      images: List.create(Gpu2dImage, cap: 32)
      imageKeys: createStringMap(Int, cap: 64)
      imagesFree: {}
      imagesReleasing: {}
      imageCommands: List.create(Float, cap: 32 * imageUniformFloats)
      imageCommandHandles: List.create(Int, cap: 32)
      imageCommandClips: List.create(Int, cap: 32)
      imageUniforms: List.create(BufferId, cap: 32)
      imageBinds: List.create(BindGroupId, cap: 32)
      imageBindHandles: List.create(Int, cap: 32)
      imageDrawCursor: 0
      imageScratch: List.create(Float, cap: imageUniformFloats)
      textPipeMade: false
      textPipeline: noRenderPipelineId()
      textAtlases: List.create(Gpu2dTextAtlas, cap: 8)
    }
  }
}

func ensureBoxResources(canvas: mod Gpu2dCanvas) {
  if let existing: view GpuResources = canvas.gpuResources {
    ret
  }
  canvas.gpuResources = GpuResources.create(
    issuer: canvas.idIssuer
    capacity: canvasManagerCapacity
  )
}

# The box pipeline: a procedural quad (no vertex buffer), one color target in
# the gpu2d presentable format, premultiplied alpha blending, no depth, no cull.
func boxPipelineSpec(format: copy Int32) ret RenderPipelineSpec {
  var colorFormats: List(Int32) = List.create(Int32, cap: 1)
  colorFormats.add(value: format)
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 1)
  ret RenderPipelineSpec {
    vertexStride: 0
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: true
    premultiplied: true
    depthFormat: 0
    depthWrite: false
    depthCompare: WGPUCompareFunction_Always
    cullMode: WGPUCullMode_None
    sampleCount: 1
  }
}

func ensureBoxPipeline(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if canvas.pipeMade {
    ret
  }
  canvas.pipeMade = true
  # Read relative to the working directory like every lib/*.wgsl asset (the
  # example gates run from the repo root). An empty read must not reach wgpu.
  let boxShader: Shader = shader(files: ["lib/gpu2d_box.wgsl"])
  var format: Int = 0
  unsafe {
    format = nativeG2dBoxFormat()
  }
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    shader: boxShader
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: boxPipelineSpec(format: format as Int32)
  ) {
    canvas.pipeline = pipeline
  }
  ensureViewportUniform(canvas: canvas, resources: resources)
}

# The shared viewport uniform (2 x vec4: physW, physH, scaleX, scaleY / offX,
# offY, ..) every 2D pipeline binds at @binding(0); written once per flush from
# the platform transform (#915: was the C g_g2d_uniform).
func ensureViewportUniform(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if isValidBuffer(resources: resources, id: canvas.viewport) {
    ret
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 32
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    canvas.viewport = uniform
  }
}

func xformAt(canvas: view Gpu2dCanvas, index: copy Int) ret Float {
  if let value: Float = canvas.xform.copyAt(index: index) {
    ret value
  }
  ret 0.0
}

# refreshXform and uploadViewport (the transform of a flush, the frame's or a sized capture's) are
# in Gpu2dCanvasCache.

# This flush's instance buffer: the slot for the flush index, grown (retired
# and re-created, doubling) when the batch outgrew it.
func boxFlushBuffer(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  prims: copy Int
) ret BufferId {
  let slot: Int = canvas.flushIndex
  canvas.flushIndex = slot + 1
  loop canvas.frameBuffers.length <= slot {
    canvas.frameBuffers.add(value: noBufferId())
    canvas.frameCapacities.add(value: 0)
  }
  var capacity: Int = 0
  if let known: Int = canvas.frameCapacities.copyAt(index: slot) {
    capacity = known
  }
  var current: BufferId = noBufferId()
  if let known: BufferId = canvas.frameBuffers.copyAt(index: slot) {
    current = known
  }
  if isValidBuffer(resources: resources, id: current) and capacity >= prims {
    ret current
  }
  retireBuffer(resources: resources, id: current)
  var grown: Int = capacity
  if grown < 4 {
    grown = 4
  }
  loop grown < prims {
    grown = grown * 2
  }
  var made: BufferId = noBufferId()
  if let buffer: BufferId = createBuffer(
    resources: resources
    size: grown * boxPrimFloats * 4
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
  ) {
    made = buffer
  }
  canvas.frameBuffers.set(index: slot, value: made)
  canvas.frameCapacities.set(index: slot, value: grown)
  ret made
}

# The frame is open once beginFrame opened its pass (endFrame closes it).
func canvasFrameActive(canvas: view Gpu2dCanvas) ret Bool {
  unsafe {
    ret canvas.framePass is not webgpuNull()
  }
}

# ----- offscreen presentable target (#920) ------------------------------------
# The frame renders into a canvas-owned texture, not the surface drawable:
# present copies it into the drawable (C, best effort), the headless
# screenshot reads it back, and the 3D renderer's tonemap / composite passes
# target its view before the 2D overlay. Rebuilt when the configured surface
# size changes (wgpu keeps the old texture alive for in-flight command buffers,
# exactly as the C release did).
func retireOffscreen(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  retireTextureView(resources: resources, id: canvas.offscreenView)
  retireTexture(resources: resources, id: canvas.offscreenTexture)
  canvas.offscreenView = noTextureViewId()
  canvas.offscreenTexture = noTextureId()
  canvas.offscreenWidth = 0
  canvas.offscreenHeight = 0
}

# True when the surface is configured and the target matches its size.
func canvasEnsureOffscreen(canvas: mod Gpu2dCanvas) ret Bool {
  var ready: Int = 0
  var width: Int = 0
  var height: Int = 0
  unsafe {
    ready = nativeG2dSurfaceReady()
    width = nativeG2dSurfaceWidth()
    height = nativeG2dSurfaceHeight()
  }
  if ready is 0 or width < 1 or height < 1 {
    ret false
  }
  ensureBoxResources(canvas: canvas)
  if let resources: mod GpuResources = canvas.gpuResources {
    if width is canvas.offscreenWidth and height is canvas.offscreenHeight and isValidTextureView(
      resources: resources
      id: canvas.offscreenView
    ) {
      ret true
    }
    retireOffscreen(canvas: canvas, resources: resources)
    var format: Int32 = 0
    unsafe {
      format = nativeG2dBoxFormat() as Int32
    }
    if let texture: TextureId = createTexture(
      resources: resources
      width: width
      height: height
      format: format
      usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_CopySrc + WGPUTextureUsage_TextureBinding
    ) {
      if let created: TextureViewId = createTextureView(resources: resources, texture: texture) {
        canvas.offscreenTexture = texture
        canvas.offscreenView = created
        canvas.offscreenWidth = width
        canvas.offscreenHeight = height
        ret true
      }
      retireTexture(resources: resources, id: texture)
    }
  }
  ret false
}

# The raw view handle for a pass that targets the offscreen image (the 3D
# renderer's tonemap / composite / inspector fullscreen passes); null when no
# surface is configured yet.
# The frame target's view, for a pass that WRITES the whole frame (the
# deferred composite, the forward tonemap, the inspector): the drawable when
# this frame renders straight into it (render-perf-11b, gpu/Surface), else
# the offscreen. The first call of a frame chooses.
func canvasFrameTargetView(canvas: mod Gpu2dCanvas) unsafe ret Ptr {
  unsafe {
    if not canvasEnsureOffscreen(canvas: canvas) {
      ret webgpuNull()
    }
    if canvasChooseTarget(canvas: canvas, loads: false) {
      ret canvas.frameTarget.drawableView
    }
    if let resources: view GpuResources = canvas.gpuResources {
      ret refHandle(resources: resources, ref: textureViewRef(id: canvas.offscreenView))
    }
    ret webgpuNull()
  }
}

# The frame target as a render-pass reference (the 2D frame's own pass);
# `loads`: the pass keeps what the frame's target already holds.
func canvasFrameTargetRef(canvas: mod Gpu2dCanvas, loads: view Bool) ret ResourceRef {
  if canvasChooseTarget(canvas: canvas, loads: loads) {
    ret frameTargetRef(target: canvas.frameTarget)
  }
  ret textureViewRef(id: canvas.offscreenView)
}

func canvasChooseTarget(canvas: mod Gpu2dCanvas, loads: view Bool) ret Bool {
  if let resources: mod GpuResources = canvas.gpuResources {
    ret chooseFrameTarget(
      target: canvas.frameTarget
      resources: resources
      pacer: canvas.framePacer
      width: canvas.offscreenWidth
      height: canvas.offscreenHeight
      loads: loads
    )
  }
  ret false
}

# The raw texture handle present copies from (null when there is none).
func canvasOffscreenTexture(canvas: view Gpu2dCanvas) unsafe ret Ptr {
  unsafe {
    if let resources: view GpuResources = canvas.gpuResources {
      if isValidTexture(resources: resources, id: canvas.offscreenTexture) {
        ret slotHandle(table: resources.textures, slot: canvas.offscreenTexture.slot)
      }
    }
    ret webgpuNull()
  }
}
