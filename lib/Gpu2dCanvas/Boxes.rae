# The box pass: rects, rounded and bordered boxes, gradients and lines, queued and drawn
# (Canvas.rae).
import String
import Math
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuRenderPass
open gpu/GpuIds
open gpu/FramePacer
open gpu/Surface
open Gpu2dCanvasFrame
open Gpu2dBindCache
open Gpu2dCanvasTiming
open Gpu2dCanvasImage
open Gpu2dCanvasClip
open Gpu2dCanvasBackdrop
open Gpu2dCanvasCache

# ----- box batch (#913: the CPU accumulation, was C's rae_g2d_push) ----------

# 0xAARRGGBB -> one premultiplied RGBA channel in 0..1 (the box shader blends
# premultiplied). `shift` selects the byte: 65536 = R, 256 = G, 1 = B.
func premultipliedChannel(color: view Int, shift: view Int) ret Float {
  let alpha: Float = ((color / 16777216) % 256).toFloat() / 255.0
  ret ((color / shift) % 256).toFloat() / 255.0 * alpha
}

func colorAlpha(color: view Int) ret Int {
  ret (color / 16777216) % 256
}

func pushPremultiplied(canvas: mod Gpu2dCanvas, color: copy Int) {
  # premultiplied: the layer's alpha scales all four channels
  let layerAlpha: Float = canvas.layerAlpha
  canvas.prims.add(value: premultipliedChannel(color: color, shift: 65536) * layerAlpha)
  canvas.prims.add(value: premultipliedChannel(color: color, shift: 256) * layerAlpha)
  canvas.prims.add(value: premultipliedChannel(color: color, shift: 1) * layerAlpha)
  canvas.prims.add(value: ((color / 16777216) % 256).toFloat() / 255.0 * layerAlpha)
}

# Queue one primitive: rect, four corner radii (top-left, top-right,
# bottom-right, bottom-left), fill, border, params (border width, rotation in
# radians, gradient flag, gradient angle) and the gradient end color — the
# same 24-float record the C batch packed. Tagged with the clip active now.
func pushBox(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radiusTopLeft: copy Float
  radiusTopRight: copy Float
  radiusBottomRight: copy Float
  radiusBottomLeft: copy Float
  fill: copy Int
  border: copy Int
  borderWidth: copy Float
  angle: copy Float
  gradient: copy Bool
  gradientAngle: copy Float
  gradientTo: copy Int
) {
  # A box with nothing visible draws nothing: its premultiplied color is 0 at every pixel, and the
  # GPU would still shade and blend its whole area (a fading shadow's layers round to alpha 0)
  if colorAlpha(color: fill) is 0 and (borderWidth <= 0.0 or colorAlpha(color: border) is 0) and (not gradient or colorAlpha(
    color: gradientTo
  ) is 0) {
    ret
  }
  canvasKeepOrder(canvas: canvas, level: 0, atlas: -1)
  # A negative size (a node flipped by scale -1) is the same box from its other corner: queued
  # with a positive size and the corners' radii swapped to match, its middle where it was
  if w < 0.0 {
    x = x + w
    w = -w
    let topLeft: Float = radiusTopLeft
    radiusTopLeft = radiusTopRight
    radiusTopRight = topLeft
    let bottomLeft: Float = radiusBottomLeft
    radiusBottomLeft = radiusBottomRight
    radiusBottomRight = bottomLeft
  }
  if h < 0.0 {
    y = y + h
    h = -h
    let topLeft: Float = radiusTopLeft
    radiusTopLeft = radiusBottomLeft
    radiusBottomLeft = topLeft
    let topRight: Float = radiusTopRight
    radiusTopRight = radiusBottomRight
    radiusBottomRight = topRight
  }
  # The canvas rotation (#1003): the box's center turns about the pivot and
  # the quad itself turns by the same angle in the shader.
  var boxX: Float = x
  var boxY: Float = y
  var boxAngle: Float = angle
  if canvas.spinAngle is not 0.0 {
    let center: SpinPoint = spinPoint(canvas: canvas, x: x + w / 2.0, y: y + h / 2.0)
    boxX = center.x - w / 2.0
    boxY = center.y - h / 2.0
    boxAngle = angle + canvas.spinAngle
  }
  # The stage (Transform.rae), after the rotation: the area's coordinates to
  # the window's points
  let stageScale: Float = canvas.stageScale
  boxX = stageX(canvas: canvas, x: boxX)
  boxY = stageY(canvas: canvas, y: boxY)
  canvas.prims.add(value: boxX)
  canvas.prims.add(value: boxY)
  canvas.prims.add(value: w * stageScale)
  canvas.prims.add(value: h * stageScale)
  canvas.prims.add(value: radiusTopLeft * stageScale)
  canvas.prims.add(value: radiusTopRight * stageScale)
  canvas.prims.add(value: radiusBottomRight * stageScale)
  canvas.prims.add(value: radiusBottomLeft * stageScale)
  pushPremultiplied(canvas: canvas, color: fill)
  pushPremultiplied(canvas: canvas, color: border)
  canvas.prims.add(value: borderWidth * stageScale)
  canvas.prims.add(value: boxAngle)
  var gradientFlag: Float = 0.0
  if gradient {
    gradientFlag = 1.0
  }
  canvas.prims.add(value: gradientFlag)
  canvas.prims.add(value: gradientAngle)
  pushPremultiplied(canvas: canvas, color: gradientTo)
  canvas.primClips.add(value: canvas.currentClip)
}

func canvasDrawRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  color: copy Int
) {
  pushBox(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radiusTopLeft: 0.0
    radiusTopRight: 0.0
    radiusBottomRight: 0.0
    radiusBottomLeft: 0.0
    fill: color
    border: 0
    borderWidth: 0.0
    angle: 0.0
    gradient: false
    gradientAngle: 0.0
    gradientTo: color
  )
}

func canvasDrawRoundedRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  color: copy Int
) {
  pushBox(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radiusTopLeft: radius
    radiusTopRight: radius
    radiusBottomRight: radius
    radiusBottomLeft: radius
    fill: color
    border: 0
    borderWidth: 0.0
    angle: 0.0
    gradient: false
    gradientAngle: 0.0
    gradientTo: color
  )
}

func canvasDrawBox(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  fill: copy Int
  borderWidth: copy Float
  border: copy Int
) {
  pushBox(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radiusTopLeft: radius
    radiusTopRight: radius
    radiusBottomRight: radius
    radiusBottomLeft: radius
    fill: fill
    border: border
    borderWidth: borderWidth
    angle: 0.0
    gradient: false
    gradientAngle: 0.0
    gradientTo: fill
  )
}

# Gradient: fill = `from`, grad = `to`, the angle in radians (0 = left-to-right,
# 90 degrees = top-to-bottom), no border.
func canvasDrawGradientRect(
  canvas: mod Gpu2dCanvas
  x: copy Float
  y: copy Float
  w: copy Float
  h: copy Float
  radius: copy Float
  from: copy Int
  to: copy Int
  angleDeg: copy Float
) {
  pushBox(
    canvas: canvas
    x: x
    y: y
    w: w
    h: h
    radiusTopLeft: radius
    radiusTopRight: radius
    radiusBottomRight: radius
    radiusBottomLeft: radius
    fill: from
    border: 0
    borderWidth: 0.0
    angle: 0.0
    gradient: true
    gradientAngle: angleDeg * 0.017453292519943295
    gradientTo: to
  )
}

# A line from (x0,y0) to (x1,y1), `thickness` wide, with rounded caps — a
# rotated capsule (a rounded rect of length x thickness, radius thickness/2).
func canvasDrawLine(
  canvas: mod Gpu2dCanvas
  x0: copy Float
  y0: copy Float
  x1: copy Float
  y1: copy Float
  thickness: copy Float
  color: copy Int
) {
  let dx: Float = x1 - x0
  let dy: Float = y1 - y0
  let length: Float = Math.sqrt(x: dx * dx + dy * dy)
  if length < 0.000001 or thickness <= 0.0 {
    ret
  }
  let angle: Float = Math.atan2(y: dy, x: dx)
  let centerX: Float = (x0 + x1) * 0.5
  let centerY: Float = (y0 + y1) * 0.5
  var radius: Float = thickness * 0.5
  if radius > length * 0.5 {
    radius = length * 0.5
  }
  pushBox(
    canvas: canvas
    x: centerX - length * 0.5
    y: centerY - thickness * 0.5
    w: length
    h: thickness
    radiusTopLeft: radius
    radiusTopRight: radius
    radiusBottomRight: radius
    radiusBottomLeft: radius
    fill: color
    border: 0
    borderWidth: 0.0
    angle: angle
    gradient: false
    gradientAngle: 0.0
    gradientTo: color
  )
}

func canvasBoxCount(canvas: view Gpu2dCanvas) ret Int {
  ret canvas.primClips.length
}

func clearBoxBatch(canvas: mod Gpu2dCanvas) {
  canvas.prims.clear()
  canvas.primClips.clear()
}

# Draw the queued primitives into the active frame pass and reset the batch.
# Contiguous same-clip runs: each sets the scissor (#144, the axis-aligned
# bbox cull) and binds a per-run clip uniform (#118, the rounded-corner SDF in
# the fragment shader). instance_index includes firstInstance, so the storage
# buffer still indexes the right primitive.
func boxClipAt(canvas: view Gpu2dCanvas, i: copy Int) ret Int {
  if let clip: Int = canvas.primClips.copyAt(index: i) {
    ret clip
  }
  ret 0
}

func boxFlushWith(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  let count: Int = canvasBoxCount(canvas: canvas)
  if count <= 0 {
    ret
  }
  # No open frame pass: keep the batch (the frame end clears it), like C did.
  if not canvasFrameActive(canvas: canvas) {
    ret
  }
  ensureBoxPipeline(canvas: canvas, resources: resources)
  if not isValidRenderPipeline(resources: resources, id: canvas.pipeline) {
    clearBoxBatch(canvas: canvas)
    ret
  }
  let instances: BufferId = boxFlushBuffer(canvas: canvas, resources: resources, prims: count)
  let strideBytes: Int = boxPrimFloats * 4
  unsafe {
    if not writeBufferFromPtr(
      resources: resources
      id: instances
      offset: 0
      data: canvas.prims.data
      size: count * strideBytes
    ) {
      clearBoxBatch(canvas: canvas)
      ret
    }
  }
  var runStart: Int = 0
  loop runStart < count {
    let clip: Int = boxClipAt(canvas: canvas, i: runStart)
    var runEnd: Int = runStart + 1
    loop runEnd < count and boxClipAt(canvas: canvas, i: runEnd) is clip {
      runEnd = runEnd + 1
    }
    let key: Gpu2dBindKey = {
      pipeline: canvas.pipeline
      viewport: canvas.viewport
      items: instances
      clip: clipUniformFor(canvas: canvas, resources: resources, clip: clip)
      textureView: noTextureViewId()
      sampler: noSamplerId()
    }
    if let bind: BindGroupId = gpu2dBindGroup(
      cache: canvas.bindCache
      resources: resources
      key: key
    ) {
      g2dScissor(canvas: canvas, clip: clip)
      unsafe {
        let drawn: Bool = recordDrawInPass(
          resources: resources
          pass: canvas.framePass
          pipeline: canvas.pipeline
          bindGroup: bind
          vertexCount: 6
          instanceCount: runEnd - runStart
          firstVertex: 0
          firstInstance: runStart
        )
        if drawn {
          canvas.drawCalls = canvas.drawCalls + 1
        }
      }
    }
    runStart = runEnd
  }
  clearBoxBatch(canvas: canvas)
}
