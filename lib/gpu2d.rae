# GPU 2D renderer — WebGPU render path (QUEUE #109, docs/webgpu-2d-ui-renderer.md).
#
# Unlike lib/gpu.rae (compute → readback) this OWNS the window surface and
# presents on the GPU: SDL3 creates the window + Metal layer, wgpu-native wraps
# it as a surface, and frames are rendered + presented directly (no CPU
# framebuffer round-trip). The SAME WGSL/API target the browser later
# (WebGPU-everywhere); this is the native (wgpu-native) side.
#
# Tier 0 slice: window + clear-colour present. Pipelines/instanced quads (the
# Box uber-shader, #110) and text (#111) build on top of this surface.
#
# Implemented in the RAE_HAS_WEBGPU + RAE_HAS_SDL3 block of
# compiler/runtime/rae_runtime.c. Compiled-target only; needs wgpu-native + SDL3.
# Importing this module links both. Window globals are shared with lib/sdl3.rae,
# so sdl3 input functions (getMouseX/isKeyDown/…) work against this window.
import core
open webgpu/webgpu
import webgpu/context

# --- Window + surface ----------------------------------------------------
# Open a GPU-presenting window (Metal layer wrapped as a wgpu surface) and
# configure its swapchain. Replaces sdl3.initWindow for the GPU render path —
# do not also call sdl3.initWindow (that one attaches an SDL_Renderer that
# fights wgpu for the drawable).
func initWindow(width: Int, height: Int, title: String) extern

# Pump the OS event queue; returns true once the user has asked to close the
# window (or a headless time budget elapsed). Call once per frame.
func pollClose() extern ret Bool

# Drawable size in physical pixels (HiDPI-aware; may exceed the logical size).
func windowWidth() extern ret Int
func windowHeight() extern ret Int
func setWindowPosition(x: Int, y: Int) extern
func setWindowSize(w: Int, h: Int) extern
func windowPositionX() extern ret Int
func windowPositionY() extern ret Int
# True once after the OS reports a window resize (edge-triggered; the flag
# is cleared on read). The app recomputes its viewport/extent and rebuilds.
func windowResized() extern ret Bool
# One-shot, like windowResized: reading it clears it. Persisting where the user
# put the window is built ON these in Rae (lib/ui/window_geometry.rae), not down
# in the runtime.
func windowMoved() extern ret Bool
# False while the window is hidden / minimized / occluded (app switched away or
# fully covered). Apps should skip their render and park in waitEvents when this
# is false: rendering while dark wastes power and, on macOS, leaks GPU memory
# (the Metal layer stops recycling drawables while backgrounded). Not edge-
# triggered — reflects the current state every call.
func windowVisible() extern("rae_g2d_window_visible") ret Bool

# The universal per-frame render decision, so no app has to hand-roll it. Render
# this frame only if the app wants to AND the window is actually visible. NEVER
# render while hidden/minimized/occluded: it wastes power and, on macOS, leaks
# GPU memory — the Metal drawable pool stops recycling while backgrounded, so
# every frame allocates a fresh drawable and the deferred pipeline's driver
# allocations pile up (measured 170MB -> 1.4GB across a few app switches). The
# app passes its own "something changed" signal and branches: render, else park
# in waitEvents. Folding the visibility rule in here is what stops that rule from
# being a per-app footgun — the engine present path refuses to present while dark
# as a hard backstop, but skipping the whole render is what avoids the waste.
func shouldRenderFrame(appNeedsRender: view Bool) ret Bool {
  if windowVisible() is false { ret false }
  ret appNeedsRender
}

# Busy-loop convenience for apps that render every frame (games, always-on
# animation): render this frame only if the window is visible. When hidden it
# PARKS briefly and returns false, so `if gpu2d.renderGate() { ...render... }`
# gets both the macOS backgrounded-render leak fix AND avoids a busy spin, with
# no else branch. Event-driven loops that already compute a needsRender should
# use shouldRenderFrame + their own waitEvents instead.
func renderGate() ret Bool {
  if windowVisible() { ret true }
  waitEvents(timeoutSec: 0.25)
  ret false
}

# --- Coordinate system (#112) --------------------------------------------
# Draw coordinates are in DESIGN units. By default 1 unit = 1 physical pixel
# (identity). Call setDesignResolution to author against a fixed virtual
# canvas that is scaled to fit the window — DPI-independent and resolution-
# independent, the Figma-style shared design-unit model
# (docs/ui-coordinate-and-responsive-layout.md). Three layers:
#   design units  --(scale + offset / fit)-->  physical px  --> clip space.
# fit: 0 = fit (contain, letterboxed), 1 = fill (cover, cropped), 2 = stretch.
# Pass width/height <= 0 to return to identity (physical-pixel) coordinates.
func setDesignResolution(width: Float, height: Float, fit: Int) extern

# Current design-canvas size in design units (the window's physical size when
# no design resolution is set). Lay out against these.
func designWidth() extern ret Float
func designHeight() extern ret Float

# Device pixel ratio: physical pixels per logical point (2.0 on retina).
func dpr() extern ret Float

# --- Input (valid after pollClose each frame) ----------------------------
# pollClose records mouse/keyboard/wheel state while it pumps the event queue,
# so these read this frame's input. Coordinates are in DESIGN units (the same
# space drawRect etc. take), so hit-testing lines up with what was drawn.
func pointerX() extern ret Float
func pointerY() extern ret Float
# Multitouch (#526): active finger count + per-finger position in design units.
# On desktop this is 0 (use the mouse pointer); on iOS every touch is reported so
# a UI can drive a joystick with one finger and the camera with another.
func touchCount() extern ret Int
func touchX(index: Int) extern ret Float
func touchY(index: Int) extern ret Float
# Stable finger id (grab a finger at press, hold it for the whole drag) + whether
# it went down this frame (edge). id is -1 out of range.
func touchId(index: Int) extern ret Int
func touchPressed(index: Int) extern ret Bool
# OS safe-area insets (notch / home indicator / rounded corners) in design units.
# 0 on platforms without insets. Lay HUD + UI chrome inside these.
func safeTop() extern ret Float
func safeBottom() extern ret Float
func safeLeft() extern ret Float
func safeRight() extern ret Float
# Left mouse button held this frame.
func pointerDown() extern ret Bool
func pointerPressed() extern ret Bool
func pointerReleased() extern ret Bool
# Per-frame mouse-wheel / trackpad delta (positive = scrolled up), matching
# raylib's getMouseWheelMove semantics.
func wheelMove() extern ret Float
# Desktop cursor kind. 0=arrow, 1=pointer/hand, 2=text, 3=horizontal resize,
# 4=vertical resize, 5=crosshair, 6=not-allowed.
func setMouseCursor(kind: Int) extern
# Monotonic wall-clock seconds since process start (for scroll/animation timing).
# Epoch seconds. Float64 deliberately: as f32 two calls one frame apart
# return the SAME value (~1.7e9 has ~128s granularity), so every frame delta
# would be exactly 0.0. See docs/primitive-types.md.
func nowSeconds() extern ret Float64

# --- Idle wait (hybrid loop) ---------------------------------------------
# Block up to `timeoutSec` for the next OS event (returns immediately if one is
# already queued), without dequeuing it — the following pollClose drains it.
# Park here when idle so the app sits at ~0% CPU; busy-render (timeout 0) while
# animating. See docs/ui-render-loop-performance.md.
func waitEvents(timeoutSec: Float) extern

# Release the surface + window. The wgpu device stays cached for reuse.
func closeWindow() extern

# --- Frame ---------------------------------------------------------------
# The frame command lifecycle runs here in Rae (#504): create the encoder +
# offscreen render pass, and on end flush the batched primitives, submit, and
# hand the platform present/screenshot tail back to C. C keeps the per-frame
# batch-counter reset (g2dFrameReset), owns the persistent offscreen colour
# target (g2dOffView), packs primitives (flush), and does the present tail.
func g2dFrameReset() extern("rae_g2d_frame_reset")
func g2dSetFrame(enc: Ptr, pass: Ptr) extern("rae_g2d_set_frame")
func g2dPass() extern("rae_g2d_pass_get") ret Ptr
func g2dEncoder() extern("rae_g2d_encoder_get") ret Ptr
func g2dFrameActive() extern("rae_g2d_frame_active") ret Int
func g2dPresentCleanup() extern("rae_g2d_present_and_cleanup")
func g2dTick() extern("rae_g2d_tick")
func g2dOffView() extern("rae_g2d_off_view") ret Ptr
func g2dOffViewReady() extern("rae_g2d_off_view_ready") ret Int
func g2dSubmit(cmd: Ptr) extern("rae_gb_submit")

# Shared: create the command encoder and begin the offscreen colour pass with
# the given load op + clear colour, then hand the encoder/pass to C so flush()
# and the present tail see the live frame.
func g2dOpenPass(loadOp: copy Int32, r: copy Float, g: copy Float, b: copy Float, a: copy Float) {
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let att: WGPURenderPassColorAttachment = {
    view_: g2dOffView(), depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
    loadOp: loadOp, storeOp: WGPUStoreOp_Store,
    clearValue: { r: r as Float64, g: g as Float64, b: b as Float64, a: a as Float64 }
  }
  # set() is a no-op past the list length, so grow to one slot first (as
  # gbuffer.rae does) before writing the single colour attachment.
  loop gG2dColorAtts.length < 1 { gG2dColorAtts.add(value: { depthSlice: 0 as UInt32 }) }
  gG2dColorAtts.set(index: 0, value: att)
  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 1 as UInt64,
    colorAttachments: gG2dColorAtts.data
  }
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  g2dSetFrame(enc: enc, pass: pass)
}

# Reused one-element attachment list; its .data is the C array pointer the pass
# descriptor references (must outlive the descriptor, so it is module-level).
var gG2dColorAtts: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 1)

# Acquire the next surface texture and begin a render pass that clears it to
# the given linear RGBA colour (components 0..1). Must be paired with endFrame.
func beginFrame(r: copy Float, g: copy Float, b: copy Float, a: copy Float) {
  g2dFrameReset()
  if g2dOffViewReady() is 0 { ret }
  g2dOpenPass(loadOp: WGPULoadOp_Clear, r: r, g: g, b: b, a: a)
}

# Begin a 2D/UI overlay pass that preserves the persistent offscreen color
# target produced by a preceding renderer pass. Pair with endFrame; this is the
# only pass that should screenshot/present the composed frame.
func beginFrameLoad() {
  g2dFrameReset()
  if g2dOffViewReady() is 0 { ret }
  g2dOpenPass(loadOp: WGPULoadOp_Load, r: 0.0, g: 0.0, b: 0.0, a: 0.0)
}

# Finish the render pass, submit the command buffer, and present the frame.
func endFrame() {
  # Advance the deterministic clock every frame, even one with no drawable yet.
  g2dTick()
  if g2dFrameActive() is 0 { ret }
  flush()
  let pass: Ptr = g2dPass()
  let enc: Ptr = g2dEncoder()
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  g2dSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
  g2dPresentCleanup()
}

# True when the most recent endFrame copied to a surface drawable and presented.
# Startup can render offscreen before the OS has a drawable; apps that skip idle
# frames should keep their first frame dirty until this reports true.
func lastPresentOk() extern ret Bool

# Flush queued primitives into the active render pass without ending the
# frame. Use this when painter order must be preserved across primitive
# pipelines (for example: image, then later shape, then text).
func flush() extern

# --- 2D primitives (#110, Box uber-shader) -------------------------------
# Submit primitives between beginFrame and endFrame; they are batched and
# drawn in one instanced draw at endFrame, in submission order (painter's).
# Colours are 0xAARRGGBB — alpha in the top byte; use 0xFF...... for opaque.
# Coordinates and sizes are in physical pixels (see windowWidth/windowHeight).
# Rounded corners and borders are antialiased analytically (no MSAA).

# Filled axis-aligned rectangle.
func drawRect(x: Float, y: Float, w: Float, h: Float, color: Int) extern

# Filled rounded rectangle (uniform corner radius).
func drawRoundedRect(x: Float, y: Float, w: Float, h: Float, radius: Float, color: Int) extern

# Rounded rectangle with a fill and a stroked border `borderWidth` px wide
# (drawn inset from the edge). radius 0 gives a sharp-cornered box.
func drawBox(x: Float, y: Float, w: Float, h: Float, radius: Float, fill: Int, borderWidth: Float, border: Int) extern

# Filled rounded rectangle with a linear gradient. `angleDeg` follows the UI
# GradientFill convention: 0 = left-to-right, 90 = top-to-bottom.
func drawGradientRect(x: Float, y: Float, w: Float, h: Float, radius: Float, from: Int, to: Int, angleDeg: Float) extern

# Antialiased line from (x0,y0) to (x1,y1), `thickness` units wide, with
# rounded caps (a rotated capsule). Works at any angle.
func drawLine(x0: Float, y0: Float, x1: Float, y1: Float, thickness: Float, color: Int) extern

# --- Clipping (#144, axis-aligned scissor) -------------------------------
# Push a rectangular clip region (design units); subsequent draws are
# clipped to it until the matching popClipRect. Clips nest — a pushed rect
# intersects the current one — so a rounded card can hold a clipped scroll
# list. Implemented as a render-pass scissor per contiguous same-clip run of
# draws, preserving the box→image→text batch order. `popClipRect` restores
# the previous region; an unmatched pop clears to no-clip. (The rounded /
# per-instance clip variant is #118.)
func pushClipRect(x: Float, y: Float, w: Float, h: Float) extern
# Rounded clip (#118): same as pushClipRect but the corners are rounded by
# `radius` (design units). The box pipeline rounds the corners via a
# fragment-shader SDF; the axis-aligned scissor still bounds every pipeline
# to the clip bbox. Use for a rounded card that contains a scroll list.
func pushClipRoundedRect(x: Float, y: Float, w: Float, h: Float, radius: Float) extern
func popClipRect() extern

# --- Images (#143, textured rounded quads) -------------------------------
# Decode a PNG file and upload it as a GPU texture; returns a 1-based handle
# (0 on failure). PNG only (lodepng) — convert JPEG assets to PNG. Load once,
# at startup; the texture is cached for the window's lifetime.
func loadImage(path: String) extern ret Int

# Device-free decode probe (#228): runs loadImage's exact decode +
# error policy (magic-sniff dispatch, one decoder per format) without
# uploading a texture, so decode behaviour is testable headless and
# assets can be validated from tooling. 1 = decodes, 0 = failed
# (with the standard stderr line). Compiled target only.
func decodeImageProbe(path: String) extern ret Int

# Decode+upload `path` and register it under `key` (returns the handle, 0 on
# failure). Lets a renderer resolve a Sprite.textureKey to an image without a
# Rae-side map. drawImageKey draws a registered key; hasImageKey tests one.
func loadImageKey(key: String, path: String) extern ret Int
# Register an image straight from RGBA pixels generated in Rae (#539) — no file.
# `pixels` is one packed int per pixel: r | g<<8 | b<<16 | a<<24 (order R,G,B,A).
func g2dRegisterImageRgba(pixels: view Buffer(Int), w: Int, h: Int) extern("rae_ext_gpu2d_registerImageRgba") ret Int
func g2dRegisterImageKeyHandle(key: String, handle: Int) extern("rae_ext_gpu2d_registerImageKeyHandle")
func registerImageRgba(key: copy String, pixels: view Buffer(Int), w: copy Int, h: copy Int) pub ret Int {
  let handle: Int = g2dRegisterImageRgba(pixels: pixels, w: w, h: h)
  if handle > 0 { g2dRegisterImageKeyHandle(key: key, handle: handle) }
  ret handle
}
func hasImageKey(key: String) extern ret Bool
func drawImageKey(key: String, x: Float, y: Float, w: Float, h: Float, radius: Float, tint: Int) extern
# Draw a registered image with ScaleMode semantics:
# 0 = fit, 1 = fill/cover-crop, 2 = stretch.
func drawImageKeyScaled(key: String, x: Float, y: Float, w: Float, h: Float, radius: Float, tint: Int, scaleMode: Int) extern

# Draw image `handle` into the rect at (x,y) sized w×h, with optional corner
# `radius`. `tint` is 0xAARRGGBB applied multiplicatively — 0xFFFFFFFF draws
# the image unchanged; a solid color tints a white/alpha icon to that color.
# Submitted between beginFrame/endFrame; drawn above boxes, below text.
func drawImage(x: Float, y: Float, w: Float, h: Float, radius: Float, handle: Int, tint: Int) extern

# --- Text (#111, MSDF glyph quads) ---------------------------------------
# Low-level: submit one MSDF glyph quad. Screen rect is (sx0,sy0)-(sx1,sy1)
# in pixels; UV rect is (u0,v0)-(u1,v1) NORMALISED into the atlas; `atlas` is
# the sdf_text.loadAtlas handle (1-based); `pxRange` is the screen-space px
# range (atlas pxRange * onScreenSize / atlasGlyphSize); colour is 0xAARRGGBB.
# One atlas/font per frame. Layout helper: lib/gpu2d_text.rae drawText.
func drawGlyph(sx0: Float, sy0: Float, sx1: Float, sy1: Float,
               u0: Float, v0: Float, u1: Float, v1: Float,
               atlas: Int, pxRange: Float, color: Int) extern

# Glyph with an outline: `outlineWidth` px of `outlineColor` (0xAARRGGBB) grown
# outward from the glyph edge (MSDF dilation), body composited over it. Used by
# lib/gpu2d_text.drawTextEx for outlined + shadowed text.
func drawGlyphEx(sx0: Float, sy0: Float, sx1: Float, sy1: Float,
                 u0: Float, v0: Float, u1: Float, v1: Float,
                 atlas: Int, pxRange: Float, color: Int,
                 outlineWidth: Float, outlineColor: Int, softness: Float) extern
