# gbuffer — the deferred frame's geometry pass (#356, Track B).
#
# This module is to `renderer_deferred` what `gpu3d` is to `renderer3d`:
# the GPU seam. `renderer_deferred` owns the frame graph and dispatches
# passes; this owns the typed encoding of one of them.
#
# WHAT MAKES IT DEFERRED. The pass writes surface ATTRIBUTES — albedo,
# world normal, metallic/roughness, depth — and performs no lighting at
# all. Lighting later reads those attributes once per pixel, so its cost
# stops scaling with the number of objects that contributed. That is the
# entire reason the frame is being rebuilt this way; a version of this
# module that shaded here would be the forward renderer wearing a new
# name.
#
# WHY THE G-BUFFER IS PACKED THE WAY IT IS (#366). Three targets plus
# depth, 16 bytes per pixel, with channels packed ACROSS targets rather
# than grouped by meaning — bandwidth is the point, and an unused channel
# is bandwidth spent on nothing:
#
#   A  oct(normal).xy at 10 bits, reserved, 2-bit shading mode
#   B  albedo.rgb, roughness
#   C  motion.xy, metallic, occlusion-or-emissive
#
# Octahedral normals are what make it fit: a unit vector has two degrees of
# freedom, so three channels waste one. The 10-bit depth is not incidental
# — 8-bit octahedral bands visibly on smooth surfaces.
#
# World position is still not stored: it reconstructs from depth, which is
# written anyway, so storing it would be three redundant channels.
#
# ALLOCATION-FREE PER OBJECT (#356's acceptance criterion). Transforms
# flow through `Mat4` from lib/math3d.rae — 16 Floats by value, an
# `Array(Float, cap: 16)` that lives on the stack. `beginPass` builds the
# view-projection from value types and hands it over by view; `drawInstance`
# builds a model matrix the same way. Neither touches the allocator, and
# test 573 asserts that by counting allocations across a many-object frame
# rather than trusting this paragraph.
#
# WORLD CONVENTION: right-handed Z-up (Blender), per
# docs/coordinate-system.md — the same as the forward path.
import core
import math
import vec3
import sky
import sky_hosek
open sky_hosek
open vec3
open scene3d
open sky
open math3d

# ----- raw C ABI (implementation detail; prefer the typed API below) ---
func begin(viewProj: view Mat4, clearR: Float, clearG: Float, clearB: Float) extern
func draw(mesh: Int, model: view Mat4, prevModel: view Mat4, r: Float, g: Float, b: Float, metallic: Float, roughness: Float, emissive: Float, toon: Int) extern
func drawSkinned(mesh: Int, model: view Mat4, prevModel: view Mat4, r: Float, g: Float, b: Float, metallic: Float, roughness: Float, emissive: Float, toon: Int) extern
# Instanced G-buffer draw (grass epic #485): one draw for `count` copies of a
# mesh. LOW-LEVEL — `records` is `count` * instanceRecordFloats fully built
# DrawU entries (model, prevModel, colour, packed params), assembled in Rae by
# swayModel + packInstanceRecord below. C only copies them and issues the draw;
# it does no math. The reusable instancing primitive for vegetation, rocks,
# crowds; grass uses it first.
func drawRecords(mesh: Int, records: view Buffer(Float), count: Int) extern
func drawMetaballs(packedBalls: view Buffer(Float), count: Int, packedColors: view Buffer(Float), smoothing: Float, camX: Float, camY: Float, camZ: Float, metallic: Float, roughness: Float, emR: Float, emG: Float, emB: Float) extern
func sdfShutdown() extern
func end() extern
func drawCount() extern ret Int
func debugView(mode: Int, zNear: Float, zFar: Float) extern
func present() extern
func shutdown() extern
func depthPyramid() extern
func lighting(camX: Float, camY: Float, camZ: Float, exposure: Float, sunX: Float, sunY: Float, sunZ: Float, sunR: Float, sunG: Float, sunB: Float, skyR: Float, skyG: Float, skyB: Float, gndR: Float, gndG: Float, gndB: Float, skyKind: Float, turbidity: Float, skyExposure: Float, sunSizeRad: Float, zenR: Float, zenG: Float, zenB: Float, bands: Float, horR: Float, horG: Float, horB: Float, discI: Float) extern
func composite(exposure: Float) extern
func pyramidMips() extern ret Int
func ssao(camX: Float, camY: Float, camZ: Float) extern
func taa() extern
func deferredShutdown() extern

# ----- G-buffer inspector modes ---------------------------------------
# Permanent equipment, not scaffolding: when a lit image is wrong the
# first question is always WHICH attribute is wrong, and that cannot be
# answered without looking at the channels directly.
const viewLit: Int = 0       # the composed/lit image (once lighting lands)
const viewAlbedo: Int = 1
const viewNormal: Int = 2
const viewMaterial: Int = 3  # r = metallic, g = roughness, b = occlusion/emissive
const viewDepth: Int = 4     # linearised for display

# Start the geometry pass. `aspect` is width/height of the target.
#
# The view-projection is built here from value types and passed by view:
# mat4LookAt, mat4Perspective and mat4Mul all return `Mat4` by value, so
# the whole chain is stack traffic. The forward path packs an equivalent
# block into a List(Float) — one allocation per frame — which this
# deliberately does not inherit.
func beginPass(camera: view Camera3d, light: view Light3d, aspect: view Float) pub {
  let worldUp: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let viewM: Mat4 = mat4LookAt(
    eyeX: camera.position.x, eyeY: camera.position.y, eyeZ: camera.position.z,
    atX: camera.target.x, atY: camera.target.y, atZ: camera.target.z,
    upX: worldUp.x, upY: worldUp.y, upZ: worldUp.z
  )
  # Reverse-Z (#367): near maps to 1, far to 0, which is what the geometry
  # pass's Greater depth test and 0.0 clear expect. The forward frame keeps
  # mat4Perspective — the two conventions must not be mixed.
  let proj: Mat4 = mat4PerspectiveReverseZ(fovYDeg: camera.fovYDeg, aspect: aspect, near: camera.nearZ, far: camera.farZ)
  let viewProj: Mat4 = mat4Mul(a: proj, b: viewM)
  begin(viewProj: viewProj, clearR: light.clearColor.x, clearG: light.clearColor.y, clearB: light.clearColor.z)
}

# Model matrix for a typed transform: M = T * Rz * Ry * Rx * S, Euler XYZ
# radians, right-handed. Same construction as the forward path's — the two
# frames must agree about where an object IS, whatever they disagree about
# in how it is shaded.
func modelMatrixOf(t: view Transform3d) pub ret Mat4 {
  let s: Mat4 = mat4ScaleXYZ(x: t.scale.x, y: t.scale.y, z: t.scale.z)
  let rx: Mat4 = mat4RotateX(angle: t.rotation.x)
  let ry: Mat4 = mat4RotateY(angle: t.rotation.y)
  let rz: Mat4 = mat4RotateZ(angle: t.rotation.z)
  let tr: Mat4 = mat4Translate(x: t.position.x, y: t.position.y, z: t.position.z)
  let rxs: Mat4 = mat4Mul(a: rx, b: s)
  let ryrxs: Mat4 = mat4Mul(a: ry, b: rxs)
  let rot: Mat4 = mat4Mul(a: rz, b: ryrxs)
  ret mat4Mul(a: tr, b: rot)
}

# ----- instanced draw: DrawU records built in Rae (grass epic #485) --------
#
# The instanced path hands the GPU seam ready-made DrawU records, the same way
# `drawInstance` hands it a ready-made Mat4. The matrix and the G-buffer's
# packed wire format both live HERE, in Rae — C's `drawRecords` only copies and
# draws. One DrawU record is `instanceRecordFloats` floats:
#   [0..15]  model         [16..31] prevModel
#   [32..34] albedo rgb    [35] metallic
#   [36] roughness  [37] emissive-or-occlusion  [38] shading mode  [39] spare
# mirroring the C staging layout (GB_DRAW_FLOATS). Kept in one Rae place so a
# caller never touches raw offsets.
const instanceRecordFloats: Int = 40

# Shading-mode field values, mirroring GB_MODE_* in the runtime. The 2-bit
# field is stored as a Float in 0..1 so it survives the rgb10a2 target.
const gbModeLit: Float = 0.0
const gbModeEmissive: Float = 0.3333333
const gbModeToon: Float = 1.0
# Emissive is log-encoded into the 8-bit channel it shares with occlusion;
# lighting decodes with the matching constant (GB_EMISSIVE_LOG_K).
const gbEmissiveLogK: Float = 6.91

# Position + yaw + two wind-driven tilt angles + uniform scale -> a model
# matrix, as T * Rz(yaw) * Rx(tiltX) * Ry(tiltY) * S(scale). This is what the C
# `gb_sway_model` used to compute; it is plain Mat4 composition, so it belongs
# in Rae like every other transform the renderer builds.
func swayModel(x: view Float, y: view Float, z: view Float, yaw: view Float,
               tiltX: view Float, tiltY: view Float, scale: view Float) pub ret Mat4 {
  let scaleM: Mat4 = mat4Scale(s: scale)
  let ry: Mat4 = mat4RotateY(angle: tiltY)
  let rx: Mat4 = mat4RotateX(angle: tiltX)
  let rz: Mat4 = mat4RotateZ(angle: yaw)
  let tr: Mat4 = mat4Translate(x: x, y: y, z: z)
  let rys: Mat4 = mat4Mul(a: ry, b: scaleM)
  let rxrys: Mat4 = mat4Mul(a: rx, b: rys)
  let rot: Mat4 = mat4Mul(a: rz, b: rxrys)
  ret mat4Mul(a: tr, b: rot)
}

# The shared param encode both draw paths need: emissive log-encoded into the
# channel it shares with occlusion, plus the shading-mode flag. A non-emitter
# stores 1.0 there — "unoccluded", the right default until AO writes something.
func encodeEmissive(emissive: view Float, toon: view Int) ret Float {
  if toon is 1 { ret 1.0 }
  if emissive > 0.0 {
    let e: Float = math.math_log(x: 1.0 + emissive) / gbEmissiveLogK
    if e > 1.0 { ret 1.0 }
    ret e
  }
  ret 1.0
}

func encodeMode(emissive: view Float, toon: view Int) ret Float {
  if toon is 1 { ret gbModeToon }
  if emissive > 0.0 { ret gbModeEmissive }
  ret gbModeLit
}

# Pack one fully-built DrawU record into `records` at instance `slot`. Writes
# `instanceRecordFloats` floats; callers size the buffer by that constant and
# never see the layout.
func packInstanceRecord(records: mod List(Float), slot: view Int,
                        model: view Mat4, prevModel: view Mat4,
                        r: view Float, g: view Float, b: view Float,
                        metallic: view Float, roughness: view Float,
                        emissive: view Float, toon: view Int) pub {
  let base: Int = slot * instanceRecordFloats
  var i: Int = 0
  loop i < 16 {
    records.set(index: base + i, value: mat4Get(m: model, i: i))
    records.set(index: base + 16 + i, value: mat4Get(m: prevModel, i: i))
    i = i + 1
  }
  records.set(index: base + 32, value: r)
  records.set(index: base + 33, value: g)
  records.set(index: base + 34, value: b)
  records.set(index: base + 35, value: metallic)
  records.set(index: base + 36, value: roughness)
  records.set(index: base + 37, value: encodeEmissive(emissive: emissive, toon: toon))
  records.set(index: base + 38, value: encodeMode(emissive: emissive, toon: toon))
  records.set(index: base + 39, value: 0.0)
}

# Write one mesh instance's surface attributes. Note what is NOT passed:
# no light, no camera, no emission. A geometry pass that needed any of
# those would not be a geometry pass.
# `prevTransform` is where the instance was LAST frame; it drives the
# G-buffer's motion channel, which TAA reads (#390). Pass the same
# transform when an object did not move.
# Bool -> Int at the extern boundary, where Rae's Bool has no defined
# representation. One place to cross it, so both draw paths agree.
func toonFlag(material: view Material3d) ret Int {
  if material.toon {
    ret 1
  }
  ret 0
}

func drawInstance(mesh: view MeshHandle, transform: view Transform3d, prevTransform: view Transform3d, material: view Material3d) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  # Emissive is ONE scalar, not a colour: an emitter's base colour is the
  # colour it emits, so the G-buffer stores intensity and lighting tints it
  # by albedo. The brightest component is the intensity — using luminance
  # would dim a saturated single-channel emitter to near nothing.
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  draw(
    mesh: mesh.id, model: model, prevModel: prevModel,
    r: material.baseColor.x, g: material.baseColor.y, b: material.baseColor.z,
    metallic: material.metallic, roughness: material.roughness, emissive: emissive,
    toon: toonFlag(material: material)
  )
}

# Queue a SKINNED mesh (#391). Same materials and the same G-buffer
# layout as a static draw; the difference is only that the vertex stage
# poses the mesh by the joint palette first. The palette is uploaded once
# per frame by gpu3d.uploadPalette and shared by every pipeline that
# reads it.
func drawSkinnedInstance(mesh: view MeshHandle, model: view Mat4, prevModel: view Mat4,
                         material: view Material3d) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  drawSkinned(
    mesh: mesh.id, model: model, prevModel: prevModel,
    r: material.baseColor.x, g: material.baseColor.y, b: material.baseColor.z,
    metallic: material.metallic, roughness: material.roughness, emissive: emissive,
    toon: toonFlag(material: material)
  )
}

# Fill the G-buffer from a scene's mesh components.
#
# SDF primitives now participate too (#392): the raymarch writes packed
# G-buffer attributes and frag_depth, so a metaball surface is shaded by
# the same lighting pass as every triangle and depth-tests against them.
# Metaball clusters into the G-buffer. Cluster discovery mirrors the
# forward path exactly — scan for unseen cluster ids rather than sorting,
# since a scene has a handful of clusters — because the two frames must
# group the same balls into the same surfaces or they render different
# geometry from one scene.
func renderSceneSdf(scene: view Scene3d, camera: view Camera3d) pub {
  if scene.sdfPrimitives.length is 0 {
    ret
  }
  var clusterScan: Int = 0
  loop clusterScan < scene.sdfPrimitives.length {
    let head: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: clusterScan)
    var alreadyDrawn: Bool = false
    var back: Int = 0
    loop back < clusterScan {
      let prior: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: back)
      if prior.shape is 0 {
        if prior.cluster is head.cluster { alreadyDrawn = true }
      }
      back = back + 1
    }
    if head.shape is 0 {
      if alreadyDrawn is false {
        let packed: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
        let colors: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
        var ballCount: Int = 0
        var i: Int = 0
        loop i < scene.sdfPrimitives.length {
          let sdf: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: i)
          if sdf.shape is 0 {
            if sdf.cluster is head.cluster {
              let transform: Transform3d = sceneTransformAt(values: scene.transforms, index: sdf.entity)
              packed.add(value: transform.position.x)
              packed.add(value: transform.position.y)
              packed.add(value: transform.position.z)
              packed.add(value: transform.scale.x)
              let ballMaterial: Material3d = sceneMaterialAt(values: scene.materials, index: sdf.material)
              colors.add(value: ballMaterial.baseColor.x)
              colors.add(value: ballMaterial.baseColor.y)
              colors.add(value: ballMaterial.baseColor.z)
              colors.add(value: 0.0)
              ballCount = ballCount + 1
            }
          }
          i = i + 1
        }
        if ballCount > 0 {
          let material: Material3d = sceneMaterialAt(values: scene.materials, index: head.material)
          drawMetaballs(
            packedBalls: packed.data, count: ballCount,
            packedColors: colors.data, smoothing: head.smoothing,
            camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
            metallic: material.metallic, roughness: material.roughness,
            emR: material.emission.x, emG: material.emission.y, emB: material.emission.z
          )
        }
      }
    }
    clusterScan = clusterScan + 1
  }
}

func renderScene(scene: view Scene3d) pub {
  var i: Int = 0
  loop i < scene.meshRenderers.length {
    let r: MeshRenderer = sceneMeshRendererAt(values: scene.meshRenderers, index: i)
    if r.visible {
      let t: Transform3d = sceneTransformAt(values: scene.transforms, index: r.entity)
      # prevTransforms is kept in lockstep with transforms by addTransform
      # (#336), so this index is always valid.
      let pt: Transform3d = sceneTransformAt(values: scene.prevTransforms, index: r.entity)
      let m: Material3d = sceneMaterialAt(values: scene.materials, index: r.material)
      drawInstance(mesh: r.mesh, transform: t, prevTransform: pt, material: m)
    }
    i = i + 1
  }
}

func endPass() pub {
  end()
}

# How many instances the last pass actually submitted. Lets a caller (or a
# test) distinguish "drew nothing" from "drew and the image is wrong".
func passDrawCount() pub ret Int {
  ret drawCount()
}

# Paint one G-buffer channel into the presentable target.
func inspect(mode: view Int, zNear: view Float, zFar: view Float) pub {
  debugView(mode: mode, zNear: zNear, zFar: zFar)
}

func presentFrame() pub {
  present()
}

# ----- the passes that consume the G-buffer ---------------------------

# Reduce depth into a MIN mip chain. Min, not average: the question a
# pyramid answers is "is anything in this region closer than my bounding
# box", and that is the nearest depth. An averaged chain would cull
# visible geometry. Hi-Z culling and a deferred SSAO are the intended
# readers.
func buildDepthPyramid() pub {
  depthPyramid()
}

# One fullscreen evaluation of the BRDF over the whole G-buffer. This is
# the payoff of the split: the cost is per pixel, not per object-pixel, so
# it no longer matters how many objects contributed to a pixel — only that
# one of them won the depth test.
# Screen-space AO for the deferred frame (#387). Runs between the depth
# pyramid and lighting; lighting samples the result and applies it to the
# INDIRECT term only.
func ssaoPass(camera: view Camera3d) pub {
  ssao(camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z)
}

# Temporal resolve (#390). Reads the radiance lighting wrote plus last
# frame's history, reprojected through the G-buffer's motion channel;
# composite then reads the resolved image. Runs on HDR, before tonemap,
# so accumulation stays linear.
func taaPass() pub {
  taa()
}

# Light the frame from a bound SKY rather than from the light's authored
# ambient (#399).
#
# The sky is the single source of the environment: the values below are
# the ones it reports, so the ambient the scene receives and the sky it
# stands under cannot drift apart. Under SkyKind.none those values ARE
# the light's own anchors, so this is bit-identical to lightingPass and
# is the whole reason M0 can claim to change nothing.
#
# The sun still comes from Light3d. Extraction (#403) is what moves it,
# and moving it before there is anything to extract from would just mean
# copying the same numbers through a second place.
func skyHosekPush(index: Int, value: Float) extern

# Three vec4 per channel: [A B C D][E F G H][I radiance _ _], matching `hosek`
# in the WGSL. Written out longhand rather than looped over a list because the
# layout IS the contract with the shader, and a reader checking it against the
# WGSL should see the same sixteen names in the same order.
func pushHosekChannel(c: view HosekChannel, base: view Int) {
  skyHosekPush(index: base + 0, value: c.a)
  skyHosekPush(index: base + 1, value: c.b)
  skyHosekPush(index: base + 2, value: c.c)
  skyHosekPush(index: base + 3, value: c.d)
  skyHosekPush(index: base + 4, value: c.e)
  skyHosekPush(index: base + 5, value: c.f)
  skyHosekPush(index: base + 6, value: c.g)
  skyHosekPush(index: base + 7, value: c.h)
  skyHosekPush(index: base + 8, value: c.i)
  skyHosekPush(index: base + 9, value: c.radiance)
}

func lightingPassSky(camera: view Camera3d, light: view Light3d, sky: view Sky) pub {
  let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let down: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0 - 1.0)
  # The shader interpolates between these two anchors, so the sky is
  # asked for exactly the two directions that interpolation runs between.
  # A sky whose irradiance is not a hemisphere blend (#401) will need the
  # shader to evaluate it per normal instead; this is the shape that is
  # correct for every kind that IS one, and it keeps M0 a no-op.
  let skyC: Vec3 = skyIrradiance(sky: sky, n: up)
  let gndC: Vec3 = skyIrradiance(sky: sky, n: down)
  # The cooked table goes up first: the lighting pass copies whatever is here
  # into the uniform, so pushing after it would show last frame's sky.
  pushHosekChannel(c: sky.hosek.r, base: 0)
  pushHosekChannel(c: sky.hosek.g, base: 12)
  pushHosekChannel(c: sky.hosek.b, base: 24)
  lighting(
    camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
    exposure: light.exposure,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    skyR: skyC.x, skyG: skyC.y, skyB: skyC.z,
    gndR: gndC.x, gndG: gndC.y, gndB: gndC.z,
    # The BACKGROUND half of the interface. Sent to the same shader as
    # the ambient above, from the same Sky, so what the camera sees and
    # what the scene is lit by cannot come from different environments.
    skyKind: skyKindCode(sky: sky), turbidity: sky.turbidity,
    skyExposure: sky.exposure, sunSizeRad: sky.sunAngularRadius,
    zenR: sky.zenithColor.x, zenG: sky.zenithColor.y, zenB: sky.zenithColor.z,
    bands: sky.bands,
    horR: sky.horizonColor.x, horG: sky.horizonColor.y, horB: sky.horizonColor.z,
    discI: sky.sunDiscIntensity
  )
}

func lightingPass(camera: view Camera3d, light: view Light3d) pub {
  lighting(
    camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
    exposure: light.exposure,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    skyR: light.ambSky.x, skyG: light.ambSky.y, skyB: light.ambSky.z,
    gndR: light.ambGround.x, gndG: light.ambGround.y, gndB: light.ambGround.z,
    # Kind 0: no sky, background stays the clear colour.
    skyKind: 0.0, turbidity: 3.0, skyExposure: 1.0, sunSizeRad: 0.0047,
    zenR: 0.0, zenG: 0.0, zenB: 0.0, bands: 1.0,
    horR: 0.0, horG: 0.0, horB: 0.0, discI: 0.0
  )
}

# Exposure + ACES + gamma, radiance -> the presentable target. The tone
# curve is deliberately identical to the forward frame's: the two should
# differ in how radiance is computed, not in how it is displayed, or
# comparing them proves nothing.
func compositePass(exposure: view Float) pub {
  composite(exposure: exposure)
}

# Mip levels in the pyramid; 0 before the first build. Lets a caller
# confirm the chain was built rather than silently skipped.
func depthPyramidMips() pub ret Int {
  ret pyramidMips()
}

func shutdownAll() pub {
  deferredShutdown()
  shutdown()
}
