# gbuffer — the deferred frame's geometry pass (#356, Track B).
#
# This module is to `renderer_deferred` what `gpu3d` is to `renderer3d`:
# the GPU seam. `renderer_deferred` owns the frame graph and dispatches
# passes; this owns the typed encoding of one of them.
#
# WHAT MAKES IT DEFERRED. The pass writes surface ATTRIBUTES — albedo,
# world normal, metallic/roughness, depth — and performs no lighting at
# all. Lighting later reads those attributes once per pixel, so its cost
# stops scaling with the number of objects that contributed. That is the
# entire reason the frame is being rebuilt this way; a version of this
# module that shaded here would be the forward renderer wearing a new
# name.
#
# WHY THE G-BUFFER IS PACKED THE WAY IT IS (#366). Three targets plus
# depth, 16 bytes per pixel, with channels packed ACROSS targets rather
# than grouped by meaning — bandwidth is the point, and an unused channel
# is bandwidth spent on nothing:
#
#   A  oct(normal).xy at 10 bits, reserved, 2-bit shading mode
#   B  albedo.rgb, roughness
#   C  motion.xy, metallic, occlusion-or-emissive
#
# Octahedral normals are what make it fit: a unit vector has two degrees of
# freedom, so three channels waste one. The 10-bit depth is not incidental
# — 8-bit octahedral bands visibly on smooth surfaces.
#
# World position is still not stored: it reconstructs from depth, which is
# written anyway, so storing it would be three redundant channels.
#
# ALLOCATION-FREE PER OBJECT (#356's acceptance criterion). Transforms
# flow through `Mat4` from lib/math3d.rae — 16 Floats by value, an
# `Array(Float, cap: 16)` that lives on the stack. `beginPass` builds the
# view-projection from value types and hands it over by view; `drawInstance`
# builds a model matrix the same way. Neither touches the allocator, and
# test 573 asserts that by counting allocations across a many-object frame
# rather than trusting this paragraph.
#
# WORLD CONVENTION: right-handed Z-up (Blender), per
# docs/coordinate-system.md — the same as the forward path.
import core
import math
import vec3
import sky
import sky_hosek
open sky_hosek
open vec3
open scene3d
open sky
open math3d
# The instanced draw path (#502) runs in Rae directly on the WebGPU bindings.
# `open webgpu/webgpu` also makes the sibling enum/flag consts (e.g.
# WGPUIndexFormat_Uint32) resolvable as bare cheader-backed references; do NOT
# `open webgpu/webgpu_enums` — importing that module emits every enum value as a
# C definition, colliding with the real enumerators from the cheader.
open webgpu/webgpu
import webgpu/context

# ----- geometry-pass begin: frame prep (C) + render pass (Rae) (#503) --------
# C preps the frame — lazily creates pipeline/targets, resets counters, builds
# and uploads the TAA-jittered frame uniform (stateful CPU math) — and returns 1
# when ready. Everything after (the command encoder, the render pass with its 3
# G-buffer colour attachments + depth, and binding the static pipeline) is built
# in Rae over the generated bindings.
func gbPrepare() extern("rae_gb_prepare") ret Int
func gbFrameUniform(viewProj: view Mat4, clearR: Float, clearG: Float, clearB: Float) extern("rae_gb_frame_uniform") ret Int
func gbSetFrameUbuf(buf: Ptr) extern("rae_gb_set_frame_ubuf")
func gbSetDrawsBuffer(buf: Ptr) extern("rae_gb_set_draws_buffer")
func gbViewA() extern("rae_gb_view_a") ret Ptr
func gbViewB() extern("rae_gb_view_b") ret Ptr
func gbViewC() extern("rae_gb_view_c") ret Ptr
func gbViewDepth() extern("rae_gb_view_depth") ret Ptr
# Target creation (#503): C provides the offscreen size, the resize check, the
# release and the size/gen commit; Rae builds each attachment texture + view.
func gbOffscreenW() extern("rae_gb_offscreen_w") ret Int
func gbOffscreenH() extern("rae_gb_offscreen_h") ret Int
func gbTargetsMatch(w: Int, h: Int) extern("rae_gb_targets_match") ret Int
func gbTargetsReady() extern("rae_gb_targets_ready") ret Int
func gbReleaseTargets() extern("rae_gb_release_targets_ext")
func gbSetTarget(idx: Int, tex: Ptr, texView: Ptr) extern("rae_gb_set_target")
func gbCommitTargets(w: Int, h: Int) extern("rae_gb_commit_targets")
# Shared by the inspector and the deferred post-passes (declared here so both
# get them via `open gbuffer` without redeclaring): the presentable target's
# format/view and the targets-resize generation counter.
func g2dFormat() extern("rae_g2d_format") ret Int
func g2dOffView() extern("rae_g2d_off_view") ret Ptr
func gbTargetsGen() extern("rae_gb_targets_gen") ret Int

# One G-buffer attachment: a 2D texture (render target + sampleable) and its
# full view. mipLevelCount/sampleCount are 1, so an explicit single-mip 2D view
# is the default view — equivalent to the null-descriptor the C path used.
func makeTarget(idx: copy Int, w: copy Int, h: copy Int, format: copy Int32) {
  let td: WGPUTextureDescriptor = {
    usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding,
    dimension: WGPUTextureDimension_2D,
    size: { width: w as UInt32, height: h as UInt32, depthOrArrayLayers: 1 as UInt32 },
    format: format, mipLevelCount: 1 as UInt32, sampleCount: 1 as UInt32
  }
  let tex: Ptr = wgpuDeviceCreateTexture(device: webgpuDevice(), descriptor: td)
  let vd: WGPUTextureViewDescriptor = {
    format: format, dimension: WGPUTextureViewDimension_2D,
    baseMipLevel: 0 as UInt32, mipLevelCount: 1 as UInt32,
    baseArrayLayer: 0 as UInt32, arrayLayerCount: 1 as UInt32,
    aspect: WGPUTextureAspect_All
  }
  let texView: Ptr = wgpuTextureCreateView(texture: tex, descriptor: vd)
  gbSetTarget(idx: idx, tex: tex, texView: texView)
}

# (Re)create the three colour targets + depth when the offscreen size changes.
func ensureTargets() {
  let w: Int = gbOffscreenW()
  let h: Int = gbOffscreenH()
  if w <= 0 { ret }
  if h <= 0 { ret }
  if gbTargetsMatch(w: w, h: h) is 1 { ret }
  gbReleaseTargets()
  makeTarget(idx: 0, w: w, h: h, format: WGPUTextureFormat_RGB10A2Unorm)
  makeTarget(idx: 1, w: w, h: h, format: WGPUTextureFormat_RGBA8Unorm)
  makeTarget(idx: 2, w: w, h: h, format: WGPUTextureFormat_RGBA8Unorm)
  makeTarget(idx: 3, w: w, h: h, format: WGPUTextureFormat_Depth32Float)
  gbCommitTargets(w: w, h: h)
}
func gbMotionZero() extern("rae_gb_motion_zero") ret Float
func gbSetFrame(enc: Ptr, pass: Ptr) extern("rae_gb_set_frame")
# Static bind group creation (#503): built in Rae from the pipeline's auto
# layout + the frame uniform and draws buffers (still C-created), stored back
# into the C global via the setter so draws and begin() see it.
func gbFrameUbuf() extern("rae_gb_frame_ubuf") ret Ptr
func gbFrameBytes() extern("rae_gb_frame_bytes") ret Int
func gbDrawsSize() extern("rae_gb_draws_size") ret Int
func gbSetStaticBind(bind: Ptr) extern("rae_gb_set_static_bind")

var gBuffersMade: Bool = false

# Create the frame uniform + draws storage buffers once, over the bindings, and
# store them back into C so the frame-uniform upload, draws and bind groups use
# them. Distinct flag bits, so `+` is the flag union.
func ensureGbBuffers() {
  if gBuffersMade { ret }
  gBuffersMade = true
  let uDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst,
    size: gbFrameBytes() as UInt64
  }
  gbSetFrameUbuf(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: uDesc))
  let sDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst,
    size: gbDrawsSize() as UInt64
  }
  gbSetDrawsBuffer(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: sDesc))
}

var gStaticBindMade: Bool = false

# Create the static geometry bind group once, over the bindings. Safe to call
# only after gbPrepare returned 1 and the buffers exist.
func ensureStaticBind() {
  if gStaticBindMade { ret }
  gStaticBindMade = true
  let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: gbStaticPipeline(), groupIndex: 0 as UInt32)
  var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 2)
  entries.add(value: { binding: 0 as UInt32, buffer: gbFrameUbuf(), size: gbFrameBytes() as UInt64 })
  entries.add(value: { binding: 1 as UInt32, buffer: gbDrawsBuffer(), size: gbDrawsSize() as UInt64 })
  let desc: WGPUBindGroupDescriptor = {
    layout: layout, entryCount: 2 as UInt64, entries: entries.data
  }
  let bind: Ptr = wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc)
  wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
  gbSetStaticBind(bind: bind)
}

# Reusable attachment arrays (#503) — module-level so begin() never allocates
# per frame; filled once to length, then rewritten in place each frame.
var gGbColorAtts: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 3)
var gGbDepthAtt: List(WGPURenderPassDepthStencilAttachment) = createList(WGPURenderPassDepthStencilAttachment, cap: 1)

# Placeholder entries carry one explicit (zeroed) field — an empty {} is not a
# valid C initializer. They are rewritten in full by begin() every frame.
func ensureGbAttachments() {
  loop gGbColorAtts.length < 3 { gGbColorAtts.add(value: { depthSlice: 0 as UInt32 }) }
  loop gGbDepthAtt.length < 1 { gGbDepthAtt.add(value: { depthReadOnly: 0 as UInt32 }) }
}

# ----- render pipelines + WGSL shader modules (#503) -------------------------
# The shaders stay as source: C exposes the WGSL text + entry-point names, Rae
# builds the modules and pipelines over the bindings.
func gbWgsl() extern("rae_gb_wgsl") ret Ptr
func gbSkinWgsl() extern("rae_gb_skin_wgsl") ret Ptr
func gbEntryVs() extern("rae_gb_entry_vs") ret Ptr
func gbEntryFs() extern("rae_gb_entry_fs") ret Ptr
func gbSetPipeline(pipeline: Ptr) extern("rae_gb_set_pipeline")
func gbSetSkinPipeline(pipeline: Ptr) extern("rae_gb_set_skin_pipeline")

var gPipelinesMade: Bool = false

# WGSL text -> shader module. The chained WGPUShaderSourceWGSL lives in a
# one-element List so .data gives its address for nextInChain (chain is the
# struct's first field, so &struct == &chain). createShaderModule is
# synchronous, so the List outlives the call.
func makeShaderModule(wgsl: copy Ptr) ret Ptr {
  var srcList: List(WGPUShaderSourceWGSL) = createList(WGPUShaderSourceWGSL, cap: 1)
  srcList.add(value: {
    chain: { sType: WGPUSType_ShaderSourceWGSL },
    code: { data: wgsl, length: WGPU_STRLEN }
  })
  let desc: WGPUShaderModuleDescriptor = { nextInChain: srcList.data }
  ret wgpuDeviceCreateShaderModule(device: webgpuDevice(), descriptor: desc)
}

# One G-buffer render pipeline: shared 3 colour targets + reverse-Z depth, with
# the caller's shader module and vertex layout. Every array/pointer descriptor
# member is a List; .data gives the pointer, and the Lists outlive the
# synchronous createRenderPipeline.
func makeGbPipeline(shaderMod: copy Ptr, attrs: mod List(WGPUVertexAttribute), stride: copy Int) ret Ptr {
  var vbls: List(WGPUVertexBufferLayout) = createList(WGPUVertexBufferLayout, cap: 1)
  vbls.add(value: {
    stepMode: WGPUVertexStepMode_Vertex, arrayStride: stride as UInt64,
    attributeCount: attrs.length as UInt64, attributes: attrs.data
  })
  var targets: List(WGPUColorTargetState) = createList(WGPUColorTargetState, cap: 3)
  targets.add(value: { format: WGPUTextureFormat_RGB10A2Unorm, writeMask: WGPUColorWriteMask_All })
  targets.add(value: { format: WGPUTextureFormat_RGBA8Unorm, writeMask: WGPUColorWriteMask_All })
  targets.add(value: { format: WGPUTextureFormat_RGBA8Unorm, writeMask: WGPUColorWriteMask_All })
  var frags: List(WGPUFragmentState) = createList(WGPUFragmentState, cap: 1)
  frags.add(value: {
    module: shaderMod, entryPoint: { data: gbEntryFs(), length: WGPU_STRLEN },
    targetCount: 3 as UInt64, targets: targets.data
  })
  var depths: List(WGPUDepthStencilState) = createList(WGPUDepthStencilState, cap: 1)
  depths.add(value: {
    format: WGPUTextureFormat_Depth32Float,
    depthWriteEnabled: WGPUOptionalBool_True,
    depthCompare: WGPUCompareFunction_Greater,
    stencilFront: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilBack: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilReadMask: 4294967295 as UInt32, stencilWriteMask: 4294967295 as UInt32
  })
  let desc: WGPURenderPipelineDescriptor = {
    vertex: {
      module: shaderMod, entryPoint: { data: gbEntryVs(), length: WGPU_STRLEN },
      bufferCount: 1 as UInt64, buffers: vbls.data
    },
    primitive: {
      topology: WGPUPrimitiveTopology_TriangleList,
      frontFace: WGPUFrontFace_CCW, cullMode: WGPUCullMode_Back
    },
    depthStencil: depths.data,
    multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 },
    fragment: frags.data
  }
  ret wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: desc)
}

func ensurePipelines() {
  if gPipelinesMade { ret }
  gPipelinesMade = true
  let staticMod: Ptr = makeShaderModule(wgsl: gbWgsl())
  var staticAttrs: List(WGPUVertexAttribute) = createList(WGPUVertexAttribute, cap: 3)
  staticAttrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0 as UInt64, shaderLocation: 0 as UInt32 })
  staticAttrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12 as UInt64, shaderLocation: 1 as UInt32 })
  staticAttrs.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24 as UInt64, shaderLocation: 2 as UInt32 })
  gbSetPipeline(pipeline: makeGbPipeline(shaderMod: staticMod, attrs: staticAttrs, stride: 32))
  wgpuShaderModuleRelease(shaderModule: staticMod)

  let skinMod: Ptr = makeShaderModule(wgsl: gbSkinWgsl())
  var skinAttrs: List(WGPUVertexAttribute) = createList(WGPUVertexAttribute, cap: 6)
  skinAttrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0 as UInt64, shaderLocation: 0 as UInt32 })
  skinAttrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12 as UInt64, shaderLocation: 1 as UInt32 })
  skinAttrs.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24 as UInt64, shaderLocation: 2 as UInt32 })
  skinAttrs.add(value: { format: WGPUVertexFormat_Float32x4, offset: 32 as UInt64, shaderLocation: 3 as UInt32 })
  skinAttrs.add(value: { format: WGPUVertexFormat_Float32x4, offset: 48 as UInt64, shaderLocation: 4 as UInt32 })
  skinAttrs.add(value: { format: WGPUVertexFormat_Float32x4, offset: 64 as UInt64, shaderLocation: 5 as UInt32 })
  gbSetSkinPipeline(pipeline: makeGbPipeline(shaderMod: skinMod, attrs: skinAttrs, stride: 80))
  wgpuShaderModuleRelease(shaderModule: skinMod)
}

func begin(viewProj: view Mat4, clearR: copy Float, clearG: copy Float, clearB: copy Float) pub {
  if gbPrepare() is 0 { ret }
  ensurePipelines()
  ensureTargets()
  if gbTargetsReady() is 0 { ret }
  ensureGbBuffers()
  ensureStaticBind()
  if gbFrameUniform(viewProj: viewProj, clearR: clearR, clearG: clearG, clearB: clearB) is 0 { ret }
  ensureGbAttachments()

  let undefinedSlice: UInt32 = WGPU_DEPTH_SLICE_UNDEFINED as UInt32
  let motionZero: Float64 = gbMotionZero() as Float64

  # A: octahedral normal + shading mode. (0.5, 0.5) decodes to +Z, mode 0 = lit.
  let attA: WGPURenderPassColorAttachment = {
    view_: gbViewA(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: 0.5, g: 0.5, b: 0.0, a: 0.0 }
  }
  # B: albedo, cleared to the sky/background colour.
  let attB: WGPURenderPassColorAttachment = {
    view_: gbViewB(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: clearR as Float64, g: clearG as Float64, b: clearB as Float64, a: 1.0 }
  }
  # C: material/motion. Motion clears to the biased zero (no movement).
  let attC: WGPURenderPassColorAttachment = {
    view_: gbViewC(), depthSlice: undefinedSlice,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store,
    clearValue: { r: motionZero, g: motionZero, b: 0.0, a: 1.0 }
  }
  gGbColorAtts.set(index: 0, value: attA)
  gGbColorAtts.set(index: 1, value: attB)
  gGbColorAtts.set(index: 2, value: attC)

  # Depth: reverse-Z, so the far plane clears to 0 (#367).
  let depthAtt: WGPURenderPassDepthStencilAttachment = {
    view_: gbViewDepth(),
    depthLoadOp: WGPULoadOp_Clear, depthStoreOp: WGPUStoreOp_Store,
    depthClearValue: 0.0
  }
  gGbDepthAtt.set(index: 0, value: depthAtt)

  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 3 as UInt64,
    colorAttachments: gGbColorAtts.data,
    depthStencilAttachment: gGbDepthAtt.data
  }
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: gbStaticPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: gbStaticBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  gbSetFrame(enc: enc, pass: pass)
}

# Shared tail of every G-buffer draw (#502/#503): upload `count` DrawU records
# (already at `records`) into the draws storage buffer at slot `base`, bind the
# given pipeline / bind group / mesh buffers, and issue one instanced
# DrawIndexed. Every draw — static, skinned, instanced — funnels through here,
# so the whole encoding lives in Rae over the generated bindings, no C shim.
func gbIssueInstanced(pass: copy Ptr, pipeline: copy Ptr, bind: copy Ptr,
                      vbuf: copy Ptr, ibuf: copy Ptr, icount: copy Int,
                      base: copy Int, count: copy Int, records: copy Ptr) {
  let strideBytes: Int = instanceRecordFloats * 4
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: gbDrawsBuffer(),
    bufferOffset: (base * strideBytes) as UInt64, data: records,
    size: (count * strideBytes) as UInt64)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: pipeline)
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: bind, dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  wgpuRenderPassEncoderSetVertexBuffer(renderPassEncoder: pass, slot: 0 as UInt32,
    buffer: vbuf, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: vbuf))
  wgpuRenderPassEncoderSetIndexBuffer(renderPassEncoder: pass, buffer: ibuf,
    format: WGPUIndexFormat_Uint32, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: ibuf))
  wgpuRenderPassEncoderDrawIndexed(renderPassEncoder: pass,
    indexCount: icount as UInt32, instanceCount: count as UInt32,
    firstIndex: 0 as UInt32, baseVertex: 0 as Int32, firstInstance: base as UInt32)
  gbAdvanceDraws(count: count)
}

# Instanced G-buffer draw (grass epic #485, ported to Rae #502): one draw for
# `count` copies of a mesh. `records` is `count` * instanceRecordFloats fully
# built DrawU entries (model, prevModel, colour, packed params), assembled in
# Rae by swayModel + packInstanceRecord below. Rae uploads the records straight
# into the draws storage buffer and issues one instanced DrawIndexed on the
# static pipeline — no C shim. A skinned draw may have left its pipeline bound,
# so gbIssueInstanced re-binds the static one.
func drawRecords(mesh: copy Int, records: copy Ptr, count: copy Int) pub {
  if gbMeshReady(mesh: mesh) is 0 { ret }
  let base: Int = gbDrawCount()
  let remaining: Int = gbMaxDraws() - base
  var n: Int = count
  if n > remaining { n = remaining }
  if n <= 0 { ret }
  gbIssueInstanced(pass: gbPass(), pipeline: gbStaticPipeline(), bind: gbStaticBind(),
    vbuf: gbMeshVbuf(mesh: mesh), ibuf: gbMeshIbuf(mesh: mesh),
    icount: gbMeshIcount(mesh: mesh), base: base, count: n, records: records)
}

# Context accessors for the instanced draw (#502) — opaque frame handles + the
# shared instance cursor, from the C geometry pass. See runtime_gpu3d_gbuffer.c.
func gbPass() extern("rae_gb_pass") ret Ptr
func gbStaticPipeline() extern("rae_gb_static_pipeline") ret Ptr
func gbStaticBind() extern("rae_gb_static_bind") ret Ptr
func gbDrawsBuffer() extern("rae_gb_draws_buffer") ret Ptr
func gbMaxDraws() extern("rae_gb_max_draws") ret Int
func gbDrawCount() extern("rae_gb_draw_count") ret Int
func gbAdvanceDraws(count: Int) extern("rae_gb_advance_draws")
func gbMeshReady(mesh: Int) extern("rae_gb_mesh_ready") ret Int
func gbMeshVbuf(mesh: Int) extern("rae_gb_mesh_vbuf") ret Ptr
func gbMeshIbuf(mesh: Int) extern("rae_gb_mesh_ibuf") ret Ptr
func gbMeshIcount(mesh: Int) extern("rae_gb_mesh_icount") ret Int
# Skinned-draw accessors (#503). The skin bind group (frame uniform + draws +
# joint palette) is still created lazily in C — it needs the pipeline layout and
# the palette storage buffer — but the draw itself is issued from Rae.
func gbSkinPipeline() extern("rae_gb_skin_pipeline") ret Ptr
func gbSkinBind() extern("rae_gb_skin_bind") ret Ptr
func gbSkinReady(mesh: Int) extern("rae_gb_skin_ready") ret Int
func gbSkinVbuf(mesh: Int) extern("rae_gb_skin_vbuf") ret Ptr
func gbSkinIbuf(mesh: Int) extern("rae_gb_skin_ibuf") ret Ptr
func gbSkinIcount(mesh: Int) extern("rae_gb_skin_icount") ret Int
# Skin bind group creation (#503): built in Rae from the skin pipeline's layout
# + the frame uniform, draws buffer and joint palette. The palette comes up
# asynchronously, so a readiness check defers creation until it exists.
func gbSetSkinBind(bind: Ptr) extern("rae_gb_set_skin_bind")
func gbSkinPalette() extern("rae_gb_skin_palette") ret Ptr
func gbSkinPaletteSize() extern("rae_gb_skin_palette_size") ret Int
func gbSkinPaletteReady() extern("rae_gb_skin_palette_ready") ret Int

var gSkinBindMade: Bool = false

func ensureSkinBind() {
  if gSkinBindMade { ret }
  if gbSkinPaletteReady() is 0 { ret }
  gSkinBindMade = true
  let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: gbSkinPipeline(), groupIndex: 0 as UInt32)
  var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 3)
  entries.add(value: { binding: 0 as UInt32, buffer: gbFrameUbuf(), size: gbFrameBytes() as UInt64 })
  entries.add(value: { binding: 1 as UInt32, buffer: gbDrawsBuffer(), size: gbDrawsSize() as UInt64 })
  entries.add(value: { binding: 2 as UInt32, buffer: gbSkinPalette(), size: gbSkinPaletteSize() as UInt64 })
  let desc: WGPUBindGroupDescriptor = {
    layout: layout, entryCount: 3 as UInt64, entries: entries.data
  }
  let bind: Ptr = wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc)
  wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
  gbSetSkinBind(bind: bind)
}
func drawMetaballs(packedBalls: view Buffer(Float), count: Int, packedColors: view Buffer(Float), smoothing: Float, camX: Float, camY: Float, camZ: Float, metallic: Float, roughness: Float, emR: Float, emG: Float, emB: Float) extern
func sdfShutdown() extern
# Geometry-pass finish/submit accessors (#503). The pass encoding (end/finish/
# submit) runs in Rae; C keeps the encoder handle and the frame-clear.
func gbEncoder() extern("rae_gb_encoder") ret Ptr
func gbClearFrame() extern("rae_gb_clear_frame")
func gbFrameActive() extern("rae_gb_frame_active") ret Int
func drawCount() extern ret Int
func present() extern
func shutdown() extern
func depthPyramid() extern
func pyramidMips() extern ret Int
func taa() extern
func deferredShutdown() extern

# ----- G-buffer inspector modes ---------------------------------------
# Permanent equipment, not scaffolding: when a lit image is wrong the
# first question is always WHICH attribute is wrong, and that cannot be
# answered without looking at the channels directly.
const viewLit: Int = 0       # the composed/lit image (once lighting lands)
const viewAlbedo: Int = 1
const viewNormal: Int = 2
const viewMaterial: Int = 3  # r = metallic, g = roughness, b = occlusion/emissive
const viewDepth: Int = 4     # linearised for display

# Start the geometry pass. `aspect` is width/height of the target.
#
# The view-projection is built here from value types and passed by view:
# mat4LookAt, mat4Perspective and mat4Mul all return `Mat4` by value, so
# the whole chain is stack traffic. The forward path packs an equivalent
# block into a List(Float) — one allocation per frame — which this
# deliberately does not inherit.
func beginPass(camera: view Camera3d, light: view Light3d, aspect: view Float) pub {
  let worldUp: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let viewM: Mat4 = mat4LookAt(
    eyeX: camera.position.x, eyeY: camera.position.y, eyeZ: camera.position.z,
    atX: camera.target.x, atY: camera.target.y, atZ: camera.target.z,
    upX: worldUp.x, upY: worldUp.y, upZ: worldUp.z
  )
  # Reverse-Z (#367): near maps to 1, far to 0, which is what the geometry
  # pass's Greater depth test and 0.0 clear expect. The forward frame keeps
  # mat4Perspective — the two conventions must not be mixed.
  let proj: Mat4 = mat4PerspectiveReverseZ(fovYDeg: camera.fovYDeg, aspect: aspect, near: camera.nearZ, far: camera.farZ)
  let viewProj: Mat4 = mat4Mul(a: proj, b: viewM)
  begin(viewProj: viewProj, clearR: light.clearColor.x, clearG: light.clearColor.y, clearB: light.clearColor.z)
}

# Model matrix for a typed transform: M = T * Rz * Ry * Rx * S, Euler XYZ
# radians, right-handed. Same construction as the forward path's — the two
# frames must agree about where an object IS, whatever they disagree about
# in how it is shaded.
func modelMatrixOf(t: view Transform3d) pub ret Mat4 {
  let s: Mat4 = mat4ScaleXYZ(x: t.scale.x, y: t.scale.y, z: t.scale.z)
  let rx: Mat4 = mat4RotateX(angle: t.rotation.x)
  let ry: Mat4 = mat4RotateY(angle: t.rotation.y)
  let rz: Mat4 = mat4RotateZ(angle: t.rotation.z)
  let tr: Mat4 = mat4Translate(x: t.position.x, y: t.position.y, z: t.position.z)
  let rxs: Mat4 = mat4Mul(a: rx, b: s)
  let ryrxs: Mat4 = mat4Mul(a: ry, b: rxs)
  let rot: Mat4 = mat4Mul(a: rz, b: ryrxs)
  ret mat4Mul(a: tr, b: rot)
}

# ----- instanced draw: DrawU records built in Rae (grass epic #485) --------
#
# The instanced path hands the GPU seam ready-made DrawU records, the same way
# `drawInstance` hands it a ready-made Mat4. The matrix and the G-buffer's
# packed wire format both live HERE, in Rae — C's `drawRecords` only copies and
# draws. One DrawU record is `instanceRecordFloats` floats:
#   [0..15]  model         [16..31] prevModel
#   [32..34] albedo rgb    [35] metallic
#   [36] roughness  [37] emissive-or-occlusion  [38] shading mode  [39] spare
# mirroring the C staging layout (GB_DRAW_FLOATS). Kept in one Rae place so a
# caller never touches raw offsets.
const instanceRecordFloats: Int = 40

# Shading-mode field values, mirroring GB_MODE_* in the runtime. The 2-bit
# field is stored as a Float in 0..1 so it survives the rgb10a2 target.
const gbModeLit: Float = 0.0
const gbModeEmissive: Float = 0.3333333
const gbModeToon: Float = 1.0
# Emissive is log-encoded into the 8-bit channel it shares with occlusion;
# lighting decodes with the matching constant (GB_EMISSIVE_LOG_K).
const gbEmissiveLogK: Float = 6.91

# Position + yaw + two wind-driven tilt angles + uniform scale -> a model
# matrix, as T * Rz(yaw) * Rx(tiltX) * Ry(tiltY) * S(scale). This is what the C
# `gb_sway_model` used to compute; it is plain Mat4 composition, so it belongs
# in Rae like every other transform the renderer builds.
func swayModel(x: view Float, y: view Float, z: view Float, yaw: view Float,
               tiltX: view Float, tiltY: view Float, scale: view Float) pub ret Mat4 {
  let scaleM: Mat4 = mat4Scale(s: scale)
  let ry: Mat4 = mat4RotateY(angle: tiltY)
  let rx: Mat4 = mat4RotateX(angle: tiltX)
  let rz: Mat4 = mat4RotateZ(angle: yaw)
  let tr: Mat4 = mat4Translate(x: x, y: y, z: z)
  let rys: Mat4 = mat4Mul(a: ry, b: scaleM)
  let rxrys: Mat4 = mat4Mul(a: rx, b: rys)
  let rot: Mat4 = mat4Mul(a: rz, b: rxrys)
  ret mat4Mul(a: tr, b: rot)
}

# The shared param encode both draw paths need: emissive log-encoded into the
# channel it shares with occlusion, plus the shading-mode flag. A non-emitter
# stores 1.0 there — "unoccluded", the right default until AO writes something.
func encodeEmissive(emissive: view Float, toon: view Int) ret Float {
  if toon is 1 { ret 1.0 }
  if emissive > 0.0 {
    let e: Float = math.math_log(x: 1.0 + emissive) / gbEmissiveLogK
    if e > 1.0 { ret 1.0 }
    ret e
  }
  ret 1.0
}

func encodeMode(emissive: view Float, toon: view Int) ret Float {
  if toon is 1 { ret gbModeToon }
  if emissive > 0.0 { ret gbModeEmissive }
  ret gbModeLit
}

# Pack one fully-built DrawU record into `records` at instance `slot`. Writes
# `instanceRecordFloats` floats; callers size the buffer by that constant and
# never see the layout.
func packInstanceRecord(records: mod List(Float), slot: view Int,
                        model: view Mat4, prevModel: view Mat4,
                        r: view Float, g: view Float, b: view Float,
                        metallic: view Float, roughness: view Float,
                        emissive: view Float, toon: view Int) pub {
  let base: Int = slot * instanceRecordFloats
  var i: Int = 0
  loop i < 16 {
    records.set(index: base + i, value: mat4Get(m: model, i: i))
    records.set(index: base + 16 + i, value: mat4Get(m: prevModel, i: i))
    i = i + 1
  }
  records.set(index: base + 32, value: r)
  records.set(index: base + 33, value: g)
  records.set(index: base + 34, value: b)
  records.set(index: base + 35, value: metallic)
  records.set(index: base + 36, value: roughness)
  records.set(index: base + 37, value: encodeEmissive(emissive: emissive, toon: toon))
  records.set(index: base + 38, value: encodeMode(emissive: emissive, toon: toon))
  records.set(index: base + 39, value: 0.0)
}

# Write one mesh instance's surface attributes. Note what is NOT passed:
# no light, no camera, no emission. A geometry pass that needed any of
# those would not be a geometry pass.
# `prevTransform` is where the instance was LAST frame; it drives the
# G-buffer's motion channel, which TAA reads (#390). Pass the same
# transform when an object did not move.
# Bool -> Int at the extern boundary, where Rae's Bool has no defined
# representation. One place to cross it, so both draw paths agree.
func toonFlag(material: view Material3d) ret Int {
  if material.toon {
    ret 1
  }
  ret 0
}

# Reusable one-record scratch for the single-draw paths (#503), so a static or
# skinned draw builds its DrawU entry without allocating per call — the grass
# path reuses a caller-owned List the same way. Grown to instanceRecordFloats
# once, on the first draw that actually runs (never in a headless/no-device
# build, where the readiness checks below return first). Never resized after, so
# .data stays stable.
var gDrawScratch: List(Float) = createList(Float, cap: instanceRecordFloats)

func ensureDrawScratch() {
  loop gDrawScratch.length < instanceRecordFloats {
    gDrawScratch.add(value: 0.0)
  }
}

# One static mesh instance into the G-buffer (#503, was the C `draw`). Builds the
# single DrawU record in Rae (packInstanceRecord) and issues it through the same
# Rae upload+draw path as the instanced grass — the static pipeline reads
# draws[instance_index], so one record at firstInstance=base is this draw.
func draw(mesh: copy Int, model: view Mat4, prevModel: view Mat4,
          r: copy Float, g: copy Float, b: copy Float,
          metallic: copy Float, roughness: copy Float, emissive: copy Float,
          toon: copy Int) pub {
  if gbMeshReady(mesh: mesh) is 0 { ret }
  let base: Int = gbDrawCount()
  if base >= gbMaxDraws() { ret }
  ensureDrawScratch()
  packInstanceRecord(records: gDrawScratch, slot: 0, model: model, prevModel: prevModel,
    r: r, g: g, b: b, metallic: metallic, roughness: roughness, emissive: emissive, toon: toon)
  gbIssueInstanced(pass: gbPass(), pipeline: gbStaticPipeline(), bind: gbStaticBind(),
    vbuf: gbMeshVbuf(mesh: mesh), ibuf: gbMeshIbuf(mesh: mesh),
    icount: gbMeshIcount(mesh: mesh), base: base, count: 1, records: gDrawScratch.data)
}

# One skinned mesh instance (#503, was the C `drawSkinned`). Same DrawU record
# and G-buffer layout as a static draw; only the pipeline differs (the skin
# vertex stage poses the mesh by the joint palette). After issuing, the static
# pipeline/bind are restored so a following static draw is unaffected.
func drawSkinned(mesh: copy Int, model: view Mat4, prevModel: view Mat4,
                 r: copy Float, g: copy Float, b: copy Float,
                 metallic: copy Float, roughness: copy Float, emissive: copy Float,
                 toon: copy Int) pub {
  ensureSkinBind()
  if gbSkinReady(mesh: mesh) is 0 { ret }
  let base: Int = gbDrawCount()
  if base >= gbMaxDraws() { ret }
  ensureDrawScratch()
  packInstanceRecord(records: gDrawScratch, slot: 0, model: model, prevModel: prevModel,
    r: r, g: g, b: b, metallic: metallic, roughness: roughness, emissive: emissive, toon: toon)
  gbIssueInstanced(pass: gbPass(), pipeline: gbSkinPipeline(), bind: gbSkinBind(),
    vbuf: gbSkinVbuf(mesh: mesh), ibuf: gbSkinIbuf(mesh: mesh),
    icount: gbSkinIcount(mesh: mesh), base: base, count: 1, records: gDrawScratch.data)
  # Hand the pass back to the static pipeline for any following static draw.
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: gbPass(), pipeline: gbStaticPipeline())
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: gbPass(), groupIndex: 0 as UInt32,
    group: gbStaticBind(), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
}

func drawInstance(mesh: view MeshHandle, transform: view Transform3d, prevTransform: view Transform3d, material: view Material3d) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  let model: Mat4 = modelMatrixOf(t: transform)
  let prevModel: Mat4 = modelMatrixOf(t: prevTransform)
  # Emissive is ONE scalar, not a colour: an emitter's base colour is the
  # colour it emits, so the G-buffer stores intensity and lighting tints it
  # by albedo. The brightest component is the intensity — using luminance
  # would dim a saturated single-channel emitter to near nothing.
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  draw(
    mesh: mesh.id, model: model, prevModel: prevModel,
    r: material.baseColor.x, g: material.baseColor.y, b: material.baseColor.z,
    metallic: material.metallic, roughness: material.roughness, emissive: emissive,
    toon: toonFlag(material: material)
  )
}

# Queue a SKINNED mesh (#391). Same materials and the same G-buffer
# layout as a static draw; the difference is only that the vertex stage
# poses the mesh by the joint palette first. The palette is uploaded once
# per frame by gpu3d.uploadPalette and shared by every pipeline that
# reads it.
func drawSkinnedInstance(mesh: view MeshHandle, model: view Mat4, prevModel: view Mat4,
                         material: view Material3d) pub {
  if not meshHandleIsValid(h: mesh) {
    ret
  }
  var emissive: Float = material.emission.x
  if material.emission.y > emissive {
    emissive = material.emission.y
  }
  if material.emission.z > emissive {
    emissive = material.emission.z
  }
  drawSkinned(
    mesh: mesh.id, model: model, prevModel: prevModel,
    r: material.baseColor.x, g: material.baseColor.y, b: material.baseColor.z,
    metallic: material.metallic, roughness: material.roughness, emissive: emissive,
    toon: toonFlag(material: material)
  )
}

# Fill the G-buffer from a scene's mesh components.
#
# SDF primitives now participate too (#392): the raymarch writes packed
# G-buffer attributes and frag_depth, so a metaball surface is shaded by
# the same lighting pass as every triangle and depth-tests against them.
# Metaball clusters into the G-buffer. Cluster discovery mirrors the
# forward path exactly — scan for unseen cluster ids rather than sorting,
# since a scene has a handful of clusters — because the two frames must
# group the same balls into the same surfaces or they render different
# geometry from one scene.
func renderSceneSdf(scene: view Scene3d, camera: view Camera3d) pub {
  if scene.sdfPrimitives.length is 0 {
    ret
  }
  var clusterScan: Int = 0
  loop clusterScan < scene.sdfPrimitives.length {
    let head: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: clusterScan)
    var alreadyDrawn: Bool = false
    var back: Int = 0
    loop back < clusterScan {
      let prior: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: back)
      if prior.shape is 0 {
        if prior.cluster is head.cluster { alreadyDrawn = true }
      }
      back = back + 1
    }
    if head.shape is 0 {
      if alreadyDrawn is false {
        let packed: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
        let colors: List(Float) = createList(Float, cap: scene.sdfPrimitives.length * 4)
        var ballCount: Int = 0
        var i: Int = 0
        loop i < scene.sdfPrimitives.length {
          let sdf: SdfPrimitive = sceneSdfAt(values: scene.sdfPrimitives, index: i)
          if sdf.shape is 0 {
            if sdf.cluster is head.cluster {
              let transform: Transform3d = sceneTransformAt(values: scene.transforms, index: sdf.entity)
              packed.add(value: transform.position.x)
              packed.add(value: transform.position.y)
              packed.add(value: transform.position.z)
              packed.add(value: transform.scale.x)
              let ballMaterial: Material3d = sceneMaterialAt(values: scene.materials, index: sdf.material)
              colors.add(value: ballMaterial.baseColor.x)
              colors.add(value: ballMaterial.baseColor.y)
              colors.add(value: ballMaterial.baseColor.z)
              colors.add(value: 0.0)
              ballCount = ballCount + 1
            }
          }
          i = i + 1
        }
        if ballCount > 0 {
          let material: Material3d = sceneMaterialAt(values: scene.materials, index: head.material)
          drawMetaballs(
            packedBalls: packed.data, count: ballCount,
            packedColors: colors.data, smoothing: head.smoothing,
            camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
            metallic: material.metallic, roughness: material.roughness,
            emR: material.emission.x, emG: material.emission.y, emB: material.emission.z
          )
        }
      }
    }
    clusterScan = clusterScan + 1
  }
}

func renderScene(scene: view Scene3d) pub {
  var i: Int = 0
  loop i < scene.meshRenderers.length {
    let r: MeshRenderer = sceneMeshRendererAt(values: scene.meshRenderers, index: i)
    if r.visible {
      let t: Transform3d = sceneTransformAt(values: scene.transforms, index: r.entity)
      # prevTransforms is kept in lockstep with transforms by addTransform
      # (#336), so this index is always valid.
      let pt: Transform3d = sceneTransformAt(values: scene.prevTransforms, index: r.entity)
      let m: Material3d = sceneMaterialAt(values: scene.materials, index: r.material)
      drawInstance(mesh: r.mesh, transform: t, prevTransform: pt, material: m)
    }
    i = i + 1
  }
}

# Finish and submit the geometry pass (#503, was the C `end`). Draws upload their
# own slices now (#502), so nothing bulk-uploads here — just end the render pass,
# finish the command buffer and submit it, all over the bindings. The single-
# command-buffer submit goes through gbSubmit (a thin C call) only because Rae
# cannot yet take the address of one handle; everything else is Rae.
func gbSubmit(cmd: Ptr) extern("rae_gb_submit")

func end() pub {
  if gbFrameActive() is 0 { ret }
  let pass: Ptr = gbPass()
  let enc: Ptr = gbEncoder()
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
  gbClearFrame()
}

func endPass() pub {
  end()
}

# How many instances the last pass actually submitted. Lets a caller (or a
# test) distinguish "drew nothing" from "drew and the image is wrong".
func passDrawCount() pub ret Int {
  ret drawCount()
}

func presentFrame() pub {
  present()
}

# ----- the passes that consume the G-buffer ---------------------------

# Reduce depth into a MIN mip chain. Min, not average: the question a
# pyramid answers is "is anything in this region closer than my bounding
# box", and that is the nearest depth. An averaged chain would cull
# visible geometry. Hi-Z culling and a deferred SSAO are the intended
# readers.
func buildDepthPyramid() pub {
  depthPyramid()
}

# One fullscreen evaluation of the BRDF over the whole G-buffer. This is
# the payoff of the split: the cost is per pixel, not per object-pixel, so
# it no longer matters how many objects contributed to a pixel — only that
# one of them won the depth test.
# Screen-space AO for the deferred frame (#387). Runs between the depth
# pyramid and lighting; lighting samples the result and applies it to the
# INDIRECT term only.
# ssaoPass moved to gbuffer_passes.rae (#504).

# Temporal resolve (#390). Reads the radiance lighting wrote plus last
# frame's history, reprojected through the G-buffer's motion channel;
# composite then reads the resolved image. Runs on HDR, before tonemap,
# so accumulation stays linear.
func taaPass() pub {
  taa()
}

# Light the frame from a bound SKY rather than from the light's authored
# ambient (#399).
#
# The sky is the single source of the environment: the values below are
# the ones it reports, so the ambient the scene receives and the sky it
# stands under cannot drift apart. Under SkyKind.none those values ARE
# the light's own anchors, so this is bit-identical to lightingPass and
# is the whole reason M0 can claim to change nothing.
#
# The sun still comes from Light3d. Extraction (#403) is what moves it,
# and moving it before there is anything to extract from would just mean
# copying the same numbers through a second place.

# Exposure + ACES + gamma, radiance -> the presentable target. The tone
# curve is deliberately identical to the forward frame's: the two should
# differ in how radiance is computed, not in how it is displayed, or
# comparing them proves nothing.
# compositePass moved to gbuffer_passes.rae (#504).

# Mip levels in the pyramid; 0 before the first build. Lets a caller
# confirm the chain was built rather than silently skipped.
func depthPyramidMips() pub ret Int {
  ret pyramidMips()
}

func shutdownAll() pub {
  deferredShutdown()
  shutdown()
}
