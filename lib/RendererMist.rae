# RendererMist — a height mist for the deferred renderer: denser low down,
# thinning with height, so valleys and far lowland haze over while hilltops
# and towers stand out of it. Along the view ray the mist hides what is
# behind it and adds the light it scatters toward the eye (docs/physical-
# light-units.md step 3): the light from all round (the sky's own light from
# above and the lit ground's from below; paler, and tinted) and the sun's,
# mostly forward, so it glows toward the sun. All of it in the renderer's
# light units and exposed, so the same mist looks the same under every sky,
# and the far ground meets the sky with no seam. Off by default; an
# app turns it on with setMist (defaultMistSettings is a good start: a light
# morning-ish haze, a few percent at 100 m, about a third at a kilometer near
# the base height). Distance fog (setFog) is the older, flat kind.
import Vec3
open RendererDeferred

type MistSettings {
  # The mist's density per meter at the base height (1 / meters of clear
  # view there: 0.0005 is about a third gone at a kilometer)
  density: Float
  # How fast it thins going up, per meter (0.008: halving every ~87 m)
  falloff: Float
  # The height (world z) the density is given at: the lowest ground, say
  baseHeight: Float
  # A tint on the light it scatters from all round, and how much of that
  # light's color it loses (0: the sky's and the ground's own color, 1:
  # gray of the same light); the sun's light it scatters is not tinted
  tint: Vec3
  paleness: Float
}

func defaultMistSettings() ret MistSettings {
  ret MistSettings {
    density: 0.0009
    falloff: 0.01
    baseHeight: 0.0
    tint: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
    paleness: 0.45
  }
}

func setMist(renderer: mod DeferredRenderer, mist: view MistSettings) {
  renderer.passes.targets.mistOn = true
  renderer.passes.targets.mistDensity = mist.density
  renderer.passes.targets.mistFalloff = mist.falloff
  renderer.passes.targets.mistBaseHeight = mist.baseHeight
  renderer.passes.targets.mistTint = mist.tint
  renderer.passes.targets.mistPaleness = mist.paleness
}

func setMistDisabled(renderer: mod DeferredRenderer) {
  renderer.passes.targets.mistOn = false
}

func mistIsEnabled(renderer: view DeferredRenderer) ret Bool {
  ret renderer.passes.targets.mistOn
}
