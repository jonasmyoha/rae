# A picture made small for a thumbnail (lib/ImageScale does the averaging)
open ImageScale

# `rgba` (straight alpha, width x height) made to fit `longest`
func scaledDown(
  rgba: view Buffer(UInt8)
  width: view Int
  height: view Int
  longest: view Int
) ret ThumbnailPixels {
  var scaled: ScaledPixels = scaledDownPixels(
    rgba: rgba
    width: width
    height: height
    longest: longest
  )
  ret ThumbnailPixels { width: scaled.width, height: scaled.height, bytes: own scaled.bytes }
}
