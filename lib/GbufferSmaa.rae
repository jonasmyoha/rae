# GbufferSmaa — SMAA 1x, the deferred renderer's default anti-aliasing
# (render-perf-9), at the scene resolution before the composite's upscale.
# The render graph's `antialias` step runs it, or the FXAA pass when the app
# chose FXAA (setAntialiasMode), or nothing when TAA is on. Three passes,
# recorded into the frame's post recording:
#   1. edges (smaa_edges.wgsl): luma edge detection over the lit image, into
#      an rg8 target;
#   2. weights (smaa_weights.wgsl): the blending weights of each edge from
#      the line searches and the area texture, into an rgba8 target;
#   3. blend (smaa_blend.wgsl): neighbourhood blending of the lit image, into
#      the anti-aliased target the composite reads (targets.antialiased).
# The two lookup tables are made once: the area texture by a GPU pass
# (smaa_area.wgsl, 160 x 80, the subsample-0 band SMAA 1x reads) and the
# search texture in Rae (SmaaSearchTexture.rae).
import Sys
open Gbuffer
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuArgs
open gpu/GpuIds
open gpu/GpuTextures
open GbufferResources
open GbufferTargets
open GbufferFullscreen
open GbufferPasses
open SmaaSearchTexture

const smaaAreaWidth: Int = 160

const smaaAreaHeight: Int = 80

const smaaSearchWidth: Int = 64

const smaaSearchHeight: Int = 16

# Which anti-aliasing the `antialias` step runs when TAA is off
enum AntialiasMode { smaa, fxaa }

# RAE_AA=fxaa / smaa overrides the app's choice (screenshot comparisons):
# 1 for FXAA, 0 for SMAA, -1 when unset. Read once, at creation.
func antialiasOverrideFromEnv() ret Int {
  let text: String = Sys.getEnv(name: "RAE_AA")
  if text is "fxaa" {
    ret 1
  }
  if text is "smaa" {
    ret 0
  }
  ret -1
}

# The mode the antialias step runs: the RAE_AA override, else the app's.
func effectiveAntialiasMode(cache: view SmaaPassCache) ret AntialiasMode {
  if cache.envOverride is 1 {
    ret AntialiasMode.fxaa
  }
  if cache.envOverride is 0 {
    ret AntialiasMode.smaa
  }
  ret cache.mode
}

type SmaaPassCache {
  mode: AntialiasMode
  envOverride: Int
  objectsMade: Bool
  edgesPipeline: RenderPipelineId
  weightsPipeline: RenderPipelineId
  blendPipeline: RenderPipelineId
  areaPipeline: RenderPipelineId
  # 16 B: x the exposure (edges), y the area generator's subsample offset (0)
  uniform: BufferId
  sampler: SamplerId
  args: ArgWriter
  lookupsMade: Bool
  areaTexture: TextureId
  areaView: TextureViewId
  searchTexture: TextureId
  searchView: TextureViewId
  # The scene-size targets, made for the targets of generation `targetsGen`
  edges: TextureId
  edgesView: TextureViewId
  weights: TextureId
  weightsView: TextureViewId
  targetsGen: Int
  areaBind: BindGroupId
  edgesBind: BindGroupId
  weightsBind: BindGroupId
  blendBind: BindGroupId
}

func createSmaaPassCache() ret SmaaPassCache {
  ret SmaaPassCache {
    mode: AntialiasMode.smaa
    envOverride: antialiasOverrideFromEnv()
    objectsMade: false
    edgesPipeline: noRenderPipelineId()
    weightsPipeline: noRenderPipelineId()
    blendPipeline: noRenderPipelineId()
    areaPipeline: noRenderPipelineId()
    uniform: noBufferId()
    sampler: noSamplerId()
    args: createArgs(uniform: true)
    lookupsMade: false
    areaTexture: noTextureId()
    areaView: noTextureViewId()
    searchTexture: noTextureId()
    searchView: noTextureViewId()
    edges: noTextureId()
    edgesView: noTextureViewId()
    weights: noTextureId()
    weightsView: noTextureViewId()
    targetsGen: -1
    areaBind: noBindGroupId()
    edgesBind: noBindGroupId()
    weightsBind: noBindGroupId()
    blendBind: noBindGroupId()
  }
}

func ensureSmaaObjects(
  cache: mod SmaaPassCache
  resources: mod GpuResources
  litFormat: copy Int32
) {
  if cache.objectsMade {
    ret
  }
  cache.objectsMade = true
  let edgesShader: Shader = shader(files: ["lib/smaa_edges.wgsl"])
  let weightsShader: Shader = shader(files: ["lib/smaa_weights.wgsl"])
  let blendShader: Shader = shader(files: ["lib/smaa_blend.wgsl"])
  let areaShader: Shader = shader(files: ["lib/smaa_area.wgsl"])
  cache.edgesPipeline = createFullscreenPipeline(
    resources: resources
    shader: edgesShader
    format: WGPUTextureFormat_RG8Unorm
  )
  cache.weightsPipeline = createFullscreenPipeline(
    resources: resources
    shader: weightsShader
    format: WGPUTextureFormat_RGBA8Unorm
  )
  cache.blendPipeline = createFullscreenPipeline(
    resources: resources
    shader: blendShader
    format: litFormat
  )
  cache.areaPipeline = createFullscreenPipeline(
    resources: resources
    shader: areaShader
    format: WGPUTextureFormat_RG8Unorm
  )
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: 16
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    cache.uniform = uniform
  }
  if let sampler: SamplerId = createSampler(resources: resources) {
    cache.sampler = sampler
  }
}

func smaaPipelinesValid(cache: view SmaaPassCache, resources: view GpuResources) ret Bool {
  ret isValidRenderPipeline(resources: resources, id: cache.edgesPipeline) and isValidRenderPipeline(
    resources: resources
    id: cache.weightsPipeline
  ) and isValidRenderPipeline(resources: resources, id: cache.blendPipeline) and isValidRenderPipeline(
    resources: resources
    id: cache.areaPipeline
  )
}

func smaaBind(
  resources: mod GpuResources
  pipeline: view RenderPipelineId
  entries: view List(ResourceRef)
) ret BindGroupId {
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: pipeline
    entries: entries
  ) {
    ret bind
  }
  ret noBindGroupId()
}

# The two lookup tables, once: the area texture rendered by its generator
# pass (recorded into the frame's post recording, ahead of the passes that
# read it) and the search texture uploaded from Rae.
func ensureSmaaLookups(
  cache: mod SmaaPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
) ret Bool {
  if cache.lookupsMade {
    ret true
  }
  if not makeTarget(
    resources: resources
    width: smaaAreaWidth
    height: smaaAreaHeight
    format: WGPUTextureFormat_RG8Unorm
    usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
    texture: cache.areaTexture
    textureView: cache.areaView
  ) {
    ret false
  }
  if not makeTarget(
    resources: resources
    width: smaaSearchWidth
    height: smaaSearchHeight
    format: WGPUTextureFormat_RGBA8Unorm
    usage: WGPUTextureUsage_CopyDst + WGPUTextureUsage_TextureBinding
    texture: cache.searchTexture
    textureView: cache.searchView
  ) {
    ret false
  }
  let searchBytes: List(UInt8) = smaaSearchTextureRgba()
  if not writeTexture(
    resources: resources
    texture: cache.searchTexture
    bytes: searchBytes
    bytesPerRow: smaaSearchWidth * 4
  ) {
    ret false
  }
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 1)
  entries.add(value: bufferRef(id: cache.uniform))
  cache.areaBind = smaaBind(resources: resources, pipeline: cache.areaPipeline, entries: entries)
  if not bindGroupIsUsable(resources: resources, id: cache.areaBind) {
    ret false
  }
  unsafe {
    let encoder: Ptr = postEncoder(targets: targets, resources: resources)
    runFullscreenInBatch(
      encoder: encoder
      resources: resources
      pipeline: cache.areaPipeline
      bind: cache.areaBind
      target: textureViewHandle(resources: resources, id: cache.areaView)
    )
  }
  cache.lookupsMade = true
  ret true
}

func retireSmaaTargets(cache: mod SmaaPassCache, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: cache.edgesBind)
  retireBindGroup(resources: resources, id: cache.weightsBind)
  retireBindGroup(resources: resources, id: cache.blendBind)
  cache.edgesBind = noBindGroupId()
  cache.weightsBind = noBindGroupId()
  cache.blendBind = noBindGroupId()
  retireTextureView(resources: resources, id: cache.edgesView)
  retireTexture(resources: resources, id: cache.edges)
  retireTextureView(resources: resources, id: cache.weightsView)
  retireTexture(resources: resources, id: cache.weights)
  cache.edges = noTextureId()
  cache.edgesView = noTextureViewId()
  cache.weights = noTextureId()
  cache.weightsView = noTextureViewId()
  cache.targetsGen = -1
}

# The edges and weights targets at the scene size, and the binds over them;
# made again after a resize.
func ensureSmaaTargets(
  cache: mod SmaaPassCache
  resources: mod GpuResources
  targets: view DeferredTargets
) ret Bool {
  if cache.targetsGen is targets.gen {
    ret true
  }
  retireSmaaTargets(cache: cache, resources: resources)
  let attach: UInt64 = WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
  if not makeTarget(
    resources: resources
    width: targets.width
    height: targets.height
    format: WGPUTextureFormat_RG8Unorm
    usage: attach
    texture: cache.edges
    textureView: cache.edgesView
  ) or not makeTarget(
    resources: resources
    width: targets.width
    height: targets.height
    format: WGPUTextureFormat_RGBA8Unorm
    usage: attach
    texture: cache.weights
    textureView: cache.weightsView
  ) {
    retireSmaaTargets(cache: cache, resources: resources)
    ret false
  }
  var edgesEntries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
  edgesEntries.add(value: bufferRef(id: cache.uniform))
  edgesEntries.add(value: textureViewRef(id: targets.litView))
  cache.edgesBind = smaaBind(
    resources: resources
    pipeline: cache.edgesPipeline
    entries: edgesEntries
  )
  var weightsEntries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
  weightsEntries.add(value: textureViewRef(id: cache.edgesView))
  weightsEntries.add(value: textureViewRef(id: cache.areaView))
  weightsEntries.add(value: textureViewRef(id: cache.searchView))
  weightsEntries.add(value: samplerRef(id: cache.sampler))
  cache.weightsBind = smaaBind(
    resources: resources
    pipeline: cache.weightsPipeline
    entries: weightsEntries
  )
  var blendEntries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
  blendEntries.add(value: textureViewRef(id: targets.litView))
  blendEntries.add(value: textureViewRef(id: cache.weightsView))
  blendEntries.add(value: samplerRef(id: cache.sampler))
  cache.blendBind = smaaBind(
    resources: resources
    pipeline: cache.blendPipeline
    entries: blendEntries
  )
  if not bindGroupIsUsable(resources: resources, id: cache.edgesBind) or not bindGroupIsUsable(
    resources: resources
    id: cache.weightsBind
  ) or not bindGroupIsUsable(resources: resources, id: cache.blendBind) {
    retireSmaaTargets(cache: cache, resources: resources)
    ret false
  }
  cache.targetsGen = targets.gen
  ret true
}

# The render graph's antialias step with SMAA: nothing when TAA is on.
func smaaPass(
  cache: mod SmaaPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
  gbuffer: view GbufferCache
  exposure: view Float
) {
  if targets.taaEnabled {
    ret
  }
  if not postPassReady(targets: targets, resources: resources, gbuffer: gbuffer) {
    ret
  }
  ensureSmaaObjects(cache: cache, resources: resources, litFormat: targets.litFormat)
  if not smaaPipelinesValid(cache: cache, resources: resources) {
    ret
  }
  resetArgs(writer: cache.args)
  pushVec4F(
    writer: cache.args
    x: exposure
    y: 0.0
    z: 0.0
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: cache.args
    resources: resources
    buffer: cache.uniform
    offset: 0
  )
  if not ensureSmaaLookups(cache: cache, resources: resources, targets: targets) {
    ret
  }
  if not ensureSmaaTargets(cache: cache, resources: resources, targets: targets) {
    ret
  }
  unsafe {
    let encoder: Ptr = postEncoder(targets: targets, resources: resources)
    runFullscreenInBatch(
      encoder: encoder
      resources: resources
      pipeline: cache.edgesPipeline
      bind: cache.edgesBind
      target: textureViewHandle(resources: resources, id: cache.edgesView)
    )
    runFullscreenInBatch(
      encoder: encoder
      resources: resources
      pipeline: cache.weightsPipeline
      bind: cache.weightsBind
      target: textureViewHandle(resources: resources, id: cache.weightsView)
    )
    runFullscreenInBatch(
      encoder: encoder
      resources: resources
      pipeline: cache.blendPipeline
      bind: cache.blendBind
      target: textureViewHandle(resources: resources, id: targets.antialiasedView)
    )
  }
  targets.aaWritten = true
}

func smaaPassShutdown(cache: mod SmaaPassCache, resources: mod GpuResources) {
  retireSmaaTargets(cache: cache, resources: resources)
  retireBindGroup(resources: resources, id: cache.areaBind)
  retireTextureView(resources: resources, id: cache.areaView)
  retireTexture(resources: resources, id: cache.areaTexture)
  retireTextureView(resources: resources, id: cache.searchView)
  retireTexture(resources: resources, id: cache.searchTexture)
  retireRenderPipeline(resources: resources, id: cache.edgesPipeline)
  retireRenderPipeline(resources: resources, id: cache.weightsPipeline)
  retireRenderPipeline(resources: resources, id: cache.blendPipeline)
  retireRenderPipeline(resources: resources, id: cache.areaPipeline)
  retireBuffer(resources: resources, id: cache.uniform)
  retireSampler(resources: resources, id: cache.sampler)
  let mode: AntialiasMode = cache.mode
  cache = createSmaaPassCache()
  cache.mode = mode
}
