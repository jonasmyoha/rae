# GbufferResources — the geometry pass's manager-object setup (#918 split of
# Gbuffer for the 1000-line cap; manager-owned frame since #906): the four
# G-buffer targets (createTarget / ensureTargets to the C offscreen size, the
# views borrowed by C's remaining passes), the frame + draws buffers, the
# static and skinned bind groups and the pipeline specs. Gbuffer's frame API
# calls these each begin; nothing here is app-facing.
import Math
import String
open SkyHosek
open Vec3
open Scene3d
open Sky
open Math3d
open GbufferRecord
open ecs/Entity  # #793: World3d render path reads entities/components
open ecs/ComponentTable
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds
open GbufferNative
open Gbuffer

# The G-buffer's four attachments (A, B, C, depth) and their formats.
const gbufferTargetCount: Int = 4

const gbufferTargetA: Int = 0  # rgb10a2unorm: oct(normal).xy, reserved, shading mode

const gbufferTargetB: Int = 1  # rgba8unorm: albedo.rgb, roughness

const gbufferTargetC: Int = 2  # rgba8unorm: motion.xy, metallic, occlusion-or-emissive

const gbufferTargetDepth: Int = 3  # depth32float, reverse-Z, sampleable

# The frame uniform: viewProj + prevViewProj + jitter (36 floats, #390/#397).
const gbufferFrameFloats: Int = 36

# The draws storage buffer holds this many DrawU records per frame (was C's
# GB_MAX_DRAWS); every draw path clamps to it.
const gbufferMaxDraws: Int = 4096

# The biased zero the motion channel clears to: 128/255, the one value
# rgba8unorm reproduces exactly (the decode is the paired raw*2 - 256/255).
const gbufferMotionZero: Float = 0.50196078

func gbufferTargetFormat(index: copy Int) ret Int32 {
  if index is gbufferTargetA {
    ret WGPUTextureFormat_RGB10A2Unorm
  }
  if index is gbufferTargetDepth {
    ret WGPUTextureFormat_Depth32Float
  }
  ret WGPUTextureFormat_RGBA8Unorm
}

func gbufferTargetView(cache: view GbufferCache, index: copy Int) ret TextureViewId {
  if let id: TextureViewId = cache.targetViews.copyAt(index: index) {
    ret id
  }
  ret noTextureViewId()
}

# A target view as a pass / bind-group entry.
func gbufferTargetRef(cache: view GbufferCache, index: copy Int) ret ResourceRef {
  ret textureViewRef(id: gbufferTargetView(cache: cache, index: index))
}

func gbufferTargetsReady(cache: view GbufferCache, resources: view GpuResources) ret Bool {
  loop var i: Int = 0, i < gbufferTargetCount, ++i {
    if not isValidTextureView(resources: resources, id: gbufferTargetView(cache: cache, index: i)) {
      ret false
    }
  }
  ret true
}

# One G-buffer attachment (#906: a manager texture + view): render target +
# sampleable, single mip, the manager's default 2D view.
func createTarget(
  cache: mod GbufferCache
  resources: mod GpuResources
  index: copy Int
  w: copy Int
  h: copy Int
) ret Bool {
  if let texture: TextureId = createTexture(
    resources: resources
    width: w
    height: h
    format: gbufferTargetFormat(index: index)
    usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
  ) {
    if let textureView: TextureViewId = createTextureView(resources: resources, texture: texture) {
      cache.targets.set(index: index, value: texture)
      cache.targetViews.set(index: index, value: textureView)
      ret true
    }
    retireTexture(resources: resources, id: texture)
  }
  ret false
}

# Retire the four targets (a rebuild or shutdown); the manager releases them
# once no in-flight frame uses them.
func retireTargets(cache: mod GbufferCache, resources: mod GpuResources) {
  loop var i: Int = 0, i < gbufferTargetCount, ++i {
    if let textureView: TextureViewId = cache.targetViews.copyAt(index: i) {
      retireTextureView(resources: resources, id: textureView)
    }
    if let texture: TextureId = cache.targets.copyAt(index: i) {
      retireTexture(resources: resources, id: texture)
    }
    cache.targetViews.set(index: i, value: noTextureViewId())
    cache.targets.set(index: i, value: noTextureId())
  }
  cache.targetWidth = 0
  cache.targetHeight = 0
}

# (Re)create the three colour targets + depth when the offscreen size (the
# surface at the render scale, C glue) changes; the generation bumps so every
# consumer re-fits its bind groups.
func ensureTargets(cache: mod GbufferCache, resources: mod GpuResources) {
  let w: Int = gbOffscreenW()
  let h: Int = gbOffscreenH()
  if w <= 0 or h <= 0 {
    ret
  }
  if w is cache.targetWidth and h is cache.targetHeight and gbufferTargetsReady(
    cache: cache
    resources: resources
  ) {
    ret
  }
  retireTargets(cache: cache, resources: resources)
  var made: Bool = true
  loop var i: Int = 0, i < gbufferTargetCount, ++i {
    if not createTarget(
      cache: cache
      resources: resources
      index: i
      w: w
      h: h
    ) {
      made = false
    }
  }
  if not made {
    retireTargets(cache: cache, resources: resources)
    ret
  }
  cache.targetWidth = w
  cache.targetHeight = h
  cache.targetsGen = cache.targetsGen + 1
}

# The frame uniform + draws storage buffers, created once in the manager
# (they survive resizes). Distinct flag bits, so `+` is the flag union.
func ensureGbBuffers(cache: mod GbufferCache, resources: mod GpuResources) {
  if not isValidBuffer(resources: resources, id: cache.frameUniform) {
    if let frameUniform: BufferId = createBuffer(
      resources: resources
      size: gbufferFrameFloats * 4
      usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
    ) {
      cache.frameUniform = frameUniform
    }
  }
  if not isValidBuffer(resources: resources, id: cache.draws) {
    if let draws: BufferId = createBuffer(
      resources: resources
      size: gbufferMaxDraws * instanceRecordFloats * 4
      usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
    ) {
      cache.draws = draws
    }
  }
}

# Create the static geometry bind group once (frame uniform @0, draws storage
# @1 — manager buffers, created once and surviving resizes).
func ensureStaticBind(cache: mod GbufferCache, resources: mod GpuResources) {
  if bindGroupIsUsable(resources: resources, id: cache.staticBind) {
    ret
  }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
  entries.add(value: bufferRef(id: cache.frameUniform))
  entries.add(value: bufferRef(id: cache.draws))
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.staticPipeline
    entries: entries
  ) {
    cache.staticBind = bind
  }
}

# A G-buffer pipeline from a declared shader (entry points vs / fs) — the
# manager owns it; an invalid ID comes back when creation failed. `constants`
# are the shader's `override` values for this pipeline.
func createGbufferPipeline(
  resources: mod GpuResources
  shader: view Shader
  constants: view List(ShaderConstant)
  stride: copy Int
  attributes: own List(VertexAttributeSpec)
) ret RenderPipelineId {
  if let pipeline: RenderPipelineId = createRenderPipelineWithConstants(
    resources: resources
    shader: shader
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: gbufferPipelineSpec(stride: stride, attributes: attributes)
    constants: constants
  ) {
    ret pipeline
  }
  ret noRenderPipelineId()
}

func ensurePipelines(cache: mod GbufferCache, resources: mod GpuResources) {
  if cache.pipelinesMade {
    ret
  }
  cache.pipelinesMade = true
  let noConstants: List(ShaderConstant) = noShaderConstants()
  let staticShader: Shader = shader(
    files: ["lib/gbuffer_octahedral.wgsl", "lib/gbuffer_static.wgsl"]
  )
  let skinShader: Shader = shader(
    files: ["lib/gbuffer_octahedral.wgsl", "lib/gbuffer_skinned.wgsl"]
  )
  cache.staticPipeline = createGbufferPipeline(
    resources: resources
    shader: staticShader
    constants: noConstants
    stride: 32
    attributes: gbufferStaticAttributes()
  )
  let skinAttributes: List(VertexAttributeSpec) = gbufferStaticAttributes()
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 32, location: 3 })
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 48, location: 4 })
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 64, location: 5 })
  cache.skinPipeline = createGbufferPipeline(
    resources: resources
    shader: skinShader
    constants: noConstants
    stride: 80
    attributes: skinAttributes
  )
}
