# GbufferResources — the geometry pass's manager-object setup (#918 split of
# Gbuffer for the 1000-line cap): the offscreen targets (makeTarget /
# ensureTargets over the C surface size), the frame + draws buffers, the
# static and skinned bind groups, the attachment views, the SDF prepare and
# the pipeline specs. Gbuffer's frame API calls these each begin; nothing here
# is app-facing.
import Math
import String
open SkyHosek
open Vec3
open Scene3d
open Sky
open Math3d
open GbufferRecord
open ecs/Entity          # #793: World3d render path reads entities/components
open ecs/ComponentTable
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds
open GbufferNative
open Gbuffer

# One G-buffer attachment: a 2D texture (render target + sampleable) and its
# full view. mipLevelCount/sampleCount are 1, so an explicit single-mip 2D view
# is the default view — equivalent to the null-descriptor the C path used.
func makeTarget(idx: copy Int, w: copy Int, h: copy Int, format: copy Int32) {
  unsafe {
    let td: WGPUTextureDescriptor = {
      usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding,
      dimension: WGPUTextureDimension_2D,
      size: { width: w as UInt32, height: h as UInt32, depthOrArrayLayers: 1 as UInt32 },
      format: format, mipLevelCount: 1 as UInt32, sampleCount: 1 as UInt32
    }
    let tex: Ptr = wgpuDeviceCreateTexture(device: webgpuDevice(), descriptor: td)
    let vd: WGPUTextureViewDescriptor = {
      format: format, dimension: WGPUTextureViewDimension_2D,
      baseMipLevel: 0 as UInt32, mipLevelCount: 1 as UInt32,
      baseArrayLayer: 0 as UInt32, arrayLayerCount: 1 as UInt32,
      aspect: WGPUTextureAspect_All
    }
    let texView: Ptr = wgpuTextureCreateView(texture: tex, descriptor: vd)
    gbSetTarget(idx: idx, tex: tex, texView: texView)
  }
}

# (Re)create the three colour targets + depth when the offscreen size changes.
func ensureTargets() {
  let w: Int = gbOffscreenW()
  let h: Int = gbOffscreenH()
  if w <= 0 { ret }
  if h <= 0 { ret }
  if gbTargetsMatch(w: w, h: h) is 1 { ret }
  gbReleaseTargets()
  makeTarget(idx: 0, w: w, h: h, format: WGPUTextureFormat_RGB10A2Unorm)
  makeTarget(idx: 1, w: w, h: h, format: WGPUTextureFormat_RGBA8Unorm)
  makeTarget(idx: 2, w: w, h: h, format: WGPUTextureFormat_RGBA8Unorm)
  makeTarget(idx: 3, w: w, h: h, format: WGPUTextureFormat_Depth32Float)
  gbCommitTargets(w: w, h: h)
}

func ensureGbBuffers(cache: mod GbufferCache) {
  unsafe {
    if cache.buffersMade { ret }
    cache.buffersMade = true
    let uDesc: WGPUBufferDescriptor = {
      usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst,
      size: gbFrameBytes() as UInt64
    }
    gbSetFrameUbuf(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: uDesc))
    let sDesc: WGPUBufferDescriptor = {
      usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst,
      size: gbDrawsSize() as UInt64
    }
    gbSetDrawsBuffer(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: sDesc))
  }
}

# Create the static geometry bind group once (frame uniform @0, draws storage
# @1 — both created once and surviving resizes, adopted here). Safe to call
# only after gbPrepare returned 1 and the buffers exist.
func ensureStaticBind(cache: mod GbufferCache, resources: mod GpuResources) {
  if bindGroupIsUsable(resources: resources, id: cache.staticBind) { ret }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
  unsafe {
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbFrameUbuf()))
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbDrawsBuffer()))
  }
  var made: Bool = false
  if let bind: BindGroupId = createRenderBindGroup(resources: resources, pipeline: cache.staticPipeline, entries: entries) {
    cache.staticBind = bind
    made = true
  }
  # A failed build drops this attempt's adoptions so a retry does not accumulate slots.
  if not made { releaseExternalIds(resources: resources, list: cache.adopted) }
}

# Placeholder entries carry one explicit (zeroed) field — an empty {} is not a
# valid C initializer. They are rewritten in full by begin() every frame.
func ensureGbAttachments(cache: mod GbufferCache) {
  loop cache.colorAtts.length < 3 { cache.colorAtts.add(value: { depthSlice: 0 as UInt32 }) }
  loop cache.depthAtt.length < 1 { cache.depthAtt.add(value: { depthReadOnly: 0 as UInt32 }) }
}

# A G-buffer pipeline from WGSL source (entry points vs / fs) — the manager
# owns it; an invalid ID comes back when creation failed.
func createGbufferPipeline(resources: mod GpuResources, wgsl: view String, stride: copy Int, attributes: own List(VertexAttributeSpec)) pub ret RenderPipelineId {
  if let pipeline: RenderPipelineId = createRenderPipeline(resources: resources, wgsl: wgsl, vertexEntry: "vs", fragmentEntry: "fs", spec: gbufferPipelineSpec(stride: stride, attributes: attributes)) {
    ret pipeline
  }
  ret noRenderPipelineId()
}

func ensurePipelines(cache: mod GbufferCache, resources: mod GpuResources) {
  if cache.pipelinesMade { ret }
  cache.pipelinesMade = true
  var staticSource: String = ""
  var skinSource: String = ""
  unsafe {
    staticSource = String.fromCStr(s: gbWgsl())
    skinSource = String.fromCStr(s: gbSkinWgsl())
  }
  cache.staticPipeline = createGbufferPipeline(resources: resources, wgsl: staticSource, stride: 32, attributes: gbufferStaticAttributes())
  let skinAttributes: List(VertexAttributeSpec) = gbufferStaticAttributes()
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 32, location: 3 })
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 48, location: 4 })
  skinAttributes.add(value: { format: WGPUVertexFormat_Float32x4, offset: 64, location: 5 })
  cache.skinPipeline = createGbufferPipeline(resources: resources, wgsl: skinSource, stride: 80, attributes: skinAttributes)
}

func ensureSkinBind(cache: mod GbufferCache, resources: mod GpuResources) {
  if bindGroupIsUsable(resources: resources, id: cache.skinBind) { ret }
  if gbSkinPaletteReady() is 0 { ret }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
  unsafe {
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbFrameUbuf()))
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbDrawsBuffer()))
    entries.add(value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbSkinPalette()))
  }
  var made: Bool = false
  if let bind: BindGroupId = createRenderBindGroup(resources: resources, pipeline: cache.skinPipeline, entries: entries) {
    cache.skinBind = bind
    made = true
  }
  if not made { releaseExternalIds(resources: resources, list: cache.adopted) }
}
