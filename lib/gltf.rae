# gltf — glTF 2.0 binary (.glb) loading.
#
# Increment 1 of the skinning work (#356's last acceptance item): the
# CONTAINER and the accessor machinery. Skins, palettes and animation
# build on this and land separately, because a loader that cannot be
# trusted to read a buffer correctly is not a foundation to put skinning
# on top of.
#
# WHY .glb AND NOT .gltf. The binary container keeps the JSON and every
# buffer in one file, so loading is one read with no relative-path
# resolution and no base64 data URIs. It is also what every exporter emits
# by default.
#
# LAYOUT. A 12-byte header (magic "glTF", version, total length) followed
# by chunks, each an 8-byte header (length, type) plus payload:
#
#   chunk 0  type 0x4E4F534A  "JSON"  the glTF document
#   chunk 1  type 0x004E4942  "BIN "  the buffer every accessor indexes
#
# The spec allows further chunks and requires readers to skip unknown
# ones, which is why this walks the chunk list rather than assuming two.
#
# ACCESSORS. Vertex data is reached through three levels: an accessor says
# "N elements of this type and component type, at this offset into a
# bufferView"; the bufferView says "this byte range of a buffer, with this
# stride"; the buffer is the BIN chunk. The indirection exists so several
# attributes can interleave in one range, so the stride must be honoured
# rather than assuming elements are packed.
#
# ENDIANNESS. glTF is little-endian everywhere. The readers below are
# explicit about that instead of relying on the host, because a silent
# byte-order assumption is the kind of thing that works on every machine
# anyone tests on and then does not.
import core
import json
import sys
import math
import mesh3d
import math3d
import quat
open json
open mesh3d
open math3d
open quat

const glbMagic: Int = 1179937895      # "glTF" little-endian
const chunkJson: Int = 1313821514     # "JSON"
const chunkBin: Int = 5130562         # "BIN\0"

# glTF component types, from the spec's enum.
const compByte: Int = 5120
const compUByte: Int = 5121
const compShort: Int = 5122
const compUShort: Int = 5123
const compUInt: Int = 5125
const compFloat: Int = 5126

type Glb {
  ok: Bool
  errorMsg: String
  # The JSON chunk, already parsed. Callers walk it with lib/json.
  doc: JsonDoc
  # Byte offset of the BIN chunk payload within `bytes`, and its length.
  binOffset: Int
  binLength: Int
  bytes: List(Int)
}

# A failed load still has to return a whole Glb, so `doc` needs SOME valid
# document. `null` is the cheapest one; an empty object cannot be written
# here anyway, since a literal brace pair starts string interpolation.
# Callers branch on `ok`, never on the contents of `doc`.
func glbFailed(msg: view String) ret Glb {
  ret Glb {
    ok: false,
    errorMsg: "{msg}",
    doc: parseJson(source: "null"),
    binOffset: 0, binLength: 0, bytes: createList(Int, cap: 0)
  }
}

# ----- little-endian scalar readers -----------------------------------

func readU32(b: view List(Int), pos: view Int) pub ret Int {
  ret b.at(index: pos)
    bitor (b.at(index: pos + 1) shl 8)
    bitor (b.at(index: pos + 2) shl 16)
    bitor (b.at(index: pos + 3) shl 24)
}

func readU16(b: view List(Int), pos: view Int) pub ret Int {
  ret b.at(index: pos) bitor (b.at(index: pos + 1) shl 8)
}

# IEEE-754 binary32 from four bytes.
#
# Rae has no bit-cast between Int and Float, so this reconstructs the value
# arithmetically: sign, exponent and mantissa are extracted and recombined
# with a power of two. Denormals and the exponent-0 case are handled
# explicitly — a mesh with a legitimately tiny coordinate would otherwise
# come back as garbage rather than as a small number.
func readF32(b: view List(Int), pos: view Int) pub ret Float {
  let bits: Int = readU32(b: b, pos: pos)
  let sign: Int = (bits shr 31) bitand 1
  let exponent: Int = (bits shr 23) bitand 255
  let mantissa: Int = bits bitand 8388607
  var value: Float = 0.0
  if exponent is 0 {
    # Denormal (or zero): no implicit leading 1, fixed exponent of -126.
    value = mantissa.toFloat() / 8388608.0 * math.pow(base: 2.0, exp: 0.0 - 126.0)
  } else {
    if exponent is 255 {
      # Inf/NaN. A mesh containing either is broken; report zero rather
      # than propagate a value that poisons every matrix it touches.
      value = 0.0
    } else {
      let frac: Float = 1.0 + mantissa.toFloat() / 8388608.0
      value = frac * math.pow(base: 2.0, exp: (exponent - 127).toFloat())
    }
  }
  if sign is 1 {
    value = 0.0 - value
  }
  ret value
}

# ----- container ------------------------------------------------------

# Parse a .glb: validate the header, locate the JSON and BIN chunks, and
# parse the JSON. The BIN chunk is NOT copied — accessors index into
# `bytes` at `binOffset`, so a 500 KB model costs one read.
func loadGlb(path: view String) pub ret Glb {
  let bytes: List(Int) = sys.readFileBytes(path: path)
  if bytes.length < 12 {
    ret glbFailed(msg: "not a glb: fewer than 12 bytes at {path}")
  }
  if readU32(b: bytes, pos: 0) is not glbMagic {
    ret glbFailed(msg: "not a glb: bad magic in {path}")
  }
  let version: Int = readU32(b: bytes, pos: 4)
  if version is not 2 {
    ret glbFailed(msg: "unsupported glb version {version} in {path}")
  }
  let total: Int = readU32(b: bytes, pos: 8)
  if total > bytes.length {
    ret glbFailed(msg: "truncated glb: header says {total} bytes, file has {bytes.length}")
  }

  var jsonStart: Int = 0
  var jsonLen: Int = 0
  var binStart: Int = 0
  var binLen: Int = 0
  # Walk the chunk list rather than assuming JSON-then-BIN. The spec
  # permits extra chunks and requires unknown ones to be skipped, and a
  # reader that assumes the order breaks on the first exporter that adds
  # one.
  var pos: Int = 12
  loop pos + 8 <= total {
    let clen: Int = readU32(b: bytes, pos: pos)
    let ctype: Int = readU32(b: bytes, pos: pos + 4)
    let payload: Int = pos + 8
    if payload + clen > total {
      ret glbFailed(msg: "truncated chunk at byte {pos} in {path}")
    }
    if ctype is chunkJson {
      jsonStart = payload
      jsonLen = clen
    }
    if ctype is chunkBin {
      binStart = payload
      binLen = clen
    }
    # Chunks are 4-byte aligned; the padding is inside the declared length
    # for JSON (spaces) and BIN (zeros), so no extra rounding is needed.
    pos = payload + clen
  }
  if jsonLen is 0 {
    ret glbFailed(msg: "glb has no JSON chunk: {path}")
  }

  # The JSON chunk is read back from the file as text rather than rebuilt
  # from `bytes`: Rae's String indexes codepoints, so assembling one byte
  # at a time would be both quadratic and wrong for any non-ASCII string
  # inside the document (node names routinely are).
  let text: String = sys.readFileTextRange(path: path, offset: jsonStart, len: jsonLen)
  let doc: JsonDoc = parseJson(source: text)
  if doc.ok is false {
    ret glbFailed(msg: "glb JSON chunk did not parse: {path}")
  }

  ret Glb {
    ok: true, errorMsg: "", doc: own doc,
    binOffset: binStart, binLength: binLen, bytes: own bytes
  }
}

# ----- JSON convenience ------------------------------------------------
# glTF documents are deeply nested, so reaching "the byteOffset of the
# bufferView of the accessor of an attribute" is four lookups. These keep
# the accessor code readable instead of a wall of valueAt(jsonField(...)).

func objField(g: view Glb, obj: view JsonValue, key: view String) ret JsonValue {
  ret valueAt(doc: g.doc, idx: jsonField(doc: g.doc, this: obj, key: key))
}

# Missing numeric fields are COMMON and legal in glTF — byteOffset,
# byteStride and normalized are all optional with defined defaults — so a
# missing key returns the fallback rather than being an error.
func intField(g: view Glb, obj: view JsonValue, key: view String, fallback: view Int) ret Int {
  let idx: Int = jsonField(doc: g.doc, this: obj, key: key)
  if idx < 0 {
    ret fallback
  }
  ret jsonInt(this: valueAt(doc: g.doc, idx: idx), fallback: fallback)
}

func arrayField(g: view Glb, obj: view JsonValue, key: view String) ret JsonValue {
  ret objField(g: g, obj: obj, key: key)
}

# ----- accessors -------------------------------------------------------

# Bytes per component, from the glTF component-type enum.
func componentSize(componentType: view Int) ret Int {
  if componentType is compByte { ret 1 }
  if componentType is compUByte { ret 1 }
  if componentType is compShort { ret 2 }
  if componentType is compUShort { ret 2 }
  ret 4
}

# Components per element, from the accessor's `type` string.
func typeComponents(t: view String) ret Int {
  if t.equals(other: "SCALAR") { ret 1 }
  if t.equals(other: "VEC2") { ret 2 }
  if t.equals(other: "VEC3") { ret 3 }
  if t.equals(other: "VEC4") { ret 4 }
  if t.equals(other: "MAT4") { ret 16 }
  ret 0
}

type Accessor {
  ok: Bool
  count: Int
  components: Int
  componentType: Int
  # Absolute byte offset of element 0 within Glb.bytes, and the byte step
  # from one element to the next.
  start: Int
  stride: Int
}

# Resolve accessor -> bufferView -> BIN chunk into flat byte arithmetic.
#
# The three-level indirection exists so several attributes can share one
# interleaved range, which is why byteStride is honoured rather than
# assuming elements are packed end to end. When the bufferView omits it
# the elements ARE packed and the stride is the element size.
func accessorAt(g: view Glb, index: view Int) pub ret Accessor {
  let root: JsonValue = jsonRoot(doc: g.doc)
  let accessors: JsonValue = arrayField(g: g, obj: root, key: "accessors")
  if index < 0 or index >= jsonArrayLen(this: accessors) {
    ret Accessor { ok: false, count: 0, components: 0, componentType: 0, start: 0, stride: 0 }
  }
  let acc: JsonValue = jsonArrayAt(doc: g.doc, this: accessors, idx: index)
  let typeName: String = jsonString(this: objField(g: g, obj: acc, key: "type"), fallback: "")
  let comps: Int = typeComponents(t: typeName)
  let compType: Int = intField(g: g, obj: acc, key: "componentType", fallback: 0)
  let count: Int = intField(g: g, obj: acc, key: "count", fallback: 0)
  if comps is 0 or count is 0 {
    ret Accessor { ok: false, count: 0, components: 0, componentType: 0, start: 0, stride: 0 }
  }
  let elemSize: Int = comps * componentSize(componentType: compType)

  let bvIndex: Int = intField(g: g, obj: acc, key: "bufferView", fallback: 0 - 1)
  if bvIndex < 0 {
    # A bufferView-less accessor is legal and means "all zeros" (used for
    # sparse bases). Report it as empty rather than reading from offset 0,
    # which would silently return whatever the previous attribute holds.
    ret Accessor { ok: false, count: 0, components: 0, componentType: 0, start: 0, stride: 0 }
  }
  let views: JsonValue = arrayField(g: g, obj: root, key: "bufferViews")
  let bv: JsonValue = jsonArrayAt(doc: g.doc, this: views, idx: bvIndex)
  let bvOffset: Int = intField(g: g, obj: bv, key: "byteOffset", fallback: 0)
  var stride: Int = intField(g: g, obj: bv, key: "byteStride", fallback: 0)
  if stride is 0 {
    stride = elemSize
  }
  let accOffset: Int = intField(g: g, obj: acc, key: "byteOffset", fallback: 0)
  ret Accessor {
    ok: true, count: count, components: comps, componentType: compType,
    start: g.binOffset + bvOffset + accOffset, stride: stride
  }
}

# Read a float accessor as a flat list, `components` values per element.
# Integer component types are normalised to [0,1] the way the spec says,
# which is what WEIGHTS_0 stored as ubyte needs.
func readFloats(g: view Glb, index: view Int) pub ret List(Float) {
  let a: Accessor = accessorAt(g: g, index: index)
  let out: List(Float) = createList(Float, cap: a.count * a.components)
  if a.ok is false {
    ret own out
  }
  let compSize: Int = componentSize(componentType: a.componentType)
  var e: Int = 0
  loop e < a.count {
    var c: Int = 0
    loop c < a.components {
      let at: Int = a.start + e * a.stride + c * compSize
      if a.componentType is compFloat {
        out.add(value: readF32(b: g.bytes, pos: at))
      } else {
        if a.componentType is compUByte {
          out.add(value: g.bytes.at(index: at).toFloat() / 255.0)
        } else {
          if a.componentType is compUShort {
            out.add(value: readU16(b: g.bytes, pos: at).toFloat() / 65535.0)
          } else {
            out.add(value: 0.0)
          }
        }
      }
      c = c + 1
    }
    e = e + 1
  }
  ret own out
}

# Read an integer accessor as a flat list. Indices are ushort or uint in
# practice; joint indices are ubyte or ushort.
func readInts(g: view Glb, index: view Int) pub ret List(Int) {
  let a: Accessor = accessorAt(g: g, index: index)
  let out: List(Int) = createList(Int, cap: a.count * a.components)
  if a.ok is false {
    ret own out
  }
  let compSize: Int = componentSize(componentType: a.componentType)
  var e: Int = 0
  loop e < a.count {
    var c: Int = 0
    loop c < a.components {
      let at: Int = a.start + e * a.stride + c * compSize
      if a.componentType is compUByte {
        out.add(value: g.bytes.at(index: at))
      } else {
        if a.componentType is compUShort {
          out.add(value: readU16(b: g.bytes, pos: at))
        } else {
          out.add(value: readU32(b: g.bytes, pos: at))
        }
      }
      c = c + 1
    }
    e = e + 1
  }
  ret own out
}

# ----- mesh ------------------------------------------------------------

# Load one primitive as a `mesh3d.MeshData`: interleaved pos3/nrm3/uv2 per
# vertex plus a triangle index list, which is the layout gpu3d uploads.
#
# A primitive missing NORMAL or TEXCOORD_0 is legal glTF; both are filled
# with defaults rather than refused, so a model exported without UVs still
# renders instead of failing to load. A missing POSITION is not
# recoverable and returns an empty mesh.
func loadPrimitive(g: view Glb, meshIndex: view Int, primIndex: view Int) pub ret MeshData {
  let root: JsonValue = jsonRoot(doc: g.doc)
  let meshes: JsonValue = arrayField(g: g, obj: root, key: "meshes")
  let mesh: JsonValue = jsonArrayAt(doc: g.doc, this: meshes, idx: meshIndex)
  let prims: JsonValue = arrayField(g: g, obj: mesh, key: "primitives")
  let prim: JsonValue = jsonArrayAt(doc: g.doc, this: prims, idx: primIndex)
  let attrs: JsonValue = objField(g: g, obj: prim, key: "attributes")

  let posAcc: Int = intField(g: g, obj: attrs, key: "POSITION", fallback: 0 - 1)
  let nrmAcc: Int = intField(g: g, obj: attrs, key: "NORMAL", fallback: 0 - 1)
  let uvAcc: Int = intField(g: g, obj: attrs, key: "TEXCOORD_0", fallback: 0 - 1)
  let idxAcc: Int = intField(g: g, obj: prim, key: "indices", fallback: 0 - 1)

  let verts: List(Float) = createList(Float, cap: 0)
  let indices: List(Int) = createList(Int, cap: 0)
  if posAcc < 0 {
    ret MeshData { verts: own verts, indices: own indices, vertCount: 0 }
  }

  let pos: List(Float) = readFloats(g: g, index: posAcc)
  let vertCount: Int = pos.length / 3
  var nrm: List(Float) = readFloats(g: g, index: nrmAcc)
  let uv: List(Float) = readFloats(g: g, index: uvAcc)
  var hasNrm: Bool = nrm.length >= vertCount * 3
  let hasUv: Bool = uv.length >= vertCount * 2

  # Read the index list up front: flat-normal generation below needs to
  # know which vertices share a face, and a non-indexed primitive is just
  # the identity index list.
  let tri: List(Int) = createList(Int, cap: vertCount)
  if idxAcc >= 0 {
    let src: List(Int) = readInts(g: g, index: idxAcc)
    var k: Int = 0
    loop k < src.length {
      tri.add(value: src.at(index: k))
      k = k + 1
    }
  } else {
    var k: Int = 0
    loop k < vertCount {
      tri.add(value: k)
      k = k + 1
    }
  }

  # NORMAL is OPTIONAL in glTF, and the spec says a client must then
  # compute FLAT face normals — not pick a constant. Real exports rely on
  # this (the Khronos Fox sample ships no normals at all), and defaulting
  # to a fixed +Z instead lights every face identically, which reads as a
  # flat silhouette rather than as a missing attribute.
  #
  # Flat, not smoothed: the spec is explicit, and averaging across shared
  # vertices would round off hard edges the artist may have meant. Each
  # triangle writes its own geometric normal to its three corners; where
  # vertices are shared the last triangle wins, which is the accepted cost
  # of flat shading an indexed mesh.
  if hasNrm is false {
    nrm = createList(Float, cap: vertCount * 3)
    var z: Int = 0
    loop z < vertCount * 3 {
      nrm.add(value: 0.0)
      z = z + 1
    }
    var f: Int = 0
    loop f + 2 < tri.length {
      let i0: Int = tri.at(index: f)
      let i1: Int = tri.at(index: f + 1)
      let i2: Int = tri.at(index: f + 2)
      let ax: Float = pos.at(index: i1 * 3) - pos.at(index: i0 * 3)
      let ay: Float = pos.at(index: i1 * 3 + 1) - pos.at(index: i0 * 3 + 1)
      let az: Float = pos.at(index: i1 * 3 + 2) - pos.at(index: i0 * 3 + 2)
      let bx: Float = pos.at(index: i2 * 3) - pos.at(index: i0 * 3)
      let by: Float = pos.at(index: i2 * 3 + 1) - pos.at(index: i0 * 3 + 1)
      let bz: Float = pos.at(index: i2 * 3 + 2) - pos.at(index: i0 * 3 + 2)
      var cx: Float = ay * bz - az * by
      var cy: Float = az * bx - ax * bz
      var cz: Float = ax * by - ay * bx
      let len: Float = math.sqrt(x: cx * cx + cy * cy + cz * cz)
      # A degenerate triangle has no normal to give. Leave its corners at
      # zero rather than dividing by it; a neighbouring face will usually
      # overwrite them, and a zero normal is at least obviously wrong
      # rather than a NaN that propagates through the whole lighting pass.
      if len > 0.0 {
        cx = cx / len
        cy = cy / len
        cz = cz / len
        var c: Int = 0
        loop c < 3 {
          let vi: Int = tri.at(index: f + c)
          nrm.set(index: vi * 3, value: cx)
          nrm.set(index: vi * 3 + 1, value: cy)
          nrm.set(index: vi * 3 + 2, value: cz)
          c = c + 1
        }
      }
      f = f + 3
    }
    hasNrm = true
  }

  var i: Int = 0
  loop i < vertCount {
    var nx: Float = 0.0
    var ny: Float = 0.0
    var nz: Float = 1.0
    if hasNrm {
      nx = nrm.at(index: i * 3)
      ny = nrm.at(index: i * 3 + 1)
      nz = nrm.at(index: i * 3 + 2)
    }
    var u: Float = 0.0
    var v: Float = 0.0
    if hasUv {
      u = uv.at(index: i * 2)
      v = uv.at(index: i * 2 + 1)
    }
    pushVert(
      verts: verts,
      px: pos.at(index: i * 3), py: pos.at(index: i * 3 + 1), pz: pos.at(index: i * 3 + 2),
      nx: nx, ny: ny, nz: nz, u: u, v: v
    )
    i = i + 1
  }

  # `tri` was already resolved above (indexed or the identity list for a
  # non-indexed primitive), so there is one upload path rather than two.
  var k: Int = 0
  loop k < tri.length {
    indices.add(value: tri.at(index: k))
    k = k + 1
  }
  ret MeshData { verts: own verts, indices: own indices, vertCount: vertCount }
}

# ----- whole-model loading ---------------------------------------------

# Load EVERY primitive of every mesh, merged into one MeshData.
#
# A character is rarely one primitive. glTF splits geometry per material,
# and a clothed figure routinely arrives as ten meshes and a dozen
# primitives; `loadPrimitive` would render one of them and silently drop
# the rest, which looks like a broken import rather than a partial one.
#
# Merging means index REBASING: each primitive's indices are local to its
# own vertex array, so they shift by the running vertex total as the
# arrays are concatenated. Getting that wrong draws triangles between
# unrelated body parts, which is unmistakable and is why it is worth
# stating.
#
# MATERIALS ARE DROPPED. The merge produces one buffer, so the per-
# primitive material assignment cannot survive it; every primitive renders
# with whatever material the caller supplies. That is the right trade for
# displaying a model, and the wrong one for shading it properly — when
# per-material draws matter, the split has to be preserved instead.
#
# NODE TRANSFORMS ARE IGNORED, correctly: glTF specifies that a SKINNED
# mesh is posed entirely by its skin, and its node's transform must not be
# applied. For an unskinned model this would need the node hierarchy
# walked instead.
func loadAllPrimitives(g: view Glb) pub ret MeshData {
  let verts: List(Float) = createList(Float, cap: 0)
  let indices: List(Int) = createList(Int, cap: 0)
  var total: Int = 0
  if g.ok is false {
    ret MeshData { verts: own verts, indices: own indices, vertCount: 0 }
  }
  let root: JsonValue = jsonRoot(doc: g.doc)
  let meshes: JsonValue = arrayField(g: g, obj: root, key: "meshes")
  let meshCount: Int = jsonArrayLen(this: meshes)
  var m: Int = 0
  loop m < meshCount {
    let mesh: JsonValue = jsonArrayAt(doc: g.doc, this: meshes, idx: m)
    let prims: JsonValue = arrayField(g: g, obj: mesh, key: "primitives")
    let primCount: Int = jsonArrayLen(this: prims)
    var p: Int = 0
    loop p < primCount {
      let part: MeshData = loadPrimitive(g: g, meshIndex: m, primIndex: p)
      var i: Int = 0
      loop i < part.verts.length {
        verts.add(value: part.verts.at(index: i))
        i = i + 1
      }
      var k: Int = 0
      loop k < part.indices.length {
        indices.add(value: part.indices.at(index: k) + total)
        k = k + 1
      }
      total = total + part.vertCount
      p = p + 1
    }
    m = m + 1
  }
  ret MeshData { verts: own verts, indices: own indices, vertCount: total }
}

# Axis-aligned bounds of a loaded mesh, as six Floats:
# [minX, minY, minZ, maxX, maxY, maxZ].
#
# Exporters place a model wherever it happened to sit in the authoring
# scene — this walker sits ~13 units above its own origin — so a caller
# that assumes models are centred on the origin puts them off-screen. This
# lets an example FRAME whatever it loaded instead of hard-coding an
# offset that is right for exactly one file.
func meshBounds(m: view MeshData) pub ret List(Float) {
  let out: List(Float) = createList(Float, cap: 6)
  if m.vertCount is 0 {
    var z: Int = 0
    loop z < 6 {
      out.add(value: 0.0)
      z = z + 1
    }
    ret own out
  }
  var minX: Float = m.verts.at(index: 0)
  var minY: Float = m.verts.at(index: 1)
  var minZ: Float = m.verts.at(index: 2)
  var maxX: Float = minX
  var maxY: Float = minY
  var maxZ: Float = minZ
  var i: Int = 0
  loop i < m.vertCount {
    # Stride is 8: pos3, nrm3, uv2.
    let x: Float = m.verts.at(index: i * 8)
    let y: Float = m.verts.at(index: i * 8 + 1)
    let z: Float = m.verts.at(index: i * 8 + 2)
    if x < minX { minX = x }
    if y < minY { minY = y }
    if z < minZ { minZ = z }
    if x > maxX { maxX = x }
    if y > maxY { maxY = y }
    if z > maxZ { maxZ = z }
    i = i + 1
  }
  out.add(value: minX)
  out.add(value: minY)
  out.add(value: minZ)
  out.add(value: maxX)
  out.add(value: maxY)
  out.add(value: maxZ)
  ret own out
}

# ----- per-primitive access --------------------------------------------
# `loadAllPrimitives` merges everything into one buffer and therefore
# cannot keep per-primitive materials. These let a caller walk the
# primitives itself and give each one its own material, which is what
# colouring a multi-part character requires.

func meshCount(g: view Glb) pub ret Int {
  if g.ok is false {
    ret 0
  }
  ret jsonArrayLen(this: arrayField(g: g, obj: jsonRoot(doc: g.doc), key: "meshes"))
}

func primitiveCount(g: view Glb, meshIndex: view Int) pub ret Int {
  if g.ok is false {
    ret 0
  }
  let meshes: JsonValue = arrayField(g: g, obj: jsonRoot(doc: g.doc), key: "meshes")
  if meshIndex < 0 or meshIndex >= jsonArrayLen(this: meshes) {
    ret 0
  }
  let mesh: JsonValue = jsonArrayAt(doc: g.doc, this: meshes, idx: meshIndex)
  ret jsonArrayLen(this: arrayField(g: g, obj: mesh, key: "primitives"))
}

# The mesh's authored name, which is how a caller tells one part of a
# character from another. Exporters carry the modelling-tool object names
# through — "flicka.006", "Cylinder.001" — so a name is the only handle on
# WHICH part a primitive belongs to when the materials say nothing.
func meshName(g: view Glb, meshIndex: view Int) pub ret String {
  if g.ok is false {
    ret ""
  }
  let meshes: JsonValue = arrayField(g: g, obj: jsonRoot(doc: g.doc), key: "meshes")
  if meshIndex < 0 or meshIndex >= jsonArrayLen(this: meshes) {
    ret ""
  }
  let mesh: JsonValue = jsonArrayAt(doc: g.doc, this: meshes, idx: meshIndex)
  ret jsonString(this: objField(g: g, obj: mesh, key: "name"), fallback: "")
}

# ----- skinned primitives (#374) ---------------------------------------

# A primitive with its skinning attributes, ready for the skinned GPU
# pipeline. 16 Floats per vertex:
#
#   [0..2]   position
#   [3..5]   normal
#   [6..7]   uv
#   [8..11]  joint indices  (as Floats; see below)
#   [12..15] joint weights
#
# SEPARATE FROM MeshData ON PURPOSE. The static layout is 8 Floats and is
# hardcoded in mesh3d, in gpu3d's vertex layout and in the WGSL. Widening
# it would ripple through every mesh generator and every 3D example, and
# would make a ground plane carry 32 bytes per vertex of joint data it can
# never read. Skinned and static geometry are different enough to deserve
# different buffers.
#
# JOINT INDICES TRAVEL AS FLOATS. glTF stores them as unsigned bytes or
# shorts and the shader wants integers, but the vertex path here is
# float-only, so they are widened on load and cast back in the shader.
# Exact for every index a 24-bit float mantissa can hold, which is every
# skeleton anyone will build.
type SkinnedMeshData {
  verts: List(Float)
  indices: List(Int)
  vertCount: Int
}

func loadSkinnedPrimitive(g: view Glb, meshIndex: view Int, primIndex: view Int) pub ret SkinnedMeshData {
  let verts: List(Float) = createList(Float, cap: 0)
  let indices: List(Int) = createList(Int, cap: 0)
  if g.ok is false {
    ret SkinnedMeshData { verts: own verts, indices: own indices, vertCount: 0 }
  }
  let root: JsonValue = jsonRoot(doc: g.doc)
  let meshes: JsonValue = arrayField(g: g, obj: root, key: "meshes")
  let mesh: JsonValue = jsonArrayAt(doc: g.doc, this: meshes, idx: meshIndex)
  let prims: JsonValue = arrayField(g: g, obj: mesh, key: "primitives")
  let prim: JsonValue = jsonArrayAt(doc: g.doc, this: prims, idx: primIndex)
  let attrs: JsonValue = objField(g: g, obj: prim, key: "attributes")

  # Geometry comes from the existing loader so the two paths cannot
  # disagree about positions, generated normals or index rebasing.
  let base: MeshData = loadPrimitive(g: g, meshIndex: meshIndex, primIndex: primIndex)
  if base.vertCount is 0 {
    ret SkinnedMeshData { verts: own verts, indices: own indices, vertCount: 0 }
  }

  let jointAcc: Int = intField(g: g, obj: attrs, key: "JOINTS_0", fallback: 0 - 1)
  let weightAcc: Int = intField(g: g, obj: attrs, key: "WEIGHTS_0", fallback: 0 - 1)
  # readInts, not readFloats: joint indices are INDICES, and readFloats
  # normalises unsigned integer types to [0,1], which would turn joint 37
  # into 0.145 and silently bind every vertex to joint 0.
  let joints: List(Int) = readInts(g: g, index: jointAcc)
  let weights: List(Float) = readFloats(g: g, index: weightAcc)
  let hasSkin: Bool = joints.length >= base.vertCount * 4 and weights.length >= base.vertCount * 4

  var i: Int = 0
  loop i < base.vertCount {
    var c: Int = 0
    loop c < 8 {
      verts.add(value: base.verts.at(index: i * 8 + c))
      c = c + 1
    }
    if hasSkin {
      var k: Int = 0
      loop k < 4 {
        verts.add(value: joints.at(index: i * 4 + k).toFloat())
        k = k + 1
      }
      # Renormalise: glTF requires the four weights to sum to 1, but
      # quantised exports drift, and an un-normalised set scales the whole
      # vertex toward or away from the origin instead of merely posing it.
      var sum: Float = 0.0
      var w: Int = 0
      loop w < 4 {
        sum = sum + weights.at(index: i * 4 + w)
        w = w + 1
      }
      if sum <= 0.0 {
        sum = 1.0
      }
      w = 0
      loop w < 4 {
        verts.add(value: weights.at(index: i * 4 + w) / sum)
        w = w + 1
      }
    } else {
      # Unskinned primitive inside a skinned model — props parented to a
      # bone rather than weighted. Bind it rigidly to joint 0 with full
      # weight, which is what "follows the root" means in palette terms.
      verts.add(value: 0.0)
      verts.add(value: 0.0)
      verts.add(value: 0.0)
      verts.add(value: 0.0)
      verts.add(value: 1.0)
      verts.add(value: 0.0)
      verts.add(value: 0.0)
      verts.add(value: 0.0)
    }
    i = i + 1
  }
  var k2: Int = 0
  loop k2 < base.indices.length {
    indices.add(value: base.indices.at(index: k2))
    k2 = k2 + 1
  }
  ret SkinnedMeshData { verts: own verts, indices: own indices, vertCount: base.vertCount }
}

# ----- skeleton and joint palette (#375) -------------------------------

# A skin's skeleton, flattened for per-frame palette evaluation.
#
# `jointNodes` maps palette slot -> node index, which is the order the
# vertex JOINTS_0 attribute indexes. `parent` is node -> parent node (-1
# for a root), derived by inverting the children lists, because glTF
# stores the hierarchy downward and posing needs it upward.
#
# Local transforms are kept as TRS rather than composed matrices so an
# animation can overwrite one channel without disturbing the others —
# a clip that animates only rotation must leave translation alone.
type Skeleton {
  ok: Bool
  jointNodes: List(Int)
  # 16 Floats per joint, column-major, as glTF stores them.
  inverseBind: List(Float)
  nodeCount: Int
  parent: List(Int)
  # Per NODE (not per joint): 3, 4 and 3 Floats respectively.
  localT: List(Float)
  localR: List(Float)
  localS: List(Float)
}

func emptySkeleton() ret Skeleton {
  ret Skeleton {
    ok: false, jointNodes: createList(Int, cap: 0), inverseBind: createList(Float, cap: 0),
    nodeCount: 0, parent: createList(Int, cap: 0),
    localT: createList(Float, cap: 0), localR: createList(Float, cap: 0),
    localS: createList(Float, cap: 0)
  }
}

func loadSkeleton(g: view Glb, skinIndex: view Int) pub ret Skeleton {
  if g.ok is false {
    ret emptySkeleton()
  }
  let root: JsonValue = jsonRoot(doc: g.doc)
  let skins: JsonValue = arrayField(g: g, obj: root, key: "skins")
  if skinIndex < 0 or skinIndex >= jsonArrayLen(this: skins) {
    ret emptySkeleton()
  }
  let skin: JsonValue = jsonArrayAt(doc: g.doc, this: skins, idx: skinIndex)
  let jointsArr: JsonValue = arrayField(g: g, obj: skin, key: "joints")
  let jointCount: Int = jsonArrayLen(this: jointsArr)
  let jointNodes: List(Int) = createList(Int, cap: jointCount)
  var i: Int = 0
  loop i < jointCount {
    jointNodes.add(value: jsonInt(this: jsonArrayAt(doc: g.doc, this: jointsArr, idx: i), fallback: 0))
    i = i + 1
  }
  let ibmAcc: Int = intField(g: g, obj: skin, key: "inverseBindMatrices", fallback: 0 - 1)
  let inverseBind: List(Float) = readFloats(g: g, index: ibmAcc)

  let nodes: JsonValue = arrayField(g: g, obj: root, key: "nodes")
  let nodeCount: Int = jsonArrayLen(this: nodes)
  let parent: List(Int) = createList(Int, cap: nodeCount)
  let localT: List(Float) = createList(Float, cap: nodeCount * 3)
  let localR: List(Float) = createList(Float, cap: nodeCount * 4)
  let localS: List(Float) = createList(Float, cap: nodeCount * 3)
  var n: Int = 0
  loop n < nodeCount {
    parent.add(value: 0 - 1)
    # Defaults are the glTF-specified ones, applied per CHANNEL: a node
    # with only a rotation still has unit scale and no translation, and
    # zeroing the lot would collapse the skeleton to a point.
    localT.add(value: 0.0)
    localT.add(value: 0.0)
    localT.add(value: 0.0)
    localR.add(value: 0.0)
    localR.add(value: 0.0)
    localR.add(value: 0.0)
    localR.add(value: 1.0)
    localS.add(value: 1.0)
    localS.add(value: 1.0)
    localS.add(value: 1.0)
    n = n + 1
  }
  n = 0
  loop n < nodeCount {
    let node: JsonValue = jsonArrayAt(doc: g.doc, this: nodes, idx: n)
    let tIdx: Int = jsonField(doc: g.doc, this: node, key: "translation")
    if tIdx >= 0 {
      let tv: JsonValue = valueAt(doc: g.doc, idx: tIdx)
      var c: Int = 0
      loop c < 3 {
        localT.set(index: n * 3 + c, value: jsonFloat(this: jsonArrayAt(doc: g.doc, this: tv, idx: c), fallback: 0.0))
        c = c + 1
      }
    }
    let rIdx: Int = jsonField(doc: g.doc, this: node, key: "rotation")
    if rIdx >= 0 {
      let rv: JsonValue = valueAt(doc: g.doc, idx: rIdx)
      var c: Int = 0
      loop c < 4 {
        localR.set(index: n * 4 + c, value: jsonFloat(this: jsonArrayAt(doc: g.doc, this: rv, idx: c), fallback: 0.0))
        c = c + 1
      }
    }
    let sIdx: Int = jsonField(doc: g.doc, this: node, key: "scale")
    if sIdx >= 0 {
      let sv: JsonValue = valueAt(doc: g.doc, idx: sIdx)
      var c: Int = 0
      loop c < 3 {
        localS.set(index: n * 3 + c, value: jsonFloat(this: jsonArrayAt(doc: g.doc, this: sv, idx: c), fallback: 1.0))
        c = c + 1
      }
    }
    # Invert the children list into a parent map.
    let cIdx: Int = jsonField(doc: g.doc, this: node, key: "children")
    if cIdx >= 0 {
      let cv: JsonValue = valueAt(doc: g.doc, idx: cIdx)
      var k: Int = 0
      loop k < jsonArrayLen(this: cv) {
        let child: Int = jsonInt(this: jsonArrayAt(doc: g.doc, this: cv, idx: k), fallback: 0 - 1)
        if child >= 0 and child < nodeCount {
          parent.set(index: child, value: n)
        }
        k = k + 1
      }
    }
    n = n + 1
  }
  ret Skeleton {
    ok: true, jointNodes: own jointNodes, inverseBind: own inverseBind,
    nodeCount: nodeCount, parent: own parent,
    localT: own localT, localR: own localR, localS: own localS
  }
}

# A node's local transform, composed T * R * S.
#
# That order is the spec's, and it is not interchangeable: scaling after
# rotating shears the result, and translating before rotating swings the
# node around the parent's origin instead of its own.
func nodeLocalMatrix(sk: view Skeleton, node: view Int) ret Mat4 {
  let t: Mat4 = mat4Translate(
    x: sk.localT.at(index: node * 3),
    y: sk.localT.at(index: node * 3 + 1),
    z: sk.localT.at(index: node * 3 + 2)
  )
  let q: Quat = quat.create(
    x: sk.localR.at(index: node * 4),
    y: sk.localR.at(index: node * 4 + 1),
    z: sk.localR.at(index: node * 4 + 2),
    w: sk.localR.at(index: node * 4 + 3)
  )
  let r: Mat4 = quat.toMat4(q: q)
  let s: Mat4 = mat4ScaleXYZ(
    x: sk.localS.at(index: node * 3),
    y: sk.localS.at(index: node * 3 + 1),
    z: sk.localS.at(index: node * 3 + 2)
  )
  ret mat4Mul(a: t, b: mat4Mul(a: r, b: s))
}

# A node's world transform: every local transform from the root down.
#
# Walks UP to collect the chain, then multiplies DOWN. Multiplying while
# walking up would compose the transforms in reverse, which produces a
# skeleton that is subtly inside-out rather than obviously broken.
func nodeWorldMatrix(sk: view Skeleton, node: view Int) ret Mat4 {
  let chain: List(Int) = createList(Int, cap: 16)
  var cur: Int = node
  # The guard is against a malformed file whose parent links form a cycle;
  # without it a bad export hangs the frame instead of rendering wrong.
  var guard: Int = 0
  loop cur >= 0 and guard < sk.nodeCount + 1 {
    chain.add(value: cur)
    cur = sk.parent.at(index: cur)
    guard = guard + 1
  }
  var m: Mat4 = mat4Identity()
  var i: Int = chain.length - 1
  loop i >= 0 {
    m = mat4Mul(a: m, b: nodeLocalMatrix(sk: sk, node: chain.at(index: i)))
    i = i - 1
  }
  ret m
}

# Build the GPU joint palette: 12 Floats per joint, three vec4 rows.
#
#     palette[j] = worldMatrix(joint j) * inverseBind[j]
#
# The inverse bind takes a vertex from model space into the joint's local
# space; the world matrix puts it back wherever that joint now is. Only
# three rows are stored because a joint transform is affine and its fourth
# row is always (0,0,0,1) — this is the Mat3x4 saving #354 exists for.
func buildPalette(sk: view Skeleton) pub ret List(Float) {
  let out: List(Float) = createList(Float, cap: sk.jointNodes.length * 12)
  if sk.ok is false {
    ret own out
  }
  var j: Int = 0
  loop j < sk.jointNodes.length {
    let world: Mat4 = nodeWorldMatrix(sk: sk, node: sk.jointNodes.at(index: j))
    var ib: Mat4 = mat4Identity()
    if sk.inverseBind.length >= (j + 1) * 16 {
      var c: Int = 0
      loop c < 16 {
        ib.m[c] = sk.inverseBind.at(index: j * 16 + c)
        c = c + 1
      }
    }
    let m: Mat4 = mat4Mul(a: world, b: ib)
    # Column-major storage, so row r is elements r, r+4, r+8, r+12.
    var r: Int = 0
    loop r < 3 {
      out.add(value: m.m[r])
      out.add(value: m.m[r + 4])
      out.add(value: m.m[r + 8])
      out.add(value: m.m[r + 12])
      r = r + 1
    }
    j = j + 1
  }
  ret own out
}

func jointCount(sk: view Skeleton) pub ret Int {
  ret sk.jointNodes.length
}
