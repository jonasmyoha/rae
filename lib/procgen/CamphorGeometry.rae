# Smooth paths and rounded silhouette leaves for the old evergreen generator.
open procgen/Foliage
open Vec3
open Mesh3d
import Math

func camphorCurve(
  previous: view Vec3
  start: view Vec3
  end: view Vec3
  next: view Vec3
  fraction: view Float
) ret Vec3 {
  let squared: Float = fraction * fraction
  let cubed: Float = squared * fraction
  ret vadd(
    a: vadd(
      a: vscale(a: previous, s: (-fraction + 2.0 * squared - cubed) * 0.5)
      b: vscale(a: start, s: (2.0 - 5.0 * squared + 3.0 * cubed) * 0.5)
    )
    b: vadd(
      a: vscale(a: end, s: (fraction + 4.0 * squared - 3.0 * cubed) * 0.5)
      b: vscale(a: next, s: (-squared + cubed) * 0.5)
    )
  )
}

func camphorTube(
  mesh: mod MeshData
  points: view List(Vec3)
  radii: view List(Float)
  sides: view Int
) {
  if points.length < 2 {
    ret
  }
  var smoothPoints: List(Vec3) = List.create(Vec3, cap: points.length * 4)
  var smoothRadii: List(Float) = List.create(Float, cap: points.length * 4)
  loop var segment: Int = 0, segment < points.length - 1, ++segment {
    let start: Vec3 = points.copyAtDefault(index: segment)
    let end: Vec3 = points.copyAtDefault(index: segment + 1)
    let previous: Vec3 = points.copyAtFallback(index: segment - 1, fallback: start)
    let next: Vec3 = points.copyAtFallback(index: segment + 2, fallback: end)
    let radius: Float = radii.copyAtDefault(index: segment)
    let endRadius: Float = radii.copyAtDefault(index: segment + 1)
    loop var step: Int = 0, step < 4, ++step {
      let fraction: Float = step.toFloat() / 4
      smoothPoints.add(value: camphorCurve(
        previous: previous
        start: start
        end: end
        next: next
        fraction: fraction
      ))
      smoothRadii.add(value: radius + (endRadius - radius) * fraction)
    }
  }
  smoothPoints.add(value: points.copyAtDefault(index: points.length - 1))
  smoothRadii.add(value: radii.copyAtDefault(index: radii.length - 1))
  foliageTube(
    mesh: mesh
    points: smoothPoints
    radii: smoothRadii
    sides: sides
  )
}

# Tangent-plane leaves avoid the long sideways spikes of tilted flat cards.
func camphorLeaf(
  mesh: mod MeshData
  center: view Vec3
  normal: view Vec3
  size: view Float
  angle: view Float
) {
  let side: Vec3 = foliageBasis(direction: normal)
  let across: Vec3 = vcross(a: normal, b: side)
  let base: Int = mesh.vertCount
  loop var corner: Int = 0, corner < 8, ++corner {
    let phase: Float = corner.toFloat() * 6.2831853 / 8 + angle
    let point: Vec3 = vadd(
      a: center
      b: vadd(
        a: vscale(a: side, s: Math.cos(x: phase) * size)
        b: vscale(a: across, s: Math.sin(x: phase) * size * 0.8)
      )
    )
    foliageVertex(mesh: mesh, point: point, normal: normal)
  }
  loop var corner: Int = 1, corner < 7, ++corner {
    mesh.indices.add(value: base)
    mesh.indices.add(value: base + corner)
    mesh.indices.add(value: base + corner + 1)
    mesh.indices.add(value: base)
    mesh.indices.add(value: base + corner + 1)
    mesh.indices.add(value: base + corner)
  }
}

# Moss follows upward-facing root surfaces; no separate floating clumps.
func camphorMoss(wood: view MeshData) ret MeshData {
  var mesh: MeshData = foliageMesh()
  loop var triangle: Int = 0, triangle < wood.indices.length / 3, ++triangle {
    let vertexIndex: Int = wood.indices.copyAtDefault(index: triangle * 3) * 8
    let x: Float = wood.verts.copyAtDefault(index: vertexIndex)
    let y: Float = wood.verts.copyAtDefault(index: vertexIndex + 1)
    let z: Float = wood.verts.copyAtDefault(index: vertexIndex + 2)
    let upward: Float = wood.verts.copyAtDefault(index: vertexIndex + 5)
    if z < 0 or z > 3.5 or upward < 0.45 or Math.sin(x: x * 0.9 + y * 0.7) < -0.15 {
      continue
    }
    loop var corner: Int = 0, corner < 3, ++corner {
      let source: Int = wood.indices.copyAtDefault(index: triangle * 3 + corner) * 8
      let point: Vec3 = Vec3.create(
        x: wood.verts.copyAtDefault(index: source)
        y: wood.verts.copyAtDefault(index: source + 1)
        z: wood.verts.copyAtDefault(index: source + 2)
      )
      let normal: Vec3 = Vec3.create(
        x: wood.verts.copyAtDefault(index: source + 3)
        y: wood.verts.copyAtDefault(index: source + 4)
        z: wood.verts.copyAtDefault(index: source + 5)
      )
      mesh.indices.add(value: mesh.vertCount)
      foliageVertex(
        mesh: mesh
        point: vadd(a: point, b: vscale(a: normal, s: 0.025))
        normal: normal
      )
    }
  }
  ret mesh
}
