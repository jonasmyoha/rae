# Fine-edge camera-facing foliage. Depth comes from card centers distributed
# along and across the supporting twig. Lighting follows the crown envelope,
# independent of the camera; branch pivots remain fixed during wind motion.
open Vec3
open Noise
open Mesh3d
open procgen/Foliage

func foliageSprayFlexibility(seed: view Int) ret Float {
  ret -(0.80 + hash2(x: seed, y: 7, seed: 29) * 0.40)
}

func addFoliageCard(
  mesh: mod MeshData
  center: view Vec3
  pivot: view Vec3
  halfWidth: view Float
  halfHeight: view Float
  shadeNormal: view Vec3
  mirrored: view Bool
  flexibility: view Float
) {
  let base: Int = mesh.vertCount
  loop var row: Int = 0, row < 2, ++row {
    loop var column: Int = 0, column < 2, ++column {
      let x: Float = (column.toFloat() * 2.0 - 1.0) * halfWidth
      let z: Float = (row.toFloat() * 2.0 - 1.0) * halfHeight
      let position: Vec3 = Vec3.create(x: center.x + x, y: center.y, z: center.z + z)
      var textureColumn: Float = column.toFloat()
      if mirrored {
        textureColumn = 1.0 - textureColumn
      }
      pushVert(
        verts: mesh.verts
        px: position.x
        py: position.y
        pz: position.z
        nx: shadeNormal.x
        ny: shadeNormal.y
        nz: shadeNormal.z
        u: textureColumn
        value: 1.0 - row.toFloat()
      )
      mesh.windPivots.add(value: pivot.x)
      mesh.windPivots.add(value: pivot.y)
      mesh.windPivots.add(value: pivot.z)
      mesh.windPivots.add(value: flexibility)
      mesh.leafCards.add(value: center.x)
      mesh.leafCards.add(value: center.y)
      mesh.leafCards.add(value: center.z)
      mesh.leafCards.add(value: 1.0)
      mesh.vertCount = mesh.vertCount + 1
    }
  }
  mesh.indices.add(value: base)
  mesh.indices.add(value: base + 1)
  mesh.indices.add(value: base + 2)
  mesh.indices.add(value: base + 1)
  mesh.indices.add(value: base + 3)
  mesh.indices.add(value: base + 2)
}

# Overlapping unequal cards form a connected spray with small edge leaves.
# Centers stay in world geometry; only the quads turn towards the viewer.
func addFoliageSpray(
  mesh: mod MeshData
  center: view Vec3
  pivot: view Vec3
  branchDirection: view Vec3
  extent: view Vec3
  shadeNormal: view Vec3
  seed: view Int
) {
  let patchCount: Int = 4 + (seed % 2 + 2) % 2
  let flexibility: Float = foliageSprayFlexibility(seed: seed)
  let direction: Vec3 = vnorm(a: branchDirection)
  let branchSide: Vec3 = foliageBasis(direction: direction)
  loop var patch: Int = 0, patch < patchCount, ++patch {
    let along: Float = patch.toFloat() / (patchCount - 1).toFloat() * 2.0 - 1.0
    let sideAmount: Float = (hash2(x: patch, y: 3, seed: seed) - 0.5) * extent.y * 1.25
    let lift: Float = (hash2(x: patch, y: 4, seed: seed) - 0.5) * extent.z * 0.22
    let offset: Vec3 = vadd(
      a: vscale(a: direction, s: along * extent.z * 0.38)
      b: vadd(a: vscale(a: branchSide, s: sideAmount), b: Vec3.create(x: 0, y: 0, z: lift))
    )
    let clusterCenter: Vec3 = vadd(a: center, b: offset)
    let halfWidth: Float = extent.x * (0.68 + hash2(x: patch, y: 1, seed: seed) * 0.16)
    let halfHeight: Float = extent.z * (0.54 + hash2(x: patch, y: 2, seed: seed) * 0.14)
    let normal: Vec3 = vnorm(a: vadd(a: shadeNormal, b: vscale(a: offset, s: 0.16)))
    let mirrored: Bool = hash2(x: patch, y: 6, seed: seed) > 0.5
    addFoliageCard(
      mesh: mesh
      center: clusterCenter
      pivot: pivot
      halfWidth: halfWidth
      halfHeight: halfHeight
      shadeNormal: normal
      mirrored: mirrored
      flexibility: flexibility
    )
  }
}

# Explicit comparison modes keep the same supporting twigs and wind anchors.
enum FoliageSprayStyle { control, texture, connected }

func addConnectedFoliageSpray(
  mesh: mod MeshData
  center: view Vec3
  pivot: view Vec3
  branchDirection: view Vec3
  extent: view Vec3
  shadeNormal: view Vec3
  seed: view Int
) {
  let direction: Vec3 = vnorm(a: branchDirection)
  let sideways: Vec3 = foliageBasis(direction: direction)
  let flexibility: Float = foliageSprayFlexibility(seed: seed)
  # Fewer, longer overlapping layers follow the supporting spray. A broad
  # interior connects them; smaller trailing layers break its silhouette.
  loop var layer: Int = 0, layer < 3, ++layer {
    let fraction: Float = layer.toFloat() * 0.5
    let offset: Vec3 = vadd(
      a: vscale(a: direction, s: (fraction - 0.45) * extent.z * 0.85)
      b: vscale(a: sideways, s: (hash2(x: layer, y: 3, seed: seed) - 0.5) * extent.y * 0.8)
    )
    let size: Float = 1.0 - fraction * 0.18
    let firstVertex: Int = mesh.vertCount
    addFoliageCard(
      mesh: mesh
      center: vadd(a: center, b: offset)
      pivot: pivot
      halfWidth: extent.x * size * 1.05
      halfHeight: extent.z * size * 0.90
      shadeNormal: shadeNormal
      mirrored: hash2(x: layer, y: 6, seed: seed) > 0.5
      flexibility: flexibility
    )
    # Smooth the large crown envelope, not individual leaf-face normals.
    # This stays attached to the tree while the alpha plane faces the camera.
    loop var corner: Int = 0, corner < 4, ++corner {
      let horizontal: Float = ((corner % 2).toFloat() * 2.0 - 1.0) * extent.x * 0.20
      let vertical: Float = ((corner / 2).toFloat() * 2.0 - 1.0) * extent.z * 0.22
      let normal: Vec3 = vnorm(
        a: vadd(a: shadeNormal, b: Vec3.create(x: horizontal, y: 0, z: vertical))
      )
      let vertexOffset: Int = (firstVertex + corner) * 8
      mesh.verts.set(index: vertexOffset + 3, value: normal.x)
      mesh.verts.set(index: vertexOffset + 4, value: normal.y)
      mesh.verts.set(index: vertexOffset + 5, value: normal.z)
    }
  }
}
