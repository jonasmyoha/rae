# Continuous scalloped branch skirts, rather than overlapping leaf patches.
# Each tier has a smooth lit upper surface and a closed underside for shadows.
import Math
open Vec3
open Mesh3d
open Noise
open procgen/Foliage

func spruceTier(
  mesh: mod MeshData
  tier: view Int
  sides: view Int
  seed: view Int
) {
  let fraction: Float = tier.toFloat() / 6
  # A skirt of fewer sides is a polygon inside the same circle, smaller; widen
  # it to the circle's area, so a coarser level of detail covers what the
  # full one does (docs/tree-lod-design.md §2.1)
  let roundness: Float = Math.sqrt(
    x: 3.1415927 / (sides.toFloat() * 0.5 * Math.sin(x: 6.2831853 / sides.toFloat()))
  )
  let width: Float = 0.28 * (1.0 - fraction * 0.88) * roundness
  let level: Float = 0.19 + tier.toFloat() * 0.12
  let turn: Float = tier.toFloat() * 0.61
  let first: Int = mesh.vertCount
  loop var ring: Int = 0, ring < 3, ++ring {
    var radius: Float = width
    var rise: Float = 0
    if ring is 0 {
      radius = width * 0.05
      rise = 0.20
    }
    if ring is 1 {
      radius = width * 0.62
      rise = 0.065
    }
    loop var i: Int = 0, i < sides, ++i {
      let angle: Float = i.toFloat() * 6.2831853 / sides.toFloat() + turn
      let ripple: Float = 0.94 + Math.sin(x: angle * 5 + tier.toFloat()) * 0.06
      let irregularity: Float = hash2(x: i, y: tier, seed: seed) * 0.015
      let normal: Vec3 = vnorm(
        a: Vec3.create(x: Math.cos(x: angle) * 0.65, y: Math.sin(x: angle) * 0.65, z: 0.85)
      )
      foliageVertex(
        mesh: mesh
        point: Vec3.create(
          x: Math.cos(x: angle) * radius * ripple
          y: Math.sin(x: angle) * radius * ripple
          z: level + rise + irregularity
        )
        normal: normal
      )
    }
  }
  let top: Int = mesh.vertCount
  foliageVertex(
    mesh: mesh
    point: Vec3.create(x: 0, y: 0, z: level + 0.205)
    normal: Vec3.create(x: 0, y: 0, z: 1)
  )
  let bottom: Int = mesh.vertCount
  foliageVertex(
    mesh: mesh
    point: Vec3.create(x: 0, y: 0, z: level + 0.02)
    normal: Vec3.create(x: 0, y: 0, z: -1)
  )
  loop var i: Int = 0, i < sides, ++i {
    let next: Int = (i + 1) % sides
    mesh.indices.add(value: top)
    mesh.indices.add(value: first + i)
    mesh.indices.add(value: first + next)
    mesh.indices.add(value: bottom)
    mesh.indices.add(value: first + 2 * sides + next)
    mesh.indices.add(value: first + 2 * sides + i)
    loop var ring: Int = 0, ring < 2, ++ring {
      let upper: Int = first + ring * sides
      let lower: Int = upper + sides
      mesh.indices.add(value: upper + i)
      mesh.indices.add(value: lower + i)
      mesh.indices.add(value: lower + next)
      mesh.indices.add(value: upper + i)
      mesh.indices.add(value: lower + next)
      mesh.indices.add(value: upper + next)
    }
  }
}

func spruceLeaves(seed: view Int, detail: view Int, tone: view Int) ret MeshData {
  var mesh: MeshData = foliageMesh()
  var sides: Int = detail / 2
  if sides < 6 {
    sides = 6
  }
  loop var tier: Int = 0, tier < 6, ++tier {
    if tier % 3 is tone {
      spruceTier(
        mesh: mesh
        tier: tier
        sides: sides
        seed: seed
      )
    }
  }
  ret mesh
}
