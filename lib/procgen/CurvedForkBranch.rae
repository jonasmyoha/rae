# A welded branch tube whose transported ring order follows the parent opening.
open Vec3
open Mesh3d
open procgen/Foliage
open procgen/SculpturalFork

func curvedForkJoinedBranch(
  mesh: mod MeshData
  opening: view ForkOpening
  path: view ForkPath
) ret Float {
  let sides: Int = 6
  let center: Vec3 = forkOpeningCenter(mesh: mesh, opening: opening)
  var side: Vec3 = vsub(a: forkPoint(mesh: mesh, index: opening.boundary0), b: center)
  let tangent: Vec3 = foliageTangentAt(points: path.points, index: 0)
  side = vsub(a: side, b: vscale(a: tangent, s: vdot(a: side, b: tangent)))
  if vdot(a: side, b: side) < 0.0001 {
    side = foliageBasis(direction: tangent)
  } else {
    side = vnorm(a: side)
  }
  # Carry the opening's angular coordinates along the whole branch. Replacing
  # the first irregular hexagon with an unrelated regular ring twists the neck.
  let initialAcross: Vec3 = vnorm(a: vcross(a: tangent, b: side))
  var directions: List(Vec3) = List.create(Vec3, cap: sides)
  loop var corner: Int = 0, corner < sides, ++corner {
    let offset: Vec3 = vsub(
      a: forkPoint(mesh: mesh, index: forkOpeningIndex(opening: opening, index: corner))
      b: center
    )
    directions.add(
      value: vnorm(
        a: Vec3.create(x: vdot(a: offset, b: side), y: vdot(a: offset, b: initialAcross), z: 0)
      )
    )
  }
  let first: Int = mesh.vertCount
  var minimumNormalDot: Float = 1
  var distance: Float = 0
  loop var ring: Int = 0, ring < path.points.length, ++ring {
    if ring > 0 {
      distance = distance + forkDistance(
        a: path.points.copyAtDefault(index: ring - 1)
        b: path.points.copyAtDefault(index: ring)
      )
    }
    let frame: ForkFrame = forkFrame(points: path.points, index: ring, previousSide: side)
    side = frame.side
    let branchCenter: Vec3 = path.points.copyAtDefault(index: ring)
    let radius: Float = path.radii.copyAtDefault(index: ring)
    loop var sideIndex: Int = 0, sideIndex < sides, ++sideIndex {
      let direction: Vec3 = directions.copyAtDefault(index: sideIndex)
      let radial: Vec3 = vadd(
        a: vscale(a: frame.side, s: direction.x)
        b: vscale(a: frame.across, s: direction.y)
      )
      let normal: Vec3 = radial
      forkVertex(
        mesh: mesh
        point: vadd(a: branchCenter, b: vscale(a: radial, s: radius))
        normal: normal
        u: sideIndex.toFloat() / sides.toFloat()
        v: distance
      )
    }
  }
  loop var sideIndex: Int = 0, sideIndex < sides, ++sideIndex {
    let next: Int = (sideIndex + 1) % sides
    let base: Int = forkOpeningIndex(opening: opening, index: sideIndex)
    let baseNext: Int = forkOpeningIndex(opening: opening, index: next)
    let ring: Int = first + sideIndex
    let ringNext: Int = first + next
    let normalDot: Float = vdot(
      a: forkNormal(mesh: mesh, index: base)
      b: forkNormal(mesh: mesh, index: ring)
    )
    if normalDot < minimumNormalDot {
      minimumNormalDot = normalDot
    }
    mesh.indices.add(value: base)
    mesh.indices.add(value: baseNext)
    mesh.indices.add(value: ring)
    mesh.indices.add(value: ring)
    mesh.indices.add(value: baseNext)
    mesh.indices.add(value: ringNext)
  }
  loop var ring: Int = 0, ring < path.points.length - 1, ++ring {
    loop var sideIndex: Int = 0, sideIndex < sides, ++sideIndex {
      let lower: Int = first + ring * sides + sideIndex
      let lowerNext: Int = first + ring * sides + (sideIndex + 1) % sides
      let upper: Int = lower + sides
      let upperNext: Int = lowerNext + sides
      mesh.indices.add(value: lower)
      mesh.indices.add(value: lowerNext)
      mesh.indices.add(value: upper)
      mesh.indices.add(value: upper)
      mesh.indices.add(value: lowerNext)
      mesh.indices.add(value: upperNext)
    }
  }
  forkCap(
    mesh: mesh
    ringFirst: first + (path.points.length - 1) * sides
    sides: sides
    center: path.points.copyAtDefault(index: path.points.length - 1)
    normal: foliageTangentAt(points: path.points, index: path.points.length - 1)
    v: distance
  )
  ret minimumNormalDot
}
