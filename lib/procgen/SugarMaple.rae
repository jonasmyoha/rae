# Acer saccharum, autumn-orange preset. Ascending joined axes carry opposite
# lateral sprays in a spreading oval. Coordinates are metres, Z is up.
import Math
open Noise
open Vec3
open Mesh3d
open procgen/Foliage
open procgen/FoliageCards
open procgen/SculpturalFork
open procgen/CurvedFork
open procgen/CurvedForkBranch
open procgen/ForkSurface
open procgen/Birch

# Conservative rotating-card envelope, including normal wind, at width 2 m.
const sugarMapleRadiusScale: Float = 0.75

type SugarMapleTree {
  wood: MeshData
  sprays: List(BirchTwig)
  height: Float
  width: Float
}

func sugarMapleTree(seed: view Int, height: view Float, width: view Float) ret SugarMapleTree {
  let turn: Float = hash2(x: seed, y: 11, seed: 641) * 6.2831853
  let lean: Vec3 = {
    x: Math.cos(x: turn) * width * 0.13
    y: Math.sin(x: turn) * width * 0.13
    z: 0
  }
  let controls: List(Vec3) = {
    { x: 0, y: 0, z: -height * 0.035 }
    { x: -lean.x * 0.2, y: -lean.y * 0.2, z: height * 0.12 }
    { x: lean.x * 0.2, y: lean.y * 0.4, z: height * 0.30 }
    { x: lean.x * 0.8, y: lean.y * 0.6, z: height * 0.49 }
    { x: lean.x * 1.9, y: lean.y * 0.8, z: height * 0.72 }
    { x: lean.x * 2.5, y: lean.y * 1.6, z: height * 0.93 }
  }
  let radii: List(Float) = {
    height * 0.064
    height * 0.043
    height * 0.035
    height * 0.026
    height * 0.014
    height * 0.003
  }
  let leader: ForkPath = forkSmoothPath(controls: controls, radii: radii, steps: 3)
  var cage: MeshData = foliageMesh()
  let side: Int = (seed % 12 + 12) % 12
  let openings: List(ForkOpening) = forkTrunk(
    mesh: cage
    path: leader
    sides: 12
    seed: seed
    firstOpeningRing: 5
    firstOpeningSide: side
    secondOpeningRing: 8
    secondOpeningSide: (side + 5) % 12
    openingCount: 2
  )
  forkCap(
    mesh: cage
    ringFirst: 0
    sides: 12
    center: controls.copyAtDefault(index: 0)
    normal: Vec3.create(x: 0, y: 0, z: -1)
    v: 0
  )
  var axes: List(ForkPath) = List.create(ForkPath, cap: 3)
  axes.add(value: leader)
  loop var branch: Int = 0, branch < 2, ++branch {
    let opening: ForkOpening = openings.copyAtDefault(index: branch)
    let normal: Vec3 = forkOpeningNormal(mesh: cage, opening: opening)
    let radius: Float = height * (0.025 - branch.toFloat() * 0.006)
    let path: ForkPath = curvedForkLimb(
      start: vadd(
        a: forkOpeningCenter(mesh: cage, opening: opening)
        b: vscale(a: normal, s: radius * 0.8)
      )
      outward: normal
      length: width * (0.65 - branch.toFloat() * 0.13 + hash2(x: branch, y: 21, seed: seed) * 0.10)
      rise: height * (0.46 - branch.toFloat() * 0.07)
      radius: radius
      sweep: (hash2(x: branch, y: 22, seed: seed) - 0.5) * 0.55
    )
    curvedForkJoinedBranch(mesh: cage, opening: opening, path: path)
    axes.add(value: path)
  }
  loop let opening: ForkOpening in openings {
    relaxForkJunction(
      mesh: cage
      center: forkOpeningCenter(mesh: cage, opening: opening)
      radius: height * 0.075
    )
  }
  var wood: MeshData = subdivideForkSurface(mesh: cage)
  finishForkSurface(mesh: wood)
  wood = compactForkSurface(mesh: wood)
  var sprays: List(BirchTwig) = List.create(BirchTwig, cap: 42)
  loop var axis: Int = 0, axis < axes.length, ++axis {
    let path: ForkPath = axes.copyAtDefault(index: axis)
    loop var tier: Int = 0, tier < 7, ++tier {
      let fraction: Float = 0.42 + tier.toFloat() * 0.085
      var along: Float = fraction
      if axis is 0 {
        along = 0.58 + tier.toFloat() * 0.06
      }
      let start: Vec3 = birchPathPoint(path: path, amount: along)
      loop var pair: Int = 0, pair < 2, ++pair {
        # Open lower sectors reveal the primary crotches without hollowing
        # the whole crown into a shell. Opposite shoots are unequal in length.
        if tier is 0 and pair is axis % 2 {
          continue
        }
        let angle: Float = turn + axis.toFloat() * 2.1 + tier.toFloat() * 0.91 + pair.toFloat() * 3.14159265
        let reach: Float = width * (0.38 + hash2(x: tier, y: axis * 2 + pair, seed: seed) * 0.20) * (1.1 - fraction * 0.4)
        let end: Vec3 = vadd(
          a: start
          b: Vec3.create(
            x: Math.cos(x: angle) * reach
            y: Math.sin(x: angle) * reach
            z: height * (0.06 + hash2(x: tier, y: pair + 31, seed: seed) * 0.035)
          )
        )
        let twig: BirchTwig = {
          start: start
          middle: vadd(
            a: vscale(a: vadd(a: start, b: end), s: 0.5)
            b: Vec3.create(x: 0, y: 0, z: -height * 0.018)
          )
          end: end
        }
        birchTube(
          mesh: wood
          curve: twig
          radius: height * 0.004 * (1.1 - fraction * 0.6)
          sides: 6
          steps: 4
          seed: seed + tier * 17 + pair
        )
        sprays.add(value: twig)
      }
    }
  }
  # Broad vertical ridges remain readable at the existing small-game-tree scale.
  loop var vertex: Int = 0, vertex < wood.vertCount, ++vertex {
    wood.verts.set(
      index: vertex * 8 + 7
      value: wood.verts.copyAtDefault(index: vertex * 8 + 2) / height * 1.7
    )
  }
  ret SugarMapleTree { wood: own wood, sprays: own sprays, height: height, width: width }
}

func sugarMapleLeaves(tree: view SugarMapleTree, seed: view Int, tone: view Int) ret MeshData {
  var mesh: MeshData = foliageMesh()
  loop var index: Int = 0, index < tree.sprays.length, ++index {
    if index % 3 is not tone {
      continue
    }
    let twig: BirchTwig = tree.sprays.copyAtDefault(index: index)
    let center: Vec3 = birchCurve(twig: twig, amount: 0.78)
    let variation: Float = 0.88 + hash2(x: index, y: 61, seed: seed) * 0.27
    let first: Int = mesh.vertCount
    addConnectedFoliageSpray(
      mesh: mesh
      center: center
      pivot: twig.start
      branchDirection: vsub(a: twig.end, b: twig.start)
      extent: Vec3.create(
        x: tree.width * 0.30 * variation
        y: tree.width * 0.15
        z: tree.height * 0.10 * variation
      )
      shadeNormal: vnorm(
        a: Vec3.create(x: center.x / tree.width * 0.55, y: center.y / tree.width * 0.55, z: 0.90)
      )
      seed: seed + index * 53
    )
    # Turn alternate cutouts upside down without rotating their world lighting.
    if index % 2 is 1 {
      loop var vertex: Int = first, vertex < mesh.vertCount, ++vertex {
        mesh.verts.set(
          index: vertex * 8 + 7
          value: 1 - mesh.verts.copyAtDefault(index: vertex * 8 + 7)
        )
      }
    }
  }
  ret own mesh
}

func sugarMapleLeafColor(tone: view Int) ret Vec3 {
  let variation: Float = 0.76 + tone.toFloat() * 0.07
  ret Vec3.create(x: variation, y: variation, z: variation * 0.96)
}

func sugarMapleWoodColor() ret Vec3 {
  ret Vec3.create(x: 0.80, y: 0.83, z: 0.86)
}

func sugarMapleLeafTexture() ret String {
  ret "lib/assets/trees/sugarMapleSpray.png"
}

func sugarMapleBarkTexture() ret String {
  ret "lib/assets/trees/sugarMapleBark.png"
}
