# Gpu2dCanvasText — the 2D canvas's MSDF text pass (#909) and its glyph batch
# (#915): glyph quads batched PER ATLAS (one frame mixes fonts, e.g. Roboto
# body text + the Material-icon atlas). Glyph rasterization and the CPU atlas
# pixels stay C (SdfText.loadAtlas); the atlas texture + view are uploaded
# lazily into manager textures, the per-atlas per-flush instance buffers
# persist like the box pool, and one bind group per atlas per flush draws its
# contiguous same-clip runs after the images. Split from Gpu2dCanvas.rae for
# the 1000-line cap; Gpu2dCanvasFrame.rae drives it from the frame flush.
import String
import Math
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuRenderPass
open gpu/GpuIds
open Gpu2dCanvas
open Gpu2dCanvasImage
open Gpu2dCanvasClip

# ----- text pass (#909) ---------------------------------------------------
func ensureTextPipeline(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if canvas.textPipeMade {
    ret
  }
  canvas.textPipeMade = true
  var source: String = ""
  unsafe {
    source = nativeG2dBoxReadFile(path: "lib/gpu2d_text.wgsl")
  }
  if source.length() is 0 {
    log(
      "[gpu2d] lib/gpu2d_text.wgsl not readable from the working directory — run from the repo root; 2D text is skipped"
    )
    ret
  }
  var format: Int = 0
  unsafe {
    format = nativeG2dBoxFormat()
  }
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    wgsl: source
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: boxPipelineSpec(format: format as Int32)
  ) {
    canvas.textPipeline = pipeline
  }
  # MSDF needs bilinear sampling: the same linear clamp sampler the images use.
  if not isValidSampler(resources: resources, id: canvas.imageSampler) {
    if let sampler: SamplerId = createSampler(resources: resources) {
      canvas.imageSampler = sampler
    }
  }
  ensureViewportUniform(canvas: canvas, resources: resources)
  loop canvas.textAtlases.length < g2dTextAtlasMax() {
    canvas.textAtlases.add(value: emptyTextAtlas())
  }
}

# Lazily upload atlas `ai` + 1 (1-based handle from SdfText.loadAtlas) as an
# RGBA8 manager texture (MSDF data is linear, not sRGB); cached.
func ensureTextAtlas(canvas: mod Gpu2dCanvas, resources: mod GpuResources, ai: copy Int) ret Bool {
  # #971: work through a `mod` window into the atlas List. The old copyAt/set
  # round trip deep-copied the atlas (its glyph List and all) once per flush
  # per atlas; only `resources` is mutated between get and set here (never
  # `canvas`), so an in-place window is safe.
  if ai < 0 or ai >= canvas.textAtlases.length {
    ret false
  }
  if let atlas: mod Gpu2dTextAtlas => canvas.textAtlases.modAt(index: ai) {
    if isValidTextureView(resources: resources, id: atlas.textureView) {
      ret true
    }
    let handle: Int = ai + 1
    let width: Int = sdfAtlasWidth(handle: handle)
    let height: Int = sdfAtlasHeight(handle: handle)
    if width <= 0 or height <= 0 {
      ret false
    }
    var made: Bool = false
    if let texture: TextureId = createTexture(
      resources: resources
      width: width
      height: height
      format: WGPUTextureFormat_RGBA8Unorm
      usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst
    ) {
      var uploaded: Bool = false
      unsafe {
        uploaded = writeTextureFromPtr(
          resources: resources
          texture: texture
          data: sdfAtlasPixels(handle: handle)
          bytesPerRow: width * 4
          rows: height
        )
      }
      if uploaded {
        if let textureView: TextureViewId = createTextureView(
          resources: resources
          texture: texture
        ) {
          atlas.texture = texture
          atlas.textureView = textureView
          made = true
        }
      }
      if not made {
        retireTexture(resources: resources, id: texture)
      }
    }
    ret made
  }
  ret false
}

# This flush's glyph instance buffer for atlas `ai`: the slot for its flush
# index, grown (retired and re-created, doubling) when the batch outgrew it.
func textFlushBuffer(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  ai: copy Int
  glyphs: copy Int
) ret BufferId {
  # #971: in-place `mod` window (was a full-atlas copyAt/set per flush per
  # atlas). Only `resources` is mutated between get and set, so this is safe.
  var current: BufferId = noBufferId()
  if ai < 0 or ai >= canvas.textAtlases.length {
    ret current
  }
  if let atlas: mod Gpu2dTextAtlas => canvas.textAtlases.modAt(index: ai) {
    let slot: Int = atlas.flushIndex
    atlas.flushIndex = slot + 1
    loop atlas.buffers.length <= slot {
      atlas.buffers.add(value: noBufferId())
      atlas.capacities.add(value: 0)
    }
    var capacity: Int = 0
    if let known: Int = atlas.capacities.copyAt(index: slot) {
      capacity = known
    }
    if let known: BufferId = atlas.buffers.copyAt(index: slot) {
      current = known
    }
    if not (isValidBuffer(resources: resources, id: current) and capacity >= glyphs) {
      retireBuffer(resources: resources, id: current)
      var grown: Int = capacity
      if grown < 16 {
        grown = 16
      }
      loop grown < glyphs {
        grown = grown * 2
      }
      current = noBufferId()
      if let buffer: BufferId = createBuffer(
        resources: resources
        size: grown * textGlyphFloats * 4
        usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst
      ) {
        current = buffer
      }
      atlas.buffers.set(index: slot, value: current)
      atlas.capacities.set(index: slot, value: grown)
    }
  }
  ret current
}

# One text draw per atlas that has glyphs this frame: upload its batch, bind
# [viewport, glyphs, atlas view, sampler] (a per-flush group, retired at frame
# end like the box groups), then draw the contiguous same-clip runs with their
# scissor. instance_index includes firstInstance, so the storage buffer still
# indexes the right glyph. Then reset that atlas's batch.
# ----- text batch (#915: the CPU accumulation, was C's drawGlyphEx) -----------

# Queue one MSDF glyph quad on atlas `atlas` (1-based, SdfText.loadAtlas):
# screen rect (design units), normalised uv rect, straight 0xAARRGGBB colour
# (the shader premultiplies), pxRange, an optional outline (width px + colour)
# and softness (edge falloff px; 1 = crisp). Tagged with the clip active now.
func canvasDrawGlyphEx(
  canvas: mod Gpu2dCanvas
  sx0: copy Float
  sy0: copy Float
  sx1: copy Float
  sy1: copy Float
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
  atlas: copy Int
  pxRange: copy Float
  color: copy Int
  outlineWidth: copy Float
  outlineColor: copy Int
  softness: copy Float
) {
  let ai: Int = atlas - 1
  if ai < 0 or ai >= g2dTextAtlasMax() {
    ret
  }
  loop canvas.textAtlases.length <= ai {
    canvas.textAtlases.add(value: emptyTextAtlas())
  }
  # #971: append the glyph IN PLACE via modAt. The copyAt+mutate+set form
  # this replaced deep-copied the whole accumulated glyph List on EVERY
  # glyph — O(n^2) per frame and the dominant idle malloc/free churn (114:
  # ~2.8M Buffer allocs / 20 s). A `mod` window grows the List's own storage.
  let clip: Int = canvas.currentClip
  if let entry: mod Gpu2dTextAtlas => canvas.textAtlases.modAt(index: ai) {
    entry.glyphs.add(value: sx0)
    entry.glyphs.add(value: sy0)
    entry.glyphs.add(value: sx1 - sx0)
    entry.glyphs.add(value: sy1 - sy0)
    entry.glyphs.add(value: u0)
    entry.glyphs.add(value: v0)
    entry.glyphs.add(value: u1 - u0)
    entry.glyphs.add(value: v1 - v0)
    entry.glyphs.add(value: tintChannel(color: color, shift: 65536))
    entry.glyphs.add(value: tintChannel(color: color, shift: 256))
    entry.glyphs.add(value: tintChannel(color: color, shift: 1))
    entry.glyphs.add(value: tintChannel(color: color, shift: 16777216))
    entry.glyphs.add(value: pxRange)
    entry.glyphs.add(value: outlineWidth)
    entry.glyphs.add(value: softness)
    entry.glyphs.add(value: 0.0)
    entry.glyphs.add(value: tintChannel(color: outlineColor, shift: 65536))
    entry.glyphs.add(value: tintChannel(color: outlineColor, shift: 256))
    entry.glyphs.add(value: tintChannel(color: outlineColor, shift: 1))
    entry.glyphs.add(value: tintChannel(color: outlineColor, shift: 16777216))
    entry.glyphClips.add(value: clip)
  }
}

func canvasDrawGlyph(
  canvas: mod Gpu2dCanvas
  sx0: copy Float
  sy0: copy Float
  sx1: copy Float
  sy1: copy Float
  u0: copy Float
  v0: copy Float
  u1: copy Float
  v1: copy Float
  atlas: copy Int
  pxRange: copy Float
  color: copy Int
) {
  canvasDrawGlyphEx(
    canvas: canvas
    sx0: sx0
    sy0: sy0
    sx1: sx1
    sy1: sy1
    u0: u0
    v0: v0
    u1: u1
    v1: v1
    atlas: atlas
    pxRange: pxRange
    color: color
    outlineWidth: 0.0
    outlineColor: 0
    softness: 1.0
  )
}

func clearTextBatches(canvas: mod Gpu2dCanvas) {
  # #971: clear the batch Lists IN PLACE — the copyAt/set form deep-copied
  # the whole (just-accumulated) glyph List only to empty it.
  loop var ai: Int = 0, ai < canvas.textAtlases.length, ++ai {
    if let atlas: mod Gpu2dTextAtlas => canvas.textAtlases.modAt(index: ai) {
      atlas.glyphs.clear()
      atlas.glyphClips.clear()
    }
  }
}

# One text draw per atlas that has glyphs this frame: upload its batch, bind
# [viewport, glyphs, atlas view, sampler] (a per-flush group, retired at frame
# end behind the frame's submission), then draw the contiguous same-clip runs
# with their scissor. instance_index includes firstInstance, so the storage
# buffer still indexes the right glyph. Then reset that atlas's batch.
func textFlushWith(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if not canvasFrameActive(canvas: canvas) {
    ret
  }
  loop var ai: Int = 0, ai < canvas.textAtlases.length, ++ai {
    var count: Int = 0
    # #973: read the glyph count through a `view` window — the copyAt this
    # replaced deep-copied the whole atlas (all four Lists) for EVERY atlas
    # EVERY frame just to test its length, ~124 atlas copies/frame in 114.
    if let atlas: view Gpu2dTextAtlas => canvas.textAtlases.viewAt(index: ai) {
      count = atlas.glyphClips.length
    }
    if count > 0 {
      textFlushAtlas(
        canvas: canvas
        resources: resources
        ai: ai
        count: count
      )
    }
  }
}

func textClipAt(atlas: view Gpu2dTextAtlas, i: copy Int) ret Int {
  if let clip: Int = atlas.glyphClips.copyAt(index: i) {
    ret clip
  }
  ret 0
}

func clearTextBatch(canvas: mod Gpu2dCanvas, ai: copy Int) {
  if let atlas: mod Gpu2dTextAtlas => canvas.textAtlases.modAt(index: ai) {
    atlas.glyphs.clear()
    atlas.glyphClips.clear()
  }
}

func textFlushAtlas(
  canvas: mod Gpu2dCanvas
  resources: mod GpuResources
  ai: copy Int
  count: copy Int
) {
  ensureTextPipeline(canvas: canvas, resources: resources)
  if not isValidRenderPipeline(resources: resources, id: canvas.textPipeline) {
    clearTextBatch(canvas: canvas, ai: ai)
    ret
  }
  # An atlas that is not loaded keeps its batch (the frame start clears it), as C did.
  if not ensureTextAtlas(canvas: canvas, resources: resources, ai: ai) {
    ret
  }
  let glyphs: BufferId = textFlushBuffer(
    canvas: canvas
    resources: resources
    ai: ai
    glyphs: count
  )
  var batch: Gpu2dTextAtlas = emptyTextAtlas()
  if let known: Gpu2dTextAtlas = canvas.textAtlases.copyAt(index: ai) {
    batch = own known
  }
  let strideBytes: Int = textGlyphFloats * 4
  var uploaded: Bool = false
  unsafe {
    uploaded = writeBufferFromPtr(
      resources: resources
      id: glyphs
      offset: 0
      data: batch.glyphs.data
      size: count * strideBytes
    )
  }
  if uploaded {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
    entries.add(value: bufferRef(id: canvas.viewport))
    entries.add(value: bufferRef(id: glyphs))
    entries.add(value: textureViewRef(id: batch.textureView))
    entries.add(value: samplerRef(id: canvas.imageSampler))
    if let bind: BindGroupId = createRenderBindGroup(
      resources: resources
      pipeline: canvas.textPipeline
      entries: entries
    ) {
      canvas.frameBinds.add(value: bind)
      var runStart: Int = 0
      loop runStart < count {
        let clip: Int = textClipAt(atlas: batch, i: runStart)
        var runEnd: Int = runStart + 1
        loop runEnd < count and textClipAt(atlas: batch, i: runEnd) is clip {
          runEnd = runEnd + 1
        }
        g2dScissor(canvas: canvas, clip: clip)
        unsafe {
          let drawn: Bool = recordDrawInPass(
            resources: resources
            pass: canvas.framePass
            pipeline: canvas.textPipeline
            bindGroup: bind
            vertexCount: 6
            instanceCount: runEnd - runStart
            firstVertex: 0
            firstInstance: runStart
          )
        }
        runStart = runEnd
      }
    }
  }
  batch.glyphs.clear()
  batch.glyphClips.clear()
  canvas.textAtlases.set(index: ai, value: own batch)
}
