# lib/ecs/HierarchySystem — the parent/child relationship as a system (#711, #769).
#
# `Children` (lib/ecs/hierarchy.rae) — the ORDERED child list on the parent — is
# AUTHORITATIVE and is what a snapshot persists; `Parent` is the DERIVED reverse
# index. Sibling ORDER is real information (layout + paint order) and it lives
# only in Children: component tables are swap-remove, so any rebuild that walked
# the Parent table would scramble siblings after a destroy. Callers — game or UI —
# never edit a `Children` list by hand: `setParent` (append) and `insertChild`
# (explicit index) are the ONLY mutation entries, and both keep the `Parent`
# index in lock-step. `rebuildParentsFromChildren` reconstructs every `Parent`
# from the Children lists alone (after a bulk load that wrote Children directly,
# or to self-heal) and enforces the single-parent invariant.
#
# The two component tables are passed in rather than owned, so any World that has
# a ComponentTable(Parent) + ComponentTable(Children) (UiWorld today, a GameWorld
# tomorrow) drives the same system.
import core
open ecs/entity
open ecs/component_table
open ecs/hierarchy
open ecs/world

# Append `child` to `parent`'s authoritative Children list, creating the list if
# this is the parent's first child. Internal — Children is only ever grown
# through here / insertChildAt, never by callers.
func addChildTo(childrens: mod ComponentTable(Children), parent: view EntityId, child: view EntityId) {
  if componentHas(this: childrens, entity: parent) is false {
    componentSet(this: childrens, entity: parent, data: Children { ids: createList(EntityId, cap: 4) })
  }
  let cache: mod Children => componentMod(this: childrens, entity: parent)
  cache.ids.add(value: child)
}

# Insert `child` into `parent`'s Children list at `index` (clamped to
# [0, length], so an out-of-range index appends). Internal.
func insertChildAt(childrens: mod ComponentTable(Children), parent: view EntityId,
                   child: view EntityId, index: view Int) {
  if componentHas(this: childrens, entity: parent) is false {
    componentSet(this: childrens, entity: parent, data: Children { ids: createList(EntityId, cap: 4) })
  }
  let cache: mod Children => componentMod(this: childrens, entity: parent)
  var at: Int = index
  if at < 0 {
    at = 0
  }
  if at > cache.ids.length {
    at = cache.ids.length
  }
  cache.ids.insert(index: at, value: child)
}

# Remove `child` from `parent`'s Children list (ordered remove, so surviving
# siblings keep their relative order). No-op if the parent has no list or the
# child isn't in it. Internal.
func removeChildFrom(childrens: mod ComponentTable(Children), parent: view EntityId, child: view EntityId) {
  if componentHas(this: childrens, entity: parent) is false {
    ret
  }
  let cache: mod Children => componentMod(this: childrens, entity: parent)
  loop var i: Int = 0, i < cache.ids.length, ++i {
    if let existing: EntityId = cache.ids.copyAt(index: i) {
      if existing is child {
        cache.ids.remove(index: i)
        ret
      }
    }
  }
}

# Unlink `child` from whatever parent it currently has (via the Parent index),
# so every mutation entry converges on "a child is in exactly ONE Children list".
# Internal.
func unlinkFromCurrent(parents: mod ComponentTable(Parent), childrens: mod ComponentTable(Children),
                       child: view EntityId) {
  if componentHas(this: parents, entity: child) {
    let current: Parent = componentGet(this: parents, entity: child)
    removeChildFrom(childrens: childrens, parent: current.parent, child: child)
  }
}

# Set (or clear) `child`'s parent, appending it as the LAST child. One of the two
# mutation entries (insertChild is the other): it edits the parent's authoritative
# `Children` list and keeps the derived `Parent` index in lock-step. Passing
# `noEntity()` as `parent` DETACHES the child (unlinks it from its old parent's
# list and drops its Parent). Re-parenting first unlinks from the old parent, so a
# child is never listed under two parents.
func setParent(parents: mod ComponentTable(Parent), childrens: mod ComponentTable(Children),
               child: view EntityId, parent: view EntityId) {
  unlinkFromCurrent(parents: parents, childrens: childrens, child: child)
  if isNone(this: parent) {
    componentRemove(this: parents, entity: child)
    ret
  }
  componentSet(this: parents, entity: child, data: Parent { parent: parent })
  addChildTo(childrens: childrens, parent: parent, child: child)
}

# Like setParent but places `child` at an explicit sibling `index` in `parent`'s
# Children list (clamped; past-the-end appends). Same invariants: unlinks from
# any current parent first, keeps Parent in lock-step. Use it when sibling order
# matters at insertion time (layout/paint order) instead of append-then-shuffle.
func insertChild(parents: mod ComponentTable(Parent), childrens: mod ComponentTable(Children),
                 parent: view EntityId, child: view EntityId, index: view Int) {
  unlinkFromCurrent(parents: parents, childrens: childrens, child: child)
  componentSet(this: parents, entity: child, data: Parent { parent: parent })
  insertChildAt(childrens: childrens, parent: parent, child: child, index: index)
}

# The children of `parent`, in order — a COPY, so a caller can iterate freely
# without being able to corrupt the authoritative list. Empty when `parent` has none.
func getChildren(childrens: view ComponentTable(Children), parent: view EntityId) ret List(EntityId) {
  let out: List(EntityId) = createList(EntityId, cap: 4)
  if componentHas(this: childrens, entity: parent) {
    let cache: view Children => componentView(this: childrens, entity: parent)
    loop var i: Int = 0, i < cache.ids.length, ++i {
      if let existing: EntityId = cache.ids.copyAt(index: i) {
        out.add(value: existing)
      }
    }
  }
  ret out
}

# Rebuild EVERY Parent from the Children lists alone. Drops the whole Parent
# index, then walks each Children list in the table's dense order and points each
# listed child at its list owner. Use after writing Children in bulk (a snapshot
# reload — Children is what persists) or to self-heal. Sibling order is untouched:
# Children is never rewritten, only read. Enforces the single-parent invariant: a
# child that shows up in a SECOND list (a corrupt/hand-edited snapshot) keeps its
# first parent and is dropped from the later list, so the result is always a tree.
func rebuildParentsFromChildren(parents: mod ComponentTable(Parent),
                                childrens: mod ComponentTable(Children)) {
  loop componentCount(this: parents) > 0 {
    let stale: EntityId = componentEntityAt(this: parents, i: 0)
    componentRemove(this: parents, entity: stale)
  }
  loop var i: Int = 0, i < componentCount(this: childrens), ++i {
    let owner: EntityId = componentEntityAt(this: childrens, i: i)
    let cache: mod Children => componentMod(this: childrens, entity: owner)
    var k: Int = 0
    loop k < cache.ids.length {
      if let child: EntityId = cache.ids.copyAt(index: k) {
        if componentHas(this: parents, entity: child) {
          # Already claimed by an earlier list: heal by dropping the duplicate.
          cache.ids.remove(index: k)
        } else {
          componentSet(this: parents, entity: child, data: Parent { parent: owner })
          k = k + 1
        }
      } else {
        k = k + 1
      }
    }
  }
}

# ----- depth-sorted iteration order (#713) -----------------------------------
#
# A cached topological order of the hierarchy — every parent BEFORE its children
# — so systems iterate a flat List once (transform propagation, visibility,
# painter's order) instead of pointer-chasing the tree each frame. The cache is
# dirty-tracked by the CHILDREN table's `generation` — Children is the
# authoritative shape AND order, and every mutation entry (setParent, insertChild,
# the destroy helpers, rebuildParentsFromChildren's healing) edits it through
# componentSet/componentMod/componentRemove, which bump it — so `depthOrder`
# rebuilds only when the tree actually changed and otherwise returns the cached
# list untouched.

type HierarchyOrder {
  order: List(EntityId)
  # The Children table generation the cached order was built at; -1 = never built,
  # so the first depthOrder call always builds.
  builtGeneration: Int
}

func createHierarchyOrder() ret HierarchyOrder {
  ret HierarchyOrder { order: createList(EntityId, cap: 16), builtGeneration: 0 - 1 }
}

# Append `node` then recurse into its Children, depth-first — pre-order, so a
# parent always lands before its descendants. Reads the Children cache only (no
# mutation), and is only ever entered from a ROOT, so a (malformed) parent cycle
# can never be walked into an infinite loop.
func emitSubtree(state: mod HierarchyOrder, childrens: view ComponentTable(Children), node: view EntityId) {
  state.order.add(value: node)
  if componentHas(this: childrens, entity: node) {
    let cache: view Children => componentView(this: childrens, entity: node)
    loop var i: Int = 0, i < cache.ids.length, ++i {
      if let childEntity: EntityId = cache.ids.copyAt(index: i) {
        emitSubtree(state: state, childrens: childrens, node: childEntity)
      }
    }
  }
}

# Rebuild the depth order from scratch: find every ROOT (an entity that HAS
# children but is listed under no parent — read via the Parent index) and
# pre-order DFS each subtree. Roots are taken in the Children table's dense order
# and each node's children in their authoritative order, so the result is
# deterministic. Entities in no hierarchy
# (no Parent and no Children) are correctly absent.
func rebuildDepthOrder(state: mod HierarchyOrder, parents: view ComponentTable(Parent),
                       childrens: view ComponentTable(Children)) {
  state.order.clear()
  loop var i: Int = 0, i < componentCount(this: childrens), ++i {
    let candidate: EntityId = componentEntityAt(this: childrens, i: i)
    if componentHas(this: parents, entity: candidate) is false {
      emitSubtree(state: state, childrens: childrens, node: candidate)
    }
  }
}

# The cached parent-before-child order. Rebuilds only when the Children table's
# generation moved since the last build (dirty tracking); otherwise hands back
# the cached list. Returned as a `view` so a system iterates it with no copy.
func depthOrder(state: mod HierarchyOrder, parents: view ComponentTable(Parent),
                childrens: view ComponentTable(Children)) ret view List(EntityId) {
  let gen: Int = componentTableGeneration(this: childrens)
  if state.builtGeneration is not gen {
    rebuildDepthOrder(state: state, parents: parents, childrens: childrens)
    state.builtGeneration = gen
  }
  ret view state.order
}

# ----- destroy-time referential integrity (#712) -----------------------------
#
# Destroying an entity must not leave dangling hierarchy edges: no Parent may
# point at a dead entity, and no Children list may still list one. componentRemove
# alone does NOT do this — it drops the entity's OWN Parent/Children but leaves
# its parent's Children and its children's Parent pointing at it (the gap
# documented at lib/ui/ecs.rae destroyEntity). detachForDestroy / destroySubtree
# close that gap.

# Append `node` then every descendant (pre-order) into `out`. Reads the Children
# cache only. Used to gather a whole subtree before tearing it down.
func collectSubtree(childrens: view ComponentTable(Children), node: view EntityId,
                    out: mod List(EntityId)) {
  out.add(value: node)
  if componentHas(this: childrens, entity: node) {
    let cache: view Children => componentView(this: childrens, entity: node)
    loop var i: Int = 0, i < cache.ids.length, ++i {
      if let childEntity: EntityId = cache.ids.copyAt(index: i) {
        collectSubtree(childrens: childrens, node: childEntity, out: out)
      }
    }
  }
}

# Prepare a SINGLE entity for destruction, keeping the hierarchy consistent:
# unlink it from its parent's Children (an ORDERED remove — the surviving siblings
# keep their order), drop its own Parent, ORPHAN its children (clear each child's
# Parent so it no longer dangles to the dying entity — they become roots), and
# drop its own Children. After this call no Parent/Children
# anywhere references `entity`, and `entity` references nothing. The caller then
# removes the entity's other components and frees it. Use destroySubtree instead
# when the children should die with the entity.
func detachForDestroy(parents: mod ComponentTable(Parent), childrens: mod ComponentTable(Children),
                      entity: view EntityId) {
  if componentHas(this: parents, entity: entity) {
    let link: Parent = componentGet(this: parents, entity: entity)
    removeChildFrom(childrens: childrens, parent: link.parent, child: entity)
    componentRemove(this: parents, entity: entity)
  }
  if componentHas(this: childrens, entity: entity) {
    let kids: List(EntityId) = getChildren(childrens: childrens, parent: entity)
    loop var i: Int = 0, i < kids.length, ++i {
      if let child: EntityId = kids.copyAt(index: i) {
        componentRemove(this: parents, entity: child)
      }
    }
    componentRemove(this: childrens, entity: entity)
  }
}

# Destroy `root` and its whole subtree: free every entity in the allocator and
# drop all their Parent/Children, and unlink `root` from its parent's Children.
# After this no subtree entity is alive and no surviving Parent/Children edge
# references any of them — no dangling refs. (The entities' OTHER components are
# the owning World's concern; this is the hierarchy + entity-lifetime teardown.)
func destroySubtree(allocator: mod EntityAllocator, parents: mod ComponentTable(Parent),
                    childrens: mod ComponentTable(Children), root: view EntityId) {
  let subtree: List(EntityId) = createList(EntityId, cap: 16)
  collectSubtree(childrens: childrens, node: root, out: subtree)
  # Unlink the root from its parent's Children so the (surviving) parent doesn't
  # dangle to the destroyed root.
  if componentHas(this: parents, entity: root) {
    let link: Parent = componentGet(this: parents, entity: root)
    removeChildFrom(childrens: childrens, parent: link.parent, child: root)
  }
  loop var i: Int = 0, i < subtree.length, ++i {
    if let entity: EntityId = subtree.copyAt(index: i) {
      componentRemove(this: parents, entity: entity)
      componentRemove(this: childrens, entity: entity)
      freeEntity(this: allocator, entity: entity)
    }
  }
}
