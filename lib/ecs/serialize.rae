# lib/ecs — serialize-OUT (docs/ecs-general-architecture.md §2.7, #719).
#
# Turns a World into JSON, driven entirely by the component registry (#717): a
# component is written ONLY if it was registered with the serialize flag. Derived
# / cache / runtime components (WorldTransform*, ComputedRect, MeasuredSize, ...)
# are registered WITHOUT serialize — so they are simply skipped and never reach
# the save file, with no type annotation anywhere.
#
# The output is columnar (natural for a sparse-set ECS): one object per
# component, keyed by component name, whose entries map an entity's index to that
# component's `toJson()` (the compiler-generated per-struct serializer). E.g.
#   { "Pos": { "1": {"x":10,"y":20}, "2": {...} }, "Vel": { "2": {...} } }
#
# Because Rae has no reflection and no first-class function references, a World
# can't enumerate its own heterogeneous tables generically. So the reusable piece
# is the per-table serializer `addComponentTable` (generic over the component
# type, inferred from the table); an app's `worldToJson` is a few-line
# composition that calls it once per table then `finishWorldJson` (see the test).
# lib/json's JsonBuilder (#718) isn't required — the fragments are assembled from
# `toJson()` + `jsonQuote`, and parse straight back with `parseJson`.
import core
open json
open ecs/entity
open ecs/component_table
open ecs/registry

# Accumulates one `"Name": { ... }` fragment per serialized component table, then
# joins them into a single JSON object.
type WorldJson {
  parts: List(String)
}

func createWorldJson() ret WorldJson {
  ret WorldJson { parts: createList(String, cap: 16) }
}

# Serialize ONE component table into the world JSON — but ONLY if `name` is
# registered with the serialize flag. A table whose component is a derived cache
# (registered without serialize, or not registered) is silently skipped, so it is
# never written. Generic over the component type T (inferred from the table);
# each stored component is written through its compiler-generated `toJson()`.
func addComponentTable(T: type, writer: mod WorldJson, table: view ComponentTable(T),
                       name: view String, registry: view ComponentRegistry) {
  if registeredHasFlag(reg: registry, name: name, flag: serialize) is false {
    ret
  }
  var frag: String = jsonQuote(s: name)
  frag = frag.concat(other: ": \{")
  loop var i: Int = 0, i < componentCount(this: table), ++i {
    if i > 0 {
      frag = frag.concat(other: ", ")
    }
    let entity: EntityId = componentEntityAt(this: table, i: i)
    let value: T = componentDataAt(this: table, i: i)
    let key: String = "{entity.index}"
    frag = frag.concat(other: jsonQuote(s: key))
    frag = frag.concat(other: ": ")
    frag = frag.concat(other: value.toJson())
  }
  frag = frag.concat(other: "\}")
  writer.parts.add(value: own frag)
}

# Close the world object: join every serialized-component fragment into one JSON
# object. An empty world (nothing serialized) yields "{}".
func finishWorldJson(writer: view WorldJson) ret String {
  var out: String = "\{"
  loop var i: Int = 0, i < writer.parts.length, ++i {
    if i > 0 {
      out = out.concat(other: ", ")
    }
    if let part: String = writer.parts.copyAt(index: i) {
      out = out.concat(other: part)
    }
  }
  out = out.concat(other: "\}")
  ret out
}

# ----- serialize-IN (#720) --------------------------------------------------
#
# The inverse of the serialize-out above, driven the SAME way — by the registry,
# NOT a hand-written per-name switch. loadComponentTable is generic over the
# component type T (inferred from the table) and reconstructs each stored
# component through the compiler-generated `T.fromJson`. It loads a table only if
# `name` is registered with serialize, so unregistered / non-serialized keys are
# ignored. An app's `worldFromJson` is a per-table composition (one
# loadComponentTable per table); the dispatch to the concrete fromJson is the
# generic T (compiler-monomorphized), never a switch — so adding a component is
# one registration + one call, not a new case in a giant applyComponentByName.

func loadComponentTable(T: type, table: mod ComponentTable(T), name: view String,
                        registry: view ComponentRegistry, doc: view JsonDoc) {
  if registeredHasFlag(reg: registry, name: name, flag: serialize) is false {
    ret
  }
  let root: JsonValue = jsonRoot(doc: doc)
  let componentIdx: Int = jsonField(doc: doc, this: root, key: name)
  if componentIdx < 0 {
    ret
  }
  # The component's entry is an object mapping entity index -> the component's
  # own JSON. Re-stringify each value (stringify, #718) and hand it to fromJson.
  let componentObj: JsonValue = jsonValueAt(doc: doc, idx: componentIdx)
  loop var i: Int = 0, i < jsonObjectLen(this: componentObj), ++i {
    let key: String = jsonObjectKeyAt(doc: doc, this: componentObj, idx: i)
    let valueJson: JsonValue = jsonObjectValueAt(doc: doc, this: componentObj, idx: i)
    let entity: EntityId = { index: key.toInt(), generation: 0 }
    let valueStr: String = stringify(doc: doc, value: valueJson)
    let component: T = T.fromJson(json: valueStr)
    componentSet(this: table, entity: entity, data: component)
  }
}

# ----- resources (#753) ------------------------------------------------------
#
# A resource is a world-global singleton (a plain field on the World, e.g.
# world.frame / world.layoutW), NOT a per-entity component — so it serializes as
# a SINGLE top-level value, keyed by name, rather than an entity->value map:
#   { "Frame": {"count":7,"dt":16}, "Pos": { "1": {...} } }
# addResource / resourceJson stay non-generic: the caller passes value.toJson()
# in and calls Type.fromJson on the way out (both concrete, so they monomorphize
# cleanly). Registry-gated exactly like components — written only when the name
# is registered serialize, so runtime resources (registered resource without
# serialize) are omitted.

# Write a resource's value into the world JSON, but ONLY if `name` is registered
# with serialize. `valueJson` is the resource's own JSON (its `toJson()`).
func addResource(writer: mod WorldJson, name: view String, valueJson: view String,
                 registry: view ComponentRegistry) {
  if registeredHasFlag(reg: registry, name: name, flag: serialize) is false {
    ret
  }
  var frag: String = jsonQuote(s: name)
  frag = frag.concat(other: ": ")
  frag = frag.concat(other: valueJson)
  writer.parts.add(value: own frag)
}

# The JSON string for resource `name` in `doc` (feed to Type.fromJson), or ""
# when it isn't registered serialize or isn't present in the document.
func resourceJson(name: view String, registry: view ComponentRegistry, doc: view JsonDoc) ret String {
  if registeredHasFlag(reg: registry, name: name, flag: serialize) is false {
    ret ""
  }
  let root: JsonValue = jsonRoot(doc: doc)
  let idx: Int = jsonField(doc: doc, this: root, key: name)
  if idx < 0 {
    ret ""
  }
  ret stringify(doc: doc, value: jsonValueAt(doc: doc, idx: idx))
}
