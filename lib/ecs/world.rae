# lib/ecs — the reusable entity core: index recycling, generational handles, and
# the live-entity set (#704 allocator, #705 O(1) alive, #706 packaged for reuse).
#
# EntityAllocator is the whole entity-lifecycle core, NOT just an index pool: it
# owns the generation table, the free list, AND the dense live-entity set with
# its sparse position map. Any World embeds ONE of these and gets create /
# destroy / isAlive / alive-iteration for free — its own component tables stay
# app-specific fields alongside it (UiWorld does exactly this; a GameWorld can
# too, see compiler/tests/cases/683_ecs_world_core). On destroy a slot's
# `generation` is bumped and its `index` returns to the free list; the next
# allocation reuses that index with the higher generation, so an old handle to
# the recycled slot compares unequal (its generation is stale).
#
# RESOURCES (#753). A World holds two KINDS of state. COMPONENTS are per-entity —
# a ComponentTable(T) field, one row per entity. A RESOURCE is a world-global
# SINGLETON — there is exactly one, so it is just a PLAIN FIELD on the World
# struct, read as `world.frame` / `world.input` / `world.layoutW`. A resource is
# NOT an entity and must never be modelled as one (no camera/input/clock faked as
# a one-off entity with a component). It needs no id, no table, no query — direct
# field access is the whole point.
#
# Serialization treats the two kinds by the SAME registry rule (lib/ecs/registry
# #717), just at different granularity: a component table serializes to an
# entity->value map, a resource to a single top-level value (serialize.rae
# addResource / resourceJson, #720/#753). An AUTHORED resource that belongs in a
# save file is registered `registerResource(reg, name, SERIALIZE)`; a RUNTIME
# resource (frame timing, input snapshot, GPU handles) is registered
# `registerResource(reg, name, 0)` — RESOURCE without SERIALIZE — so save/load
# skips it and it is rebuilt at runtime. Full write-up: docs/ecs-resources.md.
import core
open ecs/entity
import ecs/list_helpers

type EntityAllocator {
  generations: List(Int)   # generations[index] = the slot's current generation
  freeList: List(Int)      # indices freed by destroy, available for reuse
  nextIndex: Int           # next never-used index (when the free list is empty)
  # The live-entity set (#705): `alive` is the dense list every system iterates
  # once per frame; `aliveSlot[index]` is that entity's position in `alive`
  # (-1 = not alive), which makes destroy an O(1) swap-remove instead of a scan.
  alive: List(EntityId)
  aliveSlot: List(Int)
}

func createEntityAllocator() ret EntityAllocator {
  ret EntityAllocator {
    generations: createList(Int, cap: 256)
    freeList: createList(Int, cap: 64)
    nextIndex: 1
    alive: createList(EntityId, cap: 256)
    aliveSlot: createList(Int, cap: 256)
  }
}

# Allocate an entity: reuse the most-recently-freed index (with its bumped
# generation) if any, else hand out a fresh index at generation 0. Records the
# new handle in the live set (its position in `alive` kept in `aliveSlot` so
# freeEntity can swap-remove it in O(1)).
func allocEntity(this: mod EntityAllocator) ret EntityId {
  var idx: Int = 0
  var gen: Int = 0
  let freeCount: Int = this.freeList.length
  if freeCount > 0 {
    let last: Int = freeCount - 1
    idx = intListAt(lst: this.freeList, index: last)
    popLastInt(lst: this.freeList)
    gen = intListAt(lst: this.generations, index: idx)
  } else {
    idx = this.nextIndex
    this.nextIndex = idx + 1
    ensureIntSlots(lst: this.generations, index: idx)
    setIntListAt(lst: this.generations, index: idx, value: 0)
    gen = 0
  }
  let entity: EntityId = { index: idx, generation: gen }
  let pos: Int = this.alive.length
  appendEntityList(lst: this.alive, value: entity)
  ensureIntSlots(lst: this.aliveSlot, index: idx)
  setIntListAt(lst: this.aliveSlot, index: idx, value: pos)
  ret entity
}

# Free an entity: bump its slot's generation (so stale handles compare unequal),
# return the index to the free list, and drop it from the live set in O(1) via
# the sparse slot map (swap the last entry into the hole, fix the moved entity's
# recorded slot, pop, clear this slot).
func freeEntity(this: mod EntityAllocator, entity: view EntityId) {
  let idx: Int = entity.index
  if idx < 0 {
    ret
  }
  ensureIntSlots(lst: this.generations, index: idx)
  let cur: Int = intListAt(lst: this.generations, index: idx)
  setIntListAt(lst: this.generations, index: idx, value: cur + 1)
  appendIntList(lst: this.freeList, value: idx)
  # O(1) removal from the dense `alive` list.
  if idx >= this.aliveSlot.length {
    ret
  }
  let pos: Int = intListAt(lst: this.aliveSlot, index: idx)
  if pos < 0 {
    ret
  }
  let last: Int = this.alive.length - 1
  let lastEntity: EntityId = entityListAt(lst: this.alive, index: last)
  swapRemoveEntityList(lst: this.alive, index: pos)
  setIntListAt(lst: this.aliveSlot, index: lastEntity.index, value: pos)
  setIntListAt(lst: this.aliveSlot, index: idx, value: 0 - 1)
}

# The current generation of a slot, or -1 if the index was never allocated.
func allocatorGeneration(this: view EntityAllocator, index: view Int) ret Int {
  if index < 0 {
    ret -1
  }
  if index >= this.generations.length {
    ret -1
  }
  ret intListAt(lst: this.generations, index: index)
}

# O(1) liveness: a handle is alive iff its slot's current generation still
# matches the handle's. A freed slot has a bumped generation and a never-
# allocated/out-of-range index reads -1, so both compare unequal — noEntity()
# (index -1) and stale handles read false without touching the alive list.
func allocatorIsAlive(this: view EntityAllocator, entity: view EntityId) ret Bool {
  ret allocatorGeneration(this: this, index: entity.index) is entity.generation
}

# How many entities are currently alive (the dense set's length).
func allocatorAliveCount(this: view EntityAllocator) ret Int {
  ret this.alive.length
}
