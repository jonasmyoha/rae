# lib/ecs — multi-component queries (docs/ecs-general-architecture.md §2.6).
#
# query2/query3 join 2/3 component tables: they iterate the SMALLEST matching
# table and probe the others by entity index (componentIndexOf is an O(1) sparse
# lookup), so total work is O(min table size), not O(largest). Each match record
# carries the entity plus its DENSE INDEX in every joined table, so the shared
# queryModAt/queryViewAt accessors alias table storage directly — no second
# lookup. queryModAt bumps the table generation + the entity's change stamp, the
# same as componentMod, so systems downstream still see the write.
#
# Contract: the dense indices are valid only while none of the joined tables is
# STRUCTURALLY mutated (componentSet of a new entity / componentRemove) during
# the iteration — the standard "don't add/remove components in the table you are
# querying while you walk it" rule. Mutating component DATA through the returned
# `mod` ref is exactly what queries are for and is always safe.
#
# These are the first multi-type-param generics in the tree (query2 is 2, query3
# is 3, query4/query5 extend the same hand-written ladder, #807); they rely on
# the monomorphizer binding every type param from its own argument (compiler
# #707 work). The ladder is deliberately FIXED and explicit — there are no
# variadic / type-list generics (declined, docs/ecs-language-wishlist.md):
# nobody joins eight tables in a hot loop, and an explicit query4/query5 reads
# and analyses exactly like query2/query3.
import core
open ecs/Entity
open ecs/ComponentTable

# ----- shared storage-aliasing accessors -------------------------------------

# Borrow a MUTABLE reference to the component at a table's dense index (the index
# a query already probed). Aliases storage; bumps the table generation + the
# entity's per-entity change stamp so change-detection sees the mutation — the
# same bookkeeping componentMod does (we assume the caller writes through it).
func queryModAt(T: type, table: mod ComponentTable(T), denseIndex: view Int) ret mod T {
  table.generation = table.generation + 1
  rae_ext_rae_buf_set(buf: table.denseStamps.data, index: denseIndex, value: table.generation)
  ret mod rae_ext_rae_buf_get(buf: table.denseData.data, index: denseIndex)
}

# Borrow a READ-ONLY reference to the component at a table's dense index. No
# generation bump — a read never dirties the table.
func queryViewAt(T: type, table: view ComponentTable(T), denseIndex: view Int) ret view T {
  ret view rae_ext_rae_buf_get(buf: table.denseData.data, index: denseIndex)
}

# ----- query2 ----------------------------------------------------------------

# One (entity, dense-index-in-A, dense-index-in-B) match. Stored in a List so the
# result iterates with `loop let m: view Query2Match in query2(...)`.
type Query2Match {
  entity: EntityId
  indexA: Int
  indexB: Int
}

# Entities present in BOTH tables. Iterates the smaller table and probes the
# other by index.
func query2(A: type, B: type,
            tableA: view ComponentTable(A), tableB: view ComponentTable(B)) ret List(Query2Match) {
  let countA: Int = componentCount(this: tableA)
  let countB: Int = componentCount(this: tableB)
  let matches: List(Query2Match) = createList(Query2Match, cap: 16)
  if countA <= countB {
    loop var i: Int = 0, i < countA, ++i {
      let entity: EntityId = componentEntityAt(this: tableA, i: i)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      if idxB >= 0 {
        matches.add(value: Query2Match { entity: entity, indexA: i, indexB: idxB })
      }
    }
  } else {
    loop var i: Int = 0, i < countB, ++i {
      let entity: EntityId = componentEntityAt(this: tableB, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      if idxA >= 0 {
        matches.add(value: Query2Match { entity: entity, indexA: idxA, indexB: i })
      }
    }
  }
  ret matches
}

# ----- query3 ----------------------------------------------------------------

type Query3Match {
  entity: EntityId
  indexA: Int
  indexB: Int
  indexC: Int
}

# Entities present in ALL THREE tables. Iterates whichever table is smallest and
# probes the other two by index, so the join stays O(min of the three).
func query3(A: type, B: type, C: type,
            tableA: view ComponentTable(A), tableB: view ComponentTable(B),
            tableC: view ComponentTable(C)) ret List(Query3Match) {
  let countA: Int = componentCount(this: tableA)
  let countB: Int = componentCount(this: tableB)
  let countC: Int = componentCount(this: tableC)
  let matches: List(Query3Match) = createList(Query3Match, cap: 16)
  if countA <= countB and countA <= countC {
    loop var i: Int = 0, i < countA, ++i {
      let entity: EntityId = componentEntityAt(this: tableA, i: i)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      if idxB >= 0 and idxC >= 0 {
        matches.add(value: Query3Match { entity: entity, indexA: i, indexB: idxB, indexC: idxC })
      }
    }
  } else if countB <= countA and countB <= countC {
    loop var i: Int = 0, i < countB, ++i {
      let entity: EntityId = componentEntityAt(this: tableB, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      if idxA >= 0 and idxC >= 0 {
        matches.add(value: Query3Match { entity: entity, indexA: idxA, indexB: i, indexC: idxC })
      }
    }
  } else {
    loop var i: Int = 0, i < countC, ++i {
      let entity: EntityId = componentEntityAt(this: tableC, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      if idxA >= 0 and idxB >= 0 {
        matches.add(value: Query3Match { entity: entity, indexA: idxA, indexB: idxB, indexC: i })
      }
    }
  }
  ret matches
}

# ----- single-table dense forEach (#709) -------------------------------------

# One (entity, dense-index) pair for a SINGLE table. Same shape the join matches
# use, so a single-table walk reads through the same view/mod accessors.
type QueryMatch {
  entity: EntityId
  index: Int
}

# Walk EVERY entity in one table, in dense order — no join, no probe. This is the
# single-table base case of a query: for a system that touches one component
# kind (e.g. advance every AnimState), forEach hands back the whole dense set so
# the body reads/writes each via queryViewAt / queryModAt by `index`. The dense
# index equals the loop position, so it addresses `table` directly with no
# lookup.
func forEach(T: type, table: view ComponentTable(T)) ret List(QueryMatch) {
  let count: Int = componentCount(this: table)
  let matches: List(QueryMatch) = createList(QueryMatch, cap: 16)
  loop var i: Int = 0, i < count, ++i {
    matches.add(value: QueryMatch { entity: componentEntityAt(this: table, i: i), index: i })
  }
  ret matches
}

# ----- read-only view query variants (#709) ----------------------------------
#
# The mod accessor (queryModAt) EAGERLY bumps the table generation + entity stamp
# because it can't see whether the caller writes — correct for a mutating system,
# but a READ-ONLY system that used it would dirty change-detection every frame
# and defeat the `*IfDirty` skip. These variants read a matched component through
# a `view` ref and never touch the generation, so a read-only pass leaves every
# queried table's generation exactly as it found it. One per query slot, so a
# system reads `query2ViewA(tableA, hit)` without threading which index field
# maps to which table.

func query2ViewA(A: type, tableA: view ComponentTable(A), hit: view Query2Match) ret view A {
  ret view rae_ext_rae_buf_get(buf: tableA.denseData.data, index: hit.indexA)
}

func query2ViewB(B: type, tableB: view ComponentTable(B), hit: view Query2Match) ret view B {
  ret view rae_ext_rae_buf_get(buf: tableB.denseData.data, index: hit.indexB)
}

func query3ViewA(A: type, tableA: view ComponentTable(A), hit: view Query3Match) ret view A {
  ret view rae_ext_rae_buf_get(buf: tableA.denseData.data, index: hit.indexA)
}

func query3ViewB(B: type, tableB: view ComponentTable(B), hit: view Query3Match) ret view B {
  ret view rae_ext_rae_buf_get(buf: tableB.denseData.data, index: hit.indexB)
}

func query3ViewC(C: type, tableC: view ComponentTable(C), hit: view Query3Match) ret view C {
  ret view rae_ext_rae_buf_get(buf: tableC.denseData.data, index: hit.indexC)
}

# Read the component for a single-table forEach match through a `view` ref.
func forEachView(T: type, table: view ComponentTable(T), hit: view QueryMatch) ret view T {
  ret view rae_ext_rae_buf_get(buf: table.denseData.data, index: hit.index)
}

# ----- query-by-tag (#752) --------------------------------------------------
#
# A tag table (a ComponentTable of a zero-field marker, #751/#752) is an ordinary
# component table, so query2/query3 already join on it. tagged names the
# common case — iterate a DATA table filtered to entities that ALSO carry a tag.
# The data table is passed FIRST, so each match's indexA addresses the data slot
# (read/write via queryViewAt / queryModAt) while the tag has no payload to read.
# It reuses the smallest-table probe, so a small tag set is walked rather than the
# whole data table. This is how a tag replaces a `kind`-field if-ladder: instead
# of scanning all units and branching on kind, query only the tagged ones.
func tagged(D: type, T: type, dataTable: view ComponentTable(D),
                 tagTable: view ComponentTable(T)) ret List(Query2Match) {
  ret query2(tableA: dataTable, tableB: tagTable)
}

# ----- query4 (#807) --------------------------------------------------------

type Query4Match {
  entity: EntityId
  indexA: Int
  indexB: Int
  indexC: Int
  indexD: Int
}

# Entities present in ALL FOUR tables. Same smallest-table probe as query3:
# iterate whichever table is smallest and probe the other three by index, so the
# join stays O(min of the four) regardless of how big the others are.
func query4(A: type, B: type, C: type, D: type,
            tableA: view ComponentTable(A), tableB: view ComponentTable(B),
            tableC: view ComponentTable(C), tableD: view ComponentTable(D)) ret List(Query4Match) {
  let countA: Int = componentCount(this: tableA)
  let countB: Int = componentCount(this: tableB)
  let countC: Int = componentCount(this: tableC)
  let countD: Int = componentCount(this: tableD)
  let matches: List(Query4Match) = createList(Query4Match, cap: 16)
  if countA <= countB and countA <= countC and countA <= countD {
    loop var i: Int = 0, i < countA, ++i {
      let entity: EntityId = componentEntityAt(this: tableA, i: i)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      if idxB >= 0 and idxC >= 0 and idxD >= 0 {
        matches.add(value: Query4Match { entity: entity, indexA: i, indexB: idxB, indexC: idxC, indexD: idxD })
      }
    }
  } else if countB <= countA and countB <= countC and countB <= countD {
    loop var i: Int = 0, i < countB, ++i {
      let entity: EntityId = componentEntityAt(this: tableB, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      if idxA >= 0 and idxC >= 0 and idxD >= 0 {
        matches.add(value: Query4Match { entity: entity, indexA: idxA, indexB: i, indexC: idxC, indexD: idxD })
      }
    }
  } else if countC <= countA and countC <= countB and countC <= countD {
    loop var i: Int = 0, i < countC, ++i {
      let entity: EntityId = componentEntityAt(this: tableC, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      if idxA >= 0 and idxB >= 0 and idxD >= 0 {
        matches.add(value: Query4Match { entity: entity, indexA: idxA, indexB: idxB, indexC: i, indexD: idxD })
      }
    }
  } else {
    loop var i: Int = 0, i < countD, ++i {
      let entity: EntityId = componentEntityAt(this: tableD, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      if idxA >= 0 and idxB >= 0 and idxC >= 0 {
        matches.add(value: Query4Match { entity: entity, indexA: idxA, indexB: idxB, indexC: idxC, indexD: i })
      }
    }
  }
  ret matches
}

func query4ViewA(A: type, tableA: view ComponentTable(A), hit: view Query4Match) ret view A {
  ret view rae_ext_rae_buf_get(buf: tableA.denseData.data, index: hit.indexA)
}

func query4ViewB(B: type, tableB: view ComponentTable(B), hit: view Query4Match) ret view B {
  ret view rae_ext_rae_buf_get(buf: tableB.denseData.data, index: hit.indexB)
}

func query4ViewC(C: type, tableC: view ComponentTable(C), hit: view Query4Match) ret view C {
  ret view rae_ext_rae_buf_get(buf: tableC.denseData.data, index: hit.indexC)
}

func query4ViewD(D: type, tableD: view ComponentTable(D), hit: view Query4Match) ret view D {
  ret view rae_ext_rae_buf_get(buf: tableD.denseData.data, index: hit.indexD)
}

# ----- query5 (#807) --------------------------------------------------------

type Query5Match {
  entity: EntityId
  indexA: Int
  indexB: Int
  indexC: Int
  indexD: Int
  indexE: Int
}

# Entities present in ALL FIVE tables — the top of the fixed ladder. Iterates the
# smallest table and probes the other four, O(min of the five).
func query5(A: type, B: type, C: type, D: type, E: type,
            tableA: view ComponentTable(A), tableB: view ComponentTable(B),
            tableC: view ComponentTable(C), tableD: view ComponentTable(D),
            tableE: view ComponentTable(E)) ret List(Query5Match) {
  let countA: Int = componentCount(this: tableA)
  let countB: Int = componentCount(this: tableB)
  let countC: Int = componentCount(this: tableC)
  let countD: Int = componentCount(this: tableD)
  let countE: Int = componentCount(this: tableE)
  let matches: List(Query5Match) = createList(Query5Match, cap: 16)
  if countA <= countB and countA <= countC and countA <= countD and countA <= countE {
    loop var i: Int = 0, i < countA, ++i {
      let entity: EntityId = componentEntityAt(this: tableA, i: i)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      let idxE: Int = componentIndexOf(this: tableE, entity: entity)
      if idxB >= 0 and idxC >= 0 and idxD >= 0 and idxE >= 0 {
        matches.add(value: Query5Match { entity: entity, indexA: i, indexB: idxB, indexC: idxC, indexD: idxD, indexE: idxE })
      }
    }
  } else if countB <= countA and countB <= countC and countB <= countD and countB <= countE {
    loop var i: Int = 0, i < countB, ++i {
      let entity: EntityId = componentEntityAt(this: tableB, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      let idxE: Int = componentIndexOf(this: tableE, entity: entity)
      if idxA >= 0 and idxC >= 0 and idxD >= 0 and idxE >= 0 {
        matches.add(value: Query5Match { entity: entity, indexA: idxA, indexB: i, indexC: idxC, indexD: idxD, indexE: idxE })
      }
    }
  } else if countC <= countA and countC <= countB and countC <= countD and countC <= countE {
    loop var i: Int = 0, i < countC, ++i {
      let entity: EntityId = componentEntityAt(this: tableC, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      let idxE: Int = componentIndexOf(this: tableE, entity: entity)
      if idxA >= 0 and idxB >= 0 and idxD >= 0 and idxE >= 0 {
        matches.add(value: Query5Match { entity: entity, indexA: idxA, indexB: idxB, indexC: i, indexD: idxD, indexE: idxE })
      }
    }
  } else if countD <= countA and countD <= countB and countD <= countC and countD <= countE {
    loop var i: Int = 0, i < countD, ++i {
      let entity: EntityId = componentEntityAt(this: tableD, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      let idxE: Int = componentIndexOf(this: tableE, entity: entity)
      if idxA >= 0 and idxB >= 0 and idxC >= 0 and idxE >= 0 {
        matches.add(value: Query5Match { entity: entity, indexA: idxA, indexB: idxB, indexC: idxC, indexD: i, indexE: idxE })
      }
    }
  } else {
    loop var i: Int = 0, i < countE, ++i {
      let entity: EntityId = componentEntityAt(this: tableE, i: i)
      let idxA: Int = componentIndexOf(this: tableA, entity: entity)
      let idxB: Int = componentIndexOf(this: tableB, entity: entity)
      let idxC: Int = componentIndexOf(this: tableC, entity: entity)
      let idxD: Int = componentIndexOf(this: tableD, entity: entity)
      if idxA >= 0 and idxB >= 0 and idxC >= 0 and idxD >= 0 {
        matches.add(value: Query5Match { entity: entity, indexA: idxA, indexB: idxB, indexC: idxC, indexD: idxD, indexE: i })
      }
    }
  }
  ret matches
}

func query5ViewA(A: type, tableA: view ComponentTable(A), hit: view Query5Match) ret view A {
  ret view rae_ext_rae_buf_get(buf: tableA.denseData.data, index: hit.indexA)
}

func query5ViewB(B: type, tableB: view ComponentTable(B), hit: view Query5Match) ret view B {
  ret view rae_ext_rae_buf_get(buf: tableB.denseData.data, index: hit.indexB)
}

func query5ViewC(C: type, tableC: view ComponentTable(C), hit: view Query5Match) ret view C {
  ret view rae_ext_rae_buf_get(buf: tableC.denseData.data, index: hit.indexC)
}

func query5ViewD(D: type, tableD: view ComponentTable(D), hit: view Query5Match) ret view D {
  ret view rae_ext_rae_buf_get(buf: tableD.denseData.data, index: hit.indexD)
}

func query5ViewE(E: type, tableE: view ComponentTable(E), hit: view Query5Match) ret view E {
  ret view rae_ext_rae_buf_get(buf: tableE.denseData.data, index: hit.indexE)
}

# ----- filters as plain functions (#807) -----------------------------------
#
# Deliberately NOT a composable query-builder object / mini-DSL (declined as a
# framework creeping in — docs/ecs-language-wishlist.md). Each filter is one
# plain function on the tables' existing data:
#
#   with T      -> `tagged(dataTable, tagTable)` above: entities in the data table
#                  that ALSO carry the tag. An O(smallest) join, nothing new.
#   without T   -> `without(dataTable, tagTable)` below: entities in the data
#                  table that do NOT carry the tag. A negation has to walk the
#                  whole data table (there is no smaller set to drive off), so it
#                  is O(|data|) with one O(1) sparse probe per entity.
#   changed     -> `changedSince(table, sinceGeneration)` below: per-ENTITY
#                  change-detection on the stamps every table already carries.

# Entities in `dataTable` that are NOT present in `tagTable`. Each match's
# `index` is the entity's dense slot in the DATA table (read/write it via
# forEachView / queryModAt by index); the tag has no payload.
func without(D: type, T: type, dataTable: view ComponentTable(D),
             tagTable: view ComponentTable(T)) ret List(QueryMatch) {
  let count: Int = componentCount(this: dataTable)
  let matches: List(QueryMatch) = createList(QueryMatch, cap: 16)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: dataTable, i: i)
    if componentIndexOf(this: tagTable, entity: entity) < 0 {
      matches.add(value: QueryMatch { entity: entity, index: i })
    }
  }
  ret matches
}

# ----- change-detection as a plain function (#807) -------------------------
#
# Per-ENTITY change-detection: the entities in `table` whose component was set
# or mutated (componentSet / componentMod / queryModAt) AFTER `sinceGeneration`.
# It reads the per-entity `denseStamps` the table already maintains (each stamp
# is the table generation at that entity's last write), so it needs no extra
# bookkeeping: a system records `componentTableGeneration(table)` when it
# finishes a run and passes that value next time to touch ONLY what moved.
# This complements Schedule's TABLE-level skip ("did any input change?") with
# the ENTITY-level filter ("which ones?"). O(n) over the table with no sparse
# lookups — the stamps are dense, aligned 1:1 with the data.
func changedSince(T: type, table: view ComponentTable(T), sinceGeneration: view Int) ret List(QueryMatch) {
  let count: Int = componentCount(this: table)
  let matches: List(QueryMatch) = createList(QueryMatch, cap: 16)
  loop var i: Int = 0, i < count, ++i {
    let stamp: Int = rae_ext_rae_buf_get(buf: table.denseStamps.data, index: i)
    if stamp > sinceGeneration {
      matches.add(value: QueryMatch { entity: componentEntityAt(this: table, i: i), index: i })
    }
  }
  ret matches
}
