# The walker app: the system list (WalkerApp.rae's header has the convention)
type WalkerApp {
  # #738: the ECS WalkerWorld — the authoritative gameplay world (EntityAllocator +
  # Transform3D/WorldTransform3D/Material3D tables); the character, crowd, terrain
  # and grass live here.
  settings: WalkerAppSettings
  # The world's terrain field (walkerBiome of the settings' land)
  biome: BiomeConfig
  world: WalkerWorld
  frame: WalkerFrame
  inputSystem: WalkerInput
  cameraSystem: WalkerCamera
  cameraStudy: CameraStudy = createCameraStudy()
  characterSystem: CharacterSystem
  terrainSystem: WalkerTerrain
  renderSystem: WalkerRender
  profiler: Profiler  # #764: was lib/profile.rae gProf* globals
  grassCompute: GrassCompute  # #764: was lib/GrassCompute.rae gGrass* globals
  physicsSystem: WalkerPhysics  # fixed-step sim seam (physics.rae, #553)
  # How it all started, for R and the menu's Reset (app3d/WalkerReset)
  walkerReset: WalkerReset
  # Footprints and what the steps kick up (app3d/WalkerMarks)
  walkerMarks: WalkerMarks
  netSeam: NetSeam  # multiplayer seam (app3d/NetSeam, #554)
  players: PlayerRoster  # who the local player controls (players.rae, #546)
  persist: WalkerPersist
  # The spray of wading feet (lib/water/WadeSplash) and the FFT sea at the
  # biome water plane (lib/water/IslandSea); none in a forward frame
  wadeSplash: opt WadeSplash
  waterSystem: opt WaterSystem
  idIssuer: IdIssuer  # the root's shared ID issuer (#869)
  gpuResources: opt GpuResources  # the app-owned GPU manager the sea and the grass compute live in (#873)
  ok: Bool
}

# ----- per-frame timing + resize -------------------------------------------
func beginWalkerFrame(app: mod WalkerApp) {
  Profile.tick(profiler: app.profiler)
  app.frame.resized = resizeUiToWindow(
    world: app.inputSystem.world
    uiSystems: app.inputSystem.uiSystems
    res: app.inputSystem.gpuUi
  )
  let now: Float64 = Gpu2d.nowSeconds()
  var deltaTime: Float = (now - app.frame.prevT) as Float
  app.frame.prevT = now
  app.frame.now = now
  # NO CLAMP before DRS: the scale controller reacts to the true frame time.
  updateRenderScale(drs: app.renderSystem.drs, deltaTime: deltaTime, profiler: app.profiler)
  setDynamicRenderScale(renderer: app.renderSystem.renderer, scale: app.renderSystem.drs.scale)
  # Negative dt is a clock going backwards, not a long frame; refuse it.
  if deltaTime < 0.0 {
    deltaTime = 0.0
  }
  app.frame.deltaTime = deltaTime
  if app.renderSystem.frameLogOn {
    frameLogUpdate(
      frameLog: app.renderSystem.frameLog
      deltaTime: deltaTime
      drs: app.renderSystem.drs
      renderer: app.renderSystem.renderer
    )
  }
}

# ----- update phase: input, UI, camera, character, terrain, grass, persist --
func updateWalkerApp(app: mod WalkerApp) {
  let deltaTime: Float = app.frame.deltaTime
  let now: Float64 = app.frame.now
  # Multiplayer seam (offline no-op today, #554): pull remote intents in before
  # the local sim; the matching publish runs after it, below.
  netApplyRemote(netSeam: app.netSeam, netPlayers: app.world.netPlayers)
  let uiTick: UiTick = uiUpdate(
    uiSystems: app.inputSystem.uiSystems
    cameraSystem: app.cameraSystem
    characterSystem: app.characterSystem
    didRealWork: app.frame.dbgDidWork
    inputSystem: app.inputSystem
    persist: app.persist
    players: app.players
    renderer: app.renderSystem.renderer
    terrainSystem: app.terrainSystem
    world: app.world
    deltaTime: deltaTime
    now: now
  )
  let settingsChanged: Bool = uiTick.settingsChanged
  let scrolled: Bool = uiTick.scrolled

  let camTick: CameraTick = cameraUpdate(
    uiSystems: app.inputSystem.uiSystems
    cameraSystem: app.cameraSystem
    inputSystem: app.inputSystem
    persist: app.persist
    world: app.world
    heroEntityId: controlledCharacter(controlled: app.world.controlled)
    terrainSystem: app.terrainSystem
    physicsSystem: app.physicsSystem
    deltaTime: deltaTime
  )
  let joyActive: Bool = camTick.joyActive
  let studyMoved: Bool = stepCameraStudy(
    study: app.cameraStudy
    rig: app.cameraSystem.rig
    camera: app.cameraSystem.camera
  )
  let cameraMoved: Bool = camTick.cameraMoved or studyMoved

  # Character switching (#546): Page Up / Page Down cycle who the local player
  # controls. On a switch, snap the orbit camera behind the new character.
  if app.cameraSystem.rig.mode is CameraRigMode.character {
    var switched: Bool = false
    if sdl3.isKeyPressed(key: Keys.keyPageDown) or sdl3.isKeyPressed(key: keyNextChar) {
      walkerSwitchControl(
        players: app.players
        world: app.world
        characterSystem: app.characterSystem
        step: 1
      )
      switched = true
    }
    if sdl3.isKeyPressed(key: Keys.keyPageUp) or sdl3.isKeyPressed(key: keyPrevChar) {
      walkerSwitchControl(
        players: app.players
        world: app.world
        characterSystem: app.characterSystem
        step: -1
      )
      switched = true
    }
    if switched {
      onCharacterSwitched(
        cameraSystem: app.cameraSystem
        inputSystem: app.inputSystem
        persist: app.persist
        players: app.players
        world: app.world
        characterSystem: app.characterSystem
      )
    }
  }

  rememberCharacterModels(world: app.world)
  var characterMoved: Bool = false
  let controlledEntityId: EntityId = rosterControlledEntityId(players: app.players)
  # Devices -> intent (input.rae), then the CONTROLLED character's mover gets it
  # as a throttle (and the jump); every other character stands. A remote
  # player's intent would arrive from net.rae instead; the drive is the same.
  var intent: InputIntent = {
    moveX: 0.0
    moveY: 0.0
    walking: false
    jump: false
    actions: 0
  }
  if app.cameraSystem.rig.mode is CameraRigMode.character {
    intent = inputUpdate(
      stick: app.inputSystem.touchStick
      allowKeys: uiPointerCaptured(input: app.inputSystem.ui) is false and app.characterSystem.playing
      jumpButton: uiActionFired(world: app.inputSystem.world, actionId: jumpActionId)
    )
  }
  # R, or the "..." menu's Reset: everything back as it started
  let resetKey: Bool = walkerResetKeyPressed() and uiPointerCaptured(input: app.inputSystem.ui) is false
  if takeModeMenuReset(menu: app.inputSystem.uiModes.modeMenu) or resetKey {
    resetWalkerToStart(
      walkerReset: app.walkerReset
      physicsSystem: app.physicsSystem
      world: app.world
      rig: app.cameraSystem.rig
      groundZ: app.characterSystem.groundZ
      heroEntityId: controlledEntityId
    )
    app.persist.stateDirty = true
    log("[reset] the walker back as it started")
  }
  # The controller's heading and position before the physics steps, to tell
  # whether the character moved this frame
  let before: Vec3 = controllerOf(controllers: app.world.controllers, entityId: controlledEntityId).position
  let headingBefore: Float = controllerOf(
    controllers: app.world.controllers
    entityId: controlledEntityId
  ).heading
  # The player's drive, and the crowd's own: walking about (app3d/Wander)
  driveWalkers(
    physicsSystem: app.physicsSystem
    controlledEntityId: controlledEntityId
    controllers: app.world.controllers
    controlled: app.world.controlled
    intent: intent
    cameraYaw: app.cameraSystem.rig.viewYaw
    speedScale: app.characterSystem.speed
    deltaTime: deltaTime
  )
  # Fixed-timestep physics (#553, lib/box3d/ecs): the movers, then the bodies,
  # at 60 Hz from the frame time, decoupled from render; it writes every
  # character's controller and every cube's Transform3D.
  let physicsSteps: Int = stepPhysicsFrame(
    physicsSystem: app.physicsSystem
    transforms: app.world.transforms
    controllers: app.world.controllers
    bushes: bushSpots(propKinds: app.world.propKinds, transforms: app.world.transforms)
    frameTime: deltaTime
  )
  let after: view ThirdPersonController = controllerOf(
    controllers: app.world.controllers
    entityId: controlledEntityId
  )
  characterMoved = physicsSteps > 0 and (after.position.x is not before.x or after.position.y is not before.y or after.position.z is not before.z or after.heading is not headingBefore)
  # The crowd's names over their heads (app3d/WalkerNames)
  updateCrowdNameLabels(
    world: app.world
    groundZ: app.characterSystem.groundZ
    modelHeight: app.characterSystem.modelHeight
  )
  # Whoever a bump knocked over falls as a ragdoll; whoever is down gets up
  # where they landed (app3d/WalkerKnockdown)
  walkerKnockdownUpdate(
    physicsSystem: app.physicsSystem
    world: app.world
    characterSystem: app.characterSystem
    controlledEntityId: controlledEntityId
    wantsUp: intent.moveX is not 0.0 or intent.moveY is not 0.0 or intent.jump
    deltaTime: deltaTime
  )
  # Every character on its feet leaves a print each stride (app3d/WalkerMarks)
  walkerMarksUpdate(
    walkerMarks: app.walkerMarks
    physicsSystem: app.physicsSystem
    world: app.world
    biome: app.biome
    groundZ: app.characterSystem.groundZ
    modelHeight: app.characterSystem.modelHeight
    deltaTime: deltaTime
  )
  # Every character's model follows its controller whenever the physics moved
  # it (one can be pushed or fall while the player drives another), and its
  # clip plays slowed in the air
  updateWalkerCharacters(
    world: app.world
    characterSystem: app.characterSystem
    physicsSystem: app.physicsSystem
  )
  if characterMoved {
    app.persist.stateDirty = true
  }
  # Every other character's clip follows its mover too, always: the crowd
  # walks about on its own, and kept the clip it was spawned with before
  stepOtherLocomotionClips(
    locomotion: app.world.locomotionClips
    animStates: app.world.animStates
    animTransitions: app.world.animTransitions
    characterSystem: app.characterSystem
    characters: app.physicsSystem.characters
    knockedDown: app.physicsSystem.knockedDown
    knocks: app.physicsSystem.knocks
    moverDrives: app.physicsSystem.moverDrives
    controlledEntityId: controlledEntityId
  )
  if app.cameraSystem.rig.mode is CameraRigMode.character {
    # The controlled character's clip follows its mover, by Rae's clip
    # machine (app3d/LocomotionClips: a takeoff into the jump clip, the speed
    # with hysteresis, held while a change blends in): the same for the hero
    # and any crowd member
    var tookOff: Bool = false
    if componentHas(this: app.physicsSystem.moverDrives, entityId: controlledEntityId) {
      tookOff = componentView(this: app.physicsSystem.moverDrives, entityId: controlledEntityId).tookOff
    }
    loop componentCount(this: app.world.locomotionClips) > 0 {
      componentRemove(
        this: app.world.locomotionClips
        entityId: componentEntityAt(this: app.world.locomotionClips, i: 0)
      )
    }
    componentSet(
      this: app.world.locomotionClips
      entityId: controlledEntityId
      data: LocomotionClip { jumpStarted: tookOff }
    )
    stepLocomotionClips(
      locomotion: app.world.locomotionClips
      animStates: app.world.animStates
      animTransitions: app.world.animTransitions
      characterSystem: app.characterSystem
      characters: app.physicsSystem.characters
      knockedDown: app.physicsSystem.knockedDown
      knocks: app.physicsSystem.knocks
    )
    let focusPos: Vec3 = controlledPosition(
      controllers: app.world.controllers
      controlled: app.world.controlled
    )
    # Or, while it lies knocked down, its body (app3d/CameraKnockdownFollow)
    app.cameraSystem.camera.target = stepKnockdownFollow(
      follow: app.cameraSystem.knockdownFollow
      knockedDown: app.physicsSystem.knockedDown
      transforms: app.world.transforms
      controlled: controlledEntityId
      controllerTarget: Vec3.create(x: focusPos.x, y: focusPos.y, z: focusPos.z + characterFocusZ)
      deltaTime: deltaTime
    )
  }
  let followPos: Vec3 = controlledPosition(
    controllers: app.world.controllers
    controlled: app.world.controlled
  )
  # The ground tiles stream round what the camera looks at (the character in
  # the game), so the editor camera sees ground under the trees wherever it
  # goes; the rocks and bushes, which have bodies, and the physics below stay
  # with the walker
  let terrainWrapped: Bool = updateInfiniteTerrain(
    terrainSystem: app.terrainSystem
    renderer: app.renderSystem.renderer
    propKinds: app.world.propKinds
    transforms: app.world.transforms
    groundFocus: app.cameraSystem.camera.target
    propFocus: followPos
  )
  # The reused rock entities moved: give them their new bodies
  if terrainWrapped {
    let rockCount: Int = placeRockBodies(
      physicsSystem: app.physicsSystem
      propKinds: app.world.propKinds
      transforms: app.world.transforms
    )
  }
  # The wide forest is far bigger than one physics ground: it follows the
  # walker, and the trunk pool stands on the trees nearest it
  if app.settings.land is WalkerLand.forest {
    let feet: Vec3 = Vec3.create(
      x: followPos.x
      y: followPos.y
      z: app.characterSystem.groundZ + followPos.z
    )
    let groundMoved: Bool = followGround(physicsSystem: app.physicsSystem, position: feet)
    let trunksMoved: Bool = updateTrunkPool(
      physicsSystem: app.physicsSystem
      transforms: app.world.transforms
      forest: app.terrainSystem.forest.field
      focus: feet
      force: false
    )
  }

  netPublishIntent(netSeam: app.netSeam)

  # Read in beginWalkerFrame: windowResized() is cleared on read, and reading it
  # again here always gave false, so a resize was never saved
  let resized: Bool = app.frame.resized
  if resized {
    app.persist.stateDirty = true
  }
  updateWindowGeometry(windowGeometry: app.persist.windowGeometry, now: now, resized: resized)

  if app.persist.stateDirty and not app.frame.headless {
    if (now - app.persist.lastStateSave) as Float >= 0.25 {
      writeHotReloadStateFor(
        appId: app.settings.appId
        state: serializeWalkerState(
          clipIndex: walkerClipOf(
            world: app.world
            entityId: rosterEntityAt(roster: app.players, index: 0)
          )
          playing: app.characterSystem.playing
          speed: app.characterSystem.speed
          toon: app.characterSystem.toon
          controller: controllerOf(
            controllers: app.world.controllers
            entityId: rosterEntityAt(roster: app.players, index: 0)
          )
          rig: app.cameraSystem.rig
          camera: app.cameraSystem.camera
        )
      )
      app.persist.lastStateSave = now
      app.persist.stateDirty = false
    }
  }
  # The settings panel's values and the mode, in their own slot, when they
  # changed (the running clock: twice a second at most)
  if not app.frame.headless and (now - app.persist.lastSettingsSave) as Float >= 0.5 {
    let settingsLine: String = serializeSettingsState(
      settingsState: app.inputSystem.settings
      editor: app.inputSystem.uiModes.editor
    )
    if settingsLine is not app.persist.settingsLine {
      writeHotReloadStateFor(
        appId: settingsStateSlot(appId: app.settings.appId)
        state: settingsLine
      )
      app.persist.settingsLine = settingsLine
    }
    app.persist.lastSettingsSave = now
  }

  let hadUiEvents: Bool = uiActionCount(world: app.inputSystem.world) > 0 or app.inputSystem.ui.pointer.down or app.inputSystem.ui.pointer.pressed or app.inputSystem.ui.pointer.released
  let logChanged: Bool = app.inputSystem.logOverlay.revision is not app.inputSystem.lastLogRevision
  let transitionActive: Bool = anyCharacterTransitionActive(world: app.world)
  # Live splash droplets are an animation source: keep rendering until the last one
  # dies out, or the wait-loop would freeze them mid-air when you stop wading (#84,
  # the "feed animation sources into the loop" lesson in AGENTS.md).
  var splashesAlive: Bool = false
  if let wadeSplash: view WadeSplash = app.wadeSplash {
    splashesAlive = wadeSplashAlive(wadeSplash: wadeSplash)
  }
  # Bodies still moving (a toppling stack, a character in the air) are an
  # animation source too; the venue's static body is never awake
  let physicsAwake: Bool = physicsCounters(physics: app.physicsSystem.physics).awakeBodyCount > 0 or characterMoved
  var needsRender: Bool = app.characterSystem.playing or transitionActive or settingsChanged or cameraMoved or characterMoved or terrainWrapped or splashesAlive or physicsAwake or hadUiEvents or logChanged or resized or scrolled or app.frame.renderedOnce is false
  if app.frame.taaSettleFrames > 0 {
    needsRender = true  # only meaningful with TAA on
  }
  app.frame.dbgDidWork = needsRender
  if needsRender {
    if app.inputSystem.settings.antialias is not SettingsAntialias.taa or app.settings.forward {
      # FXAA has no history to converge, and a forward frame (4x MSAA) is
      # final the moment it is drawn
      app.frame.taaSettleFrames = 0
    } else if app.characterSystem.playing or settingsChanged or cameraMoved or hadUiEvents or resized {
      app.frame.taaSettleFrames = 6
    } else {
      app.frame.taaSettleFrames = app.frame.taaSettleFrames - 1
    }
  }
  app.frame.needsRender = needsRender
}

# Move control `step` roster places on (+1 next, -1 previous): the character
# let go of stands idle, the Controlled tag moves with the roster
func walkerSwitchControl(
  players: mod PlayerRoster
  world: mod WalkerWorld
  characterSystem: mod CharacterSystem
  step: view Int
) {
  if rosterCount(roster: players) <= 1 {
    ret
  }
  animationBeginTransition(
    animStates: world.animStates
    animTransitions: world.animTransitions
    characterSystem: characterSystem
    entityId: controlledCharacter(controlled: world.controlled)
    clipIndex: ClipKind.idle as Int
    duration: clipTransitionDuration
    holdClipFirstFrame: false
  )
  rosterStep(roster: players, step: step)
  setControlledCharacter(
    controlled: world.controlled
    entityId: rosterControlledEntityId(players: players)
  )
}

# Every character's last model kept for its motion vectors, before the
# physics moves it
func rememberCharacterModels(world: mod WalkerWorld) {
  loop var i: Int = 0, i < componentCount(this: world.characterModels), ++i {
    let entityId: EntityId = componentEntityAt(this: world.characterModels, i: i)
    let models: mod CharacterModel = componentMod(this: world.characterModels, entityId: entityId)
    models.prevModel = models.model
  }
}

# Every character's model from its controller, and its clip's rate: on the
# ground a walk or run plays as fast as the character really moves
# (app3d/CharacterHeight groundSpeedClipScale), in the air slowed
func updateWalkerCharacters(
  world: mod WalkerWorld
  characterSystem: view CharacterSystem
  physicsSystem: view WalkerPhysics
) {
  loop var i: Int = 0, i < componentCount(this: world.characterModels), ++i {
    let entityId: EntityId = componentEntityAt(this: world.characterModels, i: i)
    let model: Mat4 = walkerCharacterModel(
      world: world
      characterSystem: characterSystem
      entityId: entityId
    )
    let models: mod CharacterModel = componentMod(this: world.characterModels, entityId: entityId)
    models.model = model
    if componentHas(this: world.animStates, entityId: entityId) {
      let anim: mod AnimationState = componentMod(this: world.animStates, entityId: entityId)
      anim.playbackScale = groundSpeedClipScale(
        clipIndex: anim.clipIndex
        speed: characterSpeed(characters: physicsSystem.characters, entityId: entityId)
        rate: clipPlaybackRate(clipIndex: anim.clipIndex)
        timeScale: characterSystem.speed
      )
      if characterGrounded(characters: physicsSystem.characters, entityId: entityId) is false {
        anim.playbackScale = airborneClipScale
      }
    }
  }
}

# The clip `entityId` plays (idle without an AnimationState)
func walkerClipOf(world: view WalkerWorld, entityId: view EntityId) ret Int {
  if componentHas(this: world.animStates, entityId: entityId) {
    ret componentView(this: world.animStates, entityId: entityId).clipIndex
  }
  ret ClipKind.idle as Int
}

# Is any character still blending out of a clip change (an animation source:
# the frame loop keeps drawing)?
func anyCharacterTransitionActive(world: view WalkerWorld) ret Bool {
  loop var i: Int = 0, i < componentCount(this: world.animTransitions), ++i {
    if transitionActive(transition: componentCopyAtDefault(this: world.animTransitions, i: i)) {
      ret true
    }
  }
  ret false
}
