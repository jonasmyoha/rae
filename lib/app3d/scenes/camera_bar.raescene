{
  "type": "Scene",
  "version": 2,
  "sceneId": "app3d-camera-bar",
  "root": "CameraBar",
  "nodes": {
    "CameraBar": {
      "Layout": { "type": "Horizontal", "gap": "spaceM", "alignCross": "Center" },
      "Padding": { "l": "spaceS", "t": "spaceS", "r": "spaceM", "b": "spaceS" },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Hug" } },
      "Shape": { "kind": "RoundedRect", "fill": "surface", "radius": "radiusCard" },
      "Children": [
        "CameraModeButton",
        "CameraSmoothMouseButton",
        "CameraSmoothKeysButton",
        "CameraFovLabel",
        "CameraPositionLabel",
        "CameraYawLabel",
        "CameraPitchLabel"
      ]
    },
    "CameraModeButton": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "camera.mode" },
      "Children": ["CameraModeLabel"]
    },
    "CameraModeLabel": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Text": { "text": "Orbit", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "CameraSmoothMouseButton": {
      "Rect": { "x": 0, "y": 0, "w": 92, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "camera.smoothMouse" },
      "Children": ["CameraSmoothMouseLabel"]
    },
    "CameraSmoothMouseLabel": {
      "Rect": { "x": 0, "y": 0, "w": 92, "h": 34 },
      "Text": { "text": "Mouse ~", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "CameraSmoothKeysButton": {
      "Rect": { "x": 0, "y": 0, "w": 84, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "camera.smoothKeys" },
      "Children": ["CameraSmoothKeysLabel"]
    },
    "CameraSmoothKeysLabel": {
      "Rect": { "x": 0, "y": 0, "w": 84, "h": 34 },
      "Text": { "text": "Keys ~", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "CameraFovLabel": {
      "Rect": { "x": 0, "y": 0, "w": 78, "h": 22 },
      "Text": { "text": "FOV 50°", "styleId": "muted" }
    },
    "CameraPositionLabel": {
      "Rect": { "x": 0, "y": 0, "w": 178, "h": 22 },
      "Text": { "text": "Pos 0, -12, 4", "styleId": "muted" }
    },
    "CameraYawLabel": {
      "Rect": { "x": 0, "y": 0, "w": 108, "h": 22 },
      "Text": { "text": "Yaw 0°", "styleId": "muted" }
    },
    "CameraPitchLabel": {
      "Rect": { "x": 0, "y": 0, "w": 122, "h": 22 },
      "Text": { "text": "Pitch 0°", "styleId": "muted" }
    }
  }
}
