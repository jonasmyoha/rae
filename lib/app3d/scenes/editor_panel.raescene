{
  "type": "Scene",
  "version": 2,
  "root": "UiRoot",
  "nodes": {
    "UiRoot": {
      "Rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "Children": [
        "ContentRow"
      ],
      "Layout": {
        "type": "Stack"
      }
    },
    "ContentRow": {
      "Layout": {
        "type": "Horizontal",
        "alignMain": "Start",
        "alignCross": "Start"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Fill"
        }
      },
      "Children": [
        "MainColumn",
        "SidePanel"
      ],
      "Padding": {
        "l": "spaceL",
        "t": "spaceL",
        "r": "spaceL",
        "b": "spaceL"
      }
    },
    "MainColumn": {
      "Layout": {
        "type": "Vertical",
        "alignMain": "SpaceBetween",
        "alignCross": "Start"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Fill"
        }
      },
      "Children": [
        "TopRow"
      ]
    },
    "TopRow": {
      "Layout": {
        "type": "Horizontal",
        "gap": "spaceS",
        "alignCross": "Center",
        "alignMain": "Start"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Padding": {
        "l": "spaceS",
        "t": "spaceS",
        "r": "spaceM",
        "b": "spaceS"
      },
      "Children": [
        "CornerMenuSlot",
        "CameraBarSlot"
      ]
    },
    "CornerMenuSlot": {
      "Size": {
        "w": {
          "mode": "Hug"
        },
        "h": {
          "mode": "Hug"
        }
      }
    },
    "CameraBarSlot": {
      "Rect": {
        "x": 246,
        "y": 24,
        "w": 774,
        "h": 52
      },
      "Size": {
        "w": {
          "mode": "Hug"
        },
        "h": {
          "mode": "Hug"
        }
      }
    },
    "SidePanel": {
      "Rect": {
        "x": 940,
        "y": 0,
        "w": 320,
        "h": 800
      },
      "Layout": {
        "type": "Vertical",
        "gap": "spaceS",
        "alignCross": "Stretch"
      },
      "Padding": {
        "l": "spaceM",
        "t": "spaceM",
        "r": "spaceM",
        "b": "spaceM"
      },
      "Shape": {
        "kind": "RoundedRect",
        "fill": "surface",
        "radius": "radiusCard"
      },
      "Children": [
        "SidePanelBody"
      ],
      "OnClick": {
        "actionId": "ui.surface"
      }
    },
    "SidePanelBody": {
      "Layout": {
        "type": "Vertical",
        "alignCross": "Stretch"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Fill"
        }
      },
      "Children": [
        "SidePanelContent"
      ],
      "Overflow": {
        "mode": "clip"
      }
    },
    "SidePanelContent": {
      "ScrollRoot": {
        "axis": "y",
        "floor": "content"
      },
      "Layout": {
        "type": "Vertical",
        "gap": "spaceS",
        "alignCross": "Stretch"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Children": [
        "SettingsDialogSlot"
      ]
    },
    "SettingsDialogSlot": {
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      }
    }
  }
}
