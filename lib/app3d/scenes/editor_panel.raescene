        "h": 44
      },
      "Size": {
        "w": {
          "mode": "Fixed"
        },
        "h": {
          "mode": "Fixed"
        }
      },
      "Shape": {
        "kind": "RoundedRect",
        "fill": "surface",
        "radius": 22
      },
      "OnClick": {
        "actionId": "modeMenu.toggle"
      },
      "Children": [
        "ModeLabel"
      ]
    },
    "ModeLabel": {
      "Rect": {
        "x": 0,
        "y": 0,
        "w": 44,
        "h": 44
      },
      "Text": {
        "text": "...",
        "styleId": "panelButton"
      },
      "OpticalAlign": {
        "centerX": true,
        "centerY": true
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Fill"
        }
      }
    },
    "ContextMenu": {
      "Layout": {
        "type": "Vertical",
        "gap": 4,
        "alignCross": "Stretch"
      },
      "Size": {
        "w": {
          "mode": "Fixed"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Rect": {
        "x": 0,
        "y": 0,
        "w": 300,
        "h": 120
      },
      "Padding": {
        "l": 8,
        "t": 8,
        "r": 8,
        "b": 8
      },
      "Shape": {
        "kind": "RoundedRect",
        "fill": "surface",
        "radius": "radiusCard"
      },
      "Active": {
        "value": false
      },
      "Children": [
        "MenuCameraItem"
      ]
    },
    "MenuCameraItem": {
      "Layout": {
        "type": "Horizontal",
        "alignCross": "Center"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Padding": {
        "l": 12,
        "t": 0,
        "r": 12,
        "b": 0
