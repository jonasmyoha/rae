      }
    },
    "AppPanelReadout": {
      "Rect": {
        "x": 0,
        "y": 0,
        "w": 260,
        "h": 16
      },
      "Text": {
        "text": "",
        "styleId": "panelButton"
      }
    },
    "AppPanelButtons": {
      "Layout": {
        "type": "Vertical",
        "gap": "spaceS",
        "alignCross": "Stretch"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Children": []
    },
    "SettingsTabColumn": {
      "Layout": {
        "type": "Vertical",
        "alignMain": "Center",
        "alignCross": "Center"
      },
      "Size": {
        "w": {
          "mode": "Hug"
        },
        "h": {
          "mode": "Fill"
        }
      },
      "Children": [
        "SettingsTabSlot"
      ]
    },
    "SettingsTabSlot": {
      "Size": {
        "w": {
          "mode": "Hug"
        },
        "h": {
          "mode": "Hug"
        }
      }
    },
    "SidePanelColumn": {
      "Layout": {
        "type": "Vertical",
        "alignMain": "Start",
        "alignCross": "Start"
      },
      "Size": {
        "w": {
          "mode": "Hug"
        },
        "h": {
          "mode": "Fill"
        }
      },
      "Padding": {
        "l": 0,
        "t": 90,
        "r": 0,
        "b": 0
      },
      "Children": [
        "SidePanel"
      ]
    },
    "MenuOverlay": {
      "Layout": {
        "type": "Vertical",
        "gap": 36,
        "alignMain": "Start",
        "alignCross": "End"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Fill"
        }
      },
