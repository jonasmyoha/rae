        "type": "Horizontal",
        "gap": "spaceS",
        "alignCross": "Center"
      },
      "Size": {
        "w": {
          "mode": "Hug"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Children": []
    },
    "AppPanel": {
      "Layout": {
        "type": "Vertical",
        "gap": "spaceS",
        "alignCross": "Stretch"
      },
      "Padding": {
        "l": "spaceS",
        "t": "spaceS",
        "r": "spaceS",
        "b": "spaceM"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      },
      "Children": [
