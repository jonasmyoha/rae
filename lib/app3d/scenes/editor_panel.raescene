      ]
    },
    "SettingsDialogSlot": {
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      }
    },
    "AppBar": {
      "Rect": {
        "x": 0,
        "y": 0,
        "w": 0,
        "h": 0
      },
