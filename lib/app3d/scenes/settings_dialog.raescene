{
  "type": "Scene",
  "version": 2,
  "sceneId": "app3d-settings-dialog",
  "root": "SettingsDialog",
  "nodes": {
    "SettingsDialog": {
      "Layout": { "type": "Vertical", "gap": "spaceM", "alignCross": "Stretch" },
      "Padding": { "l": "spaceM", "t": "spaceM", "r": "spaceM", "b": "spaceM" },
      "Size": { "w": { "mode": "Fixed", "value": 360 }, "h": { "mode": "Hug" } },
      "Shape": { "kind": "RoundedRect", "fill": "surface", "radius": "radiusCard" },
      "Children": [
        "SettingsTitleRow",
        "SettingsSceneRow",
        "SettingsSpeedRow",
        "SettingsSpeedButtons",
        "SettingsToonButton",
        "SettingsSkyRow",
        "SettingsTimeLabel",
        "SettingsTimeTrack"
      ]
    },

    "SettingsTitleRow": {
      "Layout": { "type": "Horizontal", "gap": "spaceM", "alignCross": "Center" },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Children": ["SettingsTitle", "SettingsCloseButton"]
    },
    "SettingsTitle": {
      "Rect": { "x": 0, "y": 0, "w": 240, "h": 30 },
      "Text": { "text": "Settings", "styleId": "panelButton" }
    },
    "SettingsCloseButton": {
      "Rect": { "x": 0, "y": 0, "w": 72, "h": 30 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.close" },
      "Children": ["SettingsCloseLabel"]
    },
    "SettingsCloseLabel": {
      "Rect": { "x": 0, "y": 0, "w": 72, "h": 30 },
      "Text": { "text": "Close", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },

    "SettingsSceneRow": {
      "Layout": { "type": "Horizontal", "gap": "spaceS", "alignCross": "Center" },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Children": ["SettingsScene1", "SettingsScene2", "SettingsScene3"]
    },
    "SettingsScene1": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "accent", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.scene.1" },
      "Children": ["SettingsScene1Label"]
    },
    "SettingsScene1Label": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Text": { "text": "Scene 1", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "SettingsScene2": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.scene.2" },
      "Children": ["SettingsScene2Label"]
    },
    "SettingsScene2Label": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Text": { "text": "Scene 2", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "SettingsScene3": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.scene.3" },
      "Children": ["SettingsScene3Label"]
    },
    "SettingsScene3Label": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Text": { "text": "Scene 3", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },

    "SettingsSpeedRow": {
      "Rect": { "x": 0, "y": 0, "w": 328, "h": 26 },
      "Text": { "text": "Animation speed 100%", "styleId": "muted" }
    },
    "SettingsSpeedButtons": {
      "Layout": { "type": "Horizontal", "gap": "spaceS", "alignCross": "Center" },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Children": ["SettingsSlower", "SettingsFaster"]
    },
    "SettingsSlower": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.anim.slower" },
      "Children": ["SettingsSlowerLabel"]
    },
    "SettingsSlowerLabel": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Text": { "text": "Slower", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "SettingsFaster": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.anim.faster" },
      "Children": ["SettingsFasterLabel"]
    },
    "SettingsFasterLabel": {
      "Rect": { "x": 0, "y": 0, "w": 104, "h": 34 },
      "Text": { "text": "Faster", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },

    "SettingsToonButton": {
      "Rect": { "x": 0, "y": 0, "w": 328, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.toon" },
      "Children": ["SettingsToonLabel"]
    },
    "SettingsToonLabel": {
      "Rect": { "x": 0, "y": 0, "w": 328, "h": 34 },
      "Text": { "text": "Toon shading", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },

    "SettingsSkyRow": {
      "Layout": { "type": "Horizontal", "gap": "spaceS", "alignCross": "Center" },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Children": ["SettingsSkyHosek", "SettingsSkyClassic"]
    },
    "SettingsSkyHosek": {
      "Rect": { "x": 0, "y": 0, "w": 160, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "accent", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.sky.hosek" },
      "Children": ["SettingsSkyHosekLabel"]
    },
    "SettingsSkyHosekLabel": {
      "Rect": { "x": 0, "y": 0, "w": 160, "h": 34 },
      "Text": { "text": "Sky: Hosek", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },
    "SettingsSkyClassic": {
      "Rect": { "x": 0, "y": 0, "w": 160, "h": 34 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "OnClick": { "actionId": "settings.sky.classic" },
      "Children": ["SettingsSkyClassicLabel"]
    },
    "SettingsSkyClassicLabel": {
      "Rect": { "x": 0, "y": 0, "w": 160, "h": 34 },
      "Text": { "text": "Sky: Classic", "styleId": "panelButton" },
      "OpticalAlign": { "centerX": true, "centerY": true }
    },

    "SettingsTimeLabel": {
      "Rect": { "x": 0, "y": 0, "w": 328, "h": 26 },
      "Text": { "text": "Time of day 12:00", "styleId": "muted" }
    },
    "SettingsTimeTrack": {
      "Rect": { "x": 0, "y": 0, "w": 328, "h": 18 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": "radiusPill" },
      "Children": ["SettingsTimeFill"]
    },
    "SettingsTimeFill": {
      "Rect": { "x": 0, "y": 0, "w": 164, "h": 18 },
      "Shape": { "kind": "RoundedRect", "fill": "accent", "radius": "radiusPill" }
    }
  }
}
