# app3d/SpriteBake — a picture of a prop for a billboard (GbufferSprite's
# textured, alpha-cut sprite pass): its mesh parts drawn from the side into
# an RGBA image, with see-through pixels wherever no part is. A far level of
# detail (app3d/PropField's sprite level) draws the picture instead of the
# meshes: one quad per prop.
#
# It is drawn on the CPU, once, with a plain triangle rasteriser and a depth
# buffer, so it needs no GPU pass and the same parts always give the same
# picture. The view looks along +y (from -y) with x to the right and z up,
# orthographic. The picture's bottom row is the prop's foot (z = 0) and its
# top row the prop's highest point; x = 0 is its middle column, and the
# picture is `aspect` times as wide as it is tall. A part's colour is lit by
# a fixed light from the upper left and the front, so the crown keeps its
# volume once the deferred pass lights the sprite (which faces its normal up).
#
#   let picture: SpritePicture = bakeSpritePicture(parts: meshes, colors: colors, width: 96,
#   height: 128, aspect: 0.75)
#   spriteInitArray(w: 96, h: 128, layers: 1, mips: spriteMipCount(w: 96, h: 128))
#   uploadSpritePicture(layer: 0, picture: picture, mips: spriteMipCount(w: 96, h: 128), cutoff:
#   0.5)
#   ...and the world height of the picture is picture.top (times the prop's scale)
import Math
import Vec3
open Mesh3d
open GbufferSprite

# One baked picture: its pixels (row by row from the top, each packed red +
# green * 256 + blue * 65536 + alpha * 16777216, the sprite array's layout),
# its size, and the height (in the parts' units) its top row stands for
type SpritePicture {
  pixels: List(Int)
  width: Int
  height: Int
  top: Float
}

# The light the picture is baked with: from the upper left, toward the eye
func spriteBakeLight() ret Vec3 {
  ret Vec3.vnorm(a: Vec3.create(x: -0.45, y: -0.55, z: 0.7))
}

# Pack a colour (0..1 each) and an alpha (0..255) into one sprite pixel
func spritePixel(color: view Vec3, alpha: view Int) ret Int {
  let red: Int = Math.min(a: Math.max(a: (color.x * 255.0 + 0.5).toInt(), b: 0), b: 255)
  let green: Int = Math.min(a: Math.max(a: (color.y * 255.0 + 0.5).toInt(), b: 0), b: 255)
  let blue: Int = Math.min(a: Math.max(a: (color.z * 255.0 + 0.5).toInt(), b: 0), b: 255)
  ret red + green * 256 + blue * 65536 + alpha * 16777216
}

# A vertex of a part: its position (8 floats per vertex: position, normal, uv)
func bakeVertex(mesh: view MeshData, index: view Int) ret Vec3 {
  let base: Int = index * 8
  ret Vec3.create(
    x: mesh.verts.copyAtFallback(index: base, fallback: 0.0)
    y: mesh.verts.copyAtFallback(index: base + 1, fallback: 0.0)
    z: mesh.verts.copyAtFallback(index: base + 2, fallback: 0.0)
  )
}

func bakeNormal(mesh: view MeshData, index: view Int) ret Vec3 {
  let base: Int = index * 8
  ret Vec3.create(
    x: mesh.verts.copyAtFallback(index: base + 3, fallback: 0.0)
    y: mesh.verts.copyAtFallback(index: base + 4, fallback: 0.0)
    z: mesh.verts.copyAtFallback(index: base + 5, fallback: 1.0)
  )
}

# The highest point of all the parts (at least a little above the foot)
func partsTop(parts: view List(MeshData)) ret Float {
  var top: Float = 0.001
  loop let mesh: view MeshData in parts {
    loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
      top = Math.max(a: top, b: bakeVertex(mesh: mesh, index: vertex).z)
    }
  }
  ret top
}

# The picture as it is being drawn: colours and the depth of what each pixel
# shows (smaller y is nearer the eye)
type SpriteCanvas {
  colors: List(Int)
  depths: List(Float)
  width: Int
  height: Int
  # Picture pixels per unit, and where x = 0 and z = 0 fall
  pixelsPerUnit: Float
  centreColumn: Float
  footRow: Float
}

# One triangle into the canvas, in `color` (already lit)
func bakeTriangle(
  canvas: mod SpriteCanvas
  first: view Vec3
  second: view Vec3
  third: view Vec3
  color: view Int
) {
  # Picture coordinates: column right, row down
  let ax: Float = canvas.centreColumn + first.x * canvas.pixelsPerUnit
  let ay: Float = canvas.footRow - first.z * canvas.pixelsPerUnit
  let bx: Float = canvas.centreColumn + second.x * canvas.pixelsPerUnit
  let by: Float = canvas.footRow - second.z * canvas.pixelsPerUnit
  let cx: Float = canvas.centreColumn + third.x * canvas.pixelsPerUnit
  let cy: Float = canvas.footRow - third.z * canvas.pixelsPerUnit
  let area: Float = (bx - ax) * (cy - ay) - (by - ay) * (cx - ax)
  if Math.abs(value: area) < 0.000001 {
    ret
  }
  let minColumn: Int = Math.max(
    a: Math.floor(x: Math.min(a: ax, b: Math.min(a: bx, b: cx))).toInt()
    b: 0
  )
  let maxColumn: Int = Math.min(
    a: Math.ceil(x: Math.max(a: ax, b: Math.max(a: bx, b: cx))).toInt()
    b: canvas.width - 1
  )
  let minRow: Int = Math.max(
    a: Math.floor(x: Math.min(a: ay, b: Math.min(a: by, b: cy))).toInt()
    b: 0
  )
  let maxRow: Int = Math.min(
    a: Math.ceil(x: Math.max(a: ay, b: Math.max(a: by, b: cy))).toInt()
    b: canvas.height - 1
  )
  loop var row: Int = minRow, row <= maxRow, ++row {
    let py: Float = row.toFloat() + 0.5
    loop var column: Int = minColumn, column <= maxColumn, ++column {
      let px: Float = column.toFloat() + 0.5
      # Barycentric weights: all the same sign inside the triangle
      let weightA: Float = ((bx - px) * (cy - py) - (by - py) * (cx - px)) / area
      let weightB: Float = ((cx - px) * (ay - py) - (cy - py) * (ax - px)) / area
      let weightC: Float = 1.0 - weightA - weightB
      if weightA >= 0.0 and weightB >= 0.0 and weightC >= 0.0 {
        let depth: Float = weightA * first.y + weightB * second.y + weightC * third.y
        let pixel: Int = row * canvas.width + column
        if depth < canvas.depths.copyAtFallback(index: pixel, fallback: 0.0) {
          canvas.depths.set(index: pixel, value: depth)
          canvas.colors.set(index: pixel, value: color)
        }
      }
    }
  }
}

# Bake the picture of `parts`, each in its colour (`colors`, same order),
# `width` x `height` pixels, `aspect` (its width over its height in the
# parts' units) wide.
func bakeSpritePicture(
  parts: view List(MeshData)
  colors: view List(Vec3)
  width: view Int
  height: view Int
  aspect: view Float
) ret SpritePicture {
  let top: Float = partsTop(parts: parts)
  var canvas: SpriteCanvas = {
    colors: List.create(Int, cap: width * height)
    depths: List.create(Float, cap: width * height)
    width: width
    height: height
    pixelsPerUnit: height.toFloat() / top
    centreColumn: width.toFloat() * 0.5
    footRow: height.toFloat()
  }
  # The picture is `aspect` units wide per unit of height: stretch the columns
  # so the whole width maps onto `width` pixels
  let columnScale: Float = width.toFloat() / (height.toFloat() * aspect)
  loop var pixel: Int = 0, pixel < width * height, ++pixel {
    canvas.colors.add(value: 0)
    canvas.depths.add(value: 1000000.0)
  }
  let light: Vec3 = spriteBakeLight()
  loop var part: Int = 0, part < parts.length, ++part {
    if let mesh: view MeshData = parts.viewAt(index: part) {
      let base: Vec3 = colors.copyAtFallback(
        index: part
        fallback: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      )
      var triangle: Int = 0
      loop triangle + 2 < mesh.indices.length {
        let first: Int = mesh.indices.copyAtFallback(index: triangle, fallback: 0)
        let second: Int = mesh.indices.copyAtFallback(index: triangle + 1, fallback: 0)
        let third: Int = mesh.indices.copyAtFallback(index: triangle + 2, fallback: 0)
        # The face's light from its vertices' normals, turned toward the eye
        # (leaves are two-sided)
        var normal: Vec3 = Vec3.vnorm(
          a: Vec3.vadd(
            a: bakeNormal(mesh: mesh, index: first)
            b: Vec3.vadd(
              a: bakeNormal(mesh: mesh, index: second)
              b: bakeNormal(mesh: mesh, index: third)
            )
          )
        )
        if normal.y > 0.0 {
          normal = Vec3.create(x: normal.x, y: -normal.y, z: normal.z)
        }
        let lit: Float = 0.62 + 0.48 * Math.max(a: Vec3.vdot(a: normal, b: light), b: 0.0)
        let color: Int = spritePixel(color: Vec3.vscale(a: base, s: lit), alpha: 255)
        var firstPoint: Vec3 = bakeVertex(mesh: mesh, index: first)
        var secondPoint: Vec3 = bakeVertex(mesh: mesh, index: second)
        var thirdPoint: Vec3 = bakeVertex(mesh: mesh, index: third)
        firstPoint.x = firstPoint.x * columnScale
        secondPoint.x = secondPoint.x * columnScale
        thirdPoint.x = thirdPoint.x * columnScale
        bakeTriangle(
          canvas: canvas
          first: firstPoint
          second: secondPoint
          third: thirdPoint
          color: color
        )
        triangle = triangle + 3
      }
    }
  }
  ret SpritePicture { pixels: own canvas.colors, width: width, height: height, top: top }
}

# ----- the mip chain ----------------------------------------------------
# A far billboard covers few screen pixels; sampled from the full picture it
# shimmers as it moves. The sprite array keeps a mip chain, each level half
# the one before (GbufferSprite's sampler blends between them).

# The next level's size: half, at least 1 (as the GPU sizes mip levels)
func spriteHalfSize(size: view Int) ret Int {
  ret Math.max(a: size / 2, b: 1)
}

# The picture at half its size. Each new pixel covers a block of the old
# ones: its alpha is their average (so the share of pixels the cutout keeps
# stays the same), and its colour is the average of the COVERED pixels,
# weighted by their alpha — see-through pixels hold no colour, and counting
# them would darken the outline.
func halveSpritePicture(picture: view SpritePicture) ret SpritePicture {
  let width: Int = spriteHalfSize(size: picture.width)
  let height: Int = spriteHalfSize(size: picture.height)
  var pixels: List(Int) = List.create(Int, cap: width * height)
  loop var row: Int = 0, row < height, ++row {
    let firstRow: Int = row * picture.height / height
    let lastRow: Int = Math.max(a: (row + 1) * picture.height / height, b: firstRow + 1)
    loop var column: Int = 0, column < width, ++column {
      let firstColumn: Int = column * picture.width / width
      let lastColumn: Int = Math.max(a: (column + 1) * picture.width / width, b: firstColumn + 1)
      var red: Int = 0
      var green: Int = 0
      var blue: Int = 0
      var alpha: Int = 0
      var count: Int = 0
      loop var sourceRow: Int = firstRow, sourceRow < lastRow, ++sourceRow {
        loop var sourceColumn: Int = firstColumn, sourceColumn < lastColumn, ++sourceColumn {
          let pixel: Int = picture.pixels.copyAtFallback(
            index: sourceRow * picture.width + sourceColumn
            fallback: 0
          )
          let pixelAlpha: Int = pixel / 16777216 % 256
          red = red + pixel % 256 * pixelAlpha
          green = green + pixel / 256 % 256 * pixelAlpha
          blue = blue + pixel / 65536 % 256 * pixelAlpha
          alpha = alpha + pixelAlpha
          count = count + 1
        }
      }
      if alpha is 0 {
        pixels.add(value: 0)
      } else {
        let averageAlpha: Int = (alpha + count / 2) / count
        pixels.add(
          value: (red + alpha / 2) / alpha + (green + alpha / 2) / alpha * 256 + (blue + alpha / 2) / alpha * 65536 + averageAlpha * 16777216
        )
      }
    }
  }
  ret SpritePicture { pixels: own pixels, width: width, height: height, top: picture.top }
}

# Upload `picture` and its first `mips` - 1 halvings as levels 0 .. mips - 1
# of layer `layer` of the sprite array (made with spriteInitArray and the
# same `mips`)
# The share of a picture's pixels whose alpha reaches `cutoff` (0..1): what
# an alpha cut at `cutoff` keeps
func pictureCoverage(picture: view SpritePicture, cutoff: view Float) ret Float {
  if picture.pixels.length is 0 {
    ret 0.0
  }
  let limit: Int = (cutoff * 255.0 + 0.5).toInt()
  var kept: Int = 0
  loop let pixel: view Int in picture.pixels {
    if pixel / 16777216 % 256 >= limit {
      kept = kept + 1
    }
  }
  ret kept.toFloat() / picture.pixels.length.toFloat()
}

# `picture` with every alpha times `scale` (0..255). A level halved from a
# picture of 0 / 255 alphas holds only a few alpha values, so one scale moves
# all pixels of a value across the cut at once; a fixed jitter of under two
# steps per pixel breaks those ties, so the kept share can be set finely.
func scaledAlphaPicture(picture: view SpritePicture, scale: view Float) ret SpritePicture {
  var pixels: List(Int) = List.create(Int, cap: picture.pixels.length)
  loop var i: Int = 0, i < picture.pixels.length, ++i {
    let pixel: Int = picture.pixels.copyAtFallback(index: i, fallback: 0)
    let alpha: Int = pixel / 16777216 % 256
    if alpha is 0 {
      pixels.add(value: pixel)
      continue
    }
    let jitter: Float = ((i * 2654435761) % 1000).toFloat() / 1000.0 * 3.0 - 1.5
    let scaled: Int = Math.min(
      a: Math.max(a: (alpha.toFloat() * scale + jitter + 0.5).toInt(), b: 1)
      b: 255
    )
    pixels.add(value: pixel % 16777216 + scaled * 16777216)
  }
  ret SpritePicture {
    pixels: own pixels
    width: picture.width
    height: picture.height
    top: picture.top
  }
}

# A mip level whose alpha cut at `cutoff` keeps `coverage` (the full
# picture's share) as nearly as its pixels can (Castano, "Computing alpha
# mipmaps", 2010): averaging alpha blurs a crown's gaps and edges, so a
# plain cut at a coarse level keeps a different share (a dense crown turns
# solid, a sparse one thins). Its alpha is scaled by the factor, found by
# bisection, that brings the kept share to the full picture's.
func coveragePreservingLevel(
  level: view SpritePicture
  coverage: view Float
  cutoff: view Float
) ret SpritePicture {
  var low: Float = 0.0
  var high: Float = 8.0
  loop var step: Int = 0, step < 20, ++step {
    let middle: Float = (low + high) * 0.5
    if pictureCoverage(picture: scaledAlphaPicture(picture: level, scale: middle), cutoff: cutoff) < coverage {
      low = middle
    } else {
      high = middle
    }
  }
  # Of the two ends, the one whose share is nearer
  let below: Float = pictureCoverage(
    picture: scaledAlphaPicture(picture: level, scale: low)
    cutoff: cutoff
  )
  let above: Float = pictureCoverage(
    picture: scaledAlphaPicture(picture: level, scale: high)
    cutoff: cutoff
  )
  if Math.abs(value: below - coverage) < Math.abs(value: above - coverage) {
    ret scaledAlphaPicture(picture: level, scale: low)
  }
  ret scaledAlphaPicture(picture: level, scale: high)
}

# The picture and its first `mips` - 1 halvings, each level's alpha scaled
# so a cut at `cutoff` keeps the full picture's share. Each level is halved
# from the previous level BEFORE its scaling, so no scale compounds.
func spriteMipChain(
  picture: view SpritePicture
  mips: view Int
  cutoff: view Float
) ret List(SpritePicture) {
  var chain: List(SpritePicture) = List.create(SpritePicture, cap: Math.max(a: mips, b: 1))
  chain.add(value: picture)
  let coverage: Float = pictureCoverage(picture: picture, cutoff: cutoff)
  var raw: SpritePicture = picture
  loop var mip: Int = 1, mip < mips, ++mip {
    raw = halveSpritePicture(picture: raw)
    chain.add(value: coveragePreservingLevel(level: raw, coverage: coverage, cutoff: cutoff))
  }
  ret chain
}

# Upload `picture` and its coverage-preserving mip chain (spriteMipChain,
# for an alpha cut at `cutoff`) as levels 0 .. mips - 1 of layer `layer` of
# the sprite array (made with spriteInitArray and the same `mips`)
func uploadSpritePicture(
  layer: view Int
  picture: view SpritePicture
  mips: view Int
  cutoff: view Float
) {
  let chain: List(SpritePicture) = spriteMipChain(picture: picture, mips: mips, cutoff: cutoff)
  loop var mip: Int = 0, mip < chain.length, ++mip {
    if let level: view SpritePicture = chain.viewAt(index: mip) {
      spriteUploadLayer(
        layer: layer
        mip: mip
        pixels: level.pixels.data
        w: level.width
        h: level.height
      )
    }
  }
}
