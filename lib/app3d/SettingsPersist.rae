# app3d/SettingsPersist — the settings panel's values kept across a hot
# reload: every value the panel shows (play/pause, the rendering,
# antialiasing and quality switches, the sky, the sun, the moons and the
# eclipse, the exposure, the clock, the date and the place, the panel open
# or closed) and whether the app is in EDITOR mode. They are `name=value`
# words on one line in their own HotReload slot (settingsStateSlot), beside
# the app's own state. A name the line lacks keeps the value the app
# started with, so a line from an older build restores what it has.
#
# An environment variable that sets a value (RAE_QUALITY, RAE_SKY,
# RAE_ECLIPSE, ... for screenshots) wins over the saved one.
import Math
import String
import Sys
open CloudTier
open Calendar
open app3d/SettingsDialog
open app3d/SettingsSky
open app3d/SettingsWeather
open app3d/SettingsWind
open ui/UiValues

# The HotReload slot of an app's settings
func settingsStateSlot(appId: view String) ret String {
  ret "{appId}Settings"
}

# The sky model named `name` (its case name), else `fallback`
func settingsSkyNamed(name: view String, fallback: view SettingsSkyModel) ret SettingsSkyModel {
  loop var i: Int = 0, i < 4, ++i {
    if (i as SettingsSkyModel).toString() is name {
      ret i as SettingsSkyModel
    }
  }
  ret fallback
}

# The quality step named `name`, else `fallback`
func settingsQualityNamed(name: view String, fallback: view SettingsQuality) ret SettingsQuality {
  loop var i: Int = 0, i < 4, ++i {
    if (i as SettingsQuality).toString() is name {
      ret i as SettingsQuality
    }
  }
  ret fallback
}

# The antialiasing named `name`, else `fallback`
func settingsAntialiasNamed(
  name: view String
  fallback: view SettingsAntialias
) ret SettingsAntialias {
  loop var i: Int = 0, i < 3, ++i {
    if (i as SettingsAntialias).toString() is name {
      ret i as SettingsAntialias
    }
  }
  ret fallback
}

func settingsFlag(value: view Bool) ret String {
  if value {
    ret "1"
  }
  ret "0"
}

# The line: the panel's values and the mode (`editor`)
func serializeSettingsState(settingsState: view SettingsState, editor: view Bool) ret String {
  let clock: String = "hour={settingsState.timeOfDay.hour} day={settingsState.timeOfDay.dayOfYear} year={settingsState.timeOfDay.year} animateTime={settingsFlag(
    value: settingsState.animateTime
  )} latitude={settingsState.latitude} longitude={settingsState.longitude} yearSpeed={settingsState.timeOfDay.yearSpeed} weather={settingsState.weatherOverride.toString()} wind={settingsState.windOverride.toString()} weatherValues={settingsWeatherValuesText(
    values: settingsState.values
  )}"
  let rendering: String = "toon={settingsFlag(value: settingsState.toon)} clouds={cloudOptionsName(
    options: settingsState.clouds
  )} cloudSteps={settingsState.clouds.steps} cloudShadows={settingsFlag(
    value: settingsState.clouds.shadows
  )} shadows={settingsFlag(value: settingsState.shadows)} antialias={settingsState.antialias.toString()} quality={settingsState.quality.toString()}"
  let light: String = "sky={settingsState.skyModel.toString()} sunLux={settingsState.sunNoonLux} exposure={settingsState.exposureCompensation} autoExposure={settingsFlag(
    value: settingsState.autoExposure
  )} moon={settingsFlag(value: settingsState.moon)} moons={settingsState.moonCount} eclipse={settingsState.eclipse}"
  let panel: String = "editor={settingsFlag(value: editor)} open={settingsFlag(
    value: settingsState.open
  )} playing={settingsFlag(value: settingsState.playing)} scene={settingsState.scene}"
  ret "{panel} {rendering} {light} {clock}"
}

# The weather's numbers on the saved line: cloud, rain, snow, mist, wind,
# storm and the clouds' kind, cirrus, height and size, comma-separated
# (app3d/SettingsWeather's keys, settingsWeatherValueKeys)
func settingsWeatherValuesText(values: view UiValues) ret String {
  var text: String = ""
  let keys: List(String) = settingsWeatherValueKeys()
  loop var i: Int = 0, i < keys.length, ++i {
    if i > 0 {
      text = "{text},"
    }
    text = "{text}{uiValue(values: values, key: keys.copyAtDefault(index: i), fallback: 0.0)}"
  }
  ret text
}

# The saved line's keys, in its order
func settingsWeatherValueKeys() ret List(String) {
  ret List(String) {
    weatherCloudKey
    weatherRainKey
    weatherSnowKey
    weatherMistKey
    windSpeedKey
    weatherStormKey
    weatherCloudTypeKey
    weatherCirrusKey
    weatherCloudHeightKey
    weatherCloudScaleKey
  }
}

# The numbers of a saved line (or RAE_WALKER_WEATHER_VALUES) back into
# `values`: five (before the storm was saved), six (before the clouds'
# shape was) or ten; any other count is left as it was
func settingsWeatherValuesRestore(values: mod UiValues, text: view String) {
  let parts: List(String) = text.split(sep: ",")
  if parts.length is not 5 and parts.length is not 6 and parts.length is not 10 {
    ret
  }
  let keys: List(String) = settingsWeatherValueKeys()
  loop var i: Int = 0, i < parts.length, ++i {
    let changed: Bool = setUiValue(
      values: values
      key: keys.copyAtDefault(index: i)
      value: parts.copyAtDefault(index: i).toFloat()
    )
  }
}

# Is the value `name` set by an environment variable for this run
func settingsEnvSets(name: view String) ret Bool {
  ret Sys.getEnv(name: name).length() > 0
}

# Put a saved line back into `settingsState` and `editor`. False when there
# is no line.
func restoreSettingsState(
  raw: view String
  settingsState: mod SettingsState
  editor: mod Bool
) ret Bool {
  let line: String = raw.trim()
  if line.length() is 0 {
    ret false
  }
  # a jump to an eclipse sets the clock, the date and the place
  let eclipseSet: Bool = settingsEnvSets(name: "RAE_ECLIPSE")
  loop let word: String in line.split(sep: " ") {
    let parts: List(String) = word.split(sep: "=")
    if parts.length is not 2 {
      continue
    }
    let name: String = parts.copyAtDefault(index: 0)
    let value: String = parts.copyAtDefault(index: 1)
    let flag: Bool = value is "1"
    if name is "editor" and not settingsEnvSets(name: "RAE_UI_MODE") {
      editor = flag
    } else if name is "open" and not settingsEnvSets(name: "RAE_SETTINGS_OPEN") {
      settingsState.open = flag
    } else if name is "playing" {
      settingsState.playing = flag
    } else if name is "scene" {
      settingsState.scene = Math.clamp(val: value.toInt(), low: 1, high: settingsState.sceneCount)
    } else if name is "toon" {
      settingsState.toon = flag
    } else if name is "clouds" and not settingsEnvSets(name: "RAE_CLOUD_TIER") {
      if let chosen: CloudOptions = cloudOptionsNamed(name: value, options: settingsState.clouds) {
        settingsState.clouds = chosen
      }
    } else if name is "cloudSteps" and value.toInt() > 0 {
      settingsState.clouds.steps = value.toInt()
    } else if name is "cloudShadows" {
      settingsState.clouds.shadows = flag
    } else if name is "shadows" {
      settingsState.shadows = flag
    } else if name is "antialias" {
      settingsState.antialias = settingsAntialiasNamed(
        name: value
        fallback: settingsState.antialias
      )
    } else if name is "quality" and not settingsEnvSets(name: "RAE_QUALITY") {
      settingsState.quality = settingsQualityNamed(name: value, fallback: settingsState.quality)
    } else if name is "sky" and not settingsEnvSets(name: "RAE_SKY") {
      settingsState.skyModel = settingsSkyNamed(name: value, fallback: settingsState.skyModel)
    } else if name is "sunLux" and not settingsEnvSets(name: "RAE_SUN_LUX") {
      settingsState.sunNoonLux = value.toFloat()
    } else if name is "yearSpeed" {
      settingsState.timeOfDay.yearSpeed = value.toFloat()
    } else if name is "weather" {
      settingsState.weatherOverride = settingsWeatherNamed(
        name: value
        fallback: settingsState.weatherOverride
      )
      settingsWeatherPresetToValues(
        values: settingsState.values
        override: settingsState.weatherOverride
      )
    } else if name is "wind" {
      settingsState.windOverride = settingsWindNamed(
        name: value
        fallback: settingsState.windOverride
      )
      settingsWindPresetToValues(values: settingsState.values, override: settingsState.windOverride)
    } else if name is "weatherValues" {
      settingsWeatherValuesRestore(values: settingsState.values, text: value)
    } else if name is "exposure" {
      settingsState.exposureCompensation = value.toFloat()
    } else if name is "autoExposure" {
      settingsState.autoExposure = flag
    } else if name is "moon" {
      settingsState.moon = flag
    } else if name is "moons" and not settingsEnvSets(name: "RAE_MOONS") {
      settingsState.moonCount = Math.clamp(val: value.toInt(), low: 1, high: settingsMoonsMax)
    } else if eclipseSet is false {
      restoreSettingsClock(settingsState: settingsState, name: name, value: value)
    }
  }
  # the date read with its year (a 29 February)
  settingsState.timeOfDay.dayOfYear = clampDayOfYear(
    year: settingsState.timeOfDay.year
    dayOfYear: settingsState.timeOfDay.dayOfYear
  )
  ret true
}

# The clock, the date, the place and the eclipse: one saved word
func restoreSettingsClock(settingsState: mod SettingsState, name: view String, value: view String) {
  if name is "eclipse" {
    settingsState.eclipse = Math.max(a: value.toInt(), b: -1)
  } else if name is "hour" {
    settingsState.timeOfDay.hour = Math.clamp(val: value.toFloat(), low: 0.0, high: 23.999)
  } else if name is "day" {
    settingsState.timeOfDay.dayOfYear = value.toInt()
  } else if name is "year" {
    settingsState.timeOfDay.year = value.toInt()
  } else if name is "animateTime" {
    settingsState.animateTime = value is "1"
  } else if name is "latitude" {
    settingsState.latitude = Math.clamp(val: value.toFloat(), low: -90.0, high: 90.0)
  } else if name is "longitude" {
    settingsState.longitude = Math.clamp(val: value.toFloat(), low: -180.0, high: 180.0)
  }
}
