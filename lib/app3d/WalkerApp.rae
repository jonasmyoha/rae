# app3d/WalkerApp — the walker app shell: 136 (the island, deferred), 137 (the
# island, forward) and 143 (the wide forest, deferred) are each a Main.rae
# that calls runWalkerApp with its WalkerAppSettings (app3d/WalkerAppSetup).
#
# CONVENTION (#822): the `WalkerApp` struct IS the system list. Each system's
# member is named for what it is and typed as that system's state —
# `cameraSystem: WalkerCamera`, `renderSystem: WalkerRender`, `physicsSystem:
# WalkerPhysics`, `inputSystem: WalkerInput`, … — so reading the fields reads
# the systems. Cross-cutting DATA and resources stay data-typed: the per-frame
# `frame: WalkerFrame` scratch, the ECS `world: WalkerWorld`, the `players:
# PlayerRoster` control roster, and pure resources (`profiler: Profiler`,
# `grassCompute: GrassCompute`). Each system function takes the NARROW state
# it needs, never the whole app; the app is built by createWalkerApp and
# sequenced by updateWalkerApp (app3d/WalkerAppUpdate) and renderWalkerApp
# (app3d/WalkerRenderWalk).
import Math
import Profile
import Gpu2d
import Quat
open app3d/UiModes
open app3d/EditorPanel
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
import Vec3
import Sys
open GbufferInstanced
open Particles
open water/WadeSplash
open water/Water
open GbufferSprite
open water/WaterSystem
open water/IslandSea
open WorldBiome
open water/WaterFft
open gpu/GpuResources
open gpu/GpuLifetime
open GrassCompute
import GrassConfig
import app3d/Slider
open Scene3d
open RendererDeferred
open Sky
open Gbuffer
open Rendergraph
open Math3d
open Mesh3d
open Gltf
open GltfSkin
open SdfText
open Png
open app3d/CameraRig
open app3d/CameraWalkFollow
open app3d/CharacterController
open app3d/SettingsDialog
open ui/Registry
open SkyHosek
open app3d/UiShell
open app3d/ControlPanel
open app3d/CameraBar
open Shadow3d
open app3d/Playback
open HotReload
open ui/LogOverlay
open ui/WindowGeometry
open ui/scrollRootSystem/ScrollRootSystem
open ui/EventLoop
open ui/DebugOverlay
open ui/VirtualJoystick
open ui/Ecs
open ui/Components
open ui/inputSystem/InputSystem
open ui/renderSystem/RenderSystem
open app3d/RenderScale
open ui/UiSystems
open app3d/WalkerCharacter
open app3d/Characters
open app3d/PlayerRoster
open app3d/WalkerPhysics
open app3d/WalkerWorld
open app3d/WalkerInput
open app3d/WalkerCamera
open app3d/WalkerUi
open app3d/HudOverlays
open app3d/WalkerNet
open app3d/WalkerTerrain
open app3d/WalkerTerrainBodies
open app3d/IslandForest
open app3d/WalkerAppSetup
open app3d/WalkerRender
open app3d/WalkerRenderWalk
open app3d/WalkerAppUpdate
open app3d/WalkerSplash
open app3d/WalkerState
open app3d/WalkerSelfTest
open RendererForward
open Moon
open Calendar

# The app's GPU manager (#873): with the sea, its three 256 cascades with
# their mip chains, readbacks and surface (192, as the downstream game sizes
# its sea), plus what the rest of the walker keeps there; without, the grass
# compute alone
const walkerGpuCapacityWithSea: Int = 288

const walkerGpuCapacity: Int = 96

# ----- setup ---------------------------------------------------------------
func createWalkerApp(settings: view WalkerAppSettings) ret WalkerApp {
  unsafe {
    Gpu2d.initWindow(width: 1280, height: 800, title: settings.title)
    var idIssuer: IdIssuer = IdIssuer.create()
    var windowGeometry: WindowGeometry = createWindowGeometry(
      dir: dir()
      name: "window.{settings.appId}.geometry"
    )
    restoreWindowGeometry(windowGeometry: windowGeometry)
    let extentW: Float = windowExtentW()
    let extentH: Float = windowExtentH()
    Gpu2d.setDesignResolution(width: extentW, height: extentH, fit: 0)

    var moveStick: VirtualJoystick = createVirtualJoystick(
      padFracX: 0.06
      padFracY: 0.11
      radiusFrac: 0.14
    )

    let assets: String = settings.assets
    let biome: BiomeConfig = walkerBiome(land: settings.land)
    let gpuUi: Gpu2dUi = loadUiAssets(
      dir: assets
      textFontName: "Roboto-Regular"
      iconFontName: ""
      themeFile: "Theme.raescene"
    )
    var uiWorld: UiWorld = create()
    var uiSystems: UiSystems = createUiSystems()
    # #764: install the app's theme (palette + scene tokens) onto this world.
    seedWorldTheme(world: uiWorld, res: gpuUi)
    let uiRoot: EntityId = mountUiScene(
      world: uiWorld
      uiSystems: uiSystems
      path: "{assets}ui.raescene"
      res: gpuUi
    )
    let uiModes: UiModes = createUiModes(
      world: uiWorld
      uiSystems: uiSystems
      path: "{assets}ui.raescene"
    )
    var uiInput: UiInput = createUiInput()
    var logOverlay: LogOverlay = createLogOverlay(
      capacity: 64
      maxLines: 8
      anchor: logAnchorBottomLeft
      fontSize: 14.0
    )
    var dbg: DebugOverlay = createDebugOverlay(
      button: true
      fps: true
      memory: true
      heartbeat: false
    )
    let reloadGen: Int = nextReloadGeneration()
    logInfoLine(ov: logOverlay, text: "hot reload {reloadGen}")

    let g: Glb = loadGlb(path: "{assets}walker.glb")
    if g.ok is false {
      log("[gltf] {g.errorMsg}")
      log("[gltf] regenerate assets/walker.glb — see tools/README.md")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }
    let charData: MeshData = loadAllPrimitives(glb: g)
    if charData.vertCount is 0 {
      log("[gltf] model contained no readable primitives")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }
    log("[gltf] walker: {charData.vertCount} verts, {charData.indices.length / 3} triangles")

    let b: List(Float) = meshBounds(meshData: charData)
    let height: Float = walkerFloatAt(values: b, index: 4) - walkerFloatAt(values: b, index: 1)
    let targetHeight: Float = 2.0
    var modelScale: Float = 1.0
    if height > 0.0 {
      modelScale = targetHeight / height
    }
    let midX: Float = (walkerFloatAt(values: b, index: 0) + walkerFloatAt(values: b, index: 3)) * 0.5
    let midZ: Float = (walkerFloatAt(values: b, index: 2) + walkerFloatAt(values: b, index: 5)) * 0.5
    let footY: Float = walkerFloatAt(values: b, index: 1)
    log("[gltf] bounds height {height}, scale {modelScale}")

    var sk: Skeleton = loadSkeleton(glb: g, skinIndex: 0)
    if sk.ok is false {
      log("[gltf] walker.glb has no skin — cannot animate")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }
    log("[gltf] skeleton: {jointCount(sk: sk)} joints, {sk.nodeCount} nodes")

    let idleGlb: Glb = loadGlb(path: "{assets}idle.glb")
    let walkGlb: Glb = loadGlb(path: "{assets}walk.glb")
    let runGlb: Glb = loadGlb(path: "{assets}run.glb")
    let idleClip: Clip = loadClip(glb: idleGlb, animIndex: 0, sk: sk)
    let walkClip: Clip = loadClip(glb: walkGlb, animIndex: 0, sk: sk)
    let runClip: Clip = loadClip(glb: runGlb, animIndex: 0, sk: sk)
    let bindPose: SkeletonPose = captureSkeletonPose(sk: sk)
    log(
      "[anim] idle {clipChannelCount(c: idleClip)} ch / {idleClip.duration}s, walk {clipChannelCount(
        c: walkClip
      )} ch / {walkClip.duration}s, run {clipChannelCount(c: runClip)} ch / {runClip.duration}s"
    )

    let groundZ: Float = -1.0
    var characterController: ThirdPersonController = createThirdPersonController()
    # #739: the WalkerWorld holds the hero + crowd as entities; built here so
    # createWalkerApp can populate it, then moved into the app below.
    var walkerWorld: WalkerWorld = createWalkerWorld()

    # #745: quat rotation, not Euler Vec3. The model is authored Z-up-rotated by
    # +pi/2 about X; as a quat that is fromAxisAngle(X, pi/2). transform3dToMatrix
    # (T*R*S) matches the old modelMatrix for this single-axis case exactly.
    let partTransform: Transform3D = {
      position: Vec3.create(
        x: -midX * modelScale
        y: -midZ * modelScale
        z: groundZ - footY * modelScale
      )
      rotation: Quat.fromAxisAngle(axis: Vec3.create(x: 1.0, y: 0.0, z: 0.0), angle: 1.5707963)
      scale: Vec3.create(x: modelScale, y: modelScale, z: modelScale)
    }
    let basePartModel: Mat4 = transform3dToMatrix(t: partTransform)
    groundWalker(controller: characterController, groundZ: groundZ, biome: biome)

    var light: Light3d = defaultLight3d()
    # #905/#921: the renderer owns the mesh + skin stores the walker parts,
    # terrain / grass / water meshes are uploaded into, so it exists first.
    # The forward one: one 4x MSAA pass (docs/forward-msaa-study.md), with
    # SSAO fed by a 1x depth + normal pre-pass (forward-rae-6).
    var renderer: DeferredRenderer = createDeferredRendererWithUi()
    if settings.forward {
      renderer = createForwardRendererWithSsao(withUi: true)
      log("[render] path: forward (4x MSAA) with SSAO")
    }

    let pngBytes: List(Int) = Sys.readFileBytes(path: "{assets}walker_palette.png")
    var atlasW: Int = 0
    var atlasH: Int = 0
    let atlas: List(Int) = decodePng(
      png: pngBytes
      len: pngBytes.length
      width: atlasW
      height: atlasH
    )
    if atlasW is 0 {
      log("[png] walker_palette.png did not decode — parts will render untinted")
    } else {
      log("[png] palette atlas {atlasW}x{atlasH}")
    }

    # #740: each skinned body-mesh part is an ENTITY carrying a PartRoughness
    # {meshId, roughness} component — no parallel partIds/partRough Lists. The
    # renderer iterates the part table (query). firstPartId seeds the crowd
    # instance batch's capacity mesh.
    var firstPartId: Int = 0
    var haveFirstPart: Bool = false
    loop var mi: Int = 0, mi < meshCount(glb: g), ++mi {
      let name: String = meshName(glb: g, meshIndex: mi)
      var rough: Float = 0.68
      if name.startsWith(prefix: "Cylinder") {
        rough = 0.35
      }
      loop var pi: Int = 0, pi < primitiveCount(glb: g, meshIndex: mi), ++pi {
        let raw: SkinnedMeshData = loadSkinnedPrimitive(glb: g, meshIndex: mi, primIndex: pi)
        if raw.vertCount > 0 {
          let part: SkinnedMeshData = withAtlasColors(
            m: raw
            atlas: atlas
            width: atlasW
            height: atlasH
          )
          let handle: MeshHandle = uploadSkinnedMesh(
            renderer: renderer
            verts: part.verts
            vertCount: part.vertCount
            indices: part.indices
          )
          if meshHandleIsValid(h: handle) {
            let partEntityId: EntityId = walkerWorldAddEntity(world: walkerWorld)
            walkerWorldSetPartRoughness(
              world: walkerWorld
              entityId: partEntityId
              part: PartRoughness { meshId: handle.id, roughness: rough }
            )
            if haveFirstPart is false {
              firstPartId = handle.id
              haveFirstPart = true
            }
          }
        }
      }
    }
    let partCount: Int = walkerWorldPartCount(world: walkerWorld)
    log("[gltf] skinned parts: {partCount}")
    if partCount is 0 {
      log("[gltf] no skinned primitives uploaded")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }

    setWalkerTerrainShader(renderer: renderer, forward: settings.forward, biome: biome)
    var terrainSystem: WalkerTerrain = createWalkerTerrain(
      renderer: renderer
      allocator: walkerWorld.allocator
      transforms: walkerWorld.transforms
      propKinds: walkerWorld.propKinds
      assets: assets
      gridSide: walkerGridSide(land: settings.land)
      groundZ: groundZ
      biome: biome
      forest: walkerForestSettings(land: settings.land)
    )

    let cloneCount: Int = walkerCrowdCount
    let firstPart: MeshHandle = meshHandle(id: firstPartId, generation: 1)
    # One skinned instance batch for every character, the hero's and the crowd's
    var characterBatch: InstanceBatch = createInstanceBatch(
      mesh: firstPart
      capacity: 1 + cloneCount
    )
    # The physics cubes: one unit box, scaled per cube (app3d/WalkerPhysics)
    let cubeMesh: MeshHandle = uploadMeshDataForTerrain(
      renderer: renderer
      mesh: makeBox(size: 1.0)
    )
    var cubeBatch: InstanceBatch = createInstanceBatch(mesh: cubeMesh, capacity: 64)

    var camera: Camera3d = defaultCamera3d()
    let hosekData: HosekDataset = loadDefaultHosekDataset()
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: groundZ + targetHeight * 0.5)

    let gs: Int = compileDeferred(renderer: renderer)
    if gs is not 0 {
      log("render graph invalid: {statusName(status: gs)}")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }

    var rig: CameraRig = createCameraRig(camera: camera)
    rig.characterModeEnabled = true
    rig.mode = CameraRigMode.character
    rig.yaw = characterController.heading
    rig.orbitPitch = 0.24
    rig.distance = 4.2
    rig.minDistance = 1.2
    rig.maxDistance = 20.0
    rig.wheelSpeed = 0.4
    camera.target = thirdPersonCameraTarget(
      controller: characterController
      focusZ: characterFocusZ
    )
    snapCameraRigView(rig: rig)
    # Screenshot camera (#857): RAE_CAMERA_AT (or RAE_WALKER_CAMERA), so a
    # headless frame can look elsewhere than the spawn (app3d/CameraRig)
    applyCameraStartOverride(rig: rig, camera: camera)
    # #744: express the camera rig as an ECS parent relation (rig entity -> camera
    # entity) in the WalkerWorld; applyCameraRigHierarchy resolves the eye each frame.
    let rigLink: CameraRigLink = createCameraRigLink(world: walkerWorld)

    var clipIndex: Int = 0
    var playing: Bool = true
    var speed: Float = 1.0
    var toonShading: Bool = true

    var clipPanel: ControlPanel = createClipPanel(
      world: uiWorld
      uiSystems: uiSystems
      gpuUi: gpuUi
    )
    var transport: ControlPanel = createTransportPanel(
      world: uiWorld
      uiSystems: uiSystems
      gpuUi: gpuUi
    )
    var charPanel: ControlPanel = createCharacterPanel(
      world: uiWorld
      uiSystems: uiSystems
      gpuUi: gpuUi
      characterCount: 1 + cloneCount
    )

    let headless: Bool = Sys.getEnv(name: "RAE_SDL_HEADLESS_MS").length() > 0 or Sys.getEnv(
      name: "RAE_HEADLESS_FRAMES"
    ).length() > 0
    if not headless {
      let saved: String = readHotReloadStateFor(appId: settings.appId)
      if restoreWalkerState(
        raw: saved
        clipIndex: clipIndex
        playing: playing
        speed: speed
        toon: toonShading
        controller: characterController
        rig: rig
        camera: camera
      ) {
        let pctR: Int = speedPercent(value: speed)
        logInfoLine(
          ov: logOverlay
          text: "state restored: clip {clipIndex}, speed {pctR}%, camera and window kept"
        )
      }
    }

    # Nobody starts in the sea. The origin is not guaranteed land — the island mask
    # only guarantees land is SOMEWHERE inside the radius.
    spawnOnLand(controller: characterController, groundZ: groundZ, biome: biome)
    let treeCount: Int = plantWalkerForest(
      land: settings.land
      terrainSystem: terrainSystem
      world: walkerWorld
      spawnX: characterController.position.x
      spawnY: characterController.position.y
    )

    # #739: the hero is an entity like any crowd member (app3d/Characters): its
    # controller, transform, clip, transition and model are components; the
    # Controlled tag says the player drives it.
    let heroEntityId: EntityId = walkerWorldAddEntity(world: walkerWorld)
    walkerWorldSetController(
      world: walkerWorld
      entityId: heroEntityId
      controller: characterController
    )
    walkerWorldSetTransform(
      world: walkerWorld
      entityId: heroEntityId
      transform: controllerTransform3D(controller: characterController)
    )

    var crowdEntities: List(EntityId) = spawnWalkerCrowd(
      world: walkerWorld
      hero: characterController
      biome: biome
      groundZ: groundZ
      count: cloneCount
    )
    walkerWorldSetAnim(
      world: walkerWorld
      entityId: heroEntityId
      anim: AnimationState { clipIndex: clipIndex, animTime: 0.0, playbackScale: 1.0 }
    )
    addWalkerCharacterComponents(
      world: walkerWorld
      entityId: heroEntityId
      skeleton: sk
      basePartModel: basePartModel
    )
    loop let crowdEntityId: view EntityId in crowdEntities {
      addWalkerCharacterComponents(
        world: walkerWorld
        entityId: crowdEntityId
        skeleton: sk
        basePartModel: basePartModel
      )
    }
    setControlledCharacter(controlled: walkerWorld.controlled, entityId: heroEntityId)
    updateInfiniteTerrain(
      terrainSystem: terrainSystem
      renderer: renderer
      propKinds: walkerWorld.propKinds
      transforms: walkerWorld.transforms
      playerPosition: characterController.position
    )
    var physicsSystem: WalkerPhysics = createWalkerAppPhysics(
      land: settings.land
      biome: biome
      groundZ: groundZ
      world: walkerWorld
      terrainSystem: terrainSystem
      hero: characterController
      heroEntityId: heroEntityId
      crowdEntities: crowdEntities
    )
    # #746: exercise the physics/net ECS seams once at startup — spawn/despawn via
    # generational entities, step a Box3D body. Leaves the world untouched.
    seamSelfTest(world: walkerWorld, physicsSystem: physicsSystem)
    if rig.mode is CameraRigMode.character {
      camera.target = thirdPersonCameraTarget(
        controller: characterController
        focusZ: characterFocusZ
      )
    }

    setPanelSelection(
      panel: clipPanel
      world: uiWorld
      group: 1
      id: (clipIndex as ClipKind).toString()
    )
    setPanelButtonOn(
      panel: transport
      world: uiWorld
      id: "play"
      on: playing
    )
    setPanelButtonOn(
      panel: transport
      world: uiWorld
      id: "toon"
      on: toonShading
    )
    var playLabel0: String = "Pause"
    if not playing {
      playLabel0 = "Play"
    }
    setPanelButtonLabel(
      panel: transport
      world: uiWorld
      id: "play"
      label: playLabel0
    )
    let pct0: Int = speedPercent(value: speed)
    setNodeText(world: uiWorld, nodeId: "SpeedLabel", value: "Speed {pct0}%")
    runUiSystems(world: uiWorld, uiSystems: uiSystems, res: gpuUi)

    # The scene authors a `ScrollRoot` on SidePanelContent (the Hug content
    # inside the clipped SidePanelBody); the lib system seeds its state, and
    # the floor is the laid-out overflow.
    var panelScrollMemory: ScrollMemory = createScrollMemory()
    scrollRootSystem(world: uiWorld, uiSystems: uiSystems, memory: panelScrollMemory)
    var panelScroll: EntityId = findScrollRoot(world: uiWorld, uiSystems: uiSystems)
    # RAE_WALKER_HOUR overrides the start hour (19.5: sunset, 23: night), so a
    # headless frame can look at the scene at any time of day
    var startHour: Float = 12.0
    let hourSetting: String = Sys.getEnv(name: "RAE_WALKER_HOUR")
    if hourSetting.length() > 0 {
      startHour = hourSetting.toFloat()
    }
    var settingsState: SettingsState = createSettingsState(
      scene: 1
      sceneCount: 1
      speed: speed
      toon: toonShading
      hour: startHour
      skyModel: SettingsSkyModel.preetham
    )
    settingsState.timeOfDay.daySeconds = walkerDaySeconds
    # RAE_WALKER_DAY overrides the start day of the year (1..366; 193 in 1995
    # is a full moon), so a headless frame can look at any phase
    let daySetting: String = Sys.getEnv(name: "RAE_WALKER_DAY")
    if daySetting.length() > 0 {
      settingsState.timeOfDay.dayOfYear = clampDayOfYear(
        year: settingsState.timeOfDay.year
        dayOfYear: daySetting.toInt()
      )
    }
    let startMoon: MoonState = settingsMoon(settingsState: settingsState)
    log(
      "[moon] {moonPhaseName(moon: startMoon)}, {(startMoon.illumination * 100.0).toInt()}% lit, up {startMoon.up}, light {settingsMoonLight(
        settingsState: settingsState
      )}, direction {startMoon.direction.x} {startMoon.direction.y} {startMoon.direction.z}"
    )
    # Default FXAA, the settings pane toggles TAA; a forward frame has 4x MSAA
    # and no TAA
    if not settings.forward {
      setTaaEnabled(renderer: renderer, on: settingsState.taa)
    }
    # The camera bar, the settings panel's edge tab (in the slot between the
    # main column and the panel) and the settings (app3d/EditorPanel)
    let chromeMounted: Bool = mountEditorChrome(world: uiWorld, uiSystems: uiSystems, res: gpuUi)
    if chromeMounted is false {
      logWarnLine(ov: logOverlay, text: "editor chrome failed to mount")
    }
    hideCameraSmoothingToggles(world: uiWorld)
    settingsApplyToWorld(settingsState: settingsState, world: uiWorld, uiSystems: uiSystems)
    applyEditorPanelOpen(world: uiWorld, open: settingsState.open)
    setRendererSky(
      renderer: renderer
      sky: settingsBuildSky(
        settingsState: settingsState
        data: hosekData
        turbidity: 3.0
        groundAlbedo: 0.30
      )
    )
    light.sunDir = settingsKeyLightDir(settingsState: settingsState)
    light.sunColor = settingsKeyLightColor(settingsState: settingsState)
    log(
      "[ui] panel buttons: {clipPanel.buttonEntities.length} clip, {transport.buttonEntities.length} transport, editor chrome {chromeMounted}"
    )

    let startT: Float64 = Gpu2d.nowSeconds()
    var drs: RenderScaleController = createRenderScaleController(targetFps: 60.0)

    # #905: the renderer owns the mesh store the water grid and the particle
    # quad are uploaded into, so both systems are built before it moves into
    # the app.
    var wadeSplash: opt WadeSplash = none
    var waterSystem: opt WaterSystem = none
    var gpuCapacity: Int = walkerGpuCapacity
    if walkerHasSea(settings: settings) {
      wadeSplash = createWadeSplash(renderer: renderer, cap: 256)
      waterSystem = createWaterSystem(
        renderer: renderer
        body: createIslandSea(renderer: renderer, groundZ: groundZ, biome: biome)
      )
      gpuCapacity = walkerGpuCapacityWithSea
    }
    # The GPU grass grows on the world's terrain: its compute shader gets the
    # world's island radius
    var grassCompute: GrassCompute = createGrassCompute()
    grassSetComputeShaderWithConstants(
      grass: grassCompute
      shader: defaultGrassComputeShader()
      constants: islandConstantsFor(cfg: biome)
    )
    # Who the local player may control, in switching order: the hero, then
    # its crowd
    var rosterEntities: List(EntityId) = List.create(EntityId, cap: 1 + crowdEntities.length)
    rosterEntities.add(value: heroEntityId)
    loop let crowdEntityId: view EntityId in crowdEntities {
      rosterEntities.add(value: crowdEntityId)
    }
    ret WalkerApp {
      settings: settings
      biome: biome
      world: own walkerWorld
      frame: {
        deltaTime: 0.0
        now: startT
        startT: startT
        prevT: startT
        time: 0.0
        aspect: 1.0
        needsRender: true
        dbgDidWork: true
        taaSettleFrames: 0
        renderedOnce: false
        headless: headless
        resized: false
      }
      inputSystem: {
        moveStick: own moveStick
        ui: own uiInput
        world: own uiWorld
        uiSystems: own uiSystems
        gpuUi: gpuUi
        clipPanel: own clipPanel
        transport: own transport
        charPanel: own charPanel
        settings: own settingsState
        panelScroll: panelScroll
        dbg: own dbg
        uiModes: own uiModes
        logOverlay: own logOverlay
        lastLogRevision: -1
        moonItemText: ""
      }
      cameraSystem: {
        camera: camera
        rig: own rig
        light: light
        hosek: hosekData
        rigEntityId: rigLink.rigEntityId
        cameraEntityId: rigLink.cameraEntityId
        walkFollow: createWalkFollow()
      }
      characterSystem: {
        leftFootNode: wadeFootNode(skeleton: sk, name: "mixamorig:LeftToeBase")
        rightFootNode: wadeFootNode(skeleton: sk, name: "mixamorig:RightToeBase")
        skeleton: own sk
        idleClip: idleClip
        walkClip: walkClip
        runClip: runClip
        jumpClip: runClip
        runningJumpClip: runClip
        bindPose: bindPose
        playing: playing
        speed: speed
        toon: toonShading
        basePartModel: basePartModel
        characterBatch: own characterBatch
        groundZ: groundZ
      }
      terrainSystem: own terrainSystem
      renderSystem: {
        renderer: own renderer
        drs: own drs
        shadowLogged: false
        cubeBatch: own cubeBatch
      }
      profiler: Profile.createProfiler()
      grassCompute: own grassCompute
      physicsSystem: own physicsSystem
      netSystem: { role: 0, tick: 0 }
      players: createPlayerRoster(entities: own rosterEntities)
      persist: { windowGeometry: own windowGeometry, lastStateSave: startT, stateDirty: false }
      wadeSplash: own wadeSplash
      waterSystem: own waterSystem
      idIssuer: own idIssuer
      gpuResources: GpuResources.create(issuer: idIssuer, capacity: gpuCapacity)
      ok: true
    }
  }
}

# ----- the loop ------------------------------------------------------------
func runWalkerApp(settings: view WalkerAppSettings) ret Int {
  var app: WalkerApp = createWalkerApp(settings: settings)
  # #739/#740/#741: the WalkerWorld holds the hero + crowd (controllers), the
  # skinned body parts (PartRoughness), and the terrain props + heightfield tiles
  # (TerrainProp) — all recycled ECS entities.
  log(
    "[ecs] WalkerWorld: {walkerWorldEntityCount(world: app.world)} entities ({walkerWorldPartCount(
      world: app.world
    )} parts + hero + crowd + terrain)"
  )
  if let wadeSplash: mod WadeSplash = app.wadeSplash {
    prepareSplashPreview(
      wadeSplash: wadeSplash
      cameraSystem: app.cameraSystem
      biome: app.biome
      groundZ: app.characterSystem.groundZ
    )
  }
  Profile.maybeAutoStart(profiler: app.profiler)
  # RAE_WALKER_PHYSICS_TEST=1: drive the hero into a cube stack and jump, check
  # the trunks, rocks and bushes, report and quit (app3d/WalkerSelfTest),
  # instead of the window loop. RAE_WALKER_SPLASH_TEST=1: the wading spray's
  # pose check (app3d/WalkerSplash), where there is a sea.
  let physicsTest: Bool = Sys.getEnv(name: "RAE_WALKER_PHYSICS_TEST").length() > 0
  let splashTest: Bool = Sys.getEnv(name: "RAE_WALKER_SPLASH_TEST").length() > 0
  var exitCode: Int = 0
  if splashTest {
    exitCode = 1
    if let wadeSplash: mod WadeSplash = app.wadeSplash {
      exitCode = runSplashPoseTest(
        characterSystem: app.characterSystem
        world: app.world
        wadeSplash: wadeSplash
      )
    }
  }
  if physicsTest {
    exitCode = runWalkerSelfTest(
      physicsSystem: app.physicsSystem
      world: app.world
      forest: app.terrainSystem.forest
      pooledTrunks: app.settings.land is WalkerLand.forest
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    )
  }
  loop not physicsTest and not splashTest and not Gpu2d.pollClose() {
    beginWalkerFrame(app: app)
    updateWalkerApp(app: app)
    if Gpu2d.shouldRenderFrame(appNeedsRender: app.frame.needsRender) is false {
      # Park until the OS has something to say (shared policy, lib/ui/event_loop).
      Gpu2d.waitEvents(timeoutSec: nextWaitTimeoutSec(
        visible: Gpu2d.renderableNow()
        animating: false
        mouseDown: false
        pollWatcher: false
        frameSec: 0.016667
        heartbeatSec: 1.0
      ))
    } else {
      if let resources: mod GpuResources = app.gpuResources {
        renderWalkerApp(
          uiSystems: app.inputSystem.uiSystems
          cameraSystem: app.cameraSystem
          characterSystem: app.characterSystem
          frame: app.frame
          inputSystem: app.inputSystem
          renderSystem: app.renderSystem
          world: app.world
          physicsSystem: app.physicsSystem
          terrainSystem: app.terrainSystem
          wadeSplash: app.wadeSplash
          waterSystem: app.waterSystem
          biome: app.biome
          resources: resources
          profiler: app.profiler
          grassCompute: app.grassCompute
        )
      }
    }
    # Frame end: report the authored components no lib table matched (this app
    # has no tables of its own) and recycle the indices of destroyed entities.
    uiFrameEnd(world: app.inputSystem.world, uiSystems: app.inputSystem.uiSystems)
  }
  if let resources: mod GpuResources = app.gpuResources {
    grassShutdown(grass: app.grassCompute, resources: resources)
    if let waterSystem: mod WaterSystem = app.waterSystem {
      waterShutdown(waterSystem: waterSystem, resources: resources)
    }
    spriteShutdown(cache: app.terrainSystem.sprites, resources: resources)
    shutdown(resources: resources)
  }
  shutdownDeferredRenderer(renderer: app.renderSystem.renderer)  # #904: the renderer-owned GPU manager, before the C shutdown
  destroyPhysicsSystem(physicsSystem: app.physicsSystem)
  shutdown()
  Gpu2d.closeWindow()
  ret exitCode
}
