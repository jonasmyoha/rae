# app3d/WalkerCrowdTest — the walker's crowd check (RAE_WALKER_PHYSICS_TEST=1,
# after the other checks): for 20 s the crowd walks about on its own
# (app3d/Wander: each member walks off, reaches spots, stops between them);
# then the hero runs at a crowd member standing still, and the bump knocks
# over the one standing (app3d/CharacterContact: the one doing less of the
# pushing), not the hero, and it lies there walkerCrowdDownSeconds (15 s)
# before it gets up. While they walk about, each one's clip must show
# what it does (a walk or run clip while it moves, idle while it stands: the
# crowd once kept its spawn clip and slid). One [crowdtest] line; true when
# all held.
import Math
import Vec3
open ecs/Entity
open ecs/ComponentTable
open WorldBiome
open app3d/CharacterController
open app3d/CharacterBodies
open app3d/Characters
open app3d/Wander
open app3d/WalkerWorld
open app3d/WalkerPhysics
open app3d/WalkerPhysicsChecks
open app3d/WalkerTerrainBodies
open app3d/WalkerKnockdown
open app3d/LocomotionClips

# Frames of the crowd's walk about (20 s), and of the hero's run (3 s)
const crowdTestWalkFrames: Int = 1200

const crowdTestRunFrames: Int = 180

# The walk-and-stop check's range round each one (m)
const crowdTestWanderRange: Float = 10.0

# Off the ground field (the forest's: it follows the walker): a crowd member
# placed this far past the field's centre and sent this far on walks there
# for this many frames on the terrain's own height
const crowdTestFarOff: Float = 400.0

const crowdTestFarWalk: Float = 30.0

const crowdTestFarFrames: Int = 600

func crowdTestFrame(
  physicsSystem: mod WalkerPhysics
  world: mod WalkerWorld
  characterSystem: mod CharacterSystem
  heroEntityId: view EntityId
  intent: view InputIntent
  yaw: view Float
  wanders: view Bool
) {
  let step: Float = 1.0 / 60.0
  if wanders {
    driveWalkers(
      physicsSystem: physicsSystem
      controlledEntityId: heroEntityId
      controllers: world.controllers
      controlled: world.controlled
      intent: intent
      cameraYaw: yaw
      speedScale: 1.0
      deltaTime: step
    )
  } else {
    driveCharacters(
      physicsSystem: physicsSystem
      controlledEntityId: heroEntityId
      controllers: world.controllers
      intent: intent
      cameraYaw: yaw
      speedScale: 1.0
    )
  }
  let steps: Int = stepPhysicsFrame(
    physicsSystem: physicsSystem
    transforms: world.transforms
    controllers: world.controllers
    bushes: bushSpots(propKinds: world.propKinds, transforms: world.transforms)
    frameTime: step
  )
  walkerKnockdownUpdate(
    physicsSystem: physicsSystem
    world: world
    characterSystem: characterSystem
    controlledEntityId: heroEntityId
    wantsUp: false
    deltaTime: step
  )
  stepOtherLocomotionClips(
    locomotion: world.locomotionClips
    animStates: world.animStates
    animTransitions: world.animTransitions
    characterSystem: characterSystem
    characters: physicsSystem.characters
    knockedDown: physicsSystem.knockedDown
    knocks: physicsSystem.knocks
    moverDrives: physicsSystem.moverDrives
    controlledEntityId: heroEntityId
  )
  # Every character's clock, as the app's render phase steps it: a clip
  # change is held until its blend has run
  loop var i: Int = 0, i < componentCount(this: world.animStates), ++i {
    let entityId: EntityId = componentEntityAt(this: world.animStates, i: i)
    if componentHas(this: world.animTransitions, entityId: entityId) is false {
      continue
    }
    stepCharacterClock(
      anim: componentMod(this: world.animStates, entityId: entityId)
      transition: componentMod(this: world.animTransitions, entityId: entityId)
      playing: true
      speed: 1.0
      rate: 1.0
      deltaTime: step
    )
  }
}

# Does the clip `entityId` shows match what it does: a walk or run clip while
# it moves, idle while it stands? (No clip counts as matching.)
func clipShowsMotion(world: view WalkerWorld, entityId: view EntityId) ret Bool {
  if componentHas(this: world.animStates, entityId: entityId) is false {
    ret true
  }
  let clip: Int = componentView(this: world.animStates, entityId: entityId).clipIndex
  let moving: Bool = controllerOf(controllers: world.controllers, entityId: entityId).moving
  let walkingClip: Bool = clip is ClipKind.walk or clip is ClipKind.walkFast or clip is ClipKind.run
  if moving {
    ret walkingClip
  }
  ret clip is ClipKind.idle
}

func runWalkerCrowdTest(
  physicsSystem: mod WalkerPhysics
  world: mod WalkerWorld
  characterSystem: mod CharacterSystem
  heroEntityId: view EntityId
) ret Bool {
  # ----- the crowd walks about -------------------------------------------------
  let count: Int = componentCount(this: physicsSystem.wandering.wanderers)
  var starts: List(Vec3) = List.create(Vec3, cap: count)
  var farthest: List(Float) = List.create(Float, cap: count)
  var stoodFrames: List(Int) = List.create(Int, cap: count)
  var arrivalsBefore: Int = 0
  var clipFrames: Int = 0
  var clipMatches: Int = 0
  # The walk-and-stop check on a short range round where each stands (its
  # walks over the whole land take minutes); the land's range back after it
  var homes: List(Vec3) = List.create(Vec3, cap: count)
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: physicsSystem.wandering.wanderers, i: i)
    let wanderer: mod Wanderer = componentMod(
      this: physicsSystem.wandering.wanderers
      entityId: entityId
    )
    homes.add(value: Vec3.create(x: wanderer.homeX, y: wanderer.homeY, z: wanderer.range))
    let standsAt: Vec3 = controllerOf(controllers: world.controllers, entityId: entityId).position
    wanderer.homeX = standsAt.x
    wanderer.homeY = standsAt.y
    wanderer.range = crowdTestWanderRange
  }
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: physicsSystem.wandering.wanderers, i: i)
    starts.add(value: controllerOf(controllers: world.controllers, entityId: entityId).position)
    farthest.add(value: 0.0)
    stoodFrames.add(value: 0)
    arrivalsBefore = arrivalsBefore + componentCopyAtDefault(
      this: physicsSystem.wandering.wanderers
      i: i
    ).arrivals
  }
  let still: InputIntent = standingIntent()
  loop var frame: Int = 0, frame < crowdTestWalkFrames, ++frame {
    crowdTestFrame(
      physicsSystem: physicsSystem
      world: world
      characterSystem: characterSystem
      heroEntityId: heroEntityId
      intent: still
      yaw: 0.0
      wanders: true
    )
    loop var i: Int = 0, i < count, ++i {
      let entityId: EntityId = componentEntityAt(this: physicsSystem.wandering.wanderers, i: i)
      let at: Vec3 = controllerOf(controllers: world.controllers, entityId: entityId).position
      let start: Vec3 = starts.copyAtFallback(index: i, fallback: at)
      let gone: Float = Math.sqrt(
        x: (at.x - start.x) * (at.x - start.x) + (at.y - start.y) * (at.y - start.y)
      )
      farthest.set(
        index: i
        value: Math.max(a: farthest.copyAtFallback(index: i, fallback: 0.0), b: gone)
      )
      if controllerOf(controllers: world.controllers, entityId: entityId).moving is false {
        stoodFrames.set(index: i, value: stoodFrames.copyAtFallback(index: i, fallback: 0) + 1)
      }
      clipFrames = clipFrames + 1
      if clipShowsMotion(world: world, entityId: entityId) {
        clipMatches = clipMatches + 1
      }
    }
  }
  var arrivals: Int = 0 - arrivalsBefore
  var leastGone: Float = 1000.0
  var leastStood: Int = 1000000
  loop var i: Int = 0, i < count, ++i {
    arrivals = arrivals + componentCopyAtDefault(this: physicsSystem.wandering.wanderers, i: i).arrivals
    leastGone = Math.min(a: leastGone, b: farthest.copyAtFallback(index: i, fallback: 0.0))
    leastStood = Math.min(a: leastStood, b: stoodFrames.copyAtFallback(index: i, fallback: 0))
  }
  let wandered: Bool = count > 0 and leastGone > 1.5 and arrivals >= count and leastStood > 60
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: physicsSystem.wandering.wanderers, i: i)
    let wanderer: mod Wanderer = componentMod(
      this: physicsSystem.wandering.wanderers
      entityId: entityId
    )
    let home: Vec3 = homes.copyAtFallback(index: i, fallback: Vec3.create(x: 0.0, y: 0.0, z: 10.0))
    wanderer.homeX = home.x
    wanderer.homeY = home.y
    wanderer.range = home.z
  }
  # A clip changes a blend (0.28 s) after the speed does, so a few frames
  # around each start and stop do not match
  var clipShare: Float = 0.0
  if clipFrames > 0 {
    clipShare = clipMatches.toFloat() / clipFrames.toFloat()
  }
  let clipsFollow: Bool = clipShare > 0.9
  # Everyone up again before the run: at least 6 s, and as long as anyone
  # a wander bump knocked over still lies there (walkerCrowdDownSeconds)
  var settled: Int = 0
  loop settled < 360 or (componentCount(this: physicsSystem.knockedDown) > 0 and settled < 60 * (walkerCrowdDownSeconds.toInt() + 8)) {
    settled = settled + 1
    crowdTestFrame(
      physicsSystem: physicsSystem
      world: world
      characterSystem: characterSystem
      heroEntityId: heroEntityId
      intent: still
      yaw: 0.0
      wanders: false
    )
  }
  # ----- the hero runs at one standing still ------------------------------------
  var knockedOver: Bool = false
  var heroDown: Bool = false
  var closest: Float = 1000.0
  # How long the one knocked over lay before it got up (s; below 0: never)
  var lay: Float = -1.0
  if count > 0 {
    let targetId: EntityId = componentEntityAt(this: physicsSystem.wandering.wanderers, i: 0)
    let target: Vec3 = controllerFeet(
      controller: controllerOf(controllers: world.controllers, entityId: targetId)
      groundZ: physicsSystem.groundZ
    )
    let fromX: Float = target.x
    let fromY: Float = target.y - 4.0
    placeHero(
      physicsSystem: physicsSystem
      heroEntityId: heroEntityId
      feet: Vec3.create(
        x: fromX
        y: fromY
        z: worldTerrainHeight(
          x: fromX
          y: fromY
          groundZ: physicsSystem.groundZ
          cfg: physicsSystem.biome
        ) + 0.2
      )
    )
    let run: InputIntent = forwardIntent()
    var knockedFrame: Int = -1
    loop var frame: Int = 0, frame < crowdTestRunFrames, ++frame {
      crowdTestFrame(
        physicsSystem: physicsSystem
        world: world
        characterSystem: characterSystem
        heroEntityId: heroEntityId
        intent: run
        yaw: 0.0
        wanders: false
      )
      knockedOver = knockedOver or componentHas(this: physicsSystem.knockedDown, entityId: targetId)
      if knockedOver and knockedFrame < 0 {
        knockedFrame = frame
      }
      heroDown = heroDown or componentHas(this: physicsSystem.knockedDown, entityId: heroEntityId)
      let hero: Vec3 = controllerOf(controllers: world.controllers, entityId: heroEntityId).position
      closest = Math.min(
        a: closest
        b: Math.sqrt(
          x: (hero.x - target.x) * (hero.x - target.x) + (hero.y - target.y) * (hero.y - target.y)
        )
      )
    }
    # ...and it lies there walkerCrowdDownSeconds before it gets up
    if knockedFrame >= 0 {
      var frame: Int = crowdTestRunFrames
      loop componentHas(this: physicsSystem.knockedDown, entityId: targetId) and frame - knockedFrame < 60 * (walkerCrowdDownSeconds.toInt() + 8) {
        crowdTestFrame(
          physicsSystem: physicsSystem
          world: world
          characterSystem: characterSystem
          heroEntityId: heroEntityId
          intent: still
          yaw: 0.0
          wanders: false
        )
        frame = frame + 1
      }
      if componentHas(this: physicsSystem.knockedDown, entityId: targetId) is false {
        lay = (frame - knockedFrame).toFloat() / 60.0
      }
    }
  }
  let layOk: Bool = lay >= walkerCrowdDownSeconds and lay < walkerCrowdDownSeconds + 2.0
  # ----- off the ground field, on the terrain's own height (the forest) -------------
  var farWalked: Float = 0.0
  var farOffGround: Float = 0.0
  let farTested: Bool = physicsSystem.followDistance > 0.0 and count > 1
  if farTested {
    let farId: EntityId = componentEntityAt(this: physicsSystem.wandering.wanderers, i: count - 1)
    let fromX: Float = physicsSystem.groundCentre.x + crowdTestFarOff
    let fromY: Float = physicsSystem.groundCentre.y
    let fromFeet: Vec3 = Vec3.create(
      x: fromX
      y: fromY
      z: worldTerrainHeight(
        x: fromX
        y: fromY
        groundZ: physicsSystem.groundZ
        cfg: physicsSystem.biome
      )
    )
    placeHero(physicsSystem: physicsSystem, heroEntityId: farId, feet: fromFeet)
    let farWanderer: mod Wanderer = componentMod(
      this: physicsSystem.wandering.wanderers
      entityId: farId
    )
    farWanderer.state = WanderState.walking
    farWanderer.targetX = fromX + crowdTestFarWalk
    farWanderer.targetY = fromY
    farWanderer.headwayLeft = 100.0
    farWanderer.headwayDistance = crowdTestFarWalk
    loop var frame: Int = 0, frame < crowdTestFarFrames, ++frame {
      crowdTestFrame(
        physicsSystem: physicsSystem
        world: world
        characterSystem: characterSystem
        heroEntityId: heroEntityId
        intent: still
        yaw: 0.0
        wanders: true
      )
      let feet: Vec3 = controllerFeet(
        controller: controllerOf(controllers: world.controllers, entityId: farId)
        groundZ: physicsSystem.groundZ
      )
      if frame > 30 {
        farOffGround = Math.max(
          a: farOffGround
          b: Math.abs(value: feet.z - worldTerrainHeight(
            x: feet.x
            y: feet.y
            groundZ: physicsSystem.groundZ
            cfg: physicsSystem.biome
          ))
        )
      }
      farWalked = Math.max(a: farWalked, b: feet.x - fromX)
    }
  }
  let farOk: Bool = farTested is false or (farWalked > 10.0 and farOffGround < 0.15)
  let passed: Bool = wandered and clipsFollow and knockedOver and heroDown is false and layOk and farOk
  log(
    "[crowdtest] {count} wanderers in 20 s: each went at least {leastGone} m off, {arrivals} spots reached, each stood still {leastStood} frames or more ={wandered}; their clip showed what they did in {clipShare * 100.0}% of frames ={clipsFollow}; the hero ran at one standing (closest {closest} m): it fell={knockedOver}, the hero stayed up={heroDown is false}, it lay {lay} s before it got up ={layOk}; off the ground field (tested={farTested}) it walked {farWalked} m on the terrain, its feet at most {farOffGround} m off it ={farOk}; passed={passed}"
  )
  ret passed
}
