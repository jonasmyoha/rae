# TimeOfDay — the simulated clock the 3D examples' sky runs on: an hour and a
# date that advance with wall time, roll the date at midnight and the year at
# New Year. Pure arithmetic over lib/Calendar, deliberately free of any UI:
# the settings dialog (app3d/SettingsDialog) OWNS one and decides WHEN it runs
# (paused, animation off, the slider being dragged), and a test of the clock
# itself compiles this module and Calendar, not the whole UI and renderer.

import Math
open Calendar

# The June solstice, so a scene at the Helsinki default opens with the sun
# actually up: at this latitude the December sun reaches 6 degrees, which is a
# legitimate but very dark first impression for an example.
const timeOfDayDefaultDayOfYear: Int = 172

const timeOfDayDefaultYear: Int = 1995

type TimeOfDay {
  # 0 <= hour < 24, local solar time.
  hour: Float
  # The date, which is what makes seasons: declination swings noon elevation at
  # Helsinki between 6.4 and 53.3 degrees over the year.
  dayOfYear: Int
  # The year has NO effect on the sun — the declination fit repeats annually. It
  # is here because a clock that runs for long enough should roll a year over
  # rather than silently restart, and because watching it tick is a small
  # pleasure. lib/Calendar gets the leap years right, so 29 February arrives.
  year: Int
  # How many seconds of wall time one simulated day takes. A minute by
  # default: fast enough to see dawn and dusk without waiting, slow enough
  # that the sun does not strobe. A game sets its own: the walkers' days last
  # 30 minutes (app3d/WalkerAppSetup).
  daySeconds: Float = 60.0
}

func createTimeOfDay(hour: view Float) ret TimeOfDay {
  ret TimeOfDay { hour: hour, dayOfYear: timeOfDayDefaultDayOfYear, year: timeOfDayDefaultYear }
}

# Advance the clock by `deltaTime` seconds of wall time. Returns true when the
# hour actually moved. A non-positive delta is refused: time never runs
# backwards on a bad clock reading.
#
# The whole delta is integrated, however large: a caller must not cap it, or
# every slow frame loses simulated time (111 and 112 drifted apart that way,
# test 599). Midnight rolls the DATE, and the date rolls the YEAR — a loop, not
# one subtraction, so a stall longer than a day still lands on the right date.
func timeOfDayAdvance(timeOfDay: mod TimeOfDay, deltaTime: view Float) ret Bool {
  if deltaTime <= 0.0 {
    ret false
  }
  var h: Float = timeOfDay.hour + deltaTime * 24.0 / timeOfDay.daySeconds
  var rollYear: Int = timeOfDay.year
  var rollDay: Int = timeOfDay.dayOfYear
  loop h >= 24.0 {
    h = h - 24.0
    advanceOneDay(year: rollYear, dayOfYear: rollDay)
  }
  timeOfDay.year = rollYear
  timeOfDay.dayOfYear = rollDay
  if h is timeOfDay.hour {
    ret false
  }
  timeOfDay.hour = h
  ret true
}

# The date the clock is on.
func timeOfDayDate(timeOfDay: view TimeOfDay) ret CalendarDate {
  ret dateFromDayOfYear(year: timeOfDay.year, dayOfYear: timeOfDay.dayOfYear)
}

# Move the clock `hours` ahead at once (the walkers' "Skip 6 hours": past the
# night), rolling the date and the year as the clock does
func timeOfDaySkip(timeOfDay: mod TimeOfDay, hours: view Float) ret Bool {
  ret timeOfDayAdvance(timeOfDay: timeOfDay, deltaTime: hours * timeOfDay.daySeconds / 24.0)
}

# ----- the shadows' sun ---------------------------------------------------
# Moving a shadow-casting light a little every frame makes every shadow edge
# crawl and flicker across the picture. So the shadows take the light at the
# clock's hour rounded down to a step of timeOfDayShadowStepSeconds of wall
# time, while the sky's sun moves on every frame: the day's length / 60,
# kept from 30 s to 5 minutes (a 5 or 30 minute day steps every 30 s, a
# 24 hour day every 5 minutes).
const timeOfDayShadowStepMin: Float = 30.0

const timeOfDayShadowStepMax: Float = 300.0

func timeOfDayShadowStepSeconds(daySeconds: view Float) ret Float {
  ret Math.clamp(val: daySeconds / 60.0, low: timeOfDayShadowStepMin, high: timeOfDayShadowStepMax)
}

# The hour the shadows' light is at: the clock's, rounded down to its step
func timeOfDayShadowHour(timeOfDay: view TimeOfDay) ret Float {
  if timeOfDay.daySeconds <= 0.0 {
    ret timeOfDay.hour
  }
  let step: Float = 24.0 * timeOfDayShadowStepSeconds(daySeconds: timeOfDay.daySeconds) / timeOfDay.daySeconds
  ret Math.floor(x: timeOfDay.hour / step) * step
}
