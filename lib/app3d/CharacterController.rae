# app3d/character_controller — camera-relative ground movement for third-person
# examples. It owns intent and a world-space transform, not collision: a future
# physics controller can replace the position integration while retaining the
# same camera-relative direction, facing and animation state.
import Math
import Sdl3
import Vec3
import Keys
import Quat
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform

const characterPi: Float = 3.141592653589793

type ThirdPersonController {
  position: Vec3
  heading: Float
  moving: Bool
  walking: Bool
  walkSpeed: Float
  runSpeed: Float
  turnRate: Float
}

func createThirdPersonController() ret ThirdPersonController {
  ret ThirdPersonController {
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    heading: 0.0
    moving: false
    walking: false
    walkSpeed: 1.7
    runSpeed: 4.2
    turnRate: 14.0
  }
}

func wrapCharacterAngle(angle: view Float) ret Float {
  var wrapped: Float = angle
  loop wrapped > characterPi {
    wrapped = wrapped - characterPi * 2.0
  }
  loop wrapped < 0.0 - characterPi {
    wrapped = wrapped + characterPi * 2.0
  }
  ret wrapped
}

# Pure movement step, split from key polling so controller behavior is testable
# without a window. `inputRight` and `inputForward` are each in [-1, 1].
func stepThirdPersonController(
  controller: mod ThirdPersonController
  inputRight: view Float
  inputForward: view Float
  walking: view Bool
  cameraYaw: view Float
  deltaTime: view Float
) ret Bool {
  let oldPosition: Vec3 = controller.position
  let oldHeading: Float = controller.heading
  let oldMoving: Bool = controller.moving
  let oldWalking: Bool = controller.walking

  var localRight: Float = inputRight
  var localForward: Float = inputForward
  let inputLengthSq: Float = localRight * localRight + localForward * localForward
  if inputLengthSq > 1.0 {
    let inverseLength: Float = 1.0 / Math.sqrt(x: inputLengthSq)
    localRight = localRight * inverseLength
    localForward = localForward * inverseLength
  }
  controller.moving = inputLengthSq > 0.0001 and deltaTime > 0.0
  controller.walking = controller.moving and walking

  if controller.moving {
    # Yaw zero looks from -Y toward +Y. These horizontal basis vectors match
    # camera_rig exactly, so W always moves away from the camera center-line.
    let forward: Vec3 = Vec3.create(
      x: 0.0 - Math.sin(x: cameraYaw)
      y: Math.cos(x: cameraYaw)
      z: 0.0
    )
    let right: Vec3 = Vec3.create(x: Math.cos(x: cameraYaw), y: Math.sin(x: cameraYaw), z: 0.0)
    let direction: Vec3 = Vec3.vadd(
      a: Vec3.vscale(a: forward, s: localForward)
      b: Vec3.vscale(a: right, s: localRight)
    )
    var moveSpeed: Float = controller.runSpeed
    if walking {
      moveSpeed = controller.walkSpeed
    }
    controller.position = Vec3.vadd(
      a: controller.position
      b: Vec3.vscale(a: direction, s: moveSpeed * deltaTime)
    )

    # A +Z rotation turns the model's +Y forward axis into `direction`.
    let desiredHeading: Float = Math.atan2(y: 0.0 - direction.x, x: direction.y)
    let headingGap: Float = wrapCharacterAngle(angle: desiredHeading - controller.heading)
    let turnAmount: Float = 1.0 - Math.exp(x: 0.0 - controller.turnRate * deltaTime)
    controller.heading = wrapCharacterAngle(angle: controller.heading + headingGap * turnAmount)
  }

  ret controller.position.x is not oldPosition.x or controller.position.y is not oldPosition.y or controller.position.z is not oldPosition.z or controller.heading is not oldHeading or controller.moving is not oldMoving or controller.walking is not oldWalking
}

# WASD and arrows are aliases. Running is the default; holding Shift selects
# the slower walk gait, as requested for this game-mode experiment.
func updateThirdPersonController(
  controller: mod ThirdPersonController
  allowInput: view Bool
  cameraYaw: view Float
  deltaTime: view Float
) ret Bool {
  var inputRight: Float = 0.0
  var inputForward: Float = 0.0
  var walking: Bool = false
  if allowInput {
    if Sdl3.isKeyDown(key: Keys.keyD) or Sdl3.isKeyDown(key: Keys.keyRight) {
      inputRight = inputRight + 1.0
    }
    if Sdl3.isKeyDown(key: Keys.keyA) or Sdl3.isKeyDown(key: Keys.keyLeft) {
      inputRight = inputRight - 1.0
    }
    if Sdl3.isKeyDown(key: Keys.keyW) or Sdl3.isKeyDown(key: Keys.keyUp) {
      inputForward = inputForward + 1.0
    }
    if Sdl3.isKeyDown(key: Keys.keyS) or Sdl3.isKeyDown(key: Keys.keyDown) {
      inputForward = inputForward - 1.0
    }
    walking = Sdl3.isKeyDown(key: Keys.keyLShift)
  }
  ret stepThirdPersonController(
    controller: controller
    inputRight: inputRight
    inputForward: inputForward
    walking: walking
    cameraYaw: cameraYaw
    deltaTime: deltaTime
  )
}

func thirdPersonCameraTarget(controller: view ThirdPersonController, focusZ: view Float) ret Vec3 {
  ret Vec3.create(
    x: controller.position.x
    y: controller.position.y
    z: controller.position.z + focusZ
  )
}

# A frame's movement intent. moveX/moveY are analog in [-1, 1] (right+/forward+);
# walking = the shift-to-walk modifier the controller expects (default is run);
# jump = Space or F went down this frame (a press, not held: one jump per
# press); actions is a reserved bitset for discrete button intents (unused
# today).
type InputIntent {
  moveX: Float
  moveY: Float
  walking: Bool
  jump: Bool
  actions: Int
}

# No input: standing, no jump, no action
func createInputIntent() ret InputIntent {
  ret InputIntent {
    moveX: 0.0
    moveY: 0.0
    walking: false
    jump: false
    actions: 0
  }
}

# The ThirdPersonController of a character entity (the hero or anyone else)
func controllerOf(
  controllers: view ComponentTable(ThirdPersonController)
  entityId: view EntityId
) ret view ThirdPersonController {
  ret componentView(this: controllers, entityId: entityId)
}

# A controller's place as a Transform3D: its position, turned by its heading
# about +z (the character entity's transform follows its controller)
func controllerTransform3D(controller: view ThirdPersonController) ret Transform3D {
  ret Transform3D {
    position: controller.position
    rotation: Quat.fromAxisAngle(axis: Vec3 { x: 0.0, y: 0.0, z: 1.0 }, angle: controller.heading)
    scale: Vec3 { x: 1.0, y: 1.0, z: 1.0 }
  }
}
