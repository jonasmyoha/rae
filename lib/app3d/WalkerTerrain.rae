# app3d/WalkerTerrain — the walker examples' terrain (136, 137, 143): the
# streamed heightfield tiles (app3d/TerrainTiles), the small props streamed
# with them (Autumn Grove's procedural rocks, the leaf bushes, the flowers and
# grass tufts) and the forest (an app3d/PropField the app plants once). Their
# differences are the arguments of createWalkerTerrain: the window's side in
# cells, the biome and the forest field's size and distances.
#
# The small props are ECS entities in the app's world, NOT parallel pool
# Lists: each carries a `TerrainProp` {kind, slot, active, ...} and a
# `Transform3D`. The pool is spawned once (one entity per window cell per
# kind); when the walker crosses a cell border only the slots whose cell left
# the window are placed again (the slots wrap, as the tiles do), so a stream
# moves one row or column of props, not the whole window. A prop over water
# is inactive and simply not gathered. The entities (and the rocks' and
# bushes' bodies) stream round the walker; what is DRAWN is a separate list
# (drawnProps) of the same placements round what the camera looks at, so an
# editor camera far from the walker still sees rocks and bushes. A cell's
# props are a function of the cell, so where the two windows overlap they
# are the same props.
#
# Each frame: gatherForest and gatherTerrainProps fill the batches once, then
# the shadow pass (drawTerrainPropsShadow) and the scene pass
# (drawTerrainGround, drawTerrainProps) both draw them, one instanced draw per
# batch.
import RendererDeferred
import RendererDeferredShadow
import Sys
import Math
import Noise
import Vec3
import Quat
import Gbuffer
open WorldBiome
open GbufferTerrain
open gpu/GpuResources
open Gltf
open Scene3d
open Mesh3d
open GbufferInstanced
open GbufferSprite
open ecs/Entity
open ecs/World
open ecs/ComponentTable
open ecs/Query
open ecs/Transform
open treeSets/TreeSet
open treeSets/TreeSetKinds
open app3d/PropInstancer
open app3d/PropField
open app3d/PropFieldFrame
open app3d/FarSprites
open app3d/FarCanopy
open CanopyBake
open app3d/TerrainTiles
open app3d/TerrainRocks
open app3d/WalkerFlowers

# The side of a terrain cell (m): one tile and one prop of each kind
const walkerCellSize: Float = 18.0

# The quads along a tile's side
const walkerTileSegments: Int = 24

const terrainTau: Float = 6.283185307179586

# Prop kinds (the TerrainProp.kind discriminator).
const kindTile: Int = 0

const kindTree: Int = 1

const kindRock: Int = 2

const kindBush: Int = 3

const kindFlower: Int = 4

const kindGrassA: Int = 5

const kindGrassB: Int = 6

# The grass a small prop wants under it (rocks want none)
const propGrassMin: Float = 0.45

# The single source of truth for the ground color: the terrain ground
# material AND the GPU grass gradient's bottom both read this, so the grass
# roots match the ground.
func walkerGroundColor() ret Vec3 {
  ret Vec3.create(x: 0.080, y: 0.245, z: 0.015)
}

# ----- ECS components ------------------------------------------------
# A terrain prop entity: which kind it is, which pool slot it occupies, and
# whether it is placed on valid ground now (props over water are inactive and
# not gathered).
type TerrainProp {
  kind: Int
  slot: Int
  active: Bool
  # The cell it is placed in now, once placed (a slot keeps its cell until
  # the cell leaves the window)
  cellX: Int
  cellY: Int
  placed: Bool
  # Which shape a rock is (app3d/TerrainRocks); 0 for the other kinds
  variant: Int
}

# One small prop as it is drawn: its kind, its rock shape (0 for the other
# kinds) and its model matrix
type DrawnProp {
  kind: Int
  variant: Int
  model: Mat4
}

# A tree's species (its terrain's treeSet), for a tree that is an entity (one
# Box3D trunk per tree: app3d/IslandForest)
type TreeVariant {
  species: Int
}

# The forest's PropField: the square round the origin it covers (m), its
# cells (m), the most trees one batch holds (0: PropField's own limit), and
# where its sparser crowns and its billboards end (treeSets/TreeSetKinds);
# `farReach` how far past that its trees still stand as far billboards
# (app3d/FarSprites) on a coarse far ground (0: none, the field is all)
type ForestFieldSettings {
  extent: Float
  cellSize: Float
  batchLimit: Int
  midDistance: Float
  farDistance: Float
  farReach: Float = 0.0
}

# The far ground: walkerFarGroundSide x walkerFarGroundSide tiles of
# walkerFarGroundCell meters round the camera's focus, a vertex every 10 m,
# drawn 1 m under the near ground. Under the near ground it has a hole
# (updateFarGroundHole), so it is not a second terrain below the first
const walkerFarGroundSide: Int = 5

const walkerFarGroundCell: Float = 400.0

const walkerFarGroundSegments: Int = 40

const walkerFarGroundDrop: Float = 1.0

# The far trees: at most this many billboards a frame, thinned past this
# distance (m), in blocks of this size (m)
const walkerFarTreeLimit: Int = 8192

const walkerFarTreeThinFrom: Float = 300.0

const walkerFarTreeBlock: Float = 64.0

# Past this distance (m) the far canopy (app3d/FarCanopy: one cluster
# impostor a forest cell) takes over from the far trees, across a band this
# wide; the trees are drawn to the band's end plus a cluster's reach (a tree
# is measured from its cluster's center), unthinned
const walkerCanopyFrom: Float = 300.0

const walkerCanopyFadeWidth: Float = 60.0

const walkerCanopyClusterReach: Float = 40.0

type WalkerTerrain {
  # The streamed window: gridSide x gridSide cells round the walker
  gridSide: Int
  cellSize: Float
  groundZ: Float
  biome: BiomeConfig
  centerCellX: Int
  centerCellY: Int
  toon: Bool
  # The ground: the streamed heightfield tiles (app3d/TerrainTiles)
  ground: TerrainTiles
  # One instancer per rock shape (TerrainProp.variant)
  rockParts: List(PropInstancer)
  # Oxeye daisies: one shared patch mesh in three instanced material parts.
  flowerParts: List(PropInstancer)
  # Harebells: one shared patch mesh in two instanced material parts.
  harebellParts: List(PropInstancer)
  grassProp: PropInstancer
  # The set of tree species the forest is planted from (treeSets/TreeSet)
  treeSet: TreeSet
  # The forest: every tree species as a kind at three levels of detail, its
  # placements in cells; only what is near and in view is drawn, one
  # instanced draw per species, level and part
  forest: PropField
  # The sprite pass the forest's far level (its billboards) is drawn with
  sprites: SpriteCache
  # Past the forest's own billboards, its trees' far billboards, standing on
  # the far ground (when the forest has a farReach)
  farTrees: FarSprites
  # Past the far trees, the forest's cells as cluster impostors (baked once
  # the forest is planted: bakeWalkerCanopy)
  canopy: FarCanopy
  farGround: TerrainTiles
  hasFarGround: Bool
  # The bush's three leaf tones
  bushParts: List(PropInstancer)
  # The small props drawn: every placement of the window round the cell
  # (drawCenterCellX, drawCenterCellY) the camera looks at (updateDrawnProps)
  drawnProps: List(DrawnProp)
  drawCenterCellX: Int
  drawCenterCellY: Int
  # The stand of hand-made T02 trees (app3d/ReferenceTree), when the app asks
  # for one (WalkerAppSettings.referenceTree): the wide forest leaves its
  # patch to them, and plants them there, five floats each: x y z yaw scale
  referenceStandOn: Bool = false
  # the stand's center: ahead of where, and the way, this run starts
  referenceStandX: Float = 0.0
  referenceStandY: Float = 0.0
  referenceStand: List(Float) = List.create(Float, cap: 0)
}

# The props in the window: one of each kind per cell
func terrainCellCount(terrainSystem: view WalkerTerrain) ret Int {
  ret terrainSystem.gridSide * terrainSystem.gridSide
}

# The height of the terrain's ground at (x, y)
func walkerTerrainHeight(
  terrainSystem: view WalkerTerrain
  x: view Float
  y: view Float
) ret Float {
  ret worldTerrainHeight(
    x: x
    y: y
    groundZ: terrainSystem.groundZ
    cfg: terrainSystem.biome
  )
}

func terrainMesh(renderer: mod DeferredRenderer, path: view String) ret MeshHandle {
  let model: Glb = loadGlb(path: path)
  let mesh: MeshData = loadAllPrimitives(glb: model)
  if mesh.vertCount < 1 {
    log("[terrain] no mesh data in {path}")
    ret meshHandleNone()
  }
  ret uploadMeshDataForTerrain(renderer: renderer, mesh: mesh)
}

func uploadMeshDataForTerrain(renderer: mod DeferredRenderer, mesh: view MeshData) ret MeshHandle {
  ret RendererDeferred.uploadMesh(
    renderer: renderer
    verts: mesh.verts
    vertCount: mesh.vertCount
    indices: mesh.indices
  )
}

func terrainMaterial(color: view Vec3, roughness: view Float) ret Material3d {
  ret Material3d {
    baseColor: color
    metallic: 0.0
    roughness: roughness
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: true
  }
}

# Every rock shape (app3d/TerrainRocks) as an instancer of `capacity` rocks
func createRockParts(renderer: mod DeferredRenderer, capacity: view Int) ret List(PropInstancer) {
  let shapes: List(RockShape) = createRockShapes(renderer: renderer)
  var parts: List(PropInstancer) = List.create(PropInstancer, cap: shapes.length)
  loop let shape: view RockShape in shapes {
    parts.add(
      value: createPropInstancer(mesh: shape.mesh, material: shape.material, capacity: capacity)
    )
  }
  ret parts
}

# The empty forest field of `settings`: its kinds, no trees yet (the far
# level's billboard pictures go into `sprites`' image array)
func createForestField(
  treeSet: view TreeSet
  renderer: mod DeferredRenderer
  sprites: mod SpriteCache
  settings: view ForestFieldSettings
) ret PropField {
  var field: PropField = createPropField(
    originX: settings.extent * -0.5
    originY: settings.extent * -0.5
    size: settings.extent
    cellSize: settings.cellSize
  )
  if settings.batchLimit > 0 {
    field.batchLimit = settings.batchLimit
  }
  addTreeSetKinds(
    treeSet: treeSet
    field: field
    renderer: renderer
    sprites: sprites
    midDistance: settings.midDistance
    farDistance: settings.farDistance
  )
  ret field
}

func terrainHash(cellX: view Int, cellY: view Int, seed: view Int) ret Float {
  ret Noise.hash2(x: cellX, y: cellY, seed: seed)
}

func terrainOffset(cellX: view Int, cellY: view Int, seed: view Int) ret Float {
  ret (terrainHash(cellX: cellX, cellY: cellY, seed: seed) - 0.5) * 12.0
}

# A small prop's placement in its cell: scattered x/y, the ground's height
# plus `lift`, a turn about +Z, a uniform scale from `minScale` to
# `minScale + scaleSpread`
func propTransform3D(
  terrainSystem: view WalkerTerrain
  cellX: view Int
  cellY: view Int
  seedX: view Int
  seedY: view Int
  seedScale: view Int
  lift: view Float
  minScale: view Float
  scaleSpread: view Float
) ret Transform3D {
  let scale: Float = minScale + terrainHash(cellX: cellX, cellY: cellY, seed: seedScale) * scaleSpread
  let posX: Float = cellX.toFloat() * terrainSystem.cellSize + terrainOffset(
    cellX: cellX
    cellY: cellY
    seed: seedX
  )
  let posY: Float = cellY.toFloat() * terrainSystem.cellSize + terrainOffset(
    cellX: cellX
    cellY: cellY
    seed: seedY
  )
  let yaw: Float = terrainHash(cellX: cellX, cellY: cellY, seed: seedScale + 71) * terrainTau
  ret Transform3D {
    position: Vec3.create(
      x: posX
      y: posY
      z: walkerTerrainHeight(terrainSystem: terrainSystem, x: posX, y: posY) + lift
    )
    rotation: Quat.fromAxisAngle(axis: Vec3.create(x: 0.0, y: 0.0, z: 1.0), angle: yaw)
    scale: Vec3.create(x: scale, y: scale, z: scale)
  }
}

# The placement of the prop of `kind` in cell (cellX, cellY): its own
# scatter seeds and scale range per kind
func kindTransform(
  terrainSystem: view WalkerTerrain
  kind: view Int
  cellX: view Int
  cellY: view Int
) ret Transform3D {
  if kind is kindRock {
    ret rockPlacement(
      cellX: cellX
      cellY: cellY
      cellSize: terrainSystem.cellSize
      groundZ: terrainSystem.groundZ
      biome: terrainSystem.biome
    )
  }
  if kind is kindBush {
    # A bush stands 5 cm into the ground
    ret propTransform3D(
      terrainSystem: terrainSystem
      cellX: cellX
      cellY: cellY
      seedX: 47
      seedY: 53
      seedScale: 59
      lift: -0.05
      minScale: 1.5
      scaleSpread: 0.9
    )
  }
  if kind is kindFlower {
    ret propTransform3D(
      terrainSystem: terrainSystem
      cellX: cellX
      cellY: cellY
      seedX: 61
      seedY: 67
      seedScale: 71
      lift: 0.015
      minScale: 0.90
      scaleSpread: 0.25
    )
  }
  if kind is kindGrassA {
    ret propTransform3D(
      terrainSystem: terrainSystem
      cellX: cellX
      cellY: cellY
      seedX: 73
      seedY: 79
      seedScale: 83
      lift: 0.0
      minScale: 0.52
      scaleSpread: 0.30
    )
  }
  # kindGrassB
  ret propTransform3D(
    terrainSystem: terrainSystem
    cellX: cellX
    cellY: cellY
    seedX: 89
    seedY: 97
    seedScale: 101
    lift: 0.0
    minScale: 0.38
    scaleSpread: 0.27
  )
}

# Rocks may stand on bare ground; everything else wants grass under it.
func kindMinGrass(kind: view Int) ret Float {
  if kind is kindRock {
    ret 0.0
  }
  ret propGrassMin
}

# The window cell a slot column (or row) holds. The slots wrap: column
# `column` always holds the window cell whose index is `column` modulo the
# grid side, so when the walker crosses a cell border only the one column (or
# row) of slots that fell out of the window moves to the new edge.
func wrappedCell(gridSide: view Int, centerCell: view Int, column: view Int) ret Int {
  let first: Int = centerCell - gridSide / 2
  ret first + ((column - first) % gridSide + gridSide) % gridSide
}

# ----- streaming -----------------------------------------------------
# Stream the terrain: the ground tiles (near and far, drawn only) round
# `groundFocus`, what the camera looks at, so the editor camera sees ground
# wherever it goes; the small props (rocks and bushes, which have physics
# bodies) round `propFocus`, the walker, so its bodies stay where the
# character is. Places every prop whose slot now maps to another cell. True
# when anything was streamed.
func updateInfiniteTerrain(
  terrainSystem: mod WalkerTerrain
  renderer: mod DeferredRenderer
  propKinds: mod ComponentTable(TerrainProp)
  transforms: mod ComponentTable(Transform3D)
  groundFocus: view Vec3
  propFocus: view Vec3
) ret Bool {
  # The far ground: its cells are not the near ones', so it can move when
  # they do not
  var groundMoved: Bool = false
  if terrainSystem.hasFarGround {
    groundMoved = updateTerrainTiles(
      tiles: terrainSystem.farGround
      renderer: renderer
      cellX: Math.floor(x: groundFocus.x / walkerFarGroundCell).toInt()
      cellY: Math.floor(x: groundFocus.y / walkerFarGroundCell).toInt()
    )
  }
  let nearMoved: Bool = updateTerrainTiles(
    tiles: terrainSystem.ground
    renderer: renderer
    cellX: Math.floor(x: groundFocus.x / terrainSystem.cellSize).toInt()
    cellY: Math.floor(x: groundFocus.y / terrainSystem.cellSize).toInt()
  )
  if terrainSystem.hasFarGround {
    updateFarGroundHole(terrainSystem: terrainSystem, renderer: renderer)
  }
  let drawnMoved: Bool = updateDrawnProps(terrainSystem: terrainSystem, focus: groundFocus)
  let cellX: Int = Math.floor(x: propFocus.x / terrainSystem.cellSize).toInt()
  let cellY: Int = Math.floor(x: propFocus.y / terrainSystem.cellSize).toInt()
  if cellX is terrainSystem.centerCellX and cellY is terrainSystem.centerCellY {
    ret groundMoved or nearMoved or drawnMoved
  }
  terrainSystem.centerCellX = cellX
  terrainSystem.centerCellY = cellY
  let gridSide: Int = terrainSystem.gridSide
  loop var i: Int = 0, i < componentCount(this: propKinds), ++i {
    let entityId: EntityId = componentEntityAt(this: propKinds, i: i)
    let prop: mod TerrainProp = queryModAt(table: propKinds, denseIndex: i)
    # The trees are planted once (the app's forest), not streamed
    if prop.kind is kindTree {
      continue
    }
    let propCellX: Int = wrappedCell(
      gridSide: gridSide
      centerCell: cellX
      column: prop.slot % gridSide
    )
    let propCellY: Int = wrappedCell(
      gridSide: gridSide
      centerCell: cellY
      column: prop.slot / gridSide
    )
    if prop.placed and propCellX is prop.cellX and propCellY is prop.cellY {
      continue
    }
    prop.placed = true
    prop.cellX = propCellX
    prop.cellY = propCellY
    let transform: Transform3D = kindTransform(
      terrainSystem: terrainSystem
      kind: prop.kind
      cellX: propCellX
      cellY: propCellY
    )
    prop.active = worldPropAllowed(
      x: transform.position.x
      y: transform.position.y
      minGrass: kindMinGrass(kind: prop.kind)
      cfg: terrainSystem.biome
    )
    if prop.kind is kindRock {
      prop.variant = rockShapeAt(cellX: propCellX, cellY: propCellY)
    }
    componentSet(this: transforms, entityId: entityId, data: transform)
  }
  ret true
}

# Cut the far ground under the near ground: the near tiles' area, less one
# far quad (10 m) on every side, so the two still overlap at the near
# ground's edge and no gap opens there
func updateFarGroundHole(terrainSystem: mod WalkerTerrain, renderer: mod DeferredRenderer) {
  let near: view TerrainTiles = terrainSystem.ground
  let half: Int = near.gridSide / 2
  let margin: Float = walkerFarGroundCell / walkerFarGroundSegments.toFloat()
  let firstX: Int = near.centerCellX - half
  let firstY: Int = near.centerCellY - half
  let lastX: Int = firstX + near.gridSide - 1
  let lastY: Int = firstY + near.gridSide - 1
  let minX: Float = (firstX.toFloat() - 0.5) * near.cellSize + margin
  let minY: Float = (firstY.toFloat() - 0.5) * near.cellSize + margin
  let maxX: Float = (lastX.toFloat() + 0.5) * near.cellSize - margin
  let maxY: Float = (lastY.toFloat() + 0.5) * near.cellSize - margin
  setTerrainTilesHole(
    tiles: terrainSystem.farGround
    renderer: renderer
    minX: minX
    minY: minY
    maxX: maxX
    maxY: maxY
  )
}

# The small props drawn round `focus` (what the camera looks at): every
# kind's placement in every cell of the window, as the entities would be
# placed there. Rebuilt only when `focus` crosses a cell border. True when
# it was rebuilt.
func updateDrawnProps(terrainSystem: mod WalkerTerrain, focus: view Vec3) ret Bool {
  let centerX: Int = Math.floor(x: focus.x / terrainSystem.cellSize).toInt()
  let centerY: Int = Math.floor(x: focus.y / terrainSystem.cellSize).toInt()
  if centerX is terrainSystem.drawCenterCellX and centerY is terrainSystem.drawCenterCellY {
    ret false
  }
  terrainSystem.drawCenterCellX = centerX
  terrainSystem.drawCenterCellY = centerY
  terrainSystem.drawnProps.clear()
  let gridSide: Int = terrainSystem.gridSide
  loop var row: Int = 0, row < gridSide, ++row {
    loop var column: Int = 0, column < gridSide, ++column {
      let cellX: Int = centerX - gridSide / 2 + column
      let cellY: Int = centerY - gridSide / 2 + row
      # The streamed kinds (kindRock .. kindGrassB, as createWalkerTerrain
      # spawns them)
      loop var kind: Int = kindRock, kind <= kindGrassB, ++kind {
        let transform: Transform3D = kindTransform(
          terrainSystem: terrainSystem
          kind: kind
          cellX: cellX
          cellY: cellY
        )
        if worldPropAllowed(
          x: transform.position.x
          y: transform.position.y
          minGrass: kindMinGrass(kind: kind)
          cfg: terrainSystem.biome
        ) {
          var variant: Int = 0
          if kind is kindRock {
            variant = rockShapeAt(cellX: cellX, cellY: cellY)
          }
          terrainSystem.drawnProps.add(
            value: { kind: kind, variant: variant, model: transform3dToMatrix(t: transform) }
          )
        }
      }
    }
  }
  ret true
}

# ----- draw ----------------------------------------------------------
# Fill the small props' batches for this frame (before the shadow and scene
# passes, which both draw them), from the props drawn round the camera's
# focus (drawnProps), not the walker's entities
func gatherTerrainProps(terrainSystem: mod WalkerTerrain) {
  loop let part: mod PropInstancer in terrainSystem.rockParts {
    resetInstanceBatch(batch: part.batch)
  }
  loop let part: mod PropInstancer in terrainSystem.flowerParts {
    resetInstanceBatch(batch: part.batch)
  }
  loop let part: mod PropInstancer in terrainSystem.harebellParts {
    resetInstanceBatch(batch: part.batch)
  }
  resetInstanceBatch(batch: terrainSystem.grassProp.batch)
  loop let part: mod PropInstancer in terrainSystem.bushParts {
    resetInstanceBatch(batch: part.batch)
  }
  loop let prop: view DrawnProp in terrainSystem.drawnProps {
    if prop.kind is kindRock {
      if let rockPart: mod PropInstancer = terrainSystem.rockParts.modAt(index: prop.variant) {
        addPropInstance(prop: rockPart, model: prop.model)
      }
    }
    if prop.kind is kindBush {
      loop let part: mod PropInstancer in terrainSystem.bushParts {
        addPropInstance(prop: part, model: prop.model)
      }
    }
    if prop.kind is kindFlower {
      loop let part: mod PropInstancer in terrainSystem.flowerParts {
        addPropInstance(prop: part, model: prop.model)
      }
      loop let part: mod PropInstancer in terrainSystem.harebellParts {
        addPropInstance(prop: part, model: prop.model)
      }
    }
    if prop.kind is kindGrassA or prop.kind is kindGrassB {
      addPropInstance(prop: terrainSystem.grassProp, model: prop.model)
    }
  }
}

# Fill the forest's batches for this frame (before the shadow and scene
# passes, which both draw them). The view cone is widened by about 34
# degrees, so a tree just outside the picture still casts its shadow into it.
func gatherForest(terrainSystem: mod WalkerTerrain, camera: view Camera3d, aspect: view Float) {
  var propView: PropView = propViewOf(camera: camera, aspect: aspect)
  propView.halfAngle = Math.min(a: propView.halfAngle + 0.6, b: 3.0)
  gatherPropField(field: terrainSystem.forest, propView: propView, toon: terrainSystem.toon)
  # The far trees: the picture only (no shadows), so the plain view
  if terrainSystem.hasFarGround {
    gatherFarSprites(
      farSprites: terrainSystem.farTrees
      propView: propViewOf(camera: camera, aspect: aspect)
      toon: terrainSystem.toon
    )
    gatherFarCanopy(
      canopy: terrainSystem.canopy
      propView: propViewOf(camera: camera, aspect: aspect)
      toon: terrainSystem.toon
    )
  }
}

# This frame's props and forest (gathered above) into the open scene pass
func drawTerrainProps(
  cache: mod GbufferCache
  resources: mod GpuResources
  terrainSystem: mod WalkerTerrain
) {
  loop let part: view PropInstancer in terrainSystem.rockParts {
    drawInstances(cache: cache, resources: resources, batch: part.batch)
  }
  loop let part: view PropInstancer in terrainSystem.flowerParts {
    drawInstances(cache: cache, resources: resources, batch: part.batch)
  }
  loop let part: view PropInstancer in terrainSystem.harebellParts {
    drawInstances(cache: cache, resources: resources, batch: part.batch)
  }
  drawInstances(cache: cache, resources: resources, batch: terrainSystem.grassProp.batch)
  drawPropField(cache: cache, resources: resources, field: terrainSystem.forest)
  drawPropFieldSprites(
    cache: cache
    resources: resources
    field: terrainSystem.forest
    sprites: terrainSystem.sprites
  )
  if terrainSystem.hasFarGround {
    drawFarSprites(
      cache: cache
      resources: resources
      farSprites: terrainSystem.farTrees
      sprites: terrainSystem.sprites
    )
    drawFarCanopy(cache: cache, resources: resources, canopy: terrainSystem.canopy)
  }
  loop let part: view PropInstancer in terrainSystem.bushParts {
    drawInstances(cache: cache, resources: resources, batch: part.batch)
  }
}

# The forest's trees as far billboards, once it is planted (its finished
# field's placements, in blocks); nothing when the forest has no farReach
func fillFarTrees(terrainSystem: mod WalkerTerrain) {
  if terrainSystem.hasFarGround is false {
    ret
  }
  var trees: List(FarSprite) = farSpritesOf(
    field: terrainSystem.forest
    placements: terrainSystem.forest.placements
  )
  planFarCanopy(canopy: terrainSystem.canopy, field: terrainSystem.forest, trees: trees)
  let added: Int = addFarSpritesInCells(
    farSprites: terrainSystem.farTrees
    sprites: trees
    cellSize: walkerFarTreeBlock
  )
  log(
    "[terrain] far trees: {terrainSystem.forest.placements.length} trees in {added} blocks, to {terrainSystem.farTrees.settings.farDistance} m"
  )
}

# Bake the far canopy planned when the forest was planted (fillFarTrees),
# from the forest's tree impostors; nothing without a far ground
func bakeWalkerCanopy(terrainSystem: mod WalkerTerrain, renderer: mod DeferredRenderer) {
  if terrainSystem.hasFarGround is false {
    ret
  }
  if let resources: mod GpuResources = renderer.gpuResources {
    bakeFarCanopy(
      canopy: terrainSystem.canopy
      resources: resources
      treeAtlas: terrainSystem.sprites.impostors.binding
      settings: defaultCanopySettings()
      cutoff: spriteCutoff
    )
  }
}

func drawTerrainGround(
  cache: mod GbufferCache
  resources: mod GpuResources
  terrainSystem: view WalkerTerrain
  time: copy Float
) {
  drawTerrainTiles(
    tiles: terrainSystem.ground
    cache: cache
    resources: resources
    time: time
  )
  if terrainSystem.hasFarGround {
    drawTerrainTiles(
      tiles: terrainSystem.farGround
      cache: cache
      resources: resources
      time: time
    )
  }
}

# Rocks, bushes, flowers and forest use one shadow draw per material batch.
func drawTerrainPropsShadow(renderer: mod DeferredRenderer, terrainSystem: view WalkerTerrain) {
  loop let part: view PropInstancer in terrainSystem.rockParts {
    RendererDeferredShadow.drawShadowCasterBatchWith(
      renderer: renderer
      mesh: part.mesh
      batch: part.batch
    )
  }
  loop let part: view PropInstancer in terrainSystem.bushParts {
    RendererDeferredShadow.drawShadowCasterBatchWith(
      renderer: renderer
      mesh: part.mesh
      batch: part.batch
    )
  }
  loop let part: view PropInstancer in terrainSystem.flowerParts {
    RendererDeferredShadow.drawShadowCasterBatchWith(
      renderer: renderer
      mesh: part.mesh
      batch: part.batch
    )
  }
  loop let part: view PropInstancer in terrainSystem.harebellParts {
    RendererDeferredShadow.drawShadowCasterBatchWith(
      renderer: renderer
      mesh: part.mesh
      batch: part.batch
    )
  }
  drawPropFieldShadows(renderer: renderer, field: terrainSystem.forest)
  drawPropFieldSpriteShadows(
    renderer: renderer
    field: terrainSystem.forest
    aspect: spritePictureAspect
    cutoff: spriteCutoff
    impostors: terrainSystem.sprites.impostors.binding
  )
}

func setInfiniteTerrainToon(terrainSystem: mod WalkerTerrain, toon: view Bool) {
  if terrainSystem.toon is toon {
    ret
  }
  terrainSystem.toon = toon
  loop let part: mod PropInstancer in terrainSystem.rockParts {
    setPropInstancerToon(prop: part, toon: toon)
  }
  # The recovered daisy uses broad physical shading independently of terrain.
  loop let part: mod PropInstancer in terrainSystem.flowerParts {
    setPropInstancerToon(prop: part, toon: toon and Sys.getEnv(name: "RAE_DAISY_CONTROL") is "1")
  }
  loop let part: mod PropInstancer in terrainSystem.harebellParts {
    setPropInstancerToon(prop: part, toon: toon and Sys.getEnv(name: "RAE_HAREBELL_CONTROL") is "1")
  }
  setPropInstancerToon(prop: terrainSystem.grassProp, toon: toon)
  loop let part: mod PropInstancer in terrainSystem.bushParts {
    setPropInstancerToon(prop: part, toon: toon)
  }
}

# ----- setup ---------------------------------------------------------
# Spawn one prop entity of `kind` for pool slot `slot`, not placed yet
func spawnProp(
  allocator: mod EntityAllocator
  transforms: mod ComponentTable(Transform3D)
  propKinds: mod ComponentTable(TerrainProp)
  kind: view Int
  slot: view Int
) ret EntityId {
  let entityId: EntityId = allocEntity(this: allocator)
  componentSet(this: transforms, entityId: entityId, data: createTransform3D())
  componentSet(
    this: propKinds
    entityId: entityId
    data: TerrainProp {
      kind: kind
      slot: slot
      active: false
      cellX: 0
      cellY: 0
      placed: false
      variant: 0
    }
  )
  ret entityId
}

# The terrain of `biome` at `groundZ`: a window of `gridSide` x `gridSide`
# cells round the walker (its tiles, and one entity of every small prop kind
# per cell spawned into the app's tables) and an empty forest field of
# `forest` of `treeSet`'s species (the app plants it once the spawn is
# known). Nothing is placed
# until the first updateInfiniteTerrain.
func createWalkerTerrain(
  renderer: mod DeferredRenderer
  allocator: mod EntityAllocator
  transforms: mod ComponentTable(Transform3D)
  propKinds: mod ComponentTable(TerrainProp)
  assets: view String
  gridSide: view Int
  groundZ: view Float
  biome: view BiomeConfig
  forest: view ForestFieldSettings
  treeSet: view TreeSet
) ret WalkerTerrain {
  let cellCount: Int = gridSide * gridSide
  let grassMesh: MeshHandle = terrainMesh(renderer: renderer, path: "{assets}environment/grass.glb")
  let grassMaterial: Material3d = terrainMaterial(
    color: Vec3.create(x: 0.18, y: 0.42, z: 0.055)
    roughness: 0.94
  )
  # One entity per pool slot per small prop kind, placed by updateInfiniteTerrain
  let streamedKinds: List(Int) = [
    kindRock
    kindBush
    kindFlower
    kindGrassA
    kindGrassB
  ]
  loop var slot: Int = 0, slot < cellCount, ++slot {
    loop let kind: view Int in streamedKinds {
      let unusedEntityId: EntityId = spawnProp(
        allocator: allocator
        transforms: transforms
        propKinds: propKinds
        kind: kind
        slot: slot
      )
    }
  }
  var sprites: SpriteCache = createSpriteCache()
  var forestField: PropField = createForestField(
    treeSet: treeSet
    renderer: renderer
    sprites: sprites
    settings: forest
  )
  # Far trees from where the forest's own billboards end; a far ground under
  # them (one tile when there is none, never drawn)
  var farSettings: FarSpriteSettings = defaultFarSpriteSettings()
  farSettings.nearDistance = forest.farDistance
  farSettings.farDistance = forest.farDistance + forest.farReach
  farSettings.limit = walkerFarTreeLimit
  farSettings.thinFrom = walkerFarTreeThinFrom
  let hasFarGround: Bool = forest.farReach > 0.0
  let canopySettings: FarCanopySettings = {
    fadeMiddle: walkerCanopyFrom
    fadeWidth: walkerCanopyFadeWidth
    farDistance: forest.farDistance + forest.farReach
  }
  if hasFarGround {
    # The canopy holds every tree past its band: the far trees stop there
    farSettings.farDistance = walkerCanopyFrom + walkerCanopyFadeWidth * 0.5 + walkerCanopyClusterReach
    farSettings.thinFrom = farSettings.farDistance
    farSettings.fadeOutMiddle = walkerCanopyFrom
    farSettings.fadeOutWidth = walkerCanopyFadeWidth
  }
  var farSide: Int = 1
  if hasFarGround {
    farSide = walkerFarGroundSide
  }
  var farGround: TerrainTiles = createTerrainTiles(
    renderer: renderer
    gridSide: farSide
    cellSize: walkerFarGroundCell
    segments: walkerFarGroundSegments
    groundZ: groundZ
    biome: biome
  )
  farGround.drawDrop = walkerFarGroundDrop
  ret WalkerTerrain {
    gridSide: gridSide
    cellSize: walkerCellSize
    groundZ: groundZ
    biome: biome
    centerCellX: 1000000000
    centerCellY: 1000000000
    toon: true
    ground: own createTerrainTiles(
      renderer: renderer
      gridSide: gridSide
      cellSize: walkerCellSize
      segments: walkerTileSegments
      groundZ: groundZ
      biome: biome
    )
    rockParts: own createRockParts(renderer: renderer, capacity: cellCount)
    flowerParts: own createWalkerDaisyParts(renderer: renderer, capacity: cellCount)
    harebellParts: own createWalkerHarebellParts(renderer: renderer, capacity: cellCount)
    grassProp: own createPropInstancer(
      mesh: grassMesh
      material: grassMaterial
      capacity: cellCount * 2
    )
    treeSet: treeSet
    forest: own forestField
    sprites: own sprites
    farTrees: own createFarSprites(settings: farSettings)
    canopy: own createFarCanopy(settings: canopySettings)
    farGround: own farGround
    hasFarGround: hasFarGround
    bushParts: own createTreeSetBushParts(treeSet: treeSet, renderer: renderer, capacity: cellCount)
    drawnProps: List.create(DrawnProp, cap: cellCount * 5)
    drawCenterCellX: 1000000000
    drawCenterCellY: 1000000000
  }
}
