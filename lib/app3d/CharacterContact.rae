# app3d/CharacterContact — characters bumping into each other. Box3D's movers
# are not bodies in the world (each only queries the world's shapes), so two
# characters would pass through each other. After every mover has moved, each
# pair whose capsules overlap is resolved here: pushed apart to two radii
# along the line between them (sideways only, never lifted), and, if they
# were closing, given an impulse along that line, as two equal bodies with a
# little bounce. A runner into someone standing therefore slows and sends
# them stumbling; a runner pushing on keeps shoving. A hard enough bump
# knocks someone over (Knockdown): the one doing less of the pushing falls,
# the pusher stays up; two pushing about as hard both fall.
#
# resolveCharacterContact is the rule over plain values
# (app3d/CharacterContactRules, free of Box3D); bumpMovers is the system: every pair of movers not
# parked (lying, seated, climbing), their
# movers moved apart and shoved, and whoever falls given a KnockRequest
# (app3d/KnockedDown) for the app to make its ragdoll. An app with places a
# push must not move a character into (a wall it keeps by hand) resolves the
# pairs itself with the rule.
import Math
import Vec3
open ecs/Entity
open ecs/ComponentTable
open ecs/Tag
open box3d/ecs/PhysicsComponents
open app3d/CharacterMovers
open app3d/KnockedDown
open app3d/CharacterContactRules

# A mover's collision capsule as a CharacterShape
func characterShapeOf(character: view CharacterBody) ret CharacterShape {
  ret CharacterShape {
    radius: character.mover.capsule.radius
    height: character.mover.capsule.center2.z - character.mover.capsule.center1.z + character.mover.capsule.radius * 2.0
  }
}

func moverPosition(character: view CharacterBody) ret Vec3 {
  ret Vec3.create(
    x: character.mover.transform.p.x
    y: character.mover.transform.p.y
    z: character.mover.transform.p.z
  )
}

func moverVelocity(character: view CharacterBody) ret Vec3 {
  ret Vec3.create(
    x: character.mover.velocity.x
    y: character.mover.velocity.y
    z: character.mover.velocity.z
  )
}

# The mover's place and velocity after a contact (`falls`: knocked over, so
# it stops where it is; its ragdoll takes the velocity)
func setMoverAfterContact(
  character: mod CharacterBody
  position: view Vec3
  velocity: view Vec3
  falls: view Bool
) {
  character.mover.transform.p.x = position.x
  character.mover.transform.p.y = position.y
  if falls {
    character.mover.velocity.x = 0.0
    character.mover.velocity.y = 0.0
    character.mover.velocity.z = 0.0
  } else {
    character.mover.velocity.x = velocity.x
    character.mover.velocity.y = velocity.y
  }
}

# One fixed step of bumps among every mover in `characters` not `parked`:
# each overlapping pair pushed apart and shoved; whoever a bump knocks over
# gets a KnockRequest in `knocks` with the velocity it falls at (a little
# upward, so the body leaves the ground). The number knocked over.
func bumpMovers(
  characters: mod ComponentTable(CharacterBody)
  parked: view ComponentTable(MoverParked)
  knocks: mod ComponentTable(KnockRequest)
) ret Int {
  var fallen: Int = 0
  let count: Int = componentCount(this: characters)
  loop var i: Int = 0, i < count, ++i {
    let idA: EntityId = componentEntityAt(this: characters, i: i)
    loop var j: Int = i + 1, j < count, ++j {
      let idB: EntityId = componentEntityAt(this: characters, i: j)
      if hasTag(MoverParked, table: parked, entityId: idA) or hasTag(
        MoverParked
        table: parked
        entityId: idB
      ) or componentHas(this: knocks, entityId: idA) or componentHas(this: knocks, entityId: idB) {
        continue
      }
      let a: CharacterBody = componentCopyAtDefault(this: characters, i: i)
      let b: CharacterBody = componentCopyAtDefault(this: characters, i: j)
      let contact: CharacterContact = resolveCharacterContact(
        shapeA: characterShapeOf(character: a)
        shapeB: characterShapeOf(character: b)
        positionA: moverPosition(character: a)
        velocityA: moverVelocity(character: a)
        positionB: moverPosition(character: b)
        velocityB: moverVelocity(character: b)
      )
      if contact.touching is false {
        continue
      }
      let aFalls: Bool = contact.knockdown is Knockdown.aFalls or contact.knockdown is Knockdown.bothFall
      let bFalls: Bool = contact.knockdown is Knockdown.bFalls or contact.knockdown is Knockdown.bothFall
      setMoverAfterContact(
        character: componentMod(this: characters, entityId: idA)
        position: contact.positionA
        velocity: contact.velocityA
        falls: aFalls
      )
      setMoverAfterContact(
        character: componentMod(this: characters, entityId: idB)
        position: contact.positionB
        velocity: contact.velocityB
        falls: bFalls
      )
      if aFalls {
        componentSet(
          this: knocks
          entityId: idA
          data: KnockRequest {
            velocity: Vec3.create(x: contact.velocityA.x, y: contact.velocityA.y, z: 1.5)
          }
        )
        fallen = fallen + 1
      }
      if bFalls {
        componentSet(
          this: knocks
          entityId: idB
          data: KnockRequest {
            velocity: Vec3.create(x: contact.velocityB.x, y: contact.velocityB.y, z: 1.5)
          }
        )
        fallen = fallen + 1
      }
    }
  }
  ret fallen
}
