# app3d/WalkerPhysics — the walker's physics: upstream Box3D's C library
# through box3d/ecs (docs/physics-two-implementations.md), on a fixed 60 Hz
# step taken from the frame's accumulator. The system owns the physics
# resource and the tables of its bodies (docs/ecs-systems-own-their-tables.md);
# the pose of every body lives in the app's Transform3D table, which the pull
# system writes back after each step. Used by the walker examples (136, 137,
# 143); their differences are settings of createWalkerPhysics.
#
# - The ground is a static height field sampled from the app's WorldBiome
#   terrain (worldTerrainHeight on its BiomeConfig), on the render tiles' 1.5
#   m lattice: one field over a whole island, or (followDistance > 0) a field
#   round the walker that is made again when the walker has gone that far.
# - Every character (the hero, each crowd member) is a CharacterBody: Box3D's
#   mover (samples/mover.cpp), a capsule that slides along the ground, pushes
#   loose bodies and jumps; deep water (worldWadable) stays a wall. The
#   controller of the character (its feet, heading and gait) is read back
#   from the mover after each step. A bush slows a character inside it
#   (box3d/ecs/NatureBodies; the app hands the step its bush spots).
# - A few stacks of cubes near the spawn are dynamic bodies (app3d/WalkerCubes).
# - Tree trunks are static capsules: one per tree (addTreeTrunk), or a pool of
#   them moved onto the trees of a PropField nearest the walker
#   (createTrunkPool / updateTrunkPool) when the forest is too big for one each.
import Math
import Vec3
import Quat
open Vec2
open Math3d
open WorldBiome
open ecs/Entity
open ecs/World
open ecs/ComponentTable
open ecs/Transform
open ecs/Tag
open app3d/CharacterController
open app3d/WalkerCharacter
open treeSets/TreeSet
open app3d/PropField
open box3d/ecs/PhysicsTypes
open box3d/ecs/Physics
open box3d/ecs/PhysicsComponents
open box3d/ecs/PhysicsSpawn
open box3d/ecs/PhysicsSystems
open box3d/ecs/CharacterMover
open box3d/ecs/VenueMesh
open box3d/ecs/NatureBodies
open box3d/Box3d
open box3d/Box3dTypes
open app3d/CharacterBodies
open app3d/CharacterMovers
open GltfSkin
open app3d/KnockedDown
open app3d/RagdollRig
open app3d/Ragdoll
open app3d/PropColliderRules
open app3d/PropBodyPool
open app3d/ClimbRules
open app3d/Climbing
open app3d/CharacterContact
open app3d/Wander
open app3d/Characters
open water/WaterIce

const walkerPhysicsStep: Float = 1.0 / 60.0

# The crowd's wander picks, the same every run
const walkerWanderSeed: Int = 1136

const walkerPhysicsSubSteps: Int = 4

# Fixed steps one frame may take: past this the world slows down instead of
# spiralling (a stall, a breakpoint)
const walkerPhysicsMaxSteps: Int = 4

# The ground's lattice: the render tiles' 1.5 m (18 m cells of 12 segments)
const walkerGroundSpacing: Float = 1.5

# A loose cube: its half edge and color (its pose is its Transform3D)
type PhysicsCube {
  halfSize: Float
  color: Vec3
  # A picture on its faces (a layer of the renderer's material images, as
  # Material3d.colorTextureLayer), -1 for none
  textureLayer: Int = -1
}

type WalkerPhysics {
  # Frame time not yet stepped
  accumulator: Float
  # The fastest a character moves in this frame's snow (m/s;
  # app3d/SnowField snowSpeedLimit), with the bushes' limits
  snowSpeedLimit: Float = 1000.0
  # How far the lakes and the sea's shore are frozen this frame (lib/Climate
  # climateIceAt, water/WaterIce): frozen water is ground at its surface
  iceLake: Float = 0.0
  iceSea: Float = 0.0
  # The terrain the ground and the wading follow: the app's biome and the
  # height its ground sits at
  biome: BiomeConfig
  groundZ: Float
  # The ground field: fieldCount x fieldCount points; with followDistance > 0
  # it is made again round the walker once it is that far from the center
  fieldCount: Int
  followDistance: Float
  physics: Physics
  rigidBodies: ComponentTable(RigidBody)
  colliders: ComponentTable(Collider)
  characters: ComponentTable(CharacterBody)
  # The mover system's components (app3d/CharacterMovers)
  moverDrives: ComponentTable(MoverDrive)
  moverParked: ComponentTable(MoverParked)
  # Characters lying as ragdolls (app3d/Ragdoll on the Mixamo rig) and when
  # they get up (app3d/KnockedDown; app3d/WalkerKnockdown)
  ragdolls: ComponentTable(Ragdoll)
  knockedDown: ComponentTable(KnockedDown)
  # Knocked over by a bump this step (app3d/CharacterContact: the one doing
  # less of the pushing), the ragdoll not made yet: the knockdown trips them
  knocks: ComponentTable(KnockRequest)
  # The copies of other clients' walkers in a networked session
  # (app3d/remoteWalkerSystem, app3d/CharacterContact)
  remoteMovers: ComponentTable(RemoteMover)
  ragdollRig: RagdollRig
  moverLimits: ComponentTable(MoverSpeedLimit)
  moverSteps: ComponentTable(MoverStep)
  cubes: ComponentTable(PhysicsCube)
  # The ground height field now (followGround): its shape, the point it is
  # centered on, and how many times it has been made
  groundShape: ShapeId
  groundCenter: Vec3
  groundFields: Int
  # The trunk pool (TrunkPool): static trunk bodies moved onto the trees
  # nearest the walker, the point they were placed round, and how many stand
  # on trees now
  trunkPool: PropBodyPool
  # Every character climbs what it pushes into (app3d/Climbing)
  climbing: Climbing
  # The crowd walks about on its own (app3d/Wander)
  wandering: Wandering
}

# The physics of a walker on the terrain of `biome` at `groundZ`, its ground a
# field of `fieldCount` x `fieldCount` points (231 cover an island of radius
# 150 m), made again round the walker when it has gone `followDistance` from
# the field's center (0: never)
# The category of the walker's ground and loose cubes: everything collides
# with them, but they are not walls to the camera; the trees and rocks keep
# every category, so the camera pulls in front of them
const walkerWorldCategory: UInt64 = 1

func createWalkerPhysics(
  biome: view BiomeConfig
  groundZ: view Float
  fieldCount: view Int
  followDistance: view Float
) ret WalkerPhysics {
  ret WalkerPhysics {
    accumulator: 0.0
    biome: biome
    groundZ: groundZ
    fieldCount: fieldCount
    followDistance: followDistance
    physics: createPhysics(
      def: defaultPhysicsWorldDef()
      fixedStep: walkerPhysicsStep
      subSteps: walkerPhysicsSubSteps
    )
    rigidBodies: ComponentTable.create(RigidBody)
    colliders: ComponentTable.create(Collider)
    characters: ComponentTable.create(CharacterBody)
    moverDrives: ComponentTable.create(MoverDrive)
    moverParked: ComponentTable.create(MoverParked)
    ragdolls: ComponentTable.create(Ragdoll)
    knockedDown: ComponentTable.create(KnockedDown)
    knocks: ComponentTable.create(KnockRequest)
    remoteMovers: ComponentTable.create(RemoteMover)
    ragdollRig: createRagdollRig(
      skeleton: emptySkeleton()
      bones: mixamoRagdollBones(prefix: "mixamorig:")
    )
    moverLimits: ComponentTable.create(MoverSpeedLimit)
    moverSteps: ComponentTable.create(MoverStep)
    cubes: ComponentTable.create(PhysicsCube)
    groundShape: nullShapeId()
    groundCenter: Vec3 { x: 0.0, y: 0.0, z: 0.0 }
    groundFields: 0
    trunkPool: emptyPropBodyPool(settings: walkerTrunkPoolSettings())
    climbing: createClimbing(
      tuning: ClimbTuning {}
      staminaTuning: StaminaTuning {}
      wallMask: allBits
    )
    wandering: createWandering(seed: walkerWanderSeed)
  }
}

func destroyPhysicsSystem(physicsSystem: mod WalkerPhysics) {
  destroyPhysics(physics: physicsSystem.physics)
}

# ----- the ground --------------------------------------------------------
# A static height field (Box3D's is a grid over its local x and z with the
# heights along local y; a quarter turn about x stands it up, so local column
# i is world x = left + i * spacing and local row j is world y = top - j *
# spacing, as packages/physicsScenes' vehicle course does). Every height is
# terrainHeightAt itself, so what you walk on is what you see.
func addIslandGround(physicsSystem: mod WalkerPhysics) ret Bool {
  ret addGroundAround(physicsSystem: physicsSystem, center: physicsSystem.groundCenter)
}

# A height field centered on `center` (snapped to the field's lattice, so
# every field samples the same points), replacing the one before. True when
# Box3D took it.
func addGroundAround(physicsSystem: mod WalkerPhysics, center: view Vec3) ret Bool {
  let count: Int = physicsSystem.fieldCount
  let half: Float = walkerGroundSpacing * (((count - 1) / 2) as Float)
  let centerX: Float = Math.floor(x: center.x / walkerGroundSpacing) * walkerGroundSpacing
  let centerY: Float = Math.floor(x: center.y / walkerGroundSpacing) * walkerGroundSpacing
  var heights: List(Float) = List.create(Float, cap: count * count)
  loop var row: Int = 0, row < count, ++row {
    loop var column: Int = 0, column < count, ++column {
      heights.add(value: worldTerrainHeight(
        x: centerX - half + (column as Float) * walkerGroundSpacing
        y: centerY + half - (row as Float) * walkerGroundSpacing
        groundZ: physicsSystem.groundZ
        cfg: physicsSystem.biome
      ))
    }
  }
  var groundDef: ShapeDef = defaultShapeDef(lengthUnitsPerMeter: 1.0)
  groundDef.baseMaterial.friction = 0.8
  # Not a wall to the camera (app3d/CameraObstruction): it stays over the
  # ground by OrbitGround instead
  groundDef.filter.categoryBits = walkerWorldCategory
  if let shapeId: ShapeId = addVenueHeightField(
    physics: physicsSystem.physics
    heights: heights
    countX: count
    countZ: count
    scale: Vec3 { x: walkerGroundSpacing, y: 1.0, z: walkerGroundSpacing }
    transform: Transform {
      position: Vec3 { x: centerX - half, y: centerY + half, z: 0.0 }
      rotation: Quat.fromAxisAngle(axis: Vec3 { x: 1.0, y: 0.0, z: 0.0 }, angle: Math.pi * 0.5)
    }
    def: groundDef
  ) {
    if physicsSystem.groundFields > 0 {
      let removed: Bool = removeVenueHeightField(
        physics: physicsSystem.physics
        shapeId: physicsSystem.groundShape
      )
    }
    physicsSystem.groundShape = shapeId
    physicsSystem.groundCenter = Vec3 { x: centerX, y: centerY, z: 0.0 }
    physicsSystem.groundFields = physicsSystem.groundFields + 1
    ret true
  }
  ret false
}

# Keep the ground under the walker: once `position` is followDistance from
# the field's center, make a new field round it (never when followDistance
# is 0). True when it did.
func followGround(physicsSystem: mod WalkerPhysics, position: view Vec3) ret Bool {
  if physicsSystem.followDistance <= 0.0 {
    ret false
  }
  let gapX: Float = position.x - physicsSystem.groundCenter.x
  let gapY: Float = position.y - physicsSystem.groundCenter.y
  let reach: Float = physicsSystem.followDistance
  if gapX * gapX + gapY * gapY < reach * reach {
    ret false
  }
  ret addGroundAround(physicsSystem: physicsSystem, center: position)
}

# The input for the coming fixed steps: `controlledEntityId` driven by the
# player's `intent` along the camera's yaw, everyone else standing (the mover
# system, app3d/CharacterMovers). The self-tests drive this way, the crowd
# still.
func driveCharacters(
  physicsSystem: mod WalkerPhysics
  controlledEntityId: view EntityId
  controllers: view ComponentTable(ThirdPersonController)
  intent: view InputIntent
  cameraYaw: view Float
  speedScale: view Float
) {
  setPlayerDrive(
    physicsSystem: physicsSystem
    controlledEntityId: controlledEntityId
    intent: intent
    cameraYaw: cameraYaw
    speedScale: speedScale
  )
  driveMovers(
    characters: physicsSystem.characters
    controllers: controllers
    drives: physicsSystem.moverDrives
  )
}

# A frame's input: the player's drive as driveCharacters gives it, and the
# crowd's own, walking about (app3d/Wander), `deltaTime` s on
func driveWalkers(
  physicsSystem: mod WalkerPhysics
  controlledEntityId: view EntityId
  controllers: view ComponentTable(ThirdPersonController)
  controlled: view ComponentTable(Controlled)
  intent: view InputIntent
  cameraYaw: view Float
  speedScale: view Float
  deltaTime: view Float
) {
  setPlayerDrive(
    physicsSystem: physicsSystem
    controlledEntityId: controlledEntityId
    intent: intent
    cameraYaw: cameraYaw
    speedScale: speedScale
  )
  stepWanderers(
    wandering: physicsSystem.wandering
    controllers: controllers
    controlled: controlled
    parked: physicsSystem.moverParked
    drives: physicsSystem.moverDrives
    deltaTime: deltaTime
  )
  driveMovers(
    characters: physicsSystem.characters
    controllers: controllers
    drives: physicsSystem.moverDrives
  )
}

# Only the player's drive: every other drive taken away
func setPlayerDrive(
  physicsSystem: mod WalkerPhysics
  controlledEntityId: view EntityId
  intent: view InputIntent
  cameraYaw: view Float
  speedScale: view Float
) {
  loop componentCount(this: physicsSystem.moverDrives) > 0 {
    componentRemove(
      this: physicsSystem.moverDrives
      entityId: componentEntityAt(this: physicsSystem.moverDrives, i: 0)
    )
  }
  componentSet(
    this: physicsSystem.moverDrives
    entityId: controlledEntityId
    data: MoverDrive {
      intent: intent
      yaw: cameraYaw
      speedScale: speedScale
      tookOff: false
      # The walker's run (4.2 m/s) is under the mover's cap: no sprint
      sprints: false
    }
  )
}

# Every character one fixed step: held to the speed limit of a bush in
# `bushes` it stands in, moved (the mover system), deep water a wall (a step
# that ends where a character cannot wade is undone per axis, so walking into
# the drop-off at an angle slides along it), then its controller read back
func moveCharacters(
  physicsSystem: mod WalkerPhysics
  controllers: mod ComponentTable(ThirdPersonController)
  bushes: view List(BushSpot)
) {
  loop var i: Int = 0, i < componentCount(this: physicsSystem.characters), ++i {
    let entityId: EntityId = componentEntityAt(this: physicsSystem.characters, i: i)
    let body: view CharacterBody = componentView(this: physicsSystem.characters, entityId: entityId)
    componentSet(
      this: physicsSystem.moverLimits
      entityId: entityId
      data: MoverSpeedLimit {
        limit: Math.min(
          a: bushSpeedLimitAmong(
            bushes: bushes
            x: body.mover.transform.p.x
            y: body.mover.transform.p.y
          )
          b: physicsSystem.snowSpeedLimit
        )
      }
    )
  }
  moveMovers(
    physics: physicsSystem.physics
    characters: physicsSystem.characters
    parked: physicsSystem.moverParked
    limits: physicsSystem.moverLimits
    steps: physicsSystem.moverSteps
  )
  let biome: BiomeConfig = physicsSystem.biome
  loop var i: Int = 0, i < componentCount(this: physicsSystem.moverSteps), ++i {
    let entityId: EntityId = componentEntityAt(this: physicsSystem.moverSteps, i: i)
    let step: MoverStep = componentCopyAtDefault(this: physicsSystem.moverSteps, i: i)
    let character: mod CharacterBody = componentMod(
      this: physicsSystem.characters
      entityId: entityId
    )
    let center: Vec3 = {
      x: character.mover.transform.p.x
      y: character.mover.transform.p.y
      z: 0.0
    }
    holdMoverWithin(
      character: character
      step: step
      insideNow: walkerCanStand(physicsSystem: physicsSystem, x: center.x, y: center.y)
      insideWithOldY: walkerCanStand(physicsSystem: physicsSystem, x: center.x, y: step.fromY)
      insideWithOldX: walkerCanStand(physicsSystem: physicsSystem, x: step.fromX, y: center.y)
    )
  }
  holdMoversOnTerrain(physicsSystem: physicsSystem)
  # Bumps between them: pushed apart, and a hard one knocks over the one
  # doing less of the pushing (app3d/CharacterContact)
  let fallen: Int = bumpMovers(
    characters: physicsSystem.characters
    parked: physicsSystem.moverParked
    remotes: physicsSystem.remoteMovers
    knocks: physicsSystem.knocks
  )
  # The climbers on their walls (app3d/Climbing), before the rest are read back
  stepClimbers(
    climbing: physicsSystem.climbing
    physics: physicsSystem.physics
    characters: physicsSystem.characters
    controllers: controllers
    drives: physicsSystem.moverDrives
    parked: physicsSystem.moverParked
    groundZ: physicsSystem.groundZ
    deltaTime: walkerPhysicsStep
  )
  readMoverControllers(
    characters: physicsSystem.characters
    controllers: controllers
    parked: physicsSystem.moverParked
    groundZ: physicsSystem.groundZ
    fixedStep: walkerPhysicsStep
  )
}

# Off the ground field (the forest's follows the walker; the crowd wanders
# kilometers past it), no ground under a mover: the terrain's own height
# (worldTerrainHeight, which the field is sampled from) holds up any mover
# whose feet come down to it there, so it walks on as on the field
const walkerGroundEdge: Float = 3.0

# The ice's share at (x, y) this frame (water/WaterIce)
func walkerIceAt(physicsSystem: view WalkerPhysics, x: view Float, y: view Float) ret Float {
  if physicsSystem.iceLake <= 0.02 and physicsSystem.iceSea <= 0.02 {
    ret 0.0
  }
  ret waterIceCover(
    lake: physicsSystem.iceLake
    sea: physicsSystem.iceSea
    x: x
    y: y
    groundZ: physicsSystem.groundZ
    biome: physicsSystem.biome
  )
}

# Where a character may stand: ground it can wade to, or ice that holds it
func walkerCanStand(physicsSystem: view WalkerPhysics, x: view Float, y: view Float) ret Bool {
  ret worldWadable(x: x, y: y, cfg: physicsSystem.biome) or walkerIceAt(
    physicsSystem: physicsSystem
    x: x
    y: y
  ) > waterIceWalkable
}

func holdMoversOnTerrain(physicsSystem: mod WalkerPhysics) {
  let half: Float = walkerGroundSpacing * ((physicsSystem.fieldCount - 1) / 2).toFloat() - walkerGroundEdge
  loop var i: Int = 0, i < componentCount(this: physicsSystem.characters), ++i {
    let entityId: EntityId = componentEntityAt(this: physicsSystem.characters, i: i)
    if hasTag(MoverParked, table: physicsSystem.moverParked, entityId: entityId) {
      continue
    }
    let character: mod CharacterBody = componentMod(
      this: physicsSystem.characters
      entityId: entityId
    )
    let x: Float = character.mover.transform.p.x
    let y: Float = character.mover.transform.p.y
    # on ice the ground is the water's surface, on the field or off it
    let onIce: Bool = walkerIceAt(physicsSystem: physicsSystem, x: x, y: y) > waterIceWalkable
    if onIce is false and Math.abs(value: x - physicsSystem.groundCenter.x) < half and Math.abs(
      value: y - physicsSystem.groundCenter.y
    ) < half {
      continue
    }
    var ground: Float = worldTerrainHeight(
      x: x
      y: y
      groundZ: physicsSystem.groundZ
      cfg: physicsSystem.biome
    )
    if onIce {
      ground = Math.max(
        a: ground
        b: worldWaterZ(groundZ: physicsSystem.groundZ, cfg: physicsSystem.biome)
      )
    }
    let above: Float = moverCenterAboveFeet(character: character)
    if character.mover.transform.p.z - above <= ground + 0.02 {
      character.mover.transform.p.z = ground + above
      if character.mover.velocity.z < 0.0 {
        character.mover.velocity.z = 0.0
      }
      character.mover.onGround = true
    }
  }
}

# One fixed step: the characters first (the mover reads the world as the last
# step left it, as Box3D's sample does), then the bodies.
func walkerPhysicsTick(
  physicsSystem: mod WalkerPhysics
  transforms: mod ComponentTable(Transform3D)
  controllers: mod ComponentTable(ThirdPersonController)
  bushes: view List(BushSpot)
) {
  moveCharacters(physicsSystem: physicsSystem, controllers: controllers, bushes: bushes)
  stepPhysicsBodies(
    physics: physicsSystem.physics
    rigidBodies: physicsSystem.rigidBodies
    transforms: transforms
  )
}

# A frame: the fixed steps `frameTime` pays for, at most walkerPhysicsMaxSteps
# (the rest is dropped, so a long frame slows the world instead of
# spiralling). The number of steps taken.
func stepPhysicsFrame(
  physicsSystem: mod WalkerPhysics
  transforms: mod ComponentTable(Transform3D)
  controllers: mod ComponentTable(ThirdPersonController)
  bushes: view List(BushSpot)
  frameTime: view Float
) ret Int {
  let due: FixedSteps = fixedStepsFor(
    accumulator: physicsSystem.accumulator
    frameTime: frameTime
    fixedStep: walkerPhysicsStep
    maxSteps: walkerPhysicsMaxSteps
  )
  physicsSystem.accumulator = due.accumulator
  loop var step: Int = 0, step < due.steps, ++step {
    walkerPhysicsTick(
      physicsSystem: physicsSystem
      transforms: transforms
      controllers: controllers
      bushes: bushes
    )
  }
  advancePhysicsEvents(physics: physicsSystem.physics)
  ret due.steps
}

# ----- tree trunks -------------------------------------------------------
# A static body with a trunk capsule for the tree `entityId` at its pose in
# `transforms`, `height` m tall (treeSets/TreeSet.treeTrunkTop: up into its
# crown, so a climber goes up it), as thick for every tree
# (treeSets/TreeSet.treeTrunkRadius). A tree that moves only needs its body moved,
# which the push system does when its Transform3D changes.
func addTreeTrunk(
  physicsSystem: mod WalkerPhysics
  transforms: mod ComponentTable(Transform3D)
  entityId: view EntityId
  height: view Float
) {
  var bodyDef: BodyDef = defaultBodyDef(lengthUnitsPerMeter: 1.0)
  bodyDef.bodyType = BodyType.staticBody
  bodyDef.position = componentView(this: transforms, entityId: entityId).position
  bodyDef.rotation = componentView(this: transforms, entityId: entityId).rotation
  let bodyId: BodyId = spawnRigidBody(
    physics: physicsSystem.physics
    rigidBodies: physicsSystem.rigidBodies
    transforms: transforms
    entityId: entityId
    def: bodyDef
  )
  var shapeDef: ShapeDef = defaultShapeDef(lengthUnitsPerMeter: 1.0)
  shapeDef.baseMaterial.friction = 0.6
  let shapeId: ShapeId = addCapsuleCollider(
    physics: physicsSystem.physics
    rigidBodies: physicsSystem.rigidBodies
    colliders: physicsSystem.colliders
    entityId: entityId
    def: shapeDef
    capsule: {
      center1: Vec3 { x: 0.0, y: 0.0, z: treeTrunkRadius }
      center2: Vec3 { x: 0.0, y: 0.0, z: Math.max(a: height, b: treeTrunkRadius * 2.0) }
      radius: treeTrunkRadius
    }
  )
}

# ----- the trunk pool -----------------------------------------------------
# For a forest with tens of thousands of trees, only the ones near the walker
# can be touched, so physics has a FIXED number of static trunk capsules
# (trunkPoolSize) and moves them onto the trees nearest the walker. When the
# walker has gone trunkPoolMove meters since the last placing, the trees
# within trunkPoolReach are looked up in the forest's PropField cells, the
# nearest trunkPoolSize get a trunk each, and the rest of the pool waits far
# below the ground. Each trunk is an entity whose Transform3D the placing
# writes; the physics push system moves its body.
# How many trunk bodies there are
const trunkPoolSize: Int = 96

# Trees this close to the walker (m) get a trunk
const trunkPoolReach: Float = 16.0

# The walker moves this far (m) before the trunks are placed again
const trunkPoolMove: Float = 2.0

# Where an unused trunk waits: this far below the ground
const trunkPoolParked: Float = -1000.0

# The pool's settings: trunks only, each as thick (treeSets/TreeSet.treeTrunkRadius)
# and reaching up into its tree's crown (walkerTrunkRules), the default
# material
func walkerTrunkPoolSettings() ret PropPoolSettings {
  ret PropPoolSettings {
    trunkCount: trunkPoolSize
    sphereCount: 0
    reach: trunkPoolReach
    moveDistance: trunkPoolMove
    parkedZ: trunkPoolParked
    categoryBits: allBits
    friction: 0.6
    trunkRestitution: defaultSurfaceMaterial().restitution
    sphereRestitution: defaultSurfaceMaterial().restitution
    trunkRadius: treeTrunkRadius
    trunkHeight: treeTrunkHeight
    sphereRadius: 0.5
  }
}

# Every kind of the forest a trunk of the one thickness, its top
# treeTrunkShare of its tree's height (a climber goes up into the crown)
func walkerTrunkRules(forest: view PropField) ret List(PropColliderRule) {
  var rules: List(PropColliderRule) = List.create(PropColliderRule, cap: forest.kinds.length)
  loop var kind: Int = 0, kind < forest.kinds.length, ++kind {
    # a kind without a trunk (a bush) has no body here
    var hasTrunk: Bool = true
    if let propKind: view PropKind = forest.kinds.viewAt(index: kind) {
      hasTrunk = propKind.hasTrunk
    }
    if not hasTrunk {
      rules.add(value: noPropCollider())
      continue
    }
    rules.add(value: PropColliderRule {
      role: PropBodyRole.trunk
      minRadius: treeTrunkRadius
      maxRadius: treeTrunkRadius
      heightShare: treeTrunkShare
      maxHeight: 40.0
    })
  }
  ret rules
}

# The pool's bodies (app3d/PropBodyPool), parked until placed. The number of
# bodies.
func createTrunkPool(
  physicsSystem: mod WalkerPhysics
  allocator: mod EntityAllocator
  transforms: mod ComponentTable(Transform3D)
) ret Int {
  physicsSystem.trunkPool = createPropBodyPool(
    physics: physicsSystem.physics
    rigidBodies: physicsSystem.rigidBodies
    colliders: physicsSystem.colliders
    transforms: transforms
    allocator: allocator
    settings: walkerTrunkPoolSettings()
  )
  ret physicsSystem.trunkPool.trunks.length
}

# The forest's trees within trunkPoolReach of (x, y): their placement
# indices in `indices`, their squared distances in `distances`
func treesNear(
  forest: view PropField
  x: view Float
  y: view Float
  indices: mod List(Int)
  distances: mod List(Float)
) {
  indices.clear()
  distances.clear()
  if forest.finished is false {
    ret
  }
  let first: Int = propCellOf(field: forest, x: x - trunkPoolReach, y: y - trunkPoolReach)
  let last: Int = propCellOf(field: forest, x: x + trunkPoolReach, y: y + trunkPoolReach)
  loop var row: Int = first / forest.columns, row <= last / forest.columns, ++row {
    loop var column: Int = first % forest.columns, column <= last % forest.columns, ++column {
      let cell: Int = row * forest.columns + column
      let start: Int = forest.cellStart.copyAtFallback(index: cell, fallback: 0)
      let end: Int = forest.cellStart.copyAtFallback(index: cell + 1, fallback: 0)
      loop var i: Int = start, i < end, ++i {
        if let placement: view PropPlacement = forest.placements.viewAt(index: i) {
          let gapX: Float = placement.position.x - x
          let gapY: Float = placement.position.y - y
          let distance: Float = gapX * gapX + gapY * gapY
          if distance < trunkPoolReach * trunkPoolReach {
            indices.add(value: i)
            distances.add(value: distance)
          }
        }
      }
    }
  }
}

# Place the pool round `focus` (the walker's feet) when the walker has gone
# trunkPoolMove since the last placing, or `force`: the nearest trees within
# trunkPoolReach get a trunk each (app3d/PropBodyPool). True when it placed.
func updateTrunkPool(
  physicsSystem: mod WalkerPhysics
  transforms: mod ComponentTable(Transform3D)
  forest: view PropField
  focus: view Vec3
  force: view Bool
) ret Bool {
  if force is false and propPoolNeedsPlacing(
    pool: physicsSystem.trunkPool
    x: focus.x
    y: focus.y
    changes: 0
  ) is false {
    ret false
  }
  beginPropGathering(pool: physicsSystem.trunkPool)
  gatherPropBodies(
    pool: physicsSystem.trunkPool
    field: forest
    rules: walkerTrunkRules(forest: forest)
    x: focus.x
    y: focus.y
  )
  placePropBodies(
    pool: physicsSystem.trunkPool
    physics: physicsSystem.physics
    transforms: transforms
    x: focus.x
    y: focus.y
    changes: 0
  )
  ret true
}
