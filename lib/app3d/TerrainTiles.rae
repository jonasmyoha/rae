# app3d/TerrainTiles — the ground of a streamed WorldBiome terrain: a square
# of gridSide x gridSide heightfield tiles, cellSize meters each, round the
# cell the camera looks at (drawn only: the physics has its own ground). Each
# tile owns one mesh, rewritten in place when the tile moves to another cell;
# its vertices carry the absolute world height of the app's biome field
# (worldTerrainHeight), so what is drawn is what the physics and the props
# stand on.
#
#   var ground: TerrainTiles = createTerrainTiles(renderer: r, gridSide: 7,
#     cellSize: 18.0, segments: 24, groundZ: z, biome: cfg)
#   ...when the camera's focus cell may have changed:
#   let moved: Bool = updateTerrainTiles(tiles: ground, renderer: r,
#     cellX: cx, cellY: cy)
#   ...in the G-buffer (or forward) pass:
#   drawTerrainTiles(tiles: ground, cache: c, resources: g, time: t)
#
# NO SEAMS. Every tile is sampled on one integer lattice (cell * segments +
# vertex index), so two neighbors compute their shared edge from the same
# points, and tiles never overlap: overlapping heightfields disagree inside
# the strip, which showed as depth fighting and dark shadow seams.
#
# CHEAP STREAMING. A cell's tile is the one at (cellX mod gridSide, cellY mod
# gridSide), so when the player crosses into the next cell only the row or
# column that came into view is rewritten, not the whole grid.
#
# AN APP'S OWN TERRAIN (createAppTerrainTiles; docs/open-world-tiles.md (b)):
# the heights and ground kinds come from the app, not WorldBiome. A tile that
# moves to a new cell is listed in `wanted` and not drawn until the app answers
# it with a TerrainPatch (app3d/TerrainPatch, commitTerrainPatch); the
# patches' kinds go into a wrapping kind map (two RGBA8 layers of the terrain
# texture array, uploaded by uploadTerrainKinds once a frame) that
# terrain_kinds.wgsl paints per pixel.
#
# A HOLE where a finer ground covers it (setTerrainTilesHole): a coarse far
# ground drawn under a near one leaves out every quad wholly inside the
# near one's area, so it is not drawn twice there (seen from below the near
# ground, it was a second terrain 1 m under the first).
import Math
import Vec3
open MeshStore
import RendererDeferred
open Math3d
open Mesh3d
open Scene3d
open WorldBiome
open GbufferTerrain
open Gbuffer
open gpu/GpuResources
open app3d/TerrainPatch

# One tile: its mesh and the cell it covers now
type TerrainTile {
  meshId: Int
  cellX: Int
  cellY: Int
  # An app terrain's tile is drawn once its patch is committed
  ready: Bool = true
}

type TerrainTiles {
  gridSide: Int
  cellSize: Float
  segments: Int
  groundZ: Float
  biome: BiomeConfig
  # The cell the grid is centered on (none yet: a far-off sentinel)
  centerCellX: Int
  centerCellY: Int
  # Row-major by (cellX mod gridSide, cellY mod gridSide)
  tiles: List(TerrainTile)
  # Reused staging buffer for one tile's vertices
  scratchVerts: List(Float)
  # Drawn this far below its heights (m): a coarse far ground under a finer
  # near one, so the near one covers it where both are
  drawDrop: Float = 0.0
  # The world rectangle whose quads are left out (setTerrainTilesHole);
  # none while min > max
  holeMinX: Float = 1.0
  holeMinY: Float = 1.0
  holeMaxX: Float = 0.0
  holeMaxY: Float = 0.0
  # Reused staging list for one tile's indices
  scratchIndices: List(Int) = List.create(Int, cap: 0)
  # An app's own terrain (createAppTerrainTiles): the cells it must answer with a patch, and
  # the kind map's two layers (kinds 0 - 3 and 4 - 7, a texel a lattice point) and whether they
  # changed since the last upload
  appSource: Bool = false
  wanted: List(TerrainCell) = List.create(TerrainCell, cap: 0)
  kindTexelsLow: List(Int) = List.create(Int, cap: 0)
  kindTexelsHigh: List(Int) = List.create(Int, cap: 0)
  kindsChanged: Bool = false
}

# The pool: gridSide x gridSide tiles of `segments` x `segments` quads, each
# with its own mesh uploaded into `renderer`; none placed until the first
# updateTerrainTiles
func createTerrainTiles(
  renderer: mod DeferredRenderer
  gridSide: view Int
  cellSize: view Float
  segments: view Int
  groundZ: view Float
  biome: view BiomeConfig
) ret TerrainTiles {
  let plane: MeshData = makePlane(size: cellSize, segments: segments)
  var tiles: List(TerrainTile) = List.create(TerrainTile, cap: gridSide * gridSide)
  loop var i: Int = 0, i < gridSide * gridSide, ++i {
    let mesh: MeshHandle = RendererDeferred.uploadMesh(
      renderer: renderer
      verts: plane.verts
      vertCount: plane.vertCount
      indices: plane.indices
    )
    tiles.add(value: { meshId: mesh.id, cellX: 1000000000, cellY: 1000000000 })
  }
  let floats: Int = (segments + 1) * (segments + 1) * 8
  var scratch: List(Float) = List.create(Float, cap: floats)
  loop var i: Int = 0, i < floats, ++i {
    scratch.add(value: 0.0)
  }
  ret TerrainTiles {
    gridSide: gridSide
    cellSize: cellSize
    segments: segments
    groundZ: groundZ
    biome: biome
    centerCellX: 1000000000
    centerCellY: 1000000000
    tiles: own tiles
    scratchVerts: own scratch
  }
}

# The pool for an app's own terrain: as createTerrainTiles, but the tiles ask the app for their
# patches (`wanted`, commitTerrainPatch) and the kind map is made (all kind 0)
func createAppTerrainTiles(
  renderer: mod DeferredRenderer
  gridSide: view Int
  cellSize: view Float
  segments: view Int
) ret TerrainTiles {
  var tiles: TerrainTiles = createTerrainTiles(
    renderer: renderer
    gridSide: gridSide
    cellSize: cellSize
    segments: segments
    groundZ: 0.0
    biome: defaultBiomeConfig()
  )
  tiles.appSource = true
  let texels: Int = terrainKindMapSide * terrainKindMapSide
  tiles.kindTexelsLow = List.create(Int, cap: texels)
  tiles.kindTexelsHigh = List.create(Int, cap: texels)
  let first: Int = terrainKindTexel(
    a: 1.0
    b: 0.0
    c: 0.0
    d: 0.0
  )
  loop var i: Int = 0, i < texels, ++i {
    tiles.kindTexelsLow.add(value: first)
    tiles.kindTexelsHigh.add(value: 0)
  }
  terrainInitArray(w: terrainKindMapSide, h: terrainKindMapSide)
  tiles.kindsChanged = true
  ret tiles
}

# The ground height at world (`x`, `y`)
func terrainTilesHeight(tiles: view TerrainTiles, x: view Float, y: view Float) ret Float {
  ret worldTerrainHeight(
    x: x
    y: y
    groundZ: tiles.groundZ
    cfg: tiles.biome
  )
}

# `value` mod `side`, never negative
func terrainTileWrap(value: view Int, side: view Int) ret Int {
  let wrapped: Int = value % side
  if wrapped < 0 {
    ret wrapped + side
  }
  ret wrapped
}

# Center the grid on cell (`cellX`, `cellY`): every tile whose slot now maps
# to another cell is rewritten for it. True when any tile moved.
func updateTerrainTiles(
  tiles: mod TerrainTiles
  renderer: mod DeferredRenderer
  cellX: view Int
  cellY: view Int
) ret Bool {
  if cellX is tiles.centerCellX and cellY is tiles.centerCellY {
    ret false
  }
  tiles.centerCellX = cellX
  tiles.centerCellY = cellY
  let half: Int = tiles.gridSide / 2
  var moved: Bool = false
  loop var row: Int = 0, row < tiles.gridSide, ++row {
    loop var column: Int = 0, column < tiles.gridSide, ++column {
      let wantX: Int = cellX - half + column
      let wantY: Int = cellY - half + row
      let slot: Int = terrainTileWrap(value: wantY, side: tiles.gridSide) * tiles.gridSide + terrainTileWrap(
        value: wantX
        side: tiles.gridSide
      )
      # Which mesh is in the slot, and does it cover another cell? (read
      # first: the reshape below writes `tiles`)
      var meshId: Int = 0
      if let tile: view TerrainTile = tiles.tiles.viewAt(index: slot) {
        if tile.cellX is not wantX or tile.cellY is not wantY {
          meshId = tile.meshId
        }
      }
      if meshId > 0 and tiles.appSource {
        # the app answers it (commitTerrainPatch); hidden until then
        if let tile: mod TerrainTile = tiles.tiles.modAt(index: slot) {
          tile.cellX = wantX
          tile.cellY = wantY
          tile.ready = false
        }
        tiles.wanted.add(value: TerrainCell { x: wantX, y: wantY })
        moved = true
      } else if meshId > 0 {
        reshapeTerrainTile(
          tiles: tiles
          renderer: renderer
          meshId: meshId
          cellX: wantX
          cellY: wantY
        )
        if terrainTilesHasHole(tiles: tiles) {
          cutTerrainTileHole(
            tiles: tiles
            renderer: renderer
            meshId: meshId
            cellX: wantX
            cellY: wantY
          )
        }
        if let tile: mod TerrainTile = tiles.tiles.modAt(index: slot) {
          tile.cellX = wantX
          tile.cellY = wantY
        }
        moved = true
      }
    }
  }
  ret moved
}

# Rewrite one tile's mesh for cell (`cellX`, `cellY`): heights from the biome
# field on the shared lattice, normals from central differences, positions
# local to the cell's center (the tile's model matrix is a translation)
func reshapeTerrainTile(
  tiles: mod TerrainTiles
  renderer: mod DeferredRenderer
  meshId: view Int
  cellX: view Int
  cellY: view Int
) {
  if meshId < 1 {
    ret
  }
  let segments: Int = tiles.segments
  let spacing: Float = tiles.cellSize / segments.toFloat()
  let eps: Float = 0.6
  loop var yi: Int = 0, yi <= segments, ++yi {
    let fy: Float = yi.toFloat() / segments.toFloat()
    let localY: Float = (yi - segments / 2).toFloat() * spacing
    let worldY: Float = (cellY * segments + yi - segments / 2).toFloat() * spacing
    loop var xi: Int = 0, xi <= segments, ++xi {
      let fx: Float = xi.toFloat() / segments.toFloat()
      let localX: Float = (xi - segments / 2).toFloat() * spacing
      let worldX: Float = (cellX * segments + xi - segments / 2).toFloat() * spacing
      let height: Float = terrainTilesHeight(tiles: tiles, x: worldX, y: worldY)
      let slopeX: Float = (terrainTilesHeight(tiles: tiles, x: worldX + eps, y: worldY) - terrainTilesHeight(
        tiles: tiles
        x: worldX - eps
        y: worldY
      )) / (eps * 2.0)
      let slopeY: Float = (terrainTilesHeight(tiles: tiles, x: worldX, y: worldY + eps) - terrainTilesHeight(
        tiles: tiles
        x: worldX
        y: worldY - eps
      )) / (eps * 2.0)
      let inverseLength: Float = 1.0 / Math.sqrt(x: slopeX * slopeX + slopeY * slopeY + 1.0)
      let base: Int = (yi * (segments + 1) + xi) * 8
      tiles.scratchVerts.set(index: base, value: localX)
      tiles.scratchVerts.set(index: base + 1, value: localY)
      tiles.scratchVerts.set(index: base + 2, value: height)
      tiles.scratchVerts.set(index: base + 3, value: -slopeX * inverseLength)
      tiles.scratchVerts.set(index: base + 4, value: -slopeY * inverseLength)
      tiles.scratchVerts.set(index: base + 5, value: inverseLength)
      tiles.scratchVerts.set(index: base + 6, value: fx)
      tiles.scratchVerts.set(index: base + 7, value: fy)
    }
  }
  RendererDeferred.updateMeshVerts(
    renderer: renderer
    mesh: meshHandle(id: meshId, generation: 0)
    verts: tiles.scratchVerts
    vertCount: (segments + 1) * (segments + 1)
  )
}

# Draw every placed tile with the terrain material (the G-buffer pass, or the
# forward pass of a forward frame)
func drawTerrainTiles(
  tiles: view TerrainTiles
  cache: mod GbufferCache
  resources: mod GpuResources
  time: view Float
) {
  loop let tile: view TerrainTile in tiles.tiles {
    if tile.meshId >= 1 and tile.cellX is not 1000000000 and tile.ready {
      let model: Mat4 = mat4Translate(
        x: tile.cellX.toFloat() * tiles.cellSize
        y: tile.cellY.toFloat() * tiles.cellSize
        z: 0.0 - tiles.drawDrop
      )
      drawTerrainMesh(
        cache: cache
        resources: resources
        mesh: tile.meshId
        model: model
        prevModel: model
        roughness: 0.96
        time: time
      )
    }
  }
}

func terrainTilesHasHole(tiles: view TerrainTiles) ret Bool {
  ret tiles.holeMinX <= tiles.holeMaxX and tiles.holeMinY <= tiles.holeMaxY
}

# Does the tile of cell (`cellX`, `cellY`) reach into the hole
# (minX, minY)-(maxX, maxY)?
func terrainTileTouches(
  tiles: view TerrainTiles
  cellX: view Int
  cellY: view Int
  minX: view Float
  minY: view Float
  maxX: view Float
  maxY: view Float
) ret Bool {
  let half: Float = tiles.cellSize * 0.5
  let centerX: Float = cellX.toFloat() * tiles.cellSize
  let centerY: Float = cellY.toFloat() * tiles.cellSize
  ret minX <= maxX and minY <= maxY and centerX + half > minX and centerX - half < maxX and centerY + half > minY and centerY - half < maxY
}

# Leave out of the tiles every quad wholly inside the world rectangle
# (minX, minY)-(maxX, maxY): the area a finer ground covers. Only the tiles
# the old or the new hole touches are rewritten (their indices; the
# vertices stay). min > max: no hole.
func setTerrainTilesHole(
  tiles: mod TerrainTiles
  renderer: mod DeferredRenderer
  minX: view Float
  minY: view Float
  maxX: view Float
  maxY: view Float
) {
  if minX is tiles.holeMinX and minY is tiles.holeMinY and maxX is tiles.holeMaxX and maxY is tiles.holeMaxY {
    ret
  }
  let oldMinX: Float = tiles.holeMinX
  let oldMinY: Float = tiles.holeMinY
  let oldMaxX: Float = tiles.holeMaxX
  let oldMaxY: Float = tiles.holeMaxY
  tiles.holeMinX = minX
  tiles.holeMinY = minY
  tiles.holeMaxX = maxX
  tiles.holeMaxY = maxY
  loop var i: Int = 0, i < tiles.tiles.length, ++i {
    let tile: TerrainTile = tiles.tiles.copyAtDefault(index: i)
    if tile.meshId < 1 or tile.cellX is 1000000000 {
      continue
    }
    if terrainTileTouches(
      tiles: tiles
      cellX: tile.cellX
      cellY: tile.cellY
      minX: oldMinX
      minY: oldMinY
      maxX: oldMaxX
      maxY: oldMaxY
    ) or terrainTileTouches(
      tiles: tiles
      cellX: tile.cellX
      cellY: tile.cellY
      minX: minX
      minY: minY
      maxX: maxX
      maxY: maxY
    ) {
      cutTerrainTileHole(
        tiles: tiles
        renderer: renderer
        meshId: tile.meshId
        cellX: tile.cellX
        cellY: tile.cellY
      )
    }
  }
}

# Rewrite one tile's indices for cell (`cellX`, `cellY`): every quad but
# those wholly inside the hole, in makePlane's winding (a degenerate
# triangle when none is left, so the draw stays valid)
func cutTerrainTileHole(
  tiles: mod TerrainTiles
  renderer: mod DeferredRenderer
  meshId: view Int
  cellX: view Int
  cellY: view Int
) {
  let segments: Int = tiles.segments
  let spacing: Float = tiles.cellSize / segments.toFloat()
  let stride: Int = segments + 1
  tiles.scratchIndices.clear()
  loop var row: Int = 0, row < segments, ++row {
    let lowY: Float = (cellY * segments + row - segments / 2).toFloat() * spacing
    let inY: Bool = lowY >= tiles.holeMinY and lowY + spacing <= tiles.holeMaxY
    loop var column: Int = 0, column < segments, ++column {
      let lowX: Float = (cellX * segments + column - segments / 2).toFloat() * spacing
      if inY and lowX >= tiles.holeMinX and lowX + spacing <= tiles.holeMaxX {
        continue
      }
      let a: Int = row * stride + column
      let b: Int = a + stride
      tiles.scratchIndices.add(value: a)
      tiles.scratchIndices.add(value: a + 1)
      tiles.scratchIndices.add(value: b)
      tiles.scratchIndices.add(value: b)
      tiles.scratchIndices.add(value: a + 1)
      tiles.scratchIndices.add(value: b + 1)
    }
  }
  if tiles.scratchIndices.length is 0 {
    tiles.scratchIndices.add(value: 0)
    tiles.scratchIndices.add(value: 0)
    tiles.scratchIndices.add(value: 0)
  }
  if let resources: view GpuResources = renderer.gpuResources {
    let wrote: Bool = meshStoreUpdateIndices(
      store: renderer.passes.gbuffer.meshes
      resources: resources
      mesh: meshHandle(id: meshId, generation: 0)
      indices: tiles.scratchIndices
    )
  }
}

# ----- an app's own terrain -------------------------------------------------
# The app's answer for one wanted cell: its tile's mesh from the patch's heights (normals from
# the border too, so no seam), its kinds into the kind map; the tile is drawn from now on. False
# when no tile waits for that cell (the window moved on).
func commitTerrainPatch(
  tiles: mod TerrainTiles
  renderer: mod DeferredRenderer
  patch: view TerrainPatch
) ret Bool {
  let slot: Int = terrainTileWrap(value: patch.cellY, side: tiles.gridSide) * tiles.gridSide + terrainTileWrap(
    value: patch.cellX
    side: tiles.gridSide
  )
  var meshId: Int = 0
  if let tile: view TerrainTile = tiles.tiles.viewAt(index: slot) {
    if tile.cellX is patch.cellX and tile.cellY is patch.cellY {
      meshId = tile.meshId
    }
  }
  var still: List(TerrainCell) = List.create(TerrainCell, cap: tiles.wanted.length)
  loop let cell: view TerrainCell in tiles.wanted {
    if cell.x is not patch.cellX or cell.y is not patch.cellY {
      still.add(value: cell)
    }
  }
  tiles.wanted = still
  if meshId < 1 or patch.segments is not tiles.segments {
    ret false
  }
  let segments: Int = tiles.segments
  let spacing: Float = tiles.cellSize / segments.toFloat()
  loop var j: Int = 0, j <= segments, ++j {
    loop var i: Int = 0, i <= segments, ++i {
      let normal: Vec3 = terrainPatchNormal(
        patch: patch
        i: i
        j: j
        cellSize: tiles.cellSize
      )
      let base: Int = (j * (segments + 1) + i) * 8
      tiles.scratchVerts.set(index: base, value: (i - segments / 2).toFloat() * spacing)
      tiles.scratchVerts.set(index: base + 1, value: (j - segments / 2).toFloat() * spacing)
      tiles.scratchVerts.set(index: base + 2, value: terrainPatchHeight(patch: patch, i: i, j: j))
      tiles.scratchVerts.set(index: base + 3, value: normal.x)
      tiles.scratchVerts.set(index: base + 4, value: normal.y)
      tiles.scratchVerts.set(index: base + 5, value: normal.z)
      tiles.scratchVerts.set(index: base + 6, value: i.toFloat() / segments.toFloat())
      tiles.scratchVerts.set(index: base + 7, value: j.toFloat() / segments.toFloat())
      # its kinds, at its lattice point in the wrapping map
      let texel: Int = terrainKindMapWrap(
        index: terrainLatticeIndex(cell: patch.cellY, i: j, segments: segments)
      ) * terrainKindMapSide + terrainKindMapWrap(
        index: terrainLatticeIndex(cell: patch.cellX, i: i, segments: segments)
      )
      tiles.kindTexelsLow.set(
        index: texel
        value: terrainKindTexel(
          a: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 0
          )
          b: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 1
          )
          c: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 2
          )
          d: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 3
          )
        )
      )
      tiles.kindTexelsHigh.set(
        index: texel
        value: terrainKindTexel(
          a: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 4
          )
          b: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 5
          )
          c: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 6
          )
          d: terrainPatchWeight(
            patch: patch
            i: i
            j: j
            kind: 7
          )
        )
      )
    }
  }
  RendererDeferred.updateMeshVerts(
    renderer: renderer
    mesh: meshHandle(id: meshId, generation: 0)
    verts: tiles.scratchVerts
    vertCount: (segments + 1) * (segments + 1)
  )
  if terrainTilesHasHole(tiles: tiles) {
    cutTerrainTileHole(
      tiles: tiles
      renderer: renderer
      meshId: meshId
      cellX: patch.cellX
      cellY: patch.cellY
    )
  }
  if let tile: mod TerrainTile = tiles.tiles.modAt(index: slot) {
    tile.ready = true
  }
  tiles.kindsChanged = true
  ret true
}

# The kind map to the GPU when patches changed it (once a frame, after the commits)
func uploadTerrainKinds(tiles: mod TerrainTiles) {
  if not tiles.appSource or not tiles.kindsChanged {
    ret
  }
  terrainUploadLayer(
    layer: 0
    pixels: tiles.kindTexelsLow.data
    w: terrainKindMapSide
    h: terrainKindMapSide
  )
  terrainUploadLayer(
    layer: 1
    pixels: tiles.kindTexelsHigh.data
    w: terrainKindMapSide
    h: terrainKindMapSide
  )
  tiles.kindsChanged = false
}

# The kinds shader (terrain_kinds.wgsl) for an app's own terrain, its kinds looking as `looks`
# say (app3d/TerrainPatch TerrainKindLook), its kind map's spacing the tiles'
func setTerrainKindsShader(
  renderer: mod DeferredRenderer
  tiles: view TerrainTiles
  looks: view List(TerrainKindLook)
) {
  var constants: List(ShaderConstant) = terrainKindConstants(looks: looks)
  constants.add(
    value: { name: "RAE_KINDS_SPACING", value: tiles.cellSize / tiles.segments.toFloat() }
  )
  RendererDeferred.rendererSetTerrainShaderWithConstants(
    renderer: renderer
    shader: shader(
      files: ["lib/grass_field.wgsl", "lib/wind.wgsl", "lib/snow.wgsl", "lib/terrain_kinds.wgsl"]
    )
    constants: own constants
  )
}
