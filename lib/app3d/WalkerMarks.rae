# app3d/WalkerMarks — the walker's footprints and what its steps kick up
# (app3d/Footprints, app3d/GroundParticles): every character with a mover
# leaves a print each stride, a shade of the ground there, and kicks up bits
# of grass in the meadow or puffs of sand elsewhere. What is underfoot is the
# world's terrain field (WorldBiome): its blended ground color, grass where
# it is mostly meadow.
import Math
import Vec3
open WorldBiome
open Wind
open ecs/ComponentTable
open RendererDeferred
open Gbuffer
open gpu/GpuResources
open app3d/GroundTouch
open app3d/GroundParticles
open app3d/Footprints
open app3d/GroundPalette
open app3d/Precipitation
open LeafParticles
open app3d/WalkerPhysics
open app3d/WalkerWorld

# How far over the height field a print lies: the terrain mesh is drawn from
# the same field, but flat between its vertices
const walkerMarkLift: Float = 0.04

type WalkerMarks {
  footprints: Footprints
  groundParticles: GroundParticles
  random: Random
  # The rain and the falling snow round the camera (app3d/Precipitation),
  # and this frame's: the weather's rate (mm of water an hour), the air
  # (°C), the eye and the clock (s), set by the update
  precipitation: Precipitation
  precipitationRate: Float = 0.0
  precipitationAir: Float = 10.0
  precipitationEye: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  precipitationClock: Float = 0.0
  # The leaves in the air and on the ground (lib/LeafParticles, on the
  # GPU), released by the update (app3d/LeafRelease), and a frame count
  leafParticles: LeafParticles
  leafFrame: Int = 0
}

# Room for `characterCount` characters' full trails
func createWalkerMarks(
  renderer: mod DeferredRenderer
  characterCount: view Int
  biome: view BiomeConfig
) ret WalkerMarks {
  ret WalkerMarks {
    footprints: createFootprints(
      renderer: renderer
      tuning: defaultFootprintTuning()
      characterCapacity: characterCount
    )
    groundParticles: createGroundParticles(renderer: renderer, capacity: 256)
    random: createRandom(seed: 1147)
    precipitation: createPrecipitation(renderer: renderer)
    leafParticles: createLeafParticles(
      capacity: walkerLeafCapacity
      constants: islandConstantsFor(cfg: biome)
    )
  }
}

# The most leaves in the air and lying at once
const walkerLeafCapacity: Int = 8192

# How far from the eye trees let leaves go (m), and how far a leaf may be
# carried before it is gone (a gale's cloud stays in view downwind)
const walkerLeafReach: Float = 40.0

const walkerLeafKeep: Float = 110.0

# How deep the water over the ground may be before a step is in water (m):
# a wet foot on the shore still kicks up its sand
const walkerMarkWaterDepth: Float = 0.03

# What is under (`x`, `y`) on the terrain field of `biome` at `groundZ`:
# grass blades the color of the grass there (the ground palette's,
# `palette`, mid-blade: the blades lighten from the root's ground color to
# the tip), and in water nothing kicked up (the water splashes instead)
func walkerGroundAnswer(
  x: view Float
  y: view Float
  biome: view BiomeConfig
  groundZ: view Float
  palette: view GroundPalette
) ret GroundAnswer {
  let depth: Float = worldWaterZ(groundZ: groundZ, cfg: biome) - worldTerrainHeight(
    x: x
    y: y
    groundZ: groundZ
    cfg: biome
  )
  ret GroundAnswer {
    color: biomeGroundColor(x: x, y: y, cfg: biome)
    lift: walkerMarkLift
    blades: worldIsGrass(x: x, y: y, cfg: biome)
    dustColor: sandMatColor()
    bladeColor: Vec3.vscale(
      a: groundGrassAt(palette: palette, moisture: worldMoisture(x: x, y: y, cfg: biome))
      s: 1.3
    )
    inWater: depth > walkerMarkWaterDepth
  }
}

# One frame: the strides finished, answered from the field (the grass in
# the frame's ground `palette`), laid; the particles on
func walkerMarksUpdate(
  walkerMarks: mod WalkerMarks
  physicsSystem: view WalkerPhysics
  world: view WalkerWorld
  biome: view BiomeConfig
  groundZ: view Float
  modelHeight: view Float
  deltaTime: view Float
  palette: view GroundPalette
) {
  findFootsteps(
    footprints: walkerMarks.footprints
    characters: physicsSystem.characters
    controllers: world.controllers
    parked: physicsSystem.moverParked
    heights: world.heights
    fallbackHeight: modelHeight
    groundZ: groundZ
    deltaTime: deltaTime
  )
  loop var i: Int = 0, i < walkerMarks.footprints.touches.length, ++i {
    if let touch: mod GroundTouch = walkerMarks.footprints.touches.modAt(index: i) {
      touch.answer = walkerGroundAnswer(
        x: touch.point.x
        y: touch.point.y
        biome: biome
        groundZ: groundZ
        palette: palette
      )
    }
  }
  layFootsteps(
    footprints: walkerMarks.footprints
    groundParticles: walkerMarks.groundParticles
    random: walkerMarks.random
  )
  groundParticlesUpdate(groundParticles: walkerMarks.groundParticles, deltaTime: deltaTime)
}

# The prints, the particles and the rain or snow into the open geometry pass
func drawWalkerMarks(
  cache: mod GbufferCache
  resources: mod GpuResources
  walkerMarks: mod WalkerMarks
  toon: view Bool
) {
  drawFootprints(
    cache: cache
    resources: resources
    footprints: walkerMarks.footprints
    toon: toon
  )
  drawGroundParticles(
    cache: cache
    resources: resources
    groundParticles: walkerMarks.groundParticles
    toon: toon
  )
  drawLeafParticles(leafParticles: walkerMarks.leafParticles, resources: resources, gbuffer: cache)
  # the rain or the snow, blown by the frame's wind
  drawPrecipitation(
    cache: cache
    resources: resources
    precipitation: walkerMarks.precipitation
    eye: walkerMarks.precipitationEye
    seconds: walkerMarks.precipitationClock
    rate: walkerMarks.precipitationRate
    air: walkerMarks.precipitationAir
    windX: windMetersPerSecond(sway: cache.windX)
    windY: windMetersPerSecond(sway: cache.windY)
  )
}

# How many prints the walker's characters show, all told
func walkerFootprintCount(walkerMarks: view WalkerMarks) ret Int {
  var total: Int = 0
  loop var i: Int = 0, i < componentCount(this: walkerMarks.footprints.trails), ++i {
    total = total + footprintCount(
      footprints: walkerMarks.footprints
      entityId: componentEntityAt(this: walkerMarks.footprints.trails, i: i)
    )
  }
  ret total
}
