# app3d/WalkerNet — the walker examples' seam self test (#746): the shared
# net seam's recycling check (app3d/NetSeam) and this world's physics: a
# Box3D cube above the island, stepped, must have moved.
import Vec3
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open ecs/World
open app3d/NetSeam
open app3d/WalkerPhysics
open app3d/WalkerWorld
open app3d/CharacterBodies

# Spawn/despawn smoke test for the ECS seams (#746): the net seam's recycling
# check, then a Box3D cube high above the island, stepped, must have moved;
# everything it made is gone again, so the world is untouched.
func seamSelfTest(world: mod WalkerWorld, physicsSystem: mod WalkerPhysics) {
  let check: NetRecycleCheck = netRecycleSelfTest(WalkerWorld, world: world)

  let body: EntityId = spawnPhysicsCube(
    physicsSystem: physicsSystem
    allocator: world.allocator
    transforms: world.transforms
    center: Vec3.create(x: 0.0, y: 0.0, z: 200.0)
    halfSize: 0.5
    color: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  setBodyVelocity(
    rigidBodies: physicsSystem.rigidBodies
    entityId: body
    velocity: Vec3.create(x: 1.0, y: 0.0, z: 0.0)
  )
  # The position BEFORE the steps, as plain values: a view would read the row
  # after the steps moved it.
  let beforeX: Float = componentView(this: world.transforms, entityId: body).position.x
  let beforeZ: Float = componentView(this: world.transforms, entityId: body).position.z
  loop var step: Int = 0, step < 6, ++step {
    stepPhysicsBodies(
      physics: physicsSystem.physics
      rigidBodies: physicsSystem.rigidBodies
      transforms: world.transforms
    )
  }
  let after: view Transform3D = componentView(this: world.transforms, entityId: body)
  # x advances with the velocity, z falls under gravity — both must have moved.
  let physicsOk: Bool = after.position.x > beforeX and after.position.z < beforeZ

  despawnCubeEntity(physicsSystem: physicsSystem, world: world, entityId: body)
  log(seamTestLine(check: check, physicsOk: physicsOk))
}
