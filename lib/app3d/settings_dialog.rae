# The shared settings SECTION: scene chooser, animation speed, toon shading,
# sky model and time of day.
#
# It mounts INSIDE the app's side panel, not as a floating dialog. A dialog
# holding the same controls the panel already showed meant two surfaces with one
# job, and the settings button had to explain which one it opened. Now there is
# one panel, and the button hides it.
#
# Same split as the other app3d components — this owns the CHROME
# (`scenes/settings_dialog.raescene`) and the BEHAVIOUR, the app owns where it
# goes and what the values mean. An app mounts it into a host node, forwards
# actions, and reads the state back.
#
# WHY THE STATE LIVES HERE rather than in each app: 110 and 113 had drifted to
# different controls for the same ideas — 110's animation speed was a toggle,
# 113's was a percentage with Slower/Faster. One type means one behaviour, and
# a new setting appears in both apps at once instead of being ported.
#
# Every control is present in every app, INCLUDING the scene buttons in 113,
# which has one scene. An app that cannot honour a setting says so by leaving it
# disabled; hiding it per app is how two dialogs drift back apart.

import core
import math
import string
import vec3
import sky_hosek
import sky
open ui/ecs
open ui/components
open ui/input_gpu2d
open app3d/ui_shell
open app3d/playback
open app3d/slider
open vec3
open sky_hosek
open sky
open app3d/camera_bar

# Which sky model the dialog is asking for. Deliberately not SkyKind: that enum
# also carries `none`, `hdri` and `stylised`, which are not choices this dialog
# offers. Mapping to SkyKind is the app's job, because only the app knows what
# to build a Sky out of.
enum SettingsSkyModel {
  # Hosek-Wilkie: the fitted physical model.
  hosek
  # The model used before Hosek-Wilkie landed.
  preetham
}

const settingsHourMin: Float = 0.0
const settingsHourMax: Float = 24.0

type SettingsState {
  # Play/pause. Shared because both examples had one and they had drifted to
  # different words for the same control — 110 said Resume, 113 said Play.
  playing: Bool
  # Whether the panel BODY is showing. The button that toggles this stays
  # visible either way, or there would be no way to bring the panel back.
  open: Bool
  # 1..3. Kept even where an app has one scene, so the dialog does not need to
  # know which app it is in.
  scene: Int
  sceneCount: Int
  speed: Float
  toon: Bool
  skyModel: SettingsSkyModel
  hour: Float
  # Drag state kept FLAT rather than as a nested Slider. Passing a nested struct
  # field as a `mod` argument does not reliably write back in this compiler and
  # fails silently — the slider looked wired, moved nothing, and reported no
  # change. Same hazard renderer_deferred warns about for the sky.
  timeDragging: Bool
}

# `skyModel` is the app's default, not a shared one: 110 is the realistic scene
# and starts on Preetham, 113 is the stylised one and starts on Hosek. The panel
# switches either.
func createSettingsState(scene: view Int, sceneCount: view Int, speed: view Float,
                         toon: view Bool, hour: view Float,
                         skyModel: SettingsSkyModel) pub ret SettingsState {
  ret SettingsState {
    playing: true
    open: true
    scene: scene
    sceneCount: sceneCount
    speed: speed
    toon: toon
    skyModel: skyModel
    hour: hour
    timeDragging: false
  }
}

# Mounted the way camera_bar is: the app authors a host node and owns where the
# dialog sits; the chrome comes from the shared scene.
func mountSettingsDialog(world: mod UiWorld, res: view Gpu2dUi,
                         hostNodeId: view String) pub ret Bool {
  let host: EntityId = nodeEntityFor(world: world, nodeId: hostNodeId)
  if isNone(this: host) {
    ret false
  }
  let scene: Scene = loadSceneFile(path: "{app3dSceneDir()}settings_dialog.raescene")
  if scene.ok is false {
    ret false
  }
  let overrides: List(SceneOverride) = createList(SceneOverride, cap: 0)
  let root: EntityId = mountSceneInstance(
    world: world, mountEntity: host, scene: scene, overrides: overrides
  )
  if isNone(this: root) {
    ret false
  }
  runUiSystems(world: world, res: res)
  ret true
}

# 12:00, not 12.0 — an hours-and-minutes readout is what a time control means,
# and 6.5 on screen reads as a number rather than as half past six.
func formatHour(hour: view Float) pub ret String {
  var h: Float = hour
  if h < 0.0 { h = 0.0 }
  if h >= 24.0 { h = 23.999 }
  let whole: Int = h.toInt()
  let minutes: Int = ((h - whole.toFloat()) * 60.0).toInt()
  var mm: String = "{minutes}"
  if minutes < 10 {
    mm = "0{minutes}"
  }
  var hh: String = "{whole}"
  if whole < 10 {
    hh = "0{whole}"
  }
  ret "{hh}:{mm}"
}

# Apply one action id. Returns true when something changed, so the caller can
# rebuild only what the change affects. Unknown ids are ignored rather than
# treated as an error: the app forwards every action it sees, including its own.
func settingsHandleAction(s: mod SettingsState, actionId: view String) pub ret Bool {
  # One action, and it TOGGLES: the button shows and hides the panel rather
  # than opening a second surface.
  if actionId.equals(other: "settings.open") {
    s.open = s.open is false
    ret true
  }
  if actionId.equals(other: "settings.playback") {
    s.playing = s.playing is false
    ret true
  }
  if actionId.equals(other: "settings.toon") {
    s.toon = s.toon is false
    ret true
  }
  if actionId.equals(other: "settings.anim.slower") {
    s.speed = nextSpeed(current: s.speed, up: false)
    ret true
  }
  if actionId.equals(other: "settings.anim.faster") {
    s.speed = nextSpeed(current: s.speed, up: true)
    ret true
  }
  if actionId.equals(other: "settings.sky.hosek") {
    s.skyModel = SettingsSkyModel.hosek
    ret true
  }
  if actionId.equals(other: "settings.sky.preetham") {
    s.skyModel = SettingsSkyModel.preetham
    ret true
  }
  # Scene selection is clamped to what the app actually has, so the buttons can
  # exist in an app with one scene without being able to select a second.
  if actionId.equals(other: "settings.scene.1") {
    ret settingsSelectScene(s: s, scene: 1)
  }
  if actionId.equals(other: "settings.scene.2") {
    ret settingsSelectScene(s: s, scene: 2)
  }
  if actionId.equals(other: "settings.scene.3") {
    ret settingsSelectScene(s: s, scene: 3)
  }
  ret false
}

func settingsSelectScene(s: mod SettingsState, scene: view Int) ret Bool {
  if scene > s.sceneCount {
    ret false
  }
  if s.scene is scene {
    ret false
  }
  s.scene = scene
  ret true
}

# Pointer half: drag the time slider. Separate from the action half because
# actions arrive as discrete events while a drag is a per-frame sample.
func settingsUpdatePointer(s: mod SettingsState, world: view UiWorld,
                           input: view UiInput) pub ret Bool {
  if s.open is false {
    ret false
  }
  # A press anywhere on the track starts a drag and jumps the handle there: the
  # handle is small and the track is the affordance.
  var pressedInside: Bool = false
  if input.pointer.pressed {
    pressedInside = pointInNode(world: world, nodeId: "SettingsTimeTrack",
                                x: input.pointer.x, y: input.pointer.y)
  }
  s.timeDragging = sliderDragActive(wasDragging: s.timeDragging,
                                    pressedInside: pressedInside,
                                    down: input.pointer.down,
                                    released: input.pointer.released)
  if s.timeDragging is false {
    ret false
  }
  let f: Float = fractionAcrossNode(world: world, nodeId: "SettingsTimeTrack",
                                    x: input.pointer.x)
  let next: Float = settingsHourMin + f * (settingsHourMax - settingsHourMin)
  if next is s.hour {
    ret false
  }
  s.hour = next
  ret true
}

# Push the state onto the mounted chrome. Cheap enough to call whenever
# something changed; every write underneath is guarded against writing an
# unchanged value.
func settingsApplyToWorld(s: view SettingsState, world: mod UiWorld) pub {
  var playLabel: String = "Pause"
  if s.playing is false {
    playLabel = "Play"
  }
  setNodeText(world: world, nodeId: "SettingsPlayLabel", value: playLabel)
  setNodeFillSlot(world: world, nodeId: "SettingsPlayButton",
                  slot: settingsSlotFor(on: s.playing is false))
  let pct: Int = speedPercent(v: s.speed)
  setNodeText(world: world, nodeId: "SettingsSpeedRow", value: "Animation speed {pct}%")
  setNodeText(world: world, nodeId: "SettingsTimeLabel", value: "Time of day {formatHour(hour: s.hour)}")

  setNodeFillSlot(world: world, nodeId: "SettingsToonButton",
                  slot: settingsSlotFor(on: s.toon))
  setNodeFillSlot(world: world, nodeId: "SettingsSkyHosek",
                  slot: settingsSlotFor(on: s.skyModel is SettingsSkyModel.hosek))
  setNodeFillSlot(world: world, nodeId: "SettingsSkyPreetham",
                  slot: settingsSlotFor(on: s.skyModel is SettingsSkyModel.preetham))
  setNodeFillSlot(world: world, nodeId: "SettingsScene1", slot: settingsSlotFor(on: s.scene is 1))
  setNodeFillSlot(world: world, nodeId: "SettingsScene2", slot: settingsSlotFor(on: s.scene is 2))
  setNodeFillSlot(world: world, nodeId: "SettingsScene3", slot: settingsSlotFor(on: s.scene is 3))

  # Two drawn parts: the track, and the knob that travels along it. A filled
  # portion made it read as a progress bar, which is a different control.
  let f: Float = (s.hour - settingsHourMin) / (settingsHourMax - settingsHourMin)
  centreNodeAtFraction(world: world, trackId: "SettingsTimeTrack",
                       handleId: "SettingsTimeHandle", fraction: f)
}

# The palette slots the shared components are allowed to name (see
# lib/app3d/README.md — the vocabulary is closed and anything else paints
# magenta).
func settingsSlotFor(on: view Bool) ret String {
  if on {
    ret "accent"
  }
  ret "surfaceAlt"
}

# ----- driving the scene ----------------------------------------------
#
# The panel holds values; these turn them into the things a renderer takes. They
# live here so 110 and 113 cannot disagree about what "10:00, Hosek" means.

# Where the sun is, for this hour. Both the sky and the key light take it, so
# the visible sun and the cast shadows cannot drift apart.
func settingsSunDir(s: view SettingsState) pub ret Vec3 {
  ret sunDirForHour(hour: s.hour)
}

# Warm at the horizon, neutral overhead, and dimmed as the sun sets — the sky
# model reddens on its own, but the direct light would otherwise stay white and
# full-strength through a sunset.
func settingsSunColor(s: view SettingsState) pub ret Vec3 {
  let base: Vec3 = sunColorForHour(hour: s.hour)
  var lift: Float = sunHeightForHour(hour: s.hour)
  # Never fully black: a scene lit by nothing reads as broken rather than as
  # night, and there is no night sky model here yet.
  lift = 0.15 + 0.85 * lift
  ret vec3.create(x: base.x * lift, y: base.y * lift, z: base.z * lift)
}

# Build the sky the panel is asking for. `data` is only read by the Hosek
# branch; a caller with no dataset can pass an empty one and still get Preetham.
func settingsBuildSky(s: view SettingsState, data: view HosekDataset,
                      turbidity: view Float, groundAlbedo: view Float) pub ret Sky {
  let dir: Vec3 = settingsSunDir(s: s)
  let col: Vec3 = settingsSunColor(s: s)
  # Both models are fitted only for a sun at or above the horizon, so the night
  # side is a fade rather than a different sky. Applied here, once, so the two
  # models darken together.
  let day: Float = daylightFactorForHour(hour: s.hour)
  if s.skyModel is SettingsSkyModel.preetham {
    var pre: Sky = createSkyProcedural(sunDir: dir, sunColor: col, turbidity: turbidity)
    pre.exposure = day
    pre.sunDiscIntensity = pre.sunDiscIntensity * day
    ret pre
  }
  var hos: Sky = createSkyHosek(data: data, sunDir: dir, sunColor: col,
                                turbidity: turbidity, groundAlbedo: groundAlbedo)
  hos.exposure = day
  hos.sunDiscIntensity = hos.sunDiscIntensity * day
  ret hos
}
