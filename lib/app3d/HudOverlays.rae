# app3d/HudOverlays — the touch controls' frame step (the scene's touch stick
# and the camera's touch split), the overlays an app draws in code over its
# scene UI (the log strip, the debug readout), and hiding the camera bar's
# smoothing toggles. Used by the walker examples (136, 137, 143) and by apps
# with their own shell.
import Gpu2d
open app3d/UiModes
open RendererDeferred
open app3d/SettingsDialog
open app3d/UiShell
open ui/Ecs
open ui/inputSystem/InputSystem
open ui/LogOverlay
open ui/DebugOverlay
open ui/renderSystem/RenderSystem
open ui/touchStickSystem/TouchStickSystem
open ui/Transform
open ui/visualBoundsSystem/VisualBoundsSystem
open app3d/CameraRig
open ui/safeAreaSystem/SafeAreaSystem
open Gpu2dCanvas
open ui/UiSystems

# The touch stick (lib/ui/touchStickSystem: a TouchStick node in the scene,
# shown by its touch frame) for this frame, and the camera rig told to leave
# its zone and its finger alone, so on a phone one finger drives the stick
# while another turns the camera (#526). When the knob moved, the transform
# pass runs so it is drawn where it is. The stick `stickNodeId`'s state: its
# value for movement, `active` while a finger or the mouse holds it.
func updateTouchControls(
  rig: mod CameraRig
  world: mod UiWorld
  uiSystems: mod UiSystems
  res: view Gpu2dUi
  stickNodeId: view String
) ret TouchStickState {
  if touchStickSystem(world: world, uiSystems: uiSystems) {
    transformSystem(world: world, uiSystems: uiSystems)
    visualBoundsSystem(world: world, uiSystems: uiSystems, res: res)
  }
  let stick: TouchStickState = touchStickStateOf(
    world: world
    uiSystems: uiSystems
    nodeId: stickNodeId
  )
  if stick.shown {
    setCameraTouch(
      rig: rig
      excludeId: stick.grabbedId
      joystickActive: stick.active
      zoneX: stick.centerX
      zoneY: stick.centerY
      zoneR: stick.zoneRadius
    )
  } else {
    setCameraTouch(
      rig: rig
      excludeId: -1
      joystickActive: false
      zoneX: 0.0
      zoneY: 0.0
      zoneR: -1.0
    )
  }
  ret stick
}

# Hide the camera bar's "Mouse"/"Keys" smoothing toggles — not needed, and they
# crowd the top bar on a phone. (Their smoothing defaults still apply.)
func hideCameraSmoothingToggles(world: mod UiWorld) {
  setNodeActive(world: world, nodeId: "CameraSmoothMouseButton", value: false)
  setNodeActive(world: world, nodeId: "CameraSmoothKeysButton", value: false)
}

# All HUD overlays, drawn inside the 2D overlay pass (after the ECS UI world).
func drawHudOverlays(
  logOverlay: view LogOverlay
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  dbg: mod DebugOverlay
  editor: view Bool
) {
  # EDITOR: the log strip. The debug readout is both modes'. (The touch stick
  # is a scene node, drawn with the rest of the UI.)
  if editor {
    drawLogOverlay(
      ov: logOverlay
      canvas: canvas
      font: gpuUi.textFont
      screenW: windowExtentW()
      screenH: windowExtentH()
    )
  }
  # Debug D last, so it is above everything else.
  drawDebugOverlay(
    debugOverlay: dbg
    canvas: canvas
    font: gpuUi.textFont
    didRealWork: true
  )
}
