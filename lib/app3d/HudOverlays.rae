# app3d/HudOverlays — the touch controls' frame step (the scene's touch stick
# and the camera's touch split), the system that draws Rae's overlay entities
# (the scene UI, the world's labels, the log strip, the debug readout, by the
# window's layer stack: drawHudLayers) in the 2D overlay pass, and hiding the camera bar's smoothing
# toggles. Used by the walker examples (136, 137, 143) and by apps
# with their own shell.
import Gpu2d
open app3d/UiModes
open RendererDeferred
open app3d/SettingsDialog
open app3d/UiShell
open ui/Ecs
open ui/InputSystem
open ui/LogOverlay
open ui/DebugOverlay
open ui/RenderSystem
open ui/touchStickSystem/TouchStickSystem
open ui/Transform
open ui/visualBoundsSystem/VisualBoundsSystem
open app3d/CameraRig
open ui/safeAreaSystem/SafeAreaSystem
open Gpu2dCanvas
open ui/UiSystems
open ui/UiLayers
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open Scene3d
open app3d/WorldLabel
open app3d/WorldLabelDraw

# The touch stick (lib/ui/touchStickSystem: a TouchStick node in the scene,
# shown by its touch frame) for this frame, and the camera rig told to leave
# its zone and its finger alone, so on a phone one finger drives the stick
# while another turns the camera (#526). When the knob moved, the transform
# pass runs so it is drawn where it is. The stick `stickNodeId`'s state: its
# value for movement, `active` while a finger or the mouse holds it.
func updateTouchControls(
  rig: mod CameraRig
  world: mod UiWorld
  uiSystems: mod UiSystems
  res: view Gpu2dUi
  stickNodeId: view String
) ret TouchStickState {
  if touchStickSystem(world: world, uiSystems: uiSystems) {
    transformSystem(world: world, uiSystems: uiSystems)
    visualBoundsSystem(world: world, uiSystems: uiSystems, res: res)
  }
  let stick: TouchStickState = touchStickStateOf(
    world: world
    uiSystems: uiSystems
    nodeId: stickNodeId
  )
  if stick.shown {
    setCameraTouch(
      rig: rig
      excludeId: stick.grabbedId
      joystickActive: stick.active
      zoneX: stick.centerX
      zoneY: stick.centerY
      zoneR: stick.zoneRadius
    )
  } else {
    setCameraTouch(
      rig: rig
      excludeId: -1
      joystickActive: false
      zoneX: 0.0
      zoneY: 0.0
      zoneR: -1.0
    )
  }
  ret stick
}

# Hide the camera bar's "Mouse"/"Keys" smoothing toggles — not needed, and they
# crowd the top bar on a phone. (Their smoothing defaults still apply.)
func hideCameraSmoothingToggles(world: mod UiWorld) {
  setNodeActive(world: world, nodeId: "CameraSmoothMouseButton", value: false)
  setNodeActive(world: world, nodeId: "CameraSmoothKeysButton", value: false)
}

# What Rae's 3D shell draws in 2D over the frame, by the window's layer stack
# (ui/UiLayers; docs/ui-layers-design.md): the world's labels in the world layer
# (game mode), the scene UI's roots in their layers, the log strip in the log layer
# (editor mode) and the debug readout in the debug layer. The app keeps one
# HudLayerPaint (the walkers on their WalkerRender) and calls drawHudLayers in its
# 2D overlay pass; an app's own drawing is a LayerDraw it adds (addLayerDraw) and
# draws itself when the plan reaches it.
type HudLayerPaint {
  stack: LayerStack
  contributions: List(LayerContribution)
  plan: LayerPaintPlan
}

func createHudLayerPaint() ret HudLayerPaint {
  var stack: LayerStack = createStandardLayerStack()
  # the world's labels are a game-mode thing
  setLayerShows(stack: stack, name: "world", shows: LayerShows.gameMode)
  layerStackAddWorld(stack: stack, worldKey: 0)
  let unusedLabels: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw {
      layer: layerIdOf(stack: stack, name: "world")
      kind: LayerDrawKind.worldLabels
    }
  )
  let unusedLog: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw { layer: layerIdOf(stack: stack, name: "log"), kind: LayerDrawKind.logStrip }
  )
  let unusedDebug: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw {
      layer: layerIdOf(stack: stack, name: "debug")
      kind: LayerDrawKind.debugReadout
    }
  )
  ret HudLayerPaint {
    stack: own stack
    contributions: { createLayerContribution(worldKey: 0) }
    plan: createLayerPaintPlan()
  }
}

# This frame's plan for the UI world `world` (its own layers adopted, its roots
# refreshed), in game or editor mode
func buildHudLayerPlan(
  paint: mod HudLayerPaint
  world: view UiWorld
  uiSystems: view UiSystems
  editor: view Bool
) {
  adoptWorldLayers(stack: paint.stack, world: world)
  if let contribution: mod LayerContribution = paint.contributions.modAt(index: 0) {
    refreshLayerContribution(
      contribution: contribution
      stack: paint.stack
      world: world
      uiSystems: uiSystems
    )
  }
  buildLayerPaintPlan(
    plan: paint.plan
    stack: paint.stack
    contributions: paint.contributions
    editor: editor
  )
}

# Everything 2D over the frame, in layer order, inside the 2D overlay pass: the
# scene UI's roots and layers, and Rae's draws (world labels, log strip, debug
# readout); an app's own draws (LayerDrawKind.app) are left to the app
func drawHudLayers(
  paint: mod HudLayerPaint
  world: view UiWorld
  uiSystems: view UiSystems
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  logOverlay: view LogOverlay
  dbg: mod DebugOverlay
  labels: view ComponentTable(WorldLabel)
  transforms: view ComponentTable(Transform3D)
  camera: view Camera3d
  editor: view Bool
) {
  buildHudLayerPlan(
    paint: paint
    world: world
    uiSystems: uiSystems
    editor: editor
  )
  loop let step: view PaintStep in paint.plan.steps {
    if not paintPlanStepRaeG(
      step: step
      stack: paint.stack
      worldKey: 0
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    ) and step.kind is PaintStepKind.draw {
      let draw: LayerDraw = paint.stack.draws.copyAtFallback(
        index: step.draw
        fallback: LayerDraw { layer: -1, kind: LayerDrawKind.app }
      )
      if draw.kind is LayerDrawKind.worldLabels {
        drawWorldLabels(
          labels: labels
          transforms: transforms
          camera: camera
          canvas: canvas
          font: gpuUi.textFont
        )
      } else if draw.kind is LayerDrawKind.logStrip {
        drawLogOverlay(
          ov: logOverlay
          canvas: canvas
          font: gpuUi.textFont
          screenW: windowExtentW()
          screenH: windowExtentH()
        )
      } else if draw.kind is LayerDrawKind.debugReadout {
        drawDebugOverlay(
          debugOverlay: dbg
          canvas: canvas
          font: gpuUi.textFont
          didRealWork: true
        )
      }
    }
  }
  renderSharedNodesGpu2d(
    world: world
    uiSystems: uiSystems
    res: gpuUi
    canvas: canvas
  )
  # a dragged canvas node's snapping guides, over everything (ui/canvasGestureSystem)
  paintCanvasGuidesG(world: world, canvas: canvas)
}
