# app3d/HudOverlays — the on-screen overlays an app draws in code over its
# scene UI: the touch joystick (with the camera's touch split and the OS safe
# area), the log strip and the debug readout, and hiding the camera bar's
# smoothing toggles. Used by the walker examples (136, 137, 143) and by apps
# with their own shell.
import Gpu2d
open app3d/UiModes
open RendererDeferred
open app3d/SettingsDialog
open app3d/UiShell
open ui/Ecs
open ui/inputSystem/InputSystem
open ui/LogOverlay
open ui/DebugOverlay
open ui/renderSystem/RenderSystem
open ui/VirtualJoystick
open app3d/CameraRig
open ui/safeAreaSystem/SafeAreaSystem
open Gpu2dCanvas
open ui/UiSystems

# Update the touch stick AND tell the camera rig to exclude its region, so on a
# phone one finger drives the joystick while another rotates the camera (#526).
func updateTouchControls(
  rig: mod CameraRig
  moveStick: mod VirtualJoystick
  enabled: view Bool
) ret Bool {
  # (The screen's safe area is the layout pass's own step: lib/ui/safeAreaSystem
  # feedSafeArea, run by runUiSystems.)
  # The stick is GAME mode's: in EDITOR it is left alone and the camera gets
  # every finger
  if enabled is false {
    setCameraTouch(
      rig: rig
      excludeId: -1
      joystickActive: false
      zoneX: 0.0
      zoneY: 0.0
      zoneR: -1.0
    )
    ret false
  }
  let active: Bool = updateVirtualJoystick(joy: moveStick)
  # Hand the camera the joystick's exclusion zone (same radius the stick grabs
  # with) + the owned finger id: a press inside the zone is the stick's, outside
  # is the camera's, and each holds its finger for the whole drag.
  setCameraTouch(
    rig: rig
    excludeId: moveStick.grabbedId
    joystickActive: active
    zoneX: moveStick.baseX
    zoneY: moveStick.baseY
    zoneR: zoneRadius(joy: moveStick)
  )
  ret active
}

# Hide the camera bar's "Mouse"/"Keys" smoothing toggles — not needed, and they
# crowd the top bar on a phone. (Their smoothing defaults still apply.)
func hideCameraSmoothingToggles(world: mod UiWorld) {
  setNodeActive(world: world, nodeId: "CameraSmoothMouseButton", value: false)
  setNodeActive(world: world, nodeId: "CameraSmoothKeysButton", value: false)
}

# All HUD overlays, drawn inside the 2D overlay pass (after the ECS UI world).
func drawHudOverlays(
  logOverlay: view LogOverlay
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  dbg: mod DebugOverlay
  moveStick: view VirtualJoystick
  editor: view Bool
  touchControls: view Bool
) {
  # GAME mode: the touch stick when touch controls are shown (a phone, or the
  # "..." menu's "Simulate mobile phone"); EDITOR: the log strip. The debug
  # readout is both modes'.
  if editor {
    drawLogOverlay(
      ov: logOverlay
      canvas: canvas
      font: gpuUi.textFont
      screenW: windowExtentW()
      screenH: windowExtentH()
    )
  } else if touchControls {
    drawVirtualJoystick(joy: moveStick, canvas: canvas)
  }
  # Debug D last, so it is above everything else.
  drawDebugOverlay(
    debugOverlay: dbg
    canvas: canvas
    font: gpuUi.textFont
    didRealWork: true
  )
}
