# app3d/HudOverlays — the touch controls' frame step (the scene's touch stick
# and the camera's touch split), the system that draws Rae's overlay entities
# (the scene UI, the world's labels, the log strip, the debug readout, by the
# window's layer stack: drawHudLayers) in the 2D overlay pass, and hiding the camera bar's smoothing
# toggles. Used by the walker examples (136, 137, 143) and by apps
# with their own shell.
import Gpu2d
import Vec3
open app3d/UiModes
open RendererDeferred
open app3d/SettingsDialog
open app3d/UiShell
open ui/Ecs
open ui/InputSystem
open ui/LogOverlay
open ui/DebugOverlay
open ui/RenderSystem
open ui/touchStickSystem/TouchStickSystem
open ui/Transform
open ui/visualBoundsSystem/VisualBoundsSystem
open app3d/CameraRig
open ui/safeAreaSystem/SafeAreaSystem
open Gpu2dCanvas
open SdfText
open ui/UiSystems
open ui/UiLayers
open ui/LayerFrame
open ui/LayerCapture
open ui/LayerHit
open ui/WorldInput
open ui/DebugLayers
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open Scene3d
open app3d/WorldLabel
open app3d/WorldLabelDraw

# The touch stick (lib/ui/touchStickSystem: a TouchStick node in the scene,
# shown by its touch frame) for this frame, and the camera rig told to leave
# its zone and its finger alone, so on a phone one finger drives the stick
# while another turns the camera (#526). When the knob moved, the transform
# pass runs so it is drawn where it is. The stick `stickNodeId`'s state: its
# value for movement, `active` while a finger or the mouse holds it.
func updateTouchControls(
  rig: mod CameraRig
  world: mod UiWorld
  uiSystems: mod UiSystems
  res: view Gpu2dUi
  stickNodeId: view String
  blockedIds: view List(Int)
) ret TouchStickState {
  if touchStickSystemBlocking(world: world, uiSystems: uiSystems, blockedIds: blockedIds) {
    transformSystem(world: world, uiSystems: uiSystems)
    visualBoundsSystem(world: world, uiSystems: uiSystems, res: res)
  }
  let stick: TouchStickState = touchStickStateOf(
    world: world
    uiSystems: uiSystems
    nodeId: stickNodeId
  )
  if stick.shown {
    setCameraTouch(
      rig: rig
      excludeId: stick.grabbedId
      joystickActive: stick.active
      zoneX: stick.centerX
      zoneY: stick.centerY
      zoneR: stick.zoneRadius
    )
  } else {
    setCameraTouch(
      rig: rig
      excludeId: -1
      joystickActive: false
      zoneX: 0.0
      zoneY: 0.0
      zoneR: -1.0
    )
  }
  ret stick
}

# Hide the camera bar's "Mouse"/"Keys" smoothing toggles — not needed, and they
# crowd the top bar on a phone. (Their smoothing defaults still apply.)
func hideCameraSmoothingToggles(world: mod UiWorld) {
  setNodeActive(world: world, nodeId: "CameraSmoothMouseButton", value: false)
  setNodeActive(world: world, nodeId: "CameraSmoothKeysButton", value: false)
}

# What Rae's 3D shell draws in 2D over the frame, by the window's layer stack
# (ui/UiLayers; docs/ui-layers-design.md): the world's labels in the world layer
# (game mode), the scene UI's roots in their layers, the log strip in the log layer
# (editor mode) and the debug readout in the debug layer. The app keeps one
# HudLayerPaint (the walkers on their WalkerRender) and calls drawHudLayers in its
# 2D overlay pass; an app's own drawing is a LayerDraw it adds (addLayerDraw) and
# draws itself when the plan reaches it.
type HudLayerPaint {
  stack: LayerStack
  contributions: List(LayerContribution)
  plan: LayerPaintPlan
}

func createHudLayerPaint() ret HudLayerPaint {
  var stack: LayerStack = createStandardLayerStack()
  # the world's labels are a game-mode thing
  setLayerShows(stack: stack, name: "world", shows: LayerShows.gameMode)
  layerStackAddWorld(stack: stack, worldKey: 0)
  let unusedLog: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw { layer: layerIdOf(stack: stack, name: "log"), kind: LayerDrawKind.logStrip }
  )
  let unusedDebug: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw {
      layer: layerIdOf(stack: stack, name: "debug")
      kind: LayerDrawKind.debugReadout
    }
  )
  ret HudLayerPaint {
    stack: own stack
    contributions: { createLayerContribution(worldKey: 0) }
    plan: createLayerPaintPlan()
  }
}

# This frame's plan for the UI world `world` (its roots refreshed), in game or editor mode
func buildHudLayerPlan(
  paint: mod HudLayerPaint
  world: view UiWorld
  uiSystems: view UiSystems
  editor: view Bool
) {
  if let contribution: mod LayerContribution = paint.contributions.modAt(index: 0) {
    refreshLayerContribution(
      contribution: contribution
      stack: paint.stack
      world: world
      uiSystems: uiSystems
    )
  }
  buildLayerPaintPlan(
    plan: paint.plan
    stack: paint.stack
    contributions: paint.contributions
    editor: editor
  )
}

# Everything 2D over the frame, in layer order, inside the 2D overlay pass: the
# scene UI's roots and layers, and Rae's draws (world labels, log strip, debug
# readout); an app's own draws (LayerDrawKind.app) are left to the app
func drawHudLayers(
  paint: mod HudLayerPaint
  world: view UiWorld
  uiSystems: view UiSystems
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  logOverlay: view LogOverlay
  dbg: mod DebugOverlay
  labels: view ComponentTable(WorldLabel)
  transforms: view ComponentTable(Transform3D)
  camera: view Camera3d
  editor: view Bool
) {
  # the window and its safe area (a safeArea layer is clipped to it), and the world's labels as
  # world anchors, sorted far to near with any of the app's own (ui/LayerFrame)
  setLayerStackFrame(
    stack: paint.stack
    width: windowExtentW()
    height: windowExtentH()
    safe: screenSafeInsets(world: world)
    reserved: reservedInsets(world: world)
  )
  addWorldLabelAnchors(paint: paint, labels: labels, transforms: transforms)
  sortWorldAnchors(
    stack: paint.stack
    cameraX: camera.position.x
    cameraY: camera.position.y
    cameraZ: camera.position.z
  )
  buildHudLayerPlan(
    paint: paint
    world: world
    uiSystems: uiSystems
    editor: editor
  )
  loop let step: view PaintStep in paint.plan.steps {
    if step.kind is PaintStepKind.worldAnchor and step.appKind is worldLabelAnchorKind {
      drawWorldLabelAnchor(
        paint: paint
        step: step
        labels: labels
        camera: camera
        canvas: canvas
        font: gpuUi.textFont
      )
      continue
    }
    if not paintPlanStepRaeG(
      step: step
      stack: paint.stack
      worldKey: 0
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    ) and step.kind is PaintStepKind.draw {
      let clipped: Bool = beginLayerDrawG(step: step, stack: paint.stack, canvas: canvas)
      let draw: LayerDraw = paint.stack.draws.copyAtFallback(
        index: step.draw
        fallback: LayerDraw { layer: -1, kind: LayerDrawKind.app }
      )
      if draw.kind is LayerDrawKind.worldLabels {
        drawWorldLabels(
          labels: labels
          transforms: transforms
          camera: camera
          canvas: canvas
          font: gpuUi.textFont
        )
      } else if draw.kind is LayerDrawKind.logStrip {
        drawLogOverlay(
          ov: logOverlay
          canvas: canvas
          font: gpuUi.textFont
          screenW: windowExtentW()
          screenH: windowExtentH()
        )
      } else if draw.kind is LayerDrawKind.debugReadout {
        feedDebugLayers(debugOverlay: dbg, stack: paint.stack, contributions: paint.contributions)
        drawDebugOverlay(
          debugOverlay: dbg
          canvas: canvas
          font: gpuUi.textFont
          didRealWork: true
        )
      }
      endLayerDrawG(canvas: canvas, pushed: clipped)
    }
  }
  renderSharedNodesGpu2d(
    world: world
    uiSystems: uiSystems
    res: gpuUi
    canvas: canvas
  )
  # a dragged canvas node's snapping guides, over everything (ui/canvasGestureSystem)
  paintCanvasGuidesG(world: world, canvas: canvas)
}

# This frame's world anchors: cleared, then every world label added (kind worldLabelAnchorKind,
# its index as the id); an app with anchors of its own adds them after this, before its plan is
# built
func addWorldLabelAnchors(
  paint: mod HudLayerPaint
  labels: view ComponentTable(WorldLabel)
  transforms: view ComponentTable(Transform3D)
) {
  clearWorldAnchors(stack: paint.stack)
  loop var i: Int = 0, i < componentCount(this: labels), ++i {
    let label: view WorldLabel = componentView(
      this: labels
      entityId: componentEntityAt(this: labels, i: i)
    )
    if let at: Vec3 = labelWorldPoint(label: label, transforms: transforms) {
      worldAnchorDraw(
        stack: paint.stack
        x: at.x
        y: at.y
        z: at.z
        appKind: worldLabelAnchorKind
        id: i
      )
    }
  }
}

# One world label, at its anchor step
func drawWorldLabelAnchor(
  paint: view HudLayerPaint
  step: view PaintStep
  labels: view ComponentTable(WorldLabel)
  camera: view Camera3d
  canvas: mod Gpu2dCanvas
  font: view SdfFont
) {
  if let anchor: view WorldAnchor = paint.stack.anchors.viewAt(index: step.draw) {
    if anchor.id < componentCount(this: labels) {
      drawLabelAt(
        canvas: canvas
        font: font
        camera: camera
        label: componentView(this: labels, entityId: componentEntityAt(this: labels, i: anchor.id))
        at: Vec3.create(x: anchor.x, y: anchor.y, z: anchor.z)
      )
    }
  }
}

# This frame's presses through the last drawn plan (the one on screen): the mouse (pointer -1) and
# each finger (its touch id) captured by what the hit walk finds, released when let go, and every
# capture under a modal that shows now canceled (ui/LayerCapture). The camera, the touch stick and
# the keys ask the claims after this.
func hudCapturesStep(
  paint: view HudLayerPaint
  captures: mod UiCaptures
  world: view UiWorld
  uiSystems: view UiSystems
) {
  capturesFrameBegin(
    captures: captures
    plan: paint.plan
    stack: paint.stack
    contributions: paint.contributions
  )
  feedUiTextFocus(captures: captures, world: world)
  if Gpu2d.pointerReleased() {
    captureRelease(captures: captures, pointerId: -1)
  }
  if Gpu2d.pointerPressed() {
    hudCapturePress(
      paint: paint
      captures: captures
      world: world
      uiSystems: uiSystems
      pointerId: -1
      x: Gpu2d.pointerX()
      y: Gpu2d.pointerY()
    )
  }
  hudCaptureButton(
    paint: paint
    captures: captures
    world: world
    uiSystems: uiSystems
    button: Gpu2d.PointerButton.middle
    pointerId: pointerIdMiddle
  )
  hudCaptureButton(
    paint: paint
    captures: captures
    world: world
    uiSystems: uiSystems
    button: Gpu2d.PointerButton.secondary
    pointerId: pointerIdSecondary
  )
  # fingers that are gone let go of their captures
  loop var c: Int = captures.captures.length - 1, c >= 0, --c {
    let pointerId: Int = captures.captures.copyAtFallback(
      index: c
      fallback: PointerCapture { pointerId: -1, hit: UiHit {}, claimed: false }
    ).pointerId
    if pointerId >= 0 {
      var down: Bool = false
      loop var i: Int = 0, i < Gpu2d.touchCount(), ++i {
        if Gpu2d.touchId(index: i) is pointerId {
          down = true
        }
      }
      if not down {
        captureRelease(captures: captures, pointerId: pointerId)
      }
    }
  }
  loop var i: Int = 0, i < Gpu2d.touchCount(), ++i {
    if Gpu2d.touchPressed(index: i) {
      hudCapturePress(
        paint: paint
        captures: captures
        world: world
        uiSystems: uiSystems
        pointerId: Gpu2d.touchId(index: i)
        x: Gpu2d.touchX(index: i)
        y: Gpu2d.touchY(index: i)
      )
    }
  }
  # what is left for the world this frame (ui/WorldInput): a game reads worldPointer / worldKeyDown
  feedWorldInput(captures: captures)
}

# The press and the release of a mouse button beyond the primary one
func hudCaptureButton(
  paint: view HudLayerPaint
  captures: mod UiCaptures
  world: view UiWorld
  uiSystems: view UiSystems
  button: copy Gpu2d.PointerButton
  pointerId: view Int
) {
  if Gpu2d.buttonReleased(button: button) {
    captureRelease(captures: captures, pointerId: pointerId)
  }
  if Gpu2d.buttonPressed(button: button) {
    hudCapturePress(
      paint: paint
      captures: captures
      world: world
      uiSystems: uiSystems
      pointerId: pointerId
      x: Gpu2d.pointerX()
      y: Gpu2d.pointerY()
    )
  }
}

# One press of `pointerId` at (x, y) through the plan on screen, captured by what it hits
func hudCapturePress(
  paint: view HudLayerPaint
  captures: mod UiCaptures
  world: view UiWorld
  uiSystems: view UiSystems
  pointerId: view Int
  x: view Float
  y: view Float
) {
  let unusedHit: UiHit = capturePress(
    captures: captures
    pointerId: pointerId
    walk: uiHitWalkAt(
      plan: paint.plan
      stack: paint.stack
      worldKey: 0
      world: world
      uiSystems: uiSystems
      x: x
      y: y
      targetSize: 0.0
      skip: noEntity()
    )
  )
}

# The camera's share of this frame's input (CameraRig updateCameraRigFor): the pointer unless the
# UI holds it (a press on its buttons, a drag that began there, a modal), the keys unless a text
# field or a modal holds them (ui/LayerCapture worldKeys)
func cameraRigInputFrom(captures: view UiCaptures, ui: view UiInput) ret CameraRigInput {
  ret CameraRigInput {
    pointer: uiPointerCaptured(input: ui) is false and not uiClaimsPointer(captures: captures)
    keys: worldKeys(captures: captures)
  }
}

# The fingers the UI holds this frame do not start a camera drag (after setCameraTouch)
func blockClaimedCameraFingers(rig: mod CameraRig, captures: view UiCaptures) {
  loop let capture: view PointerCapture in captures.captures {
    if capture.pointerId >= 0 and capture.claimed {
      blockCameraFinger(rig: rig, id: capture.pointerId)
    }
  }
}

# A panel world over a 3D frame (app3d/EditorPanel: its chrome and the debug readout), in layer
# order by `paint`'s plan: the scene UI's roots and layers, the debug readout in the debug layer
func drawPanelLayers(
  paint: mod HudLayerPaint
  world: view UiWorld
  uiSystems: view UiSystems
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  dbg: mod DebugOverlay
) {
  setLayerStackFrame(
    stack: paint.stack
    width: windowExtentW()
    height: windowExtentH()
    safe: screenSafeInsets(world: world)
    reserved: reservedInsets(world: world)
  )
  clearWorldAnchors(stack: paint.stack)
  buildHudLayerPlan(
    paint: paint
    world: world
    uiSystems: uiSystems
    editor: false
  )
  loop let step: view PaintStep in paint.plan.steps {
    if not paintPlanStepRaeG(
      step: step
      stack: paint.stack
      worldKey: 0
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    ) and step.kind is PaintStepKind.draw {
      let draw: LayerDraw = paint.stack.draws.copyAtFallback(
        index: step.draw
        fallback: LayerDraw { layer: -1, kind: LayerDrawKind.app }
      )
      if draw.kind is LayerDrawKind.debugReadout {
        feedDebugLayers(debugOverlay: dbg, stack: paint.stack, contributions: paint.contributions)
        drawDebugOverlay(
          debugOverlay: dbg
          canvas: canvas
          font: gpuUi.textFont
          didRealWork: true
        )
      }
    }
  }
  renderSharedNodesGpu2d(
    world: world
    uiSystems: uiSystems
    res: gpuUi
    canvas: canvas
  )
  paintCanvasGuidesG(world: world, canvas: canvas)
}
