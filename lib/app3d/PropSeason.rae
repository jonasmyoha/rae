# app3d/PropSeason — how a prop kind's leaves change color through the year
# (docs/seasons-and-weather-design.md §3): a tint the leaf parts' colors are
# multiplied by, from the slow temperature (lib/Climate) and whether it is
# rising. The tints are ratios to the kind's summer greens (1 in summer),
# so each leaf part keeps its own light and dark and only its hue moves.
#
# - Deciduous: falling past `turnStart` the leaves turn toward the autumn
#   tint, fully at `turnFull`, then dry and darken toward `bareAt`; rising,
#   the new leaves come out lighter and yellower (the spring tint) from
#   `leafOut` and reach summer's green 6 °C later.
# - Leaf loss (propSeasonLoss, 0 all leaves .. 1 bare): falling, the crown
#   thins from a degree past fully turned and is bare at `bareAt`; rising,
#   the leaves come back in the 4 °C up to a degree past `leafOut`. The
#   static shaders drop each leaf card by it (lib/wind.wgsl leafCardKept,
#   the outer cards of a leaf mass first; propLeafCardKey here is the same
#   key), so a deciduous tree in winter is its bark and branches.
# - Evergreen: darker and browner in the cold (the winter tint from 2 °C
#   down to -6 °C).
#
# Each tree shifts its temperature by up to ±1.5 °C, hashed from where it
# stands (propSeasonShift), so a stand turns over days, not on one day.
import Math
import Vec3

type PropSeason {
  # false: no season (the low-poly set, the umbrella pine): no tint
  on: Bool = false
  deciduous: Bool = false
  springTint: Vec3 = Vec3.create(x: 1.2, y: 1.3, z: 0.75)
  autumnTint: Vec3 = Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  winterTint: Vec3 = Vec3.create(x: 0.85, y: 0.82, z: 0.75)
  # the slow temperatures (°C) of the phases
  leafOut: Float = 8.0
  turnStart: Float = 10.0
  turnFull: Float = 5.0
  bareAt: Float = 2.0
  # The color of its falling leaves (app3d/LeafRelease): its autumn's
  fallColor: Vec3 = Vec3.create(x: 0.55, y: 0.35, z: 0.1)
}

# A tree's leaves this frame: their colors' tint and their loss (0 .. 1)
type PropLeaves {
  tint: Vec3
  loss: Float
}

func noPropSeason() ret PropSeason {
  ret PropSeason {}
}

func propSeasonRamp(from: view Float, to: view Float, value: view Float) ret Float {
  let t: Float = Math.clamp(val: (value - from) / (to - from), low: 0.0, high: 1.0)
  ret t * t * (3.0 - 2.0 * t)
}

func propSeasonMix(a: view Vec3, b: view Vec3, t: view Float) ret Vec3 {
  ret Vec3.vadd(a: a, b: Vec3.vscale(a: Vec3.vsub(a: b, b: a), s: t))
}

# The tint of `season`'s leaves at slow temperature `slow` (°C), `warming`
# whether it is rising
func propSeasonTint(season: view PropSeason, slow: view Float, warming: view Bool) ret Vec3 {
  let one: Vec3 = Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  if season.on is false {
    ret one
  }
  if season.deciduous is false {
    ret propSeasonMix(
      a: one
      b: season.winterTint
      t: propSeasonRamp(from: 2.0, to: -6.0, value: slow)
    )
  }
  if warming {
    # the new leaves: lighter, yellower, reaching summer's green
    let fresh: Float = 1.0 - propSeasonRamp(
      from: season.leafOut
      to: season.leafOut + 6.0
      value: slow
    )
    ret propSeasonMix(a: one, b: season.springTint, t: fresh)
  }
  let turned: Vec3 = propSeasonMix(
    a: one
    b: season.autumnTint
    t: propSeasonRamp(from: season.turnStart, to: season.turnFull, value: slow)
  )
  # past fully turned: the leaves dry, darker and duller
  ret Vec3.vscale(
    a: turned
    s: 1.0 - 0.45 * propSeasonRamp(from: season.turnFull, to: season.bareAt, value: slow)
  )
}

# How much of `season`'s leaves are gone (0 .. 1) at slow temperature
# `slow` (°C), `warming` whether it is rising; evergreens keep theirs
func propSeasonLoss(season: view PropSeason, slow: view Float, warming: view Bool) ret Float {
  if season.on is false or season.deciduous is false {
    ret 0.0
  }
  # the gone share of the cards; the square root because a crown is several
  # layers of cards deep, so it reads as thinner only once most are gone
  if warming {
    ret Math.sqrt(
      x: 1.0 - propSeasonRamp(from: season.leafOut - 3.0, to: season.leafOut + 1.0, value: slow)
    )
  }
  ret Math.sqrt(x: propSeasonRamp(from: season.turnFull + 1.0, to: season.bareAt, value: slow))
}

# How far from its leaf mass's anchor (m, in the tree's own space) a card
# is fully "outside" for the leaf loss (lib/wind.wgsl leafLossReach)
const propLeafLossReach: Float = 2.0

# A leaf card's key for the leaf loss, as lib/wind.wgsl leafCardKept
# computes it: the card stays while its key is at least the loss. A hash of
# the card's center and the tree's place, biased by how far the card is
# from its leaf mass's anchor `pivot` (the outside falls first).
func propLeafCardKey(center: view Vec3, pivot: view Vec3, place: view Vec3) ret Float {
  let seed: Vec3 = Vec3.vadd(
    a: center
    b: Vec3.vscale(a: propSeasonFract3(value: Vec3.vscale(a: place, s: 0.0137)), s: 101.0)
  )
  let random: Float = propSeasonFract(
    value: Math.sin(x: seed.x * 12.9898 + seed.y * 78.233 + seed.z * 37.719) * 43758.5453
  )
  let outer: Float = Math.clamp(
    val: Vec3.vlen(a: Vec3.vsub(a: center, b: pivot)) / propLeafLossReach
    low: 0.0
    high: 1.0
  )
  ret 0.7 * random + 0.3 * (1.0 - outer)
}

# Does a card with key `key` stay at leaf loss `loss`? (leafCardKept)
func propLeafCardKept(key: view Float, loss: view Float) ret Bool {
  if loss <= 0.0 {
    ret true
  }
  if loss >= 1.0 {
    ret false
  }
  ret key >= loss
}

func propSeasonFract(value: view Float) ret Float {
  ret value - Math.floor(x: value)
}

func propSeasonFract3(value: view Vec3) ret Vec3 {
  ret Vec3.create(
    x: propSeasonFract(value: value.x)
    y: propSeasonFract(value: value.y)
    z: propSeasonFract(value: value.z)
  )
}

# A tree's own shift of the slow temperature (°C), from its seed (0 .. 1,
# hashed from where it stands): ±1.5 °C
func propSeasonShift(seed: view Float) ret Float {
  ret (seed - 0.5) * 3.0
}
