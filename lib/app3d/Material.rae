# app3d/Material — a surface's gameplay material as an ECS component (an
# entity's base colour, metallic, roughness, emission).
import Vec3

# A gameplay surface material. Capital-D `Material3D` to match the capital-D
# lib/ecs Transform3D/WorldTransform3D components; distinct from scene3d's
# `Material3d` that the renderer consumes.
type Material3D {
  baseColor: Vec3
  metallic: Float
  roughness: Float
  emission: Vec3
}
