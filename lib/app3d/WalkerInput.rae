# app3d/WalkerInput — the walker examples' input (136, 137, 143): the input
# devices and the UI world state (WalkerInput), the window-geometry and
# hot-reload persistence (WalkerPersist), and inputUpdate, which turns the
# devices into an INTENT rather than moving the character directly: the touch
# stick when active, else WASD/arrows (+ shift = walk), and Space, F or the
# scene's Jump button (any finger on it) to jump. The intent becomes the controlled character's
# mover input
# (WalkerPhysics driveCharacters), so a remote player's intent can arrive from
# app3d/NetSeam instead of a device.
import Keys
open ecs/Entity
open ui/LayerCapture
open ui/WorldInput
open ui/Ecs
open ui/InputSystem
open ui/RenderSystem
open ui/UiSystems
open ui/DebugOverlay
open ui/LogOverlay
open ui/WindowGeometry
open app3d/ControlPanel
open app3d/SettingsDialog
open app3d/UiModes
open app3d/WalkerPhysics

# Input devices + the UI world state (panels, dialog, overlays)
type WalkerInput {
  # This frame's touch stick (app3d/HudOverlays updateTouchControls)
  touchStick: TouchStickState
  ui: UiInput
  world: UiWorld
  # The lib UI systems' derived tables (ui/UiSystems), next to the world.
  uiSystems: UiSystems
  gpuUi: Gpu2dUi
  transport: ControlPanel
  charPanel: ControlPanel  # prev/next character-switch buttons (#546)
  settings: SettingsState
  panelScroll: EntityId
  dbg: DebugOverlay
  logOverlay: LogOverlay
  lastLogRevision: Int
  # GAME (the default) or EDITOR, with the scene's pointer frames and `short`
  # state (lib/app3d/UiModes); the "..." button switches the mode
  uiModes: UiModes
  # What the "..." menu's moon item says now (app3d/WalkerUi)
  moonItemText: String
  # Presses held in layer order and what the UI claims (ui/LayerCapture), fed each frame from the
  # last drawn plan (app3d/HudOverlays hudCapturesStep)
  captures: UiCaptures
}

# Window-geometry + hot-reload persistence. (#555)
type WalkerPersist {
  windowGeometry: WindowGeometry
  lastStateSave: Float64
  stateDirty: Bool
  # The settings panel's values and the mode as last saved
  # (app3d/SettingsPersist), and when
  settingsLine: String = ""
  lastSettingsSave: Float64 = 0.0
}

# Space, or F under the WASD hand (Space alone is awkward to reach), pressed this frame, as the
# world gets it (ui/WorldInput: not while a text field has focus or a modal shows)
func jumpPressed(captures: view UiCaptures) ret Bool {
  ret worldKeyPressed(captures: captures, key: Keys.keySpace) or worldKeyPressed(
    captures: captures
    key: Keys.keyF
  )
}

# The scene's Jump button (shown by its touch frame), pressed this frame by
# any finger or a click
const jumpActionId: String = "touch.jump"

# The walker's intent this frame: the touch stick, or WASD / the arrows (Shift walks) and the jump,
# read as the world's keys (ui/WorldInput worldKeyDown); `playing` false keeps the keys out
func inputUpdate(
  stick: view TouchStickState
  captures: view UiCaptures
  playing: view Bool
  jumpButton: view Bool
) ret InputIntent {
  let jump: Bool = (playing and jumpPressed(captures: captures)) or jumpButton
  if stick.active {
    ret InputIntent {
      moveX: stick.valueX
      moveY: stick.valueY
      walking: false
      jump: jump
      actions: 0
    }
  }
  var moveX: Float = 0.0
  var moveY: Float = 0.0
  var walking: Bool = false
  if playing {
    if worldKeyDown(captures: captures, key: Keys.keyD) or worldKeyDown(
      captures: captures
      key: Keys.keyRight
    ) {
      moveX = moveX + 1.0
    }
    if worldKeyDown(captures: captures, key: Keys.keyA) or worldKeyDown(
      captures: captures
      key: Keys.keyLeft
    ) {
      moveX = moveX - 1.0
    }
    if worldKeyDown(captures: captures, key: Keys.keyW) or worldKeyDown(
      captures: captures
      key: Keys.keyUp
    ) {
      moveY = moveY + 1.0
    }
    if worldKeyDown(captures: captures, key: Keys.keyS) or worldKeyDown(
      captures: captures
      key: Keys.keyDown
    ) {
      moveY = moveY - 1.0
    }
    walking = worldKeyDown(captures: captures, key: Keys.keyLShift)
  }
  ret InputIntent {
    moveX: moveX
    moveY: moveY
    walking: walking
    jump: jump
    actions: 0
  }
}

# R: the walker back as it started (app3d/WalkerReset), as the "..." menu's Reset
func walkerResetKeyPressed(captures: view UiCaptures) ret Bool {
  ret worldKeyPressed(captures: captures, key: Keys.keyR)
}

# V: the character in front of the WASD camera and Character control, or
# back to the WASD camera (app3d/WalkerSpawnHere)
func walkerSpawnHereKeyPressed(captures: view UiCaptures) ret Bool {
  ret worldKeyPressed(captures: captures, key: Keys.keyV)
}

# The walker's keys (WASD, R, V) act: they reach the world (no text field has focus, no modal
# shows; ui/LayerCapture worldKeys). Hovering the UI with the pointer does not stop them.
func walkerKeysFree(inputSystem: view WalkerInput) ret Bool {
  ret worldKeys(captures: inputSystem.captures)
}
