# app3d/CharacterContactRules — two characters' capsules meeting: pushed
# apart to two radii along the line between them (sideways only, never
# lifted), and, if they were closing, given an impulse along that line, as
# two equal bodies with a little bounce; a hard enough bump knocks over the
# one doing less of the pushing (Knockdown). Pure over plain values, free of
# Box3D, so an app's own rule tests build without it; app3d/CharacterContact
# runs it over the movers (bumpMovers).
import Math
import Vec3

# Of the impulse along the contact, how much bounces back (0 would be two
# bodies that stick together, 1 billiard balls).
const characterBounce: Float = 0.3

# How hard a bump has to be to knock someone over: the speed the two close at
# along the line between them (m/s). Walking (1.4) or brushing past a runner
# beside you does not; a jog (3-4) or anything faster into someone does.
const knockdownClosingSpeed: Float = 3.5

# When both push within this of each other (m/s), a hard bump floors both.
const bothFallMargin: Float = 1.0

# Who a bump knocks over.
enum Knockdown { none, aFalls, bFalls, bothFall }

# The one doing less of the pushing falls: each one's push is its own speed
# toward the other along the line between them.
func knockdownOf(pushA: view Float, pushB: view Float) ret Knockdown {
  if pushA + pushB < knockdownClosingSpeed {
    ret Knockdown.none
  }
  if Math.abs(value: pushA - pushB) < bothFallMargin {
    ret Knockdown.bothFall
  }
  if pushA > pushB {
    ret Knockdown.bFalls
  }
  ret Knockdown.aFalls
}

# When someone knocked over gets up (only where their body came to rest) is
# app3d/KnockedDown (canGetUp, hipsAtRest).

# A character's collision capsule: its radius and its full height (from the
# bottom of the lower cap to the top of the upper one), standing up along +Z
# around its centre.
type CharacterShape {
  radius: Float
  height: Float
}

# Two characters after their contact: where they are, how they move, and
# whether they touched at all.
type CharacterContact {
  touching: Bool
  knockdown: Knockdown
  positionA: Vec3
  velocityA: Vec3
  positionB: Vec3
  velocityB: Vec3
}

# Resolve the contact between character A and character B (each its own
# capsule, centre and velocity): touching within their two radii, side by
# side within half their two heights.
func resolveCharacterContact(
  shapeA: view CharacterShape
  shapeB: view CharacterShape
  positionA: view Vec3
  velocityA: view Vec3
  positionB: view Vec3
  velocityB: view Vec3
) ret CharacterContact {
  let apart: CharacterContact = {
    touching: false
    knockdown: Knockdown.none
    positionA: positionA
    velocityA: velocityA
    positionB: positionB
    velocityB: velocityB
  }
  if Math.abs(value: positionB.z - positionA.z) >= (shapeA.height + shapeB.height) * 0.5 {
    ret apart
  }
  let dx: Float = positionB.x - positionA.x
  let dy: Float = positionB.y - positionA.y
  let distance: Float = Math.sqrt(x: dx * dx + dy * dy)
  let contactDistance: Float = shapeA.radius + shapeB.radius
  if distance >= contactDistance {
    ret apart
  }
  # The line from A to B; on one spot, any line will do
  var normalX: Float = 1.0
  var normalY: Float = 0.0
  if distance > 0.0001 {
    normalX = dx / distance
    normalY = dy / distance
  }
  let halfPush: Float = (contactDistance - distance) * 0.5
  # Closing speed along the line; an impulse only if they are closing
  let closing: Float = (velocityA.x - velocityB.x) * normalX + (velocityA.y - velocityB.y) * normalY
  var impulse: Float = 0.0
  if closing > 0.0 {
    impulse = (1.0 + characterBounce) * closing * 0.5
  }
  let pushA: Float = velocityA.x * normalX + velocityA.y * normalY
  let pushB: Float = 0.0 - (velocityB.x * normalX + velocityB.y * normalY)
  ret CharacterContact {
    touching: true
    knockdown: knockdownOf(pushA: pushA, pushB: pushB)
    positionA: Vec3.create(
      x: positionA.x - normalX * halfPush
      y: positionA.y - normalY * halfPush
      z: positionA.z
    )
    velocityA: Vec3.create(
      x: velocityA.x - normalX * impulse
      y: velocityA.y - normalY * impulse
      z: velocityA.z
    )
    positionB: Vec3.create(
      x: positionB.x + normalX * halfPush
      y: positionB.y + normalY * halfPush
      z: positionB.z
    )
    velocityB: Vec3.create(
      x: velocityB.x + normalX * impulse
      y: velocityB.y + normalY * impulse
      z: velocityB.z
    )
  }
}
