# app3d/CharacterContactRules — two characters' capsules meeting: pushed
# apart to two radii along the line between them (sideways only, never
# lifted), and, if they were closing, given an impulse along that line, as
# two equal bodies with a little bounce; a hard enough bump knocks over the
# one doing less of the pushing (Knockdown). Pure over plain values, free of
# Box3D, so an app's own rule tests build without it; app3d/CharacterContact
# runs it over the movers (bumpMovers).
import Math
import Vec3

# Of the impulse along the contact, how much bounces back (0 would be two
# bodies that stick together, 1 billiard balls).
const characterBounce: Float = 0.3

# How hard a bump has to be to knock someone over: the speed the two close at
# along the line between them (m/s). Walking (1.4) or brushing past a runner
# beside you does not; a jog (3-4) or anything faster into someone does.
const knockdownClosingSpeed: Float = 3.5

# When both push within this of each other (m/s), a hard bump floors both.
const bothFallMargin: Float = 1.0

# Who a bump knocks over.
enum Knockdown { none, aFalls, bFalls, bothFall }

# The one doing less of the pushing falls: each one's push is its own speed
# toward the other along the line between them.
func knockdownOf(pushA: view Float, pushB: view Float) ret Knockdown {
  if pushA + pushB < knockdownClosingSpeed {
    ret Knockdown.none
  }
  if Math.abs(value: pushA - pushB) < bothFallMargin {
    ret Knockdown.bothFall
  }
  if pushA > pushB {
    ret Knockdown.bFalls
  }
  ret Knockdown.aFalls
}

# When someone knocked over gets up (only where their body came to rest) is
# app3d/KnockedDown (canGetUp, hipsAtRest).

# A character's collision capsule: its radius and its full height (from the
# bottom of the lower cap to the top of the upper one), standing up along +Z
# around its center.
type CharacterShape {
  radius: Float
  height: Float
}

# Two characters after their contact: where they are, how they move, and
# whether they touched at all.
type CharacterContact {
  touching: Bool
  knockdown: Knockdown
  positionA: Vec3
  velocityA: Vec3
  positionB: Vec3
  velocityB: Vec3
}

# Resolve the contact between character A and character B (each its own
# capsule, center and velocity): touching within their two radii, side by
# side within half their two heights.
func resolveCharacterContact(
  shapeA: view CharacterShape
  shapeB: view CharacterShape
  positionA: view Vec3
  velocityA: view Vec3
  positionB: view Vec3
  velocityB: view Vec3
) ret CharacterContact {
  let apart: CharacterContact = {
    touching: false
    knockdown: Knockdown.none
    positionA: positionA
    velocityA: velocityA
    positionB: positionB
    velocityB: velocityB
  }
  if Math.abs(value: positionB.z - positionA.z) >= (shapeA.height + shapeB.height) * 0.5 {
    ret apart
  }
  let dx: Float = positionB.x - positionA.x
  let dy: Float = positionB.y - positionA.y
  let distance: Float = Math.sqrt(x: dx * dx + dy * dy)
  let contactDistance: Float = shapeA.radius + shapeB.radius
  if distance >= contactDistance {
    ret apart
  }
  # The line from A to B; on one spot, any line will do
  var normalX: Float = 1.0
  var normalY: Float = 0.0
  if distance > 0.0001 {
    normalX = dx / distance
    normalY = dy / distance
  }
  let halfPush: Float = (contactDistance - distance) * 0.5
  # Closing speed along the line; an impulse only if they are closing
  let closing: Float = (velocityA.x - velocityB.x) * normalX + (velocityA.y - velocityB.y) * normalY
  var impulse: Float = 0.0
  if closing > 0.0 {
    impulse = (1.0 + characterBounce) * closing * 0.5
  }
  let pushA: Float = velocityA.x * normalX + velocityA.y * normalY
  let pushB: Float = 0.0 - (velocityB.x * normalX + velocityB.y * normalY)
  ret CharacterContact {
    touching: true
    knockdown: knockdownOf(pushA: pushA, pushB: pushB)
    positionA: Vec3.create(
      x: positionA.x - normalX * halfPush
      y: positionA.y - normalY * halfPush
      z: positionA.z
    )
    velocityA: Vec3.create(
      x: velocityA.x - normalX * impulse
      y: velocityA.y - normalY * impulse
      z: velocityA.z
    )
    positionB: Vec3.create(
      x: positionB.x + normalX * halfPush
      y: positionB.y + normalY * halfPush
      z: positionB.z
    )
    velocityB: Vec3.create(
      x: velocityB.x + normalX * impulse
      y: velocityB.y + normalY * impulse
      z: velocityB.z
    )
  }
}

# ----- a local walker and a copy of a remote one -----------------------------------
#
# In a networked session each client owns one walker, and draws a copy of every other
# walker where it was a moment ago (it follows that walker's pose). Applying the rule
# above to such a pair never comes to rest. On one spot both clients push their own
# walker the same way, and then each draws the other just behind it, so each is pushed
# on by the copy, without end (compiler/tests/cases/1343_walkers_on_one_spot: 1.6 m/s,
# forever). So a copy is never moved, and:
# - at rest, only one side of the pair gets out of an overlap (`localYields`, which the
#   clients must agree on), since the other side's walker will be seen to move. A walker
#   on the move does not give way, or it could never reach anyone to shove them;
# - a walker is shoved, whichever side it is, only by a walker that says it is moving
#   (`remoteSpeed`, from its pose) and is really closing on it. A copy catching up with a
#   walker that slid out of an overlap is not moving by that walker's word, and a copy
#   trailing behind when both go the same way is lag, not a push;
# - a walker on the move into a copy presses in only so far (remotePressDepth), which is
#   enough to reach the real walker and shove it, and never goes through it.
#
# Of the overlap, the share the side that gives way moves out per fixed step: gone in
# about a third of a second, as a slide and not a jump
const remoteYieldShare: Float = 0.2

# Closing slower than this (m/s) is no shove, and a walker slower than this is at rest
const remoteShoveClosingSpeed: Float = 0.5

# A copy along the line at this speed or more (m/s) is at a run
const remoteHardHitSpeed: Float = 2.5

# How near a walker on the move gets to a copy, as a share of their two radii
const remotePressDepth: Float = 0.6

# The contact of local walker A with remote copy B, whose place and velocity stay.
# `aFalls` is the only knockdown: B's own client decides whether B falls.
func resolveRemoteContact(
  shapeA: view CharacterShape
  shapeB: view CharacterShape
  positionA: view Vec3
  velocityA: view Vec3
  positionB: view Vec3
  velocityB: view Vec3
  remoteSpeed: view Float
  remotePeakSpeed: view Float
  localYields: view Bool
) ret CharacterContact {
  let apart: CharacterContact = {
    touching: false
    knockdown: Knockdown.none
    positionA: positionA
    velocityA: velocityA
    positionB: positionB
    velocityB: velocityB
  }
  if Math.abs(value: positionB.z - positionA.z) >= (shapeA.height + shapeB.height) * 0.5 {
    ret apart
  }
  let dx: Float = positionB.x - positionA.x
  let dy: Float = positionB.y - positionA.y
  let distance: Float = Math.sqrt(x: dx * dx + dy * dy)
  let contactDistance: Float = shapeA.radius + shapeB.radius
  if distance >= contactDistance {
    ret apart
  }
  var normalX: Float = 1.0
  var normalY: Float = 0.0
  if distance > 0.0001 {
    normalX = dx / distance
    normalY = dy / distance
  }
  let closing: Float = (velocityA.x - velocityB.x) * normalX + (velocityA.y - velocityB.y) * normalY
  let pushA: Float = velocityA.x * normalX + velocityA.y * normalY
  let pushB: Float = 0.0 - (velocityB.x * normalX + velocityB.y * normalY)
  let atRest: Bool = velocityA.x * velocityA.x + velocityA.y * velocityA.y < remoteShoveClosingSpeed * remoteShoveClosingSpeed
  let shoved: Bool = closing > remoteShoveClosingSpeed and pushB > remoteShoveClosingSpeed and remoteSpeed > remoteShoveClosingSpeed
  var position: Vec3 = positionA
  if (localYields and atRest) or shoved {
    let move: Float = (contactDistance - distance) * remoteYieldShare
    position.x = positionA.x - normalX * move
    position.y = positionA.y - normalY * move
  }
  var velocity: Vec3 = velocityA
  if (closing > remoteShoveClosingSpeed and pushA > remoteShoveClosingSpeed) or shoved {
    let impulse: Float = (1.0 + characterBounce) * closing * 0.5
    velocity.x = velocityA.x - normalX * impulse
    velocity.y = velocityA.y - normalY * impulse
  }
  # Any closing at all, or a walker a little faster than the copy ahead of it slips through
  if closing > 0.0 and pushA > remoteShoveClosingSpeed {
    let nearest: Float = contactDistance * remotePressDepth
    if distance < nearest {
      position.x = positionB.x - normalX * nearest
      position.y = positionB.y - normalY * nearest
    }
  }
  # A copy at a run stops and starts as it catches up, and the walker's own client may
  # already have slowed it: its hit is judged by the fastest the walker has lately said
  # it went, in the direction its copy comes from. A copy that has slowed below a run
  # has braked, and hits as it is.
  var hitB: Float = pushB
  if pushB >= remoteHardHitSpeed {
    let copySpeed: Float = Math.sqrt(x: velocityB.x * velocityB.x + velocityB.y * velocityB.y)
    hitB = Math.max(a: pushB, b: remotePeakSpeed * pushB / copySpeed)
  }
  let both: Knockdown = knockdownOf(pushA: pushA, pushB: hitB)
  var knockdown: Knockdown = Knockdown.none
  if both is Knockdown.aFalls or both is Knockdown.bothFall {
    knockdown = Knockdown.aFalls
  }
  ret CharacterContact {
    touching: true
    knockdown: knockdown
    positionA: position
    velocityA: velocity
    positionB: positionB
    velocityB: velocityB
  }
}
