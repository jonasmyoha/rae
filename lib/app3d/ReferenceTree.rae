# app3d/ReferenceTree — the tree being made by hand to match reference crop
# T02 (lib/treeGen, docs/reference-tree-plan.md), as a stand of such trees
# among a walker app's forest, so it can be seen in motion and next to the
# old trees. The wide forest leaves a patch to them and plants them there
# (app3d/WideForest, WalkerTerrain.referenceStand; WalkerAppSettings
# referenceTree, example 143). The trees are GROWN from the trace's measures
# (treeGen/TreeGrower), a few varieties, each its own tree; every stand tree
# wears one of them, turned and sized. Per variety: one bark mesh as one
# instance batch, one draw of its leaf pass over its trees' placements
# (treeGen/LeafPass), the shadows as two instance batches. They have no
# physics bodies: the walker passes through their trunks.
import Sys
import Math
import Vec3
open Scene3d
open Math3d
open Mesh3d
open Gbuffer
open GbufferRecord
open GbufferInstanced
open RendererDeferred
open RendererDeferredShadow
open RendererImages
open gpu/GpuResources
open treeGen/TreeParams
open treeGen/Skeleton
open treeGen/BarkMesh
open treeGen/Bark
open treeGen/ClumpMesh
open treeGen/LeafCards
open treeGen/LeafImage
open treeGen/LeafPass
open treeGen/TreeGrower

# The bark picture, painted once
const referenceBarkImagePath: String = ".rae/treeGen/warmBark.png"

# Floats per tree in a stand's list: x y z yaw scale
const referenceStandFloats: Int = 5

# The number of different grown trees in a stand
const referenceVarietyCount: Int = 4

# One grown tree and every stand tree that wears it
type ReferenceVariety {
  bark: MeshHandle
  shadowMasses: MeshHandle
  # one record per tree: the bark (with its material) and the leaf masses'
  # shadow
  barkBatch: InstanceBatch
  massBatch: InstanceBatch
  leaves: LeafPass
  count: Int
}

type ReferenceTree {
  varieties: List(ReferenceVariety)
  count: Int
}

# The bark picture's layer in the renderer's material images (painted the
# first time), or -1
func referenceBarkLayer(renderer: mod DeferredRenderer) ret Int {
  if not Sys.exists(path: referenceBarkImagePath) {
    let made: Bool = Sys.makeDir(path: ".rae/treeGen")
    if not writeBarkImage(path: referenceBarkImagePath) {
      log("[referenceTree] could not write the bark picture {referenceBarkImagePath}")
      ret -1
    }
  }
  ret rendererLoadSurfaceImage(renderer: renderer, path: referenceBarkImagePath)
}

# Grown variety `seed` at every `variety`-th place of `stand`
# (referenceStandFloats floats each: x y z yaw scale), starting at place
# `variety`
func createReferenceVariety(
  renderer: mod DeferredRenderer
  stand: view List(Float)
  variety: view Int
  material: view Material3d
  pictures: view List(List(Float))
) ret ReferenceVariety {
  let seed: Int = variety + 1
  let params: TreeParams = grownBroadleafParams(seed: seed)
  let skeleton: TreeSkeleton = growSkeleton(params: params)
  let barkData: MeshData = barkMesh(skeleton: skeleton)
  let massData: MeshData = clumpShadowMesh(skeleton: skeleton, scale: 0.75)
  let bark: MeshHandle = uploadMesh(
    renderer: renderer
    verts: barkData.verts
    vertCount: barkData.vertCount
    indices: barkData.indices
  )
  let shadowMasses: MeshHandle = uploadMesh(
    renderer: renderer
    verts: massData.verts
    vertCount: massData.vertCount
    indices: massData.indices
  )
  let places: Int = stand.length / referenceStandFloats
  let capacity: Int = Math.max(a: places / referenceVarietyCount + 1, b: 1)
  var barkBatch: InstanceBatch = createInstanceBatch(mesh: bark, capacity: capacity)
  var massBatch: InstanceBatch = createInstanceBatch(mesh: shadowMasses, capacity: capacity)
  var placements: List(Float) = List.create(Float, cap: capacity * leafPlacementFloats)
  var count: Int = 0
  loop var i: Int = variety, i < places, ++i {
    if i % referenceVarietyCount is not variety {
      continue
    }
    let base: Int = i * referenceStandFloats
    let x: Float = stand.copyAtDefault(index: base)
    let y: Float = stand.copyAtDefault(index: base + 1)
    let z: Float = stand.copyAtDefault(index: base + 2)
    let yaw: Float = stand.copyAtDefault(index: base + 3)
    let scale: Float = stand.copyAtDefault(index: base + 4)
    let model: Mat4 = modelMatrixOf(
      t: Transform3d {
        position: Vec3.create(x: x, y: y, z: z)
        rotation: Vec3.create(x: 0.0, y: 0.0, z: yaw)
        scale: Vec3.create(x: scale, y: scale, z: scale)
      }
    )
    addInstance(
      batch: barkBatch
      model: model
      prevModel: model
      material: material
    )
    addInstance(
      batch: massBatch
      model: model
      prevModel: model
      material: material
    )
    leafPlacement(
      placements: placements
      x: x
      y: y
      z: z
      yaw: yaw
      scale: scale
    )
    count = count + 1
  }
  let ownPictures: List(List(Float)) = pictures
  var leaves: LeafPass = createLeafPass(
    cards: leafCards(skeleton: skeleton, seed: seed)
    pictures: own ownPictures
  )
  setLeafPlacements(leaves: leaves, placements: own placements)
  log(
    "[referenceTree] grown T02 variety {seed}: {count} trees, {skeleton.limbs.length} limbs and {leaves.cards.count} leaf cards each"
  )
  ret ReferenceVariety {
    bark: bark
    shadowMasses: shadowMasses
    barkBatch: own barkBatch
    massBatch: own massBatch
    leaves: own leaves
    count: count
  }
}

# A stand of grown T02 trees, one at every place of `stand`
# (referenceStandFloats floats each: x y z yaw scale), the varieties taking
# turns
func createReferenceStand(
  renderer: mod DeferredRenderer
  stand: view List(Float)
) ret ReferenceTree {
  let count: Int = stand.length / referenceStandFloats
  var varieties: List(ReferenceVariety) = List.create(ReferenceVariety, cap: referenceVarietyCount)
  if count is 0 {
    ret ReferenceTree { varieties: own varieties, count: 0 }
  }
  let material: Material3d = barkMaterial(layer: referenceBarkLayer(renderer: renderer))
  # the leaf stamps are painted once; each variety's pass gets a copy
  let pictures: List(List(Float)) = leafImageLayerPixels()
  loop var variety: Int = 0, variety < Math.min(a: referenceVarietyCount, b: count), ++variety {
    varieties.add(value: createReferenceVariety(
      renderer: renderer
      stand: stand
      variety: variety
      material: material
      pictures: pictures
    ))
  }
  log(
    "[referenceTree] a stand of {count} grown T02 trees from {stand.copyAtDefault(index: 0)} {stand.copyAtDefault(
      index: 1
    )}"
  )
  ret ReferenceTree { varieties: own varieties, count: count }
}

# The bark and the leaves, inside the G-buffer pass now open
func drawReferenceTree(
  tree: mod ReferenceTree
  cache: mod GbufferCache
  rendererResources: mod GpuResources
  resources: mod GpuResources
  camera: view Camera3d
  light: view Light3d
) {
  loop let variety: mod ReferenceVariety in tree.varieties {
    drawInstances(cache: cache, resources: rendererResources, batch: variety.barkBatch)
    drawLeaves(
      leaves: variety.leaves
      resources: resources
      gbuffer: cache
      gbufferResources: rendererResources
      camera: camera
      light: light
    )
  }
}

# The trunks' and the crowns' shadows, inside the shadow pass now open
func drawReferenceTreeShadow(tree: view ReferenceTree, renderer: mod DeferredRenderer) {
  loop let variety: view ReferenceVariety in tree.varieties {
    drawShadowCasterBatchWith(renderer: renderer, mesh: variety.bark, batch: variety.barkBatch)
    drawShadowCasterBatchWith(
      renderer: renderer
      mesh: variety.shadowMasses
      batch: variety.massBatch
    )
  }
}

func releaseReferenceTree(tree: mod ReferenceTree, resources: mod GpuResources) {
  loop let variety: mod ReferenceVariety in tree.varieties {
    releaseLeafPass(leaves: variety.leaves, resources: resources)
  }
}
