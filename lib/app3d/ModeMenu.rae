# The "..." mode menu: the button a GAME / EDITOR scene puts in its top-right
# corner opens a small menu under it instead of flipping the mode at once. In
# GAME mode it offers "Open editor" and "Reverse camera rotation: off/on" (the
# camera rig's reverseDrag, which turns the orbit camera only: the editor's WASD
# camera always looks where the drag goes); in EDITOR mode "Back to game"; in
# both "Reset": in an app that puts itself back as it started (it sets the
# menu state's appResets), a request the app takes once (takeModeMenuReset)
# and answers as its own reset key does; in any other, starting the program
# again with no saved state (HotReload.restartFresh: a desktop only, a phone
# cannot start a program again);
# and, in an app with touch controls (its scene has the item), "Simulate
# mobile phone: off/on", which shows them on a desktop as a phone build always
# does (it picks the scene's touch frame, app3d/UiModes framePointerFor, where
# the touch controls are nodes). Which items show is
# the scene's `editor` state (app3d/UiModes); the menu's own open/close is set
# here, outside the state bags. Choosing an item, or a press anywhere else,
# closes it.
#
# The scene names the nodes below. A layout that keeps the button on screen
# whatever the editor chrome does: the button and the menu in an overlay over
# the whole HUD, pinned to the top-right corner, with the top row and the
# editor's side panel keeping clear of it. The menu is the corner's own; an
# editor's side panel opens from its own edge tab (app3d/EdgeTab), never from
# the menu. An app without modes (app3d/EditorPanel) puts only the camera
# item in it and calls updateModeMenuItems. The scene's `editor` state may restyle the menu like
# the editor's panels: applying a
# state resets those nodes, so the menu binds its open/close and its items'
# text to their nodes (bindNodeText / bindNodeActive, ui/nodeBindingSystem),
# which the apply writes again.
#
#   ...each frame, after updateUiInput, before layout:
#   if updateUiModes(world: w, uiSystems: s, uiModes: m) or updateModeMenu(world: w,
#      uiSystems: s, uiModes: m, input: ui, rig: rig) { ...lay the UI out again... }
open app3d/UiModes
open app3d/UiShell
open app3d/CameraRig
open ui/Ecs
open ui/nodeBindingSystem/NodeBindingSystem
open ui/UiSystems
open ui/inputSystem/InputSystem
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open HotReload

# The button's and the items' action ids
# (not "menu.toggle", which an older corner button used)
const modeMenuToggleActionId: String = "modeMenu.toggle"

const modeMenuEditorActionId: String = "menu.editor"

const modeMenuGameActionId: String = "menu.game"

const modeMenuCameraRotationActionId: String = "menu.cameraRotation"

const modeMenuResetActionId: String = "menu.reset"

const modeMenuMobileActionId: String = "menu.simulateMobile"

# The nodes: the "..." button, the menu, its items and the camera item's label
const modeMenuButtonNodeId: String = "ModeButton"

const modeMenuNodeId: String = "ContextMenu"

const modeMenuCameraLabelNodeId: String = "MenuCameraLabel"

const modeMenuMobileItemNodeId: String = "MenuMobileItem"

const modeMenuMobileLabelNodeId: String = "MenuMobileLabel"

# The clock items a scene with a sky may add (the walkers do): skip some hours
# ahead, switch the moon. Like any app's own item, the app does what it says
# (app3d/WalkerUi) and the menu closes as for its own.
const modeMenuSkipHoursActionId: String = "menu.skipHours"

const modeMenuMoonActionId: String = "menu.moon"

# Is the menu open after this frame? A tap on the button opens or closes it;
# choosing an item, or a press anywhere else, closes it.
func modeMenuOpenAfter(
  open: view Bool
  buttonTapped: view Bool
  itemChosen: view Bool
  pressedElsewhere: view Bool
) ret Bool {
  if itemChosen {
    ret false
  }
  if buttonTapped {
    ret open is false
  }
  if pressedElsewhere {
    ret false
  }
  ret open
}

# The camera item's text for the rig's reverseDrag
func cameraRotationItemText(reversed: view Bool) ret String {
  if reversed {
    ret "Reverse camera rotation: on"
  }
  ret "Reverse camera rotation: off"
}

# The mobile item's text for the menu's simulateMobile
func simulateMobileItemText(simulated: view Bool) ret String {
  if simulated {
    ret "Simulate mobile phone: on"
  }
  ret "Simulate mobile phone: off"
}

func modeMenuTapped(world: view UiWorld, actionId: view String) ret Bool {
  loop var i: Int = 0, i < uiActionCount(world: world), ++i {
    if uiActionAt(world: world, index: i) is actionId {
      ret true
    }
  }
  ret false
}

# Is `entityId` the menu node or anything under it (an item, Rae's or the
# app's, or an item's label)? The scene says what the items are.
func inModeMenu(world: view UiWorld, uiSystems: view UiSystems, entityId: view EntityId) ret Bool {
  let menuNode: EntityId = nodeEntityFor(world: world, nodeId: modeMenuNodeId)
  if isNone(this: menuNode) {
    ret false
  }
  var current: EntityId = entityId
  loop isNone(this: current) is false {
    if current is menuNode {
      ret true
    }
    if componentHas(this: uiSystems.hierarchy.parents, entityId: current) is false {
      ret false
    }
    let parent: view Parent = componentView(this: uiSystems.hierarchy.parents, entityId: current)
    current = { index: parent.parent.index, generation: parent.parent.generation }
  }
  ret false
}

# Is `entityId` the button or in the menu: a press there does not close it?
func isModeMenuPressNode(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  if isNone(this: entityId) {
    ret false
  }
  if nodeEntityFor(world: world, nodeId: modeMenuButtonNodeId) is entityId {
    ret true
  }
  ret inModeMenu(world: world, uiSystems: uiSystems, entityId: entityId)
}

# Was an item in the menu chosen this frame: any UI action from a node in it,
# whoever handles it (Rae's own here, an app's in its systems)?
func modeMenuItemChosen(world: view UiWorld, uiSystems: view UiSystems) ret Bool {
  loop var i: Int = 0, i < eventCount(UiAction, this: world.uiActions), ++i {
    let action: UiAction = eventAt(UiAction, this: world.uiActions, i: i)
    if inModeMenu(world: world, uiSystems: uiSystems, entityId: action.entityId) {
      ret true
    }
  }
  ret false
}

# This frame's taps on the menu: switch modes, reverse the camera's drag, open
# or close it. True when the UI must be laid out again.
func updateModeMenu(
  world: mod UiWorld
  uiSystems: mod UiSystems
  uiModes: mod UiModes
  input: view UiInput
  rig: mod CameraRig
) ret Bool {
  let openEditor: Bool = modeMenuTapped(world: world, actionId: modeMenuEditorActionId)
  let backToGame: Bool = modeMenuTapped(world: world, actionId: modeMenuGameActionId)
  var changed: Bool = false
  if openEditor or backToGame {
    setUiModeEditor(
      world: world
      uiSystems: uiSystems
      uiModes: uiModes
      editor: openEditor
    )
    changed = true
  }
  if updateModeMenuItems(
    world: world
    uiSystems: uiSystems
    menu: uiModes.modeMenu
    input: input
    rig: rig
  ) {
    changed = true
  }
  ret changed
}

# The menu without the modes (an app with no GAME / EDITOR modes, whose
# menu has the camera and reset items): reverse the camera's drag, start the
# program again, open or close it. Any item in the menu node, Rae's or the
# app's, closes it when chosen. True when the UI must be laid out again. Its labels and whether
# it is open are bound to their nodes (ui/nodeBindingSystem), so a frame or
# state that restyles the menu keeps them.
func updateModeMenuItems(
  world: mod UiWorld
  uiSystems: view UiSystems
  menu: mod ModeMenuState
  input: view UiInput
  rig: mod CameraRig
) ret Bool {
  let cameraTapped: Bool = modeMenuTapped(world: world, actionId: modeMenuCameraRotationActionId)
  let pressedElsewhere: Bool = input.pointer.pressed and isModeMenuPressNode(
    world: world
    uiSystems: uiSystems
    entityId: input.pressedEntityId
  ) is false
  var changed: Bool = false
  if cameraTapped {
    rig.reverseDrag = rig.reverseDrag is false
  }
  let mobileTapped: Bool = modeMenuTapped(world: world, actionId: modeMenuMobileActionId)
  if mobileTapped {
    menu.simulateMobile = menu.simulateMobile is false
  }
  let resetTapped: Bool = modeMenuTapped(world: world, actionId: modeMenuResetActionId)
  if resetTapped {
    if menu.appResets {
      askModeMenuReset(menu: menu)
    } else {
      # Does not come back when the program restarts
      let restarted: Bool = restartFresh()
    }
  }
  # The camera item says what the rig does (an app may start it reversed)
  if menu.cameraLabelReversed is not rig.reverseDrag or menu.cameraLabelWritten is false {
    menu.cameraLabelReversed = rig.reverseDrag
    menu.cameraLabelWritten = true
    bindNodeText(
      world: world
      nodeId: modeMenuCameraLabelNodeId
      value: cameraRotationItemText(reversed: rig.reverseDrag)
    )
    changed = true
  }
  # The mobile item says what the menu does; a phone build has nothing to
  # simulate, so there it is not shown
  if menu.mobileLabelSimulated is not menu.simulateMobile or menu.mobileLabelWritten is false {
    menu.mobileLabelSimulated = menu.simulateMobile
    menu.mobileLabelWritten = true
    bindNodeText(
      world: world
      nodeId: modeMenuMobileLabelNodeId
      value: simulateMobileItemText(simulated: menu.simulateMobile)
    )
    if Target.isMobileOs {
      bindNodeActive(world: world, nodeId: modeMenuMobileItemNodeId, value: false)
    }
    changed = true
  }
  let open: Bool = modeMenuOpenAfter(
    open: menu.open
    buttonTapped: modeMenuTapped(world: world, actionId: modeMenuToggleActionId)
    itemChosen: modeMenuItemChosen(world: world, uiSystems: uiSystems)
    pressedElsewhere: pressedElsewhere
  )
  if open is not menu.open or menu.openWritten is false {
    menu.open = open
    menu.openWritten = true
    bindNodeActive(world: world, nodeId: modeMenuNodeId, value: open)
    changed = true
  }
  ret changed
}

# The app's reset, asked (the menu's Reset in an app with appResets)
func askModeMenuReset(menu: mod ModeMenuState) {
  menu.resetAsked = true
}

# Was the app asked to put itself back as it started since it last took it?
# (once: the request is taken)
func takeModeMenuReset(menu: mod ModeMenuState) ret Bool {
  let asked: Bool = menu.resetAsked
  menu.resetAsked = false
  ret asked
}
