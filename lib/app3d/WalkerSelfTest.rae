# app3d/WalkerSelfTest — the walker's physics check that needs no one to play
# (RAE_WALKER_PHYSICS_TEST=1). The steps are app3d/WalkerPhysicsChecks and
# app3d/WalkerTerrainBodies: the cube stacks settle, the hero pushes one and
# jumps, then the tree trunks hold (one per island tree, or the pool on the
# trees nearest the walker, with the ground following it), and the rocks and
# bushes. It prints the one [physicstest] line the gates grep; the result is
# 0 when all held.
import Math
import Vec3
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open app3d/WalkerPhysics
open app3d/WalkerPhysicsChecks
open app3d/GroveTrees
open app3d/PropField
open app3d/WalkerTerrainBodies
open app3d/WalkerWorld
open app3d/CharacterBodies

# The pool trunk standing on a tree nearest to `point`, or none
func nearestPooledTrunk(
  physicsSystem: view WalkerPhysics
  world: view WalkerWorld
  point: view Vec3
) ret opt EntityId {
  var nearest: opt EntityId = none
  var nearestDistance: Float = 1000000.0
  loop let entityId: view EntityId in physicsSystem.trunks {
    let position: Vec3 = componentView(this: world.transforms, entityId: entityId).position
    if position.z > trunkPoolParked * 0.5 {
      let gap: Vec3 = Vec3.vsub(a: position, b: point)
      let distance: Float = Math.sqrt(x: gap.x * gap.x + gap.y * gap.y)
      if distance < nearestDistance {
        nearestDistance = distance
        nearest = entityId
      }
    }
  }
  ret nearest
}

# The pooled trunk nearest the hero blocks a ray, the hero walking at it
# stops at its bark, the pool follows the walker somewhere else, and so does
# the ground. One [trunktest] line.
func runPooledTrunkTest(
  physicsSystem: mod WalkerPhysics
  world: mod WalkerWorld
  forest: view PropField
  heroEntityId: view EntityId
) ret Bool {
  let heroFeet: Vec3 = controllerFeet(
    controller: controllerOf(controllers: world.controllers, entityId: heroEntityId)
    groundZ: physicsSystem.groundZ
  )
  if let treeEntityId: EntityId = nearestPooledTrunk(
    physicsSystem: physicsSystem
    world: world
    point: heroFeet
  ) {
    let placed: Transform3D = transformOf(transforms: world.transforms, entityId: treeEntityId)
    let blocksRay: Bool = rayHitsEntity(
      physicsSystem: physicsSystem
      entityId: treeEntityId
      foot: placed.position
      height: 1.2
      halfSpan: 3.0
    )
    let closest: Float = walkClosest(
      physicsSystem: physicsSystem
      transforms: world.transforms
      controllers: world.controllers
      bushes: bushSpots(propKinds: world.propKinds, transforms: world.transforms)
      heroEntityId: heroEntityId
      target: placed.position
      steps: trunkTestWalkSteps
    )
    let stoppedAtBark: Bool = closest > treeTrunkRadius + 0.1 and closest < treeTrunkRadius + 1.2
    let feetNow: Vec3 = controllerFeet(
      controller: controllerOf(controllers: world.controllers, entityId: heroEntityId)
      groundZ: physicsSystem.groundZ
    )
    let followed: Bool = poolFollows(
      physicsSystem: physicsSystem
      transforms: world.transforms
      forest: forest
      heroFeet: feetNow
    )
    let groundMoved: Bool = groundFollows(physicsSystem: physicsSystem, heroFeet: feetNow)
    let passed: Bool = blocksRay and stoppedAtBark and followed and groundMoved
    log(
      "[trunktest] blocksRay={blocksRay}, closest {closest} m from the trunk (stoppedAtBark={stoppedAtBark}), poolFollows={followed}, groundFollows={groundMoved}, passed={passed}"
    )
    ret passed
  }
  log("[trunktest] no pooled trunk on a tree, passed=false")
  ret false
}

# The whole check. `pooledTrunks`: the trunks are WalkerPhysics' pool on
# `forest` (a wide forest), else one per tree entity (an island).
func runWalkerSelfTest(
  physicsSystem: mod WalkerPhysics
  world: mod WalkerWorld
  forest: view PropField
  pooledTrunks: view Bool
  heroEntityId: view EntityId
) ret Int {
  let check: CubeJumpCheck = runCubeJumpCheck(
    physicsSystem: physicsSystem
    transforms: world.transforms
    controllers: world.controllers
    bushes: bushSpots(propKinds: world.propKinds, transforms: world.transforms)
    heroEntityId: heroEntityId
  )
  var trunksHeld: Bool = false
  if pooledTrunks {
    trunksHeld = runPooledTrunkTest(
      physicsSystem: physicsSystem
      world: world
      forest: forest
      heroEntityId: heroEntityId
    )
  } else {
    trunksHeld = runIslandTrunkTest(
      physicsSystem: physicsSystem
      treeVariants: world.treeVariants
      propKinds: world.propKinds
      transforms: world.transforms
      controllers: world.controllers
      heroEntityId: heroEntityId
    )
  }
  let rocksAndBushesHeld: Bool = runRockBushTest(
    physicsSystem: physicsSystem
    propKinds: world.propKinds
    transforms: world.transforms
    controllers: world.controllers
    heroEntityId: heroEntityId
  )
  let passed: Bool = cubeJumpCheckPassed(check: check) and trunksHeld and rocksAndBushesHeld
  log("[physicstest] {cubeJumpCheckText(check: check)}, passed={passed}")
  if passed {
    ret 0
  }
  ret 1
}
