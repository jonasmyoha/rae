# app3d/GrassTuft — a clump of grass made in code for the walkers' meadow
# (app3d/WalkerMeadow), stylized low-poly like the GPU grass: a dozen
# broad, flat blades rise from a small oval root, each a strip that tapers
# to a point and leans outward, the inner ones taller. One normal a blade
# vertex, up and a little outward, so the clump shades as one soft shape,
# not blade by blade. Both faces are written, so it draws from every side.
# Written new.
#
# Three forms (grassTuftForm): the tuft, a low wide spread and tall upright
# reeds, drawn near with two segments a blade and far with one (the same
# blades, straight). The meadow colors a tuft as the GPU grass: the
# terrain's grass color at the root, lighter to the tip (GbufferRecord
# grassBladePattern; the blade's height is 1 - its v coordinate).
#
# Each vertex carries its blade's root as its wind pivot and a flexibility
# that grows to the tip (lib/FoliageMesh), so a tuft uploaded with
# uploadFoliage and drawn with a sway (GbufferRecord setInstanceSway) bends
# in the wind, each blade on its own phase.
import Math
import Vec3
open Mesh3d
open Noise

const grassTuftBlades: Int = 12

const grassTuftSegments: Int = 4

# How far a blade's tip bends in the wind (lib/wind.wgsl windLeaf's
# flexibility): every vertex turns about its blade's root, by this times
# the square of how far up the blade it is, so the root stays put and the
# blade curves, the tip most. Negative: windLeaf's slow, broad response
# (the tuft or patch sways as one, the blades a little apart), a calm sway
# with no quick per-blade jitter
const grassTuftTipFlex: Float = -0.6

# One blade's strip from `root` leaning toward `out` (unit, level), `height`
# tall and `width` wide at its root, in `segments` pieces
func addGrassBlade(
  mesh: mod MeshData
  root: view Vec3
  out: view Vec3
  height: view Float
  width: view Float
  lean: view Float
  segments: view Int
) {
  let side: Vec3 = Vec3.create(x: -out.y, y: out.x, z: 0.0)
  let normal: Vec3 = Vec3.vnorm(a: Vec3.create(x: out.x * 0.45, y: out.y * 0.45, z: 1.0))
  let first: Int = mesh.vertCount
  loop var k: Int = 0, k <= segments, ++k {
    let t: Float = k.toFloat() / segments.toFloat()
    # the blade bends outward more toward its tip
    let reach: Float = lean * height * t * t
    let center: Vec3 = Vec3.vadd(
      a: root
      b: Vec3.create(x: out.x * reach, y: out.y * reach, z: height * t * (1.0 - 0.15 * t * lean))
    )
    let half: Float = width * 0.5 * (1.0 - t)
    loop var edge: Int = 0, edge < 2, ++edge {
      let s: Float = edge.toFloat() * 2.0 - 1.0
      pushVert(
        verts: mesh.verts
        px: center.x + side.x * half * s
        py: center.y + side.y * half * s
        pz: center.z
        nx: normal.x
        ny: normal.y
        nz: normal.z
        u: edge.toFloat()
        value: 1.0 - t
      )
      mesh.vertCount = mesh.vertCount + 1
      # its wind pivot (the blade's root) and flexibility
      # (lib/FoliageMesh: upload with uploadFoliage)
      mesh.windPivots.add(value: root.x)
      mesh.windPivots.add(value: root.y)
      mesh.windPivots.add(value: root.z)
      mesh.windPivots.add(value: grassTuftTipFlex * t * t)
    }
  }
  loop var k: Int = 0, k < segments, ++k {
    let a: Int = first + k * 2
    # front and back faces
    mesh.indices.add(value: a)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 3)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a + 3)
  }
}

# A tuft's form: its blades, its root's oval (m), the heights of its inner
# and its outer blades (m, at scale 1), how far the blades lean out at the
# center and at the rim, and their width at the root (m)
type GrassTuftForm {
  blades: Int
  rootX: Float
  rootY: Float
  innerHeight: Float
  outerHeight: Float
  innerLean: Float
  rimLean: Float
  width: Float
}

# The forms: 0 the tuft (about 1 m across, 1.2 m tall at scale 1), 1 a low
# wide spread (1.3 m across, 0.6 m tall, the blades leaning far out), 2 tall
# upright reeds (1.9 m tall, narrow)
const grassTuftForms: Int = 3

func grassTuftForm(form: view Int) ret GrassTuftForm {
  if form is 1 {
    ret GrassTuftForm {
      blades: 10
      rootX: 0.34
      rootY: 0.30
      innerHeight: 0.62
      outerHeight: 0.36
      innerLean: 0.5
      rimLean: 1.0
      width: 0.2
    }
  }
  if form is 2 {
    ret GrassTuftForm {
      blades: 9
      rootX: 0.15
      rootY: 0.13
      innerHeight: 1.9
      outerHeight: 1.3
      innerLean: 0.06
      rimLean: 0.25
      width: 0.12
    }
  }
  ret GrassTuftForm {
    blades: grassTuftBlades
    rootX: 0.22
    rootY: 0.18
    innerHeight: 1.2
    outerHeight: 0.75
    innerLean: 0.15
    rimLean: 0.55
    width: 0.17
  }
}

# The tuft made from `seed`, its foot at the origin, Z up
func grassTuftMesh(seed: view Int) ret MeshData {
  ret grassTuftFormMesh(
    seed: seed
    form: grassTuftForm(form: 0)
    segments: grassTuftSegments
    widthScale: 1.0
  )
}

# A tuft of `form` from `seed`, its blades in `segments` pieces and
# `widthScale` times as wide (a far tuft's blades wider, so they do not
# thin to nothing)
func grassTuftFormMesh(
  seed: view Int
  form: view GrassTuftForm
  segments: view Int
  widthScale: view Float
) ret MeshData {
  var mesh: MeshData = {
    verts: List.create(Float, cap: form.blades * (segments + 1) * 16)
    indices: List.create(Int, cap: form.blades * segments * 12)
    vertCount: 0
  }
  loop var blade: Int = 0, blade < form.blades, ++blade {
    let around: Float = blade.toFloat() * 2.3999632 + hash2(x: blade, y: 1, seed: seed) * 0.6
    # the root in the oval, the later blades nearer the rim
    let rim: Float = Math.sqrt(x: (blade.toFloat() + 0.5) / form.blades.toFloat())
    let out: Vec3 = Vec3.create(x: Math.cos(x: around), y: Math.sin(x: around), z: 0.0)
    let root: Vec3 = Vec3.create(x: out.x * form.rootX * rim, y: out.y * form.rootY * rim, z: -0.03)
    # inner blades tall and upright, outer ones shorter and leaning further
    let height: Float = (form.innerHeight + (form.outerHeight - form.innerHeight) * rim) * (0.85 + 0.15 * hash2(
      x: blade
      y: 2
      seed: seed
    ))
    let lean: Float = form.innerLean + (form.rimLean - form.innerLean) * rim + 0.1 * hash2(
      x: blade
      y: 3
      seed: seed
    )
    let stretch: Vec3 = Vec3.create(x: out.x, y: out.y * form.rootY / form.rootX, z: 0.0)
    addGrassBlade(
      mesh: mesh
      root: root
      out: Vec3.vnorm(a: stretch)
      height: height
      width: (form.width + 0.03 * hash2(x: blade, y: 4, seed: seed)) * widthScale
      lean: lean
      segments: segments
    )
  }
  ret own mesh
}

# A patch of turf `size` m square, its center at the origin: `blades` short
# blades (0.3 - 0.6 m) on a jittered grid, each leaning its own way, in
# `segments` pieces and `widthScale` times as wide, the stylized low-poly
# blades of the GPU grass carpet, so the meadow (app3d/WalkerMeadow) carries
# that carpet out over the whole grassy ground. With wind pivots as the
# tufts.
func grassTurfMesh(
  seed: view Int
  blades: view Int
  size: view Float
  segments: view Int
  widthScale: view Float
) ret MeshData {
  var mesh: MeshData = {
    verts: List.create(Float, cap: blades * (segments + 1) * 16)
    indices: List.create(Int, cap: blades * segments * 12)
    vertCount: 0
  }
  let side: Int = Math.max(a: 1, b: Math.sqrt(x: blades.toFloat()).toInt())
  let step: Float = size / side.toFloat()
  loop var blade: Int = 0, blade < blades, ++blade {
    let column: Int = blade % side
    let row: Int = (blade / side) % side
    let root: Vec3 = Vec3.create(
      x: (column.toFloat() + hash2(x: blade, y: 5, seed: seed)) * step - size * 0.5
      y: (row.toFloat() + hash2(x: blade, y: 6, seed: seed)) * step - size * 0.5
      z: -0.03
    )
    let around: Float = hash2(x: blade, y: 7, seed: seed) * 6.2831853
    addGrassBlade(
      mesh: mesh
      root: root
      out: Vec3.create(x: Math.cos(x: around), y: Math.sin(x: around), z: 0.0)
      height: 0.3 + 0.3 * hash2(x: blade, y: 8, seed: seed)
      width: (0.13 + 0.06 * hash2(x: blade, y: 9, seed: seed)) * widthScale
      lean: 0.15 + 0.3 * hash2(x: blade, y: 10, seed: seed)
      segments: segments
    )
  }
  ret own mesh
}
