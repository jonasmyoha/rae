# app3d/GrassTuft — a clump of grass made in code: the walkers' grass
# tufts (app3d/WalkerTerrain kindGrassA/B), in place of a third-party
# Unity asset (the FlatKit "GrassBunch" clump the walker examples once
# loaded). About 30 blades rise from a narrow oval root, each a curved
# strip that tapers to a point and leans outward, the inner ones taller.
# Its size is the old clump's: 1.2 m by 0.8 m and about 1.4 m tall at scale
# 1 (the walkers place it at 0.38 - 0.82). One normal a blade vertex, up and
# a little outward, so the clump shades as one soft shape, not blade by
# blade. Both faces are written, so it draws from every side. Written new.
#
# The walkers' meadow (app3d/WalkerMeadow) uses three forms of it
# (grassTuftForm): the tuft, a low wide spread and tall upright reeds, each
# also with one segment a blade for the distance (the same blades, straight:
# a quarter of the triangles, the same outline).
#
# Each vertex carries its blade's root as its wind pivot and a flexibility
# that grows to the tip (lib/FoliageMesh), so a tuft uploaded with
# uploadFoliage and drawn with a sway (GbufferRecord setInstanceSway) bends
# in the wind, each blade on its own phase.
import Math
import Vec3
open Mesh3d
open Noise

const grassTuftBlades: Int = 30

const grassTuftSegments: Int = 4

# How far a blade's tip bends in the wind (lib/wind.wgsl windLeaf's
# flexibility): every vertex turns about its blade's root, by this times
# the square of how far up the blade it is, so the root stays put and the
# blade curves, the tip most
const grassTuftTipFlex: Float = 2.0

# One blade's strip from `root` leaning toward `out` (unit, level), `height`
# tall and `width` wide at its root, in `segments` pieces
func addGrassBlade(
  mesh: mod MeshData
  root: view Vec3
  out: view Vec3
  height: view Float
  width: view Float
  lean: view Float
  segments: view Int
) {
  let side: Vec3 = Vec3.create(x: -out.y, y: out.x, z: 0.0)
  let normal: Vec3 = Vec3.vnorm(a: Vec3.create(x: out.x * 0.45, y: out.y * 0.45, z: 1.0))
  let first: Int = mesh.vertCount
  loop var k: Int = 0, k <= segments, ++k {
    let t: Float = k.toFloat() / segments.toFloat()
    # the blade bends outward more toward its tip
    let reach: Float = lean * height * t * t
    let center: Vec3 = Vec3.vadd(
      a: root
      b: Vec3.create(x: out.x * reach, y: out.y * reach, z: height * t * (1.0 - 0.15 * t * lean))
    )
    let half: Float = width * 0.5 * (1.0 - t)
    loop var edge: Int = 0, edge < 2, ++edge {
      let s: Float = edge.toFloat() * 2.0 - 1.0
      pushVert(
        verts: mesh.verts
        px: center.x + side.x * half * s
        py: center.y + side.y * half * s
        pz: center.z
        nx: normal.x
        ny: normal.y
        nz: normal.z
        u: edge.toFloat()
        value: 1.0 - t
      )
      mesh.vertCount = mesh.vertCount + 1
      # its wind pivot (the blade's root) and flexibility
      # (lib/FoliageMesh: upload with uploadFoliage)
      mesh.windPivots.add(value: root.x)
      mesh.windPivots.add(value: root.y)
      mesh.windPivots.add(value: root.z)
      mesh.windPivots.add(value: grassTuftTipFlex * t * t)
    }
  }
  loop var k: Int = 0, k < segments, ++k {
    let a: Int = first + k * 2
    # front and back faces
    mesh.indices.add(value: a)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 3)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 1)
    mesh.indices.add(value: a + 2)
    mesh.indices.add(value: a + 3)
  }
}

# A tuft's form: its blades, its root's oval (m), the heights of its inner
# and its outer blades (m, at scale 1), how far the blades lean out at the
# center and at the rim, and their width at the root (m)
type GrassTuftForm {
  blades: Int
  rootX: Float
  rootY: Float
  innerHeight: Float
  outerHeight: Float
  innerLean: Float
  rimLean: Float
  width: Float
}

# The forms: 0 the tuft (1.2 x 0.8 m, 1.4 m tall), 1 a low wide spread
# (1.3 m across, 0.6 m tall, the blades leaning far out), 2 tall upright
# reeds (2 m tall, narrow)
const grassTuftForms: Int = 3

func grassTuftForm(form: view Int) ret GrassTuftForm {
  if form is 1 {
    ret GrassTuftForm {
      blades: 26
      rootX: 0.36
      rootY: 0.30
      innerHeight: 0.62
      outerHeight: 0.34
      innerLean: 0.45
      rimLean: 0.95
      width: 0.08
    }
  }
  if form is 2 {
    ret GrassTuftForm {
      blades: 24
      rootX: 0.17
      rootY: 0.14
      innerHeight: 2.0
      outerHeight: 1.35
      innerLean: 0.05
      rimLean: 0.22
      width: 0.05
    }
  }
  ret GrassTuftForm {
    blades: grassTuftBlades
    rootX: 0.24
    rootY: 0.16
    innerHeight: 1.39
    outerHeight: 0.79
    innerLean: 0.12
    rimLean: 0.5
    width: 0.07
  }
}

# The tuft made from `seed`, its foot at the origin, Z up
func grassTuftMesh(seed: view Int) ret MeshData {
  ret grassTuftFormMesh(
    seed: seed
    form: grassTuftForm(form: 0)
    segments: grassTuftSegments
    widthScale: 1.0
  )
}

# A tuft of `form` from `seed`, its blades in `segments` pieces and
# `widthScale` times as wide (a far tuft's blades wider, so they do not
# thin to nothing)
func grassTuftFormMesh(
  seed: view Int
  form: view GrassTuftForm
  segments: view Int
  widthScale: view Float
) ret MeshData {
  var mesh: MeshData = {
    verts: List.create(Float, cap: form.blades * (segments + 1) * 16)
    indices: List.create(Int, cap: form.blades * segments * 12)
    vertCount: 0
  }
  loop var blade: Int = 0, blade < form.blades, ++blade {
    let around: Float = blade.toFloat() * 2.3999632 + hash2(x: blade, y: 1, seed: seed) * 0.6
    # the root in the oval, the later blades nearer the rim
    let rim: Float = Math.sqrt(x: (blade.toFloat() + 0.5) / form.blades.toFloat())
    let out: Vec3 = Vec3.create(x: Math.cos(x: around), y: Math.sin(x: around), z: 0.0)
    let root: Vec3 = Vec3.create(x: out.x * form.rootX * rim, y: out.y * form.rootY * rim, z: -0.03)
    # inner blades tall and upright, outer ones shorter and leaning further
    let height: Float = (form.innerHeight + (form.outerHeight - form.innerHeight) * rim) * (0.85 + 0.15 * hash2(
      x: blade
      y: 2
      seed: seed
    ))
    let lean: Float = form.innerLean + (form.rimLean - form.innerLean) * rim + 0.1 * hash2(
      x: blade
      y: 3
      seed: seed
    )
    let stretch: Vec3 = Vec3.create(x: out.x, y: out.y * form.rootY / form.rootX, z: 0.0)
    addGrassBlade(
      mesh: mesh
      root: root
      out: Vec3.vnorm(a: stretch)
      height: height
      width: (form.width + 0.03 * hash2(x: blade, y: 4, seed: seed)) * widthScale
      lean: lean
      segments: segments
    )
  }
  ret own mesh
}
