# A horizontal slider, driven by the pointer against a named track node.
#
# Lives in app3d rather than lib/ui because it is built out of the same
# named-node access the other shared components use (`ui_shell`), not out of new
# ECS components. Nothing here is 3D-specific; if a second family of apps wants
# it, it moves down with no change to the interface.
#
# The app owns the CHROME — a track node and a fill node in its own scene, so
# placement, colours and rounding stay the app's business — and this owns the
# BEHAVIOUR: where the pointer is, whether a drag is in progress, and what
# fraction that maps to. The split matches `control_panel.rae`.
#
# Dragging continues while the button is held even if the pointer leaves the
# track, which is what every real slider does; releasing anywhere ends it. A
# slider that only tracked while inside its own rect would slip whenever the
# user moved faster than the frame rate.

import core
import math
open ui/ecs
open ui/components
open ui/input_gpu2d
open app3d/ui_shell
open ecs/entity

type Slider {
  # Node ids in the app's scene. `trackId` is the full-width bar the pointer is
  # measured against; `fillId` is the portion left of the handle, resized here.
  trackId: String
  fillId: String
  minValue: Float
  maxValue: Float
  value: Float
  # True between press and release. Held here rather than derived per frame so
  # a drag survives the pointer leaving the track.
  dragging: Bool
}

func createSlider(trackId: view String, fillId: view String,
                  minValue: view Float, maxValue: view Float,
                  value: view Float) pub ret Slider {
  ret Slider {
    trackId: "{trackId}"
    fillId: "{fillId}"
    minValue: minValue
    maxValue: maxValue
    value: value
    dragging: false
  }
}

func sliderClamp(v: view Float, lo: view Float, hi: view Float) ret Float {
  if v < lo {
    ret lo
  }
  if v > hi {
    ret hi
  }
  ret v
}

# Where the value sits in 0..1. Guards a zero-width range rather than dividing
# by it: a slider whose bounds are equal is a mistake, not a crash.
func sliderFraction(s: view Slider) pub ret Float {
  let span: Float = s.maxValue - s.minValue
  if span <= 0.0 {
    ret 0.0
  }
  ret sliderClamp(v: (s.value - s.minValue) / span, lo: 0.0, hi: 1.0)
}

func sliderSetFraction(s: mod Slider, f: view Float) pub {
  let span: Float = s.maxValue - s.minValue
  s.value = s.minValue + sliderClamp(v: f, lo: 0.0, hi: 1.0) * span
}

# Pointer x -> value, using the track's laid-out rect. Returns the fraction so
# the caller can decide what "changed" means for its own value.
func sliderFractionForX(world: view UiWorld, trackId: view String, x: view Float) ret Float {
  let e: EntityId = nodeEntityFor(world: world, nodeId: trackId)
  if isNone(this: e) {
    ret 0.0
  }
  if componentHas(this: world.computedRects, entity: e) is false {
    ret 0.0
  }
  let r: ComputedRect = componentGet(this: world.computedRects, entity: e)
  if r.size.x <= 0.0 {
    ret 0.0
  }
  # Screen x, for the same reason as pointInNode.
  let sx: Float = nodeScreenX(world: world, e: e)
  ret sliderClamp(v: (x - sx) / r.size.x, lo: 0.0, hi: 1.0)
}

func pointInRect(r: view ComputedRect, x: view Float, y: view Float) ret Bool {
  if x < r.position.x or x > r.position.x + r.size.x {
    ret false
  }
  if y < r.position.y or y > r.position.y + r.size.y {
    ret false
  }
  ret true
}

# Advance the slider for this frame. Returns true when the value moved, so a
# caller can avoid recomputing whatever the slider drives on frames where the
# user is only hovering.
func updateSlider(s: mod Slider, world: view UiWorld, input: view UiInput) pub ret Bool {
  let before: Float = s.value

  if input.pointer.pressed {
    let e: EntityId = nodeEntityFor(world: world, nodeId: s.trackId)
    if isNone(this: e) is false {
      if componentHas(this: world.computedRects, entity: e) {
        let r: ComputedRect = componentGet(this: world.computedRects, entity: e)
        # A press anywhere on the track jumps the handle there and begins a
        # drag, rather than requiring the handle itself to be hit — the handle
        # is a few pixels wide and the track is the affordance.
        if pointInRect(r: r, x: input.pointer.x, y: input.pointer.y) {
          s.dragging = true
        }
      }
    }
  }

  if s.dragging {
    sliderSetFraction(s: s, f: sliderFractionForX(world: world, trackId: s.trackId, x: input.pointer.x))
  }

  # Released, or the button came up somewhere we never saw: either way the drag
  # is over. Checking `down` as well as `released` means a release swallowed by
  # a window switch cannot leave the slider stuck to the pointer.
  if input.pointer.released or input.pointer.down is false {
    s.dragging = false
  }

  ret s.value is not before
}

# Resize the fill node to match the value. Separate from `updateSlider` because
# the visual is the app's scene: a caller that paints its slider differently
# uses `sliderFraction` and skips this.
func applySliderFill(s: view Slider, world: mod UiWorld) pub {
  let track: EntityId = nodeEntityFor(world: world, nodeId: s.trackId)
  if isNone(this: track) {
    ret
  }
  if componentHas(this: world.computedRects, entity: track) is false {
    ret
  }
  let tr: ComputedRect = componentGet(this: world.computedRects, entity: track)
  let fill: EntityId = nodeEntityFor(world: world, nodeId: s.fillId)
  if isNone(this: fill) {
    ret
  }
  if componentHas(this: world.computedRects, entity: fill) is false {
    ret
  }
  let want: Float = tr.size.x * sliderFraction(s: s)
  let fr: ComputedRect = componentGet(this: world.computedRects, entity: fill)
  # Only write on a real change: componentSet bumps the table generation whether
  # or not the value differs, and a per-frame write to an unchanged width keeps
  # the render cache permanently dirty (#407).
  var delta: Float = want - fr.size.x
  if delta < 0.0 {
    delta = 0.0 - delta
  }
  if delta <= 0.05 {
    ret
  }
  let next: ComputedRect = { position: { x: fr.position.x, y: fr.position.y }, size: { x: want, y: fr.size.y } }
  componentSet(this: world.computedRects, entity: fill, data: next)
}


# ----- node-based slider ----------------------------------------------
#
# The functions above keep a Slider value; these take the track and handle node
# ids directly, so a caller can hold nothing but the value it cares about. That
# matters because a Slider stored INSIDE another struct cannot be updated: a
# nested field passed as `mod` does not reliably write back in this compiler,
# and the failure is silent.

func nodeComputedRect(world: view UiWorld, nodeId: view String, out: mod ComputedRect) ret Bool {
  let e: EntityId = nodeEntityFor(world: world, nodeId: nodeId)
  if isNone(this: e) {
    ret false
  }
  if componentHas(this: world.computedRects, entity: e) is false {
    ret false
  }
  out = componentGet(this: world.computedRects, entity: e)
  ret true
}

func debugNodeRect(world: view UiWorld, nodeId: view String) pub {
  let e: EntityId = nodeEntityFor(world: world, nodeId: nodeId)
  if isNone(this: e) {
    log("[slider] {nodeId}: NO ENTITY")
    ret
  }
  if componentHas(this: world.computedRects, entity: e) is false {
    log("[slider] {nodeId}: no ComputedRect")
    ret
  }
  let r: ComputedRect = componentGet(this: world.computedRects, entity: e)
  log("[slider] {nodeId}: x={r.position.x} y={r.position.y} w={r.size.x} h={r.size.y}")
}

# POSITION COMES FROM WorldTransform, SIZE FROM ComputedRect.
#
# ComputedRect.x/y is PARENT-LOCAL — a control nested three deep in a panel
# reports x=12 while sitting at x=952 on screen. Testing a pointer against it
# compares screen coordinates to local ones, so a press is never inside and the
# control is silently inert. uiHitTest gets this right (wt.x + cr.size.x) and is the
# reference; these helpers now match it.
func nodeScreenX(world: view UiWorld, e: view EntityId) ret Float {
  if componentHas(this: world.worldTransforms, entity: e) is false {
    ret 0.0
  }
  let wt: WorldTransform = componentGet(this: world.worldTransforms, entity: e)
  ret wt.x
}

func nodeScreenY(world: view UiWorld, e: view EntityId) ret Float {
  if componentHas(this: world.worldTransforms, entity: e) is false {
    ret 0.0
  }
  let wt: WorldTransform = componentGet(this: world.worldTransforms, entity: e)
  ret wt.y
}

func pointInNode(world: view UiWorld, nodeId: view String,
                 x: view Float, y: view Float) pub ret Bool {
  let e: EntityId = nodeEntityFor(world: world, nodeId: nodeId)
  if isNone(this: e) {
    ret false
  }
  if componentHas(this: world.computedRects, entity: e) is false {
    ret false
  }
  let r: ComputedRect = componentGet(this: world.computedRects, entity: e)
  let sx: Float = nodeScreenX(world: world, e: e)
  let sy: Float = nodeScreenY(world: world, e: e)
  if x < sx or x > sx + r.size.x {
    ret false
  }
  if y < sy or y > sy + r.size.y {
    ret false
  }
  ret true
}

# Where x falls across the node, 0..1.
func fractionAcrossNode(world: view UiWorld, nodeId: view String, x: view Float) pub ret Float {
  let e: EntityId = nodeEntityFor(world: world, nodeId: nodeId)
  if isNone(this: e) {
    ret 0.0
  }
  if componentHas(this: world.computedRects, entity: e) is false {
    ret 0.0
  }
  let r: ComputedRect = componentGet(this: world.computedRects, entity: e)
  if r.size.x <= 0.0 {
    ret 0.0
  }
  # Screen x, for the same reason as pointInNode.
  let sx: Float = nodeScreenX(world: world, e: e)
  ret sliderClamp(v: (x - sx) / r.size.x, lo: 0.0, hi: 1.0)
}

# Resize `fillId` to a fraction of `trackId`. Writes only on a real change:
# componentSet bumps the table generation either way, and a per-frame write to
# an unchanged width keeps the render cache permanently dirty (#407).
func setNodeFractionWidth(world: mod UiWorld, trackId: view String,
                          fillId: view String, fraction: view Float) pub {
  let te: EntityId = nodeEntityFor(world: world, nodeId: trackId)
  let fe: EntityId = nodeEntityFor(world: world, nodeId: fillId)
  if isNone(this: te) or isNone(this: fe) {
    ret
  }
  if componentHas(this: world.computedRects, entity: te) is false {
    ret
  }
  if componentHas(this: world.computedRects, entity: fe) is false {
    ret
  }
  let tr: ComputedRect = componentGet(this: world.computedRects, entity: te)
  let fr: ComputedRect = componentGet(this: world.computedRects, entity: fe)
  let want: Float = tr.size.x * sliderClamp(v: fraction, lo: 0.0, hi: 1.0)
  var delta: Float = want - fr.size.x
  if delta < 0.0 {
    delta = 0.0 - delta
  }
  if delta <= 0.05 {
    ret
  }
  let next: ComputedRect = { position: { x: tr.position.x, y: fr.position.y }, size: { x: want, y: fr.size.y } }
  componentSet(this: world.computedRects, entity: fe, data: next)
  if componentHas(this: world.rects, entity: fe) {
    let ar: Rect = componentGet(this: world.rects, entity: fe)
    let nextAuthored: Rect = { position: { x: ar.position.x, y: ar.position.y }, size: { x: want, y: ar.size.y } }
    componentSet(this: world.rects, entity: fe, data: nextAuthored)
  }
}

# Centre `handleId` on a fraction along `trackId` — the moving circle that makes
# the control read as a slider rather than as a progress bar.
func centreNodeAtFraction(world: mod UiWorld, trackId: view String,
                          handleId: view String, fraction: view Float) pub {
  let te: EntityId = nodeEntityFor(world: world, nodeId: trackId)
  let he: EntityId = nodeEntityFor(world: world, nodeId: handleId)
  if isNone(this: te) or isNone(this: he) {
    ret
  }
  if componentHas(this: world.computedRects, entity: te) is false {
    ret
  }
  if componentHas(this: world.rects, entity: he) is false {
    ret
  }
  let tr: ComputedRect = componentGet(this: world.computedRects, entity: te)
  let hr: Rect = componentGet(this: world.rects, entity: he)
  let f: Float = sliderClamp(v: fraction, lo: 0.0, hi: 1.0)
  # The handle is a CHILD of the track, so its authored x is already relative to
  # the track's origin: the travel is the track's width less the handle's, so it
  # stays inside at both ends instead of hanging off.
  let travel: Float = tr.size.x - hr.size.x
  let wantX: Float = travel * f
  var dx: Float = wantX - hr.position.x
  if dx < 0.0 {
    dx = 0.0 - dx
  }
  # Only on a real change: componentSet bumps the table generation either way,
  # and a per-frame write keeps the render cache permanently dirty (#407).
  if dx <= 0.05 {
    ret
  }
  # BOTH rects. The authored one is what layout recomputes from next frame; the
  # computed one is what this frame draws, and writing only the authored rect
  # leaves the knob a frame behind — or not moving at all where layout does not
  # re-derive it.
  let next: Rect = { position: { x: wantX, y: hr.position.y }, size: { x: hr.size.x, y: hr.size.y } }
  componentSet(this: world.rects, entity: he, data: next)
  if componentHas(this: world.computedRects, entity: he) {
    let cr: ComputedRect = componentGet(this: world.computedRects, entity: he)
    let trc: ComputedRect = componentGet(this: world.computedRects, entity: te)
    let nextC: ComputedRect = { position: { x: trc.position.x + wantX, y: cr.position.y }, size: { x: cr.size.x, y: cr.size.y } }
    componentSet(this: world.computedRects, entity: he, data: nextC)
  }
}

# Should a drag be running after this frame's pointer state?
#
# Pulled out as a pure function because the bug it encodes cost two rounds and
# is invisible in a screenshot: requiring `down` to be true cancelled the drag on
# the very frame the press arrived, because the press EDGE and the held STATE do
# not necessarily both read true on the same frame. The slider was not twitchy,
# it was completely inert — and nothing about the rendered frame said why.
#
#   wasDragging — whether a drag was already running
#   pressedInside — a press edge landed on the track this frame
func sliderDragActive(wasDragging: view Bool, pressedInside: view Bool,
                      down: view Bool, released: view Bool) pub ret Bool {
  if released {
    ret false
  }
  # A press counts as held even if `down` has not caught up yet.
  let held: Bool = down or pressedInside
  if held is false {
    ret false
  }
  if pressedInside {
    ret true
  }
  ret wasDragging
}
