# app3d/WalkerWorld — the walker examples' ECS world (136, 137, 143): the
# reusable entity core (EntityAllocator) plus a ComponentTable per gameplay
# component, keyed by EntityId. The hero and every crowd member carry a
# ThirdPersonController and an AnimationState; each skinned body part is an
# entity with a PartRoughness; the terrain props are WalkerTerrain's
# TerrainProp / TreeVariant; a joined remote player is a NetPlayer
# (app3d/WalkerNet). The physics bodies' tables are WalkerPhysics' own, their
# poses are in `transforms` here.
#
# The transform components are lib/ecs's quaternion Transform3D /
# WorldTransform3D folded by the general TransformSystem; the camera rig is a
# parent/child relation in `parents` / `childrens` (app3d/WalkerCamera).
import Vec3
import Quat
open ecs/Entity
open ecs/World
open ecs/ComponentTable
open ecs/Query
open ecs/Transform
open ecs/Hierarchy
open ecs/hierarchySystem/HierarchySystem
open app3d/CharacterController
open app3d/WalkerCharacter
open app3d/Characters
open app3d/Material
open ecs/Tag
open app3d/PlayerRoster
open app3d/WalkerTerrain
open app3d/WalkerPhysics

type WalkerWorld {
  allocator: EntityAllocator
  transforms: ComponentTable(Transform3D)
  worldTransforms: ComponentTable(WorldTransform3D)
  materials: ComponentTable(Material3D)
  # #739: gameplay controllers + per-entity animation. The hero and every crowd
  # member is an entity carrying a ThirdPersonController (movement) and an
  # AnimationState (clip + phase); driven in place via componentMod (#721), no
  # copy-out/mutate/set-back.
  controllers: ComponentTable(ThirdPersonController)
  animStates: ComponentTable(AnimationState)
  # A character's clip transition, its render models, and the tag on the one
  # the local player drives (app3d/Characters)
  animTransitions: ComponentTable(AnimationTransition)
  characterModels: ComponentTable(CharacterModel)
  controlled: ComponentTable(Controlled)
  # #740: skinned body-mesh parts, one entity each.
  partRoughness: ComponentTable(PartRoughness)
  # The terrain's props are recycled entities (app3d/WalkerTerrain):
  # TerrainProp identifies the prop (kind + pool slot + placement-active);
  # TreeVariant records a tree entity's species.
  propKinds: ComponentTable(TerrainProp)
  treeVariants: ComponentTable(TreeVariant)
  # #744: ECS parent/child hierarchy — Parent (cached upward link) + Children
  # (authoritative ordered list) folded into WorldTransform3D by the general
  # TransformSystem, walked in HierarchyOrder. First 3D user is the camera rig
  # (rig entity -> camera entity as a Parent relation), replacing applyCameraRig.
  parents: ComponentTable(Parent)
  childrens: ComponentTable(Children)
  hierarchyOrder: HierarchyOrder
  # #746: a joined remote player is an ENTITY carrying a NetPlayer, spawned /
  # despawned through the generational allocator (#704). The physics bodies'
  # tables (rigid bodies, colliders, characters, cubes) are WalkerPhysics'
  # own; their poses are in `transforms` here.
  netPlayers: ComponentTable(NetPlayer)
}

func createWalkerWorld() ret WalkerWorld {
  ret WalkerWorld {
    allocator: createEntityAllocator()
    transforms: ComponentTable.create(Transform3D)
    worldTransforms: ComponentTable.create(WorldTransform3D)
    materials: ComponentTable.create(Material3D)
    controllers: ComponentTable.create(ThirdPersonController)
    animStates: ComponentTable.create(AnimationState)
    animTransitions: ComponentTable.create(AnimationTransition)
    characterModels: ComponentTable.create(CharacterModel)
    controlled: ComponentTable.create(Controlled)
    partRoughness: ComponentTable.create(PartRoughness)
    propKinds: ComponentTable.create(TerrainProp)
    treeVariants: ComponentTable.create(TreeVariant)
    parents: ComponentTable.create(Parent)
    childrens: ComponentTable.create(Children)
    hierarchyOrder: createHierarchyOrder()
    netPlayers: ComponentTable.create(NetPlayer)
  }
}

# Allocate a fresh gameplay entity.
func walkerWorldAddEntity(world: mod WalkerWorld) ret EntityId {
  ret allocEntity(this: world.allocator)
}

# Component setters — thin wrappers so call sites read as intent rather than
# ComponentTable plumbing (mirrors 134's World3d helpers).
func walkerWorldSetTransform(
  world: mod WalkerWorld
  entityId: view EntityId
  transform: view Transform3D
) {
  componentSet(this: world.transforms, entityId: entityId, data: transform)
}

func walkerWorldSetWorldTransform(
  world: mod WalkerWorld
  entityId: view EntityId
  worldTransform: view WorldTransform3D
) {
  componentSet(this: world.worldTransforms, entityId: entityId, data: worldTransform)
}

func walkerWorldSetMaterial(
  world: mod WalkerWorld
  entityId: view EntityId
  material: view Material3D
) {
  componentSet(this: world.materials, entityId: entityId, data: material)
}

func walkerWorldSetController(
  world: mod WalkerWorld
  entityId: view EntityId
  controller: view ThirdPersonController
) {
  componentSet(this: world.controllers, entityId: entityId, data: controller)
}

func walkerWorldSetAnim(
  world: mod WalkerWorld
  entityId: view EntityId
  anim: view AnimationState
) {
  componentSet(this: world.animStates, entityId: entityId, data: anim)
}

func walkerWorldSetPartRoughness(
  world: mod WalkerWorld
  entityId: view EntityId
  part: view PartRoughness
) {
  componentSet(this: world.partRoughness, entityId: entityId, data: part)
}

# The skinned parts, in creation (= upload) order — a query over the part table.
func walkerWorldPartCount(world: view WalkerWorld) ret Int {
  ret componentCount(this: world.partRoughness)
}

func walkerWorldPartAt(world: view WalkerWorld, i: view Int) ret view PartRoughness {
  ret queryViewAt(table: world.partRoughness, denseIndex: i)
}

# Derive a Transform3D from a controller (its position + heading about +Z). Kept
# in sync at creation and whenever the controller moves, so the ECS transform
# tracks the gameplay controller (later systems — camera rig #744, quat #745 —
# read this rather than the controller directly).
# The ThirdPersonController of an entity (hero or crowd member). A narrow
# WalkerWorld accessor so systems read a controlled character straight from the
# world without depending on the App aggregate (#743).
func controllerOf(world: view WalkerWorld, entityId: view EntityId) ret view ThirdPersonController {
  ret componentView(this: world.controllers, entityId: entityId)
}

func controllerTransform3D(controller: view ThirdPersonController) ret Transform3D {
  ret Transform3D {
    position: controller.position
    rotation: Quat.fromAxisAngle(axis: Vec3 { x: 0.0, y: 0.0, z: 1.0 }, angle: controller.heading)
    scale: Vec3 { x: 1.0, y: 1.0, z: 1.0 }
  }
}

func walkerWorldEntityCount(world: view WalkerWorld) ret Int {
  ret allocatorAliveCount(this: world.allocator)
}

# The world position / heading of whichever character the local player
# controls (app3d/PlayerRoster) — the hero or a crowd member. Used to aim the
# camera and stream the terrain around the ACTIVE character.
func controlledPosition(
  world: view WalkerWorld
  players: view PlayerRoster
  characterSystem: view CharacterSystem
) ret Vec3 {
  ret controllerOf(world: world, entityId: rosterControlledEntityId(players: players)).position
}

func controlledHeading(
  world: view WalkerWorld
  players: view PlayerRoster
  characterSystem: view CharacterSystem
) ret Float {
  ret controllerOf(world: world, entityId: rosterControlledEntityId(players: players)).heading
}

# Despawn a cube: its body, collider and PhysicsCube row (WalkerPhysics),
# then every component row of the entity in the world (so a recycled index
# reads nothing stale), then the entity itself.
func despawnCubeEntity(
  physicsSystem: mod WalkerPhysics
  world: mod WalkerWorld
  entityId: view EntityId
) {
  despawnPhysicsCube(physicsSystem: physicsSystem, entityId: entityId)
  clearEntityComponents(world: world, entityId: entityId)
  freeEntity(this: world.allocator, entityId: entityId)
}
