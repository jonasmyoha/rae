# app3d/SettingsSky — the settings panel's values turned into what a renderer
# takes (split from app3d/SettingsDialog for the 1000-line cap): the sun for
# the hour, the sky of the chosen model, the moon and its light, the key
# light (the sun by day, the moon at night) and the shadows' sun.
# SettingsDialog owns SettingsState, the panel and its controls.
import Math
import Sys
open GbufferSmaa
open RendererDeferred
open LightUnits
open ui/Ecs
open Vec3
open SkyHosek
open Sky
open app3d/TimeOfDay
open Moon
open app3d/SettingsDialog

# The most moons in the sky, the earth's one and the invented ones the sky
# draws beside it
const settingsMoonsMax: Int = 1 + skyMoonsMax

# The moon count to start with: RAE_MOONS=<n> (1 .. settingsMoonsMax), else
# the earth's moon alone
func settingsMoonCountFromEnv() ret Int {
  let text: String = Sys.getEnv(name: "RAE_MOONS")
  if text.length() is 0 {
    ret 1
  }
  ret Math.clamp(val: text.toInt(), low: 1, high: settingsMoonsMax)
}

# The moon count's buttons: "settings.moons.fewer" / "settings.moons.more"
# change it by one within 1 .. settingsMoonsMax and switch the moon on. True
# when `actionId` was one of them.
func settingsMoonsAction(settingsState: mod SettingsState, actionId: view String) ret Bool {
  var change: Int = 0
  if actionId is "settings.moons.fewer" {
    change = -1
  } else if actionId is "settings.moons.more" {
    change = 1
  } else {
    ret false
  }
  settingsState.moonCount = Math.clamp(
    val: settingsState.moonCount + change
    low: 1
    high: settingsMoonsMax
  )
  settingsState.moon = true
  ret true
}

# "Moons: 3", or "Moons: off" with the moon switched off
func settingsMoonsTitle(settingsState: view SettingsState) ret String {
  if settingsState.moon is false {
    ret "Moons: off"
  }
  ret "Moons: {settingsState.moonCount}"
}

# The panel's antialiasing on a deferred renderer: TAA on or off, and SMAA
# or FXAA on the finished frame when it is off
func settingsApplyAntialias(renderer: mod DeferredRenderer, settingsState: view SettingsState) {
  setTaaEnabled(renderer: renderer, on: settingsState.antialias is SettingsAntialias.taa)
  var mode: AntialiasMode = AntialiasMode.smaa
  if settingsState.antialias is SettingsAntialias.fxaa {
    mode = AntialiasMode.fxaa
  }
  setAntialiasMode(renderer: renderer, mode: mode)
}

# The panel holds values; these turn them into the things a renderer takes. They
# live here so 110 and 113 cannot disagree about what "10:00, Hosek" means.

# Where the sun is, for this hour. Both the sky and the key light take it, so
# the visible sun and the cast shadows cannot drift apart.
func settingsSunDir(settingsState: view SettingsState) ret Vec3 {
  ret sunDirForDate(
    hour: settingsState.timeOfDay.hour
    dayOfYear: settingsState.timeOfDay.dayOfYear
    latitudeDeg: settingsState.latitude
  )
}

# Warm at the horizon, neutral overhead, and dimmed as the sun sets — the sky
# model reddens on its own, but the direct light would otherwise stay white and
# full-strength through a sunset.
# The sun's illuminance at its highest, in lux: a real clear noon (chosen
# 2026-10-28 over the old balance of 20,000 lux and
# the tree lab's 66,000; looks-development lighting/walkerSun.html). With the
# sky in real units too, the sunlit ground is about 5 times brighter than
# the shade, as outdoors; the automatic exposure brings it to the screen,
# with the walker's -0.5 EV compensation (WalkerApp) so noon's sunlit sand
# does not wash out (docs/physical-light-units.md).
const settingsSunNoonLux: Float = 100000.0

# The sun's light now: its color times its illuminance (lux)
func settingsSunColor(settingsState: view SettingsState) ret Vec3 {
  let base: Vec3 = sunColorForDate(
    hour: settingsState.timeOfDay.hour
    dayOfYear: settingsState.timeOfDay.dayOfYear
    latitudeDeg: settingsState.latitude
  )
  var lift: Float = sunHeightForDate(
    hour: settingsState.timeOfDay.hour
    dayOfYear: settingsState.timeOfDay.dayOfYear
    latitudeDeg: settingsState.latitude
  )
  # Never fully black: a scene lit by nothing reads as broken rather than as
  # night, and there is no night sky model here yet.
  lift = 0.15 + 0.85 * lift
  let lux: Float = settingsState.sunNoonLux * lift * settingsEclipseLight(
    settingsState: settingsState
  )
  ret Vec3.create(x: base.x * lux, y: base.y * lux, z: base.z * lux)
}

# The share of the sun's light that gets past the moon (1 with no eclipse;
# at totality nearly none: the sky turns to a dusk and the light falls with
# it). 1 with the moon off.
func settingsEclipseLight(settingsState: view SettingsState) ret Float {
  if settingsState.moon is false {
    ret 1.0
  }
  let covered: Float = settingsMoon(settingsState: settingsState).sunCovered
  ret 1.0 - 0.995 * Math.clamp(val: covered, low: 0.0, high: 1.0)
}

# Build the sky the panel is asking for. `data` is only read by the Hosek
# branch; a caller with no dataset can pass an empty one and still get Preetham.
func settingsBuildSky(
  settingsState: view SettingsState
  data: view HosekDataset
  turbidity: view Float
  groundAlbedo: view Float
) ret Sky {
  let dir: Vec3 = settingsSunDir(settingsState: settingsState)
  let col: Vec3 = settingsSunColor(settingsState: settingsState)
  # Both models are fitted only for a sun at or above the horizon, so the night
  # side is a fade rather than a different sky. Applied here, once, so the two
  # models darken together.
  # an eclipse darkens the sky with the light
  let day: Float = daylightFactorForDate(
    hour: settingsState.timeOfDay.hour
    dayOfYear: settingsState.timeOfDay.dayOfYear
    latitudeDeg: settingsState.latitude
  ) * settingsEclipseLight(settingsState: settingsState)
  # SOLID is the control case: a flat color, no gradient and no sun disc, so
  # anything still varying across the background is provably not the sky. It
  # still tracks the time of day — a flat sky that stayed bright at midnight
  # would be a second thing to explain rather than a simpler one.
  if settingsState.skyModel is SettingsSkyModel.solid {
    let base: Vec3 = Vec3.create(x: 0.10, y: 0.16, z: 0.26)
    let lit: Vec3 = Vec3.create(x: base.x * day, y: base.y * day, z: base.z * day)
    # the flat color is a display color; as the ambient light, in cd/m2
    let litLight: Vec3 = fromRelativeLight(value: lit)
    var flat: Sky = createSkyNone(
      light: Light3d {
        sunDir: dir
        sunColor: col
        ambSky: litLight
        ambGround: litLight
        exposure: 1.0
        clearColor: lit
      }
      clearColor: lit
    )
    flat.exposure = 1.0
    ret flat
  }
  if settingsState.skyModel is SettingsSkyModel.preetham {
    var pre: Sky = createSkyProcedural(sunDir: dir, sunColor: col, turbidity: turbidity)
    pre.exposure = day
    pre.sunDiscIntensity = pre.sunDiscIntensity * day
    settingsAddMoon(settingsState: settingsState, sky: pre, day: day)
    ret pre
  }
  if settingsState.skyModel is SettingsSkyModel.stylized {
    var painted: Sky = createSkyStylized(
      sunDir: dir
      sunColor: col
      zenith: Vec3.create(x: 0.16, y: 0.34, z: 0.62)
      horizon: Vec3.create(x: 0.74, y: 0.80, z: 0.72)
      bands: 3.0
    )
    painted.exposure = day
    painted.sunDiscIntensity = painted.sunDiscIntensity * day
    settingsAddMoon(settingsState: settingsState, sky: painted, day: day)
    ret painted
  }
  var hos: Sky = createSkyHosek(
    data: data
    sunDir: dir
    sunColor: col
    turbidity: turbidity
    groundAlbedo: groundAlbedo
  )
  hos.exposure = day
  hos.sunDiscIntensity = hos.sunDiscIntensity * day
  settingsAddMoon(settingsState: settingsState, sky: hos, day: day)
  ret hos
}

# ----- the moon and the key light --------------------------------------
#
# The moon (lib/Moon) on the settings' clock and place
func settingsMoon(settingsState: view SettingsState) ret MoonState {
  ret moonForDate(
    year: settingsState.timeOfDay.year
    dayOfYear: settingsState.timeOfDay.dayOfYear
    hour: settingsState.timeOfDay.hour
    latitudeDeg: settingsState.latitude
    longitudeDeg: settingsState.longitude
  )
}

# The moon's light now, 0..1: its phase, dimmed near the horizon, 0 while it
# is set or switched off. The light a game can ask "how dark is the night".
func settingsMoonLight(settingsState: view SettingsState) ret Float {
  if settingsState.moon is false {
    ret 0.0
  }
  ret moonLightLevel(moon: settingsMoon(settingsState: settingsState))
}

# How far into the night it is for the key light, 0..1: 0 while the sun is up,
# 1 once it is 3.5 degrees under the horizon. Always 0 with the moon off.
func settingsNightBlend(settingsState: view SettingsState) ret Float {
  if settingsState.moon is false {
    ret 0.0
  }
  let sunUp: Float = sunHeightSignedForDate(
    hour: settingsState.timeOfDay.hour
    dayOfYear: settingsState.timeOfDay.dayOfYear
    latitudeDeg: settingsState.latitude
  )
  let t: Float = Math.clamp(val: -sunUp / 0.06, low: 0.0, high: 1.0)
  ret t * t * (3.0 - 2.0 * t)
}

# The scene's one directional light: the sun by day; at night, with the moon
# on, the moon while it is up. The shadows follow it, so a moonlit night has
# moon shadows.
func settingsKeyLightDir(settingsState: view SettingsState) ret Vec3 {
  ret settingsKeyLightDirAt(settingsState: settingsState, hour: settingsState.timeOfDay.hour)
}

# ...at `hour` of the clock's day (the night blend is above 0 exactly while
# the sun is under the horizon)
func settingsKeyLightDirAt(settingsState: view SettingsState, hour: view Float) ret Vec3 {
  if settingsState.moon {
    let sunUp: Float = sunHeightSignedForDate(
      hour: hour
      dayOfYear: settingsState.timeOfDay.dayOfYear
      latitudeDeg: settingsState.latitude
    )
    if sunUp < 0.0 {
      let moon: MoonState = moonForDate(
        year: settingsState.timeOfDay.year
        dayOfYear: settingsState.timeOfDay.dayOfYear
        hour: hour
        latitudeDeg: settingsState.latitude
        longitudeDeg: settingsState.longitude
      )
      if moon.up > 0.0 {
        ret moon.direction
      }
    }
  }
  ret sunDirForDate(
    hour: hour
    dayOfYear: settingsState.timeOfDay.dayOfYear
    latitudeDeg: settingsState.latitude
  )
}

# The direction the shadows are cast from: the key light's, but while the
# clock runs at the hour rounded down to its step (app3d/TimeOfDay
# timeOfDayShadowHour: every 30 s of a 30 minute day), so the shadows do not
# crawl as the sun moves; paused, or the time set by hand, the light's own.
# The sky and the shading still follow the sun every frame.
func settingsShadowLightDir(settingsState: view SettingsState) ret Vec3 {
  if settingsState.playing is false or settingsState.animateTime is false or settingsState.timeDragging {
    ret settingsKeyLightDir(settingsState: settingsState)
  }
  ret settingsKeyLightDirAt(
    settingsState: settingsState
    hour: timeOfDayShadowHour(timeOfDay: settingsState.timeOfDay)
  )
}

# Its color: the sun's, crossing at dusk to the moon's cold light, which a
# full moon gives far more of than a crescent, and a moonless night almost
# none of. With the moon off it is the sun's color (and its dim night floor).
func settingsKeyLightColor(settingsState: view SettingsState) ret Vec3 {
  let sun: Vec3 = settingsSunColor(settingsState: settingsState)
  let blend: Float = settingsNightBlend(settingsState: settingsState)
  if blend <= 0.0 {
    ret sun
  }
  let level: Float = settingsMoonLight(settingsState: settingsState)
  let strength: Float = 0.03 + 0.42 * level
  # in lux, like the sun it takes over from
  let moonColor: Vec3 = fromRelativeLight(
    value: Vec3.create(x: 0.52 * strength, y: 0.60 * strength, z: 0.82 * strength)
  )
  ret Vec3.create(
    x: sun.x + (moonColor.x - sun.x) * blend
    y: sun.y + (moonColor.y - sun.y) * blend
    z: sun.z + (moonColor.z - sun.z) * blend
  )
}

# The moon in a sky: its disc, the moonlit night sky and its ambient light,
# which fade in as the day (`day`, the daylight factor) fades out
func settingsAddMoon(settingsState: view SettingsState, sky: mod Sky, day: view Float) {
  if settingsState.moon is false {
    ret
  }
  let moon: MoonState = settingsMoon(settingsState: settingsState)
  let level: Float = moonLightLevel(moon: moon)
  let night: Float = 1.0 - Math.clamp(val: day, low: 0.0, high: 1.0)
  let ambient: Float = (0.02 + 0.10 * level) * night
  sky.moonDir = moon.direction
  # its game size, its real size near the sun (an eclipse as it is)
  sky.moonAngularRadius = moon.drawRadius
  sky.sunCovered = moon.sunCovered
  # the earth's shadow on it (a lunar eclipse)
  sky.moonShadowDir = moon.shadowDirection
  sky.moonUmbra = moon.umbraRadius
  sky.moonPenumbra = moon.penumbraRadius
  # the disc's luminance, cd/m2
  sky.moonDiscIntensity = 2.5 * relativeLightUnit
  sky.nightLight = level
  # cd/m2
  sky.nightAmbient = fromRelativeLight(
    value: Vec3.create(x: 0.55 * ambient, y: 0.65 * ambient, z: ambient)
  )
  # the invented moons, each in its own size and color, as many as the
  # count asks beside the earth's
  sky.moons.clear()
  if settingsState.moonCount > 1 {
    loop let body: view MoonBody in inventedMoons() {
      if sky.moons.length >= Math.min(a: skyMoonsMax, b: settingsState.moonCount - 1) {
        break
      }
      let other: MoonState = moonForBody(
        body: body
        year: settingsState.timeOfDay.year
        dayOfYear: settingsState.timeOfDay.dayOfYear
        hour: settingsState.timeOfDay.hour
        latitudeDeg: settingsState.latitude
        longitudeDeg: settingsState.longitude
      )
      sky.moons.add(
        value: {
          direction: other.direction
          radius: other.drawRadius
          color: other.color
          intensity: sky.moonDiscIntensity * other.brightness
        }
      )
    }
  }
}
