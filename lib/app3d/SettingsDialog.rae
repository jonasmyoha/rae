# The shared settings SECTION: scene chooser, animation speed, toon shading,
# sky model and time of day.
#
# It mounts INSIDE the app's side panel, not as a floating dialog. A dialog
# holding the same controls the panel already showed meant two surfaces with one
# job, and the settings button had to explain which one it opened. Now there is
# one panel, and the button hides it.
#
# Same split as the other app3d components — this owns the CHROME
# (`scenes/settingsDialog.raescene`) and the BEHAVIOR, the app owns where it
# goes and what the values mean. An app mounts it into a host node, forwards
# actions, and reads the state back.
#
# WHY THE STATE LIVES HERE rather than in each app: 110 and 113 had drifted to
# different controls for the same ideas — 110's animation speed was a toggle,
# 113's was a percentage with Slower/Faster. One type means one behavior, and
# a new setting appears in both apps at once instead of being ported.
#
# Every control is present in every app, INCLUDING the scene buttons in 113,
# which has one scene. An app that cannot honor a setting says so by leaving it
# disabled; hiding it per app is how two dialogs drift back apart.

import Math
import String
import Sys
open ui/Ecs
open ui/Components
open ui/inputSystem/InputSystem
open app3d/UiShell
open app3d/Playback
open app3d/Slider
open app3d/SettingsSky
open Vec3
open SkyHosek
open Sky
open Calendar
open app3d/TimeOfDay
open Moon
open app3d/SettingsEclipse
open app3d/CameraBar
open ecs/Entity
open ui/SceneFile
open ui/SceneInstance
open ui/UiSystems

# Which sky model the dialog is asking for. Deliberately not SkyKind: that enum
# also carries `none` and `hdri`, which are not choices this dialog offers.
# Mapping to SkyKind is the app's job, because only the app knows what to build
# a Sky out of.
enum SettingsSkyModel { preetham, hosek, stylized, solid }

# The renderer's quality steps. For now only Ultra differs: it draws the 3D
# scene at the window's native resolution, pixel for pixel, with no dynamic
# resolution, on desktop and on phones alike (RendererQuality). Low, Mid and
# High are today's renderer (the device's resolution ceiling and the dynamic
# scale); they are here so later steps have their places.
enum SettingsQuality { low, mid, high, ultra }

# RAE_SUN_LUX=<lux> sets the walker sun's noon illuminance; otherwise
# settingsSunNoonLux
func settingsSunNoonLuxFromEnv() ret Float {
  let text: String = Sys.getEnv(name: "RAE_SUN_LUX")
  if text.length() > 0 and text.toFloat() > 0.0 {
    ret text.toFloat()
  }
  ret settingsSunNoonLux
}

# The exposure compensation's step and its limit either way (EV)
const settingsExposureStep: Float = 0.5

const settingsExposureLimit: Float = 4.0

# "+0.5", "-1.0", "+0.0"
func formatExposureCompensation(value: view Float) ret String {
  let tenths: Int = Math.round(x: Math.abs(value: value) * 10.0).toInt()
  var sign: String = "+"
  if value < -0.01 {
    sign = "-"
  }
  ret "{sign}{tenths / 10}.{tenths % 10}"
}

# RAE_QUALITY=low|mid|high|ultra starts at that step (screenshots, frame
# times); otherwise High
func settingsQualityFromEnv() ret SettingsQuality {
  let text: String = Sys.getEnv(name: "RAE_QUALITY")
  if text is "low" {
    ret SettingsQuality.low
  }
  if text is "mid" {
    ret SettingsQuality.mid
  }
  if text is "ultra" {
    ret SettingsQuality.ultra
  }
  ret SettingsQuality.high
}

# RAE_SKY=preetham|hosek|stylized|solid starts on that sky (screenshots);
# otherwise `fallback`
func settingsSkyFromEnv(fallback: view SettingsSkyModel) ret SettingsSkyModel {
  let text: String = Sys.getEnv(name: "RAE_SKY")
  if text is "preetham" {
    ret SettingsSkyModel.preetham
  }
  if text is "hosek" {
    ret SettingsSkyModel.hosek
  }
  if text is "stylized" {
    ret SettingsSkyModel.stylized
  }
  if text is "solid" {
    ret SettingsSkyModel.solid
  }
  ret fallback
}

# Preetham: the default sky across the examples — the analytic model, listed
# first here and first in the panel.
# Hosek-Wilkie: the fitted physical model.
# Stylized: a painted, three-band palette with the same time-of-day sun.
# A flat color. Not a lesser sky — it is the control case: with no gradient
# and no sun disc, anything still varying across the background is coming from
# somewhere else, which is how you tell a sky bug from a lighting bug.

# The panel node ids this component collapses. Named here rather than passed in:
# both apps author the same two nodes, and a shared component that takes them as
# arguments invites them to drift apart.
const settingsPanelNodeId: String = "SidePanel"

const settingsPanelBodyNodeId: String = "SidePanelBody"

const settingsHourMin: Float = 0.0

const settingsHourMax: Float = 24.0

type SettingsState {
  # Play/pause. Shared because both examples had one and they had drifted to
  # different words for the same control — 110 said Resume, 113 said Play.
  playing: Bool
  # Whether the panel BODY is showing. The button that toggles this stays
  # visible either way, or there would be no way to bring the panel back.
  open: Bool
  # 1..3. Kept even where an app has one scene, so the dialog does not need to
  # know which app it is in.
  scene: Int
  sceneCount: Int
  speed: Float
  toon: Bool
  taa: Bool  # anti-aliasing: TAA on, or (default) FXAA
  skyModel: SettingsSkyModel
  # The simulated clock (hour + date), app3d/TimeOfDay. The dialog owns it and
  # decides when it runs; the arithmetic lives there.
  timeOfDay: TimeOfDay
  # Drag state kept FLAT here (a Bool, not a nested Slider). Nested-field `mod`
  # write-back is reliable now (#762, test 707_nested_mod_writeback) so a nested
  # Slider would work too; the flat form is just what this dialog already uses.
  timeDragging: Bool
  # Whether the clock runs on its own. On by default: a sky model that responds
  # to the sun is best demonstrated moving, and the slider is still there to
  # take over.
  animateTime: Bool
  # Where on Earth, in degrees north. Together with the hour and the date this
  # DERIVES the sun, which is why there is no separate elevation control: one
  # would fight the clock for the same value.
  latitude: Float
  latDragging: Bool
  # ----- rendering toggles -------------------------------------------
  # A renderer you cannot A/B is a renderer you cannot debug. Shadows are here
  # because the shadow pass is APP-owned, so switching it off is simply not
  # doing the work. SSAO and TAA are deliberately absent: in the deferred path
  # their targets feed the composite, so skipping the pass leaves it sampling a
  # stale or empty texture — measured, that is a near-black frame for TAA and
  # 21k blacked-out samples for SSAO. They need real enable flags in the
  # renderer, not a skipped pass.
  shadows: Bool
  # The renderer's quality step (High: today's renderer)
  quality: SettingsQuality = SettingsQuality.high
  # The sun's illuminance at its highest, in lux (SettingsSky
  # settingsSunNoonLux; RAE_SUN_LUX=<lux> tries another, for screenshots)
  sunNoonLux: Float = settingsSunNoonLuxFromEnv()
  # The sun slider is being dragged
  luxDragging: Bool = false
  # The automatic exposure's compensation in EV (AutoExposure): + brighter,
  # - darker; steps of settingsExposureStep
  exposureCompensation: Float = 0.0
  # The camera follows the scene's brightness (AutoExposure), or stays at the
  # look the lights were tuned at. Each app starts it as it runs: the walker
  # on, the editor-panel examples off.
  autoExposure: Bool = false
  dateDragging: Bool
  # Where on Earth, in degrees east. It does not move the sun (the clock is
  # local solar time), but it turns that time into universal time, which is
  # what the moon's place in its month runs on (lib/Moon)
  longitude: Float
  lonDragging: Bool
  # The moon (lib/Moon): its disc and night sky, and its light at night. Off,
  # the night is what it was before the moon: the sun's dim floor light.
  moon: Bool
  # How many moons are in the sky: the earth's and up to three invented
  # ones beside it (lib/Moon inventedMoons; the -/+ buttons, RAE_MOONS=<n>)
  moonCount: Int = settingsMoonCountFromEnv()
  # The eclipse last jumped to (lib/Eclipses; -1 none): the eclipse buttons
  # step through the list, wrapping round
  eclipse: Int = -1
}

# `skyModel` is the app's default, not a shared one: 110 is the realistic scene
# and starts on Preetham, 113 is the stylized one and starts on Hosek. The panel
# switches either.
func createSettingsState(
  scene: view Int
  sceneCount: view Int
  speed: view Float
  toon: view Bool
  hour: view Float
  skyModel: SettingsSkyModel
) ret SettingsState {
  var settingsState: SettingsState = {
    playing: true
    # the panel starts closed; its edge tab opens it (RAE_SETTINGS_OPEN=1
    # starts it open, for screenshots)
    open: Sys.getEnv(name: "RAE_SETTINGS_OPEN") is "1"
    scene: scene
    sceneCount: sceneCount
    speed: speed
    toon: toon
    taa: false
    skyModel: skyModel
    quality: settingsQualityFromEnv()
    timeOfDay: createTimeOfDay(hour: hour)
    timeDragging: false
    animateTime: true
    latitude: skyDefaultLatitudeDeg
    latDragging: false
    shadows: true
    dateDragging: false
    longitude: moonDefaultLongitudeDeg
    lonDragging: false
    moon: true
  }
  # RAE_ECLIPSE=<n>: start at eclipse n (1-based) of lib/Eclipses
  let eclipseName: String = Sys.getEnv(name: "RAE_ECLIPSE")
  if eclipseName.length() > 0 {
    settingsJumpToEclipse(settingsState: settingsState, index: eclipseName.toInt() - 1)
  }
  ret settingsState
}

# Advance the clock. Returns true when the hour actually moved, so the caller
# rebuilds the sky only on frames that changed it.
#
# PLAY/PAUSE IS THE MASTER. Pausing stops the clock too, whatever the Animate
# time toggle says — pause means the app is not running, and a paused scene with
# the sun still sweeping across it is not paused in any sense a user would
# recognize. The toggle keeps its own value rather than being written to false,
# so resuming restores exactly what was set; nothing in the UI needs to show
# this, because the button already says the app is paused.
#
# A DRAG WINS. While the pointer owns the slider the clock holds still, or the
# two would fight over the same value and the handle would crawl away from
# where it was put.
func settingsAdvanceTime(settingsState: mod SettingsState, deltaTime: view Float) ret Bool {
  if settingsState.playing is false {
    ret false
  }
  if settingsState.animateTime is false {
    ret false
  }
  if settingsState.timeDragging {
    ret false
  }
  # The arithmetic — date and year roll, the refused negative delta — is the
  # clock's own (app3d/TimeOfDay).
  ret timeOfDayAdvance(timeOfDay: settingsState.timeOfDay, deltaTime: deltaTime)
}

# The date slider, over the real length of the current year.
func settingsUpdateDatePointer(
  settingsState: mod SettingsState
  world: view UiWorld
  uiSystems: view UiSystems
  input: view UiInput
) ret Bool {
  if settingsState.open is false {
    ret false
  }
  if settingsState.timeDragging or settingsState.latDragging or settingsState.lonDragging {
    ret false
  }
  var pressedInside: Bool = false
  if input.pointer.pressed {
    pressedInside = pointInNode(
      world: world
      uiSystems: uiSystems
      nodeId: "SettingsDateTrack"
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  settingsState.dateDragging = dragActive(
    wasDragging: settingsState.dateDragging
    pressedInside: pressedInside
    down: input.pointer.down
    released: input.pointer.released
  )
  if settingsState.dateDragging is false {
    ret false
  }
  let f: Float = fractionAcrossNode(
    world: world
    uiSystems: uiSystems
    nodeId: "SettingsDateTrack"
    x: input.pointer.x
  )
  let span: Int = daysInYear(year: settingsState.timeOfDay.year)
  var next: Int = 1 + (f * (span - 1).toFloat() + 0.5).toInt()
  next = clampDayOfYear(year: settingsState.timeOfDay.year, dayOfYear: next)
  if next is settingsState.timeOfDay.dayOfYear {
    ret false
  }
  settingsState.timeOfDay.dayOfYear = next
  ret true
}

# The date this state is on.
func settingsDate(settingsState: view SettingsState) ret CalendarDate {
  ret timeOfDayDate(timeOfDay: settingsState.timeOfDay)
}

# Mounted the way camera_bar is: the app authors a host node and owns where the
# dialog sits; the chrome comes from the shared scene.
func mountSettingsDialog(
  world: mod UiWorld
  uiSystems: mod UiSystems
  res: view Gpu2dUi
  hostNodeId: view String
) ret Bool {
  let host: EntityId = nodeEntityFor(world: world, nodeId: hostNodeId)
  if isNone(this: host) {
    ret false
  }
  let scene: Scene = loadSceneFile(path: "{app3dSceneDir()}settings_dialog.raescene")
  if scene.ok is false {
    ret false
  }
  let overrides: List(SceneOverride) = List.create(SceneOverride, cap: 0)
  let root: EntityId = mountSceneInstance(
    world: world
    uiSystems: uiSystems
    mountEntityId: host
    scene: scene
    overrides: overrides
  )
  if isNone(this: root) {
    ret false
  }
  runUiSystems(world: world, uiSystems: uiSystems, res: res)
  ret true
}

# 12:00, not 12.0 — an hours-and-minutes readout is what a time control means,
# and 6.5 on screen reads as a number rather than as half past six.
func formatHour(hour: view Float) ret String {
  var h: Float = hour
  if h < 0.0 {
    h = 0.0
  }
  if h >= 24.0 {
    h = 23.999
  }
  let whole: Int = h.toInt()
  let minutes: Int = ((h - whole.toFloat()) * 60.0).toInt()
  var mm: String = "{minutes}"
  if minutes < 10 {
    mm = "0{minutes}"
  }
  var hh: String = "{whole}"
  if whole < 10 {
    hh = "0{whole}"
  }
  ret "{hh}:{mm}"
}

# Apply one action id. Returns true when something changed, so the caller can
# rebuild only what the change affects. Unknown ids are ignored rather than
# treated as an error: the app forwards every action it sees, including its own.
func settingsHandleAction(settingsState: mod SettingsState, actionId: view String) ret Bool {
  # One action, and it TOGGLES: the button shows and hides the panel rather
  # than opening a second surface.
  if actionId is "settings.open" {
    settingsState.open = settingsState.open is false
    ret true
  }
  if actionId is "settings.playback" {
    settingsState.playing = settingsState.playing is false
    ret true
  }
  if actionId is "settings.time.animate" {
    settingsState.animateTime = settingsState.animateTime is false
    ret true
  }
  if actionId is "settings.toon" {
    settingsState.toon = settingsState.toon is false
    ret true
  }
  if actionId is "settings.taa" {
    settingsState.taa = settingsState.taa is false
    ret true
  }
  if actionId is "settings.anim.slower" {
    settingsState.speed = nextSpeed(current: settingsState.speed, up: false)
    ret true
  }
  if actionId is "settings.anim.faster" {
    settingsState.speed = nextSpeed(current: settingsState.speed, up: true)
    ret true
  }
  if actionId is "settings.exposure.auto" {
    settingsState.autoExposure = settingsState.autoExposure is false
    ret true
  }
  if actionId is "settings.exposure.darker" {
    settingsState.exposureCompensation = Math.max(
      a: settingsState.exposureCompensation - settingsExposureStep
      b: -settingsExposureLimit
    )
    ret true
  }
  if actionId is "settings.exposure.brighter" {
    settingsState.exposureCompensation = Math.min(
      a: settingsState.exposureCompensation + settingsExposureStep
      b: settingsExposureLimit
    )
    ret true
  }
  if actionId is "settings.quality.low" {
    settingsState.quality = SettingsQuality.low
    ret true
  }
  if actionId is "settings.quality.mid" {
    settingsState.quality = SettingsQuality.mid
    ret true
  }
  if actionId is "settings.quality.high" {
    settingsState.quality = SettingsQuality.high
    ret true
  }
  if actionId is "settings.quality.ultra" {
    settingsState.quality = SettingsQuality.ultra
    ret true
  }
  if actionId is "settings.sky.hosek" {
    settingsState.skyModel = SettingsSkyModel.hosek
    ret true
  }
  if actionId is "settings.sky.preetham" {
    settingsState.skyModel = SettingsSkyModel.preetham
    ret true
  }
  if actionId is "settings.sky.stylized" {
    settingsState.skyModel = SettingsSkyModel.stylized
    ret true
  }
  if actionId is "settings.sky.solid" {
    settingsState.skyModel = SettingsSkyModel.solid
    ret true
  }
  if actionId is "settings.render.shadows" {
    settingsState.shadows = settingsState.shadows is false
    ret true
  }
  if actionId is "settings.moon" {
    settingsState.moon = settingsState.moon is false
    ret true
  }
  if settingsMoonsAction(settingsState: settingsState, actionId: actionId) {
    ret true
  }
  # the eclipse list: the next one (the first from none), the one before;
  # both wrap round
  if actionId is "settings.eclipse.next" {
    settingsJumpToEclipse(settingsState: settingsState, index: settingsState.eclipse + 1)
    ret true
  }
  if actionId is "settings.eclipse.previous" {
    var before: Int = settingsState.eclipse - 1
    if settingsState.eclipse < 0 {
      before = -1
    }
    settingsJumpToEclipse(settingsState: settingsState, index: before)
    ret true
  }
  # Scene selection is clamped to what the app actually has, so the buttons can
  # exist in an app with one scene without being able to select a second.
  if actionId is "settings.scene.1" {
    ret settingsSelectScene(settingsState: settingsState, scene: 1)
  }
  if actionId is "settings.scene.2" {
    ret settingsSelectScene(settingsState: settingsState, scene: 2)
  }
  if actionId is "settings.scene.3" {
    ret settingsSelectScene(settingsState: settingsState, scene: 3)
  }
  ret false
}

func settingsSelectScene(settingsState: mod SettingsState, scene: view Int) ret Bool {
  if scene > settingsState.sceneCount {
    ret false
  }
  if settingsState.scene is scene {
    ret false
  }
  settingsState.scene = scene
  ret true
}

# Pointer half: drag the time slider. Separate from the action half because
# actions arrive as discrete events while a drag is a per-frame sample.
func settingsUpdatePointer(
  settingsState: mod SettingsState
  world: view UiWorld
  uiSystems: view UiSystems
  input: view UiInput
) ret Bool {
  if settingsState.open is false {
    ret false
  }
  # A press anywhere on the track starts a drag and jumps the handle there: the
  # handle is small and the track is the affordance.
  var pressedInside: Bool = false
  if input.pointer.pressed {
    pressedInside = pointInNode(
      world: world
      uiSystems: uiSystems
      nodeId: "SettingsTimeTrack"
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  settingsState.timeDragging = dragActive(
    wasDragging: settingsState.timeDragging
    pressedInside: pressedInside
    down: input.pointer.down
    released: input.pointer.released
  )
  if settingsState.timeDragging is false {
    ret false
  }
  let f: Float = fractionAcrossNode(
    world: world
    uiSystems: uiSystems
    nodeId: "SettingsTimeTrack"
    x: input.pointer.x
  )
  let next: Float = settingsHourMin + f * (settingsHourMax - settingsHourMin)
  if next is settingsState.timeOfDay.hour {
    ret false
  }
  settingsState.timeOfDay.hour = next
  ret true
}

# The latitude slider, the same shape as the time one. Separate function rather
# than a second block inside settingsUpdatePointer so that neither drag can
# swallow the other's press: whichever track was hit owns the pointer.
func settingsUpdateLatitudePointer(
  settingsState: mod SettingsState
  world: view UiWorld
  uiSystems: view UiSystems
  input: view UiInput
) ret Bool {
  if settingsState.open is false {
    ret false
  }
  if settingsState.timeDragging or settingsState.lonDragging {
    ret false
  }
  var pressedInside: Bool = false
  if input.pointer.pressed {
    pressedInside = pointInNode(
      world: world
      uiSystems: uiSystems
      nodeId: "SettingsLatTrack"
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  settingsState.latDragging = dragActive(
    wasDragging: settingsState.latDragging
    pressedInside: pressedInside
    down: input.pointer.down
    released: input.pointer.released
  )
  if settingsState.latDragging is false {
    ret false
  }
  let f: Float = fractionAcrossNode(
    world: world
    uiSystems: uiSystems
    nodeId: "SettingsLatTrack"
    x: input.pointer.x
  )
  let next: Float = skyLatitudeMin + f * (skyLatitudeMax - skyLatitudeMin)
  if next is settingsState.latitude {
    ret false
  }
  settingsState.latitude = next
  ret true
}

# The sun slider's range (lux at noon): even in ratio, not in steps, so a
# dim sun and a bright one get as much of the track
const settingsSunLuxMin: Float = 5000.0

const settingsSunLuxMax: Float = 150000.0

# Where `lux` sits along the sun slider, 0..1, and back
func sunLuxFraction(lux: view Float) ret Float {
  let clamped: Float = Math.clamp(val: lux, low: settingsSunLuxMin, high: settingsSunLuxMax)
  ret Math.naturalLog(x: clamped / settingsSunLuxMin) / Math.naturalLog(
    x: settingsSunLuxMax / settingsSunLuxMin
  )
}

func sunLuxAt(fraction: view Float) ret Float {
  let lux: Float = settingsSunLuxMin * Math.pow(
    base: settingsSunLuxMax / settingsSunLuxMin
    exp: Math.clamp(val: fraction, low: 0.0, high: 1.0)
  )
  # to the nearest 1,000 lux
  ret Math.round(x: lux / 1000.0) * 1000.0
}

# "100,000"
func formatLux(lux: view Float) ret String {
  let whole: Int = Math.round(x: lux).toInt()
  let thousands: Int = whole / 1000
  let rest: Int = whole % 1000
  if thousands is 0 {
    ret "{rest}"
  }
  var restText: String = "{rest}"
  if rest < 10 {
    restText = "00{rest}"
  } else if rest < 100 {
    restText = "0{rest}"
  }
  ret "{thousands},{restText}"
}

# The sun slider (the sun's illuminance at noon, settingsState.sunNoonLux),
# the same shape as the latitude one
func settingsUpdateSunLuxPointer(
  settingsState: mod SettingsState
  world: view UiWorld
  uiSystems: view UiSystems
  input: view UiInput
) ret Bool {
  if settingsState.open is false {
    ret false
  }
  if settingsState.timeDragging or settingsState.latDragging or settingsState.lonDragging or settingsState.dateDragging {
    ret false
  }
  var pressedInside: Bool = false
  if input.pointer.pressed {
    pressedInside = pointInNode(
      world: world
      uiSystems: uiSystems
      nodeId: "SettingsSunLuxTrack"
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  settingsState.luxDragging = dragActive(
    wasDragging: settingsState.luxDragging
    pressedInside: pressedInside
    down: input.pointer.down
    released: input.pointer.released
  )
  if settingsState.luxDragging is false {
    ret false
  }
  let next: Float = sunLuxAt(fraction: fractionAcrossNode(
    world: world
    uiSystems: uiSystems
    nodeId: "SettingsSunLuxTrack"
    x: input.pointer.x
  ))
  if next is settingsState.sunNoonLux {
    ret false
  }
  settingsState.sunNoonLux = next
  ret true
}

# The longitude slider, the same shape as the latitude one: -180..180 east
func settingsUpdateLongitudePointer(
  settingsState: mod SettingsState
  world: view UiWorld
  uiSystems: view UiSystems
  input: view UiInput
) ret Bool {
  if settingsState.open is false {
    ret false
  }
  if settingsState.timeDragging or settingsState.latDragging {
    ret false
  }
  var pressedInside: Bool = false
  if input.pointer.pressed {
    pressedInside = pointInNode(
      world: world
      uiSystems: uiSystems
      nodeId: "SettingsLonTrack"
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  settingsState.lonDragging = dragActive(
    wasDragging: settingsState.lonDragging
    pressedInside: pressedInside
    down: input.pointer.down
    released: input.pointer.released
  )
  if settingsState.lonDragging is false {
    ret false
  }
  let f: Float = fractionAcrossNode(
    world: world
    uiSystems: uiSystems
    nodeId: "SettingsLonTrack"
    x: input.pointer.x
  )
  let next: Float = -180.0 + f * 360.0
  if next is settingsState.longitude {
    ret false
  }
  settingsState.longitude = next
  ret true
}

# 24.9E, as formatLatitude reads a latitude
func formatLongitude(longitudeDeg: view Float) ret String {
  var lon: Float = longitudeDeg
  var suffix: String = "E"
  if lon < 0.0 {
    lon = -lon
    suffix = "W"
  }
  let tenths: Int = (lon * 10.0 + 0.5).toInt()
  ret "{tenths / 10}.{tenths % 10}{suffix}"
}

# 60.2N, not 60.17 — a hemisphere letter is how a latitude is read, and the
# second decimal is noise on a slider a person drags.
func formatLatitude(latitudeDeg: view Float) ret String {
  var lat: Float = latitudeDeg
  var suffix: String = "N"
  if lat < 0.0 {
    lat = 0.0 - lat
    suffix = "S"
  }
  let tenths: Int = (lat * 10.0 + 0.5).toInt()
  let whole: Int = tenths / 10
  let frac: Int = tenths - whole * 10
  ret "{whole}.{frac}{suffix}"
}

# Show or hide the panel BODY, and collapse the panel itself with it.
#
# Hiding the body alone left the panel background at its authored full height —
# an empty card down the side of the screen with one button at the top. The
# container has to change its sizing policy too: Hug measures from the ACTIVE
# children plus padding, so with the body deactivated the panel shrinks to the
# settings button, which is the whole point of a button that hides a panel.
#
# Shared rather than repeated in each app: both examples had the setNodeActive
# call, and both would have needed the same second line.
func applySettingsPanelOpen(world: mod UiWorld, open: view Bool) {
  setNodeActive(world: world, nodeId: settingsPanelBodyNodeId, value: open)
  setNodeHeightMode(world: world, nodeId: settingsPanelNodeId, hug: open is false)
}

# Push the state onto the mounted chrome. Cheap enough to call whenever
# something changed; every write underneath is guarded against writing an
# unchanged value.
func settingsApplyToWorld(
  settingsState: view SettingsState
  world: mod UiWorld
  uiSystems: mod UiSystems
) {
  var playLabel: String = "Pause"
  if settingsState.playing is false {
    playLabel = "Play"
  }
  setNodeText(world: world, nodeId: "SettingsPlayLabel", value: playLabel)
  setNodeFillSlot(
    world: world
    nodeId: "SettingsPlayButton"
    slot: settingsSlotFor(on: settingsState.playing is false)
  )
  let pct: Int = speedPercent(value: settingsState.speed)
  setNodeText(world: world, nodeId: "SettingsSpeedRow", value: "Animation speed {pct}%")
  setNodeText(
    world: world
    nodeId: "SettingsExposureLabel"
    value: "Exposure {formatExposureCompensation(value: settingsState.exposureCompensation)} EV"
  )
  setNodeText(
    world: world
    nodeId: "SettingsTimeLabel"
    value: "Time of day {formatHour(hour: settingsState.timeOfDay.hour)} {formatCalendarDate(
      date: settingsDate(settingsState: settingsState)
    )}"
  )
  setNodeText(
    world: world
    nodeId: "SettingsLatLabel"
    value: "Latitude {formatLatitude(latitudeDeg: settingsState.latitude)}"
  )
  setNodeText(
    world: world
    nodeId: "SettingsSunLuxLabel"
    value: "Sun {formatLux(lux: settingsState.sunNoonLux)} lux at noon"
  )
  setNodeText(
    world: world
    nodeId: "SettingsLonLabel"
    value: "Longitude {formatLongitude(longitudeDeg: settingsState.longitude)}"
  )
  setNodeText(
    world: world
    nodeId: "SettingsEclipseLabel"
    value: settingsEclipseTitle(settingsState: settingsState)
  )
  setNodeText(
    world: world
    nodeId: "SettingsEclipseDetail"
    value: settingsEclipseDetail(settingsState: settingsState)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsMoonButton"
    slot: settingsSlotFor(on: settingsState.moon)
  )
  setNodeText(
    world: world
    nodeId: "SettingsMoonsLabel"
    value: settingsMoonsTitle(settingsState: settingsState)
  )

  setNodeFillSlot(
    world: world
    nodeId: "SettingsToonButton"
    slot: settingsSlotFor(on: settingsState.toon)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsTaaButton"
    slot: settingsSlotFor(on: settingsState.taa)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsAnimTimeButton"
    slot: settingsSlotFor(on: settingsState.animateTime)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsAutoExposureButton"
    slot: settingsSlotFor(on: settingsState.autoExposure)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsQualityLow"
    slot: settingsSlotFor(on: settingsState.quality is SettingsQuality.low)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsQualityMid"
    slot: settingsSlotFor(on: settingsState.quality is SettingsQuality.mid)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsQualityHigh"
    slot: settingsSlotFor(on: settingsState.quality is SettingsQuality.high)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsQualityUltra"
    slot: settingsSlotFor(on: settingsState.quality is SettingsQuality.ultra)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsSkyHosek"
    slot: settingsSlotFor(on: settingsState.skyModel is SettingsSkyModel.hosek)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsSkyPreetham"
    slot: settingsSlotFor(on: settingsState.skyModel is SettingsSkyModel.preetham)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsSkyStylized"
    slot: settingsSlotFor(on: settingsState.skyModel is SettingsSkyModel.stylized)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsSkySolid"
    slot: settingsSlotFor(on: settingsState.skyModel is SettingsSkyModel.solid)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsShadowsButton"
    slot: settingsSlotFor(on: settingsState.shadows)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsScene1"
    slot: settingsSlotFor(on: settingsState.scene is 1)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsScene2"
    slot: settingsSlotFor(on: settingsState.scene is 2)
  )
  setNodeFillSlot(
    world: world
    nodeId: "SettingsScene3"
    slot: settingsSlotFor(on: settingsState.scene is 3)
  )

  # Two drawn parts: the track, and the knob that travels along it. A filled
  # portion made it read as a progress bar, which is a different control.
  let f: Float = (settingsState.timeOfDay.hour - settingsHourMin) / (settingsHourMax - settingsHourMin)
  centerNodeAtFraction(
    world: world
    uiSystems: uiSystems
    trackId: "SettingsTimeTrack"
    handleId: "SettingsTimeHandle"
    fraction: f
  )
  let dateSpan: Int = daysInYear(year: settingsState.timeOfDay.year) - 1
  var dateF: Float = 0.0
  if dateSpan > 0 {
    dateF = (settingsState.timeOfDay.dayOfYear - 1).toFloat() / dateSpan.toFloat()
  }
  centerNodeAtFraction(
    world: world
    uiSystems: uiSystems
    trackId: "SettingsDateTrack"
    handleId: "SettingsDateHandle"
    fraction: dateF
  )
  let latF: Float = (settingsState.latitude - skyLatitudeMin) / (skyLatitudeMax - skyLatitudeMin)
  centerNodeAtFraction(
    world: world
    uiSystems: uiSystems
    trackId: "SettingsLatTrack"
    handleId: "SettingsLatHandle"
    fraction: latF
  )
  centerNodeAtFraction(
    world: world
    uiSystems: uiSystems
    trackId: "SettingsLonTrack"
    handleId: "SettingsLonHandle"
    fraction: (settingsState.longitude + 180.0) / 360.0
  )
  centerNodeAtFraction(
    world: world
    uiSystems: uiSystems
    trackId: "SettingsSunLuxTrack"
    handleId: "SettingsSunLuxHandle"
    fraction: sunLuxFraction(lux: settingsState.sunNoonLux)
  )
}

# The palette slots the shared components are allowed to name (see
# lib/app3d/README.md — the vocabulary is closed and anything else paints
# magenta).
func settingsSlotFor(on: view Bool) ret String {
  if on {
    ret "accent"
  }
  ret "surfaceAlt"
}
