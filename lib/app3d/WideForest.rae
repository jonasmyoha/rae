# app3d/WideForest — the walker's wide forest world (143): a terrain that is
# not an island, and tens of thousands of trees (its terrain's treeSet) over a
# square wideForestExtent meters on a side round the origin, planted ONCE at
# startup into the WalkerTerrain's PropField. The field sorts them into
# cells, and each frame only the cells and trees near and in view are
# gathered, each tree at its level of detail, into one instanced draw per
# species, level and part. A tree is a placement, not an entity; the trees
# nearest the walker get their Box3D trunks from a fixed pool
# (WalkerPhysics' trunk pool), so physics costs the same however big the
# forest is.
#
# The spots are a jittered grid (wideForestSpacing apart): a spot gets a tree
# when the forest-density noise says forest there (dense woods, thin woods
# and open meadows, each a few hundred meters across), it is grassy land
# (not lake, beach or bare rock) and it is outside the spawn clearing. The
# species come in stands (treeSets/TreeSet.treeSpeciesAt).
import Math
import Noise
import Vec3
open Scene3d
open WorldBiome
open treeSets/TreeSet
open app3d/PropField
open app3d/WalkerTerrain

# The forest world is not an island. The lib's biome field fades the land out
# into the sea at its island radius; a radius far past anywhere the walker can
# go turns that off, so the noise terrain (hills, valleys, lakes) goes on.
const wideForestWorldRadius: Float = 1000000.0

# The side of the forested square (m), round the origin
const wideForestExtent: Float = 1200.0

# The grid the spots are jittered on (m): the crowns (4 to 7 m wide) overlap
const wideForestSpacing: Float = 3.5

# The grass a tree wants under it: less than the small props, so woods reach
# onto drier ground, but never the beach or bare rock
const wideForestGrassMin: Float = 0.12

# No tree grows this close (m) to the spawn, where the cube stacks stand
const wideForestSpawnClearing: Float = 11.0

# The stand of hand-made T02 trees (app3d/ReferenceTree, when the app asks
# for it): a patch this far ahead of the spawn (m, +y) and this wide, where
# the forest's own trees do not grow; a T02 tree takes a grid spot there
# with this chance (the crowns are about 5 m wide, the grid 3.5 m)
const referenceStandAhead: Float = 30.0

const referenceStandRadius: Float = 22.0

const referenceStandChance: Float = 0.3

func wideForestBiome() ret BiomeConfig {
  var config: BiomeConfig = defaultBiomeConfig()
  config.islandRadius = wideForestWorldRadius
  ret config
}

# The forest's PropField: the forested square in 40 m cells, at most 1024
# trees per batch; the sparser crowns from 60 m, billboards from 140 m
# (treeSets/TreeSetKinds.addTreeSetKinds), and past that far billboards on the far
# ground out to 1,800 m (app3d/FarSprites; the whole forest from its middle)
func wideForestSettings() ret ForestFieldSettings {
  ret ForestFieldSettings {
    extent: wideForestExtent
    cellSize: 40.0
    batchLimit: 1024
    midDistance: 60.0
    farDistance: 140.0
    farReach: 1660.0
  }
}

# How much forest grows at (x, y), 0 to 1: value noise about 90 m across,
# so the forest is a patchwork of woods and meadows
func wideForestDensity(x: view Float, y: view Float) ret Float {
  ret Noise.value2(x: x / 90.0, y: y / 90.0, seed: 401)
}

# Plant the forest around a spawn at (spawnX, spawnY). The number of trees.
func plantWideForest(
  terrainSystem: mod WalkerTerrain
  spawnX: view Float
  spawnY: view Float
) ret Int {
  let side: Int = (wideForestExtent / wideForestSpacing).toInt()
  let origin: Float = wideForestExtent * -0.5
  var planted: Int = 0
  loop var row: Int = 0, row < side, ++row {
    loop var column: Int = 0, column < side, ++column {
      let x: Float = origin + (column.toFloat() + 0.5 + (Noise.hash2(x: column, y: row, seed: 811) - 0.5) * 0.8) * wideForestSpacing
      let y: Float = origin + (row.toFloat() + 0.5 + (Noise.hash2(x: column, y: row, seed: 812) - 0.5) * 0.8) * wideForestSpacing
      # Thinner where the density is low: a spot is kept with the chance the
      # density gives, so meadows keep only the odd lone tree
      let chance: Float = Math.min(
        a: Math.max(a: (wideForestDensity(x: x, y: y) - 0.3) * 3.0, b: 0.02)
        b: 1.0
      )
      if Noise.hash2(x: column, y: row, seed: 813) > chance {
        continue
      }
      let gapX: Float = x - spawnX
      let gapY: Float = y - spawnY
      if gapX * gapX + gapY * gapY < wideForestSpawnClearing * wideForestSpawnClearing {
        continue
      }
      if worldPropAllowed(
        x: x
        y: y
        minGrass: wideForestGrassMin
        cfg: terrainSystem.biome
      ) is false {
        continue
      }
      if terrainSystem.referenceStandOn {
        let standX: Float = x - terrainSystem.referenceStandX
        let standY: Float = y - terrainSystem.referenceStandY
        if standX * standX + standY * standY < referenceStandRadius * referenceStandRadius {
          # the stand's patch: a T02 tree now and then, never the forest's
          if Noise.hash2(x: column, y: row, seed: 815) < referenceStandChance {
            terrainSystem.referenceStand.add(value: x)
            terrainSystem.referenceStand.add(value: y)
            terrainSystem.referenceStand.add(
              value: walkerTerrainHeight(terrainSystem: terrainSystem, x: x, y: y) - 0.05
            )
            terrainSystem.referenceStand.add(
              value: Noise.hash2(x: column, y: row, seed: 814) * 6.2831853
            )
            terrainSystem.referenceStand.add(
              value: 0.85 + 0.25 * Noise.hash2(x: column, y: row, seed: 816)
            )
          }
          continue
        }
      }
      let species: Int = treeSpeciesAt(
        treeSet: terrainSystem.treeSet
        x: x
        y: y
        number: planted
      )
      addPropPlacement(
        field: terrainSystem.forest
        placement: {
          kind: species
          position: Vec3.create(
            x: x
            y: y
            z: walkerTerrainHeight(terrainSystem: terrainSystem, x: x, y: y) - 0.05
          )
          yaw: Noise.hash2(x: column, y: row, seed: 814) * 6.2831853
          scale: treeScaleAt(treeSet: terrainSystem.treeSet, species: species, number: planted)
        }
      )
      planted = planted + 1
    }
  }
  finishPropField(field: terrainSystem.forest)
  fillFarTrees(terrainSystem: terrainSystem)
  ret planted
}
