# app3d/SettingsClouds — the walkers' clouds (lib/CloudTier,
# docs/cloud-rendering-research.md §8.4) from the settings panel's Clouds
# group: an exact renderer (off, the 2D layer, the slab, volumetric; the 2D
# layer at start) or Auto, which takes the game's ceiling, the device it runs
# on, the quality setting's tier, and each frame the measured fallback,
# fed by the cloud passes' own GPU time (lib/CloudTiming, their timestamps,
# on every device) and the OS thermal state. The tier it settles on goes to the renderer
# (setCloudTier).
import Sys
import Device
open CloudTier
open RendererDeferred
open CloudTiming
open app3d/SettingsDialog
open app3d/RenderScale
open ui/Ecs
open app3d/UiShell

# The walkers' clouds (an app resource, on the render state)
type WalkerClouds {
  settings: CloudSettings
  control: CloudTierControl
  # the pass timing samples already read, the last GPU time measured (-1
  # none yet) and the status line shown
  seenSamples: Int
  lastMicroseconds: Int = -1
  status: String = ""
}

# A phone or a tablet, or a browser on one (a coarse main pointer): the
# device question is asked at run time
func walkerCloudDeviceMobile() ret Bool {
  if Target.isMobileOs {
    ret true
  }
  when Target.os is Os.web {
    ret Device.primaryPointer() is Pointer.coarse
  } else {
    ret false
  }
}

# The tier a quality step allows: Low the layer, Mid the slab, High and
# Ultra the game's ceiling (lib/CloudTier cloudTierForQuality)
func settingsQualityCloudTier(
  quality: view SettingsQuality
  maxTier: view CloudTier
) ret CloudTier {
  var level: Int = 3
  if quality is SettingsQuality.low {
    level = 0
  } else if quality is SettingsQuality.mid {
    level = 1
  } else if quality is SettingsQuality.high {
    level = 2
  }
  ret cloudTierForQuality(level: level, maxTier: maxTier)
}

# The volumetric tier's march steps a quality step asks for: 64 at Ultra
# (at the native resolution; 96 cost 7.4 ms on a Mac), 48 below
# (RAE_CLOUD_STEPS overrides, for measuring)
func settingsQualityCloudSteps(quality: view SettingsQuality) ret Int {
  let forced: Int = Sys.getEnv(name: "RAE_CLOUD_STEPS").toInt()
  if forced > 0 {
    ret forced
  }
  if quality is SettingsQuality.ultra {
    ret 64
  }
  ret 48
}

# The walkers' clouds at the start: the game's ceiling `settings`, this
# device, the quality setting, or RAE_CLOUD_TIER (logged once)
# The walkers' clouds at the start: the game's ceiling `settings`, this
# device, the quality setting and the panel's choice `options` (an exact
# tier, or Auto; logged once)
func createWalkerClouds(
  settings: view CloudSettings
  quality: view SettingsQuality
  options: view CloudOptions
) ret WalkerClouds {
  var forced: String = ""
  if not options.auto {
    forced = "{options.tier}"
  }
  ret WalkerClouds {
    settings: settings
    control: createCloudTierControl(
      settings: settings
      mobile: walkerCloudDeviceMobile()
      qualityTier: settingsQualityCloudTier(quality: quality, maxTier: settings.maxTier)
      forcedName: forced
    )
    seenSamples: 0
    status: ""
  }
}

# The clouds' own GPU time in the newest sample of their pass timestamps
# (lib/CloudTiming), once per sample (-1 when there is no new one, or the
# GPU has no timestamps)
func walkerCloudMicroseconds(clouds: mod WalkerClouds, renderer: view DeferredRenderer) ret Int {
  let cloudTiming: view CloudTiming = renderer.passes.targets.cloudShadow.timing
  if cloudTiming.samples is clouds.seenSamples {
    ret -1
  }
  clouds.seenSamples = cloudTiming.samples
  # under a profile's timing (RAE_GPU_PASS_TIMING, RAE_FRAME_TIMING), a line
  # every 60 samples: the clouds' time and each pass's
  if cloudTiming.samples % 15 is 1 and (Sys.getEnv(name: "RAE_GPU_PASS_TIMING").length() > 0 or Sys.getEnv(
    name: "RAE_FRAME_TIMING"
  ).length() > 0) {
    var passes: String = ""
    loop var i: Int = 0, i < cloudTiming.cloudPassTimes.length, ++i {
      passes = "{passes} {cloudTiming.cloudPassTimes.copyAtDefault(index: i)}"
    }
    log(
      "[clouds gpu] {clouds.control.tier}: {cloudTiming.lastMicroseconds} us (passes us:{passes})"
    )
  }
  ret cloudTiming.lastMicroseconds
}

# One frame: the panel's choice (an exact tier, or Auto with the quality's
# ceiling and the measured fallback), the tier, the steps and the shadows to
# the renderer, and the Clouds group's status line in `world`
func walkerCloudsFrame(
  clouds: mod WalkerClouds
  renderer: mod DeferredRenderer
  quality: view SettingsQuality
  options: view CloudOptions
  world: mod UiWorld
) {
  let chosen: Bool = cloudTierUseOptions(
    control: clouds.control
    options: options
    qualityTier: settingsQualityCloudTier(quality: quality, maxTier: clouds.settings.maxTier)
  )
  let measured: Int = walkerCloudMicroseconds(clouds: clouds, renderer: renderer)
  if measured >= 0 {
    clouds.lastMicroseconds = measured
  }
  let fellBack: Bool = cloudTierFrame(
    control: clouds.control
    cloudMicroseconds: measured
    thermal: thermalState()
  )
  setCloudTier(renderer: renderer, tier: clouds.control.tier)
  setCloudSteps(renderer: renderer, steps: options.steps)
  setCloudShadows(renderer: renderer, on: options.shadows)
  let status: String = walkerCloudStatus(clouds: clouds, options: options)
  if not (status is clouds.status) {
    clouds.status = status
    setNodeText(world: world, nodeId: "SettingsCloudStatus", value: status)
  }
}

# The Clouds group's status line: the tier drawn, how it was chosen, and the
# cloud passes' last GPU time ("Drawing slab (auto, fell back), 2.2 ms")
func walkerCloudStatus(clouds: view WalkerClouds, options: view CloudOptions) ret String {
  var how: String = ""
  if options.auto {
    how = " (auto)"
    if cloudTierRank(tier: clouds.control.tier) < cloudTierRank(tier: clouds.control.ceiling) {
      how = " (auto, fell back)"
    }
  } else if not (clouds.control.tier is options.tier) {
    how = " (not built: the highest)"
  }
  var cost: String = ""
  if clouds.lastMicroseconds >= 0 {
    let tenths: Int = (clouds.lastMicroseconds + 50) / 100
    cost = ", {tenths / 10}.{tenths % 10} ms"
  }
  ret "Drawing {walkerCloudTierLabel(tier: clouds.control.tier)}{how}{cost}"
}

# A tier as the panel's buttons name it
func walkerCloudTierLabel(tier: view CloudTier) ret String {
  if tier is CloudTier.layer {
    ret "2D layer"
  }
  ret "{tier}"
}
