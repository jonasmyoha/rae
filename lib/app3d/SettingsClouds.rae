# app3d/SettingsClouds — the walkers' cloud tier (lib/CloudTier,
# docs/cloud-rendering-research.md §8.4): the game's ceiling, the device it
# runs on, the quality setting's tier, and each frame the measured fallback,
# fed by the cloud passes' own GPU time (lib/CloudTiming, their timestamps,
# on every device) and the OS thermal state. The tier it settles on goes to the renderer
# (setCloudTier).
import Sys
import Device
open CloudTier
open RendererDeferred
open CloudTiming
open app3d/SettingsDialog
open app3d/RenderScale

# The walkers' clouds (an app resource, on the render state)
type WalkerClouds {
  settings: CloudSettings
  control: CloudTierControl
  # the pass timing samples already read
  seenSamples: Int
}

# A phone or a tablet, or a browser on one (a coarse main pointer): the
# device question is asked at run time
func walkerCloudDeviceMobile() ret Bool {
  if Target.isMobileOs {
    ret true
  }
  when Target.os is Os.web {
    ret Device.primaryPointer() is Pointer.coarse
  } else {
    ret false
  }
}

# The tier a quality step allows: Low the layer, Mid the slab, High and
# Ultra the game's ceiling (lib/CloudTier cloudTierForQuality)
func settingsQualityCloudTier(
  quality: view SettingsQuality
  maxTier: view CloudTier
) ret CloudTier {
  var level: Int = 3
  if quality is SettingsQuality.low {
    level = 0
  } else if quality is SettingsQuality.mid {
    level = 1
  } else if quality is SettingsQuality.high {
    level = 2
  }
  ret cloudTierForQuality(level: level, maxTier: maxTier)
}

# The walkers' clouds at the start: the game's ceiling `settings`, this
# device, the quality setting, or RAE_CLOUD_TIER (logged once)
func createWalkerClouds(
  settings: view CloudSettings
  quality: view SettingsQuality
) ret WalkerClouds {
  ret WalkerClouds {
    settings: settings
    control: createCloudTierControl(
      settings: settings
      mobile: walkerCloudDeviceMobile()
      qualityTier: settingsQualityCloudTier(quality: quality, maxTier: settings.maxTier)
      forcedName: Sys.getEnv(name: "RAE_CLOUD_TIER")
    )
    seenSamples: 0
  }
}

# The clouds' own GPU time in the newest sample of their pass timestamps
# (lib/CloudTiming), once per sample (-1 when there is no new one, or the
# GPU has no timestamps)
func walkerCloudMicroseconds(clouds: mod WalkerClouds, renderer: view DeferredRenderer) ret Int {
  let cloudTiming: view CloudTiming = renderer.passes.targets.cloudShadow.timing
  if cloudTiming.samples is clouds.seenSamples {
    ret -1
  }
  clouds.seenSamples = cloudTiming.samples
  # under a profile's timing (RAE_GPU_PASS_TIMING, RAE_FRAME_TIMING), a line
  # every 60 samples: the clouds' time and each pass's
  if cloudTiming.samples % 60 is 1 and (Sys.getEnv(name: "RAE_GPU_PASS_TIMING").length() > 0 or Sys.getEnv(
    name: "RAE_FRAME_TIMING"
  ).length() > 0) {
    var passes: String = ""
    loop var i: Int = 0, i < cloudTiming.cloudPassTimes.length, ++i {
      passes = "{passes} {cloudTiming.cloudPassTimes.copyAtDefault(index: i)}"
    }
    log(
      "[clouds gpu] {clouds.control.tier}: {cloudTiming.lastMicroseconds} us (passes us:{passes})"
    )
  }
  ret cloudTiming.lastMicroseconds
}

# One frame: the quality's ceiling, the fallback, and the tier to the renderer
func walkerCloudsFrame(
  clouds: mod WalkerClouds
  renderer: mod DeferredRenderer
  quality: view SettingsQuality
) {
  let qualityChanged: Bool = cloudTierSetQuality(
    control: clouds.control
    qualityTier: settingsQualityCloudTier(quality: quality, maxTier: clouds.settings.maxTier)
  )
  let fellBack: Bool = cloudTierFrame(
    control: clouds.control
    cloudMicroseconds: walkerCloudMicroseconds(clouds: clouds, renderer: renderer)
    thermal: thermalState()
  )
  setCloudTier(renderer: renderer, tier: clouds.control.tier)
}
