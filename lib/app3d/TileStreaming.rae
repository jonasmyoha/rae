# app3d/TileStreaming — an open world in square tiles, only those near a
# point in memory. The world is tiles `tileSize` a side, tile (0, 0) centered
# on the origin. A tile loads once its center is within `loadDistance` of the
# point and is let go once it is past `unloadDistance` (apart, so a tile at
# the edge does not load and unload by turns), at most `slotCount` at a time
# and one a frame, the nearest first. The slots are what an app keeps per
# tile on the GPU and in physics (app3d/SlotMeshes, a PropField group per
# slot), so they are the open world's memory however big the world is.
#
# A loaded tile is an entity (from the app's allocator, so the app can put its
# own components on it) with a StreamedTile component: its place in the grid,
# its slot, its state. Each frame streamTiles lets go of the tiles past the
# unload distance and loads the nearest wanted one, and says so in two event
# queues the app answers:
#
#   TileGone    the tile left its slot: the app takes its content out of the
#               slot (zero its mesh ranges, destroy its colliders, clear its
#               prop groups) and its own components off the entity, which
#               streamTiles frees on its next call
#   TileLoaded  a tile came into a free slot: the app builds its content there
#
# streamTilesAround does the same round several centers (a host keeping the
# world loaded round every player): a tile is kept while any center wants it.
#
# streamTilesPrimary, with `priority.primaryCenter` on, gives the first center
# the slots first (a fast camera among parked bodies and bots): its tiles round
# it and round where it will be in `leadSeconds` come before any other center's,
# the others want and keep only tiles within their own smaller reach, and with
# every slot held the least needed tile gives its slot up to a missing one
# needed clearly more (TilePriority). Off, it is streamTilesAround.
#
# What a tile holds is the app's; this is only which tiles, when, where.
import Math
open ecs/Entity
open ecs/World
open ecs/ComponentTable
open ecs/Event

type TileGridSettings {
  # A tile's side (m)
  tileSize: Float
  # Load a tile whose center is within this of the point (m); let it go past
  # unloadDistance
  loadDistance: Float
  unloadDistance: Float
  # Tiles in memory at most
  slotCount: Int
  # The first center first (streamTilesPrimary); off by default
  priority: TilePriority = {}
}

# streamTilesPrimary's rule. The need of a tile is a distance (m, less is more
# needed): to the primary center, or to its lead point plus `aheadPenalty`, for
# the primary's tiles; past every primary one, the distance to the nearest
# other center for theirs.
type TilePriority {
  # the first center is primary (off: every center alike, streamTilesAround)
  primaryCenter: Bool = false
  # the primary also wants the tiles round where it will be this long ahead (s)
  leadSeconds: Float = 3.0
  # a move faster than this (m/s) is a jump (a teleport, a respawn), not a speed
  jumpSpeed: Float = 150.0
  # a tile round the lead point counts as this much further (m): a little less
  # wanted than one round the center
  aheadPenalty: Float = 40.0
  # the other centers want tiles within this (m) and keep them within the second
  otherLoadDistance: Float = 160.0
  otherUnloadDistance: Float = 220.0
  # a missing tile takes a loaded tile's slot only when needed more by this (m),
  # so two tiles do not swap by turns
  swapMargin: Float = 60.0
}

# One tile's place in the grid
type GridTile {
  x: Int
  y: Int
}

enum TileState { loaded, gone }

# A streamed tile's entity: its place, its slot, whether it is still loaded
type StreamedTile {
  tile: GridTile
  slot: Int
  state: TileState
}

type TileLoaded {
  entityId: EntityId
  tile: GridTile
  slot: Int
}

type TileGone {
  entityId: EntityId
  tile: GridTile
  slot: Int
}

type TileStreamer {
  settings: TileGridSettings
  # The tile entity in each slot (noEntity when free)
  slots: List(EntityId)
  tiles: ComponentTable(StreamedTile)
  loaded: EventQueue(TileLoaded)
  gone: EventQueue(TileGone)
  # The entities let go last call, freed on the next
  toFree: List(EntityId)
  loads: Int
  unloads: Int
  # streamTilesPrimary: the primary center last call, and its speed (m/s)
  primaryLast: TileCenter = { x: 0.0, y: 0.0 }
  hasPrimaryLast: Bool = false
  primaryVelocity: TileCenter = { x: 0.0, y: 0.0 }
  # tiles that gave up their slot to a more needed one
  evictions: Int = 0
}

func createTileStreamer(settings: view TileGridSettings) ret TileStreamer {
  var slots: List(EntityId) = List.create(EntityId, cap: settings.slotCount)
  loop var s: Int = 0, s < settings.slotCount, ++s {
    slots.add(value: noEntity())
  }
  ret TileStreamer {
    settings: settings
    slots: own slots
    tiles: ComponentTable.create(StreamedTile)
    loaded: createEventQueue(TileLoaded)
    gone: createEventQueue(TileGone)
    toFree: List.create(EntityId, cap: settings.slotCount)
    loads: 0
    unloads: 0
  }
}

# ----- the grid's rules ------------------------------------------------------
func tileOfPoint(settings: view TileGridSettings, x: view Float, y: view Float) ret GridTile {
  ret GridTile {
    x: Math.floor(x: x / settings.tileSize + 0.5).toInt()
    y: Math.floor(x: y / settings.tileSize + 0.5).toInt()
  }
}

func tileCenterX(settings: view TileGridSettings, tile: view GridTile) ret Float {
  ret tile.x.toFloat() * settings.tileSize
}

func tileCenterY(settings: view TileGridSettings, tile: view GridTile) ret Float {
  ret tile.y.toFloat() * settings.tileSize
}

func tileDistance(
  settings: view TileGridSettings
  tile: view GridTile
  x: view Float
  y: view Float
) ret Float {
  let dx: Float = tileCenterX(settings: settings, tile: tile) - x
  let dy: Float = tileCenterY(settings: settings, tile: tile) - y
  ret Math.sqrt(x: dx * dx + dy * dy)
}

func tileWanted(
  settings: view TileGridSettings
  tile: view GridTile
  x: view Float
  y: view Float
) ret Bool {
  ret tileDistance(
    settings: settings
    tile: tile
    x: x
    y: y
  ) <= settings.loadDistance
}

func tileKept(
  settings: view TileGridSettings
  tile: view GridTile
  x: view Float
  y: view Float
) ret Bool {
  ret tileDistance(
    settings: settings
    tile: tile
    x: x
    y: y
  ) <= settings.unloadDistance
}

func sameTile(a: view GridTile, b: view GridTile) ret Bool {
  ret a.x is b.x and a.y is b.y
}

# Every tile wanted round (x, y), row by row from the south-west
func tilesToLoad(settings: view TileGridSettings, x: view Float, y: view Float) ret List(GridTile) {
  var tiles: List(GridTile) = List.create(GridTile, cap: settings.slotCount)
  let center: GridTile = tileOfPoint(settings: settings, x: x, y: y)
  let reach: Int = (settings.loadDistance / settings.tileSize).toInt() + 1
  loop var dy: Int = 0 - reach, dy <= reach, ++dy {
    loop var dx: Int = 0 - reach, dx <= reach, ++dx {
      let tile: GridTile = { x: center.x + dx, y: center.y + dy }
      if tileWanted(
        settings: settings
        tile: tile
        x: x
        y: y
      ) {
        tiles.add(value: tile)
      }
    }
  }
  ret tiles
}

# The nearest wanted tile not among `loaded`, if there is one and a slot for it
func nextTileToLoad(
  settings: view TileGridSettings
  loaded: view List(GridTile)
  x: view Float
  y: view Float
) ret opt GridTile {
  if loaded.length >= settings.slotCount {
    ret none
  }
  var best: GridTile = { x: 0, y: 0 }
  var bestDistance: Float = 1000000.0
  var found: Bool = false
  loop let tile: view GridTile in tilesToLoad(settings: settings, x: x, y: y) {
    var held: Bool = false
    loop let other: view GridTile in loaded {
      if sameTile(a: other, b: tile) {
        held = true
      }
    }
    let distance: Float = tileDistance(
      settings: settings
      tile: tile
      x: x
      y: y
    )
    if held is false and distance < bestDistance {
      best = tile
      bestDistance = distance
      found = true
    }
  }
  if found {
    ret best
  }
  ret none
}

# A point the tiles are loaded round (a player, a camera)
type TileCenter {
  x: Float
  y: Float
}

# Is `tile` within the unload distance of any of `centers`?
func tileKeptAround(
  settings: view TileGridSettings
  tile: view GridTile
  centers: view List(TileCenter)
) ret Bool {
  loop let center: view TileCenter in centers {
    if tileKept(
      settings: settings
      tile: tile
      x: center.x
      y: center.y
    ) {
      ret true
    }
  }
  ret false
}

# The wanted tile not among `loaded` nearest to any of `centers`, if there is one and a slot for it
func nextTileToLoadAround(
  settings: view TileGridSettings
  loaded: view List(GridTile)
  centers: view List(TileCenter)
) ret opt GridTile {
  var best: GridTile = { x: 0, y: 0 }
  var bestDistance: Float = 1000000.0
  var found: Bool = false
  loop let center: view TileCenter in centers {
    if let tile: GridTile = nextTileToLoad(
      settings: settings
      loaded: loaded
      x: center.x
      y: center.y
    ) {
      let distance: Float = tileDistance(
        settings: settings
        tile: tile
        x: center.x
        y: center.y
      )
      if distance < bestDistance {
        best = tile
        bestDistance = distance
        found = true
      }
    }
  }
  if found {
    ret best
  }
  ret none
}

# ----- the streaming system ----------------------------------------------------
# The loaded tiles, in slot order
func streamedTiles(streamer: view TileStreamer) ret List(GridTile) {
  var tiles: List(GridTile) = List.create(GridTile, cap: streamer.settings.slotCount)
  loop let entityId: view EntityId in streamer.slots {
    if isNone(this: entityId) is false {
      tiles.add(value: componentView(this: streamer.tiles, entityId: entityId).tile)
    }
  }
  ret tiles
}

# How many slots hold a tile
func usedTileSlots(streamer: view TileStreamer) ret Int {
  ret streamedTiles(streamer: streamer).length
}

# The tile in `slot`, if one is loaded there
func tileInSlot(streamer: view TileStreamer, slot: view Int) ret opt GridTile {
  let entityId: EntityId = streamer.slots.copyAtFallback(index: slot, fallback: noEntity())
  if isNone(this: entityId) {
    ret none
  }
  ret componentView(this: streamer.tiles, entityId: entityId).tile
}

# One frame round (x, y): free the entities let go last call, then send a
# TileGone for every tile past the unload distance (in slot order) and a
# TileLoaded for the nearest wanted tile, into the first free slot. The
# events of the call before are gone.
func streamTiles(
  streamer: mod TileStreamer
  allocator: mod EntityAllocator
  x: view Float
  y: view Float
) {
  var centers: List(TileCenter) = List.create(TileCenter, cap: 1)
  centers.add(value: TileCenter { x: x, y: y })
  streamTilesAround(streamer: streamer, allocator: allocator, centers: centers)
}

# One frame round several centers (docs/open-world-tiles.md (d): a host keeps
# the world loaded round every player): a tile is wanted within the load
# distance of any center and kept until it is past the unload distance of all;
# the nearest wanted one to any center loads first. With one center, streamTiles.
func streamTilesAround(
  streamer: mod TileStreamer
  allocator: mod EntityAllocator
  centers: view List(TileCenter)
) {
  loop let entityId: view EntityId in streamer.toFree {
    componentRemove(this: streamer.tiles, entityId: entityId)
    freeEntity(this: allocator, entityId: entityId)
  }
  streamer.toFree.clear()
  eventClear(TileLoaded, this: streamer.loaded)
  eventClear(TileGone, this: streamer.gone)
  let settings: TileGridSettings = streamer.settings
  loop var s: Int = 0, s < settings.slotCount, ++s {
    let entityId: EntityId = streamer.slots.copyAtFallback(index: s, fallback: noEntity())
    if isNone(this: entityId) {
      continue
    }
    let streamed: mod StreamedTile = componentMod(this: streamer.tiles, entityId: entityId)
    if tileKeptAround(settings: settings, tile: streamed.tile, centers: centers) {
      continue
    }
    streamed.state = TileState.gone
    let tile: GridTile = streamed.tile
    eventSend(
      TileGone
      this: streamer.gone
      value: TileGone { entityId: entityId, tile: tile, slot: s }
    )
    streamer.slots.set(index: s, value: noEntity())
    streamer.toFree.add(value: entityId)
    streamer.unloads = streamer.unloads + 1
  }
  if let next: GridTile = nextTileToLoadAround(
    settings: settings
    loaded: streamedTiles(streamer: streamer)
    centers: centers
  ) {
    var free: Int = -1
    loop var s: Int = 0, s < settings.slotCount and free < 0, ++s {
      if isNone(this: streamer.slots.copyAtFallback(index: s, fallback: noEntity())) {
        free = s
      }
    }
    if free >= 0 {
      let entityId: EntityId = allocEntity(this: allocator)
      componentSet(
        this: streamer.tiles
        entityId: entityId
        data: StreamedTile { tile: next, slot: free, state: TileState.loaded }
      )
      streamer.slots.set(index: free, value: entityId)
      eventSend(
        TileLoaded
        this: streamer.loaded
        value: TileLoaded { entityId: entityId, tile: next, slot: free }
      )
      streamer.loads = streamer.loads + 1
    }
  }
}

# ----- the primary center's rule (streamTilesPrimary) ---------------------------
# The primary's speed after a move from `last` to `now` in `deltaTime`: half the
# last speed and half this move's; a move faster than `jumpSpeed`, or no time,
# is no speed
func primaryVelocityAfter(
  priority: view TilePriority
  velocity: view TileCenter
  last: view TileCenter
  now: view TileCenter
  deltaTime: view Float
) ret TileCenter {
  if deltaTime <= 0.0 {
    ret velocity
  }
  let vx: Float = (now.x - last.x) / deltaTime
  let vy: Float = (now.y - last.y) / deltaTime
  if Math.sqrt(x: vx * vx + vy * vy) > priority.jumpSpeed {
    ret TileCenter { x: 0.0, y: 0.0 }
  }
  ret TileCenter { x: velocity.x * 0.5 + vx * 0.5, y: velocity.y * 0.5 + vy * 0.5 }
}

# Where the primary will be in `leadSeconds` at `velocity`
func primaryLeadPoint(
  priority: view TilePriority
  primary: view TileCenter
  velocity: view TileCenter
) ret TileCenter {
  ret TileCenter {
    x: primary.x + velocity.x * priority.leadSeconds
    y: primary.y + velocity.y * priority.leadSeconds
  }
}

# Above any primary tile's need: where the other centers' needs start
const otherCentersNeed: Float = 1000000.0

# How much `tile` is needed (less is more), or none when no center wants it:
# `keeping` a loaded tile reaches to the unload distances, wanting a missing one
# to the load distances. `centers` first is the primary, `lead` its lead point.
func tileNeed(
  settings: view TileGridSettings
  tile: view GridTile
  centers: view List(TileCenter)
  lead: view TileCenter
  keeping: view Bool
) ret opt Float {
  let priority: view TilePriority = settings.priority
  var primaryReach: Float = settings.loadDistance
  var otherReach: Float = priority.otherLoadDistance
  if keeping {
    primaryReach = settings.unloadDistance
    otherReach = priority.otherUnloadDistance
  }
  var best: Float = otherCentersNeed * 2.0
  var found: Bool = false
  loop var i: Int = 0, i < centers.length, ++i {
    let center: TileCenter = centers.copyAtFallback(
      index: i
      fallback: TileCenter { x: 0.0, y: 0.0 }
    )
    let distance: Float = tileDistance(
      settings: settings
      tile: tile
      x: center.x
      y: center.y
    )
    if i is 0 {
      if distance <= primaryReach and distance < best {
        best = distance
        found = true
      }
      let ahead: Float = tileDistance(
        settings: settings
        tile: tile
        x: lead.x
        y: lead.y
      )
      if ahead <= primaryReach and ahead + priority.aheadPenalty < best {
        best = ahead + priority.aheadPenalty
        found = true
      }
    } else if distance <= otherReach and otherCentersNeed + distance < best {
      best = otherCentersNeed + distance
      found = true
    }
  }
  if found {
    ret best
  }
  ret none
}

# A tile and its need
type TileNeed {
  tile: GridTile
  need: Float
}

# The most needed tile not among `loaded` (wanted round the primary, its lead
# point, or another center), if any
func mostNeededMissingTile(
  settings: view TileGridSettings
  loaded: view List(GridTile)
  centers: view List(TileCenter)
  lead: view TileCenter
) ret opt TileNeed {
  var best: TileNeed = { tile: { x: 0, y: 0 }, need: 0.0 }
  var found: Bool = false
  var points: List(TileCenter) = {}
  loop let center: view TileCenter in centers {
    points.add(value: center)
  }
  points.add(value: lead)
  loop let point: view TileCenter in points {
    loop let tile: view GridTile in tilesToLoad(settings: settings, x: point.x, y: point.y) {
      var held: Bool = false
      loop let other: view GridTile in loaded {
        if sameTile(a: other, b: tile) {
          held = true
        }
      }
      if held {
        continue
      }
      if let need: Float = tileNeed(
        settings: settings
        tile: tile
        centers: centers
        lead: lead
        keeping: false
      ) {
        if not found or need < best.need {
          best = TileNeed { tile: tile, need: need }
          found = true
        }
      }
    }
  }
  if found {
    ret best
  }
  ret none
}

# The slot of the least needed loaded tile (kept reach), and its need, if any slot is held
type SlotNeed {
  slot: Int
  need: Float
}

func leastNeededSlot(
  streamer: view TileStreamer
  centers: view List(TileCenter)
  lead: view TileCenter
) ret opt SlotNeed {
  var worst: SlotNeed = { slot: -1, need: 0.0 }
  loop var s: Int = 0, s < streamer.slots.length, ++s {
    let entityId: EntityId = streamer.slots.copyAtFallback(index: s, fallback: noEntity())
    if isNone(this: entityId) {
      continue
    }
    var need: Float = otherCentersNeed * 4.0
    if let kept: Float = tileNeed(
      settings: streamer.settings
      tile: componentView(this: streamer.tiles, entityId: entityId).tile
      centers: centers
      lead: lead
      keeping: true
    ) {
      need = kept
    }
    if worst.slot < 0 or need > worst.need {
      worst = SlotNeed { slot: s, need: need }
    }
  }
  if worst.slot < 0 {
    ret none
  }
  ret worst
}

# Let the tile in slot `s` go: a TileGone, and its entity freed next call
func releaseTileSlot(streamer: mod TileStreamer, s: view Int) {
  let entityId: EntityId = streamer.slots.copyAtFallback(index: s, fallback: noEntity())
  if isNone(this: entityId) {
    ret
  }
  let streamed: mod StreamedTile = componentMod(this: streamer.tiles, entityId: entityId)
  streamed.state = TileState.gone
  let tile: GridTile = streamed.tile
  eventSend(
    TileGone
    this: streamer.gone
    value: TileGone { entityId: entityId, tile: tile, slot: s }
  )
  streamer.slots.set(index: s, value: noEntity())
  streamer.toFree.add(value: entityId)
  streamer.unloads = streamer.unloads + 1
}

# One frame round `centers`, the first primary (TilePriority; with
# `primaryCenter` off this is streamTilesAround). `deltaTime` (s) since the last
# call measures the primary's speed. Tiles no center keeps go; the most needed
# missing tile loads into a free slot; with every slot held, the least needed
# loaded tile gives its slot up (a TileGone) when the missing one is needed more
# by `swapMargin`, and the missing one loads there on the next call.
func streamTilesPrimary(
  streamer: mod TileStreamer
  allocator: mod EntityAllocator
  centers: view List(TileCenter)
  deltaTime: view Float
) {
  let settings: TileGridSettings = streamer.settings
  if not settings.priority.primaryCenter or centers.length is 0 {
    streamTilesAround(streamer: streamer, allocator: allocator, centers: centers)
    ret
  }
  loop let entityId: view EntityId in streamer.toFree {
    componentRemove(this: streamer.tiles, entityId: entityId)
    freeEntity(this: allocator, entityId: entityId)
  }
  streamer.toFree.clear()
  eventClear(TileLoaded, this: streamer.loaded)
  eventClear(TileGone, this: streamer.gone)
  let primary: TileCenter = centers.copyAtFallback(
    index: 0
    fallback: TileCenter { x: 0.0, y: 0.0 }
  )
  if streamer.hasPrimaryLast {
    streamer.primaryVelocity = primaryVelocityAfter(
      priority: settings.priority
      velocity: streamer.primaryVelocity
      last: streamer.primaryLast
      now: primary
      deltaTime: deltaTime
    )
  }
  streamer.primaryLast = primary
  streamer.hasPrimaryLast = true
  let lead: TileCenter = primaryLeadPoint(
    priority: settings.priority
    primary: primary
    velocity: streamer.primaryVelocity
  )
  loop var s: Int = 0, s < settings.slotCount, ++s {
    let entityId: EntityId = streamer.slots.copyAtFallback(index: s, fallback: noEntity())
    if isNone(this: entityId) {
      continue
    }
    let kept: opt Float = tileNeed(
      settings: settings
      tile: componentView(this: streamer.tiles, entityId: entityId).tile
      centers: centers
      lead: lead
      keeping: true
    )
    if kept is none {
      releaseTileSlot(streamer: streamer, s: s)
    }
  }
  if let next: TileNeed = mostNeededMissingTile(
    settings: settings
    loaded: streamedTiles(streamer: streamer)
    centers: centers
    lead: lead
  ) {
    var free: Int = -1
    loop var s: Int = 0, s < settings.slotCount and free < 0, ++s {
      if isNone(this: streamer.slots.copyAtFallback(index: s, fallback: noEntity())) {
        free = s
      }
    }
    if free >= 0 {
      let entityId: EntityId = allocEntity(this: allocator)
      componentSet(
        this: streamer.tiles
        entityId: entityId
        data: StreamedTile { tile: next.tile, slot: free, state: TileState.loaded }
      )
      streamer.slots.set(index: free, value: entityId)
      eventSend(
        TileLoaded
        this: streamer.loaded
        value: TileLoaded { entityId: entityId, tile: next.tile, slot: free }
      )
      streamer.loads = streamer.loads + 1
    } else if let worst: SlotNeed = leastNeededSlot(
      streamer: streamer
      centers: centers
      lead: lead
    ) {
      if next.need + settings.priority.swapMargin < worst.need {
        releaseTileSlot(streamer: streamer, s: worst.slot)
        streamer.evictions = streamer.evictions + 1
      }
    }
  }
}
