# The GPU grass exclusion field for the three walker examples. It is a bounded
# list of world-space circles around nearby forest trunks and streamed rocks.
# GrassCompute owns and reuses the GPU buffer; this module only rewrites its
# contents, so moving the terrain window cannot grow resources or move an
# existing exclusion edge.
import Math
open Math3d
open GrassCompute
open gpu/GpuResources
open app3d/GroveTrees
open app3d/PropField
open app3d/PropFieldQuery
open app3d/WalkerTerrain

const walkerGrassObstacleLimit: Int = 512

const walkerGrassObstacleFloats: Int = 1 + walkerGrassObstacleLimit * 4

const walkerGrassObstacleMargin: Float = 0.24

func emptyWalkerGrassObstacles() ret List(Float) {
  var values: List(Float) = List.create(Float, cap: walkerGrassObstacleFloats)
  loop var i: Int = 0, i < walkerGrassObstacleFloats, ++i {
    values.add(value: 0.0)
  }
  ret values
}

func addWalkerGrassObstacle(
  values: mod List(Float)
  count: mod Int
  x: view Float
  y: view Float
  radius: view Float
) {
  if count >= walkerGrassObstacleLimit {
    ret
  }
  let offset: Int = 1 + count * 4
  values.set(index: offset, value: x)
  values.set(index: offset + 1, value: y)
  values.set(index: offset + 2, value: radius)
  values.set(index: offset + 3, value: 0.0)
  count = count + 1
}

func walkerGrassObstacles(
  terrainSystem: view WalkerTerrain
  centerX: view Float
  centerY: view Float
  reach: view Float
) ret List(Float) {
  var values: List(Float) = emptyWalkerGrassObstacles()
  var count: Int = 0
  let nearbyTrees: List(PropNear) = propsNear(
    field: terrainSystem.forest
    x: centerX
    y: centerY
    reach: reach + 2.0
  )
  loop let tree: view PropNear in nearbyTrees {
    addWalkerGrassObstacle(
      values: values
      count: count
      x: tree.placement.position.x
      y: tree.placement.position.y
      radius: treeTrunkRadius * tree.placement.scale + walkerGrassObstacleMargin
    )
  }
  loop let prop: view DrawnProp in terrainSystem.drawnProps {
    if prop.kind is not kindRock {
      continue
    }
    let x: Float = mat4Get(m: prop.model, i: 12)
    let y: Float = mat4Get(m: prop.model, i: 13)
    let deltaX: Float = x - centerX
    let deltaY: Float = y - centerY
    if deltaX * deltaX + deltaY * deltaY > (reach + 2.0) * (reach + 2.0) {
      continue
    }
    let scaleX: Float = Math.sqrt(
      x: mat4Get(m: prop.model, i: 0) * mat4Get(m: prop.model, i: 0) + mat4Get(m: prop.model, i: 1) * mat4Get(
        m: prop.model
        i: 1
      )
    )
    let scaleY: Float = Math.sqrt(
      x: mat4Get(m: prop.model, i: 4) * mat4Get(m: prop.model, i: 4) + mat4Get(m: prop.model, i: 5) * mat4Get(
        m: prop.model
        i: 5
      )
    )
    addWalkerGrassObstacle(
      values: values
      count: count
      x: x
      y: y
      radius: Math.max(a: scaleX, b: scaleY) * 0.78 + walkerGrassObstacleMargin
    )
  }
  values.set(index: 0, value: count.toFloat())
  ret values
}

func updateWalkerGrassObstacles(
  grass: mod GrassCompute
  resources: mod GpuResources
  terrainSystem: view WalkerTerrain
  centerX: view Float
  centerY: view Float
  reach: view Float
) {
  let values: List(Float) = walkerGrassObstacles(
    terrainSystem: terrainSystem
    centerX: centerX
    centerY: centerY
    reach: reach
  )
  grassUpdateSurfaceField(
    grass: grass
    resources: resources
    offset: 0
    values: values
  )
}
