# app3d/camera_rig — shared orbit, free and opt-in character-follow camera.
#
# Extracted from example 110, which had the only complete version: orbit
# and WASD-fly modes, pointer drag, wheel zoom, keyboard nudges, a pitch
# clamp that both input paths share, and a snapshot format for hot
# reload. Examples 112 and 113 each carried a partial reimplementation
# with its own clamps and its own sign conventions, which is how a camera
# ends up feeling different in every example of the same renderer.
#
# WHY A RIG AND NOT A CAMERA. Camera3d is what the renderer consumes:
# a position, a target, a field of view. This is the CONTROL state behind
# it — yaw, pitch, distance — which is not derivable from the camera
# after the fact (many rigs produce the same eye point). Keeping them
# separate is what lets `applyCameraRig` stay a pure function of the rig.
#
# LIMITS ARE FIELDS, NOT CONSTANTS. An example that frames a 2-metre
# character needs a different distance range from one framing a 36-metre
# scene. Making them fields is what stops the next example from forking
# the module to change one number.
import core
import math
import gpu2d
import sdl3
import vec3
import keys
open scene3d
open math3d

# Shift makes the WASD camera 4x FASTER, Control makes it 4x SLOWER (for fine framing).
# Applied to translation only — boosting the turn rate as well makes the view hard to aim.
const cameraRigBoost: Float = 4.0
const cameraRigSlow: Float = 0.25

func cameraRigSpeedScale() ret Float {
  if sdl3.isKeyDown(key: keys.keyLShift) or sdl3.isKeyDown(key: keys.keyRShift) {
    ret cameraRigBoost
  }
  if sdl3.isKeyDown(key: keys.keyLCtrl) or sdl3.isKeyDown(key: keys.keyRCtrl) {
    ret cameraRigSlow
  }
  ret 1.0
}

enum CameraRigMode {
  orbit
  free
  character
}

type CameraRig {
  mode: CameraRigMode
  # Apps with a controllable subject opt in. Other examples retain the
  # original two-mode Orbit/WASD cycle and can never enter a mode they do
  # not know how to supply a follow target for.
  characterModeEnabled: Bool
  yaw: Float
  orbitPitch: Float
  freePitch: Float
  distance: Float
  freePosition: Vec3
  # Tunables. See the note above on why these are fields.
  minDistance: Float
  maxDistance: Float
  pitchLimit: Float
  dragSpeed: Float
  wheelSpeed: Float
  keyTurnSpeed: Float
  moveSpeed: Float
  # Input smoothing, mouse and keyboard toggled INDEPENDENTLY because they
  # want different answers: a mouse flick is a noisy signal worth
  # filtering, while a held key is already clean and only wants
  # acceleration. Someone who likes damped movement often still wants the
  # look to track the pointer exactly, so one shared switch would be the
  # wrong control.
  smoothMouse: Bool
  smoothKeys: Bool
  # Rate in units of e-folds per second: the gap to the target shrinks by
  # 1/e every 1/rate seconds. 22 is a ~45ms time constant, enough to take
  # the steps out of a jittery pointer without reading as lag; keys ramp
  # slower because that is the point of smoothing them.
  mouseSmoothRate: Float
  keySmoothRate: Float
  # DISPLAY STATE — what the camera is actually derived from, as opposed
  # to the target fields above that input writes. With smoothing off these
  # track the targets exactly and every path below is a no-op; with it on
  # they chase. Keeping them apart is what lets the readout and the
  # snapshot report where the camera is GOING rather than an intermediate
  # frame of the easing, so a hot reload does not save a half-finished
  # movement.
  viewYaw: Float
  viewOrbitPitch: Float
  viewFreePitch: Float
  viewDistance: Float
  viewPosition: Vec3
  # Drag tracking. Held here rather than in the app because every caller
  # needs exactly the same three variables and gets them subtly wrong —
  # the common bug is orbiting on the first frame of a press, which
  # snaps the view by however far the pointer was from its last position.
  dragging: Bool
  lastX: Float
  lastY: Float
}

# Camera drag pointer (#526). By default the rig drags with the mouse pointer.
# For touch, setCameraTouch tells it the joystick's exclusion zone (centre +
# radius, design units) and which finger it owns (excludeId). The grab is decided
# by REGION — a finger that goes down inside the joystick zone belongs to the
# joystick, one outside belongs to the camera — and then HELD by id, so a drag
# never transfers mid-gesture even if it wanders across the boundary. Region-at-
# grab is what makes the two complementary; id-hold is what makes ownership
# sticky. gCamTouchOn stays false until set, so other rigs (110/113) keep the
# plain-mouse behaviour.
var gCamTouchOn: Bool = false
var gCamExcludeId: Int = 0 - 1     # finger currently owned by the joystick
var gCamJoyActive: Bool = false    # desktop: joystick has the mouse
var gCamGrabId: Int = 0 - 1        # finger this rig owns
var gCamZoneX: Float = 0.0         # joystick zone centre (design units)
var gCamZoneY: Float = 0.0
var gCamZoneR: Float = 0.0 - 1.0   # joystick zone radius (<0 = no zone)
var gCamPointerX: Float = 0.0
var gCamPointerY: Float = 0.0
var gCamPointerDown: Bool = false

func setCameraTouch(excludeId: copy Int, joystickActive: copy Bool,
                    zoneX: copy Float, zoneY: copy Float, zoneR: copy Float) pub {
  gCamTouchOn = true
  gCamExcludeId = excludeId
  gCamJoyActive = joystickActive
  gCamZoneX = zoneX
  gCamZoneY = zoneY
  gCamZoneR = zoneR
}

# True when the point is outside the joystick zone (or no zone is set), i.e. the
# camera is allowed to start a grab there.
func pointerOutsideCamZone(x: view Float, y: view Float) ret Bool {
  if gCamZoneR < 0.0 { ret true }
  let dx: Float = x - gCamZoneX
  let dy: Float = y - gCamZoneY
  ret dx * dx + dy * dy > gCamZoneR * gCamZoneR
}

func resolveCameraPointer() {
  if gCamTouchOn is false {
    gCamPointerX = gpu2d.pointerX()
    gCamPointerY = gpu2d.pointerY()
    gCamPointerDown = gpu2d.pointerDown()
    ret
  }
  let touches: Int = gpu2d.touchCount()
  if touches > 0 {
    # Own a finger from press and hold it: keep our grabbed finger while it stays
    # down, else grab a newly-pressed finger that goes down OUTSIDE the joystick
    # zone (the stick owns inside; each holds its finger for the whole drag).
    var found: Bool = false
    var index: Int = 0
    loop index < touches {
      let id: Int = gpu2d.touchId(index: index)
      let tx: Float = gpu2d.touchX(index: index)
      let ty: Float = gpu2d.touchY(index: index)
      let pressed: Bool = gpu2d.touchPressed(index: index)
      # Reused-id release: SDL recycles finger ids after a lift, so a FRESH press
      # carrying the id we hold means our finger lifted and a new one took the id.
      # A hold is never a fresh press — drop it here so the grab below re-decides
      # by region. Without this the camera and stick fight over one finger and
      # never release it (the "input goes to both" bug).
      if gCamGrabId >= 0 and id is gCamGrabId and pressed { gCamGrabId = 0 - 1 }
      if gCamGrabId >= 0 and id is gCamGrabId {
        # Hold: keep our finger wherever it goes, even into the joystick zone.
        gCamPointerX = tx
        gCamPointerY = ty
        found = true
      }
      if gCamGrabId < 0 and pressed
        and id is not gCamExcludeId and pointerOutsideCamZone(x: tx, y: ty) {
        gCamGrabId = id
        gCamPointerX = tx
        gCamPointerY = ty
        found = true
      }
      index = index + 1
    }
    if found is false { gCamGrabId = 0 - 1 }
    gCamPointerDown = found
  } else {
    # Desktop mouse: skip while the joystick owns the mouse.
    gCamPointerX = gpu2d.pointerX()
    gCamPointerY = gpu2d.pointerY()
    gCamPointerDown = gpu2d.pointerDown() and gCamJoyActive is false
  }
}

func createCameraRig(camera: view Camera3d) pub ret CameraRig {
  ret CameraRig {
    mode: CameraRigMode.orbit
    characterModeEnabled: false
    yaw: 0.0
    orbitPitch: 0.38
    freePitch: 0.0 - 0.38
    distance: 12.5
    freePosition: camera.position
    minDistance: 4.0
    maxDistance: 30.0
    pitchLimit: 1.45
    dragSpeed: 0.008
    wheelSpeed: 0.8
    keyTurnSpeed: 1.2
    moveSpeed: 6.0
    # On by default: this is the camera feel the examples are meant to
    # ship with, and the rates are low enough that the easing reads as
    # weight rather than lag. Both are one click away in the camera bar,
    # and whichever way they are left persists.
    smoothMouse: true
    smoothKeys: true
    mouseSmoothRate: 22.0
    keySmoothRate: 12.0
    viewYaw: 0.0
    viewOrbitPitch: 0.38
    viewFreePitch: 0.0 - 0.38
    viewDistance: 12.5
    viewPosition: camera.position
    dragging: false
    lastX: 0.0
    lastY: 0.0
  }
}

# Orbit pitch limit, shared by the drag and keyboard paths so they cannot
# drift apart.
#
# SYMMETRIC: the camera orbits as far BELOW the horizon as above it. An
# earlier version stopped at +0.05 rad, which pinned it to almost exactly
# horizontal and made it feel stuck against an invisible floor.
#
# The magnitude stops just short of a right angle because the view matrix
# uses a fixed +Z world up: at exactly +/-90 degrees the view direction is
# parallel to that up vector, their cross product is zero, and the basis
# collapses. The default 1.45 rad is about 83 degrees — close enough to
# straight down to feel unrestricted, far enough to stay off the
# singularity.
func clampRigPitch(rig: view CameraRig, pitch: view Float) pub ret Float {
  if pitch > rig.pitchLimit {
    ret rig.pitchLimit
  }
  if pitch < 0.0 - rig.pitchLimit {
    ret 0.0 - rig.pitchLimit
  }
  ret pitch
}

# Move `current` toward `target`, FRAME-RATE INDEPENDENTLY.
#
# The obvious version — current + (target - current) * rate * dt — is a
# different filter at every frame rate: the same rate feels sluggish at
# 30fps and snappy at 144, and a long frame can overshoot past the target
# and oscillate. Decaying the REMAINING GAP exponentially is the same
# curve sampled at whatever moments the frames land on, so the camera
# behaves identically however the frame rate moves around. That property
# is what test 581 pins.
#
# The epsilon snap matters for more than tidiness: an exponential never
# actually arrives, so without it `updateCameraRig` would report movement
# forever and an idle-aware render loop would never get to sleep.
const rigSmoothEpsilon: Float = 0.00001

func smoothTowards(current: view Float, target: view Float,
                   rate: view Float, dt: view Float) pub ret Float {
  if rate <= 0.0 {
    ret target
  }
  let gap: Float = target - current
  if gap < rigSmoothEpsilon and gap > 0.0 - rigSmoothEpsilon {
    ret target
  }
  ret target - gap * math.exp(x: 0.0 - rate * dt)
}

# Which rate the rotation and zoom easing runs at. Those quantities are
# driven by BOTH mouse and keys, so the rate depends on which sources are
# being smoothed; with both on, the slower one wins, because the gap left
# by the smoother source is the one still closing.
func rigRotationRate(rig: view CameraRig) pub ret Float {
  if rig.smoothMouse and rig.smoothKeys {
    if rig.keySmoothRate < rig.mouseSmoothRate {
      ret rig.keySmoothRate
    }
    ret rig.mouseSmoothRate
  }
  if rig.smoothMouse {
    ret rig.mouseSmoothRate
  }
  if rig.smoothKeys {
    ret rig.keySmoothRate
  }
  # Neither smoothed: 0 means "snap", and display already equals target.
  ret 0.0
}

# Built from the DISPLAYED orientation, not the target. This is both what
# the user sees and what they expect to fly along — moving toward where
# the camera is still turning to face would feel like the controls were
# fighting the view.
func cameraRigForward(rig: view CameraRig) pub ret Vec3 {
  let cp: Float = math.cos(x: rig.viewFreePitch)
  ret vec3.create(
    x: (0.0 - math.sin(x: rig.viewYaw)) * cp
    y: math.cos(x: rig.viewYaw) * cp
    z: math.sin(x: rig.viewFreePitch)
  )
}

# Zoom range, shared by the wheel, the keys, the easing and the snapshot
# restore for the same reason the pitch clamp is shared: four copies of a
# bound is four chances for one of them to disagree.
func clampRigDistance(rig: view CameraRig, dist: view Float) pub ret Float {
  if dist < rig.minDistance {
    ret rig.minDistance
  }
  if dist > rig.maxDistance {
    ret rig.maxDistance
  }
  ret dist
}

func cameraRigRight(rig: view CameraRig) pub ret Vec3 {
  let forward: Vec3 = cameraRigForward(rig: rig)
  let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  ret vec3.vnorm(a: vec3.vcross(a: forward, b: up))
}

func cameraRigModeName(rig: view CameraRig) pub ret String {
  if rig.mode is CameraRigMode.character {
    ret "Character"
  }
  if rig.mode is CameraRigMode.free {
    ret "WASD"
  }
  ret "Orbit"
}

# Swap between orbit and fly WITHOUT the view jumping. Each mode stores
# its own pitch because their sign conventions differ (orbit pitch raises
# the eye, free pitch aims it), and the orbit target is recovered by
# walking `distance` along the current view direction — otherwise
# switching back to orbit re-centres on wherever the target happened to
# be left, which reads as the camera teleporting.
func toggleCameraRigMode(rig: mod CameraRig, camera: mod Camera3d) pub {
  if rig.mode is CameraRigMode.orbit {
    rig.mode = CameraRigMode.free
    rig.freePosition = camera.position
    rig.freePitch = 0.0 - rig.orbitPitch
  } else if rig.mode is CameraRigMode.free {
    let forward: Vec3 = cameraRigForward(rig: rig)
    rig.orbitPitch = clampRigPitch(rig: rig, pitch: 0.0 - rig.freePitch)
    camera.target = vec3.vadd(a: rig.freePosition, b: vec3.vscale(a: forward, s: rig.distance))
    if rig.characterModeEnabled {
      rig.mode = CameraRigMode.character
    } else {
      rig.mode = CameraRigMode.orbit
    }
  } else {
    # Character and orbit share the same orbit-camera representation; only
    # the app's ownership of the pivot differs, so this switch cannot jump.
    rig.mode = CameraRigMode.orbit
  }
  # A mode switch is a deliberate re-anchor, so it must not be eased.
  snapCameraRigView(rig: rig)
}

# Read pointer, wheel and keyboard into the rig. Returns whether anything
# actually moved, which is what an idle-aware render loop gates on.
#
# `allowInput` is false when the UI has captured the pointer, so pressing
# a button does not also spin the camera. Note that it gates the KEYBOARD
# too: a text field would otherwise steer the view while being typed in.
func updateCameraRig(rig: mod CameraRig, camera: mod Camera3d,
                     allowInput: view Bool, dt: view Float) pub ret Bool {
  let yaw0: Float = rig.yaw
  let orbitPitch0: Float = rig.orbitPitch
  let freePitch0: Float = rig.freePitch
  let dist0: Float = rig.distance
  let pos0: Vec3 = rig.freePosition

  let viewYaw0: Float = rig.viewYaw
  let viewOrbit0: Float = rig.viewOrbitPitch
  let viewFree0: Float = rig.viewFreePitch
  let viewDist0: Float = rig.viewDistance
  let viewPos0: Vec3 = rig.viewPosition

  # This frame's input, kept apart by SOURCE until it is applied, because
  # the two sources can be smoothed independently even though they drive
  # the same yaw, pitch and distance.
  var mouseYaw: Float = 0.0
  var mouseOrbitPitch: Float = 0.0
  var mouseFreePitch: Float = 0.0
  var mouseDist: Float = 0.0
  var keyYaw: Float = 0.0
  var keyOrbitPitch: Float = 0.0
  var keyDist: Float = 0.0
  var keyMove: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)

  resolveCameraPointer()
  let px: Float = gCamPointerX
  let py: Float = gCamPointerY
  if allowInput and gCamPointerDown {
    # Only orbit once a drag is ESTABLISHED. On the press frame there is
    # no previous position to difference against, and using the stale one
    # snaps the view by the distance the pointer travelled while up.
    if rig.dragging {
      if rig.mode is not CameraRigMode.free {
        mouseYaw = (px - rig.lastX) * rig.dragSpeed
        mouseOrbitPitch = 0.0 - (py - rig.lastY) * rig.dragSpeed
      } else {
        # Fly mode drags the WORLD past a fixed eye, so yaw runs opposite
        # to orbit, where the drag carries the eye around the subject.
        mouseYaw = 0.0 - (px - rig.lastX) * rig.dragSpeed
        mouseFreePitch = 0.0 - (py - rig.lastY) * rig.dragSpeed
      }
    }
    rig.dragging = true
  } else {
    rig.dragging = false
  }
  rig.lastX = px
  rig.lastY = py

  if allowInput {
    # The wheel is a pointer device, so it rides the mouse toggle.
    mouseDist = 0.0 - gpu2d.wheelMove() * rig.wheelSpeed
    let boost: Float = cameraRigSpeedScale()
    if rig.mode is CameraRigMode.orbit {
      if sdl3.isKeyDown(key: keys.keyW) { keyDist = keyDist - dt * rig.moveSpeed * boost }
      if sdl3.isKeyDown(key: keys.keyS) { keyDist = keyDist + dt * rig.moveSpeed * boost }
      if sdl3.isKeyDown(key: keys.keyA) { keyYaw = keyYaw - dt * rig.keyTurnSpeed }
      if sdl3.isKeyDown(key: keys.keyD) { keyYaw = keyYaw + dt * rig.keyTurnSpeed }
      if sdl3.isKeyDown(key: keys.keyQ) { keyOrbitPitch = keyOrbitPitch - dt * rig.keyTurnSpeed }
      if sdl3.isKeyDown(key: keys.keyE) { keyOrbitPitch = keyOrbitPitch + dt * rig.keyTurnSpeed }
    } else if rig.mode is CameraRigMode.free {
      let step: Float = dt * rig.moveSpeed * boost
      let forward: Vec3 = cameraRigForward(rig: rig)
      let right: Vec3 = cameraRigRight(rig: rig)
      let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
      if sdl3.isKeyDown(key: keys.keyW) { keyMove = vec3.vadd(a: keyMove, b: vec3.vscale(a: forward, s: step)) }
      if sdl3.isKeyDown(key: keys.keyS) { keyMove = vec3.vsub(a: keyMove, b: vec3.vscale(a: forward, s: step)) }
      if sdl3.isKeyDown(key: keys.keyA) { keyMove = vec3.vsub(a: keyMove, b: vec3.vscale(a: right, s: step)) }
      if sdl3.isKeyDown(key: keys.keyD) { keyMove = vec3.vadd(a: keyMove, b: vec3.vscale(a: right, s: step)) }
      if sdl3.isKeyDown(key: keys.keyQ) { keyMove = vec3.vsub(a: keyMove, b: vec3.vscale(a: up, s: step)) }
      if sdl3.isKeyDown(key: keys.keyE) { keyMove = vec3.vadd(a: keyMove, b: vec3.vscale(a: up, s: step)) }
    }
  }

  # THE TARGET TAKES EVERYTHING; THE DISPLAY TAKES ONLY WHAT IS NOT
  # SMOOTHED. That split is the whole mechanism: an unsmoothed source
  # lands in both and so has exactly zero added lag, while a smoothed one
  # moves the target and leaves a gap for the easing below to close. It
  # also means the two toggles compose — with the mouse smoothed and keys
  # raw, a key press still responds instantly on the same frame that a
  # drag is easing.
  rig.yaw = rig.yaw + mouseYaw + keyYaw
  rig.orbitPitch = clampRigPitch(rig: rig, pitch: rig.orbitPitch + mouseOrbitPitch + keyOrbitPitch)
  rig.freePitch = clampRigPitch(rig: rig, pitch: rig.freePitch + mouseFreePitch)
  rig.distance = clampRigDistance(rig: rig, dist: rig.distance + mouseDist + keyDist)
  rig.freePosition = vec3.vadd(a: rig.freePosition, b: keyMove)

  if not rig.smoothMouse {
    rig.viewYaw = rig.viewYaw + mouseYaw
    rig.viewOrbitPitch = rig.viewOrbitPitch + mouseOrbitPitch
    rig.viewFreePitch = rig.viewFreePitch + mouseFreePitch
    rig.viewDistance = rig.viewDistance + mouseDist
  }
  if not rig.smoothKeys {
    rig.viewYaw = rig.viewYaw + keyYaw
    rig.viewOrbitPitch = rig.viewOrbitPitch + keyOrbitPitch
    rig.viewDistance = rig.viewDistance + keyDist
    rig.viewPosition = vec3.vadd(a: rig.viewPosition, b: keyMove)
  }

  # Close whatever gap the smoothed sources left. With both toggles off
  # every gap is already zero and each of these is the identity.
  let rotRate: Float = rigRotationRate(rig: rig)
  rig.viewYaw = smoothTowards(current: rig.viewYaw, target: rig.yaw, rate: rotRate, dt: dt)
  rig.viewOrbitPitch = smoothTowards(current: rig.viewOrbitPitch, target: rig.orbitPitch, rate: rotRate, dt: dt)
  rig.viewFreePitch = smoothTowards(current: rig.viewFreePitch, target: rig.freePitch, rate: rotRate, dt: dt)
  rig.viewDistance = smoothTowards(current: rig.viewDistance, target: rig.distance, rate: rotRate, dt: dt)
  # Position is keyboard-driven only, so it follows that toggle alone.
  var moveRate: Float = 0.0
  if rig.smoothKeys { moveRate = rig.keySmoothRate }
  rig.viewPosition = vec3.create(
    x: smoothTowards(current: rig.viewPosition.x, target: rig.freePosition.x, rate: moveRate, dt: dt),
    y: smoothTowards(current: rig.viewPosition.y, target: rig.freePosition.y, rate: moveRate, dt: dt),
    z: smoothTowards(current: rig.viewPosition.z, target: rig.freePosition.z, rate: moveRate, dt: dt)
  )
  # A snapshot restored under different limits, or a target clamped after
  # the display already passed the old bound, must not leave the visible
  # camera outside the range.
  rig.viewOrbitPitch = clampRigPitch(rig: rig, pitch: rig.viewOrbitPitch)
  rig.viewFreePitch = clampRigPitch(rig: rig, pitch: rig.viewFreePitch)
  rig.viewDistance = clampRigDistance(rig: rig, dist: rig.viewDistance)

  # THE DISPLAY MOVING COUNTS AS MOVEMENT. Easing continues for a while
  # after the last event, and a loop that only watched the target would
  # drop to its idle rate mid-glide and show the smoothing as a stutter —
  # the same starvation trap documented for every other animation source.
  if rig.viewYaw is not viewYaw0
    or rig.viewOrbitPitch is not viewOrbit0
    or rig.viewFreePitch is not viewFree0
    or rig.viewDistance is not viewDist0
    or rig.viewPosition.x is not viewPos0.x
    or rig.viewPosition.y is not viewPos0.y
    or rig.viewPosition.z is not viewPos0.z {
    ret true
  }

  ret rig.yaw is not yaw0
    or rig.orbitPitch is not orbitPitch0
    or rig.freePitch is not freePitch0
    or rig.distance is not dist0
    or rig.freePosition.x is not pos0.x
    or rig.freePosition.y is not pos0.y
    or rig.freePosition.z is not pos0.z
}

# Derive the camera from the rig. Pure in the rig: calling it twice with
# no input between gives the same camera, which is what makes the
# moved-flag above safe to gate rendering on.
func applyCameraRig(rig: view CameraRig, camera: mod Camera3d) pub {
  if rig.mode is not CameraRigMode.free {
    camera.position = orbitEye(
      targetX: camera.target.x, targetY: camera.target.y, targetZ: camera.target.z,
      yaw: rig.viewYaw, pitch: rig.viewOrbitPitch, dist: rig.viewDistance
    )
  } else {
    let forward: Vec3 = cameraRigForward(rig: rig)
    camera.position = rig.viewPosition
    camera.target = vec3.vadd(a: camera.position, b: forward)
  }
}

# Collapse any easing in flight, putting the camera on its target NOW.
# Used wherever the view is meant to jump rather than glide — a mode
# switch, a restored snapshot — because easing across a deliberate
# teleport is a swoop through the scene, not smoothing.
func snapCameraRigView(rig: mod CameraRig) pub {
  rig.viewYaw = rig.yaw
  rig.viewOrbitPitch = rig.orbitPitch
  rig.viewFreePitch = rig.freePitch
  rig.viewDistance = rig.distance
  rig.viewPosition = rig.freePosition
}

# ----- snapshot -------------------------------------------------------
# Space-separated numbers rather than JSON: the payload is twelve values, a
# malformed or older line must degrade to "start fresh" rather than
# half-apply, and the caller already owns a version tag for the rest of
# its state. Restoring a partially-parsed camera is worse than not
# restoring one.

# Twelve values: mode, yaw, two pitches, distance, free position xyz, the
# orbit target's x/y, and the two smoothing toggles.
#
# Only TARGET state is written. The display fields are mid-easing values
# with no meaning across a restart, and saving them would persist a
# half-finished movement.
const cameraRigFields: Int = 12

func cameraRigPart(parts: view List(String), index: view Int) ret String {
  if let value: String = parts.at(index: index) { ret value }
  ret ""
}

func cameraRigStateString(rig: view CameraRig, camera: view Camera3d) pub ret String {
  var modeNum: Int = 0
  if rig.mode is CameraRigMode.free { modeNum = 1 }
  if rig.mode is CameraRigMode.character { modeNum = 2 }
  var smoothM: Int = 0
  if rig.smoothMouse { smoothM = 1 }
  var smoothK: Int = 0
  if rig.smoothKeys { smoothK = 1 }
  ret "{modeNum} {rig.yaw} {rig.orbitPitch} {rig.freePitch} {rig.distance} {rig.freePosition.x} {rig.freePosition.y} {rig.freePosition.z} {camera.target.x} {camera.target.y} {smoothM} {smoothK}"
}

# Apply `cameraRigFields` values starting at `offset` in an
# already-split snapshot. Returns false — changing nothing — when the
# fields are not all present, so a truncated line cannot leave the rig
# half-restored.
func applyCameraRigState(parts: view List(String), offset: view Int,
                         rig: mod CameraRig, camera: mod Camera3d) pub ret Bool {
  if parts.length < offset + cameraRigFields {
    ret false
  }
  let modeNum: Int = cameraRigPart(parts: parts, index: offset).trim().toInt()
  if modeNum is 2 and rig.characterModeEnabled {
    rig.mode = CameraRigMode.character
  } else if modeNum is 1 {
    rig.mode = CameraRigMode.free
  } else {
    rig.mode = CameraRigMode.orbit
  }
  rig.yaw = cameraRigPart(parts: parts, index: offset + 1).trim().toFloat()
  rig.orbitPitch = cameraRigPart(parts: parts, index: offset + 2).trim().toFloat()
  rig.freePitch = cameraRigPart(parts: parts, index: offset + 3).trim().toFloat()
  rig.distance = cameraRigPart(parts: parts, index: offset + 4).trim().toFloat()
  rig.freePosition = vec3.create(
    x: cameraRigPart(parts: parts, index: offset + 5).trim().toFloat(),
    y: cameraRigPart(parts: parts, index: offset + 6).trim().toFloat(),
    z: cameraRigPart(parts: parts, index: offset + 7).trim().toFloat()
  )
  # Orbit needs the target restored too, or the camera returns to the
  # right angle around the wrong point.
  camera.target = vec3.create(
    x: cameraRigPart(parts: parts, index: offset + 8).trim().toFloat(),
    y: cameraRigPart(parts: parts, index: offset + 9).trim().toFloat(),
    z: camera.target.z
  )
  rig.smoothMouse = cameraRigPart(parts: parts, index: offset + 10).trim().toInt() is 1
  rig.smoothKeys = cameraRigPart(parts: parts, index: offset + 11).trim().toInt() is 1
  # A snapshot written by a build with different limits should still land
  # inside this build's.
  rig.distance = clampRigDistance(rig: rig, dist: rig.distance)
  rig.orbitPitch = clampRigPitch(rig: rig, pitch: rig.orbitPitch)
  # Start ON the restored camera rather than easing to it from wherever
  # the defaults put the display — that would play a swoop on every
  # reload, which is the opposite of preserving the view.
  snapCameraRigView(rig: rig)
  ret true
}
