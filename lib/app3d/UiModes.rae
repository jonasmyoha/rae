# Two UI modes for an app's HUD scene: GAME (the default at every launch: the
# play view, the touch stick, the app's own HUD) and EDITOR (the debugging
# chrome — a camera bar, a settings panel, a log strip), switched from the "..."
# button's menu the scene puts in both (app3d/ModeMenu). The mode is the scene's `editor` STATE
# (lib/ui
# Frames S5): one state overlay turns the editor chrome on and the game layer
# off, so no node is toggled by hand. Applied together with the scene's
# pointer frames (`"when": { "pointer": "coarse" }` for a finger) and a `short`
# state for a low window (a phone on its side) — every time one of them
# changes.
#
#   let uiModes: UiModes = createUiModes(world: w, uiSystems: s, path: "assets/ui.raescene")
#   ...each frame, before layout:
#   if updateUiModes(world: w, uiSystems: s, uiModes: uiModes) or updateModeMenu(world: w,
#      uiSystems: s, uiModes: uiModes, input: ui, rig: rig) { ...lay the UI out again... }
#   if uiModes.editor { ...draw the editor-only overlays... }
#
# Applying frames and states resets the nodes they name to the scene's authored
# components, so an app that writes those nodes at run time writes them again
# when `generation` moves. RAE_UI_MODE=editor starts in EDITOR, RAE_UI_FRAME=<id>
# forces a frame, RAE_UI_MENU=open starts with the "..." menu open (all for
# screenshots).
import Sys
open Device
open ui/Scene
open ui/SceneFile
open ui/Frames
open ui/Ecs
open ui/UiSystems
open app3d/UiShell
open ui/DebugOverlay
open ui/Components
open ui/Transform
open ui/inputSystem/InputSystem
open ecs/Entity
open ecs/ComponentTable

# The scene's frames and states as applied: the scene (they are read from
# it), the main pointer the frames were chosen for, the mode, whether the
# window is short, and how many times they have been applied.
type UiModes {
  scene: Scene
  pointer: Pointer
  # EDITOR mode on: the scene's `editor` state is active
  editor: Bool
  # A low window (a phone on its side): the scene's `short` state is active
  short: Bool
  generation: Int
  # The "..." mode menu (app3d/ModeMenu)
  modeMenu: ModeMenuState
}

# The "..." menu's own state (app3d/ModeMenu): open or not, and the camera
# item's text as written (whether it says reversed, and whether it was
# written yet). Kept apart from the modes so an app without GAME / EDITOR
# modes (app3d/EditorPanel) has the same menu.
type ModeMenuState {
  open: Bool
  cameraLabelReversed: Bool
  cameraLabelWritten: Bool
  # Show the touch controls (an on-screen joystick) as a phone does: on in a
  # phone build, where the menu has no item for it; on a desktop off until
  # the menu's "Simulate mobile phone" turns it on (RAE_SIMULATE_MOBILE=1
  # starts it on, for screenshots). Read it with touchControlsShown.
  simulateMobile: Bool
  # The mobile item's text as written
  mobileLabelSimulated: Bool
  mobileLabelWritten: Bool
  # The generation the menu's nodes were last written under: applying a frame
  # or state resets the nodes it names (the menu, restyled for EDITOR), so
  # the menu writes them again when the modes' `generation` moves
  generation: Int
}

# Closed (open under RAE_UI_MENU=open, for screenshots), nothing written yet
func createModeMenuState() ret ModeMenuState {
  ret ModeMenuState {
    open: Sys.getEnv(name: "RAE_UI_MENU") is "open"
    cameraLabelReversed: false
    cameraLabelWritten: false
    simulateMobile: Target.isMobileOs or Sys.getEnv(name: "RAE_SIMULATE_MOBILE") is "1"
    mobileLabelSimulated: false
    mobileLabelWritten: false
    generation: 0
  }
}

const uiModeEditorState: String = "editor"

const uiModeShortState: String = "short"

# A window under this many points tall gets the `short` state
const uiModeShortWindowPoints: Float = 520.0

# Is a window `height` points tall short (a phone on its side)?
func isShortWindowHeight(height: view Float) ret Bool {
  ret height > 0.0 and height < uiModeShortWindowPoints
}

# The scene states active for a mode and window shape.
func uiModeStates(editor: view Bool, short: view Bool) ret List(String) {
  var states: List(String) = List.create(String, cap: 2)
  if editor {
    states.add(value: uiModeEditorState)
  }
  if short {
    states.add(value: uiModeShortState)
  }
  ret states
}

# The main pointer the frames are picked for: a finger while a desktop
# simulates a phone (the "..." menu's "Simulate mobile phone"), so its
# touch-only controls show; else the device's own (a phone, or a tablet with
# a trackpad, keeps what it has)
func framePointerFor(
  pointer: view Pointer
  simulateMobile: view Bool
  mobileOs: view Bool
) ret Pointer {
  if simulateMobile and mobileOs is false {
    ret Pointer.coarse
  }
  ret pointer
}

# This app's frame pointer now
func uiModesPointer(menu: view ModeMenuState) ret Pointer {
  ret framePointerFor(
    pointer: primaryPointer()
    simulateMobile: menu.simulateMobile
    mobileOs: Target.isMobileOs
  )
}

# Apply the scene's frames (for the frame pointer) and its states (the mode,
# the window shape).
func applyUiModes(world: mod UiWorld, uiSystems: mod UiSystems, uiModes: view UiModes) {
  applySceneFramesToPageWithStatesFor(
    world: world
    uiSystems: uiSystems
    scene: uiModes.scene
    pageId: ""
    windowPtW: world.layoutW
    pointer: uiModes.pointer
    forcedFrameId: Sys.getEnv(name: "RAE_UI_FRAME")
    activeStates: uiModeStates(editor: uiModes.editor, short: uiModes.short)
  )
}

# Read `path`'s frames and states and apply them for now: GAME mode (EDITOR
# under RAE_UI_MODE=editor), the main pointer, the window's shape.
func createUiModes(world: mod UiWorld, uiSystems: mod UiSystems, path: view String) ret UiModes {
  let scene: Scene = loadSceneFile(path: path)
  let modeMenu: ModeMenuState = createModeMenuState()
  let uiModes: UiModes = {
    scene: own scene
    pointer: uiModesPointer(menu: modeMenu)
    editor: Sys.getEnv(name: "RAE_UI_MODE") is "editor"
    short: isShortWindowHeight(height: world.layoutH)
    generation: 1
    modeMenu: modeMenu
  }
  applyUiModes(world: world, uiSystems: uiSystems, uiModes: uiModes)
  ret uiModes
}

# Switch to the other mode now (and apply it).
func setUiModeEditor(
  world: mod UiWorld
  uiSystems: mod UiSystems
  uiModes: mod UiModes
  editor: view Bool
) {
  uiModes.editor = editor
  uiModes.generation = uiModes.generation + 1
  applyUiModes(world: world, uiSystems: uiSystems, uiModes: uiModes)
}

# The frame pointer changed (a trackpad case on an iPad, "Simulate mobile
# phone" switched), or the window turned short or tall (a phone rotated):
# apply the frames and states again. True when it did (the caller lays the UI
# out again).
func updateUiModes(world: mod UiWorld, uiSystems: mod UiSystems, uiModes: mod UiModes) ret Bool {
  let pointer: Pointer = uiModesPointer(menu: uiModes.modeMenu)
  let short: Bool = isShortWindowHeight(height: world.layoutH)
  if pointer is uiModes.pointer and short is uiModes.short {
    ret false
  }
  uiModes.pointer = pointer
  uiModes.short = short
  uiModes.generation = uiModes.generation + 1
  applyUiModes(world: world, uiSystems: uiSystems, uiModes: uiModes)
  ret true
}

# The debug readout (lib/ui DebugOverlay: its button, fps and memory lines) is
# about this tall (pt), and keeps this far from the "..." button
const uiModeReadoutHeight: Float = 80.0

const uiModeReadoutGap: Float = 8.0

# Place the debug readout by the scene's "..." button (node `buttonNodeId`),
# which holds the window's top-right corner in both modes: in the corner itself
# when the top row leaves room above it (a phone upright, under its notch),
# else just left of the button, level with it. Call after layout, every frame.
func placeDebugOverlayByModeButton(
  world: view UiWorld
  uiSystems: view UiSystems
  debugOverlay: mod DebugOverlay
  buttonNodeId: view String
) {
  let button: EntityId = nodeEntityFor(world: world, nodeId: buttonNodeId)
  if isNone(this: button) or uiEntityActive(world: world, entityId: button) is false or componentHas(
    this: uiSystems.transform2d.worldTransforms
    entityId: button
  ) is false {
    placeDebugOverlay(debugOverlay: debugOverlay, right: 0.0, top: 0.0)
    ret
  }
  let placed: view WorldTransform2D = componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: button
  )
  if placed.position.y < uiModeReadoutHeight {
    placeDebugOverlay(
      debugOverlay: debugOverlay
      right: placed.position.x - uiModeReadoutGap
      top: placed.position.y
    )
  } else {
    placeDebugOverlay(debugOverlay: debugOverlay, right: 0.0, top: 0.0)
  }
}
