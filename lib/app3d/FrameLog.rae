# app3d/FrameLog — a frame-time log an app turns on by owning a FrameLog and
# calling frameLogUpdate once a frame (from its own frame loop, not a headless
# test's): every `frameLogPeriodSeconds` one "[frames]" line with how the last
# period's frames went — their median and 95th percentile, how many missed the
# dynamic-resolution controller's budget — and where the resolution stands
# (the 3D scene's size in pixels, the dynamic scale, the frame cap, the OS
# thermal state). On a phone the line lands in the app's log file, where a
# device profile (tools/ios/profile-ios.sh) reads it. The line's rules are
# pure. After it, one "[draws]" line a pass (lib/DrawStats): what the last frame's
# G-buffer or pre-pass, forward pass and each shadow cascade drew, by kind.
# Under a profiler capture (RAE_PROFILE) frameLogCounters puts the same numbers in
# the trace once a frame: frame.us, scene.width/height and the draws by pass.
import Math
import Profile
open DrawStats
open gpu/FramePacer
open gpu/GpuTiming
open RendererDeferred
open app3d/RenderScale

const frameLogPeriodSeconds: Float = 5.0

# Is a line due, `sinceLog` s after the last?
func frameLogDue(sinceLog: view Float) ret Bool {
  ret sinceLog >= frameLogPeriodSeconds
}

# The frame time (s) `share` of the way up `frameTimes` sorted (0.5 the
# median, 0.95 the 95th percentile, by nearest rank); 0 with none.
func frameTimePercentile(frameTimes: view List(Float), share: view Float) ret Float {
  if frameTimes.length is 0 {
    ret 0.0
  }
  var sorted: List(Float) = List.create(Float, cap: frameTimes.length)
  loop let time: view Float in frameTimes {
    var at: Int = sorted.length
    loop at > 0 and sorted.copyAtFallback(index: at - 1, fallback: 0.0) > time {
      at = at - 1
    }
    sorted.insert(index: at, value: time)
  }
  var rank: Int = Math.ceil(x: share * sorted.length.toFloat()).toInt() - 1
  rank = Math.max(a: 0, b: Math.min(a: sorted.length - 1, b: rank))
  ret sorted.copyAtFallback(index: rank, fallback: 0.0)
}

# How many of `frameTimes` took longer than `overSeconds`.
func slowFrameCount(frameTimes: view List(Float), overSeconds: view Float) ret Int {
  var slow: Int = 0
  loop let time: view Float in frameTimes {
    if time > overSeconds {
      slow = slow + 1
    }
  }
  ret slow
}

# `seconds` as milliseconds to a tenth ("16.7").
func millisecondsText(seconds: view Float) ret String {
  let tenths: Int = Math.round(x: seconds * 10000.0).toInt()
  ret "{tenths / 10}.{tenths % 10}"
}

# `value` to a hundredth ("0.70").
func hundredthsText(value: view Float) ret String {
  let hundredths: Int = Math.round(x: value * 100.0).toInt()
  let fraction: Int = hundredths % 100
  if fraction < 10 {
    ret "{hundredths / 100}.0{fraction}"
  }
  ret "{hundredths / 100}.{fraction}"
}

func frameLogLine(
  frameTimes: view List(Float)
  overSeconds: view Float
  scale: view Float
  capFps: view Float
  thermal: view Int
  sceneWidth: view Int
  sceneHeight: view Int
) ret String {
  let median: String = millisecondsText(
    seconds: frameTimePercentile(frameTimes: frameTimes, share: 0.5)
  )
  let p95: String = millisecondsText(
    seconds: frameTimePercentile(frameTimes: frameTimes, share: 0.95)
  )
  let slow: Int = slowFrameCount(frameTimes: frameTimes, overSeconds: overSeconds)
  ret "[frames] {frameTimes.length} in {frameLogPeriodSeconds.toInt()} s: median {median} ms, p95 {p95} ms, {slow} over {millisecondsText(
    seconds: overSeconds
  )} ms; scene {sceneWidth}x{sceneHeight}, scale {hundredthsText(value: scale)}, cap {capFps.toInt()} fps, thermal {thermal}"
}

# The frames since the last line, and the time since it
type FrameLog {
  times: List(Float)
  sinceLog: Float
}

func createFrameLog() ret FrameLog {
  ret FrameLog { times: List.create(Float, cap: 512), sinceLog: 0.0 }
}

# One frame of `deltaTime` s: collected, and the line logged when one is due,
# from the controller `drs` and the scene `renderer` draws. True when it logged.
func frameLogUpdate(
  frameLog: mod FrameLog
  deltaTime: view Float
  drs: view RenderScaleController
  renderer: view DeferredRenderer
) ret Bool {
  if deltaTime > 0.0 {
    frameLog.times.add(value: deltaTime)
    frameLog.sinceLog = frameLog.sinceLog + deltaTime
  }
  if frameLogDue(sinceLog: frameLog.sinceLog) is false {
    ret false
  }
  log(frameLogLine(
    frameTimes: frameLog.times
    overSeconds: drs.overBudgetSeconds
    scale: drs.scale
    capFps: drs.capFps
    thermal: thermalState()
    sceneWidth: renderer.passes.gbuffer.targetWidth
    sceneHeight: renderer.passes.gbuffer.targetHeight
  ))
  frameLog.times.clear()
  frameLog.sinceLog = 0.0
  ret true
}

# The "[draws]" lines of the frame just drawn. Grass is drawn by a count on the GPU, so the
# caller reads it back and hands it in, for each pass that draws the scene.
func frameLogDraws(
  renderer: mod DeferredRenderer
  grassBlades: view Int
  grassTriangles: view Int
) {
  if drawStatsTotalInstances(stats: renderer.passes.gbuffer.drawStats) > 0 {
    drawStatsAdd(
      stats: renderer.passes.gbuffer.drawStats
      kind: DrawKind.grass
      instances: grassBlades
      triangles: grassTriangles
    )
  }
  if drawStatsTotalInstances(stats: renderer.passes.gbuffer.forwardDrawStats) > 0 {
    drawStatsAdd(
      stats: renderer.passes.gbuffer.forwardDrawStats
      kind: DrawKind.grass
      instances: grassBlades
      triangles: grassTriangles
    )
    log(drawStatsLine(name: "pre-pass", stats: renderer.passes.gbuffer.drawStats))
    log(drawStatsLine(name: "forward", stats: renderer.passes.gbuffer.forwardDrawStats))
  } else {
    log(drawStatsLine(name: "gbuffer", stats: renderer.passes.gbuffer.drawStats))
  }
  loop var cascade: Int = 0, cascade < renderer.passes.shadow.cascadeCount, ++cascade {
    if let stats: view DrawStats = renderer.passes.shadow.drawStats.viewAt(index: cascade) {
      log(drawStatsLine(name: "shadow cascade {cascade}", stats: stats))
    }
  }
}

# This frame's numbers into a profiler capture (lib/Profile): its time (frame.us), the
# scene's size, and what the last frame drew (draws.<pass>.instances / .triangles, the
# shadow cascades summed). Nothing while the profiler is not capturing.
func frameLogCounters(
  profiler: mod Profiler
  deltaTime: view Float
  renderer: view DeferredRenderer
) {
  if not Profile.capturing(profiler: profiler) {
    ret
  }
  Profile.counter(profiler: profiler, name: "frame.us", value: (deltaTime * 1000000.0).toInt())
  frameBoundCounters(profiler: profiler, renderer: renderer)
  Profile.counter(
    profiler: profiler
    name: "scene.width"
    value: renderer.passes.gbuffer.targetWidth
  )
  Profile.counter(
    profiler: profiler
    name: "scene.height"
    value: renderer.passes.gbuffer.targetHeight
  )
  let gbuffer: view DrawStats = renderer.passes.gbuffer.drawStats
  Profile.counter(
    profiler: profiler
    name: "draws.gbuffer.instances"
    value: drawStatsTotalInstances(stats: gbuffer)
  )
  Profile.counter(
    profiler: profiler
    name: "draws.gbuffer.triangles"
    value: drawStatsTotalTriangles(stats: gbuffer)
  )
  let forward: view DrawStats = renderer.passes.gbuffer.forwardDrawStats
  if drawStatsTotalInstances(stats: forward) > 0 {
    Profile.counter(
      profiler: profiler
      name: "draws.forward.instances"
      value: drawStatsTotalInstances(stats: forward)
    )
    Profile.counter(
      profiler: profiler
      name: "draws.forward.triangles"
      value: drawStatsTotalTriangles(stats: forward)
    )
  }
  var shadowInstances: Int = 0
  var shadowTriangles: Int = 0
  loop var cascade: Int = 0, cascade < renderer.passes.shadow.cascadeCount, ++cascade {
    if let stats: view DrawStats = renderer.passes.shadow.drawStats.viewAt(index: cascade) {
      shadowInstances = shadowInstances + drawStatsTotalInstances(stats: stats)
      shadowTriangles = shadowTriangles + drawStatsTotalTriangles(stats: stats)
    }
  }
  Profile.counter(profiler: profiler, name: "draws.shadow.instances", value: shadowInstances)
  Profile.counter(profiler: profiler, name: "draws.shadow.triangles", value: shadowTriangles)
}

# The last frame's split (gpu/FramePacer: the CPU's own work, the drawable acquire, the wait for
# the GPU) and the GPU's busy time (the pass timing's last sample, RAE_GPU_PASS_TIMING) as
# counters, and a mark naming which of the CPU, the GPU and the drawable bounds the frame: the
# largest of the three
func frameBoundCounters(profiler: mod Profiler, renderer: view DeferredRenderer) {
  let pacer: view FramePacer = renderer.canvas.framePacer
  if pacer.lastFrameSeconds <= 0.0 {
    ret
  }
  let cpuUs: Int = (pacer.lastCpuSeconds * 1000000.0) as Int
  let drawableUs: Int = (pacer.lastAcquireSeconds * 1000000.0) as Int
  Profile.counter(profiler: profiler, name: "frame.cpu.us", value: cpuUs)
  Profile.counter(profiler: profiler, name: "frame.drawable.us", value: drawableUs)
  Profile.counter(
    profiler: profiler
    name: "frame.gpuWait.us"
    value: (pacer.lastWaitSeconds * 1000000.0) as Int
  )
  var gpuUs: Int = -1
  if let timing: view GpuTiming = renderer.passTiming.timing {
    gpuUs = lastTotalUs(timing: timing)
  }
  if gpuUs >= 0 {
    Profile.counter(profiler: profiler, name: "gpu.busy.us", value: gpuUs)
  }
  var bound: String = "bound by the CPU"
  if gpuUs > cpuUs and gpuUs >= drawableUs {
    bound = "bound by the GPU"
  } else if drawableUs > cpuUs and drawableUs > gpuUs {
    bound = "bound by the drawable"
  }
  Profile.mark(profiler: profiler, name: bound, extra: 0)
}
