# app3d/WalkerCharacter — the walker: a skinned character (a glTF skeleton
# and its idle / walk / run clips) that is the player's hero plus a crowd of
# independently animated members, standing on a WorldBiome terrain. Used by
# the walker examples (136, 137, 143). Holds the WalkerCharacters state, the
# clip set and its playback (the speed->clip mapping, posing the shared
# skeleton into a joint palette), the gait thresholds the physics reads back
# with, the model matrix of a character and its spawn onto land. Everything
# that needs the terrain takes the app's BiomeConfig.
import Math
import Vec3
import Quat
open Scene3d
open Mesh3d
open Math3d
open Gltf
open GltfSkin
open GbufferInstanced
open WorldBiome
open ecs/Entity
open app3d/CharacterController

# Below this horizontal speed (m/s) a character stands; below the next it walks;
# below the last it walks fast; past it it runs
const standSpeed: Float = 0.25

const walkSpeedLimit: Float = 2.4

const walkFastSpeedLimit: Float = 3.6

# The animated character: the player-controlled hero plus a `crowd` of
# independently-animated members. #739: the hero's controller and each crowd
# member are now ENTITIES in the GameWorld — `heroEntityId` carries the hero's
# ThirdPersonController; `crowdEntities` are the crowd members, each an entity
# with a ThirdPersonController + AnimationState{clipIndex,animTime} + Transform3D.
# They're driven in place via componentMod (no copy-out/mutate/set-back), and
# each member's render model is derived from its controller (walkerWorldModel).
type WalkerCharacters {
  # The toe bones the wading splashes follow (water/WadeSplash); -1 without
  leftFootNode: Int = -1
  rightFootNode: Int = -1
  skeleton: Skeleton
  idleClip: Clip
  walkClip: Clip
  runClip: Clip
  bindPose: SkeletonPose
  transitionFrom: SkeletonPose
  transitionElapsed: Float
  heroEntityId: EntityId
  clipIndex: Int
  playing: Bool
  speed: Float
  animTime: Float
  toon: Bool
  basePartModel: Mat4
  model: Mat4
  prevModel: Mat4
  crowdEntities: List(EntityId)
  crowdBatch: InstanceBatch
  groundZ: Float
  # The hero is in the air (a jump, a fall): its run clip plays slowed, as
  # there is no jump clip
  airborne: Bool
}

# The character's locomotion clips (idle=0 … run=3). clipIndex stays an Int for
# storage/serialisation; this enum drives the exhaustive `match`es that dispatch
# on it, and the panel button id is just `.toString()` so no index->name table.
# The clips a walker may play; an app with jumps has their clips too
enum ClipKind {
  idle
  walk
  walkFast
  run
  jump
  runningJump
}

# the walk clip at 1.6x, not a fourth asset

# The clip a character's mover implies, from its actual horizontal speed:
# idle when it stands, walk / walkFast / run by speed, so a character pushing
# against something reads as pushing, not running in place. In the air it is
# the run clip (played slowed: there is no jump clip).
func moverClipFor(speed: view Float, grounded: view Bool) ret Int {
  if grounded is false {
    ret ClipKind.run as Int
  }
  if speed < standSpeed {
    ret ClipKind.idle as Int
  }
  if speed < walkSpeedLimit {
    ret ClipKind.walk as Int
  }
  if speed < walkFastSpeedLimit {
    ret ClipKind.walkFast as Int
  }
  ret ClipKind.run as Int
}

# A deterministic, lively clip mix for the crowd (#547): each member animates
# independently of the player, so the roster reads as distinct characters.
func crowdClipFor(index: view Int) ret Int {
  let pick: Int = index % 3
  if pick is 0 {
    ret ClipKind.walk as Int
  }
  if pick is 1 {
    ret ClipKind.run as Int
  }
  ret ClipKind.idle as Int
}

# Playback rate for a clip: walkFast is the walk clip at 1.6x, everything else
# plays at authored speed.
func clipPlaybackRate(clipIndex: view Int) ret Float {
  if clipIndex is ClipKind.walkFast {
    ret 1.6
  }
  ret 1.0
}

func walkerFloatAt(values: view List(Float), index: view Int) ret Float {
  if let value: Float = values.copyAt(index: index) {
    ret value
  }
  ret 0.0
}

func walkerIntAt(values: view List(Int), index: view Int) ret Int {
  if let value: Int = values.copyAt(index: index) {
    ret value
  }
  ret 0
}

# Pose the shared skeleton at a given clip + time, then extract the joint palette
# (#547). Used to build a DISTINCT pose per crowd member — the skeleton is scratch
# here, re-posed each call; the hero's palette is built separately, before this
# runs, so re-posing does not disturb it.
func poseCharacterPalette(
  walkerCharacters: mod WalkerCharacters
  clipIndex: copy Int
  animTime: copy Float
) ret List(Float) {
  applySkeletonPose(sk: walkerCharacters.skeleton, pose: walkerCharacters.bindPose)
  match clipIndex {
    case ClipKind.idle {
      applyClip(sk: walkerCharacters.skeleton, c: walkerCharacters.idleClip, time: animTime)
    }
    case ClipKind.walk {
      applyClip(sk: walkerCharacters.skeleton, c: walkerCharacters.walkClip, time: animTime)
    }
    case ClipKind.walkFast {
      applyClip(sk: walkerCharacters.skeleton, c: walkerCharacters.walkClip, time: animTime)
    }
    case ClipKind.run {
      applyClip(sk: walkerCharacters.skeleton, c: walkerCharacters.runClip, time: animTime)
    }
  }
  ret buildPalette(sk: walkerCharacters.skeleton)
}

# Where "Orbit" re-centres: THE CHARACTER'S MIDDLE, not the world floor. The
# model is normalised to 2.0 tall on groundZ (-1.0), spanning z -1..+1, centre 0.
const orbitFocusZ: Float = 0.0

# Where the CHARACTER camera looks, relative to the controller position: the
# head. +0.9 is eye level just under the crown — over-the-shoulder framing.
const characterFocusZ: Float = 0.9

# Put a controller on the nearest land and ground it there.
# The spawn goes to the nearest MEADOW, not the nearest land: land nearest the
# coast is beach, and a first frame of sand and surf misrepresents the island.
func spawnOnLand(
  controller: mod ThirdPersonController
  groundZ: view Float
  biome: view BiomeConfig
) {
  let spot: Vec3 = worldFindGrass(x: controller.position.x, y: controller.position.y, cfg: biome)
  controller.position.x = spot.x
  controller.position.y = spot.y
  groundWalker(controller: controller, groundZ: groundZ, biome: biome)
}

# Blender is Z-up but does not mandate one object-facing axis. This asset's
# authored front becomes -Y after the glTF Y-up -> Rae Z-up conversion, while
# Rae gameplay forward is +Y. Correct that at the asset-placement boundary.
const walkerFacingCorrection: Float = 3.141592653589793

func walkerWorldModel(baseModel: view Mat4, controller: view ThirdPersonController) ret Mat4 {
  let worldTranslation: Mat4 = mat4Translate(
    x: controller.position.x
    y: controller.position.y
    z: controller.position.z
  )
  # #745: heading -> quat rotation about Z (not a Euler axis matrix).
  let worldHeading: Mat4 = Quat.toMat4(
    q: Quat.fromAxisAngle(
      axis: Vec3.create(x: 0.0, y: 0.0, z: 1.0)
      angle: controller.heading + walkerFacingCorrection
    )
  )
  ret mat4Mul(a: worldTranslation, b: mat4Mul(a: worldHeading, b: baseModel))
}

# The character's walk ray: sample the terrain height field straight down at the
# character's x/y and stand on the hit. The field is analytic (the app's
# biome, worldTerrainHeight), so the raycast is one function call. position.z is the DELTA
# above the flat groundZ baked into the model's base transform.
func groundWalker(
  controller: mod ThirdPersonController
  groundZ: view Float
  biome: view BiomeConfig
) {
  controller.position.z = worldTerrainHeight(
    x: controller.position.x
    y: controller.position.y
    groundZ: groundZ
    cfg: biome
  ) - groundZ
}
