# app3d/PlayerRoster — who controls which walker character (#546). Today there
# is one LOCAL player. The roster maps that player to a CONTROLLED character
# index: 0 = the hero, 1..count-1 = crowd member (index - 1). Switching (Page
# Up / Page Down, or the settings buttons) moves the local player between
# characters; the non-controlled characters run their own animation. This is
# the seam multiplayer builds on: a second player would take another index,
# and a remote player's control would arrive over the network instead of a
# device.
import Keys
open ecs/Entity

# The local player's id. (Naming: constants are camelCase — #746 fixed the old
# SHOUTING_SNAKE_CASE `PLAYER_LOCAL`, which the language bans.)
const playerLocal: Int = 0

# Character-switch key bindings, named from the canonical SDL scancodes in
# lib/keys.rae. 1 / Page Up go to the previous character, 2 / Page Down to the
# next (Page Up/Down are used via keys.keyPageUp/keyPageDown at the call site).
const keyPrevChar: Int = Keys.key1

const keyNextChar: Int = Keys.key2

# The local player's control mapping: `entities`, the controllable
# characters in the order switching cycles through (the walker's: the hero,
# then its crowd); `controlledIndex`, the position of the one the player
# drives.
type PlayerRoster {
  controlledIndex: Int
  entities: List(EntityId)
}

func createPlayerRoster(entities: own List(EntityId)) ret PlayerRoster {
  ret PlayerRoster { controlledIndex: 0, entities: own entities }
}

func rosterCount(roster: view PlayerRoster) ret Int {
  ret roster.entities.length
}

# The character at roster position `index` (none past the end)
func rosterEntityAt(roster: view PlayerRoster, index: view Int) ret EntityId {
  if let entity: EntityId = roster.entities.copyAt(index: index) {
    ret entity
  }
  ret noEntity()
}

func rosterControlledIsHero(roster: view PlayerRoster) ret Bool {
  ret roster.controlledIndex is 0
}

# "hero" for roster position 0, "crowd <i>" for the characters after it
func rosterSlotLabel(roster: view PlayerRoster) ret String {
  if roster.controlledIndex is 0 {
    ret "hero"
  }
  ret "crowd {roster.controlledIndex - 1}"
}

# The ENTITY the local player currently controls (#746): the roster's ECS
# view — the same kind of character-entity handle a NetPlayer points at via
# `controlled`, so local and remote control resolve identically.
func rosterControlledEntityId(players: view PlayerRoster) ret EntityId {
  ret rosterEntityAt(roster: players, index: players.controlledIndex)
}

# Move control `step` positions on (+1 next, -1 previous; wraps). No-op with
# one character, so a roster of just the hero behaves exactly as before.
func rosterStep(roster: mod PlayerRoster, step: view Int) {
  let count: Int = rosterCount(roster: roster)
  if count <= 1 {
    ret
  }
  roster.controlledIndex = (roster.controlledIndex + count + step) % count
}

func rosterSwitchNext(roster: mod PlayerRoster) {
  rosterStep(roster: roster, step: 1)
}

func rosterSwitchPrev(roster: mod PlayerRoster) {
  rosterStep(roster: roster, step: -1)
}
