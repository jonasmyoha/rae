# Dynamic-resolution controller (#530): keeps the frame at the target rate by
# lowering the deferred render scale when frames miss the budget and raising it
# back after a sustained stretch of good frames. The scene renders at that
# fraction and the composite pass upscales it (lib/gbufferPasses.rae), so fewer
# shaded pixels = less sustained GPU load = the phone throttles later / not at all.
#
# Signal: wall-clock frame time (dt). Under vsync this is coarse (≈16.7ms at 60,
# ≈33ms at 30), so the loop reacts to DROPPED frames rather than fine headroom:
# drop scale fast on consecutive over-budget frames, raise it one slow step after
# a long good stretch, with a cooldown so it can't oscillate.
#
# Missed frames that never come 4 in a row (a GPU frame just over the period
# gives 16.7 / 33 ms alternately, or a slow frame every few) also lower the
# scale: the controller keeps which of the last missWindow frames missed, and
# steps down when missWindowLimit of them did. Only the resolution reacts to
# that; the 30 fps cap still needs the streak, since scattered misses at 60
# still beat a steady 30. When real per-pass
# GPU timing (#528) lands, swap `dt` for measured GPU ms for a tighter loop.
#
# While the 30 fps cap holds, dt is the PADDED period (capFrameSleep sleeps
# every frame up to 33 ms), which is always over budget — judged by dt, a capped
# frame could never count as good and the cap never lifted. So a capped frame is
# judged by its WORK time instead: the time from the frame's start to just
# before the padding sleep, which capFrameSleep records on the controller.
#
#   var drs: RenderScaleController = createRenderScaleController(targetFps: 60.0)
#   updateRenderScale(drs: drs, deltaTime: deltaTime, profiler: profiler)
#   ...render...
#   capFrameSleep(drs: drs, frameStartSec: frameStart)        # end of the frame
#   setDynamicRenderScale(renderer: renderer, scale: drs.scale)   # the renderer draws at it
import Gpu2d
import Profile
import Sys
open RenderResolution

# OS thermal pressure (Apple's NSProcessInfo, runtime_platform_apple.c): 0
# nominal, 1 fair, 2 serious, 3 critical. Other platforms have no such API, so
# their state is always nominal.
when Target.isApple {
  func nativeThermalState() unsafe extern("rae_ext_thermalState") ret Int
}

func thermalState() ret Int {
  when Target.isApple {
    unsafe {
      ret nativeThermalState()
    }
  } else {
    ret 0
  }
}

# Scale ceiling for the current OS thermal state — proactively cap resolution
# BEFORE frames drop, which is the whole point of reading thermalState: reacting
# only to dropped frames means the device is already hot.
func thermalCeiling(therm: view Int) ret Float {
  if therm >= 3 {
    ret 0.5
  }
  if therm >= 2 {
    ret 0.7
  }
  ret 1.0
}

# A two-rung quality ladder against sustained GPU load: first lower the render
# scale (1.0 -> 0.5), and only when that bottoms out and frames still miss, drop
# the frame-rate cap to 30 (halving the GPU duty cycle so the SoC cools — a clean
# divisor is smoother than a jittery throttled ~20 too). Recovery restores the
# rate first, then the resolution.
# The frames the miss window looks back over, and the misses in it that step
# the scale down (10%: a 2 s stretch of about 54 fps or worse)
const missWindow: Int = 60

const missWindowLimit: Int = 6

# Good frames in a row before a rung is restored (3 s), and the most that wait
# grows to (60 s). A raise followed by a drop within raiseHoldFrames (10 s) was
# too early: the next raise waits twice as long. A raise that holds 10 s brings
# the wait back to 3 s. Without this, a scene that misses only at the higher
# rung climbs back every 3 s and starts missing again.
const baseRaiseFrames: Int = 180

const maxRaiseFrames: Int = 3600

const raiseHoldFrames: Int = 600

type RenderScaleController {
  scale: Float
  maxScale: Float  # 1.0, or what RAE_RENDER_SCALE forces: the ladder never climbs above it
  minScale: Float
  step: Float
  capFps: Float  # 60 normally; 30 = bottom rung frame cap
  overBudgetSec: Float  # a frame slower than this counts as "missed"
  overFrames: Int  # consecutive missed frames
  goodFrames: Int  # consecutive good frames
  missBits: Int  # bit i set = the frame i frames ago missed (the last missWindow frames)
  windowFrames: Int  # frames in the window so far (up to missWindow)
  windowMisses: Int  # set bits in missBits
  raiseFrames: Int  # good frames in a row the next raise needs (backs off)
  sinceRaise: Int  # frames since the last raise, up to raiseHoldFrames
  cooldown: Int  # frames to wait after a change (anti-oscillation)
  workSec: Float  # the last capped frame's work time, before the cap's padding
  workMeasured: Bool  # capFrameSleep measured workSec and no update used it yet
  thermalCap: Bool  # the 30 fps cap was forced by a critical thermal state
  # RAE_DRS=off: the ladder never moves (the scale stays at its maximum, 60
  # fps), so two runs compare at the same resolution whatever their frames do
  fixed: Bool
  lastThermal: Int  # the OS thermal state last logged (-1: none yet)
}

func createRenderScaleController(targetFps: copy Float) ret RenderScaleController {
  var fps: Float = targetFps
  if fps < 1.0 {
    fps = 60.0
  }
  # Missed = 25% over the target period (e.g. >20.8ms for 60fps) — clearly not
  # holding the rate, not just jitter.
  let maxScale: Float = renderScaleFromEnv()
  ret RenderScaleController {
    scale: maxScale
    maxScale: maxScale
    minScale: 0.5
    step: 0.1
    capFps: 60.0
    overBudgetSec: 1.25 / fps
    overFrames: 0
    goodFrames: 0
    missBits: 0
    windowFrames: 0
    windowMisses: 0
    raiseFrames: baseRaiseFrames
    sinceRaise: raiseHoldFrames
    cooldown: 0
    workSec: 0.0
    workMeasured: false
    thermalCap: false
    fixed: Sys.getEnv(name: "RAE_DRS") is "off"
    lastThermal: -1
  }
}

# Feed one frame's dt (seconds). Reads the OS thermal state and walks the
# ladder (stepRenderScale); the app hands drs.scale to the renderer
# (setDynamicRenderScale), which draws its scene at that fraction of the
# render-resolution ceiling (lib/RenderResolution).
func updateRenderScale(
  drs: mod RenderScaleController
  deltaTime: copy Float
  profiler: mod Profiler
) {
  let therm: Int = thermalState()
  # Every change of the OS thermal state is logged: two measured runs are
  # comparable only at the same one
  if therm is not drs.lastThermal {
    drs.lastThermal = therm
    log("[drs] thermal state {therm}")
  }
  let scaleBefore: Float = drs.scale
  let capBefore: Float = drs.capFps
  stepRenderScale(drs: drs, deltaTime: deltaTime, therm: therm)
  if drs.scale is not scaleBefore or drs.capFps is not capBefore {
    let percent: Int = (drs.scale * 100.0 + 0.5).toInt()
    log("[drs] render scale {percent}%, cap {drs.capFps.toInt()} fps, thermal state {therm}")
  }
  # Surface the current tier in profile captures: render.scale (percent), the
  # frame cap, and the OS thermal state, plotted alongside fps / per-pass GPU ms.
  unsafe {
    Profile.counter(
      profiler: profiler
      name: "render.scale"
      value: rae_float_to_int(f: drs.scale * 100.0)
    )
    Profile.counter(
      profiler: profiler
      name: "render.capFps"
      value: rae_float_to_int(f: drs.capFps)
    )
  }
  Profile.counter(profiler: profiler, name: "thermal.state", value: therm)
}

# One frame of the ladder, given the frame's dt and the OS thermal state (0
# nominal .. 3 critical). Drop fast after 4 missed frames in a row or 6 of the
# last 60 (the scale only), restore one rung after ~3 s good (longer after a
# raise that did not hold, see baseRaiseFrames), 30-frame cooldown between moves. Pure — no native
# call — so a test
# can drive it frame by frame.
func stepRenderScale(drs: mod RenderScaleController, deltaTime: view Float, therm: view Int) {
  if drs.fixed {
    ret
  }
  # Proactive OS-thermal ceiling: snap the scale down (and force the 30fps cap at
  # critical) the moment the OS reports heat, without waiting for missed frames.
  var ceiling: Float = thermalCeiling(therm: therm)
  if drs.maxScale < ceiling {
    ceiling = drs.maxScale
  }
  if drs.scale > ceiling and drs.cooldown <= 0 {
    drs.scale = ceiling
    drs.cooldown = 30
  }
  if therm >= 3 and drs.capFps > 30.0 {
    drs.capFps = 30.0
    drs.thermalCap = true
  }

  # Under the cap, judge the frame by its work time, not by the padded dt
  var frameSec: Float = deltaTime
  if drs.capFps < 60.0 and drs.workMeasured {
    frameSec = drs.workSec
  }
  drs.workMeasured = false
  let missed: Bool = frameSec > drs.overBudgetSec
  if missed {
    drs.overFrames = drs.overFrames + 1
    drs.goodFrames = 0
  } else {
    drs.goodFrames = drs.goodFrames + 1
    drs.overFrames = 0
  }
  noteWindowFrame(drs: drs, missed: missed)
  if drs.sinceRaise < raiseHoldFrames {
    drs.sinceRaise = drs.sinceRaise + 1
    if drs.sinceRaise is raiseHoldFrames {
      drs.raiseFrames = baseRaiseFrames
    }
  }
  if drs.cooldown > 0 {
    drs.cooldown = drs.cooldown - 1
    ret
  }
  # A cap the heat forced lifts when the heat falls, not on frame times: the
  # frames did not cause it
  if drs.thermalCap and therm < 3 {
    drs.capFps = 60.0
    drs.thermalCap = false
    drs.cooldown = 30
    drs.goodFrames = 0
    drs.overFrames = 0
    ret
  }
  if drs.overFrames < 4 and windowMissesTooMany(drs: drs) and drs.scale > drs.minScale {
    drs.scale = drs.scale - drs.step
    if drs.scale < drs.minScale {
      drs.scale = drs.minScale
    }
    noteDrop(drs: drs)
    ret
  }
  if drs.overFrames >= 4 {
    if drs.scale > drs.minScale {
      drs.scale = drs.scale - drs.step
      if drs.scale < drs.minScale {
        drs.scale = drs.minScale
      }
      noteDrop(drs: drs)
    } else if drs.capFps > 30.0 {
      drs.capFps = 30.0  # bottom rung: cap to 30
      noteDrop(drs: drs)
    }
  } else if drs.goodFrames >= drs.raiseFrames {
    if drs.capFps < 60.0 and therm < 3 {
      drs.capFps = 60.0  # restore the rate before the resolution
      noteRaise(drs: drs)
    } else if drs.scale < ceiling {
      drs.scale = drs.scale + drs.step
      if drs.scale > ceiling {
        drs.scale = ceiling
      }
      noteRaise(drs: drs)
    }
  }
}

# A rung went down: wait out the cooldown, start a fresh miss window, and if
# the last raise was under raiseHoldFrames ago, make the next one wait longer
func noteDrop(drs: mod RenderScaleController) {
  drs.cooldown = 30
  drs.overFrames = 0
  clearWindow(drs: drs)
  if drs.sinceRaise < raiseHoldFrames {
    drs.raiseFrames = drs.raiseFrames * 2
    if drs.raiseFrames > maxRaiseFrames {
      drs.raiseFrames = maxRaiseFrames
    }
    drs.sinceRaise = raiseHoldFrames
  }
}

func noteRaise(drs: mod RenderScaleController) {
  drs.cooldown = 30
  drs.goodFrames = 0
  drs.sinceRaise = 0
}

# Push one frame into the miss window, dropping the one missWindow frames ago
func noteWindowFrame(drs: mod RenderScaleController, missed: view Bool) {
  if drs.windowFrames >= missWindow {
    if (drs.missBits shr (missWindow - 1)) bitand 1 is 1 {
      drs.windowMisses = drs.windowMisses - 1
    }
  } else {
    drs.windowFrames = drs.windowFrames + 1
  }
  drs.missBits = (drs.missBits shl 1) bitand ((1 shl missWindow) - 1)
  if missed {
    drs.missBits = drs.missBits bitor 1
    drs.windowMisses = drs.windowMisses + 1
  }
}

# A full window with missWindowLimit or more misses
func windowMissesTooMany(drs: view RenderScaleController) ret Bool {
  ret drs.windowFrames >= missWindow and drs.windowMisses >= missWindowLimit
}

# After a move, the frames before it no longer say anything about the new rung
func clearWindow(drs: mod RenderScaleController) {
  drs.missBits = 0
  drs.windowFrames = 0
  drs.windowMisses = 0
}

# Shadow-map resolution for the current tier. DRS scales the deferred targets but
# NOT the shadow map (it's a separate fixed-size depth texture), yet shadows are
# the dominant sustained cost in the walker scene — so shrink the shadow map with
# the scale too (1024² is a quarter of 2048²'s rasterized pixels). Cascade COUNT
# stays fixed so the lighting sampler is untouched; the shadow pass reallocates
# only when this value changes.
func drsShadowRes(drs: view RenderScaleController) pub ret Int {
  if drs.scale >= 0.85 {
    ret 2048
  }
  if drs.scale >= 0.65 {
    ret 1536
  }
  ret 1024
}

# Pad the current frame to the cap period by sleeping any slack (only meaningful
# at the 30fps rung; a no-op at 60 since vsync already paces there). Call at the
# end of the render branch with the frame's start time. The frame's work time —
# start to here, before the sleep — is recorded for the next updateRenderScale.
func capFrameSleep(drs: mod RenderScaleController, frameStartSec: copy Float64) {
  unsafe {
    if drs.capFps >= 60.0 {
      ret
    }
    let period: Float = 1.0 / drs.capFps
    let elapsed: Float = (Gpu2d.nowSeconds() - frameStartSec) as Float
    recordFrameWork(drs: drs, workSec: elapsed)
    if elapsed < period {
      sleep(ms: rae_float_to_int(f: (period - elapsed) * 1000.0))
    }
  }
}

# The frame's work time, start to just before the cap's padding sleep
func recordFrameWork(drs: mod RenderScaleController, workSec: view Float) {
  drs.workSec = workSec
  drs.workMeasured = true
}
