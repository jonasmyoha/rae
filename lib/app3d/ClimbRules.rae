# app3d/ClimbRules — the rules of climbing and of the stamina that pays for
# it (app3d/Climbing runs them on the movers; app3d/StaminaWheel shows the
# stamina). Pure, so tested without a physics engine.
#
# Anything steep enough is a wall: a tree's trunk, a house, a cliff or a
# rock, with nothing marked. A character pushing into one starts climbing;
# the stick moves it up, down and sideways along the wall; jump leaps up a
# stretch; at the top it pulls itself over. Climbing drains stamina while
# the climber moves (hanging still costs nothing) and a leap costs a chunk.
# Run out on a wall and the climber lets go; it is then exhausted, and may
# not climb again until the stamina has filled all the way. Stamina fills
# again on the ground a moment after it was last spent.
import Math
import Vec3

type ClimbTuning {
  # A surface whose normal's up part is under this is a wall (about 63
  # degrees and steeper); gentler ground is walked
  wallNormalUp: Float = 0.45
  # How far past the capsule's surface a wall is reached (m)
  reach: Float = 0.45
  # How far from the wall the capsule hangs (m)
  gap: Float = 0.05
  # Climbing speeds (m/s): up and down, and along
  climbSpeed: Float = 1.6
  sideSpeed: Float = 1.3
  # A leap: how far up (m) and how fast (m/s)
  leapHeight: Float = 1.4
  leapSpeed: Float = 4.5
  # How far onto the top a pull-up puts the feet (m), and how far down from
  # there the top may be found
  mantleForward: Float = 0.6
  mantleReach: Float = 0.8
  # The stick must point this much into the wall to start a climb
  pushIn: Float = 0.6
}

type StaminaTuning {
  maximum: Float = 100.0
  # Spent a second climbing while moving; a leap's cost
  climbPerSecond: Float = 9.0
  leapCost: Float = 20.0
  # Filled a second on the ground, after this long since it was last spent
  regainPerSecond: Float = 40.0
  regainDelay: Float = 0.6
  # Under this share it shows as low
  lowShare: Float = 0.25
  # The wheel shows while it is not full, and this long after it filled
  showAfterFull: Float = 1.0
}

# A character's stamina: how much is left, whether it ran out (and must fill
# all the way before a climb), how long since it was last spent, and how
# long since it was last full (for the wheel)
type Stamina {
  value: Float
  exhausted: Bool
  sinceSpent: Float
  sinceFull: Float
}

func fullStamina(tuning: view StaminaTuning) ret Stamina {
  ret Stamina { value: tuning.maximum, exhausted: false, sinceSpent: 1000.0, sinceFull: 1000.0 }
}

# Is a surface with `normal` a wall (steep enough to climb)?
func isClimbableWall(tuning: view ClimbTuning, normal: view Vec3) ret Bool {
  ret Math.abs(value: normal.z) < tuning.wallNormalUp
}

# May a character with `stamina` start (or keep) climbing?
func mayClimb(stamina: view Stamina) ret Bool {
  ret stamina.exhausted is false and stamina.value > 0.0
}

# `amount` spent: down to 0, and out of it the character is exhausted
func spendStamina(stamina: mod Stamina, amount: view Float) {
  if amount <= 0.0 {
    ret
  }
  stamina.value = Math.max(a: 0.0, b: stamina.value - amount)
  stamina.sinceSpent = 0.0
  if stamina.value <= 0.0 {
    stamina.exhausted = true
  }
}

# `deltaTime` s on: on the ground (`grounded`) it fills again a moment after
# it was last spent; full, it is no longer exhausted
func restStamina(
  stamina: mod Stamina
  tuning: view StaminaTuning
  grounded: view Bool
  deltaTime: view Float
) {
  stamina.sinceSpent = stamina.sinceSpent + deltaTime
  if grounded and stamina.sinceSpent >= tuning.regainDelay {
    stamina.value = Math.min(
      a: tuning.maximum
      b: stamina.value + tuning.regainPerSecond * deltaTime
    )
  }
  if stamina.value >= tuning.maximum {
    stamina.exhausted = false
    stamina.sinceFull = stamina.sinceFull + deltaTime
  } else {
    stamina.sinceFull = 0.0
  }
}

# Its share of the maximum (0..1)
func staminaShare(stamina: view Stamina, tuning: view StaminaTuning) ret Float {
  ret Math.max(a: 0.0, b: Math.min(a: 1.0, b: stamina.value / tuning.maximum))
}

# Does the wheel show? While not full, and a moment after it filled
func staminaWheelShows(stamina: view Stamina, tuning: view StaminaTuning) ret Bool {
  ret stamina.value < tuning.maximum or stamina.sinceFull < tuning.showAfterFull
}

# The heading (about +z; heading 0 faces +y) of a climber facing a wall whose
# outward normal is `normal`
func headingFacing(normal: view Vec3) ret Float {
  ret Math.atan2(y: normal.x, x: 0.0 - normal.y)
}

# The way a stick (`moveX` right, `moveY` forward) along `yaw` points on the
# ground (unit, or zero when it is let go); yaw 0 looks toward +y
func stickDirection(moveX: view Float, moveY: view Float, yaw: view Float) ret Vec3 {
  let forwardX: Float = 0.0 - Math.sin(x: yaw)
  let forwardY: Float = Math.cos(x: yaw)
  let rightX: Float = Math.cos(x: yaw)
  let rightY: Float = Math.sin(x: yaw)
  let x: Float = forwardX * moveY + rightX * moveX
  let y: Float = forwardY * moveY + rightY * moveX
  let length: Float = Math.sqrt(x: x * x + y * y)
  if length < 0.001 {
    ret Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  }
  ret Vec3.create(x: x / length, y: y / length, z: 0.0)
}

# Does a stick pointing `direction` push into a wall with `normal`?
func pushesInto(tuning: view ClimbTuning, direction: view Vec3, normal: view Vec3) ret Bool {
  let flat: Float = Math.sqrt(x: normal.x * normal.x + normal.y * normal.y)
  if flat < 0.001 {
    ret false
  }
  ret 0.0 - (direction.x * normal.x + direction.y * normal.y) / flat >= tuning.pushIn
}
