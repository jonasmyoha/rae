# Minimal deferred-scene HUD, backed by the shared DebugOverlay widget.
# Create the renderer with createDeferredRendererWithUi; update before camera
# input, then draw at RenderTag.uiOverlay. The renderer handles presentation.
# Its dialog's "Performance" row opens the perf HUD (ui/PerfHud); the HUD's
# threads and its save button read this HUD's own profiler, which records only
# while the perf HUD is open.
import Gpu2d
import Profile
open Gpu2dCanvas
import SdfText
open ui/DebugOverlay

type DebugHud {
  debugOverlay: DebugOverlay
  font: SdfFont
  profiler: Profiler
}

func createDebugHud(fontBase: view String) ret DebugHud {
  ret DebugHud {
    debugOverlay: createDebugOverlay(
      button: true
      fps: true
      memory: true
      heartbeat: false
    )
    font: SdfText.loadSdfFont(
      jsonPath: "{fontBase}.mtsdf.json"
      rawAtlasPath: "{fontBase}.mtsdf.raw"
    )
    profiler: Profile.createProfiler()
  }
}

# A visible dialog owns input until dismissed; the dismissing press is consumed.
func updateDebugHud(debugHud: mod DebugHud, now: copy Float64, rendered: copy Bool) ret Bool {
  let unusedWritten: Bool = Profile.tick(profiler: debugHud.profiler)
  debugOverlayPerf(debugOverlay: debugHud.debugOverlay, profiler: debugHud.profiler)
  let tookPointer: Bool = updateDebugOverlay(
    debugOverlay: debugHud.debugOverlay
    screenW: Gpu2d.designWidth()
    screenH: Gpu2d.designHeight()
    now: now
    didRealWork: rendered
  )
  ret tookPointer or debugHud.debugOverlay.open
}

func drawDebugHud(debugHud: mod DebugHud, canvas: mod Gpu2dCanvas) {
  Gpu2d.beginFrameLoad(canvas: canvas)
  drawDebugOverlay(
    debugOverlay: debugHud.debugOverlay
    canvas: canvas
    font: debugHud.font
    didRealWork: true
  )
}
