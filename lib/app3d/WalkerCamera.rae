# Camera rig + camera + scene light. (#548)
# #744: `rigEntityId` and `cameraEntityId` are the two WalkerWorld entities that express
# the rig as an ECS PARENT relation — camEntity is a child of rigEntity. The rig
# sits at the focus target oriented by yaw/pitch; the camera hangs a fixed
# distance behind it. TransformSystem composes the child's world position, which
# IS the camera eye — replacing the hand-rolled orbitEye trig in applyCameraRig.
type WalkerCamera {
  camera: Camera3d
  rig: CameraRig
  light: Light3d
  hosek: HosekDataset
  rigEntityId: EntityId
  cameraEntityId: EntityId
  # The character camera turns after the walker (lib/app3d/CameraWalkFollow)
  walkFollow: WalkFollow
}

# Create the rig->camera parent relation in the world (call once, at setup).
# Both entities carry an identity local Transform3D to start; applyCameraRig-
# Hierarchy rewrites them each frame from the CameraRig's view state.
func createCameraRigLink(world: mod WalkerWorld) ret CameraRigLink {
  let rigEntityId: EntityId = walkerWorldAddEntity(world: world)
  let cameraEntityId: EntityId = walkerWorldAddEntity(world: world)
  componentSet(this: world.transforms, entityId: rigEntityId, data: createTransform3D())
  componentSet(this: world.transforms, entityId: cameraEntityId, data: createTransform3D())
  setParent(
    parents: world.parents
    childrens: world.childrens
    child: cameraEntityId
    parent: rigEntityId
  )
  ret CameraRigLink { rigEntityId: rigEntityId, cameraEntityId: cameraEntityId }
}

# Resolve the camera eye from the rig->camera hierarchy, replacing applyCameraRig.
# Non-free modes: place rigEntity at the focus target, rotated by yaw then -pitch
# (matching orbitEye: eye = target + Rz(yaw)*Rx(-pitch)*(0,-distance,0)); the
# camEntity's local offset is (0, -distance, 0). TransformSystem folds child onto
# parent, and the composed world translation IS the eye. Free mode has no orbit
# rig, so it keeps the direct fly-camera placement.
func applyCameraRigHierarchy(cameraSystem: mod WalkerCamera, world: mod WalkerWorld) {
  if cameraSystem.rig.mode is not CameraRigMode.free {
    let qz: Quat = Quat.fromAxisAngle(
      axis: Vec3.create(x: 0.0, y: 0.0, z: 1.0)
      angle: cameraSystem.rig.viewYaw
    )
    let qx: Quat = Quat.fromAxisAngle(
      axis: Vec3.create(x: 1.0, y: 0.0, z: 0.0)
      angle: -cameraSystem.rig.viewOrbitPitch
    )
    componentSet(
      this: world.transforms
      entityId: cameraSystem.rigEntityId
      data: Transform3D {
        position: cameraSystem.camera.target
        rotation: Quat.qmul(a: qz, b: qx)
        scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      }
    )
    componentSet(
      this: world.transforms
      entityId: cameraSystem.cameraEntityId
      data: Transform3D {
        position: Vec3.create(x: 0.0, y: -cameraSystem.rig.viewDistance, z: 0.0)
        rotation: Quat.identity()
        scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      }
    )
    transformSystem3D(
      orderState: world.hierarchyOrder
      transforms: world.transforms
      worldTransforms: world.worldTransforms
      parents: world.parents
      childrens: world.childrens
    )
    let camWorld: view WorldTransform3D => componentView(
      this: world.worldTransforms
      entityId: cameraSystem.cameraEntityId
    )
    cameraSystem.camera.position = Vec3.create(
      x: mat4Get(m: camWorld.matrix, i: 12)
      y: mat4Get(m: camWorld.matrix, i: 13)
      z: mat4Get(m: camWorld.matrix, i: 14)
    )
  } else {
    let forward: Vec3 = cameraRigForward(rig: cameraSystem.rig)
    cameraSystem.camera.position = cameraSystem.rig.viewPosition
    cameraSystem.camera.target = Vec3.vadd(a: cameraSystem.camera.position, b: forward)
  }
}

# What a camera tick reports: the touch stick's active state (used by character
# movement) and whether the camera moved this frame (feeds needsRender).
type CameraTick {
  joyActive: Bool
  cameraMoved: Bool
}

# The GAME camera's eye stays this far over the terrain (m)
const cameraGroundClearance: Float = 0.3

# #743: consumes the narrow state it needs — the camera, the input/UI bundle,
# the persist dirty flag, the world + hero entity to read the followed
# controller, and the terrain the GAME camera stays above — not the whole App.
func cameraUpdate(
  uiSystems: mod UiSystems
  cameraSystem: mod WalkerCamera
  inputSystem: mod WalkerInput
  persist: mod WalkerPersist
  world: view WalkerWorld
  heroEntityId: view EntityId
  terrainSystem: view WalkerTerrain
  deltaTime: copy Float
) ret CameraTick {
  let previousMode: CameraRigMode = cameraSystem.rig.mode
  if handleCameraBar(world: inputSystem.world, rig: cameraSystem.rig, camera: cameraSystem.camera) {
    persist.stateDirty = true
  }
  if previousMode is not CameraRigMode.character and cameraSystem.rig.mode is CameraRigMode.character {
    cameraSystem.rig.yaw = controllerOf(world: world, entityId: heroEntityId).heading
    cameraSystem.rig.orbitPitch = 0.24
    cameraSystem.camera.target = thirdPersonCameraTarget(
      controller: controllerOf(world: world, entityId: heroEntityId)
      focusZ: characterFocusZ
    )
    snapCameraRigView(rig: cameraSystem.rig)
  }
  if previousMode is not CameraRigMode.orbit and cameraSystem.rig.mode is CameraRigMode.orbit {
    cameraSystem.camera.target = thirdPersonCameraTarget(
      controller: controllerOf(world: world, entityId: heroEntityId)
      focusZ: orbitFocusZ
    )
  }
  let joyActive: Bool = updateTouchControls(
    rig: cameraSystem.rig
    moveStick: inputSystem.moveStick
    world: inputSystem.world
    uiSystems: uiSystems
    enabled: inputSystem.uiModes.editor is false and touchControlsShown(
      menu: inputSystem.uiModes.modeMenu
    )
  )
  var cameraMoved: Bool = updateCameraRig(
    rig: cameraSystem.rig
    camera: cameraSystem.camera
    allowInput: uiPointerCaptured(input: inputSystem.ui) is false
    wheel: uiWheelUnclaimed(input: inputSystem.ui)
    deltaTime: deltaTime
  )
  # The GAME camera turns after the walker while it walks or runs, leaving the
  # view where the player turned it for a moment (lib/app3d/CameraWalkFollow)
  if inputSystem.uiModes.editor is false and cameraSystem.rig.mode is CameraRigMode.character {
    stepWalkFollow(
      follow: cameraSystem.walkFollow
      rig: cameraSystem.rig
      controller: controllerOf(world: world, entityId: heroEntityId)
      deltaTime: deltaTime
    )
  }
  # The GAME camera stays above the terrain (lib/app3d/OrbitGround), over the
  # higher of the ground under its target and under its eye (a slope behind
  # it); the editor's orbits freely
  if inputSystem.uiModes.editor is false and cameraSystem.rig.mode is CameraRigMode.character {
    let target: Vec3 = cameraSystem.camera.target
    let eye: Vec3 = orbitEye(
      targetX: target.x
      targetY: target.y
      targetZ: target.z
      yaw: cameraSystem.rig.viewYaw
      pitch: cameraSystem.rig.viewOrbitPitch
      dist: cameraSystem.rig.viewDistance
    )
    let ground: Float = Math.max(
      a: walkerTerrainHeight(terrainSystem: terrainSystem, x: target.x, y: target.y)
      b: walkerTerrainHeight(terrainSystem: terrainSystem, x: eye.x, y: eye.y)
    )
    if keepOrbitAboveGround(
      rig: cameraSystem.rig
      focusHeight: target.z - ground
      clearance: cameraGroundClearance
    ) {
      cameraMoved = true
    }
  }
  if cameraMoved {
    persist.stateDirty = true
  }
  ret CameraTick { joyActive: joyActive, cameraMoved: cameraMoved }
}
