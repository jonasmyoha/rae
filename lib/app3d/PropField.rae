# app3d/PropField — many static props (trees, bushes, rocks, …) placed over a
# world, drawn as few instanced draws, only those near the eye and in view.
#
# A KIND is one shape at one or more levels of detail. Each level has its mesh
# parts (a mesh and a material each: a tree is its wood and its leaves in three
# shades), the distance it is drawn out to, whether it casts a shadow, and
# whether it turns to face the eye every frame (a billboard). The next level
# takes over past a level's distance; past the last, the prop is not drawn. A
# PLACEMENT is one prop of a kind: its foot, its turn about +Z and its scale.
#
# The placements are sorted into square cells. Each frame gatherPropField
# looks only at the cells within the draw distance and in the view (a cone
# round the camera's view, a sphere round each cell), then at their props, and
# fills one instance batch per kind, level and part; drawPropField and
# drawPropFieldShadows draw them (the G-buffer pass, the shadow pass). So a
# field can hold thousands of props and cost only what is near and in front.
#
#   var field: PropField = createPropField(originX: -500, originY: -500, size: 1000, cellSize: 32)
#   let tree: Int = addPropKind(field: field, kind: { lods: …, radius: 3, centerHeight: 3 })
#   addPropPlacement(field: field, placement: { kind: tree, position: …, yaw: 0, scale: 1 })
#   finishPropField(field: field)
#   ...each frame: gatherPropField(field: field, propView: propViewOf(camera:, aspect:), toon:)
#   ...G-buffer: drawPropField(cache:, resources:, field:); shadows: drawPropFieldShadows
#
# A GROUP is placements that come and go together, such as one streamed
# tile's (setPropGroup, clearPropGroup): each group is sorted into the
# field's cells on its own, over the window of cells its props stand in, so
# setting or clearing one sorts only its own props, never the field again.
# The gather looks into the field's own cells and every group's in reach.
#
# A level with no parts that faces the camera is a SPRITE level: instead of
# meshes, each prop there is one billboard quad showing its kind's picture
# (setPropKindSprite: a layer of GbufferSprite's image array, made with
# app3d/SpriteBake). The field's sprites go into one batch, drawn with
# drawPropFieldSprites in the G-buffer pass, and when a sprite level casts
# shadows, drawPropFieldSpriteShadows casts them facing the sun.
import Math
import Vec3
open Scene3d
open Math3d
open GbufferRecord
open GbufferInstanced
open Gbuffer
open gpu/GpuResources
open RendererDeferred
open GbufferSprite
open app3d/PropFade

# One mesh of a level of detail, in its material
type PropPart {
  mesh: MeshHandle
  material: Material3d
  # How much it moves in the wind (lib/wind.wgsl): 0 rigid (a trunk, a
  # rock), 1 a tree's leaves. Only leaves sway; a tree's body stays still.
  sway: Float = 0.0
}

# One level of detail of a kind
type PropLod {
  parts: List(PropPart)
  # Drawn while the prop is at most this far from the eye (m)
  maxDistance: Float
  castsShadow: Bool
  # Turned about +Z toward the eye every frame (a billboard)
  facesCamera: Bool
}

# One shape, at its levels of detail (nearest first). `radius` and
# `centerHeight` are a sphere round the shape at scale 1, its center that
# high over the foot: what the view test sees.
type PropKind {
  lods: List(PropLod)
  radius: Float
  centerHeight: Float
  # Each level's maxDistance (filled by addPropKind), for the cross-fade's
  # pick (app3d/PropFade)
  lodEnds: List(Float) = List.create(Float, cap: 0)
}

# One prop: its kind (addPropKind's index), its foot, its turn about +Z
# (radians) and its uniform scale
type PropPlacement {
  kind: Int
  position: Vec3
  yaw: Float
  scale: Float
}

# A group's placements sorted into the cells of its window of the field's
# grid (the columns and rows its props stand in): cell c of the window holds
# placements cellStart[c] .. cellStart[c + 1] - 1, with their model
# matrices and a sphere round each cell's props. The field's own placements
# are sorted the same way, over the whole grid (finishPropField).
type PropGroup {
  used: Bool
  placements: List(PropPlacement)
  models: List(Mat4)
  firstColumn: Int
  firstRow: Int
  columns: Int
  rows: Int
  cellStart: List(Int)
  cellCenterZ: List(Float)
  cellRadius: List(Float)
  # Its props of each kind
  kindCounts: List(Int)
}

# What the gather sees from: the eye, the unit direction it looks, and the
# half angle of a cone round the whole view (its corners included)
type PropView {
  eye: Vec3
  forward: Vec3
  halfAngle: Float
}

type PropField {
  kinds: List(PropKind)
  placements: List(PropPlacement)
  # Per placement once finished: its model matrix
  models: List(Mat4)
  # The cell grid: its corner, its cell size (m) and its size in cells
  originX: Float
  originY: Float
  cellSize: Float
  columns: Int
  rows: Int
  # Once finished, the placements are in cell order: cell c holds placements
  # cellStart[c] .. cellStart[c + 1] - 1; a sphere round each cell's props
  cellStart: List(Int)
  cellCenterZ: List(Float)
  cellRadius: List(Float)
  # Per kind: the sprite array layer of its picture (-1: none) and the
  # picture's world height at scale 1 (setPropKindSprite)
  spriteLayers: List(Int)
  spriteHeights: List(Float)
  # This frame's billboards of every kind's sprite level
  spriteBatch: InstanceBatch
  # Some kind's sprite level casts shadows (finishPropField)
  spriteCastsShadow: Bool
  # One instance batch per kind, level and part; `lodFirstBatch` is each
  # (kind, level)'s first, by kindFirstLod[kind] + level
  batches: List(InstanceBatch)
  batchMeshes: List(MeshHandle)
  batchMaterials: List(Material3d)
  # Per batch: its part's sway (PropPart sway; 0 rigid)
  batchSways: List(Float)
  batchCastsShadow: List(Bool)
  lodFirstBatch: List(Int)
  kindFirstLod: List(Int)
  # The farthest any level is drawn (m)
  drawDistance: Float
  # The most instances one batch holds (0: as many as its kind has props). A
  # field of tens of thousands of props sets it: only the near and in-view
  # ones are drawn, and a batch sized for every prop of a kind would hold
  # megabytes that are never used. Set before finishPropField; props past it
  # in a frame are not drawn.
  batchLimit: Int
  finished: Bool
  # The last gather: props drawn, cells looked into
  visibleCount: Int
  cellsVisited: Int
  # The field's own props of each kind (finishPropField), and the groups
  kindCounts: List(Int)
  groups: List(PropGroup)
}

# An empty field over the square from (`originX`, `originY`) `size` meters on a
# side, in cells of `cellSize` meters. Placements outside it go to its edge
# cells.
func createPropField(
  originX: view Float
  originY: view Float
  size: view Float
  cellSize: view Float
) ret PropField {
  var count: Int = (size / cellSize).toInt()
  if count < 1 {
    count = 1
  }
  ret PropField {
    kinds: List.create(PropKind, cap: 8)
    placements: List.create(PropPlacement, cap: 256)
    models: List.create(Mat4, cap: 256)
    originX: originX
    originY: originY
    cellSize: cellSize
    columns: count
    rows: count
    cellStart: List.create(Int, cap: count * count + 1)
    cellCenterZ: List.create(Float, cap: count * count)
    cellRadius: List.create(Float, cap: count * count)
    spriteLayers: List.create(Int, cap: 8)
    spriteHeights: List.create(Float, cap: 8)
    spriteBatch: createInstanceBatch(mesh: meshHandleNone(), capacity: 0)
    spriteCastsShadow: false
    batches: List.create(InstanceBatch, cap: 16)
    batchMeshes: List.create(MeshHandle, cap: 16)
    batchMaterials: List.create(Material3d, cap: 16)
    batchSways: List.create(Float, cap: 16)
    batchCastsShadow: List.create(Bool, cap: 16)
    lodFirstBatch: List.create(Int, cap: 16)
    kindFirstLod: List.create(Int, cap: 8)
    drawDistance: 0.0
    batchLimit: 0
    finished: false
    visibleCount: 0
    cellsVisited: 0
    kindCounts: List.create(Int, cap: 8)
    groups: List.create(PropGroup, cap: 0)
  }
}

# Add a kind; returns its index for placements.
func addPropKind(field: mod PropField, kind: view PropKind) ret Int {
  field.spriteLayers.add(value: -1)
  field.spriteHeights.add(value: 0.0)
  var added: PropKind = kind
  added.lodEnds.clear()
  loop let lod: view PropLod in kind.lods {
    added.lodEnds.add(value: lod.maxDistance)
  }
  field.kinds.add(value: own added)
  ret field.kinds.length - 1
}

# Give kind `kind` its picture for its sprite level: layer `layer` of the
# sprite image array, `height` tall in the world at scale 1 (the baked
# picture's top). A sprite level is one with no parts that faces the camera.
func setPropKindSprite(
  field: mod PropField
  kind: view Int
  layer: view Int
  height: view Float
) {
  field.spriteLayers.set(index: kind, value: layer)
  field.spriteHeights.set(index: kind, value: height)
}

# Is `lod` a sprite level (a billboard of its kind's picture)?
func propLodIsSprite(lod: view PropLod) ret Bool {
  ret lod.facesCamera and lod.parts.length is 0
}

# Add one prop (before finishPropField).
func addPropPlacement(field: mod PropField, placement: view PropPlacement) {
  field.placements.add(value: placement)
}

# The cell holding (`x`, `y`): an edge cell for a point outside the field.
func propCellOf(field: view PropField, x: view Float, y: view Float) ret Int {
  var column: Int = Math.floor(x: (x - field.originX) / field.cellSize).toInt()
  var row: Int = Math.floor(x: (y - field.originY) / field.cellSize).toInt()
  if column < 0 {
    column = 0
  }
  if column >= field.columns {
    column = field.columns - 1
  }
  if row < 0 {
    row = 0
  }
  if row >= field.rows {
    row = field.rows - 1
  }
  ret row * field.columns + column
}

# The sphere round a placement of `kind`: its center and its radius
func propCenter(kind: view PropKind, placement: view PropPlacement) ret Vec3 {
  ret Vec3.create(
    x: placement.position.x
    y: placement.position.y
    z: placement.position.z + kind.centerHeight * placement.scale
  )
}

func propRadius(kind: view PropKind, placement: view PropPlacement) ret Float {
  ret kind.radius * placement.scale
}

func propModel(placement: view PropPlacement, yaw: view Float) ret Mat4 {
  ret modelMatrixOf(
    t: Transform3d {
      position: placement.position
      rotation: Vec3.create(x: 0.0, y: 0.0, z: yaw)
      scale: Vec3.create(x: placement.scale, y: placement.scale, z: placement.scale)
    }
  )
}

# Sort the placements into their cells, make their model matrices and the
# instance batches (each as big as its kind's placements). Call once, after
# the last placement.
# `placements` sorted into the cells of the window of the field's grid from
# (`firstColumn`, `firstRow`), `columns` x `rows` cells (every placement in
# it: propCellOf), with their model matrices and each cell's sphere.
func sortPropsIntoCells(
  field: view PropField
  placements: view List(PropPlacement)
  firstColumn: view Int
  firstRow: view Int
  columns: view Int
  rows: view Int
) ret PropGroup {
  let cellCount: Int = columns * rows
  # Count per cell, then each cell's start, then place every placement
  var counts: List(Int) = List.create(Int, cap: cellCount)
  loop var c: Int = 0, c < cellCount, ++c {
    counts.add(value: 0)
  }
  var kindCounts: List(Int) = List.create(Int, cap: field.kinds.length)
  loop var k: Int = 0, k < field.kinds.length, ++k {
    kindCounts.add(value: 0)
  }
  loop let placement: view PropPlacement in placements {
    let cell: Int = propWindowCell(
      field: field
      placement: placement
      firstColumn: firstColumn
      firstRow: firstRow
      columns: columns
    )
    counts.set(index: cell, value: counts.copyAtFallback(index: cell, fallback: 0) + 1)
    kindCounts.set(
      index: placement.kind
      value: kindCounts.copyAtFallback(index: placement.kind, fallback: 0) + 1
    )
  }
  var cellStart: List(Int) = List.create(Int, cap: cellCount + 1)
  var next: List(Int) = List.create(Int, cap: cellCount)
  var running: Int = 0
  loop var c: Int = 0, c < cellCount, ++c {
    cellStart.add(value: running)
    next.add(value: running)
    running = running + counts.copyAtFallback(index: c, fallback: 0)
  }
  cellStart.add(value: running)
  var sorted: List(PropPlacement) = List.create(PropPlacement, cap: placements.length)
  loop var i: Int = 0, i < placements.length, ++i {
    sorted.add(value: placements.copyAtDefault(index: 0))
  }
  loop let placement: view PropPlacement in placements {
    let cell: Int = propWindowCell(
      field: field
      placement: placement
      firstColumn: firstColumn
      firstRow: firstRow
      columns: columns
    )
    let slot: Int = next.copyAtFallback(index: cell, fallback: 0)
    sorted.set(index: slot, value: placement)
    next.set(index: cell, value: slot + 1)
  }
  # Model matrices, and a sphere round each cell's props
  var models: List(Mat4) = List.create(Mat4, cap: sorted.length)
  loop let placement: view PropPlacement in sorted {
    models.add(value: propModel(placement: placement, yaw: placement.yaw))
  }
  var cellCenterZ: List(Float) = List.create(Float, cap: cellCount)
  var cellRadius: List(Float) = List.create(Float, cap: cellCount)
  let halfDiagonal: Float = field.cellSize * 0.7072
  loop var c: Int = 0, c < cellCount, ++c {
    let first: Int = cellStart.copyAtFallback(index: c, fallback: 0)
    let last: Int = cellStart.copyAtFallback(index: c + 1, fallback: 0)
    var low: Float = 0.0
    var high: Float = 0.0
    var reach: Float = 0.0
    loop var i: Int = first, i < last, ++i {
      let placement: PropPlacement = sorted.copyAtDefault(index: i)
      var center: Vec3 = placement.position
      var radius: Float = 0.0
      if let kind: view PropKind = field.kinds.viewAt(index: placement.kind) {
        center = propCenter(kind: kind, placement: placement)
        radius = propRadius(kind: kind, placement: placement)
      }
      if i is first or center.z - radius < low {
        low = center.z - radius
      }
      if i is first or center.z + radius > high {
        high = center.z + radius
      }
      reach = Math.max(a: reach, b: radius)
    }
    let halfHeight: Float = (high - low) * 0.5
    cellCenterZ.add(value: (low + high) * 0.5)
    cellRadius.add(
      value: Math.sqrt(x: halfDiagonal * halfDiagonal + halfHeight * halfHeight) + reach
    )
  }
  ret PropGroup {
    used: placements.length > 0
    placements: own sorted
    models: own models
    firstColumn: firstColumn
    firstRow: firstRow
    columns: columns
    rows: rows
    cellStart: own cellStart
    cellCenterZ: own cellCenterZ
    cellRadius: own cellRadius
    kindCounts: own kindCounts
  }
}

# A placement's cell in a window of the field's grid
func propWindowCell(
  field: view PropField
  placement: view PropPlacement
  firstColumn: view Int
  firstRow: view Int
  columns: view Int
) ret Int {
  let cell: Int = propCellOf(field: field, x: placement.position.x, y: placement.position.y)
  ret (cell / field.columns - firstRow) * columns + cell % field.columns - firstColumn
}

func finishPropField(field: mod PropField) {
  var sorted: PropGroup = sortPropsIntoCells(
    field: field
    placements: field.placements
    firstColumn: 0
    firstRow: 0
    columns: field.columns
    rows: field.rows
  )
  field.placements = sorted.placements
  field.models = sorted.models
  field.cellStart = sorted.cellStart
  field.cellCenterZ = sorted.cellCenterZ
  field.cellRadius = sorted.cellRadius
  field.kindCounts = sorted.kindCounts
  # The batches: per kind, per level, per part, as many as the kind's props
  # (at most batchLimit when it is set)
  field.drawDistance = 0.0
  loop var k: Int = 0, k < field.kinds.length, ++k {
    let kindCount: Int = propBatchSize(field: field, kind: k)
    field.kindFirstLod.add(value: field.lodFirstBatch.length)
    let kind: PropKind = field.kinds.copyAtDefault(index: k)
    loop let lod: view PropLod in kind.lods {
      field.lodFirstBatch.add(value: field.batches.length)
      # reached to the end of its fade band (app3d/PropFade)
      field.drawDistance = Math.max(
        a: field.drawDistance
        b: lod.maxDistance + propFadeWidth(maxDistance: lod.maxDistance) * 0.5
      )
      loop let part: view PropPart in lod.parts {
        field.batches.add(value: createInstanceBatch(mesh: part.mesh, capacity: kindCount))
        field.batchMeshes.add(value: part.mesh)
        field.batchMaterials.add(value: part.material)
        field.batchSways.add(value: part.sway)
        field.batchCastsShadow.add(value: lod.castsShadow)
      }
    }
  }
  # The sprite batch: as many as the props of kinds with a sprite level (at
  # most batchLimit per such kind when it is set)
  var spriteCapacity: Int = 0
  loop var k: Int = 0, k < field.kinds.length, ++k {
    let kind: PropKind = field.kinds.copyAtDefault(index: k)
    var hasSprite: Bool = false
    loop let lod: view PropLod in kind.lods {
      if propLodIsSprite(lod: lod) {
        hasSprite = true
        if lod.castsShadow {
          field.spriteCastsShadow = true
        }
      }
    }
    if hasSprite {
      spriteCapacity = spriteCapacity + propBatchSize(field: field, kind: k)
    }
  }
  field.spriteBatch = createInstanceBatch(mesh: meshHandleNone(), capacity: spriteCapacity)
  field.finished = true
}

# How many instances one batch of `kind` holds: its props, the field's own
# and every group's, at most batchLimit when it is set
func propBatchSize(field: view PropField, kind: view Int) ret Int {
  var count: Int = field.kindCounts.copyAtFallback(index: kind, fallback: 0)
  loop let held: view PropGroup in field.groups {
    if held.used {
      count = count + held.kindCounts.copyAtFallback(index: kind, fallback: 0)
    }
  }
  if field.batchLimit > 0 and count > field.batchLimit {
    ret field.batchLimit
  }
  ret count
}

# Every placement the field holds: its own and its groups'
func propFieldPlacementCount(field: view PropField) ret Int {
  var count: Int = field.placements.length
  loop let held: view PropGroup in field.groups {
    if held.used {
      count = count + held.placements.length
    }
  }
  ret count
}

func emptyPropGroup() ret PropGroup {
  ret PropGroup {
    used: false
    placements: List.create(PropPlacement, cap: 0)
    models: List.create(Mat4, cap: 0)
    firstColumn: 0
    firstRow: 0
    columns: 0
    rows: 0
    cellStart: List.create(Int, cap: 0)
    cellCenterZ: List.create(Float, cap: 0)
    cellRadius: List.create(Float, cap: 0)
    kindCounts: List.create(Int, cap: 0)
  }
}

# Group `group` (0 and up) holds `placements` from now on, in place of what
# it held: only they are sorted, into the cells they stand in. Before or
# after finishPropField; a batch too small for its kind's props grows.
func setPropGroup(field: mod PropField, group: view Int, placements: view List(PropPlacement)) {
  if group < 0 {
    ret
  }
  loop field.groups.length <= group {
    field.groups.add(value: emptyPropGroup())
  }
  if placements.length is 0 {
    field.groups.set(index: group, value: emptyPropGroup())
    ret
  }
  # The window of cells the props stand in
  var firstColumn: Int = field.columns
  var firstRow: Int = field.rows
  var lastColumn: Int = 0
  var lastRow: Int = 0
  loop let placement: view PropPlacement in placements {
    let cell: Int = propCellOf(field: field, x: placement.position.x, y: placement.position.y)
    let column: Int = cell % field.columns
    let row: Int = cell / field.columns
    if column < firstColumn {
      firstColumn = column
    }
    if column > lastColumn {
      lastColumn = column
    }
    if row < firstRow {
      firstRow = row
    }
    if row > lastRow {
      lastRow = row
    }
  }
  let sorted: PropGroup = sortPropsIntoCells(
    field: field
    placements: placements
    firstColumn: firstColumn
    firstRow: firstRow
    columns: lastColumn - firstColumn + 1
    rows: lastRow - firstRow + 1
  )
  field.groups.set(index: group, value: sorted)
  growPropBatches(field: field)
}

# Group `group` holds nothing from now on.
func clearPropGroup(field: mod PropField, group: view Int) {
  if group >= 0 and group < field.groups.length {
    field.groups.set(index: group, value: emptyPropGroup())
  }
}

# After a group grew a kind past its batches (once the field is finished):
# those batches made again, a quarter bigger than needed, so a few more props
# do not make them again. They never shrink.
func growPropBatches(field: mod PropField) {
  if field.finished is false {
    ret
  }
  var spriteCapacity: Int = 0
  loop var k: Int = 0, k < field.kinds.length, ++k {
    let size: Int = propBatchSize(field: field, kind: k)
    var batchIndices: List(Int) = List.create(Int, cap: 8)
    var hasSprite: Bool = false
    if let kind: view PropKind = field.kinds.viewAt(index: k) {
      let firstLod: Int = field.kindFirstLod.copyAtFallback(index: k, fallback: 0)
      loop var l: Int = 0, l < kind.lods.length, ++l {
        if let lod: view PropLod = kind.lods.viewAt(index: l) {
          hasSprite = hasSprite or propLodIsSprite(lod: lod)
          let first: Int = field.lodFirstBatch.copyAtFallback(index: firstLod + l, fallback: 0)
          loop var p: Int = 0, p < lod.parts.length, ++p {
            batchIndices.add(value: first + p)
          }
        }
      }
    }
    if hasSprite {
      spriteCapacity = spriteCapacity + size
    }
    loop let b: view Int in batchIndices {
      var capacity: Int = 0
      if let batch: view InstanceBatch = field.batches.viewAt(index: b) {
        capacity = batch.capacity
      }
      if capacity < size {
        field.batches.set(
          index: b
          value: createInstanceBatch(
            mesh: field.batchMeshes.copyAtDefault(index: b)
            capacity: size + size / 4
          )
        )
      }
    }
  }
  if field.spriteBatch.capacity < spriteCapacity {
    field.spriteBatch = createInstanceBatch(
      mesh: meshHandleNone()
      capacity: spriteCapacity + spriteCapacity / 4
    )
  }
}

# The view from a camera, `aspect` its width over its height.
func propViewOf(camera: view Camera3d, aspect: view Float) ret PropView {
  let along: Vec3 = Vec3.vsub(a: camera.target, b: camera.position)
  var forward: Vec3 = Vec3.create(x: 0.0, y: 1.0, z: 0.0)
  if Vec3.vlen(a: along) > 0.0001 {
    forward = Vec3.vnorm(a: along)
  }
  # The view's corner: the vertical half angle's tangent, widened by the aspect
  let halfTan: Float = Math.tan(x: camera.fovYDeg * 0.008726646259971648)
  let cornerTan: Float = halfTan * Math.sqrt(x: 1.0 + aspect * aspect)
  ret PropView { eye: camera.position, forward: forward, halfAngle: Math.atan(x: cornerTan) }
}

# Is a sphere at `center` of `radius` in the view's cone?
func propSphereInView(propView: view PropView, center: view Vec3, radius: view Float) ret Bool {
  let toward: Vec3 = Vec3.vsub(a: center, b: propView.eye)
  let distance: Float = Vec3.vlen(a: toward)
  if distance <= radius {
    ret true
  }
  var cosine: Float = Vec3.vdot(a: toward, b: propView.forward) / distance
  if cosine > 1.0 {
    cosine = 1.0
  }
  if cosine < 0.0 - 1.0 {
    cosine = 0.0 - 1.0
  }
  ret Math.acos(x: cosine) <= propView.halfAngle + Math.asin(x: radius / distance)
}

# The level of detail a prop `distance` meters from the eye is drawn at;
# none past the last level's distance.
func propLodAt(kind: view PropKind, distance: view Float) ret opt Int {
  loop var l: Int = 0, l < kind.lods.length, ++l {
    if distance <= kind.lods.copyAtDefault(index: l).maxDistance {
      ret l
    }
  }
  ret none
}

# A cell's placements (start .. end - 1) and the sphere round them
type PropCellRange {
  start: Int
  end: Int
  centerZ: Float
  radius: Float
}

func propCellRange(field: view PropField, group: view Int, cell: view Int) ret PropCellRange {
  if group < 0 {
    ret PropCellRange {
      start: field.cellStart.copyAtFallback(index: cell, fallback: 0)
      end: field.cellStart.copyAtFallback(index: cell + 1, fallback: 0)
      centerZ: field.cellCenterZ.copyAtFallback(index: cell, fallback: 0.0)
      radius: field.cellRadius.copyAtFallback(index: cell, fallback: 0.0)
    }
  }
  if let held: view PropGroup = field.groups.viewAt(index: group) {
    ret PropCellRange {
      start: held.cellStart.copyAtFallback(index: cell, fallback: 0)
      end: held.cellStart.copyAtFallback(index: cell + 1, fallback: 0)
      centerZ: held.cellCenterZ.copyAtFallback(index: cell, fallback: 0.0)
      radius: held.cellRadius.copyAtFallback(index: cell, fallback: 0.0)
    }
  }
  ret PropCellRange { start: 0, end: 0, centerZ: 0.0, radius: 0.0 }
}

# Placement `index` of the field's own (`group` -1) or of a group, and its
# model matrix
func propPlacementAt(field: view PropField, group: view Int, index: view Int) ret PropPlacement {
  if group >= 0 {
    if let held: view PropGroup = field.groups.viewAt(index: group) {
      ret held.placements.copyAtDefault(index: index)
    }
  }
  ret field.placements.copyAtDefault(index: index)
}

func propModelAt(field: view PropField, group: view Int, index: view Int) ret Mat4 {
  if group >= 0 {
    if let held: view PropGroup = field.groups.viewAt(index: group) {
      ret held.models.copyAtDefault(index: index)
    }
  }
  ret field.models.copyAtDefault(index: index)
}
