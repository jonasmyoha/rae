# app3d/TreeForest — a forest of one tree set (treeSets/TreeSet) at every
# distance, for an app that is not a walker: the trees' near and middle
# meshes and their billboards (app3d/PropField, kinds built by
# treeSets/TreeSetKinds), past those far billboards (app3d/FarSprites), and
# past those the far canopy (app3d/FarCanopy: one cluster impostor a forest
# cell). The app plants it (addPropPlacement on `field`), finishes it once
# (finishTreeForest), then each frame gathers it before its shadow and scene
# passes and draws it in both. The walkers' terrain (app3d/WalkerTerrain)
# holds one, and so do example 138's lod scene and the tree lab's forest.
import Math
import Noise
import RendererDeferred
import RendererDeferredShadow
open Vec3
open Scene3d
open Gbuffer
open GbufferSprite
open gpu/GpuResources
open app3d/PropField
open app3d/PropFieldFrame
open app3d/FarSprites
open app3d/FarCanopy
open CanopyBake
open treeSets/TreeSet
open treeSets/TreeSetKinds

# Where a forest's levels end: the field's square round the origin (m) and
# its cells (m); the sparser crowns end at midDistance, the field's own
# billboards at farDistance, the far billboards at canopyFrom (where the far
# canopy fades in over canopyFadeWidth), and nothing is drawn farReach past
# farDistance (0: no far billboards and no canopy, the field is all);
# batchLimit the most trees one batch holds (0: PropField's own limit)
type TreeForestSettings {
  extent: Float
  cellSize: Float
  batchLimit: Int = 0
  midDistance: Float
  farDistance: Float
  canopyFrom: Float
  canopyFadeWidth: Float
  farReach: Float
}

type TreeForest {
  field: PropField
  sprites: SpriteCache
  farTrees: FarSprites
  canopy: FarCanopy
  # far billboards and a canopy past the field (the settings' farReach)
  hasFar: Bool
  toon: Bool
}

# The walkers' distances (app3d/WideForest, app3d/WalkerTerrain): sparser
# crowns from 60 m, billboards from 140 m, far billboards to the canopy at
# 300 m, the canopy to `farReach`
func defaultTreeForestSettings(extent: view Float, farReach: view Float) ret TreeForestSettings {
  ret TreeForestSettings {
    extent: extent
    cellSize: 40.0
    midDistance: 60.0
    farDistance: 140.0
    canopyFrom: 300.0
    canopyFadeWidth: 60.0
    farReach: farReach
  }
}

# A band of forest in front of a camera at the origin looking along +Y:
# `width` meters wide from `near` to `far` ahead, a tree every `spacing`
# meters (moved up to half of that), no trees in the `meadowShare` of the
# 90 m squares a noise picks as meadows, and a clear lane `laneHalfWidth`
# to each side up to `laneLength` ahead
type TreeForestBand {
  width: Float
  near: Float
  far: Float
  spacing: Float
  meadowShare: Float = 0.25
  laneHalfWidth: Float = 6.0
  laneLength: Float = 40.0
}

# An empty forest of `treeSet`'s species (its kinds, billboard pictures and
# impostors are built here), no trees yet
func createTreeForest(
  treeSet: view TreeSet
  renderer: mod DeferredRenderer
  settings: view TreeForestSettings
  toon: view Bool
) ret TreeForest {
  var sprites: SpriteCache = createSpriteCache()
  var field: PropField = createPropField(
    originX: settings.extent * -0.5
    originY: settings.extent * -0.5
    size: settings.extent
    cellSize: settings.cellSize
  )
  if settings.batchLimit > 0 {
    field.batchLimit = settings.batchLimit
  }
  addTreeSetKinds(
    treeSet: treeSet
    field: field
    renderer: renderer
    sprites: sprites
    midDistance: settings.midDistance
    farDistance: settings.farDistance
  )
  # The far billboards from where the field's own end to where the canopy
  # holds every tree (a tree is measured from its cluster's center, up to
  # 40 m away)
  let hasFar: Bool = settings.farReach > 0.0
  var farSettings: FarSpriteSettings = defaultFarSpriteSettings()
  farSettings.nearDistance = settings.farDistance
  farSettings.farDistance = settings.farDistance + settings.farReach
  farSettings.thinFrom = 300.0
  if hasFar {
    farSettings.farDistance = settings.canopyFrom + settings.canopyFadeWidth * 0.5 + 40.0
    farSettings.thinFrom = farSettings.farDistance
    farSettings.fadeOutMiddle = settings.canopyFrom
    farSettings.fadeOutWidth = settings.canopyFadeWidth
  }
  ret TreeForest {
    field: own field
    sprites: own sprites
    farTrees: own createFarSprites(settings: farSettings)
    canopy: own createFarCanopy(
      settings: {
        fadeMiddle: settings.canopyFrom
        fadeWidth: settings.canopyFadeWidth
        farDistance: settings.farDistance + settings.farReach
      }
    )
    hasFar: hasFar
    toon: toon
  }
}

# Plant `band` with `treeSet`'s species in stands, as the walkers plant
# theirs (TreeSet.treeSpeciesAt, treeScaleAt), on flat ground at z 0. The
# number of trees planted; finishTreeForest still follows.
func plantTreeForestBand(
  forest: mod TreeForest
  treeSet: view TreeSet
  band: view TreeForestBand
) ret Int {
  let columns: Int = (band.width / band.spacing).toInt()
  let rows: Int = ((band.far - band.near) / band.spacing).toInt()
  var number: Int = 0
  loop var row: Int = 0, row < rows, ++row {
    loop var column: Int = 0, column < columns, ++column {
      let x: Float = (column.toFloat() + 0.5) * band.spacing - band.width * 0.5 + (Noise.hash2(
        x: column
        y: row
        seed: 41
      ) - 0.5) * band.spacing
      let y: Float = band.near + (row.toFloat() + 0.5) * band.spacing + (Noise.hash2(
        x: column
        y: row
        seed: 43
      ) - 0.5) * band.spacing
      # meadows between the woods, and a clear lane in front of the camera
      let woods: Float = Noise.hash2(
        x: Math.floor(x: x / 90.0).toInt()
        y: Math.floor(x: y / 90.0).toInt()
        seed: 47
      )
      if woods < band.meadowShare or (Math.abs(value: x) < band.laneHalfWidth and y < band.laneLength) {
        continue
      }
      let species: Int = treeSpeciesAt(
        treeSet: treeSet
        x: x
        y: y
        number: number
      )
      addPropPlacement(
        field: forest.field
        placement: {
          kind: species
          position: Vec3.create(x: x, y: y, z: 0.0)
          yaw: Noise.hash2(x: column, y: row, seed: 53) * 6.2831853
          scale: treeScaleAt(treeSet: treeSet, species: species, number: number)
        }
      )
      number = number + 1
    }
  }
  ret number
}

# Once the field is finished (finishPropField): its trees as far
# billboards (in 64 m blocks) and the plan of the far canopy. The number of
# blocks; nothing without far billboards.
func addTreeForestFarTrees(forest: mod TreeForest) ret Int {
  if forest.hasFar is false {
    ret 0
  }
  var trees: List(FarSprite) = farSpritesOf(
    field: forest.field
    placements: forest.field.placements
  )
  planFarCanopy(canopy: forest.canopy, field: forest.field, trees: trees)
  ret addFarSpritesInCells(farSprites: forest.farTrees, sprites: trees, cellSize: 64.0)
}

# Bake the far canopy planned by addTreeForestFarTrees from the trees'
# impostors; nothing without far billboards
func bakeTreeForestCanopy(forest: mod TreeForest, renderer: mod DeferredRenderer) {
  if forest.hasFar is false {
    ret
  }
  RendererDeferred.ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources = renderer.gpuResources {
    bakeFarCanopy(
      canopy: forest.canopy
      resources: resources
      treeAtlas: forest.sprites.impostors.binding
      settings: defaultCanopySettings()
      cutoff: spriteCutoff
    )
  }
}

# Once every tree is planted: the field's cells, the far billboards and the
# far canopy (addTreeForestFarTrees, bakeTreeForestCanopy). The number of
# trees.
func finishTreeForest(forest: mod TreeForest, renderer: mod DeferredRenderer) ret Int {
  finishPropField(field: forest.field)
  let unusedBlocks: Int = addTreeForestFarTrees(forest: forest)
  bakeTreeForestCanopy(forest: forest, renderer: renderer)
  ret forest.field.placements.length
}

# This frame's trees (before the shadow and scene passes, which both draw
# them). The field's view cone is widened by about 34 degrees, so a tree
# just outside the picture still casts its shadow into it; the far trees
# and the canopy are the picture only. `deltaTime`: the seconds since the
# last gather, for the trees' level fades (app3d/PropFade).
func gatherTreeForest(
  forest: mod TreeForest
  camera: view Camera3d
  aspect: view Float
  deltaTime: view Float
) {
  var propView: PropView = propViewOf(camera: camera, aspect: aspect)
  propView.halfAngle = Math.min(a: propView.halfAngle + 0.6, b: 3.0)
  gatherPropField(
    field: forest.field
    propView: propView
    toon: forest.toon
    deltaTime: deltaTime
  )
  if forest.hasFar is false {
    ret
  }
  # the far canopy's hand-over first: the far trees and their clusters
  # both fade by it
  stepFarCanopyHandOver(
    canopy: forest.canopy
    propView: propViewOf(camera: camera, aspect: aspect)
    deltaTime: deltaTime
  )
  gatherFarSprites(
    farSprites: forest.farTrees
    propView: propViewOf(camera: camera, aspect: aspect)
    toon: forest.toon
    handOver: forest.canopy.handOver
  )
  gatherFarCanopy(
    canopy: forest.canopy
    propView: propViewOf(camera: camera, aspect: aspect)
    toon: forest.toon
  )
}

# This frame's trees (gathered above) into the open scene pass
func drawTreeForest(cache: mod GbufferCache, resources: mod GpuResources, forest: mod TreeForest) {
  drawPropField(cache: cache, resources: resources, field: forest.field)
  drawPropFieldSprites(
    cache: cache
    resources: resources
    field: forest.field
    sprites: forest.sprites
  )
  if forest.hasFar is false {
    ret
  }
  drawFarSprites(
    cache: cache
    resources: resources
    farSprites: forest.farTrees
    sprites: forest.sprites
  )
  drawFarCanopy(cache: cache, resources: resources, canopy: forest.canopy)
}

# The trees' shadows, into the open shadow pass: the meshes and the
# billboards
func drawTreeForestShadows(renderer: mod DeferredRenderer, forest: view TreeForest) {
  drawPropFieldShadows(renderer: renderer, field: forest.field)
  drawPropFieldSpriteShadows(
    renderer: renderer
    field: forest.field
    aspect: spritePictureAspect
    cutoff: spriteCutoff
    impostors: forest.sprites.impostors.binding
  )
}

func treeForestShutdown(forest: mod TreeForest, resources: mod GpuResources) {
  spriteShutdown(cache: forest.sprites, resources: resources)
  farCanopyShutdown(canopy: forest.canopy, resources: resources)
}
