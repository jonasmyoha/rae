# The "..." menu's "Skip 6 hours": a quarter of a day, enough to step from a
# late evening past the night (21:00 -> 03:00, and dawn follows) without a
# second tap, short enough not to overshoot a whole day
const walkerSkipHours: Float = 6.0

# The "..." menu's moon item: whether the moon is on, and while it is, its
# phase and how much of it is lit
func walkerMoonItemText(settingsState: view SettingsState) ret String {
  if settingsState.moon is false {
    ret "Moon: off"
  }
  let moon: MoonState = settingsMoon(settingsState: settingsState)
  let percent: Int = (moon.illumination * 100.0 + 0.5).toInt()
  ret "Moon: {moonPhaseName(moon: moon)}, {percent}% lit"
}

# Shared reaction to a character switch (#546), from Page Up/Down, keys 1/2, or
# the settings-panel Prev/Next buttons: snap the orbit camera behind the new
# character and update the panel readout.
func onCharacterSwitched(
  cameraSystem: mod WalkerCamera
  inputSystem: mod WalkerInput
  persist: mod WalkerPersist
  players: view PlayerRoster
  world: view WalkerWorld
  characterSystem: view CharacterSystem
) {
  cameraSystem.rig.yaw = controlledHeading(
    world: world
    players: players
    characterSystem: characterSystem
  )
  snapCameraRigView(rig: cameraSystem.rig)
  persist.stateDirty = true
  setNodeText(
    world: inputSystem.world
    nodeId: "CharacterReadout"
    value: "Controlling {players.controlledIndex + 1} / {players.count}"
  )
}

# What a UI tick reports back to the app for the render decision.
type UiTick {
  settingsChanged: Bool
  scrolled: Bool
}

func uiUpdate(
  uiSystems: mod UiSystems
  cameraSystem: mod WalkerCamera
  characterSystem: mod CharacterSystem
  didRealWork: view Bool
  inputSystem: mod WalkerInput
  persist: mod WalkerPersist
  players: mod PlayerRoster
  renderer: mod DeferredRenderer
  terrainSystem: mod WalkerTerrain
  world: view WalkerWorld
  deltaTime: copy Float
  now: copy Float64
) ret UiTick {
  updateUiInput(input: inputSystem.ui, world: inputSystem.world, uiSystems: uiSystems)
  # GAME / EDITOR: the "..." button's menu (app3d/ModeMenu), a rotation, a
  # change of pointer
  let modesChanged: Bool = updateUiModes(
    world: inputSystem.world
    uiSystems: uiSystems
    uiModes: inputSystem.uiModes
  ) or updateModeMenu(
    world: inputSystem.world
    uiSystems: uiSystems
    uiModes: inputSystem.uiModes
    input: inputSystem.ui
    rig: cameraSystem.rig
  )
  # The debug readout, the same in both modes, left of the "..." button
  placeDebugOverlayByModeButton(
    world: inputSystem.world
    uiSystems: uiSystems
    debugOverlay: inputSystem.dbg
    buttonNodeId: "ModeButton"
  )
  let scrolled: Bool = updateScrollRoot(
    world: inputSystem.world
    uiSystems: uiSystems
    entityId: inputSystem.panelScroll
    input: inputSystem.ui
  )
  if updateDebugOverlay(
    debugOverlay: inputSystem.dbg
    screenW: windowExtentW()
    screenH: windowExtentH()
    now: now
    didRealWork: didRealWork
  ) {
    suppressUiPress(input: inputSystem.ui, world: inputSystem.world)
  }
  let clipHit: String = panelClickedId(panel: inputSystem.clipPanel, world: inputSystem.world)
  if clipHit.length() > 0 and cameraSystem.rig.mode is not CameraRigMode.character {
    var nextClipIndex: Int = characterSystem.clipIndex
    if clipHit is "idle" {
      nextClipIndex = 0
    }
    if clipHit is "walk" {
      nextClipIndex = 1
    }
    if clipHit is "walkFast" {
      nextClipIndex = 2
    }
    if clipHit is "run" {
      nextClipIndex = 3
    }
    if nextClipIndex is not characterSystem.clipIndex {
      characterSystem.transitionFrom = captureSkeletonPose(sk: characterSystem.skeleton)
      characterSystem.transitionElapsed = 0.0
      characterSystem.clipIndex = nextClipIndex
      characterSystem.animTime = 0.0
      persist.stateDirty = true
    }
    setPanelSelection(
      panel: inputSystem.clipPanel
      world: inputSystem.world
      group: 1
      id: clipHit
    )
  }
  let transportHit: String = panelClickedId(panel: inputSystem.transport, world: inputSystem.world)
  if transportHit is "play" {
    characterSystem.playing = not characterSystem.playing
    var playLabel: String = "Pause"
    if not characterSystem.playing {
      playLabel = "Play"
    }
    setPanelButtonLabel(
      panel: inputSystem.transport
      world: inputSystem.world
      id: "play"
      label: playLabel
    )
    setPanelButtonOn(
      panel: inputSystem.transport
      world: inputSystem.world
      id: "play"
      on: characterSystem.playing
    )
  }
  if transportHit is "toon" {
    characterSystem.toon = not characterSystem.toon
    setPanelButtonOn(
      panel: inputSystem.transport
      world: inputSystem.world
      id: "toon"
      on: characterSystem.toon
    )
  }
  if transportHit is "slower" {
    characterSystem.speed = nextSpeed(current: characterSystem.speed, up: false)
  }
  if transportHit is "faster" {
    characterSystem.speed = nextSpeed(current: characterSystem.speed, up: true)
  }
  if transportHit.length() > 0 {
    let pct: Int = speedPercent(value: characterSystem.speed)
    setNodeText(world: inputSystem.world, nodeId: "SpeedLabel", value: "Speed {pct}%")
  }
  # Character-switch buttons (#546): same effect as Page Up/Down and keys 1/2.
  let charHit: String = panelClickedId(panel: inputSystem.charPanel, world: inputSystem.world)
  if charHit is "prev" {
    rosterSwitchPrev(roster: players)
    onCharacterSwitched(
      cameraSystem: cameraSystem
      inputSystem: inputSystem
      persist: persist
      players: players
      world: world
      characterSystem: characterSystem
    )
  }
  if charHit is "next" {
    rosterSwitchNext(roster: players)
    onCharacterSwitched(
      cameraSystem: cameraSystem
      inputSystem: inputSystem
      persist: persist
      players: players
      world: world
      characterSystem: characterSystem
    )
  }
  # The "..." menu's clock items: skip the night, switch the moon
  var clockChanged: Bool = false
  if modeMenuTapped(world: inputSystem.world, actionId: modeMenuSkipHoursActionId) {
    let skipped: Bool = timeOfDaySkip(
      timeOfDay: inputSystem.settings.timeOfDay
      hours: walkerSkipHours
    )
    clockChanged = true
  }
  if modeMenuTapped(world: inputSystem.world, actionId: modeMenuMoonActionId) {
    inputSystem.settings.moon = inputSystem.settings.moon is false
    clockChanged = true
  }
  # The shared settings (app3d/EditorPanel): every action (the edge tab's
  # settings.open too), the sliders, the running clock
  let settingsChanged: Bool = clockChanged or updateEditorSettings(
    world: inputSystem.world
    uiSystems: uiSystems
    input: inputSystem.ui
    settings: inputSystem.settings
    deltaTime: deltaTime
  )
  # The moon item says what the moon is doing; a mode switch resets the menu's
  # nodes to their authored text, so it is written again then
  let moonText: String = walkerMoonItemText(settingsState: inputSystem.settings)
  if modesChanged or moonText is not inputSystem.moonItemText {
    setNodeText(world: inputSystem.world, nodeId: "MenuMoonLabel", value: moonText)
    inputSystem.moonItemText = moonText
  }
  # A mode switch resets the panel's nodes: apply its open/close again
  if modesChanged {
    applyEditorPanelOpen(world: inputSystem.world, open: inputSystem.settings.open)
  }
  if settingsChanged {
    # TAA opt-in, SMAA when off; a forward frame has 4x MSAA and no TAA
    if not isForwardRenderer(renderer: renderer) {
      setTaaEnabled(renderer: renderer, on: inputSystem.settings.taa)
    }
    renderer.sky = settingsBuildSky(
      settingsState: inputSystem.settings
      data: cameraSystem.hosek
      turbidity: 3.0
      groundAlbedo: 0.30
    )
    cameraSystem.light.sunDir = settingsKeyLightDir(settingsState: inputSystem.settings)
    cameraSystem.light.sunColor = settingsKeyLightColor(settingsState: inputSystem.settings)
    characterSystem.speed = inputSystem.settings.speed
    characterSystem.playing = inputSystem.settings.playing
    if characterSystem.toon is not inputSystem.settings.toon {
      characterSystem.toon = inputSystem.settings.toon
      setPanelButtonOn(
        panel: inputSystem.transport
        world: inputSystem.world
        id: "toon"
        on: characterSystem.toon
      )
    }
    let pctS: Int = speedPercent(value: characterSystem.speed)
    setNodeText(world: inputSystem.world, nodeId: "SpeedLabel", value: "Speed {pctS}%")
    persist.stateDirty = true
  }
  if clipHit.length() > 0 or transportHit.length() > 0 {
    inputSystem.settings.speed = characterSystem.speed
    inputSystem.settings.toon = characterSystem.toon
    settingsApplyToWorld(
      settingsState: inputSystem.settings
      world: inputSystem.world
      uiSystems: uiSystems
    )
    applyEditorPanelOpen(world: inputSystem.world, open: inputSystem.settings.open)
    persist.stateDirty = true
  }
  if terrainSystem.toon is not characterSystem.toon {
    setInfiniteTerrainToon(terrainSystem: terrainSystem, toon: characterSystem.toon)
  }
  # `scrolled`: updateScrollRoot writes the new position into a RuntimeOffset,
  # and only transformSystem (inside runUiSystems) turns that into screen
  # positions. Without it the wheel moved nothing until the next
  # relayout — again masked by the time-of-day animation while it runs.
  if uiActionCount(world: inputSystem.world) > 0 or settingsChanged or scrolled or modesChanged {
    runUiSystems(world: inputSystem.world, uiSystems: uiSystems, res: inputSystem.gpuUi)
  }
  ret UiTick { settingsChanged: settingsChanged, scrolled: scrolled }
}
