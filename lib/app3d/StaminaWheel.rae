# app3d/StaminaWheel — a character's stamina (app3d/ClimbRules) as a ring
# beside its head, drawn in the 2D overlay: a dark track with the stamina
# left over it, clockwise from the top. Green, orange when low, red while
# exhausted (it must fill all the way before the next climb). It shows while
# the stamina is not full and a moment after it filled
# (staminaWheelShows), so it is there only while it matters. Each part is
# one smooth arc (Gpu2dCanvasArc), not pieces of line.
import Math
import Vec3
open Gpu2dCanvas
open Gpu2dCanvasArc
open ecs/Entity
open ecs/ComponentTable
open Scene3d
open app3d/ClimbRules
open app3d/Climbing
open app3d/WorldLabel
open app3d/CharacterController
open app3d/CharacterBodies
open app3d/CharacterHeight
open app3d/UiShell

# The ring's outer radius and thickness (pt), and how far right of the head
# its middle sits
const staminaWheelRadius: Float = 18.0

const staminaWheelThickness: Float = 6.0

const staminaWheelOffset: Float = 42.0

# The track the stamina is drawn over: dark, a little see-through
const staminaWheelTrackColor: Int = 2517899294

func staminaWheelColor(stamina: view Stamina, tuning: view StaminaTuning) ret Int {
  if stamina.exhausted {
    ret 4293412156
  }
  if staminaShare(stamina: stamina, tuning: tuning) < tuning.lowShare {
    ret 4293957170
  }
  ret 4284404587
}

# The wheel for `stamina` beside the head at world point `head`, seen from a
# camera at `eye` looking at `target` with `fovYDeg` on a `width` x `height`
# pt screen; nothing when it does not show or the head is off screen
func drawStaminaWheel(
  canvas: mod Gpu2dCanvas
  stamina: view Stamina
  tuning: view StaminaTuning
  head: view Vec3
  eye: view Vec3
  target: view Vec3
  fovYDeg: view Float
  width: view Float
  height: view Float
) {
  if staminaWheelShows(stamina: stamina, tuning: tuning) is false or width <= 0.0 or height <= 0.0 {
    ret
  }
  if let point: ScreenPoint = projectToScreen(
    eye: eye
    target: target
    fovYDeg: fovYDeg
    aspect: width / height
    point: head
  ) {
    if onScreen(point: point, margin: 0.0) is false {
      ret
    }
    let x: Float = point.x * width + staminaWheelOffset
    let y: Float = point.y * height
    canvasDrawArc(
      canvas: canvas
      centerX: x
      centerY: y
      radius: staminaWheelRadius
      thickness: staminaWheelThickness
      share: 1.0
      color: staminaWheelTrackColor
    )
    canvasDrawArc(
      canvas: canvas
      centerX: x
      centerY: y
      radius: staminaWheelRadius
      thickness: staminaWheelThickness
      share: staminaShare(stamina: stamina, tuning: tuning)
      color: staminaWheelColor(stamina: stamina, tuning: tuning)
    )
  }
}

# The wheel of the climber `entityId` (app3d/Climbing) beside its head (90%
# of its CharacterHeight over its controller's feet), seen by `camera` in
# the window; nothing when it is no climber
func drawClimberStaminaWheel(
  canvas: mod Gpu2dCanvas
  climbing: view Climbing
  controllers: view ComponentTable(ThirdPersonController)
  heights: view ComponentTable(CharacterHeight)
  entityId: view EntityId
  groundZ: view Float
  modelHeight: view Float
  camera: view Camera3d
) {
  if let stamina: Stamina = componentCopy(this: climbing.staminas, entityId: entityId) {
    if componentHas(this: controllers, entityId: entityId) is false {
      ret
    }
    let feet: Vec3 = controllerFeet(
      controller: componentView(this: controllers, entityId: entityId)
      groundZ: groundZ
    )
    let height: Float = characterHeightOf(
      heights: heights
      entityId: entityId
      fallback: modelHeight
    )
    drawStaminaWheel(
      canvas: canvas
      stamina: stamina
      tuning: climbing.staminaTuning
      head: Vec3.create(x: feet.x, y: feet.y, z: feet.z + height * 0.9)
      eye: camera.position
      target: camera.target
      fovYDeg: camera.fovYDeg
      width: windowExtentW()
      height: windowExtentH()
    )
  }
}
