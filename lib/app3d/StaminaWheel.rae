# app3d/StaminaWheel — a character's stamina (app3d/ClimbRules) as a ring
# beside its head, drawn in the 2D overlay: a dark track with the stamina
# left over it, clockwise from the top. Green, orange when low, red while
# exhausted (it must fill all the way before the next climb). It shows while
# the stamina is not full and a moment after it filled
# (staminaWheelShows), so it is there only while it matters.
import Math
import Vec3
import Gpu2d
open Gpu2dCanvas
open app3d/ClimbRules
open app3d/WorldLabel

# The ring's size (pt), its segments, and how far right of the head it sits
const staminaWheelRadius: Float = 15.0

const staminaWheelThickness: Float = 6.0

const staminaWheelSegments: Int = 48

const staminaWheelOffset: Float = 42.0

func staminaWheelColor(stamina: view Stamina, tuning: view StaminaTuning) ret Int {
  if stamina.exhausted {
    ret 4293412156
  }
  if staminaShare(stamina: stamina, tuning: tuning) < tuning.lowShare {
    ret 4293957170
  }
  ret 4284404587
}

# An arc of the ring from `from` to `to` (shares of the turn, clockwise from
# the top) round (x, y)
func drawWheelArc(
  canvas: mod Gpu2dCanvas
  x: view Float
  y: view Float
  from: view Float
  to: view Float
  color: view Int
) {
  let first: Int = Math.floor(x: from * staminaWheelSegments.toFloat()).toInt()
  let last: Int = Math.ceil(x: to * staminaWheelSegments.toFloat()).toInt()
  loop var i: Int = first, i < last, ++i {
    let a: Float = Math.max(a: from, b: i.toFloat() / staminaWheelSegments.toFloat()) * 6.2831853
    let b: Float = Math.min(a: to, b: (i + 1).toFloat() / staminaWheelSegments.toFloat()) * 6.2831853
    Gpu2d.drawLine(
      canvas: canvas
      x0: x + Math.sin(x: a) * staminaWheelRadius
      y0: y - Math.cos(x: a) * staminaWheelRadius
      x1: x + Math.sin(x: b) * staminaWheelRadius
      y1: y - Math.cos(x: b) * staminaWheelRadius
      thickness: staminaWheelThickness
      color: color
    )
  }
}

# The wheel for `stamina` beside the head at world point `head`, seen from a
# camera at `eye` looking at `target` with `fovYDeg` on a `width` x `height`
# pt screen; nothing when it does not show or the head is off screen
func drawStaminaWheel(
  canvas: mod Gpu2dCanvas
  stamina: view Stamina
  tuning: view StaminaTuning
  head: view Vec3
  eye: view Vec3
  target: view Vec3
  fovYDeg: view Float
  width: view Float
  height: view Float
) {
  if staminaWheelShows(stamina: stamina, tuning: tuning) is false or width <= 0.0 or height <= 0.0 {
    ret
  }
  if let point: ScreenPoint = projectToScreen(
    eye: eye
    target: target
    fovYDeg: fovYDeg
    aspect: width / height
    point: head
  ) {
    if onScreen(point: point, margin: 0.0) is false {
      ret
    }
    let x: Float = point.x * width + staminaWheelOffset
    let y: Float = point.y * height
    drawWheelArc(canvas: canvas, x: x, y: y, from: 0.0, to: 1.0, color: 2517899294)
    drawWheelArc(
      canvas: canvas
      x: x
      y: y
      from: 0.0
      to: staminaShare(stamina: stamina, tuning: tuning)
      color: staminaWheelColor(stamina: stamina, tuning: tuning)
    )
  }
}
