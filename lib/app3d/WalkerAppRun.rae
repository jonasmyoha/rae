# app3d/WalkerAppRun — the walker app's run: makes the app (app3d/WalkerApp
# createWalkerApp), then its self-tests or its frame loop, and its shutdown.
# 136, 137 and 143 each call runWalkerApp from their Main.rae.
import Profile
import Gpu2d
open app3d/ReferenceTree
open ecs/ComponentTable
import Vec3
import Sys
open water/WadeSplash
open GbufferSprite
open water/WaterSystem
open water/WaterFft
open gpu/GpuResources
open gpu/GpuLifetime
open GrassCompute
open Scene3d
open RendererDeferred
open Gbuffer
open app3d/WalkerResetTest
open ui/Registry
open ui/EventLoop
open ui/Ecs
open app3d/PlayerRoster
open app3d/WalkerPhysics
open app3d/WalkerMarkTest
open app3d/WalkerLayoutTest
open app3d/WalkerWorld
open app3d/FarCanopy
open app3d/WalkerAppSetup
open app3d/WalkerRenderWalk
open app3d/WalkerAppUpdate
open app3d/WalkerSplash
open app3d/WalkerSelfTest
open app3d/WalkerClimbTest
open app3d/WalkerCrowdTest
open app3d/Climbing
open app3d/RagdollRig
open app3d/WalkerKnockdown
open app3d/WalkerKnockTest
open app3d/WalkerApp

func runWalkerApp(settings: view WalkerAppSettings) ret Int {
  var app: WalkerApp = createWalkerApp(settings: settings)
  # #739/#740/#741: the WalkerWorld holds the hero + crowd (controllers), the
  # skinned body parts (PartRoughness), and the terrain props + heightfield tiles
  # (TerrainProp) — all recycled ECS entities.
  log(
    "[ecs] WalkerWorld: {walkerWorldEntityCount(world: app.world)} entities ({walkerWorldPartCount(
      world: app.world
    )} parts + hero + crowd + terrain)"
  )
  if let wadeSplash: mod WadeSplash = app.wadeSplash {
    prepareSplashPreview(
      wadeSplash: wadeSplash
      cameraSystem: app.cameraSystem
      biome: app.biome
      groundZ: app.characterSystem.groundZ
    )
  }
  Profile.maybeAutoStart(profiler: app.profiler)
  # RAE_WALKER_PHYSICS_TEST=1: drive the hero into a cube stack and jump, check
  # the trunks, rocks and bushes, report and quit (app3d/WalkerSelfTest),
  # instead of the window loop. RAE_WALKER_SPLASH_TEST=1: the wading spray's
  # pose check (app3d/WalkerSplash), where there is a sea.
  # The ragdoll's bones on the loaded skeleton (app3d/WalkerKnockdown)
  app.physicsSystem.ragdollRig = createRagdollRig(
    skeleton: app.characterSystem.skeleton
    bones: mixamoRagdollBones(prefix: "mixamorig:")
  )
  # RAE_WALKER_TRIP=1 trips the hero at the start (for screenshots of a ragdoll)
  if Sys.getEnv(name: "RAE_WALKER_TRIP") is "1" {
    let tripped: Bool = tripCharacter(
      physicsSystem: app.physicsSystem
      world: app.world
      characterSystem: app.characterSystem
      entityId: rosterEntityAt(roster: app.players, index: 0)
      velocity: Vec3.create(x: 3.0, y: 2.0, z: 1.5)
    )
  }
  let physicsTest: Bool = Sys.getEnv(name: "RAE_WALKER_PHYSICS_TEST").length() > 0
  let splashTest: Bool = Sys.getEnv(name: "RAE_WALKER_SPLASH_TEST").length() > 0
  var exitCode: Int = 0
  if splashTest {
    exitCode = 1
    if let wadeSplash: mod WadeSplash = app.wadeSplash {
      exitCode = runSplashPoseTest(
        characterSystem: app.characterSystem
        world: app.world
        wadeSplash: wadeSplash
      )
    }
  }
  # RAE_WALKER_LAYOUT_TEST=1: the HUD laid out at phone and desktop sizes fits
  # each safe area (app3d/WalkerLayoutTest), then quit
  let layoutTest: Bool = Sys.getEnv(name: "RAE_WALKER_LAYOUT_TEST").length() > 0
  if layoutTest and runWalkerLayoutTest(inputSystem: app.inputSystem) is false {
    exitCode = 1
  }
  if physicsTest {
    # The checks below were written for a hero that does not climb: it climbs
    # again for its own check after them
    removeClimber(
      climbing: app.physicsSystem.climbing
      parked: app.physicsSystem.moverParked
      entityId: rosterEntityAt(roster: app.players, index: 0)
    )
    exitCode = runWalkerSelfTest(
      physicsSystem: app.physicsSystem
      world: app.world
      forest: app.terrainSystem.forest
      pooledTrunks: app.settings.land is WalkerLand.forest
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    )
    # Then the knockdown: tripped, a ragdoll, up where it landed
    if runWalkerKnockTest(
      physicsSystem: app.physicsSystem
      world: app.world
      characterSystem: app.characterSystem
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    ) is false {
      exitCode = 1
    }
    # Then the footprints: a print a stride, none standing still
    if runWalkerMarkTest(
      physicsSystem: app.physicsSystem
      world: app.world
      walkerMarks: app.walkerMarks
      biome: app.biome
      groundZ: app.characterSystem.groundZ
      modelHeight: app.characterSystem.modelHeight
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    ) is false {
      exitCode = 1
    }
    # Then climbing: up the nearest tree's trunk and down again
    addClimber(
      climbing: app.physicsSystem.climbing
      entityId: rosterEntityAt(roster: app.players, index: 0)
    )
    if runWalkerClimbTest(
      physicsSystem: app.physicsSystem
      world: app.world
      treeSet: app.terrainSystem.treeSet
      pooledTrunks: app.settings.land is WalkerLand.forest
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    ) is false {
      exitCode = 1
    }
    # Then the crowd: walking about on its own, and knocked over by the hero
    # running into one standing
    if runWalkerCrowdTest(
      physicsSystem: app.physicsSystem
      world: app.world
      characterSystem: app.characterSystem
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    ) is false {
      exitCode = 1
    }
    # Then R / the menu's Reset: everything back as it started
    if runWalkerResetTest(
      walkerReset: app.walkerReset
      physicsSystem: app.physicsSystem
      world: app.world
      characterSystem: app.characterSystem
      rig: app.cameraSystem.rig
      heroEntityId: rosterEntityAt(roster: app.players, index: 0)
    ) is false {
      exitCode = 1
    }
  }
  loop not physicsTest and not splashTest and not layoutTest and not Gpu2d.pollClose() {
    beginWalkerFrame(app: app)
    updateWalkerApp(app: app)
    if Gpu2d.shouldRenderFrame(appNeedsRender: app.frame.needsRender) is false {
      # Park until the OS has something to say (shared policy, lib/ui/event_loop).
      Gpu2d.waitEvents(timeoutSec: nextWaitTimeoutSec(
        visible: Gpu2d.renderableNow()
        animating: false
        mouseDown: false
        pollWatcher: false
        frameSec: 0.016667
        heartbeatSec: 1.0
      ))
    } else {
      if let resources: mod GpuResources = app.gpuResources {
        renderWalkerApp(
          uiSystems: app.inputSystem.uiSystems
          cameraSystem: app.cameraSystem
          characterSystem: app.characterSystem
          frame: app.frame
          inputSystem: app.inputSystem
          renderSystem: app.renderSystem
          world: app.world
          physicsSystem: app.physicsSystem
          walkerMarks: app.walkerMarks
          terrainSystem: app.terrainSystem
          wadeSplash: app.wadeSplash
          waterSystem: app.waterSystem
          biome: app.biome
          resources: resources
          profiler: app.profiler
          grassCompute: app.grassCompute
        )
      }
    }
    # Frame end: report the authored components no lib table matched (this app
    # has no tables of its own) and recycle the indices of destroyed entities.
    uiFrameEnd(world: app.inputSystem.world, uiSystems: app.inputSystem.uiSystems)
  }
  if let resources: mod GpuResources = app.gpuResources {
    grassShutdown(grass: app.grassCompute, resources: resources)
    if let tree: mod ReferenceTree = app.renderSystem.referenceTree {
      releaseReferenceTree(tree: tree, resources: resources)
    }
    if let waterSystem: mod WaterSystem = app.waterSystem {
      waterShutdown(waterSystem: waterSystem, resources: resources)
    }
    spriteShutdown(cache: app.terrainSystem.sprites, resources: resources)
    farCanopyShutdown(canopy: app.terrainSystem.canopy, resources: resources)
    shutdown(resources: resources)
  }
  shutdownDeferredRenderer(renderer: app.renderSystem.renderer)  # #904: the renderer-owned GPU manager, before the C shutdown
  destroyPhysicsSystem(physicsSystem: app.physicsSystem)
  shutdown()
  Gpu2d.closeWindow()
  ret exitCode
}
