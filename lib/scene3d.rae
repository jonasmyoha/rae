# scene3d — backend-agnostic 3D scene data model for the unified renderer.
#
# This is the layer BOTH renderer backends read, and the reason the three
# seed examples (107 raymarch, 108 procedural raymarch, 109 PBR raster)
# can converge without pretending their geometry is the same thing:
#
#   - `MeshRenderer`  — explicit triangle meshes. The RASTER backend
#     (lib/gpu3d.rae + runtime_gpu3d.c) consumes these.
#   - `SdfPrimitive`  — implicit signed-distance geometry + procedural
#     displacement. gpu3d currently consumes sphere groups as smooth-union
#     metaballs; the general raymarch backend will add the other shapes.
#
# Geometry is the one place total unification is NOT possible, so it is an
# explicit tagged split rather than a lowest-common-denominator fudge.
# Everything above geometry — transforms, materials, camera, lights,
# environment — is shared, so a scene is authored once and either backend
# renders the parts it understands.
#
# WORLD CONVENTION: right-handed Z-up (Blender), per
# `docs/coordinate-system.md`. +X right, +Y forward, +Z up.
#
# Storage is parallel component arrays indexed by entity, the extraction-
# friendly shape 108 established: `renderables[i].entity` indexes
# `transforms`. Components stay primitive/Vec3-only (no inner String or
# other heap fields) — Rae's `List(Struct)` does not deep-copy inner heap
# fields reliably, so keeping components flat avoids that whole class of
# aliasing bug.
import core
open vec3

# ----- typed resource handles ----------------------------------------
# Raw `Int` handles let a material id be passed where a mesh id belongs
# and silently render garbage. These wrappers make that a type error, and
# carry a generation so a stale handle to a freed slot is detectable
# rather than aliasing whatever got allocated into that slot next.
type MeshHandle {
  id: Int
  generation: Int
}

type MaterialHandle {
  id: Int
  generation: Int
}

func meshHandle(id: view Int, generation: view Int) pub ret MeshHandle {
  ret MeshHandle { id: id, generation: generation }
}

func materialHandle(id: view Int, generation: view Int) pub ret MaterialHandle {
  ret MaterialHandle { id: id, generation: generation }
}

# The native mesh registry is 1-based (runtime_gpu3d.c returns slot+1 and
# subtracts on draw), so id 0 is the natural "nothing" value.
func meshHandleNone() pub ret MeshHandle {
  ret MeshHandle { id: 0, generation: 0 }
}

func meshHandleIsValid(h: view MeshHandle) pub ret Bool {
  ret h.id > 0
}

# ----- shared components ---------------------------------------------
# Rotation is Euler XYZ in radians, right-handed, applied as yaw about +Z
# and pitch about +X per docs/coordinate-system.md. (A Quat type is the
# natural upgrade once Rae grows one — see the follow-up queue item.)
type Transform3d {
  position: Vec3
  rotation: Vec3
  scale: Vec3
}

type Material3d {
  baseColor: Vec3
  metallic: Float
  roughness: Float
  emission: Vec3
  # Shade this surface in bands rather than with the PBR BRDF (#396).
  #
  # A MATERIAL FLAG, NOT A FRAME SETTING. The deferred G-buffer stores
  # surface attributes independently of how they are lit, so the style is
  # a different read of the same buffer — which means toon and PBR
  # objects can share one frame and one sun. A frame-wide switch would
  # have been simpler and could not express that.
  #
  # Deferred only. The forward path ignores it rather than growing a
  # second implementation of the same look.
  toon: Bool
}

type Camera3d {
  position: Vec3
  target: Vec3
  fovYDeg: Float
  nearZ: Float
  farZ: Float
}

# One directional sun + hemisphere ambient + exposure. This is exactly the
# lighting the raster uber-shader and both raymarch shaders already
# implement, so it is shared rather than duplicated per backend.
type Light3d {
  sunDir: Vec3
  sunColor: Vec3
  ambSky: Vec3
  ambGround: Vec3
  exposure: Float
  clearColor: Vec3
}

# ----- geometry components (the backend divergence point) -------------
type MeshRenderer {
  entity: Int
  mesh: MeshHandle
  material: Int
  visible: Bool
}

# shape: 0 sphere, 1 box, 2 torus — matches the raymarch shaders' switch.
#
# `cluster` groups primitives that fuse with each other. Only primitives
# sharing a cluster id blend; separate clusters are independent surfaces
# that merely occlude one another, so a scene can hold several blobs with
# different looks. `smoothing` is the cluster's stickiness — the distance
# over which two balls merge — and is read from the cluster's FIRST
# primitive (it is a property of the group, not of one ball).
#
# Albedo IS per-primitive: each ball's material colour bleeds across the
# region where its surface merges, using the same weight that fuses the
# distances. Metallic/roughness/emission come from the first primitive,
# because those shade the fused surface as a whole.
type SdfPrimitive {
  entity: Int
  shape: Int
  material: Int
  noise: Float
  cluster: Int
  smoothing: Float
}

type Scene3d {
  transforms: List(Transform3d)
  # Previous-frame transforms, same entity indexing (#336). Motion vectors
  # (TAA #335) need where each entity WAS; kept in lockstep by addTransform
  # and advanced once per frame by snapshotPrevTransforms.
  prevTransforms: List(Transform3d)
  materials: List(Material3d)
  meshRenderers: List(MeshRenderer)
  sdfPrimitives: List(SdfPrimitive)
  # Monotonic change counter (#336). Bumped by every authoring call and by
  # setTransform; a consumer (dirty-region GI updates, #338) remembers the
  # revision it last processed and compares. Mutating component lists
  # directly bypasses this — setTransform is the sanctioned mutation path.
  revision: Int
}

func createScene3d() pub ret Scene3d {
  ret Scene3d {
    transforms: createList(Transform3d, cap: 16),
    prevTransforms: createList(Transform3d, cap: 16),
    materials: createList(Material3d, cap: 8),
    meshRenderers: createList(MeshRenderer, cap: 16),
    sdfPrimitives: createList(SdfPrimitive, cap: 16),
    revision: 0
  }
}

# ----- authoring helpers ---------------------------------------------
func addTransform(scene: mod Scene3d, position: view Vec3, rotation: view Vec3, scale: view Vec3) pub ret Int {
  let entity: Int = scene.transforms.length
  scene.transforms.add(value: Transform3d { position: position, rotation: rotation, scale: scale })
  # A new entity has no history; its previous transform IS its first one,
  # so its first motion vector is zero rather than a streak from origin.
  scene.prevTransforms.add(value: Transform3d { position: position, rotation: rotation, scale: scale })
  scene.revision = scene.revision + 1
  ret entity
}

# The sanctioned way to move an entity. Writes the component AND bumps the
# revision, so change consumers (GI dirty regions) see it. prevTransforms
# is untouched here — it advances once per frame via snapshotPrevTransforms,
# not per mutation, so multiple writes in one frame yield one clean delta.
func setTransform(scene: mod Scene3d, entity: view Int, transform: view Transform3d) pub {
  scene.transforms.set(index: entity, value: transform)
  scene.revision = scene.revision + 1
}

# Advance frame history: current transforms become the previous frame's.
# Call exactly once per rendered frame, AFTER extraction/draw and before
# the next frame's mutations. Forgetting this makes motion vectors read
# zero (history always equals current) — not garbage, but TAA/velocity silently
# degrade to camera-only.
func snapshotPrevTransforms(scene: mod Scene3d) pub {
  var i: Int = 0
  loop i < scene.transforms.length {
    scene.prevTransforms.set(index: i, value: scene.transforms.at(index: i))
    i = i + 1
  }
}

func addMaterial(scene: mod Scene3d, baseColor: view Vec3, metallic: view Float, roughness: view Float, emission: view Vec3) pub ret Int {
  let index: Int = scene.materials.length
  scene.materials.add(value: Material3d { baseColor: baseColor, metallic: metallic, roughness: roughness, emission: emission, toon: false })
  ret index
}

# Switch an existing material between banded and PBR shading. Separate
# from `addMaterial` so a style toggle does not have to rebuild a scene's
# materials — the attribute lives on the material, and this flips it in
# place for every instance already referring to it.
func setMaterialToon(scene: mod Scene3d, index: view Int, toon: view Bool) pub {
  if index < 0 or index >= scene.materials.length {
    ret
  }
  let m: Material3d = scene.materials.at(index: index)
  scene.materials.set(index: index, value: Material3d {
    baseColor: m.baseColor, metallic: m.metallic, roughness: m.roughness,
    emission: m.emission, toon: toon
  })
}

# Attach a triangle mesh to a fresh entity. Raster backend renders these.
func addMeshInstance(scene: mod Scene3d, mesh: view MeshHandle, material: view Int, position: view Vec3, rotation: view Vec3, scale: view Vec3) pub ret Int {
  let entity: Int = addTransform(scene: scene, position: position, rotation: rotation, scale: scale)
  scene.meshRenderers.add(value: MeshRenderer { entity: entity, mesh: mesh, material: material, visible: true })
  ret entity
}

# Attach an SDF primitive to a fresh entity. Raymarch backend renders these.
func addSdfInstance(scene: mod Scene3d, shape: view Int, material: view Int, position: view Vec3, scale: view Vec3, noise: view Float, cluster: view Int, smoothing: view Float) pub ret Int {
  let zero: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let entity: Int = addTransform(scene: scene, position: position, rotation: zero, scale: scale)
  scene.sdfPrimitives.add(value: SdfPrimitive { entity: entity, shape: shape, material: material, noise: noise, cluster: cluster, smoothing: smoothing })
  ret entity
}

# ----- defaults ------------------------------------------------------
# Blender front view: camera on -Y looking toward +Y, world-up +Z.
func defaultCamera3d() pub ret Camera3d {
  ret Camera3d {
    position: vec3.create(x: 0.0, y: 0.0 - 12.0, z: 4.0),
    target: vec3.create(x: 0.0, y: 0.0, z: 0.5),
    fovYDeg: 50.0,
    nearZ: 0.1,
    farZ: 200.0
  }
}

# Sun from above-front (Z-up: the -Z component points the light downward).
func defaultLight3d() pub ret Light3d {
  ret Light3d {
    sunDir: vec3.create(x: 0.0 - 0.4, y: 0.3, z: 0.0 - 1.0),
    sunColor: vec3.create(x: 3.2, y: 3.0, z: 2.7),
    ambSky: vec3.create(x: 0.25, y: 0.3, z: 0.4),
    ambGround: vec3.create(x: 0.12, y: 0.1, z: 0.09),
    exposure: 1.0,
    clearColor: vec3.create(x: 0.02, y: 0.02, z: 0.03)
  }
}
