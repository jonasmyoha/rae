# sky — the environment, as two questions and nothing else.
#
# Full rationale in docs/sky-system-design.md. The short version:
#
# EVERY SKY IMPLEMENTATION ANSWERS EXACTLY TWO QUESTIONS.
#
#   skyRadiance(dir)    what the camera sees looking that way
#   skyIrradiance(n)    what a surface facing that way receives
#
# The first is the background and, later, the reflection source. The
# second is ambient light. Fixing the interface at two functions is what
# lets a photographic HDRI and a hand-painted stylised sky be swapped
# without the lighting pass changing a line — and it is why this exists
# before any sky does, rather than being retrofitted around whichever
# one gets built first.
#
# WHAT THIS MODULE DELIBERATELY IS NOT. It is not a skybox. A skybox is
# a background; this is a background AND the light that background
# implies. Splitting them is how a scene ends up lit by hand-typed
# ambient constants that disagree with what is visibly behind it — which
# is exactly the state this replaces.
#
# M0 (#399) ships ONLY the seam and the existing behaviour behind it.
# `SkyKind.none` reproduces the authored hemisphere blend the deferred
# lighting pass already performs, exactly, so landing it changes no
# pixel. That is the acceptance criterion, and test 583 is what pins it:
# a seam that quietly alters the image is not a seam, it is a rewrite
# with no way to tell which change caused what.
import core
import math
import vec3
import sky_hosek
open sky_hosek
open scene3d

enum SkyKind {
  # The authored two-colour hemisphere. Not a placeholder to be deleted:
  # it stays as the fallback for a scene that binds no sky, and as the
  # reference the other kinds are compared against.
  none
  # Equirectangular HDR photograph (#402).
  hdri
  # Analytic physical sky from a sun direction (#400).
  procedural
  # Composited layers — gradient, clouds, sun, silhouettes (#404).
  stylised
  # Hosek-Wilkie: the fitted physical model (#400). Distinct from `procedural`
  # rather than replacing it so a scene can pick the table-free Preetham
  # fallback deliberately, and so the two stay comparable.
  hosek
}

# Ordinary vegetated ground. Named rather than repeated as 0.25 in each
# constructor, because it is the value a reader has to recognise to know that a
# sky was not authored with snow or asphalt in mind.
const skyDefaultGroundAlbedo: Float = 0.25

type Sky {
  kind: SkyKind
  # Multiplies radiance and irradiance together, so the environment
  # brightens as one thing. Separate sky and ambient exposures would let
  # a scene be lit brighter than the sky it is standing under.
  exposure: Float
  # Rotate the environment about the up axis. NOT a convenience: it is
  # the difference between an HDRI being usable and being re-exported
  # from a DCC tool because its sun sits behind the camera.
  yawDeg: Float
  # Extracted from the image for `hdri` (#403), authored otherwise. Held
  # here rather than only on Light3d so that "where the sun is" has one
  # answer once a sky is bound — a sky and a light that disagree put
  # every shadow in the scene at odds with the visible sun.
  sunDir: Vec3
  sunColor: Vec3
  # The `none` payload: the hemisphere anchors and the background.
  ambSky: Vec3
  ambGround: Vec3
  clearColor: Vec3
  # The `procedural` payload (#400). Haze: 2 is an exceptionally clear
  # day, 3-6 ordinary, above 10 fog.
  turbidity: Float
  # The sun as a DISC, shared by every kind that draws a sky. Separate
  # from sunColor's intensity because the disc is ~1e5 times the sky's
  # radiance: folding it into the sky models would make their whole
  # dynamic range about the disc.
  sunAngularRadius: Float
  sunDiscIntensity: Float
  # A Hosek-Wilkie input, and the axis Preetham does not have: the sky over
  # snow is not the sky over grass, because the ground bounces light back into
  # the atmosphere. 0.1 is dark rock, ~0.25 grass, 0.8 fresh snow. Ignored by
  # every other kind.
  groundAlbedo: Float
  # The `hosek` payload: cooked from the fitted table when the sky is built,
  # so the per-frame path is a copy rather than a table walk.
  hosek: HosekSky
  # The `stylised` payload (#404). A ramp between two authored colours,
  # quantised into `bands` the same way the toon terminator is.
  zenithColor: Vec3
  horizonColor: Vec3
  bands: Float
}

# The kind, as the number the shader switches on. One place that mapping
# exists, so adding a kind cannot leave the GPU and CPU disagreeing about
# which is which.
func skyKindCode(sky: view Sky) pub ret Float {
  if sky.kind is SkyKind.hdri { ret 1.0 }
  if sky.kind is SkyKind.procedural { ret 2.0 }
  if sky.kind is SkyKind.stylised { ret 3.0 }
  if sky.kind is SkyKind.hosek { ret 4.0 }
  ret 0.0
}

# A PAINTED sky, for a cel-shaded scene (#404).
#
# NOT an HDRI and not a smooth gradient: banded, from colours the scene
# authors. A photographic environment behind a cel character reads as a
# model pasted onto a photograph, and — more subtly — a sky whose palette
# was chosen independently disagrees with the character's shadow tint,
# which the toon path takes from the sky ambient. Passing the same
# colours to both is what keeps them in step.
func createSkyStylised(sunDir: view Vec3, sunColor: view Vec3,
                       zenith: view Vec3, horizon: view Vec3,
                       bands: view Float) pub ret Sky {
  ret Sky {
    kind: SkyKind.stylised
    exposure: 1.0
    yawDeg: 0.0
    sunDir: sunDir
    sunColor: sunColor
    ambSky: zenith
    ambGround: horizon
    clearColor: horizon
    turbidity: 3.0
    # Larger and brighter than the real sun: a painted sky wants a sun
    # you can see, not an accurate 0.53-degree disc.
    sunAngularRadius: 0.05
    sunDiscIntensity: 2.0
    groundAlbedo: skyDefaultGroundAlbedo
    hosek: emptyHosekSky()
    zenithColor: zenith
    horizonColor: horizon
    bands: bands
  }
}

# The fallback sky, built from what a scene already has. Taking the
# anchors from an existing Light3d rather than from new numbers is what
# makes M0 provably a no-op.
# A PHYSICAL sky from a sun direction, using Hosek-Wilkie (#400).
#
# The default procedural sky. Preetham (createSkyProcedural) is retained
# alongside it as the table-free fallback, but this is the better fit where a
# daylight sky is actually looked at — near the horizon and at low sun — and it
# is the only one of the two that responds to ground albedo.
#
# `turbidity` is haze: 2 is an exceptionally clear day, 3-6 ordinary, above 10
# fog. `groundAlbedo` is how much light the ground bounces back up: ~0.1 dark
# rock, 0.25 grass, 0.8 fresh snow.
func createSkyHosek(data: view HosekDataset, sunDir: view Vec3, sunColor: view Vec3,
                    turbidity: view Float, groundAlbedo: view Float) pub ret Sky {
  ret Sky {
    kind: SkyKind.hosek
    exposure: 1.0
    yawDeg: 0.0
    sunDir: sunDir
    sunColor: sunColor
    # The hemisphere anchors stay populated: skyIrradiance still uses them until
    # SH9 irradiance lands (#401), so a Hosek sky is currently lit by the same
    # authored ambient as any other while its BACKGROUND is the fitted model.
    # Leaving them zero would light the scene from nothing.
    ambSky: vec3.create(x: 0.32, y: 0.45, z: 0.62)
    ambGround: vec3.create(x: 0.18, y: 0.16, z: 0.13)
    clearColor: vec3.create(x: 0.32, y: 0.45, z: 0.62)
    turbidity: turbidity
    sunAngularRadius: 0.00465
    sunDiscIntensity: 12.0
    groundAlbedo: groundAlbedo
    hosek: createHosekSky(data: data, turbidity: turbidity, albedo: groundAlbedo,
                          solarElevationRad: sunElevationRad(sunDir: sunDir))
    # Below the horizon the fit is undefined, so the shader fades to
    # horizonColor there; it is a ground tone, not a stylised ramp anchor.
    zenithColor: vec3.create(x: 0.0, y: 0.0, z: 0.0)
    horizonColor: vec3.create(x: 0.22, y: 0.20, z: 0.17)
    bands: 0.0
  }
}

func createSkyNone(light: view Light3d, clearColor: view Vec3) pub ret Sky {
  ret Sky {
    kind: SkyKind.none
    exposure: 1.0
    yawDeg: 0.0
    sunDir: light.sunDir
    sunColor: light.sunColor
    ambSky: light.ambSky
    ambGround: light.ambGround
    clearColor: clearColor
    turbidity: 3.0
    sunAngularRadius: 0.0047
    sunDiscIntensity: 0.0
    groundAlbedo: skyDefaultGroundAlbedo
    hosek: emptyHosekSky()
    zenithColor: light.ambSky
    horizonColor: light.ambGround
    bands: 1.0
  }
}

# An analytic sky from a sun direction (#400). No asset, and it ANIMATES
# — time of day is a parameter here, which a static HDRI cannot do at
# all. `sunDir` points toward the scene, matching Light3d, and is
# negated internally: the model is expressed from the surface toward the
# sun, and having one convention at the boundary beats two everywhere.
func createSkyProcedural(sunDir: view Vec3, sunColor: view Vec3,
                         turbidity: view Float) pub ret Sky {
  ret Sky {
    kind: SkyKind.procedural
    exposure: 1.0
    yawDeg: 0.0
    sunDir: sunDir
    sunColor: sunColor
    # Unused by this kind, but a Sky is one type: leaving them at zero
    # would make a mis-dispatch render black rather than merely wrong,
    # and black is harder to trace than "the old ambient".
    ambSky: vec3.create(x: 0.25, y: 0.30, z: 0.40)
    ambGround: vec3.create(x: 0.12, y: 0.10, z: 0.09)
    clearColor: vec3.create(x: 0.02, y: 0.02, z: 0.03)
    turbidity: turbidity
    # The real sun subtends about 0.53 degrees; this is its radius.
    sunAngularRadius: 0.0047
    sunDiscIntensity: 40.0
    groundAlbedo: skyDefaultGroundAlbedo
    hosek: emptyHosekSky()
    zenithColor: vec3.create(x: 0.25, y: 0.30, z: 0.40)
    horizonColor: vec3.create(x: 0.50, y: 0.55, z: 0.60)
    bands: 1.0
  }
}

# The hemisphere blend, in ONE place.
#
# Z-UP (docs/coordinate-system.md), so this blends on n.z. The forward
# renderer blends on n.y because it predates the convention; that
# disagreement is known and tracked, and this is the correct one. Every
# future sky kind reduces to a function of the same normal, so the
# convention is fixed here once rather than per implementation.
func hemisphereIrradiance(ambSky: view Vec3, ambGround: view Vec3,
                          n: view Vec3) pub ret Vec3 {
  let t: Float = n.z * 0.5 + 0.5
  ret vec3.create(
    x: ambGround.x + (ambSky.x - ambGround.x) * t,
    y: ambGround.y + (ambSky.y - ambGround.y) * t,
    z: ambGround.z + (ambSky.z - ambGround.z) * t
  )
}

# Ambient arriving at a surface facing `n`.
#
# EXPOSURE IS APPLIED HERE, not by the caller, so a sky cannot be shown
# at one brightness and light the scene at another.
func skyIrradiance(sky: view Sky, n: view Vec3) pub ret Vec3 {
  if sky.kind is SkyKind.procedural {
    # A STOPGAP, and marked as one. Ambient here is the model sampled at
    # the zenith and at the horizon away from the sun, then blended as a
    # hemisphere — which is the shape the lighting pass already consumes,
    # so #400 needs no shader change. It is not the correct integral of
    # the sky over the hemisphere; that is #401's SH9, and it will
    # replace this function's body rather than sit beside it.
    let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
    let toSun: Vec3 = vec3.create(x: 0.0 - sky.sunDir.x, y: 0.0 - sky.sunDir.y, z: 0.0 - sky.sunDir.z)
    # Away from the sun, just above the horizon, so the anchor is sky
    # rather than sun glow.
    let horiz: Vec3 = vec3.create(x: 0.0 - toSun.x, y: 0.0 - toSun.y, z: 0.08)
    let zc: Vec3 = preethamRadiance(dir: up, sunDir: toSun, turbidity: sky.turbidity)
    let hc: Vec3 = preethamRadiance(dir: horiz, sunDir: toSun, turbidity: sky.turbidity)
    let blended: Vec3 = hemisphereIrradiance(ambSky: zc, ambGround: hc, n: n)
    ret vec3.vscale(a: blended, s: sky.exposure)
  }
  if sky.kind is SkyKind.stylised {
    # DELIBERATELY NOT an integral of the painted sky. A cel scene wants
    # CHOSEN ambient — the toon path tints shadows toward this value, so
    # it has to be the palette the artist picked, not whatever averaging
    # a gradient produces.
    let blended: Vec3 = hemisphereIrradiance(ambSky: sky.zenithColor, ambGround: sky.horizonColor, n: n)
    ret vec3.vscale(a: blended, s: sky.exposure)
  }
  var c: Vec3 = hemisphereIrradiance(ambSky: sky.ambSky, ambGround: sky.ambGround, n: n)
  if sky.kind is SkyKind.none {
    # EXACTLY the existing expression when exposure is 1, which is what
    # createSkyNone sets. Multiplying unconditionally would introduce a
    # float rounding difference into a step whose entire claim is that
    # it changes nothing.
    if sky.exposure is 1.0 {
      ret c
    }
  }
  ret vec3.vscale(a: c, s: sky.exposure)
}

# What the camera sees looking along `dir`.
#
# For `none` this is the clear colour — which is what the lighting pass
# already returns at far depth, so the background is unchanged too.
func skyRadiance(sky: view Sky, dir: view Vec3) pub ret Vec3 {
  if sky.kind is SkyKind.none {
    if sky.exposure is 1.0 {
      ret sky.clearColor
    }
    ret vec3.vscale(a: sky.clearColor, s: sky.exposure)
  }
  if sky.kind is SkyKind.stylised {
    let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
    let t: Float = dir.z * 0.5 + 0.5
    let c: Vec3 = hemisphereIrradiance(ambSky: sky.zenithColor, ambGround: sky.horizonColor, n: vec3.create(x: 0.0, y: 0.0, z: dir.z))
    ret vec3.vscale(a: c, s: sky.exposure)
  }
  if sky.kind is SkyKind.procedural {
    let toSun: Vec3 = vec3.create(x: 0.0 - sky.sunDir.x, y: 0.0 - sky.sunDir.y, z: 0.0 - sky.sunDir.z)
    let c: Vec3 = preethamRadiance(dir: dir, sunDir: toSun, turbidity: sky.turbidity)
    ret vec3.vscale(a: c, s: sky.exposure)
  }
  # No implementation yet for the remaining kinds. Returning the clear
  # colour rather than a loud magenta is deliberate: an unimplemented sky
  # should look like no sky, not like a bug in the scene that binds it.
  ret sky.clearColor
}

# Is this sky merely reproducing the authored constants? Callers use it
# to keep the old uniform path until a real sky is bound, so that
# binding one is an opt-in rather than a silent change to every scene.
func skyIsFallback(sky: view Sky) pub ret Bool {
  ret sky.kind is SkyKind.none
}

# ----- procedural physical sky (#400) ---------------------------------
# Preetham et al., "A Practical Analytic Model for Daylight" (1999).
#
# WHY THIS AND NOT HOSEK-WILKIN. Hosek-Wilkie is the better model — it
# handles low sun angles and high turbidity where Preetham goes wrong,
# and it carries a ground albedo term. It also needs a table of 9x6
# fitted coefficients per channel that must be transcribed exactly. This
# is the first sky in the engine and the shape of the interface matters
# more than the last few percent of a sunset; Preetham is five closed-
# form coefficients per channel, which fits in this file and can be read
# and checked. Swapping the model later touches ONE function, which is
# the point of §2 of the design doc.
#
# The model is xyY: a luminance channel Y and two chromaticity channels
# x and y, each of the form
#
#   F(theta, gamma) = (1 + A e^(B/cos theta)) (1 + C e^(D gamma) + E cos^2 gamma)
#
# where theta is the angle from the zenith to the sample direction and
# gamma is the angle between the sample direction and the sun. The whole
# sky is that one function evaluated three times with different
# coefficients, and the coefficients are linear in TURBIDITY.
#
# TURBIDITY is haze: 2 is an exceptionally clear day, 3-6 is ordinary,
# above 10 is fog. It is the one dial worth exposing.

type PreethamCoeffs {
  a: Float
  b: Float
  c: Float
  d: Float
  e: Float
}

func preethamY(t: view Float) ret PreethamCoeffs {
  ret PreethamCoeffs {
    a: 0.1787 * t - 1.4630
    b: 0.0 - 0.3554 * t + 0.4275
    c: 0.0 - 0.0227 * t + 5.3251
    d: 0.1206 * t - 2.5771
    e: 0.0 - 0.0670 * t + 0.3703
  }
}

func preethamX(t: view Float) ret PreethamCoeffs {
  ret PreethamCoeffs {
    a: 0.0 - 0.0193 * t - 0.2592
    b: 0.0 - 0.0665 * t + 0.0008
    c: 0.0 - 0.0004 * t + 0.2125
    d: 0.0 - 0.0641 * t - 0.8989
    e: 0.0 - 0.0033 * t + 0.0452
  }
}

func preethamZ(t: view Float) ret PreethamCoeffs {
  ret PreethamCoeffs {
    a: 0.0 - 0.0167 * t - 0.2608
    b: 0.0 - 0.0950 * t + 0.0092
    c: 0.0 - 0.0079 * t + 0.2102
    d: 0.0 - 0.0441 * t - 1.6537
    e: 0.0 - 0.0109 * t + 0.0529
  }
}

# The distribution function above. `cosTheta` is clamped away from zero
# because the model's e^(B/cos theta) term diverges at the horizon —
# below it the formula is not merely inaccurate, it is unbounded, and a
# sky that returns infinity at the horizon takes the whole frame with it
# once it reaches the tonemapper.
func preethamF(c: view PreethamCoeffs, cosTheta: view Float, gamma: view Float) ret Float {
  var ct: Float = cosTheta
  if ct < 0.01 {
    ct = 0.01
  }
  let cosGamma: Float = math.cos(x: gamma)
  ret (1.0 + c.a * math.exp(x: c.b / ct))
     * (1.0 + c.c * math.exp(x: c.d * gamma) + c.e * cosGamma * cosGamma)
}

# xyY -> linear sRGB. Two conversions, kept together because they are one
# step conceptually and splitting them invites a caller to do half.
func xyYToLinearRgb(x: view Float, y: view Float, bigY: view Float) pub ret Vec3 {
  var yy: Float = y
  if yy < 0.0001 {
    yy = 0.0001
  }
  let bigX: Float = x * bigY / yy
  let bigZ: Float = (1.0 - x - y) * bigY / yy
  # sRGB primaries, D65. Negative results are out-of-gamut rather than
  # wrong; clamping is left to the caller so a wide-gamut path can keep
  # them if it ever wants to.
  ret vec3.create(
    x: 3.2406 * bigX - 1.5372 * bigY - 0.4986 * bigZ,
    y: 0.0 - 0.9689 * bigX + 1.8758 * bigY + 0.0415 * bigZ,
    z: 0.0557 * bigX - 0.2040 * bigY + 1.0570 * bigZ
  )
}

# Sky radiance along `dir`, for a sun at `sunDir`. Both must be unit
# vectors and Z-up. `dir.z < 0` is below the horizon.
#
# The sun DISC is deliberately not drawn here. It is a different
# magnitude of radiance (about 1e5 times the sky), so folding it into
# the same expression makes the whole function's dynamic range about the
# disc; and the disc's size and colour are things a stylised sky wants
# to control independently. It is added by the caller.
func preethamRadiance(dir: view Vec3, sunDir: view Vec3,
                      turbidity: view Float) pub ret Vec3 {
  let cosTheta: Float = dir.z
  var cosGamma: Float = dir.x * sunDir.x + dir.y * sunDir.y + dir.z * sunDir.z
  if cosGamma > 1.0 { cosGamma = 1.0 }
  if cosGamma < 0.0 - 1.0 { cosGamma = 0.0 - 1.0 }
  let gamma: Float = math.acos(x: cosGamma)

  var sunCosTheta: Float = sunDir.z
  if sunCosTheta < 0.01 { sunCosTheta = 0.01 }
  let thetaSun: Float = math.acos(x: sunCosTheta)

  let cy: PreethamCoeffs = preethamY(t: turbidity)
  let cx: PreethamCoeffs = preethamX(t: turbidity)
  let cz: PreethamCoeffs = preethamZ(t: turbidity)

  # NORMALISED BY THE ZENITH. The model gives relative radiance, so each
  # channel is divided by its own value looking straight up with the sun
  # where it is. Without this the sky's absolute brightness swings with
  # turbidity for no physical reason a viewer would accept.
  let fy: Float = preethamF(c: cy, cosTheta: cosTheta, gamma: gamma)
     / preethamF(c: cy, cosTheta: 1.0, gamma: thetaSun)
  let fx: Float = preethamF(c: cx, cosTheta: cosTheta, gamma: gamma)
     / preethamF(c: cx, cosTheta: 1.0, gamma: thetaSun)
  let fz: Float = preethamF(c: cz, cosTheta: cosTheta, gamma: gamma)
     / preethamF(c: cz, cosTheta: 1.0, gamma: thetaSun)

  # Zenith chromaticity and luminance for this sun elevation, from the
  # same paper. These are what turn a relative distribution into an
  # actual colour that reddens as the sun sets.
  let t: Float = turbidity
  let ts: Float = thetaSun
  let ts2: Float = ts * ts
  let ts3: Float = ts2 * ts
  let chi: Float = (4.0 / 9.0 - t / 120.0) * (3.14159265 - 2.0 * ts)
  var zenithY: Float = (4.0453 * t - 4.9710) * math.tan(x: chi) - 0.2155 * t + 2.4192
  if zenithY < 0.0 {
    zenithY = 0.0
  }
  let zenithX: Float =
      (0.00166 * ts3 - 0.00375 * ts2 + 0.00209 * ts) * t * t
    + (0.0 - 0.02903 * ts3 + 0.06377 * ts2 - 0.03202 * ts + 0.00394) * t
    + (0.11693 * ts3 - 0.21196 * ts2 + 0.06052 * ts + 0.25886)
  let zenithYc: Float =
      (0.00275 * ts3 - 0.00610 * ts2 + 0.00317 * ts) * t * t
    + (0.0 - 0.04214 * ts3 + 0.08970 * ts2 - 0.04153 * ts + 0.00516) * t
    + (0.15346 * ts3 - 0.26756 * ts2 + 0.06670 * ts + 0.26688)

  # cd/m^2 down to something a renderer's exposure expects. Purely a unit
  # choice; the shape of the sky is above.
  let scale: Float = 0.05
  ret xyYToLinearRgb(x: zenithX * fx, y: zenithYc * fz, bigY: zenithY * fy * scale)
}
