# treeSets/stylized/StylizedTrees — the stylized tree set, the walkers'
# (docs/tree-sets-design.md): createStylizedTrees is the set's data
# (treeSets/TreeSet), the rest builds its meshes and pictures. It began as
# Autumn Grove's trees and bushes (app3d/GroveTrees) and gains the
# treeGen-grown species as the reference-tree work reaches them. The foliage
# forms (procgen/FluffyFoliage: umbrella pine, cypress, spruce, bush), the
# lime, the maples, the ginkgo, the birch and the palm are generated once.
# Each tree species becomes an app3d/PropField kind at three levels of
# detail (addStylizedForestKinds), each level its wood and its leaves in
# three tones: full crowns near, sparser crowns out to the shadows' reach,
# and beyond that an impostor of the near crowns, baked on the GPU from
# every side (lib/ImpostorBake). The leaf-patch forms are unit height (their
# width is built into their meshes, speciesWidth), so a placement's scale is
# their height in meters; the others are built at autumnReferenceHeight.
# Bushes are drawn as app3d/PropInstancer parts, one per leaf tone
# (createStylizedBushParts). Used by the walkers (136, 137, 143).
import Math
import Vec3
import RendererDeferred
open FoliageMesh
open RendererImages
open procgen/Birch
open procgen/Lime
open procgen/SugarMaple
open procgen/RedMaple
open procgen/Ginkgo
open procgen/JapaneseMaple
open Noise
open Scene3d
open Mesh3d
open GbufferInstanced
open procgen/Spruce
open procgen/Cypress
open procgen/FluffyFoliage
open procgen/Foliage
open app3d/PropField
open app3d/PropInstancer
open GbufferSprite
open gpu/GpuResources
open ImpostorAtlas
open ImpostorBake
open treeSets/TreeSet

# Stable legacy kind: small-leaved lime (Tilia cordata), never renumbered.
const speciesBroadleaf: Int = 0

const speciesUmbrella: Int = 1

const speciesCypress: Int = 2

const speciesSpruce: Int = 3

# The autumn broadleaves: orange, red, gold and crimson leaves
const speciesOrange: Int = 4

const speciesRed: Int = 5

const speciesGold: Int = 6

const speciesCrimson: Int = 7

const speciesPalm: Int = 8

const speciesBirch: Int = 9

const stylizedSpeciesCount: Int = 10

# The height (m) the autumn trees and the palm are built at; a placement
# scales them from it
const autumnReferenceHeight: Float = 5.5

# The stylized set (treeSets/TreeSet): its ten species, in the order of the
# species constants above, and its stands: the leaf-patch broadleaf and
# spruce most, then the autumn trees, the umbrella pine and cypress; among
# the mixed-in trees now and then a palm (a crimson maple or a palm is never
# a stand's main species)
func createStylizedTrees() ret TreeSet {
  let species: List(TreeSpecies) = List(TreeSpecies) {
    { name: "lime", minHeight: 4.8, heightRange: 2.4, heightUnit: 1.0 }
    { name: "umbrella pine", minHeight: 5.6, heightRange: 1.8, heightUnit: 1.0 }
    { name: "cypress", minHeight: 8.0, heightRange: 3.5, heightUnit: 1.0 }
    { name: "spruce", minHeight: 5.5, heightRange: 3.0, heightUnit: 1.0 }
    { name: "sugar maple", minHeight: 4.2, heightRange: 2.6, heightUnit: autumnReferenceHeight }
    { name: "red maple", minHeight: 4.2, heightRange: 2.6, heightUnit: autumnReferenceHeight }
    { name: "ginkgo", minHeight: 4.2, heightRange: 2.6, heightUnit: autumnReferenceHeight }
    { name: "japanese maple", minHeight: 3.2, heightRange: 1.6, heightUnit: autumnReferenceHeight }
    { name: "palm", minHeight: 5.0, heightRange: 1.5, heightUnit: autumnReferenceHeight }
    { name: "birch", minHeight: 6.5, heightRange: 2.0, heightUnit: autumnReferenceHeight }
  }
  let standPicks: List(SpeciesPick) = List(SpeciesPick) {
    { upTo: 0.12, species: speciesBirch }
    { upTo: 0.26, species: speciesBroadleaf }
    { upTo: 0.40, species: speciesSpruce }
    { upTo: 0.46, species: speciesUmbrella }
    { upTo: 0.56, species: speciesCypress }
    { upTo: 0.67, species: speciesOrange }
    { upTo: 0.78, species: speciesRed }
    { upTo: 1.0, species: speciesGold }
  }
  let mixedPicks: List(SpeciesPick) = List(SpeciesPick) {
    { upTo: 0.12, species: speciesBirch }
    { upTo: 0.26, species: speciesBroadleaf }
    { upTo: 0.40, species: speciesSpruce }
    { upTo: 0.46, species: speciesUmbrella }
    { upTo: 0.56, species: speciesCypress }
    { upTo: 0.67, species: speciesOrange }
    { upTo: 0.78, species: speciesRed }
    { upTo: 0.88, species: speciesGold }
    { upTo: 0.96, species: speciesCrimson }
    { upTo: 1.0, species: speciesPalm }
  }
  ret TreeSet {
    name: "stylized"
    style: TreeSetStyle.stylized
    species: species
    standSize: 36.0
    mixedShare: 0.3
    standPicks: standPicks
    mixedPicks: mixedPicks
  }
}

func treeSpeciesForm(species: view Int) ret FluffyForm {
  if species is speciesUmbrella {
    ret FluffyForm.umbrella
  }
  if species is speciesCypress {
    ret FluffyForm.cypress
  }
  if species is speciesSpruce {
    ret FluffyForm.spruce
  }
  ret FluffyForm.broadleaf
}

# An autumn tree's or the palm's leaf color per tone (Autumn Grove's paint)
func autumnLeafColor(species: view Int, tone: view Int) ret Vec3 {
  let variation: Float = 0.85 + tone.toFloat() * 0.13
  if species is speciesOrange {
    ret Vec3.create(x: 0.86 * variation, y: 0.39 * variation, z: 0.022)
  }
  if species is speciesRed {
    ret Vec3.create(x: 0.72 * variation, y: 0.13 * variation, z: 0.025)
  }
  if species is speciesGold {
    ret Vec3.create(x: 0.88 * variation, y: 0.66 * variation, z: 0.04)
  }
  if species is speciesPalm {
    ret Vec3.create(x: 0.28 * variation, y: 0.42 * variation, z: 0.045)
  }
  ret Vec3.create(x: 0.33 * variation, y: 0.035 * variation, z: 0.022)
}

# The leaves' color per form and tone (as Autumn Grove paints them)
func leafColor(form: view FluffyForm, tone: view Int) ret Vec3 {
  let variation: Float = 0.86 + tone.toFloat() * 0.12
  var color: Vec3 = Vec3.create(x: 0.18, y: 0.35, z: 0.055)
  if form is FluffyForm.cypress {
    ret cypressLeafColor(tone: tone)
  }
  if form is FluffyForm.umbrella {
    color = Vec3.create(x: 0.055, y: 0.19, z: 0.09)
  }
  if form is FluffyForm.spruce {
    ret spruceLeafColor(tone: tone)
  }
  if form is FluffyForm.bush {
    color = Vec3.create(x: 0.28, y: 0.39, z: 0.075)
  }
  ret Vec3.vscale(a: color, s: variation)
}

func foliageMaterial(color: view Vec3) ret Material3d {
  ret Material3d {
    baseColor: color
    metallic: 0.0
    roughness: 1.0
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: true
  }
}

# The leaf tones of `form`, one instancer each, added to `parts`
func addLeafParts(
  parts: mod List(PropInstancer)
  renderer: mod DeferredRenderer
  form: view FluffyForm
  capacity: view Int
) {
  loop var tone: Int = 0, tone < 3, ++tone {
    let leaves: MeshData = fluffyLeaves(
      form: form
      seed: 73
      patchCount: 48
      tone: tone
    )
    parts.add(
      value: createPropInstancer(
        mesh: uploadFoliage(renderer: renderer, mesh: leaves)
        material: foliageMaterial(color: leafColor(form: form, tone: tone))
        capacity: capacity
      )
    )
  }
}

# The forest's levels of detail: patches per crown cluster (leaf-patch forms)
# or leaves per crown and tone (autumn trees and palm), and how far each is
# drawn. Shadows reach 120 m; every level casts them (the far level's
# billboards face the sun, cut to the picture's outline).
# The near level is the crowns' outline (procgen/FluffyFoliage,
# procgen/Foliage): every coarser level is built to cover what it does
# (docs/tree-lod-design.md §2.1, checked by app3d/TreeCoverage)
const nearPatches: Int = fluffyOutlinePatches

const midPatches: Int = 14

const nearLeaves: Int = outlineLeafCount

const midLeaves: Int = 110

# The far level is an octahedral impostor of the near level (ImpostorBake,
# one layer of the atlas per species) drawn on one quad per tree by the
# sprite pass (its picture settings: treeSets/TreeSet spritePictureAspect,
# spriteCutoff).
const nearTreeDistance: Float = 30.0

# How much wider than a unit form a species is (PropField scales uniformly,
# so the width is built into its meshes)
func speciesWidth(species: view Int) ret Float {
  if species is speciesUmbrella {
    ret 1.1
  }
  if species is speciesCypress {
    ret 0.85
  }
  ret 1.0
}

# Stretch a mesh across (x and y) by `factor`, its normals the inverse way
func widenMesh(mesh: mod MeshData, factor: view Float) {
  if factor is 1.0 {
    ret
  }
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    if vertex * 4 + 3 < mesh.windPivots.length {
      loop var axis: Int = 0, axis < 2, ++axis {
        let index: Int = vertex * 4 + axis
        mesh.windPivots.set(
          index: index
          value: mesh.windPivots.copyAtFallback(index: index, fallback: 0.0) * factor
        )
      }
    }
    if vertex * 4 + 3 < mesh.leafCards.length {
      loop var axis: Int = 0, axis < 2, ++axis {
        let index: Int = vertex * 4 + axis
        mesh.leafCards.set(index: index, value: mesh.leafCards.copyAtDefault(index: index) * factor)
      }
    }
    let base: Int = vertex * 8
    mesh.verts.set(
      index: base
      value: mesh.verts.copyAtFallback(index: base, fallback: 0.0) * factor
    )
    mesh.verts.set(
      index: base + 1
      value: mesh.verts.copyAtFallback(index: base + 1, fallback: 0.0) * factor
    )
    let normal: Vec3 = Vec3.vnorm(
      a: Vec3.create(
        x: mesh.verts.copyAtFallback(index: base + 3, fallback: 0.0) / factor
        y: mesh.verts.copyAtFallback(index: base + 4, fallback: 0.0) / factor
        z: mesh.verts.copyAtFallback(index: base + 5, fallback: 1.0)
      )
    )
    mesh.verts.set(index: base + 3, value: normal.x)
    mesh.verts.set(index: base + 4, value: normal.y)
    mesh.verts.set(index: base + 5, value: normal.z)
  }
}

# A species' wood, uploaded
func speciesWoodMesh(species: view Int) ret MeshData {
  let seed: Int = 501 + species * 104
  if species is speciesBirch {
    let tree: BirchTree = birchTree(seed: seed, height: autumnReferenceHeight)
    ret tree.wood
  }
  if species is speciesOrange {
    let tree: SugarMapleTree = sugarMapleTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret tree.wood
  }
  if species is speciesRed {
    let tree: RedMapleTree = redMapleTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret tree.wood
  }
  if species is speciesGold {
    let tree: GinkgoTree = ginkgoTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret tree.wood
  }
  if species is speciesCrimson {
    let tree: JapaneseMapleTree = japaneseMapleTree(
      seed: seed
      height: autumnReferenceHeight
      width: 2.0
      multiStem: true
    )
    ret tree.wood
  }
  if species is speciesPalm {
    ret palmWood(seed: seed, height: autumnReferenceHeight, width: 2.0)
  }
  if species >= speciesOrange {
    let tree: BroadleafTree = broadleafTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret tree.wood
  }
  var wood: MeshData = fluffyWood(form: treeSpeciesForm(species: species), seed: 73)
  widenMesh(mesh: wood, factor: speciesWidth(species: species))
  ret wood
}

func speciesWood(renderer: mod DeferredRenderer, species: view Int) ret MeshHandle {
  ret uploadFoliage(renderer: renderer, mesh: speciesWoodMesh(species: species))
}

# A species' leaves in one tone at a level's detail (`patches` for the
# leaf-patch forms, `leaves` for the autumn trees and the palm)
func speciesLeavesMesh(
  species: view Int
  tone: view Int
  patches: view Int
  leaves: view Int
) ret MeshData {
  let seed: Int = 501 + species * 104
  if species is speciesBirch {
    let tree: BirchTree = birchTree(seed: seed, height: autumnReferenceHeight)
    ret birchLeaves(twigs: tree.twigs, seed: seed, tone: tone)
  }
  if species is speciesOrange {
    let tree: SugarMapleTree = sugarMapleTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret sugarMapleLeaves(tree: tree, seed: seed, tone: tone)
  }
  if species is speciesRed {
    let tree: RedMapleTree = redMapleTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret redMapleLeaves(tree: tree, seed: seed, tone: tone)
  }
  if species is speciesGold {
    let tree: GinkgoTree = ginkgoTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret ginkgoLeaves(tree: tree, seed: seed, tone: tone)
  }
  if species is speciesCrimson {
    let tree: JapaneseMapleTree = japaneseMapleTree(
      seed: seed
      height: autumnReferenceHeight
      width: 2.0
      multiStem: true
    )
    ret japaneseMapleLeaves(tree: tree, seed: seed, tone: tone)
  }
  if species is speciesPalm {
    ret palmLeaves(
      seed: seed
      height: autumnReferenceHeight
      width: 2.0
      tone: tone
      leafCount: leaves
    )
  }
  if species >= speciesOrange {
    let tree: BroadleafTree = broadleafTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    ret broadleafLeaves(
      tips: tree.tips
      seed: seed
      height: autumnReferenceHeight
      width: 2.0
      tone: tone
      leafCount: leaves
    )
  }
  var crown: MeshData = fluffyLeaves(
    form: treeSpeciesForm(species: species)
    seed: 73
    patchCount: patches
    tone: tone
  )
  widenMesh(mesh: crown, factor: speciesWidth(species: species))
  var flexibility: Float = 1.0
  if species is speciesCypress {
    flexibility = 0.35
  } else if species is speciesUmbrella {
    flexibility = 0.55
  }
  loop var vertex: Int = 0, vertex < crown.windPivots.length / 4, ++vertex {
    if species is speciesSpruce or species is speciesCypress {
      continue
    }
    crown.windPivots.set(index: vertex * 4 + 3, value: flexibility)
  }
  ret crown
}

func speciesLeaves(
  renderer: mod DeferredRenderer
  species: view Int
  tone: view Int
  patches: view Int
  leaves: view Int
) ret MeshHandle {
  ret uploadFoliage(
    renderer: renderer
    mesh: speciesLeavesMesh(
      species: species
      tone: tone
      patches: patches
      leaves: leaves
    )
  )
}

func speciesLeafColor(species: view Int, tone: view Int) ret Vec3 {
  if species is speciesOrange {
    ret sugarMapleLeafColor(tone: tone)
  }
  if species is speciesRed {
    ret redMapleLeafColor(tone: tone)
  }
  if species is speciesGold {
    ret ginkgoLeafColor(tone: tone)
  }
  if species is speciesCrimson {
    ret japaneseMapleLeafColor(tone: tone)
  }
  if species is speciesBroadleaf {
    ret limeLeafColor(tone: tone)
  }
  if species is speciesBirch {
    ret birchLeafColor(tone: tone)
  }
  if species >= speciesOrange {
    ret autumnLeafColor(species: species, tone: tone)
  }
  ret leafColor(form: treeSpeciesForm(species: species), tone: tone)
}

# The color of every species' wood
func speciesWoodColor() ret Vec3 {
  ret Vec3.create(x: 0.13, y: 0.075, z: 0.04)
}

# A level of a species as mesh data: its wood, then its leaves in three tones
func speciesLevelMeshes(species: view Int, patches: view Int, leaves: view Int) ret List(MeshData) {
  var meshes: List(MeshData) = List.create(MeshData, cap: 4)
  if species is speciesBroadleaf {
    let tree: LimeTree = limeTree(seed: 73)
    meshes.add(value: tree.wood)
    loop var tone: Int = 0, tone < 3, ++tone {
      meshes.add(value: limeLeaves(sprays: tree.sprays, seed: 73, tone: tone))
    }
    ret own meshes
  }
  if species is speciesOrange {
    let seed: Int = 501 + species * 104
    let tree: SugarMapleTree = sugarMapleTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    meshes.add(value: tree.wood)
    loop var tone: Int = 0, tone < 3, ++tone {
      meshes.add(value: sugarMapleLeaves(tree: tree, seed: seed, tone: tone))
    }
    ret own meshes
  }
  if species is speciesRed {
    let seed: Int = 501 + species * 104
    let tree: RedMapleTree = redMapleTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    meshes.add(value: tree.wood)
    loop var tone: Int = 0, tone < 3, ++tone {
      meshes.add(value: redMapleLeaves(tree: tree, seed: seed, tone: tone))
    }
    ret own meshes
  }
  if species is speciesGold {
    let seed: Int = 501 + species * 104
    let tree: GinkgoTree = ginkgoTree(seed: seed, height: autumnReferenceHeight, width: 2.0)
    meshes.add(value: tree.wood)
    loop var tone: Int = 0, tone < 3, ++tone {
      meshes.add(value: ginkgoLeaves(tree: tree, seed: seed, tone: tone))
    }
    ret own meshes
  }
  if species is speciesCrimson {
    let seed: Int = 501 + species * 104
    let tree: JapaneseMapleTree = japaneseMapleTree(
      seed: seed
      height: autumnReferenceHeight
      width: 2.0
      multiStem: true
    )
    meshes.add(value: tree.wood)
    loop var tone: Int = 0, tone < 3, ++tone {
      meshes.add(value: japaneseMapleLeaves(tree: tree, seed: seed, tone: tone))
    }
    ret own meshes
  }
  meshes.add(value: speciesWoodMesh(species: species))
  loop var tone: Int = 0, tone < 3, ++tone {
    meshes.add(value: speciesLeavesMesh(
      species: species
      tone: tone
      patches: patches
      leaves: leaves
    ))
  }
  if species is speciesBirch {
    let tree: BirchTree = birchTree(seed: 501 + species * 104, height: autumnReferenceHeight)
    meshes.add(value: tree.twigWood)
  }
  ret meshes
}

# A species' level for app3d/TreeCoverage: its wood and its leaves in three tones, at `patches`
# patches (the leaf-patch forms) or `leaves` leaves (the autumn trees, palm)
func speciesLevelParts(species: view Int, patches: view Int, leaves: view Int) ret List(MeshData) {
  var parts: List(MeshData) = List.create(MeshData, cap: 4)
  parts.add(value: speciesWoodMesh(species: species))
  loop var tone: Int = 0, tone < 3, ++tone {
    parts.add(value: speciesLeavesMesh(
      species: species
      tone: tone
      patches: patches
      leaves: leaves
    ))
  }
  ret parts
}

# The albedos of a level's meshes, in speciesLevelMeshes' order
func speciesAlbedos(species: view Int) ret List(Vec3) {
  var albedos: List(Vec3) = List.create(Vec3, cap: 4)
  if species is speciesBirch {
    albedos.add(value: Vec3.create(x: 0.94, y: 0.95, z: 0.97))
  } else if species is speciesCypress {
    albedos.add(value: cypressWoodColor())
  } else if species is speciesSpruce {
    albedos.add(value: spruceWoodColor())
  } else if species is speciesRed {
    albedos.add(value: redMapleWoodColor())
  } else if species is speciesCrimson {
    albedos.add(value: japaneseMapleWoodColor())
  } else if species is speciesGold {
    albedos.add(value: ginkgoWoodColor())
  } else if species is speciesOrange {
    albedos.add(value: sugarMapleWoodColor())
  } else if species is speciesBroadleaf {
    albedos.add(value: limeWoodColor())
  } else {
    albedos.add(value: speciesWoodColor())
  }
  loop var tone: Int = 0, tone < 3, ++tone {
    albedos.add(value: speciesLeafColor(species: species, tone: tone))
  }
  if species is speciesBirch {
    albedos.add(value: Vec3.create(x: 0.13, y: 0.085, z: 0.055))
  }
  ret albedos
}

# A level of uploaded meshes, each in the foliage material of its albedo
func speciesLodOf(
  meshes: view List(MeshHandle)
  albedos: view List(Vec3)
  maxDistance: view Float
  castsShadow: view Bool
) ret PropLod {
  var parts: List(PropPart) = List.create(PropPart, cap: meshes.length)
  loop var part: Int = 0, part < meshes.length, ++part {
    # Part 0 is the wood, which stays still; the rest are leaves
    var sway: Float = groveLeafSway
    if part is 0 {
      sway = 0.0
    }
    parts.add(
      value: {
        mesh: meshes.copyAtDefault(index: part)
        material: foliageMaterial(
          color: albedos.copyAtFallback(index: part, fallback: speciesWoodColor())
        )
        sway: sway
      }
    )
  }
  ret PropLod {
    parts: own parts
    maxDistance: maxDistance
    castsShadow: castsShadow
    facesCamera: false
  }
}

# One level of a species: its wood and its leaves in three tones
func speciesLod(
  renderer: mod DeferredRenderer
  species: view Int
  wood: view MeshHandle
  patches: view Int
  leaves: view Int
  maxDistance: view Float
  castsShadow: view Bool
) ret PropLod {
  var meshes: List(MeshHandle) = List.create(MeshHandle, cap: 4)
  meshes.add(value: wood)
  loop var tone: Int = 0, tone < 3, ++tone {
    meshes.add(value: speciesLeaves(
      renderer: renderer
      species: species
      tone: tone
      patches: patches
      leaves: leaves
    ))
  }
  ret speciesLodOf(
    meshes: meshes
    albedos: speciesAlbedos(species: species)
    maxDistance: maxDistance
    castsShadow: castsShadow
  )
}

# Every tree species as a PropField kind (kind index = species) at three
# levels of detail: full crowns near, sparser crowns of bigger patches or
# leaves out to the shadows' reach, and beyond that an impostor of the full
# crowns (a layer of the atlas baked here, drawn by the sprite pass).
# `midDistance` is where the sparser crowns end (keep it inside the shadows'
# reach), `farDistance` where the impostors end.
func addStylizedForestKinds(
  field: mod PropField
  renderer: mod DeferredRenderer
  sprites: mod SpriteCache
  midDistance: view Float
  farDistance: view Float
) {
  RendererDeferred.ensureRendererResources(renderer: renderer)
  if let resources: mod GpuResources = renderer.gpuResources {
    spriteSetParams(
      cache: sprites
      resources: resources
      heightK: 1.0
      aspect: spritePictureAspect
      cutoff: spriteCutoff
      time: 0.0
      tilt: 0.0
    )
  }
  let birchLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: "lib/assets/trees/birchBark.png"
  )
  let birchLeafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: birchLeafTexture(style: birchCrownStyle)
  )
  let limeLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: limeBarkTexture())
  let limeLeafLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: limeLeafTexture())
  let mapleBarkLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: sugarMapleBarkTexture()
  )
  let mapleLeafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: sugarMapleLeafTexture()
  )
  let redMapleBarkLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: redMapleBarkTexture()
  )
  let redMapleLeafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: redMapleLeafTexture()
  )
  let ginkgoBarkLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: ginkgoBarkTexture())
  let ginkgoLeafLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: ginkgoLeafTexture())
  let japaneseMapleBarkLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: japaneseMapleBarkTexture()
  )
  let japaneseMapleLeafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: japaneseMapleLeafTexture()
  )
  let spruceBarkLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: spruceBarkTexture())
  let spruceLeafLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: spruceLeafTexture())
  let cypressBarkLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: cypressBarkTexture()
  )
  let cypressLeafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: cypressLeafTexture()
  )
  var subjects: List(ImpostorSubject) = List.create(ImpostorSubject, cap: stylizedSpeciesCount)
  loop var species: Int = 0, species < stylizedSpeciesCount, ++species {
    # The near level's meshes, made once: drawn near, and baked into the
    # impostor (their bounds frame it)
    let nearMeshes: List(MeshData) = speciesLevelMeshes(
      species: species
      patches: nearPatches
      leaves: nearLeaves
    )
    let albedos: List(Vec3) = speciesAlbedos(species: species)
    var nearHandles: List(MeshHandle) = List.create(MeshHandle, cap: nearMeshes.length)
    loop let mesh: view MeshData in nearMeshes {
      nearHandles.add(value: uploadFoliage(renderer: renderer, mesh: mesh))
    }
    var subject: ImpostorSubject = impostorSubject(
      parts: nearMeshes
      meshes: nearHandles
      albedos: albedos
    )
    if species is speciesBirch {
      subject.imageLayers = List(Int) {
        birchLayer
        birchLeafLayer
        birchLeafLayer
        birchLeafLayer
        -1
      }
    }
    if species is speciesBroadleaf {
      subject.imageLayers = List(Int) { limeLayer, limeLeafLayer, limeLeafLayer, limeLeafLayer }
    }
    if species is speciesOrange {
      subject.imageLayers = List(Int) {
        mapleBarkLayer
        mapleLeafLayer
        mapleLeafLayer
        mapleLeafLayer
      }
    }
    if species is speciesRed {
      subject.imageLayers = List(Int) {
        redMapleBarkLayer
        redMapleLeafLayer
        redMapleLeafLayer
        redMapleLeafLayer
      }
    }
    if species is speciesGold {
      subject.imageLayers = List(Int) {
        ginkgoBarkLayer
        ginkgoLeafLayer
        ginkgoLeafLayer
        ginkgoLeafLayer
      }
    }
    if species is speciesCrimson {
      subject.imageLayers = List(Int) {
        japaneseMapleBarkLayer
        japaneseMapleLeafLayer
        japaneseMapleLeafLayer
        japaneseMapleLeafLayer
      }
    }
    if species is speciesSpruce {
      subject.imageLayers = List(Int) {
        spruceBarkLayer
        spruceLeafLayer
        spruceLeafLayer
        spruceLeafLayer
      }
    }
    if species is speciesCypress {
      subject.imageLayers = List(Int) {
        cypressBarkLayer
        cypressLeafLayer
        cypressLeafLayer
        cypressLeafLayer
      }
    }
    var lods: List(PropLod) = List.create(PropLod, cap: 3)
    lods.add(value: speciesLodOf(
      meshes: nearHandles
      albedos: albedos
      maxDistance: nearTreeDistance
      castsShadow: true
    ))
    if species is speciesCypress or species is speciesSpruce or species is speciesBirch or species is speciesBroadleaf or species is speciesOrange or species is speciesRed or species is speciesGold or species is speciesCrimson {
      # The textured crowns share handles through the middle range; their
      # existing far level is baked from these same textured meshes.
      lods.add(value: speciesLodOf(
        meshes: nearHandles
        albedos: albedos
        maxDistance: midDistance
        castsShadow: true
      ))
    } else {
      lods.add(value: speciesLod(
        renderer: renderer
        species: species
        wood: nearHandles.copyAtDefault(index: 0)
        patches: midPatches
        leaves: midLeaves
        maxDistance: midDistance
        castsShadow: true
      ))
    }
    lods.add(
      value: {
        parts: List.create(PropPart, cap: 0)
        maxDistance: farDistance
        castsShadow: true
        facesCamera: true
      }
    )
    if species is speciesBirch {
      treeLodImages(lods: lods, barkLayer: birchLayer, leafLayer: birchLeafLayer)
    }
    if species is speciesBroadleaf {
      treeLodImages(lods: lods, barkLayer: limeLayer, leafLayer: limeLeafLayer)
    }
    if species is speciesOrange {
      treeLodImages(lods: lods, barkLayer: mapleBarkLayer, leafLayer: mapleLeafLayer)
    }
    if species is speciesRed {
      treeLodImages(lods: lods, barkLayer: redMapleBarkLayer, leafLayer: redMapleLeafLayer)
    }
    if species is speciesGold {
      treeLodImages(lods: lods, barkLayer: ginkgoBarkLayer, leafLayer: ginkgoLeafLayer)
    }
    if species is speciesCrimson {
      treeLodImages(
        lods: lods
        barkLayer: japaneseMapleBarkLayer
        leafLayer: japaneseMapleLeafLayer
      )
    }
    if species is speciesSpruce {
      treeLodImages(lods: lods, barkLayer: spruceBarkLayer, leafLayer: spruceLeafLayer)
    }
    if species is speciesCypress {
      treeLodImages(lods: lods, barkLayer: cypressBarkLayer, leafLayer: cypressLeafLayer)
    }
    # The sphere round the tree at scale 1: the leaf-patch forms are unit
    # height, the others autumnReferenceHeight
    var radius: Float = 0.6 * speciesWidth(species: species) + 0.1
    var centerHeight: Float = 0.55
    if species >= speciesOrange {
      radius = autumnReferenceHeight * 0.65
      centerHeight = autumnReferenceHeight * 0.55
    }
    if species is speciesOrange {
      radius = autumnReferenceHeight * sugarMapleRadiusScale
    }
    if species is speciesRed {
      radius = autumnReferenceHeight * redMapleRadiusScale
    }
    if species is speciesGold {
      radius = autumnReferenceHeight * ginkgoRadiusScale
    }
    if species is speciesCrimson {
      radius = japaneseMapleBoundsRadius(height: autumnReferenceHeight, width: 2)
    }
    let kind: Int = addPropKind(
      field: field
      kind: { lods: own lods, radius: radius, centerHeight: centerHeight }
    )
    setPropKindSprite(
      field: field
      kind: kind
      layer: species
      height: subject.height
    )
    subjects.add(value: subject)
  }
  if let resources: mod GpuResources = renderer.gpuResources {
    let atlas: ImpostorAtlas = bakeTexturedImpostorAtlas(
      resources: resources
      meshes: renderer.passes.gbuffer.meshes
      subjects: subjects
      settings: defaultImpostorSettings()
      cutoff: spriteCutoff
      images: renderer.passes.gbuffer.surfaceImages
    )
    setSpriteImpostors(cache: sprites, resources: resources, atlas: atlas)
  }
}

# How much the grove's leaves move in the wind (lib/wind.wgsl). Only the
# leaves sway: a tree's wood (part 0 of each level) stays still.
const groveLeafSway: Float = 1.0

# The bush's three leaf tones
func createStylizedBushParts(
  renderer: mod DeferredRenderer
  capacity: view Int
) ret List(PropInstancer) {
  var parts: List(PropInstancer) = List.create(PropInstancer, cap: 3)
  addLeafParts(
    parts: parts
    renderer: renderer
    form: FluffyForm.bush
    capacity: capacity
  )
  loop var i: Int = 0, i < parts.length, ++i {
    if let part: mod PropInstancer = parts.modAt(index: i) {
      part.sway = groveLeafSway
    }
  }
  ret parts
}

# One material assignment for every textured species and both mesh levels.
func treeLodImages(lods: mod List(PropLod), barkLayer: view Int, leafLayer: view Int) {
  loop let level: mod PropLod in lods {
    if let wood: mod PropPart = level.parts.modAt(index: 0) {
      wood.material.colorTextureLayer = barkLayer
    }
    loop var part: Int = 1, part < 4, ++part {
      if let leaves: mod PropPart = level.parts.modAt(index: part) {
        leaves.material.colorTextureLayer = leafLayer
      }
    }
  }
}
