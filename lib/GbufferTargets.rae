# GbufferTargets — the deferred POST-PASS targets, uniforms and pipelines as
# renderer-owned manager objects (#923, shared renderer slice 3c). Was C's
# runtime_gpu3d_deferred.c state: the lit HDR target + its opaque snapshot
# (litCopy), the AO target, the two TAA ping-pong/history targets, the depth
# pyramid (a half-res r32float mip chain, one view per level), the 416-byte
# light uniform + the 16-byte TAA uniform, and the lighting / TAA / pyramid
# pipelines over the C-kept WGSL sources. Everything is keyed on the geometry
# pass's targets generation (GbufferCache.targetsGen): a G-buffer rebuild
# (resize, render-scale change) retires and re-creates these at the new size,
# and every pass rebuilds its bind groups when the generation changes.
#
# The per-frame state that used to be C statics lives here too: the TAA
# ping-pong slot + "history exists" flag, the fog block (#57) and the TAA
# switch (#20, mirrored onto the GbufferCache so the geometry jitter follows).
import Math
import Sys
open Scene3d
open Math3d
open Vec3
open Sky
open SkyHosek
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuTextures
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuIds
open gpu/DeviceFeatures
open Gbuffer
open GbufferResources
open GbufferPassesNative
open GbufferFullscreen

const pyramidMaxMips: Int = 16

const lightUniformFloats: Int = 124  # 496 bytes: LightU in the lighting WGSL

const taaUniformBytes: Int = 16

type DeferredTargets {
  gen: Int  # the GbufferCache.targetsGen these were built for (-1: none)
  width: Int
  height: Int
  litFormat: Int32  # rg11b10ufloat when renderable, else rgba16float (#370)
  lit: TextureId
  litView: TextureViewId
  litCopy: TextureId
  litCopyView: TextureViewId
  # The anti-aliased scene (the antialias pass, FXAA before the upscale): same
  # extent and format as lit. `aaWritten` says this frame's pass wrote it, so
  # an app that never runs the pass composites the lit image as before.
  antialiased: TextureId
  antialiasedView: TextureViewId
  aaWritten: Bool
  # This frame's bloom (GbufferBloom, render-perf-8): the half-size glow the
  # composite adds before tone mapping, how strongly, and the generation of
  # the bloom targets (the composite rebuilds its binds when it changes).
  # `bloomWritten` is false when bloom is off or did not run.
  bloomView: TextureViewId
  bloomWritten: Bool
  bloomIntensity: Float
  bloomGen: Int
  # litCopy holds THIS frame's opaque snapshot (a transparent pass or the
  # underwater fog took it): the TAA compares the lit image with it to find
  # the pixels a transparent surface drew over (render-perf-10)
  litCopyFresh: Bool
  # RAE_TAA=1 / 0 forces TAA on / off over the app's choice (frame
  # sequences for ghosting checks); -1 when unset
  taaOverride: Int
  # The SSAO at HALF the scene size (render-perf-6, GbufferAo): `ao` is the
  # result lighting upsamples, `aoBlur` the blur's middle step, `aoDepth`
  # the half-size depth with the index of the full-size texel each kept.
  ao: TextureId
  aoView: TextureViewId
  aoBlur: TextureId
  aoBlurView: TextureViewId
  aoDepth: TextureId
  aoDepthView: TextureViewId
  taa: List(TextureId)  # ping-pong slots 0/1
  taaViews: List(TextureViewId)
  pyramid: TextureId
  pyramidViews: List(TextureViewId)  # one per mip level
  pyramidMips: Int
  # A consumer asked for the pyramid (requestDepthPyramid). Until one does,
  # the pyramid is neither allocated nor built.
  pyramidWanted: Bool
  # frame state
  taaEnabled: Bool
  taaCur: Int  # the slot the resolve writes this frame (the composite reads it)
  taaHaveHistory: Bool
  fogOn: Bool
  fogColor: Vec3
  fogStart: Float
  fogEnd: Float
  # Height mist (RendererMist): LightU's mist and mistTint
  mistOn: Bool
  mistDensity: Float
  mistFalloff: Float
  mistBaseHeight: Float
  mistTint: Vec3
  mistPaleness: Float
  # uniforms + pipelines (created once, survive resizes)
  lightUniform: BufferId
  taaUniform: BufferId
  lightPipeline: RenderPipelineId
  taaPipeline: RenderPipelineId
  pyrFromDepth: RenderPipelineId
  pyrReduce: RenderPipelineId
  pipesMade: Bool
  args: ArgWriter
  columns: List(Float)
  hosek: List(Float)  # the cooked Hosek-Wilkie state (36 floats) for the light uniform
  # The post passes of a frame (ssao, the pyramid, lighting, the transparent
  # copy and draw, underwater, taa, antialias, composite) record into an open
  # recording instead of an encoder and a submit each (render-perf-5b). It is
  # submitted by flushPostPasses: after lighting (the heaviest pass, so the
  # GPU starts on it early), after the composite, before an app draws with
  # its own encoder in the middle of the graph (snapshotOpaque), and at
  # present. Usually two submits: ssao + lighting, then the rest.
  post: opt Recording
  postInFlight: List(SubmissionId)
}

func createDeferredTargets() ret DeferredTargets {
  var hosek: List(Float) = List.create(Float, cap: 36)
  loop hosek.length < 36 {
    hosek.add(value: 0.0)
  }
  # The open post recording holds a raw encoder Ptr
  unsafe {
    ret DeferredTargets {
      gen: -1
      width: 0
      height: 0
      litFormat: WGPUTextureFormat_RGBA16Float
      lit: noTextureId()
      litView: noTextureViewId()
      litCopy: noTextureId()
      litCopyView: noTextureViewId()
      antialiased: noTextureId()
      antialiasedView: noTextureViewId()
      aaWritten: false
      bloomView: noTextureViewId()
      bloomWritten: false
      bloomIntensity: 0.0
      bloomGen: -1
      litCopyFresh: false
      taaOverride: taaOverrideFromEnv()
      ao: noTextureId()
      aoView: noTextureViewId()
      aoBlur: noTextureId()
      aoBlurView: noTextureViewId()
      aoDepth: noTextureId()
      aoDepthView: noTextureViewId()
      taa: fillTextureIds(count: 2)
      taaViews: fillTextureViewIds(count: 2)
      pyramid: noTextureId()
      pyramidViews: List.create(TextureViewId, cap: pyramidMaxMips)
      pyramidMips: 0
      pyramidWanted: false
      taaEnabled: false  # #20: FXAA by default, TAA opt-in (setTaaEnabled)
      taaCur: 0
      taaHaveHistory: false
      fogOn: false
      fogColor: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
      fogStart: 0.0
      fogEnd: 0.0
      mistOn: false
      mistDensity: 0.0
      mistFalloff: 0.0
      mistBaseHeight: 0.0
      mistTint: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      mistPaleness: 0.0
      lightUniform: noBufferId()
      taaUniform: noBufferId()
      lightPipeline: noRenderPipelineId()
      taaPipeline: noRenderPipelineId()
      pyrFromDepth: noRenderPipelineId()
      pyrReduce: noRenderPipelineId()
      pipesMade: false
      args: createArgs(uniform: true)
      columns: List.create(Float, cap: 16)
      hosek: own hosek
      post: none
      postInFlight: List.create(SubmissionId, cap: 4)
    }
  }
}

func taaOverrideFromEnv() ret Int {
  let text: String = Sys.getEnv(name: "RAE_TAA")
  if text is "1" {
    ret 1
  }
  if text is "0" {
    ret 0
  }
  ret -1
}

func targetsReady(targets: view DeferredTargets, resources: view GpuResources) ret Bool {
  ret isValidTextureView(resources: resources, id: targets.litView) and isValidTextureView(
    resources: resources
    id: targets.litCopyView
  ) and isValidTextureView(resources: resources, id: targets.aoView) and isValidTextureView(
    resources: resources
    id: targets.aoBlurView
  ) and isValidTextureView(resources: resources, id: targets.aoDepthView) and isValidTextureView(
    resources: resources
    id: targets.antialiasedView
  )
}

func retireDeferredTargets(targets: mod DeferredTargets, resources: mod GpuResources) {
  retireTextureView(resources: resources, id: targets.litView)
  retireTexture(resources: resources, id: targets.lit)
  retireTextureView(resources: resources, id: targets.litCopyView)
  retireTexture(resources: resources, id: targets.litCopy)
  retireTextureView(resources: resources, id: targets.aoView)
  retireTexture(resources: resources, id: targets.ao)
  retireTextureView(resources: resources, id: targets.aoBlurView)
  retireTexture(resources: resources, id: targets.aoBlur)
  retireTextureView(resources: resources, id: targets.aoDepthView)
  retireTexture(resources: resources, id: targets.aoDepth)
  retireTextureView(resources: resources, id: targets.antialiasedView)
  retireTexture(resources: resources, id: targets.antialiased)
  retireTaaTargets(targets: targets, resources: resources)
  retirePyramidTarget(targets: targets, resources: resources)
  targets.lit = noTextureId()
  targets.litView = noTextureViewId()
  targets.litCopy = noTextureId()
  targets.litCopyView = noTextureViewId()
  targets.ao = noTextureId()
  targets.aoView = noTextureViewId()
  targets.aoBlur = noTextureId()
  targets.aoBlurView = noTextureViewId()
  targets.aoDepth = noTextureId()
  targets.aoDepthView = noTextureViewId()
  targets.antialiased = noTextureId()
  targets.antialiasedView = noTextureViewId()
  targets.aaWritten = false
  targets.width = 0
  targets.height = 0
  targets.gen = -1
}

func makeTarget(
  resources: mod GpuResources
  width: copy Int
  height: copy Int
  format: copy Int32
  usage: copy UInt64
  texture: mod TextureId
  textureView: mod TextureViewId
) ret Bool {
  if let made: TextureId = createTexture(
    resources: resources
    width: width
    height: height
    format: format
    usage: usage
  ) {
    if let madeView: TextureViewId = createTextureView(resources: resources, texture: made) {
      texture = made
      textureView = madeView
      ret true
    }
    retireTexture(resources: resources, id: made)
  }
  ret false
}

# (Re)create everything downstream of the G-buffer whenever the G-buffer was
# recreated — keyed on its generation, not on dimensions: a resize back to a
# previous size still invalidates every bind group.
func ensureDeferredTargets(
  targets: mod DeferredTargets
  resources: mod GpuResources
  gbuffer: view GbufferCache
) ret Bool {
  if targets.gen is gbuffer.targetsGen and targetsReady(targets: targets, resources: resources) {
    ret true
  }
  if gbuffer.targetWidth < 1 or gbuffer.targetHeight < 1 {
    ret false
  }
  if not gbufferTargetsReady(cache: gbuffer, resources: resources) {
    ret false
  }
  # The open post recording may still name the targets about to be retired
  flushPostPasses(targets: targets, resources: resources)
  retireDeferredTargets(targets: targets, resources: resources)
  let w: Int = gbuffer.targetWidth
  let h: Int = gbuffer.targetHeight
  unsafe {
    if webgpuHaveRg11b10() is 1 {
      targets.litFormat = WGPUTextureFormat_RG11B10Ufloat
    } else {
      targets.litFormat = WGPUTextureFormat_RGBA16Float
    }
  }
  let attach: UInt64 = WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
  var ok: Bool = makeTarget(
    resources: resources
    width: w
    height: h
    format: targets.litFormat
    usage: attach + WGPUTextureUsage_CopySrc
    texture: targets.lit
    textureView: targets.litView
  )
  # Same extent/format as the lit target, sampled by transparent materials
  # (the #842 opaque snapshot) and the underwater fog.
  if ok {
    ok = makeTarget(
      resources: resources
      width: w
      height: h
      format: targets.litFormat
      usage: WGPUTextureUsage_CopyDst + WGPUTextureUsage_TextureBinding
      texture: targets.litCopy
      textureView: targets.litCopyView
    )
  }
  # The anti-aliased scene: written by the antialias pass, sampled by the
  # composite.
  if ok {
    ok = makeTarget(
      resources: resources
      width: w
      height: h
      format: targets.litFormat
      usage: attach
      texture: targets.antialiased
      textureView: targets.antialiasedView
    )
  }
  # AO (#387) at half the scene size (render-perf-6), rounded up so every
  # full-size pixel has a half texel: r8unorm results (one byte, writable as
  # a colour attachment) and the rg32float half depth (depth + kept index).
  let halfWidth: Int = (w + 1) / 2
  let halfHeight: Int = (h + 1) / 2
  if ok {
    ok = makeTarget(
      resources: resources
      width: halfWidth
      height: halfHeight
      format: WGPUTextureFormat_R8Unorm
      usage: attach
      texture: targets.ao
      textureView: targets.aoView
    )
  }
  if ok {
    ok = makeTarget(
      resources: resources
      width: halfWidth
      height: halfHeight
      format: WGPUTextureFormat_R8Unorm
      usage: attach
      texture: targets.aoBlur
      textureView: targets.aoBlurView
    )
  }
  if ok {
    ok = makeTarget(
      resources: resources
      width: halfWidth
      height: halfHeight
      format: WGPUTextureFormat_RG32Float
      usage: attach
      texture: targets.aoDepth
      textureView: targets.aoDepthView
    )
  }
  if not ok {
    retireDeferredTargets(targets: targets, resources: resources)
    ret false
  }
  targets.width = w
  targets.height = h
  targets.taaHaveHistory = false
  targets.gen = gbuffer.targetsGen
  ret true
}

# The pipelines + uniforms, created once. The lit format is decided with the
# targets, so this runs after the first ensureDeferredTargets.
func ensureDeferredPipelines(targets: mod DeferredTargets, resources: mod GpuResources) {
  if targets.pipesMade {
    ret
  }
  targets.pipesMade = true
  # The f16 variant when the device has shader-f16 (render-perf-12)
  var lightShader: Shader = shader(files: [
    "lib/precision_f32.wgsl"
    "lib/gbuffer_octahedral.wgsl"
    "lib/sky_hosek.wgsl"
    "lib/deferred_uniforms.wgsl"
    "lib/deferred_shade.wgsl"
    "lib/ssao_upsample.wgsl"
    "lib/deferred_light.wgsl"
  ])
  if deviceHasShaderF16() {
    lightShader = shader(files: [
      "lib/precision_f16.wgsl"
      "lib/gbuffer_octahedral.wgsl"
      "lib/sky_hosek.wgsl"
      "lib/deferred_uniforms.wgsl"
      "lib/deferred_shade.wgsl"
      "lib/ssao_upsample.wgsl"
      "lib/deferred_light.wgsl"
    ])
  }
  let taaShader: Shader = shader(files: ["lib/deferred_taa.wgsl"])
  let pyramidFromDepthShader: Shader = shader(files: ["lib/deferred_pyramid_from_depth.wgsl"])
  let pyramidReduceShader: Shader = shader(files: ["lib/deferred_pyramid_reduce.wgsl"])
  targets.lightPipeline = createFullscreenPipeline(
    resources: resources
    shader: lightShader
    format: targets.litFormat
  )
  targets.taaPipeline = createFullscreenPipeline(
    resources: resources
    shader: taaShader
    format: targets.litFormat
  )
  targets.pyrFromDepth = createFullscreenPipeline(
    resources: resources
    shader: pyramidFromDepthShader
    format: WGPUTextureFormat_R32Float
  )
  targets.pyrReduce = createFullscreenPipeline(
    resources: resources
    shader: pyramidReduceShader
    format: WGPUTextureFormat_R32Float
  )
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: lightUniformFloats * 4
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    targets.lightUniform = uniform
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: taaUniformBytes
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    targets.taaUniform = uniform
  }
}

func pyramidViewRef(targets: view DeferredTargets, level: copy Int) ret ResourceRef {
  if let levelView: TextureViewId = targets.pyramidViews.copyAt(index: level) {
    ret textureViewRef(id: levelView)
  }
  ret noRef()
}

# The TAA history: two ping-pong slots at the scene size, in the radiance
# format (the resolve accumulates LINEAR HDR, before the composite's tone
# curve). They are made when TAA is on (postPassReady), not with the other
# targets: an app on FXAA never pays for two HDR targets. Once made they stay
# until the next resize, because the TAA and composite passes keep bind groups
# that point at them.
func ensureTaaTargets(targets: mod DeferredTargets, resources: mod GpuResources) ret Bool {
  if taaTargetsMade(targets: targets, resources: resources) {
    ret true
  }
  retireTaaTargets(targets: targets, resources: resources)
  var ok: Bool = true
  loop var i: Int = 0, i < 2, ++i {
    if ok {
      var texture: TextureId = noTextureId()
      var slotView: TextureViewId = noTextureViewId()
      ok = makeTarget(
        resources: resources
        width: targets.width
        height: targets.height
        format: targets.litFormat
        usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
        texture: texture
        textureView: slotView
      )
      targets.taa.set(index: i, value: texture)
      targets.taaViews.set(index: i, value: slotView)
    }
  }
  if not ok {
    retireTaaTargets(targets: targets, resources: resources)
  }
  ret ok
}

func taaTargetsMade(targets: view DeferredTargets, resources: view GpuResources) ret Bool {
  loop let slotView: TextureViewId in targets.taaViews {
    if not isValidTextureView(resources: resources, id: slotView) {
      ret false
    }
  }
  ret true
}

func retireTaaTargets(targets: mod DeferredTargets, resources: mod GpuResources) {
  retireTextureViewIds(resources: resources, list: targets.taaViews)
  retireTextureIds(resources: resources, list: targets.taa)
  targets.taa = fillTextureIds(count: 2)
  targets.taaViews = fillTextureViewIds(count: 2)
  targets.taaHaveHistory = false
}

# The depth pyramid: half the scene size, a MIN mip chain down to 1x1
# (bounded). Made by the first pyramid pass a consumer asked for; it stays
# until the next resize, like the TAA history.
func ensurePyramidTarget(targets: mod DeferredTargets, resources: mod GpuResources) ret Bool {
  if targets.pyramidMips > 0 {
    ret true
  }
  var pw: Int = targets.width / 2
  var ph: Int = targets.height / 2
  if pw < 1 {
    pw = 1
  }
  if ph < 1 {
    ph = 1
  }
  var mips: Int = 1
  var m: Int = pw
  if ph > m {
    m = ph
  }
  loop m > 1 and mips < pyramidMaxMips {
    m = m / 2
    mips = mips + 1
  }
  var ok: Bool = false
  if let pyramid: TextureId = createTextureMipped(
    resources: resources
    width: pw
    height: ph
    format: WGPUTextureFormat_R32Float
    usage: WGPUTextureUsage_RenderAttachment + WGPUTextureUsage_TextureBinding
    mipLevels: mips
  ) {
    targets.pyramid = pyramid
    ok = true
    loop var level: Int = 0, level < mips, ++level {
      if let mipView: TextureViewId = createTextureViewMip(
        resources: resources
        texture: pyramid
        mip: level
      ) {
        targets.pyramidViews.add(value: mipView)
      } else {
        ok = false
      }
    }
  }
  if not ok {
    retirePyramidTarget(targets: targets, resources: resources)
    ret false
  }
  targets.pyramidMips = mips
  ret true
}

func retirePyramidTarget(targets: mod DeferredTargets, resources: mod GpuResources) {
  retireTextureViewIds(resources: resources, list: targets.pyramidViews)
  targets.pyramidViews.clear()
  retireTexture(resources: resources, id: targets.pyramid)
  targets.pyramid = noTextureId()
  targets.pyramidMips = 0
}

func taaViewRef(targets: view DeferredTargets, slot: copy Int) ret ResourceRef {
  if let slotView: TextureViewId = targets.taaViews.copyAt(index: slot) {
    ret textureViewRef(id: slotView)
  }
  ret noRef()
}

# What the composite samples: the TAA resolve when it ran (the slot written
# this frame), else the raw lit radiance; the index keys the composite's bind.
# What the composite upscales: the TAA resolve, else this frame's
# anti-aliased scene, else the lit image (an app that never ran the antialias
# pass).
func compositeSourceRef(targets: view DeferredTargets) ret ResourceRef {
  if targets.taaEnabled {
    ret taaViewRef(targets: targets, slot: targets.taaCur)
  }
  if targets.aaWritten {
    ret textureViewRef(id: targets.antialiasedView)
  }
  ret textureViewRef(id: targets.litView)
}

func compositeSourceIndex(targets: view DeferredTargets) ret Int {
  if targets.taaEnabled {
    ret targets.taaCur
  }
  if targets.aaWritten {
    ret 3
  }
  ret 2
}

# TAA per frame: flip the write slot (resolve into the slot not read this
# frame) and upload the history flag; taaEnd marks that history now exists.
func taaBegin(targets: mod DeferredTargets, resources: mod GpuResources) ret Int {
  targets.taaCur = 1 - targets.taaCur
  var history: Float = 0.0
  if targets.taaHaveHistory {
    history = 1.0
  }
  var litCopyFresh: Float = 0.0
  if targets.litCopyFresh {
    litCopyFresh = 1.0
  }
  resetArgs(writer: targets.args)
  pushVec4F(
    writer: targets.args
    x: history
    y: litCopyFresh
    z: 0.0
    w: 0.0
  )
  let uploaded: Bool = uploadArgs(
    writer: targets.args
    resources: resources
    buffer: targets.taaUniform
    offset: 0
  )
  ret targets.taaCur
}

func taaEnd(targets: mod DeferredTargets) {
  targets.taaHaveHistory = true
}

func pushMatrixColumns(targets: mod DeferredTargets, m: view Mat4) {
  targets.columns.clear()
  loop let column: Float in m.m {
    targets.columns.add(value: column)
  }
  let pushed: Bool = pushMat4(writer: targets.args, columns: targets.columns)
}

# The SSAO's share of the light uniform (it runs BEFORE lighting): the inverse
# of the jittered viewProj + the camera at the top, the jittered viewProj at
# float 40, the rest zero. Lighting rewrites the same values later from the
# same matrices, so they cannot disagree.
func uploadSsaoUniform(
  targets: mod DeferredTargets
  resources: mod GpuResources
  gbuffer: view GbufferCache
  camera: view Camera3d
) ret Bool {
  resetArgs(writer: targets.args)
  pushMatrixColumns(targets: targets, m: mat4Inverse(a: gbuffer.viewProjJittered))
  pushVec4F(
    writer: targets.args
    x: camera.position.x
    y: camera.position.y
    z: camera.position.z
    w: 0.0
  )
  loop var i: Int = 0, i < 5, ++i {
    pushVec4F(
      writer: targets.args
      x: 0.0
      y: 0.0
      z: 0.0
      w: 0.0
    )
  }
  pushMatrixColumns(targets: targets, m: gbuffer.viewProjJittered)
  loop var i: Int = 0, i < 12, ++i {
    pushVec4F(
      writer: targets.args
      x: 0.0
      y: 0.0
      z: 0.0
      w: 0.0
    )
  }
  ret uploadArgs(
    writer: targets.args
    resources: resources
    buffer: targets.lightUniform
    offset: 0
  )
}

# The cooked Hosek-Wilkie coefficients for the light uniform: three vec4 per
# channel (a..i + radiance, 10 of 12 floats), matching the WGSL `hosek` layout.
func setHosekChannel(targets: mod DeferredTargets, c: view HosekChannel, base: copy Int) {
  targets.hosek.set(index: base + 0, value: c.a)
  targets.hosek.set(index: base + 1, value: c.b)
  targets.hosek.set(index: base + 2, value: c.c)
  targets.hosek.set(index: base + 3, value: c.d)
  targets.hosek.set(index: base + 4, value: c.e)
  targets.hosek.set(index: base + 5, value: c.f)
  targets.hosek.set(index: base + 6, value: c.g)
  targets.hosek.set(index: base + 7, value: c.h)
  targets.hosek.set(index: base + 8, value: c.i)
  targets.hosek.set(index: base + 9, value: c.radiance)
}

func hosekAt(targets: view DeferredTargets, index: copy Int) ret Float {
  ret targets.hosek.copyAtFallback(index: index, fallback: 0.0)
}

# The whole light uniform (LightU): inverse jittered viewProj, camera +
# exposure scale, sun, sun colour (+ fog start in .w), sky ambient (+ fog end),
# ground ambient, the fog block (#57: rgb + enabled flag, else the clear
# colour), the jittered viewProj, the sky params, then the cooked Hosek state.
func uploadLightUniform(
  targets: mod DeferredTargets
  resources: mod GpuResources
  gbuffer: view GbufferCache
  camera: view Camera3d
  exposureScale: copy Float
  sunDir: view Vec3
  sunColor: view Vec3
  skyAmbient: view Vec3
  groundAmbient: view Vec3
  skyKind: copy Float
  turbidity: copy Float
  skyExposure: copy Float
  sunSizeRad: copy Float
  zenith: view Vec3
  bands: copy Float
  horizon: view Vec3
  discIntensity: copy Float
  skySunDir: view Vec3
  moonDir: view Vec3
  moonRadius: copy Float
  moonIntensity: copy Float
  nightLight: copy Float
) ret Bool {
  var fogStart: Float = 0.0
  var fogEnd: Float = 0.0
  var fogRgb: Vec3 = gbuffer.clearColor
  var fogFlag: Float = 0.0
  if targets.fogOn {
    fogStart = targets.fogStart
    fogEnd = targets.fogEnd
    fogRgb = targets.fogColor
    fogFlag = 1.0
  }
  resetArgs(writer: targets.args)
  pushMatrixColumns(targets: targets, m: mat4Inverse(a: gbuffer.viewProjJittered))
  pushVec4F(
    writer: targets.args
    x: camera.position.x
    y: camera.position.y
    z: camera.position.z
    # the camera's exposure scale (LightUnits): the shader exposes the sky
    # models, the moon and the night sky with it
    w: exposureScale
  )
  pushVec4F(
    writer: targets.args
    x: sunDir.x
    y: sunDir.y
    z: sunDir.z
    w: gbuffer.targetWidth.toFloat()  # the scene size: the forward entry rebuilds positions
  )
  pushVec4F(
    writer: targets.args
    x: sunColor.x
    y: sunColor.y
    z: sunColor.z
    w: fogStart
  )
  pushVec4F(
    writer: targets.args
    x: skyAmbient.x
    y: skyAmbient.y
    z: skyAmbient.z
    w: fogEnd
  )
  pushVec4F(
    writer: targets.args
    x: groundAmbient.x
    y: groundAmbient.y
    z: groundAmbient.z
    w: gbuffer.targetHeight.toFloat()
  )
  pushVec4F(
    writer: targets.args
    x: fogRgb.x
    y: fogRgb.y
    z: fogRgb.z
    w: fogFlag
  )
  pushMatrixColumns(targets: targets, m: gbuffer.viewProjJittered)
  pushVec4F(
    writer: targets.args
    x: skyKind
    y: turbidity
    z: skyExposure
    w: sunSizeRad
  )
  pushVec4F(
    writer: targets.args
    x: zenith.x
    y: zenith.y
    z: zenith.z
    w: bands
  )
  pushVec4F(
    writer: targets.args
    x: horizon.x
    y: horizon.y
    z: horizon.z
    w: discIntensity
  )
  loop var i: Int = 0, i < 9, ++i {
    pushVec4F(
      writer: targets.args
      x: hosekAt(targets: targets, index: i * 4)
      y: hosekAt(targets: targets, index: i * 4 + 1)
      z: hosekAt(targets: targets, index: i * 4 + 2)
      w: hosekAt(targets: targets, index: i * 4 + 3)
    )
  }
  var mistFlag: Float = 0.0
  if targets.mistOn {
    mistFlag = 1.0
  }
  pushVec4F(
    writer: targets.args
    x: targets.mistDensity
    y: targets.mistFalloff
    z: targets.mistBaseHeight
    w: mistFlag
  )
  pushVec4F(
    writer: targets.args
    x: targets.mistTint.x
    y: targets.mistTint.y
    z: targets.mistTint.z
    w: targets.mistPaleness
  )
  # The sky's own sun (the key light may be the moon at night) and the moon:
  # the way TOWARD each, as the sky shader looks
  pushVec4F(
    writer: targets.args
    x: -skySunDir.x
    y: -skySunDir.y
    z: -skySunDir.z
    w: moonRadius
  )
  pushVec4F(
    writer: targets.args
    x: -moonDir.x
    y: -moonDir.y
    z: -moonDir.z
    w: moonIntensity
  )
  pushVec4F(
    writer: targets.args
    x: nightLight
    y: 0.0
    z: 0.0
    w: 0.0
  )
  ret uploadArgs(
    writer: targets.args
    resources: resources
    buffer: targets.lightUniform
    offset: 0
  )
}

# The encoder of the frame's open post recording, opened on first use. A
# post pass records its render passes and copies into it; nothing reaches the
# GPU until flushPostPasses. Null when no encoder could be made.
func postEncoder(targets: mod DeferredTargets, resources: mod GpuResources) ret Ptr {
  if let recording: view Recording = targets.post {
    if recordingIsOpen(recording: recording, resources: resources) {
      unsafe {
        ret recording.encoder
      }
    }
  }
  if var recording: Recording = beginRecording(resources: resources) {
    unsafe {
      let encoder: Ptr = recording.encoder
      targets.post = own recording
      ret encoder
    }
  }
  unsafe {
    ret webgpuNull()
  }
}

# Submit the open post recording, if any (one submit for every post pass
# recorded since the last flush). Every post pass writes its own uniform
# once per frame, so the queue's buffer writes, which all land before the
# submit, give each pass the values it uploaded; the one shared buffer, the
# light uniform, gets the same camera matrices from SSAO and lighting.
func flushPostPasses(targets: mod DeferredTargets, resources: mod GpuResources) {
  if let recording: mod Recording = targets.post {
    let tracked: opt SubmissionId = trackSubmission(
      inFlight: targets.postInFlight
      resources: resources
      recording: recording
    )
  }
  targets.post = none
  pollSubmissions(inFlight: targets.postInFlight, resources: resources)
}

# Retire everything (renderer shutdown).
func deferredTargetsShutdown(targets: mod DeferredTargets, resources: mod GpuResources) {
  flushPostPasses(targets: targets, resources: resources)
  drainSubmissions(inFlight: targets.postInFlight, resources: resources)
  retireDeferredTargets(targets: targets, resources: resources)
  retireBuffer(resources: resources, id: targets.lightUniform)
  retireBuffer(resources: resources, id: targets.taaUniform)
  retireRenderPipeline(resources: resources, id: targets.lightPipeline)
  retireRenderPipeline(resources: resources, id: targets.taaPipeline)
  retireRenderPipeline(resources: resources, id: targets.pyrFromDepth)
  retireRenderPipeline(resources: resources, id: targets.pyrReduce)
  targets.lightUniform = noBufferId()
  targets.taaUniform = noBufferId()
  targets.lightPipeline = noRenderPipelineId()
  targets.taaPipeline = noRenderPipelineId()
  targets.pyrFromDepth = noRenderPipelineId()
  targets.pyrReduce = noRenderPipelineId()
  targets.pipesMade = false
}
