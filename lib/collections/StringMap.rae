# collections/StringMap.rae — StringMap(V), an open-addressing string-keyed map.
# A collections-package module: NOT in the prelude — `import collections/StringMap`.
type StringMapEntry(V: type) {
  k: String
  value: V
  occupied: Bool
}

type StringMap(V: type) {
  data: Buffer(StringMapEntry(V))
  length: Int
  cap: Int
  isGrowing: Bool
}

func createStringMap(V: type, cap: view Int) ret StringMap(V) {
  unsafe {
    ret StringMap(V) {
      data: rae_ext_rae_buf_alloc(size: cap, elemSize: sizeof(StringMapEntry(V)))
      length: 0
      cap: cap
      isGrowing: false
    }
  }
}

# The constructor by name (#880): `var m: StringMap(Int) = create(cap: 8)`.
func create(V: type, cap: view Int) ret StringMap(V) {
  ret StringMap.create(V, cap: cap)
}

func set(
  V: type
  this: mod StringMap(V)
  k: view String
  value: own V
) {
  unsafe {
    if this.cap is 0 {
      this.cap = 8
      this.data = rae_ext_rae_buf_alloc(size: this.cap, elemSize: sizeof(StringMapEntry(V)))
    }
    if not this.isGrowing and this.length * 2 > this.cap {
      growStringMap(this)
    }
    let h: Int = rae_str_hash(s: k)
    var idx: Int = h % this.cap
    if idx < 0 {
      idx = -idx
    }
    loop true {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: idx)
      if not entry.occupied {
        # Deep-copy the key so the map owns its own heap copy. Without
        # this, world.nodeIds-style maps shallow-alias the caller's
        # `k` (e.g. scene.nodes[i].nodeId) and the map's drop frees
        # those pointers, corrupting the source storage on the next
        # rebuild. The struct-literal codegen's per-field deep-copy
        # (Phase 2) does this automatically for non-generic structs
        # but not yet for generic StringMapEntry(V).
        let keyCopy: String = rae_ext_rae_string_copy(string: k)
        rae_ext_rae_buf_set(
          buf: this.data
          index: idx
          value: { k: own keyCopy, value: own value, occupied: true }
        )
        this.length = this.length + 1
        ret
      }
      if rae_str_eq(a: entry.k, b: k) {
        # Replace the whole entry: release the old key and value, then
        # store a fresh one exactly as the insert path above does.
        # (`entry` is a bitwise copy of the slot; assigning its `value`
        # never released the old one, so every overwrite of a heap value
        # leaked it.)
        rae_ext_rae_buf_drop_at(buf: this.data, index: idx)
        let keyCopy: String = rae_ext_rae_string_copy(string: k)
        rae_ext_rae_buf_set(
          buf: this.data
          index: idx
          value: { k: own keyCopy, value: own value, occupied: true }
        )
        ret
      }
      idx = (idx + 1) % this.cap
    }
  }
}

# A window into the stored value, rather than a copy of it. Same probe as
# `get`; the difference is only what comes back. `none` when the key is
# absent — the reference has no empty state of its own.
func viewGet(V: type, this: view StringMap(V), key: view String) ret opt view V {
  unsafe {
    if this.cap is 0 {
      ret none
    }
    let hash: Int = rae_str_hash(s: key)
    var idx: Int = hash % this.cap
    if idx < 0 {
      idx = -idx
    }
    let startIdx: Int = idx
    loop true {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: idx)
      if not entry.occupied {
        ret none
      }
      if rae_str_eq(a: entry.k, b: key) {
        # Read the slot again as a reference: `entry` above is a copy, so a
        # view of ITS field would name a local that dies with this function.
        ret view rae_ext_rae_buf_get(buf: this.data, index: idx).value
      }
      idx = (idx + 1) % this.cap
      if idx is startIdx {
        ret none
      }
    }
  }
}

# Mutable window into the stored value. Writing through it updates the map
# in place, with no drop-and-reinsert of the value's owned fields.
func modGet(V: type, this: mod StringMap(V), key: view String) ret opt mod V {
  unsafe {
    if this.cap is 0 {
      ret none
    }
    let hash: Int = rae_str_hash(s: key)
    var idx: Int = hash % this.cap
    if idx < 0 {
      idx = -idx
    }
    let startIdx: Int = idx
    loop true {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: idx)
      if not entry.occupied {
        ret none
      }
      if rae_str_eq(a: entry.k, b: key) {
        ret mod rae_ext_rae_buf_get(buf: this.data, index: idx).value
      }
      idx = (idx + 1) % this.cap
      if idx is startIdx {
        ret none
      }
    }
  }
}

func get(V: type, this: view StringMap(V), k: view String) ret opt V {
  unsafe {
    if this.cap is 0 {
      ret none
    }
    let h: Int = rae_str_hash(s: k)
    var idx: Int = h % this.cap
    if idx < 0 {
      idx = -idx
    }
    let startIdx: Int = idx
    loop true {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: idx)
      if not entry.occupied {
        ret none
      }
      if rae_str_eq(a: entry.k, b: k) {
        ret entry.value
      }
      idx = (idx + 1) % this.cap
      if idx is startIdx {
        ret none
      }
    }
  }
}

# Through viewGet, not get: get returns an owned COPY of the value, and a
# temporary optional that is only compared to none is never released — one
# leaked copy of a heap value per call.
func has(V: type, this: view StringMap(V), k: view String) ret Bool {
  ret viewGet(this, key: k) is not none
}

func remove(V: type, this: mod StringMap(V), k: view String) {
  unsafe {
    if this.cap is 0 {
      ret
    }
    let h: Int = rae_str_hash(s: k)
    var idx: Int = h % this.cap
    if idx < 0 {
      idx = -idx
    }
    let startIdx: Int = idx
    loop true {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: idx)
      if not entry.occupied {
        ret
      }
      if rae_str_eq(a: entry.k, b: k) {
        # Backward-shift deletion. This is open addressing with linear
        # probing and NO tombstones, so merely clearing the slot would cut
        # the probe chain: every key that had probed PAST this slot becomes
        # unreachable to get/set until something happens to re-insert it
        # (unmountPage removing a page's node ids used to make a chrome id
        # vanish for a frame). Walk the run after the hole and pull back
        # each entry whose home slot is not cyclically inside (hole, probe]
        # — it belongs before the hole, so it may fill it — carrying the
        # dead entry along to the final hole (no slot ever holds two
        # copies of one entry's heap).
        entry.occupied = false
        rae_ext_rae_buf_set(buf: this.data, index: idx, value: entry)
        # A shallow re-read of the now-dead slot (buf_get copies the struct
        # bitwise; a `var x = entry` would ask for a deep copy).
        let dead: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: idx)
        var hole: Int = idx
        var probe: Int = idx
        loop true {
          probe = (probe + 1) % this.cap
          let next: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: probe)
          if not next.occupied or probe is idx {
            break
          }
          var home: Int = rae_str_hash(s: next.k) % this.cap
          if home < 0 {
            home = -home
          }
          var stays: Bool = false
          if hole < probe {
            stays = home > hole and home <= probe
          } else {
            stays = home > hole or home <= probe
          }
          if not stays {
            rae_ext_rae_buf_set(buf: this.data, index: hole, value: next)
            hole = probe
          }
        }
        rae_ext_rae_buf_set(buf: this.data, index: hole, value: dead)
        # The removed entry ends here: release its key and value. It sits
        # unoccupied, so nothing reads it again, but its heap was never
        # freed (#85206966: every removed key leaked, e.g. unmountPage's
        # node ids on every remount).
        rae_ext_rae_buf_drop_at(buf: this.data, index: hole)
        this.length = this.length - 1
        ret
      }
      idx = (idx + 1) % this.cap
      if idx is startIdx {
        ret
      }
    }
  }
}

func keys(V: type, this: view StringMap(V)) ret List(String) {
  unsafe {
    let result: List(String) = List.create(String, cap: this.length)
    var i: Int = 0
    loop i < this.cap {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: i)
      if entry.occupied {
        add(result, value: entry.k)
      }
      i = i + 1
    }
    ret result
  }
}

func values(V: type, this: view StringMap(V)) ret List(V) {
  unsafe {
    let result: List(V) = List.create(V, cap: this.length)
    var i: Int = 0
    loop i < this.cap {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: this.data, index: i)
      if entry.occupied {
        add(result, value: entry.value)
      }
      i = i + 1
    }
    ret result
  }
}

func growStringMap(V: type, this: mod StringMap(V)) {
  unsafe {
    this.isGrowing = true
    let oldCap: Int = this.cap
    let oldData: Buffer(StringMapEntry(V)) = this.data
    this.cap = oldCap * 2
    if this.cap is 0 {
      this.cap = 8
    }
    this.data = rae_ext_rae_buf_alloc(size: this.cap, elemSize: sizeof(StringMapEntry(V)))
    this.length = 0

    # MOVE each entry into the new buffer as it is: its key and value keep
    # their heap, and the old buffer is released without dropping anything.
    # Re-inserting through `set` copied every key and then freed the old
    # buffer with the old keys still in it — one leaked String per entry
    # per doubling (#85206966: ~800 per UI editor boot, all node ids).
    var i: Int = 0
    loop i < oldCap {
      let entry: StringMapEntry(V) = rae_ext_rae_buf_get(buf: oldData, index: i)
      if entry.occupied {
        var slot: Int = rae_str_hash(s: entry.k) % this.cap
        if slot < 0 {
          slot = -slot
        }
        loop rae_ext_rae_buf_get(buf: this.data, index: slot).occupied {
          slot = (slot + 1) % this.cap
        }
        rae_ext_rae_buf_set(buf: this.data, index: slot, value: entry)
        this.length = this.length + 1
      }
      i = i + 1
    }
    rae_ext_rae_buf_free(buf: oldData)
    this.isGrowing = false
  }
}

# Canonical scope-exit dealloc name per docs/scope-exit-dealloc.md.
# Same body as `free()`. Once Stage 2 codegen lands and starts
# emitting `drop()` calls automatically, `free()` becomes dead and
# can be removed in a cleanup pass.
func drop(V: type, this: mod StringMap(V)) {
  unsafe {
    rae_ext_rae_buf_free(buf: this.data)
    # #965: leave the EMPTY value behind, not a dangling pointer — a
    # zero-count alloc is the null Buffer, so a later drop (scope exit, or
    # the release a whole-value store performs first) is a no-op.
    this.data = rae_ext_rae_buf_alloc(size: 0, elemSize: sizeof(StringMapEntry(V)))
    this.length = 0
    this.cap = 0
  }
}
