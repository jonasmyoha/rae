open water/WaterReadback
# WaterFft — the FFT ocean's GPU side (#831 slice 1, #849, #850), split out of
# WaterSystem.rae at the 1000-line cap. Owns the cascade maps, the one-time
# spectrum + butterfly bake, the per-frame evolution + Stockham inverse FFT into
# the maps, the readback diagnostics, and the release of all of it (so
# waterShutdown lives here: it is the one place that needs both halves).
# Everything is a typed ID in the App-owned manager (#873, water/WaterGpuIds):
# creation, bind groups, dispatches, readbacks and retirement all go through
# gpu/GpuResources + gpu/GpuLifetime, passed in explicitly.
import Math
import Vec3
open Gbuffer
open GbufferPasses
open Gpu3d
open Math3d
open Scene3d
open TransparentForward
open water/Water
open water/WaterSystem
open water/WaterPerf
open water/WaterSchedule
open water/WaterGpuIds
open water/WaterGpuBridge
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open webgpu/WebgpuEnums

# ----- FFT cascades (#831) -----------------------------------------------------
# One cascade map: a storage texture the FFT compute writes and the surface
# shader samples. rgba16float is enough for displacement in metres and unit
# normals; the Jacobian map uses the same format for one path.
const cascadeMapUsage: UInt64 = WGPUTextureUsage_StorageBinding + WGPUTextureUsage_TextureBinding
# rgba32float storage textures: h0 packs (h0(k), h0(-k)); the butterfly packs
# (twiddle re, twiddle im, read index a, read index b) per (stage, index).
const float4StorageUsage: UInt64 = WGPUTextureUsage_StorageBinding + WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopySrc

# Creates a texture + its view and stores both at `index` of the lists.
func createMap(resources: mod GpuResources, width: view Int, height: view Int, format: view Int32, usage: view UInt64,
               textures: mod List(TextureId), views: mod List(TextureViewId), index: view Int) ret Bool {
  if let texture: TextureId = createTexture(resources: resources, width: width, height: height, format: format, usage: usage) {
    if let textureView: TextureViewId = createTextureView(resources: resources, texture: texture) {
      textures.set(index: index, value: texture)
      views.set(index: index, value: textureView)
      ret true
    }
    retireTexture(resources: resources, id: texture)
  }
  ret false
}

# Rebuild resource-dependent bindings before replacing cascade textures. Cleanup
# walks the fixed group capacity, never a newly edited body's cascade count.
func resetWaterFft(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  releaseWaterReadback(waterSystem: waterSystem, resources: resources)
  retireBindGroup(resources: resources, id: waterSystem.surface.bindGroup)
  waterSystem.surface.bindGroup = noBindGroupId()
  waterSystem.bindMade = false
  releaseFftFrameGpu(waterSystem: waterSystem, resources: resources)
  releaseFftGpu(waterSystem: waterSystem, resources: resources)
  releaseCascades(waterSystem: waterSystem, resources: resources)
  waterSystem.fftNeedsRefresh = true
}

# Call once at the waterFft render tag. Allocation, baking and the initial full
# refresh finish in this call, before the first surface draw can sample the maps.
func waterFftStep(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  waterSystem.fftLastUpdates = 0
  waterPollSubmissions(waterSystem: waterSystem, resources: resources)
  collectWaterPerf(performance: waterSystem.performance, resources: resources)
  if gbDeferredPrepare() is 0 { ret }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  if waterSystem.cascadesMade and (body.fftSize is not waterSystem.fftAllocatedSize or body.cascadeCount is not waterSystem.fftAllocatedCount) {
    resetWaterFft(waterSystem: waterSystem, resources: resources)
  }
  if not waterSystem.cascadesMade {
    loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
      loop var map: Int = 0, map < waterCascadeMaps, ++map {
        createMap(resources: resources, width: body.fftSize, height: body.fftSize, format: WGPUTextureFormat_RGBA16Float, usage: cascadeMapUsage,
          textures: waterSystem.cascades.textures, views: waterSystem.cascades.views, index: waterCascadeIndex(cascade: cascade, map: map))
      }
    }
    waterSystem.cascadesMade = true
    waterSystem.fftAllocatedSize = body.fftSize
    waterSystem.fftAllocatedCount = body.cascadeCount
    waterSystem.fftNeedsRefresh = true
    log("[water] fft cascades: {body.cascadeCount} x {body.fftSize}x{body.fftSize}, update rate {body.updateRate}")
  }
  if not sameWaterSpectrum(previous: waterSystem.fftSeaState, current: body) {
    waterFftInvalidate(waterSystem: waterSystem, resources: resources)
  }
  waterSystem.fftSeaState = body
  ensureFftGpu(waterSystem: waterSystem, resources: resources)
  bakeFftSpectrum(waterSystem: waterSystem, resources: resources)
  if body.style is WaterStyle.realistic {
    waterFftUpdate(waterSystem: waterSystem, resources: resources, time: waterSystem.time)
    updateWaterReadback(waterSystem: waterSystem, resources: resources)
  }
}

# ----- FFT spectrum + butterfly (#849) ----------------------------------------
const fftUniformFloats: Int = 12   # three vec4 (see waterFft.wgsl `FftU`)

func log2Int(n: view Int) ret Int {
  var stages: Int = 0
  var v: Int = n
  loop v > 1 { v = v / 2 stages = stages + 1 }
  ret stages
}

func fftWgsl() ret String {
  ret gbReadWgsl(path: "lib/water/waterFft.wgsl")
}

# Pipelines, textures and bind groups for the spectrum bake. Each compute entry
# point gets its own pipeline AND bind group: wgpu derives a layout from the
# bindings an entry point actually uses, so the two cannot share one.
func ensureFftGpu(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  if waterSystem.fftGpuMade { ret }
  let source: String = fftWgsl()
  if source.length() is 0 {
    log("[water fft] lib/water/waterFft.wgsl not readable from the working directory — run from the repo root; the spectrum is not baked")
    waterSystem.fftGpuMade = true
    ret
  }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  if let spectrumPipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "spectrum") { waterSystem.fft.spectrumPipeline = spectrumPipeline }
  if let butterflyPipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "butterfly") { waterSystem.fft.butterflyPipeline = butterflyPipeline }
  if let uniform: BufferId = createBuffer(resources: resources, size: fftUniformFloats * 4, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) { waterSystem.fft.uniform = uniform }
  if let butterfly: TextureId = createTexture(resources: resources, width: log2Int(n: size), height: size, format: WGPUTextureFormat_RGBA32Float, usage: float4StorageUsage) {
    waterSystem.fft.butterflyTexture = butterfly
    if let butterflyView: TextureViewId = createTextureView(resources: resources, texture: butterfly) { waterSystem.fft.butterflyView = butterflyView }
  }
  if let readback: BufferId = createBuffer(resources: resources, size: size * size * 16, usage: WGPUBufferUsage_CopyDst + WGPUBufferUsage_MapRead) { waterSystem.fft.readback = readback }
  loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
    createMap(resources: resources, width: size, height: size, format: WGPUTextureFormat_RGBA32Float, usage: float4StorageUsage,
      textures: waterSystem.fft.h0Textures, views: waterSystem.fft.h0Views, index: cascade)
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
    entries.add(value: bufferRef(id: waterSystem.fft.uniform))
    entries.add(value: textureViewRef(id: waterSystem.fft.h0Views.copyAtFallback(index: cascade, fallback: noTextureViewId())))
    if let bind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.spectrumPipeline, entries: entries) {
      waterSystem.fft.spectrumBinds.set(index: cascade, value: bind)
    }
  }
  # The butterfly entry point binds the uniform @0 and its table @2 (@1 is the
  # spectrum's h0, unused here): a skip keeps the binding numbers aligned.
  let butterflyEntries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
  butterflyEntries.add(value: bufferRef(id: waterSystem.fft.uniform))
  butterflyEntries.add(value: skipRef())
  butterflyEntries.add(value: textureViewRef(id: waterSystem.fft.butterflyView))
  if let butterflyBind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.butterflyPipeline, entries: butterflyEntries) {
    waterSystem.fft.butterflyBind = butterflyBind
  }
  waterSystem.fftGpuMade = true
}

func cascadeTile(body: view WaterBody, cascade: view Int) ret Float {
  if cascade is 0 { ret body.cascadeTile0 }
  if cascade is 1 { ret body.cascadeTile1 }
  ret body.cascadeTile2
}

# Each cascade owns a k band so the cascades never count a wavelength twice
# when the surface sums them. The hand-over to the next (smaller) tile happens
# where that tile resolves the wave with cascadeBandBins grid cells per
# wavelength: kHigh = cascadeBandBins * 2pi / L_next. (Handing over at exactly
# 2pi/L_next — one cell — would leave the 250 m cascade owning a 4-bin disc of
# its 256x256 grid while the 60 m cascade represents 60..10 m waves with 1..6
# cells; six cells is where the finer tile is the better home.)
const cascadeBandBins: Float = 6.0

func cascadeBandHigh(body: view WaterBody, cascade: view Int) ret Float {
  if cascade >= body.cascadeCount - 1 { ret 1000000.0 }
  ret cascadeBandBins * 6.28318530718 / cascadeTile(body: body, cascade: cascade + 1)
}

func uploadFftUniform(waterSystem: mod WaterSystem, resources: view GpuResources, body: view WaterBody, cascade: view Int) {
  loop waterSystem.fftUniform.length < fftUniformFloats { waterSystem.fftUniform.add(value: 0.0) }
  let tile: Float = cascadeTile(body: body, cascade: cascade)
  var kLow: Float = 0.0
  if cascade > 0 { kLow = cascadeBandHigh(body: body, cascade: cascade - 1) }
  let kHigh: Float = cascadeBandHigh(body: body, cascade: cascade)
  put4(uniform: waterSystem.fftUniform, base: 0, x: body.fftSize.toFloat(), y: tile, z: body.windSpeed, w: body.windDirRad)
  put4(uniform: waterSystem.fftUniform, base: 4, x: body.fetch, y: 9.81, z: body.waterDepth, w: 1337.0 + cascade.toFloat() * 101.0)
  var testMode: Float = 0.0
  if waterSystem.fftTestMode { testMode = 1.0 }
  put4(uniform: waterSystem.fftUniform, base: 8, x: kLow, y: kHigh, z: cascade.toFloat(), w: testMode)
  uploadFloats(resources: resources, buffer: waterSystem.fft.uniform, floats: waterSystem.fftUniform)
}

func workgroups(extent: view Int) ret Int {
  ret (extent + 7) / 8
}

# One compute dispatch of `pipeline` with `bind` over a width x height grid of
# 8x8 workgroups, SUBMITTED at once (the uniform it read was queued just before,
# and the next cascade rewrites that same buffer).
func dispatchFft(waterSystem: mod WaterSystem, resources: mod GpuResources, pipeline: view PipelineId, bind: view BindGroupId, width: view Int, height: view Int) {
  let command: ComputeCommand = computeCommand(pipeline: pipeline, bindGroup: bind, workgroupsX: workgroups(extent: width), workgroupsY: workgroups(extent: height), workgroupsZ: 1)
  if let recording: Recording = beginRecording(resources: resources) {
    if recordComputeCommand(recording: recording, resources: resources, command: command) {
      waterSubmit(waterSystem: waterSystem, resources: resources, recording: recording)
    }
  }
}

# Bake h0 for every cascade + the butterfly table. Runs ONCE; call
# waterFftInvalidate when the sea state or the resolution changes.
func bakeFftSpectrum(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  if waterSystem.fftBaked { ret }
  if not isValidPipeline(resources: resources, id: waterSystem.fft.spectrumPipeline) { ret }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
    uploadFftUniform(waterSystem: waterSystem, resources: resources, body: body, cascade: cascade)
    dispatchFft(waterSystem: waterSystem, resources: resources, pipeline: waterSystem.fft.spectrumPipeline,
      bind: waterSystem.fft.spectrumBinds.copyAtFallback(index: cascade, fallback: noBindGroupId()), width: size, height: size)
  }
  # The butterfly only needs N; the last uniform upload carries it.
  dispatchFft(waterSystem: waterSystem, resources: resources, pipeline: waterSystem.fft.butterflyPipeline, bind: waterSystem.fft.butterflyBind, width: log2Int(n: size), height: size)
  waterSystem.fftBaked = true
  waterSystem.fftNeedsRefresh = true
  log("[water fft] spectrum baked: {body.cascadeCount} cascades of {size}x{size}, wind {body.windSpeed} m/s, fetch {body.fetch} m, depth {body.waterDepth} m; butterfly {log2Int(n: size)} stages")
}

# Sea state or resolution changed: re-bake next frame.
func waterFftInvalidate(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  releaseWaterReadback(waterSystem: waterSystem, resources: resources)
  waterSystem.fftBaked = false
  waterSystem.fftNeedsRefresh = true
}

# ----- diagnostics: read a baked texture back (#849) -------------------------
# Copy an rgba32float texture into the MapRead staging buffer and read it into
# fftRead through a manager ReadbackId, WAITING for it: for tests and
# diagnostics, never per frame. WebGPU requires bytesPerRow to be a multiple of
# 256, so a row is padded up to that: read texel (x, y) at float index
# y * readbackRowFloats(width) + x*4 (h0 at 256 wide is exactly 4096 B/row; the
# 8-wide butterfly pads 128 -> 256).
func readbackRowBytes(width: view Int) ret Int {
  let raw: Int = width * 16
  ret ((raw + 255) / 256) * 256
}

func readbackRowFloats(width: view Int) ret Int {
  ret readbackRowBytes(width: width) / 4
}

func awaitSubmission(resources: mod GpuResources, id: view SubmissionId) ret Bool {
  var spins: Int = 0
  loop spins < 100000000 {
    let status: Int = pollSubmission(resources: resources, id: id)
    if status is 1 { ret true }
    if status < 0 { ret false }
    spins = spins + 1
  }
  ret false
}

func awaitReadback(resources: mod GpuResources, id: view ReadbackId) ret Bool {
  var spins: Int = 0
  loop spins < 100000000 {
    let status: Int = pollReadback(resources: resources, id: id)
    if status is 1 { ret true }
    if status is not 0 { ret false }
    spins = spins + 1
  }
  ret false
}

func readbackFloat4(waterSystem: mod WaterSystem, resources: mod GpuResources, texture: view TextureId, width: copy Int, height: copy Int) ret Bool {
  if not isValidTexture(resources: resources, id: texture) { ret false }
  let rowBytes: Int = readbackRowBytes(width: width)
  let bytes: Int = rowBytes * height
  var copied: Bool = false
  if let recording: Recording = beginRecording(resources: resources) {
    if recordCopyTextureToBuffer(recording: recording, resources: resources, texture: texture, buffer: waterSystem.fft.readback, bytesPerRow: rowBytes) {
      if let submission: SubmissionId = waterSubmit(waterSystem: waterSystem, resources: resources, recording: recording) {
        copied = awaitSubmission(resources: resources, id: submission)
      }
    }
  }
  if not copied { ret false }
  waterPollSubmissions(waterSystem: waterSystem, resources: resources)
  var ok: Bool = false
  if let read: ReadbackId = startReadback(resources: resources, buffer: waterSystem.fft.readback, offset: 0, size: bytes) {
    if awaitReadback(resources: resources, id: read) {
      let raw: List(UInt8) = List.create(UInt8, cap: bytes)
      loop raw.length < bytes { raw.add(value: 0 as UInt8) }
      if copyReadback(resources: resources, id: read, destination: raw) {
        bytesToFloats(bytes: raw, floats: waterSystem.fftRead, count: bytes / 4)
        ok = true
      }
    }
    retireReadback(resources: resources, id: read)
  }
  ret ok
}

func readAt(waterSystem: view WaterSystem, index: view Int) ret Float {
  if let f: Float = waterSystem.fftRead.copyAt(index: index) { ret f }
  ret 0.0
}

# The honest check of the bake (#849): read cascade 0's h0 back and confirm
# (a) it is non-zero, (b) the (k, -k) packing is exactly symmetric — texel(k).zw
# is texel(-k).xy — which is what the time evolution relies on to keep the
# surface real, (c) the radial energy peaks at the JONSWAP peak wavenumber
# k_p = w_p^2 / g (deep water), and (d) the butterfly's first stage reads (i/2,
# i/2 + N/2) with twiddle +-1. Logs one "[water fft] h0 ok ..." line (or FAIL).
func waterFftDiagnose(waterSystem: mod WaterSystem, resources: mod GpuResources) ret Bool {
  if not waterSystem.fftBaked { log("[water fft] h0 FAIL: not baked") ret false }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  if not readbackFloat4(waterSystem: waterSystem, resources: resources, texture: waterSystem.fft.h0Textures.copyAtFallback(index: 0, fallback: noTextureId()), width: size, height: size) {
    log("[water fft] h0 FAIL: readback failed")
    ret false
  }
  let deltaK: Float = 6.28318530718 / body.cascadeTile0
  let bins: Int = size / 2
  var energy: List(Float) = List.create(Float, cap: bins)
  loop var b: Int = 0, b < bins, ++b { energy.add(value: 0.0) }
  var nonZero: Int = 0
  var maxAsymmetry: Float = 0.0
  let rowFloats: Int = readbackRowFloats(width: size)
  loop var y: Int = 1, y < size, ++y {
    loop var x: Int = 1, x < size, ++x {
      let i: Int = y * rowFloats + x * 4
      let re: Float = readAt(waterSystem: waterSystem, index: i)
      let im: Float = readAt(waterSystem: waterSystem, index: i + 1)
      let e: Float = re * re + im * im
      if e > 0.0 { nonZero = nonZero + 1 }
      # -k lives at (size - x, size - y); its .xy must equal our .zw.
      let j: Int = (size - y) * rowFloats + (size - x) * 4
      let dRe: Float = Math.abs(value: readAt(waterSystem: waterSystem, index: i + 2) - readAt(waterSystem: waterSystem, index: j))
      let dIm: Float = Math.abs(value: readAt(waterSystem: waterSystem, index: i + 3) - readAt(waterSystem: waterSystem, index: j + 1))
      if dRe > maxAsymmetry { maxAsymmetry = dRe }
      if dIm > maxAsymmetry { maxAsymmetry = dIm }
      let n: Float = (x - size / 2).toFloat()
      let m: Float = (y - size / 2).toFloat()
      let bin: Int = (Math.sqrt(x: n * n + m * m)).toInt()
      if bin < bins {
        if let current: Float = energy.copyAt(index: bin) { energy.set(index: bin, value: current + e) }
      }
    }
  }
  var peakBin: Int = 0
  var peakEnergy: Float = 0.0
  loop var b2: Int = 1, b2 < bins, ++b2 {
    if let e2: Float = energy.copyAt(index: b2) {
      if e2 > peakEnergy { peakEnergy = e2 peakBin = b2 }
    }
  }
  # JONSWAP peak: w_p = 22 (g^2 / (U F))^(1/3); deep water k_p = w_p^2 / g.
  let g: Float = 9.81
  let omegaP: Float = 22.0 * Math.pow(base: g * g / (body.windSpeed * body.fetch), exp: 1.0 / 3.0)
  let kP: Float = omegaP * omegaP / g
  let expectedBin: Float = kP / deltaK
  # butterfly stage 0, index 0 and 1
  var butterflyOk: Bool = false
  let stages: Int = log2Int(n: size)
  if readbackFloat4(waterSystem: waterSystem, resources: resources, texture: waterSystem.fft.butterflyTexture, width: stages, height: size) {
    # texel (stage 0, i) lives at row i: index i * rowFloats + stage * 4.
    let butterflyRow: Int = readbackRowFloats(width: stages)
    let b0: Int = 0
    let b1: Int = butterflyRow
    butterflyOk = Math.abs(value: readAt(waterSystem: waterSystem, index: b0) - 1.0) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b0 + 2) - 0.0) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b0 + 3) - (size / 2).toFloat()) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b1) + 1.0) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b1 + 2) - 0.0) < 0.0001
  }
  # Non-zero texels = the band's disc in k-space: pi (kHigh / dk)^2 cells (the
  # k = 0 texel and the Nyquist row/column are zeroed). This checks the band
  # mask, which a flat "mostly non-zero" threshold would not — a banded cascade
  # is mostly zero by design.
  let total: Int = (size - 1) * (size - 1)
  let bandRadius: Float = cascadeBandHigh(body: body, cascade: 0) / deltaK
  let expectedNonZero: Float = 3.14159265 * bandRadius * bandRadius
  let nonZeroOk: Bool = nonZero.toFloat() > expectedNonZero * 0.6 and nonZero.toFloat() < expectedNonZero * 1.3
  let symmetryOk: Bool = maxAsymmetry < 0.000001
  let peakOk: Bool = Math.abs(value: peakBin.toFloat() - expectedBin) <= 2.0
  let ok: Bool = nonZeroOk and symmetryOk and peakOk and butterflyOk
  var verdict: String = "ok"
  if not ok { verdict = "FAIL" }
  log("[water fft] h0 {verdict}: nonzero {nonZero}/{total} (band disc expects ~{expectedNonZero}), max (k,-k) asymmetry {maxAsymmetry}, energy peak bin {peakBin} vs JONSWAP k_p bin {expectedBin} (k_p {kP} rad/m), butterfly stage 0 {butterflyOk}")
  ret ok
}

# ----- per-frame evolution + inverse FFT (#850) --------------------------------
# One shared set of working textures serves every cascade in turn (the post
# pass writes a cascade's maps before the next reuses them): P/Q ping-pong the
# Stockham stages, R0..R3 hold the four transformed field pairs. Stage uniforms
# are one per stage: all dispatches share one submit, so no buffer may be
# rewritten between them.
const evolveUniformFloats: Int = 8

# Working texture index: 0 = P, 1 = Q, 2 + f = R_f.
func workView(waterSystem: view WaterSystem, which: view Int) ret TextureViewId {
  ret waterSystem.fft.workViews.copyAtFallback(index: which, fallback: noTextureViewId())
}

func fieldView(waterSystem: view WaterSystem, field: view Int) ret TextureViewId {
  ret workView(waterSystem: waterSystem, which: 2 + field)
}

func h0View(waterSystem: view WaterSystem, cascade: view Int) ret TextureViewId {
  ret waterSystem.fft.h0Views.copyAtFallback(index: cascade, fallback: noTextureViewId())
}

func evolveIndex(cascade: view Int, field: view Int) ret Int {
  ret cascade * fftFields + field
}

func ensureFftFrameGpu(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  if waterSystem.fftFrameMade { ret }
  if not isValidPipeline(resources: resources, id: waterSystem.fft.spectrumPipeline) { ret }
  let source: String = fftWgsl()
  if source.length() is 0 { waterSystem.fftFrameMade = true ret }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  let stages: Int = log2Int(n: size)
  if let evolvePipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "evolve") { waterSystem.fft.evolvePipeline = evolvePipeline }
  if let stockhamPipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "stockham") { waterSystem.fft.stockhamPipeline = stockhamPipeline }
  if let transposePipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "transpose") { waterSystem.fft.transposePipeline = transposePipeline }
  if let fieldOutPipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "fieldOut") { waterSystem.fft.fieldOutPipeline = fieldOutPipeline }
  if let postPipeline: PipelineId = createComputePipeline(resources: resources, wgsl: source, entryPoint: "post") { waterSystem.fft.postPipeline = postPipeline }
  # Working textures: P, Q, R0..R3.
  loop var which: Int = 0, which < fftWorkTextures, ++which {
    createMap(resources: resources, width: size, height: size, format: WGPUTextureFormat_RGBA32Float, usage: float4StorageUsage,
      textures: waterSystem.fft.workTextures, views: waterSystem.fft.workViews, index: which)
  }
  # Stage uniforms (static) + stage binds for both ping-pong directions.
  loop waterSystem.stageUniform.length < 4 { waterSystem.stageUniform.add(value: 0 as Int32) }
  loop var stage: Int = 0, stage < stages, ++stage {
    if let stageUniform: BufferId = createBuffer(resources: resources, size: 16, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) {
      waterSystem.fft.stageUniforms.set(index: stage, value: stageUniform)
      waterSystem.stageUniform.set(index: 0, value: stage as Int32)
      uploadInts(resources: resources, buffer: stageUniform, values: waterSystem.stageUniform)
      loop var direction: Int = 0, direction < 2, ++direction {
        let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
        entries.add(value: bufferRef(id: stageUniform))
        entries.add(value: textureViewRef(id: waterSystem.fft.butterflyView))
        entries.add(value: textureViewRef(id: workView(waterSystem: waterSystem, which: direction)))
        entries.add(value: textureViewRef(id: workView(waterSystem: waterSystem, which: 1 - direction)))
        if let bind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.stockhamPipeline, entries: entries) {
          waterSystem.fft.stageBinds.set(index: stage * 2 + direction, value: bind)
        }
      }
    }
  }
  # Transpose binds: direction 0 = P -> Q, 1 = Q -> P.
  loop var direction2: Int = 0, direction2 < 2, ++direction2 {
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
    entries.add(value: textureViewRef(id: workView(waterSystem: waterSystem, which: direction2)))
    entries.add(value: textureViewRef(id: workView(waterSystem: waterSystem, which: 1 - direction2)))
    if let bind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.transposePipeline, entries: entries) {
      waterSystem.fft.transposeBinds.set(index: direction2, value: bind)
    }
  }
  # fieldOut binds: field f from P (0) or Q (1).
  loop var field2: Int = 0, field2 < fftFields, ++field2 {
    loop var source2: Int = 0, source2 < 2, ++source2 {
      let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
      entries.add(value: textureViewRef(id: workView(waterSystem: waterSystem, which: source2)))
      entries.add(value: textureViewRef(id: fieldView(waterSystem: waterSystem, field: field2)))
      if let bind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.fieldOutPipeline, entries: entries) {
        waterSystem.fft.fieldOutBinds.set(index: field2 * 2 + source2, value: bind)
      }
    }
  }
  # Evolve uniforms + binds per (cascade, field); post binds per cascade.
  loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
    loop var field3: Int = 0, field3 < fftFields, ++field3 {
      if let evolveUniform: BufferId = createBuffer(resources: resources, size: evolveUniformFloats * 4, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) {
        waterSystem.fft.evolveUniforms.set(index: evolveIndex(cascade: cascade, field: field3), value: evolveUniform)
        let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
        entries.add(value: bufferRef(id: evolveUniform))
        entries.add(value: textureViewRef(id: h0View(waterSystem: waterSystem, cascade: cascade)))
        entries.add(value: textureViewRef(id: workView(waterSystem: waterSystem, which: 0)))
        if let bind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.evolvePipeline, entries: entries) {
          waterSystem.fft.evolveBinds.set(index: evolveIndex(cascade: cascade, field: field3), value: bind)
        }
      }
    }
    let postEntries: List(ResourceRef) = List.create(ResourceRef, cap: 8)
    postEntries.add(value: bufferRef(id: waterSystem.fft.evolveUniforms.copyAtFallback(index: evolveIndex(cascade: cascade, field: 0), fallback: noBufferId())))
    loop var field4: Int = 0, field4 < fftFields, ++field4 {
      postEntries.add(value: textureViewRef(id: fieldView(waterSystem: waterSystem, field: field4)))
    }
    postEntries.add(value: textureViewRef(id: cascadeView(waterSystem: waterSystem, cascade: cascade, map: 0)))
    postEntries.add(value: textureViewRef(id: cascadeView(waterSystem: waterSystem, cascade: cascade, map: 1)))
    postEntries.add(value: textureViewRef(id: cascadeView(waterSystem: waterSystem, cascade: cascade, map: 2)))
    if let postBind: BindGroupId = createComputeBindGroupOrdered(resources: resources, pipeline: waterSystem.fft.postPipeline, entries: postEntries) {
      waterSystem.fft.postBinds.set(index: cascade, value: postBind)
    }
  }
  waterSystem.fftFrameMade = true
}

func addDispatch(commands: mod List(ComputeCommand), pipeline: view PipelineId, bind: view BindGroupId, width: view Int, height: view Int) {
  commands.add(value: computeCommand(pipeline: pipeline, bindGroup: bind, workgroupsX: workgroups(extent: width), workgroupsY: workgroups(extent: height), workgroupsZ: 1))
}

# Evolve every cascade to `time` and inverse-transform it into its maps: ONE
# compute pass, ONE submit. Per cascade and field: evolve -> P; log2N Stockham
# row stages ping-ponging P/Q; transpose; the same stages again for the
# columns; fieldOut un-transposes into R_f. Then post writes the maps.
func waterFftUpdate(waterSystem: mod WaterSystem, resources: mod GpuResources, time: copy Float) {
  if not waterSystem.fftBaked { ret }
  ensureFftFrameGpu(waterSystem: waterSystem, resources: resources)
  if not isValidPipeline(resources: resources, id: waterSystem.fft.postPipeline) { ret }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  waterSystem.fftLastUpdates = 0
  loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
    if waterCascadeDue(frame: waterSystem.fftFrame, cascade: cascade, updateRate: body.updateRate, refreshAll: waterSystem.fftNeedsRefresh) {
      waterSystem.fftLastUpdates = waterSystem.fftLastUpdates + 1
    }
  }
  if waterSystem.fftLastUpdates is 0 {
    waterSystem.fftFrame = waterSystem.fftFrame + 1
    idleWaterPerf(performance: waterSystem.performance)
    ret
  }
  let size: Int = body.fftSize
  let stages: Int = log2Int(n: size)
  loop waterSystem.evolveUniform.length < evolveUniformFloats { waterSystem.evolveUniform.add(value: 0.0) }
  # All uniforms first (flushed writes land before the submit below).
  loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
    if not waterCascadeDue(frame: waterSystem.fftFrame, cascade: cascade, updateRate: body.updateRate, refreshAll: waterSystem.fftNeedsRefresh) { continue }
    loop var field: Int = 0, field < fftFields, ++field {
      put4(uniform: waterSystem.evolveUniform, base: 0, x: size.toFloat(), y: cascadeTile(body: body, cascade: cascade), z: 9.81, w: body.waterDepth)
      put4(uniform: waterSystem.evolveUniform, base: 4, x: time, y: field.toFloat(), z: body.choppiness, w: 0.0)
      uploadFloats(resources: resources, buffer: waterSystem.fft.evolveUniforms.copyAtFallback(index: evolveIndex(cascade: cascade, field: field), fallback: noBufferId()), floats: waterSystem.evolveUniform)
    }
  }
  let commands: List(ComputeCommand) = List.create(ComputeCommand, cap: 64)
  loop var cascade2: Int = 0, cascade2 < body.cascadeCount, ++cascade2 {
    if not waterCascadeDue(frame: waterSystem.fftFrame, cascade: cascade2, updateRate: body.updateRate, refreshAll: waterSystem.fftNeedsRefresh) { continue }
    loop var field2: Int = 0, field2 < fftFields, ++field2 {
      addDispatch(commands: commands, pipeline: waterSystem.fft.evolvePipeline,
        bind: waterSystem.fft.evolveBinds.copyAtFallback(index: evolveIndex(cascade: cascade2, field: field2), fallback: noBindGroupId()), width: size, height: size)
      # Rows: the data starts in P (current = 0).
      var current: Int = 0
      loop var stage: Int = 0, stage < stages, ++stage {
        addDispatch(commands: commands, pipeline: waterSystem.fft.stockhamPipeline,
          bind: waterSystem.fft.stageBinds.copyAtFallback(index: stage * 2 + current, fallback: noBindGroupId()), width: size, height: size)
        current = 1 - current
      }
      addDispatch(commands: commands, pipeline: waterSystem.fft.transposePipeline,
        bind: waterSystem.fft.transposeBinds.copyAtFallback(index: current, fallback: noBindGroupId()), width: size, height: size)
      current = 1 - current
      loop var stage2: Int = 0, stage2 < stages, ++stage2 {
        addDispatch(commands: commands, pipeline: waterSystem.fft.stockhamPipeline,
          bind: waterSystem.fft.stageBinds.copyAtFallback(index: stage2 * 2 + current, fallback: noBindGroupId()), width: size, height: size)
        current = 1 - current
      }
      addDispatch(commands: commands, pipeline: waterSystem.fft.fieldOutPipeline,
        bind: waterSystem.fft.fieldOutBinds.copyAtFallback(index: field2 * 2 + current, fallback: noBindGroupId()), width: size, height: size)
    }
    addDispatch(commands: commands, pipeline: waterSystem.fft.postPipeline,
      bind: waterSystem.fft.postBinds.copyAtFallback(index: cascade2, fallback: noBindGroupId()), width: size, height: size)
  }
  let timed: Bool = beginWaterPerf(performance: waterSystem.performance, resources: resources)
  var submitted: Bool = false
  if let recording: Recording = beginRecording(resources: resources) {
    if recordWaterCompute(recording: recording, resources: resources, commands: commands, performance: waterSystem.performance, timed: timed) {
      if timed { resolveWaterPerf(performance: waterSystem.performance, recording: recording, resources: resources) }
      if let submission: SubmissionId = waterSubmit(waterSystem: waterSystem, resources: resources, recording: recording) {
        submitted = true
        if timed { noteWaterPerfSubmission(performance: waterSystem.performance, submission: submission) }
      }
    }
  }
  if not submitted {
    log("[water fft] update refused by the manager (a stale ID?); the maps keep their last state")
    ret
  }
  loop var cascade: Int = 0, cascade < body.cascadeCount, ++cascade {
    if waterCascadeDue(frame: waterSystem.fftFrame, cascade: cascade, updateRate: body.updateRate, refreshAll: waterSystem.fftNeedsRefresh) {
      if let count: Int = waterSystem.fftUpdateCounts.copyAt(index: cascade) { waterSystem.fftUpdateCounts.set(index: cascade, value: count + 1) }
      waterSystem.fftSampleTimes.set(index: cascade, value: time)
    }
  }
  waterSystem.fftFrame = waterSystem.fftFrame + 1
  waterSystem.fftNeedsRefresh = false
}

# THE FFT CORRECTNESS CHECK (#850): bake one known wave (h0 = 0.25 at k index
# +-3 along x, so h = 0.5 there at t = 0), run the evolution + inverse FFT, and
# read field 0 (h) of cascade 0 back: row N/2, sign-corrected by (-1)^(x+y),
# must be cos(2 pi 3 x / N) of amplitude 1 — amplitude, phase at x = 0, and
# the six zero crossings. Then re-bake JONSWAP, transform, and check the height
# field is finite and bounded. Logs "[water fft] ifft ok ..." (or FAIL).
func waterFftDiagnoseIfft(waterSystem: mod WaterSystem, resources: mod GpuResources) ret Bool {
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  waterSystem.fftTestMode = true
  waterFftInvalidate(waterSystem: waterSystem, resources: resources)
  bakeFftSpectrum(waterSystem: waterSystem, resources: resources)
  waterFftUpdate(waterSystem: waterSystem, resources: resources, time: 0.0)
  var amplitude: Float = 0.0
  var atZero: Float = 0.0
  var crossings: Int = 0
  var finite: Bool = true
  let heightField: TextureId = waterSystem.fft.workTextures.copyAtFallback(index: 2, fallback: noTextureId())
  if readbackFloat4(waterSystem: waterSystem, resources: resources, texture: heightField, width: size, height: size) {
    let rowFloats: Int = readbackRowFloats(width: size)
    let row: Int = size / 2
    var previous: Float = 0.0
    loop var x: Int = 0, x < size, ++x {
      var sign: Float = 1.0
      if (x + row) % 2 is 1 { sign = 0.0 - 1.0 }
      let v: Float = readAt(waterSystem: waterSystem, index: row * rowFloats + x * 4) * sign
      if not (v < 1000000.0 and v > 0.0 - 1000000.0) { finite = false }
      if Math.abs(value: v) > amplitude { amplitude = Math.abs(value: v) }
      if x is 0 { atZero = v }
      if x > 0 {
        if (previous < 0.0 and v >= 0.0) or (previous >= 0.0 and v < 0.0) { crossings = crossings + 1 }
      }
      previous = v
    }
  } else {
    finite = false
  }
  # Back to the sea: re-bake JONSWAP and check the height field is sane.
  waterSystem.fftTestMode = false
  waterFftInvalidate(waterSystem: waterSystem, resources: resources)
  bakeFftSpectrum(waterSystem: waterSystem, resources: resources)
  waterFftUpdate(waterSystem: waterSystem, resources: resources, time: 1.0)
  var seaMax: Float = 0.0
  var seaFinite: Bool = true
  if readbackFloat4(waterSystem: waterSystem, resources: resources, texture: heightField, width: size, height: size) {
    let rowFloats2: Int = readbackRowFloats(width: size)
    loop var y: Int = 0, y < size, ++y {
      loop var x2: Int = 0, x2 < size, ++x2 {
        let v: Float = readAt(waterSystem: waterSystem, index: y * rowFloats2 + x2 * 4)
        if not (v < 1000000.0 and v > 0.0 - 1000000.0) { seaFinite = false }
        if Math.abs(value: v) > seaMax { seaMax = Math.abs(value: v) }
      }
    }
  } else {
    seaFinite = false
  }
  let amplitudeOk: Bool = Math.abs(value: amplitude - 1.0) < 0.03
  let phaseOk: Bool = Math.abs(value: atZero - 1.0) < 0.03
  let crossingsOk: Bool = crossings is 6
  let seaOk: Bool = seaFinite and seaMax > 0.0 and seaMax < 20.0
  let ok: Bool = finite and amplitudeOk and phaseOk and crossingsOk and seaOk
  var verdict: String = "ok"
  if not ok { verdict = "FAIL" }
  log("[water fft] ifft {verdict}: known wave amplitude {amplitude} (expect 1), value at x=0 {atZero} (expect 1), zero crossings {crossings} (expect 6), finite {finite}; jonswap height max {seaMax} m, finite {seaFinite}")
  ret ok
}

# ----- release: retire this system's IDs (deferred behind in-flight work) -----
func releaseFftFrameGpu(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  if not waterSystem.fftFrameMade { ret }
  waterSystem.fftFrameMade = false
  retireBindGroupIds(resources: resources, list: waterSystem.fft.stageBinds)
  retireBindGroupIds(resources: resources, list: waterSystem.fft.transposeBinds)
  retireBindGroupIds(resources: resources, list: waterSystem.fft.fieldOutBinds)
  retireBindGroupIds(resources: resources, list: waterSystem.fft.evolveBinds)
  retireBindGroupIds(resources: resources, list: waterSystem.fft.postBinds)
  retirePipeline(resources: resources, id: waterSystem.fft.evolvePipeline)
  retirePipeline(resources: resources, id: waterSystem.fft.stockhamPipeline)
  retirePipeline(resources: resources, id: waterSystem.fft.transposePipeline)
  retirePipeline(resources: resources, id: waterSystem.fft.fieldOutPipeline)
  retirePipeline(resources: resources, id: waterSystem.fft.postPipeline)
  waterSystem.fft.evolvePipeline = noPipelineId()
  waterSystem.fft.stockhamPipeline = noPipelineId()
  waterSystem.fft.transposePipeline = noPipelineId()
  waterSystem.fft.fieldOutPipeline = noPipelineId()
  waterSystem.fft.postPipeline = noPipelineId()
  retireBufferIds(resources: resources, list: waterSystem.fft.stageUniforms)
  retireBufferIds(resources: resources, list: waterSystem.fft.evolveUniforms)
  retireTextureViewIds(resources: resources, list: waterSystem.fft.workViews)
  retireTextureIds(resources: resources, list: waterSystem.fft.workTextures)
}

func releaseFftGpu(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  if not waterSystem.fftGpuMade { ret }
  waterSystem.fftGpuMade = false
  waterSystem.fftBaked = false
  retireBindGroupIds(resources: resources, list: waterSystem.fft.spectrumBinds)
  retireBindGroup(resources: resources, id: waterSystem.fft.butterflyBind)
  waterSystem.fft.butterflyBind = noBindGroupId()
  retireTextureViewIds(resources: resources, list: waterSystem.fft.h0Views)
  retireTextureIds(resources: resources, list: waterSystem.fft.h0Textures)
  retireTextureView(resources: resources, id: waterSystem.fft.butterflyView)
  retireTexture(resources: resources, id: waterSystem.fft.butterflyTexture)
  waterSystem.fft.butterflyView = noTextureViewId()
  waterSystem.fft.butterflyTexture = noTextureId()
  retireBuffer(resources: resources, id: waterSystem.fft.readback)
  retireBuffer(resources: resources, id: waterSystem.fft.uniform)
  waterSystem.fft.readback = noBufferId()
  waterSystem.fft.uniform = noBufferId()
  retirePipeline(resources: resources, id: waterSystem.fft.spectrumPipeline)
  retirePipeline(resources: resources, id: waterSystem.fft.butterflyPipeline)
  waterSystem.fft.spectrumPipeline = noPipelineId()
  waterSystem.fft.butterflyPipeline = noPipelineId()
}

func releaseCascades(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  if not waterSystem.cascadesMade { ret }
  waterSystem.cascadesMade = false
  retireTextureViewIds(resources: resources, list: waterSystem.cascades.views)
  retireTextureIds(resources: resources, list: waterSystem.cascades.textures)
}

# Retire every GPU object of THIS system (app shutdown or a rebuild) and drain
# its submissions, so the manager frees them synchronously. Another system on
# the same manager is untouched. Safe to call twice.
func waterShutdown(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  releaseWaterReadback(waterSystem: waterSystem, resources: resources)
  releaseFftFrameGpu(waterSystem: waterSystem, resources: resources)
  releaseFftGpu(waterSystem: waterSystem, resources: resources)
  releaseCascades(waterSystem: waterSystem, resources: resources)
  retireBindGroup(resources: resources, id: waterSystem.surface.bindGroup)
  retireRenderPipeline(resources: resources, id: waterSystem.surface.pipeline)
  retireBuffer(resources: resources, id: waterSystem.surface.uniform)
  retireSampler(resources: resources, id: waterSystem.surface.litSampler)
  retireSampler(resources: resources, id: waterSystem.surface.cascadeSampler)
  releaseFrameExternals(resources: resources, frame: waterSystem.surface.frame)
  releaseMeshExternals(resources: resources, meshes: waterSystem.surface.meshes)
  waterSystem.surface = createSurfaceGpu()
  releaseWaterPerf(performance: waterSystem.performance, resources: resources)
  waterDrainSubmissions(waterSystem: waterSystem, resources: resources)
  waterSystem.pipeMade = false
  waterSystem.pipeReady = false
  waterSystem.bindMade = false
}
