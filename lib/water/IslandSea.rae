# The sea round a WorldBiome island (or between its lakes): Rae's realistic
# water, the FFT ocean of examples/141_ocean_fft (createOceanRealistic), as a
# sheltered coastal sea. Three wave cascades on a mesh that follows the camera
# (water/ClipMap), with refraction of the sea bed, shoreline foam,
# screen-space reflections, whitecaps where the waves fold, and the waves
# fading out as the water gets shallow (biomeShoreDepth) so they do not roll
# over the beach. The sea is the biome's flat water plane, so the island's
# ponds and lakes are the same water. A phone gets the mobile tier (one small
# cascade, no refraction).
#
# The app passes the BiomeConfig its terrain uses: the shore damping reads the
# same field on the CPU (biomeShoreEnergy) and, through the surface
# pipeline's override constants, on the GPU, so the coast is where the land
# is. Everything else is a field of the returned WaterBody, which the app may
# change before handing it to createWaterSystem.
import Vec3
open Mesh3d
open RendererDeferred
open WorldBiome
open water/Water
open water/WaterSchedule
open water/ClipMap

# The camera-centered grid the sea is drawn on (141's)
const islandSeaGridRings: Int = 70

const islandSeaGridSegments: Int = 96

const islandSeaGridGrowth: Float = 1.09

# Sheltered island water: a light breeze, short fetch and gentle lateral motion
const islandSeaWindSpeed: Float = 3.5

const islandSeaSpectrumDepth: Float = 4.0

const islandSeaChoppiness: Float = 0.45

# Where the sea's still surface sits in WORLD space: the biome's flat water
# plane over the terrain's `groundZ`
func islandSeaSurfaceZ(groundZ: view Float, biome: view BiomeConfig) ret Float {
  ret worldWaterZ(groundZ: groundZ, cfg: biome)
}

# The island's sea for the terrain at `groundZ` of `biome`: the FFT ocean at
# the water plane over a camera-centered grid uploaded into `renderer`
func createIslandSea(
  renderer: mod DeferredRenderer
  groundZ: view Float
  biome: view BiomeConfig
) ret WaterBody {
  let grid: MeshData = createRadialGridMesh(
    rings: islandSeaGridRings
    segments: islandSeaGridSegments
    firstCell: 1.0
    growth: islandSeaGridGrowth
  )
  let gridMesh: MeshHandle = uploadMesh(
    renderer: renderer
    verts: grid.verts
    vertCount: grid.vertCount
    indices: grid.indices
  )
  var sea: WaterBody = createOceanRealistic(
    surfaceZ: islandSeaSurfaceZ(groundZ: groundZ, biome: biome)
  )
  sea.meshId = gridMesh.id
  sea.clipCellPerMeter = radialGridCellPerMeter(
    segments: islandSeaGridSegments
    growth: islandSeaGridGrowth
  )
  sea.clipFirstCell = 1.0
  sea.windSpeed = islandSeaWindSpeed
  sea.waterDepth = islandSeaSpectrumDepth
  sea.choppiness = islandSeaChoppiness
  sea.fftAmplitude = 0.35
  sea.fetch = 12000.0
  sea.biomeShoreDepth = 2.5
  sea.biomeGroundZ = groundZ
  sea.biome = biome
  sea.foamDistance = 0.22
  sea.refractStrength = 0.008
  sea.shallowColor = Vec3.create(x: 0.04, y: 0.50, z: 0.32)
  sea.deepColor = Vec3.create(x: 0.015, y: 0.24, z: 0.22)
  sea.absorbColor = Vec3.create(x: 0.75, y: 0.15, z: 0.25)
  sea.spray = 0
  if Target.isMobileOs {
    useMobileWaterTier(body: sea)
  }
  normalizeWaterTier(body: sea)
  log(
    "[sea] FFT ocean at z {sea.center.z}: {sea.cascadeCount} cascades of {sea.fftSize}, wind {sea.windSpeed} m/s, island radius {biome.islandRadius} m"
  )
  ret sea
}
