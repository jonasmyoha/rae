# WaterSystem — the GPU side of the water package (#830). Owned by the app as a
# resource (`app.waterSystem: WaterSystem`, the #822 convention), it steps wave
# time, keeps the surface pipeline / uniform buffer / bind group (parked in the
# C handle slots, the grass idiom), and draws ONE body per call as ONE draw of a
# unit grid — no compute — through the transparent forward pass (#843): a render
# pass that LOADS the lit HDR target, alpha-blends the surface into it, and
# tests the opaque scene depth READ-ONLY. The same depth is bound as a texture
# so the fragment shader can compute the water depth under every pixel
# (sceneDepth - surfaceDepth) — the depth-gradient colour and shoreline foam of
# the Roystan toon recipe (waterSurface.wgsl).
#
# Call order at the transparentForward tag: waterDraw FIRST, then the renderer's
# transparentPass (particles), so splashes blend OVER the surface. Refraction is
# off on this tier, so the #842 opaque snapshot taken after the water is fine;
# #832 (refraction) will want the snapshot before the water — split
# transparentPass then, it is a two-line change.
import Math
import Vec3
open Gbuffer
open GbufferPasses
open Gpu3d
open Math3d
open Mesh3d
open Scene3d
open Sky
open TransparentForward
open water/Water
open webgpu/Webgpu
open webgpu/Context

func gbLitFormat() extern("rae_gb_lit_format") ret Int
# Handle slots: 0 = surface pipeline, 1 = uniform buffer, 2 = bind group, 3 = lit sampler.
func waterSet(index: Int, ptr: Ptr) extern("rae_gb_water_set")
func waterGet(index: Int) extern("rae_gb_water_get") ret Ptr
func waterRelease() extern("rae_gb_water_release")

const waterUniformFloats: Int = 64   # sixteen vec4 (see waterSurface.wgsl `Water`)

type WaterSystem {
  # Every body this system draws (#847): they share ONE unit-grid mesh (sized
  # by the first body's gridSegments) and one pipeline; each is one draw with
  # its own uniform upload. The first body also owns the FFT cascades.
  bodies: List(WaterBody)
  mesh: MeshHandle
  pipeMade: Bool    # creation attempted (a missing shader is reported once)
  pipeReady: Bool   # creation succeeded; the draw is skipped otherwise
  bindGen: Int      # targets generation the bind group was built at (depth view changes on resize)
  bindMade: Bool
  time: Float
  uniform: List(Float)
  drawCount: Int
  cascadesMade: Bool   # the FFT cascade textures exist (#831 slice 1)
  fftGpuMade: Bool     # spectrum/butterfly pipelines, h0 + butterfly textures, binds (#849)
  fftBaked: Bool       # h0 + butterfly filled for the current params/resolution
  fftUniform: List(Float)
  fftRead: List(Float) # readback staging on the CPU side (diagnostics only)
}

func createWaterSystem(body: view WaterBody) pub ret WaterSystem {
  # A unit grid (-0.5..0.5) the vertex shader scales to each body's extent, so
  # one mesh serves every body; its density is the first body's tier knob.
  var segments: Int = body.gridSegments
  if segments < 4 { segments = 4 }
  let grid: MeshData = makePlane(size: 1.0, segments: segments)
  let mesh: MeshHandle = uploadMesh(verts: grid.verts, vertCount: grid.vertCount, indices: grid.indices)
  let uniform: List(Float) = createList(Float, cap: waterUniformFloats)
  var i: Int = 0
  loop i < waterUniformFloats {
    uniform.add(value: 0.0)
    i = i + 1
  }
  var bodies: List(WaterBody) = createList(WaterBody, cap: 4)
  bodies.add(value: body)
  ret WaterSystem {
    bodies: own bodies, mesh: mesh, pipeMade: false, pipeReady: false,
    bindGen: 0 - 1, bindMade: false, time: 0.0, uniform: uniform, drawCount: 0,
    cascadesMade: false, fftGpuMade: false, fftBaked: false,
    fftUniform: createList(Float, cap: fftUniformFloats), fftRead: createList(Float, cap: 16)
  }
}

# Add another body (a pond on an island, an ocean beyond a lake). Same mesh,
# same pipeline; drawn after the earlier bodies.
func waterAddBody(waterSystem: mod WaterSystem, body: view WaterBody) pub {
  waterSystem.bodies.add(value: body)
}

# The first body: it sizes the shared mesh and owns the FFT cascades.
func primaryBody(waterSystem: view WaterSystem) ret WaterBody {
  if let body: WaterBody = waterSystem.bodies.copyAt(index: 0) { ret body }
  ret createLakeToon(surfaceZ: 0.0, extent: 1.0)
}

func waterSurfaceWgsl() ret String {
  let noiseSrc: String = gbReadWgsl(path: "lib/noise.wgsl")
  let surfaceSrc: String = gbReadWgsl(path: "lib/water/waterSurface.wgsl")
  if surfaceSrc.length() is 0 { ret surfaceSrc }
  ret noiseSrc.concat(other: "\n").concat(other: surfaceSrc)
}

# The surface pipeline: the geometry pass's vertex layout (pos/nrm/uv, stride 32),
# straight alpha blending, reverse-Z depth TEST without write, cull none (a lake is
# seen from above and, wading, from just under its surface), one target in the HDR
# format lighting wrote. Built lazily after the first deferred prepare.
func ensureWaterPipeline(waterSystem: mod WaterSystem) {
  if waterSystem.pipeMade { ret }
  waterSystem.pipeMade = true
  let source: String = waterSurfaceWgsl()
  if source.length() is 0 {
    log("[water] lib/water/waterSurface.wgsl not readable from the working directory — run from the repo root; water is not drawn")
    ret
  }
  let sourceC: Buffer(Any) = source.toCStr()
  let shaderMod: Ptr = makeShaderModule(wgsl: sourceC)
  var attrs: List(WGPUVertexAttribute) = createList(WGPUVertexAttribute, cap: 3)
  attrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0 as UInt64, shaderLocation: 0 as UInt32 })
  attrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12 as UInt64, shaderLocation: 1 as UInt32 })
  attrs.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24 as UInt64, shaderLocation: 2 as UInt32 })
  var vbls: List(WGPUVertexBufferLayout) = createList(WGPUVertexBufferLayout, cap: 1)
  vbls.add(value: {
    stepMode: WGPUVertexStepMode_Vertex, arrayStride: 32 as UInt64,
    attributeCount: 3 as UInt64, attributes: attrs.data
  })
  var blends: List(WGPUBlendState) = createList(WGPUBlendState, cap: 1)
  blends.add(value: {
    color: { operation: WGPUBlendOperation_Add, srcFactor: WGPUBlendFactor_SrcAlpha, dstFactor: WGPUBlendFactor_OneMinusSrcAlpha },
    alpha: { operation: WGPUBlendOperation_Add, srcFactor: WGPUBlendFactor_One, dstFactor: WGPUBlendFactor_OneMinusSrcAlpha }
  })
  var targets: List(WGPUColorTargetState) = createList(WGPUColorTargetState, cap: 1)
  targets.add(value: { format: gbLitFormat() as Int32, blend: blends.data, writeMask: WGPUColorWriteMask_All })
  var frags: List(WGPUFragmentState) = createList(WGPUFragmentState, cap: 1)
  frags.add(value: {
    module: shaderMod, entryPoint: { data: gbEntryFs(), length: WGPU_STRLEN },
    targetCount: 1 as UInt64, targets: targets.data
  })
  var depths: List(WGPUDepthStencilState) = createList(WGPUDepthStencilState, cap: 1)
  depths.add(value: {
    format: WGPUTextureFormat_Depth32Float,
    depthWriteEnabled: WGPUOptionalBool_False,
    depthCompare: WGPUCompareFunction_Greater,
    stencilFront: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilBack: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilReadMask: 4294967295 as UInt32, stencilWriteMask: 4294967295 as UInt32
  })
  let desc: WGPURenderPipelineDescriptor = {
    vertex: {
      module: shaderMod, entryPoint: { data: gbEntryVs(), length: WGPU_STRLEN },
      bufferCount: 1 as UInt64, buffers: vbls.data
    },
    primitive: {
      topology: WGPUPrimitiveTopology_TriangleList,
      frontFace: WGPUFrontFace_CCW, cullMode: WGPUCullMode_None
    },
    depthStencil: depths.data,
    multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 },
    fragment: frags.data
  }
  waterSet(index: 0, ptr: wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: desc))
  wgpuShaderModuleRelease(shaderModule: shaderMod)
  let uDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst,
    size: (waterUniformFloats * 4) as UInt64
  }
  waterSet(index: 1, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: uDesc))
  # Linear clamped sampler for reading the opaque snapshot through the surface.
  let sd: WGPUSamplerDescriptor = {
    addressModeU: WGPUAddressMode_ClampToEdge, addressModeV: WGPUAddressMode_ClampToEdge,
    addressModeW: WGPUAddressMode_ClampToEdge,
    magFilter: WGPUFilterMode_Linear, minFilter: WGPUFilterMode_Linear,
    mipmapFilter: WGPUMipmapFilterMode_Nearest,
    lodMinClamp: 0.0 as Float32, lodMaxClamp: 1.0 as Float32, maxAnisotropy: 1 as UInt16
  }
  waterSet(index: 3, ptr: wgpuDeviceCreateSampler(device: webgpuDevice(), descriptor: sd))
  waterSystem.pipeReady = true
}

# Frame uniform @0 (viewProj + jitter, the geometry pass's), water uniform @1,
# scene depth @2. The depth view is recreated on resize, so the bind follows
# the targets generation like the other post passes.
func ensureWaterBind(waterSystem: mod WaterSystem) {
  let gen: Int = gbTargetsGen()
  if waterSystem.bindMade and gen is waterSystem.bindGen { ret }
  waterSystem.bindMade = true
  waterSystem.bindGen = gen
  let old: Ptr = waterGet(index: 2)
  if not (old is webgpuNull()) { wgpuBindGroupRelease(bindGroup: old) }
  let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: waterGet(index: 0), groupIndex: 0 as UInt32)
  var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 5)
  entries.add(value: { binding: 0 as UInt32, buffer: gbFrameUbuf(), size: gbFrameBytes() as UInt64 })
  entries.add(value: { binding: 1 as UInt32, buffer: waterGet(index: 1), size: (waterUniformFloats * 4) as UInt64 })
  entries.add(value: { binding: 2 as UInt32, textureView: gbViewDepth() })
  # The opaque snapshot (#842 litCopy) + its sampler: refraction reads the scene
  # through the surface. Generation-keyed like the depth view.
  entries.add(value: { binding: 3 as UInt32, textureView: gbLitCopyView() })
  entries.add(value: { binding: 4 as UInt32, sampler: waterGet(index: 3) })
  let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 5 as UInt64, entries: entries.data }
  waterSet(index: 2, ptr: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
  wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
}

func put4(uniform: mod List(Float), base: view Int, x: view Float, y: view Float, z: view Float, w: view Float) {
  uniform.set(index: base, value: x)
  uniform.set(index: base + 1, value: y)
  uniform.set(index: base + 2, value: z)
  uniform.set(index: base + 3, value: w)
}

func putWave(uniform: mod List(Float), base: view Int, wave: view GerstnerWave) {
  # Normalise the direction here so the shader never has to.
  var length: Float = Math.sqrt(x: wave.dirX * wave.dirX + wave.dirY * wave.dirY)
  if length < 0.0001 { length = 1.0 }
  put4(uniform: uniform, base: base, x: wave.dirX / length, y: wave.dirY / length, z: wave.amplitude, w: wave.wavelength)
  put4(uniform: uniform, base: base + 4, x: wave.steepness, y: wave.speed, z: 0.0, w: 0.0)
}

# Fill + upload the `Water` uniform (layout mirrored in waterSurface.wgsl).
func uploadWaterUniform(waterSystem: mod WaterSystem, body: view WaterBody, camera: view Camera3d,
                        light: view Light3d, sky: view Sky, hasSky: view Bool) {
  var sunDir: Vec3 = light.sunDir
  var sunColor: Vec3 = light.sunColor
  var zenith: Vec3 = light.ambSky
  var horizon: Vec3 = light.ambGround
  if hasSky {
    sunDir = sky.sunDir
    sunColor = sky.sunColor
    zenith = sky.zenithColor
    horizon = sky.horizonColor
  }
  put4(uniform: waterSystem.uniform, base: 0, x: body.centre.x, y: body.centre.y, z: body.centre.z, w: body.extent)
  put4(uniform: waterSystem.uniform, base: 4, x: body.shallowColor.x, y: body.shallowColor.y, z: body.shallowColor.z, w: body.depthMax)
  put4(uniform: waterSystem.uniform, base: 8, x: body.deepColor.x, y: body.deepColor.y, z: body.deepColor.z, w: body.absorb)
  put4(uniform: waterSystem.uniform, base: 12, x: body.foamDistance, y: body.rippleScale, z: body.rippleSpeed, w: body.rippleCutoff)
  put4(uniform: waterSystem.uniform, base: 16, x: camera.position.x, y: camera.position.y, z: camera.position.z, w: waterSystem.time)
  put4(uniform: waterSystem.uniform, base: 20, x: sunDir.x, y: sunDir.y, z: sunDir.z, w: body.highlightStep)
  put4(uniform: waterSystem.uniform, base: 24, x: sunColor.x, y: sunColor.y, z: sunColor.z, w: body.highlightPower)
  put4(uniform: waterSystem.uniform, base: 28, x: zenith.x, y: zenith.y, z: zenith.z, w: camera.nearZ)
  put4(uniform: waterSystem.uniform, base: 32, x: horizon.x, y: horizon.y, z: horizon.z, w: camera.farZ)
  putWave(uniform: waterSystem.uniform, base: 36, wave: body.waves.first)
  putWave(uniform: waterSystem.uniform, base: 44, wave: body.waves.second)
  var riverMode: Float = 0.0
  if body.meshId > 0 { riverMode = 1.0 }
  put4(uniform: waterSystem.uniform, base: 52, x: body.distortion, y: body.waveCount.toFloat(), z: riverMode, w: body.flowSpeed)
  # Refraction: on/off, strength, and the lit target's size for screen uvs.
  let litTexture: Ptr = gbLitTexture()
  put4(uniform: waterSystem.uniform, base: 56, x: body.refraction.toFloat(), y: body.refractStrength,
    z: (wgpuTextureGetWidth(texture: litTexture) as Int).toFloat(), w: (wgpuTextureGetHeight(texture: litTexture) as Int).toFloat())
  put4(uniform: waterSystem.uniform, base: 60, x: body.absorbColor.x, y: body.absorbColor.y, z: body.absorbColor.z, w: 0.0)
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: waterGet(index: 1),
    bufferOffset: 0 as UInt64, data: waterSystem.uniform.data,
    size: (waterUniformFloats * 4) as UInt64)
}

# One body: upload its uniform, then one render pass into the lit target with
# read-only depth and one indexed draw of the shared grid. The upload is a
# queued write and the pass is SUBMITTED here, so the next body's upload
# cannot overtake this draw (several bodies share the one uniform buffer).
func drawWaterBody(waterSystem: mod WaterSystem, body: view WaterBody, camera: view Camera3d,
                   light: view Light3d, sky: view Sky, hasSky: view Bool) {
  uploadWaterUniform(waterSystem: waterSystem, body: body, camera: camera, light: light, sky: sky, hasSky: hasSky)
  var mesh: Int = waterSystem.mesh.id
  if body.meshId > 0 { mesh = body.meshId }   # a baked river ribbon instead of the unit grid
  if gbMeshIcount(mesh: mesh) <= 0 { ret }

  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  var colorAtts: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 1)
  colorAtts.add(value: {
    view_: gbLitView(), depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
    loadOp: WGPULoadOp_Load, storeOp: WGPUStoreOp_Store
  })
  var depthAtts: List(WGPURenderPassDepthStencilAttachment) = createList(WGPURenderPassDepthStencilAttachment, cap: 1)
  depthAtts.add(value: {
    view_: gbViewDepth(),
    depthLoadOp: WGPULoadOp_Undefined, depthStoreOp: WGPUStoreOp_Undefined,
    depthReadOnly: 1 as UInt32
  })
  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 1 as UInt64, colorAttachments: colorAtts.data,
    depthStencilAttachment: depthAtts.data
  }
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: waterGet(index: 0))
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: waterGet(index: 2), dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  let vbuf: Ptr = gbMeshVbuf(mesh: mesh)
  let ibuf: Ptr = gbMeshIbuf(mesh: mesh)
  wgpuRenderPassEncoderSetVertexBuffer(renderPassEncoder: pass, slot: 0 as UInt32,
    buffer: vbuf, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: vbuf))
  wgpuRenderPassEncoderSetIndexBuffer(renderPassEncoder: pass, buffer: ibuf,
    format: WGPUIndexFormat_Uint32, offset: 0 as UInt64, size: wgpuBufferGetSize(buffer: ibuf))
  wgpuRenderPassEncoderDrawIndexed(renderPassEncoder: pass,
    indexCount: gbMeshIcount(mesh: mesh) as UInt32, instanceCount: 1 as UInt32,
    firstIndex: 0 as UInt32, baseVertex: 0 as Int32, firstInstance: 0 as UInt32)
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
}

# Draw every body. Call at the transparentForward tag, BEFORE the renderer's
# transparentPass. `deltaTime` steps the shared wave clock (visual only).
func waterDraw(waterSystem: mod WaterSystem, camera: view Camera3d, light: view Light3d,
               sky: view Sky, hasSky: view Bool, deltaTime: copy Float) pub {
  if gbDeferredPrepare() is 0 { ret }
  waterSystem.time = waterSystem.time + deltaTime
  ensureWaterPipeline(waterSystem: waterSystem)
  if not waterSystem.pipeReady { ret }
  ensureWaterBind(waterSystem: waterSystem)
  var i: Int = 0
  loop i < waterSystem.bodies.length {
    if let body: WaterBody = waterSystem.bodies.copyAt(index: i) {
      drawWaterBody(waterSystem: waterSystem, body: body, camera: camera, light: light, sky: sky, hasSky: hasSky)
    }
    i = i + 1
  }
  if waterSystem.drawCount is 0 {
    let first: WaterBody = primaryBody(waterSystem: waterSystem)
    log("[water] toon lake: {waterSystem.bodies.length} bodies, extent {first.extent}, {first.gridSegments}x{first.gridSegments} grid, {first.waveCount} gerstner waves, surface z {first.centre.z}")
  }
  waterSystem.drawCount = waterSystem.drawCount + 1
}

# ----- FFT cascades (#831) -----------------------------------------------------
# Slot layout in the C handle store: cascade c, map m (0 displacement, 1 normal,
# 2 Jacobian/foam) -> texture at waterCascadeSlot(c, m), its view one slot up.
const waterCascadeSlotBase: Int = 8
const waterCascadeMaps: Int = 3

func waterCascadeSlot(cascade: view Int, map: view Int) ret Int {
  ret waterCascadeSlotBase + (cascade * waterCascadeMaps + map) * 2
}

# Allocate one cascade map: a storage texture the FFT compute will write and
# the surface shader will sample. rgba16float is enough for displacement in
# metres and unit normals; the Jacobian map uses the same format for one path.
func makeCascadeMap(size: copy Int) ret Ptr {
  let td: WGPUTextureDescriptor = {
    usage: WGPUTextureUsage_StorageBinding + WGPUTextureUsage_TextureBinding,
    dimension: WGPUTextureDimension_2D,
    size: { width: size as UInt32, height: size as UInt32, depthOrArrayLayers: 1 as UInt32 },
    format: WGPUTextureFormat_RGBA16Float, mipLevelCount: 1 as UInt32, sampleCount: 1 as UInt32
  }
  ret wgpuDeviceCreateTexture(device: webgpuDevice(), descriptor: td)
}

func makeCascadeView(texture: copy Ptr) ret Ptr {
  let vd: WGPUTextureViewDescriptor = {
    format: WGPUTextureFormat_RGBA16Float, dimension: WGPUTextureViewDimension_2D,
    baseMipLevel: 0 as UInt32, mipLevelCount: 1 as UInt32,
    baseArrayLayer: 0 as UInt32, arrayLayerCount: 1 as UInt32,
    aspect: WGPUTextureAspect_All
  }
  ret wgpuTextureCreateView(texture: texture, descriptor: vd)
}

# The render graph's waterFft step (#831). Slice 1: make sure the cascade maps
# exist for the body's tier (fftSize x fftSize, cascadeCount sets of
# displacement / normal / Jacobian), then bake the h0 spectrum + the Stockham
# butterfly (#849). The per-frame evolution + iFFT that fill the maps are the
# next slice; until then the maps are allocated, declared to the graph, and
# left untouched (the toon surface does not read them). Call at RenderTag.waterFft.
func waterFftStep(waterSystem: mod WaterSystem) pub {
  if gbDeferredPrepare() is 0 { ret }
  if waterSystem.cascadesMade {
    # Slice 2 (#849): the spectrum + butterfly, baked once (or after invalidate).
    ensureFftGpu(waterSystem: waterSystem)
    bakeFftSpectrum(waterSystem: waterSystem)
    ret
  }
  waterSystem.cascadesMade = true
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  var cascade: Int = 0
  loop cascade < body.cascadeCount {
    var map: Int = 0
    loop map < waterCascadeMaps {
      let slot: Int = waterCascadeSlot(cascade: cascade, map: map)
      let texture: Ptr = makeCascadeMap(size: size)
      waterSet(index: slot, ptr: texture)
      waterSet(index: slot + 1, ptr: makeCascadeView(texture: texture))
      map = map + 1
    }
    cascade = cascade + 1
  }
  log("[water] fft cascades: {body.cascadeCount} x {size}x{size} (displacement, normal, jacobian), tiles {body.cascadeTile0}/{body.cascadeTile1}/{body.cascadeTile2} m, update rate {body.updateRate}")
}

# ----- FFT spectrum + butterfly (#849) ----------------------------------------
# Slots: 32 = FftU uniform, 33 = spectrum pipeline, 34 = butterfly pipeline,
# 35/36 = butterfly texture/view, 37 = readback staging (MapRead), 40 + c*2 (+1) =
# h0 texture/view per cascade, 48 + c = spectrum bind per cascade, 51 = butterfly bind.
const fftUniformFloats: Int = 12   # three vec4 (see waterFft.wgsl `FftU`)
const fftSlotUniform: Int = 32
const fftSlotSpectrumPipe: Int = 33
const fftSlotButterflyPipe: Int = 34
const fftSlotButterflyTex: Int = 35
const fftSlotReadback: Int = 37
const fftSlotH0Base: Int = 40
const fftSlotSpectrumBindBase: Int = 48
const fftSlotButterflyBind: Int = 51

func log2Int(n: view Int) ret Int {
  var stages: Int = 0
  var v: Int = n
  loop v > 1 { v = v / 2 stages = stages + 1 }
  ret stages
}

# rgba32float storage textures: h0 packs (h0(k), h0(-k)); the butterfly packs
# (twiddle re, twiddle im, read index a, read index b) per (stage, index).
func makeFloat4Storage(width: copy Int, height: copy Int) ret Ptr {
  let td: WGPUTextureDescriptor = {
    usage: WGPUTextureUsage_StorageBinding + WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopySrc,
    dimension: WGPUTextureDimension_2D,
    size: { width: width as UInt32, height: height as UInt32, depthOrArrayLayers: 1 as UInt32 },
    format: WGPUTextureFormat_RGBA32Float, mipLevelCount: 1 as UInt32, sampleCount: 1 as UInt32
  }
  ret wgpuDeviceCreateTexture(device: webgpuDevice(), descriptor: td)
}

func makeFloat4View(texture: copy Ptr) ret Ptr {
  let vd: WGPUTextureViewDescriptor = {
    format: WGPUTextureFormat_RGBA32Float, dimension: WGPUTextureViewDimension_2D,
    baseMipLevel: 0 as UInt32, mipLevelCount: 1 as UInt32,
    baseArrayLayer: 0 as UInt32, arrayLayerCount: 1 as UInt32,
    aspect: WGPUTextureAspect_All
  }
  ret wgpuTextureCreateView(texture: texture, descriptor: vd)
}

func makeComputePipeline(shaderMod: copy Ptr, entry: view String) ret Ptr {
  let entryC: Buffer(Any) = entry.toCStr()
  let pipeDesc: WGPUComputePipelineDescriptor = {
    compute: { module: shaderMod, entryPoint: { data: entryC, length: WGPU_STRLEN } }
  }
  ret wgpuDeviceCreateComputePipeline(device: webgpuDevice(), descriptor: pipeDesc)
}

# Pipelines, textures and bind groups for the spectrum bake. Each compute entry
# point gets its own pipeline AND bind group: wgpu derives a layout from the
# bindings an entry point actually uses, so the two cannot share one.
func ensureFftGpu(waterSystem: mod WaterSystem) {
  if waterSystem.fftGpuMade { ret }
  let source: String = gbReadWgsl(path: "lib/water/waterFft.wgsl")
  if source.length() is 0 {
    log("[water fft] lib/water/waterFft.wgsl not readable from the working directory — run from the repo root; the spectrum is not baked")
    waterSystem.fftGpuMade = true
    ret
  }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  let sourceC: Buffer(Any) = source.toCStr()
  let shaderMod: Ptr = makeShaderModule(wgsl: sourceC)
  waterSet(index: fftSlotSpectrumPipe, ptr: makeComputePipeline(shaderMod: shaderMod, entry: "spectrum"))
  waterSet(index: fftSlotButterflyPipe, ptr: makeComputePipeline(shaderMod: shaderMod, entry: "butterfly"))
  wgpuShaderModuleRelease(shaderModule: shaderMod)
  let uDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst, size: (fftUniformFloats * 4) as UInt64
  }
  waterSet(index: fftSlotUniform, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: uDesc))
  let butterfly: Ptr = makeFloat4Storage(width: log2Int(n: size), height: size)
  waterSet(index: fftSlotButterflyTex, ptr: butterfly)
  waterSet(index: fftSlotButterflyTex + 1, ptr: makeFloat4View(texture: butterfly))
  let rDesc: WGPUBufferDescriptor = {
    usage: WGPUBufferUsage_CopyDst + WGPUBufferUsage_MapRead, size: (size * size * 16) as UInt64
  }
  waterSet(index: fftSlotReadback, ptr: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: rDesc))
  var cascade: Int = 0
  loop cascade < body.cascadeCount {
    let h0: Ptr = makeFloat4Storage(width: size, height: size)
    waterSet(index: fftSlotH0Base + cascade * 2, ptr: h0)
    waterSet(index: fftSlotH0Base + cascade * 2 + 1, ptr: makeFloat4View(texture: h0))
    let layout: Ptr = wgpuComputePipelineGetBindGroupLayout(computePipeline: waterGet(index: fftSlotSpectrumPipe), groupIndex: 0 as UInt32)
    var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 2)
    entries.add(value: { binding: 0 as UInt32, buffer: waterGet(index: fftSlotUniform), size: (fftUniformFloats * 4) as UInt64 })
    entries.add(value: { binding: 1 as UInt32, textureView: waterGet(index: fftSlotH0Base + cascade * 2 + 1) })
    let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 2 as UInt64, entries: entries.data }
    waterSet(index: fftSlotSpectrumBindBase + cascade, ptr: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
    wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
    cascade = cascade + 1
  }
  let bLayout: Ptr = wgpuComputePipelineGetBindGroupLayout(computePipeline: waterGet(index: fftSlotButterflyPipe), groupIndex: 0 as UInt32)
  var bEntries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 2)
  bEntries.add(value: { binding: 0 as UInt32, buffer: waterGet(index: fftSlotUniform), size: (fftUniformFloats * 4) as UInt64 })
  bEntries.add(value: { binding: 2 as UInt32, textureView: waterGet(index: fftSlotButterflyTex + 1) })
  let bDesc: WGPUBindGroupDescriptor = { layout: bLayout, entryCount: 2 as UInt64, entries: bEntries.data }
  waterSet(index: fftSlotButterflyBind, ptr: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: bDesc))
  wgpuBindGroupLayoutRelease(bindGroupLayout: bLayout)
  waterSystem.fftGpuMade = true
}

func cascadeTile(body: view WaterBody, cascade: view Int) ret Float {
  if cascade is 0 { ret body.cascadeTile0 }
  if cascade is 1 { ret body.cascadeTile1 }
  ret body.cascadeTile2
}

# Each cascade owns a k band so the cascades never count a wavelength twice
# when the surface sums them. The hand-over to the next (smaller) tile happens
# where that tile resolves the wave with cascadeBandBins grid cells per
# wavelength: kHigh = cascadeBandBins * 2pi / L_next. (Handing over at exactly
# 2pi/L_next — one cell — would leave the 250 m cascade owning a 4-bin disc of
# its 256x256 grid while the 60 m cascade represents 60..10 m waves with 1..6
# cells; six cells is where the finer tile is the better home.)
const cascadeBandBins: Float = 6.0

func cascadeBandHigh(body: view WaterBody, cascade: view Int) ret Float {
  if cascade >= body.cascadeCount - 1 { ret 1000000.0 }
  ret cascadeBandBins * 6.28318530718 / cascadeTile(body: body, cascade: cascade + 1)
}

func uploadFftUniform(waterSystem: mod WaterSystem, body: view WaterBody, cascade: view Int) {
  loop waterSystem.fftUniform.length < fftUniformFloats { waterSystem.fftUniform.add(value: 0.0) }
  let tile: Float = cascadeTile(body: body, cascade: cascade)
  var kLow: Float = 0.0
  if cascade > 0 { kLow = cascadeBandHigh(body: body, cascade: cascade - 1) }
  let kHigh: Float = cascadeBandHigh(body: body, cascade: cascade)
  put4(uniform: waterSystem.fftUniform, base: 0, x: body.fftSize.toFloat(), y: tile, z: body.windSpeed, w: body.windDirRad)
  put4(uniform: waterSystem.fftUniform, base: 4, x: body.fetch, y: 9.81, z: body.waterDepth, w: 1337.0 + cascade.toFloat() * 101.0)
  put4(uniform: waterSystem.fftUniform, base: 8, x: kLow, y: kHigh, z: cascade.toFloat(), w: 0.0)
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: waterGet(index: fftSlotUniform),
    bufferOffset: 0 as UInt64, data: waterSystem.fftUniform.data, size: (fftUniformFloats * 4) as UInt64)
}

# One compute dispatch of `pipeline` with `bind` over a width x height grid of
# 8x8 workgroups, SUBMITTED at once (the uniform it read was queued just before,
# and the next cascade rewrites that same buffer).
func dispatchFft(pipeline: copy Ptr, bind: copy Ptr, width: copy Int, height: copy Int) {
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let cpDesc: WGPUComputePassDescriptor = { nextInChain: webgpuNull() }
  let pass: Ptr = wgpuCommandEncoderBeginComputePass(commandEncoder: enc, descriptor: cpDesc)
  wgpuComputePassEncoderSetPipeline(computePassEncoder: pass, pipeline: pipeline)
  wgpuComputePassEncoderSetBindGroup(computePassEncoder: pass, groupIndex: 0 as UInt32,
    group: bind, dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  wgpuComputePassEncoderDispatchWorkgroups(computePassEncoder: pass,
    workgroupCountX: ((width + 7) / 8) as UInt32, workgroupCountY: ((height + 7) / 8) as UInt32, workgroupCountZ: 1 as UInt32)
  wgpuComputePassEncoderEnd(computePassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuComputePassEncoderRelease(computePassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
}

# Bake h0 for every cascade + the butterfly table. Runs ONCE; call
# waterFftInvalidate when the sea state or the resolution changes.
func bakeFftSpectrum(waterSystem: mod WaterSystem) {
  if waterSystem.fftBaked { ret }
  if waterGet(index: fftSlotSpectrumPipe) is webgpuNull() { ret }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  var cascade: Int = 0
  loop cascade < body.cascadeCount {
    uploadFftUniform(waterSystem: waterSystem, body: body, cascade: cascade)
    dispatchFft(pipeline: waterGet(index: fftSlotSpectrumPipe), bind: waterGet(index: fftSlotSpectrumBindBase + cascade), width: size, height: size)
    cascade = cascade + 1
  }
  # The butterfly only needs N; the last uniform upload carries it.
  dispatchFft(pipeline: waterGet(index: fftSlotButterflyPipe), bind: waterGet(index: fftSlotButterflyBind), width: log2Int(n: size), height: size)
  waterSystem.fftBaked = true
  log("[water fft] spectrum baked: {body.cascadeCount} cascades of {size}x{size}, wind {body.windSpeed} m/s, fetch {body.fetch} m, depth {body.waterDepth} m; butterfly {log2Int(n: size)} stages")
}

# Sea state or resolution changed: re-bake next frame.
func waterFftInvalidate(waterSystem: mod WaterSystem) pub {
  waterSystem.fftBaked = false
}

# ----- diagnostics: read a baked texture back (#849) -------------------------
# Copy an rgba32float texture into the MapRead staging buffer and map it into
# fftRead. BLOCKING (the grass idiom): for tests and diagnostics, never per
# frame. WebGPU requires bytesPerRow to be a multiple of 256, so a row is padded
# up to that: read texel (x, y) at float index y * readbackRowFloats(width) + x*4
# (h0 at 256 wide is exactly 4096 B/row; the 8-wide butterfly pads 128 -> 256).
func readbackRowBytes(width: view Int) ret Int {
  let raw: Int = width * 16
  ret ((raw + 255) / 256) * 256
}

func readbackRowFloats(width: view Int) ret Int {
  ret readbackRowBytes(width: width) / 4
}

func readbackFloat4(waterSystem: mod WaterSystem, texture: copy Ptr, width: copy Int, height: copy Int) ret Bool {
  if texture is webgpuNull() { ret false }
  let rowBytes: Int = readbackRowBytes(width: width)
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  let source: WGPUTexelCopyTextureInfo = { texture: texture, aspect: WGPUTextureAspect_All }
  let destination: WGPUTexelCopyBufferInfo = {
    layout: { offset: 0 as UInt64, bytesPerRow: rowBytes as UInt32, rowsPerImage: height as UInt32 },
    buffer: waterGet(index: fftSlotReadback)
  }
  let extent: WGPUExtent3D = { width: width as UInt32, height: height as UInt32, depthOrArrayLayers: 1 as UInt32 }
  wgpuCommandEncoderCopyTextureToBuffer(commandEncoder: enc, source: source, destination: destination, copySize: extent)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuCommandEncoderRelease(commandEncoder: enc)
  let floats: Int = (rowBytes / 4) * height
  loop waterSystem.fftRead.length < floats { waterSystem.fftRead.add(value: 0.0) }
  let ok: Int = webgpuMapRead(buffer: waterGet(index: fftSlotReadback), size: (floats * 4) as UInt64, dst: waterSystem.fftRead.data)
  ret ok is not 0
}

func readAt(waterSystem: view WaterSystem, index: view Int) ret Float {
  if let f: Float = waterSystem.fftRead.copyAt(index: index) { ret f }
  ret 0.0
}

# The honest check of the bake (#849): read cascade 0's h0 back and confirm
# (a) it is non-zero, (b) the (k, -k) packing is exactly symmetric — texel(k).zw
# is texel(-k).xy — which is what the time evolution relies on to keep the
# surface real, (c) the radial energy peaks at the JONSWAP peak wavenumber
# k_p = w_p^2 / g (deep water), and (d) the butterfly's first stage reads (i/2,
# i/2 + N/2) with twiddle +-1. Logs one "[water fft] h0 ok ..." line (or FAIL).
func waterFftDiagnose(waterSystem: mod WaterSystem) pub ret Bool {
  if not waterSystem.fftBaked { log("[water fft] h0 FAIL: not baked") ret false }
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let size: Int = body.fftSize
  if not readbackFloat4(waterSystem: waterSystem, texture: waterGet(index: fftSlotH0Base), width: size, height: size) {
    log("[water fft] h0 FAIL: readback failed")
    ret false
  }
  let deltaK: Float = 6.28318530718 / body.cascadeTile0
  let bins: Int = size / 2
  var energy: List(Float) = createList(Float, cap: bins)
  loop var b: Int = 0, b < bins, ++b { energy.add(value: 0.0) }
  var nonZero: Int = 0
  var maxAsymmetry: Float = 0.0
  let rowFloats: Int = readbackRowFloats(width: size)
  loop var y: Int = 1, y < size, ++y {
    loop var x: Int = 1, x < size, ++x {
      let i: Int = y * rowFloats + x * 4
      let re: Float = readAt(waterSystem: waterSystem, index: i)
      let im: Float = readAt(waterSystem: waterSystem, index: i + 1)
      let e: Float = re * re + im * im
      if e > 0.0 { nonZero = nonZero + 1 }
      # -k lives at (size - x, size - y); its .xy must equal our .zw.
      let j: Int = (size - y) * rowFloats + (size - x) * 4
      let dRe: Float = Math.abs(value: readAt(waterSystem: waterSystem, index: i + 2) - readAt(waterSystem: waterSystem, index: j))
      let dIm: Float = Math.abs(value: readAt(waterSystem: waterSystem, index: i + 3) - readAt(waterSystem: waterSystem, index: j + 1))
      if dRe > maxAsymmetry { maxAsymmetry = dRe }
      if dIm > maxAsymmetry { maxAsymmetry = dIm }
      let n: Float = (x - size / 2).toFloat()
      let m: Float = (y - size / 2).toFloat()
      let bin: Int = (Math.sqrt(x: n * n + m * m)).toInt()
      if bin < bins {
        if let current: Float = energy.copyAt(index: bin) { energy.set(index: bin, value: current + e) }
      }
    }
  }
  var peakBin: Int = 0
  var peakEnergy: Float = 0.0
  loop var b2: Int = 1, b2 < bins, ++b2 {
    if let e2: Float = energy.copyAt(index: b2) {
      if e2 > peakEnergy { peakEnergy = e2 peakBin = b2 }
    }
  }
  # JONSWAP peak: w_p = 22 (g^2 / (U F))^(1/3); deep water k_p = w_p^2 / g.
  let g: Float = 9.81
  let omegaP: Float = 22.0 * Math.pow(base: g * g / (body.windSpeed * body.fetch), exp: 1.0 / 3.0)
  let kP: Float = omegaP * omegaP / g
  let expectedBin: Float = kP / deltaK
  # butterfly stage 0, index 0 and 1
  var butterflyOk: Bool = false
  let stages: Int = log2Int(n: size)
  if readbackFloat4(waterSystem: waterSystem, texture: waterGet(index: fftSlotButterflyTex), width: stages, height: size) {
    # texel (stage 0, i) lives at row i: index i * rowFloats + stage * 4.
    let butterflyRow: Int = readbackRowFloats(width: stages)
    let b0: Int = 0
    let b1: Int = butterflyRow
    butterflyOk = Math.abs(value: readAt(waterSystem: waterSystem, index: b0) - 1.0) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b0 + 2) - 0.0) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b0 + 3) - (size / 2).toFloat()) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b1) + 1.0) < 0.0001
      and Math.abs(value: readAt(waterSystem: waterSystem, index: b1 + 2) - 0.0) < 0.0001
  }
  # Non-zero texels = the band's disc in k-space: pi (kHigh / dk)^2 cells (the
  # k = 0 texel and the Nyquist row/column are zeroed). This checks the band
  # mask, which a flat "mostly non-zero" threshold would not — a banded cascade
  # is mostly zero by design.
  let total: Int = (size - 1) * (size - 1)
  let bandRadius: Float = cascadeBandHigh(body: body, cascade: 0) / deltaK
  let expectedNonZero: Float = 3.14159265 * bandRadius * bandRadius
  let nonZeroOk: Bool = nonZero.toFloat() > expectedNonZero * 0.6 and nonZero.toFloat() < expectedNonZero * 1.3
  let symmetryOk: Bool = maxAsymmetry < 0.000001
  let peakOk: Bool = Math.abs(value: peakBin.toFloat() - expectedBin) <= 2.0
  let ok: Bool = nonZeroOk and symmetryOk and peakOk and butterflyOk
  var verdict: String = "ok"
  if not ok { verdict = "FAIL" }
  log("[water fft] h0 {verdict}: nonzero {nonZero}/{total} (band disc expects ~{expectedNonZero}), max (k,-k) asymmetry {maxAsymmetry}, energy peak bin {peakBin} vs JONSWAP k_p bin {expectedBin} (k_p {kP} rad/m), butterfly stage 0 {butterflyOk}")
  ret ok
}

func releaseFftGpu(waterSystem: mod WaterSystem) {
  if not waterSystem.fftGpuMade { ret }
  waterSystem.fftGpuMade = false
  waterSystem.fftBaked = false
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  var cascade: Int = 0
  loop cascade < body.cascadeCount {
    let bind: Ptr = waterGet(index: fftSlotSpectrumBindBase + cascade)
    if not (bind is webgpuNull()) { wgpuBindGroupRelease(bindGroup: bind) waterSet(index: fftSlotSpectrumBindBase + cascade, ptr: webgpuNull()) }
    let h0View: Ptr = waterGet(index: fftSlotH0Base + cascade * 2 + 1)
    if not (h0View is webgpuNull()) { wgpuTextureViewRelease(textureView: h0View) waterSet(index: fftSlotH0Base + cascade * 2 + 1, ptr: webgpuNull()) }
    let h0Tex: Ptr = waterGet(index: fftSlotH0Base + cascade * 2)
    if not (h0Tex is webgpuNull()) { wgpuTextureRelease(texture: h0Tex) waterSet(index: fftSlotH0Base + cascade * 2, ptr: webgpuNull()) }
    cascade = cascade + 1
  }
  let bBind: Ptr = waterGet(index: fftSlotButterflyBind)
  if not (bBind is webgpuNull()) { wgpuBindGroupRelease(bindGroup: bBind) waterSet(index: fftSlotButterflyBind, ptr: webgpuNull()) }
  let bView: Ptr = waterGet(index: fftSlotButterflyTex + 1)
  if not (bView is webgpuNull()) { wgpuTextureViewRelease(textureView: bView) waterSet(index: fftSlotButterflyTex + 1, ptr: webgpuNull()) }
  let bTex: Ptr = waterGet(index: fftSlotButterflyTex)
  if not (bTex is webgpuNull()) { wgpuTextureRelease(texture: bTex) waterSet(index: fftSlotButterflyTex, ptr: webgpuNull()) }
  let readback: Ptr = waterGet(index: fftSlotReadback)
  if not (readback is webgpuNull()) { wgpuBufferRelease(buffer: readback) waterSet(index: fftSlotReadback, ptr: webgpuNull()) }
  let ubuf: Ptr = waterGet(index: fftSlotUniform)
  if not (ubuf is webgpuNull()) { wgpuBufferRelease(buffer: ubuf) waterSet(index: fftSlotUniform, ptr: webgpuNull()) }
  let sp: Ptr = waterGet(index: fftSlotSpectrumPipe)
  if not (sp is webgpuNull()) { wgpuComputePipelineRelease(computePipeline: sp) waterSet(index: fftSlotSpectrumPipe, ptr: webgpuNull()) }
  let bp: Ptr = waterGet(index: fftSlotButterflyPipe)
  if not (bp is webgpuNull()) { wgpuComputePipelineRelease(computePipeline: bp) waterSet(index: fftSlotButterflyPipe, ptr: webgpuNull()) }
}

func releaseCascades(waterSystem: mod WaterSystem) {
  if not waterSystem.cascadesMade { ret }
  waterSystem.cascadesMade = false
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  var cascade: Int = 0
  loop cascade < body.cascadeCount {
    var map: Int = 0
    loop map < waterCascadeMaps {
      let slot: Int = waterCascadeSlot(cascade: cascade, map: map)
      let textureView: Ptr = waterGet(index: slot + 1)
      if not (textureView is webgpuNull()) { wgpuTextureViewRelease(textureView: textureView) }
      let texture: Ptr = waterGet(index: slot)
      if not (texture is webgpuNull()) { wgpuTextureRelease(texture: texture) }
      waterSet(index: slot + 1, ptr: webgpuNull())
      waterSet(index: slot, ptr: webgpuNull())
      map = map + 1
    }
    cascade = cascade + 1
  }
}

# Release the GPU handles (app shutdown or a rebuild). Null-safe.
func waterShutdown(waterSystem: mod WaterSystem) pub {
  releaseFftGpu(waterSystem: waterSystem)
  releaseCascades(waterSystem: waterSystem)
  let sampler: Ptr = waterGet(index: 3)
  if not (sampler is webgpuNull()) { wgpuSamplerRelease(sampler: sampler) waterSet(index: 3, ptr: webgpuNull()) }
  waterRelease()
  waterSystem.pipeMade = false
  waterSystem.pipeReady = false
  waterSystem.bindMade = false
}
