open water/FftSurfaceCache
# WaterSystem — the GPU side of the water package (#830). Owned by the app as a
# resource (`app.waterSystem: WaterSystem`, the #822 convention), it steps wave
# time, keeps the surface pipeline / uniform buffer / bind group as typed IDs
# in the App-owned gpu/GpuResources manager (#873; the manager is passed to
# every GPU operation and never stored), and draws ONE body per call as ONE
# draw of a unit grid — no compute — through the transparent forward pass (#843): a render
# pass that LOADS the lit HDR target, alpha-blends the surface into it, and
# tests the opaque scene depth READ-ONLY. The same depth is bound as a texture
# so the fragment shader can compute the water depth under every pixel
# (sceneDepth - surfaceDepth) — the depth-gradient colour and shoreline foam of
# the Roystan toon recipe (waterSurface.wgsl).
#
# Call order at the transparentForward tag: waterDraw FIRST, then the renderer's
# transparentPass (particles), so splashes blend OVER the surface. Refraction is
# off on this tier, so the #842 opaque snapshot taken after the water is fine;
# #832 (refraction) will want the snapshot before the water — split
# transparentPass then, it is a two-line change.
#
# The FFT ocean (cascade maps, spectrum bake, evolution + iFFT) lives in
# WaterFft.rae; its IDs are grouped in water/WaterGpuIds.rae. Two systems on
# one manager are independent instance groups: rebuilding or shutting one
# down retires only its own IDs.
import Math
import Vec3
import RendererDeferred
open MeshStore
open Gbuffer
open GbufferPasses
open GbufferTargets
open Gpu3d
open Math3d
open Mesh3d
open Scene3d
open Sky
open TransparentForward
open water/Water
open water/WaterPerf
open gpu/GpuTiming
open water/WaterSchedule
open water/WaterGpuIds
open water/WaterGpuBridge
open GbufferUnderwater
open gpu/GpuResources
open gpu/GpuDependencies
open gpu/GpuTextures
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderTransfer
open gpu/GpuRenderPass
open gpu/GpuArgs
open gpu/GpuIds
open webgpu/Webgpu
open webgpu/WebgpuEnums
open webgpu/Context

const waterUniformFloats: Int = 80  # twenty vec4 (see waterSurface.wgsl `Water`)

# SSR march tuning (#854): a hit counts when the ray is behind the scene by
# less than this many metres (grown with distance in the shader), and rays
# stop after this many metres (the fade starts at 70% of it).
const waterSsrThickness: Float = 0.6

const waterSsrMaxDistance: Float = 80.0

# The FFT cascade maps (#831; WaterFft.rae fills them): cascade c, map m (0
# displacement+Jacobian, 1 normal, 2 foam). The surface binds them here.
func cascadeTexture(waterSystem: view WaterSystem, cascade: view Int, map: view Int) ret TextureId {
  ret waterSystem.cascades.textures.copyAtFallback(
    index: waterCascadeIndex(cascade: cascade, map: map)
    fallback: noTextureId()
  )
}

func cascadeView(
  waterSystem: view WaterSystem
  cascade: view Int
  map: view Int
) ret TextureViewId {
  ret waterSystem.cascades.views.copyAtFallback(
    index: waterCascadeIndex(cascade: cascade, map: map)
    fallback: noTextureViewId()
  )
}

# The whole mip chain of a cascade map (#1002) — what the surface shader
# samples; `cascadeView` is level 0 alone (the FFT's write target, the
# readback's copy source).
func cascadeSampleView(
  waterSystem: view WaterSystem
  cascade: view Int
  map: view Int
) ret TextureViewId {
  ret waterSystem.cascades.sampleViews.copyAtFallback(
    index: waterCascadeIndex(cascade: cascade, map: map)
    fallback: noTextureViewId()
  )
}

type WaterSystem {
  surfaceCache: FftSurfaceCache
  # Every body this system draws (#847): they share ONE unit-grid mesh (sized
  # by the first body's gridSegments) and one pipeline; each is one draw with
  # its own uniform upload. The first body also owns the FFT cascades.
  bodies: List(WaterBody)
  mesh: MeshHandle
  pipeMade: Bool  # creation attempted (a missing shader is reported once)
  pipeReady: Bool  # creation succeeded; the draw is skipped otherwise
  bindGen: Int  # targets generation the bind group was built at (depth view changes on resize)
  bindMade: Bool
  time: Float
  uniform: List(Float)
  drawCount: Int
  cascadesMade: Bool  # the FFT cascade textures exist (#831 slice 1)
  fftGpuMade: Bool  # spectrum/butterfly pipelines, h0 + butterfly textures, binds (#849)
  fftBaked: Bool  # h0 + butterfly filled for the current params/resolution
  fftUniform: List(Float)
  fftRead: List(Float)  # readback staging on the CPU side (diagnostics only)
  fftFrameMade: Bool  # the evolution/iFFT pipelines, working textures, binds (#850)
  fftTestMode: Bool  # bake ONE known wave instead of JONSWAP (diagnostics)
  evolveUniform: List(Float)
  stageUniform: List(Int32)
  performance: WaterPerf
  surfacePerf: WaterPerf  # #854: capture-only timing of the primary body's surface draw
  fftAllocatedSize: Int
  fftAllocatedCount: Int
  fftSeaState: WaterBody
  fftFrame: Int  # render-frame ordinal, independent of skipped updates
  fftNeedsRefresh: Bool  # force every active map before sampling a new state
  fftUpdateCounts: List(Int)
  fftSampleTimes: List(Float)
  fftLastUpdates: Int
  # The manager-owned GPU objects, by lifetime group (water/WaterGpuIds.rae).
  surface: WaterSurfaceGpu
  cascades: WaterCascadeGpu
  fft: WaterFftGpu
  cache: WaterCacheGpu
  inFlight: List(SubmissionId)  # this system's submissions, polled every step
  # The camera's underwater state (#855, water/Underwater.rae): the last
  # decision (for the crossing hysteresis), the body it named, and how many
  # frames an FFT body fell back to its still level for the crossing test.
  underwater: UnderwaterParams
  underwaterBody: Int
  underwaterStillFrames: Int
}

# The unit grid mesh is uploaded into the RENDERER's mesh store (#905): the
# water pass borrows it from there like every other mesh it draws.
func createWaterSystem(renderer: mod DeferredRenderer, body: view WaterBody) ret WaterSystem {
  unsafe {
    # A unit grid (-0.5..0.5) the vertex shader scales to each body's extent, so
    # one mesh serves every body; its density is the first body's tier knob.
    var segments: Int = body.gridSegments
    if segments < 4 {
      segments = 4
    }
    let grid: MeshData = makePlane(size: 1.0, segments: segments)
    let mesh: MeshHandle = RendererDeferred.uploadMesh(
      renderer: renderer
      verts: grid.verts
      vertCount: grid.vertCount
      indices: grid.indices
    )
    let uniform: List(Float) = List.create(Float, cap: waterUniformFloats)
    var i: Int = 0
    loop i < waterUniformFloats {
      uniform.add(value: 0.0)
      i = i + 1
    }
    var bodies: List(WaterBody) = List.create(WaterBody, cap: 4)
    bodies.add(value: body)
    let updateCounts: List(Int) = { 0, 0, 0 }
    let sampleTimes: List(Float) = { 0.0, 0.0, 0.0 }
    ret WaterSystem {
      surfaceCache: createFftSurfaceCache(body: body)
      bodies: own bodies
      mesh: mesh
      pipeMade: false
      pipeReady: false
      bindGen: 0 - 1
      bindMade: false
      time: 0.0
      uniform: uniform
      drawCount: 0
      cascadesMade: false
      fftGpuMade: false
      fftBaked: false
      fftUniform: List.create(Float, cap: fftUniformFloats)
      fftRead: List.create(Float, cap: 16)
      fftFrameMade: false
      fftTestMode: false
      evolveUniform: List.create(Float, cap: 8)
      stageUniform: List.create(Int32, cap: 4)
      performance: createWaterPerf()
      surfacePerf: createWaterPerfLabeled(label: "surface")
      fftAllocatedSize: 0
      fftAllocatedCount: 0
      fftSeaState: body
      fftFrame: 0
      fftNeedsRefresh: true
      fftUpdateCounts: own updateCounts
      fftSampleTimes: own sampleTimes
      fftLastUpdates: 0
      surface: createSurfaceGpu()
      cascades: createCascadeGpu()
      fft: createFftGpu()
      cache: createCacheGpu()
      inFlight: List.create(SubmissionId, cap: 8)
      underwater: noUnderwater()
      underwaterBody: 0 - 1
      underwaterStillFrames: 0
    }
  }
}

# ----- submissions (gpu/GpuIds helpers over this system's own list) --------
func waterSubmit(
  waterSystem: mod WaterSystem
  resources: mod GpuResources
  recording: mod Recording
) ret opt SubmissionId {
  ret trackSubmission(inFlight: waterSystem.inFlight, resources: resources, recording: recording)
}

func waterPollSubmissions(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  pollSubmissions(inFlight: waterSystem.inFlight, resources: resources)
  # Submission dependency slices live in the manager's shared append arena.
  # Water records FFT, readback and surface work every frame, so retired
  # submissions must be removed from that arena just as Gpu2dCanvas removes
  # its per-frame slices. Without this relocation the GPU object tables stay
  # flat while the three CPU dependency Lists grow forever.
  compactDependencies(resources: resources)
}

func waterDrainSubmissions(waterSystem: mod WaterSystem, resources: mod GpuResources) {
  drainSubmissions(inFlight: waterSystem.inFlight, resources: resources)
}

# Add another body (a pond on an island, an ocean beyond a lake). Same mesh,
# same pipeline; drawn after the earlier bodies.
func waterAddBody(waterSystem: mod WaterSystem, body: view WaterBody) {
  waterSystem.bodies.add(value: body)
}

# The first body: it sizes the shared mesh and owns the FFT cascades.
func primaryBody(waterSystem: view WaterSystem) ret WaterBody {
  if let body: WaterBody = waterSystem.bodies.copyAt(index: 0) {
    var normalized: WaterBody = body
    normalizeWaterTier(body: normalized)
    ret normalized
  }
  ret createLakeToon(surfaceZ: 0.0, extent: 1.0)
}

func waterSurfaceWgsl() ret String {
  let noiseSrc: String = gbReadWgsl(path: "lib/noise.wgsl")
  let surfaceSrc: String = gbReadWgsl(path: "lib/water/waterSurface.wgsl")
  if surfaceSrc.length() is 0 {
    ret surfaceSrc
  }
  ret noiseSrc.concat(other: "\n").concat(other: surfaceSrc)
}

# The surface pipeline: the geometry pass's vertex layout (pos/nrm/uv, stride 32),
# straight alpha blending, reverse-Z depth TEST without write, cull none (a lake is
# seen from above and, wading, from just under its surface), one target in the HDR
# format lighting wrote. Built lazily after the first deferred prepare.
func ensureWaterPipeline(
  waterSystem: mod WaterSystem
  resources: mod GpuResources
  litFormat: copy Int32
) {
  if waterSystem.pipeMade {
    ret
  }
  waterSystem.pipeMade = true
  let source: String = waterSurfaceWgsl()
  if source.length() is 0 {
    log(
      "[water] lib/water/waterSurface.wgsl not readable from the working directory — run from the repo root; water is not drawn"
    )
    ret
  }
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 3)
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0, location: 0 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12, location: 1 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24, location: 2 })
  let colorFormats: List(Int32) = List.create(Int32, cap: 1)
  colorFormats.add(value: litFormat)
  let spec: RenderPipelineSpec = {
    vertexStride: 32
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: true
    premultiplied: false
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: false
    depthCompare: WGPUCompareFunction_Greater
    cullMode: WGPUCullMode_None
  }
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    wgsl: source
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: spec
  ) {
    waterSystem.surface.pipeline = pipeline
  }
  if let uniform: BufferId = createBuffer(
    resources: resources
    size: waterUniformFloats * 4
    usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst
  ) {
    waterSystem.surface.uniform = uniform
  }
  # Linear clamped sampler for reading the opaque snapshot through the surface.
  if let litSampler: SamplerId = createSampler(resources: resources) {
    waterSystem.surface.litSampler = litSampler
  }
  # The cascades TILE: world.xy / tile runs far outside [0, 1], so they need a
  # repeating sampler (clamp-to-edge stretches the edge texels into streaks) —
  # trilinear, since the maps carry a mip chain the shader picks a level of
  # per vertex and per pixel (#1002, WaterFftMips).
  if let cascadeSampler: SamplerId = createSamplerMipped(
    resources: resources
    addressMode: WGPUAddressMode_Repeat
  ) {
    waterSystem.surface.cascadeSampler = cascadeSampler
  }
  waterSystem.pipeReady = isValidRenderPipeline(
    resources: resources
    id: waterSystem.surface.pipeline
  ) and isValidBuffer(resources: resources, id: waterSystem.surface.uniform) and isValidSampler(
    resources: resources
    id: waterSystem.surface.litSampler
  ) and isValidSampler(resources: resources, id: waterSystem.surface.cascadeSampler)
  if not waterSystem.pipeReady {
    log("[water] surface pipeline could not be created; water is not drawn")
  }
}

# Frame uniform @0 (viewProj + jitter, the geometry pass's), water uniform @1,
# scene depth @2. The depth view is recreated on resize, so the bind (and the
# adopted frame externals) follow the targets generation like the other post
# passes. The previous bind group retires behind any draw still using it.
func ensureWaterBind(
  waterSystem: mod WaterSystem
  resources: mod GpuResources
  gbuffer: view GbufferCache
  targets: view DeferredTargets
  gbufferResources: view GpuResources
) {
  let gen: Int = gbuffer.targetsGen
  if waterSystem.bindMade and gen is waterSystem.bindGen {
    ret
  }
  # The cascade maps are allocated by waterFftStep at the waterFft tag; without
  # them the layout cannot be satisfied — draw nothing until they exist.
  if not isValidTextureView(
    resources: resources
    id: cascadeSampleView(waterSystem: waterSystem, cascade: 0, map: 1)
  ) {
    ret
  }
  waterSystem.bindMade = false
  retireBindGroup(resources: resources, id: waterSystem.surface.bindGroup)
  waterSystem.surface.bindGroup = noBindGroupId()
  releaseFrameExternals(resources: resources, frame: waterSystem.surface.frame)
  waterSystem.surface.frame = adoptFrameExternals(
    resources: resources
    gbuffer: gbuffer
    targets: targets
    gbufferResources: gbufferResources
  )
  if not waterSystem.surface.frame.valid {
    ret
  }
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 12)
  entries.add(value: externalRef(id: waterSystem.surface.frame.frameUniform))
  entries.add(value: bufferRef(id: waterSystem.surface.uniform))
  entries.add(value: externalRef(id: waterSystem.surface.frame.depthView))
  # The opaque snapshot (#842 litCopy) + its sampler: refraction reads the scene
  # through the surface. Generation-keyed like the depth view.
  entries.add(value: externalRef(id: waterSystem.surface.frame.litCopyView))
  entries.add(value: samplerRef(id: waterSystem.surface.litSampler))
  # The FFT cascades (#851): displacement+Jacobian and normal per cascade,
  # summed by the realistic path; the toon path binds them too (one layout)
  # but never samples them.
  let primary: WaterBody = primaryBody(waterSystem: waterSystem)
  loop var cascade: Int = 0, cascade < waterCascadeCount, ++cascade {
    # All six layout entries must be valid. Unused entries borrow cascade 0;
    # the shader's active-count branch never samples those extra bindings.
    var sourceCascade: Int = cascade
    if sourceCascade >= primary.cascadeCount {
      sourceCascade = 0
    }
    entries.add(
      value: textureViewRef(
        id: cascadeSampleView(waterSystem: waterSystem, cascade: sourceCascade, map: 0)
      )
    )
    entries.add(
      value: textureViewRef(
        id: cascadeSampleView(waterSystem: waterSystem, cascade: sourceCascade, map: 1)
      )
    )
  }
  entries.add(value: samplerRef(id: waterSystem.surface.cascadeSampler))
  if let bindGroup: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: waterSystem.surface.pipeline
    entries: entries
  ) {
    waterSystem.surface.bindGroup = bindGroup
    waterSystem.bindMade = true
    waterSystem.bindGen = gen
  }
}

func put4(
  uniform: mod List(Float)
  base: view Int
  x: view Float
  y: view Float
  z: view Float
  w: view Float
) {
  uniform.set(index: base, value: x)
  uniform.set(index: base + 1, value: y)
  uniform.set(index: base + 2, value: z)
  uniform.set(index: base + 3, value: w)
}

func putWave(uniform: mod List(Float), base: view Int, wave: view GerstnerWave) {
  unsafe {
    # Normalise the direction here so the shader never has to.
    var length: Float = Math.sqrt(x: wave.dirX * wave.dirX + wave.dirY * wave.dirY)
    if length < 0.0001 {
      length = 1.0
    }
    put4(
      uniform: uniform
      base: base
      x: wave.dirX / length
      y: wave.dirY / length
      z: wave.amplitude
      w: wave.wavelength
    )
    put4(
      uniform: uniform
      base: base + 4
      x: wave.steepness
      y: wave.speed
      z: 0.0
      w: 0.0
    )
  }
}

# Fill + upload the `Water` uniform (layout mirrored in waterSurface.wgsl).
func uploadWaterUniform(
  waterSystem: mod WaterSystem
  resources: view GpuResources
  body: view WaterBody
  camera: view Camera3d
  light: view Light3d
  sky: view Sky
  hasSky: view Bool
  litWidth: copy Int
  litHeight: copy Int
) {
  unsafe {
    var sunDir: Vec3 = light.sunDir
    var sunColor: Vec3 = light.sunColor
    var zenith: Vec3 = light.ambSky
    var horizon: Vec3 = light.ambGround
    if hasSky {
      sunDir = sky.sunDir
      sunColor = sky.sunColor
      zenith = sky.zenithColor
      horizon = sky.horizonColor
      if sky.kind is SkyKind.procedural {
        let zenithDirection: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 1.0)
        # Sample the horizon away from the sun so its glow does not tint the
        # entire approximation. At noon the azimuth is undefined; east is an
        # equivalent stable direction for the rotationally symmetric model.
        var horizonDirection: Vec3 = Vec3.create(x: sky.sunDir.x, y: sky.sunDir.y, z: 0.0)
        if Vec3.vlenSq(a: horizonDirection) < 0.0001 {
          horizonDirection = Vec3.create(x: 1.0, y: 0.0, z: 0.0)
        } else {
          horizonDirection = Vec3.vnorm(a: horizonDirection)
        }
        zenith = radiance(sky: sky, dir: zenithDirection)
        horizon = radiance(sky: sky, dir: horizonDirection)
      }
    }
    put4(
      uniform: waterSystem.uniform
      base: 0
      x: body.centre.x
      y: body.centre.y
      z: body.centre.z
      w: body.extent
    )
    put4(
      uniform: waterSystem.uniform
      base: 4
      x: body.shallowColor.x
      y: body.shallowColor.y
      z: body.shallowColor.z
      w: body.depthMax
    )
    put4(
      uniform: waterSystem.uniform
      base: 8
      x: body.deepColor.x
      y: body.deepColor.y
      z: body.deepColor.z
      w: body.absorb
    )
    put4(
      uniform: waterSystem.uniform
      base: 12
      x: body.foamDistance
      y: body.rippleScale
      z: body.rippleSpeed
      w: body.rippleCutoff
    )
    put4(
      uniform: waterSystem.uniform
      base: 16
      x: camera.position.x
      y: camera.position.y
      z: camera.position.z
      w: waterSystem.time
    )
    put4(
      uniform: waterSystem.uniform
      base: 20
      x: sunDir.x
      y: sunDir.y
      z: sunDir.z
      w: body.highlightStep
    )
    put4(
      uniform: waterSystem.uniform
      base: 24
      x: sunColor.x
      y: sunColor.y
      z: sunColor.z
      w: body.highlightPower
    )
    put4(
      uniform: waterSystem.uniform
      base: 28
      x: zenith.x
      y: zenith.y
      z: zenith.z
      w: camera.nearZ
    )
    put4(
      uniform: waterSystem.uniform
      base: 32
      x: horizon.x
      y: horizon.y
      z: horizon.z
      w: camera.farZ
    )
    putWave(uniform: waterSystem.uniform, base: 36, wave: body.waves.first)
    putWave(uniform: waterSystem.uniform, base: 44, wave: body.waves.second)
    put4(
      uniform: waterSystem.uniform
      base: 52
      x: body.distortion
      y: body.waveCount.toFloat()
      z: body.meshMode.toFloat()
      w: body.flowSpeed
    )
    # Refraction: on/off, strength, and the lit target's size for screen uvs.
    put4(
      uniform: waterSystem.uniform
      base: 56
      x: body.refraction.toFloat()
      y: body.refractStrength
      z: litWidth.toFloat()
      w: litHeight.toFloat()
    )
    put4(
      uniform: waterSystem.uniform
      base: 60
      x: body.absorbColor.x
      y: body.absorbColor.y
      z: body.absorbColor.z
      w: 0.0
    )
    # Realistic path (#851): the cascade tiles and the flag; the camera-centred
    # mesh is snapped to whole metres so its vertices never swim under the camera.
    var realistic: Float = 0.0
    if body.style is WaterStyle.realistic {
      realistic = 1.0
    }
    let fftBody: WaterBody = primaryBody(waterSystem: waterSystem)
    put4(
      uniform: waterSystem.uniform
      base: 64
      x: fftBody.cascadeTile0
      y: fftBody.cascadeTile1
      z: fftBody.cascadeTile2
      w: realistic
    )
    # The grid cell (m) lets the vertex shader fade Gerstner waves the grid
    # cannot sample (#857) — the same rule as Water.waveGridFactor.
    var gridCell: Float = 0.0
    if body.meshMode is 0 and body.gridSegments > 0 {
      gridCell = body.extent / body.gridSegments.toFloat()
    }
    put4(
      uniform: waterSystem.uniform
      base: 68
      x: Math.floor(x: camera.position.x)
      y: Math.floor(x: camera.position.y)
      z: fftBody.cascadeCount.toFloat()
      w: gridCell
    )
    # Screen-space reflections (#854): on/off, steps, hit thickness (m) and
    # the longest ray traced (m) — the desktop switch is the body's `ssr`.
    var ssrOn: Float = 0.0
    if body.ssr > 0 {
      ssrOn = 1.0
    }
    put4(
      uniform: waterSystem.uniform
      base: 72
      x: ssrOn
      y: body.ssrSteps.toFloat()
      z: waterSsrThickness
      w: waterSsrMaxDistance
    )
    # The sampling limits the shader fades the cascades against (#1002): the
    # centred grid's cell growth + innermost cell for the vertex displacement,
    # the map size + band hand-over for the per-pixel normals and foam.
    put4(
      uniform: waterSystem.uniform
      base: 76
      x: body.clipCellPerMetre
      y: body.clipFirstCell
      z: fftBody.fftSize.toFloat()
      w: cascadeBandBins
    )
    uploadFloats(
      resources: resources
      buffer: waterSystem.surface.uniform
      floats: waterSystem.uniform
    )
  }
}

# The adopted vertex/index buffers of a gbuffer mesh, adopted on first use.
func meshExternals(
  waterSystem: mod WaterSystem
  resources: mod GpuResources
  meshes: view MeshStore
  meshResources: view GpuResources
  mesh: view Int
) ret WaterMeshExternals {
  loop var i: Int = 0, i < waterSystem.surface.meshes.length, ++i {
    if let entry: WaterMeshExternals = waterSystem.surface.meshes.copyAt(index: i) {
      if entry.mesh is mesh {
        ret entry
      }
    }
  }
  let adopted: WaterMeshExternals = adoptMeshExternals(
    resources: resources
    meshes: meshes
    meshResources: meshResources
    mesh: mesh
  )
  if adopted.valid {
    waterSystem.surface.meshes.add(value: adopted)
  }
  ret adopted
}

# One body: upload its uniform, then one render pass into the lit target with
# read-only depth and one indexed draw of the shared grid. The upload is a
# flushed queue write and the pass is SUBMITTED here, so the next body's upload
# cannot overtake this draw (several bodies share the one uniform buffer).
func drawWaterBody(
  waterSystem: mod WaterSystem
  resources: mod GpuResources
  meshes: view MeshStore
  meshResources: view GpuResources
  body: view WaterBody
  camera: view Camera3d
  light: view Light3d
  sky: view Sky
  hasSky: view Bool
  litWidth: copy Int
  litHeight: copy Int
) {
  uploadWaterUniform(
    waterSystem: waterSystem
    resources: resources
    body: body
    camera: camera
    light: light
    sky: sky
    hasSky: hasSky
    litWidth: litWidth
    litHeight: litHeight
  )
  var mesh: Int = waterSystem.mesh.id
  if body.meshId > 0 {
    mesh = body.meshId  # a baked river ribbon instead of the unit grid
  }
  if meshStoreIndexCount(store: meshes, mesh: mesh) <= 0 {
    ret
  }
  let meshGpu: WaterMeshExternals = meshExternals(
    waterSystem: waterSystem
    resources: resources
    meshes: meshes
    meshResources: meshResources
    mesh: mesh
  )
  if not meshGpu.valid {
    ret
  }
  let target: RenderTarget = renderTargetWithDepth(
    colorView: externalRef(id: waterSystem.surface.frame.litView)
    clear: false
    r: 0.0
    g: 0.0
    b: 0.0
    a: 0.0
    depthView: externalRef(id: waterSystem.surface.frame.depthView)
    depthReadOnly: true
  )
  # #854: the surface draw is timed like the FFT step (RAE_WATER_PERF) —
  # one sample in flight, resolved on this recording, read back later — so
  # the reflection cost (SSR on vs off) is measured apart from the compute.
  let timed: Bool = beginWaterPerf(performance: waterSystem.surfacePerf, resources: resources)
  if let recording: Recording = beginRecording(resources: resources) {
    var recorded: Bool = false
    unsafe {
      var timestampWrites: Ptr = webgpuNull()
      if timed {
        if let timing: view GpuTiming => waterSystem.surfacePerf.timing {
          timestampWrites = timingWrites(timing: timing)
        }
      }
      recorded = recordDrawIndexedTimed(
        recording: recording
        resources: resources
        target: target
        pipeline: waterSystem.surface.pipeline
        bindGroup: waterSystem.surface.bindGroup
        vertexBuffer: externalRef(id: meshGpu.vertex)
        indexBuffer: externalRef(id: meshGpu.index)
        indexCount: meshGpu.indexCount
        timestampWrites: timestampWrites
      )
    }
    if recorded {
      if timed {
        resolveWaterPerf(
          performance: waterSystem.surfacePerf
          recording: recording
          resources: resources
        )
      }
      if let submission: SubmissionId = waterSubmit(
        waterSystem: waterSystem
        resources: resources
        recording: recording
      ) {
        if timed {
          noteWaterPerfSubmission(performance: waterSystem.surfacePerf, submission: submission)
        }
      }
    }
  }
}

# Draw every body. Call at the transparentForward tag, BEFORE the renderer's
# transparentPass. `deltaTime` steps the shared wave clock (visual only).
func waterDraw(
  waterSystem: mod WaterSystem
  resources: mod GpuResources
  passes: view RenderPasses
  meshResources: view GpuResources
  camera: view Camera3d
  light: view Light3d
  sky: view Sky
  hasSky: view Bool
  deltaTime: copy Float
) {
  waterPollSubmissions(waterSystem: waterSystem, resources: resources)
  collectWaterPerf(performance: waterSystem.surfacePerf, resources: resources)
  if gbDeferredPrepare() is 0 {
    ret
  }
  let primary: WaterBody = primaryBody(waterSystem: waterSystem)
  if primary.style is WaterStyle.realistic and waterSystem.fftNeedsRefresh {
    ret
  }
  if not targetsReady(targets: passes.targets, resources: meshResources) {
    ret
  }
  ensureWaterPipeline(
    waterSystem: waterSystem
    resources: resources
    litFormat: passes.targets.litFormat
  )
  if not waterSystem.pipeReady {
    ret
  }
  ensureWaterBind(
    waterSystem: waterSystem
    resources: resources
    gbuffer: passes.gbuffer
    targets: passes.targets
    gbufferResources: meshResources
  )
  if not waterSystem.bindMade {
    ret
  }
  waterSystem.time = waterSystem.time + deltaTime
  var i: Int = 0
  loop i < waterSystem.bodies.length {
    if let body: WaterBody = waterSystem.bodies.copyAt(index: i) {
      drawWaterBody(
        waterSystem: waterSystem
        resources: resources
        meshes: passes.gbuffer.meshes
        meshResources: meshResources
        body: body
        camera: camera
        light: light
        sky: sky
        hasSky: hasSky
        litWidth: passes.targets.width
        litHeight: passes.targets.height
      )
    }
    i = i + 1
  }
  if waterSystem.drawCount is 0 {
    let first: WaterBody = primaryBody(waterSystem: waterSystem)
    log(
      "[water] toon lake: {waterSystem.bodies.length} bodies, extent {first.extent}, {first.gridSegments}x{first.gridSegments} grid, {first.waveCount} gerstner waves, surface z {first.centre.z}"
    )
  }
  waterSystem.drawCount = waterSystem.drawCount + 1
}
