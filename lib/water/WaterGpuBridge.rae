# water/WaterGpuBridge — the one water module that touches raw handles (#873).
# It adopts the renderer's per-frame resources and mesh buffers into the
# water manager as EXTERNALS (referenced, never owned): since #906 the frame
# uniform, the scene depth view and the mesh buffers are the renderer's
# GbufferCache manager objects (a cross-manager borrow, read through the
# renderer manager's handles), while the lit / opaque-snapshot views are still
# C's. It also reinterprets readback bytes as floats and hands the optional
# timing pointer to a one-pass multi-dispatch recording. Everything else in
# water is plain Rae over typed IDs. The unsafe blocks here carry the
# obligations the renderer already guarantees: a frame resource stays valid
# until the targets generation changes (re-adopted then), a mesh buffer until
# renderer shutdown.
open MeshStore
open Gbuffer
open GbufferResources
open GbufferPasses
open TransparentForward
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuArgs
open gpu/GpuTiming
open water/WaterGpuIds
open gpu/GpuIds
open water/WaterPerf
open webgpu/Context

func gbLitFormat() unsafe extern("rae_gb_lit_format") ret Int

# The lit HDR target's format: the water surface's colour target.
func waterLitFormat() ret Int32 {
  unsafe {
    ret gbLitFormat() as Int32
  }
}

# Adopts the frame uniform, scene depth view, opaque snapshot view and lit
# view of the current targets generation. All four or none.
func adoptFrameExternals(
  resources: mod GpuResources
  gbuffer: view GbufferCache
  gbufferResources: view GpuResources
) ret WaterFrameExternals {
  var frame: WaterFrameExternals = noFrameExternals()
  var adopted: Int = 0
  if not isValidBuffer(resources: gbufferResources, id: gbuffer.frameUniform) {
    ret frame
  }
  if not gbufferTargetsReady(cache: gbuffer, resources: gbufferResources) {
    ret frame
  }
  unsafe {
    if let frameUniform: ExternalId = adoptExternalBuffer(
      resources: resources
      handle: refHandle(resources: gbufferResources, ref: bufferRef(id: gbuffer.frameUniform))
    ) {
      frame.frameUniform = frameUniform
      adopted = adopted + 1
    }
    if let depthView: ExternalId = adoptExternalTextureView(
      resources: resources
      handle: refHandle(
        resources: gbufferResources
        ref: gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth)
      )
    ) {
      frame.depthView = depthView
      adopted = adopted + 1
    }
    if let litCopyView: ExternalId = adoptExternalTextureView(
      resources: resources
      handle: gbLitCopyView()
    ) {
      frame.litCopyView = litCopyView
      adopted = adopted + 1
    }
    if let litView: ExternalId = adoptExternalTextureView(resources: resources, handle: gbLitView()) {
      frame.litView = litView
      adopted = adopted + 1
    }
  }
  if adopted is 4 {
    frame.valid = true
    ret frame
  }
  releaseFrameExternals(resources: resources, frame: frame)
  ret noFrameExternals()
}

func releaseFrameExternals(resources: mod GpuResources, frame: view WaterFrameExternals) {
  releaseExternal(resources: resources, id: frame.frameUniform)
  releaseExternal(resources: resources, id: frame.depthView)
  releaseExternal(resources: resources, id: frame.litCopyView)
  releaseExternal(resources: resources, id: frame.litView)
}

# Adopts one renderer mesh's vertex + index buffers (u32 indices) into the
# water manager: the buffers belong to the renderer's MeshStore (#905), the
# water system BORROWS them as externals.
func adoptMeshExternals(
  resources: mod GpuResources
  meshes: view MeshStore
  meshResources: view GpuResources
  mesh: view Int
) ret WaterMeshExternals {
  var result: WaterMeshExternals = noMeshExternals()
  result.mesh = mesh
  var adopted: Int = 0
  unsafe {
    result.indexCount = meshStoreIndexCount(store: meshes, mesh: mesh)
    if result.indexCount <= 0 {
      ret noMeshExternals()
    }
    if let vertex: ExternalId = adoptExternalBuffer(
      resources: resources
      handle: meshStoreVbufHandle(store: meshes, resources: meshResources, mesh: mesh)
    ) {
      result.vertex = vertex
      adopted = adopted + 1
    }
    if let index: ExternalId = adoptExternalBuffer(
      resources: resources
      handle: meshStoreIbufHandle(store: meshes, resources: meshResources, mesh: mesh)
    ) {
      result.index = index
      adopted = adopted + 1
    }
  }
  if adopted is 2 {
    result.valid = true
    ret result
  }
  releaseExternal(resources: resources, id: result.vertex)
  releaseExternal(resources: resources, id: result.index)
  ret noMeshExternals()
}

func releaseMeshExternals(resources: mod GpuResources, meshes: mod List(WaterMeshExternals)) {
  loop var i: Int = 0, i < meshes.length, ++i {
    if let entry: WaterMeshExternals = meshes.copyAt(index: i) {
      releaseExternal(resources: resources, id: entry.vertex)
      releaseExternal(resources: resources, id: entry.index)
    }
  }
  meshes.clear()
}

# Uploads a float list as a tightly packed f32 stream (#872 packing; the water
# uniforms are sequences of vec4, so std140 and a flat stream coincide).
func uploadFloats(
  resources: view GpuResources
  buffer: view BufferId
  floats: view List(Float)
) ret Bool {
  var writer: ArgWriter = createArgs(uniform: true)
  loop var i: Int = 0, i < floats.length, ++i {
    if let value: Float = floats.copyAt(index: i) {
      pushF32(writer: writer, value: value)
    }
  }
  ret uploadArgs(
    writer: writer
    resources: resources
    buffer: buffer
    offset: 0
  )
}

func uploadInts(
  resources: view GpuResources
  buffer: view BufferId
  values: view List(Int32)
) ret Bool {
  var writer: ArgWriter = createArgs(uniform: true)
  loop var i: Int = 0, i < values.length, ++i {
    if let value: Int32 = values.copyAt(index: i) {
      pushI32(writer: writer, value: value as Int)
    }
  }
  ret uploadArgs(
    writer: writer
    resources: resources
    buffer: buffer
    offset: 0
  )
}

# Reinterprets the first `count` * 4 readback bytes as f32 into `floats`.
func bytesToFloats(bytes: view List(UInt8), floats: mod List(Float), count: view Int) {
  loop floats.length < count {
    floats.add(value: 0.0)
  }
  if bytes.length < count * 4 {
    ret
  }
  unsafe {
    rae_ext_rae_buf_copy(
      V: UInt8
      src: bytes.data
      src_off: 0
      dst: floats.data
      dst_off: 0
      len: count * 4
      elemSize: 1
    )
  }
}

# ONE compute pass with every dispatch of `commands`, timed by the water
# performance capture when `timed` (untimed otherwise).
func recordWaterCompute(
  recording: mod Recording
  resources: view GpuResources
  commands: view List(ComputeCommand)
  performance: view WaterPerf
  timed: view Bool
) ret Bool {
  unsafe {
    var writes: Ptr = webgpuNull()
    if timed and performance.enabled {
      if let timing: view GpuTiming => performance.timing {
        writes = timingWrites(timing: timing)
      }
    }
    ret recordComputeCommands(
      recording: recording
      resources: resources
      commands: commands
      timestampWrites: writes
    )
  }
}
