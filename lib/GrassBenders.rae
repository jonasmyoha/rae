# GrassBenders — what bends a grass field's blades near it: characters and vehicles walking
# or driving through the grass push it aside. A short list of circles (x, y, radius in m,
# strength 0 to 1) an app hands GrassCompute every frame (grassSetBenders); the grass
# uniform carries them to the render pass's vertex stage (grass_render.wgsl grassBend).
import Math
import GrassConfig
open gpu/GpuArgs
open GrassCompute

# How many circles can bend the blades at once (grass_render.wgsl GW.bend)
const grassBenderCount: Int = 8

# A field's candidate grid: `side` x `side` blades a frame round its middle (Rae's default 256),
# so a dense near field can have more than a far one. Its spacing is the field's extent over
# `side`. Call before the field's first frame: the instance buffer is sized by it.
func grassSetBladeSide(grass: mod GrassCompute, side: view Int) {
  let clamped: Int = Math.clamp(val: side, low: 16, high: 1024)
  grass.bladeCount = clamped * clamped
  resetGrassPipeline(grass: grass)
}

# What bends a field's blades near it this frame: x, y, radius (m), strength (0 to 1) each, up
# to grassBenderCount. Call before grassGenerate.
func grassSetBenders(grass: mod GrassCompute, benders: view List(Float)) {
  grass.benders = grassBendersKept(benders: benders)
}

# The first grassBenderCount circles of `benders` (four values each); more are left out
func grassBendersKept(benders: view List(Float)) ret List(Float) {
  var kept: List(Float) = List.create(Float, cap: grassBenderCount * 4)
  loop var index: Int = 0, index < Math.min(a: benders.length, b: grassBenderCount * 4), ++index {
    kept.add(value: benders.copyAtFallback(index: index, fallback: 0.0))
  }
  ret kept
}

# The grass uniform's tail: a ring's inner edge and its fade band, the shimmer and the
# painted warmth from `settings` (l), the painted root lift (m), then the circles,
# grassBenderCount vec4s, none as zeros (bend)
func pushGrassRingAndBenders(
  writer: mod ArgWriter
  settings: view GrassConfig.GrassViewSettings
  benders: view List(Float)
) {
  pushVec4F(
    writer: writer
    x: settings.innerRadius
    y: settings.innerFade
    z: settings.shimmer
    w: settings.paintWarmth
  )
  # m: the painted grass's root lift and its gradient
  pushVec4F(
    writer: writer
    x: settings.paintRootLift
    y: settings.paintGradient
    z: 0.0
    w: 0.0
  )
  loop var bender: Int = 0, bender < grassBenderCount, ++bender {
    pushVec4F(
      writer: writer
      x: benders.copyAtFallback(index: bender * 4, fallback: 0.0)
      y: benders.copyAtFallback(index: bender * 4 + 1, fallback: 0.0)
      z: benders.copyAtFallback(index: bender * 4 + 2, fallback: 0.0)
      w: benders.copyAtFallback(index: bender * 4 + 3, fallback: 0.0)
    )
  }
}
