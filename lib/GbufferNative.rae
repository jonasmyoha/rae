# GbufferNative — the C-ABI accessor layer of Gbuffer (#918 split for the
# 1000-line cap): every `native*` extern and the thin `gb*` wrappers that hand
# the Rae geometry pass what is still C-owned (the WGSL sources, the
# frame-derived uniform math, the offscreen size; the skin buffers + palette
# are the SkinStore's since #921, the metaball prep the SdfPassCache's since
# #922) — since #906 the targets, frame uniform, draws
# buffer and
# the frame's encoder / pass are the GbufferCache's manager objects. Nothing
# here is app-facing; the frame API (begin / draw / end / present) stays in Gbuffer.
import Math
import String
open SkyHosek
open Vec3
open Scene3d
open Sky
open Math3d
open GbufferRecord
open ecs/Entity  # #793: World3d render path reads entities/components
open ecs/ComponentTable
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds
open Gbuffer

func nativeGbPrepare() unsafe extern("rae_gb_prepare") ret Int

func gbPrepare() ret Int {
  unsafe {
    ret nativeGbPrepare()
  }
}

# The presentable target's format (the composite / inspector pipelines write it).
func nativeG2dFormat() unsafe extern("rae_g2d_format") ret Int

# The configured surface's physical size (C surface glue). The scene targets
# are this at the scene scale, which lib/RenderResolution decides.
func nativeGbSurfaceWidth() unsafe extern("rae_g2d_surface_width") ret Int

func gbSurfaceWidth() ret Int {
  unsafe {
    ret nativeGbSurfaceWidth()
  }
}

func nativeGbSurfaceHeight() unsafe extern("rae_g2d_surface_height") ret Int

func gbSurfaceHeight() ret Int {
  unsafe {
    ret nativeGbSurfaceHeight()
  }
}

# ----- render pipelines + WGSL shader modules (#503) -------------------------
# The shaders stay as source: C exposes the WGSL text + entry-point names, Rae
# builds the modules and pipelines over the bindings.

# One G-buffer render pipeline spec: the shared 3 colour targets + reverse-Z
# depth (write, Greater), back-face culled, over the caller's vertex layout.
# The static and terrain pipelines use the 32-byte layout; skin adds the joint
# indices/weights (80 bytes).
func gbufferPipelineSpec(
  stride: copy Int
  attributes: own List(VertexAttributeSpec)
) pub ret RenderPipelineSpec {
  var colorFormats: List(Int32) = List.create(Int32, cap: 3)
  colorFormats.add(value: WGPUTextureFormat_RGB10A2Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  ret RenderPipelineSpec {
    vertexStride: stride
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: false
    premultiplied: false
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: true
    depthCompare: WGPUCompareFunction_Greater
    cullMode: WGPUCullMode_Back
    sampleCount: 1
  }
}

# The metaball cluster shader (#392): its WGSL stays C source like every
# other shader; the pipeline, uniforms, buffers and binds are the Rae
# SdfPassCache's (GbufferSdf.rae, #922).
