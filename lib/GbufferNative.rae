# GbufferNative — the C-ABI accessor layer of Gbuffer (#918 split for the
# 1000-line cap): every `native*` extern and the thin `gb*` wrappers that hand
# the Rae geometry pass its C-owned handles (frame uniform, targets, draws
# buffer, mesh/skin buffers, SDF pipeline, encoder/frame state). Nothing here
# is app-facing; the frame API (begin / draw / end / present) stays in Gbuffer.
import Math
import String
open SkyHosek
open Vec3
open Scene3d
open Sky
open Math3d
open GbufferRecord
open ecs/Entity  # #793: World3d render path reads entities/components
open ecs/ComponentTable
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds
open Gbuffer

func nativeGbPrepare() unsafe extern("rae_gb_prepare") ret Int

func gbPrepare() ret Int {
  unsafe {
    ret nativeGbPrepare()
  }
}

func nativeGbFrameUniform(
  viewProj: view Mat4
  clearR: Float
  clearG: Float
  clearB: Float
) unsafe extern("rae_gb_frame_uniform") ret Int

func gbFrameUniform(
  viewProj: view Mat4
  clearR: copy Float
  clearG: copy Float
  clearB: copy Float
) ret Int {
  unsafe {
    ret nativeGbFrameUniform(
      viewProj: viewProj
      clearR: clearR
      clearG: clearG
      clearB: clearB
    )
  }
}

