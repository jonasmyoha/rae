# GbufferNative — the C-ABI accessor layer of Gbuffer (#918 split for the
# 1000-line cap): every `native*` extern and the thin `gb*` wrappers that hand
# the Rae geometry pass what is still C-owned (the WGSL sources, the SDF
# prepare, the frame-derived uniform math, the offscreen size; the skin
# buffers + palette are the SkinStore's since #921) — since #906 the targets, frame uniform, draws
# buffer and
# the frame's encoder / pass are the GbufferCache's manager objects. Nothing
# here is app-facing; the frame API (begin / draw / end / present) stays in Gbuffer.
import Math
import String
open SkyHosek
open Vec3
open Scene3d
open Sky
open Math3d
open GbufferRecord
open ecs/Entity  # #793: World3d render path reads entities/components
open ecs/ComponentTable
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds
open Gbuffer

func nativeGbPrepare() unsafe extern("rae_gb_prepare") ret Int

func gbPrepare() ret Int {
  unsafe {
    ret nativeGbPrepare()
  }
}

# #906: the geometry frame's targets, frame uniform, draws buffer and
# encoder / pass are the GbufferCache's manager objects (GbufferResources).
# C keeps the frame-derived uniform MATH — rae_gb_frame_data writes the 36
# floats of the TAA-jittered frame uniform into a Rae buffer and remembers the
# jittered / previous view-projection for the still-C post passes — and
# BORROWS the four target views + size (gbCommitTargets / gbForgetTargets).
func nativeGbFrameData(
  viewProj: view Mat4
  clearR: Float
  clearG: Float
  clearB: Float
  w: Int
  h: Int
  out: Ptr
) unsafe extern("rae_gb_frame_data") ret Int

func gbFrameData(
  viewProj: view Mat4
  clearR: copy Float
  clearG: copy Float
  clearB: copy Float
  w: copy Int
  h: copy Int
  out: copy Ptr
) unsafe ret Int {
  unsafe {
    ret nativeGbFrameData(
      viewProj: viewProj
      clearR: clearR
      clearG: clearG
      clearB: clearB
      w: w
      h: h
      out: out
    )
  }
}

