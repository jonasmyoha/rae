# ----- render pipelines + WGSL shader modules (#503) -------------------------
# The shaders stay as source: C exposes the WGSL text + entry-point names, Rae
# builds the modules and pipelines over the bindings.
func gbWgsl() unsafe extern("rae_gb_wgsl") ret Buffer(Any)

func gbSkinWgsl() unsafe extern("rae_gb_skin_wgsl") ret Buffer(Any)

func nativeGbReadWgsl(path: String) unsafe extern("rae_ext_rae_sys_read_file") ret String

# One G-buffer render pipeline spec: the shared 3 colour targets + reverse-Z
# depth (write, Greater), back-face culled, over the caller's vertex layout.
# The static and terrain pipelines use the 32-byte layout; skin adds the joint
# indices/weights (80 bytes).
func gbufferPipelineSpec(
  stride: copy Int
  attributes: own List(VertexAttributeSpec)
) pub ret RenderPipelineSpec {
  let colorFormats: List(Int32) = List.create(Int32, cap: 3)
  colorFormats.add(value: WGPUTextureFormat_RGB10A2Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  colorFormats.add(value: WGPUTextureFormat_RGBA8Unorm)
  ret RenderPipelineSpec {
    vertexStride: stride
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: false
    premultiplied: false
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: true
    depthCompare: WGPUCompareFunction_Greater
    cullMode: WGPUCullMode_Back
  }
}

# Metaball cluster into the G-buffer (#392, ported to Rae #504): a fullscreen
# raymarch that writes packed G-buffer attributes + depth into the OPEN geometry
# pass, so a metaball surface is shaded by the same lighting as every triangle.
# C does the dense per-cluster prep (inverse-viewProj frame uniform, ball/colour
# uploads, params, bind) and returns the group index; Rae issues the draw into
# the pass and restores the static pipeline after, like drawSkinned does.
func gbSdfPrepare(
  packedBalls: Ptr
  count: Int
  packedColors: Ptr
  smoothing: Float
  camX: Float
  camY: Float
  camZ: Float
  metallic: Float
  roughness: Float
  emR: Float
  emG: Float
  emB: Float
) unsafe extern("rae_gb_sdf_prepare") ret Int

func gbSdfPipeline() unsafe extern("rae_gb_sdf_pipeline") ret Ptr

func gbSdfBind(gi: Int) unsafe extern("rae_gb_sdf_bind") ret Ptr

func nativeSdfShutdown() unsafe extern("rae_ext_Gbuffer_sdfShutdown")

func sdfShutdown() {
  unsafe {
    nativeSdfShutdown()
  }
}

func nativePyramidMips() unsafe extern("rae_ext_Gbuffer_pyramidMips") ret Int

func pyramidMips() ret Int {
