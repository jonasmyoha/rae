# Gpu2dCanvas — the 2D renderer's Rae-owned canvas over the WebGPU bindings:
# the box/primitive pass (#907), the image pass (#908) and, in the sibling
# modules, the text pass (Gpu2dCanvasText.rae, #909) and the frame lifecycle
# (Gpu2dCanvasFrame.rae, #910/#915), on ONE app-owned gpu/GpuResources
# manager. Since #915 the canvas also owns the viewport uniform (the
# design->physical transform C computes from the surface, uploaded per flush),
# the clip stack + per-run scissor and the rounded-clip uniforms; C keeps only
# surface glue (window, offscreen target, present tail, image decode, glyph
# rasterization). Everything the passes CREATE — pipelines, instance buffers,
# image textures + views + sampler, per-draw uniforms and bind groups — is a
# typed ID here, and the draws go into the frame pass the canvas opened with
# recordDrawInPass, the #874 grass pattern.
#
# Box pass: one pipeline (lib/gpu2d_box.wgsl) draws every rect / rounded rect /
# bordered box / gradient / line the frame queued, in contiguous same-clip
# runs (scissor + clip uniform per run). Instance buffers are per flush slot
# within a frame (a later flush must not overwrite what an earlier draw still
# reads) and persist across frames, like the C pool did.
#
# Image pass: images are decoded by C (stb_image, CPU RGBA) and uploaded here
# into manager textures; the 1-based image handle indexes `images`, the key
# registry maps a name to a handle (ImageRegistry.rae keeps the load / retry /
# cache policy over it). Each queued draw is one 64-byte uniform + one bind
# group [viewport, uniform, view, sampler], cached per draw slot by handle
# exactly as the C flush cached them; draws go after the boxes, before text.
#
# Owner: an app (or the deferred renderer for its UI overlay) holds ONE
# Gpu2dCanvas and hands it to Gpu2d.flush / Gpu2d.endFrame and the image API.
import String
import Math
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds

func nativeG2dBoxFormat() unsafe extern("rae_g2d_format") ret Int
# The C offscreen presentable target's view (recreated on surface configure /
# resize — re-adopted when the handle changes) and the design->physical
# transform (window size, design resolution + fit mode: platform state).
func g2dOffscreenView() unsafe extern("rae_g2d_off_view") ret Ptr
func nativeG2dXform(out: view Buffer(Float)) unsafe extern("rae_g2d_xform")
# The clip stack stays C (behind the stateless pushClipRect/popClipRect, see
# #913): C fills a run's 8-float clip uniform and sets the scissor on the pass
# the canvas hands it.
func nativeG2dBoxReadFile(path: String) unsafe extern("rae_ext_rae_sys_read_file") ret String
# CPU image decode stays C (stb_image): a malloc'd RGBA8 buffer + its size,
# freed with g2dDecodeFree once uploaded. A failed decode logs once in C and
# returns null.
func g2dDecodeImage(path: String) unsafe extern("rae_g2d_decode_image") ret Ptr
func nativeG2dDecodedWidth() unsafe extern("rae_g2d_decoded_width") ret Int
func nativeG2dDecodedHeight() unsafe extern("rae_g2d_decoded_height") ret Int
func g2dDecodeFree(rgba: Ptr) unsafe extern("rae_g2d_decode_free")
# The CPU MSDF atlas pixels (SdfText.loadAtlas), read for the atlas upload.
func nativeG2dTextAtlasMax() unsafe extern("rae_g2d_text_atlas_max") ret Int
func sdfAtlasPixels(handle: Int) unsafe extern("rae_sdf_atlas_pixels") ret Ptr
func nativeSdfAtlasWidth(handle: Int) unsafe extern("rae_sdf_atlas_width") ret Int
func nativeSdfAtlasHeight(handle: Int) unsafe extern("rae_sdf_atlas_height") ret Int

func g2dDecodedWidth() ret Int {
  unsafe { ret nativeG2dDecodedWidth() }
}
func g2dDecodedHeight() ret Int {
  unsafe { ret nativeG2dDecodedHeight() }
}
func g2dTextAtlasMax() ret Int {
  unsafe { ret nativeG2dTextAtlasMax() }
}
func sdfAtlasWidth(handle: copy Int) ret Int {
  unsafe { ret nativeSdfAtlasWidth(handle: handle) }
}
func sdfAtlasHeight(handle: copy Int) ret Int {
  unsafe { ret nativeSdfAtlasHeight(handle: handle) }
}

# One MSDF atlas on the GPU (uploaded lazily from the C pixels) and its
# per-flush instance buffer pool (slot = flush index in the frame).
type Gpu2dTextAtlas {
  texture: TextureId
  textureView: TextureViewId
  buffers: List(BufferId)
  capacities: List(Int)
  flushIndex: Int
  glyphs: List(Float)               # the queued glyphs, textGlyphFloats each (#915: was the C batch)
  glyphClips: List(Int)             # each glyph's clip index at queue time
}

func emptyTextAtlas() ret Gpu2dTextAtlas {
  ret Gpu2dTextAtlas { texture: noTextureId(), textureView: noTextureViewId(), buffers: List.create(BufferId, cap: 4), capacities: List.create(Int, cap: 4), flushIndex: 0, glyphs: List.create(Float, cap: 64 * textGlyphFloats), glyphClips: List.create(Int, cap: 64) }
}

# One text glyph = 5 x vec4: rect, uv, colour, params(pxRange, outline width,
# softness), outline colour.
const textGlyphFloats: Int = 20

# One uploaded image: its manager texture + default view and the size the
# aspect-preserving scaled draw needs.
type Gpu2dImage {
  texture: TextureId
  textureView: TextureViewId
  width: Int
  height: Int
}

type Gpu2dCanvas {
  idIssuer: IdIssuer
  gpuResources: opt GpuResources
  # --- frame (#910/#915) ---
  recording: opt Recording          # the open frame's manager recording (none between frames)
  framePass: Ptr                    # the open frame's render pass into the offscreen target
  inFlight: List(SubmissionId)      # submitted frames not yet retired
  offscreen: ExternalId             # the C offscreen presentable view, adopted (re-adopted when it changes)
  offscreenHandle: Ptr
  viewport: BufferId                # the 2 x vec4 design->physical transform every 2D pipeline binds at @0
  xform: List(Float)                # its 8 floats (physW, physH, scaleX, scaleY, offX, offY, 0, 0)
  clipUniforms: List(BufferId)      # per-run 32-byte clip uniforms, slot = run index in the frame
  clipCursor: Int
  clipScratch: List(Float)          # one clip uniform's 8 floats, staged for the upload
  # --- clip stack (#915: was C's g_g2d_clips) — design units; [0] = the full sentinel ---
  clipX: List(Float)
  clipY: List(Float)
  clipW: List(Float)
  clipH: List(Float)
  clipRadius: List(Float)
  clipFull: List(Bool)
  clipStack: List(Int)
  currentClip: Int
  # --- box pass ---
  pipeMade: Bool
  pipeline: RenderPipelineId
  prims: List(Float)                # the queued primitives, boxPrimFloats each (#913: was the C batch)
  primClips: List(Int)              # each primitive's clip index at queue time
  frameBuffers: List(BufferId)      # per-flush instance buffers, slot = flush index in the frame
  frameCapacities: List(Int)        # each slot's capacity in primitives
  flushIndex: Int
  frameBinds: List(BindGroupId)     # this frame's per-run bind groups
  # --- image pass ---
  imagePipeMade: Bool
  imagePipeline: RenderPipelineId
  imageSampler: SamplerId
  images: List(Gpu2dImage)          # handle = index + 1
  imageKeys: List(String)           # name -> handle registry
  imageKeyHandles: List(Int)
  imageCommands: List(Float)        # queued draws, 16 floats each = the uImg uniform
  imageCommandHandles: List(Int)
  imageCommandClips: List(Int)
  imageUniforms: List(BufferId)     # per-draw-slot 64-byte uniforms, persistent
  imageBinds: List(BindGroupId)     # per-draw-slot bind groups, cached by handle
  imageBindHandles: List(Int)
  imageDrawCursor: Int              # draw slots used so far this frame
  imageScratch: List(Float)         # one command's 16 floats, staged for the upload
  # --- text pass ---
  textPipeMade: Bool
  textPipeline: RenderPipelineId
  textAtlases: List(Gpu2dTextAtlas) # index = atlas handle - 1, sized to the C atlas max
}

# Slot budget: one bind group + one clip external per same-clip run per flush
# for boxes (the UI render system flushes once per entity), one uniform + bind
# per image draw, two slots per image. Retired per frame and reused.
const canvasManagerCapacity: Int = 1024
const imageUniformFloats: Int = 16
# One box primitive = 6 x vec4 (std430): rect, radius, fill, border, params, grad.
const boxPrimFloats: Int = 24

func createGpu2dCanvas() ret Gpu2dCanvas {
  unsafe {
    ret Gpu2dCanvas {
      idIssuer: IdIssuer.create(), gpuResources: none,
      recording: none, framePass: webgpuNull(), inFlight: List.create(SubmissionId, cap: 4),
      offscreen: noExternalId(), offscreenHandle: webgpuNull(),
      viewport: noBufferId(), xform: List.create(Float, cap: 8),
      clipUniforms: List.create(BufferId, cap: 64), clipCursor: 0, clipScratch: List.create(Float, cap: 8),
      clipX: List.create(Float, cap: 32), clipY: List.create(Float, cap: 32), clipW: List.create(Float, cap: 32), clipH: List.create(Float, cap: 32),
      clipRadius: List.create(Float, cap: 32), clipFull: List.create(Bool, cap: 32), clipStack: List.create(Int, cap: 32), currentClip: 0,
      pipeMade: false,
      pipeline: noRenderPipelineId(), prims: List.create(Float, cap: 64 * boxPrimFloats), primClips: List.create(Int, cap: 64),
      frameBuffers: List.create(BufferId, cap: 8), frameCapacities: List.create(Int, cap: 8), flushIndex: 0,
      frameBinds: List.create(BindGroupId, cap: 64),
      imagePipeMade: false, imagePipeline: noRenderPipelineId(), imageSampler: noSamplerId(),
      images: List.create(Gpu2dImage, cap: 32), imageKeys: List.create(String, cap: 32), imageKeyHandles: List.create(Int, cap: 32),
      imageCommands: List.create(Float, cap: 32 * imageUniformFloats), imageCommandHandles: List.create(Int, cap: 32), imageCommandClips: List.create(Int, cap: 32),
      imageUniforms: List.create(BufferId, cap: 32), imageBinds: List.create(BindGroupId, cap: 32), imageBindHandles: List.create(Int, cap: 32),
      imageDrawCursor: 0, imageScratch: List.create(Float, cap: imageUniformFloats),
      textPipeMade: false, textPipeline: noRenderPipelineId(), textAtlases: List.create(Gpu2dTextAtlas, cap: 8)
    }
  }
}

func ensureBoxResources(canvas: mod Gpu2dCanvas) {
  if let existing: view GpuResources => canvas.gpuResources { ret }
  canvas.gpuResources = GpuResources.create(issuer: canvas.idIssuer, capacity: canvasManagerCapacity)
}

# The box pipeline: a procedural quad (no vertex buffer), one colour target in
# the gpu2d presentable format, premultiplied alpha blending, no depth, no cull.
func boxPipelineSpec(format: copy Int32) ret RenderPipelineSpec {
  let colorFormats: List(Int32) = List.create(Int32, cap: 1)
  colorFormats.add(value: format)
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 1)
  ret RenderPipelineSpec {
    vertexStride: 0, attributes: own attributes, colorFormats: own colorFormats,
    alphaBlend: true, premultiplied: true, depthFormat: 0 as Int32, depthWrite: false,
    depthCompare: WGPUCompareFunction_Always, cullMode: WGPUCullMode_None
  }
}

func ensureBoxPipeline(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if canvas.pipeMade { ret }
  canvas.pipeMade = true
  # Read relative to the working directory like every lib/*.wgsl asset (the
  # example gates run from the repo root). An empty read must not reach wgpu.
  var source: String = ""
  unsafe { source = nativeG2dBoxReadFile(path: "lib/gpu2d_box.wgsl") }
  if source.length() is 0 {
    log("[gpu2d] lib/gpu2d_box.wgsl not readable from the working directory — run from the repo root; 2D boxes are skipped")
    ret
  }
  var format: Int = 0
  unsafe { format = nativeG2dBoxFormat() }
  if let pipeline: RenderPipelineId = createRenderPipeline(resources: resources, wgsl: source, vertexEntry: "vs", fragmentEntry: "fs", spec: boxPipelineSpec(format: format as Int32)) {
    canvas.pipeline = pipeline
  }
  ensureViewportUniform(canvas: canvas, resources: resources)
}

# The shared viewport uniform (2 x vec4: physW, physH, scaleX, scaleY / offX,
# offY, ..) every 2D pipeline binds at @binding(0); written once per flush from
# the platform transform (#915: was the C g_g2d_uniform).
func ensureViewportUniform(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if isValidBuffer(resources: resources, id: canvas.viewport) { ret }
  if let uniform: BufferId = createBuffer(resources: resources, size: 32, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) { canvas.viewport = uniform }
}

func refreshXform(canvas: mod Gpu2dCanvas) {
  canvas.xform.clear()
  loop var k: Int = 0, k < 8, ++k { canvas.xform.add(value: 0.0) }
  unsafe { nativeG2dXform(out: canvas.xform.data) }
}

func xformAt(canvas: view Gpu2dCanvas, index: copy Int) ret Float {
  if let value: Float = canvas.xform.copyAt(index: index) { ret value }
  ret 0.0
}

func uploadViewport(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  ensureViewportUniform(canvas: canvas, resources: resources)
  refreshXform(canvas: canvas)
  unsafe { let written: Bool = writeBufferFromPtr(resources: resources, id: canvas.viewport, offset: 0, data: canvas.xform.data, size: 32) }
}

# This flush's instance buffer: the slot for the flush index, grown (retired
# and re-created, doubling) when the batch outgrew it.
func boxFlushBuffer(canvas: mod Gpu2dCanvas, resources: mod GpuResources, prims: copy Int) ret BufferId {
  let slot: Int = canvas.flushIndex
  canvas.flushIndex = slot + 1
  loop canvas.frameBuffers.length <= slot {
    canvas.frameBuffers.add(value: noBufferId())
    canvas.frameCapacities.add(value: 0)
  }
  var capacity: Int = 0
  if let known: Int = canvas.frameCapacities.copyAt(index: slot) { capacity = known }
  var current: BufferId = noBufferId()
  if let known: BufferId = canvas.frameBuffers.copyAt(index: slot) { current = known }
  if isValidBuffer(resources: resources, id: current) and capacity >= prims { ret current }
  retireBuffer(resources: resources, id: current)
  var grown: Int = capacity
  if grown < 4 { grown = 4 }
  loop grown < prims { grown = grown * 2 }
  var made: BufferId = noBufferId()
  if let buffer: BufferId = createBuffer(resources: resources, size: grown * boxPrimFloats * 4, usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopyDst) {
    made = buffer
  }
  canvas.frameBuffers.set(index: slot, value: made)
  canvas.frameCapacities.set(index: slot, value: grown)
  ret made
}

# Clip stack (#144/#118) in DESIGN units. Index 0 is the "no clip" sentinel
# (full framebuffer). A push intersects with the parent so nested clips
# compose; the larger radius wins (the scissor bbox already enforces the
# parent's straight edges). Reset each frame.
func clipReset(canvas: mod Gpu2dCanvas) {
  canvas.clipX.clear()
  canvas.clipY.clear()
  canvas.clipW.clear()
  canvas.clipH.clear()
  canvas.clipRadius.clear()
  canvas.clipFull.clear()
  canvas.clipStack.clear()
  canvas.clipX.add(value: 0.0)
  canvas.clipY.add(value: 0.0)
  canvas.clipW.add(value: 0.0)
  canvas.clipH.add(value: 0.0)
  canvas.clipRadius.add(value: 0.0)
  canvas.clipFull.add(value: true)
  canvas.currentClip = 0
}

func clipFloatAt(list: view List(Float), index: copy Int) ret Float {
  if let value: Float = list.copyAt(index: index) { ret value }
  ret 0.0
}

func clipIsFull(canvas: view Gpu2dCanvas, clip: copy Int) ret Bool {
  if clip <= 0 or clip >= canvas.clipFull.length { ret true }
  if let full: Bool = canvas.clipFull.copyAt(index: clip) { ret full }
  ret true
}

func canvasPushClip(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float) {
  let parent: Int = canvas.currentClip
  var childX: Float = x
  var childY: Float = y
  var childW: Float = w
  var childH: Float = h
  var childRadius: Float = radius
  if not clipIsFull(canvas: canvas, clip: parent) {
    let parentX: Float = clipFloatAt(list: canvas.clipX, index: parent)
    let parentY: Float = clipFloatAt(list: canvas.clipY, index: parent)
    let parentW: Float = clipFloatAt(list: canvas.clipW, index: parent)
    let parentH: Float = clipFloatAt(list: canvas.clipH, index: parent)
    let parentRadius: Float = clipFloatAt(list: canvas.clipRadius, index: parent)
    let x0: Float = Math.max(a: parentX, b: x)
    let y0: Float = Math.max(a: parentY, b: y)
    let x1: Float = Math.min(a: parentX + parentW, b: x + w)
    let y1: Float = Math.min(a: parentY + parentH, b: y + h)
    childX = x0
    childY = y0
    childW = Math.max(a: 0.0, b: x1 - x0)
    childH = Math.max(a: 0.0, b: y1 - y0)
    childRadius = Math.max(a: radius, b: parentRadius)
  }
  canvas.clipX.add(value: childX)
  canvas.clipY.add(value: childY)
  canvas.clipW.add(value: childW)
  canvas.clipH.add(value: childH)
  canvas.clipRadius.add(value: childRadius)
  canvas.clipFull.add(value: false)
  canvas.clipStack.add(value: parent)
  canvas.currentClip = canvas.clipFull.length - 1
}

func canvasPopClip(canvas: mod Gpu2dCanvas) {
  if canvas.clipStack.length > 0 {
    if let parent: Int = canvas.clipStack.copyAt(index: canvas.clipStack.length - 1) { canvas.currentClip = parent }
    canvas.clipStack.removeLast()
  } else {
    canvas.currentClip = 0
  }
}

# Resolve a clip index to a framebuffer-pixel scissor (via the design->physical
# transform of this flush) and set it on the open pass, clamped to the target.
func g2dScissor(canvas: view Gpu2dCanvas, clip: copy Int) {
  let physW: Float = xformAt(canvas: canvas, index: 0)
  let physH: Float = xformAt(canvas: canvas, index: 1)
  let scaleX: Float = xformAt(canvas: canvas, index: 2)
  let scaleY: Float = xformAt(canvas: canvas, index: 3)
  let offX: Float = xformAt(canvas: canvas, index: 4)
  let offY: Float = xformAt(canvas: canvas, index: 5)
  var x0: Float = 0.0
  var y0: Float = 0.0
  var x1: Float = physW
  var y1: Float = physH
  if not clipIsFull(canvas: canvas, clip: clip) {
    let clipX: Float = clipFloatAt(list: canvas.clipX, index: clip)
    let clipY: Float = clipFloatAt(list: canvas.clipY, index: clip)
    let clipW: Float = clipFloatAt(list: canvas.clipW, index: clip)
    let clipH: Float = clipFloatAt(list: canvas.clipH, index: clip)
    x0 = clipX * scaleX + offX
    y0 = clipY * scaleY + offY
    x1 = (clipX + clipW) * scaleX + offX
    y1 = (clipY + clipH) * scaleY + offY
  }
  x0 = Math.max(a: 0.0, b: x0)
  y0 = Math.max(a: 0.0, b: y0)
  x1 = Math.min(a: physW, b: x1)
  y1 = Math.min(a: physH, b: y1)
  if x1 < x0 { x1 = x0 }
  if y1 < y0 { y1 = y0 }
  var ix: Int = (x0 + 0.5).toInt()
  var iy: Int = (y0 + 0.5).toInt()
  var iw: Int = (x1 - x0 + 0.5).toInt()
  var ih: Int = (y1 - y0 + 0.5).toInt()
  let pw: Int = (physW + 0.5).toInt()
  let ph: Int = (physH + 0.5).toInt()
  if ix > pw { ix = pw }
  if iy > ph { iy = ph }
  if ix + iw > pw { iw = pw - ix }
  if iy + ih > ph { ih = ph - iy }
  unsafe { setScissorInPass(pass: canvas.framePass, x: ix, y: iy, width: iw, height: ih) }
}

# This run's clip uniform (a persistent per-run-slot pool of 32-byte uniforms):
# [x,y,w,h] design units + [radius, enabled, 0, 0]. `enabled` only for a ROUNDED
# clip — a rectangular clip is the scissor alone, so its SDF stays off.
func clipUniformFor(canvas: mod Gpu2dCanvas, resources: mod GpuResources, clip: copy Int) ret BufferId {
  let slot: Int = canvas.clipCursor
  canvas.clipCursor = slot + 1
  loop canvas.clipUniforms.length <= slot { canvas.clipUniforms.add(value: noBufferId()) }
  var uniform: BufferId = noBufferId()
  if let known: BufferId = canvas.clipUniforms.copyAt(index: slot) { uniform = known }
  if not isValidBuffer(resources: resources, id: uniform) {
    if let made: BufferId = createBuffer(resources: resources, size: 32, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) {
      uniform = made
      canvas.clipUniforms.set(index: slot, value: made)
    }
  }
  canvas.clipScratch.clear()
  let rounded: Bool = not clipIsFull(canvas: canvas, clip: clip) and clipFloatAt(list: canvas.clipRadius, index: clip) > 0.0
  if rounded {
    canvas.clipScratch.add(value: clipFloatAt(list: canvas.clipX, index: clip))
    canvas.clipScratch.add(value: clipFloatAt(list: canvas.clipY, index: clip))
    canvas.clipScratch.add(value: clipFloatAt(list: canvas.clipW, index: clip))
    canvas.clipScratch.add(value: clipFloatAt(list: canvas.clipH, index: clip))
    canvas.clipScratch.add(value: clipFloatAt(list: canvas.clipRadius, index: clip))
    canvas.clipScratch.add(value: 1.0)
    canvas.clipScratch.add(value: 0.0)
    canvas.clipScratch.add(value: 0.0)
  } else {
    loop var k: Int = 0, k < 8, ++k { canvas.clipScratch.add(value: 0.0) }
  }
  unsafe {
    let written: Bool = writeBufferFromPtr(resources: resources, id: uniform, offset: 0, data: canvas.clipScratch.data, size: 32)
  }
  ret uniform
}
# The frame is open once beginFrame opened its pass (endFrame closes it).
func canvasFrameActive(canvas: view Gpu2dCanvas) ret Bool {
  unsafe { ret canvas.framePass is not webgpuNull() }
}

# ----- box batch (#913: the CPU accumulation, was C's rae_g2d_push) ----------

# 0xAARRGGBB -> one premultiplied RGBA channel in 0..1 (the box shader blends
# premultiplied). `shift` selects the byte: 65536 = R, 256 = G, 1 = B.
func premultipliedChannel(color: view Int, shift: view Int) ret Float {
  let alpha: Float = ((color / 16777216) % 256).toFloat() / 255.0
  ret ((color / shift) % 256).toFloat() / 255.0 * alpha
}

func pushPremultiplied(canvas: mod Gpu2dCanvas, color: copy Int) {
  canvas.prims.add(value: premultipliedChannel(color: color, shift: 65536))
  canvas.prims.add(value: premultipliedChannel(color: color, shift: 256))
  canvas.prims.add(value: premultipliedChannel(color: color, shift: 1))
  canvas.prims.add(value: ((color / 16777216) % 256).toFloat() / 255.0)
}

# Queue one primitive: rect, four corner radii (top-left, top-right,
# bottom-right, bottom-left), fill, border, params (border width, rotation in
# radians, gradient flag, gradient angle) and the gradient end colour — the
# same 24-float record the C batch packed. Tagged with the clip active now.
func pushBox(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radiusTopLeft: copy Float, radiusTopRight: copy Float, radiusBottomRight: copy Float, radiusBottomLeft: copy Float, fill: copy Int, border: copy Int, borderWidth: copy Float, angle: copy Float, gradient: copy Bool, gradientAngle: copy Float, gradientTo: copy Int) {
  canvas.prims.add(value: x)
  canvas.prims.add(value: y)
  canvas.prims.add(value: w)
  canvas.prims.add(value: h)
  canvas.prims.add(value: radiusTopLeft)
  canvas.prims.add(value: radiusTopRight)
  canvas.prims.add(value: radiusBottomRight)
  canvas.prims.add(value: radiusBottomLeft)
  pushPremultiplied(canvas: canvas, color: fill)
  pushPremultiplied(canvas: canvas, color: border)
  canvas.prims.add(value: borderWidth)
  canvas.prims.add(value: angle)
  var gradientFlag: Float = 0.0
  if gradient { gradientFlag = 1.0 }
  canvas.prims.add(value: gradientFlag)
  canvas.prims.add(value: gradientAngle)
  pushPremultiplied(canvas: canvas, color: gradientTo)
  canvas.primClips.add(value: canvas.currentClip)
}

func canvasDrawRect(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, color: copy Int) {
  pushBox(canvas: canvas, x: x, y: y, w: w, h: h, radiusTopLeft: 0.0, radiusTopRight: 0.0, radiusBottomRight: 0.0, radiusBottomLeft: 0.0, fill: color, border: 0, borderWidth: 0.0, angle: 0.0, gradient: false, gradientAngle: 0.0, gradientTo: color)
}

func canvasDrawRoundedRect(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, color: copy Int) {
  pushBox(canvas: canvas, x: x, y: y, w: w, h: h, radiusTopLeft: radius, radiusTopRight: radius, radiusBottomRight: radius, radiusBottomLeft: radius, fill: color, border: 0, borderWidth: 0.0, angle: 0.0, gradient: false, gradientAngle: 0.0, gradientTo: color)
}

func canvasDrawBox(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, fill: copy Int, borderWidth: copy Float, border: copy Int) {
  pushBox(canvas: canvas, x: x, y: y, w: w, h: h, radiusTopLeft: radius, radiusTopRight: radius, radiusBottomRight: radius, radiusBottomLeft: radius, fill: fill, border: border, borderWidth: borderWidth, angle: 0.0, gradient: false, gradientAngle: 0.0, gradientTo: fill)
}

# Gradient: fill = `from`, grad = `to`, the angle in radians (0 = left-to-right,
# 90 degrees = top-to-bottom), no border.
func canvasDrawGradientRect(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, from: copy Int, to: copy Int, angleDeg: copy Float) {
  pushBox(canvas: canvas, x: x, y: y, w: w, h: h, radiusTopLeft: radius, radiusTopRight: radius, radiusBottomRight: radius, radiusBottomLeft: radius, fill: from, border: 0, borderWidth: 0.0, angle: 0.0, gradient: true, gradientAngle: angleDeg * 0.017453292519943295, gradientTo: to)
}

# A line from (x0,y0) to (x1,y1), `thickness` wide, with rounded caps — a
# rotated capsule (a rounded rect of length x thickness, radius thickness/2).
func canvasDrawLine(canvas: mod Gpu2dCanvas, x0: copy Float, y0: copy Float, x1: copy Float, y1: copy Float, thickness: copy Float, color: copy Int) {
  let dx: Float = x1 - x0
  let dy: Float = y1 - y0
  let length: Float = Math.sqrt(x: dx * dx + dy * dy)
  if length < 0.000001 or thickness <= 0.0 { ret }
  let angle: Float = Math.atan2(y: dy, x: dx)
  let centerX: Float = (x0 + x1) * 0.5
  let centerY: Float = (y0 + y1) * 0.5
  var radius: Float = thickness * 0.5
  if radius > length * 0.5 { radius = length * 0.5 }
  pushBox(canvas: canvas, x: centerX - length * 0.5, y: centerY - thickness * 0.5, w: length, h: thickness, radiusTopLeft: radius, radiusTopRight: radius, radiusBottomRight: radius, radiusBottomLeft: radius, fill: color, border: 0, borderWidth: 0.0, angle: angle, gradient: false, gradientAngle: 0.0, gradientTo: color)
}

func canvasBoxCount(canvas: view Gpu2dCanvas) ret Int {
  ret canvas.primClips.length
}

func clearBoxBatch(canvas: mod Gpu2dCanvas) {
  canvas.prims.clear()
  canvas.primClips.clear()
}

# Draw the queued primitives into the active frame pass and reset the batch.
# Contiguous same-clip runs: each sets the scissor (#144, the axis-aligned
# bbox cull) and binds a per-run clip uniform (#118, the rounded-corner SDF in
# the fragment shader). instance_index includes firstInstance, so the storage
# buffer still indexes the right primitive.
func boxClipAt(canvas: view Gpu2dCanvas, i: copy Int) ret Int {
  if let clip: Int = canvas.primClips.copyAt(index: i) { ret clip }
  ret 0
}

func boxFlushWith(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  let count: Int = canvasBoxCount(canvas: canvas)
  if count <= 0 { ret }
  # No open frame pass: keep the batch (the frame end clears it), like C did.
  if not canvasFrameActive(canvas: canvas) { ret }
  ensureBoxPipeline(canvas: canvas, resources: resources)
  if not isValidRenderPipeline(resources: resources, id: canvas.pipeline) {
    clearBoxBatch(canvas: canvas)
    ret
  }
  let instances: BufferId = boxFlushBuffer(canvas: canvas, resources: resources, prims: count)
  let strideBytes: Int = boxPrimFloats * 4
  unsafe {
    if not writeBufferFromPtr(resources: resources, id: instances, offset: 0, data: canvas.prims.data, size: count * strideBytes) {
      clearBoxBatch(canvas: canvas)
      ret
    }
  }
  var runStart: Int = 0
  loop runStart < count {
    let clip: Int = boxClipAt(canvas: canvas, i: runStart)
    var runEnd: Int = runStart + 1
    loop runEnd < count and boxClipAt(canvas: canvas, i: runEnd) is clip { runEnd = runEnd + 1 }
    let entries: List(ResourceRef) = List.create(ResourceRef, cap: 3)
    entries.add(value: bufferRef(id: canvas.viewport))
    entries.add(value: bufferRef(id: instances))
    entries.add(value: bufferRef(id: clipUniformFor(canvas: canvas, resources: resources, clip: clip)))
    if let bind: BindGroupId = createRenderBindGroup(resources: resources, pipeline: canvas.pipeline, entries: entries) {
      canvas.frameBinds.add(value: bind)
      g2dScissor(canvas: canvas, clip: clip)
      unsafe {
        let drawn: Bool = recordDrawInPass(resources: resources, pass: canvas.framePass, pipeline: canvas.pipeline, bindGroup: bind, vertexCount: 6, instanceCount: runEnd - runStart, firstVertex: 0, firstInstance: runStart)
      }
    }
    runStart = runEnd
  }
  clearBoxBatch(canvas: canvas)
}

# ----- image pass (#908) --------------------------------------------------

func ensureImagePipeline(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if canvas.imagePipeMade { ret }
  canvas.imagePipeMade = true
  var source: String = ""
  unsafe { source = nativeG2dBoxReadFile(path: "lib/gpu2d_image.wgsl") }
  if source.length() is 0 {
    log("[gpu2d] lib/gpu2d_image.wgsl not readable from the working directory — run from the repo root; 2D images are skipped")
    ret
  }
  var format: Int = 0
  unsafe { format = nativeG2dBoxFormat() }
  if let pipeline: RenderPipelineId = createRenderPipeline(resources: resources, wgsl: source, vertexEntry: "vs", fragmentEntry: "fs", spec: boxPipelineSpec(format: format as Int32)) {
    canvas.imagePipeline = pipeline
  }
  # Linear, clamp-to-edge (the C image path shared the text sampler's settings).
  if let sampler: SamplerId = createSampler(resources: resources) { canvas.imageSampler = sampler }
  ensureViewportUniform(canvas: canvas, resources: resources)
}

# Registers an uploaded RGBA8 texture (w x h) as the next 1-based handle.
func registerImageTexture(canvas: mod Gpu2dCanvas, resources: mod GpuResources, texture: view TextureId, width: copy Int, height: copy Int) ret Int {
  if let textureView: TextureViewId = createTextureView(resources: resources, texture: texture) {
    canvas.images.add(value: { texture: texture, textureView: textureView, width: width, height: height })
    ret canvas.images.length
  }
  retireTexture(resources: resources, id: texture)
  ret 0
}

# Decode an image file (C, stb_image) and upload it as an RGBA8 texture.
# Returns the 1-based handle, 0 on failure (the caller renders its placeholder).
func canvasLoadImage(canvas: mod Gpu2dCanvas, path: copy String) ret Int {
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources => canvas.gpuResources {
    unsafe {
      let rgba: Ptr = g2dDecodeImage(path: path)
      if rgba is webgpuNull() { ret 0 }
      let width: Int = g2dDecodedWidth()
      let height: Int = g2dDecodedHeight()
      if let texture: TextureId = createTexture(resources: resources, width: width, height: height, format: WGPUTextureFormat_RGBA8Unorm, usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst) {
        if writeTextureFromPtr(resources: resources, texture: texture, data: rgba, bytesPerRow: width * 4, rows: height) {
          handle = registerImageTexture(canvas: canvas, resources: resources, texture: texture, width: width, height: height)
        } else {
          retireTexture(resources: resources, id: texture)
        }
      }
      g2dDecodeFree(rgba: rgba)
    }
  }
  ret handle
}

# Register an image from RGBA pixels generated in Rae (#539 procedural
# textures): each Int is one packed pixel r | g<<8 | b<<16 | a<<24 (byte order
# R,G,B,A, matching RGBA8Unorm). Returns a 1-based handle, 0 on failure.
func canvasRegisterImageRgba(canvas: mod Gpu2dCanvas, pixels: view Buffer(Int), width: copy Int, height: copy Int) ret Int {
  if width <= 0 or height <= 0 { ret 0 }
  ensureBoxResources(canvas: canvas)
  var handle: Int = 0
  if let resources: mod GpuResources => canvas.gpuResources {
    let count: Int = width * height
    let bytes: List(UInt8) = List.create(UInt8, cap: count * 4)
    unsafe {
      loop var i: Int = 0, i < count, ++i {
        let packed: Int = rae_ext_rae_buf_get(buf: pixels, index: i)
        bytes.add(value: (packed % 256) as UInt8)
        bytes.add(value: ((packed / 256) % 256) as UInt8)
        bytes.add(value: ((packed / 65536) % 256) as UInt8)
        bytes.add(value: ((packed / 16777216) % 256) as UInt8)
      }
    }
    if let texture: TextureId = createTexture(resources: resources, width: width, height: height, format: WGPUTextureFormat_RGBA8Unorm, usage: WGPUTextureUsage_TextureBinding + WGPUTextureUsage_CopyDst) {
      if writeTexture(resources: resources, texture: texture, bytes: bytes, bytesPerRow: width * 4) {
        handle = registerImageTexture(canvas: canvas, resources: resources, texture: texture, width: width, height: height)
      } else {
        retireTexture(resources: resources, id: texture)
      }
    }
  }
  ret handle
}

# Name -> handle registry. Re-registering a key updates it.
func canvasRegisterImageKey(canvas: mod Gpu2dCanvas, key: copy String, handle: copy Int) {
  if handle <= 0 { ret }
  loop var i: Int = 0, i < canvas.imageKeys.length, ++i {
    if let existing: String = canvas.imageKeys.copyAt(index: i) {
      if existing is key {
        canvas.imageKeyHandles.set(index: i, value: handle)
        ret
      }
    }
  }
  canvas.imageKeys.add(value: key)
  canvas.imageKeyHandles.add(value: handle)
}

func canvasImageHandleForKey(canvas: view Gpu2dCanvas, key: view String) ret Int {
  loop var i: Int = 0, i < canvas.imageKeys.length, ++i {
    if let existing: String = canvas.imageKeys.copyAt(index: i) {
      if existing is key {
        if let handle: Int = canvas.imageKeyHandles.copyAt(index: i) { ret handle }
      }
    }
  }
  ret 0
}

# Decode + upload `path` and register it under `key` (handle, 0 on failure).
func canvasLoadImageKey(canvas: mod Gpu2dCanvas, key: copy String, path: copy String) ret Int {
  let handle: Int = canvasLoadImage(canvas: canvas, path: path)
  canvasRegisterImageKey(canvas: canvas, key: key, handle: handle)
  ret handle
}

# True if `key` resolves to a loaded image (so a renderer can fall back to a
# placeholder / mat: glyph when it doesn't).
func canvasHasImageKey(canvas: view Gpu2dCanvas, key: view String) ret Bool {
  ret canvasImageHandleForKey(canvas: canvas, key: key) > 0
}

func canvasImageCount(canvas: view Gpu2dCanvas) ret Int {
  ret canvas.images.length
}

func tintChannel(color: view Int, shift: view Int) ret Float {
  ret ((color / shift) % 256).toFloat() / 255.0
}

# Queue one image draw for this frame: rect, straight tint (the shader
# premultiplies), radius, uv window, and the clip active now.
func queueImage(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, handle: copy Int, tint: copy Int, u0: copy Float, v0: copy Float, u1: copy Float, v1: copy Float) {
  if handle < 1 or handle > canvas.images.length { ret }
  canvas.imageCommands.add(value: x)
  canvas.imageCommands.add(value: y)
  canvas.imageCommands.add(value: w)
  canvas.imageCommands.add(value: h)
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 65536))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 256))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 1))
  canvas.imageCommands.add(value: tintChannel(color: tint, shift: 16777216))
  canvas.imageCommands.add(value: radius)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: 0.0)
  canvas.imageCommands.add(value: u0)
  canvas.imageCommands.add(value: v0)
  canvas.imageCommands.add(value: u1 - u0)
  canvas.imageCommands.add(value: v1 - v0)
  canvas.imageCommandHandles.add(value: handle)
  canvas.imageCommandClips.add(value: canvas.currentClip)
}

# Queue an image draw (handle from canvasLoadImage). tint is 0xAARRGGBB applied
# multiplicatively (0xFFFFFFFF for the unmodified image); radius rounds the
# corners (design units).
func canvasDrawImage(canvas: mod Gpu2dCanvas, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, handle: copy Int, tint: copy Int) {
  queueImage(canvas: canvas, x: x, y: y, w: w, h: h, radius: radius, handle: handle, tint: tint, u0: 0.0, v0: 0.0, u1: 1.0, v1: 1.0)
}

# Draw a registered image by key (no-op if the key isn't registered).
func canvasDrawImageKey(canvas: mod Gpu2dCanvas, key: view String, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, tint: copy Int) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle > 0 { canvasDrawImage(canvas: canvas, x: x, y: y, w: w, h: h, radius: radius, handle: handle, tint: tint) }
}

# Draw by key preserving the image's aspect: scaleMode 0 = fit (letterbox
# inside the rect), 1 = fill (center-crop the source), anything else = stretch.
func canvasDrawImageKeyScaled(canvas: mod Gpu2dCanvas, key: view String, x: copy Float, y: copy Float, w: copy Float, h: copy Float, radius: copy Float, tint: copy Int, scaleMode: copy Int) {
  let handle: Int = canvasImageHandleForKey(canvas: canvas, key: key)
  if handle <= 0 or handle > canvas.images.length or w <= 0.0 or h <= 0.0 { ret }
  var imageWidth: Float = 0.0
  var imageHeight: Float = 0.0
  if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
    imageWidth = image.width.toFloat()
    imageHeight = image.height.toFloat()
  }
  if imageWidth <= 0.0 or imageHeight <= 0.0 {
    canvasDrawImage(canvas: canvas, x: x, y: y, w: w, h: h, radius: radius, handle: handle, tint: tint)
    ret
  }
  let imageAspect: Float = imageWidth / imageHeight
  let targetAspect: Float = w / h
  var drawX: Float = x
  var drawY: Float = y
  var drawW: Float = w
  var drawH: Float = h
  var u0: Float = 0.0
  var v0: Float = 0.0
  var u1: Float = 1.0
  var v1: Float = 1.0
  if scaleMode is 0 {
    if imageAspect > targetAspect {
      drawH = w / imageAspect
      drawY = y + (h - drawH) * 0.5
    } else {
      drawW = h * imageAspect
      drawX = x + (w - drawW) * 0.5
    }
  } else if scaleMode is 1 {
    if imageAspect > targetAspect {
      let visibleW: Float = targetAspect / imageAspect
      u0 = (1.0 - visibleW) * 0.5
      u1 = u0 + visibleW
    } else if imageAspect < targetAspect {
      let visibleH: Float = imageAspect / targetAspect
      v0 = (1.0 - visibleH) * 0.5
      v1 = v0 + visibleH
    }
  }
  queueImage(canvas: canvas, x: drawX, y: drawY, w: drawW, h: drawH, radius: radius, handle: handle, tint: tint, u0: u0, v0: v0, u1: u1, v1: v1)
}

# This draw slot's 64-byte uniform (persistent pool, grown on demand).
func imageUniformAt(canvas: mod Gpu2dCanvas, resources: mod GpuResources, slot: copy Int) ret BufferId {
  loop canvas.imageUniforms.length <= slot {
    canvas.imageUniforms.add(value: noBufferId())
    canvas.imageBinds.add(value: noBindGroupId())
    canvas.imageBindHandles.add(value: 0)
  }
  var current: BufferId = noBufferId()
  if let known: BufferId = canvas.imageUniforms.copyAt(index: slot) { current = known }
  if isValidBuffer(resources: resources, id: current) { ret current }
  if let buffer: BufferId = createBuffer(resources: resources, size: imageUniformFloats * 4, usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst) {
    canvas.imageUniforms.set(index: slot, value: buffer)
    ret buffer
  }
  ret noBufferId()
}

# One draw per queued image into the active frame pass, then clear the queue.
# The bind group for a draw slot is rebuilt only when the slot's image handle
# changed (or the pipeline was rebuilt), as the C flush cached it.
func clearImageQueue(canvas: mod Gpu2dCanvas) {
  canvas.imageCommands.clear()
  canvas.imageCommandHandles.clear()
  canvas.imageCommandClips.clear()
}

func imageFlushWith(canvas: mod Gpu2dCanvas, resources: mod GpuResources) {
  if not canvasFrameActive(canvas: canvas) { ret }
  ensureImagePipeline(canvas: canvas, resources: resources)
  if not isValidRenderPipeline(resources: resources, id: canvas.imagePipeline) {
    clearImageQueue(canvas: canvas)
    ret
  }
  let bytes: List(UInt8) = List.create(UInt8, cap: imageUniformFloats * 4)
  loop var i: Int = 0, i < canvas.imageCommandHandles.length, ++i {
    var handle: Int = 0
    if let known: Int = canvas.imageCommandHandles.copyAt(index: i) { handle = known }
    if handle >= 1 and handle <= canvas.images.length {
      imageDrawCommand(canvas: canvas, resources: resources, index: i, handle: handle)
    }
  }
  clearImageQueue(canvas: canvas)
}

func imageDrawCommand(canvas: mod Gpu2dCanvas, resources: mod GpuResources, index: copy Int, handle: copy Int) {
  let i: Int = index
  let slot: Int = canvas.imageDrawCursor
  canvas.imageDrawCursor = slot + 1
  let uniform: BufferId = imageUniformAt(canvas: canvas, resources: resources, slot: slot)
  canvas.imageScratch.clear()
  loop var k: Int = 0, k < imageUniformFloats, ++k {
    var value: Float = 0.0
    if let known: Float = canvas.imageCommands.copyAt(index: i * imageUniformFloats + k) { value = known }
    canvas.imageScratch.add(value: value)
  }
  unsafe {
    if not writeBufferFromPtr(resources: resources, id: uniform, offset: 0, data: canvas.imageScratch.data, size: imageUniformFloats * 4) { ret }
  }
  var cachedHandle: Int = 0
  if let known: Int = canvas.imageBindHandles.copyAt(index: slot) { cachedHandle = known }
  var bind: BindGroupId = noBindGroupId()
  if let known: BindGroupId = canvas.imageBinds.copyAt(index: slot) { bind = known }
  if cachedHandle is not handle or not bindGroupIsUsable(resources: resources, id: bind) {
    retireBindGroup(resources: resources, id: bind)
    bind = noBindGroupId()
    if let image: Gpu2dImage = canvas.images.copyAt(index: handle - 1) {
      let entries: List(ResourceRef) = List.create(ResourceRef, cap: 4)
      entries.add(value: bufferRef(id: canvas.viewport))
      entries.add(value: bufferRef(id: uniform))
      entries.add(value: textureViewRef(id: image.textureView))
      entries.add(value: samplerRef(id: canvas.imageSampler))
      if let made: BindGroupId = createRenderBindGroup(resources: resources, pipeline: canvas.imagePipeline, entries: entries) { bind = made }
    }
    canvas.imageBinds.set(index: slot, value: bind)
    canvas.imageBindHandles.set(index: slot, value: handle)
  }
  var clip: Int = 0
  if let known: Int = canvas.imageCommandClips.copyAt(index: i) { clip = known }
  g2dScissor(canvas: canvas, clip: clip)
  unsafe {
    let drawn: Bool = recordDrawInPass(resources: resources, pass: canvas.framePass, pipeline: canvas.imagePipeline, bindGroup: bind, vertexCount: 6, instanceCount: 1, firstVertex: 0, firstInstance: 0)
  }
}

func canvasShutdown(canvas: mod Gpu2dCanvas) {
  if let resources: mod GpuResources => canvas.gpuResources {
    drainSubmissions(inFlight: canvas.inFlight, resources: resources)
    releaseExternal(resources: resources, id: canvas.offscreen)
    retireBuffer(resources: resources, id: canvas.viewport)
    retireBindGroupIds(resources: resources, list: canvas.frameBinds)
    canvas.frameBinds.clear()
    retireBufferIds(resources: resources, list: canvas.clipUniforms)
    canvas.clipUniforms.clear()
    retireBufferIds(resources: resources, list: canvas.frameBuffers)
    canvas.frameBuffers.clear()
    canvas.frameCapacities.clear()
    retireRenderPipeline(resources: resources, id: canvas.pipeline)
    retireBindGroupIds(resources: resources, list: canvas.imageBinds)
    canvas.imageBinds.clear()
    canvas.imageBindHandles.clear()
    retireBufferIds(resources: resources, list: canvas.imageUniforms)
    canvas.imageUniforms.clear()
    loop var i: Int = 0, i < canvas.images.length, ++i {
      if let image: Gpu2dImage = canvas.images.copyAt(index: i) {
        retireTextureView(resources: resources, id: image.textureView)
        retireTexture(resources: resources, id: image.texture)
      }
    }
    canvas.images.clear()
    canvas.imageKeys.clear()
    canvas.imageKeyHandles.clear()
    clearImageQueue(canvas: canvas)
    retireSampler(resources: resources, id: canvas.imageSampler)
    retireRenderPipeline(resources: resources, id: canvas.imagePipeline)
    loop var ai: Int = 0, ai < canvas.textAtlases.length, ++ai {
      if let atlas: Gpu2dTextAtlas = canvas.textAtlases.copyAt(index: ai) {
        var retired: Gpu2dTextAtlas = own atlas
        retireBufferIds(resources: resources, list: retired.buffers)
        retireTextureView(resources: resources, id: retired.textureView)
        retireTexture(resources: resources, id: retired.texture)
      }
    }
    canvas.textAtlases.clear()
    retireRenderPipeline(resources: resources, id: canvas.textPipeline)
    shutdown(resources: resources)
  }
  canvas.gpuResources = none
  canvas.pipeline = noRenderPipelineId()
  canvas.viewport = noBufferId()
  canvas.offscreen = noExternalId()
  unsafe { canvas.offscreenHandle = webgpuNull() }
  canvas.recording = none
  canvas.pipeMade = false
  canvas.flushIndex = 0
  canvas.clipCursor = 0
  canvas.imagePipeMade = false
  canvas.imagePipeline = noRenderPipelineId()
  canvas.imageSampler = noSamplerId()
  canvas.imageDrawCursor = 0
  canvas.textPipeMade = false
  canvas.textPipeline = noRenderPipelineId()
}
