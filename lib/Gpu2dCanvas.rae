# Gpu2dCanvas — the 2D renderer's Rae-owned passes over the WebGPU bindings:
# the box/primitive pass (#907) and the image pass (#908), on ONE app-owned
# gpu/GpuResources manager. C keeps the frame lifecycle (encoder/pass/present),
# the box batch accumulation (until #913), the shared viewport uniform and the
# per-run clip uniform + scissor; everything the passes CREATE — pipelines,
# instance buffers, image textures + views + sampler, per-draw uniforms and
# bind groups — is a typed ID here, and the draws go into the C-owned frame
# pass (rae_g2d_pass_get) with recordDrawInPass, the #874 grass pattern.
#
# Box pass: one pipeline (lib/gpu2d_box.wgsl) draws every rect / rounded rect /
# bordered box / gradient / line the frame queued, in contiguous same-clip
# runs (scissor + clip uniform per run). Instance buffers are per flush slot
# within a frame (a later flush must not overwrite what an earlier draw still
# reads) and persist across frames, like the C pool did.
#
# Image pass: images are decoded by C (stb_image, CPU RGBA) and uploaded here
# into manager textures; the 1-based image handle indexes `images`, the key
# registry maps a name to a handle (ImageRegistry.rae keeps the load / retry /
# cache policy over it). Each queued draw is one 64-byte uniform + one bind
# group [viewport, uniform, view, sampler], cached per draw slot by handle
# exactly as the C flush cached them; draws go after the boxes, before text.
#
# Text pass (#909): MSDF glyph quads batched PER ATLAS (so one frame mixes
# fonts, e.g. Roboto body text + the Material-icon atlas). Glyph rasterization
# and the CPU atlas pixels stay C (SdfText.loadAtlas); the atlas texture +
# view are uploaded lazily into manager textures, the per-atlas per-flush
# instance buffers persist like the box pool, and one bind group per atlas per
# flush draws its contiguous same-clip runs after the images.
#
# Owner: an app (or the deferred renderer for its UI overlay) holds ONE
# Gpu2dCanvas and hands it to Gpu2d.flush / Gpu2d.endFrame and the image API.
import String
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuIds

func g2dBoxPass() unsafe extern("rae_g2d_pass_get") ret Ptr
func nativeG2dBoxFormat() unsafe extern("rae_g2d_format") ret Int
func g2dViewportUniform() unsafe extern("rae_g2d_viewport_uniform") ret Ptr
func nativeG2dPrimCount() unsafe extern("rae_g2d_prim_count") ret Int
func nativeG2dPrimFloats() unsafe extern("rae_g2d_prim_floats") ret Int
func g2dPrimData() unsafe extern("rae_g2d_prim_data") ret Ptr
func nativeG2dPrimClipAt(i: Int) unsafe extern("rae_g2d_prim_clip_at") ret Int
func nativeG2dPrimReset() unsafe extern("rae_g2d_prim_reset")
func g2dClipFrameUniform(clip: Int) unsafe extern("rae_g2d_clip_frame_uniform") ret Ptr
func nativeG2dScissor(clip: Int) unsafe extern("rae_g2d_scissor")
func nativeG2dPrepareFlush(imagesPending: Int) unsafe extern("rae_g2d_prepare_flush")
func nativeG2dCurrentClip() unsafe extern("rae_g2d_current_clip") ret Int
func nativeG2dBoxReadFile(path: String) unsafe extern("rae_ext_rae_sys_read_file") ret String
# CPU image decode stays C (stb_image): a malloc'd RGBA8 buffer + its size,
# freed with g2dDecodeFree once uploaded. A failed decode logs once in C and
# returns null.
func g2dDecodeImage(path: String) unsafe extern("rae_g2d_decode_image") ret Ptr
func nativeG2dDecodedWidth() unsafe extern("rae_g2d_decoded_width") ret Int
func nativeG2dDecodedHeight() unsafe extern("rae_g2d_decoded_height") ret Int
func g2dDecodeFree(rgba: Ptr) unsafe extern("rae_g2d_decode_free")
# The C per-atlas glyph batch (drawGlyph/drawGlyphEx accumulate there) and the
# CPU MSDF atlas pixels (SdfText.loadAtlas), read back for the text pass.
func nativeG2dTextAtlasMax() unsafe extern("rae_g2d_text_atlas_max") ret Int
func nativeG2dTextFloats() unsafe extern("rae_g2d_text_floats") ret Int
func nativeG2dTextCount(ai: Int) unsafe extern("rae_g2d_text_count") ret Int
func g2dTextData(ai: Int) unsafe extern("rae_g2d_text_data") ret Ptr
func nativeG2dTextClipAt(ai: Int, i: Int) unsafe extern("rae_g2d_text_clip_at") ret Int
