# TransparentForward — the transparent forward pass of the deferred frame (#842/#843).
#
# Runs between lighting and taa (see RendererDeferred.buildDeferredGraph). Two
# steps, in this order:
#   1. copyOpaqueRadiance: snapshot the lit HDR target into litCopy (#842), so a
#      later refracting material can READ the opaque frame it is about to write
#      over (the standard answer to "read the target you write").
#   2. the GPU draw (#843): alpha-blend instanced transparent geometry INTO the
#      lit target, depth-testing the opaque scene READ-ONLY. Transparents are
#      occluded by geometry but never write depth, so they cannot occlude each
#      other or the opaque frame; sort order between transparents is the
#      caller's problem, as everywhere.
#
# This is the first forward-into-lit precedent in the renderer: every other
# geometry draw writes the G-buffer and only fullscreen passes touch gb_lit. It
# reuses the geometry pass's Frame uniform + DrawU draws storage and its vertex
# layout, so an instance is packed once (packInstanceRecord) and drawn with the
# same mesh buffers; only the pipeline (blend, read-only depth, one HDR target)
# and the render pass differ. Pipeline + bind are built in Rae over the bindings
# and parked in the C handle slots, like the AO / composite passes.
#
# Client API (one batch, one mesh per frame — a list of batches is the obvious
# extension when a second mesh needs it):
#   addTransparentInstance(cache, mesh, transform, r, g, b, alpha)   # per instance
# The pass draws whatever was added this frame and resets the batch, so callers
# never reset it themselves. Adding after the pass ran shows up next frame.
open Gbuffer
open GbufferInstanced
open GbufferPasses
open Scene3d
open webgpu/Webgpu
open webgpu/Context

func gbLitTexture() extern("rae_gb_lit_texture") ret Ptr
func gbLitCopyTexture() extern("rae_gb_lit_copy_texture") ret Ptr
func gbLitCopyView() extern("rae_gb_lit_copy_view") ret Ptr
func gbLitFormat() extern("rae_gb_lit_format") ret Int
func gbTransparentPipeline() extern("rae_gb_transparent_pipeline") ret Ptr
func gbSetTransparentPipeline(pipeline: Ptr) extern("rae_gb_set_transparent_pipeline")
func gbTransparentBind() extern("rae_gb_transparent_bind") ret Ptr
func gbSetTransparentBind(bind: Ptr) extern("rae_gb_set_transparent_bind")

# Per-renderer state (#764: no module globals). `batch` is sized once at
# creation and refilled in place each frame — zero per-frame allocation.
type TransparentPassCache {
  pipeMade: Bool   # creation attempted (so a missing shader is reported once)
  pipeReady: Bool  # creation succeeded; the draw is skipped otherwise
  bindMade: Bool
  snapshotDone: Bool  # this frame's opaque snapshot was taken early (transparentSnapshot)
  batch: InstanceBatch
}

func createTransparentPassCache(capacity: copy Int) pub ret TransparentPassCache {
  let floatCount: Int = capacity * instanceRecordFloats
  let records: List(Float) = createList(Float, cap: floatCount)
  var floatIndex: Int = 0
  loop floatIndex < floatCount {
    records.add(value: 0.0)
    floatIndex = floatIndex + 1
  }
  # meshId -1: no mesh until the first addTransparentInstance names one.
  ret TransparentPassCache {
    pipeMade: false, pipeReady: false, bindMade: false, snapshotDone: false,
    batch: { meshId: 0 - 1, capacity: capacity, count: 0, records: records }
  }
}

# Queue one transparent instance for this frame. The record is the geometry
# pass's DrawU with the ALPHA carried in the metallic slot (the transparent
# shader reads albedoMetallic.w as alpha; an unlit blend has no metallic).
# Silently drops instances past capacity, like every fixed-size batch.
func addTransparentInstance(cache: mod TransparentPassCache, mesh: view MeshHandle,
                            transform: view Transform3d,
                            r: copy Float, g: copy Float, b: copy Float, alpha: copy Float) pub {
  cache.batch.meshId = mesh.id
  if cache.batch.count >= cache.batch.capacity { ret }
  let model: Mat4 = modelMatrixOf(t: transform)
  packInstanceRecord(records: cache.batch.records, slot: cache.batch.count,
    model: model, prevModel: model,
    r: r, g: g, b: b, metallic: alpha, roughness: 0.0,
    emissive: 0.0, toon: 0, paletteBase: 0)
  cache.batch.count = cache.batch.count + 1
}

func copyOpaqueRadiance() {
  if gbDeferredPrepare() is 0 { ret }
  # Geometry has already submitted its encoder. Like the fullscreen post
  # passes, submit on the same queue to preserve graph execution order.
  let encoderDescriptor: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let encoder: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encoderDescriptor)
  let texture: Ptr = gbLitTexture()
  let source: WGPUTexelCopyTextureInfo = { texture: texture, aspect: WGPUTextureAspect_All }
  let destination: WGPUTexelCopyTextureInfo = { texture: gbLitCopyTexture(), aspect: WGPUTextureAspect_All }
  let extent: WGPUExtent3D = {
    width: wgpuTextureGetWidth(texture: texture)
    height: wgpuTextureGetHeight(texture: texture)
    depthOrArrayLayers: 1 as UInt32
  }
  wgpuCommandEncoderCopyTextureToTexture(commandEncoder: encoder, source: source, destination: destination, copySize: extent)
  let bufferDescriptor: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let commandBuffer: Ptr = wgpuCommandEncoderFinish(commandEncoder: encoder, descriptor: bufferDescriptor)
  gbSubmit(cmd: commandBuffer)
  wgpuCommandBufferRelease(commandBuffer: commandBuffer)
  wgpuCommandEncoderRelease(commandEncoder: encoder)
}

# The blend pipeline: the geometry pass's vertex layout and group-0 bindings,
# ONE colour target in the lit HDR format with straight alpha blending, and a
# depth state that TESTS reverse-Z (Greater, like the G-buffer) but never writes.
# Built lazily after the first deferred prepare, so gbLitFormat is the format
# the targets were actually created with (rg11b10 or the rgba16f fallback).
func ensureTransparentPipeline(cache: mod TransparentPassCache) {
  if cache.pipeMade { ret }
  cache.pipeMade = true
  # The shader is read relative to the working directory, like every lib/*.wgsl
  # (run the app from the repo root — the example gates `cd ..` for this).
  # An empty read must NOT reach wgpu: a module with no `vs` entry point makes
  # createRenderPipeline abort the process with an unhelpful validation error.
  let source: String = gbReadWgsl(path: "lib/transparentForward.wgsl")
  if source.length() is 0 {
    log("[transparentForward] lib/transparentForward.wgsl not readable from the working directory — run from the repo root; transparent draws are skipped")
    ret
  }
  cache.pipeReady = true
  let sourceC: Buffer(Any) = source.toCStr()
  let shaderMod: Ptr = makeShaderModule(wgsl: sourceC)
  var attrs: List(WGPUVertexAttribute) = createList(WGPUVertexAttribute, cap: 3)
  attrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0 as UInt64, shaderLocation: 0 as UInt32 })
  attrs.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12 as UInt64, shaderLocation: 1 as UInt32 })
  attrs.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24 as UInt64, shaderLocation: 2 as UInt32 })
  var vbls: List(WGPUVertexBufferLayout) = createList(WGPUVertexBufferLayout, cap: 1)
  vbls.add(value: {
    stepMode: WGPUVertexStepMode_Vertex, arrayStride: 32 as UInt64,
    attributeCount: 3 as UInt64, attributes: attrs.data
  })
  # Straight alpha: out = src * a + dst * (1 - a); alpha channel keeps coverage.
  var blends: List(WGPUBlendState) = createList(WGPUBlendState, cap: 1)
  blends.add(value: {
    color: { operation: WGPUBlendOperation_Add, srcFactor: WGPUBlendFactor_SrcAlpha, dstFactor: WGPUBlendFactor_OneMinusSrcAlpha },
    alpha: { operation: WGPUBlendOperation_Add, srcFactor: WGPUBlendFactor_One, dstFactor: WGPUBlendFactor_OneMinusSrcAlpha }
  })
  var targets: List(WGPUColorTargetState) = createList(WGPUColorTargetState, cap: 1)
  targets.add(value: { format: gbLitFormat() as Int32, blend: blends.data, writeMask: WGPUColorWriteMask_All })
  var frags: List(WGPUFragmentState) = createList(WGPUFragmentState, cap: 1)
  frags.add(value: {
    module: shaderMod, entryPoint: { data: gbEntryFs(), length: WGPU_STRLEN },
    targetCount: 1 as UInt64, targets: targets.data
  })
  var depths: List(WGPUDepthStencilState) = createList(WGPUDepthStencilState, cap: 1)
  depths.add(value: {
    format: WGPUTextureFormat_Depth32Float,
    depthWriteEnabled: WGPUOptionalBool_False,
    depthCompare: WGPUCompareFunction_Greater,
    stencilFront: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilBack: { compare: WGPUCompareFunction_Always, failOp: WGPUStencilOperation_Keep, depthFailOp: WGPUStencilOperation_Keep, passOp: WGPUStencilOperation_Keep },
    stencilReadMask: 4294967295 as UInt32, stencilWriteMask: 4294967295 as UInt32
  })
  # No culling: a transparent surface (water sheet, a fading particle seen
  # from inside its splash) is meaningful from both sides.
  let desc: WGPURenderPipelineDescriptor = {
    vertex: {
      module: shaderMod, entryPoint: { data: gbEntryVs(), length: WGPU_STRLEN },
      bufferCount: 1 as UInt64, buffers: vbls.data
    },
    primitive: {
      topology: WGPUPrimitiveTopology_TriangleList,
      frontFace: WGPUFrontFace_CCW, cullMode: WGPUCullMode_None
    },
    depthStencil: depths.data,
    multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 },
    fragment: frags.data
  }
  gbSetTransparentPipeline(pipeline: wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: desc))
  wgpuShaderModuleRelease(shaderModule: shaderMod)
}

# A bind group from THIS pipeline's layout (wgpu auto-layouts are pipeline-
# exclusive, so the geometry pass's static bind cannot be reused) over the same
# two buffers: frame uniform @0, draws storage @1. Those buffers are created
# once and survive resizes, so the bind is made once.
func ensureTransparentBind(cache: mod TransparentPassCache) {
  if cache.bindMade { ret }
  cache.bindMade = true
  let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: gbTransparentPipeline(), groupIndex: 0 as UInt32)
  var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 2)
  entries.add(value: { binding: 0 as UInt32, buffer: gbFrameUbuf(), size: gbFrameBytes() as UInt64 })
  entries.add(value: { binding: 1 as UInt32, buffer: gbDrawsBuffer(), size: gbDrawsSize() as UInt64 })
  let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 2 as UInt64, entries: entries.data }
  gbSetTransparentBind(bind: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
  wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
}

# Encode + submit the transparent draw: one render pass that LOADS the lit
# target (the opaque radiance stays), attaches the scene depth READ-ONLY, and
# issues one instanced DrawIndexed through the shared geometry-draw tail
# (gbIssueInstanced: records -> draws buffer at the running cursor, then the
# draw). The cursor is per frame and only resets at the next Gbuffer.begin, so
# these records land after the geometry pass's and never overlap them.
func drawTransparentBatch(cache: mod TransparentPassCache) {
  let mesh: Int = cache.batch.meshId
  # NOT gbMeshReady: that answers "may I draw into the CURRENT geometry pass"
  # (it is 0 once Gbuffer.end cleared the pass), and this pass runs after it.
  # An uploaded mesh has a non-zero index count; an invalid/unset id has 0.
  if gbMeshIcount(mesh: mesh) <= 0 { ret }
  let base: Int = gbDrawCount()
  var count: Int = cache.batch.count
  let remaining: Int = gbMaxDraws() - base
  if count > remaining { count = remaining }
  if count <= 0 { ret }
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  var colorAtts: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 1)
  colorAtts.add(value: {
    view_: gbLitView(), depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
    loadOp: WGPULoadOp_Load, storeOp: WGPUStoreOp_Store
  })
  # Read-only depth: WebGPU requires the load/store ops to be Undefined then.
  var depthAtts: List(WGPURenderPassDepthStencilAttachment) = createList(WGPURenderPassDepthStencilAttachment, cap: 1)
  depthAtts.add(value: {
    view_: gbViewDepth(),
    depthLoadOp: WGPULoadOp_Undefined, depthStoreOp: WGPUStoreOp_Undefined,
    depthReadOnly: 1 as UInt32
  })
  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 1 as UInt64, colorAttachments: colorAtts.data,
    depthStencilAttachment: depthAtts.data
  }
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  gbIssueInstanced(pass: pass, pipeline: gbTransparentPipeline(), bind: gbTransparentBind(),
    vbuf: gbMeshVbuf(mesh: mesh), ibuf: gbMeshIbuf(mesh: mesh),
    icount: gbMeshIcount(mesh: mesh), base: base, count: count, records: cache.batch.records.data)
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
}

# The render graph's transparentForward step: snapshot, then draw this frame's
# batch, then reset it for the next frame. With nothing queued only the
# snapshot runs — the pass costs no GPU work until a client uses it.
# Take the opaque snapshot EARLY, before something refractive (the water, #832)
# draws and reads litCopy. An app that draws refracting surfaces calls this
# first, then its draws, then transparentPass; an app without them just calls
# transparentPass, which snapshots on its own.
func transparentSnapshot(cache: mod TransparentPassCache) pub {
  if gbDeferredPrepare() is 0 { ret }
  copyOpaqueRadiance()
  cache.snapshotDone = true
}

func transparentPass(cache: mod TransparentPassCache) pub {
  if gbDeferredPrepare() is 0 { ret }
  if not cache.snapshotDone { copyOpaqueRadiance() }
  cache.snapshotDone = false
  if cache.batch.count > 0 {
    ensureTransparentPipeline(cache: cache)
    if cache.pipeReady {
      ensureTransparentBind(cache: cache)
      drawTransparentBatch(cache: cache)
    }
  }
  cache.batch.count = 0
}
