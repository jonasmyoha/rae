# TransparentForward — the transparent forward pass of the deferred frame (#842/#843).
#
# Runs between lighting and taa (see RendererDeferred.buildDeferredGraph). Two
# steps, in this order:
#   1. copyOpaqueRadiance: snapshot the lit HDR target into litCopy (#842), so a
#      later refracting material can READ the opaque frame it is about to write
#      over (the standard answer to "read the target you write").
#   2. the GPU draw (#843): alpha-blend instanced transparent geometry INTO the
#      lit target, depth-testing the opaque scene READ-ONLY. Transparents are
#      occluded by geometry but never write depth, so they cannot occlude each
#      other or the opaque frame; sort order between transparents is the
#      caller's problem, as everywhere.
#
# This is the first forward-into-lit precedent in the renderer: every other
# geometry draw writes the G-buffer and only fullscreen passes touch gb_lit. It
# reuses the geometry pass's Frame uniform + DrawU draws storage and its vertex
# layout, so an instance is packed once (packInstanceRecord) and drawn with the
# same mesh buffers; only the pipeline (blend, read-only depth, one HDR target)
# and the render pass differ. Since #904 the pipeline + bind are typed IDs in
# the DeferredRenderer-owned manager (the frame uniform + draws storage are
# adopted as externals once — they survive resizes), like the post-passes.
#
# Client API (one batch, one mesh per frame — a list of batches is the obvious
# extension when a second mesh needs it):
#   addTransparentInstance(cache, mesh, transform, r, g, b, alpha)   # per instance
# The pass draws whatever was added this frame and resets the batch, so callers
# never reset it themselves. Adding after the pass ran shows up next frame.
open MeshStore
open Gbuffer
open GbufferInstanced
open GbufferRecord
open GbufferPasses
open Scene3d
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuIds

func gbLitTexture() unsafe extern("rae_gb_lit_texture") ret Ptr

func gbLitCopyTexture() unsafe extern("rae_gb_lit_copy_texture") ret Ptr

func gbLitCopyView() unsafe extern("rae_gb_lit_copy_view") ret Ptr

func nativeGbLitFormat() unsafe extern("rae_gb_lit_format") ret Int

func gbLitFormat() ret Int {
  unsafe {
    ret nativeGbLitFormat()
  }
}

# Per-renderer state (#764: no module globals). `batch` is sized once at
# creation and refilled in place each frame — zero per-frame allocation.
type TransparentPassCache {
  pipeMade: Bool  # creation attempted (so a missing shader is reported once)
  pipeline: RenderPipelineId  # invalid when creation failed; the draw is skipped then
  bindGroup: BindGroupId
  adopted: List(ExternalId)  # the frame uniform + draws storage, adopted once
  snapshotDone: Bool  # this frame's opaque snapshot was taken early (transparentSnapshot)
  batch: InstanceBatch
}

func createTransparentPassCache(capacity: copy Int) pub ret TransparentPassCache {
  let floatCount: Int = capacity * instanceRecordFloats
  let records: List(Float) = List.create(Float, cap: floatCount)
  var floatIndex: Int = 0
  loop floatIndex < floatCount {
    records.add(value: 0.0)
    floatIndex = floatIndex + 1
  }
  # meshId -1: no mesh until the first addTransparentInstance names one.
  ret TransparentPassCache {
    pipeMade: false
    pipeline: noRenderPipelineId()
    bindGroup: noBindGroupId()
    adopted: List.create(ExternalId, cap: 2)
    snapshotDone: false
    batch: { meshId: 0 - 1, capacity: capacity, count: 0, records: records }
  }
}

# Queue one transparent instance for this frame. The record is the geometry
# pass's DrawU with the ALPHA carried in the metallic slot (the transparent
# shader reads albedoMetallic.w as alpha; an unlit blend has no metallic).
# Silently drops instances past capacity, like every fixed-size batch.
func addTransparentInstance(
  cache: mod TransparentPassCache
  mesh: view MeshHandle
  transform: view Transform3d
  r: copy Float
  g: copy Float
  b: copy Float
  alpha: copy Float
) pub {
  cache.batch.meshId = mesh.id
  if cache.batch.count >= cache.batch.capacity {
    ret
  }
  let model: Mat4 = modelMatrixOf(t: transform)
  packInstanceRecord(
    records: cache.batch.records
    slot: cache.batch.count
    model: model
    prevModel: model
    r: r
    g: g
    b: b
    metallic: alpha
    roughness: 0.0
    emissive: 0.0
    toon: 0
    paletteBase: 0
  )
  cache.batch.count = cache.batch.count + 1
}

func copyOpaqueRadiance() {
  unsafe {
    if gbDeferredPrepare() is 0 {
      ret
    }
    # Geometry has already submitted its encoder. Like the fullscreen post
    # passes, submit on the same queue to preserve graph execution order.
    let encoderDescriptor: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let encoder: Ptr = wgpuDeviceCreateCommandEncoder(
      device: webgpuDevice()
      descriptor: encoderDescriptor
    )
    let texture: Ptr = gbLitTexture()
    let source: WGPUTexelCopyTextureInfo = { texture: texture, aspect: WGPUTextureAspect_All }
    let destination: WGPUTexelCopyTextureInfo = {
      texture: gbLitCopyTexture()
      aspect: WGPUTextureAspect_All
    }
    let extent: WGPUExtent3D = {
      width: wgpuTextureGetWidth(texture: texture)
      height: wgpuTextureGetHeight(texture: texture)
      depthOrArrayLayers: 1 as UInt32
    }
    wgpuCommandEncoderCopyTextureToTexture(
      commandEncoder: encoder
      source: source
      destination: destination
      copySize: extent
    )
    let bufferDescriptor: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
    let commandBuffer: Ptr = wgpuCommandEncoderFinish(
      commandEncoder: encoder
      descriptor: bufferDescriptor
    )
    gbSubmit(cmd: commandBuffer)
    wgpuCommandBufferRelease(commandBuffer: commandBuffer)
    wgpuCommandEncoderRelease(commandEncoder: encoder)
  }
}

# The blend pipeline: the geometry pass's vertex layout and group-0 bindings,
# ONE colour target in the lit HDR format with straight alpha blending, and a
# depth state that TESTS reverse-Z (Greater, like the G-buffer) but never writes.
# Built lazily after the first deferred prepare, so gbLitFormat is the format
# the targets were actually created with (rg11b10 or the rgba16f fallback).
# No culling: a transparent surface (water sheet, a fading particle seen from
# inside its splash) is meaningful from both sides.
func transparentPipelineSpec() ret RenderPipelineSpec {
  let colorFormats: List(Int32) = List.create(Int32, cap: 1)
  colorFormats.add(value: gbLitFormat() as Int32)
  let attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 3)
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0, location: 0 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12, location: 1 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24, location: 2 })
  ret RenderPipelineSpec {
    vertexStride: 32
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: true
    premultiplied: false
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: false
    depthCompare: WGPUCompareFunction_Greater
    cullMode: WGPUCullMode_None
  }
}

func ensureTransparentPipeline(cache: mod TransparentPassCache, resources: mod GpuResources) {
  if cache.pipeMade {
    ret
  }
  cache.pipeMade = true
  # The shader is read relative to the working directory, like every lib/*.wgsl
  # (run the app from the repo root — the example gates `cd ..` for this).
  # An empty read must NOT reach wgpu: a module with no `vs` entry point makes
  # createRenderPipeline abort the process with an unhelpful validation error.
  var source: String = ""
  unsafe {
    source = gbReadWgsl(path: "lib/transparentForward.wgsl")
  }
  if source.length() is 0 {
    log(
      "[transparentForward] lib/transparentForward.wgsl not readable from the working directory — run from the repo root; transparent draws are skipped"
    )
    ret
  }
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    wgsl: source
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: transparentPipelineSpec()
  ) {
    cache.pipeline = pipeline
  }
}

# A bind group from THIS pipeline's layout (wgpu auto-layouts are pipeline-
# exclusive, so the geometry pass's static bind cannot be reused) over the same
# two buffers: frame uniform @0, draws storage @1. Those buffers are created
# once and survive resizes, so the bind (and its adoptions) are made once.
func ensureTransparentBind(cache: mod TransparentPassCache, resources: mod GpuResources) {
  if bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    ret
  }
  releaseExternalIds(resources: resources, list: cache.adopted)
  let entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
  unsafe {
    entries.add(
      value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbFrameUbuf())
    )
    entries.add(
      value: adoptBufferRef(resources: resources, adopted: cache.adopted, handle: gbDrawsBuffer())
    )
  }
  var made: Bool = false
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.pipeline
    entries: entries
  ) {
    cache.bindGroup = bind
    made = true
  }
  if not made {
    releaseExternalIds(resources: resources, list: cache.adopted)
  }
}

# Encode + submit the transparent draw: one render pass that LOADS the lit
# target (the opaque radiance stays), attaches the scene depth READ-ONLY, and
# issues one instanced DrawIndexed from the manager IDs over the mesh's
# buffers, after uploading the records into the draws buffer at the running
# cursor. The cursor is per frame and only resets at the next Gbuffer.begin,
# so these records land after the geometry pass's and never overlap them.
func drawTransparentBatch(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  meshes: view MeshStore
) {
  unsafe {
    let mesh: Int = cache.batch.meshId
    # NOT gbMeshReady: that answers "may I draw into the CURRENT geometry pass"
    # (it is 0 once Gbuffer.end cleared the pass), and this pass runs after it.
    # An uploaded mesh has a non-zero index count; an invalid/unset id has 0.
    if meshStoreIndexCount(store: meshes, mesh: mesh) <= 0 {
      ret
    }
    let base: Int = gbDrawCount()
    var count: Int = cache.batch.count
    let remaining: Int = gbMaxDraws() - base
    if count > remaining {
      count = remaining
    }
    if count <= 0 {
      ret
    }
    let strideBytes: Int = instanceRecordFloats * 4
    wgpuQueueWriteBuffer(
      queue: webgpuQueue()
      buffer: gbDrawsBuffer()
      bufferOffset: (base * strideBytes) as UInt64
      data: cache.batch.records.data
      size: (count * strideBytes) as UInt64
    )
    let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
    let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
    var colorAtts: List(WGPURenderPassColorAttachment) = List.create(
      WGPURenderPassColorAttachment
      cap: 1
    )
    colorAtts.add(
      value: {
        view_: gbLitView()
        depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32
        loadOp: WGPULoadOp_Load
        storeOp: WGPUStoreOp_Store
      }
    )
    # Read-only depth: WebGPU requires the load/store ops to be Undefined then.
    var depthAtts: List(WGPURenderPassDepthStencilAttachment) = List.create(
      WGPURenderPassDepthStencilAttachment
      cap: 1
    )
    depthAtts.add(
      value: {
        view_: gbViewDepth()
        depthLoadOp: WGPULoadOp_Undefined
        depthStoreOp: WGPUStoreOp_Undefined
        depthReadOnly: 1 as UInt32
      }
    )
    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 1 as UInt64
      colorAttachments: colorAtts.data
      depthStencilAttachment: depthAtts.data
    }
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    if recordDrawIndexedInPass(
      resources: resources
      pass: pass
      pipeline: cache.pipeline
      bindGroup: cache.bindGroup
      vertexBuffer: meshStoreVbufHandle(store: meshes, resources: resources, mesh: mesh)
      indexBuffer: meshStoreIbufHandle(store: meshes, resources: resources, mesh: mesh)
      indexCount: meshStoreIndexCount(store: meshes, mesh: mesh)
      instanceCount: count
      firstInstance: base
    ) {
      gbAdvanceDraws(count: count)
    }
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
    let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
    gbSubmit(cmd: cmd)
    wgpuCommandBufferRelease(commandBuffer: cmd)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
    wgpuCommandEncoderRelease(commandEncoder: enc)
  }
}

# The render graph's transparentForward step: snapshot, then draw this frame's
# batch, then reset it for the next frame. With nothing queued only the
# snapshot runs — the pass costs no GPU work until a client uses it.
# Take the opaque snapshot EARLY, before something refractive (the water, #832)
# draws and reads litCopy. An app that draws refracting surfaces calls this
# first, then its draws, then transparentPass; an app without them just calls
# transparentPass, which snapshots on its own.
func transparentSnapshot(cache: mod TransparentPassCache) pub {
  if gbDeferredPrepare() is 0 {
    ret
  }
  copyOpaqueRadiance()
  cache.snapshotDone = true
}

func transparentPass(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  meshes: view MeshStore
) pub {
  if gbDeferredPrepare() is 0 {
    ret
  }
  if not cache.snapshotDone {
    copyOpaqueRadiance()
  }
  cache.snapshotDone = false
  if cache.batch.count > 0 {
    ensureTransparentPipeline(cache: cache, resources: resources)
    if isValidRenderPipeline(resources: resources, id: cache.pipeline) {
      ensureTransparentBind(cache: cache, resources: resources)
      drawTransparentBatch(cache: cache, resources: resources, meshes: meshes)
    }
  }
  cache.batch.count = 0
}

# Retire the pass's manager objects (renderer shutdown); the batch stays.
func transparentShutdown(cache: mod TransparentPassCache, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: cache.bindGroup)
  releaseExternalIds(resources: resources, list: cache.adopted)
  retireRenderPipeline(resources: resources, id: cache.pipeline)
  cache.bindGroup = noBindGroupId()
  cache.pipeline = noRenderPipelineId()
  cache.pipeMade = false
}
