# TransparentForward — the transparent forward pass of the deferred frame (#842/#843).
#
# Runs between lighting and taa (see RendererDeferred.buildDeferredGraph). Two
# steps, in this order:
#   1. copyOpaqueRadiance: snapshot the lit HDR target into litCopy (#842), so a
#      later refracting material can READ the opaque frame it is about to write
#      over (the standard answer to "read the target you write").
#   2. the GPU draw (#843): alpha-blend instanced transparent geometry INTO the
#      lit target, depth-testing the opaque scene READ-ONLY. Transparents are
#      occluded by geometry but never write depth, so they cannot occlude each
#      other or the opaque frame; sort order between transparents is the
#      caller's problem, as everywhere.
#
# This is the first forward-into-lit precedent in the renderer: every other
# geometry draw writes the G-buffer and only fullscreen passes touch gb_lit. It
# reuses the geometry pass's Frame uniform + DrawU draws storage and its vertex
# layout, so an instance is packed once (packInstanceRecord) and drawn with the
# same mesh buffers; only the pipeline (blend, read-only depth, one HDR target)
# and the render pass differ. Since #904 the pipeline + bind are typed IDs in
# the DeferredRenderer-owned manager; since #906 the bind names the geometry
# frame's uniform + draws buffers by ID (GbufferCache) and the pass attaches
# the cache's depth target read-only — no adopted externals.
#
# Client API:
#   addTransparentInstance(cache, mesh, transform, r, g, b, alpha)   # per instance
#   addTransparentShimmerInstance(cache, mesh, model, r, g, b, alpha, shimmer)
# Instances of several meshes may be queued in one frame. They are drawn in the
# order they were queued (sort them farthest first for the blend): each run of
# instances with one mesh is one instanced draw, all in one render pass.
# The pass draws whatever was added this frame and resets the batch, so callers
# never reset it themselves. Adding after the pass ran shows up next frame.
open MeshStore
open Gbuffer
open GbufferIssue
open GbufferResources
open GbufferInstanced
open GbufferRecord
open GbufferPasses
open GbufferTargets
open gpu/GpuTextures
open Scene3d
open webgpu/Webgpu
open webgpu/Context
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuRender
open gpu/GpuRenderPass
open gpu/GpuRenderTransfer
open gpu/GpuIds

# The lit HDR target, its opaque snapshot (litCopy) and their format are the
# renderer's DeferredTargets since #923 (GbufferTargets.rae).

# Per-renderer state (#764: no module globals). `batch` is sized once at
# creation and refilled in place each frame — zero per-frame allocation.
type TransparentPassCache {
  pipeMade: Bool  # creation attempted (so a missing shader is reported once)
  pipeline: RenderPipelineId  # invalid when creation failed; the draw is skipped then
  bindGroup: BindGroupId
  snapshotDone: Bool  # this frame's opaque snapshot was taken early (transparentSnapshot)
  batch: InstanceBatch
  # the mesh of each queued instance, by slot (batch.meshId is only the last one)
  meshIds: List(Int)
  # this frame's draws, one per run of instances with one mesh (transparentRuns)
  runs: List(TransparentRun)
}

# A run of queued instances with one mesh: slots first .. first + count - 1
type TransparentRun {
  meshId: Int
  first: Int
  count: Int
}

# How a shimmering surface moves (style 4, addTransparentShimmerInstance): bands
# along its height that run in time, with a finer ripple across them, and more
# light and alpha where the surface is seen side-on (its edges). Both faces show,
# so a wall reads from inside and outside.
type TransparentShimmer {
  # seconds; the bands move with it (the program's clock, any start)
  time: Float = 0.0
  # bands per meter up the surface (world z)
  bandsPerMeter: Float = 0.5
  # bands per second that pass a point
  speed: Float = 0.4
  # extra brightness and alpha seen side-on (0 none, 1 strong)
  edgeGlow: Float = 0.6
  # add light instead of blending over (a glow, not a tinted sheet)
  additive: Bool = false
}

func createTransparentPassCache(capacity: copy Int) pub ret TransparentPassCache {
  let floatCount: Int = capacity * instanceRecordFloats
  var records: List(Float) = List.create(Float, cap: floatCount)
  var floatIndex: Int = 0
  loop floatIndex < floatCount {
    records.add(value: 0.0)
    floatIndex = floatIndex + 1
  }
  # meshId -1: no mesh until the first addTransparentInstance names one.
  ret TransparentPassCache {
    pipeMade: false
    pipeline: noRenderPipelineId()
    bindGroup: noBindGroupId()
    snapshotDone: false
    batch: { meshId: -1, capacity: capacity, count: 0, records: records }
    meshIds: List.create(Int, cap: capacity)
    runs: List.create(TransparentRun, cap: 4)
  }
}

# Queue one transparent instance for this frame. The record is the geometry
# pass's DrawU with the ALPHA carried in the metallic slot (the transparent
# shader reads albedoMetallic.w as alpha; an unlit blend has no metallic).
# Silently drops instances past capacity, like every fixed-size batch.
func addTransparentInstance(
  cache: mod TransparentPassCache
  mesh: view MeshHandle
  transform: view Transform3d
  r: copy Float
  g: copy Float
  b: copy Float
  alpha: copy Float
) {
  addTransparentMaterialInstance(
    cache: cache
    mesh: mesh
    model: modelMatrixOf(t: transform)
    r: r
    g: g
    b: b
    alpha: alpha
    style: 0.0
  )
}

# style 0 is plain unlit geometry; 1 the rounded water-drop impostor; 2 a soft
# puff; 3 a soft glow; 4 a shimmering surface (addTransparentShimmerInstance).
# Meshes may be mixed within a frame.
func addTransparentMaterialInstance(
  cache: mod TransparentPassCache
  mesh: view MeshHandle
  model: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  alpha: copy Float
  style: copy Float
) {
  cache.batch.meshId = mesh.id
  if cache.batch.count >= cache.batch.capacity {
    ret
  }
  packInstanceRecord(
    records: cache.batch.records
    slot: cache.batch.count
    model: model
    prevModel: model
    r: r
    g: g
    b: b
    metallic: alpha
    roughness: style
    emissive: 0.0
    toon: 0
    paletteBase: 0
  )
  if cache.batch.count < cache.meshIds.length {
    cache.meshIds.set(index: cache.batch.count, value: mesh.id)
  } else {
    cache.meshIds.add(value: mesh.id)
  }
  cache.batch.count = cache.batch.count + 1
}

# Queue one shimmering instance (style 4, see TransparentShimmer). The time and
# the band settings go in the record's free slots: params.yzw (time, bands per
# meter, speed) and fade.xy (additive, edge glow), which the plain styles do not
# read.
func addTransparentShimmerInstance(
  cache: mod TransparentPassCache
  mesh: view MeshHandle
  model: view Mat4
  r: copy Float
  g: copy Float
  b: copy Float
  alpha: copy Float
  shimmer: view TransparentShimmer
) {
  let before: Int = cache.batch.count
  addTransparentMaterialInstance(
    cache: cache
    mesh: mesh
    model: model
    r: r
    g: g
    b: b
    alpha: alpha
    style: 4.0
  )
  if cache.batch.count is before {
    ret
  }
  let base: Int = before * instanceRecordFloats
  cache.batch.records.set(index: base + 37, value: shimmer.time)
  cache.batch.records.set(index: base + 38, value: shimmer.bandsPerMeter)
  cache.batch.records.set(index: base + 39, value: shimmer.speed)
  var additive: Float = 0.0
  if shimmer.additive {
    additive = 1.0
  }
  cache.batch.records.set(index: base + 40, value: additive)
  cache.batch.records.set(index: base + 41, value: shimmer.edgeGlow)
}

# This frame's draws into cache.runs: the queued instances in order, a new run
# where the mesh changes. Refilled in place (no allocation once it has grown).
func transparentRuns(cache: mod TransparentPassCache) {
  cache.runs.clear()
  var count: Int = cache.batch.count
  if count > cache.meshIds.length {
    count = cache.meshIds.length
  }
  loop var slot: Int = 0, slot < count, ++slot {
    let meshId: Int = cache.meshIds.copyAtFallback(index: slot, fallback: -1)
    let last: Int = cache.runs.length - 1
    var extended: Bool = false
    if let run: mod TransparentRun = cache.runs.modAt(index: last) {
      if run.meshId is meshId {
        run.count = run.count + 1
        extended = true
      }
    }
    if not extended {
      cache.runs.add(value: TransparentRun { meshId: meshId, first: slot, count: 1 })
    }
  }
}

func copyOpaqueRadiance(resources: mod GpuResources, targets: mod DeferredTargets) {
  unsafe {
    let texture: Ptr = textureHandle(resources: resources, id: targets.lit)
    let copyTexture: Ptr = textureHandle(resources: resources, id: targets.litCopy)
    if texture is webgpuNull() or copyTexture is webgpuNull() {
      ret
    }
    # Recorded into the frame's post recording, after the passes before it
    let encoder: Ptr = postEncoder(targets: targets, resources: resources)
    if encoder is webgpuNull() {
      ret
    }
    let source: WGPUTexelCopyTextureInfo = { texture: texture, aspect: WGPUTextureAspect_All }
    let destination: WGPUTexelCopyTextureInfo = {
      texture: copyTexture
      aspect: WGPUTextureAspect_All
    }
    let extent: WGPUExtent3D = {
      width: wgpuTextureGetWidth(texture: texture)
      height: wgpuTextureGetHeight(texture: texture)
      depthOrArrayLayers: 1
    }
    wgpuCommandEncoderCopyTextureToTexture(
      commandEncoder: encoder
      source: source
      destination: destination
      copySize: extent
    )
  }
  targets.litCopyFresh = true
}

# The blend pipeline: the geometry pass's vertex layout and group-0 bindings,
# ONE color target in the lit HDR format with premultiplied alpha blending (the
# shader multiplies its color by alpha; an additive style returns alpha 0, so
# one pipeline both blends and adds), and a
# depth state that TESTS reverse-Z (Greater, like the G-buffer) but never writes.
# Built lazily after the targets exist, so the format is the one the lit
# target was actually created with (rg11b10 or the rgba16f fallback).
# No culling: a transparent surface (water sheet, a fading particle seen from
# inside its splash) is meaningful from both sides.
func transparentPipelineSpec(litFormat: copy Int32) ret RenderPipelineSpec {
  var colorFormats: List(Int32) = List.create(Int32, cap: 1)
  colorFormats.add(value: litFormat)
  var attributes: List(VertexAttributeSpec) = List.create(VertexAttributeSpec, cap: 3)
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 0, location: 0 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x3, offset: 12, location: 1 })
  attributes.add(value: { format: WGPUVertexFormat_Float32x2, offset: 24, location: 2 })
  ret RenderPipelineSpec {
    vertexStride: 32
    attributes: own attributes
    colorFormats: own colorFormats
    alphaBlend: true
    premultiplied: true
    depthFormat: WGPUTextureFormat_Depth32Float
    depthWrite: false
    depthCompare: WGPUCompareFunction_Greater
    cullMode: WGPUCullMode_None
    sampleCount: 1
  }
}

func ensureTransparentPipeline(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  litFormat: copy Int32
) {
  if cache.pipeMade {
    ret
  }
  cache.pipeMade = true
  # The shader is read relative to the working directory, like every lib/*.wgsl
  # (run the app from the repo root — the example gates `cd ..` for this).
  # An empty read must NOT reach wgpu: a module with no `vs` entry point makes
  # createRenderPipeline abort the process with an unhelpful validation error.
  let forwardShader: Shader = shader(files: ["lib/transparentForward.wgsl"])
  if let pipeline: RenderPipelineId = createRenderPipeline(
    resources: resources
    shader: forwardShader
    vertexEntry: "vs"
    fragmentEntry: "fs"
    spec: transparentPipelineSpec(litFormat: litFormat)
  ) {
    cache.pipeline = pipeline
  }
}

# A bind group from THIS pipeline's layout (wgpu auto-layouts are pipeline-
# exclusive, so the geometry pass's static bind cannot be reused) over the same
# two buffers: frame uniform @0, draws storage @1. Those buffers are created
# once and survive resizes, so the bind is made once.
func ensureTransparentBind(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  gbuffer: view GbufferCache
) {
  if bindGroupIsUsable(resources: resources, id: cache.bindGroup) {
    ret
  }
  var entries: List(ResourceRef) = List.create(ResourceRef, cap: 2)
  entries.add(value: bufferRef(id: gbuffer.frameUniform))
  entries.add(value: bufferRef(id: gbuffer.draws))
  if let bind: BindGroupId = createRenderBindGroup(
    resources: resources
    pipeline: cache.pipeline
    entries: entries
  ) {
    cache.bindGroup = bind
  }
}

# Encode + submit the transparent draws: one render pass that LOADS the lit
# target (the opaque radiance stays), attaches the scene depth READ-ONLY, and
# issues one instanced DrawIndexed per run of one mesh (transparentRuns), in the
# order queued, after uploading every record into the draws buffer at the
# running cursor. The cursor is per frame and only resets at the next
# Gbuffer.begin, so these records land after the geometry pass's and never
# overlap them. A run whose mesh is not uploaded is skipped.
func drawTransparentBatch(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  gbuffer: mod GbufferCache
  targets: mod DeferredTargets
) {
  unsafe {
    if not gbufferTargetsReady(cache: gbuffer, resources: resources) {
      ret
    }
    let base: Int = gbDrawCount(cache: gbuffer)
    var count: Int = cache.batch.count
    let remaining: Int = gbufferMaxDraws - base
    if count > remaining {
      count = remaining
    }
    if count <= 0 {
      ret
    }
    transparentRuns(cache: cache)
    let strideBytes: Int = instanceRecordFloats * 4
    if not writeBufferFromPtr(
      resources: resources
      id: gbuffer.draws
      offset: base * strideBytes
      data: cache.batch.records.data
      size: count * strideBytes
    ) {
      ret
    }
    let enc: Ptr = postEncoder(targets: targets, resources: resources)
    if enc is webgpuNull() {
      ret
    }
    var colorAtts: List(WGPURenderPassColorAttachment) = List.create(
      WGPURenderPassColorAttachment
      cap: 1
    )
    colorAtts.add(
      value: {
        view_: textureViewHandle(resources: resources, id: targets.litView)
        depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32
        loadOp: WGPULoadOp_Load
        storeOp: WGPUStoreOp_Store
      }
    )
    # Read-only depth: WebGPU requires the load/store ops to be Undefined then.
    var depthAtts: List(WGPURenderPassDepthStencilAttachment) = List.create(
      WGPURenderPassDepthStencilAttachment
      cap: 1
    )
    depthAtts.add(
      value: {
        view_: refHandle(
          resources: resources
          ref: gbufferTargetRef(cache: gbuffer, index: gbufferTargetDepth)
        )
        depthLoadOp: WGPULoadOp_Undefined
        depthStoreOp: WGPUStoreOp_Undefined
        depthReadOnly: 1 as UInt32
      }
    )
    let rpDesc: WGPURenderPassDescriptor = {
      colorAttachmentCount: 1
      colorAttachments: colorAtts.data
      depthStencilAttachment: depthAtts.data
    }
    let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
    loop let run: view TransparentRun in cache.runs {
      var runCount: Int = run.count
      if run.first + runCount > count {
        runCount = count - run.first
      }
      # NOT gbMeshReady: that answers "may I draw into the CURRENT geometry pass"
      # (it is 0 once Gbuffer.end cleared the pass), and this pass runs after it.
      # An uploaded mesh has a non-zero index count; an invalid/unset id has 0.
      let indexCount: Int = meshStoreIndexCount(store: gbuffer.meshes, mesh: run.meshId)
      if runCount > 0 and indexCount > 0 {
        let drawn: Bool = recordDrawIndexedInPass(
          resources: resources
          pass: pass
          pipeline: cache.pipeline
          bindGroup: cache.bindGroup
          vertexBuffer: meshStoreVbufHandle(
            store: gbuffer.meshes
            resources: resources
            mesh: run.meshId
          )
          indexBuffer: meshStoreIbufHandle(
            store: gbuffer.meshes
            resources: resources
            mesh: run.meshId
          )
          indexCount: indexCount
          instanceCount: runCount
          firstInstance: base + run.first
        )
      }
    }
    gbAdvanceDraws(cache: gbuffer, count: count)
    wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
    wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  }
}

# The render graph's transparentForward step: snapshot, then draw this frame's
# batch, then reset it for the next frame. With nothing queued (and no early
# snapshot) the pass does no GPU work at all.
# Take the opaque snapshot EARLY, before something refractive (the water, #832)
# draws and reads litCopy. An app that draws refracting surfaces calls this
# first, then its draws, then transparentPass; an app without them just calls
# transparentPass, which snapshots on its own.
func transparentSnapshot(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  targets: mod DeferredTargets
) {
  if not targetsReady(targets: targets, resources: resources) {
    ret
  }
  copyOpaqueRadiance(resources: resources, targets: targets)
  cache.snapshotDone = true
  # The app draws its refracting surface next with its own encoder and
  # submit, so everything recorded so far (lighting, this copy) goes first.
  flushPostPasses(targets: targets, resources: resources)
}

func transparentPass(
  cache: mod TransparentPassCache
  resources: mod GpuResources
  gbuffer: mod GbufferCache
  targets: mod DeferredTargets
) {
  if not targetsReady(targets: targets, resources: resources) {
    cache.batch.count = 0
    ret
  }
  # The snapshot is for the transparents drawn now; with nothing queued it
  # would be a full-screen copy nobody reads (render-perf-5). The underwater
  # pass takes its own, and a refracting app takes it early (transparentSnapshot).
  if not cache.snapshotDone and cache.batch.count > 0 {
    copyOpaqueRadiance(resources: resources, targets: targets)
  }
  cache.snapshotDone = false
  if cache.batch.count > 0 {
    ensureTransparentPipeline(cache: cache, resources: resources, litFormat: targets.litFormat)
    if isValidRenderPipeline(resources: resources, id: cache.pipeline) {
      ensureTransparentBind(cache: cache, resources: resources, gbuffer: gbuffer)
      drawTransparentBatch(
        cache: cache
        resources: resources
        gbuffer: gbuffer
        targets: targets
      )
    }
  }
  cache.batch.count = 0
}

# Retire the pass's manager objects (renderer shutdown); the batch stays.
func transparentShutdown(cache: mod TransparentPassCache, resources: mod GpuResources) {
  retireBindGroup(resources: resources, id: cache.bindGroup)
  retireRenderPipeline(resources: resources, id: cache.pipeline)
  cache.bindGroup = noBindGroupId()
  cache.pipeline = noRenderPipelineId()
  cache.pipeMade = false
}
