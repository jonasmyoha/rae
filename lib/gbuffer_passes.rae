# gbuffer_passes — the passes that consume the G-buffer, in Rae (#504).
#
# These are the deferred post-passes (composite first; lighting / ssao / taa /
# depth-pyramid to follow). Each is a fullscreen pass built over the WebGPU
# bindings. It reuses gbuffer's low-level helpers (makeShaderModule, the shader
# entry points, the one-command-buffer submit) via `open gbuffer`. The shared
# intermediate render targets and their generation counter stay C for now (they
# are produced by passes not yet migrated); Rae reads them through accessors.
import core
import gbuffer
import scene3d
import vec3
import sky
open gbuffer
open scene3d
open vec3
open sky
open webgpu/webgpu
import webgpu/context

# Presentable target + resize generation (also declared in gbuffer_inspector;
# these bind the same C symbols).

# Composite: tonemap the last radiometric result into the presentable target.
func gbDeferredPrepare() extern("rae_gb_deferred_prepare") ret Int
func gbCompositeWgsl() extern("rae_gb_composite_wgsl") ret Ptr
func gbCompositeSourceView() extern("rae_gb_composite_source_view") ret Ptr
func gbCompositeSourceIndex() extern("rae_gb_composite_source_index") ret Int
func gbCompositePipeline() extern("rae_gb_composite_pipeline") ret Ptr
func gbCompositeUbuf() extern("rae_gb_composite_ubuf") ret Ptr
func gbCompositeBind(idx: Int) extern("rae_gb_composite_bind") ret Ptr
func gbSetCompositePipeline(pipeline: Ptr) extern("rae_gb_set_composite_pipeline")
func gbSetCompositeUbuf(buf: Ptr) extern("rae_gb_set_composite_ubuf")
func gbSetCompositeBind(idx: Int, bind: Ptr) extern("rae_gb_set_composite_bind")

# A fullscreen pipeline: no vertex buffers, no depth, one colour target. The
# reusable primitive every deferred post-pass builds on.
func makeFullscreenPipeline(wgsl: copy Ptr, format: copy Int32) ret Ptr {
  let shaderMod: Ptr = makeShaderModule(wgsl: wgsl)
  var targets: List(WGPUColorTargetState) = createList(WGPUColorTargetState, cap: 1)
  targets.add(value: { format: format, writeMask: WGPUColorWriteMask_All })
  var frags: List(WGPUFragmentState) = createList(WGPUFragmentState, cap: 1)
  frags.add(value: {
    module: shaderMod, entryPoint: { data: gbEntryFs(), length: WGPU_STRLEN },
    targetCount: 1 as UInt64, targets: targets.data
  })
  let desc: WGPURenderPipelineDescriptor = {
    vertex: { module: shaderMod, entryPoint: { data: gbEntryVs(), length: WGPU_STRLEN } },
    primitive: {
      topology: WGPUPrimitiveTopology_TriangleList,
      frontFace: WGPUFrontFace_CCW, cullMode: WGPUCullMode_None
    },
    multisample: { count: 1 as UInt32, mask: 4294967295 as UInt32 },
    fragment: frags.data
  }
  let pipeline: Ptr = wgpuDeviceCreateRenderPipeline(device: webgpuDevice(), descriptor: desc)
  wgpuShaderModuleRelease(shaderModule: shaderMod)
  ret pipeline
}

# One fullscreen pass (clear + draw 3) into `target` with `pipeline` + `bind`.
func runFullscreen(pipeline: copy Ptr, bind: copy Ptr, target: copy Ptr) {
  let encDesc: WGPUCommandEncoderDescriptor = { nextInChain: webgpuNull() }
  let enc: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encDesc)
  var atts: List(WGPURenderPassColorAttachment) = createList(WGPURenderPassColorAttachment, cap: 1)
  atts.add(value: {
    view_: target, depthSlice: WGPU_DEPTH_SLICE_UNDEFINED as UInt32,
    loadOp: WGPULoadOp_Clear, storeOp: WGPUStoreOp_Store
  })
  let rpDesc: WGPURenderPassDescriptor = {
    colorAttachmentCount: 1 as UInt64, colorAttachments: atts.data
  }
  let pass: Ptr = wgpuCommandEncoderBeginRenderPass(commandEncoder: enc, descriptor: rpDesc)
  wgpuRenderPassEncoderSetPipeline(renderPassEncoder: pass, pipeline: pipeline)
  wgpuRenderPassEncoderSetBindGroup(renderPassEncoder: pass, groupIndex: 0 as UInt32,
    group: bind, dynamicOffsetCount: 0 as UInt64, dynamicOffsets: webgpuNull())
  wgpuRenderPassEncoderDraw(renderPassEncoder: pass, vertexCount: 3 as UInt32,
    instanceCount: 1 as UInt32, firstVertex: 0 as UInt32, firstInstance: 0 as UInt32)
  wgpuRenderPassEncoderEnd(renderPassEncoder: pass)
  let cbDesc: WGPUCommandBufferDescriptor = { nextInChain: webgpuNull() }
  let cmd: Ptr = wgpuCommandEncoderFinish(commandEncoder: enc, descriptor: cbDesc)
  gbSubmit(cmd: cmd)
  wgpuCommandBufferRelease(commandBuffer: cmd)
  wgpuRenderPassEncoderRelease(renderPassEncoder: pass)
  wgpuCommandEncoderRelease(commandEncoder: enc)
}

var gCompositePipeMade: Bool = false
var gCompositeBindGen: Int = -1
var gCompositeBindMade: List(Bool) = createList(Bool, cap: 3)
var gCompositeUniform: List(Float) = createList(Float, cap: 4)

func compositeSlotMade(idx: copy Int) ret Bool {
  if let made: Bool = gCompositeBindMade.get(index: idx) { ret made }
  ret false
}

# Composite the lit/TAA result into the presentable target with exposure.
func composite(exposure: copy Float) pub {
  if gbDeferredPrepare() is 0 { ret }

  if not gCompositePipeMade {
    gCompositePipeMade = true
    gbSetCompositePipeline(pipeline: makeFullscreenPipeline(wgsl: gbCompositeWgsl(), format: g2dFormat() as Int32))
    let ud: WGPUBufferDescriptor = {
      usage: WGPUBufferUsage_Uniform + WGPUBufferUsage_CopyDst, size: 16 as UInt64
    }
    gbSetCompositeUbuf(buf: wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: ud))
  }

  # The source bind is per TAA slot (0/1) or the no-TAA lit slot (2), rebuilt
  # when the targets change (C released the old handle then).
  loop gCompositeBindMade.length < 3 { gCompositeBindMade.add(value: false) }
  let gen: Int = gbTargetsGen()
  if not (gen is gCompositeBindGen) {
    gCompositeBindGen = gen
    gCompositeBindMade.set(index: 0, value: false)
    gCompositeBindMade.set(index: 1, value: false)
    gCompositeBindMade.set(index: 2, value: false)
  }
  let idx: Int = gbCompositeSourceIndex()
  if not compositeSlotMade(idx: idx) {
    let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: gbCompositePipeline(), groupIndex: 0 as UInt32)
    var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 2)
    entries.add(value: { binding: 0 as UInt32, buffer: gbCompositeUbuf(), size: 16 as UInt64 })
    entries.add(value: { binding: 1 as UInt32, textureView: gbCompositeSourceView() })
    let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 2 as UInt64, entries: entries.data }
    gbSetCompositeBind(idx: idx, bind: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
    wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
    gCompositeBindMade.set(index: idx, value: true)
  }

  loop gCompositeUniform.length < 4 { gCompositeUniform.add(value: 0.0) }
  gCompositeUniform.set(index: 0, value: exposure)
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: gbCompositeUbuf(),
    bufferOffset: 0 as UInt64, data: gCompositeUniform.data, size: 16 as UInt64)

  runFullscreen(pipeline: gbCompositePipeline(), bind: gbCompositeBind(idx: idx), target: g2dOffView())
}

# Public wrapper: the render graph's composite step (was gbuffer.compositePass).
func compositePass(exposure: view Float) pub {
  composite(exposure: exposure)
}

# ----- SSAO: screen-space ambient occlusion (#504) ---------------------------
# Reads the G-buffer normal (A) + depth, writes the R8 AO target. The uniform
# (inverse jittered viewProj + camera pos) is C math, uploaded into the shared
# light uniform by gbSsaoUpload.
func gbSsaoUpload(camX: Float, camY: Float, camZ: Float) extern("rae_gb_ssao_upload")
func gbAoWgsl() extern("rae_gb_ao_wgsl") ret Ptr
func gbAoView() extern("rae_gb_ao_view") ret Ptr
func gbAoPipeline() extern("rae_gb_ao_pipeline") ret Ptr
func gbAoBind() extern("rae_gb_ao_bind") ret Ptr
func gbLightUbuf() extern("rae_gb_light_ubuf") ret Ptr
func gbLightBytes() extern("rae_gb_light_bytes") ret Int
func gbSetAoPipeline(pipeline: Ptr) extern("rae_gb_set_ao_pipeline")
func gbSetAoBind(bind: Ptr) extern("rae_gb_set_ao_bind")

var gAoPipeMade: Bool = false
var gAoBindGen: Int = -1
var gAoBindMade: Bool = false

func ssao(camX: copy Float, camY: copy Float, camZ: copy Float) pub {
  if gbDeferredPrepare() is 0 { ret }
  if not gAoPipeMade {
    gAoPipeMade = true
    gbSetAoPipeline(pipeline: makeFullscreenPipeline(wgsl: gbAoWgsl(), format: WGPUTextureFormat_R8Unorm))
  }
  gbSsaoUpload(camX: camX, camY: camY, camZ: camZ)
  let gen: Int = gbTargetsGen()
  if not (gen is gAoBindGen) {
    gAoBindGen = gen
    gAoBindMade = false
  }
  if not gAoBindMade {
    gAoBindMade = true
    let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: gbAoPipeline(), groupIndex: 0 as UInt32)
    var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 3)
    entries.add(value: { binding: 0 as UInt32, buffer: gbLightUbuf(), size: gbLightBytes() as UInt64 })
    entries.add(value: { binding: 1 as UInt32, textureView: gbViewA() })
    entries.add(value: { binding: 2 as UInt32, textureView: gbViewDepth() })
    let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 3 as UInt64, entries: entries.data }
    gbSetAoBind(bind: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
    wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
  }
  runFullscreen(pipeline: gbAoPipeline(), bind: gbAoBind(), target: gbAoView())
}

# Public wrapper: the render graph's SSAO step (was gbuffer.ssaoPass).
func ssaoPass(camera: view Camera3d) pub {
  ssao(camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z)
}

# ----- lighting: the deferred shading pass (#504) ----------------------------
# Reads the whole G-buffer + AO + the shadow cascades, writes linear HDR
# radiance into the lit target. The large uniform (inverse viewProj + camera/
# sun/sky params + the Rae-cooked Hosek state) is C frame-math, uploaded by
# gbLightUpload; Rae builds the 9-entry bind and runs the pass. The lighting
# pipeline stays C for now (its creation guards the shared init block).
func gbLightUpload(camX: Float, camY: Float, camZ: Float, exposure: Float, sunX: Float, sunY: Float, sunZ: Float, sunR: Float, sunG: Float, sunB: Float, skyR: Float, skyG: Float, skyB: Float, gndR: Float, gndG: Float, gndB: Float, skyKind: Float, turbidity: Float, skyExposure: Float, sunSizeRad: Float, zenR: Float, zenG: Float, zenB: Float, bands: Float, horR: Float, horG: Float, horB: Float, discI: Float) extern("rae_gb_light_upload")
func skyHosekPush(index: Int, value: Float) extern("rae_ext_gbuffer_skyHosekPush")
func gbLightPipeline() extern("rae_gb_light_pipeline") ret Ptr
func gbLitView() extern("rae_gb_lit_view") ret Ptr
func gbLightBind() extern("rae_gb_light_bind") ret Ptr
func gbSetLightBind(bind: Ptr) extern("rae_gb_set_light_bind")
func gbShadowFrameUbuf() extern("rae_gb_shadow_frame_ubuf") ret Ptr
func gbShadowFrameBytes() extern("rae_gb_shadow_frame_bytes") ret Int
func gbShadowArrayView() extern("rae_gb_shadow_array_view") ret Ptr
func gbShadowSampler() extern("rae_gb_shadow_sampler") ret Ptr

var gLightBindGen: Int = -1
var gLightBindMade: Bool = false

# Cooked Hosek-Wilkie coefficients pushed before lighting; three vec4 per
# channel, matching the WGSL `hosek` layout.
func pushHosekChannel(c: view HosekChannel, base: view Int) {
  skyHosekPush(index: base + 0, value: c.a)
  skyHosekPush(index: base + 1, value: c.b)
  skyHosekPush(index: base + 2, value: c.c)
  skyHosekPush(index: base + 3, value: c.d)
  skyHosekPush(index: base + 4, value: c.e)
  skyHosekPush(index: base + 5, value: c.f)
  skyHosekPush(index: base + 6, value: c.g)
  skyHosekPush(index: base + 7, value: c.h)
  skyHosekPush(index: base + 8, value: c.i)
  skyHosekPush(index: base + 9, value: c.radiance)
}

# Low-level lighting: upload the uniform (C), build the bind (rebuilt on resize),
# run the fullscreen pass into the lit target.
func lighting(camX: copy Float, camY: copy Float, camZ: copy Float, exposure: copy Float,
              sunX: copy Float, sunY: copy Float, sunZ: copy Float,
              sunR: copy Float, sunG: copy Float, sunB: copy Float,
              skyR: copy Float, skyG: copy Float, skyB: copy Float,
              gndR: copy Float, gndG: copy Float, gndB: copy Float,
              skyKind: copy Float, turbidity: copy Float, skyExposure: copy Float,
              sunSizeRad: copy Float, zenR: copy Float, zenG: copy Float, zenB: copy Float,
              bands: copy Float, horR: copy Float, horG: copy Float, horB: copy Float,
              discI: copy Float) {
  if gbDeferredPrepare() is 0 { ret }
  gbLightUpload(camX: camX, camY: camY, camZ: camZ, exposure: exposure,
    sunX: sunX, sunY: sunY, sunZ: sunZ, sunR: sunR, sunG: sunG, sunB: sunB,
    skyR: skyR, skyG: skyG, skyB: skyB, gndR: gndR, gndG: gndG, gndB: gndB,
    skyKind: skyKind, turbidity: turbidity, skyExposure: skyExposure, sunSizeRad: sunSizeRad,
    zenR: zenR, zenG: zenG, zenB: zenB, bands: bands, horR: horR, horG: horG, horB: horB, discI: discI)
  let gen: Int = gbTargetsGen()
  if not (gen is gLightBindGen) {
    gLightBindGen = gen
    gLightBindMade = false
  }
  if not gLightBindMade {
    gLightBindMade = true
    let layout: Ptr = wgpuRenderPipelineGetBindGroupLayout(renderPipeline: gbLightPipeline(), groupIndex: 0 as UInt32)
    var entries: List(WGPUBindGroupEntry) = createList(WGPUBindGroupEntry, cap: 9)
    entries.add(value: { binding: 0 as UInt32, buffer: gbLightUbuf(), size: gbLightBytes() as UInt64 })
    entries.add(value: { binding: 1 as UInt32, textureView: gbViewA() })
    entries.add(value: { binding: 2 as UInt32, textureView: gbViewB() })
    entries.add(value: { binding: 3 as UInt32, textureView: gbViewC() })
    entries.add(value: { binding: 4 as UInt32, textureView: gbViewDepth() })
    entries.add(value: { binding: 5 as UInt32, textureView: gbAoView() })
    entries.add(value: { binding: 6 as UInt32, buffer: gbShadowFrameUbuf(), size: gbShadowFrameBytes() as UInt64 })
    entries.add(value: { binding: 7 as UInt32, textureView: gbShadowArrayView() })
    entries.add(value: { binding: 8 as UInt32, sampler: gbShadowSampler() })
    let desc: WGPUBindGroupDescriptor = { layout: layout, entryCount: 9 as UInt64, entries: entries.data }
    gbSetLightBind(bind: wgpuDeviceCreateBindGroup(device: webgpuDevice(), descriptor: desc))
    wgpuBindGroupLayoutRelease(bindGroupLayout: layout)
  }
  runFullscreen(pipeline: gbLightPipeline(), bind: gbLightBind(), target: gbLitView())
}

# Public: lighting with a bound sky environment (Hosek ambient + background).
func lightingPassSky(camera: view Camera3d, light: view Light3d, sky: view Sky) pub {
  let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  let down: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0 - 1.0)
  let skyC: Vec3 = skyIrradiance(sky: sky, n: up)
  let gndC: Vec3 = skyIrradiance(sky: sky, n: down)
  pushHosekChannel(c: sky.hosek.r, base: 0)
  pushHosekChannel(c: sky.hosek.g, base: 12)
  pushHosekChannel(c: sky.hosek.b, base: 24)
  lighting(
    camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
    exposure: light.exposure,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    skyR: skyC.x, skyG: skyC.y, skyB: skyC.z,
    gndR: gndC.x, gndG: gndC.y, gndB: gndC.z,
    skyKind: skyKindCode(sky: sky), turbidity: sky.turbidity,
    skyExposure: sky.exposure, sunSizeRad: sky.sunAngularRadius,
    zenR: sky.zenithColor.x, zenG: sky.zenithColor.y, zenB: sky.zenithColor.z,
    bands: sky.bands,
    horR: sky.horizonColor.x, horG: sky.horizonColor.y, horB: sky.horizonColor.z,
    discI: sky.sunDiscIntensity
  )
}

# Public: lighting with the authored ambient hemisphere, no sky.
func lightingPass(camera: view Camera3d, light: view Light3d) pub {
  lighting(
    camX: camera.position.x, camY: camera.position.y, camZ: camera.position.z,
    exposure: light.exposure,
    sunX: light.sunDir.x, sunY: light.sunDir.y, sunZ: light.sunDir.z,
    sunR: light.sunColor.x, sunG: light.sunColor.y, sunB: light.sunColor.z,
    skyR: light.ambSky.x, skyG: light.ambSky.y, skyB: light.ambSky.z,
    gndR: light.ambGround.x, gndG: light.ambGround.y, gndB: light.ambGround.z,
    skyKind: 0.0, turbidity: 3.0, skyExposure: 1.0, sunSizeRad: 0.0047,
    zenR: 0.0, zenG: 0.0, zenB: 0.0, bands: 1.0,
    horR: 0.0, horG: 0.0, horB: 0.0, discI: 0.0
  )
}
