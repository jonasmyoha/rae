# A Rae host for the module tools/wasm-module-check.sh builds from
# compiler/tests/wasmModule (docs/wasm-modules.md): it runs it in lib/wasm
# (docs/wasm-embedding.md) with the minimal WASI granted, and calls `add` and
# `greet` through the module ABI (a String in through raeModuleAlloc, a
# String result packed as address << 32 | length). Then, built from the same
# frame types as the module (the `frames` package, tests/wasmFrames), it
# checks the module's rae.interface and runs 1000 AppFrameIn -> AppFrameOut
# frames through wasm/WasmInterface (docs/wasm-interfaces.md §5); a module
# built from a changed AppFrameIn is refused before any call. The module's
# path is $RAE_WASM_MODULE, the changed one's $RAE_WASM_CHANGED_MODULE.
import String
open Sys
open wasm/Wasm
open wasm/WasiMinimal
open wasm/WasmInterface
open crypto/CryptoBytes
open frames/Frames

type Host {
  output: WasiOutput
  describeCalls: Int
}

# The typed host import rae.describe (docs/wasm-interfaces.md §6), answered
# with the typed helpers: a Command in, a Command out; a factor over 100
# answers a name longer than the module's buffer.
func hostDescribe(
  host: mod Host
  instance: mod WasmInstance
  call: view WasmHostCall
) ret WasmHostAnswer {
  host.describeCalls = host.describeCalls + 1
  let factor: Int = call.args.copyAtFallback(index: 2, fallback: wasmI64(value: 0)).integer
  if let command: Command = wasmCallValue(
    Command
    instance: instance
    call: call
    at: 0
  ) {
    var name: String = "{command.name} x{factor} (from Rae)"
    if factor > 100 {
      name = ""
      loop var i: Int = 0, i < factor, ++i {
        name = "{name}y"
      }
    }
    let answer: Command = { name: name, count: command.count * (factor as Int32) }
    ret wasmAnswerValue(
      Command
      instance: instance
      call: call
      value: answer
    )
  }
  ret wasmTrap(message: "describe: the command does not decode")
}

func wasmHostCall(
  host: mod Host
  instance: mod WasmInstance
  call: view WasmHostCall
) ret WasmHostAnswer {
  if call.module is "rae" and call.name is "describe" {
    ret hostDescribe(host: host, instance: instance, call: call)
  }
  if let answer: WasmHostAnswer = wasiMinimalAnswer(
    instance: instance
    call: call
    output: host.output
  ) {
    ret answer
  }
  ret wasmTrap(message: "no host function {call.module}.{call.name}")
}

func first(result: view WasmCallResult) ret Int {
  ret result.values.copyAtFallback(index: 0, fallback: wasmI32(value: 0)).integer
}

# greet(name, times) through the module ABI
func greet(
  host: mod Host
  instance: mod WasmInstance
  name: view String
  times: view Int
) ret String {
  let bytes: List(UInt8) = bytesOfText(text: name)
  let address: Int = first(result: wasmCall(
    Host
    host: host
    instance: instance
    name: "raeModuleAlloc"
    args: { wasmI32(value: bytes.length) }
    timeoutMs: 1000
  ))
  let written: Bool = wasmMemoryWrite(instance: instance, address: address, bytes: bytes)
  let packed: Int = first(result: wasmCall(
    Host
    host: host
    instance: instance
    name: "greet"
    args: { wasmI32(value: address), wasmI32(value: bytes.length), wasmI64(value: times) }
    timeoutMs: 1000
  ))
  let freedName: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: "raeModuleFree"
    args: { wasmI32(value: address) }
    timeoutMs: 1000
  )
  let resultAddress: Int = (packed shr 32) bitand 4294967295
  let resultLength: Int = packed bitand 4294967295
  var text: String = ""
  if let answer: List(UInt8) = wasmMemoryRead(
    instance: instance
    address: resultAddress
    count: resultLength
  ) {
    text = String.fromBytes(bytes: answer, start: 0, count: resultLength)
  }
  if resultAddress is not 0 {
    let freedAnswer: WasmCallResult = wasmCall(
      Host
      host: host
      instance: instance
      name: "raeModuleFree"
      args: { wasmI32(value: resultAddress) }
      timeoutMs: 1000
    )
  }
  ret text
}

func moduleBytes(path: view String) ret List(UInt8) {
  let raw: List(Int) = readFileBytes(path: path)
  var bytes: List(UInt8) = List.create(UInt8, cap: raw.length)
  loop let byte: view Int in raw {
    bytes.add(value: byte as UInt8)
  }
  ret bytes
}

# The host's own view of summarize: its parameter and result types.
func checkSummarize(module: view WasmModule) ret opt WasmError {
  ret wasmCheckExport(
    module: module
    name: "summarize"
    params: { binarySchemaText(AppFrameIn) }
    result: binarySchemaText(AppFrameOut)
  )
}

func frameNumber(index: view Int) ret AppFrameIn {
  var commands: List(Command) = List.create(Command, cap: 2)
  commands.add(value: Command { name: "tap", count: (index % 5) as Int32 })
  commands.add(value: Command { name: "scroll", count: 1 })
  ret AppFrameIn { commands: commands, mood: Mood.calm, note: "frame {index}" }
}

func runFrames(host: mod Host, instance: mod WasmInstance, module: view WasmModule) {
  if let described: WasmInterface = wasmModuleInterface(module: module) {
    log("rae.interface version {described.version}, {described.exports.length} exports")
  }
  if let mismatch: WasmError = checkSummarize(module: module) {
    log("summarize refused: {mismatch.message}")
    ret
  }
  log("summarize matches the host's AppFrameIn -> AppFrameOut")
  let memoryBefore: Int = wasmMemorySize(instance: instance)
  var total: Int = 0
  var decoded: Int = 0
  var lastNames: String = ""
  loop var i: Int = 0, i < 1000, ++i {
    let frame: AppFrameIn = frameNumber(index: i)
    let input: List(UInt8) = frame.toBinary()
    let reply: WasmBytesResult = wasmCallEncoded(
      Host
      host: host
      instance: instance
      name: "summarize"
      input: input
      timeoutMs: 1000
    )
    if wasmFailed(error: reply.error) {
      log("frame {i}: {reply.error.kind} {reply.error.message}")
      ret
    }
    if let out: AppFrameOut = AppFrameOut.fromBinary(bytes: reply.bytes) {
      total = total + out.total
      decoded = decoded + 1
      lastNames = "{out.names}"
    }
  }
  log("1000 frames: {decoded} decoded, totals {total}, the last '{lastNames}'")
  let grown: Int = wasmMemorySize(instance: instance) - memoryBefore
  log("the module's memory grew by more than 1 MiB: {grown > 1048576}")
}

# useDescribe(command, factor) through the module ABI: the command encoded
# at (address, length), the factor an i64; the Command answer packed.
func useDescribe(
  host: mod Host
  instance: mod WasmInstance
  command: view Command
  factor: view Int
) ret String {
  let input: List(UInt8) = command.toBinary()
  let allocated: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: "raeModuleAlloc"
    args: { wasmI32(value: input.length) }
    timeoutMs: 1000
  )
  let address: Int = first(result: allocated)
  let written: Bool = wasmMemoryWrite(instance: instance, address: address, bytes: input)
  let called: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: "useDescribe"
    args: { wasmI32(value: address), wasmI32(value: input.length), wasmI64(value: factor) }
    timeoutMs: 1000
  )
  let freed: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: "raeModuleFree"
    args: { wasmI32(value: address) }
    timeoutMs: 1000
  )
  if wasmFailed(error: called.error) {
    ret "{called.error.kind}: {called.error.message}"
  }
  let packed: Int = first(result: called)
  let resultAddress: Int = (packed shr 32) bitand 4294967295
  let resultLength: Int = packed bitand 4294967295
  var text: String = "no answer"
  if let bytes: List(UInt8) = wasmMemoryRead(
    instance: instance
    address: resultAddress
    count: resultLength
  ) {
    if let answer: Command = Command.fromBinary(bytes: bytes) {
      if answer.name.length() > 60 {
        text = "a name of {answer.name.length()} bytes, count {answer.count}"
      } else {
        text = "{answer.name}, count {answer.count}"
      }
    }
  }
  let freedResult: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: "raeModuleFree"
    args: { wasmI32(value: resultAddress) }
    timeoutMs: 1000
  )
  ret text
}

func gameCapabilities() ret List(WasmCapability) {
  var exposed: List(WasmCapability) = wasiMinimalCapabilities()
  exposed.add(value: WasmCapability { name: "game", imports: { "rae.describe" } })
  ret exposed
}

# A module built from another AppFrameIn: refused by the check, never called.
func checkChanged(path: view String) {
  if path.length() is 0 {
    ret
  }
  var changed: WasmModule = wasmLoad(bytes: moduleBytes(path: path))
  if let mismatch: WasmError = checkSummarize(module: changed) {
    log("a module built from a changed AppFrameIn: {mismatch.kind}")
    log("  {mismatch.message}")
  } else {
    log("a module built from a changed AppFrameIn: accepted (wrong)")
  }
  wasmUnload(module: changed)
}

func main() {
  let path: String = getEnv(name: "RAE_WASM_MODULE")
  var module: WasmModule = wasmLoad(bytes: moduleBytes(path: path))
  log("loaded: {module.error.kind}")
  let exposesNothing: List(WasmCapability) = List.create(WasmCapability, cap: 1)
  let without: WasmInstance = wasmInstantiate(
    module: module
    exposed: exposesNothing
    granted: {}
    limits: wasmDefaultLimits()
  )
  log("on a host that exposes nothing: {without.error.kind}")
  var instance: WasmInstance = wasmInstantiate(
    module: module
    exposed: gameCapabilities()
    granted: { "log", "clock", "game" }
    limits: wasmDefaultLimits()
  )
  log("with log, clock and game granted: {instance.error.kind}")
  var host: Host = { output: createWasiOutput(), describeCalls: 0 }
  let initialized: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: "_initialize"
    args: {}
    timeoutMs: 1000
  )
  log("_initialize: {initialized.error.kind}")
  log("add(40, 2) = {first(result: wasmCall(
    Host
    host: host
    instance: instance
    name: "add"
    args: { wasmI64(value: 40), wasmI64(value: 2) }
    timeoutMs: 1000
  ))}")
  log("greet = {greet(
    host: host
    instance: instance
    name: "Pähkinä"
    times: 2
  )}")
  runFrames(host: host, instance: instance, module: module)
  let lamp: Command = { name: "lamp", count: 4 }
  log("useDescribe: {useDescribe(
    host: host
    instance: instance
    command: lamp
    factor: 3
  )}")
  log("useDescribe, a 3000-byte answer: {useDescribe(
    host: host
    instance: instance
    command: lamp
    factor: 3000
  )}")
  wasmDestroy(instance: instance)
  # game requested but not granted: the import traps in lib/wasm
  var ungranted: WasmInstance = wasmInstantiate(
    module: module
    exposed: gameCapabilities()
    granted: { "log", "clock" }
    limits: wasmDefaultLimits()
  )
  let initializedAgain: WasmCallResult = wasmCall(
    Host
    host: host
    instance: ungranted
    name: "_initialize"
    args: {}
    timeoutMs: 1000
  )
  let callsBefore: Int = host.describeCalls
  log("game not granted: {useDescribe(
    host: host
    instance: ungranted
    command: lamp
    factor: 3
  )}")
  log("  the host's describe ran: {host.describeCalls is not callsBefore}")
  wasmDestroy(instance: ungranted)
  wasmUnload(module: module)
  checkChanged(path: getEnv(name: "RAE_WASM_CHANGED_MODULE"))
}
