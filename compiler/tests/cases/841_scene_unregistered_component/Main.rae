import Json
import String
import ui/Components
open ui/Ecs
open ui/Registry
open ui/Scene
open ui/SceneLoader
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems

# A well-formed scene whose one node carries `Wibble` — a name that is NOT a
# known component at all (a typo, or a non-UI component authored into a UI
# scene). The loader must fail loudly with the "not registered" form, naming the
# scene, node and component. `\{`/`\}` keep the JSON braces literal.
func typoScene() ret String {
  var s: String = ""
  s = s.concat(other: "\{")
  s = s.concat(other: "\"type\":\"Scene\",")
  s = s.concat(other: "\"version\":2,")
  s = s.concat(other: "\"root\":\"Root\",")
  s = s.concat(other: "\"nodes\":\{")
  s = s.concat(other: "\"Root\":\{")
  s = s.concat(other: "\"Wibble\":\{\"x\":1\}")
  s = s.concat(other: "\}")
  s = s.concat(other: "\}")
  s = s.concat(other: "\}")
  ret s
}

func main() {
  let scene: Scene = parseScene(source: typoScene())
  scene.sceneId = "fx-demo"
  log("scene.ok = {scene.ok}")
  let world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  log("loading scene with an unregistered component...")
  let rootEntityId: EntityId = loadScene(world: world, uiSystems: uiSystems, scene: scene)
  # An unregistered name is no longer the loader's verdict: it waits in the
  # pending outbox for an app system to claim it. With no app tables, every
  # pending component is unknown — reporting it is the #941 exit.
  reportPendingComponents(world: world)
  # Unreachable: loadScene aborts on the unregistered component (#941).
  log("unreachable rootEntity = {rootEntityId.index}")
}
