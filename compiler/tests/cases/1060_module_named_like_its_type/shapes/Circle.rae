# A module named like the type it is built around
type Circle {
  radius: Int
}

func createCircle(radius: view Int) ret Circle {
  ret Circle { radius: radius }
}

func grow(circle: mod Circle, by: view Int) {
  circle.radius = circle.radius + by
}

func describe(circle: view Circle) ret String {
  ret "circle of radius {circle.radius}"
}
