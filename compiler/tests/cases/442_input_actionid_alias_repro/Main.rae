# Repro for a double-free (SIGABRT in a UiWorld drop) when an action event
# aliases an OnClick's heap `actionId` String instead of deep-copying it.
#
# Hypothesis (the bug this guards against): appendActionEvent stores its
# `actionId` argument by SHALLOW alias. When the input system drops (its
# events list cascade-drops each ActionEvent's actionId), the heap bytes are
# freed. Then when the world drops, the OnClick's actionId field frees the
# same bytes again — double-free, libmalloc aborts.
#
# Self-contained since #955 (the raylib UI backend, whose Input module this
# used to `open`, was removed): a minimal ActionEvent / InputSystem stands in
# for it, keeping the exact aliasing shape the compiler must handle —
#   - one entity with an OnClick whose actionId is a long-enough String to be
#     heap-allocated (short strings might be inlined)
#   - input has an ActionEvent referencing that actionId
#   - input drops first (inner scope), world drops second (outer)
import String
open ui/Ecs
import ui/Components
open ecs/Entity
open ecs/ComponentTable

# A minimal stand-in for the removed backend's input system: an event carries
# its own owned actionId, so appending one must DEEP-COPY the source String.
type ActionEvent {
  entity: EntityId
  actionId: String
}

type InputSystem {
  events: List(ActionEvent)
}

func createInputSystem() ret InputSystem {
  ret InputSystem { events: List.create(ActionEvent, cap: 4) }
}

func appendActionEvent(input: mod InputSystem, entity: view EntityId, actionId: view String) {
  var copied: String = ""
  copied = copied.concat(other: actionId)
  input.events.add(value: ActionEvent { entity: entity, actionId: own copied })
}

func main() {
  let world: UiWorld = createUiWorld()
  let entity: EntityId = createEntity(world: world)
  let oc: OnClick = {
    actionId: "playback.toggle.long.string"
    actionIdDouble: ""
    actionIdTriple: ""
    maxDelayMs: 0
  }
  componentSet(this: world.onClicks, entity: entity, data: oc)

  if true {
    let input: InputSystem = createInputSystem()
    let ocView: view OnClick => componentView(this: world.onClicks, entity: entity)
    appendActionEvent(input: input, entity: entity, actionId: ocView.actionId)
    log("appended action event; input has {input.events.length} events")
  }
  # `input` dropped here. Now we drop `world` at end of main —
  # if appendActionEvent aliased the actionId, this is a double-free.
  log("about to drop world")
}
