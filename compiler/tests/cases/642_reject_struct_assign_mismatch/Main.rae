# Assigning one struct type to a variable of a different struct type is a type
# error. It used to pass sema and be caught only by the C compiler against
# generated code (a .c line); now sema reports it at the .rae site (#414).
import core

type Meters {
  v: Float
}

type Seconds {
  v: Float
}

func main() {
  var distance: Meters = { v: 10.0 }
  let elapsed: Seconds = { v: 5.0 }
  distance = elapsed
  log("{distance.v}")
}
