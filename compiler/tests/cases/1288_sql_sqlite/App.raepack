pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep sql: {
      git: "../../../.."
      subdir: "packages/sql"
      version: "1.0.0"
      hash: "git-tree:a60e5bd3cfc19c3389a2ca1941ae266b9c7b3485"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
