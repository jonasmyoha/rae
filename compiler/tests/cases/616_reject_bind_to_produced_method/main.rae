# The method-call twin of 615: `l.copyAt(index:)` returns an optional owned value;
# it cannot bind directly to a reference. Test 610 covers `viewAt`, which
# returns an optional reference and narrows through `if let`.
import core

type Track {
  title: String
  seconds: Int
}

func main() {
  var l: List(Track) = createList(Track, cap: 1)
  l.add(value: Track { title: "first", seconds: 1 })
  let e: view Track => l.copyAt(index: 0)
  log("should not run")
}
