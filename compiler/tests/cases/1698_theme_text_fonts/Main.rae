# A theme with more than one text font (docs/ui-scene-format.md §4): `assets.fonts` declares
# `text` (the bundled Roboto) and `cards` (a second atlas: the Material icons). Each text is "A"
# and an icon's codepoint, which only Roboto and only the icons have, so each font measures it
# otherwise. A style with `"font": "cards"` draws and
# measures in it, a StyleOverride's `font` wins over the style's, and a style naming a font the
# scene does not declare (`crads`) falls back to the first with one diagnostic. Each font keeps its
# atlas: the frame's glyphs are batched under two.
import SdfText
import Gpu2d
open ui/Components
open ui/Ecs
open ui/Scene
open ui/SceneFile
open ui/SceneImports
open ui/SceneLoader
open ui/ScenePolicy
open ui/ThemeParse
open ui/Theme
open ui/UiSystems
open ui/RenderSystem
open ui/LayoutSystem
open ecs/ComponentTable
open ecs/Entity
open Gpu2dCanvas
open Gpu2dCanvasClip
open app3d/UiShell
open app3d/UiFonts

const directory: String = "tests/cases/1698_theme_text_fonts/"

func nodeOf(world: view UiWorld, nodeId: view String) ret EntityId {
  if let index: Int = world.nodeIds.get(k: nodeId) {
    ret nodeEntityId(world: world, index: index)
  }
  ret noEntity()
}

func shownText(world: view UiWorld, entityId: view EntityId) ret String {
  ret "{componentView(this: world.texts, entityId: entityId).text}"
}

func main() {
  let scene: Scene = loadSceneFile(path: "{directory}Fonts.raescene")
  var assets: SceneAssets = createSceneAssets()
  var diagnostics: List(SceneDiagnostic) = {}
  collectSceneAssetsBlock(
    assets: assets
    scene: scene
    directory: directory
    sceneLabel: "fonts"
    diagnostics: diagnostics
  )
  log("declared: text {assets.textFontPath.length() > 0}, others {assets.fontNames}")
  var resources: Gpu2dUi = {
    textFont: SdfText.loadSdfFontJson(jsonPath: assets.textFontPath)
    iconFont: SdfText.loadSdfFontJson(jsonPath: assets.textFontPath)
    theme: parseTheme(scene: scene)
    activeTheme: lightTheme()
  }
  loadNamedUiFonts(
    resources: resources
    assets: assets
    diagnostics: diagnostics
    sceneLabel: "fonts"
  )
  reportUnknownStyleFonts(resources: resources, diagnostics: diagnostics, sceneLabel: "fonts")
  log("loaded fonts: {resources.fontNames}, diagnostics {diagnostics.length}")
  Gpu2d.setDesignResolution(width: 600.0, height: 400.0, fit: 0)
  var world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  seedWorldTheme(world: world, res: resources)
  world.layoutW = 600.0
  world.layoutH = 400.0
  let root: EntityId = loadScene(world: world, uiSystems: uiSystems, scene: scene)
  runUiSystems(world: world, uiSystems: uiSystems, res: resources)
  loop let nodeId: String in List(String) { "Label", "Rank", "Typo", "Override" } {
    let entityId: EntityId = nodeOf(world: world, nodeId: nodeId)
    let font: view SdfFont = uiEntityTextFont(world: world, entityId: entityId, res: resources)
    let measured: view MeasuredText = componentView(
      this: uiSystems.layout.measuredTexts
      entityId: entityId
    )
    let fontWidth: Float = SdfText.sdfMeasureText(
      font: font
      text: shownText(world: world, entityId: entityId)
      sizePx: 20.0
    )
    log(
      "{nodeId}: in the {font.jsonPath.endsWith(suffix: "MaterialIconsRound-Regular.mtsdf.json")} second font, measured {measured.w} wide (its font measures {fontWidth})"
    )
  }
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  clipReset(canvas: canvas)
  renderSystemGpu2d(
    world: world
    uiSystems: uiSystems
    res: resources
    canvas: canvas
  )
  var batches: Int = 0
  loop let atlas: view Gpu2dTextAtlas in canvas.textAtlases {
    if atlas.glyphs.length > 0 {
      batches = batches + 1
    }
  }
  log("glyph batches with glyphs: {batches}")
}
