# #71098456: a pooled ListView takes its width from LAYOUT, not from its
# authored Rect. A list authored `Size: { w: Fill, h: Hug }` inside a padded
# parent: its pooled rows fill the list's computed content width, the list's
# own height is min(rows, visibleItemCount) pitches minus the last gap, and a
# narrower layout extent re-widths the rows on the next layout — no code
# writes a Rect anywhere.
import Json
import String
import ui/Components
open ui/Ecs
import ui/Registry
open ui/Scene
open ui/SceneLoader
open ui/listViewSystem/ListViewSystem
open ui/SceneInstance
open ui/layoutSystem/LayoutSystem
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems

func pageScene() ret String {
  var s: String = ""
  s = s.concat(other: "\{\"type\":\"Scene\",\"version\":2,\"root\":\"Page\",\"nodes\":\{")
  s = s.concat(other: "\"Page\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":0,\"h\":0\},")
  s = s.concat(other: "\"Size\":\{\"w\":\{\"mode\":\"Fill\"\},\"h\":\{\"mode\":\"Fill\"\}\},")
  s = s.concat(other: "\"Layout\":\{\"type\":\"Vertical\",\"gap\":0,\"alignCross\":\"Stretch\"\},")
  s = s.concat(
    other: "\"Padding\":\{\"l\":20,\"t\":10,\"r\":20,\"b\":10\},\"Children\":[\"List\"]\},"
  )
  s = s.concat(other: "\"List\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":0,\"h\":0\},")
  s = s.concat(other: "\"Size\":\{\"w\":\{\"mode\":\"Fill\"\},\"h\":\{\"mode\":\"Hug\"\}\},")
  s = s.concat(other: "\"ListView\":\{\"itemKeyField\":\"id\",\"itemHeight\":30,\"itemGap\":4,")
  s = s.concat(other: "\"visibleItemCount\":3,\"overscanRows\":0,\"bindings\":[")
  s = s.concat(
    other: "\{\"nodeId\":\"Label\",\"component\":\"Text\",\"field\":\"text\",\"itemField\":\"label\"\}]\}\}\}\}"
  )
  ret s
}

func dataRow(index: view Int) ret ListViewRow {
  let keys: List(String) = List.create(String, cap: 2)
  let values: List(String) = List.create(String, cap: 2)
  keys.add(value: "id")
  values.add(value: "{index}")
  keys.add(value: "label")
  values.add(value: "row {index}")
  ret ListViewRow { keys: own keys, values: own values }
}

func rowWidths(
  world: view UiWorld
  uiSystems: view UiSystems
  listEntityId: view EntityId
) ret String {
  var out: String = ""
  if componentHas(this: world.childrens, entityId: listEntityId) is false {
    ret "none"
  }
  let children: view Children => componentView(this: world.childrens, entityId: listEntityId)
  loop var i: Int = 0, i < children.ids.length, ++i {
    let row: EntityId = children.ids.copyAtFallback(index: i, fallback: noEntity())
    if componentHas(this: uiSystems.layout.computedRects, entityId: row) {
      let rect: view ComputedRect => componentView(
        this: uiSystems.layout.computedRects
        entityId: row
      )
      out = "{out} {rect.size.x.toInt()}"
    }
  }
  ret out
}

func listSize(
  world: view UiWorld
  uiSystems: view UiSystems
  listEntityId: view EntityId
) ret String {
  if componentHas(this: uiSystems.layout.computedRects, entityId: listEntityId) is false {
    ret "none"
  }
  let rect: view ComputedRect => componentView(
    this: uiSystems.layout.computedRects
    entityId: listEntityId
  )
  ret "{rect.size.x.toInt()}x{rect.size.y.toInt()}"
}

func main() {
  let world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  world.layoutW = 1000.0
  world.layoutH = 800.0
  let page: Scene = parseScene(source: pageScene())
  page.sceneId = "page"
  loadScene(world: world, uiSystems: uiSystems, scene: page)
  var listEntityId: EntityId = noEntity()
  if let raw: Int = world.nodeIds.get(k: "List") {
    listEntityId = id(v: raw)
  }
  let rows: List(ListViewRow) = List.create(ListViewRow, cap: 5)
  loop var i: Int = 0, i < 5, ++i {
    rows.add(value: dataRow(index: i))
  }
  componentSet(
    this: world.listViewDatas
    entityId: listEntityId
    data: ListViewData { rows: own rows }
  )
  let registry: SceneRegistry = createSceneRegistry()
  listViewSystem(world: world, uiSystems: uiSystems, scenes: registry)
  layoutSystem(world: world, uiSystems: uiSystems)
  # 1000 wide page, 20 + 20 padding: the list and every pooled row are 960
  # wide; 3 visible rows of 30 with 4 gaps: 98 tall.
  log("list: {listSize(world: world, uiSystems: uiSystems, listEntityId: listEntityId)} (960x98)")
  log("rows:{rowWidths(world: world, uiSystems: uiSystems, listEntityId: listEntityId)} (960 each)")
  # A narrower extent (a window resize, a panel opening) re-widths the rows
  # through layout alone — the list system did not run again.
  world.layoutW = 600.0
  layoutSystem(world: world, uiSystems: uiSystems)
  log(
    "after resize list: {listSize(world: world, uiSystems: uiSystems, listEntityId: listEntityId)} (560x98)"
  )
  log(
    "after resize rows:{rowWidths(world: world, uiSystems: uiSystems, listEntityId: listEntityId)} (560 each)"
  )
  # Fewer rows than the visible count: the list hugs the rows it has.
  let two: List(ListViewRow) = List.create(ListViewRow, cap: 2)
  two.add(value: dataRow(index: 0))
  two.add(value: dataRow(index: 1))
  componentSet(
    this: world.listViewDatas
    entityId: listEntityId
    data: ListViewData { rows: own two }
  )
  listViewSystem(world: world, uiSystems: uiSystems, scenes: registry)
  layoutSystem(world: world, uiSystems: uiSystems)
  log(
    "two rows list: {listSize(world: world, uiSystems: uiSystems, listEntityId: listEntityId)} (560x64)"
  )
}
