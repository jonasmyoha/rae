# Two project modules (points/Left, points/Right) each declare `type Point`.
# A type belongs to its module: each module uses its own, in literals, lists,
# string conversion and JSON, and the written name stays `Point` in both
# (docs/module-namespacing.md). Main names neither, so it sees no clash.
func main() {
  log("left: {leftSummary()}")
  log("right: {rightSummary()}")
}
