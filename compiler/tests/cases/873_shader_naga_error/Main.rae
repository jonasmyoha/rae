# A part that references a name only a missing part defines is a COMPILE
# error, not a wgpu panic on the first frame: naga's message, with the
# location translated back from the composed text to the part file and line.
func main() {
  let lit: Shader = shader(files: ["assets/helper.wgsl", "assets/lighting.wgsl"])
  log("unreachable {lit.generation}")
}
