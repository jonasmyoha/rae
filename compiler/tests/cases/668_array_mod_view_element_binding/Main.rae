# #654: a `mod` alias to an Array element must ALIAS the storage, not a copy.
# `modAt` hands back a window into the array (like List.modAt), so a write
# through the alias must round-trip: a later `viewAt` read sees it.
type Cell {
  hp: Int
  tag: Int
}

func main() {
  var grid: Array(Cell, cap: 3) = Array(Cell, cap: 3)
  grid.set(index: 1, value: { hp: 5, tag: 0 })

  if let refm: mod Cell => grid.modAt(index: 1) {
    refm.hp = 99
    refm.tag = 7
  }
  if let refv: view Cell => grid.viewAt(index: 1) {
    log("after mod-bind hp={refv.hp} tag={refv.tag}")  # 99, 7 if aliasing
  }

  # A collection loop borrows the elements the same way.
  loop let cell: mod Cell in grid {
    cell.hp = cell.hp + 1
  }
  var total: Int = 0
  loop let cell: view Cell in grid {
    total = total + cell.hp
  }
  log("total hp={total}")  # 100 + 1 + 1
  if let missing: view Cell => grid.viewAt(index: 3) {
    log("wrong {missing.hp}")
  } else {
    log("viewAt(3) is none")
  }
}
