func addDefault(T: type, table: mod ComponentTable(T), entityId: view EntityId) {
  componentSet(this: table, entityId: entityId, data: T.default())
}

# Each named table gains the default component for every selected entity that lacks it
func addToSelection(big: mod Big, selection: view List(EntityId), name: view String) ret Int {
  var added: Int = 0
  loop let table: mod ComponentTable(any) in fields(big) {
    if typeName(table) is name {
      loop let entityId: view EntityId in selection {
        if componentHas(this: table, entityId: entityId) is false {
          addDefault(table: table, entityId: entityId)
          added = added + 1
        }
      }
    }
  }
  ret added
}

func main() {
  var big: Big = makeBig()
  let first: EntityId = { index: 1, generation: 0 }
  let second: EntityId = { index: 2, generation: 0 }
  let selection: List(EntityId) = { first, second }
  log("Part0: {addToSelection(big: big, selection: selection, name: "Part0")} added")
  log(
    "Part129: {addToSelection(big: big, selection: selection, name: "Part129")} added, again {addToSelection(
      big: big
      selection: selection
      name: "Part129"
    )}"
  )
  log(
    "the last table holds its default: {componentView(this: big.part129s, entityId: second).value}"
  )
}
