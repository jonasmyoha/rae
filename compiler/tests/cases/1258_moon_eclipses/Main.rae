# lib/Moon's ephemeris against real eclipses 1980 - 2099 (lib/Eclipses).
# At each solar eclipse's moment and place, seen from there, the moon is
# within 3 arc minutes of the sun at a total, annular or hybrid one, bigger
# than the sun at a total one and smaller at an annular one, and covers
# most of the sun at a partial one's deepest point. At each lunar eclipse
# the moon is all inside the earth's umbra at a total one and partly at a
# partial one, stands well up at the place given, and the shadow takes most
# of its light. And a phase: the full moon of 23 April 2024 (23:49 UT) is
# full, out of the shadow. The invented moons (inventedMoons) stand
# elsewhere, with their own size and color.
import Vec3
open Calendar
open Moon
open Eclipses

func check(label: view String, ok: view Bool) {
  if ok {
    log("ok   {label}")
  } else {
    log("FAIL {label}")
  }
}

func main() ret Int {
  loop let eclipse: view Eclipse in eclipses() {
    let clock: EclipseClock = eclipseClock(eclipse: eclipse)
    let moon: MoonState = moonForDate(
      year: clock.year
      dayOfYear: clock.dayOfYear
      hour: clock.hour
      latitudeDeg: eclipse.latitude
      longitudeDeg: eclipse.longitude
    )
    if eclipse.lunar {
      let shadow: LunarShadow = lunarShadow(
        year: eclipse.year
        dayOfYear: dayOfYearFromDate(
          date: { year: eclipse.year, month: eclipse.month, day: eclipse.day }
        )
        utHours: eclipse.utHours
      )
      let magnitude: Float = umbralMagnitude(shadow: shadow)
      var inside: Bool = magnitude > 0.0 and magnitude < 1.0
      if eclipse.kind is EclipseKind.total {
        inside = magnitude >= 1.0
      }
      check(
        label: eclipseCaption(eclipse: eclipse)
        ok: inside and moon.up > 0.4 and moon.shadowed > 0.5
      )
      continue
    }
    let arcMinutes: Float = moon.sunSeparation * 180.0 / 3.14159265 * 60.0
    let ratio: Float = moon.realRadius / moon.sunRealRadius
    var ok: Bool = arcMinutes < 3.0
    if eclipse.kind is EclipseKind.total {
      ok = ok and ratio > 1.0
    }
    if eclipse.kind is EclipseKind.annular {
      ok = ok and ratio < 1.0
    }
    if eclipse.kind is EclipseKind.partial {
      ok = moon.sunCovered > 0.6
    }
    check(label: eclipseCaption(eclipse: eclipse), ok: ok)
  }
  # the full moon of 23 April 2024, 23:49 UT, from Greenwich
  let full: MoonState = moonForDate(
    year: 2024
    dayOfYear: 114
    hour: 23.8
    latitudeDeg: 51.5
    longitudeDeg: 0.0
  )
  check(
    label: "23 April 2024 23:49 UT: a full moon"
    ok: full.illumination > 0.99 and full.shadowed < 0.01
  )
  let ember: MoonState = moonForBody(
    body: inventedMoons().copyAtDefault(index: 0)
    year: 2024
    dayOfYear: 114
    hour: 23.8
    latitudeDeg: 51.5
    longitudeDeg: 0.0
  )
  check(
    label: "an invented moon: elsewhere, its own size and color"
    ok: Vec3.vdot(a: ember.direction, b: full.direction) < 0.999 and ember.drawRadius is not full.drawRadius and ember.color.y is not full.color.y
  )
  ret 0
}
