# A `spawn thread` target is off the main thread too: reaching a mainThread
# call is refused, and the reason names the spawn thread
# (docs/realtime-language-design.md §4.3, §6.6.1)
func showOnScreen(value: view Int) mainThread {
  let shown: Int = value
}

func pollLoop(rounds: view Int) ret Int {
  loop var i: Int = 0, i < rounds, ++i {
    showOnScreen(value: i)
  }
  ret rounds
}

func main() {
  let poller: Task(Int) = spawn thread pollLoop(rounds: 3)
  log("{poller.get()}")
}
