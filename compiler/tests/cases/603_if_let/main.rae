# `if let` over REFERENCE optionals (spec 4.2): both calls return
# `opt view T` / `opt mod T`, so `=>` narrowing preserves the declared
# relationship — the reference already names storage that exists elsewhere.
# Narrowing an optional reference costs nothing: both are the same pointer.
# (Produced OWNED optionals are taken with `=` instead — test 607.)
import core
type Track { title: String, seconds: Int }
type Library { current: Track, hasCurrent: Bool }

func selected(lib: view Library) ret opt view Track {
  if lib.hasCurrent is false { ret none }
  ret view lib.current
}

func bumpable(lib: mod Library) ret opt mod Track {
  if lib.hasCurrent is false { ret none }
  ret mod lib.current
}

func main() {
  var lib: Library = { current: Track { title: "Outro", seconds: 143 }, hasCurrent: true }

  if let track: view Track => selected(lib: view lib) {
    log("present: {track.title} / {track.seconds}")
  } else {
    log("absent")
  }

  if let track: mod Track => bumpable(lib: mod lib) {
    track.seconds = track.seconds + 1
  }
  log("after mod narrowing: {lib.current.seconds}  (expect 144)")

  lib.hasCurrent = false
  if let track: view Track => selected(lib: view lib) {
    log("should not print: {track.title}")
  } else {
    log("absent branch taken")
  }
}
