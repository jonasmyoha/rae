
# #788 (c3), revisited under the naming rule: module files are PascalCase and
# value bindings are camelCase, so a local can NEVER share a name with a module
# — the "value shadows module" collision class no longer exists by
# construction. A local `pal` and the sibling module `Pal` simply coexist. (The
# old "that local shadows module" diagnostic can no longer be reached.)
func main() {
  let pal: Int = 3
  let viaModule: Int = Pal.shadeOf()
  log("pal={pal} Pal.shadeOf()={viaModule}")
}
