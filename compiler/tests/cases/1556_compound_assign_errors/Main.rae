# What `+=` and a loop's step refuse: a step that changes another variable, a step of a String,
# and `+=` on a `let`
func main() {
  var other: Int = 0
  loop var b: Int = 0, b < 3, other += 1 {
  }
  loop var s: String = "", s.length() < 3, s += "x" {
  }
  let fixed: Int = 1
  fixed += 1
  log("{fixed} {other}")
}
