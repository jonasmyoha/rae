# A negative literal does not fit an unsigned type (`let n: UInt64 = -1` used
# to compile and print 18446744073709551615), and one below a signed type's
# minimum does not fit that type.
func main() {
  let uint8Negative: UInt8 = -1
  let uint16Negative: UInt16 = -1
  let uint32Negative: UInt32 = -7
  let uint64Negative: UInt64 = -1
  let int8Low: Int8 = -129
  let int16Low: Int16 = -32769
  let int32Low: Int32 = -2147483649
  let intLow: Int = -9223372036854775809
}
