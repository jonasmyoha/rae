import String
import ui/Components
open ui/Ecs
open ui/layoutSystem/LayoutSystem
open ui/Transform
open ecs/ComponentTable
open ui/UiSystems

# Build a small ECS world by hand and run layout + transform on it.
# Tree:
#
#   Root  (Vertical, gap=10, padding=20, 400x600)
#   ├── Header  (Horizontal, gap=10, alignCross=Center, 360x80)
#   │     ├── IconA (40x40)
#   │     └── IconB (40x40)
#   ├── Body    (360x100)
#   └── Footer  (360x100)
#
# Then dump each entity's ComputedRect and WorldTransform.
func makeFixedSize() ret Size {
  ret Size {
    w: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
    h: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
  }
}

func setRectFixed(
  world: mod UiWorld
  entityId: view EntityId
  w: view Float
  h: view Float
) {
  let r: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: w, y: h } }
  componentSet(this: world.rects, entityId: entityId, data: r)
  componentSet(this: world.sizes, entityId: entityId, data: makeFixedSize())
}

func setShapeRect(
  world: mod UiWorld
  entityId: view EntityId
  r: view Int
  g: view Int
  b: view Int
) {
  let shape: Shape = {
    kind: ShapeKind.rect
    fill: RgbaColor { r: r, g: g, b: b, a: 255 }
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: 0.0
  }
  componentSet(this: world.shapes, entityId: entityId, data: shape)
}

func attachChildren(
  world: mod UiWorld
  uiSystems: mod UiSystems
  parent: view EntityId
  kids: view List(EntityId)
) {
  unsafe {
    let kidsCopy: List(EntityId) = List.create(EntityId, cap: kids.length)
    var i: Int = 0
    loop i < kids.length {
      let kid: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
      kidsCopy.add(value: kid)
      let pl: Parent = { parent: parent }
      componentSet(this: uiSystems.hierarchy.parents, entityId: kid, data: pl)
      i = i + 1
    }
    # `own kidsCopy` transfers ownership of the freshly-built list into
    # the new Children struct — without this, auto-drop at scope exit
    # would free the buffer the world is now holding. Same reason on
    # `own ch` to componentSet, which stores the struct into the
    # world's component table. See docs/ownership-model.md.
    let ch: Children = { ids: own kidsCopy }
    componentSet(this: world.childrens, entityId: parent, data: own ch)
  }
}

func dumpEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  label: view String
) {
  let cr: view ComputedRect => componentView(
    this: uiSystems.layout.computedRects
    entityId: entityId
  )
  let wt: view WorldTransform2D => componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  )
  let wv: WorldVisual = worldVisualOf(world: world, uiSystems: uiSystems, entityId: entityId)
  log(
    "{label} cr=({cr.position.x},{cr.position.y},{cr.size.x},{cr.size.y}) wt=({wt.position.x},{wt.position.y}) alpha={wv.alpha} visible={wv.visible}"
  )
}

func main() {
  let world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()

  let root: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entityId: root
    w: 400.0
    h: 600.0
  )
  let rootLayout: Layout = {
    kind: LayoutType.vertical
    gap: 10.0
    alignMain: AlignKind.start
    alignCross: AlignKind.start
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entityId: root, data: rootLayout)
  let rootPad: Padding = { insets: Insets { l: 20.0, t: 20.0, r: 20.0, b: 20.0 } }
  componentSet(this: world.paddings, entityId: root, data: rootPad)

  let header: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entityId: header
    w: 360.0
    h: 80.0
  )
  let headerLayout: Layout = {
    kind: LayoutType.horizontal
    gap: 10.0
    alignMain: AlignKind.start
    alignCross: AlignKind.center
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entityId: header, data: headerLayout)

  let iconA: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entityId: iconA
    w: 40.0
    h: 40.0
  )
  setShapeRect(
    world: world
    entityId: iconA
    r: 255
    g: 0
    b: 0
  )
  let iconB: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entityId: iconB
    w: 40.0
    h: 40.0
  )
  setShapeRect(
    world: world
    entityId: iconB
    r: 0
    g: 255
    b: 0
  )
  let headerKids: List(EntityId) = List.create(EntityId, cap: 2)
  headerKids.add(value: iconA)
  headerKids.add(value: iconB)
  attachChildren(
    world: world
    uiSystems: uiSystems
    parent: header
    kids: headerKids
  )

  let body: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entityId: body
    w: 360.0
    h: 100.0
  )
  setShapeRect(
    world: world
    entityId: body
    r: 200
    g: 200
    b: 200
  )

  let footer: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entityId: footer
    w: 360.0
    h: 100.0
  )
  setShapeRect(
    world: world
    entityId: footer
    r: 100
    g: 100
    b: 100
  )

  let rootKids: List(EntityId) = List.create(EntityId, cap: 3)
  rootKids.add(value: header)
  rootKids.add(value: body)
  rootKids.add(value: footer)
  attachChildren(
    world: world
    uiSystems: uiSystems
    parent: root
    kids: rootKids
  )

  log("alive = {aliveCount(world: world)}")

  layoutSystem(world: world, uiSystems: uiSystems)
  transformSystem(world: world, uiSystems: uiSystems)

  log("--- positions ---")
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: root
    label: "Root"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: header
    label: "  Header"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: iconA
    label: "    IconA"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: iconB
    label: "    IconB"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: body
    label: "  Body"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: footer
    label: "  Footer"
  )

  # Inactive subtree: set Header inactive and re-run transform.
  log("--- toggle Header.Active=false ---")
  let inactive: Active = { value: false }
  componentSet(this: world.actives, entityId: header, data: inactive)
  transformSystem(world: world, uiSystems: uiSystems)
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: header
    label: "  Header"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: iconA
    label: "    IconA"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: iconB
    label: "    IconB"
  )
  dumpEntity(
    world: world
    uiSystems: uiSystems
    entityId: body
    label: "  Body"
  )
}
