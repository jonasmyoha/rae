# #914: a value identifier that resolves to NOTHING (no local, parameter,
# const, or global) must fail sema with a precise file:line:col diagnostic —
# not silently reach the C backend as a bare `rae_<name>` and die only as
# gcc's cryptic "use of undeclared identifier". Two shapes of the same bug:
# a binary-expression operand, and a named call-argument value passed to a
# genuine, cross-file function (every project file is auto-open, so Helper's
# recordScore is visible here with no import/open directive).

func main() {
  var total: Int = 0
  recordScore(total: total, delta: bonus)
  log("{total}")
}
