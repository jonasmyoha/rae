open ecs/Entity
open ecs/ComponentTable
open ecs/Query
type Position { x: Int }
type Velocity { v: Int }
type World { positions: ComponentTable(Position), velocities: ComponentTable(Velocity) }

# #814: componentSet of a NEW entity on the table a live componentMod ref
# aliases can realloc its dense storage -> the ref dangles. Rejected at compile time.
func main() {
  var pos: ComponentTable(Position) = createComponentTable(Position)
  let e: EntityId = { index: 1, generation: 0 }
  let f: EntityId = { index: 2, generation: 0 }
  componentSet(this: pos, entity: e, data: Position { x: 1 })
  let position: mod Position => componentMod(this: pos, entity: e)
  componentSet(this: pos, entity: f, data: Position { x: 2 })
  position.x = 9
}
