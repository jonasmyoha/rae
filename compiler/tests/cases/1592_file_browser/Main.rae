# The file browser (lib/ui/fileBrowser) driven by scripted input over a made tree: clicks, the keys,
# several selected, Back and Forward, the trail, the path field, the folders left and come back to,
# the
# root limit by every way in, hidden files, order and type filter, live update, a gone folder, what
# an
# app saves, two browsers in one world, a source of the app's own, dividers. Runs under
# ThreadSanitizer too.
import Files
import SdfText
import Sys
open app3d/UiShell
open ecs/ComponentTable
open ecs/Entity
open ecs/Event
open ui/BindingComponents
open ui/Components
