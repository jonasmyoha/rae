# A qualifier is spelled as its module, with the same upper and lower case
# (docs/module-model-options.md rule 8): `math.sqrt` for the module `Math` is
# refused. It used to compile because the qualifier matched ignoring case and
# was then dropped.
import Math

func main() {
  let root: Float = math.sqrt(x: 4.0)
  log("{root}")
}
