# #507: fixed-width integers are first-class types, so List(Int32) etc.
# monomorphize to a byte-accurate element (int32_t[N], int16_t[N], …) instead
# of collapsing to rae_List_void. Each width interns distinctly and lowers to
# the matching C type. (Int8 and UInt32 are exercised for storage/compute but
# not interpolated here: Int8 formats as a bool and UInt32 shares uint32_t with
# Char32, so both print oddly — a separate, documented display concern.)
import core

func main() {
  var i32: List(Int32) = { 10, 20, 30, 40 }
  var s32: Int32 = 0
  loop let v: Int32 in i32 { s32 = s32 + v }
  log("i32 sum {s32}")

  var i16: List(Int16) = { 100, 200, 300 }
  var s16: Int16 = 0
  loop let v: Int16 in i16 { s16 = s16 + v }
  log("i16 sum {s16}")

  var u64: List(UInt64) = { 5, 10, 15 }
  var su64: UInt64 = 0
  loop let v: UInt64 in u64 { su64 = su64 + v }
  log("u64 sum {su64}")

  # A distinct-width list is a distinct type: this must not collide with i32.
  var i8: List(Int8) = { 1, 2, 3, 4 }
  var s8: Int8 = 0
  loop let v: Int8 in i8 { s8 = s8 + v }
  var widened: Int = 0
  loop let v: Int8 in i8 { widened = widened + 1 }
  log("i8 count {widened}")
}
