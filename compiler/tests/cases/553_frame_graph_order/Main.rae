# #332: the frame's execution order is DERIVED from declared resource
# dependencies, not from the order passes were added.
#
# The forward renderer (lib/RendererForward, since forward-rae-3 the only
# forward frame) declares `present` FIRST and `shadow` last, but every pass
# reads what an earlier one writes, so the graph must order them shadow ->
# forward -> bloom -> composite -> present. If this ever prints present
# first, the graph has silently regressed to insertion order.
open RendererDeferred
open RendererForward

func main() {
  var renderer: DeferredRenderer = createForwardRenderer()
  log("status={compileDeferred(renderer: renderer)}")
  log("{describeDeferred(renderer: renderer)}")

  # With a load-preserving UI overlay. The overlay MODIFIES the color target
  # (read-modify-write), which must order it after the composite that writes
  # it and before the present that reads it, and must NOT be rejected as a
  # second writer.
  var withUi: DeferredRenderer = createForwardRendererWithUi()
  log("ui-status={compileDeferred(renderer: withUi)}")
  log("{describeDeferred(renderer: withUi)}")
}
