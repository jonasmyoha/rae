# The frame entry (docs/web-frame-loop.md, option B): an entry module with no
# `main` defines `setup` and `frame` instead. The program runs setup once,
# then frame until it returns false; the app value it built is owned by that
# loop between frames and dropped once at the end (the runner's allocation
# check at exit fails the case if it is not). Natively this is a plain loop;
# in the browser the browser calls frame once per animation frame.
type App {
  frameCount: Int
  history: List(Int)
  name: String
}

func setup() ret App {
  log("setup")
  ret App { frameCount: 0, history: List.create(Int, cap: 2), name: "frame entry {1}" }
}

func frame(app: mod App) ret Bool {
  app.frameCount = app.frameCount + 1
  app.history.add(value: app.frameCount * 10)
  log("frame {app.frameCount}, history {app.history.length}, {app.name}")
  ret app.frameCount < 3
}
