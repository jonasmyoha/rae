import core
import String

# #766/#789 no-globals HARD ERROR (universal). `const` and POD-literal /
# string-literal `let` are FINE (no diagnostic). A module-level `var` (mutable
# global) and a `let` that ALLOCATES heap each fail to compile, pointing at the
# App-ownership doc.

const okConst: Int = 5                          # fine
let okPodLet: Float = 3.14                       # fine (POD literal)
let okStrLiteral: String = "static"              # fine (string literal = constant)

var warnVarInt: Int = 0                           # ERROR: mutable global
var warnVarList: List(Int) = createList(Int, cap: 2)   # ERROR: mutable global
let warnHeapStr: String = "a".concat(other: "b")       # ERROR: let allocates heap
let warnHeapList: List(Int) = createList(Int, cap: 2)  # ERROR: let owns heap

func main() {
  warnVarInt = warnVarInt + okConst
  warnVarList.add(value: 1)
  log("ok: {okConst} {okPodLet} {okStrLiteral}")
}
