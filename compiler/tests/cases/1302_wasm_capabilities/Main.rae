# lib/wasm capabilities (docs/wasm-interfaces.md §4), with the module in
# ModuleSource.txt (its bytes below): it imports fd_write, clock_time_get and
# random_get, one per standard capability, and its rae.interface section
# requests only `log`. Deny by default: an import no requested capability
# covers refuses the instance by name; a grant the module did not request and
# a request the host does not expose are refused; and a module whose section
# is edited to request more still gets only what the host grants: the calls
# of a requested but ungranted capability trap in lib/wasm, and the host's
# wasmHostCall never sees them.
import String
open wasm/Wasm
open wasm/WasmBytes
open wasm/WasiMinimal
open crypto/CryptoBytes

const moduleHex: String = ""

type Host {
  output: WasiOutput
  seen: List(String)
}

func wasmHostCall(
  host: mod Host
  instance: mod WasmInstance
  call: view WasmHostCall
) ret WasmHostAnswer {
  host.seen.add(value: "{call.name}")
  if let answer: WasmHostAnswer = wasiMinimalAnswer(
    instance: instance
    call: call
    output: host.output
  ) {
    ret answer
  }
  ret wasmTrap(message: "no host function {call.module}.{call.name}")
}

func lebBytes(value: view Int) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: 5)
  var rest: Int = value
  loop {
    let low: Int = rest bitand 127
    rest = rest shr 7
    if rest is 0 {
      bytes.add(value: low as UInt8)
      ret bytes
    }
    bytes.add(value: (low bitor 128) as UInt8)
  }
}

func appendAll(
  into: mod List(UInt8)
  from: view List(UInt8)
  start: view Int
  end: view Int
) {
  loop var i: Int = start, i < end, ++i {
    into.add(value: bytes(of: from, index: i))
  }
}

func bytes(of: view List(UInt8), index: view Int) ret UInt8 {
  ret of.copyAtFallback(index: index, fallback: 0)
}

# The module with its rae.interface section rewritten to request `requests`
# (a quoted, comma-separated list): what an edited download could claim.
func withRequests(module: view List(UInt8), requests: view String) ret List(UInt8) {
  var position: Int = 8
  loop position < module.length {
    let id: Int = bytes(of: module, index: position) as Int
    let size: WasmLeb = wasmReadLeb(bytes: module, position: position + 1)
    let end: Int = size.next + size.value
    if id is 0 {
      let nameLength: WasmLeb = wasmReadLeb(bytes: module, position: size.next)
      let name: String = String.fromBytes(
        bytes: module
        start: nameLength.next
        count: nameLength.value
      )
      if name is "rae.interface" {
        let payload: List(UInt8) = bytesOfText(
          text: "\{\"version\":1,\"exports\":[],\"requests\":[{requests}]\}"
        )
        var content: List(UInt8) = lebBytes(value: name.length())
        appendAll(
          into: content
          from: bytesOfText(text: name)
          start: 0
          end: name.length()
        )
        appendAll(
          into: content
          from: payload
          start: 0
          end: payload.length
        )
        var edited: List(UInt8) = List.create(UInt8, cap: module.length + 64)
        appendAll(
          into: edited
          from: module
          start: 0
          end: position
        )
        edited.add(value: 0)
        let contentSize: List(UInt8) = lebBytes(value: content.length)
        appendAll(
          into: edited
          from: contentSize
          start: 0
          end: contentSize.length
        )
        appendAll(
          into: edited
          from: content
          start: 0
          end: content.length
        )
        appendAll(
          into: edited
          from: module
          start: end
          end: module.length
        )
        ret edited
      }
    }
    position = end
  }
  ret List.create(UInt8, cap: 0)
}

func call(host: mod Host, instance: mod WasmInstance, name: view String) ret String {
  let result: WasmCallResult = wasmCall(
    Host
    host: host
    instance: instance
    name: name
    args: {}
    timeoutMs: 1000
  )
  if wasmFailed(error: result.error) {
    ret "{result.error.kind}: {result.error.message}"
  }
  ret "{result.values.copyAtFallback(index: 0, fallback: wasmI32(value: 0)).integer}"
}

func instantiate(
  module: view WasmModule
  exposed: view List(WasmCapability)
  granted: view List(String)
) ret WasmInstance {
  ret wasmInstantiate(
    module: module
    exposed: exposed
    granted: granted
    limits: WasmLimits { stackBytes: 65536, heapBytes: 0, maxMemoryPages: 0 }
  )
}

func main() {
  var original: List(UInt8) = List.create(UInt8, cap: 0)
  if let decoded: List(UInt8) = bytesOfHex(hex: moduleHex) {
    original = own decoded
  }
  let standard: List(WasmCapability) = wasiMinimalCapabilities()
  var host: Host = { output: createWasiOutput(), seen: List.create(String, cap: 8) }

  # As built: requests log, imports clock and random too.
  var honest: WasmModule = wasmLoad(bytes: original)
  let refused: WasmInstance = instantiate(module: honest, exposed: standard, granted: { "log" })
  log("requests log only: {refused.error.kind}: {refused.error.message}")
  wasmUnload(module: honest)

  # Edited to request log, clock and random; the host grants log only.
  let forged: List(UInt8) = withRequests(module: original, requests: "\"log\",\"clock\",\"random\"")
  var edited: WasmModule = wasmLoad(bytes: forged)
  var instance: WasmInstance = instantiate(module: edited, exposed: standard, granted: { "log" })
  log("edited to request more, log granted: {instance.error.kind}")
  log(
    "  say: {call(host: host, instance: instance, name: "say")}, wrote '{host.output.text.trim()}'"
  )
  log("  readClock: {call(host: host, instance: instance, name: "readClock")}")
  log("  readRandom: {call(host: host, instance: instance, name: "readRandom")}")
  log("  the host saw: {host.seen}")
  wasmDestroy(instance: instance)

  # The same module with clock granted as well: clock answers.
  var clocked: WasmInstance = instantiate(
    module: edited
    exposed: standard
    granted: { "log", "clock" }
  )
  log("log and clock granted: readClock {call(host: host, instance: clocked, name: "readClock")}")
  log("  readRandom: {call(host: host, instance: clocked, name: "readRandom")}")
  wasmDestroy(instance: clocked)

  # A grant the module did not request.
  let unrequested: WasmInstance = instantiate(
    module: edited
    exposed: standard
    granted: { "log", "files" }
  )
  log("granting files: {unrequested.error.kind}: {unrequested.error.message}")

  # A request this host does not expose.
  var noRandom: List(WasmCapability) = List.create(WasmCapability, cap: 4)
  loop let capability: view WasmCapability in standard {
    if capability.name is not "random" {
      noRandom.add(value: capability)
    }
  }
  let unexposed: WasmInstance = instantiate(module: edited, exposed: noRandom, granted: { "log" })
  log("a host without random: {unexposed.error.kind}: {unexposed.error.message}")
  wasmUnload(module: edited)
}
