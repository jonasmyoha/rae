# A kinematic body sent farther than the world's top speed takes it in one fixed step (a body parked
# far away, or brought back from there; box3d/ecs physicsPushSystem) is put there at once and
# stopped.
# Driven by b3Body_SetTargetTransform it went at the top speed (400 m/s) for many steps, through
# whatever was on its way. A move within a step's reach is driven as before.
import Math
import Vec3
import Quat
open ecs/Entity
open ecs/World
open ecs/ComponentTable
open ecs/Transform
open box3d/Box3d
open box3d/Box3dTypes
open box3d/ecs/PhysicsTypes
open box3d/ecs/Physics
open box3d/ecs/PhysicsComponents
open box3d/ecs/PhysicsSpawn
open box3d/ecs/PhysicsSystems
open box3d/ecs/PhysicsQueries

type GameWorld {
  allocator: EntityAllocator
  transforms: ComponentTable(Transform3D)
  rigidBodies: ComponentTable(RigidBody)
  colliders: ComponentTable(Collider)
  characters: ComponentTable(CharacterBody)
  physics: Physics
}

func createGameWorld() ret GameWorld {
  ret GameWorld {
    allocator: createEntityAllocator()
    transforms: createComponentTable(Transform3D)
    rigidBodies: createComponentTable(RigidBody)
    colliders: createComponentTable(Collider)
    characters: createComponentTable(CharacterBody)
    physics: createPhysics(def: defaultPhysicsWorldDef(), fixedStep: 1.0 / 60.0, subSteps: 4)
  }
}

func spawnKinematicBox(world: mod GameWorld) ret EntityId {
  let entityId: EntityId = allocEntity(this: world.allocator)
  var def: BodyDef = defaultBodyDef(lengthUnitsPerMeter: 1.0)
  def.bodyType = BodyType.kinematicBody
  def.position = Vec3 { x: 0.0, y: 0.0, z: 1.0 }
  spawnRigidBody(
    physics: world.physics
    rigidBodies: world.rigidBodies
    transforms: world.transforms
    entityId: entityId
    def: def
  )
  addBoxCollider(
    physics: world.physics
    rigidBodies: world.rigidBodies
    colliders: world.colliders
    entityId: entityId
    def: defaultShapeDef(lengthUnitsPerMeter: 1.0)
    halfExtents: Vec3 { x: 0.5, y: 0.5, z: 0.5 }
    transform: transformIdentity()
  )
  ret entityId
}

func step(world: mod GameWorld) {
  physicsFixedStep(
    physics: world.physics
    rigidBodies: world.rigidBodies
    characters: world.characters
    transforms: world.transforms
  )
}

func bodyX(world: view GameWorld, entityId: view EntityId) ret Float {
  ret componentView(this: world.transforms, entityId: entityId).position.x
}

func speedOf(world: view GameWorld, entityId: view EntityId) ret Float {
  ret Vec3.vlen(
    a: entityLinearVelocity(
      physics: world.physics
      rigidBodies: world.rigidBodies
      entityId: entityId
    )
  )
}

func moveTo(world: mod GameWorld, entityId: view EntityId, x: view Float) {
  let pose: mod Transform3D = componentMod(this: world.transforms, entityId: entityId)
  pose.position = Vec3 { x: x, y: 0.0, z: 1.0 }
}

func main() {
  var world: GameWorld = createGameWorld()
  let boxId: EntityId = spawnKinematicBox(world: world)
  # The top speed (400 m/s) takes it 6.67 m in a step of 1/60 s

  # Sent 1000 m (parked far away): there after one step, standing still
  moveTo(world: world, entityId: boxId, x: 1000.0)
  step(world: world)
  log(
    "sent 1000 m: there after one step {Math.abs(
      value: bodyX(world: world, entityId: boxId) - 1000.0
    ) < 0.0001}, still {speedOf(world: world, entityId: boxId) < 0.0001}"
  )
  # and stays there
  step(world: world)
  step(world: world)
  log("and stays: {Math.abs(value: bodyX(world: world, entityId: boxId) - 1000.0) < 0.0001}")

  # Brought back 1000 m: the same
  moveTo(world: world, entityId: boxId, x: 0.0)
  step(world: world)
  log("brought back: {Math.abs(value: bodyX(world: world, entityId: boxId)) < 0.0001}")

  # Moved 5 m, within a step's reach: driven there over the step, at 300 m/s, then stopped
  moveTo(world: world, entityId: boxId, x: 5.0)
  step(world: world)
  log(
    "moved 5 m: there {Math.abs(value: bodyX(world: world, entityId: boxId) - 5.0) < 0.001}, driven {speedOf(
      world: world
      entityId: boxId
    ) > 100.0}"
  )
  step(world: world)
  log(
    "then stopped there {Math.abs(value: bodyX(world: world, entityId: boxId) - 5.0) < 0.0001 and speedOf(
      world: world
      entityId: boxId
    ) < 0.0001}"
  )
}
