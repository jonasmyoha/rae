import core

# #665: the whole project tree is auto-visible — NO import/open between project
# files, at any depth. main (root) calls into subfolders; a subfolder file calls
# a SIBLING subfolder and up to root; a deeply-nested file is visible too. A
# unique name is also reachable qualified by its folder.
func rootTag() ret String { ret "ROOT" }

func main() {
  log("root->sub: {enemyLabel()}")
  log("sub->sibling+root: {itemFor()}")
  log("deep: {eliteLabel()}")
  log("qualified unique: {items.itemName()}")
}
