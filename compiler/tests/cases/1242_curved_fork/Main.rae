open procgen/CurvedFork
open procgen/SculpturalFork
open procgen/ForkSurface
open Mesh3d
open Vec3
open collections/StringMap
import Math

type EdgeUse {
  count: Int
  direction: Int
}

func verifyFork(tree: view SculpturalFork) ret Bool {
  let mesh: view MeshData = tree.wood
  if mesh.vertCount > 10000 or mesh.indices.length > 45000 or mesh.verts.length is not mesh.vertCount * 8 {
    log("mesh budget")
    ret false
  }
  if mesh.windPivots.length is not 0 or mesh.leafCards.length is not 0 or tree.boundsMin.z >= 0 {
    log("wood must be rigid and buried")
    ret false
  }
  if tree.minimumFrameDot < 0.8 {
    log("unstable transported frame")
    ret false
  }
  loop let value: Float in mesh.verts {
    if value is not value or Math.abs(value: value) > 100 {
      log("non-finite vertex")
      ret false
    }
  }
  var positions: StringMap(Int) = createStringMap(Int, cap: mesh.vertCount * 2)
  var canonical: List(Int) = List.create(Int, cap: mesh.vertCount)
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    let point: Vec3 = forkPoint(mesh: mesh, index: vertex)
    let normal: Vec3 = forkNormal(mesh: mesh, index: vertex)
    if Math.abs(value: vdot(a: normal, b: normal) - 1.0) > 0.001 {
      log("non-unit normal")
      ret false
    }
    if Math.abs(value: point.x) > tree.declaredRadius or Math.abs(value: point.y) > tree.declaredRadius or point.z < -tree.declaredDepth or point.z > tree.declaredHeight {
      log("declared bounds")
      ret false
    }
    if point.x < tree.boundsMin.x or point.x > tree.boundsMax.x or point.y < tree.boundsMin.y or point.y > tree.boundsMax.y or point.z < tree.boundsMin.z or point.z > tree.boundsMax.z {
      log("measured bounds")
      ret false
    }
    let key: String = "{point.x},{point.y},{point.z}"
    if let previous: Int = get(this: positions, k: key) {
      if vdot(a: normal, b: forkNormal(mesh: mesh, index: previous)) < 0.9999 {
        log("split seam normal")
        ret false
      }
      canonical.add(value: previous)
    } else {
      set(this: positions, k: key, value: vertex)
      canonical.add(value: vertex)
    }
  }
  var edges: StringMap(EdgeUse) = createStringMap(EdgeUse, cap: mesh.indices.length)
  var keys: List(String) = List.create(String, cap: mesh.indices.length / 2)
  loop var triangle: Int = 0, triangle < mesh.indices.length / 3, ++triangle {
    let first: Int = mesh.indices.copyAtDefault(index: triangle * 3)
    let second: Int = mesh.indices.copyAtDefault(index: triangle * 3 + 1)
    let third: Int = mesh.indices.copyAtDefault(index: triangle * 3 + 2)
    if first < 0 or second < 0 or third < 0 or first >= mesh.vertCount or second >= mesh.vertCount or third >= mesh.vertCount {
      log("index range")
      ret false
    }
    let firstU: Float = mesh.verts.copyAtDefault(index: first * 8 + 6)
    let secondU: Float = mesh.verts.copyAtDefault(index: second * 8 + 6)
    let thirdU: Float = mesh.verts.copyAtDefault(index: third * 8 + 6)
    let minimumU: Float = Math.min(a: firstU, b: Math.min(a: secondU, b: thirdU))
    let maximumU: Float = Math.max(a: firstU, b: Math.max(a: secondU, b: thirdU))
    if maximumU - minimumU > 0.50001 {
      log("texture wrap face {triangle}: {firstU}, {secondU}, {thirdU}")
      ret false
    }
    let face: Vec3 = vcross(
      a: vsub(a: forkPoint(mesh: mesh, index: second), b: forkPoint(mesh: mesh, index: first))
      b: vsub(a: forkPoint(mesh: mesh, index: third), b: forkPoint(mesh: mesh, index: first))
    )
    let averageNormal: Vec3 = vadd(
      a: forkNormal(mesh: mesh, index: first)
      b: vadd(a: forkNormal(mesh: mesh, index: second), b: forkNormal(mesh: mesh, index: third))
    )
    if vdot(a: face, b: face) < 0.000000000001 or vdot(a: face, b: averageNormal) <= 0 {
      log(
        "degenerate or inverted face {triangle} area {vdot(a: face, b: face)} facing {vdot(
          a: face
          b: averageNormal
        )}"
      )
      ret false
    }
    loop var corner: Int = 0, corner < 3, ++corner {
      let from: Int = canonical.copyAtDefault(
        index: mesh.indices.copyAtDefault(index: triangle * 3 + corner)
      )
      let to: Int = canonical.copyAtDefault(
        index: mesh.indices.copyAtDefault(index: triangle * 3 + (corner + 1) % 3)
      )
      let edgeKey: Int = forkEdgeKey(first: from, second: to, count: mesh.vertCount)
      let key: String = "{edgeKey}"
      var direction: Int = 1
      if from > to {
        direction = -1
      }
      if var edge: EdgeUse = get(this: edges, k: key) {
        edge.count = edge.count + 1
        edge.direction = edge.direction + direction
        set(this: edges, k: key, value: edge)
      } else {
        set(this: edges, k: key, value: EdgeUse { count: 1, direction: direction })
        keys.add(value: key)
      }
    }
  }
  loop let key: String in keys {
    if let edge: EdgeUse = get(this: edges, k: key) {
      if edge.count is not 2 or edge.direction is not 0 {
        log("open, non-manifold or inconsistently wound edge")
        ret false
      }
    }
  }
  ret true
}

func main() ret Int {
  let seeds: List(Int) = { 206, 907, 71, -17 }
  loop let seed: Int in seeds {
    loop var age: Int = 0, age < 2, ++age {
      let tree: SculpturalFork = curvedSculpturalFork(seed: seed, mature: age is 1)
      let repeated: SculpturalFork = curvedSculpturalFork(seed: seed, mature: age is 1)
      if not verifyFork(tree: tree) {
        log("failed seed {seed}, age {age}")
        ret 1
      }
      loop var index: Int = 0, index < tree.wood.verts.length, ++index {
        if tree.wood.verts.copyAtDefault(index: index) is not repeated.wood.verts.copyAtDefault(
          index: index
        ) {
          ret 2
        }
      }
      loop var index: Int = 0, index < tree.wood.indices.length, ++index {
        if tree.wood.indices.copyAtDefault(index: index) is not repeated.wood.indices.copyAtDefault(
          index: index
        ) {
          ret 3
        }
      }
    }
  }
  log(
    "curved forks: deterministic, closed, oriented, finite, bounded and rigid; seam normals agree"
  )
  ret 0
}
