pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../../../.."
      subdir: "packages/audio"
      version: "0.12.6"
      hash: "git-tree:f6a5e1f91c72b401f0e2f99179d70cb9f9bce757"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
