# #993: the `mod` twin — the write went through the wrong struct layout.
type Apple {
  weight: Int
}

type Basket {
  count: Int
  label: String
}

func inspect(basket: view Basket) ret Int {
  ret basket.count
}

func fill(basket: mod Basket) {
  basket.count = basket.count + 1
}

func twice(n: copy Int) ret Int {
  ret n * 2
}

func pair(first: view Int, second: view String) ret Int {
  ret first + second.length()
}

func main() ret Int {
  var apple: Apple = { weight: 3 }
  fill(basket: apple)
  log("B {apple.weight}")
  ret 0
}
