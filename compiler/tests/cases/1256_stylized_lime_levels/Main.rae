# The stylized set's lime rebuilt as a treeGen kind (stylizedTrees/
# StylizedKinds, docs/stylized-trees-new-technique.md task 2): its middle
# level (every 4th leaf card at twice the width) covers what its near level
# does within 5% from each of 8 sides, the cards facing the view as they
# are drawn (as case 1228 checks the old trees' levels); and its grown
# crown keeps the old lime's silhouette: about 0.85 of the height wide,
# starting at about a third of it.
import Math
open Mesh3d
open stylizedTrees/StylizedTrees
open stylizedTrees/StylizedKinds
open stylizedTrees/ReferenceTrees
open treeGen/TreeKind
open app3d/TreeCoverage

func percent(share: view Float) ret Int {
  ret (share * 100.0 + 0.5).toInt()
}

func main() ret Int {
  let lime: TreeKind = limeKind()
  let near: List(MeshData) = referenceLevelParts(
    treeKind: lime
    variety: limeVariety
    keepEvery: 1
    grow: 1.0
  )
  let middle: List(MeshData) = referenceLevelParts(
    treeKind: lime
    variety: limeVariety
    keepEvery: referenceMiddleKeep
    grow: referenceMiddleGrow
  )
  let shares: List(Float) = levelCoverageShares(
    near: near
    level: middle
    directions: 8
    resolution: 256
    cardsFacing: true
  )
  var low: Float = 10.0
  var high: Float = 0.0
  loop let share: view Float in shares {
    low = Math.min(a: low, b: share)
    high = Math.max(a: high, b: share)
  }
  let fits: Bool = low >= 0.95 and high <= 1.05
  log("lime: middle covers {percent(share: low)}-{percent(share: high)}% of the near crown ={fits}")
  # the silhouette: the leaves' reach, top and lowest point over the height
  # the set places it by
  let height: Float = stylizedHeightUnit(species: speciesBroadleaf, oldUnit: 1.0)
  var reach: Float = 0.0
  var top: Float = 0.0
  var bottom: Float = 1000.0
  loop var part: Int = 1, part < near.length, ++part {
    let mesh: MeshData = near.copyAtDefault(index: part)
    loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
      let x: Float = mesh.verts.copyAtDefault(index: vertex * 8)
      let y: Float = mesh.verts.copyAtDefault(index: vertex * 8 + 1)
      let z: Float = mesh.verts.copyAtDefault(index: vertex * 8 + 2)
      reach = Math.max(a: reach, b: Math.sqrt(x: x * x + y * y))
      top = Math.max(a: top, b: z)
      bottom = Math.min(a: bottom, b: z)
    }
  }
  let width: Float = 2.0 * reach / height
  let start: Float = bottom / height
  let wide: Bool = width >= 0.7 and width <= 1.0
  let starts: Bool = start >= 0.22 and start <= 0.42
  log(
    "lime: crown {percent(share: width)}% of the height wide ={wide}, from {percent(share: start)}% of it ={starts}"
  )
  let height54: Bool = height >= 4.8 and height <= 7.2
  log("lime: grown {percent(share: height / 6.0)}% of 6 m, in the old 4.8 - 7.2 m ={height54}")
  if fits and wide and starts and height54 {
    ret 0
  }
  ret 1
}
