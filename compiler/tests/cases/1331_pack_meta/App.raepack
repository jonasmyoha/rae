pack Case {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  meta: {
    name: "Case"
    version: "1.2.3"
    description: "A program that reads its own pack's meta"
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
