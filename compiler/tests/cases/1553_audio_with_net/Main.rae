# A program that loads the audio package's effect states and lib/net's Wire: the two used to
# share a function name (zeroInts: a Buffer(Int) in audio, a List(Int) in net/Wire), and every
# build said so. Builds with no such warning now and uses both.
open net/Wire
open audio/EffectStates

func main() {
  let values: List(Int) = zeroInts(count: 3)
  log("net/Wire zeroInts: {values.length} values")
}
