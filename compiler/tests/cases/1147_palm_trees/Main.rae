# The two street palms of stylizedTrees/Palm: a Mexican fan palm and a date palm,
# each as tall as asked, with a slim, slightly curved trunk, and a crown of
# fronds reaching out round its top and drooping at their tips; the three
# tones together hold every frond once; fewer leaflets, fewer triangles;
# deterministic, with valid indices.
import Math
open Vec3
open Mesh3d
open stylizedTrees/Palm

func vertexAt(mesh: view MeshData, index: view Int) ret Vec3 {
  let base: Int = index * 8
  ret Vec3.create(
    x: mesh.verts.copyAtFallback(index: base, fallback: 0.0)
    y: mesh.verts.copyAtFallback(index: base + 1, fallback: 0.0)
    z: mesh.verts.copyAtFallback(index: base + 2, fallback: 0.0)
  )
}

func indicesValid(mesh: view MeshData) ret Bool {
  loop let index: Int in mesh.indices {
    if index < 0 or index >= mesh.vertCount {
      ret false
    }
  }
  ret mesh.indices.length > 0
}

func check(label: view String, ok: view Bool) {
  if ok {
    log("ok   {label}")
  } else {
    log("FAIL {label}")
  }
}

func palmChecks(
  form: view PalmForm
  name: view String
  height: view Float
  slim: view Float
  reachLow: view Float
  reachHigh: view Float
) {
  let seed: Int = 41
  let trunk: MeshData = palmTrunk(form: form, seed: seed, height: height)
  var top: Float = 0.0
  var widest: Float = 0.0
  loop var i: Int = 0, i < trunk.vertCount, ++i {
    let point: Vec3 = vertexAt(mesh: trunk, index: i)
    top = Math.max(a: top, b: point.z)
    if point.z > 2.0 and point.z < height * 0.7 {
      let center: Vec3 = palmTrunkPoint(
        form: form
        seed: seed
        height: height
        fraction: point.z / height
      )
      let dx: Float = point.x - center.x
      let dy: Float = point.y - center.y
      widest = Math.max(a: widest, b: Math.sqrt(x: dx * dx + dy * dy))
    }
  }
  let crown: Vec3 = palmCrown(form: form, seed: seed, height: height)
  let lean: Float = Math.sqrt(x: crown.x * crown.x + crown.y * crown.y)
  check(
    label: "{name}: as tall as asked"
    ok: indicesValid(mesh: trunk) and top > height * 0.98 and top < height + 0.6
  )
  check(label: "{name}: a slim trunk (at most {slim} m round)", ok: widest > 0.1 and widest <= slim)
  check(
    label: "{name}: slightly curved (its crown {lean} m off the upright)"
    ok: lean > 0.3 and lean < 2.0
  )
  var triangles: Int = 0
  var reach: Float = 0.0
  var lowest: Float = 1000.0
  loop var tone: Int = 0, tone < 3, ++tone {
    let fronds: MeshData = palmFronds(
      form: form
      seed: seed
      height: height
      tone: tone
      leaflets: 12
    )
    let again: MeshData = palmFronds(
      form: form
      seed: seed
      height: height
      tone: tone
      leaflets: 12
    )
    var same: Bool = fronds.verts.length is again.verts.length
    loop var i: Int = 0, i < fronds.verts.length, ++i {
      same = same and fronds.verts.copyAtFallback(index: i, fallback: 0.0) is again.verts.copyAtFallback(
        index: i
        fallback: 1.0
      )
    }
    check(
      label: "{name} tone {tone}: deterministic, valid"
      ok: same and indicesValid(mesh: fronds)
    )
    triangles = triangles + fronds.indices.length / 3
    loop var i: Int = 0, i < fronds.vertCount, ++i {
      let point: Vec3 = vertexAt(mesh: fronds, index: i)
      let dx: Float = point.x - crown.x
      let dy: Float = point.y - crown.y
      reach = Math.max(a: reach, b: Math.sqrt(x: dx * dx + dy * dy))
      lowest = Math.min(a: lowest, b: point.z)
    }
  }
  var perFrond: Int = 4 * 12
  if form is PalmForm.fan {
    perFrond = 4 + 2 * 12
  }
  check(
    label: "{name}: every frond in one tone ({triangles} triangles)"
    ok: triangles is palmFrondCount(form: form) * perFrond
  )
  check(
    label: "{name}: the fronds reach out round the crown"
    ok: reach >= reachLow and reach <= reachHigh
  )
  check(
    label: "{name}: and droop: their tips hang below the crown"
    ok: lowest < crown.z - 0.5 and lowest > crown.z - 6.0
  )
  var fewer: Int = 0
  loop var tone: Int = 0, tone < 3, ++tone {
    fewer = fewer + palmFronds(
      form: form
      seed: seed
      height: height
      tone: tone
      leaflets: 4
    ).indices.length / 3
  }
  check(label: "{name}: fewer leaflets, fewer triangles (far away)", ok: fewer < triangles / 2)
}

func main() {
  palmChecks(
    form: PalmForm.fan
    name: "Mexican fan palm"
    height: 22.0
    slim: 0.3
    reachLow: 2.0
    reachHigh: 3.5
  )
  palmChecks(
    form: PalmForm.date
    name: "date palm"
    height: 13.0
    slim: 0.5
    reachLow: 3.5
    reachHigh: 6.5
  )
}
