# Spec 2.3: `=>` onto a PRODUCED value is semantically valid whether or not the
# right-hand side denotes a place. The binding views the value, and the
# implementation owes that value storage for the binding's lifetime.
#
# The backend used to emit `&make()` and the C compiler refused to take the
# address of an rvalue. It now materialises the value into a local emitted just
# before the binding, whose lifetime is the enclosing scope.
import core

type Track { title: String, seconds: Int }

func make() ret Track {
  ret Track { title: "made", seconds: 7 }
}

func main() {
  let t: view Track => make()
  log("call:    {t.title} / {t.seconds}")

  var l: List(Track) = createList(Track, cap: 2)
  l.add(value: Track { title: "first", seconds: 1 })
  let e: view Track => l.at(index: 0)
  log("element: {e.title} / {e.seconds}")
}
