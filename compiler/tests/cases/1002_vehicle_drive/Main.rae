# The vehicle on track A (docs/physics-design.md §5.7): the shared car - an
# Audi A7 built the way Box3D's Driving sample builds one
# (physicsScenes/VehicleLibrary) - through the port's ECS layer
# (physicsScenes/port/VehicleSpawn), on flat ground. Full throttle must reach
# 100 km/h in about the A7's 5.3 s, and full lock at town speed must turn the
# car more than 90 degrees while it stays upright. The rounded readings are
# printed, so a change in the wheel joint, its controls or the drive shows up
# here. Fixture 1005 is the same program on Box3D's C library and must print
# exactly this.
import Math
open Vec3
open Quat
open ecs/Transform
open physicsScenes/VehicleTypes
open physicsScenes/VehicleLibrary
open physicsScenes/port/VehicleSpawn
open physics/math/TransformMath
open physics/dynamics/WorldTypes
open physics/ecs/PhysicsSpawn

func tenths(value: view Float) ret Float {
  ret Math.round(x: value * 10.0) / 10.0
}

func kilometresPerHour(world: view VehicleWorld) ret Float {
  let pose: Transform3D = chassisTransform(world: world)
  ret forwardSpeed(velocity: chassisVelocity(world: world), chassisRotation: pose.rotation) * 3.6
}

# A world with a flat 2 km ground and the car resting on it, at the west end.
func flatWorld(car: view VehicleDescription) ret VehicleWorld {
  var world: VehicleWorld = createVehicleWorld(workerCount: 1)
  let ground: ShapeId = addVenueBox(
    physics: world.physics
    def: defaultShapeDef(lengthUnitsPerMeter: 1.0)
    halfExtents: Vec3 { x: 1000.0, y: 1000.0, z: 0.5 }
    transform: Transform { position: Vec3 { x: 0.0, y: 0.0, z: -0.5 }, rotation: Quat.identity() }
  )
  spawnVehicle(world: world, car: car)
  ret world
}

func drive(world: mod VehicleWorld, car: view VehicleDescription, command: view VehicleCommand) {
  driveVehicle(
    world: world
    car: car
    command: command
    frameTime: 1.0 / 60.0
  )
  let steps: Int = stepVehicleWorld(world: world, frameTime: 1.0 / 60.0)
}

func main() {
  let car: VehicleDescription = drivingCar(startPosition: Vec3 { x: -900.0, y: 0.0, z: 1.0 })
  let settle: VehicleCommand = { throttle: 0.0, steer: 0.0 }
  let full: VehicleCommand = { throttle: 1.0, steer: 0.0 }

  # Full throttle from rest: the A7's 0-100 km/h is 5.3 s
  var driven: VehicleWorld = flatWorld(car: car)
  loop var frame: Int = 0, frame < 60, ++frame {
    drive(world: driven, car: car, command: settle)
  }
  log("at rest: chassis centre {tenths(value: chassisTransform(world: driven).position.z)} m up")
  var hundredAt: Float = -1.0
  loop var frame: Int = 1, frame <= 900, ++frame {
    drive(world: driven, car: car, command: full)
    if hundredAt < 0.0 and kilometresPerHour(world: driven) >= 100.0 {
      hundredAt = (frame as Float) / 60.0
    }
    if frame % 180 is 0 {
      log(
        "t={frame / 60}s {Math.round(x: kilometresPerHour(world: driven))} km/h heading {tenths(
          value: headingDegrees(chassisRotation: chassisTransform(world: driven).rotation)
        )} deg"
      )
    }
  }
  log(
    "0-100 km/h in {tenths(value: hundredAt)} s: within 5.0-5.6 s {hundredAt >= 5.0 and hundredAt <= 5.6}"
  )
  destroyVehicleWorld(world: driven)

  # Full lock at town speed (throttle held at 20%, about 50 km/h)
  var steered: VehicleWorld = flatWorld(car: car)
  let cruise: VehicleCommand = { throttle: 0.2, steer: 0.0 }
  loop var frame: Int = 0, frame < 600, ++frame {
    drive(world: steered, car: car, command: cruise)
  }
  let startHeading: Float = headingDegrees(
    chassisRotation: chassisTransform(world: steered).rotation
  )
  log("steering at {Math.round(x: kilometresPerHour(world: steered))} km/h")
  let turning: VehicleCommand = { throttle: 0.2, steer: 1.0 }
  var lowestUp: Float = 1.0
  loop var frame: Int = 0, frame < 300, ++frame {
    drive(world: steered, car: car, command: turning)
    let up: Vec3 = Quat.rotate(
      q: chassisTransform(world: steered).rotation
      v: Vec3 { x: 0.0, y: 1.0, z: 0.0 }
    )
    lowestUp = Math.min(a: lowestUp, b: up.z)
  }
  var turned: Float = headingDegrees(chassisRotation: chassisTransform(world: steered).rotation) - startHeading
  if turned < 0.0 {
    turned = turned + 360.0
  }
  log(
    "full lock for 5 s: turned left {Math.round(x: turned)} deg, more than 90 {turned > 90.0}, stayed upright {lowestUp > 0.9}"
  )
  destroyVehicleWorld(world: steered)
}
