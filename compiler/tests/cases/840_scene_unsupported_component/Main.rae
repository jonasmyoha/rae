import Json
import String
import ui/Components
open ui/Ecs
import ui/Registry
open ui/Scene
open ui/SceneLoader
open ecs/Entity
open ecs/ComponentTable

# A well-formed scene whose one node carries `ComputedRect` — a UiWorld table
# that IS a component, but a DERIVED one the layout system writes; it is never
# authored, so the reflected registry (#961) excludes it. Before #941 the loader
# swallowed unknown keys silently; now it must fail loudly, naming the scene,
# node and component, and say WHY this one cannot be authored. (Before #961 this
# fixture used `WobbleFx`, "registered but not supported" — every declared
# component decodes structurally now, so that class no longer exists.)
# `\{`/`\}` keep the JSON braces literal (a bare `{` starts Rae string
# interpolation).
func fxScene() ret String {
  var s: String = ""
  s = s.concat(other: "\{")
  s = s.concat(other: "\"type\":\"Scene\",")
  s = s.concat(other: "\"version\":2,")
  s = s.concat(other: "\"root\":\"Root\",")
  s = s.concat(other: "\"nodes\":\{")
  s = s.concat(other: "\"Root\":\{")
  s = s.concat(other: "\"ComputedRect\":\{\"x\":3\}")
  s = s.concat(other: "\}")
  s = s.concat(other: "\}")
  s = s.concat(other: "\}")
  ret s
}

func main() {
  let scene: Scene = parseScene(source: fxScene())
  scene.sceneId = "fx-demo"
  log("scene.ok = {scene.ok}")
  let world: UiWorld = createUiWorld()
  log("loading scene with an unsupported component...")
  let rootEntity: EntityId = loadScene(world: world, scene: scene)
  # Unreachable: loadScene aborts on the unsupported component (#941).
  log("unreachable rootEntity = {rootEntity.index}")
}
