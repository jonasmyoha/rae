# A check-only build for iOS on arm64: Apple, unix, and a mobile OS, not a
# desktop one. The device under it (iPhone, iPad, a Mac running the app) is
# a runtime question, never a Target value.
const hasCommonCrypto: Bool = Target.isApple

func main() {
  log("{Target.os} mobile {Target.isMobileOs} commonCrypto {hasCommonCrypto}")
}
