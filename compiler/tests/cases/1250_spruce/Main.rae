open stylizedTrees/Spruce
open stylizedTrees/SpruceControl
open treeSets/TreeSet
open stylizedTrees/StylizedTrees
open stylizedTrees/SculpturalFork
open Mesh3d
open Vec3
import Math

func validSpruce(mesh: view MeshData, foliage: view Bool) ret Bool {
  if mesh.vertCount < 1 or mesh.vertCount > 10000 or mesh.verts.length is not mesh.vertCount * 8 {
    ret false
  }
  if mesh.indices.length % 3 is not 0 {
    ret false
  }
  loop let value: Float in mesh.verts {
    if value is not value or Math.abs(value: value) > 20 {
      ret false
    }
  }
  loop let index: Int in mesh.indices {
    if index < 0 or index >= mesh.vertCount {
      ret false
    }
  }
  if foliage {
    if mesh.windPivots.length is not mesh.vertCount * 4 or mesh.leafCards.length is not 0 {
      ret false
    }
  } else if mesh.windPivots.length is not 0 {
    ret false
  }
  var first: Int = 0
  var end: Int = 0
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    if Math.abs(value: vlen(a: forkNormal(mesh: mesh, index: vertex)) - 1) > 0.002 {
      ret false
    }
    let point: Vec3 = forkPoint(mesh: mesh, index: vertex)
    # Existing unit-tree bound includes a conservative 0.04 wind allowance.
    if vlen(a: vsub(a: point, b: Vec3.create(x: 0, y: 0, z: 0.55))) + 0.04 > 0.7 {
      ret false
    }
    if foliage {
      if vertex is end {
        first = vertex
        end = first + 30
      }
      loop var field: Int = 0, field < 4, ++field {
        if mesh.windPivots.copyAtDefault(index: vertex * 4 + field) is not mesh.windPivots.copyAtDefault(
          index: first * 4 + field
        ) {
          ret false
        }
      }
      let flexibility: Float = mesh.windPivots.copyAtDefault(index: vertex * 4 + 3)
      if flexibility < 0 or flexibility > 0.32 {
        ret false
      }
      loop var field: Int = 6, field < 8, ++field {
        let coordinate: Float = mesh.verts.copyAtDefault(index: vertex * 8 + field)
        if coordinate < 0 or coordinate > 1 {
          ret false
        }
      }
    }
  }
  ret true
}

func main() ret Int {
  if speciesSpruce is not 3 {
    ret 1
  }
  loop var sample: Int = 0, sample < 32, ++sample {
    let seed: Int = 73 + sample * 104
    let wood: MeshData = spruceWood(seed: seed)
    if not validSpruce(mesh: wood, foliage: false) {
      ret 2
    }
    loop var tone: Int = 0, tone < 3, ++tone {
      let leaves: MeshData = spruceLeaves(seed: seed, detail: nearPatches, tone: tone)
      let repeat: MeshData = spruceLeaves(seed: seed, detail: midPatches, tone: tone)
      if not validSpruce(mesh: leaves, foliage: true) or leaves.vertCount is not repeat.vertCount {
        ret 3
      }
      loop var value: Int = 0, value < leaves.verts.length, ++value {
        if leaves.verts.copyAtDefault(index: value) is not repeat.verts.copyAtDefault(index: value) {
          ret 4
        }
      }
    }
    # the placed height: the scale times the species' height unit (1 for
    # the old unit-height spruce, its grown height for the rebuilt one)
    let treeSet: TreeSet = createStylizedTrees()
    let height: Float = treeHeightFor(
      treeSet: treeSet
      species: speciesSpruce
      scale: treeScaleAt(treeSet: treeSet, species: speciesSpruce, number: sample)
    )
    if height < 5.5 or height > 8.5 {
      ret 5
    }
  }
  let near: List(MeshData) = speciesLevelMeshes(
    species: speciesSpruce
    patches: nearPatches
    leaves: nearLeaves
  )
  let middle: List(MeshData) = speciesLevelMeshes(
    species: speciesSpruce
    patches: midPatches
    leaves: midLeaves
  )
  var vertices: Int = 0
  var triangles: Int = 0
  loop var part: Int = 0, part < 4, ++part {
    let mesh: MeshData = near.copyAtDefault(index: part)
    if not validSpruce(mesh: mesh, foliage: part > 0) or mesh.vertCount is not middle.copyAtDefault(
      index: part
    ).vertCount {
      ret 6
    }
    vertices = vertices + mesh.vertCount
    triangles = triangles + mesh.indices.length / 3
  }
  log(
    "spruce: {vertices} vertices, {triangles} triangles; 32 seeds, rigid wood, fixed bough anchors, shared levels and bounds"
  )
  ret 0
}
