# `=` COPIES. Storing a value that reads an existing location — a local, a
# field, an element — into an owned aggregate must land a fresh deep copy of
# its String/List heap, never a bit-for-bit alias. The alias was a double free
# (#79484806): `local = copied` inside an `if let` dropped `copied` at its scope
# end and `local` at its own, over the same buffers (and `local` read freed
# memory in between). The same store through a `mod` reference had the same
# hole, and so did a binding narrowed from an optional accessor (`if let slot: mod T
# => xs.modAt(index:)`, #70178297). `own x` stays the move: the source is emptied, nothing is
# copied.
# Every case is checked twice — the values read back right, and the
# outstanding allocation count returns to its baseline once the scopes close.
open collections/StringMap

func rae_ext_rae_mem_stats_outstanding() unsafe extern ret Int

type Holder {
  label: String
  items: List(String)
}

type Pair {
  first: Holder
  second: Holder
}

func makeHolder(tag: view Int) ret Holder {
  var items: List(String) = List.create(String, cap: 2)
  items.add(value: "item {tag}")
  items.add(value: "item {tag} again")
  ret Holder { label: "holder {tag}", items: own items }
}

func maybeHolder(tag: view Int) ret opt Holder {
  ret makeHolder(tag: tag)
}

# Each shape in its own function, so every local is dropped when it returns
# and the caller can compare outstanding allocations before and after.
func assignFromIfLet(round: view Int) ret String {
  var local: Holder = Holder.default()
  if let copied: Holder = maybeHolder(tag: round) {
    local = copied
  }
  ret "{local.label} {local.items.length}"
}

func assignFromIdent() ret String {
  var target: Holder = makeHolder(tag: 9)
  let source: Holder = makeHolder(tag: 7)
  target = source
  ret "{target.label} / {source.label} {source.items.length}"
}

func assignFromField() ret String {
  let pair: Pair = { first: makeHolder(tag: 1), second: makeHolder(tag: 2) }
  var target: Holder = makeHolder(tag: 3)
  target = pair.second
  ret "{target.label} / {pair.second.label}"
}

func assignThroughModRef() ret String {
  var pair: Pair = { first: makeHolder(tag: 4), second: makeHolder(tag: 5) }
  let source: Holder = makeHolder(tag: 6)
  let slot: mod Holder => pair.first
  slot = source
  ret "{pair.first.label} {pair.first.items.length} / {source.label}"
}

func assignStringThroughModRef() ret String {
  var target: Holder = makeHolder(tag: 4)
  let source: String = "new label"
  let slot: mod String => target.label
  slot = source
  ret "{target.label} / {source}"
}

# Through a `mod` binding narrowed from an OPTIONAL accessor (`if let ... =>
# xs.modAt(index:)`): the binding is a plain reference inside the branch, so
# the store copies exactly as through `let slot: mod T => place` (#70178297).
func assignThroughModAt() ret String {
  var holders: List(Holder) = List.create(Holder, cap: 2)
  holders.add(value: makeHolder(tag: 4))
  let source: Holder = makeHolder(tag: 5)
  if let slot: mod Holder => holders.modAt(index: 0) {
    slot = source
  }
  var label: String = ""
  if let stored: view Holder => holders.viewAt(index: 0) {
    label = "{stored.label} {stored.items.length} / {source.label}"
  }
  ret label
}

func assignStringThroughModAt() ret String {
  var labels: List(String) = List.create(String, cap: 2)
  labels.add(value: "old")
  let text: String = "new label"
  if let cell: mod String => labels.modAt(index: 0) {
    cell = text
  }
  ret "{labels.copyAtDefault(index: 0)} / {text}"
}

# The same through a map's `modGet` (the generic optional-accessor path).
func assignThroughModGet() ret String {
  var byName: StringMap(Holder) = StringMap.create(Holder, cap: 4)
  byName.set(k: "slot", value: makeHolder(tag: 4))
  let source: Holder = makeHolder(tag: 5)
  if let editable: mod Holder => byName.modGet(key: "slot") {
    editable = source
  }
  var label: String = ""
  if let stored: view Holder => byName.viewGet(key: "slot") {
    label = "{stored.label} {stored.items.length} / {source.label}"
  }
  ret label
}

func assignWithOwn() ret String {
  var target: Holder = makeHolder(tag: 8)
  var source: Holder = makeHolder(tag: 6)
  target = own source
  ret "{target.label} {target.items.length}"
}

func main() {
  unsafe {
    # Warm every generated copy/drop path once, then take the baseline.
    assignFromIfLet(round: 0)
    assignFromIdent()
    assignFromField()
    assignThroughModRef()
    assignStringThroughModRef()
    assignThroughModAt()
    assignStringThroughModAt()
    assignThroughModGet()
    assignWithOwn()
    let baseline: Int = rae_ext_rae_mem_stats_outstanding()
    loop var i: Int = 1, i <= 3, ++i {
      log("if-let round {i}: {assignFromIfLet(round: i)}")
    }
    log("ident: {assignFromIdent()}")
    log("field: {assignFromField()}")
    log("mod ref: {assignThroughModRef()}")
    log("mod String ref: {assignStringThroughModRef()}")
    log("modAt: {assignThroughModAt()}")
    log("modAt String: {assignStringThroughModAt()}")
    log("modGet: {assignThroughModGet()}")
    log("own: {assignWithOwn()}")
    loop var i: Int = 0, i < 200, ++i {
      assignFromIfLet(round: i)
      assignFromIdent()
      assignFromField()
      assignThroughModRef()
      assignStringThroughModRef()
      assignThroughModAt()
      assignStringThroughModAt()
      assignThroughModGet()
      assignWithOwn()
    }
    log("leaked allocations: {rae_ext_rae_mem_stats_outstanding() - baseline}")
  }
}
