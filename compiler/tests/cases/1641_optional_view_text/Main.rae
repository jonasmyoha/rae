# The text of an optional reference: what it points at as that type is written (an enum by its
# name),
# or `none`. Of one that `if let` narrowed, and of one that is not narrowed (a parameter, a loop
# row, a
# call's answer), in an interpolation and in log, for every kind of type. Nothing leaks.
enum Kind { small, large }

type Note {
  text: String = ""
  kind: opt Kind = none
}

type Pair(T: type) {
  first: T
}

func narrowed(kind: opt view Kind) ret String {
  if let there: view Kind = kind {
    ret "{there}"
  }
  ret "nothing"
}

func written(kind: opt view Kind) ret String {
  ret "{kind}"
}

func change(kind: opt mod Kind) {
  if let there: mod Kind = kind {
    there = Kind.small
    log("changed to {there}")
  }
}

func show(T: type, title: view String, value: opt view T) {
  if let there: view T = value {
    log("{title}: {there}")
  }
  log("{title}, not narrowed: {value}")
}

func enums() {
  var maybe: opt Kind = Kind.large
  if let kind: view Kind = maybe {
    let text: String = "{kind}"
    let copied: Kind = kind
    log("view {kind} {text} {copied} {kind is Kind.large}")
    log(kind)
  }
  if let kind: mod Kind = maybe {
    log("mod {kind}")
    log(kind)
  }
  log("parameter: {narrowed(kind: maybe)} {narrowed(kind: none)}")
  log("not narrowed: {written(kind: maybe)} {written(kind: none)}")
  let note: Note = { kind: Kind.large }
  if let kind: view Kind = note.kind {
    log("field {kind}")
  }
  let kinds: List(Kind) = { Kind.large }
  let held: opt view Kind = kinds.viewAt(index: 0)
  let missing: opt view Kind = kinds.viewAt(index: 5)
  if let kind: view Kind = held {
    log("held {kind}")
  }
  log("bound {held} {missing}")
  log(held)
  log(missing)
  change(kind: maybe)
  log("now {maybe}")
}

func enumRows() {
  var rows: List(opt Kind) = { Kind.large, none }
  loop let row: opt view Kind in rows {
    if let there: view Kind = row {
      log("enum {there}")
    }
    log("enum, not narrowed: {row}")
  }
  if let there: mod Kind = rows.modAt(index: 0) {
    log("mod {there}, a call's {rows.viewAt(index: 0)} {rows.viewAt(index: 9)}")
    log(there)
  }
}

