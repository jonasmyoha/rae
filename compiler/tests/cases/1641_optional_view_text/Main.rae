func main() {
  enums()
  enumRows()
  intRows()
  uint8Rows()
  uint64Rows()
  floatRows()
  float64Rows()
  boolRows()
  charRows()
  stringRows()
  structRows()
  listRows()
  genericRows()
  let kind: opt Kind = Kind.large
  show(title: "a generic function's enum", value: kind)
}
