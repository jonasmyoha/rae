# lib/ui's design units (ui/DesignUnits, docs/ui-coordinate-and-responsive-
# layout.md): a du is a logical point, and pixels come only through
# renderScale = dpr; size classes from a layout's width in du; a device
# preset's screen and safe area in du.
open ui/DesignUnits
open ui/SizeClass
open ui/DevicePresets

func near(a: view Float, b: view Float) ret Bool {
  ret Math.abs(value: a - b) < 0.0001
}

func check(label: view String, ok: view Bool) {
  if ok {
    log("ok   {label}")
  } else {
    log("FAIL {label}")
  }
}

func main() {
  check(label: "a du is a point", ok: unitScale is 1.0)
  check(
    label: "pt <-> du: 393 pt is 393 du and back"
    ok: near(a: duFromPoints(points: 393.0), b: 393.0) and near(
      a: pointsFromDu(du: 393.0)
      b: 393.0
    )
  )
  check(
    label: "du -> px: 200 du is 200 px at dpr 1, 400 at 2, 600 at 3"
    ok: near(a: pixelsFromDu(du: 200.0, dpr: 1.0), b: 200.0) and near(
      a: pixelsFromDu(du: 200.0, dpr: 2.0)
      b: 400.0
    ) and near(a: pixelsFromDu(du: 200.0, dpr: 3.0), b: 600.0)
  )
  check(
    label: "px -> du: back again at dpr 1, 2 and 3"
    ok: near(a: duFromPixels(pixels: 200.0, dpr: 1.0), b: 200.0) and near(
      a: duFromPixels(pixels: 400.0, dpr: 2.0)
      b: 200.0
    ) and near(a: duFromPixels(pixels: 600.0, dpr: 3.0), b: 200.0)
  )
  check(
    label: "renderScale is the dpr (a dpr of 0 is taken as 1)"
    ok: near(a: renderScale(dpr: 2.0), b: 2.0) and near(a: renderScale(dpr: 0.0), b: 1.0)
  )
  check(label: "a 44 pt touch target is 44 du", ok: near(a: minTouchTargetDu, b: 44.0))
  let iphone: DevicePreset = devicePresetById(id: "iphone-15-pro")
  let safe: Insets = devicePresetSafeInsetsDu(preset: iphone)
  check(
    label: "iPhone 15 Pro: 393 x 852 du, safe top 59 du, bottom 34 du"
    ok: near(a: devicePresetWidthDu(preset: iphone), b: 393.0) and near(
      a: devicePresetHeightDu(preset: iphone)
      b: 852.0
    ) and near(a: safe.t, b: 59.0) and near(a: safe.b, b: 34.0) and near(a: safe.l, b: 0.0)
  )
  let noInsets: Insets = devicePresetSafeInsetsDu(preset: devicePresetNone())
  check(
    label: "no preset: no safe area"
    ok: noInsets.l is 0.0 and noInsets.t is 0.0 and noInsets.r is 0.0 and noInsets.b is 0.0
  )
  log(
    "size classes at 375 393 430 834 1440 pt: {sizeClassForDu(widthDu: 375.0)} {sizeClassForDu(
      widthDu: 393.0
    )} {sizeClassForDu(widthDu: 430.0)} {sizeClassForDu(widthDu: 834.0)} {sizeClassForDu(
      widthDu: 1440.0
    )}"
  )
}
