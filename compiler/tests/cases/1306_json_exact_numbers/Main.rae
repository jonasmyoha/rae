# lib/Json keeps numbers exact (found 2026-11-02: every number went through a
# 32-bit Float, so 16777217 read back 16777216 and an epoch time in ms came
# back 34 s off). A whole number with no fraction or exponent is an exact Int
# up to 2^63 (jsonInt), any other is a double (jsonFloat64), and writing a
# parsed document back (stringify, jbInt, jbNumber64) loses nothing.
open Json

func intOf(doc: view JsonDoc, key: view String) ret Int {
  ret Json.jsonInt(
    this: Json.jsonValueAt(doc: doc, idx: Json.field(doc: doc, this: Json.root(doc: doc), key: key))
    fallback: -1
  )
}

func doubleOf(doc: view JsonDoc, key: view String) ret Float64 {
  ret Json.jsonFloat64(
    this: Json.jsonValueAt(doc: doc, idx: Json.field(doc: doc, this: Json.root(doc: doc), key: key))
    fallback: -1.0
  )
}

func main() {
  let text: String = "\{\"above24\":16777217,\"above53\":9007199254740993,\"time\":1793581548749,\"negative\":-42,\"largest\":9223372036854775807,\"over\":9223372036854775808,\"smallest\":-9223372036854775808,\"half\":1.5,\"exponent\":2.5e3,\"tiny\":1e-7\}"
  let doc: JsonDoc = Json.parseJson(source: text)
  log("parsed: {doc.ok}")
  log("2^24 + 1: {intOf(doc: doc, key: "above24")}")
  log("2^53 + 1: {intOf(doc: doc, key: "above53")}")
  log("an epoch time in ms: {intOf(doc: doc, key: "time")}")
  log("a negative: {intOf(doc: doc, key: "negative")}")
  log("the largest Int: {intOf(doc: doc, key: "largest")}")
  log("one past it, clamped: {intOf(doc: doc, key: "over")}")
  log("the smallest Int: {intOf(doc: doc, key: "smallest")}")
  log(
    "a fraction as an Int: {intOf(doc: doc, key: "half")}, as a double: {doubleOf(
      doc: doc
      key: "half"
    )}"
  )
  log(
    "an exponent as an Int: {intOf(doc: doc, key: "exponent")}, as a double: {doubleOf(
      doc: doc
      key: "exponent"
    )}"
  )
  log("written back: {Json.stringify(doc: doc, value: Json.root(doc: doc))}")
  log("jbNumber64(0.1): {jbNumber64(value: 0.1)}, of 1/3: {jbNumber64(value: 1.0 / 3.0)}")
  let third: Float64 = 1.0 / 3.0
  let reread: JsonDoc = Json.parseJson(source: "[{jbNumber64(value: third)}]")
  let back: Float64 = Json.jsonFloat64(
    this: Json.arrayAt(doc: reread, this: Json.root(doc: reread), idx: 0)
    fallback: 0.0
  )
  log("1/3 survives a write and a read: {back is third}")
  log("jbInt(-9007199254740993): {jbInt(value: -9007199254740993)}")
}
