import core

# Rae has NO type inference — every value binding states its type on the LHS.
# `let x = <expr>` (type inferred from the RHS) is a compile error.
type Rect { position: Int, size: Int }
func makeR() ret Rect { ret Rect { position: 1, size: 2 } }

func main() {
  let x = 5
  let q = makeR()
  log("unreached {x} {q.size}")
}
