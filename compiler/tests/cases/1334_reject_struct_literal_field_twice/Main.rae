# A struct literal that gives one field twice is an error at the second,
# naming the first's line, both as a binding's literal and as a `ret`'s.
# It used to compile: the emitted C initializer named the field twice and
# kept the last value, which only the C warnings gate noticed
# (-Winitializer-overrides).
type Timing {
  passes: Int
  total: Int
  first: Int
  last: Int
  samples: Int
}

func emptyTiming() ret Timing {
  ret Timing {
    passes: 0
    total: 0
    first: 0
    last: 0
    passes: 1
  }
}

func main() {
  let timing: Timing = {
    passes: 2
    total: 10
    first: 1
    last: 9
    total: 20
  }
  log("{timing.total} {emptyTiming().passes}")
}
