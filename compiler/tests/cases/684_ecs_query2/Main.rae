open ecs/Entity
open ecs/ComponentTable
open ecs/Query

# #707: query2 joins two component tables — iterate the SMALLER table, probe the
# other by index, and yield each match with storage-aliasing mod access. Here
# pos has 3 entities and vel has 2, so query2 walks vel (the smaller) and probes
# pos. The loop reads vel.v through a view ref and adds it to pos.x through a mod
# ref; the write must alias table storage and be visible on read-back.

type Position { x: Int }
type Velocity { v: Int }

func posOf(table: view ComponentTable(Position), entity: view EntityId) ret Int {
  if componentHas(this: table, entity: entity) {
    let p: Position = componentGet(this: table, entity: entity)
    ret p.x
  }
  ret 0 - 1
}

func main() {
  var pos: ComponentTable(Position) = createComponentTable(Position)
  var vel: ComponentTable(Velocity) = createComponentTable(Velocity)
  let e1: EntityId = { index: 1, generation: 0 }
  let e2: EntityId = { index: 2, generation: 0 }
  let e3: EntityId = { index: 3, generation: 0 }
  componentSet(this: pos, entity: e1, data: Position { x: 10 })
  componentSet(this: pos, entity: e2, data: Position { x: 20 })
  componentSet(this: pos, entity: e3, data: Position { x: 30 })
  componentSet(this: vel, entity: e2, data: Velocity { v: 2 })
  componentSet(this: vel, entity: e3, data: Velocity { v: 3 })

  let hits: List(Query2Match) = query2(tableA: pos, tableB: vel)
  log("q2 count: {hits.length}")
  loop let row: view Query2Match in hits {
    let velocity: view Velocity => queryViewAt(table: vel, denseIndex: row.indexB)
    let posx: mod Position => queryModAt(table: pos, denseIndex: row.indexA)
    posx.x = posx.x + velocity.v
  }
  # e1 has no Velocity so it is not in the join and stays 10; e2 -> 22, e3 -> 33.
  log("e1.x: {posOf(table: pos, entity: e1)}")
  log("e2.x: {posOf(table: pos, entity: e2)}")
  log("e3.x: {posOf(table: pos, entity: e3)}")
}
