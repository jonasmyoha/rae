pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../../../.."
      subdir: "packages/audio"
      version: "0.17.0"
      hash: "git-tree:7e5d0bca5751539d3f39a6ecdc6bb8fd4ef100cf"
