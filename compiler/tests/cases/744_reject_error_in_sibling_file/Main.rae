
# #815: the sema error lives HERE, in the entry file. The diagnostic must name
# main.rae — not the sibling the module merge happened to load last.
func nudge(position: view Position) {
  position.x = 1
}

func main() {
  let p: Position = { x: 0 }
  nudge(position: p)
  log(describe(position: p))
}
