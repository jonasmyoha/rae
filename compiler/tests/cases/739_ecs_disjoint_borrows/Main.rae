import core
open ecs/Entity
open ecs/ComponentTable
open ecs/Query

# #812: pins the documented, PERMITTED borrow shapes every system relies on
# (docs/ecs-api-reference.md "Borrowing rules"). If a future checker tightening
# rejects any of these, the 114 walker breaks — this test says so first.
#   1. two disjoint tables of one world borrowed `mod` at once (a query loop);
#   2. one element ref threaded through several calls;
#   3. an element ref into one table plus a ref into another;
#   4. mutating a DIFFERENT List while a modAt binding is live.
# The one hazard (structural mutation of the table you hold a ref into) is NOT
# pinned here on purpose — it is #814's reject test.

type Pos { x: Int }
type Vel { v: Int }
type World { positions: ComponentTable(Pos), velocities: ComponentTable(Vel) }

func bump(p: mod Pos) { p.x = p.x + 1 }
func ground(p: mod Pos, floor: view Int) { if p.x < floor { p.x = floor } }

func main() {
  var world: World = { positions: createComponentTable(Pos), velocities: createComponentTable(Vel) }
  let e1: EntityId = { index: 1, generation: 0 }
  let e2: EntityId = { index: 2, generation: 0 }
  componentSet(this: world.positions, entity: e1, data: Pos { x: 10 })
  componentSet(this: world.positions, entity: e2, data: Pos { x: 20 })
  componentSet(this: world.velocities, entity: e1, data: Vel { v: 1 })
  componentSet(this: world.velocities, entity: e2, data: Vel { v: 2 })

  # 1. disjoint tables, both mod, one system
  loop let entity: EntityId, p: mod Pos, vv: mod Vel in query2(tableA: world.positions, tableB: world.velocities) {
    p.x = p.x + vv.v
    vv.v = vv.v * 10
  }
  log("after system: e1={componentGet(this: world.positions, entity: e1).x}/{componentGet(this: world.velocities, entity: e1).v} e2={componentGet(this: world.positions, entity: e2).x}/{componentGet(this: world.velocities, entity: e2).v}")

  # 2. one element ref threaded through calls (the 114 walker shape)
  let c: mod Pos => componentMod(this: world.positions, entity: e1)
  bump(p: c)
  bump(p: c)
  ground(p: c, floor: 100)
  log("threaded ref: e1.x={componentGet(this: world.positions, entity: e1).x}")

  # 3. a ref into one table plus a ref into another, at once
  let p2: mod Pos => componentMod(this: world.positions, entity: e2)
  let v2: view Vel => componentView(this: world.velocities, entity: e2)
  p2.x = p2.x + v2.v
  log("two-table refs: e2.x={componentGet(this: world.positions, entity: e2).x}")

  # 4. modAt binding live while a DIFFERENT List is mutated
  var xs: List(Int) = createList(Int, cap: 1)
  var ys: List(Int) = createList(Int, cap: 1)
  xs.add(value: 5)
  if let q: mod Int => xs.modAt(index: 0) {
    ys.add(value: 6)
    ys.add(value: 7)
    q = q + ys.length
  }
  log("other-list mutation: xs0={xs.copyAt(index: 0)} ys={ys.length}")
}
