# lib/net/Poller (docs/server-benchmarks-design.md §9 G2): readiness over many
# sockets. Two accepted loopback sockets, data on one: only that one is ready.
# A wait allocates nothing (the caller's list keeps its capacity).
open net/Tcp
open net/Poller

func acceptWithin(listenerSocketId: view SocketId) ret socketId: SocketId, status: NetStatus {
  loop var attempt: Int = 0, attempt < 200, ++attempt {
    let acceptedSocketId: SocketId = socketId,
      let acceptedStatus: NetStatus = status = tcpAccept(listenerSocketId: listenerSocketId)
    if acceptedStatus is not NetStatus.wouldBlock {
      ret socketId: acceptedSocketId, status: acceptedStatus
    }
    sleep(ms: 5)
  }
  ret socketId: noSocket(), status: NetStatus.wouldBlock
}

# Which of the two server sockets a wait reported, and how
func describe(ready: view List(Readiness), first: view SocketId, second: view SocketId) ret String {
  var text: String = "{ready.length} ready:"
  loop let readiness: Readiness in ready {
    var name: String = "other"
    if readiness.socketId.handle is first.handle {
      name = "first"
    } else if readiness.socketId.handle is second.handle {
      name = "second"
    }
    text = "{text} {name}(readable {readiness.readable}, writable {readiness.writable}, closed {readiness.closed})"
  }
  ret text
}

func main() ret Int {
  let listeningSocketId: SocketId = socketId,
    let listeningStatus: NetStatus = status = tcpListen(host: "127.0.0.1", port: 0, backlog: 16)
  if let port: Int = socketLocalPort(socketId: listeningSocketId) {
    let clientOneSocketId: SocketId = socketId,
      let clientOneStatus: NetStatus = status = tcpConnect(
        host: "127.0.0.1"
        port: port
        timeoutMs: 2000
      )
    let serverOneSocketId: SocketId = socketId,
      let serverOneStatus: NetStatus = status = acceptWithin(listenerSocketId: listeningSocketId)
    let clientTwoSocketId: SocketId = socketId,
      let clientTwoStatus: NetStatus = status = tcpConnect(
        host: "127.0.0.1"
        port: port
        timeoutMs: 2000
      )
    let serverTwoSocketId: SocketId = socketId,
      let serverTwoStatus: NetStatus = status = acceptWithin(listenerSocketId: listeningSocketId)
    log("accepted both: {serverOneStatus} {serverTwoStatus}")

    var poller: Poller = createPoller()
    log("poller: {poller.status}")
    log("watch first: {pollerWatch(
      poller: poller
      socketId: serverOneSocketId
      readable: true
      writable: false
    )}")
    log("watch second: {pollerWatch(
      poller: poller
      socketId: serverTwoSocketId
      readable: true
      writable: false
    )}")

    var ready: List(Readiness) = List.create(Readiness, cap: 16)
    let capacity: Int = ready.cap
    # Nothing written yet: a short wait times out empty
    log(
      "before data: {pollWait(poller: poller, ready: ready, timeoutMs: 20)}, {describe(
        ready: ready
        first: serverOneSocketId
        second: serverTwoSocketId
      )}"
    )

    # Data only on the first connection: only the first is ready
    let sentBytes: Int = bytes,
      let sentStatus: NetStatus = status = socketWriteText(
        socketId: clientOneSocketId
        text: "ping"
      )
    log(
      "after data: {pollWait(poller: poller, ready: ready, timeoutMs: 2000)}, {describe(
        ready: ready
        first: serverOneSocketId
        second: serverTwoSocketId
      )}"
    )
    var bytes: List(UInt8) = List.create(UInt8, cap: 8)
    let gotBytes: Int = bytes,
      let gotStatus: NetStatus = status = socketRead(
        socketId: serverOneSocketId
        bytes: bytes
        maxBytes: 64
      )
    log("read {gotBytes} bytes: {textFromBytes(bytes: bytes, start: 0, count: gotBytes)}")
    log(
      "drained: {pollWait(poller: poller, ready: ready, timeoutMs: 20)}, {describe(
        ready: ready
        first: serverOneSocketId
        second: serverTwoSocketId
      )}"
    )

    # Writable interest: a fresh connection has room to send
    log("watch first for writing: {pollerWatch(
      poller: poller
      socketId: serverOneSocketId
      readable: false
      writable: true
    )}")
    log(
      "writable: {pollWait(poller: poller, ready: ready, timeoutMs: 2000)}, {describe(
        ready: ready
        first: serverOneSocketId
        second: serverTwoSocketId
      )}"
    )
    log("forget writing: {pollerForget(
      poller: poller
      socketId: serverOneSocketId
      readable: false
      writable: true
    )}")
    log(
      "after forget: {pollWait(poller: poller, ready: ready, timeoutMs: 20)}, {describe(
        ready: ready
        first: serverOneSocketId
        second: serverTwoSocketId
      )}"
    )

    # The second peer closes: its socket is readable (end of stream) and closed
    socketClose(socketId: clientTwoSocketId)
    log(
      "peer closed: {pollWait(poller: poller, ready: ready, timeoutMs: 2000)}, {describe(
        ready: ready
        first: serverOneSocketId
        second: serverTwoSocketId
      )}"
    )

    # Many waits, no growth
    loop var i: Int = 0, i < 50, ++i {
      let status: NetStatus = pollWait(poller: poller, ready: ready, timeoutMs: 0)
    }
    log("capacity kept: {ready.cap is capacity}")

    closePoller(poller: poller)
    log("closed poller: {pollWait(poller: poller, ready: ready, timeoutMs: 0)}")
    socketClose(socketId: clientOneSocketId)
    socketClose(socketId: serverOneSocketId)
    socketClose(socketId: serverTwoSocketId)
    socketClose(socketId: listeningSocketId)
    ret 0
  }
  log("the listener has no port")
  ret 1
}
