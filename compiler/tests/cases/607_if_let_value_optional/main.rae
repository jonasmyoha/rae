# `if let` narrowing a PRODUCED owned optional (spec 4.2): ownership transfer.
# `find` returns `opt Track` — an offer of ownership — so the narrowing takes
# the payload with `=`, owns it for the branch, and drops it at the end. A
# `view` binding here is rejected (test 617): a view refuses ownership, and
# `if` adds a presence test, not an owner.
#
# The `opt T` FIELD case stays: viewing into a stored optional is legal, the
# payload's storage is the place itself.
import core

type Track { title: String, seconds: Int }
type Player { name: String, nowPlaying: opt Track }

func find(tracks: view List(Track), title: view String) ret opt Track {
  loop let track: view Track in tracks {
    if track.title is title {
      ret track
    }
  }
  ret none
}

func main() {
  var tracks: List(Track) = createList(Track, cap: 2)
  tracks.add(value: Track { title: "Intro", seconds: 95 })
  tracks.add(value: Track { title: "Outro", seconds: 143 })

  if let track: Track = find(tracks: tracks, title: "Outro") {
    log("found {track.title} / {track.seconds}")
  } else {
    log("found nothing")
  }

  if let track: Track = find(tracks: tracks, title: "Coda") {
    log("unexpectedly found {track.title}")
  } else {
    log("no track called Coda")
  }

  let player: Player = { name: "deck", nowPlaying: Track { title: "Intro", seconds: 95 } }
  if let track: view Track => player.nowPlaying {
    log("field present: {track.title} / {track.seconds}")
  }
  let idle: Player = { name: "idle", nowPlaying: none }
  if let track: view Track => idle.nowPlaying {
    log("unexpected: {track.title}")
  } else {
    log("empty field: none, as expected")
  }
}
