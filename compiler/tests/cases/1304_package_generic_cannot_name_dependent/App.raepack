pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep todo: {
      path: "vendor/todo"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
