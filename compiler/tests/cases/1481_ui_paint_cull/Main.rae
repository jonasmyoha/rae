# Drawing only what is on screen (lib/ui/renderSystem/RenderCull) on an 800 x 600 viewport: a node
# fully on screen, half on screen and fully off; one just off but within the margin; one off whose
# shadow reaches back in; a rotated one off screen (drawn: its bounds are not tested); an off-screen
# clip container (its subtree is skipped) and an unclipped one (its children are still walked);
# and a node a Camera2D's zoom puts off screen.
open ecs/ComponentTable
open ecs/Entity
open ui/Components
open ui/Ecs
open ui/Scene
open ui/SceneLoader
open ui/Transform
open ui/UiSystems
open ui/cameraSystem/CameraSystem
open ui/layoutSystem/LayoutSystem
open ui/renderSystem/RenderCull
open ui/renderSystem/RenderSystem

func node(world: view UiWorld, nodeId: view String) ret EntityId {
  if let index: Int = world.nodeIds.get(k: nodeId) {
    ret nodeEntityId(world: world, index: index)
  }
  ret noEntity()
}

func report(world: view UiWorld, uiSystems: view UiSystems, nodeId: view String) {
  let off: Bool = paintOffScreen(
    world: world
    uiSystems: uiSystems
    entityId: node(world: world, nodeId: nodeId)
    viewW: 800.0
    viewH: 600.0
  )
  var drawn: String = "drawn"
  if off {
    drawn = "skipped"
  }
  log("{nodeId}: {drawn}")
}

func main() {
  var world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  world.layoutW = 800.0
  world.layoutH = 600.0
  let unusedPage: EntityId = loadScene(
    world: world
    uiSystems: uiSystems
    scene: parseScene(
      source: "\{\"type\":\"Scene\",\"version\":2,\"root\":\"Page\",\"nodes\":\{\"Page\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":800,\"h\":600\},\"Children\":[\"Inside\",\"HalfOn\",\"Off\",\"JustOff\",\"ShadowIn\",\"Turned\",\"ClipBox\",\"OpenBox\",\"Zoomed\"]\},\"Inside\":\{\"Rect\":\{\"x\":100,\"y\":100,\"w\":100,\"h\":50\}\},\"HalfOn\":\{\"Rect\":\{\"x\":700,\"y\":100,\"w\":200,\"h\":50\}\},\"Off\":\{\"Rect\":\{\"x\":900,\"y\":100,\"w\":100,\"h\":50\}\},\"JustOff\":\{\"Rect\":\{\"x\":805,\"y\":200,\"w\":40,\"h\":20\}\},\"ShadowIn\":\{\"Rect\":\{\"x\":840,\"y\":300,\"w\":40,\"h\":20\},\"Shadow\":\{\"blur\":20\}\},\"Turned\":\{\"Rect\":\{\"x\":1200,\"y\":100,\"w\":40,\"h\":20\},\"TransformFx\":\{\"scaleX\":1,\"scaleY\":1,\"rotation\":0.5,\"alpha\":1,\"visible\":true,\"pivot\":\{\"x\":0,\"y\":0\},\"anchor\":\{\"x\":0,\"y\":0\}\}\},\"ClipBox\":\{\"Rect\":\{\"x\":0,\"y\":700,\"w\":200,\"h\":100\},\"Overflow\":\{\"mode\":\"Clip\"\},\"Children\":[\"ClipChild\"]\},\"ClipChild\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":50,\"h\":50\}\},\"OpenBox\":\{\"Rect\":\{\"x\":0,\"y\":700,\"w\":200,\"h\":100\},\"Children\":[\"OpenChild\"]\},\"OpenChild\":\{\"Rect\":\{\"x\":0,\"y\":-650,\"w\":50,\"h\":50\}\},\"Zoomed\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":800,\"h\":600\},\"Children\":[\"FarAtZoom\",\"NearAtZoom\"]\},\"FarAtZoom\":\{\"Rect\":\{\"x\":450,\"y\":10,\"w\":40,\"h\":20\}\},\"NearAtZoom\":\{\"Rect\":\{\"x\":300,\"y\":10,\"w\":40,\"h\":20\}\}\}\}"
    )
  )
  componentSet(
    this: world.cameras
    entityId: node(world: world, nodeId: "Zoomed")
    data: Camera2D { zoom: 2.0, offsetX: 0.0, offsetY: 0.0 }
  )
  cameraSystem(world: world, uiSystems: uiSystems)
  layoutSystem(world: world, uiSystems: uiSystems)
  transformSystem(world: world, uiSystems: uiSystems)
  loop let nodeId: view String in List(String) {
    "Inside"
    "HalfOn"
    "Off"
    "JustOff"
    "ShadowIn"
    "Turned"
    "ClipBox"
    "OpenBox"
    "OpenChild"
    "FarAtZoom"
    "NearAtZoom"
  } {
    report(world: world, uiSystems: uiSystems, nodeId: nodeId)
  }
  let clipBox: EntityId = node(world: world, nodeId: "ClipBox")
  let openBox: EntityId = node(world: world, nodeId: "OpenBox")
  log("ClipBox's subtree skipped with it: {paintClipsSubtree(world: world, entityId: clipBox)}")
  log("OpenBox's children still walked: {not paintClipsSubtree(world: world, entityId: openBox)}")
}
