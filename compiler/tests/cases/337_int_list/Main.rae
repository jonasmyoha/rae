# A small Int list over the generic List(T): push three values, read them
# back by index, and report the length. (Was a hand-rolled Buffer(Int)
# prototype before List(T) existed; #820 folded it onto List(Int).)
func main() {
  var list: List(Int) = createList(Int, cap: 2)
  list.add(value: 100)
  list.add(value: 200)
  list.add(value: 300)

  log(list.copyAtDefault(index: 0))
  log(list.copyAtDefault(index: 1))
  log(list.copyAtDefault(index: 2))
  log(list.length)
}
