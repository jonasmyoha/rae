# What a list refuses: comparing optionals, and every copy of a Task out of one
func work(number: copy Int) ret Int {
  ret number
}

func main() {
  var numbers: List(opt Int) = { 1, none }
  log("{numbers.contains(value: 1)}")  # ERROR
  if let index: Int = numbers.indexOf(value: 1) {
    # ERROR
    log("{index}")
  }
  numbers.sort()  # ERROR
  let optionals: List(opt Task(Int)) = { spawn work(number: 1), none }
  let tasks: List(Task(Int)) = { spawn work(number: 1) }
  loop let task: opt Task(Int) in optionals {
    # ERROR
    log("a copy")
  }
  loop let task: Task(Int) in tasks {
    # ERROR
    log("a copy")
  }
  let first: opt Task(Int) = optionals.copyAtDefault(index: 0)  # ERROR
  let second: Task(Int) = tasks.copyAtDefault(index: 0)  # ERROR
  let third: opt Task(Int) = optionals.copyAtFallback(index: 0, fallback: none)  # ERROR
  let fourth: opt Task(Int) = optionals.copyAt(index: 0)  # ERROR
  loop let task: view Task(Int) in tasks {
    log("a view {task.get()}")
  }
}
