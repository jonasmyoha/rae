import Math
import WorldBiome
open water/Water
open water/FftSurfaceCache

func main() {
  var body: WaterBody = createOceanRealistic(surfaceZ: 0.0)
  let ground: Float = WorldBiome.worldTerrainHeight(
    x: 20.0
    y: 0.0
    groundZ: -1.0
    cfg: WorldBiome.defaultBiomeConfig()
  )
  log("disabled {biomeShoreEnergy(body: body, x: 20.0, y: 0.0) is 1.0}")
  body.biomeGroundZ = -1.0
  body.biomeShoreDepth = 2.0
  body.center.z = ground - 0.1
  log("land {biomeShoreEnergy(body: body, x: 20.0, y: 0.0) is 0.0}")
  body.center.z = ground
  log("waterline {biomeShoreEnergy(body: body, x: 20.0, y: 0.0) is 0.0}")
  body.center.z = ground + 1.0
  let energy: Float = biomeShoreEnergy(body: body, x: 20.0, y: 0.0)
  log("half depth {Math.abs(value: energy - 0.5) < 0.0001}")
  let queryEnergy: Float = fftSurfaceEnergy(
    body: body
    x: 20.0
    y: 0.0
    time: 2.0
  )
  let expected: Float = oceanMacroEnergy(x: 20.0, y: 0.0, time: 2.0) * energy
  log("query uses coast {Math.abs(value: queryEnergy - expected) < 0.0001}")
  body.fftAmplitude = 0.35
  let scaled: Float = fftSurfaceEnergy(
    body: body
    x: 20.0
    y: 0.0
    time: 2.0
  )
  log("amplitude matches query {Math.abs(value: scaled - expected * 0.35) < 0.0001}")
  body.center.z = ground + 4.0
  log("offshore {biomeShoreEnergy(body: body, x: 20.0, y: 0.0) is 1.0}")
  # A wider island (143's forest world): 150 m out the default island has sunk
  # into the sea bed, the wide one has not, and the coast follows the body's
  # biome, not the default
  var wide: BiomeConfig = WorldBiome.defaultBiomeConfig()
  wide.islandRadius = 1000000.0
  let wideGround: Float = WorldBiome.worldTerrainHeight(
    x: 150.0
    y: 0.0
    groundZ: -1.0
    cfg: wide
  )
  let defaultGround: Float = WorldBiome.worldTerrainHeight(
    x: 150.0
    y: 0.0
    groundZ: -1.0
    cfg: WorldBiome.defaultBiomeConfig()
  )
  log("the default island has sunk there {defaultGround < wideGround - 0.5}")
  body.biome = wide
  body.center.z = wideGround - 0.1
  log("wide island: dry land there {biomeShoreEnergy(body: body, x: 150.0, y: 0.0) is 0.0}")
  let constants: List(ShaderConstant) = WorldBiome.islandConstantsFor(cfg: wide)
  log("wide island: shader radius {constants.copyAtDefault(index: 0).value is 1000000.0}")
}
