# #880: a constructor is any function named `create` returning T or opt T.
# A bare `create(...)` is resolved by the type of the position it sits in —
# a typed binding, an `if let` binding, a struct-literal field, a call
# argument — exactly where an untyped struct literal is legal. `T.create(...)`
# names the type where there is no expected type (`ret`). Generic types bind
# their arguments from the expected type: `let names: List(String) =
# create(cap: 4)`.
type Slot {
  id: Int
}

func create(id: view Int) ret Slot {
  log("create slot {id}")
  ret Slot { id: id }
}

func drop(this: mod Slot) {
  log("release {this.id}")
}

type Pond {
  depth: Float
}

# A fallible constructor returns opt T.
func create(depth: view Float) ret opt Pond {
  if depth <= 0.0 {
    ret none
  }
  log("create pond {depth}")
  ret Pond { depth: depth }
}

type Holder {
  name: String
  slots: List(Slot)
  first: Slot
}

func createHolder() ret Holder {
  ret Holder { name: "holder", slots: create(cap: 2), first: create(id: 7) }
}

func inspect(slot: view Slot) {
  log("inspect {slot.id}")
}

func take(slot: own Slot) {
  log("take {slot.id}")
}

func fresh() ret Slot {
  ret Slot.create(id: 9)
}

func main() {
  log("-- typed binding")
  let a: Slot = create(id: 1)
  log("-- call argument")
  inspect(slot: create(id: 2))
  take(slot: create(id: 3))
  log("-- if let on a fallible constructor")
  if let pond: Pond = create(depth: 2.5) {
    log("pond {pond.depth}")
  }
  if let dry: Pond = create(depth: 0.0) {
    log("unexpected {dry.depth}")
  } else {
    log("no pond")
  }
  log("-- struct literal fields, generic list by field type")
  var holder: Holder = createHolder()
  holder.slots.add(value: create(id: 4))
  log("holder {holder.name} has {holder.slots.length} slots, first {holder.first.id}")
  log("-- generic types by expected type")
  let names: List(String) = create(cap: 4)
  names.add(value: "a")
  names.add(value: "b")
  log("names {names.length}")
  let counts: List(Int) = List(Int).create(cap: 1)
  counts.add(value: 5)
  log("counts {counts.length}")
  log("-- type-qualified in ret")
  let nine: Slot = fresh()
  log("nine {nine.id}")
  log("-- end of main")
}
