open app3d/GroveTrees
open procgen/Ginkgo
open procgen/SculpturalFork
open Mesh3d
open Vec3
import Math

func validGinkgo(
  mesh: view MeshData
  foliage: view Bool
  bound: view Float
  height: view Float
) ret Bool {
  if mesh.vertCount < 1 or mesh.vertCount > 12000 or mesh.verts.length is not mesh.vertCount * 8 {
    ret false
  }
  loop let value: Float in mesh.verts {
    if value is not value or Math.abs(value: value) > 20 {
      ret false
    }
  }
  loop let index: Int in mesh.indices {
    if index < 0 or index >= mesh.vertCount {
      ret false
    }
  }
  loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
    if Math.abs(value: vlen(a: forkNormal(mesh: mesh, index: vertex)) - 1) > 0.002 {
      ret false
    }
    var center: Vec3 = forkPoint(mesh: mesh, index: vertex)
    var allowance: Float = 0
    if foliage {
      if mesh.windPivots.length is not mesh.vertCount * 4 or mesh.leafCards.length is not mesh.vertCount * 4 {
        ret false
      }
      center = Vec3.create(
        x: mesh.leafCards.copyAtDefault(index: vertex * 4)
        y: mesh.leafCards.copyAtDefault(index: vertex * 4 + 1)
        z: mesh.leafCards.copyAtDefault(index: vertex * 4 + 2)
      )
      allowance = vlen(a: vsub(a: forkPoint(mesh: mesh, index: vertex), b: center)) + 0.03 * height
      let first: Int = vertex / 12 * 12
      loop var field: Int = 0, field < 4, ++field {
        if mesh.windPivots.copyAtDefault(index: first * 4 + field) is not mesh.windPivots.copyAtDefault(
          index: vertex * 4 + field
        ) {
          ret false
        }
      }
    } else {
      if mesh.windPivots.length is not 0 {
        ret false
      }
      let barkHeight: Float = mesh.verts.copyAtDefault(index: vertex * 8 + 7)
      if barkHeight < 0.029 or barkHeight > 0.971 {
        ret false
      }
    }
    let radius: Float = vlen(a: vsub(a: center, b: Vec3.create(x: 0, y: 0, z: height * 0.55))) + allowance
    if radius > bound {
      log("outside bound: {radius} > {bound}")
      ret false
    }
  }
  ret true
}

func main() ret Int {
  if speciesOrange is not 4 or speciesRed is not 5 or speciesGold is not 6 or speciesCrimson is not 7 {
    ret 1
  }
  var seeds: List(Int) = {
    1125
    311
    1021
    1437
    2189
    4201
  }
  loop var sample: Int = 0, sample < 64, ++sample {
    seeds.add(value: 311 + sample * 104)
  }
  loop let seed: Int in seeds {
    let tree: GinkgoTree = ginkgoTree(seed: seed, height: autumnReferenceHeight, width: 2)
    let repeat: GinkgoTree = ginkgoTree(seed: seed, height: autumnReferenceHeight, width: 2)
    if tree.sprays.length is not 33 or not validGinkgo(
      mesh: tree.wood
      foliage: false
      bound: autumnReferenceHeight * ginkgoRadiusScale
      height: autumnReferenceHeight
    ) {
      ret 2
    }
    loop var index: Int = 0, index < tree.wood.verts.length, ++index {
      if tree.wood.verts.copyAtDefault(index: index) is not repeat.wood.verts.copyAtDefault(
        index: index
      ) {
        ret 3
      }
    }
    loop var tone: Int = 0, tone < 3, ++tone {
      let leaves: MeshData = ginkgoLeaves(tree: tree, seed: seed, tone: tone)
      if not validGinkgo(
        mesh: leaves
        foliage: true
        bound: autumnReferenceHeight * ginkgoRadiusScale
        height: autumnReferenceHeight
      ) {
        ret 4
      }
      if leaves.vertCount is not 132 or leaves.indices.length is not 198 {
        ret 5
      }
    }
  }
  let near: List(MeshData) = speciesLevelMeshes(
    species: 6
    patches: nearPatches
    leaves: nearLeaves
  )
  let middle: List(MeshData) = speciesLevelMeshes(
    species: 6
    patches: midPatches
    leaves: midLeaves
  )
  if near.length is not 4 or middle.length is not 4 {
    ret 6
  }
  loop var part: Int = 0, part < 4, ++part {
    let first: MeshData = near.copyAtDefault(index: part)
    let second: MeshData = middle.copyAtDefault(index: part)
    if first.verts.length is not second.verts.length {
      ret 7
    }
    loop var index: Int = 0, index < first.verts.length, ++index {
      if first.verts.copyAtDefault(index: index) is not second.verts.copyAtDefault(index: index) {
        ret 8
      }
    }
  }
  log("ginkgo: kind 6, 70 deterministic crowns, rigid joined wood, shared levels, bounded cards")
  ret 0
}
