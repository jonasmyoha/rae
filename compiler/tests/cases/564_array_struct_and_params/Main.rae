# Array as a struct field, through view/mod parameters, returned by value,
# and nested — the shapes a Mat4 has to survive (#352, slice 2). Access is
# List-shaped: `set`, `copyAtFallback`, and `modAt`/`viewAt` aliases.
type Mat4 {
  m: Array(Float, cap: 16)
}

func identity() ret Mat4 {
  var out: Mat4 = { m: Array(Float, cap: 16) }
  out.m.set(index: 0, value: 1.0)
  out.m.set(index: 5, value: 1.0)
  out.m.set(index: 10, value: 1.0)
  out.m.set(index: 15, value: 1.0)
  ret out
}

func trace(v: view Array(Float, cap: 16)) ret Float {
  ret v.copyAtFallback(index: 0, fallback: 0.0) + v.copyAtFallback(index: 5, fallback: 0.0) + v.copyAtFallback(
    index: 10
    fallback: 0.0
  ) + v.copyAtFallback(index: 15, fallback: 0.0)
}

func scaleFirst(v: mod Array(Float, cap: 16), by: view Float) {
  v.set(index: 0, value: v.copyAtFallback(index: 0, fallback: 0.0) * by)
}

func main() {
  let id: Mat4 = identity()
  log("trace={trace(v: id.m)}")

  # A copy passed as `mod` must not write through to the source.
  var mm: Array(Float, cap: 16) = id.m
  scaleFirst(v: mm, by: 4.0)
  log(
    "mm0={mm.copyAtFallback(index: 0, fallback: 0.0)} id0={id.m.copyAtFallback(
      index: 0
      fallback: 0.0
    )}"
  )

  # Nested aggregate: modAt aliases the inner array in place.
  var grid: Array(Array(Float, cap: 2), cap: 2) = Array(Array(Float, cap: 2), cap: 2)
  if let row: mod Array(Float, cap: 2) => grid.modAt(index: 1) {
    row.set(index: 0, value: 7.5)
  }
  var seen: Float = 0.0
  var zero: Float = 1.0
  if let row: view Array(Float, cap: 2) => grid.viewAt(index: 1) {
    seen = row.copyAtFallback(index: 0, fallback: -1.0)
  }
  if let row: view Array(Float, cap: 2) => grid.viewAt(index: 0) {
    zero = row.copyAtFallback(index: 0, fallback: -1.0)
  }
  log("grid={seen} zero={zero}")
}
