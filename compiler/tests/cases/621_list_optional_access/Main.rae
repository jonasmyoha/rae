import core

type FloatPalette {
  values: List(Float)
}

func paletteValueAt(palette: view FloatPalette, index: view Int) ret Float {
  if let value: Float = palette.values.copyAt(index: index) { ret value }
  ret -1.0
}

func main() {
  var values: List(Int) = { 10, 20, 30 }

  if let value: Int = values.copyAt(index: 1) {
    log("at valid: {value}")
  }
  if let value: Int = values.copyAt(index: 0 - 1) {
    log("unexpected negative: {value}")
  } else {
    log("at negative: none")
  }
  if let value: Int = values.copyAt(index: values.length) {
    log("unexpected length: {value}")
  } else {
    log("at length: none")
  }
  if let value: view Int => values.viewAt(index: 2) {
    log("viewAt valid: {value}")
  }
  if let value: mod Int => values.modAt(index: 1) {
    value = value + 5
  }
  if let value: Int = values.copyAt(index: 1) {
    log("modAt valid: {value}")
  }
  if let value: mod Int => values.modAt(index: 99) {
    value = 0
  } else {
    log("modAt invalid: none")
  }

  var palette: FloatPalette = { values: createList(Float, cap: 1) }
  palette.values.add(value: 0.25)
  log("field float: {paletteValueAt(palette: palette, index: 0)}")
}
