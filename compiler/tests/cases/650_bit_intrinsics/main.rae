# Bit intrinsics over the 64-bit two's-complement Int (#355 track C(c)):
# popcount, leadingZeros, trailingZeros — mapped to the CPU builtins, with a
# defined answer of 64 for leading/trailing zeros of 0.
import core
import math
open math

func main() {
  log(popcount(x: 7))
  log(popcount(x: 255))
  log(popcount(x: 0))
  log(trailingZeros(x: 8))
  log(trailingZeros(x: 1))
  log(trailingZeros(x: 0))
  log(leadingZeros(x: 1))
  log(leadingZeros(x: 0))
}
