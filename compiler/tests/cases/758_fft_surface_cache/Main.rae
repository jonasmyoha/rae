import Math
open water/Water
open water/FftSurfaceCache

func fillCache(cache: mod FftSurfaceCache, count: copy Int) {
  cache.activeCount = count
  loop var i: Int = 0, i < count, ++i {
    if let cascade: mod FftCascadeCache => cache.cascades.modAt(index: i) {
      cascade.generation = cache.generation
      cascade.tileSize = 32.0
      cascade.sampleTime = 1.0 + i.toFloat()
      loop cascade.values.length < fftCacheFloats {
        cascade.values.add(value: 0.0)
      }
      loop var texel: Int = 0, texel < fftCacheSize * fftCacheSize, ++texel {
        cascade.values.set(index: texel * 4, value: 2.0)
        cascade.values.set(index: texel * 4 + 1, value: -1.0)
        cascade.values.set(index: texel * 4 + 2, value: 3.0)
        cascade.values.set(index: texel * 4 + 3, value: -0.4)
      }
    }
  }
}

func main() {
  var body: WaterBody = createOceanRealistic(surfaceZ: 5.0)
  body.cascadeCount = 3
  var cache: FftSurfaceCache = createFftSurfaceCache(body: body)
  if let sample: FftSurfaceSample = sampleFftSurface(
    cache: cache
    body: body
    x: 0.0
    y: 0.0
    now: 3.0
    maxAge: 2.0
  ) {
    log("FAIL missing")
  } else {
    log("missing returns none")
  }
  fillCache(cache: cache, count: 3)
  if let sample: FftSurfaceSample = sampleFftSurface(
    cache: cache
    body: body
    x: -65.0
    y: 97.0
    now: 3.0
    maxAge: 2.0
  ) {
    # The raw cascade sum is (6, -3, 9); a realistic ocean scales it by the
    # weather energy at the resolved grid point, so recover that energy from
    # the x component and check the other components against the same factor.
    let energy: Float = sample.displacement.x / 6.0
    if energy >= 0.25 and energy <= 1.35 and Math.abs(value: sample.height - 5.0 - 9.0 * energy) < 0.001 and Math.abs(
      value: sample.displacement.y + 3.0 * energy
    ) < 0.001 and sample.signedJacobians.z < 0.0 and sample.sampleTimes.x is 1.0 and sample.sampleTimes.z is 3.0 {
      log("cascade sums, signed Jacobians, ages and inversion OK")
    }
  }
  if let sample: FftSurfaceSample = sampleFftSurface(
    cache: cache
    body: body
    x: 0.0
    y: 0.0
    now: 3.0
    maxAge: 1.9
  ) {
    log("FAIL stale")
  } else {
    log("oldest cascade controls staleness")
  }
  if let cascade: mod FftCascadeCache => cache.cascades.modAt(index: 2) {
    cascade.generation = -1
  }
  if let sample: FftSurfaceSample = sampleFftSurface(
    cache: cache
    body: body
    x: 0.0
    y: 0.0
    now: 3.0
    maxAge: 9.0
  ) {
    log("FAIL generation")
  } else {
    log("mixed generation returns none")
  }
  invalidateFftSurfaceCache(cache: cache)
  if cache.activeCount is 0 {
    log("invalidation clears availability")
  }
  body.cascadeCount = 1
  cache.seaState = body
  fillCache(cache: cache, count: 1)
  if let cascade: mod FftCascadeCache => cache.cascades.modAt(index: 0) {
    loop var texel: Int = 0, texel < fftCacheSize * fftCacheSize, ++texel {
      let coordinate: Float = (texel % fftCacheSize).toFloat() + 0.5
      cascade.values.set(index: texel * 4 + 2, value: Math.cos(x: 6.2831853 * coordinate / 32.0))
    }
  }
  if let sample: FftSurfaceSample = sampleFftSurface(
    cache: cache
    body: body
    x: 7.0
    y: 0.0
    now: 1.0
    maxAge: 0.0
  ) {
    # The surface over x=7 originated at x = 7 - displacement.x (raw
    # displacement.x = 2, scaled by the weather energy, which the wave height
    # is scaled by too).
    let energy: Float = sample.displacement.x / 2.0
    let origin: Float = 7.0 - sample.displacement.x
    if Math.abs(value: sample.height - 5.0 - energy * Math.cos(x: 6.2831853 * origin / 32.0)) < 0.01 {
      log("known wave with horizontal inversion OK")
    }
    if let wrapped: FftSurfaceSample = sampleFftSurface(
      cache: cache
      body: body
      x: -57.0
      y: 96.0
      now: 1.0
      maxAge: 0.0
    ) {
      # A different world position sees a different weather energy, so compare
      # the wave shape after taking that factor out: both samples must land on
      # the same cosine of their (wrapped) origin.
      let wrappedEnergy: Float = wrapped.displacement.x / 2.0
      let wrappedOrigin: Float = -57.0 - wrapped.displacement.x
      let wrappedWave: Float = (wrapped.height - 5.0) / wrappedEnergy
      if Math.abs(value: wrappedWave - Math.cos(x: 6.2831853 * wrappedOrigin / 32.0)) < 0.01 {
        log("negative and positive tile wrapping OK")
      }
    }
  }
  body.windSpeed = body.windSpeed + 1.0
  if let sample: FftSurfaceSample = sampleFftSurface(
    cache: cache
    body: body
    x: 0.0
    y: 0.0
    now: 1.0
    maxAge: 9.0
  ) {
    log("FAIL sea state")
  } else {
    log("changed sea state rejected")
  }
}
