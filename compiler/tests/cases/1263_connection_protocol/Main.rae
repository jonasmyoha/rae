# lib/net/Connection: the connection protocol over bytes, driven by hand
# with no network. Two ends talk through two lib/net/BadNetwork paths that
# lose, delay and reorder packets (a fixed seed: every run is the same).
# Every reliable message arrives once and in order under loss; unreliable
# ones never arrive out of order; a fragmented message survives a lost
# fragment; a silent peer times out; a steady connection allocates nothing.
open net/Wire
open net/Connection
open net/BadNetwork
open net/Udp
open Sys

type Link {
  client: Connection
  server: Connection
  toServer: BadNetwork
  toClient: BadNetwork
  packet: List(UInt8)
  arrived: List(UInt8)
  nowMs: Int
}

# A fast clean path (20 ms each way), from `seed`
func cleanPath(seed: view Int) ret BadNetwork {
  var settings: BadNetworkSettings = goodNetworkSettings()
  settings.latencyMs = 20
  settings.seed = seed
  ret createBadNetwork(settings: settings, maxPacketBytes: 1200, capacity: 512)
}

# Hand each packet due on `network` to `connection`
func deliver(
  network: mod BadNetwork
  connection: mod Connection
  arrived: mod List(UInt8)
  nowMs: view Int
) {
  loop badNetworkNext(network: network, packet: arrived, nowMs: nowMs).ready {
    let taken: Bool = connectionReadPacket(
      connection: connection
      packet: arrived
      start: 0
      count: arrived.length
      nowMs: nowMs
    )
  }
}

func createLink(seed: view Int) ret Link {
  ret Link {
    client: createConnection(config: defaultConnectionConfig())
    server: createConnection(config: defaultConnectionConfig())
    toServer: cleanPath(seed: seed)
    toClient: cleanPath(seed: seed + 7)
    packet: List.create(UInt8, cap: 1200)
    arrived: List.create(UInt8, cap: 1200)
    nowMs: 0
  }
}

# One 10 ms tick: clocks, every packet each end wants to send, deliveries
func step(link: mod Link) {
  link.nowMs = link.nowMs + 10
  connectionUpdate(connection: link.client, nowMs: link.nowMs)
  connectionUpdate(connection: link.server, nowMs: link.nowMs)
  loop connectionWritePacket(connection: link.client, packet: link.packet, nowMs: link.nowMs) {
    badNetworkSend(
      network: link.toServer
      packet: link.packet
      start: 0
      count: link.packet.length
      destination: noNetAddress()
      nowMs: link.nowMs
    )
  }
  loop connectionWritePacket(connection: link.server, packet: link.packet, nowMs: link.nowMs) {
    badNetworkSend(
      network: link.toClient
      packet: link.packet
      start: 0
      count: link.packet.length
      destination: noNetAddress()
      nowMs: link.nowMs
    )
  }
  deliver(
    network: link.toServer
    connection: link.server
    arrived: link.arrived
    nowMs: link.nowMs
  )
  deliver(
    network: link.toClient
    connection: link.client
    arrived: link.arrived
    nowMs: link.nowMs
  )
}

func connectLink(link: mod Link) {
  connectionListen(connection: link.server, nowMs: link.nowMs)
  connectionConnect(connection: link.client, connectionId: 305419896, nowMs: link.nowMs)
  loop var i: Int = 0, i < 500 and not (connectionIsConnected(connection: link.client) and connectionIsConnected(
    connection: link.server
  )), ++i {
    step(link: link)
  }
}

func counterMessage(message: mod List(UInt8), value: view Int) {
  message.clear()
  writeU32(bytes: message, value: value)
}

# Tracks one direction of a counted stream
type Tally {
  expected: Int
  received: Int
  outOfOrder: Int
  last: Int
}

func emptyTally() ret Tally {
  ret Tally { expected: 0, received: 0, outOfOrder: 0, last: -1 }
}

# Drain `connection`'s received messages into the tallies
func drain(
  connection: mod Connection
  message: mod List(UInt8)
  reliable: mod Tally
  unreliable: mod Tally
) {
  loop {
    let channel: MessageChannel = connectionReceive(connection: connection, message: message)
    if channel is MessageChannel.none {
      ret
    }
    let value: Int = readU32(bytes: message, offset: 0)
    if channel is MessageChannel.reliable {
      if value is not reliable.expected or message.length is not 4 {
        reliable.outOfOrder = reliable.outOfOrder + 1
      }
      reliable.expected = value + 1
      reliable.received = reliable.received + 1
    } else {
      if value <= unreliable.last {
        unreliable.outOfOrder = unreliable.outOfOrder + 1
      }
      unreliable.last = value
      unreliable.received = unreliable.received + 1
    }
  }
}

func handshakeAndTimeouts() {
  var link: Link = createLink(seed: 1)
  connectLink(link: link)
  log("handshake: client {link.client.state}, server {link.server.state} at {link.nowMs} ms")

  # Stray and garbage packets are refused
  var stray: List(UInt8) = List.create(UInt8, cap: 32)
  writeU8(bytes: stray, value: 3)
  writeU32(bytes: stray, value: 99)
  loop var i: Int = 0, i < 8, ++i {
    writeU8(bytes: stray, value: 0)
  }
  log("stray packet taken: {connectionReadPacket(
    connection: link.server
    packet: stray
    start: 0
    count: stray.length
    nowMs: link.nowMs
  )}")
  log("short packet taken: {connectionReadPacket(
    connection: link.server
    packet: stray
    start: 0
    count: 3
    nowMs: link.nowMs
  )}")

  # The client stops hearing the server: it times out after timeoutMs, and
  # then, as it falls silent too, so does the server
  link.toClient.settings.lossPercent = 100
  let silentFrom: Int = link.nowMs
  var clientTimedOutAt: Int = -1
  loop var i: Int = 0, i < 1200 and link.server.state is ConnectionState.connected, ++i {
    step(link: link)
    if clientTimedOutAt < 0 and link.client.state is ConnectionState.timedOut {
      clientTimedOutAt = link.nowMs
    }
  }
  log(
    "silent server: client {link.client.state} after {clientTimedOutAt - silentFrom} ms, then server {link.server.state}"
  )

  # Connecting to no one gives up after connectTimeoutMs
  var lonely: Link = createLink(seed: 2)
  connectionConnect(connection: lonely.client, connectionId: 7, nowMs: 0)
  loop var i: Int = 0, i < 1000 and lonely.client.state is ConnectionState.connecting, ++i {
    step(link: lonely)
  }
  log(
    "connect to no one: {lonely.client.state} at {lonely.nowMs} ms after {lonely.client.stats.packetsSent} requests"
  )

  # A disconnect reaches the peer even with a lost disconnect packet
  var leaving: Link = createLink(seed: 3)
  connectLink(link: leaving)
  connectionDisconnect(connection: leaving.client, nowMs: leaving.nowMs)
  leaving.toServer.dropCountdown = 1
  loop var i: Int = 0, i < 20, ++i {
    step(link: leaving)
  }
  log("disconnect: client {leaving.client.state}, server {leaving.server.state}")
}

func reliableUnderLoss() {
  var link: Link = createLink(seed: 11)
  connectLink(link: link)
  # The usual bad network both ways (10% loss, 150 ms, 30 ms jitter), plus
  # a few duplicated and reordered packets
  var settings: BadNetworkSettings = badNetworkSettings()
  settings.duplicatePercent = 3
  settings.reorderPercent = 5
  settings.seed = 11
  link.toServer = createBadNetwork(settings: settings, maxPacketBytes: 1200, capacity: 1024)
  settings.seed = 12
  link.toClient = createBadNetwork(settings: settings, maxPacketBytes: 1200, capacity: 1024)
  var message: List(UInt8) = List.create(UInt8, cap: 1200)
  var toServer: Tally = emptyTally()
  var toClient: Tally = emptyTally()
  var serverUnreliable: Tally = emptyTally()
  var clientUnreliable: Tally = emptyTally()
  var clientSent: Int = 0
  var serverSent: Int = 0
  var unreliableSent: Int = 0
  let total: Int = 400
  loop var i: Int = 0, i < 3000 and (toServer.received < total or toClient.received < total), ++i {
    # A few reliable messages each tick each way, as the window allows
    loop var burst: Int = 0, burst < 4 and clientSent < total, ++burst {
      counterMessage(message: message, value: clientSent)
      if not connectionSendReliable(
        connection: link.client
        bytes: message
        start: 0
        count: message.length
      ) {
        break
      }
      clientSent = clientSent + 1
    }
    loop var burst: Int = 0, burst < 4 and serverSent < total, ++burst {
      counterMessage(message: message, value: serverSent)
      if not connectionSendReliable(
        connection: link.server
        bytes: message
        start: 0
        count: message.length
      ) {
        break
      }
      serverSent = serverSent + 1
    }
    # And one unreliable message a tick, client to server
    counterMessage(message: message, value: unreliableSent)
    if connectionSendUnreliable(
      connection: link.client
      bytes: message
      start: 0
      count: message.length
    ) {
      unreliableSent = unreliableSent + 1
    }
    step(link: link)
    drain(
      connection: link.server
      message: message
      reliable: toServer
      unreliable: serverUnreliable
    )
    drain(
      connection: link.client
      message: message
      reliable: toClient
      unreliable: clientUnreliable
    )
  }
  log(
    "reliable at 10% loss, 150 ms, 30 ms jitter: client->server {toServer.received}/{total} out of order {toServer.outOfOrder}, server->client {toClient.received}/{total} out of order {toClient.outOfOrder}"
  )
  log(
    "losses made resends: {link.toServer.stats.dropped > 0 and link.client.stats.fragmentsResent > 0 and link.server.stats.fragmentsResent > 0}"
  )
  log(
    "still connected: {connectionIsConnected(connection: link.client)} {connectionIsConnected(
      connection: link.server
    )}"
  )
  log(
    "round trip measured near 300-360 ms: {link.client.rttMs > 280.0 and link.client.rttMs < 420.0}"
  )
  log(
    "the network duplicated {link.toServer.stats.duplicated > 0} and reordered {link.toServer.stats.reordered > 0}"
  )
  log(
    "unreliable: out of order {serverUnreliable.outOfOrder}, some arrived {serverUnreliable.received > unreliableSent / 2}, some lost or dropped {serverUnreliable.received < unreliableSent}, old ones dropped {link.server.stats.unreliableDropped > 0}"
  )

  # Now nothing more is sent: no reliable message arrives a second time
  loop var i: Int = 0, i < 200, ++i {
    step(link: link)
    drain(
      connection: link.server
      message: message
      reliable: toServer
      unreliable: serverUnreliable
    )
  }
  log("no duplicates later: {toServer.received is total}")
}

func fragmentedMessage() {
  var link: Link = createLink(seed: 21)
  connectLink(link: link)
  var big: List(UInt8) = List.create(UInt8, cap: 5000)
  loop var i: Int = 0, i < 5000, ++i {
    writeU8(bytes: big, value: (i * 7 + i / 256) bitand 255)
  }
  log("queued 5000 bytes: {connectionSendReliable(
    connection: link.client
    bytes: big
    start: 0
    count: big.length
  )}")
  # The second packet the client sends (a middle fragment) is lost
  link.toServer.dropCountdown = 2
  var message: List(UInt8) = List.create(UInt8, cap: 16)
  var gotIt: Bool = false
  var largest: Int = 0
  loop var i: Int = 0, i < 200 and not gotIt, ++i {
    connectionUpdate(connection: link.client, nowMs: link.nowMs + 10)
    connectionUpdate(connection: link.server, nowMs: link.nowMs + 10)
    link.nowMs = link.nowMs + 10
    loop connectionWritePacket(connection: link.client, packet: link.packet, nowMs: link.nowMs) {
      if link.packet.length > largest {
        largest = link.packet.length
      }
      badNetworkSend(
        network: link.toServer
        packet: link.packet
        start: 0
        count: link.packet.length
        destination: noNetAddress()
        nowMs: link.nowMs
      )
    }
    loop connectionWritePacket(connection: link.server, packet: link.packet, nowMs: link.nowMs) {
      badNetworkSend(
        network: link.toClient
        packet: link.packet
        start: 0
        count: link.packet.length
        destination: noNetAddress()
        nowMs: link.nowMs
      )
    }
    deliver(
      network: link.toServer
      connection: link.server
      arrived: link.arrived
      nowMs: link.nowMs
    )
    deliver(
      network: link.toClient
      connection: link.client
      arrived: link.arrived
      nowMs: link.nowMs
    )
    if connectionReceive(connection: link.server, message: message) is MessageChannel.reliable {
      gotIt = true
    }
  }
  var same: Bool = message.length is big.length
  loop var i: Int = 0, i < big.length and same, ++i {
    if readU8(bytes: message, offset: i) is not readU8(bytes: big, offset: i) {
      same = false
    }
  }
  log(
    "fragmented: arrived {gotIt}, {message.length} bytes, identical {same}, a fragment was lost {link.toServer.stats.dropped is 1}, resent {link.client.stats.fragmentsResent >= 1}"
  )
  log("largest packet {largest} bytes (under 1200: {largest <= 1200})")
}

# A steady two-way exchange (both channels, 10% loss) allocates nothing
# once the lists have grown to their working size
func zeroAllocations() {
  var link: Link = createLink(seed: 31)
  connectLink(link: link)
  link.toServer.settings.lossPercent = 10
  link.toClient.settings.lossPercent = 10
  link.toServer.settings.jitterMs = 20
  link.toClient.settings.jitterMs = 20
  var message: List(UInt8) = List.create(UInt8, cap: 1200)
  var serverReliable: Tally = emptyTally()
  var serverUnreliable: Tally = emptyTally()
  var clientReliable: Tally = emptyTally()
  var clientUnreliable: Tally = emptyTally()
  var sent: Int = 0
  var before: Int = 0
  loop var i: Int = 0, i < 700, ++i {
    if i is 200 {
      before = allocationCount()
    }
    counterMessage(message: message, value: sent)
    let reliableQueued: Bool = connectionSendReliable(
      connection: link.client
      bytes: message
      start: 0
      count: message.length
    )
    let serverQueued: Bool = connectionSendReliable(
      connection: link.server
      bytes: message
      start: 0
      count: message.length
    )
    let unreliableQueued: Bool = connectionSendUnreliable(
      connection: link.client
      bytes: message
      start: 0
      count: message.length
    )
    sent = sent + 1
    step(link: link)
    drain(
      connection: link.server
      message: message
      reliable: serverReliable
      unreliable: serverUnreliable
    )
    drain(
      connection: link.client
      message: message
      reliable: clientReliable
      unreliable: clientUnreliable
    )
  }
  let allocations: Int = allocationCount() - before
  log(
    "500 steady ticks: {allocations} allocations, {link.client.stats.packetsSent > 500} packets, reliable in order {serverReliable.outOfOrder is 0 and clientReliable.outOfOrder is 0}"
  )
}

# Sequence numbers and message ids wrap from 65535 to 0 mid-stream
func acrossTheWrap() {
  var link: Link = createLink(seed: 41)
  link.client.nextSequence = 65520
  link.client.sender.nextId = 65530
  link.client.sender.oldestId = 65530
  link.server.receiver.nextId = 65530
  link.client.unreliableNextSequence = 65530
  connectLink(link: link)
  link.toServer.settings.lossPercent = 10
  link.toClient.settings.lossPercent = 10
  link.toServer.settings.jitterMs = 30
  var message: List(UInt8) = List.create(UInt8, cap: 16)
  var reliable: Tally = emptyTally()
  var unreliable: Tally = emptyTally()
  loop var i: Int = 0, i < 300, ++i {
    if i < 60 {
      counterMessage(message: message, value: i)
      let queued: Bool = connectionSendReliable(
        connection: link.client
        bytes: message
        start: 0
        count: message.length
      )
      let sentUnreliable: Bool = connectionSendUnreliable(
        connection: link.client
        bytes: message
        start: 0
        count: message.length
      )
    }
    step(link: link)
    drain(
      connection: link.server
      message: message
      reliable: reliable
      unreliable: unreliable
    )
  }
  log(
    "across the wrap: reliable {reliable.received}/60 out of order {reliable.outOfOrder}, unreliable out of order {unreliable.outOfOrder}, ids now {link.client.sender.nextId}, packets past 65535 {link.client.nextSequence < 65520}"
  )
}

func main() ret Int {
  handshakeAndTimeouts()
  reliableUnderLoss()
  fragmentedMessage()
  acrossTheWrap()
  zeroAllocations()
  ret 0
}
