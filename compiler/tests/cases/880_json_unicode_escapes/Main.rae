# #81444309: Json.parseJson decodes \\uXXXX escapes to UTF-8 — a BMP character,
# a surrogate pair as one supplementary character, a lone surrogate as U+FFFD
# (3 bytes), a malformed escape passed through undecoded — while the standard
# escapes keep working.
import Json

func show(doc: view JsonDoc, key: view String) {
  let root: JsonValue = Json.root(doc: doc)
  let idx: Int = Json.field(doc: doc, this: root, key: key)
  let value: String = Json.jsonString(this: Json.jsonValueAt(doc: doc, idx: idx), fallback: "?")
  log("{key}: {value} ({value.length()} bytes)")
}

func main() {
  let source: String = "\{\"a\": \"em\\u2014dash\", \"b\": \"caf\\u00e9\", \"c\": \"\\ud83d\\ude00!\", \"d\": \"lone\\udc00x\", \"e\": \"bad\\u12g4\", \"f\": \"tab\\t\\\"q\\\"\"\}"
  let doc: JsonDoc = Json.parseJson(source: source)
  show(doc: doc, key: "a")
  show(doc: doc, key: "b")
  show(doc: doc, key: "c")
  show(doc: doc, key: "d")
  show(doc: doc, key: "e")
  show(doc: doc, key: "f")
  log("ok={doc.ok}")
}
