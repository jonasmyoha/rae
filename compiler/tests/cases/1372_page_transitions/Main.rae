,\"y\":300,\"w\":400,\"h\":200\},\"bundles\":[\"staggerFromStart\"],\"Children\":[\"CRow0\",\"CRow1\",\"CRow2\"]\},\"CRow0\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"CRow1\":\{\"Rect\":\{\"x\":0,\"y\":50,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"CRow2\":\{\"Rect\":\{\"x\":0,\"y\":100,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\}\}\}"
    "\{\"type\":\"Scene\",\"version\":2,\"root\":\"Screen\",\"nodes\":\{\"Screen\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":800\},\"Children\":[\"A\",\"B\",\"C\"]\},\"A\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":800\},\"PageTransition\":\{\"kind\":\"none\"\},\"Children\":[\"AButton\",\"AList\"]\},\"AButton\":\{\"Rect\":\{\"x\":100,\"y\":100,\"w\":200,\"h\":100\},\"OnClick\":\{\"actionId\":\"a\",\"label\":\"A\"\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"AList\":\{\"Rect\":\{\"x\":0,\"y\":300,\"w\":400,\"h\":200\},\"bundles\":[\"staggerFromStart\"],\"Children\":[\"ARow0\",\"ARow1\",\"ARow2\"]\},\"ARow0\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"ARow1\":\{\"Rect\":\{\"x\":0,\"y\":50,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"ARow2\":\{\"Rect\":\{\"x\":0,\"y\":100,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"B\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":800\},\"Active\":\{\"value\":false\},\"PageTransition\":\{\"kind\":\"none\"\},\"Children\":[\"BButton\",\"BList\"]\},\"BButton\":\{\"Rect\":\{\"x\":100,\"y\":100,\"w\":200,\"h\":100\},\"OnClick\":\{\"actionId\":\"b\",\"label\":\"B\"\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"BList\":\{\"Rect\":\{\"x\":0,\"y\":300,\"w\":400,\"h\":200\},\"bundles\":[\"staggerFromStart\"],\"Children\":[\"BRow0\",\"BRow1\",\"BRow2\"]\},\"BRow0\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"BRow1\":\{\"Rect\":\{\"x\":0,\"y\":50,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"BRow2\":\{\"Rect\":\{\"x\":0,\"y\":100,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"C\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":800\},\"Active\":\{\"value\":false\},\"PageTransition\":\{\"kind\":\"none\"\},\"Children\":[\"CButton\",\"CList\"]\},\"CButton\":\{\"Rect\":\{\"x\":100,\"y\":100,\"w\":200,\"h\":100\},\"OnClick\":\{\"actionId\":\"c\",\"label\":\"C\"\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"CList\":\{\"Rect\":\{\"x\":0,\"y\":300,\"w\":400,\"h\":200\},\"bundles\":[\"staggerFromStart\"],\"Children\":[\"CRow0\",\"CRow1\",\"CRow2\"]\},\"CRow0\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"CRow1\":\{\"Rect\":\{\"x\":0,\"y\":50,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"CRow2\":\{\"Rect\":\{\"x\":0,\"y\":100,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\}\}\}"
  ]
  loop var i: Int = 0, i < names.length, ++i {
    var world: UiWorld = createUiWorld()
    var uiSystems: UiSystems = createUiSystems()
    mountResident(
      world: world
      uiSystems: uiSystems
      source: sources.copyAtFallback(index: i, fallback: "")
    )
    var system: PageTransitionSystem = createPageTransitionSystem()
    pageTransitionSetSource(
      system: system
      source: PageSource { x: 300.0, y: 700.0, w: 100.0, h: 100.0 }
    )
    pageTransitionResident(
      system: system
      world: world
      uiSystems: uiSystems
      fromRoot: nodeOf(world: world, nodeId: "A")
      toRoot: nodeOf(world: world, nodeId: "B")
      back: false
    )
    frame(world: world, uiSystems: uiSystems, deltaTime: 0.0)
    log(
      "{names.copyAtFallback(index: i, fallback: "")}: B {poseText(
        pose: poseOf(world: world, uiSystems: uiSystems, nodeId: "B")
      )}; A active {activeOf(world: world, nodeId: "A")}"
    )
    loop var f: Int = 0, f < 30, ++f {
      frame(world: world, uiSystems: uiSystems, deltaTime: 0.01)
    }
    log(
      "  0.3 s, past 60%: A's opacity {poseOf(world: world, uiSystems: uiSystems, nodeId: "A").opacity}, active {activeOf(
        world: world
        nodeId: "A"
      )}"
    )
    settle(world: world, uiSystems: uiSystems)
    log(
      "  settled: A active {activeOf(world: world, nodeId: "A")}, {componentCount(
        this: uiSystems.animation.poses
      )} poses"
    )
  }
}

func sceneParts() {
  log("--- the scene")
  var world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  let root: EntityId = loadScene(
    world: world
    uiSystems: uiSystems
    scene: parseScene(
      source: "\{\"type\":\"Scene\",\"version\":2,\"root\":\"A\",\"nodes\":\{\"A\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":800\},\"PageTransition\":\{\"kind\":\"zoom\"\},\"Children\":[\"AButton\",\"AList\"]\},\"AButton\":\{\"Rect\":\{\"x\":100,\"y\":100,\"w\":200,\"h\":100\},\"OnClick\":\{\"actionId\":\"a\",\"label\":\"A\"\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"AList\":\{\"Rect\":\{\"x\":0,\"y\":300,\"w\":400,\"h\":200\},\"bundles\":[\"staggerFromStart\"],\"Children\":[\"ARow0\",\"ARow1\",\"ARow2\"]\},\"ARow0\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"ARow1\":\{\"Rect\":\{\"x\":0,\"y\":50,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\},\"ARow2\":\{\"Rect\":\{\"x\":0,\"y\":100,\"w\":400,\"h\":40\},\"bundles\":[\"appearRise\",\"disappearFade\"]\}\}\}"
    )
  )
  let saved: String = machineComponentJson(world: world, entityId: root, name: "PageTransition")
  log("saved: zoom {saved.contains(sub: "\"kind\": \"zoom\"")}")
  var other: UiWorld = createUiWorld()
  var otherSystems: UiSystems = createUiSystems()
  let bad: EntityId = loadScene(
    world: other
    uiSystems: otherSystems
    scene: parseScene(
      source: "\{\"type\":\"Scene\",\"version\":2,\"root\":\"A\",\"nodes\":\{\"A\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":10,\"h\":10\},\"PageTransition\":\{\"motion\":\"smoooth\"\}\}\}\}"
    )
  )
  log(
    "an unknown motion: {sceneDiagnosticCountOfKind(
      diagnostics: other.sceneDiagnostics
      kind: SceneDiagnosticKind.unknownToken
    )} diagnostic"
  )
}

func main() {
  rules()
  residentPush()
  residentTurns()
  worldModel()
  otherKinds()
  sceneParts()
}
