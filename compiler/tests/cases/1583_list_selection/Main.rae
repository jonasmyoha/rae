const assets: String = "../examples/104_ui_hello/assets/"

type App {
  world: UiWorld
  uiSystems: UiSystems
  input: UiInput
  resources: Gpu2dUi
  scenes: SceneRegistry
  left: EntityId
  right: EntityId
  field: EntityId
}

func nodeOf(world: view UiWorld, nodeId: view String) ret EntityId {
  if let raw: Int = findNodeInPage(world: world, pageId: "p", nodeId: nodeId) {
    ret nodeEntityId(world: world, index: raw)
  }
  ret noEntity()
}

# One row for each letter of `names`, its key the letter, its name "<letter> row"
func setRows(app: mod App, list: view EntityId, names: view String) {
  var data: ListViewData = { rows: {} }
  loop var i: Int = 0, i < names.length(), ++i {
    let letter: String = names.sub(start: i, len: 1)
    data.rows.add(
      value: ListViewRow {
        keys: List(String) { "key", "name" }
        values: List(String) { "{letter}", "{letter} row" }
      }
    )
  }
  componentSet(this: app.world.listViewDatas, entityId: list, data: own data)
}

# The list's live rows: each key, with its color
func rowsText(app: view App, list: view EntityId) ret String {
  var text: String = ""
  let children: view Children = componentView(this: app.world.childrens, entityId: list)
  loop let row: view EntityId in children.ids {
    let shape: view Shape = componentView(this: app.world.shapes, entityId: row)
    var mark: String = ""
    if shape.fillSlot is "accent" {
      mark = "*"
    } else if shape.fillSlot is "outline" {
      mark = "~"
    }
    let name: view Children = componentView(this: app.world.childrens, entityId: row)
    loop let child: view EntityId in name.ids {
      let shown: String = componentView(this: app.world.texts, entityId: child).text.sub(
        start: 0
        len: 1
      )
      var color: String = ""
      if componentHas(this: app.world.styleOverrides, entityId: child) {
        color = "!"
      }
      text = text.concat(other: "{shown}{mark}{color} ")
    }
  }
  ret text
}

func show(app: view App, step: view String) {
  var text: String = ""
  loop var i: Int = 0, i < eventCount(ListEvent, this: app.world.listEvents), ++i {
    let event: ListEvent = eventAt(ListEvent, this: app.world.listEvents, i: i)
    var which: String = "left"
    if event.list is app.right {
      which = "right"
    }
    if event.kind is ListEventKind.selectionChanged {
      text = text.concat(other: " ({which} changed, at {event.key})")
    } else if event.kind is ListEventKind.rowActivated {
      text = text.concat(other: " ({which} activated {event.key}, by key {event.byKey})")
    } else if event.kind is ListEventKind.left {
      text = text.concat(other: " ({which} Left)")
    } else {
      text = text.concat(other: " ({which} Right)")
    }
  }
  var holder: String = "none"
  let keys: EntityId = keyHolder(world: app.world, uiSystems: app.uiSystems)
  if keys is app.field {
    holder = "field"
  } else if keys is keysOwner(world: app.world, uiSystems: app.uiSystems, entityId: app.left) {
    holder = "left"
  } else if keys is keysOwner(world: app.world, uiSystems: app.uiSystems, entityId: app.right) {
    holder = "right"
  }
  log(
    "{step}: keys {holder}, left [{listSelectedKeys(world: app.world, list: app.left).join(sep: "")}] right [{listSelectedKeys(
      world: app.world
      list: app.right
    ).join(sep: "")}]{text}"
  )
}

func frame(
  app: mod App
  step: view String
  pointer: view UiPointerState
  keys: view ListSelectionKeys
) {
  app.input.nowSeconds = app.input.nowSeconds + 0.1
  updateUiInputWith(
    input: app.input
    world: app.world
    uiSystems: app.uiSystems
    pointer: pointer
    wheel: 0.0
  )
  let moved: Bool = keyFocusSystem(world: app.world, uiSystems: app.uiSystems, input: app.input)
  let changed: Bool = textFieldSystem(
    world: app.world
    textFieldSystem: app.uiSystems.textField
    actions: app.world.uiActions
    input: TextInputFrame { typed: "", backspaces: 0, enter: false, tapped: false }
    now: app.input.nowSeconds
  )
  listSelectionSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: keys
  )
  paint(app: app)
  if step.length() > 0 {
    show(app: app, step: step)
  }
}

func paint(app: mod App) {
  let scrolled: Bool = scrollToRowSystem(world: app.world, uiSystems: app.uiSystems)
  listViewSystem(world: app.world, uiSystems: app.uiSystems, scenes: app.scenes)
  runUiSystems(world: app.world, uiSystems: app.uiSystems, res: app.resources)
  releaseDeadEntities(world: app.world, uiSystems: app.uiSystems)
}

func pointer(
  app: mod App
  step: view String
  x: view Float
  y: view Float
  down: view Bool
  clicks: view Int
  toggle: view Bool
  extend: view Bool
  kind: view InputKind
) {
  var state: UiPointerState = uiPointerScriptFrame(
    previous: app.input.pointer
    x: x
    y: y
    down: down
    kind: kind
  )
  state.clicks = clicks
  frame(
    app: app
    step: step
    pointer: state
    keys: ListSelectionKeys { toggle: toggle, extend: extend }
  )
}

func secondary(
  app: mod App
  step: view String
  x: view Float
  y: view Float
) {
  var state: UiPointerState = uiPointerScriptFrame(
    previous: app.input.pointer
    x: x
    y: y
    down: false
    kind: InputKind.mouse
  )
  state.secondary = UiButtonState { down: true, pressed: true, released: false, clicks: 1 }
  frame(
    app: app
    step: step
    pointer: state
    keys: ListSelectionKeys {}
  )
}

func key(app: mod App, step: view String, keys: view ListSelectionKeys) {
  let state: UiPointerState = uiPointerScriptFrame(
    previous: app.input.pointer
    x: app.input.pointer.x
    y: app.input.pointer.y
    down: false
    kind: InputKind.mouse
  )
  frame(
    app: app
    step: step
    pointer: state
    keys: keys
  )
}

func scrollY(app: view App, list: view EntityId) ret Float {
  if componentHas(this: app.world.scrollStates, entityId: list) {
    ret componentView(this: app.world.scrollStates, entityId: list).y
  }
  ret 0.0
}

