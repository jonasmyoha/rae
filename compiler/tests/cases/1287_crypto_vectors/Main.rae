# lib/crypto against published test vectors: BLAKE2b (RFC 7693 Appendix A,
# the BLAKE2 keyed known-answer test), Ed25519 (RFC 8032 §7.1 tests 1-3),
# X25519 (RFC 7748 §6.1), Argon2d / Argon2i / Argon2id (RFC 9106 §5), and
# XChaCha20-Poly1305 (draft-irtf-cfrg-xchacha-03 A.3.1), plus the checks a
# caller relies on: a tampered message or mac does not unlock, a changed
# message does not verify, and cryptoRandomBytes gives the asked-for count
# of bytes that differ between draws.
open crypto/CryptoBytes
open crypto/CryptoRandom
open crypto/Blake2b
open crypto/Ed25519
open crypto/X25519
open crypto/Argon2
open crypto/Aead

func hex(text: view String) ret List(UInt8) {
  if let bytes: List(UInt8) = bytesOfHex(hex: text) {
    ret bytes
  }
  log("bad hex in the test: {text}")
  ret List.create(UInt8, cap: 0)
}

func check(name: view String, actual: view List(UInt8), expected: view String) {
  let got: String = hexOfBytes(bytes: actual)
  if got is expected {
    log("PASS {name}")
  } else {
    log("FAIL {name}: got {got}, expected {expected}")
  }
}

func repeated(value: view Int, count: view Int) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: count)
  loop var i: Int = 0, i < count, ++i {
    bytes.add(value: value as UInt8)
  }
  ret bytes
}

func counting(count: view Int) ret List(UInt8) {
  var bytes: List(UInt8) = List.create(UInt8, cap: count)
  loop var i: Int = 0, i < count, ++i {
    bytes.add(value: i as UInt8)
  }
  ret bytes
}

func ed25519Test(
  name: view String
  seed: view String
  publicKey: view String
  message: view String
  signature: view String
) {
  let pair: Ed25519KeyPair = ed25519KeyPairFromSeed(seed: hex(text: seed))
  check(name: "{name} public key", actual: pair.publicKey, expected: publicKey)
  let signed: List(UInt8) = ed25519Sign(secretKey: pair.secretKey, message: hex(text: message))
  check(name: "{name} signature", actual: signed, expected: signature)
  log(
    "{name} verifies: {ed25519Verify(
      signature: signed
      publicKey: pair.publicKey
      message: hex(text: message)
    )}"
  )
}

func argon2Test(name: view String, algorithm: view Argon2Algorithm, expected: view String) {
  let settings: Argon2Settings = { algorithm: algorithm, memoryKiB: 32, passes: 3, lanes: 4 }
  let tag: List(UInt8) = argon2Hash(
    password: repeated(value: 1, count: 32)
    salt: repeated(value: 2, count: 16)
    settings: settings
    hashSize: 32
    key: repeated(value: 3, count: 8)
    associatedData: repeated(value: 4, count: 12)
  )
  check(name: name, actual: tag, expected: expected)
}

func main() {
  # BLAKE2b
  check(
    name: "BLAKE2b-512 abc (RFC 7693)"
    actual: blake2b(message: bytesOfText(text: "abc"), hashSize: 64)
    expected: "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"
  )
  check(
    name: "BLAKE2b-512 empty"
    actual: blake2b(message: List.create(UInt8, cap: 0), hashSize: 64)
    expected: "786a02f742015903c6c6fd852552d272912f4740e15847618a86e217f71f5419d25e1031afee585313896444934eb04b903a685b1448b755d56f701afe9be2ce"
  )
  check(
    name: "BLAKE2b-256 of a sentence"
    actual: blake2b(
      message: bytesOfText(text: "The quick brown fox jumps over the lazy dog")
      hashSize: 32
    )
    expected: "01718cec35cd3d796dd00020e0bfecb473ad23457d063b75eff29c0ffa2e58a9"
  )
  check(
    name: "BLAKE2b keyed, empty message (BLAKE2 KAT)"
    actual: blake2bKeyed(
      message: List.create(UInt8, cap: 0)
      key: counting(count: 64)
      hashSize: 64
    )
    expected: "10ebb67700b1868efb4417987acf4690ae9d972fb7a590c2f02871799aaa4786b5e996e8f0f4eb981fc214b005f42d2ff4233499391653df7aefcbc13fc51568"
  )
  check(
    name: "BLAKE2b keyed, 3 bytes (BLAKE2 KAT)"
    actual: blake2bKeyed(message: counting(count: 3), key: counting(count: 64), hashSize: 64)
    expected: "33d0825dddf7ada99b0e7e307104ad07ca9cfd9692214f1561356315e784f3e5a17e364ae9dbb14cb2036df932b77f4b292761365fb328de7afdc6d8998f5fc1"
  )
  log(
    "BLAKE2b with a 65-byte digest: {blake2b(message: counting(count: 3), hashSize: 65).length} bytes"
  )
  # Ed25519, RFC 8032 §7.1
  ed25519Test(
    name: "Ed25519 test 1"
    seed: "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    publicKey: "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    message: ""
    signature: "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
  )
  ed25519Test(
    name: "Ed25519 test 2"
    seed: "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    publicKey: "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
    message: "72"
    signature: "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
  )
  ed25519Test(
    name: "Ed25519 test 3"
    seed: "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"
    publicKey: "fc51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025"
    message: "af82"
    signature: "6291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a"
  )
  let pair: Ed25519KeyPair = ed25519KeyPairFromSeed(
    seed: hex(text: "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb")
  )
  let signature: List(UInt8) = ed25519Sign(secretKey: pair.secretKey, message: hex(text: "72"))
  log(
    "Ed25519 a changed message verifies: {ed25519Verify(
      signature: signature
      publicKey: pair.publicKey
      message: hex(text: "73")
    )}"
  )
  let fresh: Ed25519KeyPair = ed25519NewKeyPair()
  let freshSignature: List(UInt8) = ed25519Sign(
    secretKey: fresh.secretKey
    message: bytesOfText(text: "device sign-in")
  )
  log(
    "Ed25519 a new random pair signs and verifies: {ed25519Verify(
      signature: freshSignature
      publicKey: fresh.publicKey
      message: bytesOfText(text: "device sign-in")
    )}"
  )
  # X25519, RFC 7748 §6.1
  let alice: List(UInt8) = hex(
    text: "77076d0a7318a57d3c16c17251b26645df4c2f87ebc0992ab177fba51db92c2a"
  )
  let bob: List(UInt8) = hex(
    text: "5dab087e624a8a4b79e17f8b83800ee66f3bb1292618b6fd1c2f8b27ff88e0eb"
  )
  check(
    name: "X25519 Alice's public key"
    actual: x25519PublicKey(secretKey: alice)
    expected: "8520f0098930a754748b7ddcb43ef75a0dbf3a0d26381af4eba4a98eaa9b4e6a"
  )
  check(
    name: "X25519 Bob's public key"
    actual: x25519PublicKey(secretKey: bob)
    expected: "de9edb7d7b7dc1b4d35b61c2ece435373f8343c85b78674dadfc7e146f882b4f"
  )
  let shared: String = "4a5d9d5ba4ce2de1728e3bf480350f25e07e21c947d19e3376f09b3c1e161742"
  check(
    name: "X25519 Alice's shared secret"
    actual: x25519SharedSecret(secretKey: alice, theirPublicKey: x25519PublicKey(secretKey: bob))
    expected: shared
  )
  check(
    name: "X25519 Bob's shared secret"
    actual: x25519SharedSecret(secretKey: bob, theirPublicKey: x25519PublicKey(secretKey: alice))
    expected: shared
  )
  # Argon2, RFC 9106 §5 (32 KiB, 3 passes, 4 lanes, a secret and associated data)
  argon2Test(
    name: "Argon2d (RFC 9106 5.1)"
    algorithm: Argon2Algorithm.argon2d
    expected: "512b391b6f1162975371d30919734294f868e3be3984f3c1a13a4db9fabe4acb"
  )
  argon2Test(
    name: "Argon2i (RFC 9106 5.2)"
    algorithm: Argon2Algorithm.argon2i
    expected: "c814d9d1dc7f37aa13f0d77f2494bda1c8de6b016dd388d29952a4c4672b6ce8"
  )
  argon2Test(
    name: "Argon2id (RFC 9106 5.3)"
    algorithm: Argon2Algorithm.argon2id
    expected: "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"
  )
  # XChaCha20-Poly1305, draft-irtf-cfrg-xchacha-03 A.3.1
  let key: List(UInt8) = hex(
    text: "808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f"
  )
  let nonce: List(UInt8) = hex(text: "404142434445464748494a4b4c4d4e4f5051525354555657")
  let associatedData: List(UInt8) = hex(text: "50515253c0c1c2c3c4c5c6c7")
  let message: List(UInt8) = bytesOfText(
    text: "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it."
  )
  let sealed: AeadSealed = aeadLock(
    key: key
    nonce: nonce
    plainText: message
    associatedData: associatedData
  )
  check(
    name: "XChaCha20-Poly1305 cipher text"
    actual: sealed.cipherText
    expected: "bd6d179d3e83d43b9576579493c0e939572a1700252bfaccbed2902c21396cbb731c7f1b0b4aa6440bf3a82f4eda7e39ae64c6708c54c216cb96b72e1213b4522f8c9ba40db5d945b11b69b982c1bb9e3f3fac2bc369488f76b2383565d3fff921f9664c97637da9768812f615c68b13b52e"
  )
  check(
    name: "XChaCha20-Poly1305 tag"
    actual: sealed.mac
    expected: "c0875924c1c7987947deafd8780acf49"
  )
  if let opened: List(UInt8) = aeadUnlock(
    key: key
    nonce: nonce
    sealed: sealed
    associatedData: associatedData
  ) {
    log("XChaCha20-Poly1305 unlocks to the message: {bytesEqual(a: opened, b: message)}")
  } else {
    log("FAIL XChaCha20-Poly1305 did not unlock")
  }
  var tampered: AeadSealed = {
    cipherText: copyBytes(bytes: sealed.cipherText)
    mac: copyBytes(bytes: sealed.mac)
  }
  tampered.cipherText.set(index: 0, value: 0)
  log("a changed cipher text unlocks: {aeadUnlock(
    key: key
    nonce: nonce
    sealed: tampered
    associatedData: associatedData
  ) is not none}")
  log("other associated data unlocks: {aeadUnlock(
    key: key
    nonce: nonce
    sealed: sealed
    associatedData: bytesOfText(text: "x")
  ) is not none}")
  # secure random
  let first: List(UInt8) = cryptoRandomBytes(count: 32)
  let second: List(UInt8) = cryptoRandomBytes(count: 32)
  log(
    "random: {first.length} and {second.length} bytes, the same: {bytesEqual(a: first, b: second)}"
  )
  log("random: 600 bytes (three chunks): {cryptoRandomBytes(count: 600).length}")
}
