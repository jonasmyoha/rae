# #644: binding `=> view/mod T` to `copyAt` (which returns a COPY, opt T by
# value) is a sema error — the accessor's name and return type must agree.
# Use `viewAt`/`modAt` to alias the list's storage.
import core

func main() {
  var xs: List(Int) = createList(Int, cap: 2)
  xs.add(value: 5)
  if let element: view Int => xs.copyAt(index: 0) {
    log(element)
  }
}
