open ecs/Entity
open ecs/ComponentTable
open ecs/Query

type Position { x: Int }
type Vel { v: Int }

func main() {
  var pos: ComponentTable(Position) = createComponentTable(Position)
  var vel: ComponentTable(Vel) = createComponentTable(Vel)
  loop let entity: EntityId, p: mod Position in query2(tableA: pos, tableB: vel) {
    p.x = 1
  }
}
