open ecs/Entity
open ecs/ComponentTable
open ecs/Query

type Position { x: Int }
type Velocity { v: Int }

func main() {
  var pos: ComponentTable(Position) = ComponentTable.create(Position)
  var vel: ComponentTable(Velocity) = ComponentTable.create(Velocity)
  loop let entity: EntityId, position: mod Position in query2(tableA: pos, tableB: vel) {
    position.x = 1
  }
}
