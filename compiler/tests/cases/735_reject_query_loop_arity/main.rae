import core
open ecs/Entity
open ecs/ComponentTable
open ecs/Query

type Pos { x: Int }
type Vel { v: Int }

func main() {
  var pos: ComponentTable(Pos) = createComponentTable(Pos)
  var vel: ComponentTable(Vel) = createComponentTable(Vel)
  loop let entity: EntityId, p: mod Pos in query2(tableA: pos, tableB: vel) {
    p.x = 1
  }
}
