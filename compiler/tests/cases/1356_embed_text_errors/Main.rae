# embedText's errors: the file is a build-time fact, named by a literal, in the project.
func main() {
  let name: String = "data.txt"
  let computed: String = embedText(file: name)
  let unnamed: String = embedText("data.txt")
  let absolute: String = embedText(file: "/etc/hosts")
  let missing: String = embedText(file: "no/such/file.txt")
  let aNumber: Int = embedText(file: "Main.rae")
}
