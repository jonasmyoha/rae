      "Rect": {"x": 0, "y": 0, "w": 400, "h": 200},
      "Layout": {"type": "Horizontal"},
      "Shape": {"kind": "Rect", "radius": 0},
      "OnSecondaryClick": {"actionId": "list.menu", "label": "Show the list's menu"},
      "Children": ["Left", "Right", "Over"]
    },
    "Left": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 200},
      "Shape": {"kind": "Rect", "radius": 0},
      "OnClick": {
        "actionId": "left.select",
        "label": "Select",
        "actionIdDouble": "left.open",
        "labelDouble": "Open",
        "actionIdTriple": "left.all",
        "labelTriple": "Select all"
      },
      "OnSecondaryClick": {"actionId": "left.menu", "label": "Show the row's menu"}
    },
    "Right": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 200},
      "Shape": {"kind": "Rect", "radius": 0},
      "OnClick": {"actionId": "right.select", "label": "Select"}
    },
    "Over": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 200},
      "Shape": {"kind": "Rect", "radius": 0}
    }
  }
