# Folder-package `geo`, module `Point` (folder namespace `geo` + module `Point`).
# `geo.Point.make(...)` is a 3-level qualifier: package.Module.func (#786).
type Point { x: Int, y: Int }
func make(x: copy Int, y: copy Int) ret Point { ret Point { x: x, y: y } }
func sum(point: view Point) ret Int { ret point.x + point.y }
