open collections/StringMap
open collections/IntMap

func main() {
  log("StringMap test")
  var m: StringMap(Int) = StringMap.create(Int, cap: 4)
  m.set(k: "apple", value: 10)
  m.set(k: "banana", value: 20)
  m.set(k: "cherry", value: 30)
  let k1: String = "apple"
  let k2: String = "banana"
  let k3: String = "cherry"
  let k4: String = "durian"
  log("apple: {m.get(k: k1)}")
  log("banana: {m.get(k: k2)}")
  log("cherry: {m.get(k: k3)}")
  log("missing: {m.get(k: k4)}")
  log("has banana: {m.has(k: k2)}")
  log("has durian: {m.has(k: k4)}")
  log("length: {m.length}")
  log("IntMap test")
  var m2: IntMap(String) = IntMap.create(String, cap: 4)
  # test hashing/probing
  m2.set(k: 1, value: "one")
  m2.set(k: 2, value: "two")
  m2.set(k: 10, value: "ten")
  log("1: {m2.get(k: 1)}")
  log("2: {m2.get(k: 2)}")
  log("10: {m2.get(k: 10)}")
  log("length: {m2.length}")
}
