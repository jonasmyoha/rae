# Qualified spellings of a package module's const that do not resolve are
# sema errors, never C: a const the module does not declare, the package
# used as a qualifier, and a module this file does not import.
import procgen/Texture

func main() {
  log("{Texture.matNothing}")
  log("{procgen.Texture.matGrass}")
  log("{WorldBiome.matGrass}")
}
