open ecs/Entity
open ecs/ComponentTable
open ecs/World
open ui/Ecs
import ui/Components
open ui/UiSystems

# The dead-entities outbox (docs/ecs-systems-own-their-tables.md §3.2): a
# UiWorld destroy retires the entity at once (isAlive false, aliveCount exact,
# stale handles unequal) but its index is NOT recycled until the app — which
# may still hold rows for it in its own systems' tables — calls
# releaseDeadEntities. Recycling first would let a new entity inherit them.
func main() {
  var world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  let a: EntityId = createEntity(world: world)
  let b: EntityId = createEntity(world: world)
  componentSet(this: world.actives, entityId: a, data: Active { value: true })
  log("a index={a.index} b index={b.index} alive={aliveCount(world: world)}")

  destroyEntity(world: world, entityId: a)
  log(
    "after destroy: alive={aliveCount(world: world)} a isAlive={isAlive(world: world, entityId: a)} dead={world.deadEntities.length}"
  )

  # Not released yet: a fresh index, not a's.
  let c: EntityId = createEntity(world: world)
  log("c index={c.index} reused a: {c.index is a.index}")

  # Released: the next allocation takes a's index, with a bumped generation.
  releaseDeadEntities(world: world, uiSystems: uiSystems)
  log("dead after release={world.deadEntities.length}")
  let d: EntityId = createEntity(world: world)
  log(
    "d index={d.index} reused a: {d.index is a.index} newer generation: {d.generation > a.generation}"
  )
  log("stale a has Active: {componentHas(this: world.actives, entityId: a)}")

  # A subtree destroy queues every entity of it; one release recycles all.
  let root: EntityId = createEntity(world: world)
  let child: EntityId = createEntity(world: world)
  var kids: Children = { ids: List.create(EntityId, cap: 1) }
  kids.ids.add(value: child)
  componentSet(this: world.childrens, entityId: root, data: kids)
  destroyEntitySubtree(world: world, uiSystems: uiSystems, root: root)
  log("subtree dead={world.deadEntities.length} alive={aliveCount(world: world)}")
  releaseDeadEntities(world: world, uiSystems: uiSystems)
  let e: EntityId = createEntity(world: world)
  let f: EntityId = createEntity(world: world)
  log(
    "recycled both: {(e.index is child.index or e.index is root.index) and (f.index is child.index or f.index is root.index)}"
  )
}
