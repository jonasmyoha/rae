# Shadow cascade fitting (#382, lib/shadow3d.rae).
#
# These assert the two properties that make shadows STOP SHIMMERING,
# which is the artefact people describe as pixelation. Both are
# numerical, so they are checkable with no GPU — which is the reason the
# cascade fit lives in Rae rather than in the runtime.
#
#   1. TEXEL SNAPPING. Moving the camera by less than one shadow texel
#      must not move the sampling GRID at all. If the fit slides continuously
#      with the camera, the sampling grid slides across the geometry and
#      every shadow edge crawls. This is the test that would have caught
#      a missing snap, which no screenshot reliably does.
#   2. ROTATION INVARIANCE. Yawing the camera in place must not change
#      the cascade's world-space texel size. A frustum-corner fit fails
#      this — the box grows and shrinks as you turn — which is why the
#      fit uses a bounding SPHERE.
#
# Plus two structural checks: splits must increase, and the near cascade
# must have finer texels than the far one, or the whole cascade idea is
# backwards.
import core
import math
import vec3
import shadow3d
open math3d
open shadow3d

const res: Int = 2048

func fitAt(camX: view Float, yaw: view Float) ret ShadowCascades {
  let pos: Vec3 = vec3.create(x: camX, y: 0.0 - 12.0, z: 5.0)
  # Target derived from yaw so "rotate in place" is a real rotation.
  let target: Vec3 = vec3.create(
    x: camX + math.sin(x: yaw), y: 0.0 - 12.0 + math.cos(x: yaw), z: 4.0
  )
  ret fitShadowCascades(
    camPos: pos, camTarget: target, fovYDeg: 50.0, aspect: 1.6,
    near: 0.1, far: 60.0, sunDir: vec3.create(x: 0.3, y: 0.4, z: 0.0 - 0.86),
    count: 3, resolution: res, lambda: 0.7, backExtent: 20.0
  )
}

# math.abs resolves to the Int overload here, so spell the Float one out.
func absF(v: view Float) ret Float {
  if v < 0.0 {
    ret 0.0 - v
  }
  ret v
}

# The LATERAL terms only: the x/y scales (0, 5) and offsets (12, 13).
# Those four define where the sampling grid sits on the world, and they
# are what must not move.
#
# The depth terms are deliberately excluded. The light-space depth offset
# does vary continuously with the camera, because the near plane tracks
# the fitted centre — but a uniform shift ALONG the light axis moves no
# texel sideways, so it cannot cause crawling. Asserting the whole matrix
# is unchanged would be asserting something untrue about a system that is
# nonetheless correct.
func maxGridDelta(a: view ShadowCascades, b: view ShadowCascades, index: view Int) ret Float {
  var worst: Float = 0.0
  var k: Int = 0
  loop k < 4 {
    var slot: Int = 0
    if k is 1 { slot = 5 }
    if k is 2 { slot = 12 }
    if k is 3 { slot = 13 }
    let d: Float = absF(v: a.viewProj.at(index: index * 16 + slot) - b.viewProj.at(index: index * 16 + slot))
    if d > worst {
      worst = d
    }
    k = k + 1
  }
  ret worst
}

func main() {
  let base: ShadowCascades = fitAt(camX: 0.0, yaw: 0.0)
  log("cascades {base.count} at {base.resolution}")

  # Splits must increase, or cascade selection in the shader is nonsense.
  var increasing: Bool = true
  var i: Int = 1
  loop i < base.count {
    if base.splitFar.at(index: i) <= base.splitFar.at(index: i - 1) {
      increasing = false
    }
    i = i + 1
  }
  if increasing {
    log("splits increase: yes")
  } else {
    log("splits increase: NO")
  }

  # The near cascade must resolve finer detail than the far one.
  if base.texelWorld.at(index: 0) < base.texelWorld.at(index: base.count - 1) {
    log("near cascade finer: yes")
  } else {
    log("near cascade finer: NO")
  }

  # 1: a sub-texel camera move must leave cascade 0 EXACTLY unchanged.
  # A tenth of a texel is far below what any renderer would notice
  # geometrically, and is exactly the scale at which unsnapped shadows
  # crawl.
  let texel0: Float = base.texelWorld.at(index: 0)
  let nudged: ShadowCascades = fitAt(camX: texel0 * 0.1, yaw: 0.0)
  if maxGridDelta(a: base, b: nudged, index: 0) is 0.0 {
    log("sub-texel move is snapped: yes")
  } else {
    log("sub-texel move is snapped: NO ({maxGridDelta(a: base, b: nudged, index: 0)})")
  }

  # ...and a move of MANY texels must actually move it, or "snapped"
  # would be trivially satisfied by a fit that ignores the camera.
  let moved: ShadowCascades = fitAt(camX: texel0 * 40.0, yaw: 0.0)
  if maxGridDelta(a: base, b: moved, index: 0) > 0.0 {
    log("large move does track: yes")
  } else {
    log("large move does track: NO")
  }

  # 2: yaw in place must not change the world size of a texel.
  let turned: ShadowCascades = fitAt(camX: 0.0, yaw: 0.9)
  var texelStable: Bool = true
  var k: Int = 0
  loop k < base.count {
    let d: Float = absF(v: base.texelWorld.at(index: k) - turned.texelWorld.at(index: k))
    if d > base.texelWorld.at(index: k) * 0.001 {
      texelStable = false
    }
    k = k + 1
  }
  if texelStable {
    log("texel size rotation-invariant: yes")
  } else {
    log("texel size rotation-invariant: NO")
  }
}
