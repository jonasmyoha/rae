# A module in a folder named after its headline type: folder namespace `Widget`
# == `type Widget`. Qualified calls `Widget.makeWidget(...)` must resolve to the
# module's functions, not be hijacked by the same-named type. Regression for the
# #777 module==type-name collision (sema.c AST_EXPR_METHOD_CALL qualifier path).
type Widget {
  n: Int
}

func makeWidget(value: copy Int) ret Widget {
  ret Widget { n: value }
}

func widgetValue(w: view Widget) ret Int {
  ret w.n
}
