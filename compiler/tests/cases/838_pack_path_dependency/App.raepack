pack PathDependency {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep util: {
      path: "vendor/util"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
