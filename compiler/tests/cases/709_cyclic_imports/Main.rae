# Two project modules that use each other (aa/Aa needs bb/Bb and bb/Bb
# needs aa/Aa): project files are visible without imports, so the cycle
# needs no import and resolves in any order.
func main() {
  let a: Aa = aaFromBb(b: makeBb())
  log("cyclic import: aa.tag={a.tag} bb.usesAa={bbUsesAa()}")
}
