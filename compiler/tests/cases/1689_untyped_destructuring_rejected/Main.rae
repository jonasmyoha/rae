# The destructuring form before 0.4.99 had no types: it is an error that shows the form.
func divide(a: view Int, b: view Int) ret quotient: Int, remainder: Int {
  ret quotient: a / b, remainder: a % b
}

func main() {
  let whole: quotient, let rest: remainder = divide(a: 7, b: 2)
  log("{whole} {rest}")
}
