# A call to a `blocking` extern from a task runs on a blocking-call thread
# while the task suspends (docs/lightweight-spawn-design.md §17). Two
# workers, at most four spawn threads: 32 calls hold their threads at once
# until they are released, and 100 quick tasks run meanwhile. Unmarked, the
# same calls are spawn threads, capped at four: 32 are never held (tried).
# Nothing is timed. Also a String argument and result: files written and read
# back in tasks.

# C that holds its thread (hold.c), and the runtime's file calls, marked
# `blocking`
func holdThread(value: Int) blocking unsafe extern ret Int

func waitForHeld(count: Int) unsafe extern ret Int

func heldThreads() unsafe extern ret Int

func releaseThreads() unsafe extern

func writeText(
  path: String
  content: String
) blocking unsafe extern("rae_ext_rae_sys_write_file") ret Bool

func readText(path: String) blocking unsafe extern("rae_ext_rae_sys_read_file") ret String

func deleteFile(path: String) blocking unsafe extern("rae_ext_rae_sys_delete") ret Bool

func holdTask(value: copy Int) ret Int {
  unsafe {
    ret holdThread(value: value)
  }
}

func double(value: copy Int) ret Int {
  ret value * 2
}

# Write a file and read it back, both on blocking-call threads
func roundTrip(index: copy Int) ret Int {
  let path: String = "/tmp/rae_blocking_fixture_{index}.txt"
  let content: String = "line {index}"
  var written: Bool = false
  unsafe {
    written = writeText(path: path, content: content)
  }
  if not written {
    ret -1
  }
  var text: String = ""
  unsafe {
    text = readText(path: path)
  }
  unsafe {
    let removed: Bool = deleteFile(path: path)
  }
  if text is content {
    ret 1
  }
  ret 0
}

func main() {
  let calls: Int = 32
  var holding: List(Task(Int)) = {}
  loop var i: Int = 0, i < calls, ++i {
    holding.add(value: spawn holdTask(value: i))
  }
  var held: Int = 0
  unsafe {
    held = waitForHeld(count: calls)
  }
  # Two workers, and 32 calls that each hold a thread: other tasks still run
  var doubled: Int = 0
  loop var i: Int = 0, i < 100, ++i {
    let quick: Task(Int) = spawn double(value: i)
    doubled = doubled + quick.get()
  }
  var heldAfter: Int = 0
  unsafe {
    heldAfter = heldThreads()
    releaseThreads()
  }
  var total: Int = 0
  loop var i: Int = 0, i < holding.length, ++i {
    if let task: view Task(Int) = holding.viewAt(index: i) {
      total = total + task.get()
    }
  }
  log("quick tasks: {doubled}, done while the calls blocked: {heldAfter is calls}")
  log("{calls} blocking calls held a thread at once: {held is calls} (results {total})")
  var trips: List(Task(Int)) = {}
  loop var i: Int = 0, i < 8, ++i {
    trips.add(value: spawn roundTrip(index: i))
  }
  var good: Int = 0
  loop var i: Int = 0, i < trips.length, ++i {
    if let trip: view Task(Int) = trips.viewAt(index: i) {
      good = good + trip.get()
    }
  }
  log("files written and read back in tasks: {good} of 8")
}
