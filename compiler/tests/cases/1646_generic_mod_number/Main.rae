# `mod T` and `view T` of a generic function for every number type (and Bool, Char, an enum): a
# store
# through `mod T` reaches the place, also passed on, into a field, a list row, through a `mod`
# local and
# from a declared `mod`. A fixed-width integer was passed by value, which the C compiler refused; a
# `view T` of one, given a `view`, was refused too. A Char and a UInt32 in one program are two
# types.
enum Kind { small, large }

type Box(T: type) {
  inside: T
}

func swapIn(T: type, place: mod T, value: own T) {
  place = own value
}

func copyIn(T: type, place: mod T, value: view T) {
  place = value
}

func passOn(T: type, place: mod T, value: view T) {
  copyIn(place: place, value: value)
}

func swapPlaces(T: type, a: mod T, b: mod T) {
  let held: T = a
  a = b
  b = held
}

func boxIn(T: type, box: mod Box(T), value: view T) {
  copyIn(place: box.inside, value: value)
}

func rowIn(T: type, list: mod List(T), value: view T) {
  if let there: mod T = list.modAt(index: 0) {
    there = value
  }
}

func show(T: type, value: view T) ret String {
  ret "{value}"
}

func showOn(T: type, value: view T) ret String {
  ret show(value: value)
}

func same(T: type, a: view T, b: view T) ret Bool {
  ret a is b
}

func intFirst() ret Int {
  ret 3
}

func intSecond() ret Int {
  ret 4
}

func intDeclared(place: mod Int, value: view Int) ret String {
  swapIn(place: place, value: intSecond())
  passOn(place: place, value: value)
  ret show(value: value)
}

func intRound() {
  var place: Int = 3
  let other: Int = 4
  swapIn(place: place, value: intSecond())
  let swapped: Int = place
  copyIn(place: place, value: intFirst())
  let copied: Int = place
  passOn(place: place, value: other)
  var twin: Int = 3
  swapPlaces(a: place, b: twin)
  var box: Box(Int) = { inside: 3 }
  boxIn(box: box, value: other)
  let shown: String = intDeclared(place: place, value: other)
  log("Int {swapped} {copied} {place} {twin} {box.inside} {shown}")
  let through: mod Int = place
  swapIn(place: through, value: intFirst())
  let window: view Int = other
  log(
    "  by mod {place}, view {show(value: window)} {showOn(value: window)} {same(a: window, b: other)}"
  )
  var list: List(Int) = { 3, 3 }
  rowIn(list: list, value: other)
  if let row: mod Int = list.modAt(index: 1) {
    swapIn(place: row, value: intSecond())
  }
  loop let row: mod Int in list {
    if same(a: row, b: other) {
      copyIn(place: row, value: intSecond())
    }
  }
  log("  rows {list.contains(value: intFirst())} {list.indexOf(value: other)} {list.length}")
}

