func boolFirst() ret Bool {
  ret true
}

func boolSecond() ret Bool {
  ret false
}

func boolDeclared(place: mod Bool, value: view Bool) ret String {
  swapIn(place: place, value: boolSecond())
  passOn(place: place, value: value)
  ret show(value: value)
}

func boolRound() {
  var place: Bool = true
  let other: Bool = false
  swapIn(place: place, value: boolSecond())
  let swapped: Bool = place
  copyIn(place: place, value: boolFirst())
  let copied: Bool = place
  passOn(place: place, value: other)
  var twin: Bool = true
  swapPlaces(a: place, b: twin)
  var box: Box(Bool) = { inside: true }
  boxIn(box: box, value: other)
  let shown: String = boolDeclared(place: place, value: other)
  log("Bool {swapped} {copied} {place} {twin} {box.inside} {shown}")
  let through: mod Bool = place
  swapIn(place: through, value: boolFirst())
  let window: view Bool = other
  log(
    "  by mod {place}, view {show(value: window)} {showOn(value: window)} {same(a: window, b: other)}"
  )
  var list: List(Bool) = { true, true }
  rowIn(list: list, value: other)
  if let row: mod Bool = list.modAt(index: 1) {
    swapIn(place: row, value: boolSecond())
  }
  loop let row: mod Bool in list {
    if same(a: row, b: other) {
      copyIn(place: row, value: boolSecond())
    }
  }
  log("  rows {list.contains(value: boolFirst())} {list.indexOf(value: other)} {list.length}")
}

func charFirst() ret Char {
  ret 'x'
}

func charSecond() ret Char {
  ret 'y'
}

func charDeclared(place: mod Char, value: view Char) ret String {
  swapIn(place: place, value: charSecond())
  passOn(place: place, value: value)
  ret show(value: value)
}

func charRound() {
  var place: Char = 'x'
  let other: Char = 'y'
  swapIn(place: place, value: charSecond())
  let swapped: Char = place
  copyIn(place: place, value: charFirst())
  let copied: Char = place
  passOn(place: place, value: other)
  var twin: Char = 'x'
  swapPlaces(a: place, b: twin)
  var box: Box(Char) = { inside: 'x' }
  boxIn(box: box, value: other)
  let shown: String = charDeclared(place: place, value: other)
  log("Char {swapped} {copied} {place} {twin} {box.inside} {shown}")
  let through: mod Char = place
  swapIn(place: through, value: charFirst())
  let window: view Char = other
  log(
    "  by mod {place}, view {show(value: window)} {showOn(value: window)} {same(a: window, b: other)}"
  )
  var list: List(Char) = { 'x', 'x' }
  rowIn(list: list, value: other)
  if let row: mod Char = list.modAt(index: 1) {
    swapIn(place: row, value: charSecond())
  }
  loop let row: mod Char in list {
    if same(a: row, b: other) {
      copyIn(place: row, value: charSecond())
    }
  }
  log("  rows {list.contains(value: charFirst())} {list.indexOf(value: other)} {list.length}")
}

func kindFirst() ret Kind {
  ret Kind.large
}

func kindSecond() ret Kind {
  ret Kind.small
}

func kindDeclared(place: mod Kind, value: view Kind) ret String {
  swapIn(place: place, value: kindSecond())
  passOn(place: place, value: value)
  ret show(value: value)
}

func kindRound() {
  var place: Kind = Kind.large
  let other: Kind = Kind.small
  swapIn(place: place, value: kindSecond())
  let swapped: Kind = place
  copyIn(place: place, value: kindFirst())
  let copied: Kind = place
  passOn(place: place, value: other)
  var twin: Kind = Kind.large
  swapPlaces(a: place, b: twin)
  var box: Box(Kind) = { inside: Kind.large }
  boxIn(box: box, value: other)
  let shown: String = kindDeclared(place: place, value: other)
  log("Kind {swapped} {copied} {place} {twin} {box.inside} {shown}")
  let through: mod Kind = place
  swapIn(place: through, value: kindFirst())
  let window: view Kind = other
  log(
    "  by mod {place}, view {show(value: window)} {showOn(value: window)} {same(a: window, b: other)}"
  )
  var list: List(Kind) = { Kind.large, Kind.large }
  rowIn(list: list, value: other)
  if let row: mod Kind = list.modAt(index: 1) {
    swapIn(place: row, value: kindSecond())
  }
  loop let row: mod Kind in list {
    if same(a: row, b: other) {
      copyIn(place: row, value: kindSecond())
    }
  }
  log("  rows {list.contains(value: kindFirst())} {list.indexOf(value: other)} {list.length}")
}

func charAndUInt32() {
  let number: UInt32 = 120
  let letter: Char = 'x'
  let numbers: List(UInt32) = { 120, 121 }
  let letters: List(Char) = { 'x', 'y' }
  let maybeNumber: opt UInt32 = 120
  let maybeLetter: opt Char = 'x'
  log("{show(value: number)} {show(value: letter)} {numbers} {letters} {maybeNumber} {maybeLetter}")
  log("{show(value: numbers)} {show(value: letters)} {letters.contains(value: 'y')}")
}

func main() {
  intRound()
  int8Round()
  int16Round()
  int32Round()
  uint8Round()
  uint16Round()
  uint32Round()
  uint64Round()
  floatRound()
  float64Round()
  boolRound()
  charRound()
  kindRound()
  charAndUInt32()
}
