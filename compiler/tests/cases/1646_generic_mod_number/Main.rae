func floatFirst() ret Float {
  ret 1.5
}

func floatSecond() ret Float {
  ret 2.5
}

func floatDeclared(place: mod Float, value: view Float) ret String {
  swapIn(place: place, value: floatSecond())
  passOn(place: place, value: value)
  ret show(value: value)
}

func floatRound() {
  var place: Float = 1.5
  let other: Float = 2.5
  swapIn(place: place, value: floatSecond())
  let swapped: Float = place
  copyIn(place: place, value: floatFirst())
  let copied: Float = place
  passOn(place: place, value: other)
  var twin: Float = 1.5
  swapPlaces(a: place, b: twin)
  var box: Box(Float) = { inside: 1.5 }
  boxIn(box: box, value: other)
  let shown: String = floatDeclared(place: place, value: other)
  log("Float {swapped} {copied} {place} {twin} {box.inside} {shown}")
  let through: mod Float = place
  swapIn(place: through, value: floatFirst())
  let window: view Float = other
  log(
    "  by mod {place}, view {show(value: window)} {showOn(value: window)} {same(a: window, b: other)}"
  )
  var list: List(Float) = { 1.5, 1.5 }
  rowIn(list: list, value: other)
  if let row: mod Float = list.modAt(index: 1) {
    swapIn(place: row, value: floatSecond())
  }
  loop let row: mod Float in list {
    if same(a: row, b: other) {
      copyIn(place: row, value: floatSecond())
    }
  }
  log("  rows {list.contains(value: floatFirst())} {list.indexOf(value: other)} {list.length}")
}

