pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep qr: {
      git: "../../../.."
      subdir: "packages/qr"
      version: "1.1.0"
      hash: "git-tree:3c199ad6e55e452b4c8beceec9dcc3aec290faf7"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
