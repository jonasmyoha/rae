pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep qr: {
      git: "../../../.."
      subdir: "packages/qr"
      version: "1.0.0"
      hash: "git-tree:79d8c270d8a9c6ae1a43bae85d65fc61dc576e4e"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
