open ui/Ecs
open ui/Components
open ui/scrollRootSystem/ScrollRootSystem
open ui/inputSystem/InputSystem
open ui/Transform
open ecs/Entity
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open ui/UiSystems

# A `ScrollRoot` on the content node inside a clipped viewport (the former
# ScrollPanel shape, #729) with the lib iOS-style scroll physics (drag -> release
# momentum -> friction decay; rubber-band + spring-back past a bound). This drives
# updateScrollRoot deterministically and checks the feel: a drag moves the
# position 1:1 in-bounds, releasing hands the lift velocity to a momentum fling
# that keeps moving and decays to rest, and a fling that overshoots the bottom
# springs back to the floor. The floor is the laid-out geometry: content 3000
# tall in a 100-tall viewport -> -2900. Positions are <= 0 (content slid up).
func setupNode(
  world: mod UiWorld
  uiSystems: mod UiSystems
  nodeId: view String
  w: view Float
  h: view Float
) ret EntityId {
  let e: EntityId = createEntity(world: world)
  componentSet(
    this: uiSystems.layout.computedRects
    entity: e
    data: ComputedRect { position: { x: 0.0, y: 0.0 }, size: { x: w, y: h } }
  )
  world.nodeIds.set(k: nodeId, value: e.index)
  ret e
}

func step(
  world: mod UiWorld
  uiSystems: mod UiSystems
  panel: view EntityId
  input: mod UiInput
  x: view Float
  y: view Float
  down: view Bool
  pressed: view Bool
  released: view Bool
) ret Bool {
  input.pointer = UiPointerState {
    x: x
    y: y
    down: down
    pressed: pressed
    released: released
  }
  ret updateScrollRoot(
    world: world
    uiSystems: uiSystems
    entity: panel
    input: input
  )
}

func offsetOf(world: view UiWorld, panel: view EntityId) ret Float {
  ret componentGet(this: world.scrollStates, entity: panel).y
}

# Round a Float to the nearest Int so momentum trace lines are stable/readable.
func roundI(value: view Float) ret Int {
  if value < 0.0 {
    ret (value - 0.5).toInt()
  }
  ret (value + 0.5).toInt()
}

func main() {
  var world: UiWorld = createUiWorld()
  var uiSystems: UiSystems = createUiSystems()
  # Viewport 100 tall at screen origin; content 3000 tall -> range 2900 (plenty of
  # room so momentum settles well inside the bounds).
  let vp: EntityId = setupNode(
    world: world
    uiSystems: uiSystems
    nodeId: "vp"
    w: 100.0
    h: 100.0
  )
  componentSet(
    this: uiSystems.transform2d.worldTransforms
    entity: vp
    data: WorldTransform2D {
      position: Vec2 { x: 0.0, y: 0.0 }
      rotation: 0.0
      scale: Vec2 { x: 1.0, y: 1.0 }
    }
  )
  let content: EntityId = setupNode(
    world: world
    uiSystems: uiSystems
    nodeId: "content"
    w: 100.0
    h: 3000.0
  )

  setParent(
    parents: uiSystems.hierarchy.parents
    childrens: world.childrens
    child: content
    parent: vp
  )
  let root: ScrollRoot = {
    axis: ScrollAxis.y
    floor: ScrollFloorMode.content
    fixedFloor: 0.0
    endInset: 0.0
  }
  componentSet(this: world.scrollRoots, entity: content, data: root)
  let memory: ScrollMemory = createScrollMemory()
  scrollRootSystem(world: world, uiSystems: uiSystems, memory: memory)
  let panel: EntityId = findScrollRoot(world: world, uiSystems: uiSystems)
  log("root is content: {panel.index is content.index}")
  let range: ScrollRange = scrollRootRange(world: world, uiSystems: uiSystems, entity: panel)
  log("floor: {roundI(value: range.floor)} window: {roundI(value: range.window)}")

  var input: UiInput = createUiInput()

  # Press inside, then drag the finger UP by 20 twice (content scrolls up, so the
  # offset grows 1:1 while in bounds).
  step(
    world: world
    uiSystems: uiSystems
    panel: panel
    input: input
    x: 50.0
    y: 50.0
    down: true
    pressed: true
    released: false
  )
  log("press   offset={roundI(value: offsetOf(world: world, panel: panel))}")
  step(
    world: world
    uiSystems: uiSystems
    panel: panel
    input: input
    x: 50.0
    y: 30.0
    down: true
    pressed: false
    released: false
  )
  log("drag1   offset={roundI(value: offsetOf(world: world, panel: panel))}")
  step(
    world: world
    uiSystems: uiSystems
    panel: panel
    input: input
    x: 50.0
    y: 10.0
    down: true
    pressed: false
    released: false
  )
  log("drag2   offset={roundI(value: offsetOf(world: world, panel: panel))}")

  # Release: the lift velocity (~20/frame) becomes a momentum fling.
  step(
    world: world
    uiSystems: uiSystems
    panel: panel
    input: input
    x: 50.0
    y: 10.0
    down: false
    pressed: false
    released: true
  )
  log("release offset={roundI(value: offsetOf(world: world, panel: panel))}")

  # Momentum: keep stepping with no input. The offset keeps moving and the steps
  # shrink (friction), then it settles. Loop to rest, counting frames.
  var frames: Int = 0
  var moving: Bool = true
  loop moving {
    moving = step(
      world: world
      uiSystems: uiSystems
      panel: panel
      input: input
      x: 50.0
      y: 10.0
      down: false
      pressed: false
      released: false
    )
    frames = frames + 1
    if frames > 500 {
      moving = false
    }
  }
  let settled: Float = offsetOf(world: world, panel: panel)
  log(
    "momentum settled offset={roundI(value: settled)} inBounds={settled <= 0.0 and settled >= -2900.0}"
  )

  # ----- rubber-band + spring-back past the BOTTOM bound -----
  # Press INSIDE the 100-tall viewport, then drag the finger up 800/frame for
  # several frames. As the position creeps past the floor (-2900) each further
  # delta is rubber-band-damped, so it overshoots only a little; releasing lets the
  # spring pull it back to exactly the floor.
  step(
    world: world
    uiSystems: uiSystems
    panel: panel
    input: input
    x: 50.0
    y: 50.0
    down: true
    pressed: true
    released: false
  )
  var y: Float = 50.0
  loop var k: Int = 0, k < 6, ++k {
    y = y - 800.0
    step(
      world: world
      uiSystems: uiSystems
      panel: panel
      input: input
      x: 50.0
      y: y
      down: true
      pressed: false
      released: false
    )
  }
  let overshoot: Float = offsetOf(world: world, panel: panel)
  log("overshoot past floor: {overshoot < -2900.0}")
  step(
    world: world
    uiSystems: uiSystems
    panel: panel
    input: input
    x: 50.0
    y: y
    down: false
    pressed: false
    released: true
  )
  var f2: Int = 0
  var m2: Bool = true
  loop m2 {
    m2 = step(
      world: world
      uiSystems: uiSystems
      panel: panel
      input: input
      x: 50.0
      y: y
      down: false
      pressed: false
      released: false
    )
    f2 = f2 + 1
    if f2 > 500 {
      m2 = false
    }
  }
  log("spring settled at bound: {roundI(value: offsetOf(world: world, panel: panel))}")
}
