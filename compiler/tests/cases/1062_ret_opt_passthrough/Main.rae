# `ret <an opt value>` from a `func … ret opt T` passes the optional through.
# `ret task.tryGet()` used to wrap it in a second optional, and the C did not
# compile (lib/net/ecs's takeReply worked around it). Covered: tryGet with a
# struct, a String and an Int result (through a `mod Task` parameter and
# through a field of a struct), IntMap.get, and a user function that itself
# returns an opt; each is then unwrapped, found and not found.
open collections/IntMap

type Reply {
  status: Int
  body: String
}

type Pending {
  sequence: Int
  task: Task(Reply)
}

func slowReply(code: copy Int) ret Reply {
  ret Reply { status: code, body: "done {code}" }
}

func slowName(index: copy Int) ret String {
  ret "name {index}"
}

func slowCount(count: copy Int) ret Int {
  ret count * 3
}

func takeReply(task: mod Task(Reply)) ret opt Reply {
  ret task.tryGet()
}

func takeFromPending(pending: mod Pending) ret opt Reply {
  ret pending.task.tryGet()
}

func takeName(task: mod Task(String)) ret opt String {
  ret task.tryGet()
}

func takeCount(task: mod Task(Int)) ret opt Int {
  ret task.tryGet()
}

func lookup(table: view IntMap(String), key: view Int) ret opt String {
  ret get(this: table, k: key)
}

func firstEven(numbers: view List(Int)) ret opt Int {
  loop var i: Int = 0, i < numbers.length, ++i {
    if numbers.copyAtFallback(index: i, fallback: 1) % 2 is 0 {
      ret numbers.copyAtFallback(index: i, fallback: 0)
    }
  }
  ret none
}

func evenAgain(numbers: view List(Int)) ret opt Int {
  ret firstEven(numbers: numbers)
}

func main() {
  var reply: Task(Reply) = spawn slowReply(code: 200)
  loop not reply.isDone() {
    sleep(ms: 1)
  }
  if let value: Reply = takeReply(task: reply) {
    log("reply {value.status} {value.body}")
  }
  var handedOutTwice: Bool = false
  if let again: Reply = takeReply(task: reply) {
    handedOutTwice = true
  }
  log("handed out twice: {handedOutTwice}")

  var pending: Pending = { sequence: 4, task: spawn slowReply(code: 404) }
  loop not pending.task.isDone() {
    sleep(ms: 1)
  }
  if let value: Reply = takeFromPending(pending: pending) {
    log("pending {pending.sequence}: {value.status} {value.body}")
  }

  var name: Task(String) = spawn slowName(index: 7)
  loop not name.isDone() {
    sleep(ms: 1)
  }
  if let value: String = takeName(task: name) {
    log("{value}")
  }

  var count: Task(Int) = spawn slowCount(count: 14)
  loop not count.isDone() {
    sleep(ms: 1)
  }
  if let value: Int = takeCount(task: count) {
    log("count {value}")
  }

  var names: IntMap(String) = createIntMap(String, cap: 8)
  set(this: names, k: 3, value: "three")
  if let found: String = lookup(table: names, key: 3) {
    log("key 3: {found}")
  }
  var missing: Bool = true
  if let found: String = lookup(table: names, key: 9) {
    missing = false
  }
  log("key 9 missing: {missing}")

  let numbers: List(Int) = { 1, 3, 4, 5 }
  if let even: Int = evenAgain(numbers: numbers) {
    log("first even: {even}")
  }
  let odd: List(Int) = { 1, 3 }
  var noEven: Bool = true
  if let even: Int = evenAgain(numbers: odd) {
    noEven = false
  }
  log("no even: {noEven}")
}
