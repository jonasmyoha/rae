open ecs/Entity
open ecs/ComponentTable

# #810: pins the dense-iteration-order CONTRACT of ComponentTable.
#   - dense order is INSERTION order until the first non-tail componentRemove;
#   - a non-tail remove is a SWAP-REMOVE: the LAST row moves into the removed
#     row's slot (its data and its change stamp move with it), so order after
#     that point is unspecified — a system must not assume it;
#   - removing the TAIL row leaves the remaining order untouched.
# The swap-remove is the deliberate data-oriented choice (O(1), keeps the
# array dense); order instability is its documented cost.

type Position { x: Int }

func order(pos: view ComponentTable(Position)) ret String {
  var line: String = ""
  loop var i: Int = 0, i < componentCount(this: pos), ++i {
    let e: EntityId = componentEntityAt(this: pos, i: i)
    let p: Position = componentDataAt(this: pos, i: i)
    line = "{line}e{e.index}:{p.x} "
  }
  ret line
}

func main() {
  var pos: ComponentTable(Position) = createComponentTable(Position)
  let e1: EntityId = { index: 1, generation: 0 }
  let e2: EntityId = { index: 2, generation: 0 }
  let e3: EntityId = { index: 3, generation: 0 }
  let e4: EntityId = { index: 4, generation: 0 }
  componentSet(this: pos, entity: e1, data: Position { x: 10 })
  componentSet(this: pos, entity: e2, data: Position { x: 20 })
  componentSet(this: pos, entity: e3, data: Position { x: 30 })
  componentSet(this: pos, entity: e4, data: Position { x: 40 })
  log("insertion: {order(pos: pos)}")

  # Non-tail remove: e2's slot (dense 1) receives the TAIL row (e4).
  let stamp4: Int = componentModStamp(this: pos, entity: e4)
  componentRemove(this: pos, entity: e2)
  log("after removing e2 (non-tail): {order(pos: pos)}")
  log("e4 still findable at dense {componentIndexOf(this: pos, entity: e4)} with x={componentGet(this: pos, entity: e4).x}")
  log("e4 stamp moved intact: {componentModStamp(this: pos, entity: e4) - stamp4}")
  log("e2 gone: {componentHas(this: pos, entity: e2)}")

  # Tail remove: order of the rest is untouched.
  componentRemove(this: pos, entity: e3)
  log("after removing e3 (tail): {order(pos: pos)}")
}
