const assets: String = "../examples/104_ui_hello/assets/"

type App {
  world: UiWorld
  uiSystems: UiSystems
  input: UiInput
  resources: Gpu2dUi
  scenes: SceneRegistry
  files: FileBrowserSystems
  base: String
  left: EntityId
  page: EntityId
  step: Float64 = 0.02
  lines: List(String) = {}
  dragKeys: DragKeys = {}
  osDrop: OsDrop = {}
}

# One frame of everything, as an app has it
func frame(
  app: mod App
  pointer: view UiPointerState
  listKeys: view ListSelectionKeys
  keys: view BrowserKeys
  text: view TextInputFrame
  menuKeys: view MenuKeys
) {
  app.input.nowSeconds = app.input.nowSeconds + app.step
  updateUiInputWith(
    input: app.input
    world: app.world
    uiSystems: app.uiSystems
    pointer: pointer
    wheel: 0.0
  )
  menuSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: menuKeys
  )
  var changed: Bool = dividerSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: DividerKeys {}
  )
  changed = scrollBarSystem(world: app.world, uiSystems: app.uiSystems, input: app.input)
  changed = dragSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: app.dragKeys
    osDrop: app.osDrop
  )
  changed = keyFocusSystem(world: app.world, uiSystems: app.uiSystems, input: app.input)
  changed = textFieldSystem(
    world: app.world
    textFieldSystem: app.uiSystems.textField
    actions: app.world.uiActions
    input: text
    now: app.input.nowSeconds
  )
  listSelectionSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: listKeys
  )
  changed = fileBrowserUpdate(
    systems: app.files
    world: app.world
    uiSystems: app.uiSystems
    scenes: app.scenes
    keys: keys
    input: app.input
    windowFocused: true
  )
  noteEvents(app: app)
  changed = updateScrollRoots(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    deltaTime: 0.02
  )
  changed = scrollToRowSystem(world: app.world, uiSystems: app.uiSystems)
  changed = fileBrowserRows(
    systems: app.files
    world: app.world
    uiSystems: app.uiSystems
    scenes: app.scenes
    res: app.resources
  )
  listViewSystem(world: app.world, uiSystems: app.uiSystems, scenes: app.scenes)
  # (the motion of the dialogs, by the case's own time)
  animationSystem(world: app.world, uiSystems: app.uiSystems, deltaTime: 0.1)
  let closed: Bool = dialogSystem(world: app.world, uiSystems: app.uiSystems)
  runUiSystems(world: app.world, uiSystems: app.uiSystems, res: app.resources)
  releaseDeadEntities(world: app.world, uiSystems: app.uiSystems)
}

func nodeOf(world: view UiWorld, nodeId: view String) ret EntityId {
  if let raw: Int = findNodeInPage(world: world, pageId: "p", nodeId: nodeId) {
    ret nodeEntityId(world: world, index: raw)
  }
  ret noEntity()
}

func boxOf(app: view App, entityId: view EntityId) ret WorldRect {
  ret worldRectOf(
    wt: componentView(this: app.uiSystems.transform2d.worldTransforms, entityId: entityId)
    cr: componentView(this: app.uiSystems.layout.computedRects, entityId: entityId)
  )
}

func writeFile(path: view String, text: view String) {
  let written: Bool = Sys.writeFile(path: path, content: text)
}

func makeFolder(path: view String) {
  let made: Bool = Sys.makeDir(path: path)
}

func removeTree(folder: view String) {
  loop let entry: view FileEntry in Files.readFolder(folder: folder).entries {
    if entry.kind is EntryKind.folder {
      removeTree(folder: "{folder}/{entry.name}")
    } else {
      let gone: Bool = Sys.delete(path: "{folder}/{entry.name}")
    }
  }
  let gone: Bool = Sys.delete(path: folder)
}

func makeApp(base: view String) ret App {
  let scene: Scene = parseScene(source: embedText(file: "Page.raescene"))
  let resources: Gpu2dUi = {
    textFont: SdfText.loadSdfFont(
      jsonPath: "{assets}Roboto-Regular.mtsdf.json"
      rawAtlasPath: "{assets}Roboto-Regular.mtsdf.raw"
    )
    iconFont: SdfText.loadSdfFont(
      jsonPath: "{assets}Roboto-Regular.mtsdf.json"
      rawAtlasPath: "{assets}Roboto-Regular.mtsdf.raw"
    )
    theme: parseTheme(scene: scene)
    activeTheme: lightTheme()
  }
  var app: App = {
    world: createUiWorld()
    uiSystems: createUiSystems()
    input: createUiInput()
    resources: resources
    scenes: createSceneRegistry()
    files: createFileBrowsers()
    base: "{base}"
    left: noEntity()
    page: noEntity()
  }
  registerFileBrowserScenes(scenes: app.scenes)
  seedWorldTheme(world: app.world, res: app.resources)
  app.world.layoutW = 900.0
  app.world.layoutH = 500.0
  app.input.nowSeconds = 100.0
  let root: EntityId = loadSceneIntoPage(
    world: app.world
    uiSystems: app.uiSystems
    scene: scene
    pageId: "p"
  )
  log("diagnostics {app.world.sceneDiagnostics.length}")
  ret app
}

# What the browsers told of, kept until it is shown
func noteEvents(app: mod App) {
  loop var i: Int = 0, i < eventCount(FolderOpened, this: app.files.folderOpened), ++i {
    let event: FolderOpened = eventAt(FolderOpened, this: app.files.folderOpened, i: i)
    app.lines.add(value: "   at {Files.nameOf(path: event.folder)}")
  }
  loop var i: Int = 0, i < eventCount(FileActivated, this: app.files.fileActivated), ++i {
    let event: FileActivated = eventAt(FileActivated, this: app.files.fileActivated, i: i)
    loop let path: view String in event.paths {
      app.lines.add(
        value: "   activated {path.sub(
          start: app.base.length()
          len: path.length() - app.base.length()
        )}"
      )
    }
  }
  loop var i: Int = 0, i < eventCount(PickAnswered, this: app.files.pickAnswered), ++i {
    let event: PickAnswered = eventAt(PickAnswered, this: app.files.pickAnswered, i: i)
    var text: String = ""
    loop let path: view String in event.paths {
      if path.startsWith(prefix: app.base) {
        text = "{text} {path.sub(start: app.base.length(), len: path.length() - app.base.length())}"
      } else {
        text = "{text} {path}"
      }
    }
    app.lines.add(value: "   answered{text}: canceled {event.canceled}, replace {event.replace}")
  }
  loop var i: Int = 0, i < eventCount(FilesDropped, this: app.files.filesDropped), ++i {
    let event: FilesDropped = eventAt(FilesDropped, this: app.files.filesDropped, i: i)
    app.lines.add(
      value: "   dropped {event.paths.length} in {Files.nameOf(path: event.folder)}, moved {event.moved}, external {event.external}"
    )
  }
  loop var i: Int = 0, i < eventCount(OperationDone, this: app.files.operationDone), ++i {
    let event: OperationDone = eventAt(OperationDone, this: app.files.operationDone, i: i)
    var text: String = ""
    loop let result: view ItemResult in event.results {
      text = "{text} {Files.nameOf(path: result.source)}>{Files.nameOf(path: result.target)} {result.outcome}"
      if result.error is not OperationError.none {
        text = "{text} ({result.error})"
      }
    }
    app.lines.add(value: "   done {event.kind}:{text}")
  }
  loop var i: Int = 0, i < eventCount(OperationAsked, this: app.files.operationAsked), ++i {
    let event: OperationAsked = eventAt(OperationAsked, this: app.files.operationAsked, i: i)
    app.lines.add(
      value: "   asks {event.kind}: {Files.nameOf(path: event.source)} > {Files.nameOf(
        path: event.target
      )}"
    )
  }
  loop var i: Int = 0, i < eventCount(OperationRequested, this: app.files.operationRequested), ++i {
    let event: OperationRequested = eventAt(
      OperationRequested
      this: app.files.operationRequested
      i: i
    )
    app.lines.add(
      value: "   requested {event.kind} in {event.folder}: {event.paths.length} paths {event.name}"
    )
  }
  loop var i: Int = 0, i < eventCount(BrowserMenuChosen, this: app.files.browserMenuChosen), ++i {
    let event: BrowserMenuChosen = eventAt(
      BrowserMenuChosen
      this: app.files.browserMenuChosen
      i: i
    )
    app.lines.add(value: "   chosen {event.itemId}: {event.paths.length} paths")
  }
  loop var i: Int = 0, i < eventCount(EntriesRequested, this: app.files.entriesRequested), ++i {
    let wanted: EntriesRequested = eventAt(EntriesRequested, this: app.files.entriesRequested, i: i)
    var entries: List(FileEntry) = {}
    if wanted.folder is "/Project" {
      entries.add(value: FileEntry { name: "Takes", kind: EntryKind.folder })
      entries.add(value: FileEntry { name: "take.wav", kind: EntryKind.file })
    }
    setColumnEntries(
      systems: app.files
      world: app.world
      uiSystems: app.uiSystems
      scenes: app.scenes
      browser: wanted.browser
      folder: wanted.folder
      entries: own entries
    )
  }
}

func emptyText() ret TextInputFrame {
  ret TextInputFrame { typed: "", backspaces: 0, enter: false, tapped: false }
}

func still(app: view App) ret UiPointerState {
  ret uiPointerScriptFrame(
    previous: app.input.pointer
    x: app.input.pointer.x
    y: app.input.pointer.y
    down: false
    kind: InputKind.mouse
  )
}

func idle(app: mod App) {
  frame(
    app: app
    pointer: still(app: app)
    listKeys: ListSelectionKeys {}
    keys: BrowserKeys {}
    text: emptyText()
    menuKeys: MenuKeys {}
  )
}

func busy(app: view App) ret Bool {
  # (a search a late notice of the OS asked for, too)
  loop var i: Int = 0, i < componentCount(this: app.files.searches), ++i {
    let browser: EntityId = componentEntityAt(this: app.files.searches, i: i)
    if componentView(this: app.files.searches, entityId: browser).startAt >= 0.0 {
      ret true
    }
  }
  loop let job: view OperationJob in app.files.operations.jobs {
    if job.state is OperationJobState.running or job.state is OperationJobState.waiting {
      ret true
    }
  }
  ret app.files.picking.jobs.length + app.files.listing.jobs.length + app.files.listing.waiting.length + app.files.search.jobs.length > 0
}

# Frames until nothing is read or done, and some more
func settle(app: mod App) {
  var quiet: Int = 0
  loop var i: Int = 0, i < 4000 and quiet < 12, ++i {
    idle(app: app)
    quiet = quiet + 1
    if busy(app: app) {
      quiet = 0
      sleep(ms: 1)
    }
  }
}

func listKey(app: mod App, keys: view ListSelectionKeys) {
  frame(
    app: app
    pointer: still(app: app)
    listKeys: keys
    keys: BrowserKeys {}
    text: emptyText()
    menuKeys: MenuKeys {}
  )
  settle(app: app)
}

func press(app: mod App, keys: view BrowserKeys) {
  frame(
    app: app
    pointer: still(app: app)
    listKeys: ListSelectionKeys {}
    keys: keys
    text: emptyText()
    menuKeys: MenuKeys {}
  )
  settle(app: app)
}

func clickAt(
  app: mod App
  x: view Float
  y: view Float
  listKeys: view ListSelectionKeys
) {
  loop var step: Int = 0, step < 3, ++step {
    var state: UiPointerState = uiPointerScriptFrame(
      previous: app.input.pointer
      x: x
      y: y
      down: step is 1
      kind: InputKind.mouse
    )
    state.clicks = 1
    frame(
      app: app
      pointer: state
      listKeys: listKeys
      keys: BrowserKeys {}
      text: emptyText()
      menuKeys: MenuKeys {}
    )
  }
  settle(app: app)
}

func clickNode(app: mod App, entityId: view EntityId) {
  if isNone(this: entityId) or componentHas(
    this: app.uiSystems.layout.computedRects
    entityId: entityId
  ) is false {
    log("no node to click")
    ret
  }
  let box: WorldRect = boxOf(app: app, entityId: entityId)
  clickAt(
    app: app
    x: box.x + box.w * 0.5
    y: box.y + box.h * 0.5
    listKeys: ListSelectionKeys {}
  )
}

func rowX(app: view App, browser: view EntityId, place: view Int) ret Float {
  let column: EntityId = columnAt(systems: app.files, browser: browser, place: place)
  ret boxOf(app: app, entityId: listOfColumn(systems: app.files, column: column)).x + 30.0
}

func rowY(
  app: view App
  browser: view EntityId
  place: view Int
  name: view String
) ret Float {
  let column: EntityId = columnAt(systems: app.files, browser: browser, place: place)
  let index: Int = entryIndex(systems: app.files, column: column, name: name)
  let box: WorldRect = boxOf(app: app, entityId: listOfColumn(systems: app.files, column: column))
  ret box.y + index.toFloat() * 24.0 + 12.0
}

func pick(
  app: mod App
  browser: view EntityId
  place: view Int
  name: view String
) {
  clickAt(
    app: app
    x: rowX(app: app, browser: browser, place: place)
    y: rowY(
      app: app
      browser: browser
      place: place
      name: name
    )
    listKeys: ListSelectionKeys {}
  )
}

# The dialog page over the screen, with a browser in it
func openPage(app: mod App, options: view BrowserOptions) {
  mountPage(app: app, scene: parseScene(source: embedText(file: "Pick.raescene")))
  app.left = openFileBrowser(
    systems: app.files
    world: app.world
    uiSystems: app.uiSystems
    scenes: app.scenes
    host: filesNode(app: app)
    root: "{app.base}/root"
    options: options
  )
  settle(app: app)
}

func filesNode(app: view App) ret EntityId {
  if let raw: Int = findNodeInPage(world: app.world, pageId: "pick", nodeId: "Files") {
    ret nodeEntityId(world: app.world, index: raw)
  }
  ret noEntity()
}

func mountPage(app: mod App, scene: view Scene) {
  let root: EntityId = loadSceneIntoPage(
    world: app.world
    uiSystems: app.uiSystems
    scene: scene
    pageId: "pick"
  )
  app.page = presentMountedPage(
    world: app.world
    uiSystems: app.uiSystems
    pageRoot: root
    pageId: "pick"
    overrides: List(SceneOverride) {}
  )
}

# The program closes the page; its browser goes with it
func closePage(app: mod App) {
  closePresentedPage(world: app.world, uiSystems: app.uiSystems, host: app.page)
  settle(app: app)
  log(
    "   closed: {componentCount(this: app.files.browsers)} browsers, {componentCount(
      this: app.files.picks
    )} picks, {app.world.escapeHold.holders} hold Escape"
  )
}

func footerNode(app: view App, name: view String) ret EntityId {
  ret nodeIn(
    world: app.world
    root: componentView(this: app.files.browsers, entityId: app.left).scene
    nodeId: "FileBrowserPick{name}"
  )
}

func textOf(app: view App, entityId: view EntityId) ret String {
  ret "{componentView(this: app.world.texts, entityId: entityId).text}"
}

func visible(app: view App, entityId: view EntityId) ret Bool {
  ret componentHas(this: app.world.actives, entityId: entityId) is false or componentView(
    this: app.world.actives
    entityId: entityId
  ).value
}

# The footer as it is shown
func footerText(app: view App) ret String {
  if visible(app: app, entityId: footerNode(app: app, name: "")) is false {
    ret "no footer"
  }
  var text: String = "Cancel, {textOf(app: app, entityId: footerNode(app: app, name: "DoneText"))}"
  let done: EntityId = footerNode(app: app, name: "Done")
  if componentView(this: app.world.opacities, entityId: done).value < 0.9 {
    text = "{text} (off)"
  }
  if visible(app: app, entityId: footerNode(app: app, name: "NewFolder")) {
    text = "New Folder, {text}"
  }
  if visible(app: app, entityId: footerNode(app: app, name: "NameBox")) {
    let field: EntityId = footerNode(app: app, name: "Name")
    let typed: view TextField = componentView(this: app.world.textFields, entityId: field)
    text = "name \"{typed.text}\" typing {typed.focused}, {text}"
  }
  if visible(app: app, entityId: footerNode(app: app, name: "Note")) {
    text = "{text}, note \"{textOf(app: app, entityId: footerNode(app: app, name: "Note"))}\""
  }
  ret text
}

func questionOf(app: view App) ret EntityId {
  ret componentView(this: app.files.picks, entityId: app.left).question
}

func question(app: view App) ret String {
  let node: EntityId = questionOf(app: app)
  if isNone(this: node) {
    ret "no question"
  }
  var text: String = textOf(
    app: app
    entityId: nodeIn(world: app.world, root: node, nodeId: "FileQuestionTitle")
  )
  loop let name: view String in List(String) {
    "Stop"
    "Skip"
    "Keep"
    "Replace"
    "All"
  } {
    if visible(
      app: app
      entityId: nodeIn(world: app.world, root: node, nodeId: "FileQuestion{name}")
    ) {
      text = "{text} [{name}]"
    }
  }
  ret "asks: {text}"
}

func answerQuestion(app: mod App, name: view String) {
  clickNode(
    app: app
    entityId: nodeIn(world: app.world, root: questionOf(app: app), nodeId: "FileQuestion{name}")
  )
}

# The rows of a column that are muted
func mutedText(app: view App, place: view Int) ret String {
  let column: EntityId = columnAt(systems: app.files, browser: app.left, place: place)
  var text: String = "muted:"
  let held: view ColumnEntries = componentView(this: app.files.entries, entityId: column)
  loop let entry: view FileEntry in held.entries {
    if entryFits(
      kinds: app.files.kinds
      options: browserOptions(systems: app.files, browser: app.left)
      entry: entry
    ) is false {
      text = "{text} {entry.name}"
    }
  }
  ret "{text} ({mutedRows(app: app)} rows)"
}

# What is shown muted
func mutedRows(app: view App) ret Int {
  var count: Int = 0
  loop var i: Int = 0, i < componentCount(this: app.world.opacities), ++i {
    let node: EntityId = componentEntityAt(this: app.world.opacities, i: i)
    let value: Float = componentView(this: app.world.opacities, entityId: node).value
    # (a button of the bar or the footer that is off has 0.35)
    if value > 0.37 and value < 0.45 {
      count = count + 1
    }
  }
  ret count
}

# Two clicks at once
func doublePick(app: mod App, place: view Int, name: view String) {
  let x: Float = rowX(app: app, browser: app.left, place: place)
  let y: Float = rowY(
    app: app
    browser: app.left
    place: place
    name: name
  )
  loop var step: Int = 0, step < 5, ++step {
    var state: UiPointerState = uiPointerScriptFrame(
      previous: app.input.pointer
      x: x
      y: y
      down: step is 1 or step is 3
      kind: InputKind.mouse
    )
    state.clicks = 1 + step / 3
    frame(
      app: app
      pointer: state
      listKeys: ListSelectionKeys {}
      keys: BrowserKeys {}
      text: emptyText()
      menuKeys: MenuKeys {}
    )
  }
  settle(app: app)
}

# The tree of a folder on the disk
func diskText(folder: view String) ret String {
  var text: String = ""
  var listing: FolderListing = Files.readFolder(folder: folder)
  var names: List(String) = {}
  loop let entry: view FileEntry in listing.entries {
    var name: String = "{entry.name}"
    if entry.kind is EntryKind.folder {
      name = "{name}({diskText(folder: "{folder}/{entry.name}")})"
    }
    names.add(value: own name)
  }
  # by name
  loop var i: Int = 0, i < names.length, ++i {
    loop var j: Int = i + 1, j < names.length, ++j {
      let first: String = names.copyAtFallback(index: i, fallback: "")
      let second: String = names.copyAtFallback(index: j, fallback: "")
      if second.compare(other: first) < 0 {
        names.set(index: i, value: second)
        names.set(index: j, value: first)
      }
    }
  }
  ret names.join(sep: " ")
}

func show(app: mod App, step: view String) {
  log("{step}")
  loop let line: view String in app.lines {
    log("{line}")
  }
  app.lines.clear()
  if componentHas(this: app.files.picks, entityId: app.left) is false {
    ret
  }
  log("   {footerText(app: app)}")
  if isNone(this: questionOf(app: app)) is false {
    log("   {question(app: app)}")
  }
  loop let column: view EntityId in browserColumns(systems: app.files, browser: app.left) {
    let mine: view FileColumn = componentView(this: app.files.columns, entityId: column)
    var names: List(String) = {}
    let held: view ColumnEntries = componentView(this: app.files.entries, entityId: column)
    loop let entry: view FileEntry in held.entries {
      names.add(value: "{entry.name}")
    }
    var folder: String = Files.nameOf(path: mine.folder)
    if mine.folder is app.base {
      folder = "base"
    }
    log(
      "   {folder}: {names.join(sep: " ")} [{listSelectedKeys(world: app.world, list: mine.list).join(
        sep: " "
      )}]"
    )
  }
}

# The pointer moves to (x, y), held or not
func pointTo(
  app: mod App
  x: view Float
  y: view Float
  down: view Bool
) {
  frame(
    app: app
    pointer: uiPointerScriptFrame(
      previous: app.input.pointer
      x: x
      y: y
      down: down
      kind: InputKind.mouse
    )
    listKeys: ListSelectionKeys {}
    keys: BrowserKeys {}
    text: emptyText()
    menuKeys: MenuKeys {}
  )
}

# A press at a place, moved a little: the drag has begun
func lift(app: mod App, x: view Float, y: view Float) {
  pointTo(
    app: app
    x: x
    y: y
    down: false
  )
  pointTo(
    app: app
    x: x
    y: y
    down: true
  )
  pointTo(
    app: app
    x: x + 4.0
    y: y + 5.0
    down: true
  )
  pointTo(
    app: app
    x: x + 6.0
    y: y + 7.0
    down: true
  )
}

# The drag to a place, in two frames
func carry(app: mod App, x: view Float, y: view Float) {
  pointTo(
    app: app
    x: x - 1.0
    y: y
    down: true
  )
  pointTo(
    app: app
    x: x
    y: y
    down: true
  )
}

func letGo(app: mod App) {
  pointTo(
    app: app
    x: app.input.pointer.x
    y: app.input.pointer.y
    down: false
  )
  settle(app: app)
}

func dragText(app: view App) ret String {
  let drag: view UiDrag = app.world.drag
  if drag.phase is not UiDragPhase.dragging {
    ret "no drag"
  }
  var mark: String = ""
  if isNone(this: app.files.dropRow) is false {
    mark = ", a row marked"
  } else if isNone(this: app.files.dropColumn) is false {
    mark = ", a column marked"
  }
  ret "drags \"{drag.payload.label}\" ({drag.payload.values.length}): {drag.effect}{mark}"
}

func secondaryAt(app: mod App, x: view Float, y: view Float) {
  var state: UiPointerState = uiPointerScriptFrame(
    previous: app.input.pointer
    x: x
    y: y
    down: false
    kind: InputKind.mouse
  )
  state.secondary = UiButtonState { down: true, pressed: true, released: false, clicks: 1 }
  frame(
    app: app
    pointer: state
    listKeys: ListSelectionKeys {}
    keys: BrowserKeys {}
    text: emptyText()
    menuKeys: MenuKeys {}
  )
  settle(app: app)
}

func fieldOf(app: view App) ret EntityId {
  ret componentView(this: app.files.browsers, entityId: app.left).searchField
}

# Letters typed, after letters erased; the search that follows comes to its end
func typeText(app: mod App, text: view String, erased: view Int) {
  frame(
    app: app
    pointer: still(app: app)
    listKeys: ListSelectionKeys {}
    keys: BrowserKeys {}
    text: TextInputFrame { typed: "{text}", backspaces: erased, enter: false, tapped: false }
    menuKeys: MenuKeys {}
  )
  settle(app: app)
}

func typeEnter(app: mod App) {
  frame(
    app: app
    pointer: still(app: app)
    listKeys: ListSelectionKeys {}
    keys: BrowserKeys {}
    text: TextInputFrame { typed: "", backspaces: 0, enter: true, tapped: false }
    menuKeys: MenuKeys {}
  )
  settle(app: app)
}

func menuText(app: view App) ret String {
  if app.world.menu.open is false {
    ret "none"
  }
  var text: String = ""
  loop let item: view MenuItem in app.world.menu.request.items {
    if item.separator {
      text = "{text} |"
    } else if item.enabled {
      text = "{text} {item.text},"
    } else {
      text = "{text} ({item.text}),"
    }
  }
  ret text
}

# Choose an item of the open menu by its keys: Down to it, then Return
func chooseItem(app: mod App, id: view String) {
  loop var i: Int = 0, i < 12, ++i {
    frame(
      app: app
      pointer: still(app: app)
      listKeys: ListSelectionKeys {}
      keys: BrowserKeys {}
      text: emptyText()
      menuKeys: MenuKeys { down: true }
    )
    var focused: String = ""
    if let item: view MenuItem = app.world.menu.request.items.viewAt(
      index: menuItemIndex(world: app.world, level: 0, row: menuFocusOf(world: app.world, level: 0))
    ) {
      focused = "{item.id}"
    }
    if focused is id {
      # the same Return is the list's, if it were not the menu's
      frame(
        app: app
        pointer: still(app: app)
        listKeys: ListSelectionKeys { choose: true }
        keys: BrowserKeys { confirm: true }
        text: emptyText()
        menuKeys: MenuKeys { choose: true }
      )
      settle(app: app)
      ret
    }
  }
  log("no item {id}")
}

# What fileBrowserState keeps for the next time
func recentText(app: view App) ret String {
  let state: FileBrowserState = fileBrowserState(
    systems: app.files
    world: app.world
    browser: app.left
  )
  var text: String = "at {Files.nameOf(path: state.folder)};"
  loop let folder: view String in state.recent {
    text = "{text} {Files.nameOf(path: folder)}"
  }
  ret text
}
