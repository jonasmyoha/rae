# The physics port's triangle meshes (P5b: lib/physics/geometry/Mesh,
# MeshQuery) against Box3D itself: every line of tools/box3d-oracle/goldens/
# mesh.golden is one call of mesh.c — b3CreateMesh (welding, the BVH with
# the binned SAH, median and half splits, the depth-first triangle order,
# the edge flags) on generated meshes and triangle soups, b3GetHeight,
# b3QueryMesh with mirrored and non-uniform scales and b3ComputeMeshAABB —
# with its inputs and the whole mesh as exact hex floats, written by Box3D's
# own C build. Every value must have the SAME BITS
# (docs/physics-rae-port-design.md §4).
import Vec3
import Quat
open physics/math/Scalar
open physics/math/VectorMath
open physics/math/TransformMath
open physics/math/AabbMath
open physics/geometry/Mesh
open physics/geometry/MeshQuery

type Reader {
  values: List(Float)
  next: Int
}

func readFloat(reader: mod Reader) ret Float {
  let value: Float = reader.values.copyAtDefault(index: reader.next)
  reader.next = reader.next + 1
  ret value
}

func readInt(reader: mod Reader) ret Int {
  ret readFloat(reader: reader).toInt()
}

func readVec(reader: mod Reader) ret Vec3 {
  let x: Float = readFloat(reader: reader)
  let y: Float = readFloat(reader: reader)
  let z: Float = readFloat(reader: reader)
  ret Vec3 { x: x, y: y, z: z }
}

func readTransform(reader: mod Reader) ret Transform {
  let position: Vec3 = readVec(reader: reader)
  let x: Float = readFloat(reader: reader)
  let y: Float = readFloat(reader: reader)
  let z: Float = readFloat(reader: reader)
  let w: Float = readFloat(reader: reader)
  ret Transform { position: position, rotation: Quat { x: x, y: y, z: z, w: w } }
}

func readBool(reader: mod Reader) ret Bool {
  ret readInt(reader: reader) is not 0
}

func readBox(reader: mod Reader) ret Aabb {
  let lowerBound: Vec3 = readVec(reader: reader)
  let upperBound: Vec3 = readVec(reader: reader)
  ret Aabb { lowerBound: lowerBound, upperBound: upperBound }
}

func putFloat(out: mod List(Float), value: view Float) {
  out.add(value: value)
}

func putInt(out: mod List(Float), value: view Int) {
  out.add(value: value.toFloat())
}

func putVec(out: mod List(Float), vector: view Vec3) {
  out.add(value: vector.x)
  out.add(value: vector.y)
  out.add(value: vector.z)
}

func putBox(out: mod List(Float), box: view Aabb) {
  putVec(out: out, vector: box.lowerBound)
  putVec(out: out, vector: box.upperBound)
}

# The mesh the query and AABB lines apply to: the one built last.
type MeshState {
  mesh: opt PhysicsMeshData
}

# The driver's meshOut, of the mesh built last.
func putMesh(out: mod List(Float), state: view MeshState) {
  if let data: view PhysicsMeshData => state.mesh {
    putInt(out: out, value: 1)
    putBox(out: out, box: data.bounds)
    putFloat(out: out, value: data.surfaceArea)
    putInt(out: out, value: data.treeHeight)
    putInt(out: out, value: data.degenerateCount)
    putInt(out: out, value: data.materialCount)
    putInt(out: out, value: data.nodes.length)
    loop let node: view MeshNode in data.nodes {
      putVec(out: out, vector: node.lowerBound)
      putVec(out: out, vector: node.upperBound)
      putInt(out: out, value: node.kind)
      putInt(out: out, value: node.count)
      putInt(out: out, value: node.triangleOffset)
    }
    putInt(out: out, value: data.vertices.length)
    loop let vertex: view Vec3 in data.vertices {
      putVec(out: out, vector: vertex)
    }
    putInt(out: out, value: data.triangles.length)
    loop var k: Int = 0, k < data.triangles.length, ++k {
      let triangle: MeshTriangle = data.triangles.copyAtDefault(index: k)
      putInt(out: out, value: triangle.index1)
      putInt(out: out, value: triangle.index2)
      putInt(out: out, value: triangle.index3)
      putInt(out: out, value: data.materialIndices.copyAtDefault(index: k))
      putInt(out: out, value: data.flags.copyAtDefault(index: k))
    }
    putInt(out: out, value: meshHeight(data: data))
  } else {
    putInt(out: out, value: 0)
  }
}

func readMeshDef(reader: mod Reader) ret MeshDef {
  var def: MeshDef = emptyMeshDef()
  let vertexCount: Int = readInt(reader: reader)
  loop var k: Int = 0, k < vertexCount, ++k {
    def.vertices.add(value: readVec(reader: reader))
  }
  let triangleCount: Int = readInt(reader: reader)
  loop var k: Int = 0, k < 3 * triangleCount, ++k {
    def.indices.add(value: readInt(reader: reader))
  }
  if readBool(reader: reader) {
    loop var k: Int = 0, k < triangleCount, ++k {
      def.materialIndices.add(value: readInt(reader: reader))
    }
  }
  def.weldTolerance = readFloat(reader: reader)
  def.weldVertices = readBool(reader: reader)
  def.useMedianSplit = readBool(reader: reader)
  def.identifyEdges = readBool(reader: reader)
  def.clockWiseWinding = readBool(reader: reader)
  ret def
}

# False: not a function of this golden.
func evaluate(
  name: view String
  reader: mod Reader
  out: mod List(Float)
  state: mod MeshState
) ret Bool {
  let units: Float = 1.0
  var builds: Bool = true
  if name is "b3CreateGridMesh" {
    let xCount: Int = readInt(reader: reader)
    let zCount: Int = readInt(reader: reader)
    let cellWidth: Float = readFloat(reader: reader)
    let materialCount: Int = readInt(reader: reader)
    state.mesh = createGridMesh(
      xCount: xCount
      zCount: zCount
      cellWidth: cellWidth
      materialCount: materialCount
      identifyEdges: readBool(reader: reader)
      lengthUnitsPerMeter: units
    )
  } else if name is "b3CreateBoxMesh" {
    let center: Vec3 = readVec(reader: reader)
    let extent: Vec3 = readVec(reader: reader)
    state.mesh = createBoxMesh(
      center: center
      extent: extent
      identifyEdges: readBool(reader: reader)
      lengthUnitsPerMeter: units
    )
  } else if name is "b3CreateHollowBoxMesh" {
    let center: Vec3 = readVec(reader: reader)
    state.mesh = createHollowBoxMesh(
      center: center
      extent: readVec(reader: reader)
      lengthUnitsPerMeter: units
    )
  } else if name is "b3CreatePlatformMesh" {
    let center: Vec3 = readVec(reader: reader)
    let height: Float = readFloat(reader: reader)
    let topWidth: Float = readFloat(reader: reader)
    state.mesh = createPlatformMesh(
      center: center
      height: height
      topWidth: topWidth
      bottomWidth: readFloat(reader: reader)
      lengthUnitsPerMeter: units
    )
  } else if name is "b3CreateMesh" {
    let def: MeshDef = readMeshDef(reader: reader)
    state.mesh = createMesh(def: def, lengthUnitsPerMeter: units)
  } else {
    builds = false
  }
  if builds {
    # Assigned straight from the call: a local `opt` copied into the field
    # is the compiler bug queued with this fixture.
    putMesh(out: out, state: state)
    ret true
  }

  if let data: view PhysicsMeshData => state.mesh {
    if name is "b3QueryMesh" {
      let meshScale: Vec3 = readVec(reader: reader)
      let bounds: Aabb = readBox(reader: reader)
      let mesh: Mesh = { data: data, scale: meshScale }
      let found: List(MeshQueryTriangle) = queryMesh(mesh: mesh, bounds: bounds, capacity: 1000000)
      putInt(out: out, value: found.length)
      loop let triangle: view MeshQueryTriangle in found {
        putVec(out: out, vector: triangle.a)
        putVec(out: out, vector: triangle.b)
        putVec(out: out, vector: triangle.c)
        putInt(out: out, value: triangle.triangleIndex)
      }
      ret true
    }
    if name is "b3ComputeMeshAABB" {
      let transform: Transform = readTransform(reader: reader)
      putBox(
        out: out
        box: computeMeshAabb(data: data, transform: transform, scale: readVec(reader: reader))
      )
      ret true
    }
  }
  ret false
}

# The same bits: NaN matches NaN, and a zero matches only a zero of its sign.
func sameBits(actual: view Float, expected: view Float) ret Bool {
  if actual is not actual {
    ret expected is not expected
  }
  if actual is not expected {
    ret false
  }
  if actual is 0.0 {
    ret 1.0 / actual is 1.0 / expected
  }
  ret true
}

func readGolden() ret String {
  # The runner runs from compiler/, the TSan gate from the case's folder.
  let candidates: List(String) = {
    "../tools/box3d-oracle/goldens/mesh.golden"
    "../../../tools/box3d-oracle/goldens/mesh.golden"
    "tools/box3d-oracle/goldens/mesh.golden"
  }
  loop var i: Int = 0, i < candidates.length, ++i {
    if let text: String = readFile(path: candidates.copyAtDefault(index: i)) {
      ret text
    }
  }
  ret ""
}

func main() {
  let golden: String = readGolden()
  let lines: List(String) = golden.split(sep: "\n")
  var calls: Int = 0
  var mismatches: Int = 0
  var unknown: Int = 0
  var state: MeshState = { mesh: none }
  let names: List(String) = List.create(String, cap: 8)
  loop var i: Int = 0, i < lines.length, ++i {
    let line: String = lines.copyAtDefault(index: i)
    if line.length() is 0 or line.startsWith(prefix: "#") {
      continue
    }
    let tokens: List(String) = line.split(sep: " ")
    let name: String = tokens.copyAtDefault(index: 0)
    var reader: Reader = { values: List.create(Float, cap: 128), next: 0 }
    let expected: List(Float) = List.create(Float, cap: 64)
    var afterArrow: Bool = false
    loop var j: Int = 1, j < tokens.length, ++j {
      let token: String = tokens.copyAtDefault(index: j)
      if token is "->" {
        afterArrow = true
      } else if afterArrow {
        expected.add(value: token.toFloat())
      } else {
        reader.values.add(value: token.toFloat())
      }
    }
    let actual: List(Float) = List.create(Float, cap: 64)
    if evaluate(
      name: name
      reader: reader
      out: actual
      state: state
    ) is false {
      unknown = unknown + 1
      log("not ported: {name}")
      continue
    }
    calls = calls + 1
    if names.contains(value: name) is false {
      names.add(value: name)
    }
    var same: Bool = actual.length is expected.length
    loop var j: Int = 0, j < expected.length and same, ++j {
      same = sameBits(
        actual: actual.copyAtDefault(index: j)
        expected: expected.copyAtDefault(index: j)
      )
    }
    if same is false {
      mismatches = mismatches + 1
      if mismatches <= 6 {
        log("MISMATCH line {i + 1}: {line.sub(start: 0, len: 200)}")
        var got: String = "  got"
        loop var j: Int = 0, j < actual.length and j < 40, ++j {
          got = "{got} {actual.copyAtDefault(index: j)}"
        }
        log(got)
        var want: String = "  want"
        loop var j: Int = 0, j < expected.length and j < 40, ++j {
          want = "{want} {expected.copyAtDefault(index: j)}"
        }
        log(want)
      }
    }
  }
  log(
    "mesh.golden: {calls} calls of {names.length} Box3D functions, {mismatches} not bit-exact, {unknown} not ported"
  )
}
