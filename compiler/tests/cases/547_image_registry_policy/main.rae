import core
import ImageRegistry
open ImageRegistry

func main() {
  var reg: ImageRegistry = createImageRegistry()

  let missingFailed0: Bool = isFailedPath(reg: reg, path: "missing-a.jpg")
  log("failed0={missingFailed0}")

  markFailedPath(reg: reg, path: "missing-a.jpg")
  markFailedPath(reg: reg, path: "missing-a.jpg")
  let missingFailed1: Bool = isFailedPath(reg: reg, path: "missing-a.jpg")
  log("failed1={missingFailed1}")

  let fired0: Bool = wasFired(reg: reg, path: "remote-a.jpg")
  log("fired0={fired0}")

  markFired(reg: reg, path: "remote-a.jpg")
  markFired(reg: reg, path: "remote-a.jpg")
  let fired1: Bool = wasFired(reg: reg, path: "remote-a.jpg")
  log("fired1={fired1}")

  markPending(reg: reg, key: "cover-a", path: "remote-a.jpg")
  let idx: Int = index(reg: reg, key: "cover-a")
  log("idx={idx} len={reg.items.length} rev={reg.revision}")
}
