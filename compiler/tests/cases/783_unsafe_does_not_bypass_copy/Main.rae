type NativeOwner {
  pointer: Ptr
}

func drop(this: mod NativeOwner) {
  unsafe {
    let pointer: Ptr = this.pointer
  }
}

func duplicate(this: view NativeOwner) ret NativeOwner {
  unsafe {
    let duplicateOwner: NativeOwner = this
    ret duplicateOwner
  }
}

func main() {
  log("unreachable")
}
