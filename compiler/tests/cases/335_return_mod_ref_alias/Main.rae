type Point {
  x: Int
}

func xMod(point: mod Point) ret mod Int {
  ret mod  point.x
}

func main() {
  let point: Point = { x: 1 }
  # positional arg call is ok
  let rx: mod Int => xMod(point)
  rx = 10
  # aliasing-friendly: direct access while rx exists is OK in Rae
  # expect 10
  log(point.x)
}
