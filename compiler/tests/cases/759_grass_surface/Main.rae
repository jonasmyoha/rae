# The grass compute shader is a DECLARED composition (docs/shaders-and-the-
# compiler.md): the lib default lists the compute bounds + noise + biome +
# bounded obstacle circles + the grass pass, and an
# app supplies its own surface as a composition of its own, set whole. The
# island size is no longer text in the shader — it is an `override` pair
# handed to the pipeline (WorldBiome.islandConstants). An app's surface may
# also bring data of its own (grassSetSurfaceField).
import GrassCompute
import WorldBiome

func main() ret Int {
  let standard: Shader = GrassCompute.defaultGrassComputeShader()
  log(standard.text.contains(sub: "override RAE_BIOME_ISLAND_RADIUS"))
  log(standard.text.contains(sub: "// --- lib/grass_compute.wgsl"))
  log(standard.text.contains(sub: "// --- lib/grass_obstacles.wgsl"))
  log(standard.sources.length() is 5)
  let constants: List(ShaderConstant) = WorldBiome.islandConstants()
  log(constants.length() is 2)
  var grassCompute: GrassCompute = GrassCompute.createGrassCompute()
  log(not grassCompute.computeShaderSet)
  GrassCompute.grassSetComputeShader(grass: grassCompute, shader: standard)
  log(grassCompute.computeShaderSet)
  log(grassCompute.computeShader.sources.length() is 5)
  # An app's own surface data: none by default; set, it is kept for the GPU
  # (bound at @binding(4)) and the pipeline is rebuilt
  log(grassCompute.surfaceField.length() is 0)
  grassCompute.made = true
  GrassCompute.grassSetSurfaceField(grass: grassCompute, values: [1.5, -2.0, 3.25])
  log(grassCompute.surfaceField.length() is 3)
  log(grassCompute.surfaceField.copyAtFallback(index: 1, fallback: 0.0) is -2.0)
  log(not grassCompute.made)
  ret 0
}
