# Server time (docs/server-benchmarks-design.md §9 G4) and lib/Time's dates in
# Rae (docs/runtime-c-audit.md row 6): one calendar routine for the HTTP Date
# header and formatTimestamp / formatDate, a nanosecond deadline wait and a
# fixed-rate ticker. Nothing here has an upper bound in time: how late a wait
# ends is checks/serverTime.
import Time

func main() {
  # Known instants, leap days included (2000 is a leap year, 2100 is not)
  log(Time.httpDate(epochSeconds: 0))
  log(Time.httpDate(epochSeconds: 784111777))
  log(Time.httpDate(epochSeconds: 951782400))
  log(Time.httpDate(epochSeconds: 1709251199))
  log(Time.httpDate(epochSeconds: 4107542399))
  log(Time.httpDate(epochSeconds: -1))
  log(Time.formatTimestamp(epochMs: 951868799000))
  log(Time.formatDate(epochMs: -1500))
  log(Time.formatTimestamp(epochMs: -62198755200000))
  let civil: CivilTime = Time.civilFromEpochSeconds(epochSeconds: 1791435032)
  log("civil: {civil.year}-{civil.month}-{civil.day} weekday {civil.weekday}")

  # The Date header is made once per second
  var cache: HttpDateCache = Time.createHttpDateCache()
  let first: Bool = Time.updateHttpDate(cache: cache, epochSeconds: 784111777)
  let same: Bool = Time.updateHttpDate(cache: cache, epochSeconds: 784111777)
  let next: Bool = Time.updateHttpDate(cache: cache, epochSeconds: 784111778)
  log("cache: first {first}, same second {same}, next second {next}: {cache.text}")

  # Deadlines: a wait is never early. waitUntil re-reads the clock and returns
  # only once the deadline has passed, so this holds on any machine. How late
  # it is depends on the machine, and is measured by checks/serverTime.
  var early: Bool = false
  loop var i: Int = 0, i < 15, ++i {
    let deadline: Int = nowNs() + 33000000
    Time.waitUntil(deadlineNs: deadline)
    if nowNs() < deadline {
      early = true
    }
  }
  log("deadline never early: {early is false}")

  # A 30 Hz tick: none comes before it is due, and 30 of them last at least 30
  # periods (from before the ticker was made; a slow machine makes it longer)
  let start: Int = nowNs()
  var ticker: Ticker = Time.createTicker(hertz: 30)
  let firstNs: Int = ticker.nextNs
  var tickEarly: Bool = false
  loop var i: Int = 0, i < 30, ++i {
    let due: Int = ticker.nextNs
    Time.tickerWait(ticker: ticker)
    if nowNs() < due {
      tickEarly = true
    }
  }
  log("tick never early: {tickEarly is false}")
  log("30 ticks last at least 30 periods: {nowNs() - start >= 30 * ticker.periodNs}")
  # They do not drift: the next one is due a whole number of periods after the
  # first, as many as were waited for or missed, however late each wait ended
  log("no drift: {ticker.nextNs is firstNs + (30 + ticker.missed) * ticker.periodNs}")
  # A frame that overran by three periods counts what it missed and keeps the
  # same grid; the next tick is in the future, so it does not race to catch up
  let missedBefore: Int = ticker.missed
  Time.waitUntil(deadlineNs: ticker.nextNs + 3 * ticker.periodNs)
  let late: Int = nowNs()
  Time.tickerWait(ticker: ticker)
  log("missed ticks counted: {ticker.missed - missedBefore >= 3}")
  log("next tick still to come: {ticker.nextNs > late}")
  log("no drift after it: {ticker.nextNs is firstNs + (31 + ticker.missed) * ticker.periodNs}")
}
