# Tile streaming with a primary center (app3d/TileStreaming streamTilesPrimary, TilePriority): a
# camera flying straight at 57 m/s among three other centers (a parked body and two bots), 40
# slots, tiles of 100 m loaded within 300 m and let go past 360 m. Round every center alike
# (streamTilesAround) the slots fill with the others' tiles and the camera's own wait; with the
# camera primary, no tile within 200 m of it (the load distance less a tile) is ever missing,
# and after a sharp turn the same holds again within a few seconds. A jump (a teleport) is no
# speed.
import Math
open ecs/Entity
open ecs/World
open app3d/TileStreaming

const frameSeconds: Float = 0.016666668

const speed: Float = 57.0

# The tiles within `reach` of (x, y) not loaded, and the nearest one's distance (-1: none)
type Missing {
  count: Int
  nearest: Float
}

func missingNear(
  streamer: view TileStreamer
  x: view Float
  y: view Float
  reach: view Float
) ret Missing {
  var missing: Missing = { count: 0, nearest: -1.0 }
  let loaded: List(GridTile) = streamedTiles(streamer: streamer)
  let settings: TileGridSettings = streamer.settings
  loop let tile: view GridTile in tilesToLoad(settings: settings, x: x, y: y) {
    let distance: Float = tileDistance(
      settings: settings
      tile: tile
      x: x
      y: y
    )
    if distance > reach {
      continue
    }
    var held: Bool = false
    loop let other: view GridTile in loaded {
      if sameTile(a: other, b: tile) {
        held = true
      }
    }
    if not held {
      missing.count = missing.count + 1
      if missing.nearest < 0.0 or distance < missing.nearest {
        missing.nearest = distance
      }
    }
  }
  ret missing
}

func settingsWith(primary: view Bool) ret TileGridSettings {
  ret TileGridSettings {
    tileSize: 100.0
    loadDistance: 300.0
    unloadDistance: 360.0
    slotCount: 40
    priority: TilePriority { primaryCenter: primary }
  }
}

# The camera first, then the parked body and two bots
func centersAt(x: view Float, y: view Float) ret List(TileCenter) {
  ret List(TileCenter) {
    TileCenter { x: x, y: y }
    TileCenter { x: 0.0, y: 0.0 }
    TileCenter { x: 0.0, y: 450.0 }
    TileCenter { x: 350.0, y: -350.0 }
  }
}

func step(
  streamer: mod TileStreamer
  allocator: mod EntityAllocator
  x: view Float
  y: view Float
) {
  streamTilesPrimary(
    streamer: streamer
    allocator: allocator
    centers: centersAt(x: x, y: y)
    deltaTime: frameSeconds
  )
}

# A flight of `seconds` from the origin along +x, then (when `turnSeconds` > 0) along +y: the
# most tiles missing within 200 m on any frame after the first 2 s, the nearest such tile, and
# after the turn the last frame anything was missing (s after the turn)
func fly(primary: view Bool, seconds: view Float, turnSeconds: view Float) {
  var streamer: TileStreamer = createTileStreamer(settings: settingsWith(primary: primary))
  var allocator: EntityAllocator = createEntityAllocator()
  # parked at the start until every slot settles
  loop var i: Int = 0, i < 120, ++i {
    step(
      streamer: streamer
      allocator: allocator
      x: 0.0
      y: 0.0
    )
  }
  var x: Float = 0.0
  var y: Float = 0.0
  var most: Int = 0
  var nearest: Float = -1.0
  var lastMissingAfterTurn: Float = -1.0
  var mostAfterTurn: Int = 0
  let frames: Int = ((seconds + turnSeconds) / frameSeconds).toInt()
  loop var frame: Int = 0, frame < frames, ++frame {
    let time: Float = frame.toFloat() * frameSeconds
    if time < seconds {
      x = x + speed * frameSeconds
    } else {
      y = y + speed * frameSeconds
    }
    step(
      streamer: streamer
      allocator: allocator
      x: x
      y: y
    )
    let missing: Missing = missingNear(
      streamer: streamer
      x: x
      y: y
      reach: 200.0
    )
    if time >= seconds {
      if missing.count > 0 {
        lastMissingAfterTurn = time - seconds
        mostAfterTurn = Math.max(a: mostAfterTurn, b: missing.count)
      }
    } else if time >= 2.0 and missing.count > 0 {
      most = Math.max(a: most, b: missing.count)
      if nearest < 0.0 or missing.nearest < nearest {
        nearest = missing.nearest
      }
    }
  }
  var rule: String = "every center alike"
  if primary {
    rule = "the camera primary"
  }
  log(
    "{rule}, {seconds.toInt()} s straight: at most {most} tiles within 200 m missing on a frame, the nearest at {Math.round(
      x: nearest
    )} m (-1: none); slots used {usedTileSlots(streamer: streamer)} of 40, swaps {streamer.evictions}"
  )
  if turnSeconds > 0.0 {
    log(
      "  then a sharp turn (+x to +y) for {turnSeconds.toInt()} s: at most {mostAfterTurn} missing, the last of them {Math.round(
        x: lastMissingAfterTurn * 10.0
      ) / 10.0} s after the turn (-1: none)"
    )
  }
}

func main() {
  fly(primary: false, seconds: 30.0, turnSeconds: 0.0)
  fly(primary: true, seconds: 30.0, turnSeconds: 10.0)
  let priority: TilePriority = { primaryCenter: true }
  let moving: TileCenter = primaryVelocityAfter(
    priority: priority
    velocity: TileCenter { x: 57.0, y: 0.0 }
    last: TileCenter { x: 0.0, y: 0.0 }
    now: TileCenter { x: 0.95, y: 0.0 }
    deltaTime: frameSeconds
  )
  let jumped: TileCenter = primaryVelocityAfter(
    priority: priority
    velocity: moving
    last: TileCenter { x: 0.0, y: 0.0 }
    now: TileCenter { x: 5000.0, y: 0.0 }
    deltaTime: frameSeconds
  )
  let lead: TileCenter = primaryLeadPoint(
    priority: priority
    primary: TileCenter { x: 0.0, y: 0.0 }
    velocity: moving
  )
  log(
    "speed after a move of 0.95 m in a frame: {Math.round(x: moving.x)} m/s, lead point {Math.round(
      x: lead.x
    )} m ahead; after a jump of 5 km: {jumped.x} m/s"
  )
}
