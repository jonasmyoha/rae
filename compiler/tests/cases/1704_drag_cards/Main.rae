# Drags a game can use for its cards (ui/DragSystem, DragSource): a source's own start distance
# (12 points: a move of 8 is no drag, 14 is), a finger with no hold time dragging at once (where a
# finger on a source with the default 0.4 s scrolls), a source node that follows the pointer itself
# (its offset kept, raised into the hud layer, put back at the end, no label), and the release
# velocity on the drop and on a cancel (points per second over the last 0.1 s: 10 points a 0.05 s
# frame is 200).
import Gpu2d
import Math
open ecs/ComponentTable
open ecs/Entity
open ecs/Event
open ui/BindingComponents
open ui/Components
open ui/DragComponents
open ui/DragSystem
open ui/Ecs
open ui/InputKind
open ui/InputSystem
open ui/LayerCapture
open ui/LayerHit
open ui/LayoutSystem
open ui/MenuComponents
open ui/MenuSystem
open ui/Scene
open ui/SceneInstance
open ui/SceneLoader
open ui/ScrollRootSystem
open ui/Transform
open ui/UiSystems

type App {
  world: UiWorld
  uiSystems: UiSystems
  input: UiInput
  # what a `begin` is answered with, and what the program says at a target
  starts: Bool = true
  mayMove: Bool = true
  mayCopy: Bool = true
  refuses: Bool = false
  values: Int = 1
}

func nodeOf(world: view UiWorld, nodeId: view String) ret EntityId {
  if let raw: Int = findNodeInPage(world: world, pageId: "p", nodeId: nodeId) {
    ret nodeEntityId(world: world, index: raw)
  }
  ret noEntity()
}

func nameOf(world: view UiWorld, entityId: view EntityId) ret String {
  if componentHas(this: world.sceneSources, entityId: entityId) {
    ret "{componentView(this: world.sceneSources, entityId: entityId).nodeId}"
  }
  ret "none"
}

func frame(
  app: mod App
  step: view String
  pointer: view UiPointerState
  keys: view DragKeys
  osDrop: view OsDrop
) {
  app.input.nowSeconds = app.input.nowSeconds + 0.05
  updateUiInputWith(
    input: app.input
    world: app.world
    uiSystems: app.uiSystems
    pointer: pointer
    wheel: 0.0
  )
  var text: String = ""
  loop var i: Int = 0, i < eventCount(UiAction, this: app.world.uiActions), ++i {
    text = "{text} action {eventAt(UiAction, this: app.world.uiActions, i: i).actionId}"
  }
  let changed: Bool = dragSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: keys
    osDrop: osDrop
  )
  var begins: Bool = false
  loop var i: Int = 0, i < eventCount(DragEvent, this: app.world.dragEvents), ++i {
    let event: DragEvent = eventAt(DragEvent, this: app.world.dragEvents, i: i)
    text = "{text} {event.kind}"
    if event.kind is DragEventKind.begin {
      begins = true
      text = "{text} of {nameOf(world: app.world, entityId: event.source)}"
    } else if event.kind is not DragEventKind.canceled {
      text = "{text} {nameOf(world: app.world, entityId: event.target)}"
    }
    if event.kind is DragEventKind.drop or event.kind is DragEventKind.canceled {
      text = "{text} at {Math.round(x: event.velocityX)},{Math.round(x: event.velocityY)} points a second"
    }
  }
  if begins and app.starts {
    var payload: UiDragPayload = {
      kind: "cards"
      label: "A card"
      icon: "mat:image"
      mayMove: app.mayMove
      mayCopy: app.mayCopy
      source: app.world.drag.source
    }
    loop var i: Int = 0, i < app.values, ++i {
      payload.values.add(value: "card {i}")
    }
    startDrag(
      world: app.world
      uiSystems: app.uiSystems
      input: app.input
      payload: own payload
    )
  }
  if app.refuses and dragRunning(world: app.world) {
    setDragEffect(world: app.world, effect: DragEffect.refused)
  }
  let scrolled: Bool = updateScrollRoots(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    deltaTime: 0.05
  )
  layoutSystem(world: app.world, uiSystems: app.uiSystems)
  transformSystem(world: app.world, uiSystems: app.uiSystems)
  if step.length() > 0 {
    var effect: String = ""
    if dragRunning(world: app.world) {
      effect = " [{app.world.drag.effect}, {markOf(app: app)}]"
    }
    log("{step}:{text}{effect}")
  }
  releaseDeadEntities(world: app.world, uiSystems: app.uiSystems)
}

# The label's place from the pointer, in whole points
func labelAt(app: view App) ret String {
  let label: EntityId = app.world.drag.label
  if componentHas(this: app.uiSystems.transform2d.worldTransforms, entityId: label) is false {
    ret "none"
  }
  let at: Vec2 = componentView(this: app.uiSystems.transform2d.worldTransforms, entityId: label).position
  ret "{Math.round(x: at.x - app.world.drag.x)} {Math.round(x: at.y - app.world.drag.y)}, left {at.x < app.world.drag.x}"
}

# The label's mark
func markOf(app: view App) ret String {
  let label: EntityId = app.world.drag.label
  if isNone(this: label) or componentHas(this: app.world.childrens, entityId: label) is false {
    ret "no label"
  }
  let children: view Children = componentView(this: app.world.childrens, entityId: label)
  let mark: EntityId = children.ids.copyAtFallback(
    index: children.ids.length - 1
    fallback: noEntity()
  )
  ret "{componentView(this: app.world.sprites, entityId: mark).textureKey}"
}

func point(
  app: mod App
  step: view String
  x: view Float
  y: view Float
  down: view Bool
) {
  frame(
    app: app
    step: step
    pointer: uiPointerScriptFrame(
      previous: app.input.pointer
      x: x
      y: y
      down: down
      kind: InputKind.mouse
    )
    keys: DragKeys {}
    osDrop: OsDrop {}
  )
}

func finger(
  app: mod App
  step: view String
  x: view Float
  y: view Float
  down: view Bool
) {
  frame(
    app: app
    step: step
    pointer: uiPointerScriptFrame(
      previous: app.input.pointer
      x: x
      y: y
      down: down
      kind: InputKind.touch
    )
    keys: DragKeys {}
    osDrop: OsDrop {}
  )
}

func withKeys(app: mod App, step: view String, keys: view DragKeys) {
  frame(
    app: app
    step: step
    pointer: uiPointerScriptFrame(
      previous: app.input.pointer
      x: app.input.pointer.x
      y: app.input.pointer.y
      down: true
      kind: InputKind.mouse
    )
    keys: keys
    osDrop: OsDrop {}
  )
}

func fromOs(app: mod App, step: view String, osDrop: view OsDrop) {
  frame(
    app: app
    step: step
    pointer: uiPointerScriptFrame(
      previous: app.input.pointer
      x: 5.0
      y: 395.0
      down: false
      kind: InputKind.mouse
    )
    keys: DragKeys {}
    osDrop: osDrop
  )
}

# A press on the card, moved: dragged
func lift(app: mod App, x: view Float, y: view Float) {
  point(
    app: app
    step: ""
    x: x
    y: y
    down: false
  )
  point(
    app: app
    step: ""
    x: x
    y: y
    down: true
  )
  point(
    app: app
    step: ""
    x: x + 8.0
    y: y
    down: true
  )
}

func sceneText() ret String {
  ret r#"{
    "type": "Scene",
    "version": 2,
    "sceneId": "table",
    "root": "Window",
    "nodes": {
      "Window": { "Rect": { "x": 0, "y": 0, "w": 600, "h": 400 }, "Children": ["Plain", "Far", "Quick", "Held", "Card", "Table"] },
      "Plain": { "Rect": { "x": 10, "y": 10, "w": 80, "h": 60 }, "DragSource": { "kind": "cards" } },
      "Far": { "Rect": { "x": 110, "y": 10, "w": 80, "h": 60 }, "DragSource": { "kind": "cards", "startPoints": 12 } },
      "Quick": { "Rect": { "x": 210, "y": 10, "w": 80, "h": 60 }, "DragSource": { "kind": "cards", "touch": true, "holdSeconds": 0 } },
      "Held": { "Rect": { "x": 310, "y": 10, "w": 80, "h": 60 }, "DragSource": { "kind": "cards", "touch": true } },
      "Card": { "Rect": { "x": 10, "y": 300, "w": 60, "h": 90 }, "DragSource": { "kind": "cards", "touch": true, "holdSeconds": 0, "follow": true, "followLayer": "hud" } },
      "Table": { "Rect": { "x": 200, "y": 150, "w": 300, "h": 200 }, "DropTarget": { "kinds": "cards" } }
    }
  }"#
}

# Where the node is drawn, its layer, and whether a label is shown
func placeOf(app: view App, nodeId: view String) ret String {
  let entityId: EntityId = nodeOf(world: app.world, nodeId: nodeId)
  let at: Vec2 = componentView(this: app.uiSystems.transform2d.worldTransforms, entityId: entityId).position
  var layer: String = "none"
  if componentHas(this: app.world.layerTags, entityId: entityId) {
    layer = "{componentView(this: app.world.layerTags, entityId: entityId).id}"
  }
  ret "{nodeId} at {Math.round(x: at.x)},{Math.round(x: at.y)}, layer {layer}, label {isNone(
    this: app.world.drag.label
  ) is false}"
}

func main() {
  let scene: Scene = parseScene(source: sceneText())
  var app: App = { world: createUiWorld(), uiSystems: createUiSystems(), input: createUiInput() }
  app.input.nowSeconds = 100.0
  app.world.layoutW = 600.0
  app.world.layoutH = 400.0
  let root: EntityId = loadSceneIntoPage(
    world: app.world
    uiSystems: app.uiSystems
    scene: scene
    pageId: "p"
  )
  layoutSystem(world: app.world, uiSystems: app.uiSystems)
  transformSystem(world: app.world, uiSystems: app.uiSystems)
  log("-- the start distance")
  point(
    app: app
    step: ""
    x: 50.0
    y: 40.0
    down: false
  )
  point(
    app: app
    step: "press Plain"
    x: 50.0
    y: 40.0
    down: true
  )
  point(
    app: app
    step: "Plain moved 8"
    x: 58.0
    y: 40.0
    down: true
  )
  point(
    app: app
    step: "let go"
    x: 58.0
    y: 40.0
    down: false
  )
  point(
    app: app
    step: "press Far"
    x: 150.0
    y: 40.0
    down: true
  )
  point(
    app: app
    step: "Far moved 8"
    x: 158.0
    y: 40.0
    down: true
  )
  point(
    app: app
    step: "Far moved 14"
    x: 164.0
    y: 40.0
    down: true
  )
  point(
    app: app
    step: "let go"
    x: 164.0
    y: 40.0
    down: false
  )
  log("-- a finger")
  finger(
    app: app
    step: ""
    x: 350.0
    y: 40.0
    down: false
  )
  finger(
    app: app
    step: "press Held"
    x: 350.0
    y: 40.0
    down: true
  )
  finger(
    app: app
    step: "Held moved 10 at once"
    x: 360.0
    y: 40.0
    down: true
  )
  finger(
    app: app
    step: "lift"
    x: 360.0
    y: 40.0
    down: false
  )
  finger(
    app: app
    step: "press Quick"
    x: 250.0
    y: 40.0
    down: true
  )
  finger(
    app: app
    step: "Quick moved 10 at once"
    x: 260.0
    y: 40.0
    down: true
  )
  finger(
    app: app
    step: "lift"
    x: 260.0
    y: 40.0
    down: false
  )
  log("-- a card that follows the finger, and the release velocity")
  log(placeOf(app: app, nodeId: "Card"))
  finger(
    app: app
    step: "press the card"
    x: 40.0
    y: 345.0
    down: true
  )
  finger(
    app: app
    step: "moved 10"
    x: 50.0
    y: 345.0
    down: true
  )
  log(placeOf(app: app, nodeId: "Card"))
  loop var i: Int = 1, i <= 20, ++i {
    finger(
      app: app
      step: ""
      x: 50.0 + 10.0 * i.toFloat()
      y: 345.0 - 5.0 * i.toFloat()
      down: true
    )
  }
  log(placeOf(app: app, nodeId: "Card"))
  finger(
    app: app
    step: "let go on the table, still moving"
    x: 260.0
    y: 240.0
    down: false
  )
  log(placeOf(app: app, nodeId: "Card"))
  log("-- canceled, at rest")
  finger(
    app: app
    step: "press the card"
    x: 40.0
    y: 345.0
    down: true
  )
  finger(
    app: app
    step: "moved 10"
    x: 50.0
    y: 345.0
    down: true
  )
  loop var i: Int = 0, i < 4, ++i {
    finger(
      app: app
      step: ""
      x: 50.0
      y: 345.0
      down: true
    )
  }
  finger(
    app: app
    step: "let go where nothing takes it"
    x: 50.0
    y: 345.0
    down: false
  )
  log(placeOf(app: app, nodeId: "Card"))
}
