# The prop field (lib/app3d/PropField.rae) without a GPU: its cells, its view
# test, which level of detail a distance picks, and what one gather puts in
# its batches. Drawing needs a window; an app's screenshots cover it.
import Vec3
open Scene3d
open GbufferInstanced
open app3d/PropField

func check(label: view String, ok: view Bool) {
  if ok {
    log("ok   {label}")
  } else {
    log("FAIL {label}")
  }
}

func paint() ret Material3d {
  ret Material3d {
    baseColor: Vec3.create(x: 0.3, y: 0.5, z: 0.2)
    metallic: 0.0
    roughness: 1.0
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: false
  }
}

func part(id: view Int) ret PropPart {
  ret PropPart { mesh: MeshHandle { id: id, generation: 0 }, material: paint() }
}

func batchCount(field: view PropField, index: view Int) ret Int {
  if let batch: view InstanceBatch = field.batches.viewAt(index: index) {
    ret batch.count
  }
  ret 0 - 1
}

func main() ret Int {
  var field: PropField = createPropField(
    originX: -50.0
    originY: -50.0
    size: 100.0
    cellSize: 10.0
  )
  # A tree: near, its wood and leaves with shadows to 30 m; then its leaves
  # alone to 80 m. A card: one quad, facing the eye, to 40 m. The whole kind is
  # one nested literal — a list literal (the parts) inside a list literal (the
  # levels) inside the struct the call takes — and its List(PropLod) /
  # List(PropPart) functions are generated even though nothing else in the
  # program names those lists (#31175069).
  let tree: Int = addPropKind(
    field: field
    kind: {
      lods: {
        { parts: { part(id: 1), part(id: 2) }, maxDistance: 30.0, castsShadow: true, facesCamera: false }
        { parts: { part(id: 3) }, maxDistance: 80.0, castsShadow: false, facesCamera: false }
      }
      radius: 2.0
      centerHeight: 2.0
    }
  )
  let card: Int = addPropKind(
    field: field
    kind: {
      lods: { { parts: { part(id: 4) }, maxDistance: 40.0, castsShadow: false, facesCamera: true } }
      radius: 1.0
      centerHeight: 1.0
    }
  )
  let foot: Float = 0.0
  # Near ahead, far ahead, behind, beside, past the field's edge; a card ahead
  addPropPlacement(
    field: field
    placement: { kind: tree, position: Vec3.create(x: 0.0, y: 10.0, z: foot), yaw: 0.0, scale: 1.0 }
  )
  addPropPlacement(
    field: field
    placement: { kind: tree, position: Vec3.create(x: 0.0, y: 40.0, z: foot), yaw: 0.0, scale: 1.0 }
  )
  addPropPlacement(
    field: field
    placement: {
      kind: tree
      position: Vec3.create(x: 0.0, y: -25.0, z: foot)
      yaw: 0.0
      scale: 1.0
    }
  )
  addPropPlacement(
    field: field
    placement: {
      kind: tree
      position: Vec3.create(x: 40.0, y: -4.0, z: foot)
      yaw: 0.0
      scale: 1.0
    }
  )
  addPropPlacement(
    field: field
    placement: {
      kind: tree
      position: Vec3.create(x: 0.0, y: 120.0, z: foot)
      yaw: 0.0
      scale: 1.0
    }
  )
  addPropPlacement(
    field: field
    placement: { kind: card, position: Vec3.create(x: 3.0, y: 12.0, z: foot), yaw: 0.0, scale: 1.0 }
  )
  finishPropField(field: field)
  check(
    label: "a point past the field's edge goes to its edge cell"
    ok: propCellOf(field: field, x: 0.0, y: 120.0) is propCellOf(field: field, x: 0.0, y: 49.0)
  )
  check(label: "the draw distance is the farthest level's", ok: field.drawDistance is 80.0)
  check(label: "one batch per kind, level and part (3 + 1)", ok: field.batches.length is 4)
  check(
    label: "only the near level's batches cast shadows"
    ok: field.batchCastsShadow.copyAtFallback(index: 0, fallback: false) and field.batchCastsShadow.copyAtFallback(
      index: 1
      fallback: false
    ) and field.batchCastsShadow.copyAtFallback(index: 2, fallback: true) is false
  )
  let treeKind: PropKind = field.kinds.copyAtDefault(index: tree)
  check(label: "15 m away: the near level", ok: propLodAt(kind: treeKind, distance: 15.0) is 0)
  check(label: "45 m away: the far level", ok: propLodAt(kind: treeKind, distance: 45.0) is 1)
  check(label: "past 80 m: not drawn", ok: propLodAt(kind: treeKind, distance: 90.0) is none)
  # The eye 5 m behind the origin, 1.7 m up, looking down +y
  let camera: Camera3d = {
    position: Vec3.create(x: 0.0, y: -5.0, z: 1.7)
    target: Vec3.create(x: 0.0, y: 5.0, z: 1.7)
    fovYDeg: 50.0
    nearZ: 0.1
    farZ: 500.0
  }
  let propView: PropView = propViewOf(camera: camera, aspect: 1.6)
  check(
    label: "a sphere straight ahead is in view"
    ok: propSphereInView(
      propView: propView
      center: Vec3.create(x: 0.0, y: 20.0, z: 1.7)
      radius: 1.0
    )
  )
  check(
    label: "one behind the eye is not"
    ok: propSphereInView(
      propView: propView
      center: Vec3.create(x: 0.0, y: -25.0, z: 1.7)
      radius: 1.0
    ) is false
  )
  check(
    label: "one the eye is inside is"
    ok: propSphereInView(
      propView: propView
      center: Vec3.create(x: 0.0, y: -5.0, z: 2.0)
      radius: 1.0
    )
  )
  gatherPropField(field: field, propView: propView, toon: true)
  check(
    label: "the gather draws the near tree, the far tree and the card ({field.visibleCount})"
    ok: field.visibleCount is 3
  )
  check(
    label: "the near tree in both near batches"
    ok: batchCount(field: field, index: 0) is 1 and batchCount(field: field, index: 1) is 1
  )
  check(label: "the far tree in the far batch", ok: batchCount(field: field, index: 2) is 1)
  check(label: "the card in its batch", ok: batchCount(field: field, index: 3) is 1)
  check(
    label: "not every cell is looked into ({field.cellsVisited} of {field.columns * field.rows})"
    ok: field.cellsVisited > 0 and field.cellsVisited < 20
  )
  # A second gather from far away draws nothing, and empties the batches
  let away: Camera3d = {
    position: Vec3.create(x: -45.0, y: -45.0, z: 300.0)
    target: Vec3.create(x: -45.0, y: -40.0, z: 300.0)
    fovYDeg: 50.0
    nearZ: 0.1
    farZ: 500.0
  }
  gatherPropField(field: field, propView: propViewOf(camera: away, aspect: 1.6), toon: true)
  check(
    label: "from far away nothing is drawn"
    ok: field.visibleCount is 0 and batchCount(field: field, index: 0) is 0
  )
  # A batch limit caps every batch's size, however many props a kind has
  var limited: PropField = createPropField(
    originX: -50.0
    originY: -50.0
    size: 100.0
    cellSize: 10.0
  )
  limited.batchLimit = 2
  let bush: Int = addPropKind(
    field: limited
    kind: {
      lods: {
        { parts: { part(id: 5) }, maxDistance: 40.0, castsShadow: false, facesCamera: false }
      }
      radius: 1.0
      centerHeight: 0.5
    }
  )
  loop var i: Int = 0, i < 5, ++i {
    addPropPlacement(
      field: limited
      placement: {
        kind: bush
        position: Vec3.create(x: i.toFloat() * 2.0, y: 10.0, z: foot)
        yaw: 0.0
        scale: 1.0
      }
    )
  }
  finishPropField(field: limited)
  var capacity: Int = 0
  if let batch: view InstanceBatch = limited.batches.viewAt(index: 0) {
    capacity = batch.capacity
  }
  check(
    label: "the batch limit caps a batch at 2 of the kind's 5 props ({capacity})"
    ok: capacity is 2
  )
  # A sprite level: no parts, facing the camera — the prop becomes one
  # billboard in the field's sprite batch, its kind's picture layer in record
  # slot 39 and its world height (picture height times scale) in slot 36
  var billboards: PropField = createPropField(
    originX: -50.0
    originY: -50.0
    size: 100.0
    cellSize: 10.0
  )
  var spriteLods: List(PropLod) = List.create(PropLod, cap: 2)
  spriteLods.add(
    value: { parts: { part(id: 6) }, maxDistance: 20.0, castsShadow: true, facesCamera: false }
  )
  spriteLods.add(
    value: {
      parts: List.create(PropPart, cap: 0)
      maxDistance: 200.0
      castsShadow: false
      facesCamera: true
    }
  )
  let pine: Int = addPropKind(
    field: billboards
    kind: { lods: own spriteLods, radius: 2.0, centerHeight: 2.0 }
  )
  setPropKindSprite(
    field: billboards
    kind: pine
    layer: 3
    height: 5.0
  )
  addPropPlacement(
    field: billboards
    placement: { kind: pine, position: Vec3.create(x: 0.0, y: 60.0, z: foot), yaw: 0.0, scale: 2.0 }
  )
  finishPropField(field: billboards)
  gatherPropField(field: billboards, propView: propView, toon: true)
  let records: view List(Float) = billboards.spriteBatch.records
  check(
    label: "a far prop at a sprite level is one billboard, not meshes"
    ok: billboards.spriteBatch.count is 1 and batchCount(field: billboards, index: 0) is 0
  )
  check(
    label: "its record carries the picture layer (3) and height times scale (10)"
    ok: records.copyAtFallback(index: 39, fallback: 0.0) is 3.0 and records.copyAtFallback(
      index: 36
      fallback: 0.0
    ) is 10.0
  )
  ret 0
}
