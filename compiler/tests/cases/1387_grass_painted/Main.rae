# The painted grass shape: one opaque triangle a blade, its look all in its
# shading. Its paint field and palette live in lib/grass_field.wgsl, which both
# the grass compute pass and the grass render pass compose, so a ground shader
# can ask the same functions at a blade's root.
import GrassConfig
import Vec3
import GrassCompute

func main() ret Int {
  log(GrassConfig.grassVertexCount(shape: GrassConfig.GrassShape.painted as Int))
  log(GrassConfig.grassVertexCount(shape: GrassConfig.GrassShape.textured as Int))
  let standard: Shader = GrassCompute.defaultGrassComputeShader()
  log(standard.text.contains(sub: "fn grassPaintAt"))
  log(standard.text.contains(sub: "grassPaintColor(tipValue"))
  let render: Shader = shader(
    files: [
      "lib/grass_field.wgsl"
      "lib/grass_motion.wgsl"
      "lib/snow.wgsl"
      "lib/grass_render.wgsl"
    ]
  )
  log(render.text.contains(sub: "fn grassPaintColor"))
  # a ground painted as grass: the static surface paints a texel of alpha 0.75
  # with the same field and palette
  let groundShader: Shader = shader(files: [
    "lib/gbuffer_octahedral.wgsl"
    "lib/fade_dither.wgsl"
    "lib/wind.wgsl"
    "lib/grass_field.wgsl"
    "lib/snow.wgsl"
    "lib/gbuffer_static_surface.wgsl"
    "lib/gbuffer_static.wgsl"
  ])
  log(groundShader.text.contains(sub: "grassPaintColor(grassPaintRootValue(paint)"))
  # and in bands: the patches it stands in step as the blades' do
  log(groundShader.text.contains(sub: "let patchValue = grassPaintBand("))
  # blades lean toward a camera looking down, only when an app asks (cameraTilt)
  log(render.text.contains(sub: "fn grassTiltToCamera"))
  let meadow: GrassConfig.GrassViewSettings = GrassConfig.grassMeadowSettings(
    groundColor: Vec3.create(x: 0.1, y: 0.3, z: 0.1)
  )
  log(meadow.cameraTilt is 0.0)
  # a field is a disc unless an app makes it a ring
  log(meadow.innerRadius is 0.0)
  let compute: Shader = GrassCompute.defaultGrassComputeShader()
  log(compute.text.contains(sub: "innerFade * viewShrink"))
  # the textured shape's cut-out stays its own: a painted blade discards nothing
  log(render.text.contains(sub: "GW.i.w > 2.5 && GW.i.w < 3.5"))
  ret 0
}
