import core
open ecs/registry
open ui/registry_flags

# #730: the UI's serialized-vs-derived split is REGISTRY-DRIVEN. Authored
# components are registered `serialize`; the derived caches the systems rebuild
# are registered without it, so the generic serializer skips them by flag. Keyed
# by UiWorld FIELD name (#768): the machine snapshot looks up by fieldName(table),
# so the registry registers each table under its field name (`rects`, not `Rect`).

func check(reg: view ComponentRegistry, name: view String) {
  log("{name}: registered={isRegistered(reg: reg, name: name)} serialize={registeredHasFlag(reg: reg, name: name, flag: serialize)}")
}

func main() {
  let reg: ComponentRegistry = createUiComponentRegistry()
  log("count: {registeredCount(reg: reg)}")
  # authored -> persisted
  check(reg: reg, name: "rects")
  check(reg: reg, name: "layouts")
  check(reg: reg, name: "texts")
  check(reg: reg, name: "parents")
  # editor-only still serializes, but is flagged
  let evEditorOnly: Bool = registeredHasFlag(reg: reg, name: "editorVisibles", flag: editorOnly)
  log("editorVisibles editorOnly={evEditorOnly}")
  # derived caches -> NOT persisted
  check(reg: reg, name: "childrens")
  check(reg: reg, name: "computedRects")
  check(reg: reg, name: "measuredSizes")
  check(reg: reg, name: "worldTransforms")
  check(reg: reg, name: "runtimeOffsets")
  # unknown -> nothing
  check(reg: reg, name: "wibble")
}
