# #898 gap (a): a whole-value COPY of a raw-Ptr aggregate with NO lifecycle
# (no `drop`, no `copy`) duplicates its pointer storage and must be `unsafe`.
# The destructor-copy check does not reach it (List(Ptr) has no destructor);
# `own` transfers, `view`/`mod` borrows and factory results stay safe (805).
func allocate(byteCount: copy UInt64) unsafe extern("malloc") ret Ptr

func makePtrList() ret List(Ptr) {
  var xs: List(Ptr) = List.create(Ptr, cap: 2)
  unsafe { xs.add(value: allocate(byteCount: 8 as UInt64)) }
  ret xs
}

func main() {
  let xs: List(Ptr) = makePtrList()
  let ys: List(Ptr) = xs
  log("{ys.length}")
}
