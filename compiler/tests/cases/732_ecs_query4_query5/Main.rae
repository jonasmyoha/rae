open ecs/Entity
open ecs/ComponentTable
open ecs/Query

# #807: query4/query5 extend the fixed query ladder. Both iterate whichever table
# is SMALLEST and probe the rest by O(1) index, so the join is O(min table). The
# tables are built so the smallest lands in a different SLOT per call, exercising
# different driver branches (query4: D then B; query5: E then A). Only e4 is in
# every table. A mod write through queryModAt must be visible on read-back.

type Position { x: Int }
type Vel { v: Int }
type Hp { hp: Int }
type Tag { t: Int }
type Nm { n: Int }

func main() {
  var pos: ComponentTable(Position) = createComponentTable(Position)
  var vel: ComponentTable(Vel) = createComponentTable(Vel)
  var hp: ComponentTable(Hp) = createComponentTable(Hp)
  var tag: ComponentTable(Tag) = createComponentTable(Tag)
  var nm: ComponentTable(Nm) = createComponentTable(Nm)
  let e1: EntityId = { index: 1, generation: 0 }
  let e2: EntityId = { index: 2, generation: 0 }
  let e3: EntityId = { index: 3, generation: 0 }
  let e4: EntityId = { index: 4, generation: 0 }
  componentSet(this: pos, entity: e1, data: Position { x: 10 })
  componentSet(this: pos, entity: e2, data: Position { x: 20 })
  componentSet(this: pos, entity: e3, data: Position { x: 30 })
  componentSet(this: pos, entity: e4, data: Position { x: 40 })
  componentSet(this: vel, entity: e2, data: Vel { v: 2 })
  componentSet(this: vel, entity: e3, data: Vel { v: 3 })
  componentSet(this: vel, entity: e4, data: Vel { v: 4 })
  componentSet(this: hp, entity: e3, data: Hp { hp: 33 })
  componentSet(this: hp, entity: e4, data: Hp { hp: 44 })
  componentSet(this: tag, entity: e4, data: Tag { t: 1 })
  componentSet(this: nm, entity: e1, data: Nm { n: 100 })
  componentSet(this: nm, entity: e4, data: Nm { n: 400 })

  # query4, smallest table (tag, 1 entity) in slot D.
  let h4: List(Query4Match) = query4(tableA: pos, tableB: vel, tableC: hp, tableD: tag)
  log("q4 count: {h4.length}")
  loop let row: view Query4Match in h4 {
    let position: view Position => query4ViewA(tableA: pos, hit: row)
    let vv: view Vel => query4ViewB(tableB: vel, hit: row)
    let h: view Hp => query4ViewC(tableC: hp, hit: row)
    let tg: view Tag => query4ViewD(tableD: tag, hit: row)
    log("q4 e{row.entity.index}: {position.x} {vv.v} {h.hp} {tg.t}")
  }

  # query4 again with the smallest table in slot B (a different driver branch).
  let h4b: List(Query4Match) = query4(tableA: pos, tableB: tag, tableC: vel, tableD: hp)
  log("q4b count: {h4b.length}")
  loop let row: view Query4Match in h4b {
    let px: mod Position => queryModAt(table: pos, denseIndex: row.indexA)
    px.x = px.x + 1000
  }
  let got: Position = componentGet(this: pos, entity: e4)
  log("e4.x after q4 mod: {got.x}")

  # query5, smallest table (tag) in slot E.
  let h5: List(Query5Match) = query5(tableA: pos, tableB: vel, tableC: hp, tableD: nm, tableE: tag)
  log("q5 count: {h5.length}")
  loop let row: view Query5Match in h5 {
    let position: view Position => query5ViewA(tableA: pos, hit: row)
    let vv: view Vel => query5ViewB(tableB: vel, hit: row)
    let h: view Hp => query5ViewC(tableC: hp, hit: row)
    let nn: view Nm => query5ViewD(tableD: nm, hit: row)
    let tg: view Tag => query5ViewE(tableE: tag, hit: row)
    log("q5 e{row.entity.index}: {position.x} {vv.v} {h.hp} {nn.n} {tg.t}")
  }

  # query5 with the smallest table in slot A.
  let h5a: List(Query5Match) = query5(tableA: tag, tableB: pos, tableC: vel, tableD: hp, tableE: nm)
  log("q5a count: {h5a.length}")
  loop let row: view Query5Match in h5a {
    let nn: mod Nm => queryModAt(table: nm, denseIndex: row.indexE)
    nn.n = nn.n + 1
  }
  let gotNm: Nm = componentGet(this: nm, entity: e4)
  log("e4.n after q5 mod: {gotNm.n}")
}
