# Deferred frame with a UI overlay (#389).
#
# The overlay MODIFIES the composited target — it loads the finished 3D
# image and paints over it. That distinction is the whole test:
#
#   * declared as a second WRITE, the graph would reject it (two writers)
#   * declared as a plain READ, nothing would order it after composite,
#     and the UI could be painted before the image it sits on
#
# Only `passModifies` states it truthfully, and the proof is that the
# derived order puts uiOverlay strictly between composite and present
# WITHOUT anyone writing that sequence down.
#
# Also asserts the no-UI graph is unchanged, because the two builders are
# now one parameterised function and a regression there would silently
# add a UI pass to every deferred app.
open RendererDeferred
open Rendergraph

# By TAG, not by name: the tag is the renderer's dispatch key and the
# graph deliberately does not store names. Asserting on the thing the
# frame actually switches on is also the stronger test.
func indexOfTag(renderer: view DeferredRenderer, tag: view Int) ret Int {
  var i: Int = 0
  loop i < deferredOrderLength(renderer: renderer) {
    if deferredTagAt(renderer: renderer, i: i) is tag {
      ret i
    }
    i = i + 1
  }
  ret 0 - 1
}

func main() {
  var plain: DeferredRenderer = createDeferredRenderer()
  let plainStatus: Int = compileDeferred(renderer: plain)
  log("plain status={statusName(status: plainStatus)} passes={deferredOrderLength(renderer: plain)}")
  if indexOfTag(renderer: plain, tag: RenderTag.uiOverlay) is 0 - 1 {
    log("plain has no ui pass: yes")
  } else {
    log("plain has no ui pass: NO")
  }

  var withUi: DeferredRenderer = createDeferredRendererWithUi()
  let uiStatus: Int = compileDeferred(renderer: withUi)
  log("ui status={statusName(status: uiStatus)} passes={deferredOrderLength(renderer: withUi)}")

  let composite: Int = indexOfTag(renderer: withUi, tag: RenderTag.composite)
  let ui: Int = indexOfTag(renderer: withUi, tag: RenderTag.uiOverlay)
  let present: Int = indexOfTag(renderer: withUi, tag: RenderTag.present)
  if composite >= 0 and ui > composite and present > ui {
    log("derived composite -> ui -> present: yes")
  } else {
    log("derived composite -> ui -> present: NO ({composite} {ui} {present})")
  }
  # The overlay must sit AFTER everything radiometric. UI colours are
  # authored in display space and must never be tone-curved.
  if ui > indexOfTag(renderer: withUi, tag: RenderTag.lighting) {
    log("ui after lighting: yes")
  } else {
    log("ui after lighting: NO")
  }
  let lighting: Int = indexOfTag(renderer: withUi, tag: RenderTag.lighting)
  let transparent: Int = indexOfTag(renderer: withUi, tag: RenderTag.transparentForward)
  let temporal: Int = indexOfTag(renderer: withUi, tag: RenderTag.taa)
  if lighting >= 0 and transparent is lighting + 1 and temporal is transparent + 1 {
    log("derived lighting -> transparent -> taa: yes")
  } else {
    log("derived lighting -> transparent -> taa: NO")
  }
}
