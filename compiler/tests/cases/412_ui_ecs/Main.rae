open ui/Ecs
open ui/Components
open ui/Registry
open ecs/Entity
open ecs/ComponentTable

open ecs/Query

func rectText(rect: view Rect) ret String {
  ret "{rect.position.x},{rect.position.y} {rect.size.x}x{rect.size.y}"
}

func main() {
  let world: UiWorld = createUiWorld()
  log("alive at boot: {aliveCount(world: world)}")
  log("known components: {registeredComponentCount(world: world)}")
  let rectName: String = "Rect"
  let wibbleName: String = "Wibble"
  log("Rect known: {isKnownComponent(world: world, name: rectName)}")
  log("Wibble known: {isKnownComponent(world: world, name: wibbleName)}")

  # Allocate three entities.
  var e1: EntityId = createEntity(world: world)
  var e2: EntityId = createEntity(world: world)
  var e3: EntityId = createEntity(world: world)
  log("alive after 3 createEntity: {aliveCount(world: world)}")
  log("e1={e1.index} e2={e2.index} e3={e3.index}")
  log("e1 alive: {isAlive(world: world, entityId: e1)}")
  let probe99: EntityId = id(v: 99)
  log("99 alive: {isAlive(world: world, entityId: probe99)}")

  # Add a Rect to e1 and e3, but not e2.
  let r1: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: 100.0, y: 200.0 } }
  let r3: Rect = { position: { x: 50.0, y: 50.0 }, size: { x: 320.0, y: 240.0 } }
  componentSet(this: world.rects, entityId: e1, data: r1)
  componentSet(this: world.rects, entityId: e3, data: r3)

  log("rects.count: {componentCount(this: world.rects)}")
  log("e1 hasRect: {componentHas(this: world.rects, entityId: e1)}")
  log("e2 hasRect: {componentHas(this: world.rects, entityId: e2)}")
  log("e3 hasRect: {componentHas(this: world.rects, entityId: e3)}")

  # Read through views passed as arguments: a view BINDING would still be live
  # at the replace and remove below, which the borrow rule rejects.
  log("e1 rect: {rectText(rect: componentView(this: world.rects, entityId: e1))}")
  log("e3 rect: {rectText(rect: componentView(this: world.rects, entityId: e3))}")

  # Replace e1's rect.
  let r1b: Rect = { position: { x: 10.0, y: 20.0 }, size: { x: 30.0, y: 40.0 } }
  componentSet(this: world.rects, entityId: e1, data: r1b)
  log("rects.count after replace: {componentCount(this: world.rects)}")
  log("e1 rect after replace: {rectText(rect: componentView(this: world.rects, entityId: e1))}")

  # Add a Text component to e2.
  let t2: Text = { text: "hello", styleId: "h1", wrapWidthMode: WrapWidthMode.nodeWidth }
  componentSet(this: world.texts, entityId: e2, data: t2)
  log("texts.count: {componentCount(this: world.texts)}")
  let gotT: view Text => componentView(this: world.texts, entityId: e2)
  log("e2 text: '{gotT.text}' style={gotT.styleId}")

  # Add an Active=false to e3 (default is true at construction time;
  # this overrides).
  let a3: Active = { value: false }
  componentSet(this: world.actives, entityId: e3, data: a3)
  let gotA: view Active => componentView(this: world.actives, entityId: e3)
  log("e3 active: {gotA.value}")

  # Iterate the rects table.
  let rectN: Int = componentCount(this: world.rects)
  var i: Int = 0
  loop i < rectN {
    let ent: EntityId = componentEntityAt(this: world.rects, i: i)
    let r: view Rect => queryViewAt(table: world.rects, denseIndex: i)
    log("  rect[{i}] entity={ent.index} {r.size.x}x{r.size.y}")
    i = i + 1
  }

  # Remove e3's rect, observe count.
  componentRemove(this: world.rects, entityId: e3)
  log("rects.count after remove e3: {componentCount(this: world.rects)}")
  log("e3 hasRect after remove: {componentHas(this: world.rects, entityId: e3)}")
  log("e1 hasRect after remove: {componentHas(this: world.rects, entityId: e1)}")

  let wid: WidgetId = { id: "play.icon", kind: "playbackIcon" }
  componentSet(this: world.widgetIds, entityId: e2, data: wid)
  let wstate: WidgetState = { enabled: true, selected: false, loading: false, error: false }
  componentSet(this: world.widgetStates, entityId: e2, data: wstate)
  let dep: DataDependency = {
    resource: DataResourceId.playback
    field: DataFieldId.isPlaying
    observedRevision: 7
  }
  componentSet(this: world.dataDependencies, entityId: e2, data: dep)
  let gotWid: view WidgetId => componentView(this: world.widgetIds, entityId: e2)
  let gotState: view WidgetState => componentView(this: world.widgetStates, entityId: e2)
  let gotDep: view DataDependency => componentView(this: world.dataDependencies, entityId: e2)
  log("e2 widget: {gotWid.id} kind={gotWid.kind} enabled={gotState.enabled}")
  log(
    "e2 dependency: playback={gotDep.resource is DataResourceId.playback} isPlaying={gotDep.field is DataFieldId.isPlaying} rev={gotDep.observedRevision}"
  )

  # Defaults still useful.
  let deltaTime: TransformFx = defaultTransformFx()
  log("default transform alpha: {deltaTime.alpha} visible: {deltaTime.visible}")
}
