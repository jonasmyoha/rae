# docs/binding-modes-design.md §1, the binding table (2026-10-20): row 5.
# There is no `var` alias: `var` means rebindable, and an alias never is.
type Particle {
  x: Int
}

func main() {
  var particle: Particle = { x: 1 }
  var reader: view Particle = particle
  var writer: mod Particle = particle
}
