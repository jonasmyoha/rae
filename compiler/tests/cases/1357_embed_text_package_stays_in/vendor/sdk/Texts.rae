# A package sees only its own files: not the project's file by name, and not by `..`
func byName() ret String {
  ret embedText(file: "secret.txt")
}

func byClimbing() ret String {
  ret embedText(file: "../../secret.txt")
}

func byClimbingInside() ret String {
  ret embedText(file: "scenes/../../../secret.txt")
}
