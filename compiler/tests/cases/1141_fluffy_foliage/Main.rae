# Autumn Grove's leaf-patch forms (stylizedTrees/FluffyFoliage; the stylized
# set's umbrella pine is one): deterministic meshes with valid indices,
# whole patches sharing one wind pivot, at three patch budgets.
open stylizedTrees/FluffyFoliage
open Mesh3d

func main() ret Int {
  let forms: List(FluffyForm) = { FluffyForm.broadleaf, FluffyForm.bush, FluffyForm.umbrella }
  let counts: List(Int) = { 48, 24, 12 }
  loop let form: FluffyForm in forms {
    let wood: MeshData = fluffyWood(form: form, seed: 73)
    loop let index: Int in wood.indices {
      if index < 0 or index >= wood.vertCount {
        ret 7
      }
    }
    var clusters: Int = 7
    if form is FluffyForm.bush {
      clusters = 5
    }
    loop let count: Int in counts {
      var total: Int = 0
      loop var tone: Int = 0, tone < 3, ++tone {
        let mesh: MeshData = fluffyLeaves(
          form: form
          seed: 73
          patchCount: count
          tone: tone
        )
        let repeat: MeshData = fluffyLeaves(
          form: form
          seed: 73
          patchCount: count
          tone: tone
        )
        if mesh.windPivots.length is not mesh.vertCount * 4 {
          ret 10
        }
        loop var vertex: Int = 0, vertex < mesh.vertCount, ++vertex {
          let first: Int = (vertex / 13) * 13
          loop var field: Int = 0, field < 4, ++field {
            let value: Float = mesh.windPivots.copyAtFallback(
              index: vertex * 4 + field
              fallback: -1
            )
            if value is not mesh.windPivots.copyAtFallback(index: first * 4 + field, fallback: -2) {
              ret 11
            }
            if value is not repeat.windPivots.copyAtFallback(
              index: vertex * 4 + field
              fallback: -3
            ) {
              ret 12
            }
          }
        }
        var expectedVertices: Int = clusters * count / 3 * 13
        var expectedIndices: Int = clusters * count / 3 * 72
        if mesh.vertCount is not expectedVertices {
          ret 1
        }
        if mesh.indices.length is not expectedIndices {
          ret 2
        }
        loop var i: Int = 0, i < mesh.verts.length, ++i {
          let value: Float = mesh.verts.copyAtFallback(index: i, fallback: -999)
          if value is not repeat.verts.copyAtFallback(index: i, fallback: -998) {
            ret 3
          }
          if value is not value {
            ret 4
          }
        }
        loop let index: Int in mesh.indices {
          if index < 0 or index >= mesh.vertCount {
            ret 5
          }
        }
        total = total + mesh.indices.length / 3
      }
      var expectedTriangles: Int = clusters * count * 24
      if total is not expectedTriangles {
        ret 6
      }
    }
  }
  log("three leaf-patch forms: deterministic, valid indices, three patch budgets")
  ret 0
}
