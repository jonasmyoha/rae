# A PascalCase folder is a module folder, and a program's own tree may not hold one yet
# (docs/module-model-options.md rule 9): the sibling `Color/` directory holds a .rae file, so
# the build stops before it reaches the enum `Color` it would also have clashed with (the
# earlier test of this case, from when a folder of any case was a project namespace).
enum Color { red, green, blue }

func main() {
  let c: Int = Color.green
  log("{c}")
}
