
# `Color` is BOTH an enum type (with case `green`) AND a folder-package: the
# sibling `Color/` directory holds a module (Color/Green.rae). `Color.green`
# would then be ambiguous — enum case vs a module in package `Color` — so the
# clash is a hard error at the enum's definition site.
enum Color { red, green, blue }

func main() {
  let c: Int = Color.green
  log("{c}")
}
