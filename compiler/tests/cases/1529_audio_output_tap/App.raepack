pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../../../.."
      subdir: "packages/audio"
      version: "0.24.0"
      hash: "git-tree:382f5f1701ef831fc17a3b17c779683b2e035e1a"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
