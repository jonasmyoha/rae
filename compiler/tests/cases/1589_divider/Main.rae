# Dividers (ui/DividerSystem): drags along both axes with limits, a pane after the line, the press
# taken
# from what is under it, the mouse cursor and the line's own color, a double click, the keys, a
# finger,
# a window made smaller and larger again, a saved size, a menu over it, and a line cut off by a
# clip.
import Math
open ecs/ComponentTable
open ecs/Entity
open ecs/Event
open ui/Components
open ui/DividerSystem
open ui/Ecs
open ui/InputKind
open ui/InputSystem
open ui/KeyFocusSystem
open ui/LayoutSystem
open ui/PaneComponents
open ui/Scene
open ui/SceneInstance
open ui/SceneLoader
open ui/Transform
open ui/UiSystems

type App {
  world: UiWorld
  uiSystems: UiSystems
  input: UiInput
}

func nodeOf(world: view UiWorld, nodeId: view String) ret EntityId {
  if let raw: Int = findNodeInPage(world: world, pageId: "p", nodeId: nodeId) {
    ret nodeEntityId(world: world, index: raw)
  }
  ret noEntity()
}

func box(app: view App, nodeId: view String) ret String {
  let rect: view ComputedRect = componentView(
    this: app.uiSystems.layout.computedRects
    entityId: nodeOf(world: app.world, nodeId: nodeId)
  )
  ret "{nodeId} {Math.round(x: rect.size.x)}x{Math.round(x: rect.size.y)}"
}

func show(app: view App, step: view String) {
  var text: String = ""
  loop var i: Int = 0, i < eventCount(DividerEvent, this: app.world.dividerEvents), ++i {
    let event: DividerEvent = eventAt(DividerEvent, this: app.world.dividerEvents, i: i)
    var kind: String = "moved"
    if event.kind is DividerEventKind.dropped {
      kind = "dropped"
    } else if event.kind is DividerEventKind.doubleClicked {
      kind = "double click"
    }
    text = text.concat(other: " ({kind} {event.size})")
  }
  loop var i: Int = 0, i < eventCount(UiAction, this: app.world.uiActions), ++i {
    let action: UiAction = eventAt(UiAction, this: app.world.uiActions, i: i)
    text = text.concat(other: " action {action.actionId}")
  }
  let fill: String = "{componentView(
    this: app.world.shapes
    entityId: nodeOf(world: app.world, nodeId: "Split")
  ).fillSlot}"
  log(
    "{step}: {box(app: app, nodeId: "Left")}, {box(app: app, nodeId: "Top")}, {box(
      app: app
      nodeId: "Right"
    )}, cursor {app.uiSystems.dividers.cursor}, line {fill}{text}"
  )
}

func layOut(app: mod App) {
  layoutSystem(world: app.world, uiSystems: app.uiSystems)
  transformSystem(world: app.world, uiSystems: app.uiSystems)
}

func pointer(
  app: mod App
  step: view String
  x: view Float
  y: view Float
  down: view Bool
  clicks: view Int
  kind: view InputKind
  keys: view DividerKeys
) {
  var state: UiPointerState = uiPointerScriptFrame(
    previous: app.input.pointer
    x: x
    y: y
    down: down
    kind: kind
  )
  state.clicks = clicks
  updateUiInputWith(
    input: app.input
    world: app.world
    uiSystems: app.uiSystems
    pointer: state
    wheel: 0.0
  )
  let changed: Bool = dividerSystem(
    world: app.world
    uiSystems: app.uiSystems
    input: app.input
    keys: keys
  )
  let moved: Bool = keyFocusSystem(world: app.world, uiSystems: app.uiSystems, input: app.input)
  layOut(app: app)
  if step.length() > 0 {
    show(app: app, step: step)
  }
}

