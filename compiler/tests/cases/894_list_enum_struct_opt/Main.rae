# Struct literals as list elements and as opt payloads (found in #77360967),
# interpolated through toString.
type Pair {
  x: Int
  y: Int
}

func main() {
  # A list literal of struct literals, no named intermediates.
  let pairs: List(Pair) = [Pair { x: 1, y: 2 }, Pair { x: 3, y: 4 }]
  log("pairs: {pairs}")

  # A bare struct literal as an opt payload (the type is on the left, so the
  # RHS is bare braces), and `none`.
  let maybe: opt Pair = { x: 7, y: 8 }
  log("maybe: {maybe}")
  let nothing: opt Pair = none
  log("nothing: {nothing}")
}
