# Ptr is an internal C-interoperability primitive. It lowers to void* as a
# value, void** through mod, and void** as List(Ptr)'s element storage. A Ptr
# field must also remain printable through its owner's generated formatter.
cheader "stdlib.h"

func allocate(byteCount: copy UInt64) extern("malloc") ret Ptr
func release(pointer: copy Ptr) extern("free")

type NativeOwner {
  pointer: Ptr
  marker: Int
}

func drop(this: mod NativeOwner) {
  log("drop {this.marker}")
  release(pointer: this.pointer)
}

func replace(pointer: mod Ptr, replacement: copy Ptr) {
  release(pointer: pointer)
  pointer = replacement
}

func pointerCount(pointers: copy List(Ptr)) ret Int {
  ret pointers.length
}

func main() {
  var owner: NativeOwner = {
    pointer: allocate(byteCount: 8 as UInt64)
    marker: 7
  }
  log("owner {owner}")

  replace(
    pointer: owner.pointer
    replacement: allocate(byteCount: 16 as UInt64)
  )

  var pointers: List(Ptr) = List.create(Ptr, cap: 2)
  pointers.add(value: allocate(byteCount: 24 as UInt64))
  pointers.add(value: allocate(byteCount: 32 as UInt64))
  log("count {pointers.length}")
  log("copy count {pointerCount(pointers: pointers)}")
  loop let pointer: Ptr in pointers {
    release(pointer: pointer)
  }
}
