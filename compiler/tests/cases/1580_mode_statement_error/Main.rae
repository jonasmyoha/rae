# A `mod`, `view` or `own` expression as a statement of its own does nothing, so it is an error
# (a `mod` on the line after an expression is this one too, not the remainder).
func main() {
  let count: Int = 6
  var names: List(String) = { "a" }
  let row: Int = 5
  mod count
  view count
  own names
  mod names.add(value: "b")
}
