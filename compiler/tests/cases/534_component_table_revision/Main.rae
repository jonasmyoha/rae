# Unit test for ComponentTable(T)'s `generation` counter (#260, ECS E0a).
# ComponentTable(T) is the ECS table primitive (the design's conceptual
# "Table(T)"; `generation` is its table-level revision). Asserts
# `generation` bumps exactly once per real mutation and NOT on a no-op
# remove.
open ui/Ecs
open ecs/Entity
open ecs/ComponentTable

type Cell {
  v: Int
}

# #814: a mod borrow must end before the table is mutated again — scope it here.
func setViaMod(t: mod ComponentTable(Cell), entityId: view EntityId, v: view Int) {
  let m: mod Cell => componentMod(this: t, entityId: entityId)
  m.v = v
}

func main() {
  var t: ComponentTable(Cell) = ComponentTable.create(Cell)
  log("gen0: {componentTableGeneration(this: t)}")
  log("count0: {componentCount(this: t)}")

  let e1: EntityId = id(v: 1)
  let e2: EntityId = id(v: 2)

  componentSet(this: t, entityId: e1, data: Cell { v: 10 })
  log("gen1: {componentTableGeneration(this: t)}")
  componentSet(this: t, entityId: e2, data: Cell { v: 20 })
  log("gen2: {componentTableGeneration(this: t)}")
  log("count2: {componentCount(this: t)}")

  log("has_e1: {componentHas(this: t, entityId: e1)}")
  let miss: EntityId = id(v: 99)
  log("has_miss: {componentHas(this: t, entityId: miss)}")

  log("get_e1: {componentView(this: t, entityId: e1).v}")

  # replace bumps
  componentSet(this: t, entityId: e1, data: Cell { v: 11 })
  log("gen3: {componentTableGeneration(this: t)}")
  log("get_e1b: {componentView(this: t, entityId: e1).v}")

  # mod bumps (borrow scoped in a helper, #814)
  setViaMod(t: t, entityId: e2, v: 21)
  log("gen4: {componentTableGeneration(this: t)}")
  log("get_e2: {componentView(this: t, entityId: e2).v}")

  # remove bumps; e2 survives the swap-remove of e1
  componentRemove(this: t, entityId: e1)
  log("gen5: {componentTableGeneration(this: t)}")
  log("count_after_remove: {componentCount(this: t)}")
  log("has_e2: {componentHas(this: t, entityId: e2)}")
  log("get_e2b: {componentView(this: t, entityId: e2).v}")

  # no-op remove of an absent entity must NOT bump the generation
  componentRemove(this: t, entityId: miss)
  log("gen_after_noop_remove: {componentTableGeneration(this: t)}")
}
