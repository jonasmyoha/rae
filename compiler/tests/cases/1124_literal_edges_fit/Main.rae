# Every fixed-width type's minimum and maximum is accepted as a literal, as are
# zero, a negated zero and hex: the fit check rejects only what does not fit
# (fixtures 1121-1123).
func main() {
  let int8Min: Int8 = -128
  let int8Max: Int8 = 127
  let int16Min: Int16 = -32768
  let int16Max: Int16 = 32767
  let int32Min: Int32 = -2147483648
  let int32Max: Int32 = 2147483647
  let intMin: Int = -9223372036854775808
  let intMax: Int = 9223372036854775807
  let int64Max: Int64 = 9223372036854775807
  let uint8Max: UInt8 = 255
  let uint16Max: UInt16 = 65535
  let uint32Max: UInt32 = 4294967295
  let uint64Max: UInt64 = 18446744073709551615
  let uintZero: UInt64 = 0
  let negativeZero: UInt8 = -0
  let hexMax: UInt8 = 0xFF
  let small: UInt8 = 200
  let sum: UInt8 = small + 55
  log("{int8Min} {int8Max} {int16Min} {int16Max} {int32Min} {int32Max}")
  log("{intMin} {intMax} {int64Max}")
  log("{uint8Max} {uint16Max} {uint32Max} {uint64Max} {uintZero} {negativeZero} {hexMax} {sum}")
}
