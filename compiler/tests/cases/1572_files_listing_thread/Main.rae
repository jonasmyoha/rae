# How a program lists folders without waiting for the disk (docs/file-browser-design.md §3.1, §3.2):
# one `spawn thread` per listing, its results over a channel, a stop channel, a generation per
# request. Run under ThreadSanitizer too.
#   1. two listings at once: each one's names come first, ordered, then its details in batches;
#   2. a column that moved on to another folder drops the older request's results;
#   3. a listing told to stop sends nothing more than the batch it was in;
#   4. a listing that never returns (it waits here as a readdir on a dead disk would): the others go
#      on, and the program still quits. Its task must not be joined, which a Task's drop does, so
#      the program keeps it and ends with Sys.exit.
import Files
import Sys
open text/NameOrder
open Signal
open Channel

const detailBatch: Int = 100

enum UpdateKind { names, details, done }

type ListUpdate {
  kind: UpdateKind
  generation: Int
  # names: every entry; details: the next ones, in the same order
  entries: List(FileEntry)
  error: ListError
}

# The thread of one listing
func listThread(
  updates: own Channel(ListUpdate)
  stop: own Channel(Int)
  folder: own String
  generation: copy Int
) ret Int {
  let fold: NameFold = createNameFold()
  var listing: FolderListing = Files.readFolder(folder: folder)
  Files.orderEntries(fold: fold, order: EntryOrder {}, entries: listing.entries)
  updates.channelSend(
    value: {
      kind: UpdateKind.names
      generation: generation
      entries: listing.entries
      error: listing.error
    }
  )
  var sent: Int = 0
  loop sent < listing.entries.length and stop.pending() is 0 {
    var batch: List(FileEntry) = {}
    loop var i: Int = sent, i < sent + detailBatch and i < listing.entries.length, ++i {
      if let entry: mod FileEntry = listing.entries.modAt(index: i) {
        Files.readEntryDetails(folder: folder, entry: entry)
        batch.add(value: entry)
      }
    }
    sent = sent + batch.length
    updates.channelSend(
      value: {
        kind: UpdateKind.details
        generation: generation
        entries: own batch
        error: ListError.none
      }
    )
  }
  updates.channelSend(
    value: { kind: UpdateKind.done, generation: generation, entries: {}, error: ListError.none }
  )
  ret sent
}

# The thread of a listing on a disk that never answers
func stuckThread(never: own Signal) ret Int {
  never.wait()
  ret 0
}

# A column of the program: the folder's entries by the request it made last
type Column {
  generation: Int
  names: Int
  detailed: Int
  first: String
  finished: Bool
  dropped: Int
}

# Take what has arrived, until `column` is finished (at most 10 s)
func takeUntilDone(updates: view Channel(ListUpdate), column: mod Column, doneWanted: view Int) {
  let deadline: Int = nowNs() + 10000000000
  var done: Int = 0
  loop done < doneWanted and nowNs() < deadline {
    if updates.pending() is 0 {
      sleep(ms: 1)
      continue
    }
    let update: ListUpdate = updates.receive()
    if update.kind is UpdateKind.done {
      done = done + 1
    }
    if update.generation is not column.generation {
      column.dropped = column.dropped + 1
      continue
    }
    if update.kind is UpdateKind.names {
      column.names = update.entries.length
      if let entry: view FileEntry = update.entries.viewAt(index: 0) {
        column.first = "{entry.name}"
      }
    } else if update.kind is UpdateKind.details {
      loop let entry: view FileEntry in update.entries {
        if entry.size >= 0 {
          column.detailed = column.detailed + 1
        }
      }
    } else {
      column.finished = true
    }
  }
}

func showColumn(label: view String, column: view Column) {
  log(
    "{label}: {column.names} names from {column.first}, {column.detailed} detailed, finished {column.finished}"
  )
}

func emptyColumn(generation: view Int) ret Column {
  ret Column {
    generation: generation
    names: 0
    detailed: 0
    first: ""
    finished: false
    dropped: 0
  }
}

func makeFiles(folder: view String, prefix: view String, count: view Int) {
  let made: Bool = Sys.makeDir(path: folder)
  loop var i: Int = 0, i < count, ++i {
    let one: Bool = Sys.writeFile(path: "{folder}/{prefix} {i}.txt", content: "{i}")
  }
}

func removeFolder(folder: view String) {
  let listing: FolderListing = Files.readFolder(folder: folder)
  loop let entry: view FileEntry in listing.entries {
    let gone: Bool = Sys.delete(path: "{folder}/{entry.name}")
  }
  let gone: Bool = Sys.delete(path: folder)
}

# 1 to 3, every thread joined
func listings() {
  var base: String = Sys.getEnv(name: "TMPDIR")
  if base.length() is 0 {
    base = "/tmp"
  }
  let red: String = "{base}/rae-listing-red-{nowNs()}"
  let blue: String = "{base}/rae-listing-blue-{nowNs()}"
  makeFiles(folder: red, prefix: "red", count: 450)
  makeFiles(folder: blue, prefix: "blue", count: 30)
  let redUpdates: Channel(ListUpdate) = createChannel(ListUpdate)
  let blueUpdates: Channel(ListUpdate) = createChannel(ListUpdate)
  let stop: Channel(Int) = createChannel(Int)
  let halt: Channel(Int) = createChannel(Int)
  let redTask: Task(Int) = spawn thread listThread(
    updates: redUpdates
    stop: stop
    folder: red
    generation: 1
  )
  let blueTask: Task(Int) = spawn thread listThread(
    updates: blueUpdates
    stop: stop
    folder: blue
    generation: 1
  )
  var redColumn: Column = emptyColumn(generation: 1)
  var blueColumn: Column = emptyColumn(generation: 1)
  takeUntilDone(updates: blueUpdates, column: blueColumn, doneWanted: 1)
  takeUntilDone(updates: redUpdates, column: redColumn, doneWanted: 1)
  showColumn(label: "1. red", column: redColumn)
  showColumn(label: "1. blue", column: blueColumn)
  log("   read {redTask.get()} and {blueTask.get()}")

  # 2: one column asks for red (generation 2), then for blue (3)
  let older: Task(Int) = spawn thread listThread(
    updates: redUpdates
    stop: stop
    folder: red
    generation: 2
  )
  let newer: Task(Int) = spawn thread listThread(
    updates: redUpdates
    stop: stop
    folder: blue
    generation: 3
  )
  var moved: Column = emptyColumn(generation: 3)
  takeUntilDone(updates: redUpdates, column: moved, doneWanted: 2)
  showColumn(label: "2. the newer request's", column: moved)
  log("   the older one's dropped: {moved.dropped} (its names, 5 batches and its end)")
  let both: Int = older.get() + newer.get()

  # 3: told to stop before its first batch
  halt.channelSend(value: 1)
  let stopped: Task(Int) = spawn thread listThread(
    updates: blueUpdates
    stop: halt
    folder: red
    generation: 4
  )
  var halted: Column = emptyColumn(generation: 4)
  takeUntilDone(updates: blueUpdates, column: halted, doneWanted: 1)
  showColumn(label: "3. stopped", column: halted)
  log("   it read {stopped.get()}")
  let missing: Task(Int) = spawn thread listThread(
    updates: blueUpdates
    stop: stop
    folder: "{red}/nowhere"
    generation: 5
  )
  var nowhere: Column = emptyColumn(generation: 5)
  takeUntilDone(updates: blueUpdates, column: nowhere, doneWanted: 1)
  showColumn(label: "   a missing folder", column: nowhere)
  log("   it read {missing.get()}")
  redUpdates.freeChannel()
  blueUpdates.freeChannel()
  stop.freeChannel()
  halt.freeChannel()
  removeFolder(folder: red)
  removeFolder(folder: blue)
}

func main() {
  listings()
  # 4
  let never: Signal = createSignal()
  let stuck: Task(Int) = spawn thread stuckThread(never: never)
  sleep(ms: 50)
  listings()
  log("4. a listing that never returned is left behind, and the program quits")
  Sys.exit(code: 0)
}
