type Point {
  x: Int
}

func xMod(point: mod Point) ret mod Int {
  ret mod  point.x
}

func xView(point: view Point) ret view Int {
  ret view  point.x
}

func main() {
  # ERROR: cannot take/return mod/view reference into a temporary literal
  let a: mod Int => xMod({ x: 1 })
  let b: view Int => xView({ x: 1 })
}
