# lib/treeGen (docs/reference-tree-plan.md step 3): the skeleton keeps the
# reference tree's (crop T02, as traced by hand) promises for every
# seed: a trunk, two unequal leaders forking below the crown at 72 to 82% of
# the height, 4 side branches starting 15 to 52 degrees from upright, all in
# the top 42%, radii that never grow toward a tip, the same tree for
# the same seed; and the bark mesh's triangles all face outward.
import Math
import Vec3
open Mesh3d
open treeGen/TreeParams
open treeGen/Skeleton
open treeGen/BarkMesh
open treeGen/ClumpMesh
open treeGen/TreeGrower
open treeGen/BranchDetail

func check(label: view String, ok: view Bool) {
  if ok {
    log("ok   {label}")
  } else {
    log("FAIL {label}")
  }
}

func radiiNeverGrow(limb: view Limb) ret Bool {
  # the trunk's root flare narrows upward too
  loop var i: Int = 1, i < limb.radii.length, ++i {
    if limb.radii.copyAtDefault(index: i) > limb.radii.copyAtDefault(index: i - 1) + 0.000001 {
      ret false
    }
  }
  ret true
}

# Every triangle's normal points away from its limb's center line: the face
# normal agrees with the vertex normals
func facesOutward(mesh: view MeshData) ret Bool {
  loop var triangle: Int = 0, triangle < mesh.indices.length / 3, ++triangle {
    let a: Int = mesh.indices.copyAtDefault(index: triangle * 3)
    let b: Int = mesh.indices.copyAtDefault(index: triangle * 3 + 1)
    let c: Int = mesh.indices.copyAtDefault(index: triangle * 3 + 2)
    let pa: Vec3 = Vec3.create(
      x: mesh.verts.copyAtDefault(index: a * 8)
      y: mesh.verts.copyAtDefault(index: a * 8 + 1)
      z: mesh.verts.copyAtDefault(index: a * 8 + 2)
    )
    let pb: Vec3 = Vec3.create(
      x: mesh.verts.copyAtDefault(index: b * 8)
      y: mesh.verts.copyAtDefault(index: b * 8 + 1)
      z: mesh.verts.copyAtDefault(index: b * 8 + 2)
    )
    let pc: Vec3 = Vec3.create(
      x: mesh.verts.copyAtDefault(index: c * 8)
      y: mesh.verts.copyAtDefault(index: c * 8 + 1)
      z: mesh.verts.copyAtDefault(index: c * 8 + 2)
    )
    let na: Vec3 = Vec3.create(
      x: mesh.verts.copyAtDefault(index: a * 8 + 3)
      y: mesh.verts.copyAtDefault(index: a * 8 + 4)
      z: mesh.verts.copyAtDefault(index: a * 8 + 5)
    )
    let face: Vec3 = Vec3.vcross(a: Vec3.vsub(a: pb, b: pa), b: Vec3.vsub(a: pc, b: pa))
    if Vec3.vlen(a: face) > 0.0000001 and Vec3.vdot(a: face, b: na) < 0.0 {
      ret false
    }
  }
  ret true
}

func main() ret Int {
  var limbsOk: Bool = true
  var forkOk: Bool = true
  var anglesOk: Bool = true
  var radiiOk: Bool = true
  var leadersOk: Bool = true
  var meshOk: Bool = true
  var evenOk: Bool = true
  var topThirdOk: Bool = true
  var fewest: Int = 99
  var most: Int = 0
  loop var seed: Int = 1, seed <= 20, ++seed {
    let params: TreeParams = warmBroadleafParams(seed: seed)
    let skeleton: TreeSkeleton = growSkeleton(params: params)
    var branches: Int = 0
    loop let limb: view Limb in skeleton.limbs {
      if limb.order is 2 {
        branches = branches + 1
      }
    }
    fewest = Math.min(a: fewest, b: branches)
    most = Math.max(a: most, b: branches)
    if branches < 4 or branches > 6 {
      limbsOk = false
    }
    let fork: Float = skeleton.forkPoint.z / params.height
    if fork < 0.72 or fork > 0.82 {
      forkOk = false
    }
    loop let limb: view Limb in skeleton.limbs {
      if not radiiNeverGrow(limb: limb) {
        radiiOk = false
      }
      if limb.order is 2 {
        let start: Vec3 = Vec3.vsub(
          a: limb.points.copyAtDefault(index: 1)
          b: limb.points.copyAtDefault(index: 0)
        )
        let angle: Float = angleFromUpright(direction: start) * 180.0 / 3.141592653589793
        # the first step has already turned a little toward upright
        if angle < 15.0 or angle > 52.0 {
          anglesOk = false
        }
        if limb.points.copyAtDefault(index: 0).z < params.height * 0.58 {
          topThirdOk = false
        }
      }
    }
    # the main leader carries the trunk on, joined onto it (one tube, no
    # seam at the fork); the second leader leaves it, thinner, its top lower
    let trunk: Limb = skeleton.limbs.copyAtDefault(index: 0)
    let second: Limb = skeleton.limbs.copyAtDefault(index: 1)
    var leaders: Int = 0
    loop let limb: view Limb in skeleton.limbs {
      if limb.order is 1 {
        leaders = leaders + 1
      }
    }
    let atFork: Int = indexAtHeight(limb: trunk, z: skeleton.forkPoint.z)
    if leaders is not 1 or second.order is not 1 or trunk.points.copyAtDefault(
      index: trunk.points.length - 1
    ).z < skeleton.forkPoint.z + 1.0 or second.radii.copyAtDefault(index: 0) >= trunk.radii.copyAtDefault(
      index: atFork
    ) {
      leadersOk = false
    }
    # as a branch works: every leader and branch thins to a fine tip, and
    # every child starts clearly thinner than its parent there
    loop let limb: view Limb in skeleton.limbs {
      if limb.order is 1 or limb.order is 2 {
        # thin at the tip, but still able to carry its leaves: at most a
        # third of its base, or 2.5 cm on a slender one, and never under
        # 1.8 cm where it joins its twig
        let tip: Float = limb.radii.copyAtDefault(index: limb.radii.length - 1)
        if tip > Math.max(a: limb.radii.copyAtDefault(index: 0) * 0.34, b: 0.0251) or tip < 0.0179 {
          evenOk = false
        }
      }
      if limb.parent >= 0 {
        let parent: Limb = skeleton.limbs.copyAtDefault(index: limb.parent)
        let at: Int = closestIndex(limb: parent, point: limb.points.copyAtDefault(index: 0))
        if limb.radii.copyAtDefault(index: 0) > parent.radii.copyAtDefault(index: at) * 0.76 {
          evenOk = false
        }
      }
    }
    if not facesOutward(mesh: barkMesh(skeleton: skeleton)) {
      meshOk = false
    }
  }
  check(
    label: "20 seeds: 4 side branches ({fewest} to {most})"
    ok: limbsOk and fewest is 4 and most is 4
  )
  check(label: "the fork below the crown, at 72 to 82% of the height", ok: forkOk)
  check(label: "side branches start 15 to 52 degrees from upright", ok: anglesOk)
  check(label: "side branches start high, above 58% of the height", ok: topThirdOk)
  check(label: "no radius grows toward a tip", ok: radiiOk)
  check(label: "the main leader joined onto the trunk; the second one thinner", ok: leadersOk)
  check(
    label: "branches thin to tips that carry their leaves; every child thinner than its parent"
    ok: evenOk
  )
  check(label: "every bark triangle faces outward, tip caps too", ok: meshOk)
  # the traced leaf masses: all of them, solid, facing outward
  let masses: TreeSkeleton = growSkeleton(params: warmBroadleafParams(seed: 1))
  check(
    label: "the traced leaf masses ({masses.clumps.length}) face outward"
    ok: masses.clumps.length > 0 and facesOutward(mesh: clumpMesh(skeleton: masses))
  )
  let again: TreeSkeleton = growSkeleton(params: warmBroadleafParams(seed: 7))
  let once: TreeSkeleton = growSkeleton(params: warmBroadleafParams(seed: 7))
  let tipAgain: Vec3 = again.limbs.copyAtDefault(index: 3).points.copyAtDefault(index: 14)
  let tipOnce: Vec3 = once.limbs.copyAtDefault(index: 3).points.copyAtDefault(index: 14)
  check(
    label: "the same seed gives the same tree"
    ok: Vec3.vlen(a: Vec3.vsub(a: tipAgain, b: tipOnce)) < 0.000001
  )
  checkGrownTrees()
  ret 0
}

# Step 6: the traced tree measured, and trees grown from the measures
func checkGrownTrees() {
  let measures: TreeMeasures = tracedT02Measures()
  check(
    label: "the trace measured: fork at 75%, 4 side branches, 13 leaf masses"
    ok: Math.abs(value: measures.forkHeight - 0.75) < 0.01 and measures.branchCount is 4 and measures.massCount is 13
  )
  var forkOk: Bool = true
  var branchesOk: Bool = true
  var massesOk: Bool = true
  var radiiOk: Bool = true
  var meshOk: Bool = true
  loop var seed: Int = 1, seed <= 20, ++seed {
    let params: TreeParams = grownBroadleafParams(seed: seed)
    let skeleton: TreeSkeleton = growSkeleton(params: params)
    let fork: Float = skeleton.forkPoint.z / params.height
    if fork < 0.66 or fork > 0.81 {
      forkOk = false
    }
    var branches: Int = 0
    loop let limb: view Limb in skeleton.limbs {
      if limb.order is 2 {
        branches = branches + 1
      }
      if not radiiNeverGrow(limb: limb) {
        radiiOk = false
      }
    }
    if branches < 3 or branches > 5 {
      branchesOk = false
    }
    # a mass on every leader and branch, and some to fill the crown
    if skeleton.clumps.length < 2 + branches or skeleton.clumps.length > 18 {
      massesOk = false
    }
    if not facesOutward(mesh: barkMesh(skeleton: skeleton)) or not facesOutward(
      mesh: clumpMesh(skeleton: skeleton)
    ) {
      meshOk = false
    }
  }
  check(label: "20 grown seeds: the fork at 66 to 81% of the height", ok: forkOk)
  check(label: "20 grown seeds: 3 to 5 side branches", ok: branchesOk)
  check(label: "20 grown seeds: a leaf mass on every leader and branch, at most 18", ok: massesOk)
  check(label: "20 grown seeds: no radius grows toward a tip", ok: radiiOk)
  check(label: "20 grown seeds: every bark and mass triangle faces outward", ok: meshOk)
  let first: TreeSkeleton = growSkeleton(params: grownBroadleafParams(seed: 1))
  let second: TreeSkeleton = growSkeleton(params: grownBroadleafParams(seed: 2))
  let firstAgain: TreeSkeleton = growSkeleton(params: grownBroadleafParams(seed: 1))
  let topFirst: Vec3 = first.limbs.copyAtDefault(index: 1).points.copyAtDefault(index: 14)
  let topSecond: Vec3 = second.limbs.copyAtDefault(index: 1).points.copyAtDefault(index: 14)
  let topAgain: Vec3 = firstAgain.limbs.copyAtDefault(index: 1).points.copyAtDefault(index: 14)
  check(
    label: "grown trees: the same seed the same tree, another seed another"
    ok: Vec3.vlen(a: Vec3.vsub(a: topFirst, b: topAgain)) < 0.000001 and Vec3.vlen(
      a: Vec3.vsub(a: topFirst, b: topSecond)
    ) > 0.1
  )
}
