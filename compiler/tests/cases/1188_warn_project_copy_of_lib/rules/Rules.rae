# A copy of lib/app3d/UiModes.isShortWindowHeight: the same name and
# parameters, so the build warns here
func isShortWindowHeight(height: view Float) ret Bool {
  ret height < 520.0
}

# The same name with other parameters: an overload, no warning
func isShortWindowHeight(height: view Int, slack: view Int) ret Bool {
  ret height + slack < 520
}
