pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../../../.."
      subdir: "packages/audio"
      version: "0.7.0"
      hash: "git-tree:4f00af7ca8b1a615dedb2b678c291ef6b363e5a6"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
