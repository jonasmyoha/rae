# The entry `tools/check-targets.sh` type-checks for every real target
# (`rae build --check-targets`, docs/platform-conditional-code.md §3.4), so
# the `when` branches of lib/ for platforms this machine does not build for
# cannot rot. It imports every lib/ module that uses `when`; the script fails
# when one is missing.
import crypto/Sha1
import net/NetSystem
import net/Poller
import net/Tcp
import FileNotify
import app3d/RenderScale
import sys/Spotify
import Raylib

func main() {
  log(Sha1.hexText(bytes: Sha1.sha1Text(text: "abc")))
  var poller: Poller = Poller.createPoller()
  Poller.closePoller(poller: poller)
  var watcher: FileNotify = FileNotify.createFileNotify()
  log(
    "kqueue {NetSystem.hasKqueue}, notifications {FileNotify.fileNotifyActive(fileNotify: watcher)}"
  )
  FileNotify.closeFileNotify(fileNotify: watcher)
  log("thermal {RenderScale.thermalState()}, spotify {Spotify.hasSpotifyBridge}")
}
