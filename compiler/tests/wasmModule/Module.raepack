pack Module {
  format: "raepack"
  version: 1
  defaultTarget: wasm
  dependencies: {
    dep frames: {
      path: "../wasmFrames"
    }
  }
  targets: {
    target wasm: {
      label: "Module"
      entry: "Main.rae"
      exports: "add, greet, summarize, doubled, flip"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
