# A WASM module (docs/wasm-modules.md): no main; the .raepack's wasm target
# exports `add` and `greet` by name, and tools/wasm-module-check.sh builds it
# with `rae build --target wasm` and calls them from host.mjs.
open frames/Frames

func add(a: view Int, b: view Int) ret Int {
  ret a + b
}

func greet(name: view String, times: view Int) ret String {
  var text: String = ""
  loop var i: Int = 0, i < times, ++i {
    text = "{text}Hello, {name}! "
  }
  ret text.trim()
}

# Values that cross as their binary encoding (docs/wasm-interfaces.md §2):
# the frame types are the `frames` package (tests/wasmFrames), which the
# native host in tests/wasmEmbedHost imports too.
func summarize(frame: view AppFrameIn) ret AppFrameOut {
  var total: Int = 0
  var names: String = ""
  loop let command: view Command in frame.commands {
    total = total + (command.count as Int)
    names = "{names}{command.name};"
  }
  if let note: view String = frame.note {
    names = "{names}({note})"
  }
  var mood: Mood = frame.mood
  if total > 10 {
    mood = Mood.busy
  }
  ret AppFrameOut { total: total, names: names, mood: mood }
}

func doubled(values: copy List(Int)) ret List(Int) {
  var out: List(Int) = List.create(Int, cap: values.length + 1)
  loop let value: view Int in values {
    out.add(value: value * 2)
  }
  ret out
}

func flip(mood: copy Mood) ret Mood {
  if mood is Mood.calm {
    ret Mood.busy
  }
  ret Mood.calm
}

# A typed host import (docs/wasm-interfaces.md §6): the pack lists it under
# `imports: "game.describe"`, so it is the WASM import `rae.describe` in the
# capability `game`, its Command argument and result crossing encoded.
func describe(command: view Command, factor: view Int) unsafe extern("raeHostDescribe") ret Command

func useDescribe(command: view Command, factor: copy Int) ret Command {
  unsafe {
    ret describe(command: command, factor: factor)
  }
}
