func rae_ext_benchmarkOpaqueIndex(index: Int) unsafe extern ret Int

# The constant-access scenario's index, laundered through C so the optimiser
# cannot see it is 137, fold the bounds check away and measure nothing.
func opaqueIndex(index: view Int) ret Int {
  unsafe {
    ret rae_ext_benchmarkOpaqueIndex(index: index)
  }
}

type Particle {
  px: Int
  py: Int
  pz: Int
  vx: Int
  vy: Int
  vz: Int
  mass: Int
  flags: Int
}

func makeInts(size: view Int) ret List(Int) {
  var values: List(Int) = createList(Int, cap: size)
  var index: Int = 0
  loop index < size {
    values.add(value: (index * 17 + 3) % 1009)
    index = index + 1
  }
  ret values
}

func makeParticles(size: view Int) ret List(Particle) {
  var particles: List(Particle) = createList(Particle, cap: size)
  var index: Int = 0
  loop index < size {
    particles.add(value: Particle {
      px: index % 97
      py: index % 89
      pz: index % 83
      vx: index % 79
      vy: index % 73
      vz: index % 71
      mass: index % 67
      flags: index % 61
    })
    index = index + 1
  }
  ret particles
}

func report(name: view String, startNs: view Int, checksum: view Int) {
  let elapsed: Int = nowNs() - startNs
  log("RESULT,rae,{name},{elapsed},{checksum}")
}

func intSequential(values: view List(Int), passes: view Int) {
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var pass: Int = 0
  loop pass < passes {
    var index: Int = 0
    loop index < values.length {
      if let value: Int = values.copyAt(index: index) {
        checksum = checksum + value
      }
      index = index + 1
    }
    pass = pass + 1
  }
  report(name: "int_sequential_optional", startNs: startNs, checksum: checksum)
}

func intCollection(values: view List(Int), passes: view Int) {
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var pass: Int = 0
  loop pass < passes {
    loop let value: Int in values {
      checksum = checksum + value
    }
    pass = pass + 1
  }
  report(name: "int_collection_value", startNs: startNs, checksum: checksum)
}

func intCollectionView(values: view List(Int), passes: view Int) {
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var pass: Int = 0
  loop pass < passes {
    loop let value: view Int in values {
      checksum = checksum + value
    }
    pass = pass + 1
  }
  report(name: "int_collection_view", startNs: startNs, checksum: checksum)
}

func intConstant(values: view List(Int), operations: view Int) {
  let constantIndex: Int = opaqueIndex(index: 137)
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var iteration: Int = 0
  loop iteration < operations {
    if let value: Int = values.copyAt(index: constantIndex) {
      checksum = checksum + value
    }
    iteration = iteration + 1
  }
  report(name: "int_constant_optional", startNs: startNs, checksum: checksum)
}

func intStrided(values: view List(Int), operations: view Int) {
  # The divisor goes through opaqueIndex so `% length` is a real division in
  # every language, not a mask the C optimiser derives from the constant 65 536.
  let divisor: Int = opaqueIndex(index: values.length)
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var index: Int = 0
  var iteration: Int = 0
  loop iteration < operations {
    if let value: Int = values.copyAt(index: index) {
      checksum = checksum + value
    }
    index = (index + 4) % divisor
    iteration = iteration + 1
  }
  report(name: "int_strided_optional", startNs: startNs, checksum: checksum)
}

func intRandom(values: view List(Int), operations: view Int) {
  # The divisor goes through opaqueIndex so `% length` is a real division in
  # every language, not a mask the C optimiser derives from the constant 65 536.
  let divisor: Int = opaqueIndex(index: values.length)
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var iteration: Int = 0
  loop iteration < operations {
    let index: Int = (iteration * 48271 + 17) % divisor
    if let value: Int = values.copyAt(index: index) {
      checksum = checksum + value
    }
    iteration = iteration + 1
  }
  report(name: "int_random_optional", startNs: startNs, checksum: checksum)
}

func intMostlyValid(values: view List(Int), operations: view Int) {
  # The divisor goes through opaqueIndex so `% length` is a real division in
  # every language, not a mask the C optimiser derives from the constant 65 536.
  let divisor: Int = opaqueIndex(index: values.length)
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var iteration: Int = 0
  loop iteration < operations {
    # Divide only for a valid index, as the C and Rust versions do: computing
    # `% divisor` on every iteration and then overwriting it did extra work.
    var index: Int = values.length
    if iteration % 1000 is not 0 {
      index = (iteration * 48271 + 17) % divisor
    }
    if let value: Int = values.copyAt(index: index) {
      checksum = checksum + value
    }
    iteration = iteration + 1
  }
  report(name: "int_mostly_valid_optional", startNs: startNs, checksum: checksum)
}

func intMixedInvalid(values: view List(Int), operations: view Int) {
  # The divisor goes through opaqueIndex so `% length` is a real division in
  # every language, not a mask the C optimiser derives from the constant 65 536.
  let divisor: Int = opaqueIndex(index: values.length)
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var iteration: Int = 0
  loop iteration < operations {
    # Divide only for a valid index, as the C and Rust versions do.
    var index: Int = -1
    if iteration % 4 is not 0 {
      index = (iteration * 48271 + 17) % divisor
    }
    if let value: Int = values.copyAt(index: index) {
      checksum = checksum + value
    }
    iteration = iteration + 1
  }
  report(name: "int_mixed_invalid_optional", startNs: startNs, checksum: checksum)
}

func structSequentialValue(particles: view List(Particle), passes: view Int) {
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var pass: Int = 0
  loop pass < passes {
    var index: Int = 0
    loop index < particles.length {
      if let particle: Particle = particles.copyAt(index: index) {
        checksum = checksum + particle.px + particle.vz + particle.mass
      }
      index = index + 1
    }
    pass = pass + 1
  }
  report(name: "struct_sequential_optional_value", startNs: startNs, checksum: checksum)
}

func structSequentialView(particles: view List(Particle), passes: view Int) {
  let startNs: Int = nowNs()
  var checksum: Int = 0
  var pass: Int = 0
  loop pass < passes {
    var index: Int = 0
    loop index < particles.length {
      if let particle: view Particle => particles.viewAt(index: index) {
        checksum = checksum + particle.px + particle.vz + particle.mass
      }
      index = index + 1
    }
    pass = pass + 1
  }
  report(name: "struct_sequential_optional_view", startNs: startNs, checksum: checksum)
}

