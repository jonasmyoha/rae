pack StringIsBytes {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Strings are bytes"
  description: "length() and sub are byte-indexed, but sub never cuts a character (a range inside é widens to the whole é), and charCount / charAt / charSub count characters. It used to print a lone byte."
  category: "Stress"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
  stress: {
    verdict: "handles"
    expect: {
      outcome: "run"
      exitCode: 0
      stdout: "length 10  charCount 6\nsub(1,1) [é]\ncharSub(1,1) [é]  charAt(5) 👋"
    }
    elsewhere: {
      python: "len is 6 (code points); s[1] is é"
      javascript: "length is 7 (UTF-16 units — the emoji counts twice); s[1] is é"
      java: "length() is 7 (UTF-16 units); charAt(1) is é"
      go: "len is 10 (bytes) like Rae, but range walks runes and utf8.RuneCountInString is 6"
      rust: "len() is 10 (bytes) like Rae, but s[1..2] PANICS at a non-boundary instead of producing garbage"
      c: "strlen is 10; s[1] is one byte of é"
    }
    fixedBy: "#75219451 — sub widens to character boundaries in the runtime; charCount/charAt/charSub in lib/String.rae"
  }
}
