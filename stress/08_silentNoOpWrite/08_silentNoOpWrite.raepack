pack SilentNoOpWrite {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Silent no-op write"
  description: "set(index: 10, …) on a 3-element list is a runtime error naming the index and the length, exit 70; a read past the end is none. It used to drop the write silently with exit 0."
  category: "Stress"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
  stress: {
    verdict: "handles"
    expect: {
      outcome: "run"
      exitCode: 1
      stdout: ""
      stderr: "runtime error: List.set: index 10 is out of range for length 3"
    }
    elsewhere: {
      python: "IndexError: list assignment index out of range"
      javascript: "the array grows to 11 with holes — a different foot gun"
      java: "IndexOutOfBoundsException"
      go: "run-time panic: index out of range [10] with length 3"
      rust: "panics: index out of bounds"
      c: "writes past the buffer — memory corruption"
    }
    fixedBy: "#77471032 — List.set/insert/remove/swapRemove trap through Core.runtimeError"
  }
}
