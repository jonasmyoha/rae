pack SilentNoOpWrite {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Silent no-op write"
  description: "set(index: 10, …) on a 3-element list is bounds-checked and ignored, with a warning on stderr naming the index and the length; the program continues. It used to ignore the write with no word at all."
  category: "Stress"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
  stress: {
    verdict: "handles"
    expect: {
      outcome: "run"
      exitCode: 0
      stdout: "length 3"
      stderr: "warning: List.set: index 10 is out of range for length 3"
    }
    elsewhere: {
      python: "IndexError: list assignment index out of range"
      javascript: "the array grows to 11 with holes — a different foot gun"
      java: "IndexOutOfBoundsException"
      go: "run-time panic: index out of range [10] with length 3"
      rust: "panics: index out of bounds"
      c: "writes past the buffer — memory corruption"
    }
    fixedBy: "#77471032 — List.set/insert/remove/swapRemove bounds-check and warn through Core.runtimeWarning (the same in every build profile)"
  }
}
