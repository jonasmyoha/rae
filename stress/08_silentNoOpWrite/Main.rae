# Foot gun: writing past the end of a list.
#
# `xs` has three elements; index 10 does not exist. Today `set` does
# nothing at all: no error, no growth, exit 0 — the write is dropped on the
# floor. This case asserts that current behaviour.
func main() {
  var xs: List(Int) = [1, 2, 3]
  xs.set(index: 10, value: 5)
  log("length {xs.length}")
}
