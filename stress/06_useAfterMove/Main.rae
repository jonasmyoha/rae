# Foot gun: hand a value to a function that takes it over, then keep using
# it.
#
# `own` means the callee owns the list from here on — it will free it when
# it is done. So the caller's `xs` is gone after the call, and reading it is
# refused at compile time: "use of moved value". A caller that needs the
# list afterwards passes a copy, or the callee declares `copy T`.
func consume(xs: own List(Int)) ret Int {
  xs.add(value: 4)
  ret xs.length
}

func main() {
  var xs: List(Int) = [1, 2, 3]
  let n: Int = consume(xs: xs)
  log("caller sees {xs.length}, callee returned {n}")
}
