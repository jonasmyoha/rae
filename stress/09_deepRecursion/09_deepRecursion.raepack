pack DeepRecursion {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Deep recursion"
  description: "Ten million frames of recursion. The runtime reports `rae: stack overflow (deep recursion?) in <program>` and exits non-zero. It used to die with exit 1 and not one word."
  category: "Stress"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
  stress: {
    verdict: "handles"
    expect: {
      outcome: "run"
      exitCode: 1
      stdout: ""
      stderrMatches: "^rae: stack overflow \\(deep recursion\\?\\) in .*Main\\.rae$"
    }
    elsewhere: {
      python: "RecursionError with a traceback (at a depth of about 1,000 by default)"
      javascript: "RangeError: Maximum call stack size exceeded"
      java: "StackOverflowError with a stack trace"
      go: "succeeds — goroutine stacks grow on demand (up to 1 GB)"
      rust: "aborts with `thread main has overflowed its stack`"
      c: "segmentation fault, no message"
    }
    fixedBy: "#26662952 — the crash handler runs on a sigaltstack (main thread + every spawned worker) and tells a stack fault from a bad address"
  }
}
