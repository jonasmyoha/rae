# Foot gun: recursion ten million frames deep.
#
# The stack runs out. Rae's runtime catches the overflow on an alternate
# signal stack and says so in one line — `rae: stack overflow (deep
# recursion?) in <program>` — and exits non-zero. A genuine bad-address
# fault is reported as `segmentation fault` instead, with a C backtrace, so
# the two are never confused.
func down(n: view Int) ret Int {
  if n is 0 {
    ret 0
  }
  ret 1 + down(n: n - 1)
}

func main() {
  log("depth 10000000: {down(n: 10000000)}")
}
