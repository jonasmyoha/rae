pack IntegerOverflow {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Integer overflow and division by zero"
  description: "Division by zero is a runtime error with a source position and exit 70 (a constant zero does not compile); overflow traps in the dev profile and wraps in release. It used to return 0 with exit 0."
  category: "Stress"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
  stress: {
    verdict: "handles"
    expect: {
      outcome: "run"
      exitCode: 1
      stdout: "wrapped: -9223372036854775808"
      stderrMatches: "^.*Main\\.rae:[0-9]+: runtime error: division by zero$"
    }
    elsewhere: {
      python: "no overflow (arbitrary precision); ZeroDivisionError on 7 / 0"
      javascript: "no Int: 2**63 loses precision as a double; 7 / 0 is Infinity"
      java: "wraps to Long.MIN_VALUE; ArithmeticException on 7 / 0"
      go: "wraps; run-time panic on 7 / 0 (a constant 7 / 0 is a compile error)"
      rust: "panics in debug, wraps in release; always panics on 7 / 0 (constant: compile error)"
      c: "signed overflow is undefined behaviour; 7 / 0 is undefined behaviour (usually SIGFPE)"
    }
    fixedBy: "#82802533 — rae_int_div/mod/add/sub/mul in rae_runtime.h, the constant-zero divisor error in sema"
  }
}
