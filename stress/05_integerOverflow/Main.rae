# Foot gun: arithmetic that has no right answer — the largest Int plus one,
# and a division by zero.
#
# Rae defines both (docs/integer-semantics.md). Dividing by zero is a runtime
# error in every profile: one line naming the source position, exit code 70,
# never a silent 0. (A divisor that is a constant zero does not even compile;
# this one is computed so the runtime has to catch it.) Overflow is checked
# in the dev profile — `rae run --profile dev` stops at `big + one` with
# "integer overflow in +" — and wraps two's-complement in release, which is
# what this run (release) prints on the first line.
import Sys

func main() {
  var big: Int = 9223372036854775807
  let one: Int = Sys.argCount() + 1
  big = big + one
  log("wrapped: {big}")
  let zero: Int = one - 1
  let bad: Int = 7 / zero
  log("div0: {bad}")
}
