pack ViewIntoGrowingList {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "View into a growing list"
  description: "A view of a list element passed to a call together with the list as mod; the call grows the list and reads the view."
  category: "Stress"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
  stress: {
    verdict: "handles"
    expect: {
      outcome: "compile-error"
      diagnostic: "cannot mutate a List while a `viewAt`/`modAt` binding aliases one of its elements"
    }
    elsewhere: {
      python: "runs; ints are values, the call reads the number it was given"
      javascript: "runs; numbers are values, nothing dangles"
      java: "runs; the Integer is a value object the list does not own"
      go: "runs; a pointer into the old backing array keeps that array alive"
      rust: "compile error: cannot borrow `numbers` as mutable because it is also borrowed as immutable"
      c: "undefined behaviour: the pointer into the realloc'd array dangles"
    }
    fixedBy: "0.2.4: a call argument that passes the borrowed List as `mod` counts as a change to it (sema_arg_lends_collection_mod)"
  }
}
