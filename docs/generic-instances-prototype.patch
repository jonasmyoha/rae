+        case AST_EXPR_OBJECT: for (const AstObjectField* f = e->as.object_literal.fields; f; f = f->next) cov_expr(f->value, w); break;
+        case AST_EXPR_INTERP: for (const AstInterpPart* p = e->as.interp.parts; p; p = p->next) cov_expr(p->value, w); break;
