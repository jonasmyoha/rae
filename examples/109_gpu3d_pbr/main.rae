# 3D Renderer — PBR raster scene (unified renderer, raster backend).
#
# One of three seed 3D examples sharing ONE renderer library:
#   107 raymarch · 108 procedural raymarch · 109 this PBR rasterizer.
#
# This is the native render-pass path: a PBR material-study grid (5x5
# spheres sweeping metallic x roughness), a rotating emissive torus, and a
# ground plane. MSAA 4x, Depth32Float, Cook-Torrance GGX + hemisphere
# ambient + ACES tonemap.
#
# The scene is authored once as backend-agnostic `scene3d` components
# (Transform3d / Material3d / MeshRenderer with typed MeshHandles) and
# rendered by one `renderScene` call — no hand-rolled per-entity draw loop
# and no packed magic-float blocks in app code.
#
# WORLD CONVENTION: right-handed Z-up (Blender), per
# docs/coordinate-system.md. +X right, +Y forward, +Z up. The orbit camera
# yaws about +Z and starts on -Y (Blender front view).
#
# Controls: drag to orbit, mouse wheel to zoom.
# Compiled-target only; needs wgpu-native + SDL3.
#   rae run --target compiled main.rae
# Headless screenshot:
#   RAE_SDL_HEADLESS_MS=2000 RAE_GPU2D_SCREENSHOT=/tmp/3d.bmp rae run ...
import core
import math
import gpu2d
import vec3
open scene3d
open gpu3d
open math3d
open mesh3d

func uploadMeshData(m: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: m.verts, vertCount: m.vertCount, indices: m.indices)
}

# Build the material-study scene: a metallic x roughness sphere grid, an
# emissive torus above it, and a ground plane.
func buildScene(sphere: view MeshHandle, torus: view MeshHandle, ground: view MeshHandle) ret Scene3d {
  var scene: Scene3d = createScene3d()
  let noEmit: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRot: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let unit: Vec3 = vec3.create(x: 1.0, y: 1.0, z: 1.0)

  # 5x5 grid: rows sweep metallic, columns sweep roughness.
  var row: Int = 0
  loop row < 5 {
    var col: Int = 0
    loop col < 5 {
      let metallic: Float = row.toFloat() / 4.0
      var roughness: Float = col.toFloat() / 4.0
      if roughness < 0.05 {
        roughness = 0.05
      }
      let mat: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.9, y: 0.25, z: 0.2), metallic: metallic, roughness: roughness, emission: noEmit)
      # Z-up: the grid spreads across X (right) and Y (forward), lifted on Z.
      let pos: Vec3 = vec3.create(x: (col.toFloat() - 2.0) * 2.4, y: (row.toFloat() - 2.0) * 2.4, z: 0.5)
      let e: Int = addMeshInstance(scene: scene, mesh: sphere, material: mat, position: pos, rotation: noRot, scale: unit)
      col = col + 1
    }
    row = row + 1
  }

  # Emissive metallic torus hovering above the grid (+Z is up).
  let torusMat: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.85, y: 0.86, z: 0.9), metallic: 1.0, roughness: 0.18, emission: vec3.create(x: 0.05, y: 0.12, z: 0.3))
  let torusE: Int = addMeshInstance(scene: scene, mesh: torus, material: torusMat, position: vec3.create(x: 0.0, y: 0.0, z: 3.6), rotation: noRot, scale: unit)

  # Ground plane just below the spheres.
  let groundMat: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.42, y: 0.43, z: 0.45), metallic: 0.0, roughness: 0.9, emission: noEmit)
  let groundE: Int = addMeshInstance(scene: scene, mesh: ground, material: groundMat, position: vec3.create(x: 0.0, y: 0.0, z: 0.0 - 0.7), rotation: noRot, scale: unit)
  ret scene
}

func main() ret Int {
  gpu2d.initWindow(width: 1280, height: 800, title: "Rae 3D — PBR raster (Z-up)")

  let sphereData: MeshData = makeSphere(rings: 32, segments: 48)
  let planeData: MeshData = makePlane(size: 40.0, segments: 1)
  let torusData: MeshData = makeTorus(majorR: 1.0, minorR: 0.35, majorSegs: 96, minorSegs: 48)
  let sphere: MeshHandle = uploadMeshData(m: sphereData)
  let ground: MeshHandle = uploadMeshData(m: planeData)
  let torus: MeshHandle = uploadMeshData(m: torusData)

  var scene: Scene3d = buildScene(sphere: sphere, torus: torus, ground: ground)
  # The torus is the last-but-one instance; remember its entity so the
  # animation below can spin it in place.
  let torusEntity: Int = scene.meshRenderers.at(index: scene.meshRenderers.length - 2).entity

  var camera: Camera3d = defaultCamera3d()
  var light: Light3d = defaultLight3d()

  # Orbit camera: yaw about +Z, pitch raises toward +Z.
  var yaw: Float = 0.0
  var pitch: Float = 0.35
  var dist: Float = 14.0
  var lastX: Float = 0.0
  var lastY: Float = 0.0
  var dragging: Bool = false
  let startT: Float = gpu2d.nowSeconds()

  loop not gpu2d.pollClose() {
    # ---- input: orbit camera -----------------------------------------
    let px: Float = gpu2d.pointerX()
    let py: Float = gpu2d.pointerY()
    if gpu2d.pointerDown() {
      if dragging {
        yaw = yaw + (px - lastX) * 0.008
        pitch = pitch + (py - lastY) * 0.008
        if pitch > 1.45 {
          pitch = 1.45
        }
        if pitch < 0.05 {
          pitch = 0.05
        }
      }
      dragging = true
    } else {
      dragging = false
    }
    lastX = px
    lastY = py
    dist = dist - gpu2d.wheelMove() * 0.8
    if dist < 4.0 {
      dist = 4.0
    }
    if dist > 40.0 {
      dist = 40.0
    }

    let t: Float = gpu2d.nowSeconds() - startT
    camera.position = orbitEye(targetX: camera.target.x, targetY: camera.target.y, targetZ: camera.target.z, yaw: yaw, pitch: pitch, dist: dist)

    # Slowly orbiting sun keeps the specular highlight sweeping. Z-up: the
    # sun points downward (-Z) and circles in XY. The -Y bias keeps the
    # light behind the default camera so the GGX lobe reflects back toward
    # the viewer — without it the highlights face away and the material
    # grid reads flat.
    let sunA: Float = t * 0.15
    light.sunDir = vec3.create(x: 0.0 - math.cos(x: sunA) * 0.6, y: 0.0 - 0.7 - math.sin(x: sunA) * 0.3, z: 0.0 - 1.0)

    # Spin the torus about +Z and tumble it about +X.
    var torusT: Transform3d = scene.transforms.at(index: torusEntity)
    torusT.rotation = vec3.create(x: t * 0.4, y: 0.0, z: t * 0.6)
    scene.transforms.set(index: torusEntity, value: torusT)

    let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
    beginScene(camera: camera, light: light, aspect: aspect, time: t)
    renderScene(scene: scene)
    endFrame()
  }
  shutdown()
  gpu2d.closeWindow()
  ret 0
}
