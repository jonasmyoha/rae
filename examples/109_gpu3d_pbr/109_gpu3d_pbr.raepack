pack Gpu3dPbr {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — PBR Raster Scene — Claude Fable"
  description: "Initial example authored by Claude Fable. WebGPU render-pass 3D renderer seed: a PBR material-study grid (5x5 spheres sweeping metallic x roughness), a rotating emissive torus, and a ground plane. MSAA 4x, Depth32Float, Cook-Torrance GGX + hemisphere ambient + ACES tonemap, with meshes and matrices generated in Rae. Interactive orbit camera: drag to rotate, wheel to zoom. Runs as a desktop Compiled build or browser WASM."
  category: "3D Renderer"
  wasmWebApp: "true"
  display: {
    width: 960
    height: 600
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
    target wasm: {
      label: "WASM (WebGPU)"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
