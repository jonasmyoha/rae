# 3D Renderer — PBR scene with persistent ECS/.raescene UI.
#
# Frame ownership is explicit: Scene3d renders first, gpu3d.endPass submits
# without presenting, GPU2D loads the resolved color target and paints UiWorld,
# then GPU2D presents once. UI hit-testing has priority over orbit input.
import core
import gpu2d
import math
import sdf_text
import sdl3
import vec3
open gpu3d
open math3d
open mesh3d
open scene3d
open ui/ecs
open ui/input_gpu2d
open ui/layout
open ui/render_gpu2d
open ui/scene_file
open ui/scene_loader
open ui/theme_resolved
open ui/transform
import ui/ecs
import ui/input_gpu2d
import ui/layout
import ui/render_gpu2d
import ui/scene
import ui/scene_file
import ui/scene_loader
import ui/theme_resolved
import ui/transform

let designW: Float = 1280.0
let designH: Float = 800.0

enum CameraMode {
  orbit
  free
}

type CameraController {
  mode: CameraMode
  yaw: Float
  orbitPitch: Float
  freePitch: Float
  distance: Float
  freePosition: Vec3
}

func createCameraController(camera: view Camera3d) ret CameraController {
  ret CameraController {
    mode: CameraMode.orbit
    yaw: 0.0
    orbitPitch: 0.38
    freePitch: 0.0 - 0.38
    distance: 12.5
    freePosition: camera.position
  }
}

func cameraForward(controller: view CameraController) ret Vec3 {
  let cp: Float = math.cos(x: controller.freePitch)
  ret vec3.create(
    x: (0.0 - math.sin(x: controller.yaw)) * cp
    y: math.cos(x: controller.yaw) * cp
    z: math.sin(x: controller.freePitch)
  )
}

func cameraRight(controller: view CameraController) ret Vec3 {
  let forward: Vec3 = cameraForward(controller: controller)
  let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
  ret vec3.vnorm(a: vec3.vcross(a: forward, b: up))
}

type DemoUiResource {
  paused: Bool
  fullMotion: Bool
  debugOpen: Bool
  activeScene: Int
  revision: Int
  appliedRevision: Int
  fpsRevision: Int
  appliedFpsRevision: Int
  fps: Int
}

func createDemoUiResource() ret DemoUiResource {
  ret DemoUiResource {
    paused: false
    fullMotion: true
    debugOpen: false
    activeScene: 1
    revision: 1
    appliedRevision: 0
    fpsRevision: 1
    appliedFpsRevision: 0
    fps: 0
  }
}

func nodeEntity(world: view UiWorld, nodeId: view String) ret EntityId {
  let found: opt Int = world.nodeIds.get(k: nodeId)
  if found is none { ret noEntity() }
  let raw: Int = found
  ret entityId(v: raw)
}

func setNodeActive(world: mod UiWorld, nodeId: view String, value: view Bool) {
  let entity: EntityId = nodeEntity(world: world, nodeId: nodeId)
  if isNone(this: entity) { ret }
  let active: Active = { value: value }
  componentSet(this: world.actives, entity: entity, data: active)
}

func setNodeText(world: mod UiWorld, nodeId: view String, value: view String) {
  let entity: EntityId = nodeEntity(world: world, nodeId: nodeId)
  if isNone(this: entity) { ret }
  if componentHas(this: world.texts, entity: entity) is false { ret }
  let text: mod Text => componentMod(this: world.texts, entity: entity)
  text.text = "{value}"
}

# Narrow UI diff: persistent entities are patched only when their typed
# resource revision changes. No scene remount or per-frame widget rebuilding.
func syncDemoUi(world: mod UiWorld, state: mod DemoUiResource) ret Bool {
  var layoutDirty: Bool = false
  if state.appliedRevision is not state.revision {
    setNodeActive(world: world, nodeId: "PauseLayer", value: state.paused)
    setNodeActive(world: world, nodeId: "DebugPanel", value: state.debugOpen)
    setNodeActive(world: world, nodeId: "Scene1Selected", value: state.activeScene is 1)
    setNodeActive(world: world, nodeId: "Scene2Selected", value: state.activeScene is 2)
    setNodeActive(world: world, nodeId: "Scene3Selected", value: state.activeScene is 3)
    if state.paused {
      setNodeText(world: world, nodeId: "PauseLabel", value: "Resume")
    } else {
      setNodeText(world: world, nodeId: "PauseLabel", value: "Pause")
    }
    if state.fullMotion {
      setNodeText(world: world, nodeId: "MotionLabel", value: "Animation: Full")
    } else {
      setNodeText(world: world, nodeId: "MotionLabel", value: "Animation: Reduced")
    }
    state.appliedRevision = state.revision
    layoutDirty = true
  }
  if state.appliedFpsRevision is not state.fpsRevision {
    setNodeText(world: world, nodeId: "FpsLabel", value: "fps: {state.fps}")
    state.appliedFpsRevision = state.fpsRevision
  }
  ret layoutDirty
}

func syncCameraUi(world: mod UiWorld, controller: mod CameraController, camera: view Camera3d) {
  var modeName: String = "Orbit"
  var pitchDeg: Int = (controller.orbitPitch * 57.2957795).toInt()
  if controller.mode is CameraMode.free {
    modeName = "WASD"
    pitchDeg = (controller.freePitch * 57.2957795).toInt()
  }
  let yawDeg: Int = (controller.yaw * 57.2957795).toInt()
  let fovDeg: Int = camera.fovYDeg.toInt()
  let px: Int = camera.position.x.toInt()
  let py: Int = camera.position.y.toInt()
  let pz: Int = camera.position.z.toInt()
  setNodeText(world: world, nodeId: "CameraModeLabel", value: modeName)
  setNodeText(world: world, nodeId: "CameraFovLabel", value: "FOV {fovDeg}°")
  setNodeText(world: world, nodeId: "CameraPositionLabel", value: "Pos {px}, {py}, {pz}")
  setNodeText(world: world, nodeId: "CameraYawLabel", value: "Yaw {yawDeg}°")
  setNodeText(world: world, nodeId: "CameraPitchLabel", value: "Pitch {pitchDeg}°")
}

func toggleCameraMode(controller: mod CameraController, camera: mod Camera3d) {
  if controller.mode is CameraMode.orbit {
    controller.mode = CameraMode.free
    controller.freePosition = camera.position
    controller.freePitch = 0.0 - controller.orbitPitch
  } else {
    let forward: Vec3 = cameraForward(controller: controller)
    controller.orbitPitch = 0.0 - controller.freePitch
    if controller.orbitPitch < 0.05 { controller.orbitPitch = 0.05 }
    if controller.orbitPitch > 1.45 { controller.orbitPitch = 1.45 }
    camera.target = vec3.vadd(a: controller.freePosition, b: vec3.vscale(a: forward, s: controller.distance))
    controller.mode = CameraMode.orbit
  }
}

func dispatchUiActions(input: view UiInput, state: mod DemoUiResource, controller: mod CameraController, camera: mod Camera3d) {
  var i: Int = 0
  loop i < input.events.length {
    let event: UiActionEvent = rae_ext_rae_buf_get(buf: input.events.data, index: i)
    if event.actionId.equals(other: "scene.pause") {
      state.paused = not state.paused
      state.revision = state.revision + 1
    }
    if event.actionId.equals(other: "ui.debug") {
      state.debugOpen = not state.debugOpen
      state.revision = state.revision + 1
    }
    if event.actionId.equals(other: "animation.mode") {
      state.fullMotion = not state.fullMotion
      state.revision = state.revision + 1
    }
    if event.actionId.equals(other: "camera.mode") {
      toggleCameraMode(controller: controller, camera: camera)
    }
    if event.actionId.equals(other: "scene.select.1") {
      state.activeScene = 1
      state.revision = state.revision + 1
    }
    if event.actionId.equals(other: "scene.select.2") {
      state.activeScene = 2
      state.revision = state.revision + 1
    }
    if event.actionId.equals(other: "scene.select.3") {
      state.activeScene = 3
      state.revision = state.revision + 1
    }
    i = i + 1
  }
}

func uploadMeshData(mesh: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: mesh.verts, vertCount: mesh.vertCount, indices: mesh.indices)
}

func buildScene1(sphere: view MeshHandle, torus: view MeshHandle, ground: view MeshHandle) ret Scene3d {
  var scene: Scene3d = createScene3d()
  let zero: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let unit: Vec3 = vec3.create(x: 1.0, y: 1.0, z: 1.0)
  let red: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.88, y: 0.20, z: 0.14), metallic: 0.72, roughness: 0.20, emission: zero)
  let teal: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.08, y: 0.58, z: 0.55), metallic: 0.32, roughness: 0.32, emission: zero)
  let gold: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.95, y: 0.58, z: 0.12), metallic: 0.92, roughness: 0.16, emission: vec3.create(x: 0.05, y: 0.018, z: 0.0))
  let metaball: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.04, y: 0.36, z: 0.92), metallic: 0.72, roughness: 0.14, emission: vec3.create(x: 0.0, y: 0.018, z: 0.075))
  let floor: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.20, y: 0.23, z: 0.28), metallic: 0.05, roughness: 0.86, emission: zero)
  let left: Int = addMeshInstance(scene: scene, mesh: sphere, material: red, position: vec3.create(x: 0.0 - 2.7, y: 0.0, z: 0.45), rotation: zero, scale: unit)
  let right: Int = addMeshInstance(scene: scene, mesh: sphere, material: teal, position: vec3.create(x: 2.7, y: 0.0, z: 0.45), rotation: zero, scale: unit)
  let center: Int = addMeshInstance(scene: scene, mesh: torus, material: gold, position: vec3.create(x: 0.0, y: 0.0, z: 1.35), rotation: zero, scale: unit)
  let plane: Int = addMeshInstance(scene: scene, mesh: ground, material: floor, position: vec3.create(x: 0.0, y: 0.0, z: 0.0 - 0.75), rotation: zero, scale: unit)
  let ballScale: Vec3 = vec3.create(x: 1.48, y: 1.48, z: 1.48)
  let ball1: Int = addSdfInstance(scene: scene, shape: 0, material: metaball, position: vec3.create(x: 3.5, y: 2.1, z: 2.0), scale: ballScale, noise: 0.0)
  let ball2: Int = addSdfInstance(scene: scene, shape: 0, material: metaball, position: vec3.create(x: 4.3, y: 2.3, z: 2.7), scale: ballScale, noise: 0.0)
  let ball3: Int = addSdfInstance(scene: scene, shape: 0, material: metaball, position: vec3.create(x: 5.2, y: 2.1, z: 2.1), scale: ballScale, noise: 0.0)
  let ball4: Int = addSdfInstance(scene: scene, shape: 0, material: metaball, position: vec3.create(x: 4.0, y: 2.4, z: 1.3), scale: ballScale, noise: 0.0)
  let ball5: Int = addSdfInstance(scene: scene, shape: 0, material: metaball, position: vec3.create(x: 4.9, y: 2.4, z: 1.3), scale: ballScale, noise: 0.0)
  ret scene
}

func buildScene2(sphere: view MeshHandle, torus: view MeshHandle, ground: view MeshHandle) ret Scene3d {
  var scene: Scene3d = createScene3d()
  let zero: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let unit: Vec3 = vec3.create(x: 1.0, y: 1.0, z: 1.0)
  let ink: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.025, y: 0.05, z: 0.10), metallic: 0.55, roughness: 0.30, emission: zero)
  let cyan: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.05, y: 0.72, z: 0.90), metallic: 0.65, roughness: 0.16, emission: vec3.create(x: 0.01, y: 0.06, z: 0.08))
  let coral: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.96, y: 0.24, z: 0.22), metallic: 0.25, roughness: 0.24, emission: zero)
  let white: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.90, y: 0.94, z: 1.0), metallic: 0.15, roughness: 0.12, emission: zero)
  let floor: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.045, y: 0.07, z: 0.12), metallic: 0.15, roughness: 0.72, emission: zero)
  let plane: Int = addMeshInstance(scene: scene, mesh: ground, material: floor, position: vec3.create(x: 0.0, y: 0.0, z: 0.0 - 0.9), rotation: zero, scale: unit)
  let core: Int = addMeshInstance(scene: scene, mesh: sphere, material: white, position: vec3.create(x: 0.0, y: 0.0, z: 1.8), rotation: zero, scale: vec3.create(x: 1.15, y: 1.15, z: 1.15))
  let torusLow: Int = addMeshInstance(scene: scene, mesh: torus, material: cyan, position: vec3.create(x: 0.0, y: 0.0, z: 0.25), rotation: zero, scale: vec3.create(x: 1.22, y: 1.22, z: 1.22))
  let torusMid: Int = addMeshInstance(scene: scene, mesh: torus, material: coral, position: vec3.create(x: 0.0, y: 0.0, z: 1.8), rotation: zero, scale: vec3.create(x: 1.55, y: 1.55, z: 1.55))
  let torusHigh: Int = addMeshInstance(scene: scene, mesh: torus, material: ink, position: vec3.create(x: 0.0, y: 0.0, z: 3.35), rotation: zero, scale: vec3.create(x: 1.18, y: 1.18, z: 1.18))
  var i: Int = 0
  loop i < 12 {
    let angle: Float = i.toFloat() * 0.5235988
    var material: Int = cyan
    if i % 2 is 1 { material = coral }
    let satellite: Int = addMeshInstance(
      scene: scene, mesh: sphere, material: material,
      position: vec3.create(x: math.cos(x: angle) * 5.0, y: math.sin(x: angle) * 3.2, z: 1.45 + math.sin(x: angle * 3.0) * 1.1),
      rotation: zero, scale: vec3.create(x: 0.42, y: 0.42, z: 0.42)
    )
    i = i + 1
  }
  ret scene
}

func buildScene3(sphere: view MeshHandle, torus: view MeshHandle, ground: view MeshHandle) ret Scene3d {
  var scene: Scene3d = createScene3d()
  let zero: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let unit: Vec3 = vec3.create(x: 1.0, y: 1.0, z: 1.0)
  let violet: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.42, y: 0.16, z: 0.86), metallic: 0.68, roughness: 0.22, emission: vec3.create(x: 0.025, y: 0.006, z: 0.06))
  let amber: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.98, y: 0.48, z: 0.06), metallic: 0.78, roughness: 0.17, emission: vec3.create(x: 0.05, y: 0.012, z: 0.0))
  let jade: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.04, y: 0.62, z: 0.36), metallic: 0.35, roughness: 0.28, emission: zero)
  let graphite: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.09, y: 0.10, z: 0.14), metallic: 0.72, roughness: 0.38, emission: zero)
  let floor: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.13, y: 0.09, z: 0.16), metallic: 0.08, roughness: 0.82, emission: zero)
  let plane: Int = addMeshInstance(scene: scene, mesh: ground, material: floor, position: vec3.create(x: 0.0, y: 0.0, z: 0.0 - 0.8), rotation: zero, scale: unit)
  var row: Int = 0
  loop row < 4 {
    var col: Int = 0
    loop col < 5 {
      let stagger: Float = (row % 2).toFloat() * 0.9
      let x: Float = (col.toFloat() - 2.0) * 2.15 + stagger
      let y: Float = (row.toFloat() - 1.5) * 2.0
      let height: Float = 0.4 + (row + col).toFloat() * 0.26
      var material: Int = violet
      if (row + col) % 3 is 1 { material = amber }
      if (row + col) % 3 is 2 { material = jade }
      let orb: Int = addMeshInstance(scene: scene, mesh: sphere, material: material, position: vec3.create(x: x, y: y, z: height), rotation: zero, scale: vec3.create(x: 0.62, y: 0.62, z: 0.62))
      col = col + 1
    }
    row = row + 1
  }
  let haloA: Int = addMeshInstance(scene: scene, mesh: torus, material: graphite, position: vec3.create(x: 0.0 - 3.2, y: 0.0, z: 2.1), rotation: zero, scale: vec3.create(x: 0.82, y: 0.82, z: 0.82))
  let haloB: Int = addMeshInstance(scene: scene, mesh: torus, material: amber, position: vec3.create(x: 0.0, y: 0.0, z: 3.1), rotation: zero, scale: vec3.create(x: 0.95, y: 0.95, z: 0.95))
  let haloC: Int = addMeshInstance(scene: scene, mesh: torus, material: graphite, position: vec3.create(x: 3.2, y: 0.0, z: 2.1), rotation: zero, scale: vec3.create(x: 0.82, y: 0.82, z: 0.82))
  ret scene
}

func animateScene(scene: mod Scene3d, sceneId: view Int, time: view Float) {
  var i: Int = 1
  loop i < scene.meshRenderers.length {
    let renderer: MeshRenderer = scene.meshRenderers.at(index: i)
    var transform: Transform3d = scene.transforms.at(index: renderer.entity)
    let phase: Float = i.toFloat() * 0.173 + sceneId.toFloat()
    transform.rotation = vec3.create(x: time * (0.08 + sceneId.toFloat() * 0.04), y: math.sin(x: time * 0.18 + phase) * 0.28, z: time * (0.12 + (i % 5).toFloat() * 0.025))
    scene.transforms.set(index: renderer.entity, value: transform)
    i = i + 1
  }
}

func animateScene1(scene: mod Scene3d, time: view Float) {
  let torusEntity: Int = scene.meshRenderers.at(index: 2).entity
  var torusTransform: Transform3d = scene.transforms.at(index: torusEntity)
  torusTransform.rotation = vec3.create(x: time * 0.35, y: 0.0, z: time * 0.62)
  scene.transforms.set(index: torusEntity, value: torusTransform)
  var i: Int = 0
  loop i < scene.sdfPrimitives.length {
    let sdf: SdfPrimitive = scene.sdfPrimitives.at(index: i)
    var transform: Transform3d = scene.transforms.at(index: sdf.entity)
    let phase: Float = i.toFloat() * 1.2566371
    transform.position = vec3.create(
      x: 4.55 + math.cos(x: time * 0.72 + phase) * (1.05 + (i % 2).toFloat() * 0.24),
      y: 2.25 + math.sin(x: time * 0.41 + phase * 1.7) * 0.45,
      z: 2.05 + math.sin(x: time * 0.83 + phase) * 0.85
    )
    let radius: Float = 1.45 + math.sin(x: time * 0.67 + phase * 2.0) * 0.16
    transform.scale = vec3.create(x: radius, y: radius, z: radius)
    scene.transforms.set(index: sdf.entity, value: transform)
    i = i + 1
  }
}

func main() ret Int {
  gpu2d.initWindow(width: 1280, height: 800, title: "Rae 3D — ECS Scene UI")
  gpu2d.setDesignResolution(width: designW, height: designH, fit: 0)

  let sphereData: MeshData = makeSphere(rings: 32, segments: 48)
  let torusData: MeshData = makeTorus(majorR: 1.55, minorR: 0.42, majorSegs: 96, minorSegs: 40)
  let planeData: MeshData = makePlane(size: 36.0, segments: 1)
  let sphere: MeshHandle = uploadMeshData(mesh: sphereData)
  let torus: MeshHandle = uploadMeshData(mesh: torusData)
  let ground: MeshHandle = uploadMeshData(mesh: planeData)
  var scene1: Scene3d = buildScene1(sphere: sphere, torus: torus, ground: ground)
  var scene2: Scene3d = buildScene2(sphere: sphere, torus: torus, ground: ground)
  var scene3: Scene3d = buildScene3(sphere: sphere, torus: torus, ground: ground)

  let base: String = "examples/110_gpu3d_ui/assets/"
  let textFont: SdfFont = sdf_text.loadSdfFont(jsonPath: "{base}Roboto-Regular.mtsdf.json", rawAtlasPath: "{base}Roboto-Regular.mtsdf.raw")
  let iconFont: SdfFont = sdf_text.loadSdfFont(jsonPath: "{base}MaterialIconsRound-Regular.mtsdf.json", rawAtlasPath: "{base}MaterialIconsRound-Regular.mtsdf.raw")
  let themeScene: Scene = loadSceneFile(path: "{base}theme.raescene")
  let theme: ResolvedTheme = parseTheme(scene: themeScene)
  setActiveThemeTokens(theme: theme)
  let gpuUi: Gpu2dUi = { textFont: textFont, iconFont: iconFont, theme: theme }

  var uiWorld: UiWorld = createUiWorld()
  uiWorld.layoutW = designW
  uiWorld.layoutH = designH
  let uiScene: Scene = loadSceneFile(path: "{base}ui.raescene")
  let uiRoot: EntityId = loadScene(world: uiWorld, scene: uiScene)
  layoutSystem(world: uiWorld)
  transformSystem(world: uiWorld)
  visualBoundsSystem(world: uiWorld, res: gpuUi)

  var uiInput: UiInput = createUiInput()
  var uiState: DemoUiResource = createDemoUiResource()
  var camera: Camera3d = defaultCamera3d()
  var cameraController: CameraController = createCameraController(camera: camera)
  let testState: String = getEnv(name: "RAE_GPU3D_UI_TEST_STATE")
  if testState.equals(other: "pause") { uiState.paused = true }
  if testState.equals(other: "debug") { uiState.debugOpen = true }
  if testState.equals(other: "scene2") { uiState.activeScene = 2 }
  if testState.equals(other: "scene3") { uiState.activeScene = 3 }
  if testState.equals(other: "free") {
    toggleCameraMode(controller: cameraController, camera: camera)
  }
  let initialUiLayoutDirty: Bool = syncDemoUi(world: uiWorld, state: uiState)
  if initialUiLayoutDirty {
    layoutSystem(world: uiWorld)
    transformSystem(world: uiWorld)
    visualBoundsSystem(world: uiWorld, res: gpuUi)
  }
  syncCameraUi(world: uiWorld, controller: cameraController, camera: camera)

  var light: Light3d = defaultLight3d()
  var lastX: Float = 0.0
  var lastY: Float = 0.0
  var dragging: Bool = false
  var simTime: Float = 0.0
  var lastFrame: Float = gpu2d.nowSeconds()
  var fpsAccum: Float = 0.0
  var fpsFrames: Int = 0

  loop not gpu2d.pollClose() {
    let now: Float = gpu2d.nowSeconds()
    var dt: Float = now - lastFrame
    lastFrame = now
    if dt > 0.1 { dt = 0.1 }

    updateUiInput(input: uiInput, world: uiWorld)
    dispatchUiActions(input: uiInput, state: uiState, controller: cameraController, camera: camera)
    let uiLayoutDirty: Bool = syncDemoUi(world: uiWorld, state: uiState)
    if uiLayoutDirty {
      layoutSystem(world: uiWorld)
      transformSystem(world: uiWorld)
    }
    visualBoundsSystem(world: uiWorld, res: gpuUi)

    let px: Float = gpu2d.pointerX()
    let py: Float = gpu2d.pointerY()
    let cameraInput: Bool = uiPointerCaptured(input: uiInput) is false and uiState.paused is false
    if cameraInput and gpu2d.pointerDown() {
      if dragging {
        if cameraController.mode is CameraMode.orbit {
          cameraController.yaw = cameraController.yaw + (px - lastX) * 0.008
          cameraController.orbitPitch = cameraController.orbitPitch - (py - lastY) * 0.008
          if cameraController.orbitPitch > 1.45 { cameraController.orbitPitch = 1.45 }
          if cameraController.orbitPitch < 0.05 { cameraController.orbitPitch = 0.05 }
        } else {
          cameraController.yaw = cameraController.yaw - (px - lastX) * 0.008
          cameraController.freePitch = cameraController.freePitch - (py - lastY) * 0.008
          if cameraController.freePitch > 1.45 { cameraController.freePitch = 1.45 }
          if cameraController.freePitch < 0.0 - 1.45 { cameraController.freePitch = 0.0 - 1.45 }
        }
      }
      dragging = true
    } else {
      dragging = false
    }
    lastX = px
    lastY = py
    if cameraInput {
      if cameraController.mode is CameraMode.orbit {
        cameraController.distance = cameraController.distance - gpu2d.wheelMove() * 0.8
        if sdl3.isKeyDown(key: 87) { cameraController.distance = cameraController.distance - dt * 6.0 }
        if sdl3.isKeyDown(key: 83) { cameraController.distance = cameraController.distance + dt * 6.0 }
        if sdl3.isKeyDown(key: 65) { cameraController.yaw = cameraController.yaw - dt * 1.2 }
        if sdl3.isKeyDown(key: 68) { cameraController.yaw = cameraController.yaw + dt * 1.2 }
        if sdl3.isKeyDown(key: 81) { cameraController.orbitPitch = cameraController.orbitPitch - dt * 1.2 }
        if sdl3.isKeyDown(key: 69) { cameraController.orbitPitch = cameraController.orbitPitch + dt * 1.2 }
        if cameraController.orbitPitch > 1.45 { cameraController.orbitPitch = 1.45 }
        if cameraController.orbitPitch < 0.05 { cameraController.orbitPitch = 0.05 }
        if cameraController.distance < 4.0 { cameraController.distance = 4.0 }
        if cameraController.distance > 30.0 { cameraController.distance = 30.0 }
      } else {
        let moveStep: Float = dt * 6.0
        let forward: Vec3 = cameraForward(controller: cameraController)
        let right: Vec3 = cameraRight(controller: cameraController)
        let up: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 1.0)
        if sdl3.isKeyDown(key: 87) { cameraController.freePosition = vec3.vadd(a: cameraController.freePosition, b: vec3.vscale(a: forward, s: moveStep)) }
        if sdl3.isKeyDown(key: 83) { cameraController.freePosition = vec3.vsub(a: cameraController.freePosition, b: vec3.vscale(a: forward, s: moveStep)) }
        if sdl3.isKeyDown(key: 65) { cameraController.freePosition = vec3.vsub(a: cameraController.freePosition, b: vec3.vscale(a: right, s: moveStep)) }
        if sdl3.isKeyDown(key: 68) { cameraController.freePosition = vec3.vadd(a: cameraController.freePosition, b: vec3.vscale(a: right, s: moveStep)) }
        if sdl3.isKeyDown(key: 81) { cameraController.freePosition = vec3.vsub(a: cameraController.freePosition, b: vec3.vscale(a: up, s: moveStep)) }
        if sdl3.isKeyDown(key: 69) { cameraController.freePosition = vec3.vadd(a: cameraController.freePosition, b: vec3.vscale(a: up, s: moveStep)) }
      }
    }

    if uiState.paused is false {
      var motionScale: Float = 1.0
      if uiState.fullMotion is false { motionScale = 0.25 }
      simTime = simTime + dt * motionScale
    }
    if cameraController.mode is CameraMode.orbit {
      camera.position = orbitEye(targetX: camera.target.x, targetY: camera.target.y, targetZ: camera.target.z, yaw: cameraController.yaw, pitch: cameraController.orbitPitch, dist: cameraController.distance)
    } else {
      let forward: Vec3 = cameraForward(controller: cameraController)
      camera.position = cameraController.freePosition
      camera.target = vec3.vadd(a: camera.position, b: forward)
    }
    syncCameraUi(world: uiWorld, controller: cameraController, camera: camera)
    light.sunDir = vec3.create(x: 0.0 - math.cos(x: simTime * 0.22) * 0.7, y: 0.0 - 0.7 - math.sin(x: simTime * 0.22) * 0.25, z: 0.0 - 1.0)
    if uiState.activeScene is 1 { animateScene1(scene: scene1, time: simTime) }
    if uiState.activeScene is 2 { animateScene(scene: scene2, sceneId: 2, time: simTime) }
    if uiState.activeScene is 3 { animateScene(scene: scene3, sceneId: 3, time: simTime) }

    fpsAccum = fpsAccum + dt
    fpsFrames = fpsFrames + 1
    if fpsAccum >= 0.5 {
      uiState.fps = (fpsFrames.toFloat() / fpsAccum + 0.5).toInt()
      uiState.fpsRevision = uiState.fpsRevision + 1
      fpsAccum = 0.0
      fpsFrames = 0
      let fpsLayoutDirty: Bool = syncDemoUi(world: uiWorld, state: uiState)
      if fpsLayoutDirty {
        layoutSystem(world: uiWorld)
        transformSystem(world: uiWorld)
      }
      visualBoundsSystem(world: uiWorld, res: gpuUi)
    }

    let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
    beginScene(camera: camera, light: light, aspect: aspect, time: simTime)
    if uiState.activeScene is 1 { renderScene(scene: scene1) }
    if uiState.activeScene is 2 { renderScene(scene: scene2) }
    if uiState.activeScene is 3 { renderScene(scene: scene3) }
    endPass()
    gpu2d.beginFrameLoad()
    renderSystemGpu2d(world: uiWorld, res: gpuUi)
    gpu2d.endFrame()
  }
  shutdown()
  gpu2d.closeWindow()
  ret 0
}
