# DebugGpu2dMenu — the debug menu overlay's widget builders (#918 split of
# DebugGpu2dLocal for the 1000-line cap): the node-setter helpers (offset /
# align / rect / shapes / text / sprite / layouts), the switch-row and
# button builders and buildDebugMenuOverlay itself. DebugGpu2dLocal keeps the
# DebugSystem state, the actions and the per-frame labels.
open ui/Ecs
open ui/Layer
open ui/Theme
import Json
import Gpu2d
import Gpu2dText
import SdfText
import ui/Components
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open Gpu2dCanvas
open ui/UiSystems

func setOffset(
  world: mod UiWorld
  entityId: view EntityId
  x: view Float
  y: view Float
) {
  let off: Offset = { delta: Vec2 { x: x, y: y } }
  componentSet(this: world.offsets, entityId: entityId, data: off)
}

func setAlign(
  world: mod UiWorld
  entityId: view EntityId
  x: AlignKind
  y: AlignKind
) {
  let a: Align = { x: x, y: y, hasX: true, hasY: true }
  componentSet(this: world.aligns, entityId: entityId, data: a)
}

func setFixedRect(
  world: mod UiWorld
  entityId: view EntityId
  w: view Float
  h: view Float
) {
  let r: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: w, y: h } }
  componentSet(this: world.rects, entityId: entityId, data: r)
  let s: Size = {
    w: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
    h: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
  }
  componentSet(this: world.sizes, entityId: entityId, data: s)
}

func setCircleShape(world: mod UiWorld, entityId: view EntityId, fill: view RgbaColor) {
  let sh: Shape = {
    kind: ShapeKind.circle
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    strokeDash: 0.0
    strokeGap: 0.0
    radius: 0.0
  }
  componentSet(this: world.shapes, entityId: entityId, data: sh)
}

func setRectShape(world: mod UiWorld, entityId: view EntityId, fill: view RgbaColor) {
  let sh: Shape = {
    kind: ShapeKind.rect
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    strokeDash: 0.0
    strokeGap: 0.0
    radius: 0.0
  }
  componentSet(this: world.shapes, entityId: entityId, data: sh)
}

func setRoundedShape(
  world: mod UiWorld
  entityId: view EntityId
  fill: view RgbaColor
  radius: view Float
) {
  let sh: Shape = {
    kind: ShapeKind.roundedRect
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    strokeDash: 0.0
    strokeGap: 0.0
    radius: radius
  }
  componentSet(this: world.shapes, entityId: entityId, data: sh)
}

func setDebugText(
  world: mod UiWorld
  entityId: view EntityId
  text: own String
  styleId: own String
) {
  let t: Text = { text: text, styleId: styleId, wrapWidthMode: WrapWidthMode.none }
  componentSet(this: world.texts, entityId: entityId, data: t)
}

func setDebugSprite(
  world: mod UiWorld
  entityId: view EntityId
  key: own String
  tint: view RgbaColor
) {
  let sp: Sprite = {
    textureKey: key
    tint: tint
    scaleMode: ScaleMode.fit
    tileScale: Vec2 { x: 1.0, y: 1.0 }
    nineSlice: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
    hasNineSlice: false
  }
  componentSet(this: world.sprites, entityId: entityId, data: sp)
}

func setOpticalAlign(
  world: mod UiWorld
  entityId: view EntityId
  centerX: view Bool
  centerY: view Bool
  biasX: view Float
  biasY: view Float
) {
  let oa: OpticalAlign = {
    enabled: true
    centerX: centerX
    centerY: centerY
    bias: Vec2 { x: biasX, y: biasY }
  }
  componentSet(this: world.opticalAligns, entityId: entityId, data: oa)
}

func setOnClickAction(world: mod UiWorld, entityId: view EntityId, actionId: own String) {
  let bindId: String = "{actionId}"
  let bindRole: String = "primary"
  let oc: OnClick = { actionId: actionId, actionIdDouble: "", actionIdTriple: "", maxDelayMs: 250 }
  componentSet(this: world.onClicks, entityId: entityId, data: oc)
  let binding: ActionBinding = { actionId: own bindId, role: own bindRole }
  componentSet(this: world.actionBindings, entityId: entityId, data: own binding)
}

func setActionBindingOnly(world: mod UiWorld, entityId: view EntityId, actionId: view String) {
  let bindId: String = "{actionId}"
  let bindRole: String = "primary"
  let binding: ActionBinding = { actionId: own bindId, role: own bindRole }
  componentSet(this: world.actionBindings, entityId: entityId, data: own binding)
}

func tagDebugToggleWidget(
  world: mod UiWorld
  entityId: view EntityId
  actionId: view String
  kind: view String
  selected: view Bool
) {
  let widgetId: String = "{actionId}.{kind}"
  setWidgetIdentity(
    world: world
    entityId: entityId
    id: widgetId
    kind: kind
  )
  setWidgetState(
    world: world
    entityId: entityId
    enabled: true
    selected: selected
    loading: false
    error: false
  )
  let source: DataResourceId = dataResourceDebug()
  let field: DataFieldId = dataFieldDebugToggle()
  setDataDependency(
    world: world
    entityId: entityId
    resource: source
    field: field
    observedRevision: 0
  )
  setActionBindingOnly(world: world, entityId: entityId, actionId: actionId)
}

func setDebugSwitchPillStyle(world: mod UiWorld, entityId: view EntityId) {
  let emptySprite: String = ""
  let emptySpriteSel: String = ""
  let emptyText: String = ""
  let emptyTextSel: String = ""
  let noTint: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let offFill: RgbaColor = switchOffColor()
  let onFill: RgbaColor = switchOnColor()
  let zeroOffset: Vec2 = { x: 0.0, y: 0.0 }
  let style: StateStyle = {
    spriteKey: own emptySprite
    spriteKeySelected: own emptySpriteSel
    tint: noTint
    tintSelected: noTint
    hasTint: false
    shapeFill: offFill
    shapeFillSelected: onFill
    hasShapeFill: true
    offset: zeroOffset
    offsetSelected: zeroOffset
    hasOffset: false
    textStyle: own emptyText
    textStyleSelected: own emptyTextSel
    disabledAlpha: 1.0
    loadingAlpha: 1.0
    errorAlpha: 1.0
  }
  componentSet(this: world.stateStyles, entityId: entityId, data: own style)
}

func setDebugSwitchKnobStyle(world: mod UiWorld, entityId: view EntityId) {
  let emptySprite: String = ""
  let emptySpriteSel: String = ""
  let emptyText: String = ""
  let emptyTextSel: String = ""
  let noTint: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let noFill: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let offOffset: Vec2 = { x: 0.0 - debugSwitchKnobOffset, y: 0.0 }
  let onOffset: Vec2 = { x: debugSwitchKnobOffset, y: 0.0 }
  let style: StateStyle = {
    spriteKey: own emptySprite
    spriteKeySelected: own emptySpriteSel
    tint: noTint
    tintSelected: noTint
    hasTint: false
    shapeFill: noFill
    shapeFillSelected: noFill
    hasShapeFill: false
    offset: offOffset
    offsetSelected: onOffset
    hasOffset: true
    textStyle: own emptyText
    textStyleSelected: own emptyTextSel
    disabledAlpha: 1.0
    loadingAlpha: 1.0
    errorAlpha: 1.0
  }
  componentSet(this: world.stateStyles, entityId: entityId, data: own style)
}

func setStackLayout(world: mod UiWorld, entityId: view EntityId) {
  let lay: Layout = {
    kind: LayoutType.stack
    gap: 0.0
    alignMain: AlignKind.center
    alignCross: AlignKind.center
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entityId: entityId, data: lay)
}

func setVerticalLayout(world: mod UiWorld, entityId: view EntityId, gap: view Float) {
  let lay: Layout = {
    kind: LayoutType.vertical
    gap: gap
    alignMain: AlignKind.start
    alignCross: AlignKind.stretch
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entityId: entityId, data: lay)
}

func setHorizontalLayout(
  world: mod UiWorld
  entityId: view EntityId
  gap: view Float
  alignCross: AlignKind
) {
  let lay: Layout = {
    kind: LayoutType.horizontal
    gap: gap
    alignMain: AlignKind.start
    alignCross: alignCross
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entityId: entityId, data: lay)
}

func dbgSetPaddingAll(world: mod UiWorld, entityId: view EntityId, n: view Float) {
  let pad: Padding = { insets: Insets { l: n, t: n, r: n, b: n } }
  componentSet(this: world.paddings, entityId: entityId, data: pad)
}

func attachKids(
  world: mod UiWorld
  uiSystems: mod UiSystems
  parent: view EntityId
  kids: view List(EntityId)
) {
  unsafe {
    # #726: set only Parent; HierarchySystem.setParent maintains Children.
    var i: Int = 0
    loop i < kids.length {
      let k: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
      setParent(
        parents: uiSystems.hierarchy.parents
        childrens: world.childrens
        child: k
        parent: parent
      )
      i = i + 1
    }
  }
}

func buildDebugButton(
  world: mod UiWorld
  uiSystems: mod UiSystems
  debug: view DebugSystem
) ret EntityId {
  let button: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: button
    w: debug.buttonSize
    h: debug.buttonSize
  )
  setOffset(
    world: world
    entityId: button
    x: debug.buttonX
    y: debug.buttonY
  )
  setCircleShape(world: world, entityId: button, fill: amberColor())
  setStackLayout(world: world, entityId: button)
  setOnClickAction(world: world, entityId: button, actionId: debugActionToggleMenu)

  let label: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: label
    w: debug.buttonSize
    h: debugButtonTextH
  )
  setOpticalAlign(
    world: world
    entityId: label
    centerX: true
    centerY: true
    biasX: 0.0
    biasY: 0.0
  )
  setDebugText(
    world: world
    entityId: label
    text: "D"
    styleId: "debugButtonSmall"
  )
  var kids: List(EntityId) = List.create(EntityId, cap: 1)
  kids.add(value: label)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: button
    kids: kids
  )
  ret button
}

func buildDebugIconButton(world: mod UiWorld, uiSystems: mod UiSystems) ret EntityId {
  let button: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: button
    w: debugCloseIconSize
    h: debugCloseIconSize
  )
  setRoundedShape(
    world: world
    entityId: button
    fill: colorByName(theme: world.theme.active, name: "outline")
    radius: debugCloseIconSize / 2.0
  )
  setStackLayout(world: world, entityId: button)
  setOnClickAction(world: world, entityId: button, actionId: debugActionDismiss)

  let icon: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: icon
    w: debugCloseIconGlyph
    h: debugCloseIconGlyph
  )
  setOpticalAlign(
    world: world
    entityId: icon
    centerX: true
    centerY: true
    biasX: 0.0
    biasY: 0.0
  )
  setDebugSprite(
    world: world
    entityId: icon
    key: "mat:close"
    tint: colorByName(theme: world.theme.active, name: "textPrimary")
  )
  var kids: List(EntityId) = List.create(EntityId, cap: 1)
  kids.add(value: icon)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: button
    kids: kids
  )
  ret button
}

func buildDebugCloseButton(world: mod UiWorld, uiSystems: mod UiSystems) ret EntityId {
  let button: EntityId = createEntity(world: world)
