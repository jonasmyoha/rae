    w: panelW
    h: debugDialogTitleH
  )
  setAlign(
    world: world
    entityId: title
    x: AlignKind.center
    y: AlignKind.start
  )
  setOffset(
    world: world
    entityId: title
    x: 0.0
    y: debugDialogTitleY
  )
  setStackLayout(world: world, entityId: title)

  let label: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: label
    w: panelW
    h: debugDialogTitleH
  )
  setOpticalAlign(
    world: world
    entityId: label
    centerX: true
    centerY: true
    biasX: 0.0
    biasY: 0.0
  )
  setDebugText(
    world: world
    entityId: label
    text: "Debug"
    styleId: "debugDialogTitle"
  )

  var kids: List(EntityId) = List.create(EntityId, cap: 2)
  kids.add(value: label)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: title
    kids: kids
