  ret title
}

func buildSwitchRow(
  world: mod UiWorld
  uiSystems: mod UiSystems
  labelText: own String
  actionId: own String
  on: view Bool
  width: view Float
) ret EntityId {
  let row: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: row
    w: width
    h: debugRowH
  )
  setHorizontalLayout(
    world: world
    entityId: row
    gap: debugRowGap
    alignCross: AlignKind.center
  )
  # Data-oriented widget tags (#220): identity + on/off state + action
  # binding as queryable component data. The switch
  # visuals are still mount-baked — the debug menu re-mounts on every
  # toggle — but systems can now read which toggles exist and which
  # are on straight from the widgetStates table.
  let toggleKind: String = "debugToggle"
  setWidgetIdentity(
    world: world
    entityId: row
    id: actionId
    kind: toggleKind
  )
  setWidgetState(
    world: world
    entityId: row
    enabled: true
    selected: on
    loading: false
    error: false
  )
  let bindId: String = "{actionId}"
  let bindRole: String = "primary"
  let binding: ActionBinding = { actionId: own bindId, role: own bindRole }
  componentSet(this: world.actionBindings, entityId: row, data: own binding)
  # `setOnClickAction` takes `own`: hand it a copy, the row's own `actionId`
  # is still tagged onto the switch pill below (a moved value cannot be read).
  setOnClickAction(world: world, entityId: row, actionId: "{actionId}")

  let label: EntityId = createEntity(world: world)
  let labelW: Float = width - debugSwitchW - debugRowGap
  setFixedRect(
    world: world
    entityId: label
    w: labelW
    h: debugLabelH
  )
  setDebugText(
    world: world
    entityId: label
    text: labelText
    styleId: "debugMenuLabel"
  )

  let pill: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: pill
    w: debugSwitchW
    h: debugSwitchH
  )
  var pillFill: RgbaColor = switchOffColor()
  if on {
    pillFill = switchOnColor()
  }
  setRoundedShape(
    world: world
    entityId: pill
    fill: pillFill
    radius: debugSwitchRadius
  )
  let pillKind: String = "debugSwitchPill"
  tagDebugToggleWidget(
    world: world
    entityId: pill
    actionId: actionId
    kind: pillKind
    selected: on
  )
  setDebugSwitchPillStyle(world: world, entityId: pill)
  setStackLayout(world: world, entityId: pill)

  let knob: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: knob
    w: debugSwitchKnob
    h: debugSwitchKnob
  )
  setCircleShape(world: world, entityId: knob, fill: switchKnobColor())
  var knobOff: Float = 0.0 - debugSwitchKnobOffset
  if on {
    knobOff = debugSwitchKnobOffset
  }
  setOffset(
    world: world
    entityId: knob
    x: knobOff
    y: 0.0
  )
  let knobKind: String = "debugSwitchKnob"
  tagDebugToggleWidget(
    world: world
    entityId: knob
    actionId: actionId
    kind: knobKind
    selected: on
  )
  setDebugSwitchKnobStyle(world: world, entityId: knob)

  var pillKids: List(EntityId) = List.create(EntityId, cap: 1)
  pillKids.add(value: knob)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: pill
    kids: pillKids
  )

  var rowKids: List(EntityId) = List.create(EntityId, cap: 2)
  rowKids.add(value: label)
  rowKids.add(value: pill)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: row
    kids: rowKids
  )
  ret row
}

func buildDebugMenuOverlay(
  world: mod UiWorld
  uiSystems: mod UiSystems
  debug: view DebugSystem
) ret EntityId {
  let backdrop: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: backdrop
    w: debug.screenW
    h: debug.screenH
  )
  setOffset(
    world: world
    entityId: backdrop
    x: 0.0
    y: 0.0
  )
  setRectShape(world: world, entityId: backdrop, fill: backdropColor())
  setOnClickAction(world: world, entityId: backdrop, actionId: debugActionDismiss)
  setStackLayout(world: world, entityId: backdrop)

  let panelW: Float = debug.screenW * 0.86
  let panelH: Float = debug.screenH * 0.72
  let panel: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entityId: panel
    w: panelW
    h: panelH
  )
  setRoundedShape(
    world: world
    entityId: panel
    fill: menuFillColor()
    radius: debugPanelRadius
  )
  setStackLayout(world: world, entityId: panel)

  let content: EntityId = createEntity(world: world)
  let contentW: Float = panelW - debugPanelPadding * 2.0
  let contentH: Float = panelH - debugContentTop - debugPanelPadding * 2.0 - debugCloseButtonH
  setFixedRect(
    world: world
    entityId: content
    w: contentW
    h: contentH
  )
  setAlign(
    world: world
    entityId: content
    x: AlignKind.start
    y: AlignKind.start
  )
  setOffset(
    world: world
    entityId: content
    x: debugPanelPadding
    y: debugContentTop
  )
  setVerticalLayout(world: world, entityId: content, gap: debugRowGap)

  let themeRow: EntityId = buildSwitchRow(
    world: world
    uiSystems: uiSystems
    labelText: "Dark theme"
    actionId: debugActionToggleTheme
    on: world.theme.active.mode is ThemeMode.dark
    width: contentW
  )
  let labelsRow: EntityId = buildSwitchRow(
    world: world
    uiSystems: uiSystems
    labelText: "FPS / mem labels"
    actionId: debugActionToggleLabels
    on: debug.showLabels
    width: contentW
  )
  let outlinesRow: EntityId = buildSwitchRow(
    world: world
    uiSystems: uiSystems
    labelText: "Input outlines"
    actionId: debugActionToggleInputOutlines
    on: debug.showInputOutlines
    width: contentW
  )

  var rows: List(EntityId) = List.create(EntityId, cap: 3)
  rows.add(value: themeRow)
  rows.add(value: labelsRow)
  rows.add(value: outlinesRow)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: content
    kids: rows
  )

  let closeX: EntityId = buildDebugIconButton(world: world, uiSystems: uiSystems)
  setAlign(
    world: world
    entityId: closeX
    x: AlignKind.end
    y: AlignKind.start
  )
  setOffset(
    world: world
    entityId: closeX
    x: 0.0 - debugPanelPadding
    y: debugPanelPadding
  )

  let closeButton: EntityId = buildDebugCloseButton(world: world, uiSystems: uiSystems)
  setAlign(
    world: world
    entityId: closeButton
    x: AlignKind.center
    y: AlignKind.end
  )
  setOffset(
    world: world
    entityId: closeButton
    x: 0.0
    y: 0.0 - debugPanelPadding
  )

  let title: EntityId = buildDebugMenuTitle(world: world, uiSystems: uiSystems, panelW: panelW)

  var panelKids: List(EntityId) = List.create(EntityId, cap: 4)
  panelKids.add(value: content)
  panelKids.add(value: title)
  panelKids.add(value: closeX)
  panelKids.add(value: closeButton)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: panel
    kids: panelKids
  )

  var backdropKids: List(EntityId) = List.create(EntityId, cap: 1)
  backdropKids.add(value: panel)
  attachKids(
    world: world
    uiSystems: uiSystems
    parent: backdrop
    kids: backdropKids
  )
  ret backdrop
}

func applyDebugAnchor(world: view UiWorld, debug: mod DebugSystem) ret Bool {
  let anchors: view ComponentTable(DebugAnchor) => world.debugAnchors
  let n: Int = componentCount(this: anchors)
  var i: Int = 0
  loop i < n {
    let e: EntityId = componentEntityAt(this: anchors, i: i)
    if componentHas(this: world.rects, entityId: e) {
      let r: view Rect => componentView(this: world.rects, entityId: e)
      debug.buttonX = r.position.x
      debug.buttonY = r.position.y
      if r.size.x > 0.0 {
        debug.buttonSize = r.size.x
      }
      ret true
    }
    i = i + 1
  }
  ret false
}
