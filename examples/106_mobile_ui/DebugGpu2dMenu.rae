# DebugGpu2dMenu — the debug menu overlay's widget builders (#918 split of
# DebugGpu2dLocal for the 1000-line cap): the node-setter helpers (offset /
# align / rect / shapes / text / sprite / layouts), the switch-row and
# button builders and buildDebugMenuOverlay itself. DebugGpu2dLocal keeps the
# DebugSystem state, the actions and the per-frame labels.
open ui/Ecs
open ui/Layer
open ui/Theme
import Json
import Gpu2d
import Gpu2dText
import SdfText
import ui/Components
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open Gpu2dCanvas

func setOffset(
  world: mod UiWorld
  entity: view EntityId
  x: view Float
  y: view Float
) {
  let off: Offset = { delta: Vec2 { x: x, y: y } }
  componentSet(this: world.offsets, entity: entity, data: off)
}

func setAlign(
  world: mod UiWorld
  entity: view EntityId
  x: AlignKind
  y: AlignKind
) {
  let a: Align = { x: x, y: y, hasX: true, hasY: true }
  componentSet(this: world.aligns, entity: entity, data: a)
}

func setFixedRect(
  world: mod UiWorld
  entity: view EntityId
  w: view Float
  h: view Float
) {
  let r: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: w, y: h } }
  componentSet(this: world.rects, entity: entity, data: r)
  let s: Size = {
    w: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
    h: SizeAxis { mode: SizeMode.fixed, min: -1, max: -1 }
  }
  componentSet(this: world.sizes, entity: entity, data: s)
}

func setCircleShape(world: mod UiWorld, entity: view EntityId, fill: view RgbaColor) {
  let sh: Shape = {
    kind: ShapeKind.circle
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: 0.0
  }
  componentSet(this: world.shapes, entity: entity, data: sh)
}

func setRectShape(world: mod UiWorld, entity: view EntityId, fill: view RgbaColor) {
  let sh: Shape = {
    kind: ShapeKind.rect
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: 0.0
  }
  componentSet(this: world.shapes, entity: entity, data: sh)
}

func setRoundedShape(
  world: mod UiWorld
  entity: view EntityId
  fill: view RgbaColor
  radius: view Float
) {
  let sh: Shape = {
    kind: ShapeKind.roundedRect
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: radius
  }
  componentSet(this: world.shapes, entity: entity, data: sh)
}

func setDebugText(
  world: mod UiWorld
  entity: view EntityId
  text: own String
  styleId: own String
) {
  let t: Text = { text: text, styleId: styleId, wrapWidthMode: WrapWidthMode.none }
  componentSet(this: world.texts, entity: entity, data: t)
}

func setDebugSprite(
  world: mod UiWorld
  entity: view EntityId
  key: own String
  tint: view RgbaColor
) {
  let sp: Sprite = {
    textureKey: key
    tint: tint
    scaleMode: ScaleMode.fit
    tileScale: Vec2 { x: 1.0, y: 1.0 }
    nineSlice: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
    hasNineSlice: false
  }
  componentSet(this: world.sprites, entity: entity, data: sp)
}

func setOpticalAlign(
  world: mod UiWorld
  entity: view EntityId
  centerX: view Bool
  centerY: view Bool
  biasX: view Float
  biasY: view Float
) {
  let oa: OpticalAlign = {
    enabled: true
    centerX: centerX
    centerY: centerY
    bias: Vec2 { x: biasX, y: biasY }
  }
  componentSet(this: world.opticalAligns, entity: entity, data: oa)
}

func setOnClickAction(world: mod UiWorld, entity: view EntityId, actionId: own String) {
  let bindId: String = "{actionId}"
  let bindRole: String = "primary"
  let oc: OnClick = { actionId: actionId, actionIdDouble: "", actionIdTriple: "", maxDelayMs: 250 }
  componentSet(this: world.onClicks, entity: entity, data: oc)
  let binding: ActionBinding = { actionId: own bindId, role: own bindRole }
  componentSet(this: world.actionBindings, entity: entity, data: own binding)
}

func setActionBindingOnly(world: mod UiWorld, entity: view EntityId, actionId: view String) {
  let bindId: String = "{actionId}"
  let bindRole: String = "primary"
  let binding: ActionBinding = { actionId: own bindId, role: own bindRole }
  componentSet(this: world.actionBindings, entity: entity, data: own binding)
}

func tagDebugToggleWidget(
  world: mod UiWorld
  entity: view EntityId
  actionId: view String
  kind: view String
  selected: view Bool
) {
  let widgetId: String = "{actionId}.{kind}"
  setWidgetIdentity(
    world: world
    entity: entity
    id: widgetId
    kind: kind
  )
  setWidgetState(
    world: world
    entity: entity
    enabled: true
    selected: selected
    loading: false
    error: false
  )
  let source: DataResourceId = dataResourceDebug()
  let field: DataFieldId = dataFieldDebugToggle()
  setDataDependency(
    world: world
    entity: entity
    resource: source
    field: field
    observedRevision: 0
  )
  setActionBindingOnly(world: world, entity: entity, actionId: actionId)
}

func setDebugSwitchPillStyle(world: mod UiWorld, entity: view EntityId) {
  let emptySprite: String = ""
  let emptySpriteSel: String = ""
  let emptyText: String = ""
  let emptyTextSel: String = ""
  let noTint: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let offFill: RgbaColor = switchOffColor()
  let onFill: RgbaColor = switchOnColor()
  let zeroOffset: Vec2 = { x: 0.0, y: 0.0 }
  let style: StateStyle = {
    spriteKey: own emptySprite
    spriteKeySelected: own emptySpriteSel
    tint: noTint
    tintSelected: noTint
    hasTint: false
    shapeFill: offFill
    shapeFillSelected: onFill
    hasShapeFill: true
    offset: zeroOffset
    offsetSelected: zeroOffset
    hasOffset: false
    textStyle: own emptyText
    textStyleSelected: own emptyTextSel
    disabledAlpha: 1.0
    loadingAlpha: 1.0
    errorAlpha: 1.0
  }
  componentSet(this: world.stateStyles, entity: entity, data: own style)
}

func setDebugSwitchKnobStyle(world: mod UiWorld, entity: view EntityId) {
  let emptySprite: String = ""
  let emptySpriteSel: String = ""
  let emptyText: String = ""
  let emptyTextSel: String = ""
  let noTint: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let noFill: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let offOffset: Vec2 = { x: 0.0 - debugSwitchKnobOffset, y: 0.0 }
  let onOffset: Vec2 = { x: debugSwitchKnobOffset, y: 0.0 }
  let style: StateStyle = {
    spriteKey: own emptySprite
    spriteKeySelected: own emptySpriteSel
    tint: noTint
    tintSelected: noTint
    hasTint: false
    shapeFill: noFill
    shapeFillSelected: noFill
    hasShapeFill: false
    offset: offOffset
    offsetSelected: onOffset
    hasOffset: true
    textStyle: own emptyText
    textStyleSelected: own emptyTextSel
    disabledAlpha: 1.0
    loadingAlpha: 1.0
    errorAlpha: 1.0
  }
  componentSet(this: world.stateStyles, entity: entity, data: own style)
}

func setStackLayout(world: mod UiWorld, entity: view EntityId) {
  let lay: Layout = {
    kind: LayoutType.stack
    gap: 0.0
    alignMain: AlignKind.center
    alignCross: AlignKind.center
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entity: entity, data: lay)
}

func setVerticalLayout(world: mod UiWorld, entity: view EntityId, gap: view Float) {
  let lay: Layout = {
    kind: LayoutType.vertical
    gap: gap
    alignMain: AlignKind.start
    alignCross: AlignKind.stretch
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entity: entity, data: lay)
}

func setHorizontalLayout(
  world: mod UiWorld
  entity: view EntityId
  gap: view Float
  alignCross: AlignKind
) {
  let lay: Layout = {
    kind: LayoutType.horizontal
    gap: gap
    alignMain: AlignKind.start
    alignCross: alignCross
    columns: 0
    rowGap: 0.0
    columnGap: 0.0
  }
  componentSet(this: world.layouts, entity: entity, data: lay)
}

func dbgSetPaddingAll(world: mod UiWorld, entity: view EntityId, n: view Float) {
  let pad: Padding = { insets: Insets { l: n, t: n, r: n, b: n } }
  componentSet(this: world.paddings, entity: entity, data: pad)
}

func attachKids(world: mod UiWorld, parent: view EntityId, kids: view List(EntityId)) {
  unsafe {
    # #726: set only Parent; HierarchySystem.setParent maintains Children.
    var i: Int = 0
    loop i < kids.length {
      let k: EntityId = rae_ext_rae_buf_get(buf: kids.data, index: i)
      setParent(
        parents: world.parents
        childrens: world.childrens
        child: k
        parent: parent
      )
      i = i + 1
    }
  }
}

func buildDebugButton(world: mod UiWorld, debug: view DebugSystem) ret EntityId {
  let button: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: button
    w: debug.buttonSize
    h: debug.buttonSize
  )
  setOffset(
    world: world
    entity: button
    x: debug.buttonX
    y: debug.buttonY
  )
  setCircleShape(world: world, entity: button, fill: amberColor())
  setStackLayout(world: world, entity: button)
  setOnClickAction(world: world, entity: button, actionId: debugActionToggleMenu)

  let label: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: label
    w: debug.buttonSize
    h: debugButtonTextH
  )
  setOpticalAlign(
    world: world
    entity: label
    centerX: true
    centerY: true
    biasX: 0.0
    biasY: 0.0
  )
  setDebugText(
    world: world
    entity: label
    text: "D"
    styleId: "debugButtonSmall"
  )
  let kids: List(EntityId) = List.create(EntityId, cap: 1)
  kids.add(value: label)
  attachKids(world: world, parent: button, kids: kids)
  ret button
}

func buildDebugIconButton(world: mod UiWorld) ret EntityId {
  let button: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: button
    w: debugCloseIconSize
    h: debugCloseIconSize
  )
  setRoundedShape(
    world: world
    entity: button
    fill: colorByName(theme: world.theme.active, name: "outline")
    radius: debugCloseIconSize / 2.0
  )
  setStackLayout(world: world, entity: button)
  setOnClickAction(world: world, entity: button, actionId: debugActionDismiss)

  let icon: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: icon
    w: debugCloseIconGlyph
    h: debugCloseIconGlyph
  )
  setOpticalAlign(
    world: world
    entity: icon
    centerX: true
    centerY: true
    biasX: 0.0
    biasY: 0.0
  )
  setDebugSprite(
    world: world
    entity: icon
    key: "mat:close"
    tint: colorByName(theme: world.theme.active, name: "textPrimary")
  )
  let kids: List(EntityId) = List.create(EntityId, cap: 1)
  kids.add(value: icon)
  attachKids(world: world, parent: button, kids: kids)
  ret button
}

func buildDebugCloseButton(world: mod UiWorld) ret EntityId {
  let button: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: button
    w: debugCloseButtonW
    h: debugCloseButtonH
  )
  setRoundedShape(
    world: world
