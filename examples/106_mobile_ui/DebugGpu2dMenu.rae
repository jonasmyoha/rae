func buildDebugMenuTitle(world: mod UiWorld, panelW: view Float) ret EntityId {
  let title: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: title
    w: panelW
    h: debugDialogTitleH
  )
  setAlign(
    world: world
    entity: title
    x: AlignKind.center
    y: AlignKind.start
  )
  setOffset(
    world: world
    entity: title
    x: 0.0
    y: debugDialogTitleY
  )
  setStackLayout(world: world, entity: title)

  let label: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: label
    w: panelW
    h: debugDialogTitleH
  )
  setOpticalAlign(
    world: world
    entity: label
    centerX: true
    centerY: true
    biasX: 0.0
    biasY: 0.0
  )
  setDebugText(
    world: world
    entity: label
    text: "Debug"
    styleId: "debugDialogTitle"
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 2)
  kids.add(value: label)
  attachKids(world: world, parent: title, kids: kids)
  ret title
}

func buildSwitchRow(
  world: mod UiWorld
  labelText: own String
  actionId: own String
  on: view Bool
  width: view Float
) ret EntityId {
  let row: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: row
    w: width
    h: debugRowH
  )
  setHorizontalLayout(
    world: world
    entity: row
    gap: debugRowGap
    alignCross: AlignKind.center
  )
  # Data-oriented widget tags (#220): identity + on/off state + action
  # binding as queryable component data. Copies taken BEFORE
  # setOnClickAction consumes `actionId` (own param). The switch
  # visuals are still mount-baked — the debug menu re-mounts on every
  # toggle — but systems can now read which toggles exist and which
  # are on straight from the widgetStates table.
  let toggleKind: String = "debugToggle"
  setWidgetIdentity(
    world: world
    entity: row
    id: actionId
    kind: toggleKind
  )
  setWidgetState(
    world: world
    entity: row
    enabled: true
    selected: on
    loading: false
    error: false
  )
  let bindId: String = "{actionId}"
  let bindRole: String = "primary"
  let binding: ActionBinding = { actionId: own bindId, role: own bindRole }
  componentSet(this: world.actionBindings, entity: row, data: own binding)
  setOnClickAction(world: world, entity: row, actionId: actionId)

  let label: EntityId = createEntity(world: world)
  let labelW: Float = width - debugSwitchW - debugRowGap
  setFixedRect(
    world: world
    entity: label
    w: labelW
    h: debugLabelH
  )
  setDebugText(
    world: world
    entity: label
    text: labelText
    styleId: "debugMenuLabel"
  )

  let pill: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: pill
    w: debugSwitchW
    h: debugSwitchH
  )
  var pillFill: RgbaColor = switchOffColor()
  if on {
    pillFill = switchOnColor()
  }
  setRoundedShape(
    world: world
    entity: pill
    fill: pillFill
    radius: debugSwitchRadius
  )
  let pillKind: String = "debugSwitchPill"
  tagDebugToggleWidget(
    world: world
    entity: pill
    actionId: actionId
    kind: pillKind
    selected: on
  )
  setDebugSwitchPillStyle(world: world, entity: pill)
  setStackLayout(world: world, entity: pill)

  let knob: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: knob
    w: debugSwitchKnob
    h: debugSwitchKnob
  )
  setCircleShape(world: world, entity: knob, fill: switchKnobColor())
  var knobOff: Float = 0.0 - debugSwitchKnobOffset
  if on {
    knobOff = debugSwitchKnobOffset
  }
  setOffset(
    world: world
    entity: knob
    x: knobOff
    y: 0.0
  )
  let knobKind: String = "debugSwitchKnob"
  tagDebugToggleWidget(
    world: world
    entity: knob
    actionId: actionId
    kind: knobKind
    selected: on
  )
  setDebugSwitchKnobStyle(world: world, entity: knob)

  let pillKids: List(EntityId) = List.create(EntityId, cap: 1)
  pillKids.add(value: knob)
  attachKids(world: world, parent: pill, kids: pillKids)

  let rowKids: List(EntityId) = List.create(EntityId, cap: 2)
  rowKids.add(value: label)
  rowKids.add(value: pill)
  attachKids(world: world, parent: row, kids: rowKids)
  ret row
}

func buildDebugMenuOverlay(world: mod UiWorld, debug: view DebugSystem) ret EntityId {
  let backdrop: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: backdrop
    w: debug.screenW
    h: debug.screenH
  )
  setOffset(
    world: world
    entity: backdrop
    x: 0.0
    y: 0.0
  )
  setRectShape(world: world, entity: backdrop, fill: backdropColor())
  setOnClickAction(world: world, entity: backdrop, actionId: debugActionDismiss)
  setStackLayout(world: world, entity: backdrop)

  let panelW: Float = debug.screenW * 0.86
  let panelH: Float = debug.screenH * 0.72
  let panel: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
    entity: panel
    w: panelW
    h: panelH
  )
  setRoundedShape(
    world: world
    entity: panel
    fill: menuFillColor()
    radius: debugPanelRadius
  )
  setStackLayout(world: world, entity: panel)

  let content: EntityId = createEntity(world: world)
  let contentW: Float = panelW - debugPanelPadding * 2.0
  let contentH: Float = panelH - debugContentTop - debugPanelPadding * 2.0 - debugCloseButtonH
  setFixedRect(
    world: world
    entity: content
    w: contentW
    h: contentH
  )
  setAlign(
    world: world
    entity: content
    x: AlignKind.start
    y: AlignKind.start
  )
  setOffset(
    world: world
    entity: content
    x: debugPanelPadding
    y: debugContentTop
  )
  setVerticalLayout(world: world, entity: content, gap: debugRowGap)

  let themeRow: EntityId = buildSwitchRow(
    world: world
    labelText: "Dark theme"
    actionId: debugActionToggleTheme
    on: world.theme.active.mode is ThemeMode.dark
    width: contentW
  )
  let labelsRow: EntityId = buildSwitchRow(
    world: world
    labelText: "FPS / mem labels"
    actionId: debugActionToggleLabels
    on: debug.showLabels
    width: contentW
  )
  let outlinesRow: EntityId = buildSwitchRow(
    world: world
    labelText: "Input outlines"
    actionId: debugActionToggleInputOutlines
    on: debug.showInputOutlines
    width: contentW
  )

  let rows: List(EntityId) = List.create(EntityId, cap: 3)
  rows.add(value: themeRow)
  rows.add(value: labelsRow)
  rows.add(value: outlinesRow)
  attachKids(world: world, parent: content, kids: rows)

  let closeX: EntityId = buildDebugIconButton(world: world)
  setAlign(
    world: world
    entity: closeX
    x: AlignKind.end
    y: AlignKind.start
  )
  setOffset(
    world: world
    entity: closeX
    x: 0.0 - debugPanelPadding
    y: debugPanelPadding
  )

  let closeButton: EntityId = buildDebugCloseButton(world: world)
  setAlign(
    world: world
    entity: closeButton
    x: AlignKind.center
    y: AlignKind.end
  )
  setOffset(
    world: world
    entity: closeButton
    x: 0.0
    y: 0.0 - debugPanelPadding
  )

  let title: EntityId = buildDebugMenuTitle(world: world, panelW: panelW)

  let panelKids: List(EntityId) = List.create(EntityId, cap: 4)
  panelKids.add(value: content)
  panelKids.add(value: title)
  panelKids.add(value: closeX)
  panelKids.add(value: closeButton)
  attachKids(world: world, parent: panel, kids: panelKids)

  let backdropKids: List(EntityId) = List.create(EntityId, cap: 1)
  backdropKids.add(value: panel)
  attachKids(world: world, parent: backdrop, kids: backdropKids)
  ret backdrop
}

func applyDebugAnchor(world: view UiWorld, debug: mod DebugSystem) ret Bool {
  let anchors: view ComponentTable(DebugAnchor) => world.debugAnchors
  let n: Int = componentCount(this: anchors)
  var i: Int = 0
  loop i < n {
    let e: EntityId = componentEntityAt(this: anchors, i: i)
    if componentHas(this: world.rects, entity: e) {
      let r: Rect = componentGet(this: world.rects, entity: e)
      debug.buttonX = r.position.x
      debug.buttonY = r.position.y
      if r.size.x > 0.0 {
        debug.buttonSize = r.size.x
      }
      ret true
    }
    i = i + 1
  }
  ret false
}
