    fill: colorByName(theme: world.theme.active, name: "accent")
    radius: debugCloseButtonRadius
  )
  setStackLayout(world: world, entity: button)
  setOnClickAction(world: world, entity: button, actionId: debugActionDismiss)

  let label: EntityId = createEntity(world: world)
  setFixedRect(
    world: world
