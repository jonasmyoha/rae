open ui/Ecs
open GpuAssetRegistry

# The per-frame UI observer state. The playback slice has been carved out
# into its own per-feature `UiPlaybackSystem` (#267, §5.2); `historyRevision` and
# `sheetEpoch` are the observer caches for the history list + bottom sheet
# and become their own UI systems in follow-ups.
type UiRefreshCache {
  # Last PlayHistory.revision this observer reacted to (#944, §7 system revision).
  historyRevision: Int
  uiPlayback: UiPlaybackSystem
  sheetEpoch: Int
}

type UiRefreshResult {
  historyChanged: Bool
  playbackChanged: Bool
  sheetChanged: Bool
}

func createUiRefreshCache(
  historyRevision: view Int
  playbackRevision: view Int
  sheetEpoch: view Int
) pub ret UiRefreshCache {
  ret UiRefreshCache {
    historyRevision: historyRevision
    uiPlayback: createUiPlaybackSystem(observedRevision: playbackRevision)
    sheetEpoch: sheetEpoch
  }
}

func refreshMountedUi(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  playback: view PlaybackState
  visible: view Screen
  cache: mod UiRefreshCache
  viewport: view Viewport
  reg: view TextureRegistry
) pub ret UiRefreshResult {
  let oldHistory: Int = cache.historyRevision
  let oldSheet: Int = cache.sheetEpoch

  cache.historyRevision = refreshHistoryViewsIfNeeded(
    world: world
    scenes: scenes
    state: state
    visible: visible
    cachedRevision: cache.historyRevision
    viewport: viewport
  )
  let playbackChanged: Bool = uiPlaybackObserve(
    this: cache.uiPlayback
    world: world
    playback: playback
    reg: reg
  )
  cache.sheetEpoch = refreshBottomSheetIfNeeded(
    world: world
    sheet: state.bottomSheet
    cachedEpoch: cache.sheetEpoch
  )

  ret UiRefreshResult {
    historyChanged: cache.historyRevision is not oldHistory
    playbackChanged: playbackChanged
    sheetChanged: cache.sheetEpoch is not oldSheet
  }
}
