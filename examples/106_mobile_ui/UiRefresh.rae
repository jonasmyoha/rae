open ui/Ecs
open assetSystem/GpuAssetRegistry

# The per-frame UI observer state: `historyRevision` is the observer cache
# for the history list and becomes its own UI system in a follow-up. (The
# playback widgets observe through their binding components since #981, the
# bottom sheet's epoch lives on its `BottomSheet` component since #980.)
type UiRefreshCache {
  # Last PlayHistory.revision this observer reacted to (#944, §7 system revision).
  historyRevision: Int
}

type UiRefreshResult {
  historyChanged: Bool
  playbackChanged: Bool
}

func createUiRefreshCache(historyRevision: view Int) pub ret UiRefreshCache {
  ret UiRefreshCache { historyRevision: historyRevision }
}

func refreshMountedUi(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  playback: view PlaybackState
  visible: view Screen
  cache: mod UiRefreshCache
  viewport: view Viewport
  reg: view TextureRegistry
) pub ret UiRefreshResult {
  let oldHistory: Int = cache.historyRevision

  cache.historyRevision = refreshHistoryViewsIfNeeded(
    world: world
    scenes: scenes
    state: state
    playback: playback
    visible: visible
    cachedRevision: cache.historyRevision
    viewport: viewport
  )
  # #981: play icon, cover, heart and track text follow playback / the
  # browsed track through their binding components.
  let playbackChanged: Bool = playbackBindingsSystems(
    world: world
    playback: playback
    state: state
    reg: reg
  )
  # #980: the action sheet follows BottomSheetState.visible in place.
  bottomSheetSystem(world: world, sheet: state.bottomSheet)
  # #974: the profile page's data bindings. Both compare before writing, so
  # they cost nothing at idle and need no observer revision of their own.
  profileStatsSystem(world: world, state: state)
  avatarSystem(world: world, reg: reg)
  # #996: every data list (cover grids, search results, album tracks, the
  # sheet's actions, the recently-played strip) follows its ListSource's key.
  listSourceSystem(
    world: world
    state: state
    playback: playback
    scenes: scenes
  )
  # #977: the History page's rows follow playHistory.revision in place.
  historyListSystem(world: world, state: state)
  # #979: the album page's header follows the collection.
  albumHeaderSystem(world: world, state: state)

  ret UiRefreshResult {
    historyChanged: cache.historyRevision is not oldHistory
    playbackChanged: playbackChanged
  }
}
