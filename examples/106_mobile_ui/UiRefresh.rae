open ui/Ecs
open assetSystem/GpuAssetRegistry

# The per-frame UI observer state. The playback slice has been carved out
# into its own per-feature `UiPlaybackSystem` (#267, §5.2); `historyRevision`
# is the observer cache for the history list and becomes its own UI system in
# a follow-up. (The bottom sheet's epoch lives on its `BottomSheet` component
# since #980.)
type UiRefreshCache {
  # Last PlayHistory.revision this observer reacted to (#944, §7 system revision).
  historyRevision: Int
  uiPlayback: UiPlaybackSystem
}

type UiRefreshResult {
  historyChanged: Bool
  playbackChanged: Bool
}

func createUiRefreshCache(
  historyRevision: view Int
  playbackRevision: view Int
) pub ret UiRefreshCache {
  ret UiRefreshCache {
    historyRevision: historyRevision
    uiPlayback: createUiPlaybackSystem(observedRevision: playbackRevision)
  }
}

func refreshMountedUi(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  playback: view PlaybackState
  visible: view Screen
  cache: mod UiRefreshCache
  viewport: view Viewport
  reg: view TextureRegistry
) pub ret UiRefreshResult {
  let oldHistory: Int = cache.historyRevision

  cache.historyRevision = refreshHistoryViewsIfNeeded(
    world: world
    scenes: scenes
    state: state
    visible: visible
    cachedRevision: cache.historyRevision
    viewport: viewport
  )
  let playbackChanged: Bool = uiPlaybackObserve(
    this: cache.uiPlayback
    world: world
    playback: playback
    reg: reg
  )
  # #980: the action sheet follows BottomSheetState (visible + epoch) in place.
  bottomSheetSystem(world: world, sheet: state.bottomSheet, scenes: scenes)
  # #974: the profile page's data bindings. Both compare before writing, so
  # they cost nothing at idle and need no observer revision of their own.
  profileStatsSystem(world: world, state: state)
  avatarSystem(world: world, reg: reg)
  # #975: Home / Library cover grids follow state.libraryRevision.
  coverGridSystem(world: world, state: state, scenes: scenes)
  # #976: search result rows follow the SearchField's query.
  searchResultsSystem(world: world, state: state, scenes: scenes)
  # #977: the History page's rows follow playHistory.revision in place.
  historyListSystem(world: world, state: state)
  # #979: the album page's header + track rows follow the collection / playing song.
  albumHeaderSystem(world: world, state: state)
  trackListSystem(
    world: world
    state: state
    playback: playback
    scenes: scenes
  )

  ret UiRefreshResult {
    historyChanged: cache.historyRevision is not oldHistory
    playbackChanged: playbackChanged
  }
}
