import Gpu2d
open ui/PageTransitionSystem
open HotReload
open ui/Ecs
open ui/ScrollRootSystem
open ui/Pipeline
open ecs/Schedule
open ecs/Entity
open ui/EventLoop
open ui/DebugOverlay
open ui/Theme
import FileWatch

# The interactive session's state as RESOURCES (docs/ecs-resources.md): what
# used to be ~30 locals of the one 850-line `runApp` loop, hand-carried
# between the frame phases through result structs. Three records, by
# lifetime:
#
#   * AppSession — outlives every world rebuild: the route, the hero
#     transition, the scroll FSM, the input system, the debug UI, the
#     watchers, the per-frame caches. Created once by createAppSession
#     after the stress / screenshot modes have declined the run.
#   * WorldFrame — per built world: its schedule, scroll target, render
#     cache and the "rebuild me" flag. Fresh from createWorldFrame at every
#     outer-loop rebuild.
#   * FrameTick  — one frame's derived values (wait policy, scroll bounds,
#     the input dispatch verdict, `now`, activity), written by the frame
#     systems in order (frameSystem/): wait -> input -> update -> render.
#
# Every frame system takes `app`, the session, the world, the world frame
# and the tick as `mod` parameters; nothing else crosses a phase boundary.
type AppSession {
  running: Bool
  currentScreen: Screen
  # Data hot reload: the watched `.raescene` files (polled at 4 Hz).
  watcher: FileWatcher
  # Hot-reload signal from `rae watch` (snapshot state + exit 0 on reload).
  reloadWatcher: ReloadSignalWatcher
  # The standard debug widget (lib/ui/DebugOverlay), as every Rae UI app has
  # it: drawn on top, outside the UI world, so it persists across rebuilds
  debugOverlay: DebugOverlay
  # The last frame rendered (the widget's frame-rate count)
  renderedLastFrame: Bool
  # Where every page's scroll is (page id -> position): the lib scrollRootSystem
  # seeds a freshly mounted `ScrollRoot` from it and keeps it current, so a
  # page re-mounted on a data change lands where it was; the hot-reload
  # restore writes the restored screen's position into it at boot.
  scrollMemory: ScrollMemory
  # Active-album / track cache — refreshed only on album/track change, so the
  # hot loop never deep-copies a 15-25 track Album.
  cachedAlbumStem: String
  cachedTrackIndex: Int
  cachedTrackDurMs: Int
  lastHoverAnimDirty: Bool
  lastFrameTime: Float64
  # The pages' motion, and the screen a swipe from the edge left
  pageTransitions: PageTransitionSystem
  swipedFrom: Screen
  # InputSystem outlives world rebuilds so a held press carries
  # `pressedEntityId` across them.
  input: InputSystem
  lastHoveredEntityId: EntityId
  lastCursorKind: Int
  # True while album covers / history art are still streaming in.
  assetsLoading: Bool
  # One display frame at the monitor refresh rate; paces the wait + render cap.
  targetFrameSeconds: Float
  lastRenderTime: Float64
  # Any activity keeps the loop rendering at display cadence until this deadline.
  renderUntil: Float64
  # RAE_UI_TEST_RESIZE=<frames>:<W>x<H>: resize the window to W x H points
  # after that many frames (-1: never), the headless check that a resize
  # keeps the world (screenSystem/ScreenResize)
  testResizeIn: Int = -1
  testResizeW: Int = 0
  testResizeH: Int = 0
}

# The RAE_UI_TEST_RESIZE hook into `session`
func readTestResize(session: mod AppSession) {
  let text: String = getEnv(name: "RAE_UI_TEST_RESIZE")
  let parts: List(String) = text.split(sep: ":")
  if parts.length is not 2 {
    ret
  }
  let size: List(String) = parts.copyAtDefault(index: 1).split(sep: "x")
  if size.length is not 2 {
    ret
  }
  session.testResizeIn = parts.copyAtDefault(index: 0).toInt()
  session.testResizeW = size.copyAtDefault(index: 0).toInt()
  session.testResizeH = size.copyAtDefault(index: 1).toInt()
}

# Count the hook down once a frame; resize the window when it is due
func testResizeStep(session: mod AppSession) {
  if session.testResizeIn < 0 {
    ret
  }
  if session.testResizeIn is 0 {
    log("[ui] test resize to {session.testResizeW}x{session.testResizeH}")
    Gpu2d.setWindowSize(w: session.testResizeW, h: session.testResizeH)
  }
  session.testResizeIn = session.testResizeIn - 1
}

type WorldFrame {
  schedule: Schedule
  # The app binding systems' schedule (observeSystem/AppObservation): each
  # judged from its declared sources + tables before it runs.
  observation: AppObservation
  # The active page's `ScrollRoot` (findScrollRoot), re-resolved per frame.
  scrollTarget: EntityId
  renderCache: RenderCache
  forceRender: Bool
  lastPressed: EntityId
  # True once something asked for an outer-loop world rebuild (screen
  # switch, theme, debug toggle, data hot reload; a resize is applied in
  # place, screenSystem/ScreenResize).
  switching: Bool
}

type FrameTick {
  timeout: Float
  scrollOnThisScreen: Bool
  scrollFloor: Float
  scrollAnimating: Bool
  playbackAnimating: Bool
  busyAnimating: Bool
  nextScreen: Screen
  hadActions: Bool
  willSwitch: Bool
  now: Float64
  animating: Bool
  active: Bool
}

# The session for an interactive run. Seeds the active TAB from the restored
# screen (sub-pages do not survive across launches — rebooting always returns
# to the tab's base page) and the scroll position from the restore / the
# RAE_UI_SCROLL hook — into the scroll memory under the restored screen's page
# id, which is what the scrollRootSystem seeds that page's `ScrollRoot` from.
func createAppSession(app: mod App) ret AppSession {
  let restored: RestoredState = restoreStartState()
  app.appState.tab = restored.screen
  let restoredScrollY: Float = initialScrollY(restored: restored)
  var scrollMemory: ScrollMemory = createScrollMemory()
  rememberScroll(
    memory: scrollMemory
    pageId: pageIdForScreen(screen: visibleScreen(state: app.appState))
    position: restoredScrollY
  )
  var debugOverlay: DebugOverlay = createBootDebugOverlay()
  var session: AppSession = {
    running: true
    currentScreen: visibleScreen(state: app.appState)
    watcher: createSceneWatcher()
    reloadWatcher: createReloadSignalWatcher()
    debugOverlay: own debugOverlay
    renderedLastFrame: false
    scrollMemory: own scrollMemory
    cachedAlbumStem: ""
    cachedTrackIndex: -1
    cachedTrackDurMs: 0
    lastHoverAnimDirty: false
    lastFrameTime: 0.0
    pageTransitions: createPageTransitionSystem()
    swipedFrom: Screen.home
    input: createInputSystem()
    lastHoveredEntityId: noEntity()
    lastCursorKind: cursorArrow
    assetsLoading: true
    targetFrameSeconds: displayFrameSeconds()
    lastRenderTime: 0.0
    renderUntil: 0.0
  }
  readTestResize(session: session)
  ret session
}

func createFrameTick(session: view AppSession) ret FrameTick {
  ret FrameTick {
    timeout: 0.0
    scrollOnThisScreen: false
    scrollFloor: 0.0
    scrollAnimating: false
    playbackAnimating: false
    busyAnimating: false
    nextScreen: session.currentScreen
    hadActions: false
    willSwitch: false
    now: 0.0
    animating: false
    active: false
  }
}
