open ui/Ecs
# The playback widget bindings (#981) — the systems behind the `PlaybackIcon`,
# `PlaybackCover`, `LikedHeart` and `TrackText` components authored in
# MiniPlayer.raescene (the dock) and MusicPlayerNowPlaying.raescene.
# Each system drives EVERY instance of its component, so the dock and the
# Now Playing page share one binding and no page-id lookups: it reads the
# app / playback state, compares against the component's observed revision
# or key, and writes the node's Sprite / Text / WidgetState only on a change.
# Each is a row of the app's observation schedule (observeSystem/
# AppObservation) and runs only when a declared source moved — before the
# first paint of a fresh mount too, so a page needs no first run of its own.
#
# Layering (docs/ecs-systems-and-data-observation.md §5.2): these OBSERVE
# the data systems (PlaybackSystem, the liked playlist, the browsed album)
# and mutate only the UiWorld; the play/pause toggle itself is still a
# command (`enqueuePlaybackToggle`), never a write from here.
import ui/Components
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open assetSystem/GpuAssetRegistry

# Resolve the now-playing cover to a key whose texture is actually LOADED.
# The now-playing art is preferred, but only when the gpu2d registry has it:
# a Spotify "spotify-current" key whose fetch failed (or any key not yet
# registered) would otherwise render the mini-player / hero as a grey rect.
# Fall through to the playing track's local album cover (boot-loaded), then
# the browsed stem — the first LOADED one wins.
func coverKeyResolved(
  reg: view TextureRegistry
  playbackSystem: view PlaybackSystem
  browsedStem: view String
) pub ret String {
  if playbackSystem.nowPlayingArtKey.length() > 0 and textureHas(
    reg: reg
    key: playbackSystem.nowPlayingArtKey
  ) {
    ret "{playbackSystem.nowPlayingArtKey}"
  }
  if playbackSystem.playingAlbumStem.length() > 0 and textureHas(
    reg: reg
    key: playbackSystem.playingAlbumStem
  ) {
    ret "{playbackSystem.playingAlbumStem}"
  }
  ret "{browsedStem}"
}

# Re-point one Sprite's textureKey by identity, preserving every other field.
# Every `PlaybackIcon`: the play/pause glyph and the selected flag follow
# `isPlaying`, observed through `PlaybackSystem.revision`. Returns whether any
# icon changed (the caller re-syncs the widget styles on that).
func playbackIconSystem(world: mod UiWorld, playbackSystem: view PlaybackSystem) pub ret Bool {
  var changed: Bool = false
  let n: Int = componentCount(this: playbackSystem.playbackIcons)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: playbackSystem.playbackIcons, i: i)
    let builtRevision: Int = queryViewAt(table: playbackSystem.playbackIcons, denseIndex: i).builtRevision
    if builtRevision is not playbackSystem.revision {
      setSpriteKey(
        world: world
        entityId: entityId
        key: playbackIconKey(playbackSystem: playbackSystem)
      )
      setWidgetSelected(world: world, entityId: entityId, selected: playbackSystem.isPlaying)
      let icon: mod PlaybackIcon => queryModAt(table: playbackSystem.playbackIcons, denseIndex: i)
      icon.builtRevision = playbackSystem.revision
      changed = true
    }
    i = i + 1
  }
  ret changed
}

# Every `PlaybackCover`: seeded once from the browsed album (so a fresh mount
# shows the browsed cover), then re-pointed to the playing track's art when
# `nowPlayingRevision` moves — by identity, no re-mount. Nothing playing yet
# leaves the browsed cover untouched; its `HeroWidget` key follows the
# browsed stem. Returns whether any cover changed.
func playbackCoverSystem(
  world: mod UiWorld
  playbackSystem: view PlaybackSystem
  state: view AppState
  reg: view TextureRegistry
) pub ret Bool {
  var changed: Bool = false
  let n: Int = componentCount(this: playbackSystem.playbackCovers)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: playbackSystem.playbackCovers, i: i)
    let builtRevision: Int = queryViewAt(table: playbackSystem.playbackCovers, denseIndex: i).builtRevision
    if builtRevision is not playbackSystem.nowPlayingRevision {
      if builtRevision < 0 {
        let seed: String = coverKeyResolved(
          reg: reg
          playbackSystem: playbackSystem
          browsedStem: state.currentAlbumStem
        )
        setSpriteKey(world: world, entityId: entityId, key: seed)
      } else if playbackSystem.nowPlayingArtKey.length() > 0 {
        let key: String = coverKeyResolved(
          reg: reg
          playbackSystem: playbackSystem
          browsedStem: playbackSystem.playingAlbumStem
        )
        setSpriteKey(world: world, entityId: entityId, key: key)
      }
      let cover: mod PlaybackCover => queryModAt(
        table: playbackSystem.playbackCovers
        denseIndex: i
      )
      cover.builtRevision = playbackSystem.nowPlayingRevision
      changed = true
    }
    # The cover's `HeroWidget` key is the browsed album's stem (a scene
    # authors the `"albumCover"` placeholder), so a page-to-page hero
    # transition finds it by the same key as the tile it flies from.
    if componentHas(this: world.heroWidgets, entityId: entityId) {
      if componentView(this: world.heroWidgets, entityId: entityId).key is not state.currentAlbumStem {
        let hero: mod HeroWidget => componentMod(this: world.heroWidgets, entityId: entityId)
        hero.key = "{state.currentAlbumStem}"
      }
    }
    i = i + 1
  }
  ret changed
}

# The heart's declarative visuals: outline/filled glyph and white / warm
# coral tint by `selected`. StateStyle is a runtime table the scene loader
# refuses to author, so the system installs it on first sight.
func installHeartStyle(world: mod UiWorld, entityId: view EntityId) {
  let baseKey: String = "mat:favorite_border"
  let selKey: String = "mat:favorite"
  let noTextStyle: String = ""
  let noTextStyleSel: String = ""
  let unlikedTint: RgbaColor = { r: 255, g: 255, b: 255, a: 255 }
  let likedTint: RgbaColor = { r: 250, g: 80, b: 110, a: 255 }
  let clearFill: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let zeroOffset: Vec2 = { x: 0.0, y: 0.0 }
  let style: StateStyle = {
    spriteKey: own baseKey
    spriteKeySelected: own selKey
    tint: unlikedTint
    tintSelected: likedTint
    hasTint: true
    shapeFill: clearFill
    shapeFillSelected: clearFill
    hasShapeFill: false
    offset: zeroOffset
    offsetSelected: zeroOffset
    hasOffset: false
    textStyle: own noTextStyle
    textStyleSelected: own noTextStyleSel
    disabledAlpha: 1.0
    loadingAlpha: 1.0
    errorAlpha: 1.0
  }
  componentSet(this: world.stateStyles, entityId: entityId, data: own style)
}

# Every `LikedHeart`: WidgetState.selected mirrors whether the browsed
# (stem, trackIndex) is in the liked playlist. The liked bit depends on that
# pair rather than a revision, so this runs per frame and writes only when
# the bit flips. An empty stem (before any navigation) only installs the
# styles. Returns whether any heart changed, so the caller re-syncs the
# widget styles (the outline/filled swap) that frame.
func likedHeartSystem(
  playbackSystem: mod PlaybackSystem
  world: mod UiWorld
  liked: view Playlist
  stem: view String
  trackIndex: view Int
) pub ret Bool {
  var changed: Bool = false
  var isLiked: Bool = false
  if stem.length() > 0 {
    isLiked = playlistContains(playlist: liked, stem: stem, trackIndex: trackIndex)
  }
  let n: Int = componentCount(this: playbackSystem.likedHearts)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: playbackSystem.likedHearts, i: i)
    if queryViewAt(table: playbackSystem.likedHearts, denseIndex: i).styled is false {
      installHeartStyle(world: world, entityId: entityId)
      let heart: mod LikedHeart => queryModAt(table: playbackSystem.likedHearts, denseIndex: i)
      heart.styled = true
      changed = true
    }
    if stem.length() > 0 {
      var current: Bool = false
      if componentHas(this: world.widgetStates, entityId: entityId) {
        current = componentView(this: world.widgetStates, entityId: entityId).selected
      }
      if current is not isLiked {
        setWidgetSelected(world: world, entityId: entityId, selected: isLiked)
        changed = true
      }
    }
    i = i + 1
  }
  ret changed
}

# Write one Text's string in place, keeping its style. Compared BEFORE
# taking the mod ref: componentMod bumps the table generation eagerly, so
# an unchanged string would mark the render cache dirty every frame.
func writeTrackText(world: mod UiWorld, entityId: view EntityId, value: view String) {
  if componentHas(this: world.texts, entityId: entityId) is false {
    ret
  }
  let cur: view Text => componentView(this: world.texts, entityId: entityId)
  if cur.text is value {
    ret
  }
  let slot: mod Text => componentMod(this: world.texts, entityId: entityId)
  slot.text = "{value}"
}

# Every `TrackText`: the title / artist of the browsed track, keyed on
# stem|index so a same-page track change re-binds in place. The M:SS time
# labels are their own `PlaybackTime` binding (playbackTimeSystem).
func trackTextSystem(
  playbackSystem: mod PlaybackSystem
  world: mod UiWorld
  state: view AppState
) pub {
  let key: String = "{state.currentAlbumStem}|{state.currentTrackIndex}"
  let n: Int = componentCount(this: playbackSystem.trackTexts)
  var stale: Bool = false
  var i: Int = 0
  loop i < n {
    let binding: view TrackText => componentView(
      this: playbackSystem.trackTexts
      entityId: componentEntityAt(this: playbackSystem.trackTexts, i: i)
    )
    if binding.builtKey is not key {
      stale = true
    }
    i = i + 1
  }
  if stale is false {
    ret
  }
  let album: Album = activeAlbum(state: state)
  let track: Track = trackAt(album: album, idx: state.currentTrackIndex)
  i = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: playbackSystem.trackTexts, i: i)
    if queryViewAt(table: playbackSystem.trackTexts, denseIndex: i).builtKey is not key {
      if queryViewAt(table: playbackSystem.trackTexts, denseIndex: i).field is "artist" {
        writeTrackText(world: world, entityId: entityId, value: album.artist)
      } else {
        writeTrackText(world: world, entityId: entityId, value: track.title)
      }
      let binding: mod TrackText => queryModAt(table: playbackSystem.trackTexts, denseIndex: i)
      binding.builtKey = "{key}"
    }
    i = i + 1
  }
}

# The whole second a `PlaybackTime` currently shows, so its label is
# rewritten once per second while playing and never at rest.
func playbackTimeSecond(kind: view PlaybackTimeKind, playbackSystem: view PlaybackSystem) ret Int {
  if kind is PlaybackTimeKind.elapsed {
    ret playbackSystem.elapsedSec.toInt()
  }
  ret playbackSystem.durationSec.toInt()
}

# Every `PlaybackTime`: the M:SS position (`elapsed`) or duration (`total`)
# from the playback clock, written to `Text.text` only when the whole second
# changes (`builtSecond`).
func playbackTimeSystem(world: mod UiWorld, playbackSystem: view PlaybackSystem) pub {
  let n: Int = componentCount(this: playbackSystem.playbackTimes)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: playbackSystem.playbackTimes, i: i)
    let kind: PlaybackTimeKind = queryViewAt(table: playbackSystem.playbackTimes, denseIndex: i).kind
    let second: Int = playbackTimeSecond(kind: kind, playbackSystem: playbackSystem)
    if queryViewAt(table: playbackSystem.playbackTimes, denseIndex: i).builtSecond is not second {
      var seconds: Float = playbackSystem.durationSec
      if kind is PlaybackTimeKind.elapsed {
        seconds = playbackSystem.elapsedSec
      }
      let label: String = formatDurationMs(ms: (seconds * 1000.0).toInt())
      writeTrackText(world: world, entityId: entityId, value: label)
      let binding: mod PlaybackTime => queryModAt(
        table: playbackSystem.playbackTimes
        denseIndex: i
      )
      binding.builtSecond = second
    }
    i = i + 1
  }
}
