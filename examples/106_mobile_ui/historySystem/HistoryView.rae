open ui/Ecs
# Full play-history sub-page. Reached by tapping the "Recently
# played" header on Home. Vertical list, one row per logged play:
#   * 56x56 thumb (local album stem texture when known, else a
#     placeholder surface tile)
#   * title (primary) + artist (muted) stacked
#   * duration label on the right
# Tap a row → `history.replay.N` (newest = 0). The dispatcher
# either re-seeks to the local track or sends a Spotify query.
#
# The History entry is stored in `appState.playHistory.entries`,
# oldest-first. Rendering walks the list from the tail so the most
# recent play sits at the top of the page, matching user intuition.
#
# #964/#977: the page is assets/scenes/history.raescene and the list is the
# lib/ui `ListView` authored there over `history-row.raescene` (bindings and
# window size included). This file only turns the play history into
# `ListViewData` rows (one cell per bound field) through the `HistoryList`
# component's system; windowing, recycling and the scroll translation are
# the listViewSystem's (docs/ui-ecs-refactor-status §2.6).
import Files
open ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open ui/Theme
open ui/renderSystem/RenderSystem

const historyRowH: Float = 138.79518072289156

const historyRowGap: Float = 17.349397590361445  # spaceS

const historyThumbSize: Float = 121.44578313253011

const historyDurationW: Float = 121.44578313253011

const historyInfoH: Float = 91.08433734939759

const historyTitleH: Float = 47.71084337349397

const historyArtistH: Float = 34.69879518072289

const historyTextGap: Float = 8.674698795180722

# Cap on how many recent thumbs the Home "Recently played" preview
# row shows. Tuned so the row fits the screen width without
# horizontal scrolling at 64px thumbs + 8px gaps.
const recentlyPlayedPreviewMax: Int = 5

const recentlyPlayedHeaderH: Float = 52.04819277108433

const recentlyPlayedThumbSize: Float = 138.79518072289156

func historyEntryCount(history: view PlayHistory) pub ret Int {
  ret history.entries.length
}

# Total vertical extent of the History page body. Used by the
# scroll clamp so the user can pull the bottom rows into view.
func historyContentHeight(history: view PlayHistory) pub ret Float {
  let n: Int = history.entries.length
  if n is 0 {
    ret 0.0
  }
  ret historyRowH * n.toFloat() + historyRowGap * (n - 1).toFloat()
}

func historyScrollMin(history: view PlayHistory) pub ret Float {
  let viewport: Float = phoneFrameH - outerPad * 2.0 - miniPlayerH - navTabsH - outerGap - topBarH
  let content: Float = historyContentHeight(history: history)
  let overflow: Float = content - viewport
  if overflow <= 0.0 {
    ret 0.0
  }
  ret 0.0 - overflow
}

# Body content box (the scrolling region). Pure constants so the mount and
# the scroll clamp agree exactly.
func historyBodyW() pub ret Float {
  ret phoneFrameW - outerPad * 2.0
}

func historyBodyH() pub ret Float {
  ret phoneFrameH - topBarH - navTabsH - outerGap * 4.0 - outerPad * 2.0
}

# True when the entry has a textureKey the registry can paint.
# Local entries set it to the album stem; Spotify entries set it
# to the per-trackId key registered by `loadHistoryEntryArt`. Empty
# → placeholder fallback.
func historyHasArt(entry: view PlayHistoryEntry) pub ret Bool {
  ret entry.textureKey.length() > 0
}

# One recently-played thumb: the `recent-thumb` sub-scene as its own square
# root (#990: host-less).
# Has-art -> the Art sprite is switched on with the entry's stored textureKey
# (album stem for local, "spotify-art:<id>" for Spotify) and the placeholder
# off; no-art -> the authored muted placeholder chip stays, tagged with the
# entry identity and a loading fade until art lands.
# The rounded-covers setting strips the authored corner radii when off.
func mountRecentThumb(
  world: mod UiWorld
  scenes: view AlbumScenes
  entry: view PlayHistoryEntry
  size: view Float
  rounded: view Bool
  actionId: view String
) ret EntityId {
  var overrides: List(SceneOverride) = emptyOverrides()
  if historyHasArt(entry: entry) {
    addSpriteOverride(list: overrides, nodeId: "Art", value: "{entry.textureKey}")
    addActiveOverride(list: overrides, nodeId: "Art", value: true)
    addActiveOverride(list: overrides, nodeId: "Placeholder", value: false)
  }
  addOnClickActionOverride(list: overrides, nodeId: "Thumb", value: "{actionId}")
  let host: EntityId = mountRegistrySubSceneOrError(
    world: world
    reg: scenes.subScenes
    sceneId: "recent-thumb"
    overrides: overrides
    w: size
    h: size
  )
  if historyHasArt(entry: entry) is false {
    if let phRaw: Int = world.nodeIds.get(k: "Placeholder") {
      let placeholder: EntityId = nodeEntity(world: world, index: phRaw)
      setWidgetIdentity(
        world: world
        entity: placeholder
        id: "{entry.trackName}:{entry.artistName}"
        kind: "historyArtPlaceholder"
      )
      # StateStyle is a runtime table (not authorable), so the loading fade
      # is applied here.
      setOpacityStateStyle(
        world: world
        entity: placeholder
        disabledAlpha: 1.0
        loadingAlpha: 0.72
        errorAlpha: 0.42
      )
    }
  }
  if rounded is false {
    unsafe {
      let gathered: List(EntityId) = List.create(EntityId, cap: 4)
      collectSubtree(childrens: world.childrens, node: host, out: gathered)
      loop let e: view EntityId in gathered {
        componentRemove(this: world.cornerRadiuses, entity: e)
      }
    }
  }
  ret host
}

# One `ListViewRow` per play, newest first (visual 0 = the latest entry).
# The cells are exactly what the bindings read: the texts, the replay
# action with the REAL entries index baked in, the art key, and the
# placeholder switch ("true" when the entry has no art yet).
func historyRowCell(row: mod ListViewRow, key: view String, value: own String) {
  row.keys.add(value: "{key}")
  row.values.add(value: value)
}

func historyListData(history: view PlayHistory) ret ListViewData {
  unsafe {
    let n: Int = history.entries.length
    var rows: List(ListViewRow) = List.create(ListViewRow, cap: n)
    var visual: Int = 0
    loop visual < n {
      let i: Int = n - 1 - visual
      let e: PlayHistoryEntry = rae_ext_rae_buf_get(buf: history.entries.data, index: i)
      var row: ListViewRow = {
        keys: List.create(String, cap: 6)
        values: List.create(String, cap: 6)
      }
      historyRowCell(row: row, key: "title", value: "{e.trackName}")
      historyRowCell(row: row, key: "artist", value: "{e.artistName}")
      let durMs: Int = (e.durationSec * 1000.0).toInt()
      historyRowCell(row: row, key: "duration", value: formatDurationMs(ms: durMs))
      historyRowCell(row: row, key: "action", value: "history.replay.{i}")
      historyRowCell(row: row, key: "textureKey", value: "{e.textureKey}")
      var placeholder: String = "true"
      if historyHasArt(entry: e) {
        placeholder = "false"
      }
      historyRowCell(row: row, key: "placeholder", value: placeholder)
      rows.add(value: row)
      visual = visual + 1
    }
    ret ListViewData { rows: rows }
  }
}

# ----- the History page (#977, SCENE-DRIVEN) -------------------------------
# assets/scenes/history.raescene owns the page: top bar, the `EmptyState`
# line and the `Body` list host carrying the authored `ListView` (the
# `history-row` sub-scene, its bindings, the window size) plus a
# `HistoryList` binding component. This mount is one mountPageOrError + the
# Body's runtime ScrollState; `historyListSystem` below feeds the rows.
func mountHistoryPage(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  scrollY: view Float
  viewport: view Viewport
) pub ret EntityId {
  let scene: view Scene => scenes.history
  let overrides: List(SceneOverride) = emptyOverrides()
  let pageIdCopy: String = "{historyPageId}"
  let historyLabel: String = "history"
  let mount: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scene
    overrides: overrides
    w: viewport.areaDuW
    h: viewport.areaDuH
    sceneLabel: historyLabel
    subScenes: scenes.subScenes
  )
  attachSafeAreaEdges(
    world: world
    entity: mount
    top: 1.0
    bottom: 0.0
  )
  # The list host carries the ScrollState the app's scroll FSM drives; the
  # listViewSystem turns it into the rows' RuntimeOffset.
  if let bodyRaw: Int = findNodeInPage(world: world, pageId: historyPageId, nodeId: "Body") {
    let body: EntityId = nodeEntity(world: world, index: bodyRaw)
    let scroll: ScrollState = { y: scrollY, velocity: 0.0 }
    componentSet(this: world.scrollStates, entity: body, data: scroll)
  }
  # First fill now, so the rows exist before this frame's layout.
  historyListSystem(world: world, state: state)
  ret mount
}

func setHistoryActive(world: mod UiWorld, entity: view EntityId, active: view Bool) {
  if isNone(this: entity) {
    ret
  }
  var current: Bool = true
  if componentHas(this: world.actives, entity: entity) {
    let a: Active = componentGet(this: world.actives, entity: entity)
    current = a.value
  }
  if current is not active {
    let flag: Active = { value: active }
    componentSet(this: world.actives, entity: entity, data: flag)
  }
}

# Drive every `HistoryList`: when the play history's revision moved past the
# rows last built, rewrite the host's ListViewData (the listViewSystem re-binds
# its pooled rows in place on its next run) and show the host or the page's
# empty-state node. Runs every frame from UiRefresh (a no-op at idle) and once
# at mount.
func historyListSystem(world: mod UiWorld, state: view AppState) pub {
  let n: Int = componentCount(this: world.historyLists)
  var i: Int = 0
  loop i < n {
    let host: EntityId = componentEntityAt(this: world.historyLists, i: i)
    let binding: HistoryList = componentDataAt(this: world.historyLists, i: i)
    if binding.builtRevision is not state.playHistory.revision {
      componentSet(
        this: world.listViewDatas
        entity: host
        data: historyListData(history: state.playHistory)
      )
      let hasEntries: Bool = state.playHistory.entries.length > 0
      setHistoryActive(world: world, entity: host, active: hasEntries)
      let page: String = pageOf(world: world, entity: host)
      if let emptyRaw: Int = findNodeInPage(
        world: world
        pageId: page
        nodeId: binding.emptyStateNodeId
      ) {
        setHistoryActive(
          world: world
          entity: nodeEntity(world: world, index: emptyRaw)
          active: hasEntries is false
        )
      }
      let built: HistoryList = {
        emptyStateNodeId: "{binding.emptyStateNodeId}"
        builtRevision: state.playHistory.revision
      }
      componentSet(this: world.historyLists, entity: host, data: built)
    }
    i = i + 1
  }
}

# Materialise the most-recent plays into an existing strip container
# (the scene-authored `RecentlyPlayedStrip` node on Home — the
# container's size/layout/gap live in home.raescene since #213; this
# is the data adapter). Capped at `recentlyPlayedPreviewMax` and
# emits one tile per entry, newest-first. Each tile fires
# `history.replay.N` with the *real* entries index baked in (so the
# dispatcher logic stays index-stable whether the user taps from
# Home or from the full History page).
func fillRecentlyPlayedStrip(
  world: mod UiWorld
  scenes: view AlbumScenes
  strip: view EntityId
  history: view PlayHistory
  rounded: view Bool
) pub {
  unsafe {
    let n: Int = history.entries.length
    var kidsCount: Int = recentlyPlayedPreviewMax
    if n < kidsCount {
      kidsCount = n
    }
    let kids: List(EntityId) = List.create(EntityId, cap: kidsCount)
    var visual: Int = 0
    loop visual < kidsCount {
      let entryIdx: Int = n - 1 - visual
      let e: PlayHistoryEntry = rae_ext_rae_buf_get(buf: history.entries.data, index: entryIdx)
      let tile: EntityId = mountRecentThumb(
        world: world
        scenes: scenes
        entry: e
        size: recentlyPlayedThumbSize
        rounded: rounded
        actionId: "history.replay.{entryIdx}"
      )
      kids.add(value: tile)
      visual = visual + 1
    }
    attachChildren(world: world, parent: strip, kids: kids)
  }
}
