open ui/Ecs
# Full play-history sub-page. Reached by tapping the "Recently
# played" header on Home. Vertical list, one row per logged play:
#   * 56x56 thumb (local album stem texture when known, else a
#     placeholder surface tile)
#   * title (primary) + artist (muted) stacked
#   * duration label on the right
# Tap a row → `history.replay.N` (newest = 0). The dispatcher
# either re-seeks to the local track or sends a Spotify query.
#
# The History entry is stored in `appState.playHistory.entries`,
# oldest-first. Rendering walks the list from the tail so the most
# recent play sits at the top of the page, matching user intuition.
#
# #964: the list is a lib/ui `ListView` over `history-row.raescene`. This
# file only turns the play history into `ListViewData` rows (one cell per
# bound field) and declares the bindings; windowing, recycling and the
# scroll translation are the listViewSystem's (docs/ui-ecs-refactor-status
# §2.6). The row template's nodes: HistoryRow (OnClick), Thumb (Sprite,
# with a ThumbPlaceholder child toggled by `Active`), Title, Artist,
# Duration.
import Files
open ui/Components
import ui/layoutSystem/LayoutSystem
open ecs/ComponentTable
open ui/Theme
open ui/renderSystem/RenderSystem

const historyRowH: Float = 138.79518072289156

const historyRowGap: Float = 17.349397590361445  # spaceS

const historyThumbSize: Float = 121.44578313253011

const historyDurationW: Float = 121.44578313253011

const historyInfoH: Float = 91.08433734939759

const historyTitleH: Float = 47.71084337349397

const historyArtistH: Float = 34.69879518072289

const historyTextGap: Float = 8.674698795180722

# Cap on how many recent thumbs the Home "Recently played" preview
# row shows. Tuned so the row fits the screen width without
# horizontal scrolling at 64px thumbs + 8px gaps.
const recentlyPlayedPreviewMax: Int = 5

const recentlyPlayedHeaderH: Float = 52.04819277108433

const recentlyPlayedThumbSize: Float = 138.79518072289156

func historyEntryCount(history: view PlayHistory) pub ret Int {
  ret history.entries.length
}

# Total vertical extent of the History page body. Used by the
# scroll clamp so the user can pull the bottom rows into view.
func historyContentHeight(history: view PlayHistory) pub ret Float {
  let n: Int = history.entries.length
  if n is 0 {
    ret 0.0
  }
  ret historyRowH * n.toFloat() + historyRowGap * (n - 1).toFloat()
}

func historyScrollMin(history: view PlayHistory) pub ret Float {
  let viewport: Float = phoneFrameH - outerPad * 2.0 - miniPlayerH - navTabsH - outerGap - topBarH
  let content: Float = historyContentHeight(history: history)
  let overflow: Float = content - viewport
  if overflow <= 0.0 {
    ret 0.0
  }
  ret 0.0 - overflow
}

# ----- List virtualization (#964: lib/ui ListView) ------------------
# Extra rows kept live above + below the viewport so a fast scroll doesn't
# flash blank before the pooled rows are re-bound.
const historyWindowBuffer: Int = 4

# Body content box (the scrolling region). Pure constants so the mount and
# the scroll clamp agree exactly.
func historyBodyW() pub ret Float {
  ret phoneFrameW - outerPad * 2.0
}

func historyBodyH() pub ret Float {
  ret phoneFrameH - topBarH - navTabsH - outerGap * 4.0 - outerPad * 2.0
}

# Rows spanning the viewport (plus one for a partially visible bottom row).
func historyVisibleRows() ret Int {
  let pitch: Float = historyRowH + historyRowGap
  ret (historyBodyH() / pitch).toInt() + 1
}

# True when the entry has a textureKey the registry can paint.
# Local entries set it to the album stem; Spotify entries set it
# to the per-trackId key registered by `loadHistoryEntryArt`. Empty
# → placeholder fallback.
func historyHasArt(entry: view PlayHistoryEntry) pub ret Bool {
  ret entry.textureKey.length() > 0
}

# Build a single thumb entity. Has-art → sprite bound to the
# entry's stored textureKey (album stem for local, "spotify-art:<id>"
# for Spotify). No-art → a visible placeholder rect filled with the
# theme's `textMuted` color.
func buildHistoryThumb(
  world: mod UiWorld
  entry: view PlayHistoryEntry
  size: view Float
  rounded: view Bool
) ret EntityId {
  let thumb: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: thumb
    w: size
    h: size
  )
  if rounded {
    let cr: CornerRadius = { radius: 17.349397590361445 }
    componentSet(this: world.cornerRadiuses, entity: thumb, data: cr)
  }
  if historyHasArt(entry: entry) {
    let key: String = "{entry.textureKey}"
    setSpriteFill(
      world: world
      entity: thumb
      key: key
      tint: paletteImageTint(theme: world.theme.active)
    )
    setHoverScale(world: world, entity: thumb, hoverScale: 1.12)
  } else {
    let mutedName: String = "textMuted"
    let fill: RgbaColor = colorByName(theme: world.theme.active, name: mutedName)
    let transparent: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
    var radius: Float = 0.0
    if rounded {
      radius = 17.349397590361445
    }
    let sp: Shape = {
      kind: ShapeKind.roundedRect
      fill: fill
      stroke: transparent
      strokeWidth: 0.0
      radius: radius
    }
    componentSet(this: world.shapes, entity: thumb, data: sp)
    let widgetId: String = "{entry.trackName}:{entry.artistName}"
    let kind: String = "historyArtPlaceholder"
    setWidgetIdentity(
      world: world
      entity: thumb
      id: widgetId
      kind: kind
    )
    setWidgetState(
      world: world
      entity: thumb
      enabled: true
      selected: false
      loading: true
      error: false
    )
    let source: DataResourceId = dataResourceHistory()
    let field: DataFieldId = dataFieldAll()
    setDataDependency(
      world: world
      entity: thumb
      resource: source
      field: field
      observedRevision: 0
    )
    setOpacityStateStyle(
      world: world
      entity: thumb
      disabledAlpha: 1.0
      loadingAlpha: 0.72
      errorAlpha: 0.42
    )
    setHoverScale(world: world, entity: thumb, hoverScale: 1.12)
  }
  ret thumb
}

# One `ListViewRow` per play, newest first (visual 0 = the latest entry).
# The cells are exactly what the bindings read: the texts, the replay
# action with the REAL entries index baked in, the art key, and the
# placeholder switch ("true" when the entry has no art yet).
func historyRowCell(row: mod ListViewRow, key: view String, value: own String) {
  row.keys.add(value: "{key}")
  row.values.add(value: value)
}

func historyListData(history: view PlayHistory) ret ListViewData {
  unsafe {
    let n: Int = history.entries.length
    var rows: List(ListViewRow) = List.create(ListViewRow, cap: n)
    var visual: Int = 0
    loop visual < n {
      let i: Int = n - 1 - visual
      let e: PlayHistoryEntry = rae_ext_rae_buf_get(buf: history.entries.data, index: i)
      var row: ListViewRow = {
        keys: List.create(String, cap: 6)
        values: List.create(String, cap: 6)
      }
      historyRowCell(row: row, key: "title", value: "{e.trackName}")
      historyRowCell(row: row, key: "artist", value: "{e.artistName}")
      let durMs: Int = (e.durationSec * 1000.0).toInt()
      historyRowCell(row: row, key: "duration", value: formatDurationMs(ms: durMs))
      historyRowCell(row: row, key: "action", value: "history.replay.{i}")
      historyRowCell(row: row, key: "textureKey", value: "{e.textureKey}")
      var placeholder: String = "true"
      if historyHasArt(entry: e) {
        placeholder = "false"
      }
      historyRowCell(row: row, key: "placeholder", value: placeholder)
      rows.add(value: row)
      visual = visual + 1
    }
    ret ListViewData { rows: rows }
  }
}

func historyBinding(
  nodeId: view String
  componentName: view String
  fieldName: view String
  itemField: view String
) ret ListViewBinding {
  ret ListViewBinding {
    nodeId: "{nodeId}"
    componentName: "{componentName}"
    fieldName: "{fieldName}"
    itemField: "{itemField}"
    prefix: ""
    suffix: ""
  }
}

# The History ListView: the `history-row` sub-scene per pooled row, one
# binding per cell, sized from the row constants above.
func historyListView() ret ListView {
  var bindings: List(ListViewBinding) = List.create(ListViewBinding, cap: 6)
  bindings.add(value: historyBinding(
    nodeId: "Title"
    componentName: "Text"
    fieldName: "text"
    itemField: "title"
  ))
  bindings.add(value: historyBinding(
    nodeId: "Artist"
    componentName: "Text"
    fieldName: "text"
    itemField: "artist"
  ))
  bindings.add(value: historyBinding(
    nodeId: "Duration"
    componentName: "Text"
    fieldName: "text"
    itemField: "duration"
  ))
  bindings.add(value: historyBinding(
    nodeId: "HistoryRow"
    componentName: "OnClick"
    fieldName: "actionId"
    itemField: "action"
  ))
  bindings.add(value: historyBinding(
    nodeId: "Thumb"
    componentName: "Sprite"
    fieldName: "textureKey"
    itemField: "textureKey"
  ))
  bindings.add(value: historyBinding(
    nodeId: "ThumbPlaceholder"
    componentName: "Active"
    fieldName: "value"
    itemField: "placeholder"
  ))
  var lv: ListView = ListView.default()
  lv.itemSceneId = "history-row"
  lv.itemHeight = historyRowH
  lv.itemGap = historyRowGap
  lv.visibleItemCount = historyVisibleRows()
  lv.overscanRows = historyWindowBuffer
  lv.bindings = bindings
  ret lv
}

# The scrolling body: a ListView over the play history. The body carries the
# ScrollState the app's scroll FSM drives; the listViewSystem keeps the pooled
# `history-row` instances re-bound to the rows in view. An empty history shows
# a single muted line instead of a list.
func buildHistoryBody(
  world: mod UiWorld
  history: view PlayHistory
  rounded: view Bool
  scrollY: view Float
) ret EntityId {
  let body: EntityId = createEntity(world: world)
  let bodyW: Float = historyBodyW()
  let bodyH: Float = historyBodyH()
  setRectFixed(
    world: world
    entity: body
    w: bodyW
    h: bodyH
  )
  let scroll: ScrollState = { y: scrollY, velocity: 0.0 }
  componentSet(this: world.scrollStates, entity: body, data: scroll)
  if history.entries.length is 0 {
    let empty: EntityId = createEntity(world: world)
    setRectFixed(
      world: world
      entity: empty
      w: bodyW
      h: 40.0
    )
    let style: String = "muted"
    let text: String = "Nothing played yet."
    setText(
      world: world
      entity: empty
      text: text
      styleId: style
    )
    let kids: List(EntityId) = List.create(EntityId, cap: 1)
    kids.add(value: empty)
    attachChildren(world: world, parent: body, kids: kids)
    ret body
  }
  componentSet(this: world.listViews, entity: body, data: historyListView())
  componentSet(this: world.listViewDatas, entity: body, data: historyListData(history: history))
  ret body
}

func mountHistoryPage(
  world: mod UiWorld
  state: view AppState
  scrollY: view Float
  viewport: view Viewport
) pub ret EntityId {
  let root: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: root
    w: viewport.areaDuW
    h: viewport.areaDuH
  )
  let layV: LayoutType = LayoutType.vertical
  let alignS: AlignKind = AlignKind.start
  setLayout(
    world: world
    entity: root
    kind: layV
    gap: outerGap
    alignCross: alignS
  )
  setPaddingAll(world: world, entity: root, n: outerPad)

  var copiedId: String = ""
  copiedId = copiedId.concat(other: historyPageId)
  let pr: PageRoot = { id: own copiedId }
  componentSet(this: world.pageRoots, entity: root, data: own pr)

  let topBar: EntityId = buildPageTopBar(world: world, title: "Recently played")
  let body: EntityId = buildHistoryBody(
    world: world
    history: state.playHistory
    rounded: state.settings.roundedAlbumCovers
    scrollY: scrollY
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 2)
  kids.add(value: topBar)
  kids.add(value: body)
  attachChildren(world: world, parent: root, kids: kids)
  attachSafeAreaEdges(
    world: world
    entity: root
    top: 1.0
    bottom: 0.0
  )
  ret root
}

# Materialise the most-recent plays into an existing strip container
# (the scene-authored `RecentlyPlayedStrip` node on Home — the
# container's size/layout/gap live in home.raescene since #213; this
# is the data adapter). Capped at `recentlyPlayedPreviewMax` and
# emits one tile per entry, newest-first. Each tile fires
# `history.replay.N` with the *real* entries index baked in (so the
# dispatcher logic stays index-stable whether the user taps from
# Home or from the full History page).
func fillRecentlyPlayedStrip(
  world: mod UiWorld
  strip: view EntityId
  history: view PlayHistory
  rounded: view Bool
) pub {
  unsafe {
    let n: Int = history.entries.length
    var kidsCount: Int = recentlyPlayedPreviewMax
    if n < kidsCount {
      kidsCount = n
    }
    let kids: List(EntityId) = List.create(EntityId, cap: kidsCount)
    var visual: Int = 0
    loop visual < kidsCount {
      let entryIdx: Int = n - 1 - visual
      let e: PlayHistoryEntry = rae_ext_rae_buf_get(buf: history.entries.data, index: entryIdx)
      let tile: EntityId = buildHistoryThumb(
        world: world
        entry: e
        size: recentlyPlayedThumbSize
        rounded: rounded
      )
      let replayAction: String = "history.replay.{entryIdx}"
      setOnClick(world: world, entity: tile, actionId: replayAction)
      kids.add(value: tile)
      visual = visual + 1
    }
    attachChildren(world: world, parent: strip, kids: kids)
  }
}
