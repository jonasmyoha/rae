import Gpu2d
open ui/Ecs
open ui/DevicePresets
open ui/SizeClass
open ui/DesignUnits
open ui/ResponsiveExtent
open ui/UiZoom

# 106's coordinate spine: lib/ui's responsive extent (ui/ResponsiveExtent).
# The layout is the window in points (docs/ui-coordinate-and-responsive-
# layout.md, rule 2), or an emulated phone's screen; the pages mount in a
# phone column, wider on a medium window, with the Library side panel beside
# it on an expanded one.
type DeviceFrame {
  forcedFrameId: Int
}

type Viewport {
  windowPtW: Float
  windowPtH: Float
  framebufferPxW: Float
  framebufferPxH: Float
  dpr: Float
  unitScale: Float
  areaDuW: Float
  areaDuH: Float
  renderScale: Float
  layoutW: Float
  layoutH: Float
  forcedFrameId: Int
  devicePresetActive: Bool
  safeInsetsDu: Insets
  # The layout's size class, and what it lays out: compact fills the window
  # with the page column, medium widens the column for a wider grid, expanded
  # adds the Library side panel left of the column (0 when there is none)
  sizeClass: SizeClass
  sidePanelDuW: Float
  # The user zoom (ui/UiZoom): the layout is the window in points / uiZoom
  uiZoom: Float
}

# The page column is the phone frame's width; past compact it is 1.5 times
# that (2 grid columns become 3), and the side panel at least 150 pt
func viewportColumns() ret ResponsiveColumns {
  ret ResponsiveColumns { phoneColumnW: phoneFrameW, wideColumnFactor: 1.5, sidePanelMinW: 150.0 }
}

func frameIdToInt(id: view String) pub ret Int {
  if id is "PhonePortrait" {
    ret 1
  }
  if id is "Desktop" {
    ret 2
  }
  ret 0
}

func frameIdName(id: view Int) pub ret String {
  if id is 1 {
    ret "PhonePortrait"
  }
  if id is 2 {
    ret "Desktop"
  }
  ret "none"
}

# No preset by default: the real window drives the layout (its size class,
# live while it is resized). `RAE_UI_DEVICE=<preset>` (e.g. iphone-15-pro)
# emulates one phone's screen and safe areas instead.
func active106DevicePreset() ret DevicePreset {
  let id: String = getEnv(name: "RAE_UI_DEVICE")
  if id.length() <= 0 or id is "none" {
    ret devicePresetNone()
  }
  ret devicePresetById(id: id)
}

# The frame `RAE_UI_FRAME` forces, or the phone frame while a device is
# emulated (0: none, the window's own)
func activeDeviceFrame() pub ret DeviceFrame {
  var frameId: Int = frameIdToInt(id: getEnv(name: "RAE_UI_FRAME"))
  if frameId is 0 and active106DevicePreset().width > 0.0 {
    frameId = 1
  }
  ret DeviceFrame { forcedFrameId: frameId }
}

func createViewport(
  windowPtW: view Float
  windowPtH: view Float
  framebufferPxW: view Float
  framebufferPxH: view Float
  zoom: view Float
) pub ret Viewport {
  let extent: ResponsiveExtent = responsiveExtent(
    windowW: duFromPointsAt(points: windowPtW, zoom: zoom)
    windowH: duFromPointsAt(points: windowPtH, zoom: zoom)
    framebufferW: framebufferPxW
    framebufferH: framebufferPxH
    preset: active106DevicePreset()
    columns: viewportColumns()
  )
  var dprValue: Float = 1.0
  if windowPtW > 0.0 {
    dprValue = framebufferPxW / windowPtW
  }
  ret Viewport {
    windowPtW: windowPtW
    windowPtH: windowPtH
    framebufferPxW: framebufferPxW
    framebufferPxH: framebufferPxH
    dpr: dprValue
    unitScale: unitScale
    areaDuW: extent.columnW
    areaDuH: extent.columnH
    renderScale: extent.renderScale
    layoutW: extent.layoutW
    layoutH: extent.layoutH
    forcedFrameId: activeDeviceFrame().forcedFrameId
    devicePresetActive: extent.deviceEmulated
    safeInsetsDu: extent.safeInsets
    sizeClass: extent.sizeClass
    sidePanelDuW: extent.sidePanelW
    uiZoom: clampUiZoom(zoom: zoom)
  }
}

# The zoom 106 starts at: `RAE_UI_ZOOM=2x` (ui/UiZoom), else 1x. Ctrl/Cmd
# + - 0 change it while it runs (FrameInputSystem).
func startUiZoom() ret Float {
  let zoom: Float = parseUiZoom(text: getEnv(name: "RAE_UI_ZOOM"))
  if zoom <= 0.0 {
    ret 1.0
  }
  ret zoom
}

# The viewport of the live window at `zoom`: its framebuffer, which tracks
# runtime resizes, over the display's pixels per point
func createViewportFromWindow(zoom: view Float) pub ret Viewport {
  let framebufferW: Float = uiFramebufferWidth().toFloat()
  let framebufferH: Float = uiFramebufferHeight().toFloat()
  var dprValue: Float = Gpu2d.dpr()
  if dprValue < 0.1 {
    dprValue = 1.0
  }
  ret createViewport(
    windowPtW: pointsFromDu(du: duFromPixels(pixels: framebufferW, dpr: dprValue))
    windowPtH: pointsFromDu(du: duFromPixels(pixels: framebufferH, dpr: dprValue))
    framebufferPxW: framebufferW
    framebufferPxH: framebufferH
    zoom: zoom
  )
}

func applyViewportExtent(world: mod UiWorld, viewport: view Viewport) pub {
  world.layoutW = viewport.layoutW
  world.layoutH = viewport.layoutH
  world.uiZoom = viewport.uiZoom
}
