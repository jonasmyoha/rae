# Mobile-UI demo entrypoint. The actual work — scene loading, world
# building, screen routing — lives in sibling `.rae` files in this same
# directory, which Rae auto-imports because they share the project
# root. This file owns only the program's lifecycle: window setup, font
# loading, the main render/dispatch loop, and teardown.
#
# Architecture (all files in this folder are auto-imported):
#   * config.rae           — layout, palette, asset paths
#   * world_helpers.rae    — ECS component-setter shorthands
#   * sceneLoader.rae     — parse the four .raescene files into an AlbumScenes
#   * scene_mount.rae      — mountOrError + visible error sentinel
#   * album_view.rae       — album-screen builders, including buildAlbumWorld
#   * now_playing_view.rae — buildNowPlayingWorld
#   * screen_router.rae    — Screen enum, the screen table, buildScreenWorld
#   * actionSystem/        — the action table + the command systems (what a tap does)
#   * album_loader.rae     — Album / Track structs + loadAllAlbums (album.json)
#   * asset_loader.rae     — GPU2D image-key loading (per-album cover + avatar)
import FileWatch
import SdfText
import sys/Spotify
import ui/renderSystem/RenderSystem
import ui/Scene
open ecs/Entity
open ui/ThemeResolved
open ui/ThemeParse
open ecs/ComponentTable
open ui/fitSystem/FitSystem
open ui/layoutSystem/LayoutSystem
open ui/Theme
open ui/Transform
open ui/animationSystem/AnimationSystem
open Gpu2dCanvas

# The interactive lifecycle, as one `mainLoop` (Main.rae): `AppRun` is its
# state and `runAppFrame` one frame. `app` (AppTypes.rae) carries the setup
# state; the run's own state is the AppSession resource (AppSession.rae), the
# per-world state a WorldFrame, and each frame's derived values a FrameTick.
# A frame runs the four frame systems (frameSystem/); when one asks for a
# rebuild (`frame.switching`: a screen switch, a resize) the next frame builds
# the world again first. Being a mainLoop is what lets the window keep laying
# out while macOS runs a live resize in its own loop: the runtime runs this
# frame from there (rae_set_live_frame).
type AppRun {
  app: App
  session: AppSession
  world: UiWorld
  frame: WorldFrame
}

# Memory-stress and screenshot modes run to the end here, before the loop.
# True when one ran (the program then ends).
func runOneShotModes(app: mod App) ret Bool {
  if runStressMode(
    uiSystems: app.uiSystems
    dockSystem: app.musicSystems.dockSystem
    scenes: app.scenes
    appState: app.appState
    gpuUi: app.gpuUi
  ) {
    ret true
  }
  if runScreenshotMode(
    scenes: app.scenes
    appState: app.appState
    textureRegistry: app.textureRegistry
    bg: palettePageBg(theme: app.appState.theme.active)
  ) {
    finishApp(app: app)
    ret true
  }
  ret false
}

# The App holds GPU handles (the canvas's encoder), so it is moved into the
# run under `unsafe`, never copied
func createAppRun(app: own App) ret AppRun {
  unsafe {
    var running: App = app
    var session: AppSession = createAppSession(app: running)
    var world: UiWorld = startWorld(app: running, session: session)
    let frame: WorldFrame = createWorldFrame(world: world, uiSystems: running.uiSystems)
    ret AppRun { app: running, session: session, world: world, frame: frame }
  }
}

# A new world for the current route: the lib systems' derived tables start
# empty with it, and the cover system takes the mounted pages' AlbumCover
# markers before the first frame observes
func startWorld(app: mod App, session: mod AppSession) ret UiWorld {
  refreshActiveAlbumCache(app: app, session: session)
  app.uiSystems = createUiSystems()
  var world: UiWorld = buildSessionWorld(app: app, session: session)
  resetMusicTables(musicSystems: app.musicSystems)
  applyMusicComponents(world: world, musicSystems: app.musicSystems)
  ret world
}

# One frame; false when the app has finished (its window closed)
func runAppFrame(run: mod AppRun) ret Bool {
  if run.frame.switching {
    run.world = startWorld(app: run.app, session: run.session)
    run.frame = createWorldFrame(world: run.world, uiSystems: run.app.uiSystems)
  }
  var tick: FrameTick = createFrameTick(session: run.session)
  frameWaitSystem(
    app: run.app
    session: run.session
    world: run.world
    uiSystems: run.app.uiSystems
    frame: run.frame
    tick: tick
  )
  if run.session.running {
    frameInputSystem(
      app: run.app
      session: run.session
      world: run.world
      frame: run.frame
      tick: tick
    )
    frameUpdateSystem(
      app: run.app
      session: run.session
      world: run.world
      uiSystems: run.app.uiSystems
      frame: run.frame
      tick: tick
    )
    frameRenderSystem(
      app: run.app
      session: run.session
      world: run.world
      frame: run.frame
      tick: tick
    )
    # Frame end (MusicSystems.rae): the components this app's systems own
    # reach their tables, the rest is reported, and the entities a screen
    # switch unmounted are cleared and recycled.
    musicFrameEnd(
      world: run.world
      uiSystems: run.app.uiSystems
      musicSystems: run.app.musicSystems
    )
    ret true
  }
  finishApp(app: run.app)
  ret false
}

# The end of the run: the final snapshot (it captures window-drag-only
# sessions where no dispatched action fired, so no in-loop save ran), the
# background workers joined (#950: the poll worker on its stop channel, the
# artwork downloads waited out), then the window closed
func finishApp(app: mod App) {
  saveAppState(
    path: stateFilePath
    state: app.appState
    playbackSystem: app.musicSystems.playbackSystem
  )
  stopSpotifyPoller(poller: app.spotifyPoller)
  shutdownArtworkFetchQueue(queue: app.appState.artworkFetch)
  textureUnloadAll(reg: app.textureRegistry)
  uiCloseWindow()
}
