# Mobile-UI demo entrypoint. The actual work — scene loading, world
# building, screen routing — lives in sibling `.rae` files in this same
# directory, which Rae auto-imports because they share the project
# root. This file owns only the program's lifecycle: window setup, font
# loading, the main render/dispatch loop, and teardown.
#
# Architecture (all files in this folder are auto-imported):
#   * config.rae           — layout, palette, asset paths
#   * world_helpers.rae    — ECS component-setter shorthands
#   * sceneLoader.rae     — parse the four .raescene files into an AlbumScenes
#   * scene_mount.rae      — mountOrError + visible error sentinel
#   * album_view.rae       — album-screen builders, including buildAlbumWorld
#   * now_playing_view.rae — buildNowPlayingWorld
#   * screen_router.rae    — Screen enum, the screen table, buildScreenWorld
#   * actionSystem/        — the action table + the command systems (what a tap does)
#   * album_loader.rae     — Album / Track structs + loadAllAlbums (album.json)
#   * asset_loader.rae     — GPU2D image-key loading (per-album cover + avatar)
import FileWatch
import SdfText
import sys/Spotify
import ui/renderSystem/RenderSystem
import ui/Scene
open ecs/Entity
open ui/ThemeResolved
open ui/ThemeParse
open ecs/ComponentTable
open ui/fitSystem/FitSystem
open ui/layoutSystem/LayoutSystem
open ui/Theme
open ui/Transform
open ui/animationSystem/AnimationSystem
open Gpu2dCanvas

# The interactive lifecycle. `app` (AppTypes.rae) carries the setup state;
# the run's own state is the AppSession resource (AppSession.rae), the per-
# world state a WorldFrame, and each frame's derived values a FrameTick. The
# outer loop owns the world for the current route; the inner loop runs the
# four frame systems (frameSystem/) until the window closes or a system asks
# for a rebuild (`frame.switching`), at which point the world is rebuilt.
func runApp(app: mod App) {
  # Memory-stress and screenshot modes both terminate after their run.
  if runStressMode(scenes: app.scenes, appState: app.appState, gpuUi: app.gpuUi) {
    ret
  }
  if runScreenshotMode(
    scenes: app.scenes
    appState: app.appState
    textureRegistry: app.textureRegistry
    bg: palettePageBg(theme: app.appState.theme.active)
  ) is false {
    var session: AppSession = createAppSession(app: app)
    loop session.running {
      refreshActiveAlbumCache(app: app, session: session)
      let world: UiWorld = buildSessionWorld(app: app, session: session)
      var frame: WorldFrame = createWorldFrame(world: world)
      loop session.running and frame.switching is false {
        var tick: FrameTick = createFrameTick(session: session)
        frameWaitSystem(
          app: app
          session: session
          world: world
          frame: frame
          tick: tick
        )
        if session.running {
          frameInputSystem(
            app: app
            session: session
            world: world
            frame: frame
            tick: tick
          )
          frameUpdateSystem(
            app: app
            session: session
            world: world
            frame: frame
            tick: tick
          )
          frameRenderSystem(
            app: app
            session: session
            world: world
            frame: frame
            tick: tick
          )
        }
      }
    }
  }

  # Final snapshot — captures window-drag-only sessions where no dispatched
  # action fired (and thus no in-loop save ran).
  saveAppState(path: stateFilePath, state: app.appState, playback: app.playback)
  # #950: join the background workers before the window goes — the poll
  # worker on its stop channel, the artwork downloads by waiting them out.
  stopSpotifyPoller(poller: app.spotifyPoller)
  shutdownArtworkFetchQueue(queue: app.appState.artworkFetch)
  textureUnloadAll(reg: app.textureRegistry)
  uiCloseWindow()
}
