open ui/Ecs
open ecs/Event
open ecs/Entity
open ui/UiSystems
open ui/InputKind

# Per-frame "did anything change?" gate. With the wait-events loop,
# the inner loop iterates only when an OS event arrived or our timeout
# fired — so this decision controls whether we run
# `beginDrawing → renderSystem → endDrawing` at all.
#
# Active when ANY of:
#   - first frame after world rebuild (forceRender)
#   - tracked visual ComponentTable bumped (cacheDirty)
#   - input produced a UiAction event
#   - pressed-entity transition (catches the release edge)
#   - hero transition is mid-flight
#   - mouse button is currently held down (catches the release edge
#     reliably on the next frame)
#   - bare press/release edge fired this frame (the platform event
#     pump advances edge state at the frame boundary)
#   - debug input-outline toggle on and the hovered OnClick entity
#     or held-button mask changed since last frame.
type RenderActiveDecision {
  active: Bool
  currentHovered: EntityId
}

func decideActive(
  world: view UiWorld
  uiSystems: view UiSystems
  renderCache: mod RenderCache
  input: view InputSystem
  forceRender: view Bool
  animating: view Bool
  prevPressed: view EntityId
  prevHovered: view EntityId
  viewport: view Viewport
) ret RenderActiveDecision {
  var active: Bool = forceRender
  if active is false {
    if cacheDirty(world: world, uiSystems: uiSystems, cache: renderCache) {
      active = true
    }
  }
  if active is false {
    if eventCount(this: input.uiActions) > 0 {
      active = true
    }
  }
  if active is false {
    if input.ui.pressedEntityId is not prevPressed {
      active = true
    }
  }
  if active is false {
    if animating {
      active = true
    }
  }
  if active is false {
    if uiPointerButtonDown(button: mouseButtonLeft) {
      active = true
    }
  }
  if active is false {
    if input.ui.pointer.pressed or input.ui.pointer.released {
      active = true
    }
  }

  # Hover-change detection. Always run hitTest — components with a
  # visual effect on hover (HoverScale, etc.) need a re-render when
  # the cursor enters or leaves their rect. The check below only
  # marks dirty on entity TRANSITIONS, so an idle cursor parked over
  # the same rect stays at 0 fps.
  # Hover only for a pointer that hovers: never a finger (it stays where it
  # lifted), and only where the device has one (Device.canHover); the lib's
  # input already hit-tested this frame's pointer
  var currentHovered: EntityId = noEntity()
  if showsHover(kind: input.ui.pointer.kind, canHover: input.ui.deviceWatch.facts.canHover) {
    currentHovered = input.ui.hoveredEntityId
  }
  if active is false {
    if currentHovered is not prevHovered {
      active = true
    }
  }

  let d: RenderActiveDecision = { active: active, currentHovered: currentHovered }
  ret d
}
