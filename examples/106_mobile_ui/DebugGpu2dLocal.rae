let debugActionToggleMenu: String = "debug.toggleMenu"

let debugActionToggleTheme: String = "debug.toggleTheme"

let debugActionToggleLabels: String = "debug.toggleLabels"

let debugActionToggleInputOutlines: String = "debug.toggleInputOutlines"

let debugActionDismiss: String = "debug.dismiss"

const debugRowH: Float = 121.44578313253011

const debugLabelH: Float = 52.04819277108433

const debugSwitchW: Float = 121.44578313253011

const debugSwitchH: Float = 69.39759036144578

const debugSwitchRadius: Float = 34.69879518072289

const debugSwitchKnob: Float = 56.3855421686747

const debugSwitchKnobOffset: Float = 26.024096385542165

const debugPanelRadius: Float = 69.39759036144578

const debugPanelPadding: Float = 43.373493975903614

const debugPanelInset: Float = 86.74698795180723

const debugCloseIconSize: Float = 69.39759036144578

const debugCloseButtonW: Float = 312.289156626506

const debugCloseButtonH: Float = 86.74698795180723

const debugCloseButtonRadius: Float = 43.373493975903614

const debugRowGap: Float = 26.024096385542165

const debugContentTop: Float = 138.81927710843374

const debugButtonTextH: Float = 26.024096385542165

