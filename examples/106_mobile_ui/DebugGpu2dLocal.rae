func amberColor() ret RgbaColor {
  ret RgbaColor { r: 255, g: 191, b: 0, a: 255 }
}

func backdropColor() ret RgbaColor {
  ret RgbaColor { r: 0, g: 0, b: 0, a: 160 }
}

func menuFillColor() ret RgbaColor {
  ret RgbaColor { r: 24, g: 24, b: 28, a: 240 }
}

func switchOnColor() ret RgbaColor {
  ret RgbaColor { r: 52, g: 199, b: 89, a: 255 }
}

func switchOffColor() ret RgbaColor {
  ret RgbaColor { r: 120, g: 120, b: 128, a: 200 }
}

func switchKnobColor() ret RgbaColor {
  ret RgbaColor { r: 255, g: 255, b: 255, a: 255 }
}

type DebugSystem {
  menuOpen: Bool
  showLabels: Bool
  showInputOutlines: Bool
  buttonX: Float
  buttonY: Float
  buttonSize: Float
  screenW: Float
  screenH: Float
  # Absolute epoch stamps — Float64: in f32 two frames' timestamps are
  # identical (~128s granularity), so the window span is 0 and fps reads 0.
  fpsTimes: List(Float64)
  fpsWindowSec: Float
  lastFps: Float
  lastRssKb: Int
  heartbeatX: Float
  hasBlur: Bool
}

func blurBackdropKey() pub ret String {
  ret "debug.blurBackdrop"
}

func setDebugHasBlur(debug: mod DebugSystem, value: view Bool) pub {
  debug.hasBlur = value
}

func setDebugButtonTopRight(debug: mod DebugSystem, margin: view Float) pub {
  debug.buttonX = debug.screenW - debug.buttonSize - margin
  debug.buttonY = margin
}

func createDebugSystem() pub ret DebugSystem {
  ret DebugSystem {
    menuOpen: false
    showLabels: false
    showInputOutlines: false
    buttonX: 34.69879518072289
    buttonY: 34.69879518072289
    buttonSize: 47.71084337349397
    screenW: 1080.0
    screenH: 2280.0
    fpsTimes: List.create(Float64, cap: 256)
    fpsWindowSec: 3.0
    lastFps: 0.0
    lastRssKb: 0
    heartbeatX: 0.0
    hasBlur: false
  }
}

# Persist the debug dialog's flag toggles (labels / input outlines) so they
# survive a relaunch. Written whenever a flag is toggled; read at boot by
# restoreDebugFlags. `menuOpen` is intentionally NOT persisted — the dialog
# always starts closed. Same concat-built JSON + brace-escape trick as
# saveAppState (a bare `{` in a string literal would start interpolation).
func saveDebugFlags(debug: view DebugSystem, path: view String) pub {
  unsafe {
    let q: String = "\""
    let openBrace: String = "\{"
    let closeBrace: String = "\}"
    let nl: String = "\n"
    var content: String = ""
    content = content.concat(other: openBrace).concat(other: nl)
    content = content.concat(other: "  ").concat(other: q).concat(other: "showLabels").concat(
      other: q
    ).concat(other: ": ").concat(other: boolStr(b: debug.showLabels)).concat(other: ",").concat(
      other: nl
    )
    content = content.concat(other: "  ").concat(other: q).concat(other: "showInputOutlines").concat(
      other: q
    ).concat(other: ": ").concat(other: boolStr(b: debug.showInputOutlines)).concat(other: nl)
    content = content.concat(other: closeBrace).concat(other: nl)
    let ok: Bool = rae_ext_rae_sys_write_file(path: path, content: content)
    if ok is false {
      log("[debug] flag save failed: {path}")
    }
  }
}

# Restore persisted debug flags at boot. Best-effort: a missing file or a
# missing field leaves the in-memory default (false).
func restoreDebugFlags(debug: mod DebugSystem, path: view String) pub {
  unsafe {
    let source: String = rae_ext_rae_sys_read_file(path: path)
    if source.length() is 0 {
      ret
    }
    let doc: JsonDoc = Json.parseJson(source: source)
    if doc.ok is false {
      ret
    }
    let root: JsonValue = Json.root(doc: doc)
    let labelsKey: String = "showLabels"
    let labelsIdx: Int = Json.field(doc: doc, this: root, key: labelsKey)
    if labelsIdx >= 0 {
      debug.showLabels = Json.jsonBool(
        this: Json.jsonValueAt(doc: doc, idx: labelsIdx)
        fallback: false
      )
    }
    let outlinesKey: String = "showInputOutlines"
    let outlinesIdx: Int = Json.field(doc: doc, this: root, key: outlinesKey)
    if outlinesIdx >= 0 {
      debug.showInputOutlines = Json.jsonBool(
        this: Json.jsonValueAt(doc: doc, idx: outlinesIdx)
        fallback: false
      )
    }
    log("[debug] restored flags labels={debug.showLabels} outlines={debug.showInputOutlines}")
  }
}

func setDebugScreenSize(debug: mod DebugSystem, w: view Float, h: view Float) pub {
  debug.screenW = w
  debug.screenH = h
  # Re-anchor the button to the top-right of the (possibly resized) extent.
  # buttonY doubles as the margin (setDebugButtonTopRight keeps them equal),
  # so the button follows a window resize instead of sticking at its boot X.
  debug.buttonX = w - debug.buttonSize - debug.buttonY
}

func setDebugButtonPosition(debug: mod DebugSystem, x: view Float, y: view Float) pub {
  debug.buttonX = x
  debug.buttonY = y
}

func pruneFpsBuffer(debug: mod DebugSystem) {
  let capN: Int = 16
  let times: mod List(Float64) => debug.fpsTimes
  loop times.length > capN {
    times.remove(index: 0)
  }
}

func recordDebugFrame(debug: mod DebugSystem, now: view Float64, didRealWork: view Bool) pub {
  if didRealWork {
    let times: mod List(Float64) => debug.fpsTimes
    times.add(value: now)
    pruneFpsBuffer(debug: debug)
  }
  let n: Int = debug.fpsTimes.length
  var fps: Float = 0.0
  if n >= 2 {
    if let oldest: Float64 = debug.fpsTimes.copyAt(index: 0) {
      if let newest: Float64 = debug.fpsTimes.copyAt(index: n - 1) {
        let span: Float = (newest - oldest) as Float
        if span > 0.0 {
          fps = (n - 1).toFloat() / span
        }
      }
    }
  }
  debug.lastFps = fps
  debug.lastRssKb = processRssKb()
}

func currentDebugFPS(debug: view DebugSystem) pub ret Float {
  ret debug.lastFps
}

func addDebugLayer(world: mod UiWorld, debug: mod DebugSystem) pub {
  let hasAnchor: Bool = applyDebugAnchor(world: world, debug: debug)
  let button: EntityId = buildDebugButton(world: world, debug: debug)
  setLayerById(world: world, entity: button, id: "debug")
  if debug.menuOpen {
    let menu: EntityId = buildDebugMenuOverlay(world: world, debug: debug)
    setLayerById(world: world, entity: menu, id: "debug")
  }
}

func dispatchDebugAction(
  state: mod AppState
  input: view InputSystem
  debug: mod DebugSystem
) pub ret Bool {
  unsafe {
    var needsRemount: Bool = false
    let n: Int = eventCount(this: input.uiActions)
    var i: Int = 0
    loop i < n {
      let ev: UiAction = eventAt(this: input.uiActions, i: i)
      let actionId: String = ev.actionId
      if actionId is debugActionToggleMenu {
        debug.menuOpen = debug.menuOpen is false
        needsRemount = true
      }
      if actionId is debugActionDismiss {
        if debug.menuOpen {
          debug.menuOpen = false
          needsRemount = true
        }
      }
      if actionId is debugActionToggleTheme {
        # #764: the theme lives on AppState (106 rebuilds its world per frame); the
        # remount below reseeds the new world from it.
        let cur: Theme = state.theme.active
        if cur.mode is ThemeMode.dark {
          state.theme.active = lightTheme()
        } else {
          state.theme.active = darkTheme()
        }
        state.theme.generation = state.theme.generation + 1
        needsRemount = true
      }
      if actionId is debugActionToggleLabels {
        debug.showLabels = debug.showLabels is false
        saveDebugFlags(debug: debug, path: debugFlagsFilePath)
      }
      if actionId is debugActionToggleInputOutlines {
        debug.showInputOutlines = debug.showInputOutlines is false
        saveDebugFlags(debug: debug, path: debugFlagsFilePath)
      }
      i = i + 1
    }
    ret needsRemount
  }
}

func selectedForDebugAction(
  world: view UiWorld
  actionId: view String
  debug: view DebugSystem
) ret Bool {
  if actionId is debugActionToggleTheme {
    ret world.theme.active.mode is ThemeMode.dark
  }
  if actionId is debugActionToggleLabels {
    ret debug.showLabels
  }
  if actionId is debugActionToggleInputOutlines {
    ret debug.showInputOutlines
  }
  ret false
}

func syncDebugWidgetStates(world: mod UiWorld, debug: view DebugSystem) pub {
  let n: Int = componentCount(this: world.actionBindings)
  var i: Int = 0
  loop i < n {
    let entity: EntityId = componentEntityAt(this: world.actionBindings, i: i)
    if componentHas(this: world.widgetIds, entity: entity) {
      let wid: view WidgetId => componentView(this: world.widgetIds, entity: entity)
      let debugKind: String = "debugToggle"
      let pillKind: String = "debugSwitchPill"
      let knobKind: String = "debugSwitchKnob"
      var isDebugToggle: Bool = wid.kind is debugKind
      if isDebugToggle is false {
        if wid.kind is pillKind {
          isDebugToggle = true
        }
      }
      if isDebugToggle is false {
        if wid.kind is knobKind {
          isDebugToggle = true
        }
      }
      if isDebugToggle {
        let bind: view ActionBinding => componentView(this: world.actionBindings, entity: entity)
        let selected: Bool = selectedForDebugAction(
          world: world
          actionId: bind.actionId
          debug: debug
        )
        setWidgetSelected(world: world, entity: entity, selected: selected)
      }
    }
    i = i + 1
  }
}

func formatMemMBGpu2d(kb: view Int) ret String {
  let tenths: Int = (kb * 10) / 1024
  let whole: Int = tenths / 10
  let frac: Int = tenths - whole * 10
  ret "{whole}.{frac} MB"
}

func formatFpsGpu2d(fps: view Float) ret String {
  var rounded: Int = (fps + 0.5).toInt()
  if rounded < 0 {
    rounded = 0
  }
  ret "fps: {rounded}"
}

func drawDebugHeartbeatGpu2d(
  debug: mod DebugSystem
  canvas: mod Gpu2dCanvas
  didRealWork: view Bool
) {
  if didRealWork {
    debug.heartbeatX = debug.heartbeatX + 2.1686746987951806
    if debug.heartbeatX > debug.screenW {
      debug.heartbeatX = -8.674698795180722
    }
  }
  Gpu2d.drawBox(
    canvas: canvas
    x: debug.heartbeatX
    y: 0.0
    w: 8.674698795180722
    h: 8.674698795180722
    radius: 0.0
    fill: 0xFFFFBF00
    borderWidth: 0.0
    border: 0x00000000
  )
}

func drawDebugLabelsGpu2d(debug: view DebugSystem, canvas: mod Gpu2dCanvas, font: view SdfFont) {
  let fpsText: String = formatFpsGpu2d(fps: debug.lastFps)
  let memText: String = "mem: {formatMemMBGpu2d(kb: debug.lastRssKb)}"
  let fontSize: Float = 30.361445783132528
  let lineH: Float = 34.69879518072289
  let gap: Float = 8.674698795180722
  let bottomEdge: Float = debug.buttonY + debug.buttonSize
  let fpsY: Float = bottomEdge + gap + fontSize
  let memY: Float = fpsY + lineH + 4.337349397590361
  let buttonCx: Float = debug.buttonX + debug.buttonSize * 0.5
  let screenCx: Float = debug.screenW * 0.5
  let rightAligned: Bool = buttonCx > screenCx
  var fpsX: Float = debug.buttonX
  var memX: Float = debug.buttonX
  if rightAligned {
    let rightEdge: Float = debug.buttonX + debug.buttonSize
    fpsX = rightEdge - fpsText.length().toFloat() * fontSize * 0.52
    memX = rightEdge - memText.length().toFloat() * fontSize * 0.52
  }
  let amber: Int = 0xFFFFBF00
  Gpu2dText.drawText(
    canvas: canvas
    font: font
    text: fpsText
    x: fpsX
    y: fpsY
    sizePx: fontSize
    color: amber
  )
  Gpu2dText.drawText(
    canvas: canvas
    font: font
    text: memText
    x: memX
    y: memY
    sizePx: fontSize
    color: amber
  )
  if debug.showInputOutlines {
    var lb: Int = 0
    if Gpu2d.pointerDown() {
      lb = 1
    }
    let buttonText: String = "button: {lb}"
    let buttonY: Float = memY + lineH + 4.337349397590361
    var buttonX: Float = debug.buttonX
    if rightAligned {
      let rightEdge: Float = debug.buttonX + debug.buttonSize
      buttonX = rightEdge - buttonText.length().toFloat() * fontSize * 0.52
    }
    Gpu2dText.drawText(
      canvas: canvas
      font: font
      text: buttonText
      x: buttonX
      y: buttonY
      sizePx: fontSize
      color: amber
    )
  }
}

func updateAndRenderDebugOverlayGpu2d(
  debug: mod DebugSystem
  canvas: mod Gpu2dCanvas
  now: view Float64
  didRealWork: view Bool
  font: view SdfFont
) pub {
  recordDebugFrame(debug: debug, now: now, didRealWork: didRealWork)
  if debug.showLabels {
    drawDebugLabelsGpu2d(debug: debug, canvas: canvas, font: font)
    drawDebugHeartbeatGpu2d(debug: debug, canvas: canvas, didRealWork: didRealWork)
  }
}
