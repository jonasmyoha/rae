open ui/Ecs
open ui/EventLoop
open ui/WindowGeometry
open ui/scrollRootSystem/ScrollRootSystem
open ecs/ComponentTable
open ui/UiSystems
open ui/animationSystem/AnimationTracks
open ui/textFieldSystem/TextFieldSystem
open FileWatch
open HotReload
import Gpu2d

# Frame phase 0 — the wait policy. Decides how long to block for OS events
# (busy-render while interacting / animating / loading, one frame while
# playback ticks, until the next event or deadline when nothing moves, and
# never a frame-length wait while the window is hidden), writes the scroll bounds + animation flags
# the later phases read
# into the tick, waits, and turns the close / auto-exit conditions into
# `session.running = false`. The world is only read, for the scroll bounds.
func frameWaitSystem(
  app: mod App
  session: mod AppSession
  world: view UiWorld
  uiSystems: view UiSystems
  frame: view WorldFrame
  tick: mod FrameTick
) {
  let playbackSystem: view PlaybackSystem = app.musicSystems.playbackSystem
  # Per-frame scroll bounds: the active page's ScrollRoot and its laid-out
  # floor (lib/ui/scrollRootSystem). Wrong floor → spring never settles; a
  # root not yet laid out, or whose content fits, is inert.
  let range: ScrollRange = scrollRootRange(
    world: world
    uiSystems: app.uiSystems
    entityId: frame.scrollTarget
  )
  tick.scrollOnThisScreen = range.active
  tick.scrollFloor = range.floor
  # In-flight scroll — a drag, momentum, a spring, or a wheel still settling —
  # counts as an animation so the event loop wakes at frame cadence instead
  # of blocking until the next OS event: the physics steps once per frame.
  tick.scrollAnimating = scrollRootSettling(
    world: world
    uiSystems: app.uiSystems
    entityId: frame.scrollTarget
  )
  # Suppress the playbackSystem-driven 60Hz animation gate while the user is
  # scrolling (the per-frame playbackSystem tick competed with scroll).
  let recentlyScrolling: Bool = tick.scrollAnimating
  tick.playbackAnimating = false
  if playbackSystem.isPlaying {
    if recentlyScrolling is false {
      tick.playbackAnimating = true
    }
  }
  # Interaction/transition motion → busy-render: poll (timeout 0), paint
  # every frame as fast as the machine allows (no FPS cap). Playback alone
  # stays on the throttled 60Hz path so a playing song doesn't peg a core.
  # Idle → blocking event-wait (~0% CPU).
  tick.busyAnimating = animationInFlight(world: world, uiSystems: uiSystems) or tick.scrollAnimating or session.lastHoverAnimDirty or session.assetsLoading or uiPointerButtonDown(
    button: mouseButtonLeft
  )
  # Busy-render is `animating` with a zero-length frame, so the shared policy
  # (lib/ui/EventLoop.rae) decides it too: a hidden window never spins, it
  # sleeps until it is shown again. The watchers wake the loop themselves
  # (OS file notifications) and are polled only where the OS has none; a
  # window move that is still settling asks to be woken when it is due.
  var frameSeconds: Float = session.targetFrameSeconds
  if tick.busyAnimating {
    frameSeconds = 0.0
  }
  tick.timeout = nextWaitTimeoutSeconds(
    visible: Gpu2d.renderableNow()
    animating: tick.busyAnimating or tick.playbackAnimating or uiNowSeconds() < session.renderUntil
    mouseDown: false
    pollWatcher: fileWatcherNeedsPolling(watcher: session.watcher) or reloadSignalNeedsPolling(
      w: session.reloadWatcher
    )
    frameSeconds: frameSeconds
    heartbeatSeconds: earliestDeadlineSeconds(
      first: windowGeometryDeadlineSeconds(windowGeometry: app.windowGeometry, now: uiNowSeconds())
      second: textFieldDeadlineSeconds(textFieldSystem: uiSystems.textField, now: uiNowSeconds())
    )
  )
  # Heartbeat: prints once per frame BEFORE the wait. If this line stops
  # appearing in the log, the loop has stalled inside the frame body (not in
  # waitEventsTimeout). If it keeps printing but UI doesn't update, the input
  # or render phase is being skipped — check the post-wait line.
  if app.loopDebugEnabled {
    app.loopDebugFrame = app.loopDebugFrame + 1
    let mouseDown: Bool = uiPointerButtonDown(button: mouseButtonLeft)
    log(
      "[loop {app.loopDebugFrame}] screen={screenToInt(s: session.currentScreen)} scrollY={scrollPositionOf(
        world: world
        entityId: frame.scrollTarget
      )} animA={animationInFlight(world: world, uiSystems: uiSystems)} animP={playbackSystem.isPlaying} animS={tick.scrollAnimating} mouse={mouseDown} timeout={tick.timeout}"
    )
  }
  # When RAE_AUTO_EXIT_SEC is set, clamp the wait so the deadline actually
  # fires on time — otherwise an idle iteration could sleep for the idle cap
  # (30 s) past the requested exit time.
  if app.autoExitSeconds > 0.0 {
    let elapsed: Float = (uiNowSeconds() - app.bootTime) as Float
    let remaining: Float = app.autoExitSeconds - elapsed
    if remaining < tick.timeout {
      tick.timeout = remaining
    }
    if tick.timeout < 0.001 {
      tick.timeout = 0.001
    }
  }
  updateWindowGeometry(
    windowGeometry: app.windowGeometry
    now: uiNowSeconds()
    resized: uiIsWindowResized()
  )
  let preWait: Float64 = uiNowSeconds()
  uiWaitEvents(timeoutSeconds: tick.timeout)
  let waitDt: Float = (uiNowSeconds() - preWait) as Float
  if app.waitTraceEnabled {
    if waitDt > 0.005 {
      log("[wait] dt={waitDt} timeout={tick.timeout}")
    }
  }
  # Post-wait trace. If dt ≈ timeout the wait ran to its full cap (no OS
  # event woke us) — diagnostic for "stuck on idle".
  if app.loopDebugEnabled {
    log("[loop {app.loopDebugFrame}] wait dt={waitDt}")
  }
  if uiWindowShouldClose() {
    session.running = false
  } else if app.autoExitSeconds > 0.0 and uiNowSeconds() - app.bootTime > app.autoExitSeconds {
    # RAE_AUTO_EXIT_SEC fired — clean self-shutdown so test harnesses don't
    # leave orphaned binaries owning the GPU context. Falls through to the
    # teardown at the end of runApp.
    log("[auto-exit] reached {app.autoExitSeconds}s wall-clock; shutting down")
    session.running = false
  }
}
