open ui/Ecs
import Gpu2dTextInput
# SearchSystems (#976) — the two systems behind the scene-driven Search page.
#
#   searchFieldSystem   every `SearchField`: while its page is active, append
#                       this frame's typed characters to `query` and apply
#                       Backspace; show `query` (or the placeholder while it
#                       is empty) in the field's first Text child; show the
#                       page's EmptyState node while the query is empty and
#                       the page's `SearchResults` container otherwise.
#   searchResultsSystem every `SearchResults`: when the query of the
#                       SearchField on the same page differs from the rows
#                       last built (`builtQuery`), destroy the rows and mount
#                       one track-row sub-scene per match (title / artist /
#                       album substring, case-insensitive, capped at
#                       `maxRows`), each tappable via `song.openref`.
#
# Neither system builds page layout: the field, the empty state and the
# results container are authored in Search.raescene; the rows are the data
# list's items (the same TrackRow sub-scene the Album page mounts).
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems

# ----- SearchField ----------------------------------------------------------

# True when the page holding `entityId` is active (visible). A page root with no
# Active component counts as active, like layout does.
func entityPageActive(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  let page: String = pageOf(world: world, uiSystems: uiSystems, entityId: entityId)
  if page.length() is 0 {
    ret true
  }
  let root: EntityId = findPageRootEntity(world: world, pageId: page)
  if isNone(this: root) {
    ret true
  }
  if componentHas(this: world.actives, entityId: root) is false {
    ret true
  }
  let a: Active = componentGet(this: world.actives, entityId: root)
  ret a.value
}

# Drop the last character (a whole UTF-8 sequence) of `text`.
func withoutLastChar(text: view String) ret String {
  let n: Int = text.length()
  if n is 0 {
    ret ""
  }
  var cut: Int = n - 1
  # Step back over UTF-8 continuation bytes (0x80..0xBF) to the character's
  # lead byte, so a Backspace removes the whole multi-byte character.
  loop cut > 0 and text.byteAt(index: cut) >= 128 and text.byteAt(index: cut) < 192 {
    cut = cut - 1
  }
  ret text.sub(start: 0, len: cut)
}

# The field's visible line: its first child carrying a Text.
func searchFieldTextChild(world: view UiWorld, field: view EntityId) ret EntityId {
  unsafe {
    if componentHas(this: world.childrens, entityId: field) is false {
      ret noEntity()
    }
    let kids: view Children => componentView(this: world.childrens, entityId: field)
    var k: Int = 0
    loop k < kids.ids.length {
      let child: EntityId = rae_ext_rae_buf_get(buf: kids.ids.data, index: k)
      if componentHas(this: world.texts, entityId: child) {
        ret child
      }
      k = k + 1
    }
    ret noEntity()
  }
}

func setActiveIfDifferent(world: mod UiWorld, entityId: view EntityId, active: view Bool) {
  if isNone(this: entityId) {
    ret
  }
  var current: Bool = true
  if componentHas(this: world.actives, entityId: entityId) {
    let a: Active = componentGet(this: world.actives, entityId: entityId)
    current = a.value
  }
  if current is not active {
    let flag: Active = { value: active }
    componentSet(this: world.actives, entityId: entityId, data: flag)
  }
}

func setTextIfDifferent(
  world: mod UiWorld
  entityId: view EntityId
  text: view String
  styleId: view String
) {
  if isNone(this: entityId) or componentHas(this: world.texts, entityId: entityId) is false {
    ret
  }
  let current: Text = componentGet(this: world.texts, entityId: entityId)
  if current.text is text and current.styleId is styleId {
    ret
  }
  let updated: Text = { text: "{text}", styleId: "{styleId}", wrapWidthMode: current.wrapWidthMode }
  componentSet(this: world.texts, entityId: entityId, data: updated)
}

# The search-results list host (`ListSource { searchTracks | searchAlbums }`)
# on the same page as `field`, if any.
func searchResultsOnPage(
  world: view UiWorld
  uiSystems: view UiSystems
  page: view String
) ret EntityId {
  let n: Int = componentCount(this: world.listSources)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: world.listSources, i: i)
    let binding: ListSource = componentDataAt(this: world.listSources, i: i)
    let isSearch: Bool = binding.source is ListSourceKind.searchTracks or binding.source is ListSourceKind.searchAlbums
    if isSearch and pageOf(world: world, uiSystems: uiSystems, entityId: entityId) is page {
      ret entityId
    }
    i = i + 1
  }
  ret noEntity()
}

func searchFieldSystem(world: mod UiWorld, uiSystems: view UiSystems, input: view InputSystem) pub {
  let n: Int = componentCount(this: world.searchFields)
  # OS text input is on exactly while a search field's page is on screen;
  # everywhere else the window takes raw keys (no accent popover on macOS).
  var fieldOnScreen: Bool = false
  var f: Int = 0
  loop f < n {
    if entityPageActive(
      world: world
      uiSystems: uiSystems
      entityId: componentEntityAt(this: world.searchFields, i: f)
    ) {
      fieldOnScreen = true
    }
    f = f + 1
  }
  Gpu2dTextInput.setTextInput(active: fieldOnScreen)
  var i: Int = 0
  loop i < n {
    let field: EntityId = componentEntityAt(this: world.searchFields, i: i)
    let data: SearchField = componentDataAt(this: world.searchFields, i: i)
    var query: String = "{data.query}"
    # Typing goes to the field whose page is on screen.
    if entityPageActive(world: world, uiSystems: uiSystems, entityId: field) {
      var b: Int = 0
      loop b < input.backspaces {
        query = withoutLastChar(text: query)
        b = b + 1
      }
      if input.typedText.length() > 0 {
        query = "{query}{input.typedText}"
      }
    }
    if query is not data.query {
      let updated: SearchField = {
        query: "{query}"
        placeholder: "{data.placeholder}"
        textStyleId: "{data.textStyleId}"
        placeholderStyleId: "{data.placeholderStyleId}"
      }
      componentSet(this: world.searchFields, entityId: field, data: updated)
    }
    # Mirror into the visible line.
    let line: EntityId = searchFieldTextChild(world: world, field: field)
    if query.length() > 0 {
      setTextIfDifferent(
        world: world
        entityId: line
        text: query
        styleId: data.textStyleId
      )
    } else {
      setTextIfDifferent(
        world: world
        entityId: line
        text: data.placeholder
        styleId: data.placeholderStyleId
      )
    }
    # Results vs empty state. The results container follows the query here;
    # the page's `EmptyState { kind: search }` node is toggled by
    # `emptyStateSystem` (no page + node-id lookup).
    let page: String = pageOf(world: world, uiSystems: uiSystems, entityId: field)
    let hasQuery: Bool = query.length() > 0
    setActiveIfDifferent(
      world: world
      entityId: searchResultsOnPage(world: world, uiSystems: uiSystems, page: page)
      active: hasQuery
    )
    i = i + 1
  }
}

# The live query of the `SearchField` on `page` ("" when the page has none) —
# what the page's search-results ListSource keys its rows on.
func searchQueryOnPage(
  world: view UiWorld
  uiSystems: view UiSystems
  page: view String
) ret String {
  let n: Int = componentCount(this: world.searchFields)
  var i: Int = 0
  loop i < n {
    let field: EntityId = componentEntityAt(this: world.searchFields, i: i)
    if pageOf(world: world, uiSystems: uiSystems, entityId: field) is page {
      let data: SearchField = componentDataAt(this: world.searchFields, i: i)
      ret "{data.query}"
    }
    i = i + 1
  }
  ret ""
}
