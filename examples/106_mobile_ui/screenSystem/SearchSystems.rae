open ui/Ecs
# SearchSystems (#976) — the Search page around its lib text field.
#
#   searchFieldSystem   runs lib/ui's textFieldSystem (a tap on the field
#                       gives it focus, typing edits it, the caret blinks),
#                       then shows the page's search results container while
#                       the field has text (the EmptyState node is toggled
#                       by emptyStateSystem).
#   searchQueryOnPage   the text of the field on a page, which the page's
#                       search-results ListSource keys its rows on.
#
# Neither builds page layout: the field, the empty state and the results
# container are authored in Search.raescene; the rows are the data list's
# items (the same TrackRow sub-scene the Album page mounts).
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ui/UiSystems
open ui/textFieldSystem/TextFieldSystem
import Sdl3
open Keys

# True when the page holding `entityId` is active (visible). A page root with no
# Active component counts as active, like layout does.
func entityPageActive(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
) ret Bool {
  let page: String = pageOf(world: world, uiSystems: uiSystems, entityId: entityId)
  if page.length() is 0 {
    ret true
  }
  let root: EntityId = findPageRootEntity(world: world, pageId: page)
  if isNone(this: root) {
    ret true
  }
  if componentHas(this: world.actives, entityId: root) is false {
    ret true
  }
  let a: view Active = componentView(this: world.actives, entityId: root)
  ret a.value
}

func setActiveIfDifferent(world: mod UiWorld, entityId: view EntityId, active: view Bool) {
  if isNone(this: entityId) {
    ret
  }
  var current: Bool = true
  if componentHas(this: world.actives, entityId: entityId) {
    let a: view Active = componentView(this: world.actives, entityId: entityId)
    current = a.value
  }
  if current is not active {
    let flag: Active = { value: active }
    componentSet(this: world.actives, entityId: entityId, data: flag)
  }
}

# The search-results list host (`ListSource { searchTracks | searchAlbums }`)
# on the same page as `field`, if any.
func searchResultsOnPage(
  world: view UiWorld
  uiSystems: view UiSystems
  page: view String
) ret EntityId {
  let n: Int = componentCount(this: world.listSources)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: world.listSources, i: i)
    let binding: view ListSource = queryViewAt(table: world.listSources, denseIndex: i)
    let isSearch: Bool = binding.source is ListSourceKind.searchTracks or binding.source is ListSourceKind.searchAlbums
    if isSearch and pageOf(world: world, uiSystems: uiSystems, entityId: entityId) is page {
      ret entityId
    }
    i = i + 1
  }
  ret noEntity()
}

func searchFieldSystem(
  world: mod UiWorld
  uiSystems: mod UiSystems
  input: mod InputSystem
  now: view Float64
) ret Bool {
  var textInput: TextInputFrame = {
    typed: "{input.typedText}"
    backspaces: input.backspaces
    enter: Sdl3.isKeyPressed(key: keyEnter)
    tapped: input.ui.pointer.released
  }
  # Typing with no field focused (a scripted RAE_UI_TYPE run) goes to the
  # field on the page on screen, as a tap on it would
  if textInput.typed.length() > 0 and isNone(this: focusedTextFieldEntityId(world: world)) {
    let count: Int = componentCount(this: world.textFields)
    loop var i: Int = 0, i < count, ++i {
      let field: EntityId = componentEntityAt(this: world.textFields, i: i)
      if entityPageActive(world: world, uiSystems: uiSystems, entityId: field) {
        let moved: Bool = focusTextField(world: world, entityId: field)
        break
      }
    }
  }
  let changed: Bool = textFieldSystem(
    world: world
    textFieldSystem: uiSystems.textField
    actions: input.uiActions
    input: textInput
    now: now
  )
  # Results vs empty state: the results container follows the text; the
  # page's `EmptyState { kind: search }` node is toggled by emptyStateSystem.
  let count: Int = componentCount(this: world.textFields)
  loop var i: Int = 0, i < count, ++i {
    let field: EntityId = componentEntityAt(this: world.textFields, i: i)
    let page: String = pageOf(world: world, uiSystems: uiSystems, entityId: field)
    let hasQuery: Bool = componentView(this: world.textFields, entityId: field).text.length() > 0
    setActiveIfDifferent(
      world: world
      entityId: searchResultsOnPage(world: world, uiSystems: uiSystems, page: page)
      active: hasQuery
    )
  }
  ret changed
}

# The text of the `TextField` on `page` ("" when the page has none) — what
# the page's search-results ListSource keys its rows on.
func searchQueryOnPage(
  world: view UiWorld
  uiSystems: view UiSystems
  page: view String
) ret String {
  let n: Int = componentCount(this: world.textFields)
  var i: Int = 0
  loop i < n {
    let field: EntityId = componentEntityAt(this: world.textFields, i: i)
    if pageOf(world: world, uiSystems: uiSystems, entityId: field) is page {
      let data: view TextField = queryViewAt(table: world.textFields, denseIndex: i)
      ret "{data.text}"
    }
    i = i + 1
  }
  ret ""
}
