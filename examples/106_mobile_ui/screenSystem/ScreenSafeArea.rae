# ScreenSafeArea — the safe-area and top-bar layout of the screen router
# (#918 split of ScreenRouter for the 1000-line cap): applySafeAreas and the
# dock lift, the safe-area edge attachment, the page top bar and the
# history-view refresh. ScreenRouter keeps the Screen enum, the world
# builders, the app state and dispatchActions.
open sys/Spotify
open ui/Ecs
import Files
import Sys
import ui/DevicePresets
import ui/widgetStyleSystem/WidgetStyleSystem
open ecs/Entity
open ui/renderSystem/RenderSystem
open ui/Layer
open ecs/ComponentTable
open ui/safeAreaSystem/SafeAreaSystem

# Write the active Viewport's safe insets (in design units) onto every
# SafeArea-tagged entity; return the insets so the
# caller can also honour the bottom edge on offset-anchored widgets.
# Idempotent — safe to call every frame; safeAreaSystem skips entities
# whose insets are unchanged, so it never dirties the layout at idle.
# Reads world.layoutW/H, so it must run after applyViewportExtent.
func applySafeAreas(world: mod UiWorld, viewport: view Viewport) pub ret Insets {
  safeAreaSystem(world: world, insets: viewport.safeInsetsDu)
  ret viewport.safeInsetsDu
}

# The bottom dock is bottom-anchored via an Offset and lays its children
# out top-packed, so a bottom padding would only add invisible slack.
# Lift the whole dock by the home-indicator inset instead, so the
# mini-player + nav tabs clear it.
func liftDockForSafeArea(world: mod UiWorld, dock: view EntityId, bottomInset: view Float) pub {
  if bottomInset <= 0.0 {
    ret
  }
  if componentHas(this: world.offsets, entity: dock) is false {
    ret
  }
  let cur: Offset = componentGet(this: world.offsets, entity: dock)
  let lifted: Offset = { delta: Vec2 { x: cur.delta.x, y: cur.delta.y - bottomInset } }
  componentSet(this: world.offsets, entity: dock, data: lifted)
}

# Configure a full-screen page root: a `SafeArea` (per-edge `apply`
# multipliers gate which device insets fold into padding — 1.0 honour,
# 0.0 ignore; L/R stay 0 since presets have no horizontal insets) plus an
# `ExtentAnchor.center` so the phone-width page stays a centered column on
# a wide desktop window rather than left-aligning. The bottom toolbar uses
# ExtentAnchor.fill instead (edge-to-edge); overlays keep the default left.
func attachSafeAreaEdges(
  world: mod UiWorld
  entity: view EntityId
  top: view Float
  bottom: view Float
) pub {
  let sa: SafeArea = {
    enabled: true
    apply: Insets { l: 0.0, t: top, r: 0.0, b: bottom }
    extra: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  }
  componentSet(this: world.safeAreas, entity: entity, data: sa)
  let anchor: ExtentAnchor = { h: HExtent.center }
  componentSet(this: world.extentAnchors, entity: entity, data: anchor)
}

# Shared page-top-bar builder. Every top-level screen (Home, Library,
# Search, Profile, History) wants the same look: a full-width bar with
# a single centered title in the `pageTitle` style — bigger and bolder
# than the old per-view `topBarTitle`, and centered by the renderer.
#
# Callers pass the visible label; the helper allocates the bar +
# title entities, sets the layout, and returns the bar entity ready
# to drop into a page's vertical column of children.
func buildPageTopBar(world: mod UiWorld, title: view String) pub ret EntityId {
  let bar: EntityId = createEntity(world: world)
  let w: Float = phoneFrameW - outerPad * 2.0
  setRectFixed(
    world: world
    entity: bar
    w: w
    h: topBarH
  )
  let layH: LayoutType = LayoutType.horizontal
  let alignC: AlignKind = AlignKind.center
  setLayout(
    world: world
    entity: bar
    kind: layH
    gap: 0.0
    alignCross: alignC
  )

  let titleE: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: titleE
    w: w
    h: topBarH
  )
  let style: String = "pageTitle"
  let text: String = "{title}"
  setText(
    world: world
    entity: titleE
    text: own text
    styleId: own style
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 1)
  kids.add(value: titleE)
  attachChildren(world: world, parent: bar, kids: kids)
  ret bar
}

# Re-mount Home / History in place when `playHistory` has grown
# since the last frame and one of them is the currently-visible
# screen. Catches the case where pollSpotify (or a `song.open.N`
# tap from another screen) appends an entry — the user shouldn't
# have to tab-switch to see it. Cheap: the entries.length compare
# short-circuits when nothing changed.
func refreshHistoryViewsIfNeeded(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  visible: view Screen
  cachedRevision: view Int
  viewport: view Viewport
) pub ret Int {
  # Observe PlayHistory's §7 revision (bumped on every append) rather than
  # diffing the List length (#944): both fire on append, but the revision also
  # catches an append that evicts at cap (length unchanged) and never re-keys
  # off a stale length.
  let n: Int = state.playHistory.revision
  if n is cachedRevision {
    ret cachedRevision
  }
  if visible is Screen.home {
    unmountPage(world: world, pageId: homePageId)
    let h: EntityId = mountHomePage(
      world: world
      scenes: scenes
      state: state
      scrollY: 0.0
      viewport: viewport
    )
    setPageActive(world: world, pageId: homePageId, active: true)
  }
  if visible is Screen.history {
    unmountPage(world: world, pageId: historyPageId)
    let h: EntityId = mountHistoryPage(
      world: world
      state: state
      scrollY: 0.0
      viewport: viewport
    )
    setPageActive(world: world, pageId: historyPageId, active: true)
  }
  ret n
}

func tagPlaybackIconDependency(
  world: mod UiWorld
  pageId: view String
  nodeId: view String
  widgetId: view String
  observedRevision: view Int
  playing: view Bool
) pub {
  var raw: Int = -1
  if let value: Int = findNodeInPage(world: world, pageId: pageId, nodeId: nodeId) {
    raw = value
  } else {
    ret
  }
  let entity: EntityId = nodeEntity(world: world, index: raw)
  let playbackSource: DataResourceId = dataResourcePlayback()
  let playbackField: DataFieldId = dataFieldIsPlaying()
  let iconKind: String = "playbackIcon"
  setWidgetIdentity(
    world: world
    entity: entity
    id: widgetId
    kind: iconKind
  )
  # Seed `selected` from the ACTUAL play state (#): the widgetStyleSystem
  # applies the play_arrow<->pause swap from `selected`, and the per-frame
  # refresh only fires when the playback revision CHANGES. Mounting with
  # observedRevision == playback.revision means no refresh, so a page
  # mounted while already playing must start selected=true or it would
  # show the play glyph until the next play/pause toggle.
  setWidgetState(
    world: world
    entity: entity
    enabled: true
    selected: playing
    loading: false
    error: false
  )
  setDataDependency(
    world: world
    entity: entity
    resource: playbackSource
    field: playbackField
    observedRevision: observedRevision
  )
  # Declarative visuals: selected (= playing) shows the pause glyph.
  # `widgetStyleSystem` applies the swap; the refresh below only flips
  # WidgetState.selected. Struct built inline with `own` moves — the
  # helper-returns-struct + field-reassign shape corrupts String
  # fields (same class as the List(T) inner-String ownership gap).
  let baseKey: String = "mat:play_arrow"
  let selKey: String = "mat:pause"
  let noTextStyle: String = ""
  let noTextStyleSel: String = ""
  let noTint: RgbaColor = { r: 255, g: 255, b: 255, a: 255 }
  let clearFill: RgbaColor = { r: 0, g: 0, b: 0, a: 0 }
  let zeroOffset: Vec2 = { x: 0.0, y: 0.0 }
  let style: StateStyle = {
    spriteKey: own baseKey
    spriteKeySelected: own selKey
    tint: noTint
    tintSelected: noTint
    hasTint: false
    shapeFill: clearFill
    shapeFillSelected: clearFill
    hasShapeFill: false
    offset: zeroOffset
    offsetSelected: zeroOffset
    hasOffset: false
    textStyle: own noTextStyle
    textStyleSelected: own noTextStyleSel
    disabledAlpha: 1.0
    loadingAlpha: 1.0
    errorAlpha: 1.0
  }
  componentSet(this: world.stateStyles, entity: entity, data: own style)
}

# Playback-widget refresh (`refreshPlaybackViewsIfNeeded` +
# `refreshPlaybackIconEntity`) now lives in `ui_playback_system.rae` as the
# observe step of `UiPlaybackSystem` (#267, §5.2).

# Material icon key for the play button in the current state. Used by
# both view builders to pick the right sprite override at mount time
# (so the first frame already shows the right icon). Playback revision
# invalidation refreshes dependent icon bindings when this value changes.
func playbackIconKey(playback: view PlaybackState) pub ret String {
  if playback.isPlaying {
    ret "mat:pause"
  }
  ret "mat:play_arrow"
}
