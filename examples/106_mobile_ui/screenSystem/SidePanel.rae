# What the window's size class adds to the layout (Viewport.rae decides the
# widths): past compact the page grids gain columns, and an expanded window
# shows the Library in a side panel left of the page column, like a desktop
# music player. The dock stays a full-width bar under both.
open ui/Ecs
open ui/Components
open ui/Scene
open ui/SceneInstance
open ui/SizeClass
open ui/UiSystems
open ecs/Entity
open ecs/ComponentTable

let sidePanelPageId: String = "sidePanel"

# The grid node both browsing pages author
let coverGridNodeId: String = "CoverGrid"

# Set the column count of a page's grid node
func setGridColumns(
  world: mod UiWorld
  pageId: view String
  nodeId: view String
  columns: view Int
) {
  if let index: Int = findNodeInPage(world: world, pageId: pageId, nodeId: nodeId) {
    let entityId: EntityId = nodeEntityId(world: world, index: index)
    if componentHas(this: world.layouts, entityId: entityId) {
      let layout: mod Layout => componentMod(this: world.layouts, entityId: entityId)
      layout.columns = columns
    }
  }
}

# Past compact the page column is wider, so its grids show half as many
# columns again (Home 2 -> 3, Library 3 -> 4)
func widenGrids(world: mod UiWorld, viewport: view Viewport) {
  if viewport.sizeClass is SizeClass.compact {
    ret
  }
  setGridColumns(
    world: world
    pageId: homePageId
    nodeId: coverGridNodeId
    columns: 3
  )
  setGridColumns(
    world: world
    pageId: libraryPageId
    nodeId: coverGridNodeId
    columns: 4
  )
}

# The Library scene as a panel in the left gutter of an expanded window, one
# cover per row; nothing when the viewport has no side panel
func mountSidePanel(
  world: mod UiWorld
  uiSystems: mod UiSystems
  scenes: view AlbumScenes
  viewport: view Viewport
) ret EntityId {
  if viewport.sidePanelDuW <= 0.0 {
    ret noEntity()
  }
  let sceneIndex: Int = sceneRegistryIndex(reg: scenes.pages, key: libraryPageId)
  if sceneIndex < 0 {
    ret noEntity()
  }
  let scene: view Scene => sceneRegistryGet(reg: scenes.pages, idx: sceneIndex)
  let pageIdCopy: String = "{sidePanelPageId}"
  let root: EntityId = mountPageOrError(
    world: world
    uiSystems: uiSystems
    pageId: own pageIdCopy
    scene: scene
    overrides: emptyOverrides()
    w: viewport.sidePanelDuW
    h: viewport.areaDuH
    sceneLabel: "Side panel"
    subScenes: scenes.subScenes
  )
  if isNone(this: root) {
    ret root
  }
  # The page scene centres itself; the panel sits at the left edge
  let anchor: ExtentAnchor = { h: HExtent.left }
  componentSet(this: world.extentAnchors, entityId: root, data: anchor)
  setGridColumns(
    world: world
    pageId: sidePanelPageId
    nodeId: coverGridNodeId
    columns: 1
  )
  ret root
}
