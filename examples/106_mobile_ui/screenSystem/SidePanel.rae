# What an expanded window adds to the layout (Viewport.rae decides the
# widths): the Library in a side panel left of the page column, like a desktop
# music player. (Past compact the page grids gain columns through the `Wide`
# frame of Home.raescene and Library.raescene.) The dock stays a full-width bar under both.
#
# The panel's look is data: assets/scenes/SidePanel.raescene, a left-anchored
# root holding the Library scene as an instance whose CoverGrid shows one
# cover a row. Whether it exists is the viewport's (lib/ui/ResponsiveExtent's
# side panel width); ScreenResize.rae mounts and unmounts it on a resize.
open ui/Ecs
open ui/Scene
open ui/SceneInstance
open ui/UiSystems
open ecs/Entity

const sidePanelPageId: String = "sidePanel"

# Mount SidePanel.raescene in the left gutter of an expanded window; nothing
# when the viewport has no side panel
func mountSidePanel(
  world: mod UiWorld
  uiSystems: mod UiSystems
  scenes: view AlbumScenes
  viewport: view Viewport
) ret EntityId {
  if viewport.sidePanelDuW <= 0.0 {
    ret noEntity()
  }
  let pageIdCopy: String = "{sidePanelPageId}"
  ret mountPageOrError(
    world: world
    uiSystems: uiSystems
    pageId: own pageIdCopy
    scene: scenes.sidePanel
    overrides: emptyOverrides()
    w: viewport.sidePanelDuW
    h: viewport.areaDuH
    sceneLabel: "Side panel"
    subScenes: scenes.subScenes
  )
}
