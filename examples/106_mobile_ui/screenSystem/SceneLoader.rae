open ui/Ecs
open ui/SceneInstance
open ui/Scene

# Load the four `.raescene` files this app needs and bundle them into a
# single struct so we avoid storing `Scene` values in a `List` — the C
# backend treats `List(Scene)` element gets as a struct-copy through
# `rae_ext_rae_buf_get`, which corrupts the nested JsonDoc list pointers
# on subsequent accesses. Named fields side-step the whole issue.
func loadSceneFile(path: view String) pub ret Scene {
  unsafe {
    let content: String = rae_ext_rae_sys_read_file(path: path)
    ret parseScene(source: content)
  }
}

type AlbumScenes {
  # #964: the item sub-scenes the ListView system mounts per pooled row
  # (`ListView.itemSceneId`), keyed by sceneId — today the History row.
  rowScenes: SceneRegistry
  trackRow: Scene
  navTabs: Scene
  navTab: Scene
  miniPlayer: Scene
  nowPlaying: Scene
  album: Scene
  canvas: Scene
  home: Scene
  profile: Scene
}

func loadRowScenes() ret SceneRegistry {
  var rowScenes: SceneRegistry = createSceneRegistry()
  let historyRowId: String = "history-row"
  registerScene(reg: rowScenes, key: historyRowId, scene: loadSceneFile(path: historyRowPath))
  ret rowScenes
}

func loadAllScenes() pub ret AlbumScenes {
  ret AlbumScenes {
    rowScenes: loadRowScenes()
    trackRow: loadSceneFile(path: trackRowPath)
    navTabs: loadSceneFile(path: navTabsPath)
    navTab: loadSceneFile(path: navTabPath)
    miniPlayer: loadSceneFile(path: miniPlayerPath)
    nowPlaying: loadSceneFile(path: nowPlayingPath)
    album: loadSceneFile(path: albumPath)
    canvas: loadSceneFile(path: canvasPath)
    home: loadSceneFile(path: homePath)
    profile: loadSceneFile(path: profilePath)
  }
}
