open ui/Ecs
open ui/SceneInstance
open ui/Scene
open ui/SceneFile

# Load the four `.raescene` files this app needs and bundle them into a
# single struct so we avoid storing `Scene` values in a `List` — the C
# backend treats `List(Scene)` element gets as a struct-copy through
# `rae_ext_rae_buf_get`, which corrupts the nested JsonDoc list pointers
# on subsequent accesses. Named fields side-step the whole issue.
func loadSceneFile(path: view String) pub ret Scene {
  unsafe {
    let content: String = rae_ext_rae_sys_read_file(path: path)
    let scene: Scene = parseScene(source: content)
    scene.sceneId = sceneIdentityFromFilePath(path: path)
    ret scene
  }
}

type AlbumScenes {
  # The SUB-scene registry, keyed by sceneId: what a `SceneInstance` node in
  # any page scene instances (`TopBar`, `NavTab`; resolved by
  # mountPageOrError, #978) and what the ListView system mounts per pooled
  # row (`HistoryRow`, #964).
  subScenes: SceneRegistry
  # The PAGE scenes, keyed by page id: the one `mountScreenPage` looks a
  # `ScreenPage` row's scene up in (screenSystem/ScreenPageMount).
  pages: SceneRegistry
  trackRow: Scene
  miniPlayer: Scene
  dock: Scene
  backButton: Scene
  canvas: Scene
  bottomSheet: Scene
}

func loadSubScenes() ret SceneRegistry {
  var subScenes: SceneRegistry = createSceneRegistry()
  registerScene(reg: subScenes, key: "HistoryRow", scene: loadSceneFile(path: historyRowPath))
  registerScene(reg: subScenes, key: "NavTab", scene: loadSceneFile(path: navTabPath))
  registerScene(reg: subScenes, key: "TopBar", scene: loadSceneFile(path: topBarPath))
  registerScene(reg: subScenes, key: "CoverTile", scene: loadSceneFile(path: coverTilePath))
  registerScene(reg: subScenes, key: "PlaylistTile", scene: loadSceneFile(path: playlistTilePath))
  registerScene(reg: subScenes, key: "RecentThumb", scene: loadSceneFile(path: recentThumbPath))
  registerScene(reg: subScenes, key: "TrackRow", scene: loadSceneFile(path: trackRowPath))
  registerScene(
    reg: subScenes
    key: "SheetActionRow"
    scene: loadSceneFile(path: sheetActionRowPath)
  )
  registerScene(reg: subScenes, key: "MiniPlayer", scene: loadSceneFile(path: miniPlayerPath))
  ret subScenes
}

func loadPageScenes() ret SceneRegistry {
  var pages: SceneRegistry = createSceneRegistry()
  registerScene(reg: pages, key: "{homePageId}", scene: loadSceneFile(path: homePath))
  registerScene(reg: pages, key: "{libraryPageId}", scene: loadSceneFile(path: libraryPath))
  registerScene(reg: pages, key: "{albumPageId}", scene: loadSceneFile(path: albumPath))
  registerScene(reg: pages, key: "{playerPageId}", scene: loadSceneFile(path: nowPlayingPath))
  registerScene(reg: pages, key: "{searchPageId}", scene: loadSceneFile(path: searchPath))
  registerScene(reg: pages, key: "{profilePageId}", scene: loadSceneFile(path: profilePath))
  registerScene(reg: pages, key: "{historyPageId}", scene: loadSceneFile(path: historyPath))
  ret pages
}

func loadAllScenes() pub ret AlbumScenes {
  ret AlbumScenes {
    subScenes: loadSubScenes()
    pages: loadPageScenes()
    trackRow: loadSceneFile(path: trackRowPath)
    miniPlayer: loadSceneFile(path: miniPlayerPath)
    dock: loadSceneFile(path: dockPath)
    backButton: loadSceneFile(path: backButtonPath)
    canvas: loadSceneFile(path: canvasPath)
    bottomSheet: loadSceneFile(path: bottomSheetPath)
  }
}
