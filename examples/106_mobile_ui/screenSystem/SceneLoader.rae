open ui/Ecs
open ui/SceneInstance
open ui/Scene

# Load the four `.raescene` files this app needs and bundle them into a
# single struct so we avoid storing `Scene` values in a `List` — the C
# backend treats `List(Scene)` element gets as a struct-copy through
# `rae_ext_rae_buf_get`, which corrupts the nested JsonDoc list pointers
# on subsequent accesses. Named fields side-step the whole issue.
func loadSceneFile(path: view String) pub ret Scene {
  unsafe {
    let content: String = rae_ext_rae_sys_read_file(path: path)
    ret parseScene(source: content)
  }
}

type AlbumScenes {
  # The SUB-scene registry, keyed by sceneId: what a `SceneInstance` node in
  # any page scene instances (`top-bar`, `nav-tab`; resolved by
  # mountPageOrError, #978) and what the ListView system mounts per pooled
  # row (`history-row`, #964). The page scenes below are named fields (see
  # the List(Scene) note above).
  subScenes: SceneRegistry
  trackRow: Scene
  miniPlayer: Scene
  dock: Scene
  backButton: Scene
  nowPlaying: Scene
  album: Scene
  canvas: Scene
  home: Scene
  profile: Scene
  library: Scene
  search: Scene
  history: Scene
}

func loadSubScenes() ret SceneRegistry {
  var subScenes: SceneRegistry = createSceneRegistry()
  registerScene(reg: subScenes, key: "history-row", scene: loadSceneFile(path: historyRowPath))
  registerScene(reg: subScenes, key: "nav-tab", scene: loadSceneFile(path: navTabPath))
  registerScene(reg: subScenes, key: "top-bar", scene: loadSceneFile(path: topBarPath))
  registerScene(reg: subScenes, key: "cover-tile", scene: loadSceneFile(path: coverTilePath))
  registerScene(reg: subScenes, key: "playlist-tile", scene: loadSceneFile(path: playlistTilePath))
  registerScene(reg: subScenes, key: "recent-thumb", scene: loadSceneFile(path: recentThumbPath))
  ret subScenes
}

func loadAllScenes() pub ret AlbumScenes {
  ret AlbumScenes {
    subScenes: loadSubScenes()
    trackRow: loadSceneFile(path: trackRowPath)
    miniPlayer: loadSceneFile(path: miniPlayerPath)
    dock: loadSceneFile(path: dockPath)
    backButton: loadSceneFile(path: backButtonPath)
    nowPlaying: loadSceneFile(path: nowPlayingPath)
    album: loadSceneFile(path: albumPath)
    canvas: loadSceneFile(path: canvasPath)
    home: loadSceneFile(path: homePath)
    profile: loadSceneFile(path: profilePath)
    library: loadSceneFile(path: libraryPath)
    search: loadSceneFile(path: searchPath)
    history: loadSceneFile(path: historyPath)
  }
}
