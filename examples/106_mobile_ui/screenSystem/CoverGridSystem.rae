open ui/Ecs
# CoverGridSystem (#975) — drives every authored `CoverGrid` component.
#
# A cover grid is a DATA LIST: its tiles come from app state (the library
# filter, the Liked playlist, the rounded-covers setting), so a scene can only
# author the container — and since #991 the container authors ALL of the
# geometry: `Layout { type: Grid, columns, columnGap, rowGap }` wraps the tiles
# into rows in lib/ui's layout system, so this system appends the tiles
# straight under the container and creates no entity of its own. It
# (re)materialises the tiles whenever `state.libraryRevision` moves past the
# revision the container was last built for (`CoverGrid.builtRevision`, -1 on
# a fresh mount); the tiles are `cover-tile` / `playlist-tile` sub-scene
# instances (#979, host-less since #990).
#
# Runs every frame from UiRefresh.refreshMountedUi (a no-op unless the
# revision moved) and once at the end of each page mount, so the tiles exist
# before the screen-switch hero capture reads them.
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open ui/layoutSystem/LayoutSystem

# Tile edge for the container's authored grid: `columns` cells plus their
# `columnGap`s across the phone content width. Read from the node's Layout —
# the scene is the one owner of the grid's geometry.
func coverGridTileSize(world: view UiWorld, container: view EntityId) ret Float {
  let layout: Layout = entityLayout(world: world, entity: container)
  var cols: Int = layout.columns
  if cols < 1 {
    cols = 1
  }
  let avail: Float = phoneFrameW - outerPad * 2.0
  let gapTotal: Float = layout.columnGap * (cols - 1).toFloat()
  ret (avail - gapTotal) / cols.toFloat()
}

# Destroy the tiles currently under `grid` (each destroy unlinks itself from
# the container's Children, #972), leaving the container itself untouched.
func clearCoverGridTiles(world: mod UiWorld, grid: view EntityId) {
  unsafe {
    if componentHas(this: world.childrens, entity: grid) is false {
      ret
    }
    let old: List(EntityId) = List.create(EntityId, cap: 8)
    let kids: view Children => componentView(this: world.childrens, entity: grid)
    var k: Int = 0
    loop k < kids.ids.length {
      old.add(value: rae_ext_rae_buf_get(buf: kids.ids.data, index: k))
      k = k + 1
    }
    loop let tile: view EntityId in old {
      destroyEntitySubtree(world: world, root: tile)
    }
  }
}

# Mount one sub-scene (`sceneId` from the registry) as its own root entity,
# `tileH` square (#990: host-less — the scene's root IS the tile; the side
# travels as a `Rect` override on it). A missing scene is a red error block.
func mountTileScene(
  world: mod UiWorld
  scenes: view AlbumScenes
  sceneId: view String
  tileH: view Float
  overrides: mod List(SceneOverride)
) ret EntityId {
  ret mountRegistrySubSceneOrError(
    world: world
    reg: scenes.subScenes
    sceneId: sceneId
    overrides: overrides
    w: tileH
    h: tileH
  )
}

# One album-cover tile: the `cover-tile` sub-scene with its Sprite pointed at
# the album's cover, and the per-item data the scene cannot carry — the hero
# key and the widget id, both the album stem — written as component data.
# The rounded-covers setting drops the authored CornerRadius when off.
func mountCoverTile(
  world: mod UiWorld
  scenes: view AlbumScenes
  key: view String
  tileH: view Float
  rounded: view Bool
) ret EntityId {
  let overrides: List(SceneOverride) = emptyOverrides()
  addSpriteOverride(list: overrides, nodeId: "Tile", value: "{key}")
  let tile: EntityId = mountTileScene(
    world: world
    scenes: scenes
    sceneId: "cover-tile"
    tileH: tileH
    overrides: overrides
  )
  setHeroWidget(world: world, entity: tile, key: "{key}")
  setWidgetIdentity(
    world: world
    entity: tile
    id: key
    kind: "albumTile"
  )
  if rounded is false {
    componentRemove(this: world.cornerRadiuses, entity: tile)
  }
  ret tile
}

# The Liked playlist's 2x2 tile: the `playlist-tile` sub-scene with up to four
# cover Sprites switched on (an empty cell keeps its authored placeholder).
func mountPlaylistTile(
  world: mod UiWorld
  scenes: view AlbumScenes
  coverStems: view List(String)
  tileH: view Float
  rounded: view Bool
) ret EntityId {
  let overrides: List(SceneOverride) = emptyOverrides()
  var c: Int = 0
  loop c < 4 {
    if let stem: String = coverStems.copyAt(index: c) {
      addSpriteOverride(list: overrides, nodeId: "Cell{c}Art", value: "{stem}")
      addActiveOverride(list: overrides, nodeId: "Cell{c}Art", value: true)
      addActiveOverride(list: overrides, nodeId: "Cell{c}Placeholder", value: false)
    }
    c = c + 1
  }
  let tile: EntityId = mountTileScene(
    world: world
    scenes: scenes
    sceneId: "playlist-tile"
    tileH: tileH
    overrides: overrides
  )
  if coverStems.length is 0 {
    setWidgetState(
      world: world
      entity: tile
      enabled: true
      selected: false
      loading: true
      error: false
    )
  }
  if rounded is false {
    unsafe {
      # Square corners: strip the CornerRadius from every descendant cell.
      let gathered: List(EntityId) = List.create(EntityId, cap: 12)
      collectSubtree(childrens: world.childrens, node: tile, out: gathered)
      loop let e: view EntityId in gathered {
        componentRemove(this: world.cornerRadiuses, entity: e)
      }
    }
  }
  ret tile
}

# Build the tiles for one grid from app state, in display order.
func buildCoverGridTiles(
  world: mod UiWorld
  grid: view CoverGrid
  state: view AppState
  scenes: view AlbumScenes
  tileH: view Float
) ret List(EntityId) {
  let rounded: Bool = state.settings.roundedAlbumCovers
  let keys: List(String) = collectLibraryCoverKeys(
    albums: state.mediaLibrary.albums
    library: state.library
  )
  let tiles: List(EntityId) = List.create(EntityId, cap: keys.length + 1)
  if grid.source is CoverGridSource.library {
    # The Liked playlist leads the library grid as a 2x2 cover tile.
    let coverStems: List(String) = playlistCoverStems(playlist: state.liked, max: 4)
    tiles.add(value: mountPlaylistTile(
      world: world
      scenes: scenes
      coverStems: coverStems
      tileH: tileH
      rounded: rounded
    ))
  }
  loop let key: view String in keys {
    tiles.add(value: mountCoverTile(
      world: world
      scenes: scenes
      key: key
      tileH: tileH
      rounded: rounded
    ))
  }
  ret tiles
}

# Materialise (or re-materialise) the tiles of one grid container: the
# container's own `Layout: Grid` places them, so they are attached directly.
func rebuildCoverGrid(
  world: mod UiWorld
  container: view EntityId
  grid: view CoverGrid
  state: view AppState
  scenes: view AlbumScenes
) {
  clearCoverGridTiles(world: world, grid: container)
  let tileH: Float = coverGridTileSize(world: world, container: container)
  let tiles: List(EntityId) = buildCoverGridTiles(
    world: world
    grid: grid
    state: state
    scenes: scenes
    tileH: tileH
  )
  attachChildren(world: world, parent: container, kids: tiles)
  log("[cover-grid] rebuilt {tiles.length} tiles (revision {state.libraryRevision})")
}

# Drive every `CoverGrid`: rebuild the ones whose rows predate the current
# library revision; `scenes` supplies the tile sub-scenes (#979).
func coverGridSystem(world: mod UiWorld, state: view AppState, scenes: view AlbumScenes) pub {
  let n: Int = componentCount(this: world.coverGrids)
  var i: Int = 0
  loop i < n {
    let container: EntityId = componentEntityAt(this: world.coverGrids, i: i)
    let grid: CoverGrid = componentDataAt(this: world.coverGrids, i: i)
    if grid.builtRevision is not state.libraryRevision {
      rebuildCoverGrid(
        world: world
        container: container
        grid: grid
        state: state
        scenes: scenes
      )
      let built: CoverGrid = { source: grid.source, builtRevision: state.libraryRevision }
      componentSet(this: world.coverGrids, entity: container, data: built)
    }
    i = i + 1
  }
}
