open ui/Ecs
# Home tab — SCENE-DRIVEN. assets/scenes/Home.raescene owns the page: the
# "Recently played" header + strip and the cover grid, both data lists
# (`ListView` + `ListSource`, #996) the app's listSourceSystem feeds. The
# page is mounted by the one `mountScreenPage` from its ScreenPage row; the
# scroll is the Body's authored `ScrollRoot` (lib/ui/scrollRootSystem).
# Tapping any tile fires `album.open` (same path as the Library tiles); the
# header's `nav.history` action is authored in the scene.
#
# What a scene cannot express is one binding component: `HasHistory` on the
# "Recently played" header and strip — shown only while the play history has
# entries (layout skips inactive children, so an empty history collapses the
# section). `hasHistorySystem` below writes `Active` from the history.
import ui/Components
open ecs/Entity
open ecs/ComponentTable

# Every `HasHistory`: Active follows "the play history has entries", keyed on
# the history revision so an idle frame writes nothing.
# HomeSystem (docs/ecs-systems-own-their-tables.md §3): owns the home page's `HasHistory` sections
# — its
# authored components are ITS tables, no longer lib/ui's.
type HomeSystem {
  hasHistories: ComponentTable(HasHistory)
}

func createHomeSystem() ret HomeSystem {
  ret HomeSystem { hasHistories: ComponentTable.create(HasHistory) }
}

func hasHistorySystem(homeSystem: mod HomeSystem, world: mod UiWorld, state: view AppState) pub {
  let revision: Int = state.playHistory.revision
  let hasEntries: Bool = state.playHistory.entries.length > 0
  let n: Int = componentCount(this: homeSystem.hasHistories)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: homeSystem.hasHistories, i: i)
    let binding: HasHistory = componentDataAt(this: homeSystem.hasHistories, i: i)
    if binding.builtRevision is not revision {
      let active: Active = { value: hasEntries }
      componentSet(this: world.actives, entityId: entityId, data: active)
      let built: HasHistory = { builtRevision: revision }
      componentSet(this: homeSystem.hasHistories, entityId: entityId, data: built)
    }
    i = i + 1
  }
}
