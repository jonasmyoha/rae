open ui/Ecs
# Now-playing screen: mounts `music-player-now-playing.raescene`. The
# time labels are overridden at mount from the active track; every other
# data-bound node carries a binding component driven per frame (#981).
import ui/Components
import ui/Scene
open ecs/Entity
open ui/Frames
open ui/SceneInstance
open ecs/ComponentTable
open ui/renderSystem/RenderSystem

# "1:04 / 2:52" — current playback position + active track duration,
# both formatted M:SS. Lets the time-labels overrides be built in one
# place (both this screen and the mini-player call it).
func nowPlayingTimes(playback: view PlaybackState, track: view Track) ret List(String) {
  let elapsedMs: Int = (playback.elapsedSec * 1000.0).toInt()
  let nowStr: String = formatDurationMs(ms: elapsedMs)
  let totalStr: String = formatDurationMs(ms: track.durationMs)
  let pair: List(String) = List.create(String, cap: 2)
  pair.add(value: nowStr)
  pair.add(value: totalStr)
  ret pair
}

func mountNowPlayingPage(
  world: mod UiWorld
  scenes: view AlbumScenes
  playback: view PlaybackState
  state: view AppState
  reg: view TextureRegistry
  viewport: view Viewport
) pub ret EntityId {
  let album: Album = activeAlbum(state: state)
  let track: Track = trackAt(album: album, idx: state.currentTrackIndex)

  # The page is assets/scenes/music-player-now-playing.raescene (#979): the
  # shared top bar as a sub-scene instance and the player block. The play
  # icon, cover, heart and title/artist are authored `PlaybackIcon` /
  # `PlaybackCover` / `LikedHeart` / `TrackText` bindings driven by their
  # systems (#981); only the two time labels travel as mount overrides.
  let npOverrides: List(SceneOverride) = emptyOverrides()
  let times: List(String) = nowPlayingTimes(playback: playback, track: track)
  if let nowStr: String = times.copyAt(index: 0) {
    addTextOverride(list: npOverrides, nodeId: "TimeNow", value: nowStr)
  }
  if let totalStr: String = times.copyAt(index: 1) {
    addTextOverride(list: npOverrides, nodeId: "TimeTotal", value: totalStr)
  }
  let pageIdCopy: String = "{playerPageId}"
  let mount: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scenes.nowPlaying
    overrides: npOverrides
    w: viewport.areaDuW
    h: viewport.areaDuH
    sceneLabel: "music-player-now-playing"
    subScenes: scenes.subScenes
  )
  attachSafeAreaEdges(
    world: world
    entity: mount
    top: 1.0
    bottom: 0.0
  )

  # First run of the bindings so the very first frame is right.
  playbackBindingsSystems(
    world: world
    playback: playback
    state: state
    reg: reg
  )

  # The hero's authored 24px-class corner radius follows the same
  # AppSettings flag as every other cover: strip it when covers are square.
  if state.settings.roundedAlbumCovers is false {
    if let raw: Int = findNodeInPage(world: world, pageId: playerPageId, nodeId: "Hero") {
      componentRemove(this: world.cornerRadiuses, entity: nodeEntity(world: world, index: raw))
    }
  }
  ret mount
}
