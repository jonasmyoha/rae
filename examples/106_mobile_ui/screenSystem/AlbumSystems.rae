open ui/Ecs
# AlbumSystems (#979) — the system behind the scene-driven album page header.
#
#   albumHeaderSystem  the caption / title / artist Texts carry a
#                      `TextBinding { key: "album.caption" | "album.title" |
#                      "album.artist" }` and the hero cover an `AlbumHeader`
#                      marker; this writes them from the browsed
#                      `CollectionView`. Gated by the observation schedule on
#                      the collection / library sources.
#
# It builds no layout: the header nodes are authored in Album.raescene; the
# track rows are the page's `ListView` + `ListSource` (listSystem/ListSources).
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable

open ecs/Query

# What the header and the rows depend on, as one comparable string.
# AlbumSystem (docs/ecs-systems-own-their-tables.md §3): owns the album page's `AlbumHeader` texts
# — its
# authored components are ITS tables, no longer lib/ui's.
type AlbumSystem {
  albumHeaders: ComponentTable(AlbumHeader)
}

func createAlbumSystem() ret AlbumSystem {
  ret AlbumSystem { albumHeaders: ComponentTable.create(AlbumHeader) }
}

func albumCollectionKey(state: view AppState) ret String {
  ret "{state.currentAlbumStem}|{state.viewingPlaylist}|{state.currentPlaylistId}|{state.libraryRevision}"
}

# Write a `Text.text` in place, keeping its style — the same compare-before-
# write discipline the old node-poke used, now keyed off the node's
# `TextBinding`, not a page + node-id lookup.
func writeAlbumText(world: mod UiWorld, entityId: view EntityId, text: view String) {
  if componentHas(this: world.texts, entityId: entityId) is false {
    ret
  }
  if componentView(this: world.texts, entityId: entityId).text is text {
    ret
  }
  let current: mod Text => componentMod(this: world.texts, entityId: entityId)
  current.text = "{text}"
}

# The album page's header, entirely from data (#979): the caption / title /
# artist Texts carry a `TextBinding { key: "album.caption" | "album.title" |
# "album.artist" }` and the hero cover an `AlbumHeader` marker. This writes
# them from the browsed `CollectionView`. Gated by the observation schedule on
# the collection / library sources, so it runs on a real change (or a mount),
# never per idle frame; compare-before-write keeps an unchanged value from
# bumping a table.
func albumHeaderSystem(
  albumSystem: view AlbumSystem
  world: mod UiWorld
  state: view AppState
) pub {
  let cv: CollectionView = buildCurrentCollection(state: state)
  let nb: Int = componentCount(this: world.textBindings)
  var i: Int = 0
  loop i < nb {
    let entityId: EntityId = componentEntityAt(this: world.textBindings, i: i)
    let binding: view TextBinding => queryViewAt(table: world.textBindings, denseIndex: i)
    if binding.key is "album.caption" {
      writeAlbumText(world: world, entityId: entityId, text: cv.caption)
    }
    if binding.key is "album.title" {
      writeAlbumText(world: world, entityId: entityId, text: cv.title)
    }
    if binding.key is "album.artist" {
      writeAlbumText(world: world, entityId: entityId, text: cv.artist)
    }
    i = i + 1
  }
  if cv.coverStem.length() is 0 {
    ret
  }
  let nc: Int = componentCount(this: albumSystem.albumHeaders)
  var c: Int = 0
  loop c < nc {
    let cover: EntityId = componentEntityAt(this: albumSystem.albumHeaders, i: c)
    if componentHas(this: world.sprites, entityId: cover) {
      setSpriteKey(world: world, entityId: cover, key: cv.coverStem)
    }
    setHeroWidget(world: world, entityId: cover, key: "{cv.coverStem}")
    c = c + 1
  }
}
