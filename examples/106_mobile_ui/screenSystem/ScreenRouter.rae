open ui/Ecs
open ui/SceneBundles
# The screens the app can show (the `Screen` enum and the `ScreenPage` table)
# and the world builders. The app state is screenSystem/AppState.rae; what a
# tap DOES is the action table + command systems in actionSystem/.
import Files
import Sys
import ui/DevicePresets
import ui/widgetStyleSystem/WidgetStyleSystem
open ecs/Entity
open ui/renderSystem/RenderSystem
open ui/Layer
open ecs/ComponentTable
open ui/safeAreaSystem/SafeAreaSystem
open ui/UiSystems

enum Screen {
  home
  library
  album
  player
  search
  profile
  history
}

# The four bottom-nav tabs follow. Order matters: it must match
# `hot_reload_glue.screenToInt` / `intToScreen` so saved state.json
# ordinals keep restoring correctly after a code rebuild.
#
# `Home` is the discovery / landing tab — large 2-column grid of
# albums with a friendly greeting. Where the app boots.
# `Library` is the dense 3-column album grid — the user's full
# catalog of music to play. Formerly mis-shared with Profile.
# `Album` is the sub-page showing one album's track list. Reached
# by tapping any Home or Library cover tile. NOT a tab.
# `Player` is the sub-page showing the currently-playing track with
# full controls. Reached by tapping a track row OR by tapping the
# mini-player at the bottom of any screen. NOT a tab.
# `Search` — placeholder tab for now. Will host a query-against-
# catalogue UI later.
# `Profile` is the user / account / Spotify-status / settings tab.
# Genuinely the user-info screen — no longer pretending to be the
# library grid.
# `History` is the full play-history sub-page. Pushed from a tap
# on the "Recently played" header on Home. NOT a tab.

# One row per screen (#948): the page entity's id — which is also the key of
# its scene in `AlbumScenes.pages` and the name a `NavTab` selects — the
# human label (the mount-failure block, the `[state] saved` log) and whether
# the page is re-mounted afresh on entry. The router LOOKS UP rows in this
# table instead of branching on the `Screen` enum: there is no `if screen
# is …` ladder left in the app outside the saved-state ordinal map. Every
# page is mounted by the ONE `mountScreenPage` (ScreenPageMount.rae) from
# its row; each mounted page root carries a lib `PageRoot{id}` with the same
# `pageId`, so a row resolves to its entity with `findPageRootEntity` — the
# pages ARE entities; this is the data the router needs about them. Whether
# and how far a page scrolls is not a row property: the scene authors a
# `ScrollRoot` on the scrolling node and the lib scrollRootSystem computes the
# floor from the laid-out content; the safe-area reserve is the scene's
# authored `SafeArea` too.
#
# `refreshOnEntry` is false for every page today: the lists re-bind in place
# from their sources (#996) and the Home "Recently played" section follows
# the history through `HasHistory`, so a page entered again shows current
# data — and keeps its scroll position — without a re-mount. A page that
# ever needs a fresh mount on entry flips the flag, not the code.
type ScreenPage {
  screen: Screen
  pageId: String
  label: String
  refreshOnEntry: Bool
}

# The table, built by its cold callers (screen switch, world rebuild).
func createScreenPages() ret List(ScreenPage) {
  let rows: List(ScreenPage) = List.create(ScreenPage, cap: 7)
  rows.add(
    value: ScreenPage {
      screen: Screen.home
      pageId: "{homePageId}"
      label: "Home"
      refreshOnEntry: false
    }
  )
  rows.add(
    value: ScreenPage {
      screen: Screen.library
      pageId: "{libraryPageId}"
      label: "Library"
      refreshOnEntry: false
    }
  )
  rows.add(
    value: ScreenPage {
      screen: Screen.album
      pageId: "{albumPageId}"
      label: "Album"
      refreshOnEntry: false
    }
  )
  rows.add(
    value: ScreenPage {
      screen: Screen.player
      pageId: "{playerPageId}"
      label: "Player"
      refreshOnEntry: false
    }
  )
  rows.add(
    value: ScreenPage {
      screen: Screen.search
      pageId: "{searchPageId}"
      label: "Search"
      refreshOnEntry: false
    }
  )
  rows.add(
    value: ScreenPage {
      screen: Screen.profile
      pageId: "{profilePageId}"
      label: "Profile"
      refreshOnEntry: false
    }
  )
  rows.add(
    value: ScreenPage {
      screen: Screen.history
      pageId: "{historyPageId}"
      label: "History"
      refreshOnEntry: false
    }
  )
  ret rows
}

# The row for a screen (the player's when the screen has no row).
func screenPageFor(screen: view Screen) ret ScreenPage {
  let pages: List(ScreenPage) = createScreenPages()
  loop let page: view ScreenPage in pages {
    if page.screen is screen {
      ret ScreenPage {
        screen: page.screen
        pageId: "{page.pageId}"
        label: "{page.label}"
        refreshOnEntry: page.refreshOnEntry
      }
    }
  }
  ret ScreenPage {
    screen: Screen.player
    pageId: "{playerPageId}"
    label: "Player"
    refreshOnEntry: false
  }
}

# The human label of a screen (log lines).
func pageLabelForScreen(screen: view Screen) ret String {
  let page: ScreenPage = screenPageFor(screen: screen)
  ret "{page.label}"
}

func buildScreenWorld(
  uiSystems: mod UiSystems
  dockSystem: view DockSystem
  screen: Screen
  scenes: view AlbumScenes
  playbackSystem: view PlaybackSystem
  state: view AppState
  textureRegistry: view TextureRegistry
  viewport: view Viewport
) pub ret UiWorld {
  # A "world for one screen" is the persistent world with that screen visible
  # (#948): the seven per-screen builders and the ladder that chose between
  # them are gone. Kept for the memory-stress runner, which rebuilds worlds.
  ret buildAppWorldFor(
    uiSystems: uiSystems
    dockSystem: dockSystem
    visible: screen
    scenes: scenes
    playbackSystem: playbackSystem
    state: state
    textureRegistry: textureRegistry
    viewport: viewport
  )
}

# Maps a Screen to the PageRoot id its page is mounted under.
func pageIdForScreen(screen: Screen) pub ret String {
  let page: ScreenPage = screenPageFor(screen: screen)
  ret "{page.pageId}"
}

# Persistent-world entrypoint: one UiWorld with ALL four screen pages
# mounted, plus the shared dock + back-button overlays. Initially
# only the page matching `state.tab` / `visibleScreen` is `Active`
# — the others are mounted-but-hidden. Subsequent screen changes
# flip `Active` via `setPageActive` instead of tearing the world
# down. Data changes (album / track) still trigger a full rebuild
# until slice 4b.3 introduces per-page invalidation.
func buildAppWorld(
  uiSystems: mod UiSystems
  dockSystem: view DockSystem
  scenes: view AlbumScenes
  playbackSystem: view PlaybackSystem
  state: view AppState
  textureRegistry: view TextureRegistry
  viewport: view Viewport
) pub ret UiWorld {
  ret buildAppWorldFor(
    uiSystems: uiSystems
    dockSystem: dockSystem
    visible: visibleScreen(state: state)
    scenes: scenes
    playbackSystem: playbackSystem
    state: state
    textureRegistry: textureRegistry
    viewport: viewport
  )
}

# The persistent world: every screen's page is mounted, and exactly `visible`
# is Active. Which page is visible is a table walk over the ScreenPage rows.
func buildAppWorldFor(
  uiSystems: mod UiSystems
  dockSystem: view DockSystem
  visible: Screen
  scenes: view AlbumScenes
  playbackSystem: view PlaybackSystem
  state: view AppState
  textureRegistry: view TextureRegistry
  viewport: view Viewport
) ret UiWorld {
  let world: UiWorld = create()
  seedWorldThemeFrom(world: world, src: state.theme)  # #764: theme from AppState
  world.bundles = cloneBundleSet(set: state.bundles)  # the shared Bundles.raescene
  # Publish the active Viewport extent before mounting anything. Builders
  # that need edge-to-edge geometry read `world.layoutW/H`; fixed phone
  # content still uses the `phoneFrameW/phoneFrameH` design constants and is centered
  # later by the root ExtentAnchor.
  applyViewportExtent(world: world, viewport: viewport)
  # Layer stack first — overlay-mount sites below assume the named
  # layer entities ("content" / "dock" / "back-button" / "dialog" /
  # "debug") already exist and look them up by id.
  createStandardLayers(world: world)
  # Every page from the table, by the one mounter; only the `visible`
  # screen's page is Active=true. The page's data (lists, stats, the
  # album header, the playbackSystem texts) lands through its binding components
  # when the frame's observation step runs before the first paint.
  let pages: List(ScreenPage) = createScreenPages()
  loop let page: view ScreenPage in pages {
    let root: EntityId = mountScreenPage(
      world: world
      uiSystems: uiSystems
      page: page
      scenes: scenes
      viewport: viewport
    )
    let active: Active = { value: page.screen is visible }
    componentSet(this: world.actives, entity: root, data: active)
  }

  # Shared overlays — always Active.
  let dock: EntityId = mountBottomDockOverlay(
    dockSystem: dockSystem
    world: world
    uiSystems: uiSystems
    activeTab: state.tab
    scenes: scenes
    playbackSystem: playbackSystem
    state: state
    reg: textureRegistry
  )
  let back: EntityId = mountBackButtonOverlay(
    world: world
    uiSystems: uiSystems
    scenes: scenes
    state: state
  )
  mountBottomSheetOverlay(
    world: world
    uiSystems: uiSystems
    scenes: scenes
    sheet: state.bottomSheet
    state: state
    playbackSystem: playbackSystem
  )
  # Responsive safe-area pass. `RAE_UI_DEVICE=<preset>` selects a phone
  # form factor; its notch / home-indicator insets are resolved to
  # design units in the active Viewport and written onto every `SafeArea`-tagged node.
  # `entityPadding` folds them in during the layout pass that follows.
  # Unset / unknown preset → zero insets → layout unchanged.
  #
  # Page roots opt into the top inset inside their own mount functions
  # (so an in-place re-mount — e.g. refreshHistoryViewsIfNeeded — keeps
  # the tag). Seed SafeInsets so the first layout (before the per-frame
  # `applySafeAreas`) already reflows, and lift the dock by the bottom
  # inset. Runs on every rebuild, including the resize path (main.rae
  # sets switching=true on viewport extent changes), so the active
  # viewport's insets stay in sync with the selected simulator preset.
  let safe: Insets = applySafeAreas(world: world, uiSystems: uiSystems, viewport: viewport)
  # #978: the dock's bottom anchoring (and the safe-area lift) is the
  # AnchorBottom system's; run it once so the first layout is right.
  anchorBottomSystem(world: world, bottomInset: safe.b)
  ret world
}
