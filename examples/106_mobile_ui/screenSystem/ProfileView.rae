open ui/Ecs
# Profile tab — SCENE-DRIVEN (#974). The whole page (top bar, avatar block,
# identity texts, the three stat columns, the four settings rows) is authored
# in assets/scenes/profile.raescene and mounted with one `mountPageOrError`.
# This module keeps only what a template cannot express, as components a
# system drives (docs/ecs-general-architecture.md):
#   * `ProfileStat { stat }` on each stat value Text node — `profileStatsSystem`
#     writes the live count from the media library into `Text.text`.
#   * `AvatarSource { textureKey }` on the avatar Stack — `avatarSystem`
#     activates the photo child once its texture is loaded, else the authored
#     placeholder child. A photo that lands mid-session is a toggle on two
#     children, not the full world rebuild it used to trigger.
#   * the Body's runtime `ScrollState` (scroll position survives re-mounts via
#     the scrollY argument), the same pattern Home uses.
# Both systems are idempotent: they compare before writing, so an idle frame
# bumps no component generation and the render cache stays clean.
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ui/renderSystem/RenderSystem

# Persistent-world entrypoint. Mounts the profile page into `world` and
# returns the page-root entity, tagged `PageRoot{profilePageId}` by the mount.
func mountProfilePage(
  world: mod UiWorld
  reg: view TextureRegistry
  scenes: view AlbumScenes
  state: view AppState
  scrollY: view Float
  viewport: view Viewport
) pub ret EntityId {
  let scene: view Scene => scenes.profile
  let overrides: List(SceneOverride) = emptyOverrides()
  let pageIdCopy: String = "{profilePageId}"
  let profileLabel: String = "profile"
  let mount: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scene
    overrides: overrides
    w: viewport.areaDuW
    h: viewport.areaDuH
    sceneLabel: profileLabel
  )
  # Reserve the notch at the top edge; safeAreaSystem folds the active device
  # preset's inset in. Applied here so an in-place re-mount keeps the tag.
  attachSafeAreaEdges(
    world: world
    entity: mount
    top: 1.0
    bottom: 0.0
  )

  if let bodyRaw: Int = findNodeInPage(world: world, pageId: profilePageId, nodeId: "Body") {
    let body: EntityId = nodeEntity(world: world, index: bodyRaw)
    let off: Offset = { delta: Vec2 { x: 0.0, y: scrollY } }
    componentSet(this: world.offsets, entity: body, data: off)
    let scroll: ScrollState = { y: scrollY, velocity: 0.0 }
    componentSet(this: world.scrollStates, entity: body, data: scroll)
  }

  # First-frame values: the per-frame systems run again before every render,
  # but a fresh mount should never show the scene's placeholder "0".
  profileStatsSystem(world: world, state: state)
  avatarSystem(world: world, reg: reg)
  ret mount
}

# ----- ProfileStat system --------------------------------------------------

# The live text for one stat kind. Pulls counts from the album catalogue so
# the numbers stay honest — no fake follower counts.
func profileStatText(state: view AppState, stat: ProfileStatKind) ret String {
  unsafe {
    let albumCount: Int = state.mediaLibrary.albums.length
    if stat is ProfileStatKind.albums {
      ret "{albumCount}"
    }
    var trackCount: Int = 0
    var totalMs: Int = 0
    var i: Int = 0
    loop i < albumCount {
      let a: Album = rae_ext_rae_buf_get(buf: state.mediaLibrary.albums.data, index: i)
      trackCount = trackCount + a.tracks.length
      totalMs = totalMs + a.totalDurationMs
      i = i + 1
    }
    if stat is ProfileStatKind.tracks {
      ret "{trackCount}"
    }
    ret "{totalMs / 3600000}h"
  }
}

# Drive every `ProfileStat`: the Text on the same entity shows the live count.
func profileStatsSystem(world: mod UiWorld, state: view AppState) pub {
  let n: Int = componentCount(this: world.profileStats)
  var i: Int = 0
  loop i < n {
    let entity: EntityId = componentEntityAt(this: world.profileStats, i: i)
    let binding: ProfileStat = componentDataAt(this: world.profileStats, i: i)
    if componentHas(this: world.texts, entity: entity) {
      let wanted: String = profileStatText(state: state, stat: binding.stat)
      # A by-value read (three tiny Texts): the table must not be written
      # while a view into one of its rows is live.
      let current: Text = componentGet(this: world.texts, entity: entity)
      if current.text is not wanted {
        let updated: Text = {
          text: wanted
          styleId: "{current.styleId}"
          wrapWidthMode: current.wrapWidthMode
        }
        componentSet(this: world.texts, entity: entity, data: updated)
      }
    }
    i = i + 1
  }
}

# ----- AvatarSource system -------------------------------------------------
func setActiveIfChanged(world: mod UiWorld, entity: view EntityId, active: view Bool) {
  var current: Bool = true
  if componentHas(this: world.actives, entity: entity) {
    let a: Active = componentGet(this: world.actives, entity: entity)
    current = a.value
  }
  if current is not active {
    let flag: Active = { value: active }
    componentSet(this: world.actives, entity: entity, data: flag)
  }
}

# Drive every `AvatarSource`: among the container's children, the one whose
# Sprite shows `textureKey` is the photo; every other child is the placeholder.
# The photo is active exactly when the registry has the texture.
func avatarSystem(world: mod UiWorld, reg: view TextureRegistry) pub {
  unsafe {
    let n: Int = componentCount(this: world.avatarSources)
    var i: Int = 0
    loop i < n {
      let container: EntityId = componentEntityAt(this: world.avatarSources, i: i)
      let source: AvatarSource = componentDataAt(this: world.avatarSources, i: i)
      let loaded: Bool = textureHas(reg: reg, key: source.textureKey)
      if componentHas(this: world.childrens, entity: container) {
        let kids: view Children => componentView(this: world.childrens, entity: container)
        var k: Int = 0
        loop k < kids.ids.length {
          let child: EntityId = rae_ext_rae_buf_get(buf: kids.ids.data, index: k)
          var isPhoto: Bool = false
          if componentHas(this: world.sprites, entity: child) {
            let sp: view Sprite => componentView(this: world.sprites, entity: child)
            isPhoto = sp.textureKey is source.textureKey
          }
          var active: Bool = loaded
          if isPhoto is false {
            active = loaded is false
          }
          setActiveIfChanged(world: world, entity: child, active: active)
          k = k + 1
        }
      }
      i = i + 1
    }
  }
}
