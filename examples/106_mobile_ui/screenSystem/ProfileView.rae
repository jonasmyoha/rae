open ui/Ecs
# Profile-tab world composition — the user-account screen:
#   * top bar "Profile"
#   * circular avatar, centred, with the handle and a one-line bio under it
#   * three equal stat columns (live library counts — no fake followers)
#   * four settings rows: icon, label, chevron — as cards on the page
#     background so the column reads as one list
#
# Everything is centred on the page's vertical axis and every text node is
# sized to its style's line height (a 43 du body line needs ~56 du; the old
# 18/28 du rects were pre-rescale numbers and the labels painted over the
# values). The Spotify-status card that used to sit between the bio and the
# stats is gone: the dock's mini-player already shows what is playing.
#
# Like the Library page, the body owns a `ScrollState` so the settings list
# can scroll if it overflows.
import Files
import ui/Components
import ui/layoutSystem/LayoutSystem
open ecs/ComponentTable
open ui/renderSystem/RenderSystem

# Local shape helpers — world_helpers.rae only exposes plain rect / rounded
# variants without a stroke; the avatar fallback needs a true circle.
func setProfileCircleShape(world: mod UiWorld, entity: view EntityId, fill: view RgbaColor) {
  let sh: Shape = {
    kind: ShapeKind.circle
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: 0.0
  }
  componentSet(this: world.shapes, entity: entity, data: sh)
}

func setProfileCardShape(world: mod UiWorld, entity: view EntityId, fill: view RgbaColor) {
  let sh: Shape = {
    kind: ShapeKind.roundedRect
    fill: fill
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: profileCardRadius
  }
  componentSet(this: world.shapes, entity: entity, data: sh)
}

const profileAvatarSize: Float = 260.2409638554217

const profileAvatarIconSize: Float = 173.49397590361446

# Line heights per text style (font size × ~1.3, so descenders never clip).
const profileHandleLineH: Float = 56.38554216867469

const profileBioLineH: Float = 47.71084337349397

const profileStatValueLineH: Float = 78.0722891566265

const profileStatLabelLineH: Float = 47.71084337349397

const profileSettingsRowH: Float = 121.44578313253011

const profileSettingsIconSize: Float = 60.722891566265055

const profileSettingsPad: Float = 26.024096385542165

const profileCardRadius: Float = 26.024096385542165

func profileAvatarLoaded(reg: view TextureRegistry, key: view String) ret Bool {
  ret textureHas(reg: reg, key: key)
}

func buildProfileAvatar(world: mod UiWorld, reg: view TextureRegistry) ret EntityId {
  let avatar: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: avatar
    w: profileAvatarSize
    h: profileAvatarSize
  )

  let avatarKey: String = profileAvatarKey()
  if profileAvatarLoaded(reg: reg, key: avatarKey) {
    # Real profile picture — circle-cropped at load time
    # (`loadCircleCroppedTexture`). The alpha mask on the underlying
    # texture handles the round shape; no background Shape needed.
    let whiteTint: RgbaColor = { r: 255, g: 255, b: 255, a: 255 }
    setSprite(
      world: world
      entity: avatar
      key: avatarKey
      tint: whiteTint
    )
    let cr: CornerRadius = { radius: profileAvatarSize / 2.0 }
    componentSet(this: world.cornerRadiuses, entity: avatar, data: cr)
  } else {
    let accentBg: RgbaColor = palettePill(theme: world.theme.active)
    setProfileCircleShape(world: world, entity: avatar, fill: accentBg)
    let layS: LayoutType = LayoutType.stack
    let alignC: AlignKind = AlignKind.center
    setLayout(
      world: world
      entity: avatar
      kind: layS
      gap: 0.0
      alignCross: alignC
    )

    let icon: EntityId = createEntity(world: world)
    setRectFixed(
      world: world
      entity: icon
      w: profileAvatarIconSize
      h: profileAvatarIconSize
    )
    let personKey: String = "mat:person"
    setSprite(
      world: world
      entity: icon
      key: personKey
      tint: paletteLightText(theme: world.theme.active)
    )

    let kids: List(EntityId) = List.create(EntityId, cap: 1)
    kids.add(value: icon)
    attachChildren(world: world, parent: avatar, kids: kids)
  }
  ret avatar
}

# A full-width, centred text line sized to its style's line height.
func buildProfileTextLine(
  world: mod UiWorld
  text: view String
  styleId: view String
  w: view Float
  h: view Float
) ret EntityId {
  let line: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: line
    w: w
    h: h
  )
  setText(
    world: world
    entity: line
    text: text
    styleId: styleId
  )
  ret line
}

# Stat column: big number on top, small label below, both centred.
func buildProfileStatColumn(
  world: mod UiWorld
  value: view String
  label: view String
  colW: view Float
) ret EntityId {
  let col: EntityId = createEntity(world: world)
  let gap: Float = 4.337349397590361
  let colH: Float = profileStatValueLineH + gap + profileStatLabelLineH
  setRectFixed(
    world: world
    entity: col
    w: colW
    h: colH
  )
  let layV: LayoutType = LayoutType.vertical
  let alignC: AlignKind = AlignKind.center
  setLayout(
    world: world
    entity: col
    kind: layV
    gap: gap
    alignCross: alignC
  )

  let valueText: EntityId = buildProfileTextLine(
    world: world
    text: value
    styleId: "statValue"
    w: colW
    h: profileStatValueLineH
  )
  let labelText: EntityId = buildProfileTextLine(
    world: world
    text: label
    styleId: "statLabel"
    w: colW
    h: profileStatLabelLineH
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 2)
  kids.add(value: valueText)
  kids.add(value: labelText)
  attachChildren(world: world, parent: col, kids: kids)
  ret col
}

# Library-stats row: three equal columns spanning the body width. Pulls
# live counts from the album catalogue so the numbers stay honest.
func buildProfileStatsRow(world: mod UiWorld, state: view AppState) ret EntityId {
  unsafe {
    let row: EntityId = createEntity(world: world)
    let rowW: Float = phoneFrameW - outerPad * 2.0
    let gap: Float = outerGap
    let colW: Float = (rowW - gap * 2.0) / 3.0
    let rowH: Float = profileStatValueLineH + 4.337349397590361 + profileStatLabelLineH
    setRectFixed(
      world: world
      entity: row
      w: rowW
      h: rowH
    )
    let layH: LayoutType = LayoutType.horizontal
    let alignC: AlignKind = AlignKind.center
    setLayout(
      world: world
      entity: row
      kind: layH
      gap: gap
      alignCross: alignC
    )

    let albumCount: Int = state.mediaLibrary.albums.length
    var trackCount: Int = 0
    var totalMs: Int = 0
    var i: Int = 0
    loop i < albumCount {
      let a: Album = rae_ext_rae_buf_get(buf: state.mediaLibrary.albums.data, index: i)
      trackCount = trackCount + a.tracks.length
      totalMs = totalMs + a.totalDurationMs
      i = i + 1
    }
    let totalHours: Int = totalMs / 3600000
    let albumsStr: String = "{albumCount}"
    let tracksStr: String = "{trackCount}"
    let hoursStr: String = "{totalHours}h"

    let albumsCol: EntityId = buildProfileStatColumn(
      world: world
      value: albumsStr
      label: "Albums"
      colW: colW
    )
    let tracksCol: EntityId = buildProfileStatColumn(
      world: world
      value: tracksStr
      label: "Tracks"
      colW: colW
    )
    let hoursCol: EntityId = buildProfileStatColumn(
      world: world
      value: hoursStr
      label: "Listening"
      colW: colW
    )

    let kids: List(EntityId) = List.create(EntityId, cap: 3)
    kids.add(value: albumsCol)
    kids.add(value: tracksCol)
    kids.add(value: hoursCol)
    attachChildren(world: world, parent: row, kids: kids)
    ret row
  }
}

# One settings row — a surface card with the icon on the left, the label
# filling the middle and a chevron the same size as the icon flush right.
# Inert for now (no actionId) — placeholder rows that visually complete the
# screen without pretending to work.
func buildSettingsRow(world: mod UiWorld, iconKey: view String, label: view String) ret EntityId {
  let row: EntityId = createEntity(world: world)
  let rowW: Float = phoneFrameW - outerPad * 2.0
  setRectFixed(
    world: world
    entity: row
    w: rowW
    h: profileSettingsRowH
  )
  # A translucent raise rather than the palette's `surface`: in the dark
  # theme surface equals the page background and the card vanished.
  let raise: RgbaColor = { r: 255, g: 255, b: 255, a: 14 }
  setProfileCardShape(world: world, entity: row, fill: raise)
  let layH: LayoutType = LayoutType.horizontal
  let alignC: AlignKind = AlignKind.center
  setLayout(
    world: world
    entity: row
    kind: layH
    gap: profileSettingsPad
    alignCross: alignC
  )
  setPaddingAll(world: world, entity: row, n: profileSettingsPad)

  let icon: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: icon
    w: profileSettingsIconSize
    h: profileSettingsIconSize
  )
  setSprite(
    world: world
    entity: icon
    key: "{iconKey}"
    tint: paletteIconTint(theme: world.theme.active)
  )

  # Label takes exactly what is left between the icon and the chevron, so
  # the chevron lands on the right padding edge of every row.
  let labelW: Float = rowW - profileSettingsPad * 2.0 - profileSettingsIconSize * 2.0 - profileSettingsPad * 2.0
  let labelEnt: EntityId = buildProfileTextLine(
    world: world
    text: label
    styleId: "trackTitle"
    w: labelW
    h: profileHandleLineH
  )

  let chev: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: chev
    w: profileSettingsIconSize
    h: profileSettingsIconSize
  )
  let chevKey: String = "mat:chevron_right"
  setSprite(
    world: world
    entity: chev
    key: chevKey
    tint: paletteHero(theme: world.theme.active)
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 3)
  kids.add(value: icon)
  kids.add(value: labelEnt)
  kids.add(value: chev)
  attachChildren(world: world, parent: row, kids: kids)
  ret row
}

func buildSettingsList(world: mod UiWorld) ret EntityId {
  let list: EntityId = createEntity(world: world)
  let listW: Float = phoneFrameW - outerPad * 2.0
  let gap: Float = 17.349397590361445
  let rowCount: Int = 4
  let listH: Float = profileSettingsRowH * rowCount.toFloat() + gap * (rowCount - 1).toFloat()
  setRectFixed(
    world: world
    entity: list
    w: listW
    h: listH
  )
  let layV: LayoutType = LayoutType.vertical
  let alignS: AlignKind = AlignKind.start
  setLayout(
    world: world
    entity: list
    kind: layV
    gap: gap
    alignCross: alignS
  )

  let r1: EntityId = buildSettingsRow(world: world, iconKey: "mat:tune", label: "Audio quality")
  let r2: EntityId = buildSettingsRow(world: world, iconKey: "mat:equalizer", label: "Equalizer")
  let r3: EntityId = buildSettingsRow(world: world, iconKey: "mat:person", label: "Account")
  let r4: EntityId = buildSettingsRow(world: world, iconKey: "mat:logout", label: "Sign out")

  let kids: List(EntityId) = List.create(EntityId, cap: 4)
  kids.add(value: r1)
  kids.add(value: r2)
  kids.add(value: r3)
  kids.add(value: r4)
  attachChildren(world: world, parent: list, kids: kids)
  ret list
}

func buildProfileBody(
  world: mod UiWorld
  reg: view TextureRegistry
  state: view AppState
  scrollY: view Float
) ret EntityId {
  let body: EntityId = createEntity(world: world)
  let bodyW: Float = phoneFrameW - outerPad * 2.0
  let bodyH: Float = phoneFrameH - topBarH - navTabsH - outerGap * 4.0 - outerPad * 2.0
  setRectFixed(
    world: world
    entity: body
    w: bodyW
    h: bodyH
  )
  let layV: LayoutType = LayoutType.vertical
  let alignC: AlignKind = AlignKind.center
  setLayout(
    world: world
    entity: body
    kind: layV
    gap: outerGap
    alignCross: alignC
  )
  let off: Offset = { delta: Vec2 { x: 0.0, y: scrollY } }
  componentSet(this: world.offsets, entity: body, data: off)

  let scroll: ScrollState = { y: scrollY, velocity: 0.0 }
  componentSet(this: world.scrollStates, entity: body, data: scroll)

  let avatar: EntityId = buildProfileAvatar(world: world, reg: reg)

  # Handle + bio as one tight block under the avatar.
  let identity: EntityId = createEntity(world: world)
  let identityGap: Float = 4.337349397590361
  setRectFixed(
    world: world
    entity: identity
    w: bodyW
    h: profileHandleLineH + identityGap + profileBioLineH
  )
  setLayout(
    world: world
    entity: identity
    kind: layV
    gap: identityGap
    alignCross: alignC
  )
  let handle: EntityId = buildProfileTextLine(
    world: world
    text: "@violet.tapes"
    styleId: "profileHandle"
    w: bodyW
    h: profileHandleLineH
  )
  let bio: EntityId = buildProfileTextLine(
    world: world
    text: "indie pop / dream-punk / playlist lover"
    styleId: "profileBio"
    w: bodyW
    h: profileBioLineH
  )
  let identityKids: List(EntityId) = List.create(EntityId, cap: 2)
  identityKids.add(value: handle)
  identityKids.add(value: bio)
  attachChildren(world: world, parent: identity, kids: identityKids)

  let stats: EntityId = buildProfileStatsRow(world: world, state: state)
  let settings: EntityId = buildSettingsList(world: world)

  let kids: List(EntityId) = List.create(EntityId, cap: 4)
  kids.add(value: avatar)
  kids.add(value: identity)
  kids.add(value: stats)
  kids.add(value: settings)
  attachChildren(world: world, parent: body, kids: kids)
  ret body
}

# Persistent-world entrypoint. Mounts the profile page into `world`
# and returns the page-root entity. Tagged with `PageRoot{profilePageId}`.
func mountProfilePage(
  world: mod UiWorld
  reg: view TextureRegistry
  state: view AppState
  scrollY: view Float
  viewport: view Viewport
) pub ret EntityId {
  let root: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: root
    w: viewport.areaDuW
    h: viewport.areaDuH
  )
  let layV: LayoutType = LayoutType.vertical
  let alignS: AlignKind = AlignKind.start
  setLayout(
    world: world
    entity: root
    kind: layV
    gap: outerGap
    alignCross: alignS
  )
  setPaddingAll(world: world, entity: root, n: outerPad)

  var copiedId: String = ""
  copiedId = copiedId.concat(other: profilePageId)
  let pr: PageRoot = { id: own copiedId }
  componentSet(this: world.pageRoots, entity: root, data: own pr)

  let topBar: EntityId = buildPageTopBar(world: world, title: "Profile")
  let body: EntityId = buildProfileBody(
    world: world
    reg: reg
    state: state
    scrollY: scrollY
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 2)
  kids.add(value: topBar)
  kids.add(value: body)
  attachChildren(world: world, parent: root, kids: kids)
  attachSafeAreaEdges(
    world: world
    entity: root
    top: 1.0
    bottom: 0.0
  )

  ret root
}
