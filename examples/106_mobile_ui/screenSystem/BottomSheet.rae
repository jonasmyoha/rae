open ui/Ecs
# Bottom-sheet context menu — an iOS-style action sheet that
# slides up from the bottom of the screen with a list of tappable
# actions. Reused by any "show me options for this thing" affordance
# (currently: the three-dots button on track rows / album pages).
#
# Architecture:
#   * `BottomSheetState` lives next to AppState for the app's
#     lifetime; UI mounts off it.
#   * Open it with `openBottomSheet(state, actions)`. The actions
#     list carries the rows to render; each row's `actionId` is
#     dispatched through the normal input pipeline so the host
#     handles them with its own action-id dispatch table.
#   * `closeBottomSheet(state)` (or scrim tap → `sheet.dismiss`)
#     hides it. The `epoch` field bumps on every mutation; the
#     `BottomSheet` component's `builtEpoch` trails it.
#   * Layout (#980): the whole overlay is `BottomSheet.raescene` — a
#     dialog-layer root (Active false at rest), a Fill scrim, and a
#     bottom-anchored panel — mounted once per world by
#     `mountBottomSheetOverlay`. `bottomSheetSystem` drives every
#     instance: root Active follows `visible`, and when `epoch` moves
#     it re-mounts one `SheetActionRow` sub-scene per action into the
#     panel and sizes the panel from the row count. Nothing here builds
#     layout entities; the row hosts are the per-item sub-scene mounts.
#   * Render layer: the existing "dialog" layer (order 300, via the
#     authored LayerTag), so the sheet paints over dock + back-button +
#     content but under the debug overlay.
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ecs/hierarchySystem/HierarchySystem
open ui/layoutSystem/LayoutSystem
open ui/Theme

let bottomSheetPageId: String = "bottom-sheet"

type BottomSheetAction {
  label: String
  actionId: String
}

type BottomSheetState {
  visible: Bool
  actions: List(BottomSheetAction)
  # Bumped on every mutation. `bottomSheetSystem` compares it to the
  # sheet root's `BottomSheet.builtEpoch` and rebuilds the rows when it moved.
  epoch: Int
}

func createBottomSheetState() pub ret BottomSheetState {
  ret BottomSheetState { visible: false, actions: List.create(BottomSheetAction, cap: 4), epoch: 0 }
}

# Build an owned BottomSheetAction with deep-copied Strings — safe
# to hand to `openBottomSheet` from a transient call site without
# worrying about caller-pool ownership.
func mkSheetAction(label: view String, actionId: view String) pub ret BottomSheetAction {
  unsafe {
    ret BottomSheetAction {
      label: rae_ext_rae_string_copy(string: label)
      actionId: rae_ext_rae_string_copy(string: actionId)
    }
  }
}

# Replace the action list and flip visibility on. `actions` is
# transferred by `own` — callers build a fresh list per open.
func openBottomSheet(sheet: mod BottomSheetState, actions: own List(BottomSheetAction)) pub {
  sheet.actions = actions
  sheet.visible = true
  sheet.epoch = sheet.epoch + 1
}

func closeBottomSheet(sheet: mod BottomSheetState) pub {
  sheet.visible = false
  sheet.actions.length = 0
  sheet.epoch = sheet.epoch + 1
}

# Mount the sheet overlay scene once per world (hidden by its authored
# `Active: false`). Tagged `PageRoot{bottomSheetPageId}` by the page mount.
# The root is sized to the layout extent so the scrim covers the whole
# frame and the panel anchors to its bottom — on every device preset.
func mountBottomSheetOverlay(
  world: mod UiWorld
  scenes: view AlbumScenes
  sheet: view BottomSheetState
  state: view AppState
  playback: view PlaybackState
) pub ret EntityId {
  let pageIdCopy: String = "{bottomSheetPageId}"
  let root: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scenes.bottomSheet
    overrides: emptyOverrides()
    w: world.layoutW
    h: world.layoutH
    sceneLabel: "BottomSheet"
    subScenes: scenes.subScenes
  )
  # The action rows are the panel's `ListView` + `ListSource { sheet }`
  # (#996); fill them now so the first frame after a mount is right.
  listSourceSystem(
    world: world
    state: state
    playback: playback
    scenes: scenes
  )
  bottomSheetSystem(world: world, sheet: sheet)
  ret root
}

# The bottom-sheet system: for every `BottomSheet` root, follow
# `sheet.visible` with the root's Active, and size the `panelNodeId` panel's
# authored Rect to its rows (padding + rows + gaps) so the AnchorBottom
# system seats it on the bottom edge. The rows themselves are the panel's
# data list (ListSources.rae). Runs every frame from `refreshMountedUi` and
# once at mount; at idle it is a few comparisons.
func bottomSheetSystem(world: mod UiWorld, sheet: view BottomSheetState) pub {
  let n: Int = componentCount(this: world.bottomSheets)
  var i: Int = 0
  loop i < n {
    let root: EntityId = componentEntityAt(this: world.bottomSheets, i: i)
    let binding: BottomSheet = componentDataAt(this: world.bottomSheets, i: i)
    var currentActive: Bool = true
    if componentHas(this: world.actives, entity: root) {
      currentActive = componentGet(this: world.actives, entity: root).value
    }
    if currentActive is not sheet.visible {
      let active: Active = { value: sheet.visible }
      componentSet(this: world.actives, entity: root, data: active)
    }
    let pageId: String = pageOf(world: world, entity: root)
    if let panelRaw: Int = findNodeInPage(world: world, pageId: pageId, nodeId: binding.panelNodeId) {
      let panel: EntityId = nodeEntity(world: world, index: panelRaw)
      let pad: Insets = entityPadding(world: world, entity: panel)
      let layout: Layout = entityLayout(world: world, entity: panel)
      let rowCount: Int = sheet.actions.length
      var gaps: Float = 0.0
      if rowCount > 1 {
        gaps = layout.gap * (rowCount - 1).toFloat()
      }
      let panelH: Float = pad.t + binding.rowHeight * rowCount.toFloat() + gaps + pad.b
      let current: Rect = entityRect(world: world, entity: panel)
      if current.size.y is not panelH {
        let sized: Rect = {
          position: current.position
          size: Vec2 { x: current.size.x, y: panelH }
        }
        componentSet(this: world.rects, entity: panel, data: sized)
      }
    }
    i = i + 1
  }
}
