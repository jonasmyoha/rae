open ui/Ecs
# Library screen — the local album catalogue as a 3-column grid of cover
# tiles, each tappable via `album.open` to push the Album sub-page. The page
# is SCENE-DRIVEN (#975): assets/scenes/library.raescene owns the skeleton and
# the `CoverGrid` container; this module keeps the two TILE builders (a data
# list's items — a sub-scene from #979 on) and the library-key adapter, both
# shared with the Home grid through CoverGridSystem.
import Files
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ui/renderSystem/RenderSystem

# Inner gap between the four mini-covers of a playlist tile.
const playlistCoverGap: Float = 6.506024096385541

# Collect the album-cover texture keys for albums currently in the
# user's library. The catalog (`albums`) is the source of truth for
# what exists on disk; `library` filters that down to what the user
# wants to see in Home / Library views. Removing an album just
# drops its stem from the library — covers + metadata stick around
# in the catalog (history rows, search results, undo).
func collectLibraryCoverKeys(
  albums: view List(Album)
  library: view List(String)
) pub ret List(String) {
  unsafe {
    let result: List(String) = List.create(String, cap: library.length)
    var i: Int = 0
    loop i < albums.length {
      let a: Album = rae_ext_rae_buf_get(buf: albums.data, index: i)
      if isInLibrary(library: library, stem: a.stem) {
        # Fresh String allocation — `a.stem` is owned by `albums`,
        # which outlives this list, but downstream consumers (the
        # cover-tile builder) need their own copy to avoid sharing
        # the per-Album heap.
        let copied: String = "{a.stem}"
        result.add(value: copied)
      }
      i = i + 1
    }
    ret result
  }
}

# Build one image tile for the given texture key and size.
#
# Each tile carries a HeroWidget keyed by its texture so the hero
# animation system can morph this tile to/from the Album / Player
# screens when the cover is also visible there.
#
# Tiles take click input via `actionId: "album.open"`.
# `dispatchActions` reads the clicked tile's Sprite to recover the
# texture key, stores it as the active album, and pushes the Album
# sub-page. The hero transition then naturally finds this tile as
# source / destination. Public so `home_view.rae` can reuse it.
func buildLibraryCoverTile(
  world: mod UiWorld
  key: view String
  size: view Float
  rounded: view Bool
) pub ret EntityId {
  let tile: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: tile
    w: size
    h: size
  )
  let copiedForHero: String = key
  setHeroWidget(world: world, entity: tile, key: copiedForHero)
  let albumOpen: String = "album.open"
  setOnClick(world: world, entity: tile, actionId: albumOpen)
  # Data-oriented widget tags (#220): identity keyed by the album stem
  # plus the albums data-source dependency, so systems can find and
  # refresh cover tiles from component data instead of walking sprite
  # texture keys. setOnClick above already attached the ActionBinding.
  let tileKind: String = "albumTile"
  setWidgetIdentity(
    world: world
    entity: tile
    id: key
    kind: tileKind
  )
  setWidgetState(
    world: world
    entity: tile
    enabled: true
    selected: false
    loading: false
    error: false
  )
  let albumsSource: DataResourceId = dataResourceAlbums()
  let allField: DataFieldId = dataFieldAll()
  setDataDependency(
    world: world
    entity: tile
    resource: albumsSource
    field: allField
    observedRevision: 0
  )
  setSpriteFill(
    world: world
    entity: tile
    key: "{key}"
    tint: paletteImageTint(theme: world.theme.active)
  )
  if rounded {
    let cr: CornerRadius = { radius: 26.024096385542165 }
    componentSet(this: world.cornerRadiuses, entity: tile, data: cr)
  }
  setHoverScale(world: world, entity: tile, hoverScale: 1.12)
  ret tile
}

# Build a "playlist cover": a 2x2 grid of up to four album covers
# packed into a single library-tile footprint, so a playlist reads
# distinctly from the single-cover album tiles. Fewer than four covers
# still lay out on the 2x2 grid — the remaining cells render as a dim
# placeholder. Tapping fires `playlist.open` (see `dispatchActions`).
func buildPlaylistCoverTile(
  world: mod UiWorld
  coverStems: view List(String)
  size: view Float
  rounded: view Bool
) pub ret EntityId {
  unsafe {
    let tile: EntityId = createEntity(world: world)
    setRectFixed(
      world: world
      entity: tile
      w: size
      h: size
    )
    let playlistOpen: String = "playlist.open.liked"
    setOnClick(world: world, entity: tile, actionId: playlistOpen)
    let playlistId: String = "liked"
    let tileKind: String = "playlistTile"
    setWidgetIdentity(
      world: world
      entity: tile
      id: playlistId
      kind: tileKind
    )
    setWidgetState(
      world: world
      entity: tile
      enabled: true
      selected: false
      loading: coverStems.length is 0
      error: false
    )
    let playlistSource: DataResourceId = dataResourcePlaylists()
    let allField: DataFieldId = dataFieldAll()
    setDataDependency(
      world: world
      entity: tile
      resource: playlistSource
      field: allField
      observedRevision: 0
    )
    # Hover scale goes on the four cells, not this container (a layout
    # parent draws nothing of its own). `hoverScaleSystem` propagates the
    # tile's hover state down to them via `hoverScaleContains`, so the
    # whole 2x2 thumbnail scales together — matching the album tiles.
    let layV: LayoutType = LayoutType.vertical
    let alignS: AlignKind = AlignKind.start
    setLayout(
      world: world
      entity: tile
      kind: layV
      gap: playlistCoverGap
      alignCross: alignS
    )

    let cell: Float = (size - playlistCoverGap) / 2.0
    let placeholderFill: RgbaColor = { r: 58, g: 60, b: 70, a: 255 }

    let rows: List(EntityId) = List.create(EntityId, cap: 2)
    var r: Int = 0
    loop r < 2 {
      let row: EntityId = createEntity(world: world)
      setRectFixed(
        world: world
        entity: row
        w: size
        h: cell
      )
      let layH: LayoutType = LayoutType.horizontal
      setLayout(
        world: world
        entity: row
        kind: layH
        gap: playlistCoverGap
        alignCross: alignS
      )
      let cells: List(EntityId) = List.create(EntityId, cap: 2)
      var c: Int = 0
      loop c < 2 {
        let idx: Int = r * 2 + c
        let cellEntity: EntityId = createEntity(world: world)
        setRectFixed(
          world: world
          entity: cellEntity
          w: cell
          h: cell
        )
        if let key: String = coverStems.copyAt(index: idx) {
          setSpriteFill(
            world: world
            entity: cellEntity
            key: key
            tint: paletteImageTint(theme: world.theme.active)
          )
        } else {
          setShapeRect(world: world, entity: cellEntity, fill: placeholderFill)
        }
        if rounded {
          let cr: CornerRadius = { radius: 13.012048192771083 }
          componentSet(this: world.cornerRadiuses, entity: cellEntity, data: cr)
        }
        setHoverScale(world: world, entity: cellEntity, hoverScale: 1.12)
        cells.add(value: cellEntity)
        c = c + 1
      }
      attachChildren(world: world, parent: row, kids: cells)
      rows.add(value: row)
      r = r + 1
    }
    attachChildren(world: world, parent: tile, kids: rows)
    ret tile
  }
}

# Persistent-world entrypoint (#975, SCENE-DRIVEN). The page skeleton — top
# bar, scrollable Body, the CoverGrid container with its Layout/gap — is
# authored in assets/scenes/library.raescene; the container carries a
# `CoverGrid { columns: 3, source: library }` component and coverGridSystem
# materialises the tile rows beneath it from app state (and again whenever
# the library changes, so an album removed via the bottom sheet drops out).
# Tagged `PageRoot{libraryPageId}` by the mount.
func mountLibraryPage(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  scrollY: view Float
  viewport: view Viewport
) pub ret EntityId {
  let scene: view Scene => scenes.library
  let overrides: List(SceneOverride) = emptyOverrides()
  let pageIdCopy: String = "{libraryPageId}"
  let libraryLabel: String = "library"
  let mount: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scene
    overrides: overrides
    w: viewport.areaDuW
    h: viewport.areaDuH
    sceneLabel: libraryLabel
    subScenes: scenes.subScenes
  )
  attachSafeAreaEdges(
    world: world
    entity: mount
    top: 1.0
    bottom: 0.0
  )

  # Runtime scroll state on the Body container (scroll position survives
  # re-mounts via the scrollY argument) — the same pattern Home uses.
  if let bodyRaw: Int = findNodeInPage(world: world, pageId: libraryPageId, nodeId: "Body") {
    let body: EntityId = nodeEntity(world: world, index: bodyRaw)
    let off: Offset = { delta: Vec2 { x: 0.0, y: scrollY } }
    componentSet(this: world.offsets, entity: body, data: off)
    let scroll: ScrollState = { y: scrollY, velocity: 0.0 }
    componentSet(this: world.scrollStates, entity: body, data: scroll)
  }

  # First fill now: the screen switch captures the hero tile right after
  # the mount, before the per-frame system would run.
  coverGridSystem(world: world, state: state, scenes: scenes)
  ret mount
}
