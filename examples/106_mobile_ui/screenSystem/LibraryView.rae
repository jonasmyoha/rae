open ui/Ecs
# Library screen — the local album catalogue as a 3-column grid of cover
# tiles, each tappable via `album.open` to push the Album sub-page. The page
# is SCENE-DRIVEN (#975): assets/scenes/Library.raescene owns the skeleton and
# the `CoverGrid` container, CoverGridSystem mounts the `CoverTile` /
# `PlaylistTile` sub-scenes (#979); this module keeps the library-key adapter
# shared with the Home grid.
import Files
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ui/renderSystem/RenderSystem

# Collect the album-cover texture keys for albums currently in the
# user's library. The catalog (`albums`) is the source of truth for
# what exists on disk; `library` filters that down to what the user
# wants to see in Home / Library views. Removing an album just
# drops its stem from the library — covers + metadata stick around
# in the catalog (history rows, search results, undo).
func collectLibraryCoverKeys(
  albums: view List(Album)
  library: view List(String)
) pub ret List(String) {
  unsafe {
    let result: List(String) = List.create(String, cap: library.length)
    var i: Int = 0
    loop i < albums.length {
      let a: Album = rae_ext_rae_buf_get(buf: albums.data, index: i)
      if isInLibrary(library: library, stem: a.stem) {
        # Fresh String allocation — `a.stem` is owned by `albums`,
        # which outlives this list, but downstream consumers (the
        # cover-tile builder) need their own copy to avoid sharing
        # the per-Album heap.
        let copied: String = "{a.stem}"
        result.add(value: copied)
      }
      i = i + 1
    }
    ret result
  }
}

# Persistent-world entrypoint (#975, SCENE-DRIVEN). The page skeleton — top
# bar, scrollable Body, the CoverGrid container with its Layout/gap — is
# authored in assets/scenes/Library.raescene; the container carries a
# `CoverGrid { columns: 3, source: library }` component and coverGridSystem
# materialises the tile rows beneath it from app state (and again whenever
# the library changes, so an album removed via the bottom sheet drops out).
# Tagged `PageRoot{libraryPageId}` by the mount.
func mountLibraryPage(
  world: mod UiWorld
  scenes: view AlbumScenes
  state: view AppState
  scrollY: view Float
  viewport: view Viewport
) pub ret EntityId {
  let scene: view Scene => scenes.library
  let overrides: List(SceneOverride) = emptyOverrides()
  let pageIdCopy: String = "{libraryPageId}"
  let libraryLabel: String = "Library"
  let mount: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scene
    overrides: overrides
    w: viewport.areaDuW
    h: viewport.areaDuH
    sceneLabel: libraryLabel
    subScenes: scenes.subScenes
  )
  attachSafeAreaEdges(
    world: world
    entity: mount
    top: 1.0
    bottom: 0.0
  )

  # Runtime scroll state on the Body container (scroll position survives
  # re-mounts via the scrollY argument) — the same pattern Home uses.
  if let bodyRaw: Int = findNodeInPage(world: world, pageId: libraryPageId, nodeId: "Body") {
    let body: EntityId = nodeEntity(world: world, index: bodyRaw)
    let off: Offset = { delta: Vec2 { x: 0.0, y: scrollY } }
    componentSet(this: world.offsets, entity: body, data: off)
    let scroll: ScrollState = { y: scrollY, velocity: 0.0 }
    componentSet(this: world.scrollStates, entity: body, data: scroll)
  }

  # First fill now: the screen switch captures the hero tile right after
  # the mount, before the per-frame system would run.
  coverGridSystem(world: world, state: state, scenes: scenes)
  ret mount
}
