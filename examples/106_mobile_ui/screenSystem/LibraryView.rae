open ui/Ecs
# Library screen — the local album catalogue as a 3-column grid of cover
# tiles, each tappable via `album.open` to push the Album sub-page. The page
# is SCENE-DRIVEN (#975): assets/scenes/Library.raescene owns the skeleton and
# the `CoverGrid` container, CoverGridSystem mounts the `CoverTile` /
# `PlaylistTile` sub-scenes (#979); this module keeps the library-key adapter
# shared with the Home grid.
import Files
import ui/Components
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable
open ui/renderSystem/RenderSystem

# Collect the album-cover texture keys for albums currently in the
# user's library. The catalog (`albums`) is the source of truth for
# what exists on disk; `library` filters that down to what the user
# wants to see in Home / Library views. Removing an album just
# drops its stem from the library — covers + metadata stick around
# in the catalog (history rows, search results, undo).
func collectLibraryCoverKeys(
  albums: view List(Album)
  library: view List(String)
) pub ret List(String) {
  unsafe {
    var result: List(String) = List.create(String, cap: library.length)
    var i: Int = 0
    loop i < albums.length {
      let a: Album = rae_ext_rae_buf_get(buf: albums.data, index: i)
      if isInLibrary(library: library, stem: a.stem) {
        # Fresh String allocation — `a.stem` is owned by `albums`,
        # which outlives this list, but downstream consumers (the
        # cover-tile builder) need their own copy to avoid sharing
        # the per-Album heap.
        let copied: String = "{a.stem}"
        result.add(value: copied)
      }
      i = i + 1
    }
    ret result
  }
}
