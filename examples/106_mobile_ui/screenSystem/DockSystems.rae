open ui/Ecs
# DockSystems (#978) — the systems behind Dock.raescene / BackButton.raescene.
#
#   anchorBottomSystem  every `AnchorBottom`: Offset.y = layoutH - Rect.h -
#                       bottomInset, written only when it changes (replaces
#                       both the authored dock Offset and liftDockForSafeArea).
#   layerTagSystem      every `LayerTag`: resolve the named layer to a
#                       LayerRef once (a scene cannot spell an EntityId).
#   navTabsSystem       every `NavTab`: the tab is active when its `screen`
#                       names the app's current tab — write the active /
#                       inactive icon tint onto the tab's Sprite children and
#                       the label style onto its Text children, and mirror it
#                       into WidgetState.selected. Compares before writing.
import ui/Components
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ui/Layer

# DockSystem (docs/ecs-systems-own-their-tables.md §3): owns the dock's `NavTab` tabs — its
# authored components are ITS tables, no longer lib/ui's.
type DockSystem {
  navTabs: ComponentTable(NavTab)
}

func createDockSystem() ret DockSystem {
  ret DockSystem { navTabs: ComponentTable.create(NavTab) }
}

func anchorBottomSystem(world: mod UiWorld, bottomInset: view Float) pub {
  let n: Int = componentCount(this: world.anchorBottoms)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: world.anchorBottoms, i: i)
    let anchor: view AnchorBottom => queryViewAt(table: world.anchorBottoms, denseIndex: i)
    if anchor.enabled and componentHas(this: world.rects, entityId: entityId) {
      let r: view Rect => componentView(this: world.rects, entityId: entityId)
      let wantedY: Float = world.layoutH - r.size.y - bottomInset
      var currentY: Float = wantedY - 1.0
      if componentHas(this: world.offsets, entityId: entityId) {
        currentY = componentView(this: world.offsets, entityId: entityId).delta.y
      }
      if currentY is not wantedY {
        let off: Offset = { delta: Vec2 { x: 0.0, y: wantedY } }
        componentSet(this: world.offsets, entityId: entityId, data: off)
      }
    }
    i = i + 1
  }
}

func layerTagSystem(world: mod UiWorld) pub {
  let n: Int = componentCount(this: world.layerTags)
  var i: Int = 0
  loop i < n {
    let entityId: EntityId = componentEntityAt(this: world.layerTags, i: i)
    if componentHas(this: world.layerRefs, entityId: entityId) is false {
      let tag: view LayerTag => queryViewAt(table: world.layerTags, denseIndex: i)
      setLayerById(world: world, entityId: entityId, id: tag.id)
    }
    i = i + 1
  }
}

func setTabSpriteTint(world: mod UiWorld, entityId: view EntityId, tint: view RgbaColor) {
  let current: RgbaColor = componentView(this: world.sprites, entityId: entityId).tint
  if current.r is tint.r and current.g is tint.g and current.b is tint.b and current.a is tint.a {
    ret
  }
  let sprite: mod Sprite => componentMod(this: world.sprites, entityId: entityId)
  sprite.tint = tint
  sprite.tintSlot = ""
}

func setTabTextStyle(world: mod UiWorld, entityId: view EntityId, styleId: view String) {
  if componentView(this: world.texts, entityId: entityId).styleId is styleId {
    ret
  }
  let text: mod Text => componentMod(this: world.texts, entityId: entityId)
  text.styleId = "{styleId}"
}

func navTabsSystem(dockSystem: view DockSystem, world: mod UiWorld, activeTab: Screen) pub {
  unsafe {
    # A tab's authored `NavTab.screen` is the page id of the screen it
    # selects — the same id the ScreenPage table gives the active tab.
    let activeName: String = pageIdForScreen(screen: activeTab)
    let activeTint: RgbaColor = { r: 30, g: 30, b: 36, a: 255 }
    let inactiveTint: RgbaColor = { r: 130, g: 130, b: 140, a: 255 }
    let n: Int = componentCount(this: dockSystem.navTabs)
    var i: Int = 0
    loop i < n {
      let tab: EntityId = componentEntityAt(this: dockSystem.navTabs, i: i)
      let binding: view NavTab => queryViewAt(table: dockSystem.navTabs, denseIndex: i)
      let active: Bool = binding.screen is activeName
      var tint: RgbaColor = inactiveTint
      var style: String = "tabInactive"
      if active {
        tint = activeTint
        style = "tabActive"
      }
      if componentHas(this: world.childrens, entityId: tab) {
        var kids: List(EntityId) = List.create(EntityId, cap: 4)
        let ch: view Children => componentView(this: world.childrens, entityId: tab)
        var k: Int = 0
        loop k < ch.ids.length {
          kids.add(value: rae_ext_rae_buf_get(buf: ch.ids.data, index: k))
          k = k + 1
        }
        loop let child: view EntityId in kids {
          if componentHas(this: world.sprites, entityId: child) {
            setTabSpriteTint(world: world, entityId: child, tint: tint)
          }
          if componentHas(this: world.texts, entityId: child) {
            setTabTextStyle(world: world, entityId: child, styleId: style)
          }
        }
      }
      if componentHas(this: world.widgetStates, entityId: tab) {
        if componentView(this: world.widgetStates, entityId: tab).selected is not active {
          let widgetState: mod WidgetState => componentMod(this: world.widgetStates, entityId: tab)
          widgetState.selected = active
        }
      }
      i = i + 1
    }
  }
}
