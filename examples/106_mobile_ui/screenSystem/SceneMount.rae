open ui/Ecs
# Scene-mount helpers with a visible-failure sentinel. `mountOrError`
# wraps `mountSceneInstance` so a `-1` return (parse failure, missing
# root, etc.) turns into a bright red rectangle on screen plus a log
# entry — instead of producing a half-built subtree that renders as
# the background clear color (the "grey screen of death").
import ui/Components
import ui/Registry
open ui/SceneLoader
import ui/Scene
open ecs/Entity
open ui/SceneInstance
open ecs/ComponentTable

# Decorate `entity` as a glaring red error block with a label. Used
# when scene mounting fails. Caller has already set the entity's Rect/Size.
func paintErrorBlock(world: mod UiWorld, entity: view EntityId, label: view String) pub {
  let red: RgbaColor = { r: 220, g: 32, b: 48, a: 255 }
  let shape: Shape = {
    kind: ShapeKind.roundedRect
    fill: red
    stroke: RgbaColor { r: 0, g: 0, b: 0, a: 0 }
    strokeWidth: 0.0
    radius: 17.349397590361445
  }
  componentSet(this: world.shapes, entity: entity, data: shape)

  let txt: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: txt
    w: 480.0
    h: 32.0
  )
  let prefix: String = "Scene mount failed: "
  let msg: String = prefix.concat(other: label)
  setText(
    world: world
    entity: txt
    text: msg
    styleId: "primary"
  )

  let kids: List(EntityId) = List.create(EntityId, cap: 1)
  kids.add(value: txt)
  attachChildren(world: world, parent: entity, kids: kids)
}

# Mount a scene under `mountEntity`. On failure log + paint the entity
# as a sentinel error block and return the mount entity (callers expect
# a non-negative id).
func mountOrError(
  world: mod UiWorld
  mountEntity: view EntityId
  scene: view Scene
  sceneLabel: view String
  overrides: view List(SceneOverride)
) pub ret EntityId {
  let result: EntityId = mountSceneInstance(
    world: world
    mountEntity: mountEntity
    scene: scene
    overrides: overrides
  )
  if isNone(this: result) {
    let label: String = sceneLabel
    log(
      "[scene-error] mount failed for {label} (entity {mountEntity.index}, scene.ok={scene.ok}, scene.errorMsg={scene.errorMsg})"
    )
    paintErrorBlock(world: world, entity: mountEntity, label: label)
    ret mountEntity
  }
  ret result
}

# Host-less sub-scene mount with the visible-failure sentinel (#990): the
# scene's ROOT is the returned entity (lib `mountSubScene` keeps the root's
# authored placement), sized w x h through a `Rect` override on the root
# node — so a list materialiser creates no entity of its own. Only when the
# scene is not ok does this materialise a red sentinel block at that size,
# the same failure signal `mountOrError` paints on a page.
func mountSubSceneOrError(
  world: mod UiWorld
  scene: view Scene
  sceneLabel: view String
  overrides: mod List(SceneOverride)
  w: view Float
  h: view Float
) ret EntityId {
  addRectSizeOverride(
    list: overrides
    nodeId: "{scene.rootNodeId}"
    w: w
    h: h
  )
  let mounted: EntityId = mountSubScene(world: world, scene: scene, overrides: overrides)
  if isNone(this: mounted) {
    let label: String = sceneLabel
    log(
      "[scene-error] mount failed for {label} (scene.ok={scene.ok}, scene.errorMsg={scene.errorMsg})"
    )
    let sentinel: EntityId = createEntity(world: world)
    setRectFixed(
      world: world
      entity: sentinel
      w: w
      h: h
    )
    paintErrorBlock(world: world, entity: sentinel, label: label)
    ret sentinel
  }
  ret mounted
}

# `mountSubSceneOrError` for a scene looked up by id in `reg`; an id the
# registry does not know is the same visible failure as a broken scene.
func mountRegistrySubSceneOrError(
  world: mod UiWorld
  reg: view SceneRegistry
  sceneId: view String
  overrides: mod List(SceneOverride)
  w: view Float
  h: view Float
) ret EntityId {
  let idx: Int = sceneRegistryIndex(reg: reg, key: sceneId)
  if idx < 0 {
    let label: String = sceneId
    log("[scene-error] no sub-scene registered as {label}")
    let sentinel: EntityId = createEntity(world: world)
    setRectFixed(
      world: world
      entity: sentinel
      w: w
      h: h
    )
    paintErrorBlock(world: world, entity: sentinel, label: label)
    ret sentinel
  }
  let scene: view Scene => sceneRegistryGet(reg: reg, idx: idx)
  ret mountSubSceneOrError(
    world: world
    scene: scene
    sceneLabel: sceneId
    overrides: overrides
    w: w
    h: h
  )
}

# Mount a scene under a fresh entity sized w x h. No overrides. `label`
# is a short human-readable name used in error logs / on the sentinel
# error block when mounting fails.
func buildSimpleSceneInstance(
  world: mod UiWorld
  scene: view Scene
  w: view Float
  h: view Float
  label: view String
) pub ret EntityId {
  let mount: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: mount
    w: w
    h: h
  )
  let noOverrides: List(SceneOverride) = emptyOverrides()
  let mounted: EntityId = mountOrError(
    world: world
    mountEntity: mount
    scene: scene
    sceneLabel: label
    overrides: noOverrides
  )
  ret mount
}

# mountPage wrapper with the same visible-failure-sentinel behaviour
# as `mountOrError`: on a parse / root-missing failure we still
# materialise a host entity at the requested size, paint it red, and
# tag it with PageRoot so the id is discoverable. Returns the page
# root entity in both the success and the failure case.
func mountPageOrError(
  world: mod UiWorld
  pageId: own String
  scene: view Scene
  overrides: view List(SceneOverride)
  w: view Float
  h: view Float
  sceneLabel: view String
  subScenes: view SceneRegistry
) pub ret EntityId {
  let pageIdForNested: String = "{pageId}"
  let root: EntityId = mountPage(
    world: world
    pageId: pageId
    scene: scene
    overrides: overrides
    w: w
    h: h
  )
  if isNone(this: root) is false {
    # #978: a node authored as `"SceneInstance": { "sceneId": ..., "params":
    # { "overrides": [...] } }` (a page's top bar, a nav tab) is mounted here
    # from the sub-scene registry, under the page's nodeId scope.
    resolveSceneInstances(world: world, registry: subScenes, pageId: pageIdForNested)
    ret root
  }
  # Build a husk: same shape as the success path, plus the red error
  # block + PageRoot tag.
  let husk: EntityId = createEntity(world: world)
  setRectFixed(
    world: world
    entity: husk
    w: w
    h: h
  )
  let label: String = sceneLabel
  log(
    "[scene-error] mount failed for page {pageId} (scene.ok={scene.ok}, scene.errorMsg={scene.errorMsg})"
  )
  paintErrorBlock(world: world, entity: husk, label: label)
  var copiedId: String = ""
  copiedId = copiedId.concat(other: pageId)
  let pr: PageRoot = { id: own copiedId }
  componentSet(this: world.pageRoots, entity: husk, data: own pr)
  ret husk
}
