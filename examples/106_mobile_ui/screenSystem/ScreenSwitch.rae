open ui/Ecs
open ui/Pipeline
open ecs/Schedule
open ecs/Entity
open ecs/ComponentTable
open ui/layoutSystem/LayoutSystem
open ui/Transform
open ui/scrollRootSystem/ScrollRootSystem
open ui/animationSystem/HeroTransitionSystem
open ui/UiSystems

# Persistent-world screen-switch handler. Called from the inner loop
# once per frame after `dispatchActions` has chosen `nextScreen`:
#   * willSwitch=true  → flip Active, re-mount only a page whose row asks
#                        (`ScreenPage.refreshOnEntry`), and spawn the hero
#                        transition entity when both pages show the same
#                        `HeroWidget` key (ui/animationSystem/
#                        HeroTransitionSystem).
#   * willSwitch=false → poll the hot-reload watcher and possibly
#                        force an outer rebuild.
#
# A browsed stem / track change is NOT a re-mount: the album track-row
# highlight and the player header are bindings the observation pass updates
# in place (the album ScrollRoot is reset to the top on a new album).
#
# Returns a `ScreenSwitchResult` the caller copies back into its
# locals — `currentScreen`, cached album/track values, scrollTarget,
# and the outer-rebuild `switching` signal.
#
# Scroll across a re-mount is the session's `ScrollMemory` (lib/ui/
# scrollRootSystem): a page re-mounted for FRESH data (a `refreshOnEntry`
# page) forgets its position first so it lands at the top. The album, which
# is NOT re-mounted on a stem change, is instead reset in place
# (`resetScrollRootOnPage`) so a new album starts at the top.
type ScreenSwitchResult {
  newScreen: Screen
  newScrollTarget: EntityId
  cachedTrackDurMs: Int
  cachedAlbumStem: String
  cachedTrackIndex: Int
  switching: Bool
}

func handleScreenSwitch(
  dockSystem: view DockSystem
  world: mod UiWorld
  uiSystems: mod UiSystems
  scenes: mod AlbumScenes
  playbackSystem: mod PlaybackSystem
  appState: mod AppState
  schedule: mod Schedule
  input: mod InputSystem
  scrollFsm: mod ScrollFsm
  scrollMemory: mod ScrollMemory
  watcher: mod FileWatcher
  willSwitch: view Bool
  currentScreen: view Screen
  nextScreen: view Screen
  scrollTarget: view EntityId
  cachedAlbumStem: view String
  cachedTrackIndex: view Int
  cachedTrackDurMs: view Int
  viewport: view Viewport
  reg: view TextureRegistry
) ret ScreenSwitchResult {
  let result: ScreenSwitchResult = {
    newScreen: currentScreen
    newScrollTarget: scrollTarget
    cachedTrackDurMs: cachedTrackDurMs
    cachedAlbumStem: "{cachedAlbumStem}"
    cachedTrackIndex: cachedTrackIndex
    switching: false
  }

  let outgoingPageId: String = pageIdForScreen(screen: currentScreen)
  let incomingPageId: String = pageIdForScreen(screen: nextScreen)
  let stemChangedNow: Bool = appState.currentAlbumStem is cachedAlbumStem is false
  let trackChangedNow: Bool = appState.currentTrackIndex is not cachedTrackIndex

  # Data change WITHOUT a re-mount. The album track-row highlight and the
  # player header are bindings: the album `TrackList` ListSource keys its rows
  # on the playing stem|index (so the selected row re-binds in place), and the
  # player's `PlaybackCover` / `TrackText` / `PlaybackTime` follow the browsed
  # collection + `nowPlayingRevision`. The command phase already moved those,
  # so the observation pass this frame updates both pages in place — the album
  # and player stay mounted, which is also what lets the hero transition below
  # read the (already-laid-out) incoming hero. Opening a DIFFERENT album is
  # the one thing a binding does not cover: reset the album's scroll to the
  # top, since the persistent page keeps the previous album's offset.
  if stemChangedNow {
    resetScrollRootOnPage(world: world, uiSystems: uiSystems, pageId: albumPageId)
  }

  if willSwitch is false {
    # No screen change requested — refresh outer-loop caches if the
    # data changed in place, then poll the hot-reload watcher.
    if stemChangedNow or trackChangedNow {
      let activeAlbumNow1: Album = activeAlbum(state: appState)
      let activeTrackNow1: Track = trackAt(album: activeAlbumNow1, idx: appState.currentTrackIndex)
      result.cachedTrackDurMs = activeTrackNow1.durationMs
      result.cachedAlbumStem = "{appState.currentAlbumStem}"
      result.cachedTrackIndex = appState.currentTrackIndex
      # No re-mount: the album/player pages stayed mounted and active, so the
      # scroll target is unchanged (a stem change reset its offset above).
    }
    if fileWatch.checkForChanges(watcher: watcher, now: uiNowSeconds()) {
      scenes = loadAllScenes()
      result.switching = true
      log("[data-hot-reload] scene file changed, rebuilding world")
    }
    ret result
  }

  setPageActive(world: world, pageId: outgoingPageId, active: false)
  # A page whose row asks for a fresh mount on entry is re-mounted at the
  # top; no page does today — the lists and the "Recently played" section
  # follow their data in place (ScreenPage.refreshOnEntry).
  let incomingPage: ScreenPage = screenPageFor(screen: nextScreen)
  if incomingPage.refreshOnEntry {
    unmountPage(world: world, uiSystems: uiSystems, pageId: incomingPageId)
    forgetScroll(memory: scrollMemory, pageId: incomingPageId)
    let fresh: EntityId = mountScreenPage(
      world: world
      uiSystems: uiSystems
      page: incomingPage
      scenes: scenes
      viewport: viewport
    )
  }
  setPageActive(world: world, pageId: incomingPageId, active: true)
  # Seed the ScrollRoot of whatever was just re-mounted (top for a fresh
  # page, the remembered position for an in-place re-mount).
  scrollRootSystem(world: world, uiSystems: uiSystems, memory: scrollMemory)

  # #978: the nav-tabs bar and the back button are resident. The active
  # tab is a component the nav-tabs system restyles in place; the back
  # button's page is shown while a sub-page is open.
  navTabsSystem(dockSystem: dockSystem, world: world, activeTab: appState.tab)
  setPageActive(world: world, pageId: backButtonPageId, active: isSubPage(state: appState))

  # Re-seed safe-area insets onto the freshly re-mounted page BEFORE the
  # intermediate hero layout below. That layout would otherwise run while
  # the new page root has SafeArea but no SafeInsets yet — and since
  # SafeInsets is not a layout dirty input, the per-frame applySafeAreas
  # in main.rae seeds it too late to trigger a relayout, silently losing
  # the notch reserve until something else dirties the layout.
  let switchSafe: Insets = applySafeAreas(world: world, uiSystems: uiSystems, viewport: viewport)

  # Hero transition. Both source and target live in the same persistent
  # world: the outgoing page's `HeroWidget` for the browsed album and the
  # incoming page's. The intermediate layout+transform flush gives the
  # freshly-mounted target page a valid WorldTransform2D before its rect
  # is read; `spawnHeroTransition` then creates the overlay entity that
  # flies between the two (ui/animationSystem/HeroTransitionSystem) and
  # hides the destination until it lands.
  let heroKey: String = appState.currentAlbumStem
  let heroSource: EntityId = findHeroOnPage(
    world: world
    uiSystems: uiSystems
    pageId: outgoingPageId
    key: heroKey
  )
  if isNone(this: heroSource) is false {
    if uiShouldRun(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      index: uiSystemLayout
    ) {
      layoutSystem(world: world, uiSystems: uiSystems)
    }
    if uiShouldRun(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      index: uiSystemTransform
    ) {
      transformSystem(world: world, uiSystems: uiSystems)
    }
    let heroTarget: EntityId = findHeroOnPage(
      world: world
      uiSystems: uiSystems
      pageId: incomingPageId
      key: heroKey
    )
    let started: Bool = spawnHeroTransition(
      world: world
      uiSystems: uiSystems
      key: heroKey
      source: heroSource
      target: heroTarget
      now: uiNowSeconds()
      duration: heroTransitionSec
      layerId: "dialog"
    )
  }

  result.newScreen = nextScreen
  # Refresh outer-loop caches that used to be updated by the rebuild
  # path — we no longer go through the outer loop's data-change block.
  if stemChangedNow or trackChangedNow {
    let activeAlbumNow: Album = activeAlbum(state: appState)
    let activeTrackNow: Track = trackAt(album: activeAlbumNow, idx: appState.currentTrackIndex)
    result.cachedTrackDurMs = activeTrackNow.durationMs
    result.cachedAlbumStem = "{appState.currentAlbumStem}"
    result.cachedTrackIndex = appState.currentTrackIndex
    let trackDurSec2: Float = result.cachedTrackDurMs.toFloat() / 1000.0
    if trackDurSec2 > 0.0 {
      playbackSystem.durationSec = trackDurSec2
    }
  }
  # Persistent per-page scroll: read the new page's ScrollState.y.
  # Entities survive screen changes; a re-mounted page was re-seeded from
  # the scroll memory above.
  result.newScrollTarget = findScrollRoot(world: world, uiSystems: uiSystems)
  if isNone(this: result.newScrollTarget) {
    scrollFsm.scrollY = 0.0
  } else {
    if componentHas(this: world.scrollStates, entity: result.newScrollTarget) {
      let s: ScrollState = componentGet(this: world.scrollStates, entity: result.newScrollTarget)
      scrollFsm.scrollY = s.y
    } else {
      scrollFsm.scrollY = 0.0
    }
  }
  scrollFsm.velocity = 0.0
  # Entity ids on the new screen are unrelated to the outgoing one;
  # drop any held-press id so the next screen's release doesn't
  # accidentally match a stale id.
  input.pressedEntity = noEntity()

  ret result
}
