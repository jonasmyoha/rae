open ui/Ecs
# Search tab — SCENE-DRIVEN (#976). assets/scenes/search.raescene owns the
# page: top bar, the search field (a rounded pill with a `mat:search` icon and
# the placeholder line), the `EmptyState` block shown while nothing is typed
# (the "Recent" header + three stub rows) and the `Results` list container.
# What a scene cannot express is authored as components the two systems in
# SearchSystems.rae drive: `SearchField { query, placeholder }` on the field
# (typing goes into `query`, the line mirrors it) and `SearchResults { source }`
# on the container (one track-row sub-scene per catalogue match).
import ui/Scene
open ui/SceneInstance
open ecs/Entity
open ecs/ComponentTable

# Persistent-world entrypoint; the mount tags the root `PageRoot{searchPageId}`.
func mountSearchPage(
  world: mod UiWorld
  scenes: view AlbumScenes
  viewport: view Viewport
) pub ret EntityId {
  let scene: view Scene => scenes.search
  let overrides: List(SceneOverride) = emptyOverrides()
  let pageIdCopy: String = "{searchPageId}"
  let searchLabel: String = "search"
  let mount: EntityId = mountPageOrError(
    world: world
    pageId: own pageIdCopy
    scene: scene
    overrides: overrides
    w: viewport.areaDuW
    h: viewport.areaDuH
    sceneLabel: searchLabel
  )
  attachSafeAreaEdges(
    world: world
    entity: mount
    top: 1.0
    bottom: 0.0
  )
  ret mount
}
