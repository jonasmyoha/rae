import Sys

# Central app-owned cache for runtime music data. Unlike /tmp, this survives
# restarts; unlike assets/, it is user/runtime state and stays gitignored.
const appCacheDir: String = "examples/106_mobile_ui/app_cache"

const appCacheMetadataDir: String = "examples/106_mobile_ui/app_cache/metadata"

const appCachePlaylistsDir: String = "examples/106_mobile_ui/app_cache/metadata/playlists"

const appCacheArtworkMetaDir: String = "examples/106_mobile_ui/app_cache/metadata/album_art"

const appCacheAlbumArtDir: String = "examples/106_mobile_ui/app_cache/album_art"

# Legacy locations used before app_cache existed. Read as migration fallbacks
# only; new writes go to app_cache.
const legacyHistoryFilePath: String = "examples/106_mobile_ui/temp/play_history.json"

const legacyLibraryFilePath: String = "examples/106_mobile_ui/temp/library.json"

const legacyPlaylistsDir: String = "examples/106_mobile_ui/temp/playlists"

const historyFilePath: String = "examples/106_mobile_ui/app_cache/metadata/play_history.json"

const libraryFilePath: String = "examples/106_mobile_ui/app_cache/metadata/library.json"

func ensureAppCacheDirs() pub {
  makeDir(path: appCacheDir)
  makeDir(path: appCacheMetadataDir)
  makeDir(path: appCachePlaylistsDir)
  makeDir(path: appCacheArtworkMetaDir)
  makeDir(path: appCacheAlbumArtDir)
}

func cachedArtworkPath(imageHash: view String) pub ret String {
  ret "{appCacheAlbumArtDir}/{imageHash}.jpg"
}

func cachedArtworkHashFromUrl(url: view String) pub ret String {
  let slash: String = "/"
  if let i: Int = url.lastIndexOf(sub: slash) {
    let n: Int = url.length()
    ret url.sub(start: i + 1, len: n - i - 1)
  }
  ret "{url}"
}

func cachedArtworkKeyFromUrl(url: view String) pub ret String {
  if url.length() is 0 {
    ret ""
  }
  let imageHash: String = cachedArtworkHashFromUrl(url: url)
  if imageHash.length() is 0 {
    ret ""
  }
  ret "spotify-art:{imageHash}"
}

func cachedArtworkMetadataPath(imageHash: view String) pub ret String {
  ret "{appCacheArtworkMetaDir}/{imageHash}.json"
}

func cachedPlaylistPath(id: view String) pub ret String {
  let suffix: String = ".json"
  ret "{appCachePlaylistsDir}/{id}{suffix}"
}

func legacyPlaylistPath(id: view String) pub ret String {
  let suffix: String = ".json"
  ret "{legacyPlaylistsDir}/{id}{suffix}"
}
