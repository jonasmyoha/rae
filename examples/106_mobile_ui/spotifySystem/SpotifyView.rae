open sys/Spotify
open ui/Ecs
# Spotify-mode display layer for the mobile-UI music player example.
#
# Unless opted out (RAE_UI_NO_SPOTIFY=1), the poll worker
# (`SpotifyPoller.rae`, #950) refreshes the bridge cache every ~1s off
# the UI thread and the frame's `pollSpotify` mirrors each new snapshot
# (see `lib/sys/Spotify.rae` for the bridge); when the track changes:
#   * updates the NowPlaying scene's TrackTitle / TrackArtist text
#     directly on the world's Text components (no rebuild),
#   * downloads the album art (Spotify URL primary, iTunes fallback
#     when empty) to examples/106_mobile_ui/app_cache/album_art,
#   * loads it as a gpu2d image key under "spotify-current",
#   * swaps every Sprite whose textureKey equals the previous album
#     stem to "spotify-current" so the NowPlaying cover renders the
#     real track instead of the local placeholder.
#
# The Profile-grid, Album view, and Search remain backed by the local
# album catalogue — Spotify mode only repaints the NowPlaying screen
# and the mini-player.
import Json
import Sys
import Time
open ecs/Entity
open ecs/ComponentTable

# PlaybackState lives in this example's playback.rae — auto-imported
# from the same project directory. We mutate it here to sync the local
# mock's `isPlaying` from Spotify's reported state so the play-button
# icon (driven by PlaybackState revision invalidation) matches reality.

# Per-app-instance state for the Spotify display layer. One instance
# lives in main.rae for the whole app lifetime.
type SpotifyState {
  # Toggle read once at boot from RAE_UI_SPOTIFY. False → all the
  # update calls early-out so the local mock continues unchanged.
  enabled: Bool
  # The trackId from the previous poll. When this changes, the
  # display refresh path knows to re-fetch artwork. Empty when no
  # track is loaded yet.
  lastTrackId: String
  # Texture-registry key under which we publish the current artwork.
  # Owners (the NowPlaying cover Sprite) set their `textureKey` to
  # this so paint picks up the registered texture.
  artKey: String
  # #968: async now-playing-cover pipeline state. `coverAppliedPath` is the
  # app_cache file currently loaded under `artKey`, so a repeated poll for
  # the same track is a no-op; `coverPendingPath` is the file a background
  # fetch is targeting, checked every frame (independent of the ~1Hz Spotify
  # poll tick) until it resolves — empty when nothing is in flight.
  coverAppliedPath: String
  coverPendingPath: String
  # The live now-playing snapshot the bindings read (spotifyBindingSystem):
  # the current title / artist / album. `revision` bumps whenever one of them
  # changes, so the binding system runs only then; `builtRevision` is the last
  # one it wrote. The poll writes the snapshot; the binding system writes the
  # `TextBinding { key: "spotify.title" | "spotify.artist" | "spotify.album" }`
  # nodes from it — no more per-poll node patching.
  title: String
  artist: String
  album: String
  revision: Int
  builtRevision: Int
  # RAE_UI_SPOTIFY_FAKE="Title|Artist|Album" seeds the snapshot at boot (the
  # real osascript poll stays off), so a headless run proves the binding
  # writes the node text without a running Spotify. Empty in normal use.
  fake: String
}

func createSpotifyState() pub ret SpotifyState {
  # Spotify mode is ON by default on the assumption that this is what
  # the user actually wants from a music-player example on macOS. Opt
  # OUT with RAE_UI_NO_SPOTIFY=1 (snapshot tests, no-network builds,
  # systems without Spotify installed). Previously this was opt-IN via
  # RAE_UI_SPOTIFY=1, but launchers (SUMU, IDE wrappers) don't always
  # propagate ad-hoc env vars, so the feature silently no-op'd for
  # users who didn't run from a manually-prepared shell.
  let optOut: String = getEnv(name: "RAE_UI_NO_SPOTIFY")
  let fake: String = getEnv(name: "RAE_UI_SPOTIFY_FAKE")
  var enabled: Bool = optOut.length() is 0
  # A fake snapshot seeds the bindings and turns the real poll OFF, so it
  # never calls osascript in a headless run.
  var title: String = ""
  var artist: String = ""
  var album: String = ""
  var revision: Int = 0
  if fake.length() > 0 {
    enabled = false
    let parts: List(String) = fake.split(sep: "|")
    if let first: String = parts.copyAt(index: 0) {
      title = own first
    }
    if let second: String = parts.copyAt(index: 1) {
      artist = own second
    }
    if let third: String = parts.copyAt(index: 2) {
      album = own third
    }
    revision = 1
  }
  ret SpotifyState {
    enabled: enabled
    lastTrackId: ""
    artKey: "spotify-current"
    coverAppliedPath: ""
    coverPendingPath: ""
    title: own title
    artist: own artist
    album: own album
    revision: revision
    builtRevision: 0
    fake: own fake
  }
}

# Compute the History row's texture key for a Spotify entry and, when the
# artwork isn't cached yet, kick off (or reuse) a background download for
# it — NEVER blocks the caller (#968; this used to call the blocking
# `Spotify.fetchArtwork` directly, beach-balling once per track change).
#
# Key is `spotify-art:<image-hash>` where <image-hash> is the last
# path segment of the artwork URL (Spotify CDN URLs end with a
# 40-char content hash, distinct per cover). Distinct covers for the
# same Spotify trackId — e.g., the single vs the album version of
# the same song — therefore land under distinct keys, which lets the
# play-history dedup keep them as separate entries.
#
# The key is deterministic from the URL alone, so it is safe to record onto
# the `PlayHistoryEntry` before the pixels exist: the per-frame history-art
# loader (`loadCachedHistoryArtChunk`, #950) already scans every entry whose
# `textureKey` starts with `spotify-art:` and isn't loaded yet, starting
# (or picking up) exactly this same download via `artworkFetchStatus` on the
# same `outPath` — this function only needs to fire the metadata write once
# the file is known to exist and get out of the way.
func loadHistoryEntryArt(track: view SpotifyTrack, reg: view TextureRegistry) pub ret String {
  if track.artworkUrl.length() is 0 {
    ret ""
  }
  let imageHash: String = cachedArtworkHashFromUrl(url: track.artworkUrl)
  if imageHash.length() is 0 {
    ret ""
  }
  let key: String = "spotify-art:{imageHash}"
  if textureHas(reg: reg, key: key) is false {
    let outPath: String = cachedArtworkPath(imageHash: imageHash)
    if Sys.exists(path: outPath) is false {
      saveHistoryArtworkMetadata(track: track, imageHash: imageHash, path: outPath)
    }
  }
  ret key
}

func saveHistoryArtworkMetadata(
  track: view SpotifyTrack
  imageHash: view String
  path: view String
) {
  ensureAppCacheDirs()
  let metaPath: String = cachedArtworkMetadataPath(imageHash: imageHash)
  let q: String = "\""
  let colon: String = ":"
  let comma: String = ","
  let nl: String = "\n"
  let openBrace: String = "\{"
  let closeBrace: String = "\}"
  let tn: String = Json.escape(text: track.trackName)
  let an: String = Json.escape(text: track.artistName)
  let alb: String = Json.escape(text: track.albumName)
  let url: String = Json.escape(text: track.artworkUrl)
  let p: String = Json.escape(text: path)
  var content: String = ""
  content = content.concat(other: openBrace).concat(other: nl)
  content = content.concat(other: "  ").concat(other: q).concat(other: "imageHash").concat(other: q).concat(
    other: colon
  ).concat(other: " ").concat(other: q).concat(other: imageHash).concat(other: q).concat(
    other: comma
  ).concat(other: nl)
  content = content.concat(other: "  ").concat(other: q).concat(other: "trackName").concat(other: q).concat(
    other: colon
  ).concat(other: " ").concat(other: q).concat(other: tn).concat(other: q).concat(other: comma).concat(
    other: nl
  )
  content = content.concat(other: "  ").concat(other: q).concat(other: "artistName").concat(
    other: q
  ).concat(other: colon).concat(other: " ").concat(other: q).concat(other: an).concat(other: q).concat(
    other: comma
  ).concat(other: nl)
  content = content.concat(other: "  ").concat(other: q).concat(other: "albumName").concat(other: q).concat(
    other: colon
  ).concat(other: " ").concat(other: q).concat(other: alb).concat(other: q).concat(other: comma).concat(
    other: nl
  )
  content = content.concat(other: "  ").concat(other: q).concat(other: "artworkUrl").concat(
    other: q
  ).concat(other: colon).concat(other: " ").concat(other: q).concat(other: url).concat(other: q).concat(
    other: comma
  ).concat(other: nl)
  content = content.concat(other: "  ").concat(other: q).concat(other: "path").concat(other: q).concat(
    other: colon
  ).concat(other: " ").concat(other: q).concat(other: p).concat(other: q).concat(other: nl)
  content = content.concat(other: closeBrace).concat(other: nl)
  let ok: Bool = Sys.writeFile(path: metaPath, content: content)
  if ok is false {
    log("[spotify-art] metadata save failed: {metaPath}")
  }
}

# The deterministic app_cache path for the now-playing cover: hash-derived
# from the artwork URL when there is one (shared with `loadHistoryEntryArt`'s
# keying, so the two dedupe onto one download when they want the same file),
# else the fixed `spotify-current.jpg` the iTunes-only fallback path writes.
func spotifyCoverOutPath(track: view SpotifyTrack) ret String {
  if track.artworkUrl.length() > 0 {
    let h: String = cachedArtworkHashFromUrl(url: track.artworkUrl)
    if h.length() > 0 {
      ret cachedArtworkPath(imageHash: h)
    }
  }
  ret "{appCacheAlbumArtDir}/spotify-current.jpg"
}

# Load `state.coverPendingPath` under `state.artKey` and clear the pending
# marker — the shared "a fetch just landed" tail for both the exists-already
# fast path and the async-fetch-completed path below.
func applyNowPlayingCover(state: mod SpotifyState, reg: mod TextureRegistry) {
  let copiedKey: String = "{state.artKey}"
  let copiedPath: String = "{state.coverPendingPath}"
  let h: Int = textureLoad(reg: reg, key: copiedKey, path: copiedPath)
  if h > 0 {
    state.coverAppliedPath = "{state.coverPendingPath}"
  }
  state.coverPendingPath = ""
}

# Track-change entry point (#968): kicks off — or reuses — a background
# download for the new track's cover. NEVER blocks: `Spotify.fetchArtwork`
# and the iTunes Search fallback both run on a spawned worker
# (`artworkFetchStartWithFallback`, #950); this only decides WHAT to fetch
# and records the target so `syncNowPlayingCoverFinish` can pick up the
# result on a later frame. A no-op when the wanted file is already applied
# or already the in-flight target.
func syncNowPlayingCoverStart(
  state: mod SpotifyState
  track: view SpotifyTrack
  reg: mod TextureRegistry
  fetches: mod ArtworkFetchQueue
) {
  ensureAppCacheDirs()
  let wantPath: String = spotifyCoverOutPath(track: track)
  if wantPath is state.coverAppliedPath {
    ret
  }
  if wantPath is state.coverPendingPath {
    ret
  }
  state.coverPendingPath = "{wantPath}"
  if Sys.exists(path: wantPath) {
    applyNowPlayingCover(state: state, reg: reg)
    ret
  }
  let term: String = "{track.artistName} {track.trackName}"
  let started: Bool = artworkFetchStartWithFallback(
    queue: fetches
    url: track.artworkUrl
    term: term
    outPath: wantPath
  )
  if started is false {
    # In-flight cap reached — try again on the next track-change tick.
    state.coverPendingPath = ""
  }
}

# Per-frame entry point (#968): independent of the Spotify poll tick, so the
# cover appears within a frame of the download landing (the worker's
# `wake()` already repaints; this is what notices and applies it). Cheap
# early-return when nothing is pending. Checks disk existence before the
# fetch-queue status, matching `loadCachedHistoryArtChunk`'s pattern — the
# file is written before the worker's channel post, so this is never wrong,
# and it means a status record another consumer already drained (the two
# queues share dedup keys by outPath) doesn't strand this caller.
func syncNowPlayingCoverFinish(
  state: mod SpotifyState
  reg: mod TextureRegistry
  fetches: mod ArtworkFetchQueue
) {
  if state.coverPendingPath.length() is 0 {
    ret
  }
  let path: String = "{state.coverPendingPath}"
  if Sys.exists(path: path) {
    applyNowPlayingCover(state: state, reg: reg)
    ret
  }
  let status: Int = artworkFetchStatus(queue: fetches, outPath: path)
  if status is artworkStatusFetched {
    applyNowPlayingCover(state: state, reg: reg)
  } else if status is artworkStatusFailed {
    state.coverPendingPath = ""
  }
  # else pending: nothing to do, check again next frame.
}

# Per-frame entry point. Cheap when disabled / when not enough time
# has passed for a re-poll. When it does poll:
#   * mirrors Spotify's actual play/pause state into `playback.isPlaying`
#     so PlaybackState revision invalidation keeps play buttons in sync,
#   * publishes the live title / artist / album onto SpotifyState (bumping
#     `revision`), which `spotifyBindingSystem` writes onto the `TextBinding`
#     nodes — the poll no longer patches Text nodes itself,
#   * on track change: downloads art and points the nowPlaying cover at
#     the spotify-current texture key (the covers observe + re-point, #268).
func pollSpotify(
  state: mod SpotifyState
  reg: mod TextureRegistry
  playback: mod PlaybackState
  appState: mod AppState
  now: view Timestamp
  ticked: view Bool
) pub {
  if state.enabled is false {
    ret
  }
  # #968: pick up a completed cover download every frame, independent of the
  # Spotify poll tick below — a background fetch can land between polls, and
  # this is what makes it appear within a frame instead of waiting up to 1s
  # for the next tick.
  syncNowPlayingCoverFinish(state: state, reg: reg, fetches: appState.artworkFetch)
  # `ticked` is the poll worker's "the cache has a new snapshot" cue (#950);
  # between ticks there is nothing new to mirror.
  if ticked is false {
    ret
  }
  let track: SpotifyTrack = Spotify.current()
  let pos: Float = Spotify.position()
  let dur: Float = Spotify.duration()
  # Mirror Spotify's actual state into the local playback mock so play-button
  # revision invalidation and the progress/readout state
  # match the real player. Includes "user paused in Spotify directly"
  # and "user skipped tracks in Spotify" — both flip within 1Hz here.
  let playingKey: String = "playing"
  let nowPlaying: Bool = track.state is playingKey
  setPlaybackPlaying(state: playback, value: nowPlaying)
  playback.elapsedSec = pos
  if dur > 0.0 {
    playback.durationSec = dur
  }
  # Publish the live snapshot the bindings read, bumping `revision` only when
  # a field changed so `spotifyBindingSystem` (and it alone) rewrites the
  # bound Text nodes. The M:SS time labels are `PlaybackTime` bindings on the
  # mirrored playback position / duration above — nothing to write here.
  updateSpotifySnapshot(
    state: state
    title: track.trackName
    artist: track.artistName
    album: track.albumName
  )
  # Track-change → re-fetch artwork. Compare trackId, not artworkUrl
  # (Spotify sometimes reports a slightly different art URL between
  # polls for the same track during playback).
  let changed: Bool = track.trackId is state.lastTrackId is false
  if changed {
    state.lastTrackId = "{track.trackId}"
    syncNowPlayingCoverStart(
      state: state
      track: track
      reg: reg
      fetches: appState.artworkFetch
    )
    # Append to play history. Skip empty / stopped frames where
    # trackName is blank; the local-stem match lets the history
    # row reuse local cover textures when the user happens to be
    # playing something from the catalog through Spotify directly.
    if track.trackName.length() > 0 {
      let stem: String = historyMatchLocalStem(
        albums: appState.mediaLibrary.albums
        trackName: track.trackName
        artistName: track.artistName
      )
      # Always key the thumb on the artwork URL (not the local
      # stem) for Spotify-recorded entries. Spotify plays the same
      # song from different albums with different cover URLs — if
      # we shortcut to the local stem, both plays collapse to the
      # same textureKey and the history dedup drops one of them.
      # Falls back to the local stem only when Spotify provides no
      # artwork URL (rare; podcasts, local files).
      var texKey: String = loadHistoryEntryArt(track: track, reg: reg)
      if texKey.length() is 0 {
        if stem.length() > 0 {
          texKey = "{stem}"
        }
      }
      let entry: PlayHistoryEntry = {
        trackName: "{track.trackName}"
        artistName: "{track.artistName}"
        albumName: "{track.albumName}"
        albumStem: own stem
        artworkUrl: "{track.artworkUrl}"
        textureKey: own texKey
        durationSec: dur
        # PlayHistoryEntry stays on Float64: it is serialised to JSON, and
        # migrating it belongs with the rest of the fields (#413).
        playedAt: now.epochSeconds()
      }
      recordPlay(history: appState.playHistory, entry: own entry)
      saveHistoryToJson(history: appState.playHistory, path: historyFilePath)
    }
  }
  # Point the nowPlaying cover at the Spotify art key (#268). The key is
  # constant ("spotify-current") and `refreshSpotifyArt` swaps the texture
  # under it per track, so this bumps the instance revision only on the
  # first Spotify track; the Hero + mini-player covers observe it and
  # re-point once, then track the texture swap. This replaces the old
  # per-frame `rebindAlbumCoversToSpotify` walk that matched a stale
  # browsed stem and so never followed a Spotify track change (§1).
  setNowPlayingArt(state: playback, artKey: state.artKey)
}

# Write the live now-playing snapshot, bumping `revision` only when a field
# actually changed — so `spotifyBindingSystem` runs only on a real change.
func updateSpotifySnapshot(
  state: mod SpotifyState
  title: view String
  artist: view String
  album: view String
) {
  if state.title is title and state.artist is artist and state.album is album {
    ret
  }
  state.title = "{title}"
  state.artist = "{artist}"
  state.album = "{album}"
  state.revision = state.revision + 1
}

# The now-playing text as DATA: every node with a `TextBinding` whose key is a
# `spotify.*` source gets the matching field of the live snapshot written to
# its `Text.text`. Runs only when `SpotifyState.revision` moved past the last
# one it wrote (`builtRevision`) — the poll bumps the revision, this reacts.
# Local mode leaves the revision at 0, so this never fights `trackTextSystem`.
func spotifyBindingSystem(world: mod UiWorld, state: mod SpotifyState) pub {
  if state.revision is state.builtRevision {
    ret
  }
  let n: Int = componentCount(this: world.textBindings)
  var i: Int = 0
  loop i < n {
    let entity: EntityId = componentEntityAt(this: world.textBindings, i: i)
    let binding: TextBinding = componentDataAt(this: world.textBindings, i: i)
    if binding.key is "spotify.title" {
      writeTrackText(world: world, entity: entity, value: state.title)
    }
    if binding.key is "spotify.artist" {
      writeTrackText(world: world, entity: entity, value: state.artist)
    }
    if binding.key is "spotify.album" {
      writeTrackText(world: world, entity: entity, value: state.album)
    }
    i = i + 1
  }
  state.builtRevision = state.revision
  if state.fake.length() > 0 {
    log("[spotify-bind] title={state.title} artist={state.artist} album={state.album}")
  }
}
