open Channel
open sys/Spotify
open ui/EventLoop

# The Spotify poll worker (#950, docs/parallelism-first-plan.md §5).
#
# `Spotify.poll()` forks `osascript` (~tens of ms), so it must not run on
# the UI thread. One `spawn`'d worker loops "poll, send the answer, wake the
# event loop, sleep", and the frame's `pollSpotify` runs only when an answer
# arrived — the idle loop reacts to the poll the moment it lands instead of on
# its next timeout. The answer itself travels on the channel: there is no
# shared cache (docs/runtime-c-audit.md row 9).
#
# Two channels, both owned by the app: `tracks` (worker -> app, each poll's
# SpotifyTrack) and `stop` (app -> worker, any value). Rae has no `detach` yet, so
# the worker is a Task the app joins at teardown (`stopSpotifyPoller`).
const spotifyPollIntervalMs: Int = 1000

# The worker sleeps in slices so a stop request is honoured promptly.
const spotifyPollSliceMs: Int = 50

type SpotifyPoller {
  stop: Channel(Int)
  tracks: Channel(SpotifyTrack)
  task: Task(Int)
}

# The worker body. Runs on its own OS thread; `intervalMs <= 0` means Spotify
# mode is off and the worker returns at once (a joinable no-op, so the app
# holds one Task either way). Returns the number of polls it ran.
func spotifyPollWorker(
  intervalMs: copy Int
  stop: own Channel(Int)
  tracks: own Channel(SpotifyTrack)
) ret Int {
  var polls: Int = 0
  var running: Bool = intervalMs > 0
  loop running {
    channelSend(this: tracks, value: Spotify.poll())
    polls = polls + 1
    wake()
    var slept: Int = 0
    loop slept < intervalMs and running {
      sleep(ms: spotifyPollSliceMs)
      slept = slept + spotifyPollSliceMs
      if pending(this: stop) > 0 {
        running = false
      }
    }
  }
  ret polls
}

func startSpotifyPoller(enabled: view Bool) ret SpotifyPoller {
  let stop: Channel(Int) = createChannel(Int)
  let tracks: Channel(SpotifyTrack) = createChannel(SpotifyTrack)
  var intervalMs: Int = 0
  if enabled {
    intervalMs = spotifyPollIntervalMs
  }
  ret SpotifyPoller {
    stop: stop
    tracks: tracks
    task: spawn spotifyPollWorker(intervalMs: intervalMs, stop: stop, tracks: tracks)
  }
}

# Drain the answer channel into `latest`, keeping the newest. True when at
# least one poll completed since the last call — the frame's cue to mirror it.
func spotifyPollerTake(poller: view SpotifyPoller, latest: mod SpotifyTrack) ret Bool {
  var ticked: Bool = false
  loop pending(this: poller.tracks) > 0 {
    latest = receive(this: poller.tracks)
    ticked = true
  }
  ret ticked
}

# Teardown: ask the worker to stop, join it, release the channels.
func stopSpotifyPoller(poller: mod SpotifyPoller) {
  channelSend(this: poller.stop, value: 1)
  let polls: Int = poller.task.get()
  freeChannel(this: poller.stop)
  freeChannel(this: poller.tracks)
}
