open ui/Ecs
open ui/Layer
import Sdl3
open Keys
# Pointer input for the GPU2D/SDL3-only mobile UI example.
#
# Coordinates are in logical points, matching `WorldTransform2D`.
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open ui/Transform
open ui/UiSystems
open ui/InputKind
open ui/SizeClass
import Device

let inputNoEntityId: EntityId = { index: -1, generation: 0 }

type PointerState {
  x: Float
  y: Float
  down: Bool
  pressed: Bool
  released: Bool
  # The device behind it: a finger gets the touch-sized target and no hover
  kind: InputKind
}

# Action events use lib/ui's shared `UiAction` (#943) drained through the
# lib/ecs `EventQueue` primitive — 106 no longer defines its own ActionEvent.
type InputSystem {
  pointer: PointerState
  pressedEntityId: EntityId
  uiActions: EventQueue(UiAction)
  # `RAE_UI_SCREEN_SEQ` scripted taps (#972): the remaining screen names,
  # the frame counter, and the frames between two scripted taps.
  scriptedScreens: List(String)
  scriptedFrame: Int
  scriptedEvery: Int
  # #976: this frame's keyboard text — the UTF-8 characters typed since the
  # last poll and the number of Backspace presses. Consumed by the search
  # field system; empty/0 on frames with no typing.
  typedText: String
  backspaces: Int
  # `RAE_UI_TYPE` scripted keyboard (#976): the text still to be "typed"
  # (pasted as one frame's typedText once the screen sequence is done).
  scriptedType: String
  # The kind of the last pointer event (a screen can switch density on it)
  lastInputKind: InputKind
  # A finger's smallest target side in design units (44 points, converted
  # through the viewport each frame)
  touchTargetSize: Float
  # Device facts (canHover, the display scale), kept current every frame
  deviceWatch: DeviceWatch
  # The window's size class in points, recomputed when the window changes
  windowSizeClass: WindowSizeClass
}

func createInputSystem() ret InputSystem {
  ret InputSystem {
    pointer: PointerState {
      x: 0.0
      y: 0.0
      down: false
      pressed: false
      released: false
      kind: InputKind.mouse
    }
    pressedEntityId: noEntity()
    uiActions: createEventQueue(UiAction)
    scriptedScreens: scriptedScreenSequence()
    scriptedFrame: 0
    scriptedEvery: 20
    typedText: ""
    backspaces: 0
    scriptedType: getEnv(name: "RAE_UI_TYPE")
    lastInputKind: InputKind.mouse
    touchTargetSize: touchTargetPoints
    deviceWatch: Device.createDeviceWatch()
    windowSizeClass: createWindowSizeClass(widthPoints: windowWidthPoints())
  }
}

# `RAE_UI_SCREEN_SEQ="library,home,search"` (#972): a headless way to press
# the menubar buttons. Every `scriptedEvery` frames the next name is sent as
# the same `nav.<name>` UiAction a real tab tap produces, so a scripted run
# exercises the real screen-switch path (nav-bar re-mount, dock re-attach,
# safe-area re-seed) and a `RAE_GPU2D_SCREENSHOT` at exit shows the result.
func scriptedScreenSequence() ret List(String) {
  let seqEnv: String = getEnv(name: "RAE_UI_SCREEN_SEQ")
  if seqEnv.length() is 0 {
    ret List.create(String, cap: 0)
  }
  ret seqEnv.split(sep: ",")
}

func sendScriptedTap(input: mod InputSystem) {
  if input.scriptedScreens.length is 0 {
    ret
  }
  input.scriptedFrame = input.scriptedFrame + 1
  if input.scriptedFrame % input.scriptedEvery is not 0 {
    ret
  }
  var name: String = ""
  if let head: String = input.scriptedScreens.copyAt(index: 0) {
    name = own head
  }
  input.scriptedScreens.removeAt(index: 0)
  # A bare screen name is a menubar tap (`nav.<name>`); a dotted name is sent
  # as that actionId verbatim, so a script can also drive entity-less
  # actions such as `library.remove` (#975).
  var actionId: String = "nav.{name}"
  if name.contains(sub: ".") {
    actionId = "{name}"
  }
  log("[screen-seq] tap {actionId}")
  eventSend(this: input.uiActions, value: UiAction { entityId: noEntity(), actionId: actionId })
}

func pointInEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
  targetSize: view Float
) ret Bool {
  if componentHas(this: uiSystems.transform2d.worldTransforms, entityId: entityId) is false {
    ret false
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) is false {
    ret false
  }
  let wt: view WorldTransform2D => componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  )
  if worldVisualOf(world: world, uiSystems: uiSystems, entityId: entityId).visible is false {
    ret false
  }
  let cr: view ComputedRect => componentView(
    this: uiSystems.layout.computedRects
    entityId: entityId
  )
  ret pointInTarget(
    x: x
    y: y
    left: wt.position.x
    top: wt.position.y
    width: cr.size.x
    height: cr.size.y
    targetSize: targetSize
  )
}

func hitTestEntity(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  x: view Float
  y: view Float
  targetSize: view Float
) ret EntityId {
  unsafe {
    if componentHas(this: world.childrens, entityId: entityId) {
      let ch: view Children => componentView(this: world.childrens, entityId: entityId)
      let n: Int = ch.ids.length
      var i: Int = n - 1
      loop i >= 0 {
        let cid: EntityId = rae_ext_rae_buf_get(buf: ch.ids.data, index: i)
        let hit: EntityId = hitTestEntity(
          world: world
          uiSystems: uiSystems
          entityId: cid
          x: x
          y: y
          targetSize: targetSize
        )
        if isNone(this: hit) is false {
          ret hit
        }
        i = i - 1
      }
    }

    if componentHas(this: world.onClicks, entityId: entityId) {
      if pointInEntity(
        world: world
        uiSystems: uiSystems
        entityId: entityId
        x: x
        y: y
        targetSize: targetSize
      ) {
        ret entityId
      }
    }
    ret inputNoEntityId
  }
}

func hitTest(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
) ret EntityId {
  ret hitTestTarget(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
    targetSize: 0.0
  )
}

# The entity a pointer of `kind` hits: the precise rectangle first, so a
# finger between two small controls takes the one it is on; then, for a
# finger only, the touch-sized targets
func hitTestFor(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
  kind: view InputKind
  touchTargetSize: view Float
) ret EntityId {
  let precise: EntityId = hitTest(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
  )
  if isNone(this: precise) is false or kind is not InputKind.touch {
    ret precise
  }
  ret hitTestTarget(
    world: world
    uiSystems: uiSystems
    x: x
    y: y
    targetSize: targetSizeFor(kind: kind, touchTargetUnits: touchTargetSize)
  )
}

func hitTestTarget(
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
  targetSize: view Float
) ret EntityId {
  unsafe {
    let roots: List(EntityId) = collectPaintableRoots(world: world, uiSystems: uiSystems)
    let n: Int = roots.length
    var i: Int = n - 1
    loop i >= 0 {
      let e: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: i)
      if componentHas(this: world.layerRoots, entityId: e) is false {
        let hit: EntityId = hitTestEntity(
          world: world
          uiSystems: uiSystems
          entityId: e
          x: x
          y: y
          targetSize: targetSize
        )
        if isNone(this: hit) is false {
          ret hit
        }
      }
      i = i - 1
    }
    ret inputNoEntityId
  }
}

func updateInputSystem(
  input: mod InputSystem
  world: view UiWorld
  uiSystems: view UiSystems
  viewport: view Viewport
) {
  # Recycle last frame's action channel (double-buffered), replacing the old
  # clearActionEvents: this frame's clicks produce into a clean queue.
  frameAdvance(this: input.uiActions)
  sendScriptedTap(input: input)
  input.typedText = uiTextInput()
  input.backspaces = 0
  if Sdl3.isKeyPressed(key: keyBackspace) {
    input.backspaces = 1
  }
  # Scripted keyboard: paste `RAE_UI_TYPE` on the frame after the last
  # scripted tap has fired, so a headless run can drive a text field.
  if input.scriptedType.length() > 0 and input.scriptedScreens.length is 0 {
    input.scriptedFrame = input.scriptedFrame + 1
    if input.scriptedFrame % input.scriptedEvery is 0 {
      log("[screen-seq] type \"{input.scriptedType}\"")
      input.typedText = "{input.scriptedType}"
      input.scriptedType = ""
    }
  }

  let mx: Float = viewportPointerX(viewport: viewport)
  let my: Float = viewportPointerY(viewport: viewport)
  let down: Bool = uiPointerButtonDown(button: mouseButtonLeft)
  var pressed: Bool = false
  var released: Bool = false
  if uiMouseHookActive() {
    pressed = uiMouseHookDrainPressed()
    released = uiMouseHookDrainReleased()
  } else {
    pressed = uiPointerButtonPressed(button: mouseButtonLeft)
    released = uiPointerButtonReleased(button: mouseButtonLeft)
  }

  let kind: InputKind = lastPointerKind()
  let nextPointer: PointerState = {
    x: mx
    y: my
    down: down
    pressed: pressed
    released: released
    kind: kind
  }
  input.pointer = nextPointer
  input.lastInputKind = kind
  Device.deviceChanged(watch: input.deviceWatch)
  input.touchTargetSize = touchTargetUnits(
    viewport: viewport
    displayScale: input.deviceWatch.facts.displayScale
  )

  if pressed {
    input.pressedEntityId = hitTestFor(
      world: world
      uiSystems: uiSystems
      x: mx
      y: my
      kind: kind
      touchTargetSize: input.touchTargetSize
    )
    log("[input] press at ({mx},{my}) -> pressedEntity={input.pressedEntityId.index}")
  }

  if released {
    var hit: EntityId = hitTestFor(
      world: world
      uiSystems: uiSystems
      x: mx
      y: my
      kind: kind
      touchTargetSize: input.touchTargetSize
    )
    log("[input] release at ({mx},{my}) -> hit={hit.index} pressed={input.pressedEntityId.index}")
    if isNone(this: hit) is false {
      if hit is input.pressedEntityId {
        if componentHas(this: world.onClicks, entityId: hit) {
          let oc: view OnClick => componentView(this: world.onClicks, entityId: hit)
          log("[input] fire {oc.actionId} on entity {hit.index}")
          eventSend(this: input.uiActions, value: UiAction { entityId: hit, actionId: oc.actionId })
        } else {
          log("[input] release matched press but entity has no OnClick")
        }
      } else {
        log("[input] release hit {hit.index} != pressed {input.pressedEntityId.index} - drop")
      }
    } else {
      log("[input] release hit nothing - drop")
    }
    input.pressedEntityId = inputNoEntityId
  }
}

# 44 points in design units: a point is `displayScale` pixels, a design unit
# `viewport.renderScale` pixels
func touchTargetUnits(viewport: view Viewport, displayScale: view Float) ret Float {
  if viewport.renderScale > 0.0 {
    ret touchTargetPoints * displayScale / viewport.renderScale
  }
  ret touchTargetPoints
}

# Recompute the window's size class (points); true when it changed
func updateInputSizeClass(input: mod InputSystem) ret Bool {
  ret updateWindowSizeClass(
    windowSizeClass: input.windowSizeClass
    widthPoints: windowWidthPoints()
  )
}
