# Pointer input for the GPU2D/SDL3-only mobile UI example: lib/ui's
# `UiInput` (the pointer, hover, press, the wheel's routing, a scroll root's
# drag claiming its press) plus what 106 adds on top: the scripted taps,
# typing and drag of a headless run, this frame's keyboard text and the
# window's size class.
#
# Coordinates are in logical points, matching `WorldTransform2D`.
open ui/Ecs
import Sdl3
open Keys
open ecs/Entity
open ecs/Event
open ui/UiSystems
open ui/InputKind
open ui/SizeClass
open ui/inputSystem/InputSystem

# A headless run's scripted finger (`RAE_UI_DRAG=<dy>`): it presses
# mid-screen on frame `scriptStartFrame`, moves `dy` over
# `scriptMoveFrames` frames and lifts, through the lib's input path
# (updateUiInputWith), so the gate drives drag -> fling -> settle without a
# real pointer. `dy` 0 = off.
type ScriptedDrag {
  dy: Float
  frame: Int
  # the release and the rest were logged
  releaseReported: Bool
  settleReported: Bool
}

const scriptStartFrame: Int = 10

const scriptMoveFrames: Int = 20

# Action events are lib/ui's `UiAction`s: the lib's input produces them
# into `world.uiActions`, and each frame they are moved into this queue,
# which 106's dispatch reads, together with its scripted taps.
type InputSystem {
  ui: UiInput
  uiActions: EventQueue(UiAction)
  # `RAE_UI_SCREEN_SEQ` scripted taps (#972): the remaining screen names,
  # the frame counter, and the frames between two scripted taps.
  scriptedScreens: List(String)
  scriptedFrame: Int
  scriptedEvery: Int
  # #976: this frame's keyboard text — the UTF-8 characters typed since the
  # last poll and the number of Backspace presses. Consumed by the text
  # field system; empty/0 on frames with no typing.
  typedText: String
  backspaces: Int
  # `RAE_UI_TYPE` scripted keyboard (#976): the text still to be "typed"
  # (pasted as one frame's typedText once the screen sequence is done).
  scriptedType: String
  scriptedDrag: ScriptedDrag
  # The window's size class in points, recomputed when the window changes
  windowSizeClass: WindowSizeClass
}

func createInputSystem() ret InputSystem {
  var dragDy: Float = 0.0
  let dragEnv: String = getEnv(name: "RAE_UI_DRAG")
  if dragEnv.length() > 0 {
    dragDy = dragEnv.toFloat()
  }
  ret InputSystem {
    ui: createUiInput()
    uiActions: createEventQueue(UiAction)
    scriptedScreens: scriptedScreenSequence()
    scriptedFrame: 0
    scriptedEvery: 20
    typedText: ""
    backspaces: 0
    scriptedType: getEnv(name: "RAE_UI_TYPE")
    scriptedDrag: ScriptedDrag {
      dy: dragDy
      frame: 0
      releaseReported: false
      settleReported: false
    }
    windowSizeClass: createWindowSizeClass(widthPoints: windowWidthPoints())
  }
}

# `RAE_UI_SCREEN_SEQ="library,home,search"` (#972): a headless way to press
# the menubar buttons. Every `scriptedEvery` frames the next name is sent as
# the same `nav.<name>` UiAction a real tab tap produces, so a scripted run
# exercises the real screen-switch path (nav-bar re-mount, dock re-attach,
# safe-area re-seed) and a `RAE_GPU2D_SCREENSHOT` at exit shows the result.
func scriptedScreenSequence() ret List(String) {
  let seqEnv: String = getEnv(name: "RAE_UI_SCREEN_SEQ")
  if seqEnv.length() is 0 {
    ret List.create(String, cap: 0)
  }
  ret seqEnv.split(sep: ",")
}

func sendScriptedTap(input: mod InputSystem) {
  if input.scriptedScreens.length is 0 {
    ret
  }
  input.scriptedFrame = input.scriptedFrame + 1
  if input.scriptedFrame % input.scriptedEvery is not 0 {
    ret
  }
  var name: String = ""
  if let head: String = input.scriptedScreens.copyAt(index: 0) {
    name = own head
  }
  input.scriptedScreens.removeAt(index: 0)
  # A bare screen name is a menubar tap (`nav.<name>`); a dotted name is sent
  # as that actionId verbatim, so a script can also drive entity-less
  # actions such as `library.remove` (#975).
  var actionId: String = "nav.{name}"
  if name.contains(sub: ".") {
    actionId = "{name}"
  }
  log("[screen-seq] tap {actionId}")
  eventSend(this: input.uiActions, value: UiAction { entityId: noEntity(), actionId: actionId })
}

# Whether the scripted finger is in use this run
func scriptedDragOn(input: view InputSystem) ret Bool {
  ret input.scriptedDrag.dy is not 0.0
}

# The scripted finger this frame (after `previous`): mid-screen, moving
# `dy` over `scriptMoveFrames` frames from `scriptStartFrame`, then lifted
func scriptedDragPointer(
  drag: mod ScriptedDrag
  viewport: view Viewport
  previous: view UiPointerState
) ret UiPointerState {
  drag.frame = drag.frame + 1
  let x: Float = viewport.layoutW * 0.5
  let startY: Float = viewport.layoutH * 0.5
  let moved: Int = drag.frame - scriptStartFrame
  var y: Float = startY
  var down: Bool = false
  if moved >= 0 and moved <= scriptMoveFrames {
    y = startY + drag.dy * moved.toFloat() / scriptMoveFrames.toFloat()
    down = true
  } else if moved > scriptMoveFrames {
    y = startY + drag.dy
  }
  ret uiPointerScriptFrame(
    previous: previous
    x: x
    y: y
    down: down
    kind: InputKind.touch
  )
}

# The scripted drag's log lines, for the gate: the lift (position and the
# fling's velocity), then the first frame at rest (in bounds, no velocity)
func reportScriptedDrag(
  input: mod InputSystem
  scrollY: view Float
  velocity: view Float
  floor: view Float
) {
  if scriptedDragOn(input: input) is false {
    ret
  }
  let drag: mod ScriptedDrag = input.scriptedDrag
  let lifted: Int = drag.frame - scriptStartFrame - scriptMoveFrames
  if lifted >= 1 and drag.releaseReported is false {
    drag.releaseReported = true
    log("[scroll-drag] released scrollY={scrollY} velocity={velocity} floor={floor}")
  }
  let inBounds: Bool = scrollY <= 0.0 and scrollY >= floor
  if lifted > 1 and drag.settleReported is false and inBounds and velocity is 0.0 {
    drag.settleReported = true
    log("[scroll-drag] settled scrollY={scrollY} floor={floor}")
  }
}

func updateInputSystem(
  input: mod InputSystem
  world: mod UiWorld
  uiSystems: mod UiSystems
  viewport: view Viewport
) {
  # Recycle last frame's action channel (double-buffered): this frame's
  # clicks produce into a clean queue.
  frameAdvance(this: input.uiActions)
  # A finger's target is 44 points in design units, through the viewport
  input.ui.touchTargetSize = touchTargetUnits(
    viewport: viewport
    displayScale: input.ui.deviceWatch.facts.displayScale
  )
  if scriptedDragOn(input: input) {
    let pointer: UiPointerState = scriptedDragPointer(
      drag: input.scriptedDrag
      viewport: viewport
      previous: input.ui.pointer
    )
    updateUiInputWith(
      input: input.ui
      world: world
      uiSystems: uiSystems
      pointer: pointer
      wheel: 0.0
    )
  } else {
    updateUiInput(input: input.ui, world: world, uiSystems: uiSystems)
  }
  # the lib's clicks (a scroll root's drag has already claimed its press,
  # so a drag's release is not among them) join 106's queue
  loop var i: Int = 0, i < eventCount(this: world.uiActions), ++i {
    let action: UiAction = eventAt(this: world.uiActions, i: i)
    if isNone(this: action.entityId) is false {
      log("[input] fire {action.actionId} on entity {action.entityId.index}")
    }
    eventSend(this: input.uiActions, value: action)
  }
  sendScriptedTap(input: input)
  input.typedText = uiTextInput()
  input.backspaces = 0
  if Sdl3.isKeyPressed(key: keyBackspace) {
    input.backspaces = 1
  }
  # Scripted keyboard: paste `RAE_UI_TYPE` on the frame after the last
  # scripted tap has fired, so a headless run can drive a text field.
  if input.scriptedType.length() > 0 and input.scriptedScreens.length is 0 {
    input.scriptedFrame = input.scriptedFrame + 1
    if input.scriptedFrame % input.scriptedEvery is 0 {
      log("[screen-seq] type \"{input.scriptedType}\"")
      input.typedText = "{input.scriptedType}"
      input.scriptedType = ""
    }
  }
}

# 44 points in design units: a point is `displayScale` pixels, a design unit
# `viewport.renderScale` pixels
func touchTargetUnits(viewport: view Viewport, displayScale: view Float) ret Float {
  if viewport.renderScale > 0.0 {
    ret touchTargetPoints * displayScale / viewport.renderScale
  }
  ret touchTargetPoints
}

# Recompute the window's size class (points); true when it changed
func updateInputSizeClass(input: mod InputSystem) ret Bool {
  ret updateWindowSizeClass(
    windowSizeClass: input.windowSizeClass
    widthPoints: windowWidthPoints()
  )
}
