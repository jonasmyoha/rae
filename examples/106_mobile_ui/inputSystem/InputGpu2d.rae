open ui/Ecs
open ui/Layer
import Sdl3
open Keys
# Pointer input for the GPU2D/SDL3-only mobile UI example.
#
# Coordinates are in logical points, matching `WorldTransform2D`.
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open ui/Transform

let inputNoEntity: EntityId = { index: 0 - 1, generation: 0 }

type PointerState {
  x: Float
  y: Float
  down: Bool
  pressed: Bool
  released: Bool
}

# Action events use lib/ui's shared `UiAction` (#943) drained through the
# lib/ecs `EventQueue` primitive — 106 no longer defines its own ActionEvent.
type InputSystem {
  pointer: PointerState
  pressedEntity: EntityId
  uiActions: EventQueue(UiAction)
  # `RAE_UI_SCREEN_SEQ` scripted taps (#972): the remaining screen names,
  # the frame counter, and the frames between two scripted taps.
  scriptedScreens: List(String)
  scriptedFrame: Int
  scriptedEvery: Int
  # #976: this frame's keyboard text — the UTF-8 characters typed since the
  # last poll and the number of Backspace presses. Consumed by the search
  # field system; empty/0 on frames with no typing.
  typedText: String
  backspaces: Int
  # `RAE_UI_TYPE` scripted keyboard (#976): the text still to be "typed"
  # (pasted as one frame's typedText once the screen sequence is done).
  scriptedType: String
}

func createInputSystem() ret InputSystem {
  ret InputSystem {
    pointer: PointerState {
      x: 0.0
      y: 0.0
      down: false
      pressed: false
      released: false
    }
    pressedEntity: noEntity()
    uiActions: createEventQueue(UiAction)
    scriptedScreens: scriptedScreenSequence()
    scriptedFrame: 0
    scriptedEvery: 20
    typedText: ""
    backspaces: 0
    scriptedType: getEnv(name: "RAE_UI_TYPE")
  }
}

# `RAE_UI_SCREEN_SEQ="library,home,search"` (#972): a headless way to press
# the menubar buttons. Every `scriptedEvery` frames the next name is sent as
# the same `nav.<name>` UiAction a real tab tap produces, so a scripted run
# exercises the real screen-switch path (nav-bar re-mount, dock re-attach,
# safe-area re-seed) and a `RAE_GPU2D_SCREENSHOT` at exit shows the result.
func scriptedScreenSequence() ret List(String) {
  let seqEnv: String = getEnv(name: "RAE_UI_SCREEN_SEQ")
  if seqEnv.length() is 0 {
    ret List.create(String, cap: 0)
  }
  ret seqEnv.split(sep: ",")
}

func sendScriptedTap(input: mod InputSystem) {
  if input.scriptedScreens.length is 0 {
    ret
  }
  input.scriptedFrame = input.scriptedFrame + 1
  if input.scriptedFrame % input.scriptedEvery is not 0 {
    ret
  }
  var name: String = ""
  if let head: String = input.scriptedScreens.copyAt(index: 0) {
    name = own head
  }
  input.scriptedScreens.removeAt(index: 0)
  # A bare screen name is a menubar tap (`nav.<name>`); a dotted name is sent
  # as that actionId verbatim, so a script can also drive entity-less
  # actions such as `library.remove` (#975).
  var actionId: String = "nav.{name}"
  if name.contains(sub: ".") {
    actionId = "{name}"
  }
  log("[screen-seq] tap {actionId}")
  eventSend(this: input.uiActions, value: UiAction { entity: noEntity(), actionId: actionId })
}

func pointInEntity(
  world: view UiWorld
  entity: view EntityId
  x: view Float
  y: view Float
) ret Bool {
  if componentHas(this: world.worldTransforms, entity: entity) is false {
    ret false
  }
  if componentHas(this: world.computedRects, entity: entity) is false {
    ret false
  }
  let wt: WorldTransform2D = componentGet(this: world.worldTransforms, entity: entity)
  if worldVisualOf(world: world, entity: entity).visible is false {
    ret false
  }
  let cr: ComputedRect = componentGet(this: world.computedRects, entity: entity)
  if x < wt.position.x {
    ret false
  }
  if y < wt.position.y {
    ret false
  }
  if x > wt.position.x + cr.size.x {
    ret false
  }
  if y > wt.position.y + cr.size.y {
    ret false
  }
  ret true
}

func hitTestEntity(
  world: view UiWorld
  entity: view EntityId
  x: view Float
  y: view Float
) ret EntityId {
  unsafe {
    if componentHas(this: world.childrens, entity: entity) {
      let ch: view Children => componentView(this: world.childrens, entity: entity)
      let n: Int = ch.ids.length
      var i: Int = n - 1
      loop i >= 0 {
        let cid: EntityId = rae_ext_rae_buf_get(buf: ch.ids.data, index: i)
        let hit: EntityId = hitTestEntity(
          world: world
          entity: cid
          x: x
          y: y
        )
        if isNone(this: hit) is false {
          ret hit
        }
        i = i - 1
      }
    }

    if componentHas(this: world.onClicks, entity: entity) {
      if pointInEntity(
        world: world
        entity: entity
        x: x
        y: y
      ) {
        ret entity
      }
    }
    ret inputNoEntity
  }
}

func hitTest(world: view UiWorld, x: view Float, y: view Float) ret EntityId {
  unsafe {
    let roots: List(EntityId) = collectPaintableRoots(world: world)
    let n: Int = roots.length
    var i: Int = n - 1
    loop i >= 0 {
      let e: EntityId = rae_ext_rae_buf_get(buf: roots.data, index: i)
      if componentHas(this: world.layerRoots, entity: e) is false {
        let hit: EntityId = hitTestEntity(
          world: world
          entity: e
          x: x
          y: y
        )
        if isNone(this: hit) is false {
          ret hit
        }
      }
      i = i - 1
    }
    ret inputNoEntity
  }
}

func updateInputSystem(input: mod InputSystem, world: view UiWorld, viewport: view Viewport) {
  # Recycle last frame's action channel (double-buffered), replacing the old
  # clearActionEvents: this frame's clicks produce into a clean queue.
  frameAdvance(this: input.uiActions)
  sendScriptedTap(input: input)
  input.typedText = uiTextInput()
  input.backspaces = 0
  if Sdl3.isKeyPressed(key: keyBackspace) {
    input.backspaces = 1
  }
  # Scripted keyboard: paste `RAE_UI_TYPE` on the frame after the last
  # scripted tap has fired, so a headless run can drive a text field.
  if input.scriptedType.length() > 0 and input.scriptedScreens.length is 0 {
    input.scriptedFrame = input.scriptedFrame + 1
    if input.scriptedFrame % input.scriptedEvery is 0 {
      log("[screen-seq] type \"{input.scriptedType}\"")
      input.typedText = "{input.scriptedType}"
      input.scriptedType = ""
    }
  }

  let mx: Float = viewportPointerX(viewport: viewport)
  let my: Float = viewportPointerY(viewport: viewport)
  let down: Bool = uiPointerButtonDown(button: mouseButtonLeft)
  var pressed: Bool = false
  var released: Bool = false
  if uiMouseHookActive() {
    pressed = uiMouseHookDrainPressed()
    released = uiMouseHookDrainReleased()
  } else {
    pressed = uiPointerButtonPressed(button: mouseButtonLeft)
    released = uiPointerButtonReleased(button: mouseButtonLeft)
  }

  let nextPointer: PointerState = {
    x: mx
    y: my
    down: down
    pressed: pressed
    released: released
  }
  input.pointer = nextPointer

  if pressed {
    input.pressedEntity = hitTest(world: world, x: mx, y: my)
    log("[input] press at ({mx},{my}) -> pressedEntity={input.pressedEntity.index}")
  }

  if released {
    var hit: EntityId = hitTest(world: world, x: mx, y: my)
    log("[input] release at ({mx},{my}) -> hit={hit.index} pressed={input.pressedEntity.index}")
    if isNone(this: hit) is false {
      if hit is input.pressedEntity {
        if componentHas(this: world.onClicks, entity: hit) {
          let oc: view OnClick => componentView(this: world.onClicks, entity: hit)
          log("[input] fire {oc.actionId} on entity {hit.index}")
          eventSend(this: input.uiActions, value: UiAction { entity: hit, actionId: oc.actionId })
        } else {
          log("[input] release matched press but entity has no OnClick")
        }
      } else {
        log("[input] release hit {hit.index} != pressed {input.pressedEntity.index} - drop")
      }
    } else {
      log("[input] release hit nothing - drop")
    }
    input.pressedEntity = inputNoEntity
  }
}
