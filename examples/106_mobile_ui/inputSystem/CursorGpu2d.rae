open ui/Ecs
import ui/Components
open ecs/Entity
open ecs/ComponentTable

const cursorArrow: Int = 0

const cursorPointer: Int = 1

const cursorText: Int = 2

const cursorResizeHorizontal: Int = 3

const cursorResizeVertical: Int = 4

const cursorCrosshair: Int = 5

const cursorNotAllowed: Int = 6

func cursorKindFromName(name: view String) ret Int {
  if name is "pointer" {
    ret cursorPointer
  }
  if name is "hand" {
    ret cursorPointer
  }
  if name is "text" {
    ret cursorText
  }
  if name is "resizeHorizontal" {
    ret cursorResizeHorizontal
  }
  if name is "resizeVertical" {
    ret cursorResizeVertical
  }
  if name is "crosshair" {
    ret cursorCrosshair
  }
  if name is "notAllowed" {
    ret cursorNotAllowed
  }
  ret cursorArrow
}

func cursorKindForEntity(world: view UiWorld, entityId: view EntityId) ret Int {
  if isNone(this: entityId) {
    ret cursorArrow
  }

  if componentHas(this: world.widgetStates, entityId: entityId) {
    let state: view WidgetState => componentView(this: world.widgetStates, entityId: entityId)
    if state.enabled is false {
      ret cursorArrow
    }
  }

  if componentHas(this: world.pointerEvents, entityId: entityId) {
    let pe: view PointerEvents => componentView(this: world.pointerEvents, entityId: entityId)
    if pe.enabled is false {
      ret cursorArrow
    }
    let explicit: Int = cursorKindFromName(name: pe.cursor)
    if explicit is not cursorArrow {
      ret explicit
    }
  }

  if componentHas(this: world.onClicks, entityId: entityId) {
    ret cursorPointer
  }

  ret cursorArrow
}

func syncDesktopCursor(world: view UiWorld, hovered: view EntityId, lastKind: mod Int) pub {
  let kind: Int = cursorKindForEntity(world: world, entityId: hovered)
  if kind is not lastKind {
    uiSetMouseCursor(kind: kind)
    lastKind = kind
  }
}
