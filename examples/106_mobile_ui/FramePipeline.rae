# Frame-phase helpers for 106. The app still owns the loop policy, but the
# systems now run through explicit phases: input dispatch, UI refresh/data sync,
# layout/transform, animation, and GPU2D render.
type FrameInputDispatchResult {
  nextScreen: Screen
  hadActions: Bool
  canvasChanged: Bool
  debugChanged: Bool
}

func runFrameInputDispatch(
  input: view InputSystem
  currentScreen: view Screen
  playbackSystem: mod PlaybackSystem
  appState: mod AppState
  world: mod UiWorld
  uiSystems: mod UiSystems
  debug: mod DebugSystem
  scenes: view AlbumScenes
  actionTable: view ActionTable
  commands: mod EventQueue(AppCommand)
  spotifyEnabled: view Bool
  dragJustReleased: view Bool
) pub ret FrameInputDispatchResult {
  var nextScreen: Screen = currentScreen
  let canvasOpenBefore: Bool = appState.canvasOpen
  let hadActions: Bool = eventCount(this: input.uiActions) > 0

  if dragJustReleased is false {
    # The fired ids become typed commands through the action table, and the
    # command systems (navigation, playbackSystem, sheet, canvas) consume them.
    nextScreen = runAppCommands(
      input: input
      actionTable: actionTable
      commands: commands
      state: appState
      playbackSystem: playbackSystem
      spotifyEnabled: spotifyEnabled
    )
  } else {
    if hadActions {
      let dropped: Int = eventCount(this: input.uiActions)
      log("[dispatch] dragJustReleased=true, dropping {dropped} pending event(s)")
    }
  }

  let canvasChanged: Bool = appState.canvasOpen is not canvasOpenBefore
  if canvasChanged {
    applyCanvasState(
      world: world
      uiSystems: uiSystems
      scenes: scenes
      state: appState
    )
  }

  if hadActions {
    if dragJustReleased is false {
      saveAppState(path: stateFilePath, state: appState, playbackSystem: playbackSystem)
    }
  }

  var debugChanged: Bool = false
  if dragJustReleased is false {
    debugChanged = dispatchDebugAction(state: appState, input: input, debug: debug)
    syncDebugWidgetStates(world: world, debug: debug)
  }

  ret FrameInputDispatchResult {
    nextScreen: nextScreen
    hadActions: hadActions
    canvasChanged: canvasChanged
    debugChanged: debugChanged
  }
}

type FrameDataSyncResult {
  assetsLoading: Bool
}

func syncFrameData(
  world: mod UiWorld
  uiSystems: mod UiSystems
  musicSystems: mod MusicSystems
  scenes: view AlbumScenes
  appState: mod AppState
  spotifySystem: mod SpotifySystem
  spotifyPoller: view SpotifyPoller
  textureRegistry: mod TextureRegistry
  observation: mod AppObservation
  now: view Float64
) pub ret FrameDataSyncResult {
  advancePlayback(playbackSystem: musicSystems.playbackSystem, now: now)

  # The poll worker (#950) asked Spotify off-thread and sent the answer; only
  # then is there a new snapshot worth mirroring into the world.
  var polled: SpotifyTrack = Spotify.emptySpotifyTrack()
  let ticked: Bool = spotifyPollerTake(poller: spotifyPoller, latest: polled)
  pollSpotify(
    spotifySystem: spotifySystem
    reg: textureRegistry
    playbackSystem: musicSystems.playbackSystem
    appState: appState
    now: Time.atSeconds(s: now)
    ticked: ticked
    track: polled
  )
  # Observation (B): whatever the clock tick / the Spotify mirror moved lands
  # this frame — every app system judged from its declared sources
  # (observeSystem/AppObservation); nothing runs when nothing moved.
  let observed: Int = runAppObservation(
    playbackSystem: musicSystems.playbackSystem
    observation: observation
    world: world
    uiSystems: uiSystems
    musicSystems: musicSystems
    state: appState
    scenes: scenes
    reg: textureRegistry
  )
  # Spotify's live now-playing text is a binding too: `spotifyBindingSystem`
  # writes the `TextBinding` nodes from the snapshot the poll just published,
  # and self-gates on `SpotifySystem.revision` (a no-op in local mode). Runs
  # AFTER the observation so a live Spotify track wins over the browsed one.
  spotifyBindingSystem(world: world, spotifySystem: spotifySystem)

  # Settle the artwork downloads that landed since last frame (#950), then
  # let the loaders upload them / start the next ones — album covers first
  # (they are fetched too, when not on disk), then the history art.
  artworkFetchDrain(queue: appState.artworkFetch)
  let loadingCovers: Bool = cascadeAssets(
    reg: textureRegistry
    albums: appState.mediaLibrary.albums
    budget: 2
    load: appState.assetLoad
    fetches: appState.artworkFetch
  )
  let loadingHistoryArt: Bool = loadCachedHistoryArtChunk(
    history: appState.playHistory
    reg: textureRegistry
    budget: 4
    loader: appState.historyArt
    fetches: appState.artworkFetch
  )
  ret FrameDataSyncResult { assetsLoading: loadingCovers or loadingHistoryArt }
}

# The lib/ui system phase, driven by the #939 Schedule (#949): each system is
# gated by `uiShouldRun`, which judges it from its DECLARED read/write tables
# (layout/transform skip when their inputs are unchanged — fixture 839 proves
# this equals the LayoutCache/TransformCache judgement this replaced; the
# others always run). Rae has no function references, so the app still CALLS
# the systems, in the order 106 has always used; the schedule owns the
# declarations and the dirty state.
func runFrameLayoutTransform(
  world: mod UiWorld
  uiSystems: mod UiSystems
  viewport: view Viewport
  schedule: mod Schedule
  gpuUi: view Gpu2dUi
  subScenes: view SceneRegistry
) pub {
  # #964: virtualised lists (the History page) re-bind their pooled rows to
  # the current scroll before layout, so this frame lays out the rows in
  # view. Runs every frame; it writes nothing when nothing moved.
  listViewSystem(world: world, uiSystems: uiSystems, scenes: subScenes)
  # widgetStyleSystem: WidgetState / StateStyle -> the widget's visuals
  # (pressed offsets, icon swaps, tints); change-disciplined, before layout
  # because it writes offsets.
  if uiShouldRun(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    index: uiSystemWidgetStyle
  ) {
    buttonStyleUpdate(world: world)
  }
  if uiShouldRun(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    index: uiSystemSafeArea
  ) {
    applySafeAreas(world: world, uiSystems: uiSystems, viewport: viewport)
  }
  # #978: bottom-anchored overlays follow the layout extent and the safe
  # inset; layer tags resolve for anything mounted since last frame.
  anchorBottomSystem(world: world, bottomInset: viewport.safeInsetsDu.b)
  layerTagSystem(world: world)
  if uiShouldRun(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    index: uiSystemLayout
  ) {
    layoutSystem(world: world, uiSystems: uiSystems)
  }
  if uiShouldRun(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    index: uiSystemFit
  ) {
    fitSystem(world: world, uiSystems: uiSystems)
  }
  if uiShouldRun(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    index: uiSystemTransform
  ) {
    transformSystem(world: world, uiSystems: uiSystems)
  }
  # Measured centering (#219): cache glyph bounds once per change so
  # the render pass reads them instead of remeasuring every frame.
  # Needs mod world + the fonts, so it runs here, before render.
  if uiShouldRun(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    index: uiSystemVisualBounds
  ) {
    visualBoundsSystem(world: world, uiSystems: uiSystems, res: gpuUi)
  }
}

type FrameRenderResult {
  forceRender: Bool
  # Float64: this holds an epoch TIMESTAMP, not a duration. An f32 near
  # 1.75e9 quantises to multiples of 128 s, which turns both tests below
  # into constants — either every frame is "due" (no throttle at all) or
  # none is (a visibly frozen app) for up to a minute at a time. Same for
  # `renderUntil`, which is Float64 at its owner in main.rae and must not
  # be narrowed on the way in.
  lastRenderTime: Float64
  didRender: Bool
}

func renderGpu2dFrame(
  world: mod UiWorld
  uiSystems: view UiSystems
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  debug: mod DebugSystem
  logOverlay: view LogOverlay
  logW: view Float
  logH: view Float
  renderCache: mod RenderCache
  bg: view RgbaColor
  now: view Float64
  targetFrameSec: view Float
  lastRenderTime: view Float64
  busyAnimating: view Bool
  active: view Bool
  forceRender: view Bool
  renderUntil: view Float64
  switching: view Bool
) pub ret FrameRenderResult {
  let frameDue: Bool = busyAnimating or forceRender or (now - lastRenderTime) >= targetFrameSec * 0.85
  if (busyAnimating or active or forceRender or now < renderUntil) and frameDue and switching is false {
    uiBeginFrame(canvas: canvas, clear: bg)
    renderSystemGpu2d(
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    )
    updateAndRenderDebugOverlayGpu2d(
      debug: debug
      canvas: canvas
      now: now
      didRealWork: active
      font: gpuUi.textFont
    )
    # Shared log overlay (lib/ui/LogOverlay.rae) — top-left here, bottom-left
    # in the 3D example. Drawn last so it is never covered by app UI.
    drawLogOverlay(
      ov: logOverlay
      canvas: canvas
      font: gpuUi.textFont
      screenW: logW
      screenH: logH
    )
    uiEndFrame(canvas: canvas)
    cacheDirty(world: world, uiSystems: uiSystems, cache: renderCache)
    ret FrameRenderResult {
      forceRender: uiLastPresentOk() is false
      lastRenderTime: now
      didRender: true
    }
  }

  ret FrameRenderResult {
    forceRender: forceRender
    lastRenderTime: lastRenderTime
    didRender: false
  }
}
