# Frame-phase helpers for 106. The app still owns the loop policy, but the
# systems now run through explicit phases: input dispatch, UI refresh/data sync,
# layout/transform, animation, and GPU2D render.
type FrameInputDispatchResult {
  nextScreen: Screen
  hadActions: Bool
  canvasChanged: Bool
  debugChanged: Bool
}

func runFrameInputDispatch(
  input: view InputSystem
  currentScreen: view Screen
  playback: mod PlaybackState
  appState: mod AppState
  world: mod UiWorld
  debug: mod DebugSystem
  scenes: view AlbumScenes
  spotifyEnabled: view Bool
  dragJustReleased: view Bool
) pub ret FrameInputDispatchResult {
  var nextScreen: Screen = currentScreen
  let canvasOpenBefore: Bool = appState.canvasOpen
  let hadActions: Bool = eventCount(this: input.uiActions) > 0

  if dragJustReleased is false {
    nextScreen = dispatchActions(
      input: input
      current: currentScreen
      playback: playback
      state: appState
      world: world
      spotifyEnabled: spotifyEnabled
    )
  } else {
    if hadActions {
      let dropped: Int = eventCount(this: input.uiActions)
      log("[dispatch] dragJustReleased=true, dropping {dropped} pending event(s)")
    }
  }

  let canvasChanged: Bool = appState.canvasOpen is not canvasOpenBefore
  if canvasChanged {
    applyCanvasState(world: world, scenes: scenes, state: appState)
  }

  if hadActions {
    if dragJustReleased is false {
      saveAppState(path: stateFilePath, state: appState, playback: playback)
    }
  }

  var debugChanged: Bool = false
  if dragJustReleased is false {
    debugChanged = dispatchDebugAction(state: appState, input: input, debug: debug)
    syncDebugWidgetStates(world: world, debug: debug)
  }

  ret FrameInputDispatchResult {
    nextScreen: nextScreen
    hadActions: hadActions
    canvasChanged: canvasChanged
    debugChanged: debugChanged
  }
}

type FrameUiRefreshResult {
  historyChanged: Bool
  playbackChanged: Bool
}

func refreshUiDiffs(
  world: mod UiWorld
  scenes: view AlbumScenes
  appState: view AppState
  playback: view PlaybackState
  visible: view Screen
  cache: mod UiRefreshCache
  viewport: view Viewport
  applyOverlaySync: view Bool
  reg: view TextureRegistry
) pub ret FrameUiRefreshResult {
  let refreshed: UiRefreshResult = refreshMountedUi(
    world: world
    scenes: scenes
    state: appState
    playback: playback
    visible: visible
    cache: cache
    viewport: viewport
    reg: reg
  )
  if applyOverlaySync or refreshed.playbackChanged {
    applyOverlaysToWorld(world: world, playback: playback, state: appState)
  }
  ret FrameUiRefreshResult {
    historyChanged: refreshed.historyChanged
    playbackChanged: refreshed.playbackChanged
  }
}

type FrameDataSyncResult {
  assetsLoading: Bool
  playbackChanged: Bool
}

func syncFrameData(
  world: mod UiWorld
  scenes: view AlbumScenes
  appState: mod AppState
  playback: mod PlaybackState
  spotifyState: mod SpotifyState
  spotifyPoller: view SpotifyPoller
  texReg: mod TextureRegistry
  uiRefresh: mod UiRefreshCache
  visible: view Screen
  viewport: view Viewport
  now: view Float64
  applyPlaybackFrame: view Bool
) pub ret FrameDataSyncResult {
  advancePlayback(state: playback, now: now)
  if applyPlaybackFrame {
    applyOverlaysToWorld(world: world, playback: playback, state: appState)
  }

  # The poll worker (#950) refreshed the cache off-thread and posted a tick;
  # only then is there a new snapshot worth mirroring into the world.
  pollSpotify(
    state: spotifyState
    world: world
    reg: texReg
    playback: playback
    appState: appState
    now: Time.atSeconds(s: now)
    ticked: spotifyPollerTicked(poller: spotifyPoller)
  )
  let spotifyRefresh: UiRefreshResult = refreshMountedUi(
    world: world
    scenes: scenes
    state: appState
    playback: playback
    visible: visible
    cache: uiRefresh
    viewport: viewport
    reg: texReg
  )
  if spotifyRefresh.playbackChanged {
    applyOverlaysToWorld(world: world, playback: playback, state: appState)
  }

  let loadingCovers: Bool = cascadeAssets(
    reg: texReg
    albums: appState.mediaLibrary.albums
    budget: 2
    load: appState.assetLoad
  )
  # Settle the artwork downloads that landed since last frame (#950), then
  # let the loader upload them / start the next ones.
  artworkFetchDrain(queue: appState.artworkFetch)
  let loadingHistoryArt: Bool = loadCachedHistoryArtChunk(
    history: appState.playHistory
    reg: texReg
    budget: 4
    loader: appState.historyArt
    fetches: appState.artworkFetch
  )
  ret FrameDataSyncResult {
    assetsLoading: loadingCovers or loadingHistoryArt
    playbackChanged: spotifyRefresh.playbackChanged
  }
}

# The lib/ui system phase, driven by the #939 Schedule (#949): each system is
# gated by `uiShouldRun`, which judges it from its DECLARED read/write tables
# (layout/transform skip when their inputs are unchanged — fixture 839 proves
# this equals the LayoutCache/TransformCache judgement this replaced; the
# others always run). Rae has no function references, so the app still CALLS
# the systems, in the order 106 has always used; the schedule owns the
# declarations and the dirty state.
func runFrameLayoutTransform(
  world: mod UiWorld
  viewport: view Viewport
  schedule: mod Schedule
  gpuUi: view Gpu2dUi
  subScenes: view SceneRegistry
) pub {
  # #964: virtualised lists (the History page) re-bind their pooled rows to
  # the current scroll before layout, so this frame lays out the rows in
  # view. Runs every frame; it writes nothing when nothing moved.
  listViewSystem(world: world, scenes: subScenes)
  if uiShouldRun(schedule: schedule, world: world, index: uiSystemSafeArea) {
    applySafeAreas(world: world, viewport: viewport)
  }
  # #978: bottom-anchored overlays follow the layout extent and the safe
  # inset; layer tags resolve for anything mounted since last frame.
  anchorBottomSystem(world: world, bottomInset: viewport.safeInsetsDu.b)
  layerTagSystem(world: world)
  if uiShouldRun(schedule: schedule, world: world, index: uiSystemLayout) {
    layoutSystem(world: world)
  }
  if uiShouldRun(schedule: schedule, world: world, index: uiSystemFit) {
    fitSystem(world: world)
  }
  if uiShouldRun(schedule: schedule, world: world, index: uiSystemTransform) {
    transformSystem(world: world)
  }
  # Measured centering (#219): cache glyph bounds once per change so
  # the render pass reads them instead of remeasuring every frame.
  # Needs mod world + the fonts, so it runs here, before render.
  if uiShouldRun(schedule: schedule, world: world, index: uiSystemVisualBounds) {
    visualBoundsSystem(world: world, res: gpuUi)
  }
}

type FrameAnimationResult {
  animating: Bool
  pendingSrc: Bool
  transitionArmed: Bool
  pendingHeroTargetPageId: String
}

func runFrameAnimation(
  world: mod UiWorld
  anim: mod HeroAnim
  appState: view AppState
  willSwitch: view Bool
  now: view Float64
  heroDuration: view Float
  transitionArmed: view Bool
  pendingSrc: view Bool
  pendingHeroTargetPageId: view String
) pub ret FrameAnimationResult {
  var nextTransitionArmed: Bool = transitionArmed
  var nextPendingSrc: Bool = pendingSrc
  var nextPendingHeroTargetPageId: String = "{pendingHeroTargetPageId}"

  if nextTransitionArmed {
    startHeroTransition(
      anim: anim
      key: "{appState.currentAlbumStem}"
      durationSec: heroDuration
      now: now
    )
    nextTransitionArmed = false
  }

  let animating: Bool = updateHeroAnim(anim: anim, now: now)
  if animating is false {
    if nextPendingSrc {
      if willSwitch is false {
        if nextPendingHeroTargetPageId.length() > 0 {
          setHeroVisibleOnPage(
            world: world
            pageId: nextPendingHeroTargetPageId
            key: appState.currentAlbumStem
            visible: true
          )
        } else {
          setHeroVisible(world: world, key: appState.currentAlbumStem, visible: true)
        }
        nextPendingHeroTargetPageId = ""
        nextPendingSrc = false
      }
    }
  }

  ret FrameAnimationResult {
    animating: animating
    pendingSrc: nextPendingSrc
    transitionArmed: nextTransitionArmed
    pendingHeroTargetPageId: own nextPendingHeroTargetPageId
  }
}

type FrameRenderResult {
  forceRender: Bool
  # Float64: this holds an epoch TIMESTAMP, not a duration. An f32 near
  # 1.75e9 quantises to multiples of 128 s, which turns both tests below
  # into constants — either every frame is "due" (no throttle at all) or
  # none is (a visibly frozen app) for up to a minute at a time. Same for
  # `renderUntil`, which is Float64 at its owner in main.rae and must not
  # be narrowed on the way in.
  lastRenderTime: Float64
  didRender: Bool
}

func renderGpu2dFrame(
  world: mod UiWorld
  gpuUi: view Gpu2dUi
  canvas: mod Gpu2dCanvas
  debug: mod DebugSystem
  logView: view LogOverlay
  logW: view Float
  logH: view Float
  renderCache: mod RenderCache
  bg: view RgbaColor
  now: view Float64
  targetFrameSec: view Float
  lastRenderTime: view Float64
  busyAnimating: view Bool
  active: view Bool
  forceRender: view Bool
  renderUntil: view Float64
  switching: view Bool
) pub ret FrameRenderResult {
  let frameDue: Bool = busyAnimating or forceRender or (now - lastRenderTime) >= targetFrameSec * 0.85
  if (busyAnimating or active or forceRender or now < renderUntil) and frameDue and switching is false {
    uiBeginFrame(canvas: canvas, clear: bg)
    renderSystemGpu2d(world: world, res: gpuUi, canvas: canvas)
    updateAndRenderDebugOverlayGpu2d(
      debug: debug
      canvas: canvas
      now: now
      didRealWork: active
      font: gpuUi.textFont
    )
    # Shared log overlay (lib/ui/LogOverlay.rae) — top-left here, bottom-left
    # in the 3D example. Drawn last so it is never covered by app UI.
    drawLogOverlay(
      ov: logView
      canvas: canvas
      font: gpuUi.textFont
      screenW: logW
      screenH: logH
    )
    uiEndFrame(canvas: canvas)
    cacheDirty(world: world, cache: renderCache)
    ret FrameRenderResult {
      forceRender: uiLastPresentOk() is false
      lastRenderTime: now
      didRender: true
    }
  }

  ret FrameRenderResult {
    forceRender: forceRender
    lastRenderTime: lastRenderTime
    didRender: false
  }
}
