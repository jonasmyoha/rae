{
  "type": "Scene",
  "version": 3,
  "assets": {
    "fonts": {
      "text": "../Roboto-Regular.mtsdf.json"
    }
  },
  "palette": {
    "background":      { "r": 10,  "g": 10,  "b": 14,  "a": 255 },
    "surface":         { "r": 10,  "g": 10,  "b": 14,  "a": 255 },
    "surfaceAlt":      { "r": 72,  "g": 180, "b": 152, "a": 255 },
    "textPrimary":     { "r": 248, "g": 248, "b": 250, "a": 255 },
    "textMuted":       { "r": 170, "g": 170, "b": 180, "a": 255 },
    "outline":         { "r": 60,  "g": 60,  "b": 70,  "a": 255 },
    "accent":          { "r": 72,  "g": 180, "b": 152, "a": 255 },
    "accentText":      { "r": 248, "g": 248, "b": 250, "a": 255 },
    "accentTextMuted": { "r": 224, "g": 232, "b": 228, "a": 255 },
    "imageTint":       { "r": 255, "g": 255, "b": 255, "a": 255 }
  },
  "space": {
    "spaceXS": 2.8916,
    "spaceS":  5.7831,
    "spaceM":  8.6747,
    "spaceL":  11.5663,
    "spaceXL": 17.3494
  },
  "radius": {
    "radiusChip":  8.6747,
    "radiusCard":  12.0,
    "radiusThumb": 8.6747,
    "radiusPill":  23.1325
  },
  "padding": {
    "cardPadding":       { "l": 5.3333, "t": 5.3333, "r": 5.3333, "b": 5.3333 },
    "screenEdgePadding": { "l": 14.4578, "t": 14.4578, "r": 14.4578, "b": 14.4578 }
  },
  "shadow": {
    "textOnAccent":     { "color": { "r": 0, "g": 0, "b": 0, "a": 115 },
                          "offsetX": 1.0843, "offsetY": 1.0843, "softness": 2.8916 },
    "textOnAccentSoft": { "extends": "textOnAccent",
                          "color": { "r": 0, "g": 0, "b": 0, "a": 100 },
                          "offsetX": 0.7229, "offsetY": 0.7229, "softness": 2.1687 }
  },
  "text": {
    "body":             { "font": "text", "size": 14.4578, "color": "textPrimary", "align": "start" },
    "primary":          { "extends": "body" },
    "muted":            { "extends": "body", "color": "textMuted" },
    "h1":               { "extends": "body", "size": 26.0241 },
    "h2":               { "extends": "body", "size": 20.241 },
    "pageTitle":        { "extends": "body", "size": 20.241, "align": "center" },
    "topBarTitle":      { "extends": "body", "size": 13.012 },
    "miniTitle":        { "extends": "body", "size": 13.012, "color": "accentText", "shadow": "textOnAccent" },
    "miniMuted":        { "extends": "miniTitle", "size": 10.1205, "color": "accentTextMuted", "shadow": "textOnAccentSoft" },
    "caption":          { "extends": "body", "size": 11.5663, "color": "textMuted" },
    "albumCaption":     { "extends": "body", "size": 10.1205, "color": "textMuted" },
    "pillLabel":        { "extends": "body", "size": 13.012, "color": "accentText" },
    "trackTitle":       { "extends": "body", "size": 14.4578 },
    "trackMuted":       { "extends": "body", "size": 10.1205, "color": "textMuted" },
    "historyTitle":     { "extends": "body", "size": 13.012 },
    "historyArtist":    { "extends": "body", "size": 10.1205, "color": "textMuted" },
    "tabActive":        { "extends": "body", "size": 10.1205, "align": "center" },
    "tabInactive":      { "extends": "body", "size": 10.1205, "color": "textMuted", "align": "center" },
    "timeTotal":        { "extends": "body", "size": 11.5663, "color": "textMuted", "align": "end" },
    "debugButton":      { "extends": "body", "size": 10.1205, "color": { "r": 24, "g": 24, "b": 28, "a": 255 }, "align": "center" },
    "debugButtonSmall": { "extends": "debugButton", "size": 8.6747 },
    "debugCloseButton": { "extends": "body", "size": 13.012, "color": "accentText", "align": "center" },
    "debugDialogTitle": { "extends": "body", "size": 15.9036, "color": { "r": 255, "g": 255, "b": 255, "a": 255 }, "align": "center" },
    "debugMenuLabel":   { "extends": "body", "size": 11.5663, "color": { "r": 246, "g": 246, "b": 248, "a": 255 } },
    "profileHandle":    { "extends": "body", "size": 14.4578, "align": "center" },
    "profileBio":       { "extends": "body", "size": 11.5663, "color": "textMuted", "align": "center" },
    "statValue":        { "extends": "body", "size": 20.241, "align": "center" },
    "statLabel":        { "extends": "body", "size": 11.5663, "color": "textMuted", "align": "center" }
  },
  "container": {
    "primaryButton": { "background": "accent", "radius": "radiusPill", "padding": "cardPadding", "text": "primary" },
    "card":          { "background": "surface", "radius": "radiusCard", "padding": "cardPadding", "text": "body" }
  }
}
