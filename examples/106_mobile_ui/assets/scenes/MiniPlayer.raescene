{
  "type": "Scene",
  "version": 2,
  "root": "MiniPlayer",
  "import": [
    "Theme"
  ],
  "nodes": {
    "MiniPlayer": {
      "Layout": {
        "type": "Horizontal",
        "gap": "spaceM",
        "alignCross": "Center"
      },
      "Padding": {
        "l": "spaceS",
        "t": "spaceS",
        "r": "spaceL",
        "b": 69.3976
      },
      "GradientFill": {
        "from": {
          "r": 118,
          "g": 225,
          "b": 225,
          "a": 255
        },
        "to": {
          "r": 161,
          "g": 196,
          "b": 253,
          "a": 255
        },
        "angle": 135
      },
      "CornerRadius": {
        "radius": "radiusPill"
      },
      "OnClick": {
        "actionId": "nav.nowPlaying",
        "label": "Open now playing"
      },
      "Children": [
        "MiniThumb",
        "MiniTitleBlock",
        "MiniSpacer",
        "MiniQueueButton",
        "MiniHeartButton",
        "MiniPlayCircle"
      ],
      "WidgetId": {
        "id": "miniPlayer.root",
        "kind": "miniPlayer"
      },
      "WidgetState": {
        "enabled": true,
        "selected": false,
        "loading": false,
        "error": false
      },
      "DataDependency": {
        "sourceKey": "playback",
        "fieldKey": "playingTrack",
        "observedRevision": 0
      }
    },
    "MiniThumb": {
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 40.4819,
        "h": 40.4819
      },
      "Sprite": {
        "textureKey": "albumCover",
        "tint": "imageTint",
        "scaleMode": "Fill"
      },
      "CornerRadius": {
        "radius": "radiusChip"
      },
      "AlbumCover": {},
      "PlaybackCover": {}
    },
    "MiniTitleBlock": {
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 173.494,
        "h": 34.6988
      },
      "Layout": {
        "type": "Vertical",
        "gap": 1.4458,
        "alignCross": "Start"
      },
      "Children": [
        "MiniTitle",
        "MiniArtist"
      ]
    },
    "MiniTitle": {
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 173.494,
        "h": 17.3494
      },
      "Text": {
        "text": "Unsayable",
        "styleId": "miniTitle"
      },
      "TrackText": {
        "field": "title"
      },
      "TextBinding": {
        "key": "spotify.title",
        "format": "Plain",
        "prefix": "",
        "suffix": ""
      }
    },
    "MiniArtist": {
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 173.494,
        "h": 13.012
      },
      "Text": {
        "text": "Brambles",
        "styleId": "miniMuted"
      },
      "TrackText": {
        "field": "artist"
      },
      "TextBinding": {
        "key": "spotify.artist",
        "format": "Plain",
        "prefix": "",
        "suffix": ""
      }
    },
    "MiniSpacer": {
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 0.0,
        "h": 0.7229
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Fixed"
        }
      }
    },
    "MiniQueueButton": {
      "bundles": ["pressable"],
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 20.241,
        "h": 20.241
      },
      "Sprite": {
        "textureKey": "mat:queue_music",
        "tint": "accentText"
      },
      "OnClick": {
        "actionId": "canvas.toggle",
        "label": "Show the canvas"
      },
      "Active": {
        "value": false
      }
    },
    "MiniHeartButton": {
      "bundles": ["pressable"],
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 20.241,
        "h": 20.241
      },
      "Sprite": {
        "textureKey": "mat:favorite_border",
        "tint": "accentText"
      },
      "OnClick": {
        "actionId": "playback.like",
        "label": "Like"
      },
      "WidgetId": {
        "id": "miniPlayer.likeButton",
        "kind": "likeButton"
      },
      "WidgetState": {
        "enabled": true,
        "selected": false,
        "loading": false,
        "error": false
      },
      "LikedHeart": {}
    },
    "MiniPlayCircle": {
      "bundles": ["pressable"],
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 31.8072,
        "h": 31.8072
      },
      "Shape": {
        "kind": "Circle",
        "fill": "surface",
        "radius": 15.9036
      },
      "Layout": {
        "type": "Stack",
        "gap": 0.0,
        "alignCross": "Center"
      },
      "OnClick": {
        "actionId": "playback.toggle",
        "label": "Play or pause"
      },
      "Children": [
        "MiniPlayIcon"
      ]
    },
    "MiniPlayIcon": {
      "Rect": {
        "x": 0.0,
        "y": 0.0,
        "w": 15.9036,
        "h": 15.9036
      },
      "Sprite": {
        "textureKey": "mat:play_arrow",
        "tint": "textPrimary"
      },
      "WidgetId": {
        "id": "miniPlayer.playIcon",
        "kind": "playbackIcon"
      },
      "WidgetState": {
        "enabled": true,
        "selected": false,
        "loading": false,
        "error": false
      },
      "PlaybackIcon": {}
    }
  },
  "frames": {
    "PhonePortrait": {
      "default": true,
      "nodes": {}
    },
    "Desktop": {
      "when": {
        "minPtW": 700
      },
      "nodes": {
        "MiniQueueButton": {
          "Active": {
            "value": true
          }
        },
        "MiniPlayCircle": {
          "remove": [
            "Shape"
          ]
        },
        "MiniArtist": {
          "Parent": "MiniPlayer",
          "order": 2,
          "Rect": {
            "x": 0.0,
            "y": 0.0,
            "w": 86.747,
            "h": 13.012
          }
        }
      }
    }
  }
}
