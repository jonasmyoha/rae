{
  "type": "Scene",
  "version": 2,
  "root": "SettingsRoot",
  "import": [
    "Theme"
  ],
  "_note": "The settings dialog (screenSystem/SettingsView). Hidden at rest; the settingsOpen state shows it, the darkTheme state turns the dark theme switch on.",
