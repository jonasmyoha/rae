# Per-album data. Each `albumsFolder/<stem>/` carries `album.json`; the
# cover is downloaded from its `artworkUrl` into app_cache/ on first run
# (a local `cover.jpg` next to the album.json overrides it, gitignored).
# The `album_loader.rae` module walks this folder at boot.
const albumsFolder: String = "examples/106_mobile_ui/assets/albums"

# Persistent UI state — active album stem, active track index, and
# playback position. Read at boot, written on user action.
const stateFilePath: String = "examples/106_mobile_ui/assets/state.json"

# Stem of the album whose cover we use as the (placeholder) profile
# avatar. Picked here so swapping it doesn't require editing
# `profile_view.rae`.
const avatarAlbumStem: String = "the_beaches-jocelyn"

const robotoFontSlot: Int = 0

const materialIconFontSlot: Int = 1

const robotoFontPath: String = "examples/106_mobile_ui/assets/Roboto-Regular.ttf"

const materialIconFontPath: String = "lib/assets/fonts/MaterialIconsRound-Regular.otf"

const robotoMsdfJsonPath: String = "examples/106_mobile_ui/assets/Roboto-Regular.mtsdf.json"

# Visible build version. Bumped manually when the demo's behavior
# changes meaningfully — drawn in white above the debug button so a
# tester can confirm at a glance which build is running.
const appVersion: Int = 1

# ----- page ids -------------------------------------------------------
# Pages mount their nodeIds under `"<pageId>/<nodeId>"` keys in
# `world.nodeIds` so multiple resident pages don't collide. Keep
# these in one place so the producer (mount sites) and consumer
# (`playback.rae`, future page-aware lookups) can never drift.
const albumPageId: String = "album"

const playerPageId: String = "player"

const homePageId: String = "home"

const libraryPageId: String = "library"

const searchPageId: String = "search"

const profilePageId: String = "profile"

const historyPageId: String = "history"

const dockPageId: String = "dock"

const backButtonPageId: String = "back-button"

const canvasPageId: String = "canvas"

const settingsPageId: String = "settings"
