open ui/Ecs
# Layout, palette, and asset-path constants for the music-player demo.
# Kept in one file so tweaking the look or repointing assets is a single
# place to edit. Auto-imported by every other file in this project.
import ui/Spacing
open ui/Theme

# ----- screen + spacing ---------------------------------------------
# Window dimensions and every length below are points, the design unit of
# every Rae program (rae/docs/ui-coordinate-and-responsive-layout.md). They
# were authored 1080 units wide, at 3 units per point, until 2026-11-17.
const windowW: Float = 360.0

const windowH: Float = 780.0

const phoneFrameW: Float = 360.0

const phoneFrameH: Float = 760.0

# outerPad is the screen-edge inset — domain-specific, not a generic
# spacing step. outerGap is the canonical "section gap" inside a
# screen; its numeric value is spaceM, but the C backend can't
# initialize a module-level `let` from another module-level `let`,
# so we keep it as a literal and rely on the spaceM comment to
# document the intent.
const outerPad: Float = 14.4578

const outerGap: Float = 8.6747  # old spaceM

# ----- per-section heights ------------------------------------------
const topBarH: Float = 34.6988

const heroBlockH: Float = 69.3976

const albumThumbSize: Float = 60.7229

const actionsRowH: Float = 31.8072

const pillsRowH: Float = 40.4819

const trackRowH: Float = 43.3735

const trackGap: Float = 2.8916  # old spaceXS

const miniPlayerH: Float = 57.8313

# 10% taller than the legacy tab bar so the floating iOS-style capsule
# has more top breathing room while the icon+label stack stays centered.
const navTabsH: Float = 63.6145

# ----- palette --------------------------------------------------------
# The app's named colors are derived LIVE from the active theme — there is no
# cached module-global palette state (#789: no globals). Each accessor maps an
# app color ROLE to a theme color NAME; call it with the current theme, which
# every builder already carries as `world.theme.active` (or, before the world is
# built, `appState.theme.active`). A theme toggle changes the colors on the very
# next read, so no explicit "sync" step is needed. `colorByName` is a cheap
# name lookup in the active theme's table.
func palettePageBg(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "background")
}

func paletteSurface(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "surface")
}

func paletteHero(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "textMuted")
}

func paletteIconTint(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "textPrimary")
}

func palettePill(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "accent")
}

func paletteOutline(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "outline")
}

func paletteLightText(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "accentText")
}

func paletteImageTint(theme: view Theme) ret RgbaColor {
  ret colorByName(theme: theme, name: "imageTint")
}

