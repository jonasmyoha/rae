open Math

func main() {
  # A fixed seed makes this example reproducible while still demonstrating
  # both integer and floating-point random values.
  var random: Random = createRandom(seed: 2026)

  loop var i: Int = 0, i < 8, ++i {
    let die: Int = random.nextInt(min: 1, max: 6)
    let unit: Float = random.nextFloat()
    log("sample {i}: die={die}, unit={unit}")
  }
}
