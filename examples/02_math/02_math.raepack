pack Math {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Functions and interpolation"
  description: "One step past Hello: functions with named arguments and explicit parameter modes, composition, and braced string interpolation — the one way a value becomes text in Rae. No graphics, no runtime specifics; just the language."
  featured: "true"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
