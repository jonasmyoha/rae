# Particle system. Lifetime-driven point sprites; the storage is a
# fixed-cap List(Particle) on World, with `active: Bool` as the free-slot
# flag. We never grow the list mid-game so spawning past the cap silently
# drops the request — keeps frame timing predictable.
import math
import vec3
open math

func randomRange(minimum: view Float, maximum: view Float) ret Float {
  ret minimum + (maximum - minimum) * math.random()
}

func findFreeParticle(w: mod World) ret Int {
  var i: Int = 0
  loop i < maxParticles {
    let cur: Particle = rae_ext_rae_buf_get(buf: w.particles.data, index: i)
    if cur.active is false {
      ret i
    }
    i = i + 1
  }
  ret -1
}

func spawnParticle(
  w: mod World
  px: view Float
  py: view Float
  pz: view Float
  vx: view Float
  vy: view Float
  vz: view Float
  life: view Float
  size: view Float
  color: view Vec3
) {
  let idx: Int = findFreeParticle(w)
  if idx < 0 {
    ret
  }
  let p: Particle = {
    active: true
    px: px
    py: py
    pz: pz
    vx: vx
    vy: vy
    vz: vz
    life: life
    size: size
    color: color
  }
  let particles: mod List(Particle) => w.particles
  particles.set(index: idx, value: p)
}

# Sprays particles outward along a row that just cleared. Called from
# physics.checkLines when a row is full.
func spawnLineClearParticles(w: mod World, row: view Int) {
  let cellY: Float = (0.0 - row.toFloat()) - 0.5
  var i: Int = 0
  loop i < gridWidth {
    let cellX: Float = i.toFloat() + 0.5
    # 4 small particles per cell of the cleared row.
    var burst: Int = 0
    loop burst < 4 {
      let vx: Float = randomRange(minimum: 0.0 - 4.0, maximum: 4.0)
      let vy: Float = randomRange(minimum: 2.0, maximum: 6.0)
      let vz: Float = randomRange(minimum: 0.0 - 4.0, maximum: 4.0)
      let colorId: Int = i % 7 + 1
      let color: Vec3 = kindColor(id: colorId)
      spawnParticle(
        w: w
        px: cellX
        py: cellY
        pz: 0.0
        vx: vx
        vy: vy
        vz: vz
        life: 0.7
        size: 0.18
        color: color
      )
      burst = burst + 1
    }
    i = i + 1
  }
}

# Update + cull active particles. Main's fixed-step accumulator drives this
# exactly at 60 Hz, independently from the deferred render rate.
func particleSystem(w: mod World) {
  let dt: Float = 0.016
  var i: Int = 0
  loop i < maxParticles {
    let p: Particle = rae_ext_rae_buf_get(buf: w.particles.data, index: i)
    if p.active {
      let newLife: Float = p.life - dt
      if newLife <= 0.0 {
        let dead: Particle = makeEmptyParticle()
        let particles: mod List(Particle) => w.particles
        particles.set(index: i, value: dead)
      } else {
        let nx: Float = p.px + p.vx * dt
        let ny: Float = p.py + p.vy * dt
        let nz: Float = p.pz + p.vz * dt
        # Simple gravity.
        let nvy: Float = p.vy - 9.8 * dt
        let updated: Particle = {
          active: true
          px: nx
          py: ny
          pz: nz
          vx: p.vx
          vy: nvy
          vz: p.vz
          life: newLife
          size: p.size
          color: p.color
        }
        let particles: mod List(Particle) => w.particles
        particles.set(index: i, value: updated)
      }
    }
    i = i + 1
  }
}
