# Tetris 3D on Rae's deferred renderer, SDL3 input, and ECS/.raescene UI.
import core
import gpu2d
import gbuffer
import math
import sys
import vec3
import renderer_deferred
import ui/ecs
import ui/RenderSystem/RenderSystem
import app3d/ui_shell
open app3d/ui_shell
open gbuffer
open gpu3d
open math
open renderer_deferred
open rendergraph
open scene3d
open ui/debug_overlay
open ui/ecs
open ui/RenderSystem/RenderSystem

func renderFrame(
  renderer: view DeferredRenderer
  renderState: mod TetrisRenderState
  game: view World
  camera: view Camera3d
  light: view Light3d
  uiWorld: mod UiWorld
  uiResources: view Gpu2dUi
  debug: mod DebugOverlay
) {
  extractTetrisScene(renderState: renderState, world: game)
  let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
  var passIndex: Int = 0
  loop passIndex < deferredOrderLength(r: renderer) {
    let tag: Int = deferredTagAt(r: renderer, i: passIndex)
    if tag is RenderTag.uiOverlay {
      gpu2d.beginFrameLoad()
      renderSystemGpu2d(world: uiWorld, res: uiResources)
      drawNextPiecePreview(kind: game.nextKind)
      drawDebugOverlay(d: debug, font: uiResources.textFont, didRealWork: true)
    } else {
      renderDeferredPass(
        r: renderer, tag: tag, scene: renderState.scene
        camera: camera, light: light, aspect: aspect)
    }
    passIndex = passIndex + 1
  }
  snapshotPrevTransforms(scene: renderState.scene)
}

func main() ret Int {
  gpu2d.initWindow(width: 900, height: 900, title: "Rae Tetris 3D — Deferred")
  gpu2d.setDesignResolution(width: 900.0, height: 900.0, fit: 0)
  seed(n: 2026)

  var game: World = {
    state: GameState.playing
    grid: createList(Int, cap: 0)
    currentPiece: { kind: TetrominoKind.i, x: 3, y: 0, rotation: 0 }
    nextKind: TetrominoKind.o
    score: 0, lines: 0, level: 1
    fallTimer: 0, fallDelay: 30
    hMoveTimer: 0, hMoveDelay: 4, dasDelay: 12
    lockTimer: 0, lockDelay: 30
    camTime: 0.0
    particles: createList(Particle, cap: 0)
    lockFlash: 0.0
  }
  initWorld(w: game)

  var renderState: TetrisRenderState = createTetrisRenderState()
  let camera: Camera3d = cameraForWorld(world: game)
  let light: Light3d = defaultLight3d()
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  let graphStatus: Int = compileDeferred(r: renderer)
  if graphStatus is not 0 {
    log("deferred graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }

  let uiResources: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: ""
    themeFile: "theme.raescene")
  var uiWorld: UiWorld = createUiWorld()
  let uiRoot: EntityId = mountUiScene(
    world: uiWorld
    path: "examples/97_tetris3d/assets/ui.raescene"
    res: uiResources)
  var hudState: TetrisHudState = createTetrisHudState()
  var dbg: DebugOverlay = createDebugOverlay(
    button: true, fps: true, memory: true, heartbeat: false)

  let testMode: Bool = sys.getEnv(name: "RAE_TETRIS3D_TEST_FRAME").length() > 0
  if testMode {
    game.score = 4200
    game.lines = 12
    game.level = 2
    var testX: Int = 0
    loop testX < gridWidth {
      gridSet(w: game, x: testX, y: gridHeight - 1, value: testX % 7 + 1)
      if testX % 2 is 0 {
        gridSet(w: game, x: testX, y: gridHeight - 2, value: testX % 7 + 1)
      }
      testX = testX + 1
    }
  }

  let fixedStep: Float64 = 1.0 / 60.0
  var previousTime: Float64 = gpu2d.nowSeconds()
  var accumulator: Float64 = 0.0
  var inputEdges: InputEdges = createInputEdges()
  loop not gpu2d.pollClose() {
    pollInputEdges(edges: inputEdges)
    let resized: Bool = resizeUiToWindow(world: uiWorld, res: uiResources)
    let now: Float64 = gpu2d.nowSeconds()
    if updateDebugOverlay(
      d: dbg, screenW: gpu2d.designWidth(), screenH: gpu2d.designHeight()
      now: now, didRealWork: true) {
    }
    var frameTime: Float64 = now - previousTime
    previousTime = now
    if frameTime > 0.1 { frameTime = 0.1 }
    accumulator = accumulator + frameTime
    if testMode is false {
      loop accumulator >= fixedStep {
        inputSystem(w: game, edges: inputEdges)
        clearInputEdges(edges: inputEdges)
        physicsSystem(w: game)
        particleSystem(w: game)
        cameraSystem(w: game)
        accumulator = accumulator - fixedStep
      }
    }
    syncTetrisHud(uiWorld: uiWorld, game: game, state: hudState)
    runUiSystems(world: uiWorld, res: uiResources)
    if gpu2d.renderGate() {
      renderFrame(
        renderer: renderer, renderState: renderState, game: game
        camera: camera, light: light
        uiWorld: uiWorld, uiResources: uiResources, debug: dbg)
    }
  }

  if testMode { log("[tetris3d] deterministic deferred frame rendered") }
  gbuffer.shutdownAll()
  gpu2d.closeWindow()
  ret 0
}
