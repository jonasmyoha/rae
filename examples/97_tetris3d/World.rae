# World — central component bag for the game. Shared mutably between
# systems via `mod World`, read-only via `view World`. The "ECS" here is
# a parallel-array layout over typed component lists; "entities" are
# implicit indices, not first-class IDs.
import Vec3

const gridWidth: Int = 10
const gridHeight: Int = 20
const maxParticles: Int = 64

enum GameState {
  menu
  playing
  paused
  gameOver
}

type Piece {
  kind: TetrominoKind
  x: Int
  y: Int
  rotation: Int
}

# A particle is a short-lived 3D point sprite. `active` is the free-slot
# flag — inactive slots are reused before the list grows.
type Particle {
  active: Bool
  px: Float
  py: Float
  pz: Float
  vx: Float
  vy: Float
  vz: Float
  life: Float
  size: Float
  color: Vec3
}

type World {
  state: GameState

  # Locked-board grid, row-major. 0 = empty, 1..7 = colour id.
  grid: List(Int)

  currentPiece: Piece
  nextKind: TetrominoKind

  # Score / progression
  score: Int
  lines: Int
  level: Int

  # Tick timers
  fallTimer: Int
  fallDelay: Int          # frames per row, decreases with level
  hMoveTimer: Int
  hMoveDelay: Int
  dasDelay: Int
  lockTimer: Int
  lockDelay: Int

  # Camera state (lerp targets are computed by cameraSystem)
  camTime: Float

  # Particles
  particles: List(Particle)

  # Visual flash on the most recently locked piece — fades over a few frames
  lockFlash: Float
}

func makeEmptyParticle() ret Particle {
  ret Particle {
    active: false
    px: 0.0
    py: 0.0
    pz: 0.0
    vx: 0.0
    vy: 0.0
    vz: 0.0
    life: 0.0
    size: 0.0
    color: Vec3 { x: 1.0, y: 1.0, z: 1.0 }
  }
}

func initWorld(world: mod World) {
  world.state = GameState.playing

  let grid: List(Int) = createList(cap: gridWidth * gridHeight)
  var i: Int = 0
  loop i < gridWidth * gridHeight {
    grid.add(value: 0)
    i = i + 1
  }
  world.grid = grid

  world.currentPiece = Piece { kind: randomKind(), x: 3, y: 0, rotation: 0 }
  world.nextKind = randomKind()

  world.score = 0
  world.lines = 0
  world.level = 1
  world.fallTimer = 0
  world.fallDelay = 30
  world.hMoveTimer = 0
  world.hMoveDelay = 4
  world.dasDelay = 12
  world.lockTimer = 0
  world.lockDelay = 30

  world.camTime = 0.0
  world.lockFlash = 0.0

  let particles: List(Particle) = createList(cap: maxParticles)
  var p: Int = 0
  let blank: Particle = makeEmptyParticle()
  loop p < maxParticles {
    add(particles, value: blank)
    p = p + 1
  }
  world.particles = particles
}

func gridGet(world: view World, x: view Int, y: view Int) ret Int {
  if x < 0 or x >= gridWidth or y < 0 or y >= gridHeight {
    ret 1
  }
  if let cell: Int = world.grid.copyAt(index: y * gridWidth + x) {
    ret cell
  }
  ret 1
}

func gridSet(world: mod World, x: view Int, y: view Int, value: view Int) {
  if x < 0 or x >= gridWidth or y < 0 or y >= gridHeight {
    ret
  }
  let g: mod List(Int) => world.grid
  g.set(index: y * gridWidth + x, value: value)
}
