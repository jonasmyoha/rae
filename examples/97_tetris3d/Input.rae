# Keyboard input. DAS (Delayed Auto-Shift) for repeat-side moves so
# the piece doesn't sprint at one frame per cell when you hold left/right.
import Sdl3

# SDL-compatible key codes (no enum because they're sparse and not 0..N).
const keyLeft: Int = 263
const keyRight: Int = 262
const keyDown: Int = 264
const keyUp: Int = 265
const keyA: Int = 65
const keyD: Int = 68
const keyS: Int = 83
const keyW: Int = 87
const keySpace: Int = 32
const keyP: Int = 80
const keyR: Int = 82

type InputEdges {
  restart: Bool
  pause: Bool
  rotate: Bool
  hardDrop: Bool
}

func createInputEdges() ret InputEdges {
  ret InputEdges {
    restart: false
    pause: false
    rotate: false
    hardDrop: false
  }
}

# SDL pressed edges last for one rendered frame, while gameplay advances on a
# fixed tick that may run zero or several times during that frame. Latch each
# edge until exactly one gameplay tick consumes it.
func pollInputEdges(edges: mod InputEdges) {
  if Sdl3.isKeyPressed(key: keyR) {
    edges.restart = true
  }
  if Sdl3.isKeyPressed(key: keyP) {
    edges.pause = true
  }
  if Sdl3.isKeyPressed(key: keyUp) or Sdl3.isKeyPressed(key: keyW) {
    edges.rotate = true
  }
  if Sdl3.isKeyPressed(key: keySpace) {
    edges.hardDrop = true
  }
}

func clearInputEdges(edges: mod InputEdges) {
  edges.restart = false
  edges.pause = false
  edges.rotate = false
  edges.hardDrop = false
}

func tryMove(world: mod World, dx: view Int, dr: view Int) {
  if canMove(world: world, dx: dx, dy: 0, dr: dr) is 1 {
    world.currentPiece.x = world.currentPiece.x + dx
    var newRot: Int = (world.currentPiece.rotation + dr) % 4
    if newRot < 0 {
      newRot = newRot + 4
    }
    world.currentPiece.rotation = newRot
    world.lockTimer = 0
  }
}

func tryRotate(world: mod World) {
  if canMove(world: world, dx: 0, dy: 0, dr: 1) is 1 {
    tryMove(world: world, dx: 0, dr: 1)
    ret
  }
  if canMove(world: world, dx: 1, dy: 0, dr: 1) is 1 {
    tryMove(world: world, dx: 1, dr: 1)
    ret
  }
  if canMove(world: world, dx: -1, dy: 0, dr: 1) is 1 {
    tryMove(world: world, dx: -1, dr: 1)
    ret
  }
  if canMove(world: world, dx: 2, dy: 0, dr: 1) is 1 {
    tryMove(world: world, dx: 2, dr: 1)
    ret
  }
  if canMove(world: world, dx: -2, dy: 0, dr: 1) is 1 {
    tryMove(world: world, dx: -2, dr: 1)
  }
}

# Hard drop: slam to the bottom and lock immediately.
func hardDrop(world: mod World) {
  loop canMove(world: world, dx: 0, dy: 1, dr: 0) is 1 {
    world.currentPiece.y = world.currentPiece.y + 1
    world.score = world.score + 2
  }
  lockPiece(world: world)
  checkLines(world: world)
  spawnNextPiece(world: world)
}

func inputSystem(world: mod World, edges: view InputEdges) {
  if world.state is GameState.gameOver {
    if edges.restart {
      initWorld(world)
    }
    ret
  }

  # P toggles between Playing and Paused. Handled BEFORE the
  # "skip-input-if-not-Playing" gate so the player can unpause.
  if edges.pause {
    if world.state is GameState.playing {
      world.state = GameState.paused
    } else {
      if world.state is GameState.paused {
        world.state = GameState.playing
      }
    }
  }

  if world.state is not GameState.playing {
    ret
  }

  let moveLeft: Bool = Sdl3.isKeyDown(key: keyLeft) or Sdl3.isKeyDown(key: keyA)
  let moveRight: Bool = Sdl3.isKeyDown(key: keyRight) or Sdl3.isKeyDown(key: keyD)

  if moveLeft or moveRight {
    if world.hMoveTimer is 0 {
      if moveLeft {
        tryMove(world: world, dx: -1, dr: 0)
      } else {
        tryMove(world: world, dx: 1, dr: 0)
      }
      world.hMoveTimer = 1
    } else {
      world.hMoveTimer = world.hMoveTimer + 1
      if world.hMoveTimer >= world.dasDelay {
        if (world.hMoveTimer - world.dasDelay) % world.hMoveDelay is 0 {
          if moveLeft {
            tryMove(world: world, dx: -1, dr: 0)
          } else {
            tryMove(world: world, dx: 1, dr: 0)
          }
        }
      }
    }
  } else {
    world.hMoveTimer = 0
  }

  # Soft drop (down arrow / S) — falls one row each frame, +1 point per row.
  if Sdl3.isKeyDown(key: keyDown) or Sdl3.isKeyDown(key: keyS) {
    if canMove(world: world, dx: 0, dy: 1, dr: 0) is 1 {
      world.currentPiece.y = world.currentPiece.y + 1
      world.score = world.score + 1
      world.fallTimer = 0
    }
  }

  # Rotate CCW with up / W.
  if edges.rotate {
    tryRotate(world: world)
  }

  # Hard drop with space.
  if edges.hardDrop {
    hardDrop(world: world)
  }
}
