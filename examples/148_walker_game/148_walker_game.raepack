pack WalkerGame {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "A game on the walker kit"
  description: "The forest walker with a game of its own: a box that spins near the walker, its own UI scene with a QrCode node, and with RAE_WALKER_QR=1 a cube the in-game camera reads."
  category: "UI"
  featured: "false"
  dependencies: {
    dep qr: {
      path: "../../packages/qr"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
