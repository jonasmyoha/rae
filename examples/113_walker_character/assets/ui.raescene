        "gap": "spaceS",
        "alignCross": "Start"
      },
      "Padding": {
        "l": "spaceM",
        "t": "spaceM",
        "r": "spaceM",
        "b": "spaceM"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
        "h": {
          "mode": "Hug"
        }
      },
