{
  "type": "Scene",
  "version": 2,
  "sceneId": "walker-ui",
  "root": "UiRoot",
  "nodes": {
    "UiRoot": {
      "Rect": {
        "x": 0,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "Layout": {
        "type": "Horizontal",
        "alignMain": "Start",
        "alignCross": "Start"
      },
      "Padding": {
        "l": "spaceL",
        "t": "spaceL",
        "r": "spaceL",
        "b": "spaceL"
      },
      "Size": {
        "w": {
          "mode": "Fill"
        },
