{
  "type": "Scene",
  "version": 2,
  "sceneId": "walker-ui",
  "root": "UiRoot",
  "nodes": {
    "UiRoot": {
      "Rect": { "x": 0, "y": 0, "w": 1280, "h": 800 },
      "Layout": { "type": "Vertical", "alignMain": "End", "alignCross": "Start" },
      "Padding": { "l": "spaceL", "t": "spaceL", "r": "spaceL", "b": "spaceL" },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fill" } },
      "Children": ["ControlPanel"]
    },
    "ControlPanel": {
      "Layout": { "type": "Vertical", "gap": "spaceS", "alignCross": "Start" },
      "Padding": { "l": "spaceM", "t": "spaceM", "r": "spaceM", "b": "spaceM" },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Hug" } },
      "Shape": { "kind": "RoundedRect", "fill": "surface", "radius": "radiusCard" },
      "Children": ["PanelTitle", "ClipRow", "TransportRow"]
    },
    "PanelTitle": {
      "Rect": { "x": 0, "y": 0, "w": 200, "h": 16 },
      "Text": { "text": "Animation", "styleId": "panelTitle" }
    },
    "ClipRow": {
      "Layout": { "type": "Horizontal", "gap": "spaceS", "alignCross": "Center" },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Hug" } },
      "Children": []
    },
    "TransportRow": {
      "Layout": { "type": "Horizontal", "gap": "spaceS", "alignCross": "Center" },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Hug" } },
      "Children": ["SpeedLabel"]
    },
    "SpeedLabel": {
      "Rect": { "x": 0, "y": 0, "w": 110, "h": 34 },
      "Text": { "text": "Speed 100%", "styleId": "muted" },
      "OpticalAlign": { "centerY": true }
    }
  }
}
