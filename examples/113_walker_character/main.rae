# Walker character — a multi-primitive rigged glTF model, ANIMATED (#377).
#
# Loads the walker project's character from .glb, skins it on the GPU and
# plays Mixamo clips on it. Where example 112 (the Fox) is one primitive
# with no normals and no indices, this is the opposite shape: 65 joints,
# 10 meshes / 12 primitives, every one of them indexed and carrying
# normals. Between them they cover both ends of what real exporters
# produce.
#
# THE CLIPS LIVE IN THEIR OWN FILES. idle/walk/run are separate .glb
# exports that contain animation and no mesh — the standard way animation
# libraries ship — so each is retargeted onto this character's skeleton by
# JOINT NAME at load (see lib/gltf_skin.rae). "Walk fast" is the walk clip
# played at 1.6x rather than a fourth file, which is what a speed control
# is for.
#
# A clip PLAYS FROM THE FIRST FRAME. An example that opens paused
# demonstrates nothing until someone clicks it.
#
# THE UI IS A REAL .raescene, built on the shared app3d modules. The
# scene (assets/ui.raescene) authors only the panel CHROME — a vertical
# card with two auto-laid-out rows — and the buttons are declared in code
# and inserted by lib/app3d/control_panel.rae. Nothing here places a
# button by coordinate, so adding one is one line. Colours come from
# assets/theme.raescene through palette slots, and the camera comes from
# lib/app3d/camera_rig.rae, so this example shares its look and its feel
# with example 110 rather than reimplementing both.
#
# WHAT THIS EXAMPLE EXISTS TO PROVE. Each of the model's twelve
# primitives is loaded and drawn SEPARATELY, so each can carry its own
# material. A character is rarely one primitive — glTF splits geometry
# per material — and loading only the first renders a disembodied
# fragment that looks like a broken import rather than a partial one.
# (`loadAllPrimitives` merges them into one buffer instead, which is
# cheaper but cannot keep per-primitive materials.)
#
# COLOURS COME FROM THE MODEL'S PALETTE TEXTURE, sampled AT LOAD.
#
# The character is textured with a flat palette atlas — solid colour
# swatches, the standard low-poly technique. assets/walker_palette.png is
# decoded by lib/png (pure Rae, no C image library) and sampled at every
# vertex UV, and the result rides in the skinned vertex format's colour
# channel (#378). Because the atlas is FLAT, every triangle whose corners
# land in one swatch interpolates to that swatch exactly, so this is not
# an approximation of texturing for this model — it IS the texturing.
#
# This replaces a hand-written table of dominant swatches. That table was
# exact for nine of the twelve primitives and flattened three: the body
# (61% skin over 17 swatches), the trim (51%) and the boots (86%). Those
# three now carry their real per-vertex colour.
#
# A CORRECTION IS RECORDED HERE deliberately. An earlier version of this
# file claimed the model carried no colour at all. That was wrong, and the
# cause was mine: I sampled the atlas with an OpenGL-style V flip, but
# glTF's UV origin is the TOP-LEFT with v increasing downward. The flip
# sent every lookup into the atlas's blank lower region, which returns
# white — a result that looks exactly like "this texture does not belong
# to this mesh". The UV ranges were the tell: v spans 0.007 to 0.19, which
# is the top of the image, not the bottom.
#
# FRAMING IS COMPUTED, NOT HARD-CODED. Exporters leave a model wherever it
# sat in the authoring scene; this one sits about 13 units above its own
# origin. Rather than bake an offset that is correct for exactly this
# file, the example measures the loaded bounds and places and scales from
# them, so dropping in a different model still frames it.
#
# The model is Y-up (glTF's convention); Rae is Z-up
# (docs/coordinate-system.md), hence the rotation.
#
# See assets/ATTRIBUTION.md for provenance — the mesh is the walker
# project's, the skeleton is Mixamo's — and tools/README.md for how the
# .glb is regenerated from the source FBX.
#
# Compiled-target only; needs wgpu-native + SDL3.
#   rae run --target compiled main.rae
# Headless screenshot:
#   RAE_SDL_HEADLESS_MS=1000 RAE_GPU2D_SCREENSHOT=/tmp/walker.bmp \
#     rae run --target compiled main.rae
import core
import math
import gpu2d
import sdf_text
import vec3
import gltf
import gltf_skin
import png
import sys
import app3d/camera_rig
import app3d/ui_shell
import app3d/control_panel
import app3d/camera_bar
import renderer_deferred
import sky
import gbuffer
import shadow3d
import app3d/playback
import app3d/slider
import app3d/settings_dialog
import hot_reload
import ui/log_overlay
import ui/ecs
import ui/input_gpu2d
import ui/render_gpu2d
open scene3d
open gpu3d
open renderer_deferred
open sky
open gbuffer
open rendergraph
open math3d
open mesh3d
open gltf
open gltf_skin
open sdf_text
open png
open app3d/camera_rig
open app3d/settings_dialog
open app3d/ui_shell
open app3d/control_panel
open app3d/camera_bar
open shadow3d
open app3d/playback
open hot_reload
open ui/log_overlay
open ui/ecs
open ui/components
open ui/input_gpu2d
open ui/render_gpu2d

func uploadMeshData(m: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: m.verts, vertCount: m.vertCount, indices: m.indices)
}


# The clip button ids, indexed the same way `clipIndex` is. One table
# rather than two if-chains: a restored index and a click have to agree
# on which button is selected, and two copies drift.
func clipButtonId(index: view Int) ret String {
  if index is 0 { ret "idle" }
  if index is 1 { ret "walk" }
  if index is 2 { ret "walkFast" }
  ret "run"
}

# ----- state that survives a hot reload -------------------------------
# A hot reload is a process exit and relaunch, so anything held only in
# locals is gone. For this example that means the camera, the window, and
# which clip was playing — re-choosing all three after every rebuild is
# most of the friction in iterating on an animation.
#
# One space-separated line behind a version tag rather than JSON: a bad or
# older line must degrade to "start fresh" rather than half-apply, and a
# version mismatch is then a single comparison. The camera's ten fields
# and the window's four are the shared formats from lib/app3d, so this
# example only owns the four at the front.
const state113Version: Int = 4
const state113AppId: String = "113_walker_character"
const state113OwnFields: Int = 5

func serialize113State(clipIndex: view Int, playing: view Bool, speed: view Float,
                       toon: view Bool, rig: view CameraRig, camera: view Camera3d) ret String {
  var playingNum: Int = 0
  if playing {
    playingNum = 1
  }
  var toonNum: Int = 0
  if toon {
    toonNum = 1
  }
  ret "{state113Version} {clipIndex} {playingNum} {speed} {toonNum} {cameraRigStateString(rig: rig, camera: camera)} {windowPlacementString()}"
}

func restore113State(raw: view String, clipIndex: mod Int, playing: mod Bool, speed: mod Float,
                     toon: mod Bool, rig: mod CameraRig, camera: mod Camera3d) ret Bool {
  if raw.length() < 1 {
    ret false
  }
  let parts: List(String) = raw.trim().split(sep: " ")
  if parts.length < state113OwnFields {
    ret false
  }
  if parts.at(index: 0).trim().toInt() is not state113Version {
    ret false
  }
  clipIndex = parts.at(index: 1).trim().toInt()
  if clipIndex < 0 {
    clipIndex = 0
  }
  if clipIndex > 3 {
    clipIndex = 3
  }
  playing = parts.at(index: 2).trim().toInt() is 1
  speed = parts.at(index: 3).trim().toFloat()
  if speed < speedMin {
    speed = speedMin
  }
  if speed > speedMax {
    speed = speedMax
  }
  toon = parts.at(index: 4).trim().toInt() is 1
  if applyCameraRigState(parts: parts, offset: state113OwnFields, rig: rig, camera: camera) is false {
    ret false
  }
  # The window is the one part allowed to fail on its own: a snapshot
  # written on a monitor that is no longer attached should still restore
  # the camera and the clip.
  applyWindowPlacement(parts: parts, offset: state113OwnFields + cameraRigFields)
  ret true
}

func main() ret Int {
  gpu2d.initWindow(width: 1280, height: 800, title: "Rae 3D — walker character (animated) [{rendererPathName()}]")
  var extentW: Float = windowExtentW()
  var extentH: Float = windowExtentH()
  gpu2d.setDesignResolution(width: extentW, height: extentH, fit: 0)

  let assets: String = "examples/113_walker_character/assets/"
  # Fonts + theme + a UiWorld with assets/ui.raescene mounted. The empty
  # icon-font name says "no `mat:` glyphs here", so this example does not
  # ship the megabyte icon atlas it would never sample.
  let gpuUi: Gpu2dUi = loadUiAssets(dir: assets, textFontName: "Roboto-Regular",
                                    iconFontName: "", themeFile: "theme.raescene")
  var uiWorld: UiWorld = createUiWorld()
  let uiRoot: EntityId = mountUiScene(world: uiWorld, path: "{assets}ui.raescene", res: gpuUi)
  var uiInput: UiInput = createUiInput()

  # Diagnostic log overlay (lib/ui/log_overlay.rae), bottom-right so it
  # does not sit under the control panel. Its first job is making hot
  # reloads visible: a rebuilt binary that failed to relaunch looks
  # exactly like one that reloaded and changed nothing, so the launch
  # generation is printed — watching 5 become 6 is the proof.
  var logView: LogOverlay = createLogOverlay(capacity: 64, maxLines: 8, anchor: logAnchorBottomRight, fontSize: 14.0)
  let reloadGen: Int = nextReloadGeneration()
  logInfoLine(ov: logView, text: "hot reload {reloadGen}")

  let g: Glb = loadGlb(path: "{assets}walker.glb")
  if g.ok is false {
    log("[gltf] {g.errorMsg}")
    log("[gltf] regenerate assets/walker.glb — see tools/README.md")
    gpu2d.closeWindow()
    ret 1
  }
  # Load once merged, purely to measure the whole model's bounds — the
  # framing below has to consider every part, not just the first.
  let charData: MeshData = loadAllPrimitives(g: g)
  if charData.vertCount is 0 {
    log("[gltf] model contained no readable primitives")
    gpu2d.closeWindow()
    ret 1
  }
  log("[gltf] walker: {charData.vertCount} verts, {charData.indices.length / 3} triangles")

  # Measure what was loaded and derive the placement from it. `height` is
  # the model's own Y extent (still glTF's Y-up at this point), and the
  # scale maps that to a fixed on-screen height so any model arrives the
  # same size regardless of the units it was authored in.
  let b: List(Float) = meshBounds(m: charData)
  let height: Float = b.at(index: 4) - b.at(index: 1)
  let targetHeight: Float = 2.0
  var modelScale: Float = 1.0
  if height > 0.0 {
    modelScale = targetHeight / height
  }
  # Centre of the model's footprint, and the height of its lowest point,
  # both in model units. Subtracting them puts the model's feet on the
  # ground plane and its centre on the world axis.
  let midX: Float = (b.at(index: 0) + b.at(index: 3)) * 0.5
  let midZ: Float = (b.at(index: 2) + b.at(index: 5)) * 0.5
  let footY: Float = b.at(index: 1)
  log("[gltf] bounds height {height}, scale {modelScale}")

  # The skeleton. Everything below animates by mutating its node TRS and
  # rebuilding the palette; the vertex buffers never change.
  var sk: Skeleton = loadSkeleton(g: g, skinIndex: 0)
  if sk.ok is false {
    log("[gltf] walker.glb has no skin — cannot animate")
    gpu2d.closeWindow()
    ret 1
  }
  log("[gltf] skeleton: {jointCount(sk: sk)} joints, {sk.nodeCount} nodes")

  # Clips, retargeted onto `sk` by joint name at load. Loaded from their
  # own files, each of which carries animation and no geometry.
  let idleGlb: Glb = loadGlb(path: "{assets}idle.glb")
  let walkGlb: Glb = loadGlb(path: "{assets}walk.glb")
  let runGlb: Glb = loadGlb(path: "{assets}run.glb")
  let idleClip: Clip = loadClip(g: idleGlb, animIndex: 0, sk: sk)
  let walkClip: Clip = loadClip(g: walkGlb, animIndex: 0, sk: sk)
  let runClip: Clip = loadClip(g: runGlb, animIndex: 0, sk: sk)
  log("[anim] idle {clipChannelCount(c: idleClip)} ch / {idleClip.duration}s, walk {clipChannelCount(c: walkClip)} ch / {walkClip.duration}s, run {clipChannelCount(c: runClip)} ch / {runClip.duration}s")

  let planeData: MeshData = makePlane(size: 20.0, segments: 1)
  let ground: MeshHandle = uploadMeshData(m: planeData)

  var scene: Scene3d = createScene3d()
  let noEmit: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRot: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let groundZ: Float = 0.0 - 1.0

  # Y-up -> Z-up is +90 degrees about X. After that rotation the model's
  # own Y becomes world Z, so the Y-based offsets below are applied along
  # the axes they land on rather than the ones they came from. Every part
  # shares this transform, which is what keeps them assembled.
  let partTransform: Transform3d = {
    position: vec3.create(
      x: 0.0 - midX * modelScale,
      y: 0.0 - midZ * modelScale,
      z: groundZ - footY * modelScale
    ),
    rotation: vec3.create(x: 1.5707963, y: 0.0, z: 0.0),
    scale: vec3.create(x: modelScale, y: modelScale, z: modelScale)
  }
  # Constant for the life of the program: skinning moves the VERTICES, so
  # the model matrix that places the character in the world never changes.
  let partModel: Mat4 = modelMatrix(t: partTransform)

  # The palette atlas, decoded by lib/png — pure Rae, no C image library.
  # A failed decode is not fatal: `withAtlasColors` leaves the vertex
  # colour channel white, so the model renders in flat material colour
  # rather than not at all.
  let pngBytes: List(Int) = sys.readFileBytes(path: "{assets}walker_palette.png")
  var atlasW: Int = 0
  var atlasH: Int = 0
  let atlas: List(Int) = decodePng(png: pngBytes, len: pngBytes.length, width: atlasW, height: atlasH)
  if atlasW is 0 {
    log("[png] walker_palette.png did not decode — parts will render untinted")
  } else {
    log("[png] palette atlas {atlasW}x{atlasH}")
  }

  # One SKINNED mesh per primitive. Base colour is white: the real colour
  # rides per-vertex, sampled from the atlas above. Only ROUGHNESS still
  # varies per mesh, and it comes from the authored mesh name, which is
  # the only handle on which body part it is when the materials carry
  # nothing.
  let partIds: List(Int) = createList(Int, cap: 16)
  let partRough: List(Float) = createList(Float, cap: 16)
  var mi: Int = 0
  loop mi < meshCount(g: g) {
    let name: String = meshName(g: g, meshIndex: mi)
    var rough: Float = 0.68
    if name.startsWith(prefix: "Cylinder") {
      # The staff and the metal fittings are the one non-cloth surface, so
      # they get the only low-roughness material.
      rough = 0.35
    }
    var pi: Int = 0
    loop pi < primitiveCount(g: g, meshIndex: mi) {
      let raw: SkinnedMeshData = loadSkinnedPrimitive(g: g, meshIndex: mi, primIndex: pi)
      if raw.vertCount > 0 {
        let part: SkinnedMeshData = withAtlasColors(m: raw, atlas: atlas, width: atlasW, height: atlasH)
        let handle: MeshHandle = uploadSkinnedMesh(verts: part.verts, vertCount: part.vertCount, indices: part.indices)
        if meshHandleIsValid(h: handle) {
          partIds.add(value: handle.id)
          partRough.add(value: rough)
        }
      }
      pi = pi + 1
    }
    mi = mi + 1
  }
  log("[gltf] skinned parts: {partIds.length}")
  if partIds.length is 0 {
    log("[gltf] no skinned primitives uploaded")
    gpu2d.closeWindow()
    ret 1
  }

  # Grass green. Base colours here are LINEAR, so these are not the
  # numbers a colour picker would show for the same green — an sRGB
  # 0.42/0.62/0.28 lands near this once the transfer curve is undone, and
  # entering the sRGB values directly would render a washed-out mint.
  let groundMat: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.148, y: 0.336, z: 0.064), metallic: 0.0, roughness: 0.9, emission: noEmit)
  let groundE: Int = addMeshInstance(
    scene: scene, mesh: ground, material: groundMat,
    position: vec3.create(x: 0.0, y: 0.0, z: groundZ), rotation: noRot,
    scale: vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )

  var camera: Camera3d = defaultCamera3d()
  var light: Light3d = defaultLight3d()
  camera.target = vec3.create(x: 0.0, y: 0.0, z: groundZ + targetHeight * 0.5)

  # The UI variant of the frame: the overlay MODIFIES the LDR target after
  # tonemap, and the graph derives that ordering from the declaration.
    # A PAINTED sky (#404), banded like the toon terminator.
  #
  # THE SAME TWO COLOURS FEED THE SKY AND THE AMBIENT, which is what
  # keeps the character's shadows agreeing with what is behind them: the
  # toon path tints shadows toward the sky ambient, so a sky whose
  # palette was picked independently would put the two at odds. Warm pale
  # horizon under a deeper blue zenith, three bands.
  var renderer: DeferredRenderer = createDeferredRendererWithUiSky(
    sky: createSkyStylised(
      sunDir: light.sunDir, sunColor: light.sunColor,
      zenith: vec3.create(x: 0.16, y: 0.34, z: 0.62),
      horizon: vec3.create(x: 0.74, y: 0.80, z: 0.72),
      bands: 3.0))
  let gs: Int = compileDeferred(r: renderer)
  if gs is not 0 {
    log("render graph invalid: {statusName(status: gs)}")
    gpu2d.closeWindow()
    ret 1
  }

  # Shared orbit/fly rig (lib/app3d/camera_rig.rae). Only the framing
  # numbers are per-example: this scene is a 2-metre character, not the
  # 36-metre one the rig's defaults are sized for.
  var rig: CameraRig = createCameraRig(camera: camera)
  rig.yaw = 0.6
  rig.orbitPitch = 0.18
  rig.distance = 4.2
  rig.minDistance = 1.2
  rig.maxDistance = 20.0
  rig.wheelSpeed = 0.4

  # Animation state. Clip 1 (walk) plays from the first frame — see the
  # note in the file header.
  var clipIndex: Int = 1
  var playing: Bool = true
  var speed: Float = 1.0
  var animTime: Float = 0.0
  # Toon ON by default (#396): this example is the one that shows the
  # style off, and a feature that has to be switched on to be seen mostly
  # goes unseen. The ground stays PBR either way, so the frame always
  # shows both shading models side by side.
  var toonShading: Bool = true

  # The controls. Two panels because the scene authors two auto-laid-out
  # rows; neither this code nor the scene positions a single button.
  # Group 1 is a radio set, so selecting one clip deselects the rest.
  var clipPanel: ControlPanel = createControlPanel(hostNodeId: "ClipRow")
  addPanelButton(panel: clipPanel, id: "idle", label: "Idle", actionId: "clip.idle", group: 1)
  addPanelButton(panel: clipPanel, id: "walk", label: "Walk", actionId: "clip.walk", group: 1)
  addPanelButton(panel: clipPanel, id: "walkFast", label: "Walk fast", actionId: "clip.walkFast", group: 1)
  addPanelButton(panel: clipPanel, id: "run", label: "Run", actionId: "clip.run", group: 1)
  buildControlPanel(panel: clipPanel, world: uiWorld, res: gpuUi)

  # Group 0: independent controls, not a radio set. Play is a toggle;
  # the two speed buttons are plain actions.
  var transport: ControlPanel = createControlPanel(hostNodeId: "TransportRow")
  addPanelButton(panel: transport, id: "play", label: "Pause", actionId: "anim.play", group: 0)
  addPanelButton(panel: transport, id: "slower", label: "Slower", actionId: "anim.slower", group: 0)
  addPanelButton(panel: transport, id: "faster", label: "Faster", actionId: "anim.faster", group: 0)
  # Group 0, so it toggles independently rather than deselecting a clip.
  addPanelButton(panel: transport, id: "toon", label: "Toon", actionId: "style.toon", group: 0)
  transport.buttonW = 84.0
  buildControlPanel(panel: transport, world: uiWorld, res: gpuUi)

  # A HEADLESS run never restores. Headless means a screenshot or a smoke
  # test, and those assert against a defined starting state; inheriting
  # whatever clip and camera a developer left behind makes the result
  # depend on machine-local history. Example 110 learned this the hard
  # way — a restored camera turned its gate red on one machine and green
  # on a clean checkout.
  let headless: Bool = sys.getEnv(name: "RAE_SDL_HEADLESS_MS").length() > 0
    or sys.getEnv(name: "RAE_HEADLESS_FRAMES").length() > 0
  if not headless {
    let saved: String = readHotReloadStateFor(appId: state113AppId)
    if restore113State(raw: saved, clipIndex: clipIndex, playing: playing, speed: speed,
                       toon: toonShading, rig: rig, camera: camera) {
      let pctR: Int = speedPercent(v: speed)
      logInfoLine(ov: logView, text: "state restored: clip {clipIndex}, speed {pctR}%, camera and window kept")
    }
  }

  setPanelSelection(panel: clipPanel, world: uiWorld, group: 1, id: clipButtonId(index: clipIndex))
  setPanelButtonOn(panel: transport, world: uiWorld, id: "play", on: playing)
  setPanelButtonOn(panel: transport, world: uiWorld, id: "toon", on: toonShading)
  var playLabel0: String = "Pause"
  if not playing {
    playLabel0 = "Play"
  }
  setPanelButtonLabel(panel: transport, world: uiWorld, id: "play", label: playLabel0)
  let pct0: Int = speedPercent(v: speed)
  setNodeText(world: uiWorld, nodeId: "SpeedLabel", value: "Speed {pct0}%")
  runUiSystems(world: uiWorld, res: gpuUi)

  # Save on CHANGE rather than only at exit: this example does not watch
  # for a reload signal, so a supervisor is free to kill it without
  # warning and an exit-only save would lose everything. Throttled,
  # because a camera drag changes state every frame.
  var shadowLogged: Bool = false
  var stateDirty: Bool = false
  var lastStateSave: Float64 = gpu2d.nowSeconds()
  # Counted, not assumed: a panel whose host node id does not match the
  # scene builds nothing and renders as an empty card, which a
  # "did anything paint" check cannot tell from a working one.
  # The camera readout bar is the SAME component example 110 uses; this
  # example only supplies the slot it mounts into.
  let barOk: Bool = mountCameraBar(world: uiWorld, res: gpuUi, hostNodeId: "CameraBarSlot")
  # One scene here, but the chooser still appears: the dialog refuses a
  # selection it cannot honour rather than hiding the control (see 594).
  var settings: SettingsState = createSettingsState(scene: 1, sceneCount: 1,
                                                    speed: speed, toon: toonShading,
                                                    hour: 12.0)
  let settingsOk: Bool = mountSettingsDialog(world: uiWorld, res: gpuUi,
                                             hostNodeId: "SettingsDialogSlot")
  if settingsOk is false {
    logWarnLine(ov: logView, text: "settings dialog failed to mount")
  }
  settingsApplyToWorld(s: settings, world: uiWorld)
  log("[ui] panel buttons: {clipPanel.buttonEntities.length} clip, {transport.buttonEntities.length} transport, camera bar {barOk}")

  let startT: Float64 = gpu2d.nowSeconds()
  var prevT: Float64 = startT
  loop not gpu2d.pollClose() {
    resizeUiToWindow(world: uiWorld, res: gpuUi)

    let now: Float64 = gpu2d.nowSeconds()
    var dt: Float = (now - prevT) as Float
    prevT = now
    # A long stall (a resize, a breakpoint) must not teleport the pose a
    # second and a half forward; clamp rather than integrate the gap.
    if dt > 0.1 {
      dt = 0.1
    }
    if dt < 0.0 {
      dt = 0.0
    }

    # ----- controls ---------------------------------------------------
    # Hit-testing happens against the UI's real rectangles, so the camera
    # is suppressed by what is actually under the pointer rather than by
    # a hand-maintained copy of the panel's bounds.
    updateUiInput(input: uiInput, world: uiWorld)
    let clipHit: String = panelClickedId(panel: clipPanel, input: uiInput)
    if clipHit.length() > 0 {
      if clipHit.equals(other: "idle") { clipIndex = 0 }
      if clipHit.equals(other: "walk") { clipIndex = 1 }
      if clipHit.equals(other: "walkFast") { clipIndex = 2 }
      if clipHit.equals(other: "run") { clipIndex = 3 }
      animTime = 0.0
      setPanelSelection(panel: clipPanel, world: uiWorld, group: 1, id: clipHit)
    }
    let transportHit: String = panelClickedId(panel: transport, input: uiInput)
    if transportHit.equals(other: "play") {
      playing = not playing
      var playLabel: String = "Pause"
      if not playing {
        playLabel = "Play"
      }
      setPanelButtonLabel(panel: transport, world: uiWorld, id: "play", label: playLabel)
      setPanelButtonOn(panel: transport, world: uiWorld, id: "play", on: playing)
    }
    if transportHit.equals(other: "toon") {
      toonShading = not toonShading
      setPanelButtonOn(panel: transport, world: uiWorld, id: "toon", on: toonShading)
    }
    if transportHit.equals(other: "slower") { speed = nextSpeed(current: speed, up: false) }
    if transportHit.equals(other: "faster") { speed = nextSpeed(current: speed, up: true) }
    if transportHit.length() > 0 {
      let pct: Int = speedPercent(v: speed)
      setNodeText(world: uiWorld, nodeId: "SpeedLabel", value: "Speed {pct}%")
    }
    # The shared dialog sees every action, including the panel's own — it
    # ignores what it does not own, so there is no list to keep in sync here.
    var settingsChanged: Bool = false
    var ai: Int = 0
    loop ai < uiActionCount(input: uiInput) {
      if settingsHandleAction(s: settings, actionId: uiActionAt(input: uiInput, index: ai)) {
        settingsChanged = true
      }
      ai = ai + 1
    }
    if settingsUpdatePointer(s: settings, world: uiWorld, input: uiInput) {
      settingsChanged = true
    }
    if settingsChanged {
      # The dialog is the source of truth for what it owns; the panel controls
      # write INTO it above, so mirroring back keeps one value per setting
      # rather than two that can disagree.
      speed = settings.speed
      if toonShading is not settings.toon {
        toonShading = settings.toon
        setPanelButtonOn(panel: transport, world: uiWorld, id: "toon", on: toonShading)
      }
      let pctS: Int = speedPercent(v: speed)
      setNodeText(world: uiWorld, nodeId: "SpeedLabel", value: "Speed {pctS}%")
      settingsApplyToWorld(s: settings, world: uiWorld)
      stateDirty = true
    }
    if clipHit.length() > 0 or transportHit.length() > 0 {
      # Panel and dialog share these two values.
      settings.speed = speed
      settings.toon = toonShading
      settingsApplyToWorld(s: settings, world: uiWorld)
      stateDirty = true
    }
    if uiActionCount(input: uiInput) > 0 {
      runUiSystems(world: uiWorld, res: gpuUi)
    }

    if handleCameraBar(input: uiInput, rig: rig, camera: camera) {
      stateDirty = true
    }
    if updateCameraRig(rig: rig, camera: camera,
                       allowInput: uiPointerCaptured(input: uiInput) is false, dt: dt) {
      stateDirty = true
    }
    if gpu2d.windowResized() {
      stateDirty = true
    }

    # Flush at most 4x/sec. The snapshot is twenty numbers, so the cost is
    # the file write rather than the formatting.
    if stateDirty and not headless {
      if (now - lastStateSave) as Float >= 0.25 {
        writeHotReloadStateFor(appId: state113AppId,
                               state: serialize113State(clipIndex: clipIndex, playing: playing,
                                                        speed: speed, toon: toonShading,
                                                        rig: rig, camera: camera))
        lastStateSave = now
        stateDirty = false
      }
    }

    # ----- animation -------------------------------------------------
    # "Walk fast" is the walk clip at 1.6x, not a fourth asset.
    var clipRate: Float = 1.0
    if clipIndex is 2 {
      clipRate = 1.6
    }
    if playing {
      animTime = animTime + dt * speed * clipRate
    }
    if clipIndex is 0 {
      applyClip(sk: sk, c: idleClip, time: animTime)
    }
    if clipIndex is 1 or clipIndex is 2 {
      applyClip(sk: sk, c: walkClip, time: animTime)
    }
    if clipIndex is 3 {
      applyClip(sk: sk, c: runClip, time: animTime)
    }
    let palette: List(Float) = buildPalette(sk: sk)

    applyCameraRig(rig: rig, camera: camera)
    syncCameraBar(world: uiWorld, rig: rig, camera: camera)
    let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
    let t: Float = (now - startT) as Float

    # Frame order is DERIVED by the render graph: the scene pass writes
    # hdrColor, tonemap resolves it to sceneColor, the overlay modifies
    # that, present reads it. This loop walks the derived order.
    var oi: Int = 0
    loop oi < deferredOrderLength(r: renderer) {
      let tag: Int = deferredTagAt(r: renderer, i: oi)
      if tag is tagShadowD {
        # Cascades fitted to this frame, then every caster rasterised into
        # them (#382). The ground comes from the scene; the character's
        # twelve skinned parts are submitted individually, through the
        # SKINNED shadow pipeline so they cast in their animated pose
        # rather than in bind pose.
        let cascades: ShadowCascades = fitShadowCascades(
          camPos: camera.position, camTarget: camera.target,
          fovYDeg: camera.fovYDeg, aspect: aspect,
          near: camera.nearZ, far: 24.0, sunDir: light.sunDir,
          count: 3, resolution: 2048, lambda: 0.75, backExtent: 12.0
        )
        uploadPalette(rows: palette, jointCount: jointCount(sk: sk))
        beginShadowPass(c: cascades)
        renderSceneShadow(scene: scene)
        var sp: Int = 0
        loop sp < partIds.length {
          let sh: MeshHandle = meshHandle(id: partIds.at(index: sp), generation: 1)
          drawShadowCasterSkinned(mesh: sh, model: partModel)
          sp = sp + 1
        }
        endShadowPass()
        if shadowLogged is false {
          log("[shadow] casters {shadowCasterCount()}, {cascades.count} cascades at {cascades.resolution}")
          shadowLogged = true
        }
      }
      if tag is tagGbuffer {
        # The app owns this tag rather than letting renderDeferredPass
        # handle it, because the character's twelve SKINNED parts have to
        # land inside the same G-buffer pass as the ground. Same seam the
        # UI overlay uses: the graph still decides when this runs.
        # QUALIFIED. gpu3d and gbuffer both export beginPass/endPass, and
        # this example opens both — an unqualified call silently picks the
        # forward path's, which ends a pass that was never begun and
        # leaves the G-buffer unsubmitted. The symptom is a black 3D frame
        # with a working UI, which looks like a lighting bug.
        gbuffer.beginPass(camera: camera, light: light, aspect: aspect)
        gbuffer.renderScene(scene: scene)
        uploadPalette(rows: palette, jointCount: jointCount(sk: sk))
        var p: Int = 0
        loop p < partIds.length {
          let handle: MeshHandle = meshHandle(id: partIds.at(index: p), generation: 1)
          # White base colour: the shader multiplies it by the vertex
          # colour baked from the atlas (#378).
          let mat: Material3d = {
            baseColor: vec3.create(x: 1.0, y: 1.0, z: 1.0),
            metallic: 0.0,
            roughness: partRough.at(index: p),
            emission: noEmit,
            # The style applies to the CHARACTER only, deliberately: the
            # ground stays PBR so the two shading models are visible in
            # one frame under one sun, which is the thing per-material
            # toon buys over a whole-frame switch.
            toon: toonShading
          }
          gbuffer.drawSkinnedInstance(mesh: handle, model: partModel,
                                      prevModel: partModel, material: mat)
          p = p + 1
        }
        gbuffer.endPass()
      }
      if tag is tagSsaoD or tag is tagDepthPyramid or tag is tagLighting
        or tag is tagTaaD or tag is tagComposite {
        renderDeferredPass(r: renderer, tag: tag, scene: scene,
                           camera: camera, light: light, aspect: aspect)
      }
      if tag is tagUiOverlayD {
        # Load-preserving: paints over the composited frame.
        gpu2d.beginFrameLoad()
        renderSystemGpu2d(world: uiWorld, res: gpuUi)
        drawLogOverlay(ov: logView, font: gpuUi.textFont, screenW: windowExtentW(), screenH: windowExtentH())
      }
      if tag is tagPresentD {
        gpu2d.endFrame()
      }
      oi = oi + 1
    }
    snapshotPrevTransforms(scene: scene)
  }
  skinShutdown()
  shutdown()
  gpu2d.closeWindow()
  ret 0
}
