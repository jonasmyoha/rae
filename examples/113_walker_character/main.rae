# Walker character — a multi-primitive rigged glTF model, ANIMATED (#377).
#
# Loads the walker project's character from .glb, skins it on the GPU and
# plays Mixamo clips on it. Where example 112 (the Fox) is one primitive
# with no normals and no indices, this is the opposite shape: 65 joints,
# 10 meshes / 12 primitives, every one of them indexed and carrying
# normals. Between them they cover both ends of what real exporters
# produce.
#
# THE CLIPS LIVE IN THEIR OWN FILES. idle/walk/run are separate .glb
# exports that contain animation and no mesh — the standard way animation
# libraries ship — so each is retargeted onto this character's skeleton by
# JOINT NAME at load (see lib/gltf_skin.rae). "Walk fast" is the walk clip
# played at 1.6x rather than a fourth file, which is what a speed control
# is for.
#
# A clip PLAYS FROM THE FIRST FRAME. An example that opens paused
# demonstrates nothing until someone clicks it.
#
# THE OVERLAY IS IMMEDIATE-MODE, not lib/ui. Six controls with fixed
# positions do not need an ECS, a theme and three .raescene files; the
# whole panel below is one function and a hit test. lib/ui earns its
# weight in example 110, which has responsive layout, hot reload and a
# dozen interacting widgets.
#
# WHAT THIS EXAMPLE EXISTS TO PROVE. Each of the model's twelve
# primitives is loaded and drawn SEPARATELY, so each can carry its own
# material. A character is rarely one primitive — glTF splits geometry
# per material — and loading only the first renders a disembodied
# fragment that looks like a broken import rather than a partial one.
# (`loadAllPrimitives` merges them into one buffer instead, which is
# cheaper but cannot keep per-primitive materials.)
#
# COLOURS COME FROM THE MODEL'S PALETTE TEXTURE, sampled offline.
#
# The character is textured with a flat palette atlas — solid colour
# swatches, the standard low-poly technique — so each primitive's UVs
# address one swatch and the surface is a single flat colour. The table
# below is the dominant swatch each primitive samples, converted from
# sRGB to linear because the renderer works in linear radiance.
#
# A CORRECTION IS RECORDED HERE deliberately. An earlier version of this
# file claimed the model carried no colour at all. That was wrong, and the
# cause was mine: I sampled the atlas with an OpenGL-style V flip, but
# glTF's UV origin is the TOP-LEFT with v increasing downward. The flip
# sent every lookup into the atlas's blank lower region, which returns
# white — a result that looks exactly like "this texture does not belong
# to this mesh". The UV ranges were the tell: v spans 0.007 to 0.19, which
# is the top of the image, not the bottom.
#
# WHY A TABLE AND NOT A TEXTURE. Sampling per pixel needs texture support
# in gpu3d, which does not exist for 3D yet. Because the atlas is FLAT,
# one colour per primitive is not an approximation for most of this model
# — nine of the twelve primitives sample a single swatch for 100% of their
# vertices. Three do not: the body is 61% skin over 17 swatches, the trim
# 51%, the boots 86%. Those three are genuinely flattened, and full
# fidelity needs either per-vertex colour baked from the atlas or real
# texturing. Both are tracked; neither is pretended at here.
#
# FRAMING IS COMPUTED, NOT HARD-CODED. Exporters leave a model wherever it
# sat in the authoring scene; this one sits about 13 units above its own
# origin. Rather than bake an offset that is correct for exactly this
# file, the example measures the loaded bounds and places and scales from
# them, so dropping in a different model still frames it.
#
# The model is Y-up (glTF's convention); Rae is Z-up
# (docs/coordinate-system.md), hence the rotation.
#
# See assets/ATTRIBUTION.md for provenance — the mesh is the walker
# project's, the skeleton is Mixamo's — and tools/README.md for how the
# .glb is regenerated from the source FBX.
#
# Compiled-target only; needs wgpu-native + SDL3.
#   rae run --target compiled main.rae
# Headless screenshot:
#   RAE_SDL_HEADLESS_MS=1000 RAE_GPU2D_SCREENSHOT=/tmp/walker.bmp \
#     rae run --target compiled main.rae
import core
import math
import gpu2d
import gpu2d_text
import sdf_text
import vec3
import gltf
import gltf_skin
open scene3d
open gpu3d
open renderer3d
open rendergraph
open math3d
open mesh3d
open gltf
open gltf_skin
open sdf_text

func uploadMeshData(m: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: m.verts, vertCount: m.vertCount, indices: m.indices)
}

# ----- overlay --------------------------------------------------------
# Colours are 0xAARRGGBB and authored in DISPLAY space: the overlay pass
# runs after tonemap, so these are not tone-curved.
const uiPanelBg: Int = 0xC0141821
const uiButtonBg: Int = 0xFF232A38
const uiButtonOn: Int = 0xFF3D6BE0
const uiText: Int = 0xFFE6EAF2
const uiLabel: Int = 0xFF9AA4B8

func inRect(px: view Float, py: view Float, x: view Float, y: view Float, w: view Float, h: view Float) ret Bool {
  ret px >= x and px <= x + w and py >= y and py <= y + h
}

# Draw one button and report whether it was clicked this frame. Drawing
# and hit-testing share the rect on purpose: two copies of a rectangle
# drift, and a control whose visual and clickable areas disagree is the
# single most confusing UI bug to look at.
func drawButton(font: view SdfFont, label: view String, x: view Float, y: view Float,
                w: view Float, h: view Float, active: view Bool,
                px: view Float, py: view Float, pressed: view Bool) ret Bool {
  var bg: Int = uiButtonBg
  if active {
    bg = uiButtonOn
  }
  gpu2d.drawRect(x: x, y: y, w: w, h: h, color: bg)
  let tw: Float = gpu2d_text.measureText(font: font, text: label, sizePx: 15.0)
  gpu2d_text.drawText(font: font, text: label, x: x + (w - tw) * 0.5, y: y + h * 0.66, sizePx: 15.0, color: uiText)
  ret pressed and inRect(px: px, py: py, x: x, y: y, w: w, h: h)
}

# Dominant palette colour per primitive, in LINEAR space.
#
# Extracted by sampling the model's palette atlas at every vertex UV and
# taking the most common swatch, then converting sRGB -> linear. The
# percentages are how much of the primitive that swatch actually covers,
# so it is visible at a glance which entries are exact and which are a
# flattening of a multi-swatch surface.
#
# This table is a stand-in for texture sampling, not for material data.
# When gpu3d can sample a texture in 3D, this whole function goes away.
func colorForPrimitive(meshIndex: view Int, primIndex: view Int) ret Vec3 {
  if meshIndex is 0 { ret vec3.create(x: 0.1011, y: 0.0461, z: 0.0415) }   # hair, 100%
  if meshIndex is 1 { ret vec3.create(x: 0.3686, y: 0.0127, z: 0.0399) }   # scarf, 100%
  if meshIndex is 2 { ret vec3.create(x: 0.2158, y: 0.1361, z: 0.0824) }   # strap, 89%
  if meshIndex is 3 { ret vec3.create(x: 0.4205, y: 0.4313, z: 0.3345) }   # staff, 100%
  if meshIndex is 4 { ret vec3.create(x: 0.2158, y: 0.1361, z: 0.0824) }   # leather, 100%
  if meshIndex is 5 { ret vec3.create(x: 0.2158, y: 0.1361, z: 0.0824) }   # pack, 100%
  if meshIndex is 6 { ret vec3.create(x: 0.2158, y: 0.1361, z: 0.0824) }   # pack flap, 54%
  if meshIndex is 7 { ret vec3.create(x: 0.3686, y: 0.0127, z: 0.0399) }   # bedroll, 100%
  if meshIndex is 8 { ret vec3.create(x: 0.0, y: 1.0, z: 0.3686) }         # gem, 100%
  if meshIndex is 9 {
    if primIndex is 0 { ret vec3.create(x: 1.0, y: 0.7012, z: 0.3686) }    # skin, 61%
    if primIndex is 1 { ret vec3.create(x: 0.5668, y: 0.3838, z: 0.0494) } # trim, 51%
    ret vec3.create(x: 0.0199, y: 0.0199, z: 0.0135)                       # boots, 86%
  }
  ret vec3.create(x: 0.7, y: 0.7, z: 0.72)
}

# Logical (point) size of the window. Text and hit-testing want points,
# not physical pixels, or the panel halves on a retina display.
func windowExtentW() ret Float {
  let ratio: Float = gpu2d.dpr()
  if ratio < 0.1 { ret gpu2d.windowWidth().toFloat() }
  ret gpu2d.windowWidth().toFloat() / ratio
}

func windowExtentH() ret Float {
  let ratio: Float = gpu2d.dpr()
  if ratio < 0.1 { ret gpu2d.windowHeight().toFloat() }
  ret gpu2d.windowHeight().toFloat() / ratio
}

func main() ret Int {
  gpu2d.initWindow(width: 1280, height: 800, title: "Rae 3D — walker character (animated)")
  var extentW: Float = windowExtentW()
  var extentH: Float = windowExtentH()
  gpu2d.setDesignResolution(width: extentW, height: extentH, fit: 0)

  let assets: String = "examples/113_walker_character/assets/"
  let font: SdfFont = sdf_text.loadSdfFont(
    jsonPath: "{assets}Roboto-Regular.mtsdf.json",
    rawAtlasPath: "{assets}Roboto-Regular.mtsdf.raw")

  let g: Glb = loadGlb(path: "{assets}walker.glb")
  if g.ok is false {
    log("[gltf] {g.errorMsg}")
    log("[gltf] regenerate assets/walker.glb — see tools/README.md")
    gpu2d.closeWindow()
    ret 1
  }
  # Load once merged, purely to measure the whole model's bounds — the
  # framing below has to consider every part, not just the first.
  let charData: MeshData = loadAllPrimitives(g: g)
  if charData.vertCount is 0 {
    log("[gltf] model contained no readable primitives")
    gpu2d.closeWindow()
    ret 1
  }
  log("[gltf] walker: {charData.vertCount} verts, {charData.indices.length / 3} triangles")

  # Measure what was loaded and derive the placement from it. `height` is
  # the model's own Y extent (still glTF's Y-up at this point), and the
  # scale maps that to a fixed on-screen height so any model arrives the
  # same size regardless of the units it was authored in.
  let b: List(Float) = meshBounds(m: charData)
  let height: Float = b.at(index: 4) - b.at(index: 1)
  let targetHeight: Float = 2.0
  var modelScale: Float = 1.0
  if height > 0.0 {
    modelScale = targetHeight / height
  }
  # Centre of the model's footprint, and the height of its lowest point,
  # both in model units. Subtracting them puts the model's feet on the
  # ground plane and its centre on the world axis.
  let midX: Float = (b.at(index: 0) + b.at(index: 3)) * 0.5
  let midZ: Float = (b.at(index: 2) + b.at(index: 5)) * 0.5
  let footY: Float = b.at(index: 1)
  log("[gltf] bounds height {height}, scale {modelScale}")

  # The skeleton. Everything below animates by mutating its node TRS and
  # rebuilding the palette; the vertex buffers never change.
  var sk: Skeleton = loadSkeleton(g: g, skinIndex: 0)
  if sk.ok is false {
    log("[gltf] walker.glb has no skin — cannot animate")
    gpu2d.closeWindow()
    ret 1
  }
  log("[gltf] skeleton: {jointCount(sk: sk)} joints, {sk.nodeCount} nodes")

  # Clips, retargeted onto `sk` by joint name at load. Loaded from their
  # own files, each of which carries animation and no geometry.
  let idleGlb: Glb = loadGlb(path: "{assets}idle.glb")
  let walkGlb: Glb = loadGlb(path: "{assets}walk.glb")
  let runGlb: Glb = loadGlb(path: "{assets}run.glb")
  let idleClip: Clip = loadClip(g: idleGlb, animIndex: 0, sk: sk)
  let walkClip: Clip = loadClip(g: walkGlb, animIndex: 0, sk: sk)
  let runClip: Clip = loadClip(g: runGlb, animIndex: 0, sk: sk)
  log("[anim] idle {clipChannelCount(c: idleClip)} ch / {idleClip.duration}s, walk {clipChannelCount(c: walkClip)} ch / {walkClip.duration}s, run {clipChannelCount(c: runClip)} ch / {runClip.duration}s")

  let planeData: MeshData = makePlane(size: 20.0, segments: 1)
  let ground: MeshHandle = uploadMeshData(m: planeData)

  var scene: Scene3d = createScene3d()
  let noEmit: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRot: Vec3 = vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let groundZ: Float = 0.0 - 1.0

  # Y-up -> Z-up is +90 degrees about X. After that rotation the model's
  # own Y becomes world Z, so the Y-based offsets below are applied along
  # the axes they land on rather than the ones they came from. Every part
  # shares this transform, which is what keeps them assembled.
  let partTransform: Transform3d = {
    position: vec3.create(
      x: 0.0 - midX * modelScale,
      y: 0.0 - midZ * modelScale,
      z: groundZ - footY * modelScale
    ),
    rotation: vec3.create(x: 1.5707963, y: 0.0, z: 0.0),
    scale: vec3.create(x: modelScale, y: modelScale, z: modelScale)
  }
  # Constant for the life of the program: skinning moves the VERTICES, so
  # the model matrix that places the character in the world never changes.
  let partModel: Mat4 = modelMatrix(t: partTransform)

  # One SKINNED mesh per primitive, each with its own material. The colour
  # is chosen from the primitive's authored mesh name, which is the only
  # handle on which body part it is when the materials carry nothing.
  let partIds: List(Int) = createList(Int, cap: 16)
  let partColor: List(Float) = createList(Float, cap: 48)
  let partRough: List(Float) = createList(Float, cap: 16)
  var mi: Int = 0
  loop mi < meshCount(g: g) {
    let name: String = meshName(g: g, meshIndex: mi)
    var rough: Float = 0.68
    if name.startsWith(prefix: "Cylinder") {
      # The staff and the metal fittings are the one non-cloth surface, so
      # they get the only low-roughness material.
      rough = 0.35
    }
    var pi: Int = 0
    loop pi < primitiveCount(g: g, meshIndex: mi) {
      let part: SkinnedMeshData = loadSkinnedPrimitive(g: g, meshIndex: mi, primIndex: pi)
      if part.vertCount > 0 {
        let handle: MeshHandle = uploadSkinnedMesh(verts: part.verts, vertCount: part.vertCount, indices: part.indices)
        if meshHandleIsValid(h: handle) {
          # The material is per PRIMITIVE, not per mesh: the body mesh
          # alone carries skin, trim and boots as three primitives with
          # three different swatches.
          let tint: Vec3 = colorForPrimitive(meshIndex: mi, primIndex: pi)
          partIds.add(value: handle.id)
          partColor.add(value: tint.x)
          partColor.add(value: tint.y)
          partColor.add(value: tint.z)
          partRough.add(value: rough)
        }
      }
      pi = pi + 1
    }
    mi = mi + 1
  }
  log("[gltf] skinned parts: {partIds.length}")
  if partIds.length is 0 {
    log("[gltf] no skinned primitives uploaded")
    gpu2d.closeWindow()
    ret 1
  }

  let groundMat: Int = addMaterial(scene: scene, baseColor: vec3.create(x: 0.40, y: 0.41, z: 0.43), metallic: 0.0, roughness: 0.9, emission: noEmit)
  let groundE: Int = addMeshInstance(
    scene: scene, mesh: ground, material: groundMat,
    position: vec3.create(x: 0.0, y: 0.0, z: groundZ), rotation: noRot,
    scale: vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )

  var camera: Camera3d = defaultCamera3d()
  var light: Light3d = defaultLight3d()
  camera.target = vec3.create(x: 0.0, y: 0.0, z: groundZ + targetHeight * 0.5)

  # The UI variant of the frame: the overlay MODIFIES the LDR target after
  # tonemap, and the graph derives that ordering from the declaration.
  var renderer: Renderer3d = createRenderer3dWithUi()
  let gs: Int = compileRenderer(r: renderer)
  if gs is not 0 {
    log("render graph invalid: {statusName(status: gs)}")
    gpu2d.closeWindow()
    ret 1
  }

  var yaw: Float = 0.6
  var pitch: Float = 0.18
  var dist: Float = 4.2
  var lastX: Float = 0.0
  var lastY: Float = 0.0
  var dragging: Bool = false
  var dragOnUi: Bool = false

  # Animation state. Clip 1 (walk) plays from the first frame — see the
  # note in the file header.
  var clipIndex: Int = 1
  var playing: Bool = true
  var speed: Float = 1.0
  var animTime: Float = 0.0

  let startT: Float64 = gpu2d.nowSeconds()
  var prevT: Float64 = startT
  loop not gpu2d.pollClose() {
    extentW = windowExtentW()
    extentH = windowExtentH()
    gpu2d.setDesignResolution(width: extentW, height: extentH, fit: 0)

    let now: Float64 = gpu2d.nowSeconds()
    var dt: Float = (now - prevT) as Float
    prevT = now
    # A long stall (a resize, a breakpoint) must not teleport the pose a
    # second and a half forward; clamp rather than integrate the gap.
    if dt > 0.1 {
      dt = 0.1
    }
    if dt < 0.0 {
      dt = 0.0
    }

    # Panel geometry, computed once and used for BOTH the hit test below
    # and the drawing further down.
    let panelW: Float = 452.0
    let panelH: Float = 106.0
    let panelX: Float = 16.0
    let panelY: Float = extentH - panelH - 16.0
    let px: Float = gpu2d.pointerX()
    let py: Float = gpu2d.pointerY()
    let overUi: Bool = inRect(px: px, py: py, x: panelX, y: panelY, w: panelW, h: panelH)
    let pressed: Bool = gpu2d.pointerPressed()

    # Orbit, but never while the drag STARTED on the panel: pressing a
    # button and slipping a pixel should not spin the camera.
    if gpu2d.pointerDown() {
      if not dragging {
        dragOnUi = overUi
      }
      if dragging and not dragOnUi {
        yaw = yaw + (px - lastX) * 0.008
        pitch = pitch - (py - lastY) * 0.008
        if pitch > 1.45 {
          pitch = 1.45
        }
        if pitch < 0.0 - 1.45 {
          pitch = 0.0 - 1.45
        }
      }
      dragging = true
    } else {
      dragging = false
      dragOnUi = false
    }
    lastX = px
    lastY = py
    if not overUi {
      dist = dist - gpu2d.wheelMove() * 0.4
    }
    if dist < 1.2 {
      dist = 1.2
    }
    if dist > 20.0 {
      dist = 20.0
    }

    # ----- animation -------------------------------------------------
    # "Walk fast" is the walk clip at 1.6x, not a fourth asset.
    var clipRate: Float = 1.0
    if clipIndex is 2 {
      clipRate = 1.6
    }
    if playing {
      animTime = animTime + dt * speed * clipRate
    }
    if clipIndex is 0 {
      applyClip(sk: sk, c: idleClip, time: animTime)
    }
    if clipIndex is 1 or clipIndex is 2 {
      applyClip(sk: sk, c: walkClip, time: animTime)
    }
    if clipIndex is 3 {
      applyClip(sk: sk, c: runClip, time: animTime)
    }
    let palette: List(Float) = buildPalette(sk: sk)

    camera.position = orbitEye(targetX: camera.target.x, targetY: camera.target.y, targetZ: camera.target.z, yaw: yaw, pitch: pitch, dist: dist)
    let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
    let t: Float = (now - startT) as Float

    # Frame order is DERIVED by the render graph: the scene pass writes
    # hdrColor, tonemap resolves it to sceneColor, the overlay modifies
    # that, present reads it. This loop walks the derived order.
    var oi: Int = 0
    loop oi < frameOrderLength(r: renderer) {
      let tag: Int = frameTagAt(r: renderer, i: oi)
      if tag is tagScenePass {
        beginScene(camera: camera, light: light, aspect: aspect, time: t)
        renderScene(scene: scene)
        # Skinned draws go into the pass the static path just opened. The
        # palette is per FRAME and shared by every part, so it uploads
        # once regardless of how many primitives follow.
        skinFrameBegin()
        uploadPalette(rows: palette, jointCount: jointCount(sk: sk))
        var p: Int = 0
        loop p < partIds.length {
          let handle: MeshHandle = meshHandle(id: partIds.at(index: p), generation: 1)
          let mat: Material3d = {
            baseColor: vec3.create(
              x: partColor.at(index: p * 3),
              y: partColor.at(index: p * 3 + 1),
              z: partColor.at(index: p * 3 + 2)
            ),
            metallic: 0.0,
            roughness: partRough.at(index: p),
            emission: noEmit
          }
          drawSkinnedInstance(mesh: handle, model: partModel, material: mat)
          p = p + 1
        }
        endPass()
      }
      if tag is tagSsao {
        ssaoPass()
      }
      if tag is tagTaa {
        taaPass()
      }
      if tag is tagTonemap {
        tonemapPass()
      }
      if tag is tagUiOverlay {
        gpu2d.beginFrameLoad()
        gpu2d.drawRect(x: panelX, y: panelY, w: panelW, h: panelH, color: uiPanelBg)

        # Row 1: which clip.
        let bw: Float = 104.0
        let bh: Float = 32.0
        let bx: Float = panelX + 12.0
        let by: Float = panelY + 12.0
        if drawButton(font: font, label: "Idle", x: bx, y: by, w: bw, h: bh, active: clipIndex is 0, px: px, py: py, pressed: pressed) {
          clipIndex = 0
          animTime = 0.0
        }
        if drawButton(font: font, label: "Walk", x: bx + bw + 8.0, y: by, w: bw, h: bh, active: clipIndex is 1, px: px, py: py, pressed: pressed) {
          clipIndex = 1
          animTime = 0.0
        }
        if drawButton(font: font, label: "Walk fast", x: bx + (bw + 8.0) * 2.0, y: by, w: bw, h: bh, active: clipIndex is 2, px: px, py: py, pressed: pressed) {
          clipIndex = 2
          animTime = 0.0
        }
        if drawButton(font: font, label: "Run", x: bx + (bw + 8.0) * 3.0, y: by, w: bw, h: bh, active: clipIndex is 3, px: px, py: py, pressed: pressed) {
          clipIndex = 3
          animTime = 0.0
        }

        # Row 2: transport and speed.
        let by2: Float = by + bh + 10.0
        var transport: String = "Pause"
        if not playing {
          transport = "Play"
        }
        if drawButton(font: font, label: transport, x: bx, y: by2, w: bw, h: bh, active: playing, px: px, py: py, pressed: pressed) {
          playing = not playing
        }
        if drawButton(font: font, label: "Slower", x: bx + bw + 8.0, y: by2, w: 78.0, h: bh, active: false, px: px, py: py, pressed: pressed) {
          speed = speed - 0.25
        }
        if drawButton(font: font, label: "Faster", x: bx + bw + 94.0, y: by2, w: 78.0, h: bh, active: false, px: px, py: py, pressed: pressed) {
          speed = speed + 0.25
        }
        if speed < 0.25 {
          speed = 0.25
        }
        if speed > 3.0 {
          speed = 3.0
        }
        let pct: Int = math.floor(x: speed * 100.0 + 0.5).toInt()
        gpu2d_text.drawText(font: font, text: "Speed {pct}%", x: bx + (bw + 8.0) * 3.0, y: by2 + bh * 0.66, sizePx: 15.0, color: uiLabel)
      }
      if tag is tagPresent {
        gpu2d.endFrame()
      }
      oi = oi + 1
    }
    snapshotPrevTransforms(scene: scene)
  }
  skinShutdown()
  shutdown()
  gpu2d.closeWindow()
  ret 0
}
