pack GltfLevel {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — A glTF level"
  description: "A small level authored as Blender would export it (made by tools/levels/exportWalkLevel.py), read by lib/app3d/GltfLevel: its meshes drawn in their base colors, its collision nodes as static Box3D triangle meshes, the character (a Box3D mover drawn as a capsule) starting at its spawn marker, walking on its ground and up its ramp, stopped by its walls. Every footprint is laid in a darker shade of the surface the level's surface map says is under it. W/A/S/D walk, Shift walks slowly, Space jumps, Q/E turn the camera."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
