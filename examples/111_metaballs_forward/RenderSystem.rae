# ECS RenderSystem for 111, the forward twin of 112's (#736): rendering reads
# entities via QUERIES and issues draws directly.
#
# - Mesh pass: GbufferWorld.renderSceneWorld queries the meshRenderers table.
# - SDF pass queries each per-cluster tag (#734) with tagged over the sdfs
#   table, packs that cluster's spheres, and issues one metaball draw
#   (GbufferSdf.drawMetaballs). In the forward frame that draw uses the
#   forward metaball material (forward_sdf.wgsl), so the code is 112's.
# - Shadows: the same casters into the sun cascades as 112.
#
# The cluster draw order (c0..c6) does not matter: the forward pass and the
# shadow map are depth-tested.
import Scene3d
import SceneAnimation
open RendererDeferred
open Gbuffer
open GbufferSdf
open gpu/GpuResources
open ecs/Entity
open ecs/ComponentTable
open ecs/Query

# ----- sdf (metaballs), one cluster tag at a time ---------------------
# The G-buffer metaball draw for a single cluster: pack its spheres (position +
# scale.x) and per-ball baseColor, take metallic/roughness/emission/smoothing
# from the cluster HEAD (its first sphere in query = list order), and raymarch.
func renderSdfCluster(
  T: type
  cache: mod GbufferCache
  resources: mod GpuResources
  world: view World3d
  clusterTable: view ComponentTable(T)
  camera: view Camera3d
) {
  let matches: List(Query2Match) = tagged(dataTable: world.sdfs, tagTable: clusterTable)
  if matches.length is 0 {
    ret
  }
  let packed: List(Float) = List.create(Float, cap: matches.length * 4)
  let colors: List(Float) = List.create(Float, cap: matches.length * 4)
  var ballCount: Int = 0
  var haveHead: Bool = false
  var headSmoothing: Float = 0.0
  var headMaterial: Material3d = {
    baseColor: { x: 0.0, y: 0.0, z: 0.0 }
    metallic: 0.0
    roughness: 1.0
    emission: { x: 0.0, y: 0.0, z: 0.0 }
    toon: false
  }
  loop let hit: view Query2Match in matches {
    let sdf: view SdfPrimitive => componentView(this: world.sdfs, entityId: hit.entityId)
    if sdf.shape is 0 {
      let t: view Transform3d => componentView(this: world.transforms, entityId: hit.entityId)
      packed.add(value: t.position.x)
      packed.add(value: t.position.y)
      packed.add(value: t.position.z)
      packed.add(value: t.scale.x)
      let mat: view Material3d => componentView(this: world.materials, entityId: hit.entityId)
      colors.add(value: mat.baseColor.x)
      colors.add(value: mat.baseColor.y)
      colors.add(value: mat.baseColor.z)
      colors.add(value: 0.0)
      if haveHead is false {
        headMaterial = mat
        headSmoothing = sdf.smoothing
        haveHead = true
      }
      ballCount = ballCount + 1
    }
  }
  if ballCount > 0 {
    drawMetaballs(
      cache: cache
      resources: resources
      packedBalls: packed.data
      count: ballCount
      packedColors: colors.data
      smoothing: headSmoothing
      camX: camera.position.x
      camY: camera.position.y
      camZ: camera.position.z
      metallic: headMaterial.metallic
      roughness: headMaterial.roughness
      emR: headMaterial.emission.x
      emG: headMaterial.emission.y
      emB: headMaterial.emission.z
    )
  }
}

func renderSdfClusterShadow(
  T: type
  renderer: mod DeferredRenderer
  world: view World3d
  clusterTable: view ComponentTable(T)
) {
  let matches: List(Query2Match) = tagged(dataTable: world.sdfs, tagTable: clusterTable)
  if matches.length is 0 {
    ret
  }
  let packed: List(Float) = List.create(Float, cap: matches.length * 4)
  var ballCount: Int = 0
  var haveHead: Bool = false
  var headSmoothing: Float = 0.0
  loop let hit: view Query2Match in matches {
    let sdf: view SdfPrimitive => componentView(this: world.sdfs, entityId: hit.entityId)
    if sdf.shape is 0 {
      let t: view Transform3d => componentView(this: world.transforms, entityId: hit.entityId)
      packed.add(value: t.position.x)
      packed.add(value: t.position.y)
      packed.add(value: t.position.z)
      packed.add(value: t.scale.x)
      if haveHead is false {
        headSmoothing = sdf.smoothing
        haveHead = true
      }
      ballCount = ballCount + 1
    }
  }
  if ballCount > 0 {
    shadowMetaballsWith(
      renderer: renderer
      packedBalls: packed
      count: ballCount
      smoothing: headSmoothing
    )
  }
}

# Draw every cluster of a scene. Empty tag tables (cluster ids a scene doesn't
# use) query to zero matches and are skipped.
func renderSdfScene(
  cache: mod GbufferCache
  resources: mod GpuResources
  world: view World3d
  tags: view ClusterTags
  camera: view Camera3d
) {
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c0
    camera: camera
  )
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c1
    camera: camera
  )
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c2
    camera: camera
  )
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c3
    camera: camera
  )
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c4
    camera: camera
  )
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c5
    camera: camera
  )
  renderSdfCluster(
    cache: cache
    resources: resources
    world: world
    clusterTable: tags.c6
    camera: camera
  )
}

func renderSdfShadow(renderer: mod DeferredRenderer, world: view World3d, tags: view ClusterTags) {
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c0)
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c1)
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c2)
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c3)
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c4)
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c5)
  renderSdfClusterShadow(renderer: renderer, world: world, clusterTable: tags.c6)
}

# One scene's draws into the open pass: its meshes, then every metaball
# cluster. The same draws go into the 1x pre-pass (Gbuffer.beginPass, for the
# SSAO) and into the forward pass (beginForwardPass); the pass picks the
# material.
func drawScene(
  cache: mod GbufferCache
  resources: mod GpuResources
  world: view World3d
  tags: view ClusterTags
  camera: view Camera3d
) {
  GbufferWorld.renderSceneWorld(cache: cache, resources: resources, world: world)
  renderSdfScene(
    cache: cache
    resources: resources
    world: world
    tags: tags
    camera: camera
  )
}
