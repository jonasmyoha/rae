pack MetaballsForward {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Metaballs (forward rendering)"
  description: "The FORWARD-rendered twin of example 112. Same scenes, same ECS UI, same controls — the renderer underneath is the difference, which is the point: open both to compare the two lighting paths on identical content. Both paths now draw the same sky from one shared shader; the forward frame paints it as a fullscreen pass at the start of the scene pass, where the deferred one computes it for whatever its G-buffer left empty."
  category: "3D Renderer"
  wasmWebApp: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: { source: { path: ".", emit: compiled } }
    }
    target wasm: {
      label: "WASM (WebGPU)"
      entry: "main.rae"
      sources: { source: { path: ".", emit: compiled } }
    }
  }
}
