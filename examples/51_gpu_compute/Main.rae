# GPU compute (G3) — generic, NOT a raytracer. Proves lib/gpu.rae dispatches an
# arbitrary WGSL kernel on the native GPU via wgpu-native: build an input array
# in Rae, run out[i] = in[i]*in[i] + 1 on the GPU (square.wgsl), read it back,
# and verify. Headless — no window. Compiled-target only; needs wgpu-native.
#
#   rae run --target compiled main.rae
import Io
import Gpu

func main() {
  unsafe {
    let n: Int = 1024

    let input: List(Float) = List.create(Float, cap: n)
    var i: Int = 0
    loop i < n {
      input.add(value: i.toFloat())
      i = i + 1
    }

    let wgsl: Shader = shader(files: ["square.wgsl"])

    let inBuf: Int = Gpu.storageF32(data: input.data, count: n)
    let outBuf: Int = Gpu.allocF32(count: n)
    let kernel: Int = Gpu.kernelShader(shader: wgsl, entry: "main")

    let bufs: List(Int) = List.create(Int, cap: 2)
    bufs.add(value: inBuf)
    bufs.add(value: outBuf)
    let groups: Int = (n + 63) / 64
    Gpu.run(
      kernel: kernel
      bufs: bufs.data
      bufCount: 2
      gx: groups
      gy: 1
      gz: 1
    )

    let result: List(Float) = List.create(Float, cap: n)
    i = 0
    loop i < n {
      result.add(value: 0.0)
      i = i + 1
    }
    Gpu.downloadF32(buf: outBuf, out: result.data, count: n)

    log("GPU compute on the native GPU (out[i] = i*i + 1):")
    log("  out[0]    = {result.copyAt(index: 0)}    (expect 1)")
    log("  out[7]    = {result.copyAt(index: 7)}    (expect 50)")
    log("  out[50]   = {result.copyAt(index: 50)}   (expect 2501)")
    log("  out[100]  = {result.copyAt(index: 100)}  (expect 10001)")
    Gpu.reset()
  }
}
