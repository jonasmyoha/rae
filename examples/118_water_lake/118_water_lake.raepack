pack WaterLake {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Water lake (toon water, free camera)"
  description: "Only water: the lib/water toon lake over a deep bed with a few islands, under a stylised sky whose time of day you can scrub. Fly the camera with WASD / Q / E (mouse-drag to look, shift to boost); comma / period move the sun."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
