pack UiCounter {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Counter — data-driven UI"
  description: "The smallest honest Rae UI app, in the shape a real one takes: the whole layout is a .raescene document, widgets are ECS entities, the app owns its state in a plain struct, and a history list is rebuilt from that data whenever the value moves. Portrait, phone-shaped. A counter with -1 / Clear / +1 and a step size."
  category: "UI"
  wasmWebApp: "true"
  display: {
    width: 440
    height: 880
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
