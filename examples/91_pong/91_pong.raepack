pack Pong {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Pong"
  description: "A small data-oriented Pong against a computer player, with GPU2D rendering, SDL3 input and an ECS-backed .raescene overlay."
  category: "90-99 Graphics & Games"
  featured: "true"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
