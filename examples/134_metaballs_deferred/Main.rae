# 3D Renderer — PBR scene with persistent ECS/.raescene UI.
#
# Frame ownership is explicit: the scene renders first, the composite writes
# the canvas, GPU2D loads it and paints UiWorld, then presents once. UI hit-testing has priority
# over orbit input.
#
# RESPONSIVE, NOT SCALED: the design resolution tracks the window's logical
# size, so the design->pixel transform is identity. Fonts keep their
# authored point size at every window size, and there are no letterbox
# bars. The UI scene is authored at absolute coordinates, so
# `anchorUiToExtent` re-places the root-level nodes whenever the extent
# changes — intent ("centered", "right-aligned", "full-bleed") lives there
# rather than in resolution-specific constants.
#
# STATE SURVIVES HOT RELOAD: selected scene, pause/speed/debug toggles and
# the full camera (orbit-vs-WASD mode, yaw/pitch, distance, free position,
# target) round-trip through lib/hotReload.rae's state file, so a rebuild
# drops you back where you were instead of re-aiming the camera every
# time. Saved on change (throttled), not only at exit, because nothing
# guarantees this process gets a chance to shut down cleanly.
#
# IDLE COSTS NOTHING: the loop only draws when something it depends on
# changed — simulation running, camera moved, UI event, resize, or TAA
# still converging. Otherwise it parks in `Gpu2d.waitEvents`, so a paused
# app sits at 0% CPU instead of re-rendering an identical image at frame
# rate (measured: 0.0% paused vs ~12% animating).
import Gpu2d
import Math
import SdfText
import RenderSystem
import Sdl3
import Vec3
open RendererDeferred
open RendererDeferredShadow
open gpu/GpuResources
open Sky
open SkyHosek
open Gbuffer
open Math3d
open Mesh3d
open Scene3d
open Scene3dFile
open SceneAnimation
open ui/Ecs
open ui/Registry
open ui/inputSystem/InputSystem
open ui/layoutSystem/LayoutSystem
open ui/renderSystem/RenderSystem
open ui/visualBoundsSystem/VisualBoundsSystem
open ui/SceneFile
open ui/SceneLoader
open ui/ThemeResolved
open ui/Transform
open ui/EventLoop
open ui/LogOverlay
open ui/WindowGeometry
open ui/scrollRootSystem/ScrollRootSystem
open ui/DebugOverlay
open HotReload
import String
import ui/Scene
open app3d/EditorPanel
import app3d/Slider
open GbufferWorld
open app3d/CameraRig
open app3d/CameraBar
open app3d/SettingsDialog
open app3d/SettingsSky
open Shadow3d
open app3d/UiShell
open Gpu2dCanvas
open ui/UiSystems
open app3d/RenderScale

type DemoUiResource {
  paused: Bool
  fullSpeed: Bool
  debugOpen: Bool
  activeScene: Int
  revision: Int
  appliedRevision: Int
}

func uploadMeshData(renderer: mod DeferredRenderer, mesh: view MeshData) ret MeshHandle {
  ret uploadMesh(
    renderer: renderer
    verts: mesh.verts
    vertCount: mesh.vertCount
    indices: mesh.indices
  )
}

func main() ret Int {
  Gpu2d.initWindow(width: 1280, height: 800, title: "134: Rae 3D — Metaballs (deferred rendering)")
  # The 2D UI draws on the RENDERER's canvas (#920): the deferred composite
  # writes the scene into that canvas's offscreen target, and the UI frame
  # loads it and paints over it - a separate app canvas would present an
  # offscreen the scene was never composited into (a black viewport).
  # Remember where the user put the window, across restarts. Opt-in, and the
  # app picks the file: the hot-reload channel dir is per app, so two examples
  # running at once do not share one window position.
  # The name carries the app id, because dir() is ".rae" for every
  # app: a shared file name is a shared window, and this one used to open at
  # the mobile UI example's phone-shaped 599x1259.
  var windowGeometry: WindowGeometry = createWindowGeometry(
    dir: dir()
    name: "window.{state134AppId}.geometry"
  )
  restoreWindowGeometry(windowGeometry: windowGeometry)
  # Design resolution tracks the window's LOGICAL size, so the transform is
  # identity: no letterbox bars, and fonts keep their authored point size
  # instead of shrinking with window width.
  var extentW: Float = windowExtentW()
  var extentH: Float = windowExtentH()
  Gpu2d.setDesignResolution(width: extentW, height: extentH, fit: 0)

  let sphereData: MeshData = makeSphere(rings: 32, segments: 48)
  let torusData: MeshData = makeTorus(
    majorR: 1.55
    minorR: 0.42
    majorSegs: 96
    minorSegs: 40
  )
  let planeData: MeshData = makePlane(size: 36.0, segments: 1)
  # Unit box, flat shaded (24 verts, not 8 — a shared corner cannot carry
  # three face normals). Scene 1 uses it for the voxel mountains and the
  # two spinning cubes.
  let boxData: MeshData = makeBox(size: 1.0)
  # #905: the renderer owns the mesh store, so it exists before the uploads; the
  # sky is applied below once the settings are loaded.
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  let sphere: MeshHandle = uploadMeshData(renderer: renderer, mesh: sphereData)
  let torus: MeshHandle = uploadMeshData(renderer: renderer, mesh: torusData)
  let ground: MeshHandle = uploadMeshData(renderer: renderer, mesh: planeData)
  let boxMesh: MeshHandle = uploadMeshData(renderer: renderer, mesh: boxData)
  let base: String = "examples/134_metaballs_deferred/assets/"
  var meshRegistry: MeshRegistry3d = createMeshRegistry3d()
  registerMesh3d(reg: meshRegistry, key: "sphere", handle: sphere)
  registerMesh3d(reg: meshRegistry, key: "torus", handle: torus)
  registerMesh3d(reg: meshRegistry, key: "ground", handle: ground)
  registerMesh3d(reg: meshRegistry, key: "box", handle: boxMesh)
  # #737: load straight into ECS World3ds. loadWorld3dFile parses the .raescene
  # and converts it to a World3d (component tables) + camera/light/node-id map;
  # the hand-rolled Scene3d SoA lives and dies inside that loader, so 134 never
  # touches it — its 3D state, animation and rendering are all ECS.
  var asset1: World3dAsset = loadWorld3dFile(path: "{base}scene1.raescene", meshes: meshRegistry)
  var asset2: World3dAsset = loadWorld3dFile(path: "{base}scene2.raescene", meshes: meshRegistry)
  var asset3: World3dAsset = loadWorld3dFile(path: "{base}scene3.raescene", meshes: meshRegistry)
  if asset1.ok is false {
    log("[scene3d] scene 1 failed: {asset1.errorMsg}")
    shutdown()
    Gpu2d.closeWindow()
    ret 1
  }
  if asset2.ok is false {
    log("[scene3d] scene 2 failed: {asset2.errorMsg}")
    shutdown()
    Gpu2d.closeWindow()
    ret 1
  }
  if asset3.ok is false {
    log("[scene3d] scene 3 failed: {asset3.errorMsg}")
    shutdown()
    Gpu2d.closeWindow()
    ret 1
  }

  # Capture per-scene metadata (node anchors, initial camera, per-scene lights)
  # before moving the worlds out of their assets.
  let cubeAEntityId: EntityId = world3dAssetEntityId(asset: asset1, nodeId: "spinCubeA")
  let cubeBEntityId: EntityId = world3dAssetEntityId(asset: asset1, nodeId: "spinCubeB")
  let torusEntityId: EntityId = world3dAssetEntityId(asset: asset1, nodeId: "heroTorus")
  let initialCamera: Camera3d = asset1.camera
  let light1: Light3d = asset1.light
  let light2: Light3d = asset2.light
  let light3: Light3d = asset3.light
  # The World3d stays owned by its asset (asset1.world) — copying it out would
  # double-free the component tables; every call passes asset1.world by ref.
  log(
    "[ecs] World3d: scene1 {world3dEntityCount(world: asset1.world)}, scene2 {world3dEntityCount(
      world: asset2.world
    )}, scene3 {world3dEntityCount(world: asset3.world)} entities (#737)"
  )
  # #734: per-cluster marker tags, classified once from the (renderer-owned)
  # cluster field. The animators query these tag tables instead of an
  # `if sdf.cluster is N` ladder. Clusters never change, so build once here.
  let clusters1: ClusterTags = buildClusterTags(world: asset1.world)
  let clusters2: ClusterTags = buildClusterTags(world: asset2.world)
  # #736: the RenderSystem's SDF pass queries per-cluster tags, so every scene
  # that draws metaballs needs them (scene 3 is one cluster of 40 spheres).
  let clusters3: ClusterTags = buildClusterTags(world: asset3.world)

  # Diagnostic log overlay (lib/ui/LogOverlay.rae), bottom-left here and
  # top-left in the mobile UI example — same widget, different corner.
  var logOverlay: LogOverlay = createLogOverlay(
    capacity: 64
    maxLines: 10
    anchor: logAnchorBottomLeft
    fontSize: 14.0
  )
  # This example PARKS when nothing moves, so "did real work" is the previous
  # frame's render decision — it is not known yet this early in the frame.
  var dbgDidWork: Bool = true
  # First use case: make hot reloads visible. A rebuilt binary that failed
  # to relaunch looks exactly like one that reloaded and changed nothing,
  # so print the launch generation — watching 5 become 6 is the proof.
  let reloadGen: Int = nextReloadGeneration()
  logInfoLine(ov: logOverlay, text: "hot reload {reloadGen}")
  logDebugLine(ov: logOverlay, text: "scene1/2/3 loaded, renderer graph compiled")
  # Real conditions, not decoration: surface a degraded renderer state so
  # it cannot be mistaken for how the app normally looks.
  if getEnv(name: "RAE_NO_TAA").length() > 0 {
    logWarnLine(ov: logOverlay, text: "TAA disabled (RAE_NO_TAA) - edges will alias")
  }

  var uiState: DemoUiResource = createDemoUiResource()
  # The shared editor chrome (lib/app3d/EditorPanel): the camera bar, the "..."
  # menu, the settings side panel and its edge tab, the debug readout. Three
  # scenes here, so the settings' scene chooser is live.
  let settings: SettingsState = createSettingsState(
    scene: uiState.activeScene
    sceneCount: 3
    speed: 1.0
    toon: false
    hour: 12.0
    skyModel: SettingsSkyModel.preetham
  )
  var editorPanel: EditorPanel = createEditorPanel(assetBase: base, settings: settings)
  # Where "Orbit" re-centers on every switch back from the WASD camera
  setEditorPanelOrbitHome(
    editorPanel: editorPanel
    target: Vec3.create(x: 0.0, y: 0.0, z: orbitFocusZ)
  )
  var camera: Camera3d = initialCamera
  var cameraRig: CameraRig = createCameraRig(camera: camera)
  # Restore before the test-state hook, so an explicit env override still
  # wins over whatever the previous run left behind.
  #
  # A HEADLESS run never restores. Headless means a screenshot or smoke
  # test, and those assert against a defined starting state — inheriting
  # whatever scene a developer happened to leave selected makes the result
  # depend on machine-local history. That is not hypothetical: it turned
  # the metaball assertion red on a dev machine while staying green on a
  # clean checkout, which is the worst way for a gate to fail.
  # BOTH headless vars, not just the timed one. RAE_HEADLESS_FRAMES is the
  # deterministic variant used for exact-frame captures, so it is precisely
  # the mode that must not inherit machine-local camera state — checking
  # only RAE_SDL_HEADLESS_MS left the stricter mode unguarded.
  let headless: Bool = getEnv(name: "RAE_SDL_HEADLESS_MS").length() > 0 or getEnv(
    name: "RAE_HEADLESS_FRAMES"
  ).length() > 0
  if not headless {
    let savedState: String = readHotReloadStateFor(appId: state134AppId)
    if restore134State(
      raw: savedState
      ui: uiState
      rig: cameraRig
      camera: camera
    ) {
      logInfoLine(ov: logOverlay, text: "state restored: scene {uiState.activeScene}, camera kept")
    }
  }

  let testState: String = getEnv(name: "RAE_GPU3D_UI_TEST_STATE")
  if testState is "pause" {
    uiState.paused = true
  }
  if testState is "debug" {
    uiState.debugOpen = true
  }
  if testState is "scene2" {
    uiState.activeScene = 2
  }
  if testState is "scene3" {
    uiState.activeScene = 3
  }
  if testState is "free" {
    toggleCameraRigMode(rig: cameraRig, camera: camera)
  }
  selectEditorPanelScene(editorPanel: editorPanel, scene: uiState.activeScene)
  # The three scenes' chooser, this app's own part of the panel
  var sceneChooser: EditorSceneChooser = createEditorSceneChooser(
    editorPanel: editorPanel
    title: "Scenes"
    labels: List(String) { "Scene 1", "Scene 2", "Scene 3" }
  )
  var light: Light3d = light1
  var simTime: Float = 0.0
  # Epoch seconds must stay Float64 (see docs/primitive-types.md); only the
  # small per-frame delta is narrowed to Float.
  # Frame declared as a render graph with a load-preserving UI overlay.
  # A REAL sky (#400): Preetham, from the same sun the scene is lit by,
  # so the visible sun and the shadows agree. This example is the renderer's
  # realistic end; 136 is the stylized one, and they deliberately use
  # different kinds behind the same interface.
  applyEditorPanelSettings(
    editorPanel: editorPanel
    renderer: renderer
    light: light
    sunStrength: 1.0
  )
  let gstatus: Int = compileDeferred(renderer: renderer)
  if gstatus is not 0 {
    log("render graph invalid: {gstatus}")
    ret 1
  }

  var lastFrame: Float64 = Gpu2d.nowSeconds()
  # Shared sliding-window sampler (lib/ui/FrameStats.rae): it records only
  # frames that actually rendered, so an idle app's reading decays to ~1
  # instead of freezing at the last busy value.
  # Idle policy (see docs/ui-render-loop-performance.md): busy-render while
  # anything is moving, park in waitEvents when nothing is. Relayout is
  # gated on explicit change flags, and the UI paint only happens inside a
  # rendered frame, so an idle app touches neither.
  # What the settings panel's scene chooser last read, so a change made IN the
  # panel can be told apart from the panel merely holding a stale value.
  var lastSettingsScene: Int = editorPanel.settings.scene
  var renderedOnce: Bool = false
  var lastLogRevision: Int = -1
  # Once, not per frame: this is a gate assertion, not a readout.
  var shadowLogged: Bool = false
  # Save on CHANGE rather than only at exit: 134 does not watch for a
  # reload signal, so a supervisor is free to kill it without warning and
  # an exit-only save would lose everything. Throttled because a camera
  # drag changes state every frame and one file write per frame would be
  # exactly the kind of hidden cost this app is meant to measure.
  var stateDirty: Bool = false
  var lastStateSave: Float64 = Gpu2d.nowSeconds()
  var lastSavedScene: Int = uiState.activeScene
  var lastSavedRevision: Int = uiState.revision
  # TAA converges over several frames, so stopping the instant motion ends
  # would freeze a half-resolved image. Keep drawing a few extra frames
  # after the last change, then idle on a fully converged picture.
  var taaSettleFrames: Int = 0

  loop not Gpu2d.pollClose() {
    let now: Float64 = Gpu2d.nowSeconds()
    var deltaTime: Float = (now - lastFrame) as Float
    lastFrame = now
    # NO CLAMP ON dt. A long frame is integrated in full, however long it was.
    #
    # This used to cap at 0.1 s so a stall could not teleport anything, and that
    # cap quietly ate real time: the clock is driven from dt, so every frame
    # slower than 10 fps advanced it by less than the wall clock moved. At this
    # app's day length one real second is 0.4 simulated hours, so a single
    # 250 ms hitch cost the time-of-day readout 3.6 simulated minutes -- and the
    # forward and deferred twins, which stall differently, drifted apart into
    # different dates while sitting side by side.
    #
    # Obeying dt is the honest rule and the one that survives contact with a
    # networked simulation, where "how much time passed" is not something a
    # renderer gets to round down. What a stall may now do is jump: the pose,
    # the sun and the clock all land where that much elapsed time puts them.
    # Nothing downstream is unstable under a big step -- the camera easing is
    # exponential decay, which cannot overshoot however long the frame is
    # (test 581), and the clock rolls whole days in a loop.
    #
    # Negative is still refused: that is a clock going backwards, not a long
    # frame, and no amount of honesty makes it meaningful.
    if deltaTime < 0.0 {
      deltaTime = 0.0
    }

    # The panel lays itself out again on a resize; the log overlay reads the
    # extent.
    let resized: Bool = Gpu2d.windowResized()
    updateWindowGeometry(windowGeometry: windowGeometry, now: now, resized: resized)
    if resized {
      extentW = windowExtentW()
      extentH = windowExtentH()
    }
    let extentChanged: Bool = resized

    # The chrome, then the camera rig with the pointer and wheel the UI did
    # not take. Pause freezes the SIMULATION, not the camera: being able to
    # orbit a frozen frame is the main reason to pause at all.
    let panelFrame: EditorPanelFrame = updateEditorPanel(
      editorPanel: editorPanel
      cameraRig: cameraRig
      camera: camera
      now: now
      deltaTime: deltaTime
      resized: resized
      rendered: dbgDidWork
    )
    let cameraMoved: Bool = panelFrame.cameraMoved
    let settingsChanged: Bool = panelFrame.settingsChanged
    let uiLayoutDirty: Bool = panelFrame.layoutChanged
    let hadUiEvents: Bool = uiActionCount(world: editorPanel.world) > 0
    let unusedSceneClicked: Bool = updateEditorSceneChooser(
      editorPanel: editorPanel
      chooser: sceneChooser
    )
    dispatchUiActions(
      world: editorPanel.world
      state: uiState
      rig: cameraRig
      camera: camera
    )
    # The clock, if it is running. This example PARKS in waitEvents when nothing
    # is moving, so a running clock has to be declared as motion below or it
    # starves to the heartbeat rate and the sky steps once a second.
    let timeAnimating: Bool = editorPanel.settings.playing and editorPanel.settings.animateTime and editorPanel.settings.timeDragging is false
    # The scene chooser exists in both places here: the debug state's and the
    # panel's. Keep them one value rather than two.
    #
    # THE PANEL WINS ONLY WHEN THE PANEL ACTUALLY MOVED. This used to key off
    # `settingsChanged`, which meant "the user touched the panel" until the
    # time-of-day clock started setting it every frame — after which the panel
    # won always, and silently reverted any scene chosen anywhere else. It ate
    # both the RAE_GPU3D_UI_TEST_STATE=scene3 override and a restored snapshot,
    # so the app opened on scene 1 whatever it had been told.
    if editorPanel.settings.scene is not lastSettingsScene {
      uiState.activeScene = editorPanel.settings.scene
      uiState.revision = uiState.revision + 1
      lastSettingsScene = editorPanel.settings.scene
    } else {
      if uiState.activeScene is not editorPanel.settings.scene {
        selectEditorPanelScene(editorPanel: editorPanel, scene: uiState.activeScene)
        lastSettingsScene = uiState.activeScene
      }
    }
    if settingsChanged {
      # Sky model and time of day both feed this, so one rebuild covers both
      applyEditorPanelSettings(
        editorPanel: editorPanel
        renderer: renderer
        light: light
        sunStrength: 1.0
      )
      # Pause is the shared control; uiState still owns the flag the rest of
      # this example reads.
      uiState.paused = editorPanel.settings.playing is false
      stateDirty = true
    }
    # The panel's automatic exposure, when it is switched on
    let exposureAdapting: Bool = editorPanelExposureFrame(
      editorPanel: editorPanel
      renderer: renderer
      light: light
      deltaTime: deltaTime
    )

    # The frame is only worth drawing if something it depends on changed.
    # While paused the 3D scene is frozen, so the presented image is still
    # valid — redrawing it would burn a GPU frame to produce the same
    # pixels. TAA is the one caveat: its history is still converging for a
    # few frames after motion stops, so keep drawing until it settles or
    # edges would stay half-resolved on the final image.
    let sceneAnimating: Bool = uiState.paused is false
    # Any UI-state change or camera movement makes the snapshot stale.
    if uiState.revision is not lastSavedRevision or uiState.activeScene is not lastSavedScene {
      stateDirty = true
      lastSavedRevision = uiState.revision
      lastSavedScene = uiState.activeScene
    }
    let logChanged: Bool = logOverlay.revision is not lastLogRevision
    var needsRender: Bool = sceneAnimating or cameraMoved or uiLayoutDirty or extentChanged or hadUiEvents or logChanged or timeAnimating or renderedOnce is false
    if taaSettleFrames > 0 or exposureAdapting {
      needsRender = true
    }
    dbgDidWork = needsRender
    if Gpu2d.shouldRenderFrame(appNeedsRender: needsRender) is false {
      # Nothing to draw: park until the OS has something to say, or until
      # the readout heartbeat is due. Shared policy from
      # lib/ui/eventLoop.rae rather than a hardcoded timeout.
      let idleTimeout: Float = nextWaitTimeoutSec(
        visible: Gpu2d.renderableNow()
        animating: false
        mouseDown: false
        pollWatcher: false
        frameSec: 0.016667
        heartbeatSec: 1.0
      )
      Gpu2d.waitEvents(timeoutSec: idleTimeout)
    } else {
      if sceneAnimating or cameraMoved or uiLayoutDirty or extentChanged or hadUiEvents or timeAnimating {
        taaSettleFrames = 6
      } else {
        taaSettleFrames = taaSettleFrames - 1
      }
      renderedOnce = true
      if cameraMoved {
        stateDirty = true
      }
      # Flush at most 4x/sec. The snapshot is a dozen numbers, so the cost
      # is the file write, not the formatting.
      if stateDirty and not headless {
        let sinceSave: Float = (now - lastStateSave) as Float
        if sinceSave >= 0.25 {
          writeHotReloadStateFor(
            appId: state134AppId
            state: serialize134State(ui: uiState, rig: cameraRig, camera: camera)
          )
          lastStateSave = now
          stateDirty = false
        }
      }
      if uiState.paused is false {
        var motionScale: Float = 1.0
        # Was a half-speed TOGGLE; now the shared percentage, so 134 and 136
        # express animation speed the same way (settings_dialog).
        motionScale = motionScale * editorPanel.settings.speed
        simTime = simTime + deltaTime * motionScale
      }
      if uiState.activeScene is 1 {
        light = light1
      }
      if uiState.activeScene is 2 {
        light = light2
      }
      if uiState.activeScene is 3 {
        light = light3
      }
      # AFTER the scene's own light is restored, not before: this runs every
      # frame, so setting the sun anywhere earlier is silently undone here and
      # the time-of-day slider appears to do nothing.
      #
      # AND NOTHING MAY ASSIGN sunDir BELOW THIS. A hardcoded sun that orbited on
      # simTime used to sit on the next line, left over from before the panel
      # owned the sun (#328). It won every frame, so the time-of-day slider did
      # nothing at all — and because it keyed off simTime, PAUSING froze the sun
      # solid, which is how the bug was noticed.
      light.sunDir = settingsKeyLightDir(settingsState: editorPanel.settings)
      light.sunColor = settingsKeyLightColor(settingsState: editorPanel.settings)
      if uiState.activeScene is 1 {
        animateScene1(
          world: asset1.world
          cubeA: cubeAEntityId
          cubeB: cubeBEntityId
          torus: torusEntityId
          tags: clusters1
          time: simTime
        )
      }
      if uiState.activeScene is 2 {
        animateScene(world: asset2.world, sceneId: 2, time: simTime)
        animateMetaballLab(world: asset2.world, tags: clusters2, time: simTime)
      }
      if uiState.activeScene is 3 {
        animateScene3(world: asset3.world, time: simTime)
      }

      let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
      # Rendering reads the active World3d directly through the RenderSystem's
      # ECS queries (mesh + per-cluster sdf). The generic passes below go through
      # renderDeferredPassWorld; ssao/lighting/taa/composite never read the world,
      # so any live world satisfies the signature — asset1.world is passed.
      # Frame order is DERIVED by the render graph (#331/#332): scene3d
      # writes the color target, the UI overlay MODIFIES it (load-preserving),
      # present reads it. The passes are declared backwards in
      # createRenderer3dWithUi; this loop runs them in dependency order.
      gpuPassTimingBegin(renderer: renderer)
      var pi3: Int = 0
      loop pi3 < deferredOrderLength(renderer: renderer) {
        let tag: Int = deferredTagAt(renderer: renderer, i: pi3)
        gpuPassMark(renderer: renderer, tag: tag)
        if tag is RenderTag.shadow {
          # Fit the cascades to THIS frame's camera and sun, then
          # rasterise every visible mesh into them (#382). The graph put
          # this before the scene pass because the scene pass declares a
          # read of what it writes.
          let cascades: ShadowCascades = fitShadowCascades(
            camPos: camera.position
            camTarget: camera.target
            fovYDeg: camera.fovYDeg
            aspect: aspect
            near: camera.nearZ
            far: 45.0
            sunDir: light.sunDir
            count: 3
            resolution: 2048
            lambda: 0.7
            backExtent: 30.0
          )
          beginShadowPass(renderer: renderer, c: cascades)
          # SHADOWS OFF means filling no cascades. renderer_deferred's note says
          # an app that skips the shadow pass renders unshadowed, which is what a
          # frame with no shadow pass should look like — so the toggle is simply
          # not doing the work, with no renderer flag to thread through.
          if editorPanel.settings.shadows {
            if uiState.activeScene is 1 {
              renderSceneShadowWorldWith(renderer: renderer, world: asset1.world)
              renderSdfShadow(renderer: renderer, world: asset1.world, tags: clusters1)
            }
            if uiState.activeScene is 2 {
              renderSceneShadowWorldWith(renderer: renderer, world: asset2.world)
              renderSdfShadow(renderer: renderer, world: asset2.world, tags: clusters2)
            }
            if uiState.activeScene is 3 {
              renderSceneShadowWorldWith(renderer: renderer, world: asset3.world)
              renderSdfShadow(renderer: renderer, world: asset3.world, tags: clusters3)
            }
          }
          endShadowPass(renderer: renderer)
          if shadowLogged is false {
            log(
              "[shadow] casters {shadowCasterCount(renderer: renderer)}, {cascades.count} cascades at {cascades.resolution}"
            )
            shadowLogged = true
          }
        }
        if tag is RenderTag.gbuffer {
          # App-owned so the ACTIVE scene is the one submitted.
          # #912: the geometry pass draws from the renderer-owned GPU manager.
          ensureRendererResources(renderer: renderer)
          if let resources: mod GpuResources = renderer.gpuResources {
            Gbuffer.beginPass(
              cache: renderer.passes.gbuffer
              resources: resources
              camera: camera
              light: light
              aspect: aspect
            )
            if uiState.activeScene is 1 {
              GbufferWorld.renderSceneWorld(
                cache: renderer.passes.gbuffer
                resources: resources
                world: asset1.world
              )
              renderSdfGbuffer(
                cache: renderer.passes.gbuffer
                resources: resources
                world: asset1.world
                tags: clusters1
                camera: camera
              )
            }
            if uiState.activeScene is 2 {
              GbufferWorld.renderSceneWorld(
                cache: renderer.passes.gbuffer
                resources: resources
                world: asset2.world
              )
              renderSdfGbuffer(
                cache: renderer.passes.gbuffer
                resources: resources
                world: asset2.world
                tags: clusters2
                camera: camera
              )
            }
            if uiState.activeScene is 3 {
              GbufferWorld.renderSceneWorld(
                cache: renderer.passes.gbuffer
                resources: resources
                world: asset3.world
              )
              renderSdfGbuffer(
                cache: renderer.passes.gbuffer
                resources: resources
                world: asset3.world
                tags: clusters3
                camera: camera
              )
            }
            Gbuffer.endPass(cache: renderer.passes.gbuffer, resources: resources)
          }
        }
        if tag is RenderTag.ssao or tag is RenderTag.depthPyramid or tag is RenderTag.lighting or tag is RenderTag.transparentForward or tag is RenderTag.taa or tag is RenderTag.antialias or tag is RenderTag.bloom or tag is RenderTag.composite {
          renderDeferredPassWorld(
            renderer: renderer
            tag: tag
            world: asset1.world
            camera: camera
            light: light
            aspect: aspect
          )
        }
        if tag is RenderTag.uiOverlay {
          # The chrome and the debug readout, then the log over the scene
          drawEditorPanel(editorPanel: editorPanel, canvas: renderer.canvas)
          drawLogOverlay(
            ov: logOverlay
            canvas: renderer.canvas
            font: editorPanel.gpuUi.textFont
            screenW: extentW
            screenH: extentH
          )
          lastLogRevision = logOverlay.revision
        }
        if tag is RenderTag.present {
          endUiFrameTimed(renderer: renderer)
        }
        pi3 = pi3 + 1
      }
      gpuPassTimingEnd(renderer: renderer)
      # Frame history for motion vectors (#336): PrevTransformSystem (#735) makes
      # the ACTIVE scene's current transforms its previous-frame set. Inactive
      # scenes are not advanced — they aren't rendered, so they have no frame
      # history to keep, and their first frame back re-syncs on the next run.
      if uiState.activeScene is 1 {
        world3dPrevTransformSystem(world: asset1.world)
      }
      if uiState.activeScene is 2 {
        world3dPrevTransformSystem(world: asset2.world)
      }
      if uiState.activeScene is 3 {
        world3dPrevTransformSystem(world: asset3.world)
      }
    }
  }
  # Final flush: the throttle may have a pending change when the loop ends.
  # Headless runs neither read nor write the snapshot — a smoke test must
  # not clobber the scene and camera a developer left set up.
  if not headless {
    writeHotReloadStateFor(
      appId: state134AppId
      state: serialize134State(ui: uiState, rig: cameraRig, camera: camera)
    )
  }
  shutdownDeferredRenderer(renderer: renderer)  # #904: the renderer-owned GPU manager, before the C shutdown
  shutdown()
  # The renderer's canvas is shut down by shutdownDeferredRenderer.
  Gpu2d.closeWindow()
  ret 0
}
