import core

func benchmarkNative(count: view Int) ret Int {
  let l: List(Int) = createList(cap: 10)
  loop var i: Int = 0, i < count, ++i {
    l.add(value: i)
  }
  var total: Int = 0
  loop var j: Int = 0, j < l.length, ++j {
    total = total + l.copyAt(index: j)
  }
  ret total
}

func main() {
  let count: Int = 1000
  log("Benchmarking native List with {count} items...")
  let start: Int = nowMs()
  let result: Int = benchmarkNative(count: count)
  let end: Int = nowMs()
  log("Result: {result}")
  log("Time: {end - start}ms")
}
