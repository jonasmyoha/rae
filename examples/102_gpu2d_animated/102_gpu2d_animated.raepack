pack Gpu2dAnimated {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "2D Renderer — Step 2: Animated vector shapes"
  description: "The vector-shapes dashboard brought to life: gradients rotate, corners breathe, sonar rings expand and fade, a starburst spins through the spectrum, translucent discs orbit, and a header band scrolls with a bouncing marker — all one instanced draw of the same SDF pipeline (#110), with a shared FPS debug widget top-right. Runs Compiled (wgpu-native + SDL3) or in the browser as WASM."
  category: "2D Renderer"
  featured: "true"
  wasmWebApp: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
