{
  "type": "Scene",
  "version": 2,
  "root": "Chrome",
  "bundles": {
    "pill": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 44},
      "Size": {"w": {"mode": "Hug"}, "h": {"mode": "Fixed"}},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Padding": {"l": 12, "t": 0, "r": 12, "b": 0},
      "HitArea": {"kind": "Rect"},
      "Shape": {"kind": "RoundedRect", "fill": "editorButtonSecondary", "stroke": "editorButtonQuietEdge", "strokeWidth": 1.2, "radius": 22},
      "Shadow": {"blur": 12, "layers": 12, "opacity": 0.5, "color": "editorButtonGlow", "hasColor": true, "centered": true, "hoverOnly": true}
    }
  },
  "nodes": {
    "Chrome": {
      "Layout": {"type": "Vertical", "gap": 0, "alignCross": "Stretch"},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fill"}
      },
      "Children": ["TopBar", "Body", "StatusBar"]
    },
    "TopBar": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 76},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "Rect", "fill": "editorBar", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Horizontal", "gap": 8, "alignCross": "Center"},
      "Padding": {"l": 17, "r": 44, "t": 12, "b": 12},
      "Children": [
        "LeftToggle",
        "FileName",
        "BarSpacer",
        "ZoomPill",
        "OpenPill",
        "NodeCount",
        "DiagnosticsPill",
        "RightToggle"
      ]
    },
    "LeftToggle": {
      "bundles": ["pill"],
      "OnClick": {"actionId": "panel.left"},
      "Children": ["LeftToggleLabel"],
      "PanelToggle": {"panel": "left"}
    },
    "LeftToggleLabel": {
      "Rect": {"x": 0, "y": 0, "w": 62, "h": 32},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Panels",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "editorButtonText"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "FileName": {
      "Rect": {"x": 0, "y": 0, "w": 250, "h": 32},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "scene",
        "styleId": "h2",
        "styleOverride": {"size": 22, "color": "#E6FAFA"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.fileName", "format": "Plain", "prefix": "", "suffix": ""}
    },
    "BarSpacer": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 28},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      }
    },
    "ZoomPill": {
      "Rect": {"x": 0, "y": 0, "w": 138, "h": 44},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Layout": {"type": "Horizontal", "gap": 4, "alignCross": "Center"},
      "Padding": {"l": 5, "t": 0, "r": 5, "b": 0},
      "Children": ["ZoomOut", "ZoomLabel", "ZoomIn"]
    },
    "ZoomOut": {
      "Rect": {"x": 0, "y": 0, "w": 44, "h": 44},
      "HitArea": {"kind": "Rect"},
      "OnClick": {"actionId": "zoom.out"},
      "Text": {
        "text": "-",
        "styleId": "muted",
        "styleOverride": {"size": 22, "color": "editorButtonText"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "Shape": {
        "kind": "RoundedRect",
        "fill": "editorIconFill",
        "stroke": "editorIconEdge",
        "strokeWidth": 1.2,
        "radius": 22
      },
      "Shadow": {
        "blur": 12,
        "layers": 12,
        "opacity": 0.5,
        "color": "editorButtonGlow",
        "hasColor": true,
        "centered": true,
        "hoverOnly": true
      }
    },
    "ZoomLabel": {
      "Rect": {"x": 0, "y": 0, "w": 74, "h": 32},
      "HitArea": {"kind": "Rect"},
      "OnClick": {"actionId": "zoom.reset"},
      "Text": {
        "text": "100%",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#9FC1BD"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.zoomLabel", "format": "Plain", "prefix": "", "suffix": ""}
    },
    "ZoomIn": {
      "Rect": {"x": 0, "y": 0, "w": 44, "h": 44},
      "HitArea": {"kind": "Rect"},
      "OnClick": {"actionId": "zoom.in"},
      "Text": {
        "text": "+",
        "styleId": "muted",
        "styleOverride": {"size": 22, "color": "editorButtonText"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "Shape": {
        "kind": "RoundedRect",
        "fill": "editorIconFill",
        "stroke": "editorIconEdge",
        "strokeWidth": 1.2,
        "radius": 22
      },
      "Shadow": {
        "blur": 12,
        "layers": 12,
        "opacity": 0.5,
        "color": "editorButtonGlow",
        "hasColor": true,
        "centered": true,
        "hoverOnly": true
      }
    },
    "OpenPill": {
      "bundles": ["pill"],
      "Shape": {"fill": "editorButtonPrimary", "stroke": "editorButtonEdge"},
      "Shadow": {"opacity": 0.22, "hoverOnly": false},
      "OnClick": {"actionId": "file.open"},
      "Children": ["OpenLabel"]
    },
    "OpenLabel": {
      "Rect": {"x": 0, "y": 0, "w": 70, "h": 32},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Open...",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "editorButtonText"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "NodeCount": {
      "Rect": {"x": 0, "y": 0, "w": 88, "h": 32},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "0 nodes",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#9FC1BD"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.nodeCount", "format": "Plain", "prefix": "", "suffix": ""}
    },
    "DiagnosticsPill": {
      "Rect": {"x": 0, "y": 0, "w": 138, "h": 44},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "#062B29", "stroke": "#78E6DC18", "strokeWidth": 1, "radius": 22},
      "Layout": {"type": "Horizontal", "gap": 0, "alignCross": "Center"},
      "Padding": {"l": 12, "t": 0, "r": 12, "b": 0},
      "Children": ["DiagnosticsCount"],
      "DiagnosticsBadge": {"clearFill": "#0B3932", "errorFill": "#A04746"}
    },
    "DiagnosticsCount": {
      "Rect": {"x": 0, "y": 0, "w": 112, "h": 32},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "no diagnostics",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#C9EEE4"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.diagnosticsCount", "format": "Plain", "prefix": "", "suffix": ""}
    },
    "RightToggle": {
      "bundles": ["pill"],
      "OnClick": {"actionId": "panel.right"},
      "Children": ["RightToggleLabel"],
      "PanelToggle": {"panel": "right"}
    },
    "RightToggleLabel": {
      "Rect": {"x": 0, "y": 0, "w": 75, "h": 32},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Inspector",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "editorButtonText"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "Body": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fill"}
      },
      "Layout": {"type": "Horizontal", "gap": 0, "alignCross": "Stretch"},
      "Children": ["LeftPanel", "EditArea", "RightPanel"]
    },
    "LeftPanel": {
      "Rect": {"x": 0, "y": 0, "w": 384, "h": 0},
      "Size": {
        "w": {"mode": "Fixed"},
        "h": {"mode": "Fill"}
      },
      "Shape": {"kind": "Rect", "fill": "#041A18", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 20, "alignCross": "Stretch"},
      "Padding": {"l": 19, "t": 19, "r": 19, "b": 19},
      "Children": ["ProjectPanel", "TreePanel", "DiagnosticsPanel"],
      "EditorPanel": {"panel": "left"},
      "Overflow": {"mode": "Clip"}
    },
    "EditArea": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fill"}
      },
      "EditArea": {}
    },
    "RightPanel": {
      "Rect": {"x": 0, "y": 0, "w": 384, "h": 0},
      "Size": {
        "w": {"mode": "Fixed"},
        "h": {"mode": "Fill"}
      },
      "Shape": {"kind": "Rect", "fill": "#041A18", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 20, "alignCross": "Stretch"},
      "Padding": {"l": 19, "t": 19, "r": 19, "b": 19},
      "Children": ["InspectorPanel"],
      "EditorPanel": {"panel": "right"}
    },
    "ProjectPanel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      },
      "Active": {"value": false},
      "Layout": {"type": "Vertical", "gap": 12, "alignCross": "Stretch"},
      "Children": ["ProjectTitle", "ProjectList"],
      "EditorPanel": {"panel": "project"}
    },
    "ProjectTitle": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 30},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Project",
        "styleId": "muted",
        "styleOverride": {"size": 17, "color": "#78E6DC"}
      },
      "TextBinding": {"key": "editor.projectTitle", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "ProjectList": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "ScrollState": {"y": 0},
      "ListView": {
        "itemSceneId": "chrome/ProjectRow",
        "itemKeyField": "id",
        "itemHeight": 38,
        "itemGap": 3,
        "visibleItemCount": 5,
        "overscanRows": 1,
        "bindings": [
          {"nodeId": "ProjectRow", "component": "OnClick", "field": "actionId", "itemField": "action"},
          {"nodeId": "ProjectMarker", "component": "Text", "field": "text", "itemField": "marker"},
          {"nodeId": "ProjectLabel", "component": "Text", "field": "text", "itemField": "label"}
        ]
      },
      "Overflow": {"mode": "Clip"},
      "EditorList": {"source": "project"},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      }
    },
    "TreePanel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      },
      "Active": {"value": true},
      "Layout": {"type": "Vertical", "gap": 12, "alignCross": "Stretch"},
      "Children": ["TreeTitle", "TreeViewport"],
      "EditorPanel": {"panel": "tree"}
    },
    "TreeTitle": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 30},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Hierarchy",
        "styleId": "muted",
        "styleOverride": {"size": 17, "color": "#78E6DC"}
      },
      "TextBinding": {"key": "editor.tree.header", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "TreeViewport": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 284},
      "Size": {"w": {"mode": "Fill"}, "h": {"mode": "Fixed"}},
      "Overflow": {"mode": "Clip"},
      "Children": ["TreeList"]
    },
    "TreeList": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "ScrollState": {"y": 0},
      "ListView": {
        "itemSceneId": "chrome/TreeRow",
        "itemKeyField": "id",
        "itemHeight": 38,
        "itemGap": 3,
        "visibleItemCount": 7,
        "overscanRows": 1,
        "bindings": [
          {"nodeId": "TreeRow", "component": "OnClick", "field": "actionId", "itemField": "action"},
          {"nodeId": "TreeRow", "component": "GradientFill", "field": "fromSlot", "itemField": "gradientFrom"},
          {"nodeId": "TreeRow", "component": "GradientFill", "field": "toSlot", "itemField": "gradientTo"},
          {"nodeId": "TreeChevronDown", "component": "Active", "field": "value", "itemField": "expanded"},
          {"nodeId": "TreeChevronDown", "component": "OnClick", "field": "actionId", "itemField": "chevronAction"},
          {"nodeId": "TreeChevronRight", "component": "Active", "field": "value", "itemField": "collapsed"},
          {"nodeId": "TreeChevronRight", "component": "OnClick", "field": "actionId", "itemField": "chevronAction"},
          {"nodeId": "Guide1", "component": "Active", "field": "value", "itemField": "guide1"},
          {"nodeId": "Guide2", "component": "Active", "field": "value", "itemField": "guide2"},
          {"nodeId": "Guide3", "component": "Active", "field": "value", "itemField": "guide3"},
          {"nodeId": "Guide4", "component": "Active", "field": "value", "itemField": "guide4"},
          {"nodeId": "Guide5", "component": "Active", "field": "value", "itemField": "guide5"},
          {"nodeId": "Guide6", "component": "Active", "field": "value", "itemField": "guide6"},
          {"nodeId": "TreeMarker", "component": "Text", "field": "text", "itemField": "marker"},
          {"nodeId": "TreeLabel", "component": "Text", "field": "text", "itemField": "label"}
        ]
      },
      "EditorList": {"source": "hierarchy"},
      "ScrollRoot": {"axis": "y", "floor": "content", "endInset": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      }
    },
    "DiagnosticsPanel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      },
      "Active": {"value": true},
      "Layout": {"type": "Vertical", "gap": 12, "alignCross": "Stretch"},
      "Children": ["PanelTitle", "DiagnosticList"],
      "EditorPanel": {"panel": "diagnostics"}
    },
    "PanelTitle": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 30},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Diagnostics",
        "styleId": "muted",
        "styleOverride": {"size": 17, "color": "#78E6DC"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "DiagnosticList": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "ScrollState": {"y": 0},
      "ListView": {
        "itemSceneId": "chrome/DiagnosticRow",
        "itemKeyField": "id",
        "itemHeight": 64,
        "itemGap": 4,
        "visibleItemCount": 3,
        "overscanRows": 1,
        "bindings": [
          {"nodeId": "RowKind", "component": "Text", "field": "text", "itemField": "kind"},
          {"nodeId": "RowWhere", "component": "Text", "field": "text", "itemField": "where"},
          {"nodeId": "RowName", "component": "Text", "field": "text", "itemField": "name"},
          {"nodeId": "RowMessage", "component": "Text", "field": "text", "itemField": "message"}
        ]
      },
      "Overflow": {"mode": "Clip"},
      "EditorList": {"source": "diagnostics"},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      }
    },
    "InspectorPanel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      },
      "Active": {"value": true},
      "SceneInstance": {"sceneId": "chrome/Inspector"}
    },
    "StatusBar": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 42},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "Rect", "fill": "#021210", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Horizontal", "gap": 12, "alignCross": "Center"},
      "Padding": {"l": 12, "t": 5, "r": 12, "b": 5},
      "Children": ["DesignSize", "StatusLine"]
    },
    "DesignSize": {
      "Rect": {"x": 0, "y": 0, "w": 188, "h": 22},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "1080 x 1920",
        "styleId": "muted",
        "styleOverride": {"size": 17, "color": "#9FC1BD"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.designSize", "format": "Plain", "prefix": "", "suffix": ""}
    },
    "StatusLine": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 22},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "H hides the chrome",
        "styleId": "muted",
        "styleOverride": {"size": 17, "color": "#9FC1BD"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.statusLine", "format": "Plain", "prefix": "", "suffix": ""}
    }
  }
}
