{
  "type": "Scene",
  "version": 2,
  "root": "Chrome",
  "nodes": {
    "Chrome": {
      "Layout": {"type": "Vertical", "gap": 0, "alignCross": "Stretch"},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fill"}
      },
      "Children": ["TopBar", "Body", "StatusBar"]
    },
    "TopBar": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 58},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "Rect", "fill": "#062B29", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Horizontal", "gap": 8, "alignCross": "Center"},
      "Padding": {"l": 14, "r": 14, "t": 10, "b": 10},
      "Children": [
        "LeftToggle",
        "FileName",
        "BarSpacer",
        "ZoomPill",
        "OpenPill",
        "NodeCount",
        "DiagnosticsPill",
        "RightToggle"
      ],
      "GradientFill": {"from": "#0A3832", "to": "#041A18", "angle": 90}
    },
    "LeftToggle": {
      "Rect": {"x": 0, "y": 0, "w": 80, "h": 34},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "#062B29", "stroke": "#78E6DC18", "strokeWidth": 1, "radius": 17.0},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Padding": {"l": 10, "t": 0, "r": 10, "b": 0},
      "HitArea": {"kind": "Rect"},
      "OnClick": {"actionId": "panel.left"},
      "Children": ["LeftToggleLabel"],
      "PanelToggle": {"panel": "left"}
    },
    "LeftToggleLabel": {
      "Rect": {"x": 0, "y": 0, "w": 50, "h": 22},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Panels",
        "styleId": "muted",
        "styleOverride": {"size": 12, "color": "#9FC1BD"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "FileName": {
      "Rect": {"x": 0, "y": 0, "w": 200, "h": 22},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "scene",
        "styleId": "h2",
        "styleOverride": {"size": 14, "color": "#E6FAFA"}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      },
      "TextBinding": {"key": "editor.fileName", "format": "Plain", "prefix": "", "suffix": ""}
    },
