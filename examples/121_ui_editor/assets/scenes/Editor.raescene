{
  "type": "Scene",
  "version": 2,
  "root": "Chrome",
  "nodes": {
    "Chrome": {
      "Layout": { "type": "Vertical", "gap": 0, "alignCross": "Stretch" },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fill" } },
      "Children": ["TopBar", "DiagnosticsPanel", "InspectorPanel", "TreePanel", "Spacer", "StatusBar"]
    },
    "TopBar": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 96 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Shape": { "kind": "Rect", "fill": "#10161eE6", "stroke": "#00000000", "strokeWidth": 0 },
      "Layout": { "type": "Horizontal", "gap": 14, "alignCross": "Center" },
      "Padding": { "l": 24, "t": 12, "r": 24, "b": 12 },
      "Children": ["FileName", "BarSpacer", "NodeCount", "DiagnosticsPill"]
    },
    "FileName": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 40 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "scene", "styleId": "h2", "styleOverride": { "size": 28, "color": "#f0f3fa" } }
    },
    "BarSpacer": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 40 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } }
    },
    "DesignSize": {
      "Rect": { "x": 0, "y": 0, "w": 170, "h": 40 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Margin": { "l": 0, "t": 0, "r": 24, "b": 0 },
      "Text": { "text": "1080 x 1920", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    },
    "NodeCount": {
      "Rect": { "x": 0, "y": 0, "w": 150, "h": 40 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "0 nodes", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    },
    "DiagnosticsPill": {
      "Rect": { "x": 0, "y": 0, "w": 230, "h": 48 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "stroke": "#00000000", "strokeWidth": 0, "radius": 24 },
      "Layout": { "type": "Horizontal", "gap": 0, "alignCross": "Center" },
      "Padding": { "l": 14, "t": 0, "r": 14, "b": 0 },
      "Children": ["DiagnosticsCount"]
    },
    "DiagnosticsCount": {
      "Rect": { "x": 0, "y": 0, "w": 194, "h": 40 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "no diagnostics", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    },
    "DiagnosticsPanel": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Active": { "value": false },
      "Shape": { "kind": "Rect", "fill": "#10161eD9", "stroke": "#00000000", "strokeWidth": 0 },
      "Layout": { "type": "Vertical", "gap": 8, "alignCross": "Stretch" },
      "Padding": { "l": 24, "t": 12, "r": 24, "b": 12 },
      "Children": ["PanelTitle", "DiagnosticList"]
    },
    "PanelTitle": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 32 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "Diagnostics — D hides", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    },
    "DiagnosticList": {
      "Rect": { "x": 0, "y": 0, "w": 1000, "h": 540 },
      "ScrollState": { "y": 0 },
      "ListView": {
        "itemSceneId": "chrome/DiagnosticRow",
        "itemKeyField": "id",
        "itemHeight": 84,
        "itemGap": 6,
        "visibleItemCount": 6,
        "overscanRows": 1,
        "bindings": [
          { "nodeId": "RowKind", "component": "Text", "field": "text", "itemField": "kind" },
          { "nodeId": "RowWhere", "component": "Text", "field": "text", "itemField": "where" },
          { "nodeId": "RowName", "component": "Text", "field": "text", "itemField": "name" },
          { "nodeId": "RowMessage", "component": "Text", "field": "text", "itemField": "message" }
        ]
      }
    },
    "InspectorPanel": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Active": { "value": false },
      "SceneInstance": { "sceneId": "chrome/Inspector" }
    },
    "TreePanel": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "Active": { "value": false },
      "Shape": { "kind": "Rect", "fill": "#10161eD9", "stroke": "#00000000", "strokeWidth": 0 },
      "Layout": { "type": "Vertical", "gap": 8, "alignCross": "Stretch" },
      "Padding": { "l": 24, "t": 12, "r": 24, "b": 12 },
      "Children": ["TreeTitle", "TreeList"]
    },
    "TreeTitle": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 32 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "Tree — T hides, click a row to select", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    },
    "TreeList": {
      "Rect": { "x": 0, "y": 0, "w": 1000, "h": 400 },
      "ScrollState": { "y": 0 },
      "ListView": {
        "itemSceneId": "chrome/TreeRow",
        "itemKeyField": "id",
        "itemHeight": 40,
        "itemGap": 4,
        "visibleItemCount": 12,
        "overscanRows": 1,
        "bindings": [
          { "nodeId": "TreeRow", "component": "Padding", "field": "l", "itemField": "indent" },
          { "nodeId": "TreeRow", "component": "OnClick", "field": "actionId", "itemField": "action" },
          { "nodeId": "TreeMarker", "component": "Text", "field": "text", "itemField": "marker" },
          { "nodeId": "TreeLabel", "component": "Text", "field": "text", "itemField": "label" }
        ]
      }
    },
    "Spacer": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fill" } }
    },
    "StatusBar": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 64 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Shape": { "kind": "Rect", "fill": "#10161eE6", "stroke": "#00000000", "strokeWidth": 0 },
      "Layout": { "type": "Horizontal", "gap": 0, "alignCross": "Center" },
      "Padding": { "l": 24, "t": 8, "r": 24, "b": 8 },
      "Children": ["DesignSize", "StatusLine"]
    },
    "StatusLine": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 40 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "H hides the chrome", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    }
  }
}
