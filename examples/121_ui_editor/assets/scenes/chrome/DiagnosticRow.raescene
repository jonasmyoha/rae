      "Shape": { "kind": "RoundedRect", "fill": "#1a2230F0", "stroke": "#00000000", "strokeWidth": 0, "radius": 12 },
      "Layout": { "type": "Vertical", "gap": 2, "alignCross": "Start" },
      "Padding": { "l": 16, "t": 8, "r": 16, "b": 8 },
      "Children": ["RowHead", "RowMessage"]
    },
    "RowHead": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 32 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Layout": { "type": "Horizontal", "gap": 12, "alignCross": "Center" },
      "Children": ["RowKind", "RowWhere", "RowName"]
    },
    "RowKind": {
      "Rect": { "x": 0, "y": 0, "w": 200, "h": 30 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "kind", "styleId": "muted", "styleOverride": { "size": 22, "color": "#ff9640" } }
    },
    "RowWhere": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 30 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "scene/node", "styleId": "muted", "styleOverride": { "size": 22, "color": "#9ea8c2" } }
    },
    "RowName": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 30 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "name", "styleId": "muted", "styleOverride": { "size": 22, "color": "#f0f3fa" } }
    },
    "RowMessage": {
