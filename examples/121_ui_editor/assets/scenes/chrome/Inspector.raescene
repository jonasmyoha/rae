{
  "type": "Scene",
  "version": 2,
  "root": "Inspector",
  "nodes": {
    "Inspector": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "#0A3838", "stroke": "#78E6DC14", "strokeWidth": 1, "radius": 20},
      "Layout": {"type": "Vertical", "gap": 12, "alignCross": "Stretch"},
      "Padding": {"l": 29, "t": 14, "r": 29, "b": 17},
      "Children": ["InsNodeId", "InsType", "InsComponents", "InsAppComponents", "InsRect", "InsWidgets", "InsParents"]
    },
    "InsNodeId": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 35},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "nothing selected",
        "styleId": "h2",
        "styleOverride": {"size": 24, "color": "#E6FAFA"},
        "wrapWidthMode": "NodeWidth"
      },
      "TextBinding": {"key": "editor.inspector.nodeId", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "InsType": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 35},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#9FC1BD"},
        "wrapWidthMode": "NodeWidth"
      },
      "TextBinding": {"key": "editor.inspector.type", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "InsComponents": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 120},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#9FC1BD"},
        "wrapWidthMode": "NodeWidth"
      },
      "TextBinding": {"key": "editor.inspector.components", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "InsAppComponents": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#C9A86A"},
        "wrapWidthMode": "NodeWidth"
      },
      "TextBinding": {"key": "editor.inspector.appComponents", "format": "Plain", "prefix": "", "suffix": ""}
    },
    "InsRect": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#9FC1BD"},
        "wrapWidthMode": "NodeWidth"
      },
      "TextBinding": {"key": "editor.inspector.rect", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "InsWidgets": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "ScrollState": {"y": 0},
      "ListView": {
        "itemSceneId": "chrome/ComponentRow",
        "itemKeyField": "id",
        "itemHeight": 26,
        "itemGap": 2,
        "visibleItemCount": 12,
        "overscanRows": 1,
        "bindings": [
          {"nodeId": "ComponentRow", "component": "Padding", "field": "l", "itemField": "indent"},
          {"nodeId": "RowName", "component": "Text", "field": "text", "itemField": "name"},
          {"nodeId": "RowValue", "component": "Text", "field": "text", "itemField": "value"}
        ]
      },
      "Overflow": {"mode": "Clip"},
      "EditorList": {"source": "components"},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      }
    },
    "InsParents": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "",
        "styleId": "muted",
        "styleOverride": {"size": 19, "color": "#9FC1BD"},
        "wrapWidthMode": "NodeWidth"
      },
      "TextBinding": {"key": "editor.inspector.parents", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    }
  }
}
