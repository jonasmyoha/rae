{
  "type": "Scene",
  "version": 2,
  "root": "Guides",
  "nodes": {
    "Guides": {
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fill"}
      },
      "EditorPanel": {"panel": "guides"},
      "Children": ["FrameSpace", "HoverOutline", "SelectionOutline", "NodeOutlines", "ButtonOutlines"]
    },
    "FrameGuide": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Shape": {
        "kind": "Rect",
        "fill": "#00000000",
        "stroke": "#78E6DC55",
        "strokeWidth": 1,
        "strokeDash": 8,
        "strokeGap": 12
      },
      "GuideRect": {"kind": "frame"}
    },
    "SafeAreaGuide": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Active": {"value": false},
      "Shape": {
        "kind": "Rect",
        "fill": "#00000000",
        "stroke": "#78E6DC55",
        "strokeWidth": 1,
        "strokeDash": 8,
        "strokeGap": 12
      },
      "GuideRect": {"kind": "safeArea"}
    },
    "FrameLabel": {
      "Rect": {"x": 0, "y": 0, "w": 400, "h": 28},
      "Text": {
        "text": "frame",
        "styleId": "muted",
        "styleOverride": {"size": 20, "color": "#78B9AF"}
      },
      "GuideRect": {"kind": "frameLabel"},
      "TextBinding": {"key": "editor.frameLabel", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "SafeAreaLabel": {
      "Rect": {"x": 0, "y": 0, "w": 400, "h": 28},
      "Active": {"value": false},
      "Text": {
        "text": "safe area",
        "styleId": "muted",
        "styleOverride": {"size": 20, "color": "#78B9AF"}
      },
      "GuideRect": {"kind": "safeAreaLabel"},
      "TextBinding": {"key": "editor.safeAreaLabel", "format": "Plain", "prefix": "", "suffix": ""},
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "FrameSpace": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Camera2D": {},
      "Children": ["FrameGuide", "SafeAreaGuide", "FrameLabel", "SafeAreaLabel"]
    },
    "HoverOutline": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Active": {"value": false},
      "OutlineFor": {"role": "hover"},
      "Shape": {"kind": "Rect", "fill": "#00000000", "stroke": "#78E6DCAA", "strokeWidth": 2}
    },
    "SelectionOutline": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Active": {"value": false},
      "OutlineFor": {"role": "selection"},
      "Shape": {"kind": "Rect", "fill": "#00000000", "stroke": "#00E8D2EE", "strokeWidth": 2.5}
    },
    "NodeOutlines": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Active": {"value": false},
      "EditorPanel": {"panel": "outlines"},
      "OutlinePool": {"matches": "all", "itemSceneId": "chrome/NodeOutline"}
    },
    "ButtonOutlines": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Active": {"value": false},
      "EditorPanel": {"panel": "buttons"},
      "OutlinePool": {"matches": "buttons", "itemSceneId": "chrome/ButtonOutline"}
    }
  }
}
