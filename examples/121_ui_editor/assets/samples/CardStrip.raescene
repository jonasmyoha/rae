{
  "type": "Scene",
  "version": 2,
  "import": ["Theme"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 360, "h": 640},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 9.3333, "alignCross": "Stretch"},
      "Padding": {"l": 16, "t": 33.3333, "r": 16, "b": 24},
      "Children": ["Eyebrow", "Heading", "CollectionNote", "Strip", "HandRow", "Details", "Note"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Heading": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 49.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Your hand", "styleId": "display"}
    },
    "Strip": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 213.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignMain": "SpaceBetween", "alignCross": "Center"},
      "Children": ["CardOne", "CardTwo", "CardThree"],
      "Margin": {"l": 0, "t": 24, "r": 0, "b": 0}
    },
    "CardOne": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 153.3333},
      "TransformFx": {
        "scaleX": 1,
        "scaleY": 1,
        "rotation": -0.12,
        "alpha": 1,
        "visible": true,
        "pivot": {"x": 0.5, "y": 1},
        "anchor": {"x": 0.5, "y": 1}
      },
      "SceneInstance": {
        "sceneId": "Card",
        "params": {
          "overrides": [
            {"nodeId": "CardTitle", "component": "Text", "field": "text", "value": "Ember"},
            {"nodeId": "CardCost", "component": "Text", "field": "text", "value": "3"},
            {"nodeId": "CardKind", "component": "Text", "field": "text", "value": "spell / common"}
          ]
        }
      }
    },
    "CardTwo": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 153.3333},
      "TransformFx": {
        "scaleX": 1.06,
        "scaleY": 1.06,
        "rotation": 0,
        "alpha": 1,
        "visible": true,
        "pivot": {"x": 0.5, "y": 1},
        "anchor": {"x": 0.5, "y": 1}
      },
      "SceneInstance": {
        "sceneId": "Card",
        "params": {
          "overrides": [
            {"nodeId": "CardTitle", "component": "Text", "field": "text", "value": "Tide"},
            {"nodeId": "CardCost", "component": "Text", "field": "text", "value": "5"},
            {"nodeId": "CardKind", "component": "Text", "field": "text", "value": "creature / rare"},
            {"nodeId": "ArtIcon", "component": "Sprite", "field": "textureKey", "value": "mat:favorite"}
          ]
        }
      },
      "MaskShape": {"kind": "RoundedRect", "radius": 16, "sourceNodeId": ""}
    },
    "CardThree": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 153.3333},
      "TransformFx": {
        "scaleX": 1,
        "scaleY": 1,
        "rotation": 0.12,
        "alpha": 1,
        "visible": true,
        "pivot": {"x": 0.5, "y": 1},
        "anchor": {"x": 0.5, "y": 1}
      },
      "SceneInstance": {
        "sceneId": "Card",
        "params": {
          "overrides": [
            {"nodeId": "CardTitle", "component": "Text", "field": "text", "value": "Gale"},
            {"nodeId": "CardCost", "component": "Text", "field": "text", "value": "2"},
            {"nodeId": "CardKind", "component": "Text", "field": "text", "value": "trap / common"},
            {"nodeId": "ArtIcon", "component": "Sprite", "field": "textureKey", "value": "mat:whatshot"}
          ]
        }
      }
    },
    "Note": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 12},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Three possibilities. Make your next move.", "styleId": "caption"},
      "Margin": {"l": 0, "t": 5.3333, "r": 0, "b": 0}
    },
    "Eyebrow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 11.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "THE COLLECTION", "styleId": "eyebrow"}
    },
    "HandRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 37.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Margin": {"l": 0, "t": 16, "r": 0, "b": 0},
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignMain": "Center", "alignCross": "Center"},
      "Children": ["ManaPill", "PlayCard", "EndTurn"]
    },
    "ManaPill": {
      "Rect": {"x": 0, "y": 0, "w": 66.6667, "h": 29.3333},
      "Shape": {"kind": "RoundedRect", "fill": "surface", "stroke": "outline", "strokeWidth": 0.3333, "radius": 14.6667},
      "Layout": {"type": "Horizontal", "gap": 2.6667, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["ManaDot", "ManaText"]
    },
    "ManaDot": {
      "Rect": {"x": 0, "y": 0, "w": 7.3333, "h": 7.3333},
      "Shape": {"kind": "Circle", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0}
    },
    "ManaText": {
      "Rect": {"x": 0, "y": 0, "w": 36.6667, "h": 14.6667},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "6 / 10", "styleId": "buttonSecondary"}
    },
    "PlayCard": {
      "Rect": {"x": 0, "y": 0, "w": 120, "h": 33.3333},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 16.6667},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "OnClick": {"actionId": "hand.play", "label": "Play the card"},
      "Children": ["PlayCardLabel"],
      "GradientFill": {"from": "#69C7AC", "to": "#48B498", "angle": 100},
      "CornerRadius": {"radius": 16.6667}
    },
    "PlayCardLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 17.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Play card", "styleId": "button"}
    },
    "EndTurn": {
      "Rect": {"x": 0, "y": 0, "w": 76.6667, "h": 29.3333},
      "Shape": {"kind": "RoundedRect", "fill": "surfaceAlt", "stroke": "outline", "strokeWidth": 0.3333, "radius": 14.6667},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "OnClick": {"actionId": "hand.endTurn", "label": "End turn"},
      "Children": ["EndTurnLabel"]
    },
    "EndTurnLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 16},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "End turn", "styleId": "buttonSecondary"}
    },
    "CollectionNote": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 17.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "A hand worth holding.", "styleId": "muted"}
    },
    "Details": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 106.6667},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "#1B2C34", "stroke": "#FFFFFF0C", "strokeWidth": 0.3333, "radius": 16},
      "Layout": {"type": "Vertical", "gap": 5.3333, "alignCross": "Stretch"},
      "Padding": {"l": 12, "t": 12, "r": 12, "b": 12},
      "Children": ["DetailsEyebrow", "DetailsTitle", "DetailsBody"],
      "Margin": {"l": 0, "t": 13.3333, "r": 0, "b": 2.6667}
    },
    "DetailsEyebrow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 12},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "SELECTED  /  RARE", "styleId": "eyebrow"}
    },
    "DetailsTitle": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 20},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Tide changes everything.", "styleId": "h2"}
    },
    "DetailsBody": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 30.6667},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "A little patience. A powerful next turn.\nSpend five energy to bring Tide into play.",
        "styleId": "muted",
        "wrapWidthMode": "NodeWidth"
      }
    }
  }
}
