{
  "type": "Scene",
  "version": 2,
  "root": "Card",
  "nodes": {
    "Card": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 460 },
      "Shape": { "kind": "RoundedRect", "fill": "surface", "stroke": "outline", "strokeWidth": 4, "radius": 36 },
      "Layout": { "type": "Vertical", "gap": "spaceS", "alignCross": "Stretch" },
      "Padding": { "l": "spaceM", "t": "spaceM", "r": "spaceM", "b": "spaceM" },
      "Children": ["CardArt", "CardTitle", "CardCost"]
    },
    "CardArt": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 250 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Sprite": { "textureKey": "panel", "scaleMode": "Fill" },
      "CornerRadius": { "radius": 24 }
    },
    "CardTitle": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 50 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "Card", "styleId": "h2" }
    },
    "CardCost": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 40 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "0", "styleId": "muted" }
    }
  }
}
