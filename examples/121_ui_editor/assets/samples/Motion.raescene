{
  "type": "Scene",
  "version": 2,
  "import": ["Theme"],
  "root": "Page",
  "nodes": {
    "Page": {
      "Rect": { "x": 0, "y": 0, "w": 133.3333, "h": 133.3333 },
      "PageRoot": { "id": "motion" },
      "PageTransition": { "kind": "push" },
      "Shape": { "kind": "Rect", "fill": "surface" },
      "bundles": ["staggerFromStart"],
      "Children": ["Title", "RowOne", "RowTwo"]
    },
    "Title": {
      "Rect": { "x": 6.6667, "y": 6.6667, "w": 120, "h": 16.6667 },
      "AnimateText": { "kind": "fade" },
      "Text": { "text": "Motion", "styleId": "title" }
    },
    "RowOne": {
      "Rect": { "x": 6.6667, "y": 30, "w": 120, "h": 26.6667 },
      "bundles": ["appearRise", "disappearFade"],
      "SharedElement": { "key": "rowOne" },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": 4 }
    },
    "RowTwo": {
      "Rect": { "x": 6.6667, "y": 63.3333, "w": 120, "h": 26.6667 },
      "bundles": ["appearRise", "disappearFade", "glideOnChange"],
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "radius": 4 }
    }
  }
}
