{
  "type": "Scene",
  "version": 2,
  "import": ["Theme"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Camera2D": {"zoom": 1, "offsetX": 0, "offsetY": 0},
      "Rect": {"x": 0, "y": 0, "w": 360, "h": 640},
      "Size": {
        "w": {"mode": "Fixed", "min": 360, "max": 360},
        "h": {"mode": "Fixed", "min": 640, "max": 640}
      },
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {
        "type": "Vertical",
        "gap": "spaceM",
        "alignMain": "Start",
        "alignCross": "Stretch",
        "columns": 1,
        "rowGap": 0,
        "columnGap": 0
      },
      "Padding": "screenEdgePadding",
      "SafeArea": {
        "enabled": true,
        "apply": {"l": 0, "t": 0, "r": 0, "b": 0},
        "extra": {"l": 0, "t": 0, "r": 0, "b": 0}
      },
      "Overflow": {"mode": "Clip"},
      "ExtentAnchor": {"h": "Fill"},
      "PointerEvents": {"enabled": true, "cursor": "default", "blockChildren": false},
      "PrimaryType": {"typeName": "Screen"},
      "Name": {"label": "Coverage screen"},
      "NodeId": {"id": "Screen"},
      "SceneScope": {"scope": "coverage"},
      "EditorVisible": {"value": true},
      "EditorLocked": {"value": false},
      "DebugAnchor": {"value": false},
      "PageRoot": {"id": "coverage"},
      "LayerRef": {},
      "LayerTag": {"id": "content"},
      "Children": ["Heading", "TextBlock", "ShapeRow", "SpriteRow", "CardsRow", "ListBlock", "MetaRow", "Footer"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Heading": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 30},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Coverage",
        "styleId": "title",
        "wrapWidthMode": "None",
        "styleOverride": {"size": 24}
      },
      "TextShadow": {
        "color": "#00000099",
        "offset": {"x": 0.6667, "y": 1},
        "softness": 2
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "TextBlock": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Hug"}
      },
      "ContainerStyle": "card",
      "Layout": {"type": "Vertical", "gap": "spaceS", "alignCross": "Stretch"},
      "Children": ["WrappedText", "HugText"],
      "Padding": {"l": 9.3333, "t": 9.3333, "r": 9.3333, "b": 9.3333}
    },
    "WrappedText": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "wrapWidthMode NodeWidth wraps this long sentence inside the card instead of running off the right edge of the screen",
        "styleId": "prose",
        "wrapWidthMode": "NodeWidth",
        "styleOverride": {"size": 10}
      },
      "Constraints": {
        "minW": 66.6667,
        "maxW": 338.6667,
        "minH": 13.3333,
        "maxH": 66.6667,
        "hasMinW": true,
        "hasMaxW": true,
        "hasMinH": true,
        "hasMaxH": true
      }
    },
    "HugText": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 0},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Hug"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 16},
      "Padding": {"l": "spaceS", "t": "spaceXS", "r": "spaceS", "b": "spaceXS"},
      "Layout": {"type": "Horizontal", "gap": 0, "alignCross": "Center"},
      "Align": {"x": "Start", "y": "Center", "hasX": true, "hasY": true},
      "Children": ["HugLabel"],
      "DiagnosticsBadge": {"clearFill": "#48B498", "errorFill": "#A04746"}
    },
    "HugLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 13.3333},
      "Size": {
        "w": {"mode": "Hug"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "hug x hug chip", "styleId": "button"}
    },
    "ShapeRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 66.6667},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignMain": "SpaceBetween", "alignCross": "Center"},
      "Children": ["ShadowBox", "GradientBox", "CircleMask", "ScaledBox", "FadedBox"]
    },
    "ShadowBox": {
      "Rect": {"x": 0, "y": 0, "w": 56.6667, "h": 50},
      "Shape": {"kind": "RoundedRect", "fill": "surfaceAlt", "stroke": "outline", "strokeWidth": 0.3333, "radius": 25.0},
      "Shadow": {
        "blur": 8,
        "layers": 12,
        "opacity": 0.45,
        "color": {"r": 0, "g": 232, "b": 210, "a": 255},
        "hasColor": true,
        "centered": true,
        "hoverOnly": false
      },
      "CornerRadius": {"radius": 8},
      "HitArea": {"kind": "RoundedRect", "radius": 8},
      "OnClick": {
        "actionId": "coverage.shadow",
        "label": "Shadow",
        "actionIdDouble": "coverage.shadow2",
        "labelDouble": "Shadow, double tap",
        "actionIdTriple": "coverage.shadow3",
        "labelTriple": "Shadow, triple tap",
        "maxDelayMs": 300
      },
      "Button": {"role": "secondary"},
      "HoverScale": {"restScale": 1, "hoverScale": 1.08, "pressedScale": 0.96, "speed": 12, "current": 1, "target": 1},
      "WidgetId": {"id": "shadow-box", "kind": "button"},
      "WidgetState": {"enabled": true, "selected": false, "loading": false, "error": false},
      "ActionBinding": {"actionId": "coverage.shadow", "role": "primary"}
    },
    "GradientBox": {
      "Rect": {"x": 0, "y": 0, "w": 56.6667, "h": 50},
      "GradientFill": {"from": "accent", "to": "surfaceAlt", "angle": 125},
      "CornerRadius": {"radius": 8},
      "Aspect": {"ratio": 1.1333},
      "ScaleToFit": {"mode": "Contain"},
      "Shadow": {
        "blur": 5.3333,
        "layers": 12,
        "opacity": 0.5,
        "color": {"r": 0, "g": 232, "b": 210, "a": 255},
        "hasColor": true,
        "centered": true,
        "hoverOnly": true
      },
      "HitArea": {"kind": "Rect"},
      "OnClick": {"actionId": "coverage.glow", "label": "Glow"}
    },
    "CircleMask": {
      "Rect": {"x": 0, "y": 0, "w": 56.6667, "h": 50},
      "MaskShape": {"kind": "Circle", "sourceNodeId": "", "radius": 0},
      "Sprite": {
        "textureKey": "panel",
        "tint": "#ffffffff",
        "tintSlot": "",
        "scaleMode": "Fill",
        "tileScale": {"x": 1, "y": 1},
        "nineSlice": {"l": 0, "t": 0, "r": 0, "b": 0},
        "hasNineSlice": false
      }
    },
    "ScaledBox": {
      "Rect": {"x": 0, "y": 0, "w": 56.6667, "h": 50},
      "Shape": {"kind": "RoundedRect", "fill": "#60c8ff", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 16},
      "TransformFx": {
        "scaleX": 0.7,
        "scaleY": 0.7,
        "rotation": 0.2,
        "alpha": 1,
        "visible": true,
        "pivot": {"x": 0.5, "y": 0.5},
        "anchor": {"x": 0.5, "y": 0.5}
      },
      "Offset": {
        "delta": {"x": 0, "y": 0}
      }
    },
    "FadedBox": {
      "Rect": {"x": 0, "y": 0, "w": 56.6667, "h": 50},
      "Shape": {"kind": "Circle", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0},
      "RadialGradientFill": {"from": "#FFFFFF", "to": "accent", "centerX": 0.35, "centerY": 0.3, "radius": 0.9, "stop": 1},
      "Opacity": {"value": 0.35},
      "Active": {"value": true},
      "Layout": {"type": "Stack", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["FadedChild"]
    },
    "FadedChild": {
      "Rect": {"x": 0, "y": 0, "w": 20, "h": 20},
      "Shape": {"kind": "Rect", "fill": "#ffffff", "stroke": "#00000000", "strokeWidth": 0},
      "Margin": {"l": 18.3333, "t": 15, "r": 0, "b": 0}
    },
    "SpriteRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 66.6667},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Layout": {
        "type": "Grid",
        "gap": 0,
        "columns": 4,
        "rowGap": "spaceS",
        "columnGap": "spaceM",
        "alignCross": "Start"
      },
      "Children": ["NineSlice", "IconSprite", "BackdropBox", "SourceMasked"]
    },
    "NineSlice": {
      "Rect": {"x": 0, "y": 0, "w": 80, "h": 60},
      "Sprite": {
        "textureKey": "panel",
        "scaleMode": "Stretch",
        "nineSlice": {"l": 24, "t": 24, "r": 24, "b": 24},
        "hasNineSlice": true
      },
      "AnimFrames": {
        "baseKey": "frame",
        "frameCount": 3,
        "frames": [0, 1, 2],
        "textureKeys": [],
        "fps": 4,
        "loopForever": true,
        "onEndTextureKey": ""
      },
      "AnimTrigger": {"event": "click", "actionId": "coverage.anim", "restartOnTrigger": true}
    },
    "IconSprite": {
      "Rect": {"x": 0, "y": 0, "w": 80, "h": 60},
      "Sprite": {"textureKey": "mat:favorite", "tint": "accent", "tintSlot": "accent", "scaleMode": "Fit"},
      "ImageSourceResolver": {
        "mode": "Fixed",
        "textureKeys": ["logo"],
        "seed": "coverage",
        "once": true,
        "sharedHash": ""
      },
      "WobbleFx": {"amp": 4, "freq": 2, "secondAmp": 1, "secondFreq": 5}
    },
    "BackdropBox": {
      "Rect": {"x": 0, "y": 0, "w": 80, "h": 60},
      "BackdropImage": {"textureKey": "logo"},
      "CornerRadius": {"radius": 10.6667},
      "BackgroundPan": {"speedX": 2.6667, "speedY": 0, "amplitudeX": 4, "amplitudeY": 0},
      "SmokeFx": {
        "spawnIntervalMs": 400,
        "jitter": 6,
        "lifetimeMs": 1200,
        "driftX": 0,
        "driftY": -60,
        "scaleStart": 0.5,
        "scaleEnd": 1.5,
        "fadeMs": 600
      },
      "Layout": {"type": "Stack", "gap": 0, "alignMain": "Center", "alignCross": "End"},
      "Children": ["Puff0", "Puff1", "Puff2"]
    },
    "Puff0": {
      "Rect": {"x": 0, "y": 0, "w": 13.3333, "h": 13.3333},
      "Shape": {"kind": "Circle", "fill": "#f0f3fa", "stroke": "#00000000", "strokeWidth": 0},
      "Opacity": {"value": 0}
    },
    "Puff1": {
      "Rect": {"x": 0, "y": 0, "w": 13.3333, "h": 13.3333},
      "Shape": {"kind": "Circle", "fill": "#f0f3fa", "stroke": "#00000000", "strokeWidth": 0},
      "Opacity": {"value": 0}
    },
    "Puff2": {
      "Rect": {"x": 0, "y": 0, "w": 13.3333, "h": 13.3333},
      "Shape": {"kind": "Circle", "fill": "#f0f3fa", "stroke": "#00000000", "strokeWidth": 0},
      "Opacity": {"value": 0}
    },
    "SourceMasked": {
      "Rect": {"x": 0, "y": 0, "w": 80, "h": 60},
      "Layout": {"type": "Stack", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["MaskSource", "MaskedBySource"]
    },
    "MaskSource": {
      "Rect": {"x": 0, "y": 0, "w": 40, "h": 40},
      "Margin": {"l": 20, "t": 10, "r": 0, "b": 0},
      "Shape": {"kind": "RoundedRect", "fill": "#00000000", "stroke": "outline", "strokeWidth": 0.3333, "radius": 16}
    },
    "MaskedBySource": {
      "Rect": {"x": 0, "y": 0, "w": 80, "h": 60},
      "MaskShape": {"kind": "RoundedRect", "sourceNodeId": "MaskSource", "radius": 10},
      "Sprite": {"textureKey": "logo", "scaleMode": "Fill"}
    },
    "CardsRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignMain": "SpaceBetween", "alignCross": "Center"},
      "Carousel": {
        "axis": "Start",
        "swipeThreshold": 40,
        "transitionDuration": 0.4,
        "travelFactor": 1,
        "previewScale": 0.9,
        "autoAdvanceSeconds": 1.2
      },
      "Children": ["CardA", "CardB", "CardC"]
    },
    "CardA": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 46.6667},
      "SceneInstance": {
        "sceneId": "CoverageCard",
        "params": {
          "overrides": [{"nodeId": "CardTitle", "component": "Text", "field": "text", "value": "instance A"}]
        }
      }
    },
    "CardB": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 46.6667},
      "SceneInstance": {
        "sceneId": "CoverageCard",
        "params": {
          "overrides": [{"nodeId": "CardTitle", "component": "Text", "field": "text", "value": "instance B"}]
        }
      }
    },
    "CardC": {
      "Rect": {"x": 0, "y": 0, "w": 100, "h": 46.6667},
      "SceneInstance": {
        "sceneId": "CoverageCard",
        "params": {
          "overrides": [{"nodeId": "CardTitle", "component": "Text", "field": "text", "value": "instance C"}]
        }
      }
    },
    "ListBlock": {
      "Rect": {"x": 0, "y": 0, "w": 338.6667, "h": 93.3333},
      "ScrollState": {"y": 0, "velocity": 0},
      "ListView": {
        "itemSceneId": "CoverageRow",
        "itemKeyField": "id",
        "itemHeight": 20,
        "itemGap": "spaceXS",
        "visibleItemCount": 4,
        "overscanRows": 1,
        "bindings": [
          {
            "nodeId": "RowLabel",
            "component": "Text",
            "field": "text",
            "itemField": "label",
            "prefix": "",
            "suffix": ""
          }
        ],
        "loadingSceneId": "CoverageRow",
        "emptySceneId": "CoverageRow",
        "errorSceneId": "CoverageRow"
      },
      "DataRequest": {
        "endpoint": "coverage/rows",
        "mode": "Top",
        "initialLimit": 8,
        "aroundBefore": 0,
        "aroundAfter": 0,
        "pageLimit": 8,
        "accountIdSource": "None",
        "itemsField": "items",
        "cursorBeforeField": "before",
        "cursorAfterField": "after"
      },
      "DataDependency": {"resource": "Library", "field": "All", "observedRevision": 0},
      "RefreshRegion": {"regionKey": "coverage-list", "resource": "Library", "observedRevision": 0, "dirty": false},
      "Overflow": {"mode": "Clip"},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      }
    },
    "MetaRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 20},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Layout": {"type": "Horizontal", "gap": "spaceS", "alignCross": "Center"},
      "Children": [
        "MetaStat",
        "MetaAvatar",
        "MetaGrid",
        "MetaSearch",
        "MetaResults",
        "MetaHistory",
        "MetaNav",
        "MetaAlbum",
        "MetaTracks",
        "MetaProgress",
        "MetaSheet",
        "MetaPlayback"
      ]
    },
    "MetaStat": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "Text": {"text": "0", "styleId": "muted"}
    },
    "MetaAvatar": {
      "Rect": {"x": 0, "y": 0, "w": 13.3333, "h": 13.3333},
      "Sprite": {"textureKey": "logo", "scaleMode": "Fit"},
      "HeroWidget": {"key": "avatar"}
    },
    "MetaGrid": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "Layout": {"type": "Grid", "columns": 2, "columnGap": 1.3333, "rowGap": 1.3333},
      "ListSource": {"source": "Library", "builtKey": ""}
    },
    "MetaSearch": {
      "Rect": {"x": 0, "y": 0, "w": 40, "h": 13.3333},
      "Text": {"text": "search", "styleId": "muted"},
      "TextField": {
        "text": "",
        "placeholder": "Search",
        "textStyleId": "body",
        "placeholderStyleId": "muted"
      }
    },
    "MetaResults": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "ListSource": {"source": "SearchTracks", "builtKey": ""}
    },
    "MetaHistory": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333}
    },
    "MetaNav": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "Text": {"text": "nav", "styleId": "muted"},
      "AnchorBottom": {"enabled": false}
    },
    "MetaAlbum": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333}
    },
    "MetaTracks": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "ListSource": {"source": "AlbumTracks", "builtKey": ""}
    },
    "MetaProgress": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "Shape": {"kind": "RoundedRect", "fill": "outline", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 6.6667},
      "ProgressBar": {"enabled": true}
    },
    "MetaSheet": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "BottomSheet": {"panelNodeId": "Panel", "rowHeight": 20}
    },
    "MetaPlayback": {
      "Rect": {"x": 0, "y": 0, "w": 26.6667, "h": 13.3333},
      "RuntimeOnly": {"value": false}
    },
    "Footer": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 13.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "LayerRoot": {"id": "coverage-footer", "order": 0},
      "ZoomBehavior": {"mode": "Scales", "minScale": 0.5, "maxScale": 2, "pivotX": 0, "pivotY": 0, "showFrom": 0, "showTo": 0, "fade": 1.25},
      "Text": {"text": "every authorable lib/ui component, on one page", "styleId": "caption"}
    }
  },
  "frames": {
    "Phone": {
      "default": true,
      "viewport": {"w": 360, "h": 640},
      "nodes": {}
    },
    "Tablet": {
      "viewport": {"w": 768, "h": 640},
      "when": {"minWidthPt": 600},
      "nodes": {
        "Screen": {
          "Rect": {"x": 0, "y": 0, "w": 768, "h": 640},
          "Size": {
            "w": {"mode": "Fixed", "min": 768, "max": 768},
            "h": {"mode": "Fixed", "min": 640, "max": 640}
          }
        }
      }
    },
    "Touch": {
      "when": {"pointer": "coarse"},
      "nodes": {
        "ShadowBox": {"Rect": {"x": 0, "y": 0, "w": 66.6667, "h": 60}},
        "Footer": {"Active": {"value": false}}
      }
    }
  }
}
