{
  "type": "Scene",
  "version": 2,
  "sceneId": "Coverage",
  "import": ["Theme"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": { "x": 0, "y": 0, "w": 1080, "h": 1920 },
      "Size": { "w": { "mode": "Fixed", "min": 1080, "max": 1080 }, "h": { "mode": "Fixed", "min": 1920, "max": 1920 } },
      "Shape": { "kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0 },
      "Layout": { "type": "Vertical", "gap": "spaceM", "alignMain": "Start", "alignCross": "Stretch", "columns": 1, "rowGap": 0, "columnGap": 0 },
      "Padding": "screenEdgePadding",
      "SafeArea": { "enabled": true, "apply": { "l": 0, "t": 0, "r": 0, "b": 0 }, "extra": { "l": 0, "t": 0, "r": 0, "b": 0 } },
      "Overflow": { "mode": "Clip" },
      "ExtentAnchor": { "h": "Fill" },
      "PointerEvents": { "enabled": true, "cursor": "default", "blockChildren": false },
      "PrimaryType": { "typeName": "Screen" },
      "Name": { "label": "Coverage screen" },
      "NodeId": { "id": "Screen" },
      "SceneScope": { "scope": "coverage" },
      "EditorVisible": { "value": true },
      "EditorLocked": { "value": false },
      "DebugAnchor": { "value": false },
      "PageRoot": { "id": "coverage" },
      "LayerRef": {},
      "LayerTag": { "id": "content" },
      "Children": ["Heading", "TextBlock", "ShapeRow", "SpriteRow", "CardsRow", "ListBlock", "MetaRow", "Footer"]
    },
    "Heading": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 90 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "Coverage", "styleId": "title", "wrapWidthMode": "None" },
      "TextShadow": { "color": "#00000099", "offset": { "x": 2, "y": 3 }, "softness": 6 },
      "OpticalAlign": { "enabled": true, "centerX": true, "centerY": false, "bias": { "x": 0, "y": 0 } }
    },
    "TextBlock": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Hug" } },
      "ContainerStyle": "card",
      "Layout": { "type": "Vertical", "gap": "spaceS", "alignCross": "Stretch" },
      "Children": ["WrappedText", "HugText"]
    },
    "WrappedText": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 120 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "wrapWidthMode NodeWidth wraps this long sentence inside the card instead of running off the right edge of the screen", "styleId": "body", "wrapWidthMode": "NodeWidth" },
      "Constraints": { "minW": 200, "maxW": 1016, "minH": 40, "maxH": 200, "hasMinW": true, "hasMaxW": true, "hasMinH": true, "hasMaxH": true }
    },
    "HugText": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 0 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Hug" } },
      "Shape": { "kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0, "radius": "radiusChip" },
      "Padding": { "l": "spaceS", "t": "spaceXS", "r": "spaceS", "b": "spaceXS" },
      "Layout": { "type": "Horizontal", "gap": 0, "alignCross": "Center" },
      "Align": { "x": "Start", "y": "Center", "hasX": true, "hasY": true },
      "Children": ["HugLabel"]
    },
    "HugLabel": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 40 },
      "Size": { "w": { "mode": "Hug" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "hug x hug chip", "styleId": "button" }
    },
    "ShapeRow": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 200 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Layout": { "type": "Horizontal", "gap": "spaceM", "alignMain": "SpaceBetween", "alignCross": "Center" },
      "Children": ["ShadowBox", "GradientBox", "CircleMask", "ScaledBox", "FadedBox"]
    },
    "ShadowBox": {
      "Rect": { "x": 0, "y": 0, "w": 170, "h": 150 },
      "Shape": { "kind": "RoundedRect", "fill": "surfaceAlt", "stroke": "outline", "strokeWidth": 3, "radius": 24 },
      "Shadow": { "blur": 30 },
      "CornerRadius": { "radius": 24 },
      "HitArea": { "kind": "RoundedRect", "radius": 24 },
      "OnClick": { "actionId": "coverage.shadow", "actionIdDouble": "coverage.shadow2", "actionIdTriple": "coverage.shadow3", "maxDelayMs": 300 },
      "Button": { "role": "secondary" },
      "HoverScale": { "restScale": 1, "hoverScale": 1.08, "speed": 12, "current": 1, "target": 1 },
      "WidgetId": { "id": "shadow-box", "kind": "button" },
      "WidgetState": { "enabled": true, "selected": false, "loading": false, "error": false },
      "ActionBinding": { "actionId": "coverage.shadow", "role": "primary" }
    },
    "GradientBox": {
      "Rect": { "x": 0, "y": 0, "w": 170, "h": 150 },
      "GradientFill": { "from": "#ff9640", "to": "#60c8ff", "angle": 45 },
      "CornerRadius": { "radius": 24 },
      "Aspect": { "ratio": 1.1333 },
      "ScaleToFit": { "mode": "Contain" }
    },
    "CircleMask": {
      "Rect": { "x": 0, "y": 0, "w": 170, "h": 150 },
      "MaskShape": { "kind": "Circle", "sourceNodeId": "", "radius": 0 },
      "Sprite": { "textureKey": "panel", "tint": "#ffffffff", "tintSlot": "", "scaleMode": "Fill", "tileScale": { "x": 1, "y": 1 }, "nineSlice": { "l": 0, "t": 0, "r": 0, "b": 0 }, "hasNineSlice": false }
    },
    "ScaledBox": {
      "Rect": { "x": 0, "y": 0, "w": 170, "h": 150 },
      "Shape": { "kind": "RoundedRect", "fill": "#60c8ff", "stroke": "#00000000", "strokeWidth": 0, "radius": 20 },
      "TransformFx": { "scaleX": 0.7, "scaleY": 0.7, "rotation": 0.2, "alpha": 1, "visible": true, "pivot": { "x": 0.5, "y": 0.5 }, "anchor": { "x": 0.5, "y": 0.5 } },
      "Offset": { "delta": { "x": 0, "y": 0 } }
    },
    "FadedBox": {
      "Rect": { "x": 0, "y": 0, "w": 170, "h": 150 },
      "Shape": { "kind": "Circle", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0 },
      "Opacity": { "value": 0.35 },
      "Active": { "value": true },
      "Layout": { "type": "Stack", "gap": 0, "alignMain": "Center", "alignCross": "Center" },
      "Children": ["FadedChild"]
    },
    "FadedChild": {
      "Rect": { "x": 0, "y": 0, "w": 60, "h": 60 },
      "Shape": { "kind": "Rect", "fill": "#ffffff", "stroke": "#00000000", "strokeWidth": 0 },
      "Margin": { "l": 55, "t": 45, "r": 0, "b": 0 }
    },
    "SpriteRow": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 200 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Layout": { "type": "Grid", "gap": 0, "columns": 4, "rowGap": "spaceS", "columnGap": "spaceM", "alignCross": "Start" },
      "Children": ["NineSlice", "IconSprite", "BackdropBox", "SourceMasked"]
    },
    "NineSlice": {
      "Rect": { "x": 0, "y": 0, "w": 240, "h": 180 },
      "Sprite": { "textureKey": "panel", "scaleMode": "Stretch", "nineSlice": { "l": 24, "t": 24, "r": 24, "b": 24 }, "hasNineSlice": true },
      "AnimFrames": { "baseKey": "frame", "frameCount": 3, "frames": [0, 1, 2], "textureKeys": [], "fps": 4, "loopForever": true, "onEndTextureKey": "" },
      "AnimTrigger": { "event": "click", "actionId": "coverage.anim", "restartOnTrigger": true }
    },
    "IconSprite": {
      "Rect": { "x": 0, "y": 0, "w": 240, "h": 180 },
      "Sprite": { "textureKey": "mat:favorite", "tint": "accent", "tintSlot": "accent", "scaleMode": "Fit" },
      "ImageSourceResolver": { "mode": "Fixed", "textureKeys": ["logo"], "seed": "coverage", "once": true, "sharedHash": "" },
      "WobbleFx": { "amp": 4, "freq": 2, "secondAmp": 1, "secondFreq": 5 }
    },
    "BackdropBox": {
      "Rect": { "x": 0, "y": 0, "w": 240, "h": 180 },
      "BackdropImage": { "textureKey": "logo" },
      "CornerRadius": { "radius": 32 },
      "BackgroundPan": { "speedX": 8, "speedY": 0, "amplitudeX": 12, "amplitudeY": 0 },
      "SmokeFx": { "spawnIntervalMs": 400, "jitter": 6, "lifetimeMs": 1200, "driftX": 0, "driftY": -60, "scaleStart": 0.5, "scaleEnd": 1.5, "fadeMs": 600 },
      "Layout": { "type": "Stack", "gap": 0, "alignMain": "Center", "alignCross": "End" },
      "Children": ["Puff0", "Puff1", "Puff2"]
    },
    "Puff0": { "Rect": { "x": 0, "y": 0, "w": 40, "h": 40 }, "Shape": { "kind": "Circle", "fill": "#f0f3fa", "stroke": "#00000000", "strokeWidth": 0 }, "Opacity": { "value": 0 } },
    "Puff1": { "Rect": { "x": 0, "y": 0, "w": 40, "h": 40 }, "Shape": { "kind": "Circle", "fill": "#f0f3fa", "stroke": "#00000000", "strokeWidth": 0 }, "Opacity": { "value": 0 } },
    "Puff2": { "Rect": { "x": 0, "y": 0, "w": 40, "h": 40 }, "Shape": { "kind": "Circle", "fill": "#f0f3fa", "stroke": "#00000000", "strokeWidth": 0 }, "Opacity": { "value": 0 } },
    "SourceMasked": {
      "Rect": { "x": 0, "y": 0, "w": 240, "h": 180 },
      "Layout": { "type": "Stack", "gap": 0, "alignMain": "Center", "alignCross": "Center" },
      "Children": ["MaskSource", "MaskedBySource"]
    },
    "MaskSource": {
      "Rect": { "x": 0, "y": 0, "w": 120, "h": 120 },
      "Margin": { "l": 60, "t": 30, "r": 0, "b": 0 },
      "Shape": { "kind": "RoundedRect", "fill": "#00000000", "stroke": "outline", "strokeWidth": 2, "radius": 30 }
    },
    "MaskedBySource": {
      "Rect": { "x": 0, "y": 0, "w": 240, "h": 180 },
      "MaskShape": { "kind": "RoundedRect", "sourceNodeId": "MaskSource", "radius": 30 },
      "Sprite": { "textureKey": "logo", "scaleMode": "Fill" }
    },
    "CardsRow": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 150 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Layout": { "type": "Horizontal", "gap": "spaceM", "alignMain": "SpaceBetween", "alignCross": "Center" },
      "Carousel": { "axis": "Start", "swipeThreshold": 40, "transitionDuration": 0.4, "travelFactor": 1, "previewScale": 0.9, "autoAdvanceSec": 1.2 },
      "Children": ["CardA", "CardB", "CardC"]
    },
    "CardA": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 140 },
      "SceneInstance": { "sceneId": "CoverageCard", "params": { "overrides": [ { "nodeId": "CardTitle", "component": "Text", "field": "text", "value": "instance A" } ] } }
    },
    "CardB": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 140 },
      "SceneInstance": { "sceneId": "CoverageCard", "params": { "overrides": [ { "nodeId": "CardTitle", "component": "Text", "field": "text", "value": "instance B" } ] } }
    },
    "CardC": {
      "Rect": { "x": 0, "y": 0, "w": 300, "h": 140 },
      "SceneInstance": { "sceneId": "CoverageCard", "params": { "overrides": [ { "nodeId": "CardTitle", "component": "Text", "field": "text", "value": "instance C" } ] } }
    },
    "ListBlock": {
      "Rect": { "x": 0, "y": 0, "w": 1016, "h": 260 },
      "ScrollState": { "y": 0, "velocity": 0 },
      "ListView": {
        "itemSceneId": "CoverageRow", "itemKeyField": "id", "itemHeight": 60, "itemGap": "spaceXS", "visibleItemCount": 4, "overscanRows": 1,
        "bindings": [ { "nodeId": "RowLabel", "component": "Text", "field": "text", "itemField": "label", "prefix": "", "suffix": "" } ],
        "loadingSceneId": "CoverageRow", "emptySceneId": "CoverageRow", "errorSceneId": "CoverageRow"
      },
      "DataRequest": { "endpoint": "coverage/rows", "mode": "Top", "initialLimit": 8, "aroundBefore": 0, "aroundAfter": 0, "pageLimit": 8, "accountIdSource": "None", "itemsField": "items", "cursorBeforeField": "before", "cursorAfterField": "after" },
      "DataDependency": { "resource": "Library", "field": "All", "observedRevision": 0 },
      "RefreshRegion": { "regionKey": "coverage-list", "resource": "Library", "observedRevision": 0, "dirty": false }
    },
    "MetaRow": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 60 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Layout": { "type": "Horizontal", "gap": "spaceS", "alignCross": "Center" },
      "Children": ["MetaStat", "MetaAvatar", "MetaGrid", "MetaSearch", "MetaResults", "MetaHistory", "MetaNav", "MetaAlbum", "MetaTracks", "MetaProgress", "MetaSheet", "MetaPlayback"]
    },
    "MetaStat": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "Text": { "text": "0", "styleId": "muted" }, "ProfileStat": { "stat": "Albums" } },
    "MetaAvatar": { "Rect": { "x": 0, "y": 0, "w": 40, "h": 40 }, "Sprite": { "textureKey": "logo", "scaleMode": "Fit" }, "AvatarSource": { "textureKey": "logo" }, "HeroWidget": { "key": "avatar" } },
    "MetaGrid": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "Layout": { "type": "Grid", "columns": 2, "columnGap": 4, "rowGap": 4 }, "CoverGrid": { "source": "Library", "builtRevision": -1 } },
    "MetaSearch": { "Rect": { "x": 0, "y": 0, "w": 120, "h": 40 }, "Text": { "text": "search", "styleId": "muted" }, "SearchField": { "query": "", "placeholder": "Search", "textStyleId": "body", "placeholderStyleId": "muted", "emptyStateNodeId": "EmptyState" } },
    "MetaResults": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "SearchResults": { "source": "Tracks", "maxRows": 12, "builtQuery": "" } },
    "MetaHistory": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "HistoryList": { "emptyStateNodeId": "EmptyState", "builtRevision": -1 } },
    "MetaNav": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "Text": { "text": "nav", "styleId": "muted" }, "NavTab": { "screen": "home" }, "AnchorBottom": { "enabled": false } },
    "MetaAlbum": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "AlbumHeader": { "captionNodeId": "HeroCaption", "titleNodeId": "HeroTitle", "artistNodeId": "HeroArtist", "coverNodeId": "HeroThumb", "builtKey": "" }, "LikedHeart": { "styled": false } },
    "MetaTracks": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "TrackList": { "builtKey": "" }, "TrackText": { "field": "title", "builtKey": "" } },
    "MetaProgress": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "Shape": { "kind": "RoundedRect", "fill": "outline", "stroke": "#00000000", "strokeWidth": 0, "radius": 8 }, "ProgressBar": { "enabled": true } },
    "MetaSheet": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "BottomSheet": { "panelNodeId": "Panel", "rowSceneId": "CoverageRow", "rowHeight": 60, "builtEpoch": -1 } },
    "MetaPlayback": { "Rect": { "x": 0, "y": 0, "w": 80, "h": 40 }, "PlaybackIcon": { "builtRevision": -1 }, "PlaybackCover": { "builtRevision": -1 }, "RuntimeOnly": { "value": false } },
    "Footer": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 40 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "LayerRoot": { "id": "coverage-footer", "order": 0 },
      "Text": { "text": "every authorable lib/ui component, on one page", "styleId": "caption" }
    }
  }
}
