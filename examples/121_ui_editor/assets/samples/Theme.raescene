{
  "type": "Scene",
  "version": 3,
  "assets": { "textures": { "dirs": ["."] } },
  "palette": {
    "background":      { "r": 10,  "g": 12,  "b": 20,  "a": 255 },
    "surface":         { "r": 22,  "g": 26,  "b": 40,  "a": 255 },
    "surfaceAlt":      { "r": 34,  "g": 40,  "b": 60,  "a": 255 },
    "textPrimary":     { "r": 244, "g": 246, "b": 252, "a": 255 },
    "textMuted":       { "r": 150, "g": 160, "b": 186, "a": 255 },
    "accent":          { "r": 72,  "g": 180, "b": 152, "a": 255 },
    "accentText":      { "r": 8,   "g": 18,  "b": 20,  "a": 255 },
    "accentTextMuted": { "r": 20,  "g": 60,  "b": 54,  "a": 255 },
    "outline":         { "r": 52,  "g": 60,  "b": 88,  "a": 255 },
    "imageTint":       { "r": 255, "g": 255, "b": 255, "a": 255 }
  },
  "space": { "spaceXS": 6, "spaceS": 12, "spaceM": 20, "spaceL": 32, "spaceXL": 56 },
  "radius": { "radiusCard": 28, "radiusPill": 48, "radiusChip": 18 },
  "padding": {
    "cardPadding": { "l": 24, "t": 24, "r": 24, "b": 24 },
    "screenEdgePadding": { "l": 40, "t": 40, "r": 40, "b": 40 }
  },
  "shadow": {
    "textOnAccent": { "color": { "r": 0, "g": 0, "b": 0, "a": 90 }, "offsetX": 0, "offsetY": 2, "softness": 6 }
  },
  "container": {
    "card": { "background": "surface", "radius": "radiusCard", "padding": "cardPadding", "text": "body" },
    "primaryButton": { "background": "accent", "radius": "radiusPill", "padding": "cardPadding", "text": "button" }
  },
  "text": {
    "body":            { "font": "body", "size": 36, "color": "textPrimary", "align": "start" },
    "title":           { "extends": "body", "size": 92, "align": "center" },
    "h2":              { "extends": "body", "size": 44 },
    "muted":           { "extends": "body", "size": 28, "color": "textMuted" },
    "eyebrow":         { "extends": "body", "size": 26, "color": "accent", "align": "center" },
    "sectionLabel":    { "extends": "eyebrow", "align": "start" },
    "button":          { "extends": "body", "size": 40, "color": "accentText", "align": "center" , "vAlign": "center"},
    "buttonSecondary": { "extends": "body", "size": 38, "align": "center" , "vAlign": "center"},
    "caption":         { "extends": "body", "size": 26, "color": "textMuted", "align": "center" },
    "statValue":       { "extends": "body", "size": 52, "align": "center" , "vAlign": "center"},
    "statLabel":       { "extends": "body", "size": 24, "color": "textMuted", "align": "center" , "vAlign": "center"},
    "badge":           { "extends": "body", "size": 34, "color": "accentText", "align": "center" , "vAlign": "center"}
  }
}
