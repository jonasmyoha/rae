{
  "type": "Scene",
  "version": 2,
  "root": "ParentRoot",
  "nodes": {
    "ParentRoot": {
      "Rect": { "x": 0, "y": 0, "w": 720, "h": 480 },
      "Shape": { "kind": "RoundedRect", "fill": "surface", "stroke": "outline", "strokeWidth": 4, "radius": 32 },
      "Layout": { "type": "Vertical", "gap": "spaceM", "alignMain": "Center", "alignCross": "Center" },
      "Padding": { "l": "spaceL", "t": "spaceL", "r": "spaceL", "b": "spaceL" },
      "Children": ["ParentTitle", "ChildMount"]
    },
    "ParentTitle": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 64 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "parent scene", "styleId": "title" }
    },
    "ChildMount": {
      "Rect": { "x": 0, "y": 0, "w": 560, "h": 240 },
      "SceneInstance": { "sceneId": "nested/Child" }
    }
  }
}
