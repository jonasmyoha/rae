{
  "type": "Scene",
  "version": 2,
  "import": ["Theme"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 24, "alignCross": "Center"},
      "Padding": {"l": 64, "t": 100, "r": 64, "b": 72},
      "Children": ["Eyebrow", "Title", "Tagline", "LogoRing", "Panel", "Stats", "Milestone", "Footer"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "LogoRing": {
      "Rect": {"x": 0, "y": 0, "w": 952, "h": 420},
      "Shape": {"kind": "RoundedRect", "fill": "#183730", "stroke": "#FFFFFF0C", "strokeWidth": 1, "radius": 56},
