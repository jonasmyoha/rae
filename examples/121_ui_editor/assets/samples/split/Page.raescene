{
  "type": "Scene",
  "version": 2,
  "import": ["split/Theme", "split/Assets"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 360, "h": 640},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 10.6667, "alignMain": "Center", "alignCross": "Center"},
      "Padding": {"l": 21.3333, "t": 33.3333, "r": 21.3333, "b": 24},
      "Children": ["Hero", "Title", "Note", "Action"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Hero": {
      "Rect": {"x": 0, "y": 0, "w": 253.3333, "h": 113.3333},
      "CornerRadius": {"radius": 18.6667},
      "Shadow": {"blur": 8, "layers": 12, "opacity": 0.32},
      "GradientFill": {"from": "#27493F", "to": "#172B36", "angle": 120},
      "Children": ["HeroTexture", "HeroLink", "HeroIcon", "HeroTextureLabel", "HeroIconLabel"]
    },
    "Title": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 40},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Made to come together",
        "styleId": "title",
        "styleOverride": {"size": 25.3333}
      }
    },
    "Note": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 21.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "A shared theme and your assets, beautifully connected.",
        "styleId": "body",
        "styleOverride": {"size": 9.3333}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "Action": {
      "Rect": {"x": 0, "y": 0, "w": 206.6667, "h": 42.6667},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 21.3333},
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignMain": "Center", "alignCross": "Center"},
      "Children": ["ActionIcon", "ActionLabel", "DirLogo"],
      "GradientFill": {"from": "#69C7AC", "to": "#48B498", "angle": 100},
      "CornerRadius": {"radius": 21.3333}
    },
    "ActionIcon": {
      "Rect": {"x": 0, "y": 0, "w": 18.6667, "h": 18.6667},
      "Sprite": {"textureKey": "mat:favorite", "tint": "accentText"}
    },
    "ActionLabel": {
      "Rect": {"x": 0, "y": 0, "w": 86.6667, "h": 16.6667},
      "Text": {
        "text": "All connected",
        "styleId": "button",
        "styleOverride": {}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "DirLogo": {
      "Rect": {"x": 0, "y": 0, "w": 24, "h": 24},
      "Sprite": {"textureKey": "logo", "scaleMode": "Fit"}
    },
    "HeroTexture": {
      "Rect": {"x": 42.6667, "y": 22.6667, "w": 42.6667, "h": 42.6667},
      "Sprite": {"textureKey": "hero", "scaleMode": "Fit"},
      "CornerRadius": {"radius": 10.6667}
    },
    "HeroLink": {
      "Rect": {"x": 92.6667, "y": 44, "w": 63.3333, "h": 0.6667},
      "Shape": {"kind": "RoundedRect", "fill": "#87B3A4", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 0.3333}
    },
    "HeroIcon": {
      "Rect": {"x": 164.6667, "y": 22.6667, "w": 42.6667, "h": 42.6667},
      "Shape": {"kind": "RoundedRect", "fill": "#365C50", "stroke": "#FFFFFF0C", "strokeWidth": 0.3333, "radius": 13.3333},
      "Layout": {"type": "Vertical", "alignCross": "Center", "alignMain": "Center", "gap": 0},
      "Children": ["HeroIconGlyph"]
    },
    "HeroIconGlyph": {
      "Rect": {"x": 0, "y": 0, "w": 24, "h": 24},
      "Sprite": {"textureKey": "mat:tune", "tint": "#B5E5D3", "scaleMode": "Fit"}
    },
    "HeroTextureLabel": {
      "Rect": {"x": 19.3333, "y": 77.3333, "w": 86.6667, "h": 13.3333},
      "Size": {
        "w": {"mode": "Fixed"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "YOUR ASSETS",
        "styleId": "eyebrow",
        "styleOverride": {"size": 7.3333}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "HeroIconLabel": {
      "Rect": {"x": 144, "y": 77.3333, "w": 86.6667, "h": 13.3333},
      "Size": {
        "w": {"mode": "Fixed"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "SHARED THEME",
        "styleId": "eyebrow",
        "styleOverride": {"size": 7.3333}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    }
  }
}
