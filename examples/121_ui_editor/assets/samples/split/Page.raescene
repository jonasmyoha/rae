{
  "type": "Scene",
  "version": 2,
  "import": ["split/Theme", "split/Assets"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 32, "alignMain": "Center", "alignCross": "Center"},
      "Padding": {"l": 64, "t": 100, "r": 64, "b": 72},
      "Children": ["Hero", "Title", "Note", "Action"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Hero": {
      "Rect": {"x": 0, "y": 0, "w": 760, "h": 340},
      "CornerRadius": {"radius": 56},
      "Shadow": {"blur": 24, "layers": 12, "opacity": 0.32},
      "GradientFill": {"from": "#27493F", "to": "#172B36", "angle": 120},
      "Children": ["HeroTexture", "HeroLink", "HeroIcon", "HeroTextureLabel", "HeroIconLabel"]
    },
    "Title": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 120},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Made to come together",
        "styleId": "title",
        "styleOverride": {"size": 76}
      }
    },
    "Note": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 64},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "A shared theme and your assets, beautifully connected.",
        "styleId": "body",
        "styleOverride": {"size": 28}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "Action": {
      "Rect": {"x": 0, "y": 0, "w": 620, "h": 128},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 1, "radius": 64.0},
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignMain": "Center", "alignCross": "Center"},
      "Children": ["ActionIcon", "ActionLabel", "DirLogo"],
      "GradientFill": {"from": "#69C7AC", "to": "#48B498", "angle": 100},
      "CornerRadius": {"radius": 64.0}
    },
    "ActionIcon": {
      "Rect": {"x": 0, "y": 0, "w": 56, "h": 56},
      "Sprite": {"textureKey": "mat:favorite", "tint": "accentText"}
    },
    "ActionLabel": {
      "Rect": {"x": 0, "y": 0, "w": 260, "h": 50},
      "Text": {
        "text": "All connected",
        "styleId": "button",
        "styleOverride": {}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": false,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "DirLogo": {
      "Rect": {"x": 0, "y": 0, "w": 72, "h": 72},
      "Sprite": {"textureKey": "logo", "scaleMode": "Fit"}
    },
    "HeroTexture": {
      "Rect": {"x": 128, "y": 68, "w": 128, "h": 128},
      "Sprite": {"textureKey": "hero", "scaleMode": "Fit"},
      "CornerRadius": {"radius": 32}
    },
    "HeroLink": {
      "Rect": {"x": 278, "y": 132, "w": 190, "h": 2},
      "Shape": {"kind": "RoundedRect", "fill": "#87B3A4", "stroke": "#00000000", "strokeWidth": 1, "radius": 1}
    },
    "HeroIcon": {
      "Rect": {"x": 494, "y": 68, "w": 128, "h": 128},
      "Shape": {"kind": "RoundedRect", "fill": "#365C50", "stroke": "#FFFFFF0C", "strokeWidth": 1, "radius": 40},
      "Layout": {"type": "Vertical", "alignCross": "Center", "alignMain": "Center", "gap": 0},
      "Children": ["HeroIconGlyph"]
    },
    "HeroIconGlyph": {
      "Rect": {"x": 0, "y": 0, "w": 72, "h": 72},
      "Sprite": {"textureKey": "mat:tune", "tint": "#B5E5D3", "scaleMode": "Fit"}
    },
    "HeroTextureLabel": {
      "Rect": {"x": 58, "y": 232, "w": 260, "h": 40},
      "Size": {
        "w": {"mode": "Fixed"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "YOUR ASSETS",
        "styleId": "eyebrow",
        "styleOverride": {"size": 22}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    },
    "HeroIconLabel": {
      "Rect": {"x": 432, "y": 232, "w": 260, "h": 40},
      "Size": {
        "w": {"mode": "Fixed"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "SHARED THEME",
        "styleId": "eyebrow",
        "styleOverride": {"size": 22}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": false,
        "bias": {"x": 0, "y": 0}
      }
    }
  }
}
