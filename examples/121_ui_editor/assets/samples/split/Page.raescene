{
  "type": "Scene",
  "version": 2,
  "import": ["split/Theme", "split/Assets"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": { "x": 0, "y": 0, "w": 1080, "h": 1920 },
      "Shape": { "kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0 },
      "Layout": { "type": "Vertical", "gap": "spaceL", "alignMain": "Center", "alignCross": "Center" },
      "Padding": { "l": "spaceL", "t": "spaceL", "r": "spaceL", "b": "spaceL" },
      "Children": ["Hero", "Title", "Note", "Action"]
    },
    "Hero": {
      "Rect": { "x": 0, "y": 0, "w": 480, "h": 300 },
      "Sprite": { "textureKey": "hero", "tint": "#FFFFFFFF" }
    },
    "Title": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 110 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "Split by responsibility", "styleId": "title" }
    },
    "Note": {
      "Rect": { "x": 0, "y": 0, "w": 0, "h": 60 },
      "Size": { "w": { "mode": "Fill" }, "h": { "mode": "Fixed" } },
      "Text": { "text": "tokens from split/Theme, textures and fonts from split/Assets", "styleId": "body" }
    },
    "Action": {
      "Rect": { "x": 0, "y": 0, "w": 520, "h": 130 },
      "Shape": { "kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0, "radius": "radiusPill" },
      "Layout": { "type": "Horizontal", "gap": "spaceM", "alignMain": "Center", "alignCross": "Center" },
      "Children": ["ActionIcon", "ActionLabel", "DirLogo"]
    },
    "ActionIcon": {
      "Rect": { "x": 0, "y": 0, "w": 56, "h": 56 },
      "Sprite": { "textureKey": "mat:favorite", "tint": "accentText" }
    },
    "ActionLabel": {
      "Rect": { "x": 0, "y": 0, "w": 260, "h": 50 },
      "Text": { "text": "map + dirs", "styleId": "button" }
    },
    "DirLogo": {
      "Rect": { "x": 0, "y": 0, "w": 72, "h": 72 },
      "Sprite": { "textureKey": "logo", "scaleMode": "Fit" }
    }
  }
}
