{
  "type": "Scene",
  "version": 2,
  "import": ["Theme"],
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 20, "alignCross": "Stretch"},
      "Padding": {"l": 64, "t": 100, "r": 64, "b": 72},
      "Children": [
        "Heading",
        "Subtitle",
        "AudioEyebrow",
        "SoundRow",
        "MusicRow",
        "HapticsRow",
        "ProfilesEyebrow",
        "ProfileList"
      ],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Heading": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 110},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Settings", "styleId": "title"}
    },
    "Subtitle": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 48},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Margin": {"l": 0, "t": 0, "r": 0, "b": 32},
      "Text": {"text": "Make room for your kind of play.", "styleId": "muted"}
    },
    "AudioEyebrow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 34},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "AUDIO & FEEL", "styleId": "sectionLabel"},
      "Margin": {"l": 8, "t": 32, "r": 0, "b": 8}
    },
    "SoundRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 144},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "surface", "stroke": "#FFFFFF0C", "strokeWidth": 1, "radius": 48},
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignCross": "Center"},
      "Padding": {"l": 28, "t": 28, "r": 28, "b": 28},
      "Children": ["SoundIconWell", "SoundLabel", "SoundToggle"],
      "GradientFill": {"from": "#202C36", "to": "#18222C", "angle": 110},
      "CornerRadius": {"radius": 48}
    },
    "SoundIconWell": {
      "Rect": {"x": 0, "y": 0, "w": 72, "h": 72},
      "Shape": {"kind": "RoundedRect", "fill": "#284039", "stroke": "#FFFFFF00", "strokeWidth": 1, "radius": 36},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["SoundIcon"]
    },
    "SoundIcon": {
      "Rect": {"x": 0, "y": 0, "w": 40, "h": 40},
      "Sprite": {"textureKey": "mat:equalizer", "tint": "accent", "scaleMode": "Fit"}
    },
    "SoundLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Sound effects", "styleId": "body"}
    },
    "SoundToggle": {
      "Rect": {"x": 0, "y": 0, "w": 104, "h": 60},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 1, "radius": 30.0},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "End", "alignCross": "Center"},
      "Padding": {"l": 6, "t": 0, "r": 6, "b": 0},
      "OnClick": {"actionId": "settings.sound"},
      "Children": ["SoundKnob"]
    },
    "SoundKnob": {
      "Rect": {"x": 0, "y": 0, "w": 48, "h": 48},
      "Shape": {"kind": "RoundedRect", "fill": "textPrimary", "stroke": "#00000000", "strokeWidth": 0, "radius": 24}
    },
    "MusicRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 144},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "surface", "stroke": "#FFFFFF0C", "strokeWidth": 1, "radius": 48},
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignCross": "Center"},
      "Padding": {"l": 28, "t": 28, "r": 28, "b": 28},
      "Children": ["MusicIconWell", "MusicLabel", "MusicToggle"],
      "GradientFill": {"from": "#202C36", "to": "#18222C", "angle": 110},
      "CornerRadius": {"radius": 48}
    },
    "MusicIconWell": {
      "Rect": {"x": 0, "y": 0, "w": 72, "h": 72},
      "Shape": {"kind": "RoundedRect", "fill": "#284039", "stroke": "#FFFFFF00", "strokeWidth": 1, "radius": 36},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["MusicIcon"]
    },
    "MusicIcon": {
      "Rect": {"x": 0, "y": 0, "w": 40, "h": 40},
      "Sprite": {"textureKey": "mat:queue_music", "tint": "accent", "scaleMode": "Fit"}
    },
    "MusicLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Music", "styleId": "body"}
    },
    "MusicToggle": {
      "Rect": {"x": 0, "y": 0, "w": 104, "h": 60},
      "Shape": {"kind": "RoundedRect", "fill": "surfaceAlt", "stroke": "#00000000", "strokeWidth": 1, "radius": 30.0},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Start", "alignCross": "Center"},
      "Padding": {"l": 6, "t": 0, "r": 6, "b": 0},
      "OnClick": {"actionId": "settings.music"},
      "Children": ["MusicKnob"]
    },
    "MusicKnob": {
      "Rect": {"x": 0, "y": 0, "w": 48, "h": 48},
      "Shape": {"kind": "RoundedRect", "fill": "textMuted", "stroke": "#00000000", "strokeWidth": 0, "radius": 24}
    },
    "HapticsRow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 144},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Shape": {"kind": "RoundedRect", "fill": "surface", "stroke": "#FFFFFF0C", "strokeWidth": 1, "radius": 48},
      "Layout": {"type": "Horizontal", "gap": "spaceM", "alignCross": "Center"},
      "Padding": {"l": 28, "t": 28, "r": 28, "b": 28},
      "Children": ["HapticsIconWell", "HapticsLabel", "HapticsToggle"],
      "GradientFill": {"from": "#202C36", "to": "#18222C", "angle": 110},
      "CornerRadius": {"radius": 48}
    },
    "HapticsIconWell": {
      "Rect": {"x": 0, "y": 0, "w": 72, "h": 72},
      "Shape": {"kind": "RoundedRect", "fill": "#284039", "stroke": "#FFFFFF00", "strokeWidth": 1, "radius": 36},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["HapticsIcon"]
    },
    "HapticsIcon": {
      "Rect": {"x": 0, "y": 0, "w": 40, "h": 40},
      "Sprite": {"textureKey": "mat:whatshot", "tint": "accent", "scaleMode": "Fit"}
    },
    "HapticsLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 50},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Haptics", "styleId": "body"}
    },
    "HapticsToggle": {
      "Rect": {"x": 0, "y": 0, "w": 104, "h": 60},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 1, "radius": 30.0},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "End", "alignCross": "Center"},
      "Padding": {"l": 6, "t": 0, "r": 6, "b": 0},
      "OnClick": {"actionId": "settings.haptics"},
      "Children": ["HapticsKnob"]
    },
    "HapticsKnob": {
      "Rect": {"x": 0, "y": 0, "w": 48, "h": 48},
      "Shape": {"kind": "RoundedRect", "fill": "textPrimary", "stroke": "#00000000", "strokeWidth": 0, "radius": 24}
    },
    "ProfilesEyebrow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 34},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Margin": {"l": 8, "t": 32, "r": 0, "b": 8},
      "Text": {"text": "PROFILES", "styleId": "sectionLabel"}
    },
    "ProfileList": {
      "Rect": {"x": 0, "y": 0, "w": 952, "h": 784},
      "ScrollState": {"y": 0},
      "ListView": {
        "itemSceneId": "SettingsRow",
        "itemKeyField": "id",
        "itemHeight": 144,
        "itemGap": 16,
        "visibleItemCount": 5,
        "overscanRows": 1,
        "bindings": [
          {"nodeId": "RowTitle", "component": "Text", "field": "text", "itemField": "name"},
          {"nodeId": "RowDetail", "component": "Text", "field": "text", "itemField": "detail"}
        ]
      },
      "Overflow": {"mode": "Clip"}
    }
  }
}
