{
  "type": "Scene",
  "version": 2,
  "assets": {
    "textures": {
      "map": {"badge": "logo.png"}
    },
    "fonts": {"text": "../../../105_ui_counter/assets/Roboto-Regular.mtsdf.json"}
  },
  "palette": {
    "background": {"r": 12, "g": 18, "b": 27, "a": 255},
    "surface": {"r": 24, "g": 34, "b": 44, "a": 255},
    "surfaceAlt": {"r": 36, "g": 51, "b": 61, "a": 255},
    "textPrimary": {"r": 238, "g": 244, "b": 243, "a": 255},
    "textMuted": {"r": 157, "g": 172, "b": 181, "a": 255},
    "accent": {"r": 72, "g": 180, "b": 152, "a": 255},
    "accentText": {"r": 11, "g": 36, "b": 33, "a": 255},
    "accentTextMuted": {"r": 36, "g": 75, "b": 67, "a": 255},
    "outline": {"r": 51, "g": 68, "b": 77, "a": 255},
    "imageTint": {"r": 255, "g": 255, "b": 255, "a": 255}
  },
  "space": {"spaceXS": 8, "spaceS": 16, "spaceM": 24, "spaceL": 40, "spaceXL": 64},
  "radius": {"radiusCard": 48, "radiusPill": 64, "radiusChip": 40},
  "text": {
    "body": {
      "font": "body",
      "size": 34,
      "color": "textPrimary",
      "align": "center",
      "vAlign": "center",
      "lineHeight": 1.25
    },
    "title": {"extends": "body", "size": 100, "align": "center", "lineHeight": 1.08},
    "h2": {"extends": "body", "size": 42, "lineHeight": 1.08},
    "muted": {"extends": "body", "size": 28, "color": "textMuted", "lineHeight": 1.3},
    "eyebrow": {"extends": "body", "size": 24, "color": "accent", "align": "center"},
    "sectionLabel": {"extends": "eyebrow", "size": 24},
    "button": {"extends": "body", "size": 36, "color": "accentText", "align": "center", "vAlign": "center"},
    "buttonSecondary": {"extends": "body", "size": 34, "align": "center", "vAlign": "center"},
    "caption": {
      "extends": "body",
      "size": 26,
      "color": "textMuted",
      "align": "center",
      "vAlign": "center",
      "lineHeight": 1.3
    },
    "statValue": {"extends": "body", "size": 56, "align": "center", "vAlign": "center"},
    "statLabel": {"extends": "body", "size": 24, "color": "textMuted", "align": "center", "vAlign": "center"},
    "badge": {"extends": "button", "size": 30},
    "display": {"extends": "body", "size": 128, "align": "start", "lineHeight": 1.08}
  },
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 1080, "h": 1920},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 32, "alignMain": "Center", "alignCross": "Center"},
      "Padding": {"l": 64, "t": 100, "r": 64, "b": 72},
      "Children": ["Badge", "Eyebrow", "Title", "Note", "Button"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Badge": {
      "Rect": {"x": 0, "y": 0, "w": 360, "h": 360},
      "Shape": {"kind": "RoundedRect", "fill": "#213D38", "stroke": "#FFFFFF0C", "strokeWidth": 1, "radius": 80},
      "Margin": {"l": 0, "t": 0, "r": 0, "b": 16},
      "Layout": {"type": "Vertical", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["BadgeImage"],
      "GradientFill": {"from": "#315B50", "to": "#172B32", "angle": 125},
      "Shadow": {"blur": 24, "layers": 12, "opacity": 0.32},
      "CornerRadius": {"radius": 80}
    },
    "BadgeImage": {
      "Rect": {"x": 0, "y": 0, "w": 220, "h": 220},
      "Sprite": {"textureKey": "badge", "tint": "#FFFFFFFF", "scaleMode": "Fit"},
      "CornerRadius": {"radius": 110}
    },
    "Eyebrow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 34},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "SELF-CONTAINED", "styleId": "eyebrow"}
    },
    "Title": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 136},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Everything, together.",
        "styleId": "title",
        "styleOverride": {"size": 88}
      }
    },
    "Note": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 64},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Margin": {"l": 0, "t": 0, "r": 0, "b": 24},
      "Text": {
        "text": "Colour, type and assets in one portable scene.",
        "styleId": "muted",
        "styleOverride": {"size": 28}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "Button": {
      "Rect": {"x": 0, "y": 0, "w": 580, "h": 128},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 1, "radius": 64.0},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "OnClick": {"actionId": "one.ok"},
      "Children": ["ButtonLabel"],
      "GradientFill": {"from": "#69C7AC", "to": "#48B498", "angle": 100},
      "CornerRadius": {"radius": 64.0}
    },
    "ButtonLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 52},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Got it", "styleId": "button"}
    }
  },
  "padding": {
    "cardPadding": {"l": 32, "t": 32, "r": 32, "b": 32},
    "screenEdgePadding": {"l": 64, "t": 64, "r": 64, "b": 64}
  }
}
