{
  "type": "Scene",
  "version": 2,
  "assets": {
    "textures": {
      "map": {"badge": "logo.png"}
    },
    "fonts": {"text": "../../../105_ui_counter/assets/Roboto-Regular.mtsdf.json"}
  },
  "palette": {
    "background": {"r": 12, "g": 18, "b": 27, "a": 255},
    "surface": {"r": 24, "g": 34, "b": 44, "a": 255},
    "surfaceAlt": {"r": 36, "g": 51, "b": 61, "a": 255},
    "textPrimary": {"r": 238, "g": 244, "b": 243, "a": 255},
    "textMuted": {"r": 157, "g": 172, "b": 181, "a": 255},
    "accent": {"r": 72, "g": 180, "b": 152, "a": 255},
    "accentText": {"r": 11, "g": 36, "b": 33, "a": 255},
    "accentTextMuted": {"r": 36, "g": 75, "b": 67, "a": 255},
    "outline": {"r": 51, "g": 68, "b": 77, "a": 255},
    "imageTint": {"r": 255, "g": 255, "b": 255, "a": 255}
  },
  "space": {"spaceXS": 2.6667, "spaceS": 5.3333, "spaceM": 8, "spaceL": 13.3333, "spaceXL": 21.3333},
  "radius": {"radiusCard": 16, "radiusPill": 21.3333, "radiusChip": 13.3333},
  "text": {
    "body": {
      "font": "body",
      "size": 11.3333,
      "color": "textPrimary",
      "align": "center",
      "vAlign": "center",
      "lineHeight": 1.25
    },
    "title": {"extends": "body", "size": 33.3333, "align": "center", "lineHeight": 1.08},
    "h2": {"extends": "body", "size": 14, "lineHeight": 1.08},
    "muted": {"extends": "body", "size": 9.3333, "color": "textMuted", "lineHeight": 1.3},
    "eyebrow": {"extends": "body", "size": 8, "color": "accent", "align": "center"},
    "sectionLabel": {"extends": "eyebrow", "size": 8},
    "button": {"extends": "body", "size": 12, "color": "accentText", "align": "center", "vAlign": "center"},
    "buttonSecondary": {"extends": "body", "size": 11.3333, "align": "center", "vAlign": "center"},
    "caption": {
      "extends": "body",
      "size": 8.6667,
      "color": "textMuted",
      "align": "center",
      "vAlign": "center",
      "lineHeight": 1.3
    },
    "statValue": {"extends": "body", "size": 18.6667, "align": "center", "vAlign": "center"},
    "statLabel": {"extends": "body", "size": 8, "color": "textMuted", "align": "center", "vAlign": "center"},
    "badge": {"extends": "button", "size": 10},
    "display": {"extends": "body", "size": 42.6667, "align": "start", "lineHeight": 1.08}
  },
  "root": "Screen",
  "nodes": {
    "Screen": {
      "Rect": {"x": 0, "y": 0, "w": 360, "h": 640},
      "Shape": {"kind": "Rect", "fill": "background", "stroke": "#00000000", "strokeWidth": 0},
      "Layout": {"type": "Vertical", "gap": 10.6667, "alignMain": "Center", "alignCross": "Center"},
      "Padding": {"l": 21.3333, "t": 33.3333, "r": 21.3333, "b": 24},
      "Children": ["Badge", "Eyebrow", "Title", "Note", "Button"],
      "GradientFill": {"from": "#15252C", "to": "#0C121B", "angle": 100}
    },
    "Badge": {
      "Rect": {"x": 0, "y": 0, "w": 120, "h": 120},
      "Shape": {"kind": "RoundedRect", "fill": "#213D38", "stroke": "#FFFFFF0C", "strokeWidth": 0.3333, "radius": 26.6667},
      "Margin": {"l": 0, "t": 0, "r": 0, "b": 5.3333},
      "Layout": {"type": "Vertical", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "Children": ["BadgeImage"],
      "GradientFill": {"from": "#315B50", "to": "#172B32", "angle": 125},
      "Shadow": {"blur": 8, "layers": 12, "opacity": 0.32},
      "CornerRadius": {"radius": 26.6667}
    },
    "BadgeImage": {
      "Rect": {"x": 0, "y": 0, "w": 73.3333, "h": 73.3333},
      "Sprite": {"textureKey": "badge", "tint": "#FFFFFFFF", "scaleMode": "Fit"},
      "CornerRadius": {"radius": 36.6667}
    },
    "Eyebrow": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 11.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "SELF-CONTAINED", "styleId": "eyebrow"}
    },
    "Title": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 45.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {
        "text": "Everything, together.",
        "styleId": "title",
        "styleOverride": {"size": 29.3333}
      }
    },
    "Note": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 21.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Margin": {"l": 0, "t": 0, "r": 0, "b": 8},
      "Text": {
        "text": "Color, type and assets in one portable scene.",
        "styleId": "muted",
        "styleOverride": {"size": 9.3333}
      },
      "OpticalAlign": {
        "enabled": true,
        "centerX": true,
        "centerY": true,
        "bias": {"x": 0, "y": 0}
      }
    },
    "Button": {
      "Rect": {"x": 0, "y": 0, "w": 193.3333, "h": 42.6667},
      "Shape": {"kind": "RoundedRect", "fill": "accent", "stroke": "#00000000", "strokeWidth": 0.3333, "radius": 21.3333},
      "Layout": {"type": "Horizontal", "gap": 0, "alignMain": "Center", "alignCross": "Center"},
      "OnClick": {"actionId": "one.ok", "label": "Got it"},
      "Children": ["ButtonLabel"],
      "GradientFill": {"from": "#69C7AC", "to": "#48B498", "angle": 100},
      "CornerRadius": {"radius": 21.3333}
    },
    "ButtonLabel": {
      "Rect": {"x": 0, "y": 0, "w": 0, "h": 17.3333},
      "Size": {
        "w": {"mode": "Fill"},
        "h": {"mode": "Fixed"}
      },
      "Text": {"text": "Got it", "styleId": "button"}
    }
  },
  "padding": {
    "cardPadding": {"l": 10.6667, "t": 10.6667, "r": 10.6667, "b": 10.6667},
    "screenEdgePadding": {"l": 21.3333, "t": 21.3333, "r": 21.3333, "b": 21.3333}
  }
}
