# inspectorSystem/Selection — the ONE funnel every selection change goes
# through.
#
# The editor keeps a single selection SET shared by the canvas, the hierarchy
# and the inspector, and everything that changes it — a canvas click, a tree
# row, the arrow keys, Select parent — calls `applySelect` with a `SelectMode`.
# Keeping that in one module is what stops the two surfaces from growing two
# vocabularies for the one set.
#
# Split from InspectorSystem.rae, which owns the state and the per-frame
# update, purely to keep both under the 1,000-line cap. The dependency is
# one-way: this reads and writes `InspectorSystem`, and nothing here is called
# from the type's own construction.
import Keys
import Sdl3
import String
open Sys
open ui/Ecs
open ui/Components
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems
open ui/SceneLoader
open inspectorSystem/NodeQuery

# How far a click may drift and still count as "the same spot" for
# click-through cycling (#73816378). A few screen pixels, so a shaky hand keeps
# stepping up the stack instead of silently restarting at the deepest node.
# This is a DISTANCE threshold and the only one the gesture has: there is no
# press-and-hold and no double-click timeout, so the same spot ten seconds
# later still continues the cycle.
const clickCycleSlop: Float = 4.0

# Add `entity` to the selection and make it the anchor, or drop it when it is
# already selected (a modifier-click). Kept beside `selectNode` so both halves
# of the selection contract live in one place.
func selectAddNode(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entity: view EntityId
) {
  if isNone(this: entity) {
    ret
  }
  loop var i: Int = 0, i < inspectorSystem.selection.length, ++i {
    if let member: EntityId = inspectorSystem.selection.copyAt(index: i) {
      if member is entity {
        inspectorSystem.selection.removeAt(index: i)
        var anchor: EntityId = noEntity()
        if inspectorSystem.selection.length > 0 {
          if let last: EntityId = inspectorSystem.selection.copyAt(
            index: inspectorSystem.selection.length - 1
          ) {
            anchor = last
          }
        }
        inspectorSystem.selected = anchor
        ret
      }
    }
  }
  inspectorSystem.selection.add(value: entity)
  inspectorSystem.selected = entity
}

# Replace the selection with exactly `entity` (a plain click). Every path that
# changes the selection goes through here or `selectAddNode`, so the anchor and
# the set can never disagree.
func selectNode(inspectorSystem: mod InspectorSystem, world: mod UiWorld, entity: view EntityId) {
  inspectorSystem.selected = entity
  inspectorSystem.selection.clear()
  if isNone(this: entity) {
    ret
  }
  inspectorSystem.selection.add(value: entity)
  log(
    "[ui-editor] selected {nodeIdOf(world: world, entity: entity)}: {componentNamesFor(
      world: world
      entity: entity
    )}"
  )
}

# How a click changes the selection. The canvas, the hierarchy and every
# keyboard path funnel through `applySelect` with one of these, so the two
# panels cannot grow two different vocabularies for the one shared set.
#
#   replace  — plain click: the selection becomes exactly this node, and a
#              plain click on EMPTY space clears it (there was previously no
#              way to deselect at all).
#   toggle   — Cmd/Ctrl+click: in if it was out, out if it was in.
#   add      — Shift+click: in, and never out. The hierarchy spends this on
#              range extension (#16096994); on the canvas there is no range,
#              so it is a plain additive click.
#   subtract — Alt/Opt+click: out, and never in. Distinct from `toggle`
#              because with stacked nodes a toggle is ambiguous about which
#              one you meant to drop, and "remove this" is worth being able
#              to say without having to know the current state.
#   range    — Shift+click IN THE TREE: select the contiguous run of visible
#              rows between the range anchor and this row. The canvas has no
#              row order, so there Shift stays a plain `add`; the modifier is
#              the same key, and what a RANGE means is simply a property of
#              the surface you clicked.
enum SelectMode {
  replace
  toggle
  add
  subtract
  range
}

# Which mode the modifier keys currently held ask for.
#
# Several modifiers at once are ranked by how specific they are: subtract is
# an explicit "not this one", so it wins over toggle, which in turn is more
# specific than add. Ranking them (rather than declaring the combination
# invalid) means a stray Shift never silently turns an Alt+click into an add.
# The tree's mapping: identical to the canvas except that Shift spans a range
# of rows instead of adding one. Everything else — Cmd/Ctrl toggles, Alt/Opt
# subtracts, plain replaces — is literally the same call, which is the point:
# one vocabulary, one funnel, two surfaces.
# The lowercase letter for a 0-based alphabet index.
func letterText(index: view Int) ret String {
  let alphabet: String = "abcdefghijklmnopqrstuvwxyz"
  ret alphabet.sub(start: index, len: 1)
}

func treeSelectMode() ret SelectMode {
  let mode: SelectMode = pointerSelectMode()
  if mode is SelectMode.add {
    ret SelectMode.range
  }
  ret mode
}

func pointerSelectMode() ret SelectMode {
  if Sdl3.isKeyDown(key: Keys.keyLAlt) or Sdl3.isKeyDown(key: Keys.keyRAlt) {
    ret SelectMode.subtract
  }
  let meta: Bool = Sdl3.isKeyDown(key: Keys.keyLGui) or Sdl3.isKeyDown(key: Keys.keyRGui)
  let control: Bool = Sdl3.isKeyDown(key: Keys.keyLCtrl) or Sdl3.isKeyDown(key: Keys.keyRCtrl)
  if meta or control {
    ret SelectMode.toggle
  }
  if Sdl3.isKeyDown(key: Keys.keyLShift) or Sdl3.isKeyDown(key: Keys.keyRShift) {
    ret SelectMode.add
  }
  ret SelectMode.replace
}

func isSelected(inspectorSystem: view InspectorSystem, entity: view EntityId) ret Bool {
  loop var i: Int = 0, i < inspectorSystem.selection.length, ++i {
    if let member: EntityId = inspectorSystem.selection.copyAt(index: i) {
      if member is entity {
        ret true
      }
    }
  }
  ret false
}

# The ONE way the selection set changes. Returns whether it actually changed,
# so the caller only resyncs the panels when there is something new to show.
#
# A modified click on empty space does NOTHING: only a plain click clears. A
# user holding Shift to extend a selection and missing the node is asking to
# add nothing, not to throw the selection away — and losing a carefully built
# set to a near-miss is exactly the kind of thing that makes an editor feel
# hostile.
# The row index of `entity` in the tree's visible order, or -1.
func treeRowOf(inspectorSystem: view InspectorSystem, entity: view EntityId) ret Int {
  loop var i: Int = 0, i < inspectorSystem.treeEntities.length, ++i {
    if let row: EntityId = inspectorSystem.treeEntities.copyAt(index: i) {
      if row is entity {
        ret i
      }
    }
  }
  ret -1
}

# Select the contiguous run of visible rows between the range anchor and
# `entity`. The set is REPLACED by the run rather than unioned with it, which
# is what lets a second Shift+click shrink a range that overshot — the
# behaviour every file browser has and the reason the anchor must not move.
#
# Falls back to a plain replace when either end is not on screen (the anchor's
# row can be collapsed away, or the tree may not have been built yet), since
# a range with no origin is just a click.
func applyRange(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entity: view EntityId
) ret Bool {
  let toRow: Int = treeRowOf(inspectorSystem: inspectorSystem, entity: entity)
  var fromRow: Int = treeRowOf(
    inspectorSystem: inspectorSystem
    entity: inspectorSystem.rangeAnchor
  )
  if toRow < 0 {
    # The clicked node is not a visible row at all — the tree panel is closed,
    # or it has not been built yet. A range over rows that are not on screen
    # is meaningless, so degrade to a plain click rather than doing nothing:
    # Shift+arrow must still move the active node with the tree hidden.
    selectNode(inspectorSystem: inspectorSystem, world: world, entity: entity)
    ret true
  }
  if fromRow < 0 {
    fromRow = toRow
  }
  var first: Int = fromRow
  var last: Int = toRow
  if first > last {
    first = toRow
    last = fromRow
  }
  let anchor: EntityId = inspectorSystem.rangeAnchor
  inspectorSystem.selection.clear()
  loop var i: Int = first, i <= last, ++i {
    if let row: EntityId = inspectorSystem.treeEntities.copyAt(index: i) {
      inspectorSystem.selection.add(value: row)
    }
  }
  inspectorSystem.selected = entity
  # The anchor deliberately survives the range: `selectNode` / `selectAddNode`
  # would have moved it, which is why a range does not go through them.
  inspectorSystem.rangeAnchor = anchor
  log(
    "[ui-editor] selection ({inspectorSystem.selection.length}): {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  )
  ret true
}

func applySelect(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entity: view EntityId
  mode: view SelectMode
) ret Bool {
  inspectorSystem.pendingRemoveComponent = ""
  # Any selection change ends the current click-through cycle. `canvasSelectAt`
  # re-arms it immediately afterwards for its own click, so the ONLY thing that
  # survives here is a cycle whose next step is the very next canvas click —
  # which is exactly the reset rule: a tree click, an arrow key, Esc or a
  # modifier click all leave no stale depth behind.
  inspectorSystem.cycleActive = false
  if mode is SelectMode.range {
    if isNone(this: entity) {
      ret false
    }
    ret applyRange(inspectorSystem: inspectorSystem, world: world, entity: entity)
  }
  # Every non-range gesture re-origins the range: after a plain, toggling or
  # subtracting click, the next Shift+click spans from THAT row.
  if isNone(this: entity) is false {
    inspectorSystem.rangeAnchor = entity
  }
  if mode is SelectMode.replace {
    if isNone(this: entity) {
      if inspectorSystem.selection.length is 0 {
        ret false
      }
      selectNode(inspectorSystem: inspectorSystem, world: world, entity: noEntity())
      inspectorSystem.rangeAnchor = noEntity()
      log("[ui-editor] deselected")
      ret true
    }
    if inspectorSystem.selection.length is 1 and inspectorSystem.selected is entity {
      ret false
    }
    selectNode(inspectorSystem: inspectorSystem, world: world, entity: entity)
    ret true
  }
  if isNone(this: entity) {
    ret false
  }
  let already: Bool = isSelected(inspectorSystem: inspectorSystem, entity: entity)
  if mode is SelectMode.add and already {
    ret false
  }
  if mode is SelectMode.subtract and already is false {
    ret false
  }
  # Every surviving case is a flip: `add` reached here only when the node was
  # out, `subtract` only when it was in, and `toggle` means flip by
  # definition. So the three modes differ purely in the guards above, and
  # `selectAddNode` — which toggles — is the single mutation.
  selectAddNode(inspectorSystem: inspectorSystem, world: world, entity: entity)
  log(
    "[ui-editor] selection ({inspectorSystem.selection.length}): {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  )
  ret true
}

# Apply one marquee result through the same single-node funnel as clicks and
# tree gestures. Plain replaces with the first enclosed node and adds the
# rest; an empty plain band clears. Modified bands apply their mode to every
# enclosed node and leave the set alone when they enclose nothing.
func applySelectMany(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entities: view List(EntityId)
  mode: view SelectMode
) ret Bool {
  if entities.length is 0 {
    if mode is SelectMode.replace {
      ret applySelect(
        inspectorSystem: inspectorSystem
        world: world
        entity: noEntity()
        mode: SelectMode.replace
      )
    }
    ret false
  }
  var changed: Bool = false
  var first: Bool = true
  loop let entity: view EntityId in entities {
    var entityMode: SelectMode = mode
    if mode is SelectMode.replace and first is false {
      entityMode = SelectMode.add
    }
    if applySelect(
      inspectorSystem: inspectorSystem
      world: world
      entity: entity
      mode: entityMode
    ) {
      changed = true
    }
    first = false
  }
  ret changed
}

# The selected node ids, in selection order — the headless gate's assertion
# surface, and what a future "Selection (n)" label in the panel will read.
func selectionNodeIds(inspectorSystem: view InspectorSystem, world: view UiWorld) ret String {
  if inspectorSystem.selection.length is 0 {
    ret "none"
  }
  var line: String = ""
  loop var i: Int = 0, i < inspectorSystem.selection.length, ++i {
    if let member: EntityId = inspectorSystem.selection.copyAt(index: i) {
      let name: String = nodeIdOf(world: world, entity: member)
      if line.length() is 0 {
        line = "{name}"
      } else {
        line = "{line},{name}"
      }
    }
  }
  ret line
}

# A click at a point of the CANVAS, with the modifiers that were held. The
# live pointer and the headless click hook both come through here, so the
# gate exercises the real gesture rather than a shortcut around it.
# Replace the selection with the PARENTS of everything in it (#23728694).
#
# The click-through gesture walks one node up the stack under the cursor; this
# walks the whole SET up the tree at once, which is the operation a gesture
# cannot express. Deduplicated, because two selected siblings share a parent
# and the result should be one node, not the same node twice.
#
# An entity already at the scene root contributes ITSELF rather than nothing:
# dropping it would silently shrink the selection every time it contained a
# top-level node, and a `Select parent` that sometimes deselects is worse than
# one that sometimes does nothing.
func selectParentOfSelection(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  sceneRoot: view EntityId
) ret Bool {
  if inspectorSystem.selection.length is 0 {
    ret false
  }
  var parents: List(EntityId) = List.create(EntityId, cap: 8)
  var moved: Bool = false
  loop let entity: view EntityId in inspectorSystem.selection {
    if isNone(this: entity) {
      continue
    }
    var target: EntityId = entity
    if entity is not sceneRoot {
      let parent: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: entity)
      if isNone(this: parent) is false {
        target = parent
        moved = true
      }
    }
    var already: Bool = false
    loop let seen: view EntityId in parents {
      if seen is target {
        already = true
      }
    }
    if already is false {
      parents.add(value: target)
    }
  }
  if moved is false {
    ret false
  }
  inspectorSystem.selected = noEntity()
  inspectorSystem.selection.clear()
  inspectorSystem.cycleActive = false
  loop let parent: view EntityId in parents {
    inspectorSystem.selection.add(value: parent)
    inspectorSystem.selected = parent
  }
  inspectorSystem.rangeAnchor = inspectorSystem.selected
  log(
    "[ui-editor] select parent ({inspectorSystem.selection.length}): {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  )
  ret true
}

# Whether (x, y) is the same spot as the click that armed the cycle.
func sameCycleSpot(inspectorSystem: view InspectorSystem, x: view Float, y: view Float) ret Bool {
  if inspectorSystem.cycleActive is false {
    ret false
  }
  let dx: Float = x - inspectorSystem.cycleX
  let dy: Float = y - inspectorSystem.cycleY
  ret dx * dx + dy * dy <= clickCycleSlop * clickCycleSlop
}

func canvasSelectAt(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  sceneRoot: view EntityId
  x: view Float
  y: view Float
  mode: view SelectMode
) ret Bool {
  # A MODIFIED click never cycles. Cmd/Shift/Alt are asking to change the set,
  # and stepping up the stack at the same time would make the result depend on
  # how many times you had already clicked there — two gestures fighting over
  # one press. They take the deepest hit, as a first plain click does.
  if mode is not SelectMode.replace {
    ret applySelect(
      inspectorSystem: inspectorSystem
      world: world
      entity: deepestNodeAt(
        world: world
        uiSystems: uiSystems
        entity: sceneRoot
        x: x
        y: y
      )
      mode: mode
    )
  }
  let stepping: Bool = sameCycleSpot(inspectorSystem: inspectorSystem, x: x, y: y)
  if stepping is false {
    hitStackAt(
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      x: x
      y: y
      out: inspectorSystem.cycleStack
    )
  }
  if inspectorSystem.cycleStack.length is 0 {
    # Empty canvas: clear the selection, as a plain click there always did.
    ret applySelect(
      inspectorSystem: inspectorSystem
      world: world
      entity: noEntity()
      mode: SelectMode.replace
    )
  }
  # The cycle has one position MORE than the stack: after the top comes
  # "nothing selected", then it wraps to the deepest. Without that extra
  # step there is no way to deselect with the mouse held still — every click
  # lands on something, so the set can never empty (#66601047).
  let positions: Int = inspectorSystem.cycleStack.length + 1
  var depth: Int = 0
  if stepping {
    # One level UP the stack: sprite -> Button -> row -> page -> nothing ->
    # sprite.
    depth = (inspectorSystem.cycleDepth + 1) % positions
  }
  # Past the top of the stack `copyAtFallback` yields none, and a plain
  # replace with none is exactly the clear.
  let picked: EntityId = inspectorSystem.cycleStack.copyAtFallback(
    index: depth
    fallback: noEntity()
  )
  let changed: Bool = applySelect(
    inspectorSystem: inspectorSystem
    world: world
    entity: picked
    mode: SelectMode.replace
  )
  # Re-arm AFTER applySelect, which cleared the cycle. The point is the one
  # that armed it, not this click's coordinates: otherwise a hand drifting
  # `clickCycleSlop` per click would walk across the canvas without ever
  # leaving the cycle.
  if stepping is false {
    inspectorSystem.cycleX = x
    inspectorSystem.cycleY = y
  }
  inspectorSystem.cycleDepth = depth
  inspectorSystem.cycleActive = true
  if stepping {
    # Only the STEPS are logged, not every canvas click: `applySelect` already
    # names what got selected, and the one thing that line cannot show is how
    # deep into the stack under the cursor you now are.
    var pickedName: String = nodeIdOf(world: world, entity: picked)
    if isNone(this: picked) {
      pickedName = "nothing"
    }
    log("[ui-editor] cycle {depth + 1}/{positions}: {pickedName}")
  }
  ret changed
}
