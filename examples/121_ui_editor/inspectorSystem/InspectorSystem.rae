# inspectorSystem — the read-only inspector (design §3): hover highlights the
# document node under the pointer, a click selects it, the arrow keys walk the
# tree (Up/Down siblings, Left parent, Right first child), Esc clears, T
# toggles a tree panel. The highlights are two `Shape` outline entities on an
# `overlay` layer that this system MOVES to the target's world rect — the stock
# render system draws them, there is no special draw path. Hit-testing walks
# the DOCUMENT page only (deepest node under the pointer, whether or not it has
# an OnClick), so the chrome can never select itself.
#
# RAE_UI_EDITOR_TEST_SELECT=<nodeId>: the headless gate's hook — select that
# document node at boot as a click would.
import Gpu2d
import Keys
import Sdl3
import String
open Sys
open ui/Ecs
open ui/Components
open ui/Layer
open ui/SceneLoader
open ui/inputSystem/InputSystem
open ui/BindingComponents
open ui/ScenePolicy
open ui/SceneBundles
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems

# Tree rows: one design unit of indent per depth level.
const treeIndentPerLevel: Float = 12.0

const treeRowPitch: Float = 44.0

# The inspector system owns the authored `OutlineFor` components (the hover /
# selection outline nodes in chrome/Guides.raescene) and its own state.
type InspectorSystem {
  outlineFors: ComponentTable(OutlineFor)
  hovered: EntityId
  selected: EntityId
  # The tree list's row order (entity per row), so a row's action maps back.
  treeEntities: List(EntityId)
}

# The inspector's own state: the hovered / selected document entities and
# the hierarchy list's row entities. Its outlines are AUTHORED nodes in
# chrome/Guides.raescene tagged OutlineFor { role } that placeOutlines moves;
# the app creates no entity for them.
func createInspectorSystem(world: mod UiWorld) ret InspectorSystem {
  ret InspectorSystem {
    outlineFors: ComponentTable.create(OutlineFor)
    hovered: noEntity()
    selected: noEntity()
    treeEntities: List.create(EntityId, cap: 64)
  }
}

# The document scene's root: mountPage mounts the scene's root node ONTO the
# page-root entity, so the two are the same entity.
func documentSceneRoot(world: view UiWorld, pageRoot: view EntityId) ret EntityId {
  ret pageRoot
}

# Deepest active node under (x, y) in `entity`'s subtree, or none.
func deepestNodeAt(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  x: view Float
  y: view Float
) ret EntityId {
  if uiEntityActive(world: world, entity: entity) is false {
    ret noEntity()
  }
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = children.ids.length - 1, i >= 0, --i {
      let hit: EntityId = deepestNodeAt(
        world: world
        uiSystems: uiSystems
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        x: x
        y: y
      )
      if isNone(this: hit) is false {
        ret hit
      }
    }
  }
  if uiPointInEntity(
    world: world
    uiSystems: uiSystems
    entity: entity
    x: x
    y: y
  ) {
    ret entity
  }
  ret noEntity()
}

func nodeIdOf(world: view UiWorld, entity: view EntityId) ret String {
  if isNone(this: entity) {
    ret ""
  }
  if componentHas(this: world.nodeIdComponents, entity: entity) {
    ret "{componentGet(this: world.nodeIdComponents, entity: entity).id}"
  }
  ret "entity {entity.index}"
}

# First node in `entity`'s subtree whose NodeId is `nodeId`.
func findNodeByIdIn(world: view UiWorld, entity: view EntityId, nodeId: view String) ret EntityId {
  if isNone(this: entity) {
    ret noEntity()
  }
  if componentHas(this: world.nodeIdComponents, entity: entity) {
    if componentGet(this: world.nodeIdComponents, entity: entity).id is nodeId {
      ret entity
    }
  }
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = 0, i < children.ids.length, ++i {
      let found: EntityId = findNodeByIdIn(
        world: world
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        nodeId: nodeId
      )
      if isNone(this: found) is false {
        ret found
      }
    }
  }
  ret noEntity()
}

# Move an outline node onto `target`'s world rect (or hide it for none). The
# node is an absolute child of the guides root, so its Rect position stays
# (0, 0) and the translation is a RuntimeOffset — the transform-time input a
# scroll uses — while the size is the target's scaled size. Returns whether
# anything was written: an outline that moved needs the transform pass to
# run this frame (compare-before-write keeps an idle frame idle).
func placeOutline(
  world: mod UiWorld
  uiSystems: view UiSystems
  outline: view EntityId
  target: view EntityId
  visible: view Bool
) ret Bool {
  var show: Bool = visible and isNone(this: target) is false
  if show and (componentHas(this: uiSystems.transform2d.worldTransforms, entity: target) is false or componentHas(
    this: uiSystems.layout.computedRects
    entity: target
  ) is false) {
    show = false
  }
  var changed: Bool = false
  var wasShown: Bool = true
  if componentHas(this: world.actives, entity: outline) {
    wasShown = componentGet(this: world.actives, entity: outline).value
  }
  if wasShown is not show {
    componentSet(this: world.actives, entity: outline, data: Active { value: show })
    changed = true
  }
  if show is false {
    ret changed
  }
  let transform: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entity: target
  )
  let computed: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: target)
  let w: Float = computed.size.x * transform.scale.x
  let h: Float = computed.size.y * transform.scale.y
  if componentHas(this: world.rects, entity: outline) {
    let current: Rect = componentGet(this: world.rects, entity: outline)
    if current.size.x is not w or current.size.y is not h {
      let rect: mod Rect => componentMod(this: world.rects, entity: outline)
      rect.size.x = w
      rect.size.y = h
      changed = true
    }
  }
  var writeOffset: Bool = true
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entity: outline) {
    let current: Vec2 = componentGet(this: uiSystems.transform2d.runtimeOffsets, entity: outline).delta
    if current.x is transform.position.x and current.y is transform.position.y {
      writeOffset = false
    }
  }
  if writeOffset {
    let offset: RuntimeOffset = { delta: Vec2 { x: transform.position.x, y: transform.position.y } }
    componentSet(this: uiSystems.transform2d.runtimeOffsets, entity: outline, data: own offset)
    changed = true
  }
  ret changed
}

# Every node tagged OutlineFor { role } follows its target; true if any moved.
func placeOutlines(
  inspectorSystem: view InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  role: view OutlineRole
  target: view EntityId
  visible: view Bool
) ret Bool {
  var changed: Bool = false
  let count: Int = componentCount(this: inspectorSystem.outlineFors)
  loop var i: Int = 0, i < count, ++i {
    let tag: OutlineFor = componentDataAt(this: inspectorSystem.outlineFors, i: i)
    if tag.role is role {
      if placeOutline(
        world: world
        uiSystems: uiSystems
        outline: componentEntityAt(this: inspectorSystem.outlineFors, i: i)
        target: target
        visible: visible
      ) {
        changed = true
      }
    }
  }
  ret changed
}

func parentOf(world: view UiWorld, uiSystems: view UiSystems, entity: view EntityId) ret EntityId {
  if isNone(this: entity) or componentHas(this: uiSystems.hierarchy.parents, entity: entity) is false {
    ret noEntity()
  }
  ret componentGet(this: uiSystems.hierarchy.parents, entity: entity).parent
}

# The sibling `step` places away in the parent's Children (clamped).
func siblingOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  step: view Int
) ret EntityId {
  let parent: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: entity)
  if isNone(this: parent) or componentHas(this: world.childrens, entity: parent) is false {
    ret entity
  }
  let children: view Children => componentView(this: world.childrens, entity: parent)
  loop var i: Int = 0, i < children.ids.length, ++i {
    if children.ids.copyAtFallback(index: i, fallback: noEntity()) is entity {
      var next: Int = i + step
      if next < 0 {
        next = 0
      }
      if next > children.ids.length - 1 {
        next = children.ids.length - 1
      }
      ret children.ids.copyAtFallback(index: next, fallback: entity)
    }
  }
  ret entity
}

func firstChildOf(world: view UiWorld, entity: view EntityId) ret EntityId {
  if isNone(this: entity) or componentHas(this: world.childrens, entity: entity) is false {
    ret entity
  }
  let children: view Children => componentView(this: world.childrens, entity: entity)
  if children.ids.length is 0 {
    ret entity
  }
  ret children.ids.copyAtFallback(index: 0, fallback: entity)
}

# The parent chain as `a > b > c`, stopping at the document scene root.
func parentChainOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  sceneRoot: view EntityId
) ret String {
  var chain: String = ""
  var current: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: entity)
  var guard: Int = 0
  loop isNone(this: current) is false and guard < 32 {
    if chain.length() > 0 {
      chain = "{nodeIdOf(world: world, entity: current)} > {chain}"
    } else {
      chain = nodeIdOf(world: world, entity: current)
    }
    if current is sceneRoot {
      current = noEntity()
    } else {
      current = parentOf(world: world, uiSystems: uiSystems, entity: current)
    }
    guard = guard + 1
  }
  if chain.length() is 0 {
    ret "(root)"
  }
  ret chain
}

# Fill the inspector's status texts from the selection (TextBinding
# editor.inspector.* in chrome/Inspector.raescene).
# "not a lib component: Foo, Bar" — the selected node's pending (app-owned)
# components, read-only; "" when it has none.
func appComponentsLine(world: view UiWorld, entity: view EntityId) ret String {
  var names: String = ""
  loop let pending: view PendingComponent in world.pendingComponents {
    if pending.entity is entity {
      if names.length() > 0 {
        names = "{names}, {pending.name}"
      } else {
        names = "{pending.name}"
      }
    }
  }
  if names.length() is 0 {
    ret ""
  }
  ret "not a lib component: {names}"
}

# The node's bundle provenance (ui/SceneBundles BundleRefs): which bundles it
# was expanded from, which components it inherited whole (shown dimmed, in
# brackets) and which it authored a field over — "" for a node without
# bundles. The per-field diff waits for the save path.
func bundleProvenanceLine(world: view UiWorld, entity: view EntityId) ret String {
  if componentHas(this: world.bundleRefs, entity: entity) is false {
    ret ""
  }
  let refs: view BundleRefs => componentView(this: world.bundleRefs, entity: entity)
  if refs.names.length is 0 {
    ret ""
  }
  var line: String = "  bundles: {refs.names.join(sep: ", ")}"
  if refs.inherited.length > 0 {
    line = "{line}  [inherited: {refs.inherited.join(sep: ", ")}]"
  }
  if refs.overridden.length > 0 {
    line = "{line}  overrides: {refs.overridden.join(sep: ", ")}"
  }
  ret line
}

func syncInspectorPanel(
  world: view UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  inspectorSystem: view InspectorSystem
  sceneRoot: view EntityId
) {
  let selected: EntityId = inspectorSystem.selected
  if isNone(this: selected) {
    chromeSystem.inspectorNodeId = "nothing selected"
    chromeSystem.inspectorType = "click a node, or use the arrows"
    chromeSystem.inspectorComponents = ""
    chromeSystem.inspectorAppComponents = ""
    chromeSystem.inspectorRect = ""
    chromeSystem.inspectorParents = ""
    ret
  }
  chromeSystem.inspectorNodeId = nodeIdOf(world: world, entity: selected)
  var primaryType: String = ""
  if componentHas(this: world.primaryTypes, entity: selected) {
    let primary: view PrimaryType => componentView(this: world.primaryTypes, entity: selected)
    primaryType = "{primary.typeName}"
  }
  var label: String = ""
  if componentHas(this: world.names, entity: selected) {
    let name: view Name => componentView(this: world.names, entity: selected)
    label = "{name.label}"
  }
  var typeLine: String = "{primaryType} / {label}"
  if primaryType.length() is 0 {
    typeLine = "{label}"
  }
  if label.length() is 0 {
    typeLine = "{primaryType}"
  }
  chromeSystem.inspectorType = typeLine
  let componentNames: String = componentNamesFor(world: world, entity: selected)
  chromeSystem.inspectorComponents = "{String.replace(this: componentNames, old: ",", new: ", ")}{bundleProvenanceLine(
    world: world
    entity: selected
  )}"
  chromeSystem.inspectorAppComponents = appComponentsLine(world: world, entity: selected)
  var rectLine: String = "no computed rect"
  if componentHas(this: uiSystems.layout.computedRects, entity: selected) and componentHas(
    this: uiSystems.transform2d.worldTransforms
    entity: selected
  ) {
    let transform: WorldTransform2D = componentGet(
      this: uiSystems.transform2d.worldTransforms
      entity: selected
    )
    let computed: ComputedRect = componentGet(
      this: uiSystems.layout.computedRects
      entity: selected
    )
    rectLine = "x {transform.position.x.toInt()}  y {transform.position.y.toInt()}  w {computed.size.x.toInt()}  h {computed.size.y.toInt()}"
  }
  chromeSystem.inspectorRect = rectLine
  chromeSystem.inspectorParents = parentChainOf(
    world: world
    uiSystems: uiSystems
    entity: selected
    sceneRoot: sceneRoot
  )
}

func collectTreeRows(
  world: view UiWorld
  entity: view EntityId
  depth: view Int
  selected: view EntityId
  entities: mod List(EntityId)
  rows: mod List(ListViewRow)
) {
  if isNone(this: entity) or rows.length >= 256 {
    ret
  }
  var keys: List(String) = {
    "id"
    "label"
    "indent"
    "marker"
    "action"
  }
  var values: List(String) = List.create(String, cap: 5)
  values.add(value: "{entity.index}")
  values.add(value: nodeIdOf(world: world, entity: entity))
  values.add(value: "{(depth.toFloat() * treeIndentPerLevel + 6.0).toInt()}")
  var marker: String = ""
  if entity is selected {
    marker = ">"
  }
  values.add(value: marker)
  values.add(value: "inspect:{entity.index}")
  rows.add(value: ListViewRow { keys: own keys, values: own values })
  entities.add(value: entity)
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = 0, i < children.ids.length, ++i {
      collectTreeRows(
        world: world
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        depth: depth + 1
        selected: selected
        entities: entities
        rows: rows
      )
    }
  }
}

# Rebuild the hierarchy list's rows (DFS of the document, depth as indent,
# the selection marked) on the ListView tagged `EditorList { source:
# hierarchy }`.
func syncTreePanel(
  chromeSystem: view ChromeSystem
  world: mod UiWorld
  inspectorSystem: mod InspectorSystem
  sceneRoot: view EntityId
) {
  let list: EntityId = editorListEntity(
    chromeSystem: chromeSystem
    world: world
    source: EditorListSource.hierarchy
  )
  if isNone(this: list) {
    ret
  }
  inspectorSystem.treeEntities.clear()
  var rows: List(ListViewRow) = List.create(ListViewRow, cap: 32)
  collectTreeRows(
    world: world
    entity: sceneRoot
    depth: 0
    selected: inspectorSystem.selected
    entities: inspectorSystem.treeEntities
    rows: rows
  )
  setEditorListRows(world: world, list: list, rows: own rows)
}

func selectNode(inspectorSystem: mod InspectorSystem, world: mod UiWorld, entity: view EntityId) {
  inspectorSystem.selected = entity
  if isNone(this: entity) {
    ret
  }
  log(
    "[ui-editor] selected {nodeIdOf(world: world, entity: entity)}: {componentNamesFor(
      world: world
      entity: entity
    )}"
  )
}

# Per frame: hover from the pointer, click / arrows / Esc on the selection,
# tree-row actions, then the outlines and panels. Returns whether anything
# the frame shows changed.
func inspectorUpdate(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  input: view UiInput
  pageRoot: view EntityId
  chromeVisible: view Bool
) ret Bool {
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  var changed: Bool = false
  # Only the edit area reaches the document: a pointer over a chrome panel
  # (which may cover part of the document) hovers and selects nothing.
  var hovered: EntityId = noEntity()
  if chromeVisible is false or pointInEditArea(
    chromeSystem: chromeSystem
    world: world
    uiSystems: uiSystems
    x: input.pointer.x
    y: input.pointer.y
  ) {
    hovered = deepestNodeAt(
      world: world
      uiSystems: uiSystems
      entity: sceneRoot
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  if hovered is not inspectorSystem.hovered {
    inspectorSystem.hovered = hovered
    changed = true
  }
  var selection: EntityId = inspectorSystem.selected
  if input.pointer.pressed and isNone(this: hovered) is false {
    selection = hovered
  }
  if Sdl3.isKeyPressed(key: Keys.keyEscape) {
    selection = noEntity()
  }
  if isNone(this: selection) is false {
    if Sdl3.isKeyPressed(key: Keys.keyUp) {
      selection = siblingOf(
        world: world
        uiSystems: uiSystems
        entity: selection
        step: 0 - 1
      )
    }
    if Sdl3.isKeyPressed(key: Keys.keyDown) {
      selection = siblingOf(
        world: world
        uiSystems: uiSystems
        entity: selection
        step: 1
      )
    }
    if Sdl3.isKeyPressed(key: Keys.keyLeft) {
      let parent: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: selection)
      if isNone(this: parent) is false and selection is not sceneRoot {
        selection = parent
      }
    }
    if Sdl3.isKeyPressed(key: Keys.keyRight) {
      selection = firstChildOf(world: world, entity: selection)
    }
  }
  # A tree row click carries `inspect:<entity index>`.
  let actionCount: Int = uiActionCount(world: world)
  loop var a: Int = 0, a < actionCount, ++a {
    let actionId: String = uiActionAt(world: world, index: a)
    if actionId.startsWith(prefix: "inspect:") {
      let index: Int = actionId.sub(start: 8, len: actionId.length() - 8).toInt()
      loop var t: Int = 0, t < inspectorSystem.treeEntities.length, ++t {
        let candidate: EntityId = inspectorSystem.treeEntities.copyAtFallback(
          index: t
          fallback: noEntity()
        )
        if candidate.index is index {
          selection = candidate
        }
      }
    }
  }
  if Sdl3.isKeyPressed(key: Keys.keyT) {
    toggleEditorPanel(chromeSystem: chromeSystem, world: world, kind: EditorPanelKind.tree)
    changed = true
  }
  if selection is not inspectorSystem.selected {
    selectNode(inspectorSystem: inspectorSystem, world: world, entity: selection)
    changed = true
  }
  if changed {
    syncInspectorPanel(
      world: world
      uiSystems: uiSystems
      chromeSystem: chromeSystem
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
    )
    syncTreePanel(
      chromeSystem: chromeSystem
      world: world
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
    )
  }
  # Outlines follow the layout of this frame; placed every frame, cheap.
  if placeOutlines(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    role: OutlineRole.hover
    target: inspectorSystem.hovered
    visible: chromeVisible and inspectorSystem.hovered is not inspectorSystem.selected
  ) {
    changed = true
  }
  if placeOutlines(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    role: OutlineRole.selection
    target: inspectorSystem.selected
    visible: chromeVisible
  ) {
    changed = true
  }
  ret changed
}

# After a (re)load the entities are new: drop the selection, or re-find it by
# node id, and rebuild the panels.
func inspectorAfterLoad(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  selectNodeId: view String
) {
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  inspectorSystem.hovered = noEntity()
  var target: EntityId = noEntity()
  if selectNodeId.length() > 0 {
    target = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: selectNodeId)
  }
  inspectorSystem.selected = noEntity()
  if isNone(this: target) is false {
    selectNode(inspectorSystem: inspectorSystem, world: world, entity: target)
  } else {
    if selectNodeId.length() > 0 {
      log("[ui-editor] select: no node named {selectNodeId}")
    }
  }
  syncInspectorPanel(
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
  )
  syncTreePanel(
    chromeSystem: chromeSystem
    world: world
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
  )
}
