# inspectorSystem — the read-only inspector (design §3): hover highlights the
# document node under the pointer, a click selects it, the arrow keys walk the
# tree (Up/Down siblings, Left parent, Right first child), Esc clears, T
# toggles a tree panel. The highlights are two `Shape` outline entities on an
# `overlay` layer that this system MOVES to the target's world rect — the stock
# render system draws them, there is no special draw path. Hit-testing walks
# the DOCUMENT page only (deepest node under the pointer, whether or not it has
# an OnClick), so the chrome can never select itself.
#
# RAE_UI_EDITOR_TEST_SELECT=<nodeId>: the headless gate's hook — select that
# document node at boot as a click would.
import Gpu2d
import Keys
import Sdl3
import String
open Sys
open ui/Ecs
open ui/Components
open ui/Layer
open ui/SceneLoader
open ui/inputSystem/InputSystem
open ui/BindingComponents
open ui/ScenePolicy
open ui/SceneBundles
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems
open ui/Scene
open inspectorSystem/NodeQuery
open inspectorSystem/RectWidget
open inspectorSystem/RectEdit
open inspectorSystem/ComponentEdit

# Tree rows: one design unit of indent per depth level.
const treeIndentPerLevel: Float = 12.0

# The inspector system owns the authored `OutlineFor` components (the hover /
# selection outline nodes in chrome/Guides.raescene) and its own state.
type InspectorSystem {
  outlineFors: ComponentTable(OutlineFor)
  hovered: EntityId
  # The ACTIVE node: the one the outline follows, the inspector describes and
  # the arrow keys walk from. Always a member of `selection` (or none).
  selected: EntityId
  # The SELECTION SET (#54986153). Every component widget reads this, so a
  # single selection is just the n=1 case and no widget has a single-entity
  # path to generalise later.
  selection: List(EntityId)
  # Where a Shift-range starts (#16096994). A file browser has THREE pieces of
  # selection state, not two, and collapsing them is what makes Shift+click
  # feel wrong: the set, the active row, and the range anchor. A plain /
  # Cmd / Alt click moves the anchor here; a Shift+click does NOT, so
  # shift-clicking twice re-spans from the same origin instead of ratcheting
  # the range outward one click at a time.
  rangeAnchor: EntityId
  # Click-through cycling (#73816378): where the last plain canvas click
  # landed, and how deep into that point's hit stack the selection now is.
  # `cycleActive` is cleared by every selection change that is NOT the next
  # click of this cycle, so a click on a neighbouring node cannot inherit a
  # stale depth.
  cycleX: Float
  cycleY: Float
  cycleDepth: Int
  cycleActive: Bool
  # The hit stack of the current cycle point, deepest first. Held on the
  # system rather than rebuilt per step so the cycle walks ONE stack: a
  # relayout between clicks cannot renumber the steps under the user.
  cycleStack: List(EntityId)
  # The component-list filter (#57156455): the typed text, and whether the
  # keyboard is currently feeding it. `/` focuses, Esc clears and unfocuses.
  # Focus matters because the editor binds BARE letters as panel shortcuts —
  # without a mode, typing a filter would toggle half the chrome.
  componentFilter: String
  filterFocused: Bool
  # The HIERARCHY filter (#89663819), with its own focus. Two filters, two
  # panels: `/` types into the component list, `F` into the tree. They are
  # mutually exclusive — one keyboard cannot feed both.
  treeFilter: String
  treeFilterFocused: Bool
  # The Rect group's text input (#44133406): whether a field has focus, which
  # one, what has been typed so far, and the W/H aspect lock.
  rectEditing: Bool
  rectField: RectField
  rectDraft: String
  rectLocked: Bool
  # Collapsed rows, by NODE ID rather than entity or row index (#72481430).
  # The tree rebuilds constantly and a reload recreates every entity, so an
  # entity handle or an index would lose the state on the next keystroke;
  # a node id is the one thing that survives both. Nothing clears this on
  # reload — that IS the persistence.
  collapsedNodeIds: List(String)
  # The tree list's row order (entity per row), so a row's action maps back.
  # This is also the order a Shift-range spans, which is why the range is
  # over the VISIBLE rows and not over the hierarchy: what the user is
  # selecting is the run of rows they can see between two clicks.
  treeEntities: List(EntityId)
}

# The inspector's own state: the hovered / selected document entities and
# the hierarchy list's row entities. Its outlines are AUTHORED nodes in
# chrome/Guides.raescene tagged OutlineFor { role } that placeOutlines moves;
# the app creates no entity for them.
func createInspectorSystem(world: mod UiWorld) ret InspectorSystem {
  ret InspectorSystem {
    outlineFors: ComponentTable.create(OutlineFor)
    hovered: noEntity()
    selected: noEntity()
    selection: List.create(EntityId, cap: 8)
    rangeAnchor: noEntity()
    cycleX: 0.0
    cycleY: 0.0
    cycleDepth: 0
    cycleActive: false
    cycleStack: List.create(EntityId, cap: 8)
    collapsedNodeIds: List.create(String, cap: 8)
    componentFilter: ""
    filterFocused: false
    treeFilter: ""
    treeFilterFocused: false
    rectEditing: false
    rectField: RectField.x
    rectDraft: ""
    rectLocked: false
    treeEntities: List.create(EntityId, cap: 64)
  }
}

# Move an outline node onto `target`'s world rect (or hide it for none). The
# node is an absolute child of the guides root, so its Rect position stays
# (0, 0) and the translation is a RuntimeOffset — the transform-time input a
# scroll uses — while the size is the target's scaled size. Returns whether
# anything was written: an outline that moved needs the transform pass to
# run this frame (compare-before-write keeps an idle frame idle).
func placeOutline(
  world: mod UiWorld
  uiSystems: view UiSystems
  outline: view EntityId
  target: view EntityId
  visible: view Bool
) ret Bool {
  var show: Bool = visible and isNone(this: target) is false
  if show and (componentHas(this: uiSystems.transform2d.worldTransforms, entity: target) is false or componentHas(
    this: uiSystems.layout.computedRects
    entity: target
  ) is false) {
    show = false
  }
  var changed: Bool = false
  var wasShown: Bool = true
  if componentHas(this: world.actives, entity: outline) {
    wasShown = componentGet(this: world.actives, entity: outline).value
  }
  if wasShown is not show {
    componentSet(this: world.actives, entity: outline, data: Active { value: show })
    changed = true
  }
  if show is false {
    ret changed
  }
  let transform: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entity: target
  )
  let computed: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: target)
  let w: Float = computed.size.x * transform.scale.x
  let h: Float = computed.size.y * transform.scale.y
  if componentHas(this: world.rects, entity: outline) {
    let current: Rect = componentGet(this: world.rects, entity: outline)
    if current.size.x is not w or current.size.y is not h {
      let rect: mod Rect => componentMod(this: world.rects, entity: outline)
      rect.size.x = w
      rect.size.y = h
      changed = true
    }
  }
  var writeOffset: Bool = true
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entity: outline) {
    let current: Vec2 = componentGet(this: uiSystems.transform2d.runtimeOffsets, entity: outline).delta
    if current.x is transform.position.x and current.y is transform.position.y {
      writeOffset = false
    }
  }
  if writeOffset {
    let offset: RuntimeOffset = { delta: Vec2 { x: transform.position.x, y: transform.position.y } }
    componentSet(this: uiSystems.transform2d.runtimeOffsets, entity: outline, data: own offset)
    changed = true
  }
  ret changed
}

# Every node tagged OutlineFor { role } follows its target; true if any moved.
func placeOutlines(
  inspectorSystem: view InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  role: view OutlineRole
  target: view EntityId
  visible: view Bool
) ret Bool {
  var changed: Bool = false
  let count: Int = componentCount(this: inspectorSystem.outlineFors)
  loop var i: Int = 0, i < count, ++i {
    let tag: OutlineFor = componentDataAt(this: inspectorSystem.outlineFors, i: i)
    if tag.role is role {
      if placeOutline(
        world: world
        uiSystems: uiSystems
        outline: componentEntityAt(this: inspectorSystem.outlineFors, i: i)
        target: target
        visible: visible
      ) {
        changed = true
      }
    }
  }
  ret changed
}

# Per frame: hover from the pointer, click / arrows / Esc on the selection,
# tree-row actions, then the outlines and panels. Returns whether anything
# the frame shows changed.
# Is the keyboard feeding a text input right now? While it is, keys are TEXT,
# not commands: the bare-letter panel shortcuts in App.rae, the arrows, `T`,
# `U`, `/`, `F` and the deselecting Esc must all stand down. One question with
# one answer, asked at the START of the frame, so the keystroke that ENDS an
# edit (Enter, Esc) is still spent on the edit and not also on a command.
func keyboardCaptured(inspectorSystem: view InspectorSystem) ret Bool {
  ret inspectorSystem.filterFocused or inspectorSystem.treeFilterFocused or inspectorSystem.rectEditing
}

func inspectorUpdate(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  input: view UiInput
  pageRoot: view EntityId
  chromeVisible: view Bool
  scene: view Scene
) ret Bool {
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  var changed: Bool = false
  # Asked ONCE, before anything this frame can change it (see keyboardCaptured).
  let captured: Bool = keyboardCaptured(inspectorSystem: inspectorSystem)
  # --- The Rect group's text input (#44133406) -----------------------------
  # Rect-row clicks first: focusing a field and toggling the lock.
  var rectAction: Bool = false
  let rectActionCount: Int = uiActionCount(world: world)
  loop var a: Int = 0, a < rectActionCount, ++a {
    let actionId: String = uiActionAt(world: world, index: a)
    if actionId is "rectLock" {
      rectAction = true
      rectToggleLock(inspectorSystem: inspectorSystem)
      changed = true
    }
    if actionId.startsWith(prefix: "rectFocus:") {
      rectAction = true
      if let field: RectField = rectFieldFromName(
        name: actionId.sub(start: 10, len: actionId.length() - 10)
      ) {
        # Clicking a DIFFERENT field blurs the current one, and a blur commits
        # — the same as Tab, just not in tab order.
        if inspectorSystem.rectEditing and inspectorSystem.rectField is not field {
          rectCommit(inspectorSystem: inspectorSystem, world: world, uiSystems: uiSystems)
        }
        if inspectorSystem.rectEditing is false or inspectorSystem.rectField is not field {
          rectFocus(inspectorSystem: inspectorSystem, field: field)
        }
        changed = true
      }
    }
  }
  # A press ANYWHERE else is a blur, and a blur commits. It runs before the
  # canvas and tree clicks below, so the draft lands on the selection it was
  # typed for — not on whatever that click is about to select.
  if input.pointer.pressed and inspectorSystem.rectEditing and rectAction is false {
    rectEnter(inspectorSystem: inspectorSystem, world: world, uiSystems: uiSystems)
    changed = true
  }
  # Keys, only while a field has focus. Digits live on key1..key9 then key0.
  if inspectorSystem.rectEditing and rectAction is false {
    let digits: String = "123456789"
    loop var d: Int = 0, d < 9, ++d {
      if Sdl3.isKeyPressed(key: Keys.key1 + d) {
        rectTypeChar(inspectorSystem: inspectorSystem, character: digits.sub(start: d, len: 1))
        changed = true
      }
    }
    if Sdl3.isKeyPressed(key: Keys.key0) {
      rectTypeChar(inspectorSystem: inspectorSystem, character: "0")
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyMinus) {
      rectTypeChar(inspectorSystem: inspectorSystem, character: "-")
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyPeriod) {
      rectTypeChar(inspectorSystem: inspectorSystem, character: ".")
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyBackspace) {
      rectBackspace(inspectorSystem: inspectorSystem)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyTab) {
      rectTab(inspectorSystem: inspectorSystem, world: world, uiSystems: uiSystems)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyEnter) {
      rectEnter(inspectorSystem: inspectorSystem, world: world, uiSystems: uiSystems)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyEscape) {
      rectEscape(inspectorSystem: inspectorSystem)
      changed = true
    }
  }
  # Only the edit area reaches the document: a pointer over a chrome panel
  # (which may cover part of the document) hovers and selects nothing.
  # Whether the pointer is over the CANVAS this frame. It gates both halves of
  # the click: a press on a chrome panel must not hover a document node, and
  # — the reason this is now a named local — must not read as a click on
  # empty canvas either, or every press on the `I` toggle would silently
  # throw the selection away.
  let onCanvas: Bool = chromeVisible is false or pointInEditArea(
    chromeSystem: chromeSystem
    world: world
    uiSystems: uiSystems
    x: input.pointer.x
    y: input.pointer.y
  )
  var hovered: EntityId = noEntity()
  if onCanvas {
    hovered = deepestNodeAt(
      world: world
      uiSystems: uiSystems
      entity: sceneRoot
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  if hovered is not inspectorSystem.hovered {
    inspectorSystem.hovered = hovered
    changed = true
  }
  # The canvas click goes straight through the selection funnel with whatever
  # modifiers are held — including the empty-space case, which is the whole
  # point: a plain click that hits nothing clears the set.
  if input.pointer.pressed and onCanvas {
    if canvasSelectAt(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      x: input.pointer.x
      y: input.pointer.y
      mode: pointerSelectMode()
    ) {
      changed = true
    }
  }
  # A tree row click carries `inspect:<entity index>` — an ENTITY index, not a
  # row index, so the live tree can rebuild under the user (it refreshes
  # constantly) without a click landing on whatever slid into that row.
  #
  # It runs BEFORE the keyboard block reads the active node, and goes straight
  # through the funnel rather than via the `selection` local below: a
  # Cmd+click that removes the ACTIVE row does not move the active node, and
  # the local's `is not selected` guard would have swallowed it.
  let actionCount: Int = uiActionCount(world: world)
  loop var a: Int = 0, a < actionCount, ++a {
    let actionId: String = uiActionAt(world: world, index: a)
    if actionId.startsWith(prefix: "inspect:") {
      let index: Int = actionId.sub(start: 8, len: actionId.length() - 8).toInt()
      loop var t: Int = 0, t < inspectorSystem.treeEntities.length, ++t {
        let candidate: EntityId = inspectorSystem.treeEntities.copyAtFallback(
          index: t
          fallback: noEntity()
        )
        if candidate.index is index {
          if applySelect(
            inspectorSystem: inspectorSystem
            world: world
            entity: candidate
            mode: treeSelectMode()
          ) {
            changed = true
          }
        }
      }
    }
  }
  # Component add / remove from the inspector's own rows (#57156455). Both
  # act on the WHOLE selection, and both report how many entities actually
  # changed — "removed Shape from 2" is the only way to tell a real edit from
  # a click on a component only one of the selected nodes had.
  loop var a: Int = 0, a < actionCount, ++a {
    let actionId: String = uiActionAt(world: world, index: a)
    if actionId.startsWith(prefix: "compRemove:") {
      let name: String = actionId.sub(start: 11, len: actionId.length() - 11)
      let removed: Int = removeComponentFromSelection(
        world: world
        selection: inspectorSystem.selection
        name: name
      )
      log("[ui-editor] removed {name} from {removed}")
      changed = true
    }
    if actionId.startsWith(prefix: "compAdd:") {
      let name: String = actionId.sub(start: 8, len: actionId.length() - 8)
      let added: Int = addComponentToSelection(
        world: world
        selection: inspectorSystem.selection
        name: name
      )
      log("[ui-editor] added {name} to {added}")
      changed = true
    }
  }
  # Chevron clicks: collapse / expand, keyed on the node id the row carries
  # (#72481430). Handled BEFORE the row's own `inspect:` action so a click on
  # the chevron toggles rather than also selecting — they are different
  # targets inside one row and only one of them should win.
  loop var a: Int = 0, a < actionCount, ++a {
    let actionId: String = uiActionAt(world: world, index: a)
    if actionId.startsWith(prefix: "treeToggle:") {
      let nodeId: String = actionId.sub(start: 11, len: actionId.length() - 11)
      var found: Int = 0 - 1
      loop var i: Int = 0, i < inspectorSystem.collapsedNodeIds.length, ++i {
        if let name: String = inspectorSystem.collapsedNodeIds.copyAt(index: i) {
          if name is nodeId {
            found = i
          }
        }
      }
      if found >= 0 {
        inspectorSystem.collapsedNodeIds.removeAt(index: found)
        log("[ui-editor] expanded {nodeId}")
      } else {
        inspectorSystem.collapsedNodeIds.add(value: "{nodeId}")
        log("[ui-editor] collapsed {nodeId}")
      }
      changed = true
    }
  }
  # Select parent, from the inspector's own row or the `U` key (#23728694).
  if Sdl3.isKeyPressed(key: Keys.keyU) and captured is false {
    if selectParentOfSelection(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
    ) {
      changed = true
    }
  }
  loop var a: Int = 0, a < actionCount, ++a {
    if uiActionAt(world: world, index: a) is "selectParent" {
      if selectParentOfSelection(
        inspectorSystem: inspectorSystem
        world: world
        uiSystems: uiSystems
        sceneRoot: sceneRoot
      ) {
        changed = true
      }
    }
  }
  # The component filter (#57156455). `/` focuses it; while focused the letter
  # keys type into it instead of firing the editor's panel shortcuts, which is
  # why App.rae gates those on `filterFocused`.
  if Sdl3.isKeyPressed(key: Keys.keySlash) and captured is false {
    inspectorSystem.filterFocused = true
    inspectorSystem.treeFilterFocused = false
    changed = true
  }
  if Sdl3.isKeyPressed(key: Keys.keyF) and captured is false {
    inspectorSystem.treeFilterFocused = true
    changed = true
  }
  if inspectorSystem.treeFilterFocused {
    if Sdl3.isKeyPressed(key: Keys.keyEscape) {
      inspectorSystem.treeFilter = ""
      inspectorSystem.treeFilterFocused = false
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyBackspace) {
      let length: Int = inspectorSystem.treeFilter.length()
      if length > 0 {
        inspectorSystem.treeFilter = inspectorSystem.treeFilter.sub(start: 0, len: length - 1)
        changed = true
      }
    }
    loop var letter: Int = 0, letter < 26, ++letter {
      if Sdl3.isKeyPressed(key: Keys.keyA + letter) {
        inspectorSystem.treeFilter = "{inspectorSystem.treeFilter}{letterText(index: letter)}"
        changed = true
      }
    }
  }
  if inspectorSystem.filterFocused {
    if Sdl3.isKeyPressed(key: Keys.keyEscape) {
      inspectorSystem.componentFilter = ""
      inspectorSystem.filterFocused = false
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyBackspace) {
      let length: Int = inspectorSystem.componentFilter.length()
      if length > 0 {
        inspectorSystem.componentFilter = inspectorSystem.componentFilter.sub(
          start: 0
          len: length - 1
        )
        changed = true
      }
    }
    # keyA..keyZ are contiguous scancodes, so the alphabet is one loop rather
    # than 26 arms.
    loop var letter: Int = 0, letter < 26, ++letter {
      if Sdl3.isKeyPressed(key: Keys.keyA + letter) {
        inspectorSystem.componentFilter = "{inspectorSystem.componentFilter}{letterText(
          index: letter
        )}"
        changed = true
      }
    }
  }
  # The arrows walk the active node; Shift+arrow spans a range to wherever it
  # lands, so extending with the keyboard and extending with the mouse are the
  # same operation over the same anchor.
  var selection: EntityId = inspectorSystem.selected
  var keyboardMode: SelectMode = SelectMode.replace
  if Sdl3.isKeyDown(key: Keys.keyLShift) or Sdl3.isKeyDown(key: Keys.keyRShift) {
    keyboardMode = SelectMode.range
  }
  # Esc deselects and the arrows walk the tree ONLY when no text input owns
  # the keyboard: Esc inside a filter or a Rect field ends that edit, and must
  # not also throw the selection away.
  if Sdl3.isKeyPressed(key: Keys.keyEscape) and captured is false {
    selection = noEntity()
    keyboardMode = SelectMode.replace
  }
  if isNone(this: selection) is false and captured is false {
    if Sdl3.isKeyPressed(key: Keys.keyUp) {
      selection = siblingOf(
        world: world
        uiSystems: uiSystems
        entity: selection
        step: -1
      )
    }
    if Sdl3.isKeyPressed(key: Keys.keyDown) {
      selection = siblingOf(
        world: world
        uiSystems: uiSystems
        entity: selection
        step: 1
      )
    }
    if Sdl3.isKeyPressed(key: Keys.keyLeft) {
      let parent: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: selection)
      if isNone(this: parent) is false and selection is not sceneRoot {
        selection = parent
      }
    }
    if Sdl3.isKeyPressed(key: Keys.keyRight) {
      selection = firstChildOf(world: world, entity: selection)
    }
  }
  if Sdl3.isKeyPressed(key: Keys.keyT) and captured is false {
    toggleEditorPanel(chromeSystem: chromeSystem, world: world, kind: EditorPanelKind.tree)
    changed = true
  }
  if selection is not inspectorSystem.selected {
    if applySelect(
      inspectorSystem: inspectorSystem
      world: world
      entity: selection
      mode: keyboardMode
    ) {
      changed = true
    }
  }
  if changed {
    syncInspectorPanel(
      world: world
      uiSystems: uiSystems
      chromeSystem: chromeSystem
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
      scene: scene
    )
    syncTreePanel(
      chromeSystem: chromeSystem
      world: world
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
    )
  }
  # Outlines follow the layout of this frame; placed every frame, cheap.
  if placeOutlines(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    role: OutlineRole.hover
    target: inspectorSystem.hovered
    visible: chromeVisible and inspectorSystem.hovered is not inspectorSystem.selected
  ) {
    changed = true
  }
  if placeOutlines(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    role: OutlineRole.selection
    target: inspectorSystem.selected
    visible: chromeVisible
  ) {
    changed = true
  }
  ret changed
}

# After a (re)load the entities are new: drop the selection, or re-find it by
# node id, and rebuild the panels.
func inspectorAfterLoad(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  selectNodeId: view String
  setRect: view String
  scene: view Scene
) {
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  inspectorSystem.hovered = noEntity()
  var target: EntityId = noEntity()
  if selectNodeId.length() > 0 {
    target = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: selectNodeId)
  }
  inspectorSystem.selected = noEntity()
  inspectorSystem.selection.clear()
  # `a,b,c` selects several nodes: the headless hook has to be able to produce
  # a real n>1 selection, or the composite half of every widget goes untested.
  if selectNodeId.indexOf(sub: ",") >= 0 {
    let ids: List(String) = selectNodeId.split(sep: ",")
    loop let id: view String in ids {
      let trimmed: String = id.trim()
      if trimmed.length() is 0 {
        continue
      }
      let found: EntityId = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: trimmed)
      if isNone(this: found) is false {
        selectAddNode(inspectorSystem: inspectorSystem, world: world, entity: found)
      } else {
        log("[ui-editor] select: no node named {trimmed}")
      }
    }
  } else {
    if isNone(this: target) is false {
      selectNode(inspectorSystem: inspectorSystem, world: world, entity: target)
    } else {
      if selectNodeId.length() > 0 {
        log("[ui-editor] select: no node named {selectNodeId}")
      }
    }
  }
  # The widget's model, as a line the headless gate can assert without pixels:
  # the composite value per field and what drives it, for however many nodes
  # the hook selected.
  if selectNodeId.length() > 0 {
    let rectLine: String = rectWidgetLine(
      world: world
      uiSystems: uiSystems
      selection: inspectorSystem.selection
    )
    log("[ui-editor] rect ({inspectorSystem.selection.length}): {rectLine}")
  }
  # `<field>=<value>` drives the widget's WRITE half from the same hook: one
  # edit goes to every selected entity, which is the part a single-selection
  # inspector would have let us skip.
  if setRect.length() > 0 {
    # Through the SAME functions the keys call (RectEdit.rae), not straight
    # into applyRectField — so the gate proves the keyboard's commit path.
    let written: Int = runRectScript(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      script: setRect
    )
    let afterLine: String = rectWidgetLine(
      world: world
      uiSystems: uiSystems
      selection: inspectorSystem.selection
    )
    log("[ui-editor] rect set {setRect} -> {written}: {afterLine}")
  }
  syncInspectorPanel(
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
    scene: scene
  )
  syncTreePanel(
    chromeSystem: chromeSystem
    world: world
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
  )
}
