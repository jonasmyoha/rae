# inspectorSystem — the read-only inspector (design §3): hover highlights the
# document node under the pointer, a click selects it, the arrow keys walk the
# tree (Up/Down siblings, Left parent, Right first child), Esc clears, T
# toggles a tree panel. The highlights are two `Shape` outline entities on an
# `overlay` layer that this system MOVES to the target's world rect — the stock
# render system draws them, there is no special draw path. Hit-testing walks
# the DOCUMENT page only (deepest node under the pointer, whether or not it has
# an OnClick), so the chrome can never select itself.
#
# RAE_UI_EDITOR_TEST_SELECT=<nodeId>: the headless gate's hook — select that
# document node at boot as a click would.
import Gpu2d
import Keys
import Sdl3
import String
open Sys
open ui/Ecs
open ui/Components
open ui/Layer
open ui/SceneLoader
open ui/inputSystem/InputSystem
open ui/BindingComponents
open ui/ScenePolicy
open ui/SceneBundles
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems
open inspectorSystem/NodeQuery
open inspectorSystem/RectWidget

# Tree rows: one design unit of indent per depth level.
const treeIndentPerLevel: Float = 12.0

const treeRowPitch: Float = 44.0

# The inspector system owns the authored `OutlineFor` components (the hover /
# selection outline nodes in chrome/Guides.raescene) and its own state.
type InspectorSystem {
  outlineFors: ComponentTable(OutlineFor)
  hovered: EntityId
  # The ACTIVE node: the one the outline follows, the inspector describes and
  # the arrow keys walk from. Always a member of `selection` (or none).
  selected: EntityId
  # The SELECTION SET (#54986153). Every component widget reads this, so a
  # single selection is just the n=1 case and no widget has a single-entity
  # path to generalise later.
  selection: List(EntityId)
  # Where a Shift-range starts (#16096994). A file browser has THREE pieces of
  # selection state, not two, and collapsing them is what makes Shift+click
  # feel wrong: the set, the active row, and the range anchor. A plain /
  # Cmd / Alt click moves the anchor here; a Shift+click does NOT, so
  # shift-clicking twice re-spans from the same origin instead of ratcheting
  # the range outward one click at a time.
  rangeAnchor: EntityId
  # The tree list's row order (entity per row), so a row's action maps back.
  # This is also the order a Shift-range spans, which is why the range is
  # over the VISIBLE rows and not over the hierarchy: what the user is
  # selecting is the run of rows they can see between two clicks.
  treeEntities: List(EntityId)
}

# The inspector's own state: the hovered / selected document entities and
# the hierarchy list's row entities. Its outlines are AUTHORED nodes in
# chrome/Guides.raescene tagged OutlineFor { role } that placeOutlines moves;
# the app creates no entity for them.
func createInspectorSystem(world: mod UiWorld) ret InspectorSystem {
  ret InspectorSystem {
    outlineFors: ComponentTable.create(OutlineFor)
    hovered: noEntity()
    selected: noEntity()
    selection: List.create(EntityId, cap: 8)
    rangeAnchor: noEntity()
    treeEntities: List.create(EntityId, cap: 64)
  }
}

# Move an outline node onto `target`'s world rect (or hide it for none). The
# node is an absolute child of the guides root, so its Rect position stays
# (0, 0) and the translation is a RuntimeOffset — the transform-time input a
# scroll uses — while the size is the target's scaled size. Returns whether
# anything was written: an outline that moved needs the transform pass to
# run this frame (compare-before-write keeps an idle frame idle).
func placeOutline(
  world: mod UiWorld
  uiSystems: view UiSystems
  outline: view EntityId
  target: view EntityId
  visible: view Bool
) ret Bool {
  var show: Bool = visible and isNone(this: target) is false
  if show and (componentHas(this: uiSystems.transform2d.worldTransforms, entity: target) is false or componentHas(
    this: uiSystems.layout.computedRects
    entity: target
  ) is false) {
    show = false
  }
  var changed: Bool = false
  var wasShown: Bool = true
  if componentHas(this: world.actives, entity: outline) {
    wasShown = componentGet(this: world.actives, entity: outline).value
  }
  if wasShown is not show {
    componentSet(this: world.actives, entity: outline, data: Active { value: show })
    changed = true
  }
  if show is false {
    ret changed
  }
  let transform: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entity: target
  )
  let computed: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: target)
  let w: Float = computed.size.x * transform.scale.x
  let h: Float = computed.size.y * transform.scale.y
  if componentHas(this: world.rects, entity: outline) {
    let current: Rect = componentGet(this: world.rects, entity: outline)
    if current.size.x is not w or current.size.y is not h {
      let rect: mod Rect => componentMod(this: world.rects, entity: outline)
      rect.size.x = w
      rect.size.y = h
      changed = true
    }
  }
  var writeOffset: Bool = true
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entity: outline) {
    let current: Vec2 = componentGet(this: uiSystems.transform2d.runtimeOffsets, entity: outline).delta
    if current.x is transform.position.x and current.y is transform.position.y {
      writeOffset = false
    }
  }
  if writeOffset {
    let offset: RuntimeOffset = { delta: Vec2 { x: transform.position.x, y: transform.position.y } }
    componentSet(this: uiSystems.transform2d.runtimeOffsets, entity: outline, data: own offset)
    changed = true
  }
  ret changed
}

# Every node tagged OutlineFor { role } follows its target; true if any moved.
func placeOutlines(
  inspectorSystem: view InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  role: view OutlineRole
  target: view EntityId
  visible: view Bool
) ret Bool {
  var changed: Bool = false
  let count: Int = componentCount(this: inspectorSystem.outlineFors)
  loop var i: Int = 0, i < count, ++i {
    let tag: OutlineFor = componentDataAt(this: inspectorSystem.outlineFors, i: i)
    if tag.role is role {
      if placeOutline(
        world: world
        uiSystems: uiSystems
        outline: componentEntityAt(this: inspectorSystem.outlineFors, i: i)
        target: target
        visible: visible
      ) {
        changed = true
      }
    }
  }
  ret changed
}

# Add `entity` to the selection and make it the anchor, or drop it when it is
# already selected (a modifier-click). Kept beside `selectNode` so both halves
# of the selection contract live in one place.
func selectAddNode(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entity: view EntityId
) {
  if isNone(this: entity) {
    ret
  }
  loop var i: Int = 0, i < inspectorSystem.selection.length, ++i {
    if let member: EntityId = inspectorSystem.selection.copyAt(index: i) {
      if member is entity {
        inspectorSystem.selection.removeAt(index: i)
        var anchor: EntityId = noEntity()
        if inspectorSystem.selection.length > 0 {
          if let last: EntityId = inspectorSystem.selection.copyAt(
            index: inspectorSystem.selection.length - 1
          ) {
            anchor = last
          }
        }
        inspectorSystem.selected = anchor
        ret
      }
    }
  }
  inspectorSystem.selection.add(value: entity)
  inspectorSystem.selected = entity
}

func syncInspectorPanel(
  world: view UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  inspectorSystem: view InspectorSystem
  sceneRoot: view EntityId
) {
  let selected: EntityId = inspectorSystem.selected
  if isNone(this: selected) {
    chromeSystem.inspectorNodeId = "nothing selected"
    chromeSystem.inspectorType = "click a node, or use the arrows"
    chromeSystem.inspectorComponents = ""
    chromeSystem.inspectorAppComponents = ""
    chromeSystem.inspectorRect = ""
    chromeSystem.inspectorParents = ""
    ret
  }
  chromeSystem.inspectorNodeId = nodeIdOf(world: world, entity: selected)
  var primaryType: String = ""
  if componentHas(this: world.primaryTypes, entity: selected) {
    let primary: view PrimaryType => componentView(this: world.primaryTypes, entity: selected)
    primaryType = "{primary.typeName}"
  }
  var label: String = ""
  if componentHas(this: world.names, entity: selected) {
    let name: view Name => componentView(this: world.names, entity: selected)
    label = "{name.label}"
  }
  var typeLine: String = "{primaryType} / {label}"
  if primaryType.length() is 0 {
    typeLine = "{label}"
  }
  if label.length() is 0 {
    typeLine = "{primaryType}"
  }
  chromeSystem.inspectorType = typeLine
  let componentNames: String = componentNamesFor(world: world, entity: selected)
  chromeSystem.inspectorComponents = "{String.replace(this: componentNames, old: ",", new: ", ")}{bundleProvenanceLine(
    world: world
    entity: selected
  )}"
  chromeSystem.inspectorAppComponents = appComponentsLine(world: world, entity: selected)
  # The Rect widget, over the WHOLE selection: a field the selected entities
  # agree on shows its value, one they differ on shows the mixed marker, and
  # each carries what drives it (#54986153).
  chromeSystem.inspectorRect = rectWidgetLine(
    world: world
    uiSystems: uiSystems
    selection: inspectorSystem.selection
  )
  chromeSystem.inspectorParents = parentChainOf(
    world: world
    uiSystems: uiSystems
    entity: selected
    sceneRoot: sceneRoot
  )
}

# The row marker: `>` for the ACTIVE node (the one the inspector describes),
# `-` for the other selected rows. Two glyphs rather than one because with a
# range selected, "which of these is the arrow keys' origin" is not guessable
# from a uniform highlight.
func treeRowMarker(
  selection: view List(EntityId)
  entity: view EntityId
  selected: view EntityId
) ret String {
  if entity is selected {
    ret ">"
  }
  loop var i: Int = 0, i < selection.length, ++i {
    if let member: EntityId = selection.copyAt(index: i) {
      if member is entity {
        ret "-"
      }
    }
  }
  ret ""
}

func collectTreeRows(
  world: view UiWorld
  entity: view EntityId
  depth: view Int
  selected: view EntityId
  selection: view List(EntityId)
  entities: mod List(EntityId)
  rows: mod List(ListViewRow)
) {
  if isNone(this: entity) or rows.length >= 256 {
    ret
  }
  var keys: List(String) = {
    "id"
    "label"
    "indent"
    "marker"
    "action"
  }
  var values: List(String) = List.create(String, cap: 5)
  values.add(value: "{entity.index}")
  values.add(value: nodeIdOf(world: world, entity: entity))
  values.add(value: "{(depth.toFloat() * treeIndentPerLevel + 6.0).toInt()}")
  values.add(value: treeRowMarker(selection: selection, entity: entity, selected: selected))
  values.add(value: "inspect:{entity.index}")
  rows.add(value: ListViewRow { keys: own keys, values: own values })
  entities.add(value: entity)
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = 0, i < children.ids.length, ++i {
      collectTreeRows(
        world: world
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        depth: depth + 1
        selected: selected
        selection: selection
        entities: entities
        rows: rows
      )
    }
  }
}

# Rebuild the hierarchy list's rows (DFS of the document, depth as indent,
# the selection marked) on the ListView tagged `EditorList { source:
# hierarchy }`.
func syncTreePanel(
  chromeSystem: view ChromeSystem
  world: mod UiWorld
  inspectorSystem: mod InspectorSystem
  sceneRoot: view EntityId
) {
  let list: EntityId = editorListEntity(
    chromeSystem: chromeSystem
    world: world
    source: EditorListSource.hierarchy
  )
  if isNone(this: list) {
    ret
  }
  inspectorSystem.treeEntities.clear()
  var rows: List(ListViewRow) = List.create(ListViewRow, cap: 32)
  collectTreeRows(
    world: world
    entity: sceneRoot
    depth: 0
    selected: inspectorSystem.selected
    selection: inspectorSystem.selection
    entities: inspectorSystem.treeEntities
    rows: rows
  )
  setEditorListRows(world: world, list: list, rows: own rows)
}

# Replace the selection with exactly `entity` (a plain click). Every path that
# changes the selection goes through here or `selectAddNode`, so the anchor and
# the set can never disagree.
func selectNode(inspectorSystem: mod InspectorSystem, world: mod UiWorld, entity: view EntityId) {
  inspectorSystem.selected = entity
  inspectorSystem.selection.clear()
  if isNone(this: entity) {
    ret
  }
  inspectorSystem.selection.add(value: entity)
  log(
    "[ui-editor] selected {nodeIdOf(world: world, entity: entity)}: {componentNamesFor(
      world: world
      entity: entity
    )}"
  )
}

# How a click changes the selection. The canvas, the hierarchy and every
# keyboard path funnel through `applySelect` with one of these, so the two
# panels cannot grow two different vocabularies for the one shared set.
#
#   replace  — plain click: the selection becomes exactly this node, and a
#              plain click on EMPTY space clears it (there was previously no
#              way to deselect at all).
#   toggle   — Cmd/Ctrl+click: in if it was out, out if it was in.
#   add      — Shift+click: in, and never out. The hierarchy spends this on
#              range extension (#16096994); on the canvas there is no range,
#              so it is a plain additive click.
#   subtract — Alt/Opt+click: out, and never in. Distinct from `toggle`
#              because with stacked nodes a toggle is ambiguous about which
#              one you meant to drop, and "remove this" is worth being able
#              to say without having to know the current state.
#   range    — Shift+click IN THE TREE: select the contiguous run of visible
#              rows between the range anchor and this row. The canvas has no
#              row order, so there Shift stays a plain `add`; the modifier is
#              the same key, and what a RANGE means is simply a property of
#              the surface you clicked.
enum SelectMode {
  replace
  toggle
  add
  subtract
  range
}

# Which mode the modifier keys currently held ask for.
#
# Several modifiers at once are ranked by how specific they are: subtract is
# an explicit "not this one", so it wins over toggle, which in turn is more
# specific than add. Ranking them (rather than declaring the combination
# invalid) means a stray Shift never silently turns an Alt+click into an add.
# The tree's mapping: identical to the canvas except that Shift spans a range
# of rows instead of adding one. Everything else — Cmd/Ctrl toggles, Alt/Opt
# subtracts, plain replaces — is literally the same call, which is the point:
# one vocabulary, one funnel, two surfaces.
func treeSelectMode() ret SelectMode {
  let mode: SelectMode = pointerSelectMode()
  if mode is SelectMode.add {
    ret SelectMode.range
  }
  ret mode
}

func pointerSelectMode() ret SelectMode {
  if Sdl3.isKeyDown(key: Keys.keyLAlt) or Sdl3.isKeyDown(key: Keys.keyRAlt) {
    ret SelectMode.subtract
  }
  let meta: Bool = Sdl3.isKeyDown(key: Keys.keyLGui) or Sdl3.isKeyDown(key: Keys.keyRGui)
  let control: Bool = Sdl3.isKeyDown(key: Keys.keyLCtrl) or Sdl3.isKeyDown(key: Keys.keyRCtrl)
  if meta or control {
    ret SelectMode.toggle
  }
  if Sdl3.isKeyDown(key: Keys.keyLShift) or Sdl3.isKeyDown(key: Keys.keyRShift) {
    ret SelectMode.add
  }
  ret SelectMode.replace
}

func isSelected(inspectorSystem: view InspectorSystem, entity: view EntityId) ret Bool {
  loop var i: Int = 0, i < inspectorSystem.selection.length, ++i {
    if let member: EntityId = inspectorSystem.selection.copyAt(index: i) {
      if member is entity {
        ret true
      }
    }
  }
  ret false
}

# The ONE way the selection set changes. Returns whether it actually changed,
# so the caller only resyncs the panels when there is something new to show.
#
# A modified click on empty space does NOTHING: only a plain click clears. A
# user holding Shift to extend a selection and missing the node is asking to
# add nothing, not to throw the selection away — and losing a carefully built
# set to a near-miss is exactly the kind of thing that makes an editor feel
# hostile.
# The row index of `entity` in the tree's visible order, or -1.
func treeRowOf(inspectorSystem: view InspectorSystem, entity: view EntityId) ret Int {
  loop var i: Int = 0, i < inspectorSystem.treeEntities.length, ++i {
    if let row: EntityId = inspectorSystem.treeEntities.copyAt(index: i) {
      if row is entity {
        ret i
      }
    }
  }
  ret -1
}

# Select the contiguous run of visible rows between the range anchor and
# `entity`. The set is REPLACED by the run rather than unioned with it, which
# is what lets a second Shift+click shrink a range that overshot — the
# behaviour every file browser has and the reason the anchor must not move.
#
# Falls back to a plain replace when either end is not on screen (the anchor's
# row can be collapsed away, or the tree may not have been built yet), since
# a range with no origin is just a click.
func applyRange(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entity: view EntityId
) ret Bool {
  let toRow: Int = treeRowOf(inspectorSystem: inspectorSystem, entity: entity)
  var fromRow: Int = treeRowOf(
    inspectorSystem: inspectorSystem
    entity: inspectorSystem.rangeAnchor
  )
  if toRow < 0 {
    # The clicked node is not a visible row at all — the tree panel is closed,
    # or it has not been built yet. A range over rows that are not on screen
    # is meaningless, so degrade to a plain click rather than doing nothing:
    # Shift+arrow must still move the active node with the tree hidden.
    selectNode(inspectorSystem: inspectorSystem, world: world, entity: entity)
    ret true
  }
  if fromRow < 0 {
    fromRow = toRow
  }
  var first: Int = fromRow
  var last: Int = toRow
  if first > last {
    first = toRow
    last = fromRow
  }
  let anchor: EntityId = inspectorSystem.rangeAnchor
  inspectorSystem.selection.clear()
  loop var i: Int = first, i <= last, ++i {
    if let row: EntityId = inspectorSystem.treeEntities.copyAt(index: i) {
      inspectorSystem.selection.add(value: row)
    }
  }
  inspectorSystem.selected = entity
  # The anchor deliberately survives the range: `selectNode` / `selectAddNode`
  # would have moved it, which is why a range does not go through them.
  inspectorSystem.rangeAnchor = anchor
  log(
    "[ui-editor] selection ({inspectorSystem.selection.length}): {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  )
  ret true
}

func applySelect(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  entity: view EntityId
  mode: view SelectMode
) ret Bool {
  if mode is SelectMode.range {
    if isNone(this: entity) {
      ret false
    }
    ret applyRange(inspectorSystem: inspectorSystem, world: world, entity: entity)
  }
  # Every non-range gesture re-origins the range: after a plain, toggling or
  # subtracting click, the next Shift+click spans from THAT row.
  if isNone(this: entity) is false {
    inspectorSystem.rangeAnchor = entity
  }
  if mode is SelectMode.replace {
    if isNone(this: entity) {
      if inspectorSystem.selection.length is 0 {
        ret false
      }
      selectNode(inspectorSystem: inspectorSystem, world: world, entity: noEntity())
      inspectorSystem.rangeAnchor = noEntity()
      log("[ui-editor] deselected")
      ret true
    }
    if inspectorSystem.selection.length is 1 and inspectorSystem.selected is entity {
      ret false
    }
    selectNode(inspectorSystem: inspectorSystem, world: world, entity: entity)
    ret true
  }
  if isNone(this: entity) {
    ret false
  }
  let already: Bool = isSelected(inspectorSystem: inspectorSystem, entity: entity)
  if mode is SelectMode.add and already {
    ret false
  }
  if mode is SelectMode.subtract and already is false {
    ret false
  }
  # Every surviving case is a flip: `add` reached here only when the node was
  # out, `subtract` only when it was in, and `toggle` means flip by
  # definition. So the three modes differ purely in the guards above, and
  # `selectAddNode` — which toggles — is the single mutation.
  selectAddNode(inspectorSystem: inspectorSystem, world: world, entity: entity)
  log(
    "[ui-editor] selection ({inspectorSystem.selection.length}): {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  )
  ret true
}

# The selected node ids, in selection order — the headless gate's assertion
# surface, and what a future "Selection (n)" label in the panel will read.
func selectionNodeIds(inspectorSystem: view InspectorSystem, world: view UiWorld) ret String {
  if inspectorSystem.selection.length is 0 {
    ret "none"
  }
  var line: String = ""
  loop var i: Int = 0, i < inspectorSystem.selection.length, ++i {
    if let member: EntityId = inspectorSystem.selection.copyAt(index: i) {
      let name: String = nodeIdOf(world: world, entity: member)
      if line.length() is 0 {
        line = "{name}"
      } else {
        line = "{line},{name}"
      }
    }
  }
  ret line
}

# A click at a point of the CANVAS, with the modifiers that were held. The
# live pointer and the headless click hook both come through here, so the
# gate exercises the real gesture rather than a shortcut around it.
func canvasSelectAt(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  sceneRoot: view EntityId
  x: view Float
  y: view Float
  mode: view SelectMode
) ret Bool {
  let hit: EntityId = deepestNodeAt(
    world: world
    uiSystems: uiSystems
    entity: sceneRoot
    x: x
    y: y
  )
  ret applySelect(
    inspectorSystem: inspectorSystem
    world: world
    entity: hit
    mode: mode
  )
}

# Per frame: hover from the pointer, click / arrows / Esc on the selection,
# tree-row actions, then the outlines and panels. Returns whether anything
# the frame shows changed.
func inspectorUpdate(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  input: view UiInput
  pageRoot: view EntityId
  chromeVisible: view Bool
) ret Bool {
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  var changed: Bool = false
  # Only the edit area reaches the document: a pointer over a chrome panel
  # (which may cover part of the document) hovers and selects nothing.
  # Whether the pointer is over the CANVAS this frame. It gates both halves of
  # the click: a press on a chrome panel must not hover a document node, and
  # — the reason this is now a named local — must not read as a click on
  # empty canvas either, or every press on the `I` toggle would silently
  # throw the selection away.
  let onCanvas: Bool = chromeVisible is false or pointInEditArea(
    chromeSystem: chromeSystem
    world: world
    uiSystems: uiSystems
    x: input.pointer.x
    y: input.pointer.y
  )
  var hovered: EntityId = noEntity()
  if onCanvas {
    hovered = deepestNodeAt(
      world: world
      uiSystems: uiSystems
      entity: sceneRoot
      x: input.pointer.x
      y: input.pointer.y
    )
  }
  if hovered is not inspectorSystem.hovered {
    inspectorSystem.hovered = hovered
    changed = true
  }
  # The canvas click goes straight through the selection funnel with whatever
  # modifiers are held — including the empty-space case, which is the whole
  # point: a plain click that hits nothing clears the set.
  if input.pointer.pressed and onCanvas {
    if canvasSelectAt(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      x: input.pointer.x
      y: input.pointer.y
      mode: pointerSelectMode()
    ) {
      changed = true
    }
  }
  # A tree row click carries `inspect:<entity index>` — an ENTITY index, not a
  # row index, so the live tree can rebuild under the user (it refreshes
  # constantly) without a click landing on whatever slid into that row.
  #
  # It runs BEFORE the keyboard block reads the active node, and goes straight
  # through the funnel rather than via the `selection` local below: a
  # Cmd+click that removes the ACTIVE row does not move the active node, and
  # the local's `is not selected` guard would have swallowed it.
  let actionCount: Int = uiActionCount(world: world)
  loop var a: Int = 0, a < actionCount, ++a {
    let actionId: String = uiActionAt(world: world, index: a)
    if actionId.startsWith(prefix: "inspect:") {
      let index: Int = actionId.sub(start: 8, len: actionId.length() - 8).toInt()
      loop var t: Int = 0, t < inspectorSystem.treeEntities.length, ++t {
        let candidate: EntityId = inspectorSystem.treeEntities.copyAtFallback(
          index: t
          fallback: noEntity()
        )
        if candidate.index is index {
          if applySelect(
            inspectorSystem: inspectorSystem
            world: world
            entity: candidate
            mode: treeSelectMode()
          ) {
            changed = true
          }
        }
      }
    }
  }
  # The arrows walk the active node; Shift+arrow spans a range to wherever it
  # lands, so extending with the keyboard and extending with the mouse are the
  # same operation over the same anchor.
  var selection: EntityId = inspectorSystem.selected
  var keyboardMode: SelectMode = SelectMode.replace
  if Sdl3.isKeyDown(key: Keys.keyLShift) or Sdl3.isKeyDown(key: Keys.keyRShift) {
    keyboardMode = SelectMode.range
  }
  if Sdl3.isKeyPressed(key: Keys.keyEscape) {
    selection = noEntity()
    keyboardMode = SelectMode.replace
  }
  if isNone(this: selection) is false {
    if Sdl3.isKeyPressed(key: Keys.keyUp) {
      selection = siblingOf(
        world: world
        uiSystems: uiSystems
        entity: selection
        step: -1
      )
    }
    if Sdl3.isKeyPressed(key: Keys.keyDown) {
      selection = siblingOf(
        world: world
        uiSystems: uiSystems
        entity: selection
        step: 1
      )
    }
    if Sdl3.isKeyPressed(key: Keys.keyLeft) {
      let parent: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: selection)
      if isNone(this: parent) is false and selection is not sceneRoot {
        selection = parent
      }
    }
    if Sdl3.isKeyPressed(key: Keys.keyRight) {
      selection = firstChildOf(world: world, entity: selection)
    }
  }
  if Sdl3.isKeyPressed(key: Keys.keyT) {
    toggleEditorPanel(chromeSystem: chromeSystem, world: world, kind: EditorPanelKind.tree)
    changed = true
  }
  if selection is not inspectorSystem.selected {
    if applySelect(
      inspectorSystem: inspectorSystem
      world: world
      entity: selection
      mode: keyboardMode
    ) {
      changed = true
    }
  }
  if changed {
    syncInspectorPanel(
      world: world
      uiSystems: uiSystems
      chromeSystem: chromeSystem
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
    )
    syncTreePanel(
      chromeSystem: chromeSystem
      world: world
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
    )
  }
  # Outlines follow the layout of this frame; placed every frame, cheap.
  if placeOutlines(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    role: OutlineRole.hover
    target: inspectorSystem.hovered
    visible: chromeVisible and inspectorSystem.hovered is not inspectorSystem.selected
  ) {
    changed = true
  }
  if placeOutlines(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    role: OutlineRole.selection
    target: inspectorSystem.selected
    visible: chromeVisible
  ) {
    changed = true
  }
  ret changed
}

# After a (re)load the entities are new: drop the selection, or re-find it by
# node id, and rebuild the panels.
func inspectorAfterLoad(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  selectNodeId: view String
  setRect: view String
) {
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  inspectorSystem.hovered = noEntity()
  var target: EntityId = noEntity()
  if selectNodeId.length() > 0 {
    target = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: selectNodeId)
  }
  inspectorSystem.selected = noEntity()
  inspectorSystem.selection.clear()
  # `a,b,c` selects several nodes: the headless hook has to be able to produce
  # a real n>1 selection, or the composite half of every widget goes untested.
  if selectNodeId.indexOf(sub: ",") >= 0 {
    let ids: List(String) = selectNodeId.split(sep: ",")
    loop let id: view String in ids {
      let trimmed: String = id.trim()
      if trimmed.length() is 0 {
        continue
      }
      let found: EntityId = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: trimmed)
      if isNone(this: found) is false {
        selectAddNode(inspectorSystem: inspectorSystem, world: world, entity: found)
      } else {
        log("[ui-editor] select: no node named {trimmed}")
      }
    }
  } else {
    if isNone(this: target) is false {
      selectNode(inspectorSystem: inspectorSystem, world: world, entity: target)
    } else {
      if selectNodeId.length() > 0 {
        log("[ui-editor] select: no node named {selectNodeId}")
      }
    }
  }
  # The widget's model, as a line the headless gate can assert without pixels:
  # the composite value per field and what drives it, for however many nodes
  # the hook selected.
  if selectNodeId.length() > 0 {
    let rectLine: String = rectWidgetLine(
      world: world
      uiSystems: uiSystems
      selection: inspectorSystem.selection
    )
    log("[ui-editor] rect ({inspectorSystem.selection.length}): {rectLine}")
  }
  # `<field>=<value>` drives the widget's WRITE half from the same hook: one
  # edit goes to every selected entity, which is the part a single-selection
  # inspector would have let us skip.
  if setRect.length() > 0 {
    let written: Int = applyRectEdit(
      world: world
      uiSystems: uiSystems
      selection: inspectorSystem.selection
      edit: setRect
    )
    let afterLine: String = rectWidgetLine(
      world: world
      uiSystems: uiSystems
      selection: inspectorSystem.selection
    )
    log("[ui-editor] rect set {setRect} -> {written}: {afterLine}")
  }
  syncInspectorPanel(
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
  )
  syncTreePanel(
    chromeSystem: chromeSystem
    world: world
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
  )
}
