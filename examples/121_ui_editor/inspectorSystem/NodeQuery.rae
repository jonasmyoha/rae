# inspectorSystem/NodeQuery — read-only questions about a document node.
#
# Hit testing, node ids, and walking the hierarchy: everything the inspector
# asks ABOUT the document, as opposed to what it does to the selection or
# draws in the panels. None of it touches `InspectorSystem`, which is exactly
# why it can live here — the selection code in InspectorSystem.rae opens this
# module, and nothing here needs to open that one back.
import String
open ui/Ecs
open ui/Components
open ui/SceneLoader
open ui/SceneBundles
open ui/BindingComponents
open ui/inputSystem/InputSystem
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems

# The document scene's root: mountPage mounts the scene's root node ONTO the
# page-root entity, so the two are the same entity.
func documentSceneRoot(world: view UiWorld, pageRoot: view EntityId) ret EntityId {
  ret pageRoot
}

# Deepest active node under (x, y) in `entity`'s subtree, or none.
func deepestNodeAt(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  x: view Float
  y: view Float
) ret EntityId {
  if uiEntityActive(world: world, entity: entity) is false {
    ret noEntity()
  }
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = children.ids.length - 1, i >= 0, --i {
      let hit: EntityId = deepestNodeAt(
        world: world
        uiSystems: uiSystems
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        x: x
        y: y
      )
      if isNone(this: hit) is false {
        ret hit
      }
    }
  }
  if uiPointInEntity(
    world: world
    uiSystems: uiSystems
    entity: entity
    x: x
    y: y
  ) {
    ret entity
  }
  ret noEntity()
}

func nodeIdOf(world: view UiWorld, entity: view EntityId) ret String {
  if isNone(this: entity) {
    ret ""
  }
  if componentHas(this: world.nodeIdComponents, entity: entity) {
    ret "{componentGet(this: world.nodeIdComponents, entity: entity).id}"
  }
  ret "entity {entity.index}"
}

# First node in `entity`'s subtree whose NodeId is `nodeId`.
func findNodeByIdIn(world: view UiWorld, entity: view EntityId, nodeId: view String) ret EntityId {
  if isNone(this: entity) {
    ret noEntity()
  }
  if componentHas(this: world.nodeIdComponents, entity: entity) {
    if componentGet(this: world.nodeIdComponents, entity: entity).id is nodeId {
      ret entity
    }
  }
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = 0, i < children.ids.length, ++i {
      let found: EntityId = findNodeByIdIn(
        world: world
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        nodeId: nodeId
      )
      if isNone(this: found) is false {
        ret found
      }
    }
  }
  ret noEntity()
}

func parentOf(world: view UiWorld, uiSystems: view UiSystems, entity: view EntityId) ret EntityId {
  if isNone(this: entity) or componentHas(this: uiSystems.hierarchy.parents, entity: entity) is false {
    ret noEntity()
  }
  ret componentGet(this: uiSystems.hierarchy.parents, entity: entity).parent
}

# The sibling `step` places away in the parent's Children (clamped).
func siblingOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  step: view Int
) ret EntityId {
  let parent: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: entity)
  if isNone(this: parent) or componentHas(this: world.childrens, entity: parent) is false {
    ret entity
  }
  let children: view Children => componentView(this: world.childrens, entity: parent)
  loop var i: Int = 0, i < children.ids.length, ++i {
    if children.ids.copyAtFallback(index: i, fallback: noEntity()) is entity {
      var next: Int = i + step
      if next < 0 {
        next = 0
      }
      if next > children.ids.length - 1 {
        next = children.ids.length - 1
      }
      ret children.ids.copyAtFallback(index: next, fallback: entity)
    }
  }
  ret entity
}

func firstChildOf(world: view UiWorld, entity: view EntityId) ret EntityId {
  if isNone(this: entity) or componentHas(this: world.childrens, entity: entity) is false {
    ret entity
  }
  let children: view Children => componentView(this: world.childrens, entity: entity)
  if children.ids.length is 0 {
    ret entity
  }
  ret children.ids.copyAtFallback(index: 0, fallback: entity)
}

# The parent chain as `a > b > c`, stopping at the document scene root.
func parentChainOf(
  world: view UiWorld
  uiSystems: view UiSystems
  entity: view EntityId
  sceneRoot: view EntityId
) ret String {
  var chain: String = ""
  var current: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: entity)
  var guard: Int = 0
  loop isNone(this: current) is false and guard < 32 {
    if chain.length() > 0 {
      chain = "{nodeIdOf(world: world, entity: current)} > {chain}"
    } else {
      chain = nodeIdOf(world: world, entity: current)
    }
    if current is sceneRoot {
      current = noEntity()
    } else {
      current = parentOf(world: world, uiSystems: uiSystems, entity: current)
    }
    guard = guard + 1
  }
  if chain.length() is 0 {
    ret "(root)"
  }
  ret chain
}

# Fill the inspector's status texts from the selection (TextBinding
# editor.inspector.* in chrome/Inspector.raescene).
# "not a lib component: Foo, Bar" — the selected node's pending (app-owned)
# components, read-only; "" when it has none.
# The app components this entity carries that `lib` does not know — comma
# joined, bare. The inspector tallies these across a selection exactly like
# the lib components, so this returns the NAMES and leaves the wording to the
# caller.
func pendingComponentNames(world: view UiWorld, entity: view EntityId) ret String {
  var names: String = ""
  loop let pending: view PendingComponent in world.pendingComponents {
    if pending.entity is entity {
      if names.length() > 0 {
        names = "{names}, {pending.name}"
      } else {
        names = "{pending.name}"
      }
    }
  }
  ret names
}

# The node's authored type, or "" when it has none.
func nodePrimaryType(world: view UiWorld, entity: view EntityId) ret String {
  if componentHas(this: world.primaryTypes, entity: entity) {
    let primary: view PrimaryType => componentView(this: world.primaryTypes, entity: entity)
    ret "{primary.typeName}"
  }
  ret ""
}

# `<PrimaryType> / <Name>`, dropping either half when it is absent. This is
# the node's own identity, so a selection that AGREES on it can still show it
# — and at n=1 it always agrees.
func nodeTypeLine(world: view UiWorld, entity: view EntityId) ret String {
  var primaryType: String = ""
  if componentHas(this: world.primaryTypes, entity: entity) {
    let primary: view PrimaryType => componentView(this: world.primaryTypes, entity: entity)
    primaryType = "{primary.typeName}"
  }
  var label: String = ""
  if componentHas(this: world.names, entity: entity) {
    let name: view Name => componentView(this: world.names, entity: entity)
    label = "{name.label}"
  }
  if primaryType.length() is 0 {
    ret label
  }
  if label.length() is 0 {
    ret primaryType
  }
  ret "{primaryType} / {label}"
}

# The node's bundle provenance (ui/SceneBundles BundleRefs): which bundles it
# was expanded from, which components it inherited whole (shown dimmed, in
# brackets) and which it authored a field over — "" for a node without
# bundles. The per-field diff waits for the save path.
func bundleProvenanceLine(world: view UiWorld, entity: view EntityId) ret String {
  if componentHas(this: world.bundleRefs, entity: entity) is false {
    ret ""
  }
  let refs: view BundleRefs => componentView(this: world.bundleRefs, entity: entity)
  if refs.names.length is 0 {
    ret ""
  }
  var line: String = "  bundles: {refs.names.join(sep: ", ")}"
  if refs.inherited.length > 0 {
    line = "{line}  [inherited: {refs.inherited.join(sep: ", ")}]"
  }
  if refs.overridden.length > 0 {
    line = "{line}  overrides: {refs.overridden.join(sep: ", ")}"
  }
  ret line
}

# Every node under the point, deepest FIRST: the deepest hit, then each of its
# ancestors whose own bounds also contain the point, up to and including the
# scene root. This is the stack a repeated click steps up (#73816378) — click
# a Play sprite and the stack is sprite -> Button -> row -> page.
#
# Ancestors that do NOT contain the point are skipped rather than ending the
# walk: a Hug container laid out to zero on one axis, or a child that overflows
# its parent, would otherwise cut the stack off below the nodes a user can
# plainly see under the cursor.
func hitStackAt(
  world: view UiWorld
  uiSystems: view UiSystems
  sceneRoot: view EntityId
  x: view Float
  y: view Float
  out: mod List(EntityId)
) {
  out.clear()
  let deepest: EntityId = deepestNodeAt(
    world: world
    uiSystems: uiSystems
    entity: sceneRoot
    x: x
    y: y
  )
  if isNone(this: deepest) {
    ret
  }
  out.add(value: deepest)
  var walk: EntityId = parentOf(world: world, uiSystems: uiSystems, entity: deepest)
  # Bounded by the tree's depth; the guard is against a malformed parent cycle,
  # not against normal nesting.
  loop var steps: Int = 0, steps < 64, ++steps {
    if isNone(this: walk) {
      ret
    }
    if uiPointInEntity(
      world: world
      uiSystems: uiSystems
      entity: walk
      x: x
      y: y
    ) {
      out.add(value: walk)
    }
    if walk is sceneRoot {
      ret
    }
    walk = parentOf(world: world, uiSystems: uiSystems, entity: walk)
  }
}

# The node ids of `entity`'s children, comma separated, with their entity
# indices — the hierarchy half of the identity block. Truncated at eight, so a
# container with fifty children does not push the whole panel off screen.
func childIdsOf(world: view UiWorld, entity: view EntityId) ret String {
  if isNone(this: entity) or componentHas(this: world.childrens, entity: entity) is false {
    ret ""
  }
  let children: view Children => componentView(this: world.childrens, entity: entity)
  var line: String = ""
  var shown: Int = 0
  loop var i: Int = 0, i < children.ids.length, ++i {
    if shown >= 8 {
      ret "{line}, +{children.ids.length - shown} more"
    }
    let child: EntityId = children.ids.copyAtFallback(index: i, fallback: noEntity())
    if isNone(this: child) {
      continue
    }
    let text: String = "{nodeIdOf(world: world, entity: child)} #{child.index}"
    if line.length() is 0 {
      line = "{text}"
    } else {
      line = "{line}, {text}"
    }
    shown = shown + 1
  }
  ret line
}

# `<nodeId> #<index>` for a node, or "" for none — how one entity is named in
# the identity block and beside a diagnostic.
func entityLabelOf(world: view UiWorld, entity: view EntityId) ret String {
  if isNone(this: entity) {
    ret ""
  }
  ret "{nodeIdOf(world: world, entity: entity)} #{entity.index}"
}

# `...` at `limit` characters. A tree row is one line in a narrow panel, so a
# long Text node's string has to be cut somewhere; cutting it here keeps the
# decision in one place rather than in every caller.
func truncated(text: view String, limit: view Int) ret String {
  let flat: String = text.replace(old: "\n", new: " ").trim()
  if flat.length() <= limit {
    ret flat
  }
  ret "{flat.sub(start: 0, len: limit)}..."
}

# What KIND of node this is, for the row's `Name - Kind`. The authored
# `PrimaryType` wins when there is one; otherwise the kind is derived from the
# components the node actually carries, most specific first — a node with a
# ListView is a List whatever else it has, and a bare container is a Node.
func nodeKindOf(world: view UiWorld, entity: view EntityId) ret String {
  let authored: String = nodePrimaryType(world: world, entity: entity)
  if authored.length() > 0 {
    ret authored
  }
  if componentHas(this: world.sceneInstances, entity: entity) {
    ret "Scene"
  }
  if componentHas(this: world.listViews, entity: entity) {
    ret "List"
  }
  if componentHas(this: world.texts, entity: entity) {
    ret "Text"
  }
  if componentHas(this: world.sprites, entity: entity) {
    ret "Sprite"
  }
  if componentHas(this: world.shapes, entity: entity) {
    ret "Shape"
  }
  if componentHas(this: world.layouts, entity: entity) {
    ret "Layout"
  }
  ret "Node"
}

# The row's value PREVIEW: the thing that lets you find a node without
# selecting it. A Text node previews its string, a scene instance previews the
# file it came from — those are the two cases where a node's identity is in
# its data rather than its name. "" for everything else; a preview of nothing
# is just noise in a narrow panel.
func nodePreviewOf(world: view UiWorld, entity: view EntityId) ret String {
  if componentHas(this: world.sceneInstances, entity: entity) {
    let instance: view SceneInstance => componentView(this: world.sceneInstances, entity: entity)
    if instance.sceneId.length() > 0 {
      ret "{instance.sceneId}"
    }
  }
  if componentHas(this: world.texts, entity: entity) {
    let text: view Text => componentView(this: world.texts, entity: entity)
    # Short on purpose: the row already spends its width on `Name - Kind`,
    # and the panel is ~345px. A longer preview is clipped by the panel edge
    # mid-word, which reads as broken rather than truncated.
    let preview: String = truncated(text: text.text, limit: 8)
    if preview.length() > 0 {
      ret "\"{preview}\""
    }
  }
  ret ""
}

# The whole row label: `Name - Kind` plus the preview, plus a `+` when the node
# carries bundle provenance (it came from a template rather than being written
# here). Assembled in one place so the tree and any future list agree.
func treeRowLabelOf(world: view UiWorld, entity: view EntityId) ret String {
  var line: String = "{nodeIdOf(world: world, entity: entity)} - {nodeKindOf(
    world: world
    entity: entity
  )}"
  let preview: String = nodePreviewOf(world: world, entity: entity)
  if preview.length() > 0 {
    line = "{line}  {preview}"
  }
  if componentHas(this: world.bundleRefs, entity: entity) {
    let refs: view BundleRefs => componentView(this: world.bundleRefs, entity: entity)
    if refs.names.length > 0 {
      line = "{line}  +{refs.names.join(sep: "+")}"
    }
  }
  ret line
}

# Does this node, or anything under it, match `filter`? A tree filter that hid
# non-matching ANCESTORS would cut matches out of the tree entirely, so a
# parent survives when a descendant matches — the row stays as context.
func treeRowMatches(world: view UiWorld, entity: view EntityId, filter: view String) ret Bool {
  if filter.length() is 0 {
    ret true
  }
  if treeRowLabelOf(world: world, entity: entity).toLower().indexOf(sub: filter.toLower()) >= 0 {
    ret true
  }
  if componentHas(this: world.childrens, entity: entity) is false {
    ret false
  }
  let children: view Children => componentView(this: world.childrens, entity: entity)
  loop var i: Int = 0, i < children.ids.length, ++i {
    let child: EntityId = children.ids.copyAtFallback(index: i, fallback: noEntity())
    if isNone(this: child) is false and treeRowMatches(world: world, entity: child, filter: filter) {
      ret true
    }
  }
  ret false
}
