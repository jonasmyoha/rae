# inspectorSystem/Panels — what the inspector and the hierarchy SHOW.
#
# The rendering half of the inspector: the property panel's lines and the
# hierarchy list's rows. Split from InspectorSystem.rae, which owns the state
# and the selection funnel, purely to keep both under the 1,000-line cap —
# these read `InspectorSystem` but never change it, which is why the panels
# can move out and the state cannot.
import String
open Sys
open ui/Ecs
open ui/Components
open ui/SceneLoader
open ui/BindingComponents
open ui/SceneBundles
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems
open app3d/UiShell
open inspectorSystem/NodeQuery
open inspectorSystem/RectWidget
open ui/Scene
open inspectorSystem/ComponentWidget
open inspectorSystem/RectEdit
open inspectorSystem/ComponentEdit

# The inspector renders the COMPOSITE of the whole selection. There is no
# single-selection path: n=1 is this code with one member, which is why a
# single selection cannot drift from what multi-selection shows.
#
# The header names the selection, the component lines are the UNION with a
# `(have/total)` suffix on anything only some of them carry, and each value
# line shows the common value or a mixed marker. Per-entity meta (the node's
# own type, its parent chain) appears when the selection agrees on it —
# which at n=1 it always does, so a single selection naturally reads as the
# richer editor without a branch that says so.
func syncInspectorPanel(
  world: view UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  inspectorSystem: view InspectorSystem
  sceneRoot: view EntityId
  # The parsed document, for what the AUTHOR wrote (#21438052).
  scene: view Scene
) {
  let members: Int = inspectorSystem.selection.length
  if members is 0 {
    chromeSystem.inspectorNodeId = "nothing selected"
    chromeSystem.inspectorType = "click a node, or use the arrows"
    chromeSystem.inspectorComponents = ""
    chromeSystem.inspectorAppComponents = ""
    chromeSystem.inspectorParents = ""
    chromeSystem.inspectorWidgets = ""
    setWidgetRows(world: world, chromeSystem: chromeSystem, rows: List.create(ListViewRow, cap: 1))
    ret
  }
  if members is 1 {
    chromeSystem.inspectorNodeId = nodeIdOf(world: world, entity: inspectorSystem.selected)
  } else {
    chromeSystem.inspectorNodeId = "Selection ({members}): {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  }
  var componentTallies: List(ComponentTally) = List.create(ComponentTally, cap: 16)
  var appTallies: List(ComponentTally) = List.create(ComponentTally, cap: 8)
  var typeLine: String = ""
  var parentLine: String = ""
  var typeAgrees: Bool = true
  var parentAgrees: Bool = true
  var seen: Bool = false
  loop let entity: view EntityId in inspectorSystem.selection {
    if isNone(this: entity) {
      continue
    }
    tallyComponentNames(
      tallies: componentTallies
      names: componentNamesFor(world: world, entity: entity)
    )
    tallyComponentNames(
      tallies: appTallies
      names: pendingComponentNames(world: world, entity: entity)
    )
    # At n=1 the identity line is `Type / Name`; above that it folds the TYPE
    # only. A name is per-entity meta — two Text nodes are always named
    # differently — so folding it would report every multi-selection as mixed
    # and hide the one thing they genuinely share.
    var entityType: String = nodePrimaryType(world: world, entity: entity)
    if members is 1 {
      entityType = nodeTypeLine(world: world, entity: entity)
    }
    let entityParents: String = parentChainOf(
      world: world
      uiSystems: uiSystems
      entity: entity
      sceneRoot: sceneRoot
    )
    if seen is false {
      seen = true
      # Interpolated, not assigned: `entityType` is an owned String that drops
      # at the end of this iteration, so a plain assignment would leave
      # `typeLine` pointing at a freed buffer — which showed up as NUL bytes
      # in the panel.
      typeLine = "{entityType}"
      parentLine = "{entityParents}"
      continue
    }
    if entityType is not typeLine {
      typeAgrees = false
    }
    if entityParents is not parentLine {
      parentAgrees = false
    }
  }
  if typeAgrees is false {
    typeLine = "{mixedMarker}"
  }
  if parentAgrees is false {
    parentLine = "{mixedMarker}"
  }
  chromeSystem.inspectorType = typeLine
  chromeSystem.inspectorParents = parentLine
  var components: String = compositeLine(tallies: componentTallies, members: members)
  if members is 1 {
    components = "{components}{bundleProvenanceLine(world: world, entity: inspectorSystem.selected)}"
  }
  chromeSystem.inspectorComponents = components
  let appComponents: String = compositeLine(tallies: appTallies, members: members)
  if appComponents.length() is 0 {
    chromeSystem.inspectorAppComponents = ""
  } else {
    chromeSystem.inspectorAppComponents = "not a lib component: {appComponents}"
  }
  # Every other component gets its GENERATED widget (#24323144): a header row
  # per component in the union — carrying the partial count — then one row
  # per reflected field, folded over the selection. Rect is bespoke and
  # contributes no rows here; its line is the one above.
  var widgetRows: List(ListViewRow) = List.create(ListViewRow, cap: 64)
  # The IDENTITY block (#23728694): who this node is, and where it sits. Shown
  # at n=1 only — an entity id, a name and a parent are per-entity facts, and
  # the header already names a multi-selection. This is what turns the panel
  # from a property sheet into an ECS debugger: the ids here are the ones
  # diagnostics print, so they can be matched up by eye.
  if members is 1 {
    let anchor: EntityId = inspectorSystem.selected
    addWidgetRow(
      rows: widgetRows
      id: "identity"
      name: "identity"
      value: ""
      indent: 0
      action: ""
    )
    addWidgetRow(
      rows: widgetRows
      id: "identity.entity"
      name: "entity"
      value: "#{anchor.index} gen {anchor.generation}"
      indent: 1
      action: ""
    )
    addWidgetRow(
      rows: widgetRows
      id: "identity.node"
      name: "node"
      value: nodeIdOf(world: world, entity: anchor)
      indent: 1
      action: ""
    )
    var identityName: String = ""
    if componentHas(this: world.names, entity: anchor) {
      identityName = "{componentView(this: world.names, entity: anchor).label}"
    }
    addWidgetRow(
      rows: widgetRows
      id: "identity.name"
      name: "name"
      value: identityName
      indent: 1
      action: ""
    )
    var identityType: String = nodePrimaryType(world: world, entity: anchor)
    if identityType.length() is 0 {
      identityType = "(none)"
    }
    addWidgetRow(
      rows: widgetRows
      id: "identity.type"
      name: "type"
      value: identityType
      indent: 1
      action: ""
    )
    var parentLabel: String = entityLabelOf(
      world: world
      entity: parentOf(world: world, uiSystems: uiSystems, entity: anchor)
    )
    if parentLabel.length() is 0 {
      parentLabel = "(none)"
    }
    addWidgetRow(
      rows: widgetRows
      id: "identity.parent"
      name: "parent"
      value: parentLabel
      indent: 1
      action: ""
    )
    var childLabels: String = childIdsOf(world: world, entity: anchor)
    if childLabels.length() is 0 {
      childLabels = "(none)"
    }
    addWidgetRow(
      rows: widgetRows
      id: "identity.children"
      name: "children"
      value: childLabels
      indent: 1
      action: ""
    )
  }
  # Select parent, over the WHOLE selection — the operation the click-through
  # gesture cannot express, since that walks one node up the stack under the
  # cursor rather than the set up the tree.
  addWidgetRow(
    rows: widgetRows
    id: "selectParent"
    name: "select parent"
    value: "U"
    indent: 0
    action: "selectParent"
  )
  # The filter box (#57156455). No text-input widget exists yet, so `/`
  # focuses it and letters type into it; the row shows the state either way so
  # there is something to aim at.
  var filterRow: String = "filter: {inspectorSystem.componentFilter}"
  if inspectorSystem.filterFocused {
    filterRow = "filter: {inspectorSystem.componentFilter}_  (esc to clear)"
  } else {
    if inspectorSystem.componentFilter.length() is 0 {
      filterRow = "filter: / to search components"
    }
  }
  addWidgetRow(
    rows: widgetRows
    id: "filter"
    name: filterRow
    value: ""
    indent: 0
    action: ""
  )
  loop let tally: view ComponentTally in componentTallies {
    if matchesComponentFilter(name: tally.name, filter: inspectorSystem.componentFilter) is false {
      continue
    }
    # Rect is the bespoke widget: four real input rows and the W/H lock
    # (#44133406) instead of generated field rows.
    if widgetOverride(name: tally.name).bespoke {
      var rectHeader: String = "{tally.name}"
      if tally.count < members {
        rectHeader = "{tally.name} ({tally.count}/{members})"
      }
      appendRectRows(
        rows: widgetRows
        world: world
        uiSystems: uiSystems
        inspectorSystem: inspectorSystem
        header: rectHeader
      )
      continue
    }
    # Render the fields first: a component whose every field is hidden
    # (Children is only a List(EntityId)) gets no header either, rather than
    # a heading over nothing.
    var fieldRows: List(ListViewRow) = List.create(ListViewRow, cap: 16)
    componentWidgetRows(
      world: world
      selection: inspectorSystem.selection
      name: tally.name
      scene: scene
      rows: fieldRows
    )
    if fieldRows.length is 0 {
      continue
    }
    var header: String = "{tally.name}"
    if tally.count < members {
      header = "{tally.name} ({tally.count}/{members})"
    }
    addWidgetRow(
      rows: widgetRows
      id: "{tally.name}"
      name: header
      value: "remove"
      indent: 0
      action: "compRemove:{tally.name}"
    )
    loop let row: view ListViewRow in fieldRows {
      addWidgetRow(
        rows: widgetRows
        id: row.values.copyAtDefault(index: 0)
        name: row.values.copyAtDefault(index: 1)
        value: row.values.copyAtDefault(index: 2)
        indent: 1
        action: ""
      )
    }
  }
  # The ADD list: every component the world knows that the selection does not
  # already carry in full, narrowed by the same filter. Unfiltered this is
  # ~79 rows, which is exactly why the filter earns its place.
  var addable: List(String) = List.create(String, cap: 96)
  allComponentNames(world: world, out: addable)
  var offered: Int = 0
  loop let candidate: view String in addable {
    if matchesComponentFilter(name: candidate, filter: inspectorSystem.componentFilter) is false {
      continue
    }
    if selectionHasAll(world: world, selection: inspectorSystem.selection, name: candidate) {
      continue
    }
    if offered is 0 {
      addWidgetRow(
        rows: widgetRows
        id: "add"
        name: "add component"
        value: ""
        indent: 0
        action: ""
      )
    }
    offered = offered + 1
    addWidgetRow(
      rows: widgetRows
      id: "add.{candidate}"
      name: "{candidate}"
      value: "add"
      indent: 1
      action: "compAdd:{candidate}"
    )
  }
  chromeSystem.inspectorWidgets = widgetRowsSummary(rows: widgetRows)
  setWidgetRows(world: world, chromeSystem: chromeSystem, rows: own widgetRows)
}

# Hand the generated rows to the `components` ListView, and switch the list
# OFF when there are none: a virtual ListView that hugs its height measures
# at least ONE row even when empty, and that phantom row would push the
# parent-chain line down in the nothing-selected panel for no reason.
func setWidgetRows(
  world: mod UiWorld
  chromeSystem: view ChromeSystem
  rows: own List(ListViewRow)
) {
  let list: EntityId = editorListEntity(
    chromeSystem: chromeSystem
    world: world
    source: EditorListSource.components
  )
  if isNone(this: list) {
    ret
  }
  let active: Active = { value: rows.length > 0 }
  componentSet(this: world.actives, entity: list, data: active)
  setEditorListRows(world: world, list: list, rows: own rows)
}

# Is `nodeId` collapsed?
func treeCollapsed(collapsed: view List(String), nodeId: view String) ret Bool {
  loop let name: view String in collapsed {
    if name is nodeId {
      ret true
    }
  }
  ret false
}

# Does the subtree under `entity` (excluding it) contain a selected node? Used
# to mark a COLLAPSED row that is hiding part of the selection — collapsing
# keeps descendants selected (dropping them would silently shrink a set the
# user built), so the row has to say that something is in there.
func subtreeHasSelection(
  world: view UiWorld
  entity: view EntityId
  selection: view List(EntityId)
) ret Bool {
  if componentHas(this: world.childrens, entity: entity) is false {
    ret false
  }
  let children: view Children => componentView(this: world.childrens, entity: entity)
  loop var i: Int = 0, i < children.ids.length, ++i {
    let child: EntityId = children.ids.copyAtFallback(index: i, fallback: noEntity())
    if isNone(this: child) {
      continue
    }
    loop var k: Int = 0, k < selection.length, ++k {
      if let member: EntityId = selection.copyAt(index: k) {
        if member is child {
          ret true
        }
      }
    }
    if subtreeHasSelection(world: world, entity: child, selection: selection) {
      ret true
    }
  }
  ret false
}

# The selection PLATE for a row: the palette token `Shape.fillSlot` resolves,
# or "" for a row that is not selected (an empty slot falls back to the row's
# own literal fill, which is transparent — so an unselected tree renders
# exactly as it did before the plate existed).
#
# TWO tokens, not one. With many rows selected a single flat colour cannot say
# which row the inspector is describing or which one the arrow keys walk from
# — the question a one-row selection never has to answer. Both come from the
# palette, so a theme change carries them.
func treeRowFillSlot(
  selection: view List(EntityId)
  entity: view EntityId
  selected: view EntityId
) ret String {
  if entity is selected {
    ret "editorRowActive"
  }
  loop var i: Int = 0, i < selection.length, ++i {
    if let member: EntityId = selection.copyAt(index: i) {
      if member is entity {
        ret "editorRowSelected"
      }
    }
  }
  ret ""
}

# The row marker is now ONLY `*`: a COLLAPSED row hiding a selected
# descendant. The `>` / `-` glyphs are gone because the plate says the same
# thing in colour — but `*` cannot go with them, since such a row is not
# itself selected and so has no plate to speak for it. The column stays even
# when empty, so the label keeps its indent.
func treeRowMarker(
  world: view UiWorld
  selection: view List(EntityId)
  entity: view EntityId
  selected: view EntityId
  hidden: view Bool
) ret String {
  if hidden and subtreeHasSelection(world: world, entity: entity, selection: selection) {
    ret "*"
  }
  ret ""
}

func collectTreeRows(
  world: view UiWorld
  entity: view EntityId
  depth: view Int
  selected: view EntityId
  selection: view List(EntityId)
  collapsed: view List(String)
  filter: view String
  entities: mod List(EntityId)
  rows: mod List(ListViewRow)
) {
  if isNone(this: entity) or rows.length >= 256 {
    ret
  }
  # Filtered out, and nothing beneath matches either: the whole branch goes.
  if treeRowMatches(world: world, entity: entity, filter: filter) is false {
    ret
  }
  let nodeId: String = nodeIdOf(world: world, entity: entity)
  var hasChildren: Bool = false
  if componentHas(this: world.childrens, entity: entity) {
    hasChildren = componentView(this: world.childrens, entity: entity).ids.length > 0
  }
  let isCollapsed: Bool = treeCollapsed(collapsed: collapsed, nodeId: nodeId)
  # A leaf has no chevron at all: a disclosure control that discloses nothing
  # is the classic way a tree lies about its shape.
  var chevron: String = ""
  var chevronAction: String = ""
  if hasChildren {
    chevron = "v"
    if isCollapsed {
      chevron = ">"
    }
    chevronAction = "treeToggle:{nodeId}"
  }
  var keys: List(String) = {
    "id"
    "label"
    "indent"
    "marker"
    "fillSlot"
    "action"
    "chevron"
    "chevronAction"
  }
  var values: List(String) = List.create(String, cap: 8)
  values.add(value: "{entity.index}")
  values.add(value: treeRowLabelOf(world: world, entity: entity))
  values.add(value: "{(depth.toFloat() * treeIndentPerLevel + 6.0).toInt()}")
  values.add(value: treeRowMarker(
    world: world
    selection: selection
    entity: entity
    selected: selected
    hidden: isCollapsed
  ))
  values.add(value: treeRowFillSlot(selection: selection, entity: entity, selected: selected))
  values.add(value: "inspect:{entity.index}")
  values.add(value: chevron)
  values.add(value: chevronAction)
  rows.add(value: ListViewRow { keys: own keys, values: own values })
  entities.add(value: entity)
  # A collapsed node contributes its own row and stops. `entities` therefore
  # holds exactly the VISIBLE rows, which is what makes a Shift-range span
  # what the user can see rather than the whole DFS (#72481430).
  if isCollapsed {
    ret
  }
  if componentHas(this: world.childrens, entity: entity) {
    let children: view Children => componentView(this: world.childrens, entity: entity)
    loop var i: Int = 0, i < children.ids.length, ++i {
      collectTreeRows(
        world: world
        entity: children.ids.copyAtFallback(index: i, fallback: noEntity())
        depth: depth + 1
        selected: selected
        selection: selection
        collapsed: collapsed
        filter: filter
        entities: entities
        rows: rows
      )
    }
  }
}

# Rebuild the hierarchy list's rows (DFS of the document, depth as indent,
# the selection marked) on the ListView tagged `EditorList { source:
# hierarchy }`.
func syncTreePanel(
  chromeSystem: mod ChromeSystem
  world: mod UiWorld
  inspectorSystem: mod InspectorSystem
  sceneRoot: view EntityId
) {
  let list: EntityId = editorListEntity(
    chromeSystem: chromeSystem
    world: world
    source: EditorListSource.hierarchy
  )
  if isNone(this: list) {
    ret
  }
  inspectorSystem.treeEntities.clear()
  var rows: List(ListViewRow) = List.create(ListViewRow, cap: 32)
  collectTreeRows(
    world: world
    entity: sceneRoot
    depth: 0
    selected: inspectorSystem.selected
    selection: inspectorSystem.selection
    collapsed: inspectorSystem.collapsedNodeIds
    filter: inspectorSystem.treeFilter
    entities: inspectorSystem.treeEntities
    rows: rows
  )
  # The header carries the node count and the filter, so the panel says how
  # much of the tree you are looking at without selecting anything.
  var header: String = "Hierarchy ({rows.length})"
  if inspectorSystem.treeFilterFocused {
    header = "Hierarchy ({rows.length})  filter: {inspectorSystem.treeFilter}_"
  } else {
    if inspectorSystem.treeFilter.length() > 0 {
      header = "Hierarchy ({rows.length})  filter: {inspectorSystem.treeFilter}"
    }
  }
  chromeSystem.treeHeader = header
  setEditorListRows(world: world, list: list, rows: own rows)
}

# One component of the composite: its name, and how many of the selected
# entities carry it. The count is what makes a PARTIAL component visible —
# a component on some of the selection but not all is a different thing from
# one they all share, and editing it will reach fewer nodes than you think.
type ComponentTally {
  name: String
  count: Int
}

func tallyIndexOf(tallies: view List(ComponentTally), name: view String) ret Int {
  loop var i: Int = 0, i < tallies.length, ++i {
    if let tally: view ComponentTally => tallies.viewAt(index: i) {
      if tally.name is name {
        ret i
      }
    }
  }
  ret -1
}

# Tally `names` (a comma-joined component list) into `tallies`, keeping first-
# seen order. `componentNamesFor` emits a FIXED order per entity, so first-seen
# across the selection is the same canonical order, not an accident of which
# node happened to be clicked first.
func tallyComponentNames(tallies: mod List(ComponentTally), names: view String) {
  let parts: List(String) = names.split(sep: ",")
  loop let part: view String in parts {
    let name: String = part.trim()
    if name.length() is 0 {
      continue
    }
    let at: Int = tallyIndexOf(tallies: tallies, name: name)
    if at < 0 {
      tallies.add(value: ComponentTally { name: stringCopy(string: name), count: 1 })
      continue
    }
    if let tally: mod ComponentTally => tallies.modAt(index: at) {
      tally.count = tally.count + 1
    }
  }
}

# Render a tally as the composite line: the UNION of the selection's
# components, each one carried by only SOME of them suffixed `(have/total)`.
# At n=1 every count equals the total, so the suffix never appears and the
# line is exactly what a single selection always showed — the n=1 case of the
# same code path, not a separate branch.
func compositeLine(tallies: view List(ComponentTally), members: view Int) ret String {
  var line: String = ""
  loop let tally: view ComponentTally in tallies {
    var part: String = "{tally.name}"
    if tally.count < members {
      part = "{tally.name} ({tally.count}/{members})"
    }
    if line.length() is 0 {
      line = "{part}"
    } else {
      line = "{line}, {part}"
    }
  }
  ret line
}

# The panel's lines as one string, for the headless gate. Read from
# `chromeSystem` AFTER a sync rather than recomputed, so what is asserted is
# literally what the panel shows — a second renderer here could agree with the
# test and still disagree with the screen.
func inspectorSummaryLine(chromeSystem: view ChromeSystem) ret String {
  var line: String = "{chromeSystem.inspectorNodeId} | {chromeSystem.inspectorType} | {chromeSystem.inspectorComponents}"
  if chromeSystem.inspectorAppComponents.length() > 0 {
    line = "{line} | {chromeSystem.inspectorAppComponents}"
  }
  if chromeSystem.inspectorWidgets.length() > 0 {
    line = "{line} | widgets {chromeSystem.inspectorWidgets}"
  }
  ret line
}
