# inspectorSystem/ClickScript — the headless driver for selection gestures.
#
# Selection is a POINTER gesture on both surfaces, so the only honest way to
# test it is to click things. This module turns a small script from the
# environment into exactly that: each step picks up a modifier and goes
# through the same funnel the live click uses — never a shortcut that sets
# the selection directly, because a shortcut would pass while the real
# gesture was broken.
#
#   RAE_UI_EDITOR_TEST_CLICKS="PlayButton cmd:ContinueButton alt:PlayButton at:4,4"
#
#   RAE_UI_EDITOR_TEST_TREE_CLICKS="Play shift:Continue cmd:Play"
#
# A step is `[modifier:]target`. The modifier is one of `shift`, `cmd`,
# `ctrl` or `alt` (absent = a plain click). On the CANVAS the target is either
# a node id, in which case the click lands in the middle of that node's
# current on-screen rect, or `at:<x>,<y>` for raw screen coordinates — which
# is how you click EMPTY canvas, the case that has no node to name. In the
# TREE the target is always a node id, since a row IS a node.
import String
open ui/Ecs
open ui/Components
open ui/UiSystems
open ui/Scene
open ecs/Entity
open ecs/ComponentTable
open inspectorSystem/InspectorSystem
open inspectorSystem/ComponentEdit
open ui/scrollRootSystem/ScrollRootSystem

# A point to click, and whether one could be resolved at all.
type ClickPoint {
  x: Float
  y: Float
  ok: Bool
}

# The centre of `entity` in screen space, from the transform and computed
# rect this frame's layout produced — the same numbers the hit test reads.
func nodeCenterOf(uiSystems: view UiSystems, entity: view EntityId) ret ClickPoint {
  if componentHas(this: uiSystems.transform2d.worldTransforms, entity: entity) is false {
    ret ClickPoint { x: 0.0, y: 0.0, ok: false }
  }
  if componentHas(this: uiSystems.layout.computedRects, entity: entity) is false {
    ret ClickPoint { x: 0.0, y: 0.0, ok: false }
  }
  let transform: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entity: entity
  )
  let computed: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: entity)
  ret ClickPoint {
    x: transform.position.x + computed.size.x * transform.scale.x * 0.5
    y: transform.position.y + computed.size.y * transform.scale.y * 0.5
    ok: true
  }
}

func selectModeFromName(name: view String) ret SelectMode {
  if name is "shift" {
    ret SelectMode.add
  }
  if name is "cmd" or name is "ctrl" {
    ret SelectMode.toggle
  }
  if name is "alt" {
    ret SelectMode.subtract
  }
  ret SelectMode.replace
}

# Run one `[modifier:]target` step.
func runTestClick(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: mod UiSystems
  sceneRoot: view EntityId
  step: view String
) {
  var mode: SelectMode = SelectMode.replace
  var rest: String = "{step}"
  let colon: Int = step.indexOf(sub: ":")
  if colon > 0 {
    let head: String = step.sub(start: 0, len: colon)
    if head is not "at" {
      mode = selectModeFromName(name: head)
      rest = step.sub(start: colon + 1, len: step.length() - colon - 1)
    }
  }
  var x: Float = 0.0
  var y: Float = 0.0
  if rest.startsWith(prefix: "at:") {
    let point: String = rest.sub(start: 3, len: rest.length() - 3)
    let comma: Int = point.indexOf(sub: ",")
    if comma <= 0 {
      log("[ui-editor] click: expected at:<x>,<y>, got {rest}")
      ret
    }
    x = point.sub(start: 0, len: comma).toFloat()
    y = point.sub(start: comma + 1, len: point.length() - comma - 1).toFloat()
  } else {
    let target: EntityId = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: rest)
    if isNone(this: target) {
      log("[ui-editor] click: no node named {rest}")
      ret
    }
    let center: ClickPoint = nodeCenterOf(uiSystems: uiSystems, entity: target)
    if center.ok is false {
      log("[ui-editor] click: {rest} has no on-screen rect")
      ret
    }
    x = center.x
    y = center.y
  }
  canvasSelectAt(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    sceneRoot: sceneRoot
    x: x
    y: y
    mode: mode
  )
}

# Run the whole script, then log the resulting set once. The trailing line is
# what the example gate asserts: the gesture sequence in, the selection out.
func runTestClicks(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  script: view String
  scene: view Scene
) {
  if script.length() is 0 {
    ret
  }
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  let steps: List(String) = script.split(sep: " ")
  loop let step: view String in steps {
    let trimmed: String = step.trim()
    if trimmed.length() is 0 {
      continue
    }
    runTestClick(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      step: trimmed
    )
  }
  log(
    "[ui-editor] clicks [{script}] -> {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )}"
  )
  logInspectorPanel(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    sceneRoot: sceneRoot
    scene: scene
  )
}

# The exact transformed screen rectangle the marquee compares, with a small
# exterior pad so floating-point equality at an edge cannot make the fixture
# platform-sensitive.
func testMarqueeRectOf(uiSystems: view UiSystems, entity: view EntityId) ret MarqueeRect {
  let transform: WorldTransform2D = componentGet(
    this: uiSystems.transform2d.worldTransforms
    entity: entity
  )
  let computed: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: entity)
  let exact: MarqueeRect = marqueeRectBetween(
    x1: transform.position.x
    y1: transform.position.y
    x2: transform.position.x + computed.size.x * transform.scale.x
    y2: transform.position.y + computed.size.y * transform.scale.y
  )
  ret MarqueeRect { x: exact.x - 2.0, y: exact.y - 2.0, w: exact.w + 4.0, h: exact.h + 4.0 }
}

# One headless marquee step: `[modifier:]nodeId`, `small`, or
# `preview:nodeId`. Node steps exercise begin/move/finish and the shared
# selection funnel; preview leaves the authored band visible for its reference
# image. Empty-press gating itself stays in inspectorUpdate, while the existing
# raw empty-canvas click fixture pins the below-threshold deselect behaviour.
func runTestMarquee(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  sceneRoot: view EntityId
  step: view String
) {
  var mode: SelectMode = SelectMode.replace
  var rest: String = "{step}"
  var preview: Bool = false
  let colon: Int = step.indexOf(sub: ":")
  if colon > 0 {
    let head: String = step.sub(start: 0, len: colon)
    if head is "preview" {
      preview = true
    } else {
      mode = selectModeFromName(name: head)
    }
    rest = step.sub(start: colon + 1, len: step.length() - colon - 1)
  }
  if rest is "small" or step is "small" {
    beginMarquee(
      inspectorSystem: inspectorSystem
      world: world
      x: 1.0
      y: 1.0
      mode: mode
    )
    finishMarquee(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      x: 3.0
      y: 3.0
    )
    ret
  }
  let target: EntityId = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: rest)
  if isNone(this: target) {
    log("[ui-editor] marquee: no node named {rest}")
    ret
  }
  let band: MarqueeRect = testMarqueeRectOf(uiSystems: uiSystems, entity: target)
  beginMarquee(
    inspectorSystem: inspectorSystem
    world: world
    x: band.x
    y: band.y
    mode: mode
  )
  moveMarquee(
    inspectorSystem: inspectorSystem
    world: world
    x: band.x + band.w
    y: band.y + band.h
  )
  if preview {
    # Hold only the authored pixels for the screenshot fixture. A live
    # half-gesture with the button up is cancelled by inspectorUpdate.
    inspectorSystem.marqueeTracking = false
    inspectorSystem.marqueeDragging = false
  } else {
    finishMarquee(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      x: band.x + band.w
      y: band.y + band.h
    )
  }
}

func runTestMarquees(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  script: view String
  scene: view Scene
) {
  if script.length() is 0 {
    ret
  }
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  let steps: List(String) = script.split(sep: " ")
  loop let step: view String in steps {
    let trimmed: String = step.trim()
    if trimmed.length() is 0 {
      continue
    }
    runTestMarquee(
      inspectorSystem: inspectorSystem
      world: world
      uiSystems: uiSystems
      sceneRoot: sceneRoot
      step: trimmed
    )
    log(
      "[ui-editor] marquee {trimmed} -> {selectionNodeIds(
        inspectorSystem: inspectorSystem
        world: world
      )}"
    )
  }
  logInspectorPanel(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    sceneRoot: sceneRoot
    scene: scene
  )
}

# Replay one tree-row click. Everything from the entity onward is the live
# path — the same `applySelect` with the same `treeSelectMode` mapping, so
# the range, the anchor and the markers are the real ones. Only the row's
# `inspect:<index>` action id is bypassed, because there is no pointer to
# generate it.
func runTestTreeClick(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  sceneRoot: view EntityId
  step: view String
) {
  var mode: SelectMode = SelectMode.replace
  var rest: String = "{step}"
  let colon: Int = step.indexOf(sub: ":")
  if colon > 0 {
    mode = selectModeFromName(name: step.sub(start: 0, len: colon))
    rest = step.sub(start: colon + 1, len: step.length() - colon - 1)
    # The tree spends Shift on a RANGE, not an add — the one place the two
    # surfaces read the same modifier differently.
    if mode is SelectMode.add {
      mode = SelectMode.range
    }
  }
  let target: EntityId = findNodeByIdIn(world: world, entity: sceneRoot, nodeId: rest)
  if isNone(this: target) {
    log("[ui-editor] tree click: no node named {rest}")
    ret
  }
  applySelect(
    inspectorSystem: inspectorSystem
    world: world
    entity: target
    mode: mode
  )
}

# Run a tree-click script, then log the set and the marked rows. The markers
# are logged too because "which row is active" is a separate question from
# "which rows are selected", and a range makes the difference visible.
func runTestTreeClicks(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  script: view String
  scene: view Scene
) {
  if script.length() is 0 {
    ret
  }
  let sceneRoot: EntityId = documentSceneRoot(world: world, pageRoot: pageRoot)
  let steps: List(String) = script.split(sep: " ")
  loop let step: view String in steps {
    let trimmed: String = step.trim()
    if trimmed.length() is 0 {
      continue
    }
    # A manual scroll followed by a normal panel refresh must stay where put.
    if trimmed.startsWith(prefix: "treeScroll:") {
      let list: EntityId = editorListEntity(
        chromeSystem: chromeSystem
        world: world
        source: EditorListSource.hierarchy
      )
      let position: Float = trimmed.sub(start: 11, len: trimmed.length() - 11).toFloat()
      let state: ScrollState = { y: position, velocity: 0 }
      componentSet(this: world.scrollStates, entity: list, data: state)
      syncTreePanel(
        chromeSystem: chromeSystem
        world: world
        inspectorSystem: inspectorSystem
        sceneRoot: sceneRoot
      )
      continue
    }
    # `parent` is not a click: it walks the whole selection up a level, the
    # affordance the click-through gesture cannot express.
    # `treeFilter:<text>`: what typing into the hierarchy filter produces.
    # Sets the same state the `F`-focused keystrokes write.
    if trimmed.startsWith(prefix: "treeFilter:") {
      inspectorSystem.treeFilter = trimmed.sub(start: 11, len: trimmed.length() - 11)
      syncTreePanel(
        chromeSystem: chromeSystem
        world: world
        inspectorSystem: inspectorSystem
        sceneRoot: sceneRoot
      )
      continue
    }
    # `collapse:<nodeId>` / `expand:<nodeId>`: the chevron's effect without a
    # pointer. Writes the same `collapsedNodeIds` the chevron action does.
    if trimmed.startsWith(prefix: "collapse:") or trimmed.startsWith(prefix: "expand:") {
      let wantCollapsed: Bool = trimmed.startsWith(prefix: "collapse:")
      var nodeId: String = trimmed.sub(start: 7, len: trimmed.length() - 7)
      if wantCollapsed {
        nodeId = trimmed.sub(start: 9, len: trimmed.length() - 9)
      }
      var at: Int = -1
      loop var i: Int = 0, i < inspectorSystem.collapsedNodeIds.length, ++i {
        if let name: String = inspectorSystem.collapsedNodeIds.copyAt(index: i) {
          if name is nodeId {
            at = i
          }
        }
      }
      if wantCollapsed and at < 0 {
        inspectorSystem.collapsedNodeIds.add(value: "{nodeId}")
      }
      if wantCollapsed is false and at >= 0 {
        inspectorSystem.collapsedNodeIds.removeAt(index: at)
      }
      # Rebuild the rows NOW, as a chevron click does (it sets `changed`, which
      # resyncs the panel). Without this a following `shift:` would range over
      # the pre-collapse rows.
      syncTreePanel(
        chromeSystem: chromeSystem
        world: world
        inspectorSystem: inspectorSystem
        sceneRoot: sceneRoot
      )
      continue
    }
    if trimmed is "parent" {
      selectParentOfSelection(
        inspectorSystem: inspectorSystem
        world: world
        uiSystems: uiSystems
        sceneRoot: sceneRoot
      )
      continue
    }
    runTestTreeClick(
      inspectorSystem: inspectorSystem
      world: world
      sceneRoot: sceneRoot
      step: trimmed
    )
    syncTreePanel(
      chromeSystem: chromeSystem
      world: world
      inspectorSystem: inspectorSystem
      sceneRoot: sceneRoot
    )
  }
  log(
    "[ui-editor] tree clicks [{script}] -> {selectionNodeIds(
      inspectorSystem: inspectorSystem
      world: world
    )} active {nodeIdOf(world: world, entity: inspectorSystem.selected)}"
  )
  logInspectorPanel(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    sceneRoot: sceneRoot
    scene: scene
  )
}

# Sync the panel and log what it now shows. The script drives the real
# gestures, so this is the composite an interactive user would be looking at.
func logInspectorPanel(
  inspectorSystem: mod InspectorSystem
  world: view UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  sceneRoot: view EntityId
  scene: view Scene
) {
  syncInspectorPanel(
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
    scene: scene
  )
  # The TREE rows too — they carry the selection (marker / plate cells), and a
  # scripted selection made after boot would otherwise leave them bound to
  # the empty selection `inspectorAfterLoad` built them with. That blind spot
  # produced a false "binding is inert" report (#85867026).
  syncTreePanel(
    chromeSystem: chromeSystem
    world: world
    inspectorSystem: inspectorSystem
    sceneRoot: sceneRoot
  )
  let treeList: EntityId = editorListEntity(
    chromeSystem: chromeSystem
    world: world
    source: EditorListSource.hierarchy
  )
  let treeScroll: ScrollState = componentGet(this: world.scrollStates, entity: treeList)
  log("[ui-editor] hierarchy scroll: {treeScroll.y}")
  # Read the rows AFTER the resync above: `treeEntities` is rebuilt there, and
  # logging it earlier reports the previous sync's tree.
  var visible: String = ""
  loop let row: view EntityId in inspectorSystem.treeEntities {
    let name: String = nodeIdOf(world: world, entity: row)
    if visible.length() is 0 {
      visible = "{name}"
    } else {
      visible = "{visible},{name}"
    }
  }
  log("[ui-editor] tree rows ({inspectorSystem.treeEntities.length}): {visible}")
  log("[ui-editor] tree header: {chromeSystem.treeHeader}")
  log("[ui-editor] inspector: {inspectorSummaryLine(chromeSystem: chromeSystem)}")
}

# Replay a component-list operation against the current selection:
#
#   RAE_UI_EDITOR_TEST_COMPONENT="add:Constraints"   add to every selected node
#   RAE_UI_EDITOR_TEST_COMPONENT="remove:Shape"      strip from those that have it
#   RAE_UI_EDITOR_TEST_COMPONENT="filter:tran"       narrow the component list
#   RAE_UI_EDITOR_TEST_COMPONENT="scroll:-280"       scroll the component viewport
#
# Add and remove go through the SAME functions the panel's rows call, so what
# the gate exercises is the real edit, not a shortcut around it. The filter is
# set directly because the keystroke path has no headless keyboard.
func runTestComponent(
  inspectorSystem: mod InspectorSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  chromeSystem: mod ChromeSystem
  pageRoot: view EntityId
  scene: view Scene
  script: view String
) {
  if script.length() is 0 {
    ret
  }
  let colon: Int = script.indexOf(sub: ":")
  if colon <= 0 {
    log("[ui-editor] component: expected add:/remove:/filter:/scroll:<value>, got {script}")
    ret
  }
  let verb: String = script.sub(start: 0, len: colon)
  let name: String = script.sub(start: colon + 1, len: script.length() - colon - 1)
  if verb is "filter" {
    inspectorSystem.componentFilter = "{name}"
    log("[ui-editor] component filter: {name}")
  }
  if verb is "add" {
    applyComponentAction(inspectorSystem: inspectorSystem, world: world, actionId: "compAdd:{name}")
  }
  if verb is "remove" {
    applyComponentAction(
      inspectorSystem: inspectorSystem
      world: world
      actionId: "compRemove:{name}"
    )
    applyComponentAction(
      inspectorSystem: inspectorSystem
      world: world
      actionId: "compRemove:{name}"
    )
  }
  if verb is "scroll" {
    let list: EntityId = editorListEntity(
      chromeSystem: chromeSystem
      world: world
      source: EditorListSource.components
    )
    if componentHas(this: world.scrollRoots, entity: list) {
      let root: ScrollRoot = componentGet(this: world.scrollRoots, entity: list)
      let position: Float = name.toFloat()
      applyScrollPosition(
        world: world
        uiSystems: uiSystems
        entity: list
        root: root
        position: position
      )
      log("[ui-editor] component scroll: {position}")
    }
  }
  logInspectorPanel(
    inspectorSystem: inspectorSystem
    world: world
    uiSystems: uiSystems
    chromeSystem: chromeSystem
    sceneRoot: documentSceneRoot(world: world, pageRoot: pageRoot)
    scene: scene
  )
}
