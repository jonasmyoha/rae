# 121_ui_editor — entry point. A `.raescene` viewer (docs/ui-editor-design.md):
# createApp (AppCreate.rae) opens the window and the document, runApp (App.rae)
# runs the passive view loop. Rae auto-scans every project file into one
# compile unit, so main() just composes the two.
func main() ret Int {
  var app: App = createApp()
  ret runApp(app: app)
}
