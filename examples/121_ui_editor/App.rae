# runApp — the passive view loop: the lib/ui systems on the #939 Schedule,
# the ListView system (rows are placeholder data, documentSystem), the file
# watcher (a 250 ms poll fed into the wait as `pollWatcher`), `D` the
# diagnostics panel, `P` the project panel (a tap on one of its rows opens
# that scene of the project — a reload with a new path), `O` (or the chrome's
# Open pill) the OS file picker — its choice goes through the same opener as
# the boot argument (documentOpenPath), so the picker is no second code
# path, `H` toggles the chrome, and the same idle policy as 105 (repaint on wake, ~0% CPU idle).
import Gpu2d
import Sys
import Keys
import Sdl3
open ui/Ecs
open ui/Components
open ui/EventLoop
open ui/SceneLoader
open ui/Pipeline
open ui/inputSystem/InputSystem
open ui/listViewSystem/ListViewSystem
open ui/animationSystem/EffectSystems
open ui/renderSystem/RenderSystem
open ui/safeAreaSystem/SafeAreaSystem
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open Gpu2dCanvas

const idleHeartbeatSec: Float = 0.5

func toggleChrome(chrome: mod ChromeState, world: mod UiWorld) {
  chrome.visible = not chrome.visible
  let active: Active = { value: chrome.visible }
  componentSet(this: world.actives, entity: chrome.pageRoot, data: active)
}

# A watched file changed: reload the document (its theme + fonts follow its imports) (a broken
# save keeps the last good page), refresh textures + chrome, log the delta.
func reloadDocument(app: mod App) {
  let previousNodes: Int = app.document.nodeCount
  # The selection survives by node id (the entities are new after the mount).
  var keepSelected: String = "{app.testSelectNodeId}"
  if keepSelected.length() is 0 and isNone(this: app.inspector.selected) is false {
    keepSelected = nodeIdOf(world: app.world, entity: app.inspector.selected)
  }
  let mounted: Bool = documentPrepareSystem(document: app.document, world: app.world)
  if mounted {
    applyDocumentTheme(gpuUi: app.gpuUi, document: app.document, quiet: true)
    reseedWorldTheme(world: app.world, res: app.gpuUi)
    applyDocumentFonts(gpuUi: app.gpuUi, fonts: app.fonts, document: app.document)
    documentMountSystem(
      document: app.document
      world: app.world
      builtinScenePaths: app.builtinScenePaths
      builtinSceneIds: app.builtinSceneIds
    )
    app.document.reloads = app.document.reloads + 1
    applyViewport(
      viewport: app.viewport
      world: app.world
      designW: app.document.designW
      designH: app.document.designH
    )
    placeDocumentPage(
      world: app.world
      pageRoot: app.document.pageRoot
      viewport: app.viewport
      designH: app.document.designH
    )
    sizeChromePage(world: app.world, chromeRoot: app.chrome.pageRoot, viewport: app.viewport)
    safeAreaSystem(world: app.world, insets: app.document.safeInsets)
    unsafe {
      textureSystem(
        search: app.textures
        world: app.world
        canvas: app.canvas
        assets: app.document.assets
        sceneId: app.document.fileName
      )
    }
  }
  chromeSyncSystem(
    world: app.world
    fileName: app.document.fileName
    designW: app.document.designW
    designH: app.document.designH
    columnW: app.document.columnW
    safeTop: app.document.safeInsets.t
    nodeCount: app.document.nodeCount
    status: app.document.status
  )
  watchRememberMtimes(watch: app.watch, paths: app.document.watchedPaths)
  if mounted {
    resolveSceneInstances(world: app.world, registry: app.document.registry, pageId: "chrome")
    inspectorAfterLoad(
      inspector: app.inspector
      world: app.world
      pageRoot: app.document.pageRoot
      designW: app.document.designW
      selectNodeId: keepSelected
    )
  }
  let diagnostics: Int = app.world.sceneDiagnostics.length
  if mounted {
    log(
      "[ui-editor] reloaded {app.document.path} (+{app.document.nodeCount} -{previousNodes} nodes, {diagnostics} diagnostics)"
    )
  } else {
    log("[ui-editor] reload of {app.document.path} kept the last good page: {app.document.status}")
  }
}

# Open `path` — a `.raepack` (the project) or a `.raescene` — as the boot
# argument would: documentOpenPath moves the document, the watcher's reload
# mounts it (a file that fails to parse keeps the last good page with the
# error in the chrome), and the project panel follows (shown for a project,
# hidden for a bare scene).
func openPath(app: mod App, path: view String) {
  documentOpenPath(
    document: app.document
    path: path
    wantedScene: ""
    atBoot: false
  )
  log("[ui-editor] open {path} -> {app.document.path}")
  reloadDocument(app: app)
  setProjectPanelOpen(
    chrome: app.chrome
    world: app.world
    open: app.document.projectPack.length() > 0
  )
  syncProjectPanel(
    world: app.world
    projectName: app.document.projectName
    projectScenes: app.document.projectScenes
    currentScene: documentPackagePath(document: app.document)
    designW: app.document.designW
  )
}

# The OS file picker (lib/Sdl3 openFileDialog, async): packs and scenes,
# starting in the document's root. The frame loop polls for the choice.
func requestOpenFileDialog(app: view App) {
  let filters: List(String) = { "raepack", "raescene" }
  Sdl3.openFileDialog(filters: filters, defaultLocation: app.document.root)
  log("[ui-editor] open file dialog requested (in {app.document.root})")
}

# Open scene `index` of the project (a chrome row tap, or the headless
# RAE_UI_EDITOR_TEST_OPEN hook): the document's path moves, the root does
# not, and the same reload the watcher uses mounts it — the watcher then
# follows the new file.
func openProjectScene(app: mod App, index: view Int) {
  if index < 0 or index >= app.document.projectScenes.length {
    ret
  }
  if let packagePath: String = app.document.projectScenes.copyAt(index: index) {
    setDocumentScene(document: app.document, packagePath: packagePath)
    log("[ui-editor] open {packagePath} ({app.document.path})")
    reloadDocument(app: app)
    syncProjectPanel(
      world: app.world
      projectName: app.document.projectName
      projectScenes: app.document.projectScenes
      currentScene: packagePath
      designW: app.document.designW
    )
  }
}

# The six effect systems in schedule order; true while any is live.
func effectSystems(
  app: mod App
  deltaTime: view Float
  clock: view Float
  input: view UiInput
) ret Bool {
  var live: Bool = false
  if animFramesSystem(world: app.world, deltaTime: deltaTime) {
    live = true
  }
  animTriggerSystem(world: app.world)
  if wobbleFxSystem(world: app.world, time: clock) {
    live = true
  }
  if backgroundPanSystem(world: app.world, time: clock) {
    live = true
  }
  if smokeFxSystem(world: app.world, deltaTime: deltaTime) {
    live = true
  }
  if carouselSystem(
    world: app.world
    deltaTime: deltaTime
    pointerX: input.pointer.x
    pointerY: input.pointer.y
    pointerDown: input.pointer.down
  ) {
    live = true
  }
  ret live
}

func runApp(app: mod App) ret Int {
  var input: UiInput = createUiInput()
  listViewSystem(world: app.world, scenes: app.document.registry)
  runScheduledUiSystems(schedule: app.schedule, world: app.world, res: app.gpuUi)
  # The first layout has run, so the selection hook can read computed rects.
  inspectorAfterLoad(
    inspector: app.inspector
    world: app.world
    pageRoot: app.document.pageRoot
    designW: app.document.designW
    selectNodeId: app.testSelectNodeId
  )
  inspectorSystem(
    inspector: app.inspector
    world: app.world
    input: input
    pageRoot: app.document.pageRoot
    chromeVisible: app.chrome.visible
    designW: app.document.designW
  )
  listViewSystem(world: app.world, scenes: app.document.registry)
  runScheduledUiSystems(schedule: app.schedule, world: app.world, res: app.gpuUi)
  var renderedOnce: Bool = false
  var testOpenIndex: Int = -1
  var testOpenFile: Bool = Sys.getEnv(name: "RAE_UI_EDITOR_TEST_OPEN_FILE") is "1"
  let testOpen: String = Sys.getEnv(name: "RAE_UI_EDITOR_TEST_OPEN")
  if testOpen.length() > 0 {
    testOpenIndex = testOpen.toInt()
  }
  var wokeUp: Bool = false
  var previousNow: Float64 = Gpu2d.nowSeconds()
  var animating: Bool = false
  var effectTime: Float = 0.0

  loop not Gpu2d.pollClose() {
    var changed: Bool = viewportSystem(viewport: app.viewport)
    updateUiInput(input: input, world: app.world)
    let hadEvents: Bool = uiActionCount(world: app.world) > 0
    if Sdl3.isKeyPressed(key: Keys.keyH) {
      toggleChrome(chrome: app.chrome, world: app.world)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyD) {
      setDiagnosticsPanelOpen(chrome: app.chrome, world: app.world, open: not app.chrome.panelOpen)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyP) {
      setProjectPanelOpen(chrome: app.chrome, world: app.world, open: not app.chrome.projectOpen)
      changed = true
    }
    var wantsDialog: Bool = Sdl3.isKeyPressed(key: Keys.keyO) or uiActionFired(
      world: app.world
      actionId: "file.open"
    )
    if testOpenFile and renderedOnce {
      # RAE_UI_EDITOR_TEST_OPEN_FILE=1: request the picker after the first
      # frame, as O would; RAE_SDL_FILE_DIALOG_RESULT answers it headlessly.
      wantsDialog = true
      testOpenFile = false
    }
    if wantsDialog {
      requestOpenFileDialog(app: app)
    }
    let picked: String = Sdl3.pollFileDialogResult()
    if picked.length() > 0 {
      openPath(app: app, path: picked)
      changed = true
    }
    var openIndex: Int = projectOpenActionIndex(world: app.world)
    if testOpenIndex >= 0 and renderedOnce {
      # RAE_UI_EDITOR_TEST_OPEN=<index>: open that project scene after the
      # first frame, as a row tap would — the headless gate's switch hook.
      openIndex = testOpenIndex
      testOpenIndex = -1
    }
    if openIndex >= 0 {
      openProjectScene(app: app, index: openIndex)
      changed = true
    }
    let now: Float64 = Gpu2d.nowSeconds()
    if testRewriteSystem(watch: app.watch, path: app.document.path, now: now) {
      changed = true
    }
    if fileWatchSystem(watch: app.watch, paths: app.document.watchedPaths, now: now) {
      reloadDocument(app: app)
      changed = true
    }
    if inspectorSystem(
      inspector: app.inspector
      world: app.world
      input: input
      pageRoot: app.document.pageRoot
      chromeVisible: app.chrome.visible
      designW: app.document.designW
    ) {
      changed = true
    }
    # The effect systems (#1005) run every frame the document has any; while
    # one is live the loop stays a busy render loop (animating -> frame wait).
    var deltaTime: Float = (now - previousNow) as Float
    previousNow = now
    if deltaTime < 0.0 or deltaTime > 0.25 {
      deltaTime = 0.016667
    }
    effectTime = effectTime + deltaTime
    animating = effectSystems(
      app: app
      deltaTime: deltaTime
      clock: effectTime
      input: input
    )
    if animating {
      changed = true
    }
    if hadEvents or changed {
      listViewSystem(world: app.world, scenes: app.document.registry)
      runScheduledUiSystems(schedule: app.schedule, world: app.world, res: app.gpuUi)
    }
    let needsRender: Bool = hadEvents or changed or wokeUp or renderedOnce is false
    wokeUp = false
    if Gpu2d.shouldRenderFrame(appNeedsRender: needsRender) {
      Gpu2d.beginFrame(
        canvas: app.canvas
        r: 0.04
        g: 0.04
        b: 0.05
        a: 1.0
      )
      renderSystemGpu2d(world: app.world, res: app.gpuUi, canvas: app.canvas)
      Gpu2d.endFrame(canvas: app.canvas)
      renderedOnce = true
    } else {
      # The watcher is a poll, so the wait is bounded by its interval while
      # the window can show a reload; a hidden window sleeps on the heartbeat.
      Gpu2d.waitEvents(timeoutSec: nextWaitTimeoutSec(
        animating: animating
        mouseDown: false
        pollWatcher: Gpu2d.renderableNow()
        frameSec: 0.016667
        heartbeatSec: idleHeartbeatSec
      ))
      wokeUp = true
    }
  }
  canvasShutdown(canvas: app.canvas)
  Gpu2d.closeWindow()
  ret 0
}
