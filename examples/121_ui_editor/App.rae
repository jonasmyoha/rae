# runApp — the passive view loop: the lib/ui systems on the #939 Schedule,
# the ListView system (rows are placeholder data, documentSystem), the file
# watcher (a 250 ms poll fed into the wait as `pollWatcher`), `D` the
# diagnostics panel, `P` the project panel (a tap on one of its rows opens
# that scene of the project — a reload with a new path), `G` the frame +
# safe-area guides, `N` / `B` outline every node / every button, the wheel zooms the document about
# the cursor and a
# middle drag pans it (the chrome's zoom pill steps, its 100% resets), `O`
# (or the chrome's
# Open pill) the OS file picker — its choice goes through the same opener as
# the boot argument (documentOpenPath), so the picker is no second code
# path, `H` toggles the chrome, and the same idle policy as 105 (repaint on wake, ~0% CPU idle).
import Gpu2d
import Sys
import Keys
import Sdl3
open ui/Ecs
open ui/Components
open ui/EventLoop
open ui/SceneLoader
open ui/Pipeline
open ui/inputSystem/InputSystem
open ui/listViewSystem/ListViewSystem
open ui/animationSystem/EffectSystems
open ui/renderSystem/RenderSystem
open ui/safeAreaSystem/SafeAreaSystem
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open Gpu2dCanvas
open ui/DebugOverlay
open ui/WindowGeometry
open ecs/Event
open ui/UiSystems

const idleHeartbeatSec: Float = 0.5

func toggleChrome(chromeSystem: view ChromeSystem, world: mod UiWorld) {
  let active: Active = { value: not chromeVisible(world: world, chromeSystem: chromeSystem) }
  componentSet(this: world.actives, entity: chromeSystem.pageRoot, data: active)
}

# A watched file changed: reload the document (its theme + fonts follow its imports) (a broken
# save keeps the last good page), refresh textures + chrome, log the delta.
func reloadDocument(app: mod App) {
  let previousNodes: Int = app.document.nodeCount
  # The selection survives by node id (the entities are new after the mount).
  var keepSelected: String = "{app.testSelectNodeId}"
  if keepSelected.length() is 0 and isNone(this: app.inspectorSystem.selected) is false {
    keepSelected = nodeIdOf(world: app.world, entity: app.inspectorSystem.selected)
  }
  let mounted: Bool = documentPrepareSystem(document: app.document, world: app.world)
  if mounted {
    applyDocumentTheme(gpuUi: app.gpuUi, document: app.document, quiet: true)
    reseedWorldTheme(world: app.world, res: app.gpuUi)
    applyDocumentFonts(gpuUi: app.gpuUi, fonts: app.fonts, document: app.document)
    documentMountSystem(
      document: app.document
      world: app.world
      uiSystems: app.uiSystems
      builtinScenePaths: app.builtinScenePaths
      builtinSceneIds: app.builtinSceneIds
    )
    app.document.reloads = app.document.reloads + 1
    # The unmounted page's entities are swept from the editor's tables before
    # their indices are recycled; the new page's authored editor components
    # (if a document carries any) reach their systems.
    sweepEditorEntitiesOf(app: app)
    applyEditorComponentsOf(app: app)
    pinDocumentPage(world: app.world, pageRoot: app.document.pageRoot)
    safeAreaSystem(world: app.world, uiSystems: app.uiSystems, insets: app.document.safeInsets)
    syncGuides(
      guideSystem: app.guideSystem
      world: app.world
      chromeSystem: app.chromeSystem
      designW: app.document.designW
      designH: app.document.designH
      columnW: app.document.columnW
      safeInsets: app.document.safeInsets
    )
    # A new page root: the camera follows the new frame (fitted into the
    # edit area) and is written onto the new entity.
    setCameraFrame(
      cameraSystem: app.cameraSystem
      frameW: app.document.designW
      frameH: app.document.designH
      homeX: documentHomeX(designW: app.document.designW, columnW: app.document.columnW)
      documentRoot: app.document.pageRoot
      guidesRoot: app.guideSystem.frameSpace
    )
    fitCamera(
      cameraSystem: app.cameraSystem
      world: app.world
      chromeSystem: app.chromeSystem
      area: editAreaOf(
        chromeSystem: app.chromeSystem
        world: app.world
        uiSystems: app.uiSystems
        canvasW: app.viewportSystem.designW
        canvasH: app.viewportSystem.designH
      )
    )
    unsafe {
      textureUpdate(
        textureSystem: app.textureSystem
        world: app.world
        canvas: app.canvas
        assets: app.document.assets
        sceneId: app.document.fileName
      )
    }
  }
  chromeSyncSystem(
    world: app.world
    chromeSystem: app.chromeSystem
    fileName: app.document.fileName
    designW: app.document.designW
    designH: app.document.designH
    columnW: app.document.columnW
    safeTop: app.document.safeInsets.t
    nodeCount: app.document.nodeCount
    documentStatus: app.document.status
  )
  watchRememberMtimes(watch: app.watch, paths: app.document.watchedPaths)
  if mounted {
    resolveSceneInstances(
      world: app.world
      uiSystems: app.uiSystems
      registry: app.document.registry
      pageId: "chrome"
    )
    inspectorAfterLoad(
      inspectorSystem: app.inspectorSystem
      world: app.world
      uiSystems: app.uiSystems
      chromeSystem: app.chromeSystem
      pageRoot: app.document.pageRoot
      selectNodeId: keepSelected
    )
  }
  let diagnostics: Int = app.world.sceneDiagnostics.length
  var kept: String = ""
  if app.world.pendingComponents.length > 0 {
    kept = ", {app.world.pendingComponents.length} app components kept"
  }
  if mounted {
    log(
      "[ui-editor] reloaded {app.document.path} (+{app.document.nodeCount} -{previousNodes} nodes, {diagnostics} diagnostics{kept})"
    )
  } else {
    log("[ui-editor] reload of {app.document.path} kept the last good page: {app.document.status}")
  }
}

# Open `path` — a `.raepack` (the project) or a `.raescene` — as the boot
# argument would: documentOpenPath moves the document, the watcher's reload
# mounts it (a file that fails to parse keeps the last good page with the
# error in the chrome), and the project panel follows (shown for a project,
# hidden for a bare scene).
func openPath(app: mod App, path: view String) {
  documentOpenPath(
    document: app.document
    path: path
    wantedScene: ""
    atBoot: false
  )
  log("[ui-editor] open {path} -> {app.document.path}")
  reloadDocument(app: app)
  setEditorPanelOpen(
    chromeSystem: app.chromeSystem
    world: app.world
    kind: EditorPanelKind.project
    open: app.document.projectPack.length() > 0
  )
  projectListSystem(
    world: app.world
    chromeSystem: app.chromeSystem
    projectName: app.document.projectName
    projectScenes: app.document.projectScenes
    currentScene: documentPackagePath(document: app.document)
  )
}

# The OS file picker (lib/Sdl3 openFileDialog, async): packs and scenes,
# starting in the document's root. The frame loop polls for the choice.
func requestOpenFileDialog(app: view App) {
  let filters: List(String) = { "raepack", "raescene" }
  Sdl3.openFileDialog(filters: filters, defaultLocation: app.document.root)
  log("[ui-editor] open file dialog requested (in {app.document.root})")
}

# Open scene `index` of the project (a chrome row tap, or the headless
# RAE_UI_EDITOR_TEST_OPEN hook): the document's path moves, the root does
# not, and the same reload the watcher uses mounts it — the watcher then
# follows the new file.
func openProjectScene(app: mod App, index: view Int) {
  if index < 0 or index >= app.document.projectScenes.length {
    ret
  }
  if let packagePath: String = app.document.projectScenes.copyAt(index: index) {
    setDocumentScene(document: app.document, packagePath: packagePath)
    log("[ui-editor] open {packagePath} ({app.document.path})")
    reloadDocument(app: app)
    projectListSystem(
      world: app.world
      chromeSystem: app.chromeSystem
      projectName: app.document.projectName
      projectScenes: app.document.projectScenes
      currentScene: packagePath
    )
  }
}

# The six effect systems in schedule order; true while any is live.
func effectSystems(
  app: mod App
  deltaTime: view Float
  clock: view Float
  input: view UiInput
) ret Bool {
  var live: Bool = false
  if animFramesSystem(world: app.world, uiSystems: app.uiSystems, deltaTime: deltaTime) {
    live = true
  }
  animTriggerSystem(world: app.world, uiSystems: app.uiSystems)
  if wobbleFxSystem(world: app.world, uiSystems: app.uiSystems, time: clock) {
    live = true
  }
  if backgroundPanSystem(world: app.world, uiSystems: app.uiSystems, time: clock) {
    live = true
  }
  if smokeFxSystem(world: app.world, uiSystems: app.uiSystems, deltaTime: deltaTime) {
    live = true
  }
  if carouselSystem(
    world: app.world
    uiSystems: app.uiSystems
    deltaTime: deltaTime
    pointerX: input.pointer.x
    pointerY: input.pointer.y
    pointerDown: input.pointer.down
  ) {
    live = true
  }
  ret live
}

func runApp(app: mod App) ret Int {
  var input: UiInput = createUiInput()
  listViewSystem(world: app.world, uiSystems: app.uiSystems, scenes: app.document.registry)
  runScheduledUiSystems(
    schedule: app.schedule
    world: app.world
    uiSystems: app.uiSystems
    res: app.gpuUi
  )
  # The first layout has run, so the selection hook can read computed rects.
  inspectorAfterLoad(
    inspectorSystem: app.inspectorSystem
    world: app.world
    uiSystems: app.uiSystems
    chromeSystem: app.chromeSystem
    pageRoot: app.document.pageRoot
    selectNodeId: app.testSelectNodeId
  )
  inspectorUpdate(
    inspectorSystem: app.inspectorSystem
    world: app.world
    uiSystems: app.uiSystems
    chromeSystem: app.chromeSystem
    input: input
    pageRoot: app.document.pageRoot
    chromeVisible: chromeVisible(world: app.world, chromeSystem: app.chromeSystem)
  )
  listViewSystem(world: app.world, uiSystems: app.uiSystems, scenes: app.document.registry)
  runScheduledUiSystems(
    schedule: app.schedule
    world: app.world
    uiSystems: app.uiSystems
    res: app.gpuUi
  )
  # The chrome has laid out: fit the document into the edit area (and apply
  # RAE_UI_EDITOR_ZOOM) — a Camera2D write the lib cameraSystem folds into
  # the roots' transforms on the next pipeline run.
  var editArea: EditAreaRect = editAreaOf(
    chromeSystem: app.chromeSystem
    world: app.world
    uiSystems: app.uiSystems
    canvasW: app.viewportSystem.designW
    canvasH: app.viewportSystem.designH
  )
  fitCamera(
    cameraSystem: app.cameraSystem
    world: app.world
    chromeSystem: app.chromeSystem
    area: editArea
  )
  bootCameraZoom(
    cameraSystem: app.cameraSystem
    world: app.world
    chromeSystem: app.chromeSystem
    area: editArea
  )
  runScheduledUiSystems(
    schedule: app.schedule
    world: app.world
    uiSystems: app.uiSystems
    res: app.gpuUi
  )
  var renderedOnce: Bool = false
  # Whether the previous loop iteration painted: what the debug widget's fps
  # counts (an idle wait-loop iteration is not a frame).
  var renderedThisFrame: Bool = false
  var testOpenIndex: Int = -1
  var testOpenFile: Bool = Sys.getEnv(name: "RAE_UI_EDITOR_TEST_OPEN_FILE") is "1"
  let testOpen: String = Sys.getEnv(name: "RAE_UI_EDITOR_TEST_OPEN")
  if testOpen.length() > 0 {
    testOpenIndex = testOpen.toInt()
  }
  # What the pointer was over / pressing on the previous iteration: a change
  # is a real reason to paint (hover glow starts, pill pressed), a timeout
  # wake is not — otherwise the idle editor repaints on every watcher poll
  # (20 Hz) and never sleeps.
  var previousHovered: EntityId = noEntity()
  var previousPressed: EntityId = noEntity()
  var previousNow: Float64 = Gpu2d.nowSeconds()
  var animating: Bool = false
  var effectTime: Float = 0.0

  loop not Gpu2d.pollClose() {
    let resized: Bool = Gpu2d.windowResized()
    var refit: Bool = viewportUpdate(
      viewportSystem: app.viewportSystem
      world: app.world
      chromeRoot: app.chromeSystem.pageRoot
      resized: resized
    )
    var changed: Bool = refit
    let now: Float64 = Gpu2d.nowSeconds()
    if Gpu2d.headlessRequested() is false {
      updateWindowGeometry(windowGeometry: app.windowGeometry, now: now, resized: resized)
    }
    # The debug widget reads the pointer BEFORE the chrome hit-tests, so a
    # press on its button (or its open dialog) never reaches the pill under
    # it: the press is swallowed by voiding this frame's actions.
    let overlayTookPointer: Bool = updateDebugOverlay(
      debugOverlay: app.debugOverlay
      screenW: app.viewportSystem.designW
      screenH: app.viewportSystem.designH
      now: now
      didRealWork: renderedThisFrame
    )
    renderedThisFrame = false
    updateUiInput(input: input, world: app.world, uiSystems: app.uiSystems)
    if overlayTookPointer or app.debugOverlay.open {
      eventClear(UiAction, this: app.world.uiActions)
      input.pressedEntity = noEntity()
      changed = true
    }
    let hadEvents: Bool = uiActionCount(world: app.world) > 0
    let inputChanged: Bool = input.hoveredEntity is not previousHovered or input.pressedEntity is not previousPressed or input.pointer.down
    previousHovered = input.hoveredEntity
    previousPressed = input.pressedEntity
    editArea = editAreaOf(
      chromeSystem: app.chromeSystem
      world: app.world
      uiSystems: app.uiSystems
      canvasW: app.viewportSystem.designW
      canvasH: app.viewportSystem.designH
    )
    if panelToggleSystem(chromeSystem: app.chromeSystem, world: app.world) {
      changed = true
    }
    editorTextSystem(world: app.world, chromeSystem: app.chromeSystem)
    if cameraInputSystem(
      cameraSystem: app.cameraSystem
      world: app.world
      chromeSystem: app.chromeSystem
      area: editArea
    ) {
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyH) {
      toggleChrome(chromeSystem: app.chromeSystem, world: app.world)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyD) {
      toggleEditorPanel(
        chromeSystem: app.chromeSystem
        world: app.world
        kind: EditorPanelKind.diagnostics
      )
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyG) {
      toggleEditorPanel(
        chromeSystem: app.chromeSystem
        world: app.world
        kind: EditorPanelKind.guides
      )
      syncGuides(
        guideSystem: app.guideSystem
        world: app.world
        chromeSystem: app.chromeSystem
        designW: app.document.designW
        designH: app.document.designH
        columnW: app.document.columnW
        safeInsets: app.document.safeInsets
      )
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyN) {
      toggleEditorPanel(
        chromeSystem: app.chromeSystem
        world: app.world
        kind: EditorPanelKind.outlines
      )
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyB) {
      toggleEditorPanel(
        chromeSystem: app.chromeSystem
        world: app.world
        kind: EditorPanelKind.buttons
      )
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyP) {
      toggleEditorPanel(
        chromeSystem: app.chromeSystem
        world: app.world
        kind: EditorPanelKind.project
      )
      changed = true
    }
    var wantsDialog: Bool = Sdl3.isKeyPressed(key: Keys.keyO) or uiActionFired(
      world: app.world
      actionId: "file.open"
    )
    if testOpenFile and renderedOnce {
      # RAE_UI_EDITOR_TEST_OPEN_FILE=1: request the picker after the first
      # frame, as O would; RAE_SDL_FILE_DIALOG_RESULT answers it headlessly.
      wantsDialog = true
      testOpenFile = false
    }
    if wantsDialog {
      requestOpenFileDialog(app: app)
    }
    let picked: String = Sdl3.pollFileDialogResult()
    if picked.length() > 0 {
      openPath(app: app, path: picked)
      changed = true
    }
    var openIndex: Int = projectOpenActionIndex(world: app.world)
    if testOpenIndex >= 0 and renderedOnce {
      # RAE_UI_EDITOR_TEST_OPEN=<index>: open that project scene after the
      # first frame, as a row tap would — the headless gate's switch hook.
      openIndex = testOpenIndex
      testOpenIndex = -1
    }
    if openIndex >= 0 {
      openProjectScene(app: app, index: openIndex)
      changed = true
    }
    if testRewriteSystem(watch: app.watch, path: app.document.path, now: now) {
      changed = true
    }
    if fileWatchSystem(watch: app.watch, paths: app.document.watchedPaths, now: now) {
      reloadDocument(app: app)
      changed = true
    }
    if inspectorUpdate(
      inspectorSystem: app.inspectorSystem
      world: app.world
      uiSystems: app.uiSystems
      chromeSystem: app.chromeSystem
      input: input
      pageRoot: app.document.pageRoot
      chromeVisible: chromeVisible(world: app.world, chromeSystem: app.chromeSystem)
    ) {
      changed = true
    }
    # The outline pools (N: every node, B: every button) follow the document.
    if outlinePoolUpdate(
      outlinePoolSystem: app.outlinePoolSystem
      world: app.world
      uiSystems: app.uiSystems
      documentRoot: app.document.pageRoot
      scenes: app.document.registry
    ) {
      changed = true
    }
    # The effect systems (#1005) run every frame the document has any; while
    # one is live the loop stays a busy render loop (animating -> frame wait).
    var deltaTime: Float = (now - previousNow) as Float
    previousNow = now
    if deltaTime < 0.0 or deltaTime > 0.25 {
      deltaTime = 0.016667
    }
    effectTime = effectTime + deltaTime
    animating = effectSystems(
      app: app
      deltaTime: deltaTime
      clock: effectTime
      input: input
    )
    if animating {
      changed = true
    }
    if hadEvents or changed {
      listViewSystem(world: app.world, uiSystems: app.uiSystems, scenes: app.document.registry)
      runScheduledUiSystems(
        schedule: app.schedule
        world: app.world
        uiSystems: app.uiSystems
        res: app.gpuUi
      )
      if refit {
        # The chrome relaid out for the new window: fit the document into
        # the new edit area and run the transform pass again.
        fitCamera(
          cameraSystem: app.cameraSystem
          world: app.world
          chromeSystem: app.chromeSystem
          area: editAreaOf(
            chromeSystem: app.chromeSystem
            world: app.world
            uiSystems: app.uiSystems
            canvasW: app.viewportSystem.designW
            canvasH: app.viewportSystem.designH
          )
        )
        runScheduledUiSystems(
          schedule: app.schedule
          world: app.world
          uiSystems: app.uiSystems
          res: app.gpuUi
        )
      }
    }
    if renderedOnce is false {
      # The platform applies a restored size/position on its event pump, so
      # the first frame is the earliest honest report of where the window is.
      log(
        "[ui-editor] window {Gpu2d.designWidth().toInt()}x{Gpu2d.designHeight().toInt()} at ({Gpu2d.windowPositionX()}, {Gpu2d.windowPositionY()})"
      )
    }
    # Frame end. The editor NEVER reports pending components: what no editor
    # system claims is the document app's own, kept on the node as authored
    # (docs/ecs-systems-own-their-tables.md §4) and shown in the inspector.
    # The dead entities of a reload / unmount are swept from the editor's
    # tables, then released.
    sweepEditorEntitiesOf(app: app)
    let needsRender: Bool = hadEvents or changed or inputChanged or renderedOnce is false
    if Gpu2d.shouldRenderFrame(appNeedsRender: needsRender) {
      Gpu2d.beginFrame(
        canvas: app.canvas
        r: 0.04
        g: 0.04
        b: 0.05
        a: 1.0
      )
      renderSystemGpu2d(
        world: app.world
        uiSystems: app.uiSystems
        res: app.gpuUi
        canvas: app.canvas
      )
      drawDebugOverlay(
        debugOverlay: app.debugOverlay
        canvas: app.canvas
        font: app.gpuUi.textFont
        didRealWork: true
      )
      Gpu2d.endFrame(canvas: app.canvas)
      # The first frame counts only once it reached the screen: right after
      # the window opens the surface can still report Occluded for a frame or
      # two (a benign startup transient), and a frame that was rendered but
      # not presented must not switch the loop to its idle wait — that left
      # the editor black until the first mouse move.
      if renderedOnce is false and (Gpu2d.lastPresentOk() or Gpu2d.headlessRequested()) {
        renderedOnce = true
      }
      renderedThisFrame = true
    } else {
      # The watcher is a poll, so the wait is bounded by its interval while
      # the window can show a reload; a hidden window sleeps on the heartbeat.
      Gpu2d.waitEvents(timeoutSec: nextWaitTimeoutSec(
        animating: animating
        mouseDown: false
        pollWatcher: Gpu2d.renderableNow()
        frameSec: 0.016667
        heartbeatSec: idleHeartbeatSec
      ))
    }
  }
  if Gpu2d.headlessRequested() is false {
    flushWindowGeometry(windowGeometry: app.windowGeometry)
  }
  canvasShutdown(canvas: app.canvas)
  Gpu2d.closeWindow()
  ret 0
}
