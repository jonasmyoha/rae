# runApp — the passive view loop: the lib/ui systems on the #939 Schedule,
# the ListView system (rows are placeholder data, documentSystem), the file
# watcher (a 250 ms poll fed into the wait as `pollWatcher`), `D` the
# diagnostics panel, `H` toggles
# the chrome, and the same idle policy as 105 (repaint on wake, ~0% CPU idle).
import Gpu2d
import Sys
import Keys
import Sdl3
open ui/Ecs
open ui/Components
open ui/EventLoop
open ui/SceneLoader
open ui/Pipeline
open ui/inputSystem/InputSystem
open ui/listViewSystem/ListViewSystem
open ui/animationSystem/EffectSystems
open ui/renderSystem/RenderSystem
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open Gpu2dCanvas

const idleHeartbeatSec: Float = 0.5

func toggleChrome(chrome: mod ChromeState, world: mod UiWorld) {
  chrome.visible = not chrome.visible
  let active: Active = { value: chrome.visible }
  componentSet(this: world.actives, entity: chrome.pageRoot, data: active)
}

# A watched file changed: reload the document (its theme + fonts follow its imports) (a broken
# save keeps the last good page), refresh textures + chrome, log the delta.
func reloadDocument(app: mod App) {
  let previousNodes: Int = app.document.nodeCount
  # The selection survives by node id (the entities are new after the mount).
  var keepSelected: String = "{app.testSelectNodeId}"
  if keepSelected.length() is 0 and isNone(this: app.inspector.selected) is false {
    keepSelected = nodeIdOf(world: app.world, entity: app.inspector.selected)
  }
  let mounted: Bool = documentPrepareSystem(document: app.document, world: app.world)
  if mounted {
    applyDocumentTheme(gpuUi: app.gpuUi, document: app.document, quiet: true)
    reseedWorldTheme(world: app.world, res: app.gpuUi)
    applyDocumentFonts(gpuUi: app.gpuUi, fonts: app.fonts, document: app.document)
    documentMountSystem(
      document: app.document
      world: app.world
      builtinScenePaths: app.builtinScenePaths
    )
    app.document.reloads = app.document.reloads + 1
    applyViewport(
      viewport: app.viewport
      world: app.world
      designW: app.document.designW
      designH: app.document.designH
    )
    unsafe {
      textureSystem(
        search: app.textures
        world: app.world
        canvas: app.canvas
        assets: app.document.assets
        sceneId: app.document.fileName
      )
    }
  }
  chromeSyncSystem(
    world: app.world
    fileName: app.document.fileName
    designW: app.document.designW
    designH: app.document.designH
    nodeCount: app.document.nodeCount
    status: app.document.status
  )
  watchRememberMtimes(watch: app.watch, paths: app.document.watchedPaths)
  if mounted {
    resolveSceneInstances(world: app.world, registry: app.document.registry, pageId: "chrome")
    inspectorAfterLoad(
      inspector: app.inspector
      world: app.world
      pageRoot: app.document.pageRoot
      designW: app.document.designW
      selectNodeId: keepSelected
    )
  }
  let diagnostics: Int = app.world.sceneDiagnostics.length
  if mounted {
    log(
      "[ui-editor] reloaded {app.document.path} (+{app.document.nodeCount} -{previousNodes} nodes, {diagnostics} diagnostics)"
    )
  } else {
    log("[ui-editor] reload of {app.document.path} kept the last good page: {app.document.status}")
  }
}

# The six effect systems in schedule order; true while any is live.
func effectSystems(
  app: mod App
  deltaTime: view Float
  clock: view Float
  input: view UiInput
) ret Bool {
  var live: Bool = false
  if animFramesSystem(world: app.world, deltaTime: deltaTime) {
    live = true
  }
  animTriggerSystem(world: app.world)
  if wobbleFxSystem(world: app.world, time: clock) {
    live = true
  }
  if backgroundPanSystem(world: app.world, time: clock) {
    live = true
  }
  if smokeFxSystem(world: app.world, deltaTime: deltaTime) {
    live = true
  }
  if carouselSystem(
    world: app.world
    deltaTime: deltaTime
    pointerX: input.pointer.x
    pointerY: input.pointer.y
    pointerDown: input.pointer.down
  ) {
    live = true
  }
  ret live
}

func runApp(app: mod App) ret Int {
  var input: UiInput = createUiInput()
  listViewSystem(world: app.world, scenes: app.document.registry)
  runScheduledUiSystems(schedule: app.schedule, world: app.world, res: app.gpuUi)
  # The first layout has run, so the selection hook can read computed rects.
  inspectorAfterLoad(
    inspector: app.inspector
    world: app.world
    pageRoot: app.document.pageRoot
    designW: app.document.designW
    selectNodeId: app.testSelectNodeId
  )
  inspectorSystem(
    inspector: app.inspector
    world: app.world
    input: input
    pageRoot: app.document.pageRoot
    chromeVisible: app.chrome.visible
    designW: app.document.designW
  )
  listViewSystem(world: app.world, scenes: app.document.registry)
  runScheduledUiSystems(schedule: app.schedule, world: app.world, res: app.gpuUi)
  var renderedOnce: Bool = false
  var wokeUp: Bool = false
  var previousNow: Float64 = Gpu2d.nowSeconds()
  var animating: Bool = false
  var effectTime: Float = 0.0

  loop not Gpu2d.pollClose() {
    var changed: Bool = viewportSystem(viewport: app.viewport)
    updateUiInput(input: input, world: app.world)
    let hadEvents: Bool = uiActionCount(world: app.world) > 0
    if Sdl3.isKeyPressed(key: Keys.keyH) {
      toggleChrome(chrome: app.chrome, world: app.world)
      changed = true
    }
    if Sdl3.isKeyPressed(key: Keys.keyD) {
      setDiagnosticsPanelOpen(chrome: app.chrome, world: app.world, open: not app.chrome.panelOpen)
      changed = true
    }
    let now: Float64 = Gpu2d.nowSeconds()
    if testRewriteSystem(watch: app.watch, path: app.document.path, now: now) {
      changed = true
    }
    if fileWatchSystem(watch: app.watch, paths: app.document.watchedPaths, now: now) {
      reloadDocument(app: app)
      changed = true
    }
    if inspectorSystem(
      inspector: app.inspector
      world: app.world
      input: input
      pageRoot: app.document.pageRoot
      chromeVisible: app.chrome.visible
      designW: app.document.designW
    ) {
      changed = true
    }
    # The effect systems (#1005) run every frame the document has any; while
    # one is live the loop stays a busy render loop (animating -> frame wait).
    var deltaTime: Float = (now - previousNow) as Float
    previousNow = now
    if deltaTime < 0.0 or deltaTime > 0.25 {
      deltaTime = 0.016667
    }
    effectTime = effectTime + deltaTime
    animating = effectSystems(
      app: app
      deltaTime: deltaTime
      clock: effectTime
      input: input
    )
    if animating {
      changed = true
    }
    if hadEvents or changed {
      listViewSystem(world: app.world, scenes: app.document.registry)
      runScheduledUiSystems(schedule: app.schedule, world: app.world, res: app.gpuUi)
    }
    let needsRender: Bool = hadEvents or changed or wokeUp or renderedOnce is false
    wokeUp = false
    if Gpu2d.shouldRenderFrame(appNeedsRender: needsRender) {
      Gpu2d.beginFrame(
        canvas: app.canvas
        r: 0.04
        g: 0.04
        b: 0.05
        a: 1.0
      )
      renderSystemGpu2d(world: app.world, res: app.gpuUi, canvas: app.canvas)
      Gpu2d.endFrame(canvas: app.canvas)
      renderedOnce = true
    } else {
      # The watcher is a poll, so the wait is bounded by its interval while
      # the window can show a reload; a hidden window sleeps on the heartbeat.
      Gpu2d.waitEvents(timeoutSec: nextWaitTimeoutSec(
        animating: animating
        mouseDown: false
        pollWatcher: Gpu2d.renderableNow()
        frameSec: 0.016667
        heartbeatSec: idleHeartbeatSec
      ))
      wokeUp = true
    }
  }
  canvasShutdown(canvas: app.canvas)
  Gpu2d.closeWindow()
  ret 0
}
