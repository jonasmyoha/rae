# viewportSystem — the window and the chrome's coordinate space (docs/
# ui-editor-design.md §2). The editor is a DESKTOP app: the window opens
# landscape (1400x900 logical, RAE_UI_EDITOR_WINDOW=WxH overrides, resizable)
# and the chrome is laid out to fill the window, re-applied on every resize, so its top bar is
# the same physical size on any display. Today the chrome is in logical points (1 unit per
# point), the transitional layout; the standard (docs/ui-coordinate-and-responsive-layout.md,
# rules 1-2) is du, 3 per point, which [ui coords 4/7] moves the chrome to. The document keeps its
# own frame (its design extent, column
# and safe insets — the device frame for a phone-authored scene) and is placed
# in the chrome's EditArea by the camera (cameraSystem), which fits it on load
# and zooms/pans it after; the chrome never scales with the document.
import Gpu2d
import Math
open Sys
open ui/Ecs
open ui/Components
open ui/DevicePresets
open ui/DesignUnits
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ecs/Schedule

# The page column of a page shown on a phone: 360 pt, the conventional phone
# content width (106's phoneFrameW)
const phoneColumnPt: Float = 360.0

const defaultDeviceId: String = "iphone-15-pro"

# The device frame a page is laid out in, what 106's ResponsiveExtent gives on
# that phone: the preset's size in design units (points), a centered 360 pt
# column for the page, and the preset's safe-area insets. Enabled for a page
# (a scene whose root has no Rect) while the preset is not "none".
# RAE_UI_EDITOR_DEVICE=<preset id|none> picks the preset (default
# iphone-15-pro).
type DeviceFrame {
  enabled: Bool
  presetId: String
  extentW: Float
  extentH: Float
  columnW: Float
  safeInsets: Insets
}

func editorDeviceFrame(pageScene: view Bool) ret DeviceFrame {
  var frame: DeviceFrame = {
    enabled: false
    presetId: "none"
    extentW: 0.0
    extentH: 0.0
    columnW: 0.0
    safeInsets: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  }
  if pageScene is false {
    ret frame
  }
  var id: String = getEnv(name: "RAE_UI_EDITOR_DEVICE")
  if id.length() is 0 {
    id = defaultDeviceId
  }
  let preset: DevicePreset = devicePresetById(id: id)
  if preset.width <= 0.0 or preset.height <= 0.0 {
    ret frame
  }
  frame.enabled = true
  frame.presetId = "{preset.id}"
  frame.extentW = devicePresetWidthDu(preset: preset)
  frame.extentH = devicePresetHeightDu(preset: preset)
  frame.columnW = Math.min(a: duFromPoints(points: phoneColumnPt), b: frame.extentW)
  frame.safeInsets = devicePresetSafeInsetsDu(preset: preset)
  ret frame
}

const defaultWindowW: Int = 1400

const defaultWindowH: Int = 900

type ViewportSystem {
  windowW: Int
  windowH: Int
  designW: Float
  designH: Float
}

# `WxH` from `name`, or the defaults when unset or malformed.
func envSizeOr(name: view String, fallbackW: view Int, fallbackH: view Int) ret ViewportSystem {
  var viewportSystem: ViewportSystem = {
    windowW: fallbackW
    windowH: fallbackH
    designW: fallbackW.toFloat()
    designH: fallbackH.toFloat()
  }
  let text: String = getEnv(name: name)
  if let x: Int = text.indexOf(sub: "x") {
    if x > 0 {
      let w: Int = text.sub(start: 0, len: x).toInt()
      let h: Int = text.sub(start: x + 1, len: text.length() - x - 1).toInt()
      if w > 0 and h > 0 {
        viewportSystem.windowW = w
        viewportSystem.windowH = h
      }
    }
  }
  ret viewportSystem
}

func createViewportSystem() ret ViewportSystem {
  ret envSizeOr(name: "RAE_UI_EDITOR_WINDOW", fallbackW: defaultWindowW, fallbackH: defaultWindowH)
}

# The chrome's design space = the window's logical size (physical pixels over
# the display's pixel ratio): 1 design unit = 1 point. Applied at boot and on
# every resize; the world lays out against it.
func applyChromeViewport(viewportSystem: mod ViewportSystem, world: mod UiWorld) {
  var dpr: Float = Gpu2d.dpr()
  if dpr <= 0.0 {
    dpr = 1.0
  }
  viewportSystem.designW = Gpu2d.windowWidth().toFloat() / dpr
  viewportSystem.designH = Gpu2d.windowHeight().toFloat() / dpr
  if viewportSystem.designW <= 0.0 or viewportSystem.designH <= 0.0 {
    viewportSystem.designW = viewportSystem.windowW.toFloat()
    viewportSystem.designH = viewportSystem.windowH.toFloat()
  }
  Gpu2d.setDesignResolution(width: viewportSystem.designW, height: viewportSystem.designH, fit: 0)
  world.layoutW = viewportSystem.designW
  world.layoutH = viewportSystem.designH
}

# Pin the document's page root to its frame's origin. A scene root may carry
# `ExtentAnchor: Center` (106's pages do, to center in the app's wider
# layout); mounted onto the page root that would center the page in the
# WINDOW's layout extent. In the editor the frame is the extent and the
# camera places the column (documentHomeX), so the root anchors left.
func pinDocumentPage(world: mod UiWorld, pageRoot: view EntityId) {
  if isNone(this: pageRoot) {
    ret
  }
  let anchor: ExtentAnchor = { h: HExtent.left }
  componentSet(this: world.extentAnchors, entityId: pageRoot, data: anchor)
}

# The document column's x inside its own frame (centered in the frame's
# extent) — the camera's home; the root itself lays out at (0, 0).
func documentHomeX(designW: view Float, columnW: view Float) ret Float {
  var slack: Float = designW - columnW
  if slack < 0.0 {
    slack = 0.0
  }
  ret slack / 2.0
}

# Size the chrome's page root to the design space on every load (it was
# mounted with the first document's size; the design can change per file).
func sizeChromePage(
  world: mod UiWorld
  chromeRoot: view EntityId
  viewportSystem: view ViewportSystem
) {
  if isNone(this: chromeRoot) or componentHas(this: world.rects, entityId: chromeRoot) is false {
    ret
  }
  let rect: mod Rect = componentMod(this: world.rects, entityId: chromeRoot)
  rect.size.x = viewportSystem.designW
  rect.size.y = viewportSystem.designH
}

# A window resize re-derives the chrome's design space and relayouts the
# chrome; the caller re-fits the camera. Returns whether the window changed.
# `resized` is this frame's one-shot Gpu2d.windowResized(), read ONCE by the
# loop (reading clears it) and shared with the window-geometry writer.
func viewportUpdate(
  viewportSystem: mod ViewportSystem
  world: mod UiWorld
  chromeRoot: view EntityId
  resized: view Bool
) ret Bool {
  if resized is false {
    ret false
  }
  # The platform reports a resize on the first frame of a new window too;
  # only a size that actually differs is a resize (a spurious one would
  # re-fit the camera and cancel a boot zoom).
  let beforeW: Float = viewportSystem.designW
  let beforeH: Float = viewportSystem.designH
  applyChromeViewport(viewportSystem: viewportSystem, world: world)
  if viewportSystem.designW is beforeW and viewportSystem.designH is beforeH {
    ret false
  }
  sizeChromePage(world: world, chromeRoot: chromeRoot, viewportSystem: viewportSystem)
  ret true
}
