# viewportSystem — the window and the chrome's coordinate space (docs/
# ui-editor-design.md §2). The editor is a DESKTOP app: the window opens
# landscape (1400x900 logical, RAE_UI_EDITOR_WINDOW=WxH overrides, resizable)
# and the chrome is authored in logical POINTS — the design resolution is the
# window's logical size, re-applied on every resize, so a 44pt top bar is 44pt
# on any display. The document keeps its own frame (its design extent, column
# and safe insets — the device frame for a phone-authored scene) and is placed
# in the chrome's EditArea by the camera (cameraSystem), which fits it on load
# and zooms/pans it after; the chrome never scales with the document.
import Gpu2d
open Sys
open ui/Ecs
open ui/Components
open ui/DevicePresets
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ecs/Schedule

# The page column of a phone-authored scene: 360pt, the conventional phone
# content width (106's phoneFrameW is exactly 360 x its unitScale 3 = 1080).
const phoneColumnPt: Float = 360.0

const defaultDeviceId: String = "iphone-15-pro"

# The device frame a phone-authored scene is laid out in — what 106's
# Viewport.rae computes for the app: the preset's size in design units
# (pt x unitScale), a centered 360pt column for the page, and the preset's
# safe-area insets. Enabled when the scene declares `unitScale` and the
# preset is not "none". RAE_UI_EDITOR_DEVICE=<preset id|none> picks the
# preset (default iphone-15-pro, 106's own default).
type EditorDeviceFrame {
  enabled: Bool
  presetId: String
  extentW: Float
  extentH: Float
  columnW: Float
  safeInsets: Insets
}

func editorDeviceFrame(unitScale: view Float) ret EditorDeviceFrame {
  var frame: EditorDeviceFrame = {
    enabled: false
    presetId: "none"
    extentW: 0.0
    extentH: 0.0
    columnW: 0.0
    safeInsets: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  }
  if unitScale <= 0.0 {
    ret frame
  }
  var id: String = getEnv(name: "RAE_UI_EDITOR_DEVICE")
  if id.length() is 0 {
    id = defaultDeviceId
  }
  let preset: DevicePreset = devicePresetById(id: id)
  if preset.width <= 0.0 or preset.height <= 0.0 {
    ret frame
  }
  frame.enabled = true
  frame.presetId = "{preset.id}"
  frame.extentW = preset.width * unitScale
  frame.extentH = preset.height * unitScale
  frame.columnW = phoneColumnPt * unitScale
  if frame.columnW > frame.extentW {
    frame.columnW = frame.extentW
  }
  frame.safeInsets = Insets {
    l: preset.safeLeft * unitScale
    t: preset.safeTop * unitScale
    r: preset.safeRight * unitScale
    b: preset.safeBottom * unitScale
  }
  ret frame
}

const defaultWindowW: Int = 1400

const defaultWindowH: Int = 900

type EditorViewport {
  windowW: Int
  windowH: Int
  designW: Float
  designH: Float
}

# `WxH` from `name`, or the defaults when unset or malformed.
func envSizeOr(name: view String, fallbackW: view Int, fallbackH: view Int) ret EditorViewport {
  var viewport: EditorViewport = {
    windowW: fallbackW
    windowH: fallbackH
    designW: fallbackW.toFloat()
    designH: fallbackH.toFloat()
  }
  let text: String = getEnv(name: name)
  let x: Int = text.indexOf(sub: "x")
  if x > 0 {
    let w: Int = text.sub(start: 0, len: x).toInt()
    let h: Int = text.sub(start: x + 1, len: text.length() - x - 1).toInt()
    if w > 0 and h > 0 {
      viewport.windowW = w
      viewport.windowH = h
    }
  }
  ret viewport
}

func createEditorViewport() ret EditorViewport {
  ret envSizeOr(name: "RAE_UI_EDITOR_WINDOW", fallbackW: defaultWindowW, fallbackH: defaultWindowH)
}

# The chrome's design space = the window's logical size (physical pixels over
# the display's pixel ratio): 1 design unit = 1 point. Applied at boot and on
# every resize; the world lays out against it.
func applyChromeViewport(viewport: mod EditorViewport, world: mod UiWorld) {
  var dpr: Float = Gpu2d.dpr()
  if dpr <= 0.0 {
    dpr = 1.0
  }
  viewport.designW = Gpu2d.windowWidth().toFloat() / dpr
  viewport.designH = Gpu2d.windowHeight().toFloat() / dpr
  if viewport.designW <= 0.0 or viewport.designH <= 0.0 {
    viewport.designW = viewport.windowW.toFloat()
    viewport.designH = viewport.windowH.toFloat()
  }
  Gpu2d.setDesignResolution(width: viewport.designW, height: viewport.designH, fit: 0)
  world.layoutW = viewport.designW
  world.layoutH = viewport.designH
}

# Pin the document's page root to its frame's origin. A scene root may carry
# `ExtentAnchor: Center` (106's pages do, to centre in the app's wider
# layout); mounted onto the page root that would centre the page in the
# WINDOW's layout extent. In the editor the frame is the extent and the
# camera places the column (documentHomeX), so the root anchors left.
func pinDocumentPage(world: mod UiWorld, pageRoot: view EntityId) {
  if isNone(this: pageRoot) {
    ret
  }
  let anchor: ExtentAnchor = { h: HExtent.left }
  componentSet(this: world.extentAnchors, entity: pageRoot, data: anchor)
}

# The document column's x inside its own frame (centered in the frame's
# extent) — the camera's home; the root itself lays out at (0, 0).
func documentHomeX(designW: view Float, columnW: view Float) ret Float {
  var slack: Float = designW - columnW
  if slack < 0.0 {
    slack = 0.0
  }
  ret slack / 2.0
}

# Size the chrome's page root to the design space on every load (it was
# mounted with the first document's size; the design can change per file).
func sizeChromePage(world: mod UiWorld, chromeRoot: view EntityId, viewport: view EditorViewport) {
  if isNone(this: chromeRoot) or componentHas(this: world.rects, entity: chromeRoot) is false {
    ret
  }
  let rect: mod Rect => componentMod(this: world.rects, entity: chromeRoot)
  rect.size.x = viewport.designW
  rect.size.y = viewport.designH
}

# A window resize re-derives the chrome's design space and relayouts the
# chrome; the caller re-fits the camera. Returns whether the window changed.
func viewportSystem(
  viewport: mod EditorViewport
  world: mod UiWorld
  chromeRoot: view EntityId
) ret Bool {
  if Gpu2d.windowResized() is false {
    ret false
  }
  applyChromeViewport(viewport: viewport, world: world)
  sizeChromePage(world: world, chromeRoot: chromeRoot, viewport: viewport)
  ret true
}
