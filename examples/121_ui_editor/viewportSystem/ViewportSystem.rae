# viewportSystem — the window and the letterbox (docs/ui-editor-design.md §2):
# the window opens 9:16 (540x960 logical, RAE_UI_EDITOR_WINDOW=WxH overrides,
# resizable), and the DESIGN resolution is fitted with `contain` so a phone
# scene stays a phone in any window shape. A resize only re-fits; the layout
# size the world sees is always the design size.
#
# The design resolution is the LARGER of the document's design and the
# chrome's own 1080x1920, per axis. The chrome and the document share one
# canvas, so if the design simply followed the document, opening a small
# scene (a 993x130 list row) shrank the chrome into the letterboxed strip —
# top bar clipped, status bar and Open button gone. Now the chrome always
# lays out in at least its own space; a document smaller than that keeps its
# authored size and sits centered in it (a translation, never a scale — the
# renderer draws authored pixels 1:1).
import Gpu2d
open Sys
open ui/Ecs
open ui/Components
open ui/DevicePresets
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ecs/Schedule

const chromeDesignW: Float = 1080.0

const chromeDesignH: Float = 1920.0

# The page column of a phone-authored scene: 360pt, the conventional phone
# content width (106's phoneFrameW is exactly 360 x its unitScale 3 = 1080).
const phoneColumnPt: Float = 360.0

const defaultDeviceId: String = "iphone-15-pro"

# The device frame a phone-authored scene is laid out in — what 106's
# Viewport.rae computes for the app: the preset's size in design units
# (pt x unitScale), a centered 360pt column for the page, and the preset's
# safe-area insets. Enabled when the scene declares `unitScale` and the
# preset is not "none". RAE_UI_EDITOR_DEVICE=<preset id|none> picks the
# preset (default iphone-15-pro, 106's own default).
type EditorDeviceFrame {
  enabled: Bool
  presetId: String
  extentW: Float
  extentH: Float
  columnW: Float
  safeInsets: Insets
}

func editorDeviceFrame(unitScale: view Float) ret EditorDeviceFrame {
  var frame: EditorDeviceFrame = {
    enabled: false
    presetId: "none"
    extentW: 0.0
    extentH: 0.0
    columnW: 0.0
    safeInsets: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  }
  if unitScale <= 0.0 {
    ret frame
  }
  var id: String = getEnv(name: "RAE_UI_EDITOR_DEVICE")
  if id.length() is 0 {
    id = defaultDeviceId
  }
  let preset: DevicePreset = devicePresetById(id: id)
  if preset.width <= 0.0 or preset.height <= 0.0 {
    ret frame
  }
  frame.enabled = true
  frame.presetId = "{preset.id}"
  frame.extentW = preset.width * unitScale
  frame.extentH = preset.height * unitScale
  frame.columnW = phoneColumnPt * unitScale
  if frame.columnW > frame.extentW {
    frame.columnW = frame.extentW
  }
  frame.safeInsets = Insets {
    l: preset.safeLeft * unitScale
    t: preset.safeTop * unitScale
    r: preset.safeRight * unitScale
    b: preset.safeBottom * unitScale
  }
  ret frame
}

const defaultWindowW: Int = 540

const defaultWindowH: Int = 960

type EditorViewport {
  windowW: Int
  windowH: Int
  designW: Float
  designH: Float
}

# `WxH` from `name`, or the defaults when unset or malformed.
func envSizeOr(name: view String, fallbackW: view Int, fallbackH: view Int) ret EditorViewport {
  var viewport: EditorViewport = {
    windowW: fallbackW
    windowH: fallbackH
    designW: fallbackW.toFloat()
    designH: fallbackH.toFloat()
  }
  let text: String = getEnv(name: name)
  let x: Int = text.indexOf(sub: "x")
  if x > 0 {
    let w: Int = text.sub(start: 0, len: x).toInt()
    let h: Int = text.sub(start: x + 1, len: text.length() - x - 1).toInt()
    if w > 0 and h > 0 {
      viewport.windowW = w
      viewport.windowH = h
    }
  }
  ret viewport
}

func createEditorViewport() ret EditorViewport {
  ret envSizeOr(name: "RAE_UI_EDITOR_WINDOW", fallbackW: defaultWindowW, fallbackH: defaultWindowH)
}

# Point the 2D canvas at the design resolution (fit 0 = contain, letterboxed)
# and size the world's layout to it. `designW`/`designH` are the DOCUMENT's;
# the resolution applied is at least the chrome's.
func applyViewport(
  viewport: mod EditorViewport
  world: mod UiWorld
  designW: view Float
  designH: view Float
) {
  viewport.designW = designW
  viewport.designH = designH
  if viewport.designW < chromeDesignW {
    viewport.designW = chromeDesignW
  }
  if viewport.designH < chromeDesignH {
    viewport.designH = chromeDesignH
  }
  Gpu2d.setDesignResolution(width: viewport.designW, height: viewport.designH, fit: 0)
  world.layoutW = viewport.designW
  world.layoutH = viewport.designH
}

# Place the document's page root in the design space: centered horizontally
# (the root's extent anchor) and vertically (a runtime translation, applied
# in the transform pass like a scroll — no relayout), so a document smaller
# than the design does not hug the top-left corner under the chrome's bar.
func placeDocumentPage(
  world: mod UiWorld
  pageRoot: view EntityId
  viewport: view EditorViewport
  designH: view Float
) {
  if isNone(this: pageRoot) {
    ret
  }
  let anchor: ExtentAnchor = { h: HExtent.center }
  componentSet(this: world.extentAnchors, entity: pageRoot, data: anchor)
  var slack: Float = viewport.designH - designH
  if slack < 0.0 {
    slack = 0.0
  }
  let offset: RuntimeOffset = { delta: Vec2 { x: 0.0, y: slack / 2.0 } }
  componentSet(this: world.runtimeOffsets, entity: pageRoot, data: own offset)
}

# Size the chrome's page root to the design space on every load (it was
# mounted with the first document's size; the design can change per file).
func sizeChromePage(world: mod UiWorld, chromeRoot: view EntityId, viewport: view EditorViewport) {
  if isNone(this: chromeRoot) or componentHas(this: world.rects, entity: chromeRoot) is false {
    ret
  }
  let rect: mod Rect => componentMod(this: world.rects, entity: chromeRoot)
  rect.size.x = viewport.designW
  rect.size.y = viewport.designH
}

# A window resize re-fits the same design resolution; the layout is unchanged.
# Returns whether the window changed (a repaint is due).
func viewportSystem(viewport: view EditorViewport) ret Bool {
  if Gpu2d.windowResized() is false {
    ret false
  }
  Gpu2d.setDesignResolution(width: viewport.designW, height: viewport.designH, fit: 0)
  ret true
}
