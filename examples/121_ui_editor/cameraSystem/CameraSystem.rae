# cameraSystem — zoom and pan of the DOCUMENT (docs/ui-editor-design.md §2,
# the reference editor's camera, docs/ui-editor-reference-features.md §7).
# The camera is a scale + offset applied to the document page root and the
# guides page root as a TransformFx (scale about the origin) plus a
# RuntimeOffset — the transform-pass inputs a scroll uses — so the stock
# transform, render and input systems do the rest: an inherited world scale
# sizes every box, glyph, clip and hit test. The chrome is untouched.
#
# `canvas` coordinates below are the chrome's design space in points (what
# Gpu2d.pointerX reports); a document FRAME point f sits at offset + f * zoom.
# On load the frame is FITTED into the chrome's EditArea (the space between
# the panels); the wheel then zooms about the cursor (0.25x .. 5x), the middle
# button drags the view, the chrome's zoom pill steps +-10% about the area's
# centre and its "100%" label shows the frame at 1 point per design unit,
# centred; `F` fits again. RAE_UI_EDITOR_ZOOM=<factor> boots zoomed (the
# headless gate).
import Gpu2d
import Sdl3
import Keys
open Sys
open ui/Ecs
open ui/Components
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable

const zoomMin: Float = 0.25

const zoomMax: Float = 5.0

const zoomWheelStep: Float = 0.1

const zoomButtonStep: Float = 0.1

# The margin the fit leaves around the frame, in points.
const fitMargin: Float = 24.0

# The chrome's edit area — the space between the panels the document is
# fitted into; (0, 0, canvasW, canvasH) until the chrome has laid out.
type EditArea {
  x: Float
  y: Float
  w: Float
  h: Float
}

func editAreaOf(world: view UiWorld, canvasW: view Float, canvasH: view Float) ret EditArea {
  var area: EditArea = { x: 0.0, y: 0.0, w: canvasW, h: canvasH }
  let entity: EntityId = nodeEntityFor(world: world, nodeId: "chrome/EditArea")
  if isNone(this: entity) {
    ret area
  }
  if componentHas(this: world.computedRects, entity: entity) and componentHas(
    this: world.worldTransforms
    entity: entity
  ) {
    let rect: ComputedRect = componentGet(this: world.computedRects, entity: entity)
    let transform: WorldTransform2D = componentGet(this: world.worldTransforms, entity: entity)
    if rect.size.x > 0.0 and rect.size.y > 0.0 {
      area.x = transform.position.x
      area.y = transform.position.y
      area.w = rect.size.x
      area.h = rect.size.y
    }
  }
  ret area
}

type EditorCamera {
  zoom: Float
  # The frame's translation in the chrome's space (the guides root's); the
  # document root gets the same camera with its column offset folded in.
  offsetX: Float
  offsetY: Float
  # The document column's x inside its frame (0 for a full-width document).
  homeX: Float
  homeY: Float
  # The frame's extent, for fit / centre.
  frameW: Float
  frameH: Float
  # Middle-drag pan state.
  panning: Bool
  lastPointerX: Float
  lastPointerY: Float
}

func createEditorCamera() ret EditorCamera {
  var camera: EditorCamera = {
    zoom: 1.0
    offsetX: 0.0
    offsetY: 0.0
    homeX: 0.0
    homeY: 0.0
    frameW: 1080.0
    frameH: 1920.0
    panning: false
    lastPointerX: 0.0
    lastPointerY: 0.0
  }
  ret camera
}

# RAE_UI_EDITOR_ZOOM=<factor>: boot zoomed about the canvas centre (the
# headless gate's hook). Call once the home is set.
func bootCameraZoom(camera: mod EditorCamera, area: view EditArea) {
  let boot: String = getEnv(name: "RAE_UI_EDITOR_ZOOM")
  if boot.length() is 0 {
    ret
  }
  centerCamera(camera: camera, area: area, zoom: boot.toFloat())
  log(
    "[ui-editor] zoom {(camera.zoom * 100.0 + 0.5).toInt()}% offset {camera.offsetX.toInt()},{camera.offsetY.toInt()}"
  )
}

func clampZoom(zoom: view Float) ret Float {
  if zoom < zoomMin {
    ret zoomMin
  }
  if zoom > zoomMax {
    ret zoomMax
  }
  ret zoom
}

# The frame (called after every load): its extent and the column's x in it.
func setCameraFrame(
  camera: mod EditorCamera
  frameW: view Float
  frameH: view Float
  homeX: view Float
) {
  camera.frameW = frameW
  camera.frameH = frameH
  camera.homeX = homeX
  camera.homeY = 0.0
}

# Centre the frame in the edit area at `zoom`.
func centerCamera(camera: mod EditorCamera, area: view EditArea, zoom: view Float) {
  camera.zoom = clampZoom(zoom: zoom)
  camera.offsetX = area.x + (area.w - camera.frameW * camera.zoom) / 2.0
  camera.offsetY = area.y + (area.h - camera.frameH * camera.zoom) / 2.0
}

# Fit the whole frame into the edit area with a margin, centred.
func fitCamera(camera: mod EditorCamera, area: view EditArea) {
  var zoomW: Float = 1.0
  var zoomH: Float = 1.0
  if camera.frameW > 0.0 {
    zoomW = (area.w - fitMargin * 2.0) / camera.frameW
  }
  if camera.frameH > 0.0 {
    zoomH = (area.h - fitMargin * 2.0) / camera.frameH
  }
  var zoom: Float = zoomW
  if zoomH < zoom {
    zoom = zoomH
  }
  centerCamera(camera: camera, area: area, zoom: zoom)
}

# Zoom so the canvas point (aboutX, aboutY) stays where it is.
func zoomCameraAbout(
  camera: mod EditorCamera
  zoom: view Float
  aboutX: view Float
  aboutY: view Float
) {
  let next: Float = clampZoom(zoom: zoom)
  if next is camera.zoom {
    ret
  }
  let ratio: Float = next / camera.zoom
  camera.offsetX = aboutX - (aboutX - camera.offsetX) * ratio
  camera.offsetY = aboutY - (aboutY - camera.offsetY) * ratio
  camera.zoom = next
}

func setRootTransform(
  world: mod UiWorld
  root: view EntityId
  zoom: view Float
  offsetX: view Float
  offsetY: view Float
) {
  if isNone(this: root) {
    ret
  }
  let fx: TransformFx = {
    scaleX: zoom
    scaleY: zoom
    rotation: 0.0
    alpha: 1.0
    visible: true
    pivot: Vec2 { x: 0.0, y: 0.0 }
    anchor: Vec2 { x: 0.0, y: 0.0 }
  }
  componentSet(this: world.transforms, entity: root, data: fx)
  let offset: RuntimeOffset = { delta: Vec2 { x: offsetX, y: offsetY } }
  componentSet(this: world.runtimeOffsets, entity: root, data: own offset)
}

# Write the camera onto the two roots. Both lay out at (0, 0); the document
# root is the column, which sits at homeX inside the frame, so it gets the
# frame's translation plus the scaled column offset; the guides root is the
# frame itself.
func applyCamera(
  camera: view EditorCamera
  world: mod UiWorld
  documentRoot: view EntityId
  guidesRoot: view EntityId
) {
  let z: Float = camera.zoom
  setRootTransform(
    world: world
    root: guidesRoot
    zoom: z
    offsetX: camera.offsetX
    offsetY: camera.offsetY
  )
  setRootTransform(
    world: world
    root: documentRoot
    zoom: z
    offsetX: camera.offsetX + camera.homeX * z
    offsetY: camera.offsetY + camera.homeY * z
  )
  setNodeText(world: world, nodeId: "chrome/ZoomLabel", value: "{(z * 100.0 + 0.5).toInt()}%")
}

# Per-frame input: wheel = zoom about the cursor, middle drag = pan, the
# chrome pill's actions. Returns whether the camera moved.
func cameraInputSystem(
  camera: mod EditorCamera
  world: view UiWorld
  area: view EditArea
) ret Bool {
  var moved: Bool = false
  let pointerX: Float = Gpu2d.pointerX()
  let pointerY: Float = Gpu2d.pointerY()
  let wheel: Float = Gpu2d.wheelMove()
  if wheel is not 0.0 {
    zoomCameraAbout(
      camera: camera
      zoom: camera.zoom * (1.0 + zoomWheelStep * wheel)
      aboutX: pointerX
      aboutY: pointerY
    )
    moved = true
  }
  let middle: Bool = Sdl3.isMouseButtonDown(button: 2)
  if middle {
    if camera.panning {
      camera.offsetX = camera.offsetX + (pointerX - camera.lastPointerX)
      camera.offsetY = camera.offsetY + (pointerY - camera.lastPointerY)
      moved = true
    }
    camera.panning = true
    camera.lastPointerX = pointerX
    camera.lastPointerY = pointerY
  } else {
    camera.panning = false
  }
  let centreX: Float = area.x + area.w / 2.0
  let centreY: Float = area.y + area.h / 2.0
  if uiActionFired(world: world, actionId: "zoom.in") {
    zoomCameraAbout(
      camera: camera
      zoom: camera.zoom + zoomButtonStep
      aboutX: centreX
      aboutY: centreY
    )
    moved = true
  }
  if uiActionFired(world: world, actionId: "zoom.out") {
    zoomCameraAbout(
      camera: camera
      zoom: camera.zoom - zoomButtonStep
      aboutX: centreX
      aboutY: centreY
    )
    moved = true
  }
  if uiActionFired(world: world, actionId: "zoom.reset") {
    centerCamera(camera: camera, area: area, zoom: 1.0)
    moved = true
  }
  if Sdl3.isKeyPressed(key: Keys.keyF) {
    fitCamera(camera: camera, area: area)
    moved = true
  }
  ret moved
}
