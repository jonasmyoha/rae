# cameraSystem — the INPUT side of zoom and pan (docs/ui-editor-design.md §2,
# the reference editor's cameraSystem, docs/ui-editor-reference-features.md §7).
# The cameraSystem itself is the lib `Camera2D` component on the guides page root
# (the frame's translation and zoom in the chrome's space); the document
# page root carries a derived Camera2D with the column offset folded in. The
# lib cameraSystem (ui/cameraSystem, in the Pipeline) turns both into the
# roots' TransformFx + RuntimeOffset, so the stock transform, render and
# input systems do the rest. What lives here is only what reads input and
# writes the component: the wheel zooms about the cursor (0.25x .. 5x), the
# middle button drags the view, the chrome's zoom pill steps +-10% about the
# edit area's centre and its "100%" label centres the frame at 1 point per
# design unit, `F` fits the frame into the area, and a load fits it.
# RAE_UI_EDITOR_ZOOM=<factor> boots zoomed (the headless gate).
import Gpu2d
import Sdl3
import Keys
open Sys
open ui/Ecs
open ui/Components
open ecs/Entity
open ecs/ComponentTable
open ui/inputSystem/InputSystem

const zoomMin: Float = 0.25

const zoomMax: Float = 5.0

const zoomWheelStep: Float = 0.1

const zoomButtonStep: Float = 0.1

# The margin the fit leaves around the frame, in points.
const fitMargin: Float = 24.0

# The editor's cameraSystem INPUT state: which roots carry the Camera2D, the
# frame's extent and column (for fit / centre / the document's derived
# offset), and the middle-drag pan in progress. Zoom and offset are NOT here
# — read them from the component (cameraOf).
type CameraSystem {
  guidesRoot: EntityId
  documentRoot: EntityId
  frameW: Float
  frameH: Float
  # The document column's x inside its frame (0 for a full-width document).
  homeX: Float
  panning: Bool
  lastPointerX: Float
  lastPointerY: Float
}

func createCameraSystem() ret CameraSystem {
  ret CameraSystem {
    guidesRoot: noEntity()
    documentRoot: noEntity()
    frameW: 1080.0
    frameH: 1920.0
    homeX: 0.0
    panning: false
    lastPointerX: 0.0
    lastPointerY: 0.0
  }
}

func clampZoom(zoom: view Float) ret Float {
  if zoom < zoomMin {
    ret zoomMin
  }
  if zoom > zoomMax {
    ret zoomMax
  }
  ret zoom
}

# The frame and its roots (called after every load — the document root is a
# new entity then): the extent, the column's x, and the two roots to write.
func setCameraFrame(
  cameraSystem: mod CameraSystem
  frameW: view Float
  frameH: view Float
  homeX: view Float
  documentRoot: view EntityId
  guidesRoot: view EntityId
) {
  cameraSystem.frameW = frameW
  cameraSystem.frameH = frameH
  cameraSystem.homeX = homeX
  cameraSystem.documentRoot = documentRoot
  cameraSystem.guidesRoot = guidesRoot
}

# The cameraSystem as the world has it: the guides root's Camera2D (identity
# until something wrote one).
func cameraOf(cameraSystem: view CameraSystem, world: view UiWorld) ret Camera2D {
  if isNone(this: cameraSystem.guidesRoot) or componentHas(
    this: world.cameras
    entityId: cameraSystem.guidesRoot
  ) is false {
    ret Camera2D { zoom: 1.0, offsetX: 0.0, offsetY: 0.0 }
  }
  ret componentGet(this: world.cameras, entityId: cameraSystem.guidesRoot)
}

# Write the cameraSystem: the guides root gets it as is; the document root gets it
# with the column offset folded in (the column sits at homeX inside the
# frame). The zoom label follows.
func writeCamera(
  cameraSystem: view CameraSystem
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  next: view Camera2D
) {
  if isNone(this: cameraSystem.guidesRoot) is false {
    componentSet(
      this: world.cameras
      entityId: cameraSystem.guidesRoot
      data: Camera2D { zoom: next.zoom, offsetX: next.offsetX, offsetY: next.offsetY }
    )
  }
  if isNone(this: cameraSystem.documentRoot) is false {
    componentSet(
      this: world.cameras
      entityId: cameraSystem.documentRoot
      data: Camera2D {
        zoom: next.zoom
        offsetX: next.offsetX + cameraSystem.homeX * next.zoom
        offsetY: next.offsetY
      }
    )
  }
  chromeSystem.zoomLabel = "{(next.zoom * 100.0 + 0.5).toInt()}%"
}

# Centre the frame in the edit area at `zoom`.
func centerCamera(
  cameraSystem: view CameraSystem
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  area: view EditAreaRect
  zoom: view Float
) {
  let z: Float = clampZoom(zoom: zoom)
  let next: Camera2D = {
    zoom: z
    offsetX: area.x + (area.w - cameraSystem.frameW * z) / 2.0
    offsetY: area.y + (area.h - cameraSystem.frameH * z) / 2.0
  }
  writeCamera(
    cameraSystem: cameraSystem
    world: world
    chromeSystem: chromeSystem
    next: next
  )
}

# Fit the whole frame into the edit area with a margin, centred.
func fitCamera(
  cameraSystem: view CameraSystem
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  area: view EditAreaRect
) {
  var zoomW: Float = 1.0
  var zoomH: Float = 1.0
  if cameraSystem.frameW > 0.0 {
    zoomW = (area.w - fitMargin * 2.0) / cameraSystem.frameW
  }
  if cameraSystem.frameH > 0.0 {
    zoomH = (area.h - fitMargin * 2.0) / cameraSystem.frameH
  }
  var zoom: Float = zoomW
  if zoomH < zoom {
    zoom = zoomH
  }
  centerCamera(
    cameraSystem: cameraSystem
    world: world
    chromeSystem: chromeSystem
    area: area
    zoom: zoom
  )
}

# Zoom so the canvas point (aboutX, aboutY) stays where it is.
func zoomCameraAbout(
  cameraSystem: view CameraSystem
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  zoom: view Float
  aboutX: view Float
  aboutY: view Float
) {
  let current: Camera2D = cameraOf(cameraSystem: cameraSystem, world: world)
  let z: Float = clampZoom(zoom: zoom)
  if z is current.zoom {
    ret
  }
  let ratio: Float = z / current.zoom
  let next: Camera2D = {
    zoom: z
    offsetX: aboutX - (aboutX - current.offsetX) * ratio
    offsetY: aboutY - (aboutY - current.offsetY) * ratio
  }
  writeCamera(
    cameraSystem: cameraSystem
    world: world
    chromeSystem: chromeSystem
    next: next
  )
}

# RAE_UI_EDITOR_ZOOM=<factor>: boot zoomed about the area's centre (the
# headless gate's hook). Call after the fit.
func bootCameraZoom(
  cameraSystem: view CameraSystem
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  area: view EditAreaRect
) {
  let boot: String = getEnv(name: "RAE_UI_EDITOR_ZOOM")
  if boot.length() is 0 {
    ret
  }
  centerCamera(
    cameraSystem: cameraSystem
    world: world
    chromeSystem: chromeSystem
    area: area
    zoom: boot.toFloat()
  )
  let now: Camera2D = cameraOf(cameraSystem: cameraSystem, world: world)
  log(
    "[ui-editor] zoom {(now.zoom * 100.0 + 0.5).toInt()}% offset {now.offsetX.toInt()},{now.offsetY.toInt()}"
  )
}

# Per-frame input: wheel = zoom about the cursor, middle drag = pan, the
# chrome pill's actions, `F` = fit. Returns whether the cameraSystem moved.
# The wheel is only the camera's when updateUiInput routed it to the EditArea
# (its `WheelTarget`): over the hierarchy it scrolls the list, over the
# inspector it does nothing. With the chrome hidden the canvas is the whole
# window, so every wheel notch zooms.
func cameraInputSystem(
  cameraSystem: mod CameraSystem
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  area: view EditAreaRect
  input: view UiInput
) ret Bool {
  var moved: Bool = false
  let pointerX: Float = Gpu2d.pointerX()
  let pointerY: Float = Gpu2d.pointerY()
  var wheel: Float = uiWheelFor(
    input: input
    entityId: editAreaEntityId(chromeSystem: chromeSystem)
  )
  if chromeVisible(world: world, chromeSystem: chromeSystem) is false {
    wheel = input.wheel
  }
  if wheel is not 0.0 {
    let current: Camera2D = cameraOf(cameraSystem: cameraSystem, world: world)
    zoomCameraAbout(
      cameraSystem: cameraSystem
      world: world
      chromeSystem: chromeSystem
      zoom: current.zoom * (1.0 + zoomWheelStep * wheel)
      aboutX: pointerX
      aboutY: pointerY
    )
    moved = true
  }
  let middle: Bool = Sdl3.isMouseButtonDown(button: 2)
  if middle {
    if cameraSystem.panning {
      let current: Camera2D = cameraOf(cameraSystem: cameraSystem, world: world)
      let next: Camera2D = {
        zoom: current.zoom
        offsetX: current.offsetX + (pointerX - cameraSystem.lastPointerX)
        offsetY: current.offsetY + (pointerY - cameraSystem.lastPointerY)
      }
      writeCamera(
        cameraSystem: cameraSystem
        world: world
        chromeSystem: chromeSystem
        next: next
      )
      moved = true
    }
    cameraSystem.panning = true
    cameraSystem.lastPointerX = pointerX
    cameraSystem.lastPointerY = pointerY
  } else {
    cameraSystem.panning = false
  }
  let centreX: Float = area.x + area.w / 2.0
  let centreY: Float = area.y + area.h / 2.0
  if uiActionFired(world: world, actionId: "zoom.in") {
    let current: Camera2D = cameraOf(cameraSystem: cameraSystem, world: world)
    zoomCameraAbout(
      cameraSystem: cameraSystem
      world: world
      chromeSystem: chromeSystem
      zoom: current.zoom + zoomButtonStep
      aboutX: centreX
      aboutY: centreY
    )
    moved = true
  }
  if uiActionFired(world: world, actionId: "zoom.out") {
    let current: Camera2D = cameraOf(cameraSystem: cameraSystem, world: world)
    zoomCameraAbout(
      cameraSystem: cameraSystem
      world: world
      chromeSystem: chromeSystem
      zoom: current.zoom - zoomButtonStep
      aboutX: centreX
      aboutY: centreY
    )
    moved = true
  }
  if uiActionFired(world: world, actionId: "zoom.reset") {
    centerCamera(
      cameraSystem: cameraSystem
      world: world
      chromeSystem: chromeSystem
      area: area
      zoom: 1.0
    )
    moved = true
  }
  if Sdl3.isKeyPressed(key: Keys.keyF) {
    fitCamera(
      cameraSystem: cameraSystem
      world: world
      chromeSystem: chromeSystem
      area: area
    )
    moved = true
  }
  ret moved
}
