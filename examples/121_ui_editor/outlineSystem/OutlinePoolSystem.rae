# outlinePoolSystem — the reference editor's "Outlines" and "Buttons"
# toggles (docs/ui-editor-reference-features.md §2b) as authored outline
# POOLS: a node in chrome/Guides.raescene tagged `OutlinePool { match,
# itemSceneId }` gets one mounted instance of `itemSceneId` per matched
# document entity (every entity, or every entity with an OnClick), each
# positioned over its target like the hover outline — the ListView row-pool
# shape, one authored scene per row. The pool node's Active is the toggle
# (an EditorPanel of kind outlines / buttons: `N` / `B`); while it is off the
# pool is emptied so nothing is laid out or drawn.
open ui/Ecs
open ui/Components
open ui/BindingComponents
open ui/Scene
open ui/SceneInstance
open ui/SceneLoader
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ecs/hierarchySystem/HierarchySystem
open ui/UiSystems

const outlinePoolCap: Int = 512

# The outline-pool system owns the authored `OutlinePool` components (the
# "Outlines" / "Buttons" pool roots in chrome/Guides.raescene).
type OutlinePoolSystem {
  outlinePools: ComponentTable(OutlinePool)
}

func createOutlinePoolSystem() ret OutlinePoolSystem {
  ret OutlinePoolSystem { outlinePools: ComponentTable.create(OutlinePool) }
}

# Every entity of the document subtree that has a world rect (paint order).
func collectDocumentEntities(
  world: view UiWorld
  uiSystems: view UiSystems
  entityId: view EntityId
  out: mod List(EntityId)
) {
  if isNone(this: entityId) or out.length >= outlinePoolCap {
    ret
  }
  if componentHas(this: uiSystems.layout.computedRects, entityId: entityId) and componentHas(
    this: uiSystems.transform2d.worldTransforms
    entityId: entityId
  ) {
    out.add(value: entityId)
  }
  if componentHas(this: world.childrens, entityId: entityId) {
    let children: view Children => componentView(this: world.childrens, entityId: entityId)
    loop var i: Int = 0, i < children.ids.length, ++i {
      collectDocumentEntities(
        world: world
        uiSystems: uiSystems
        entityId: children.ids.copyAtFallback(index: i, fallback: noEntity())
        out: out
      )
    }
  }
}

func poolMatches(
  world: view UiWorld
  matches: view OutlineMatch
  entityId: view EntityId
  selection: view List(EntityId)
  anchor: view EntityId
) ret Bool {
  if matches is OutlineMatch.buttons {
    ret componentHas(this: world.onClicks, entityId: entityId)
  }
  if matches is OutlineMatch.selection {
    # The anchor is deliberately skipped: it already has the single selection
    # outline, and drawing both over it would double its stroke. So for a
    # selection of one this pool is empty and the canvas looks exactly as it
    # did before multi-selection existed.
    if entityId is anchor {
      ret false
    }
    loop var i: Int = 0, i < selection.length, ++i {
      if let member: EntityId = selection.copyAt(index: i) {
        if member is entityId {
          ret true
        }
      }
    }
    ret false
  }
  ret true
}

# Grow or shrink the pool node's children to exactly `wanted` instances of
# the outline scene.
func sizeOutlinePool(
  world: mod UiWorld
  uiSystems: view UiSystems
  pool: view EntityId
  itemSceneId: view String
  wanted: view Int
  scenes: view SceneRegistry
) ret Bool {
  var changed: Bool = false
  var have: Int = 0
  if componentHas(this: world.childrens, entityId: pool) {
    have = componentView(this: world.childrens, entityId: pool).ids.length
  }
  loop have > wanted {
    let children: view Children => componentView(this: world.childrens, entityId: pool)
    let last: EntityId = children.ids.copyAtFallback(index: have - 1, fallback: noEntity())
    destroyEntitySubtree(world: world, uiSystems: uiSystems, root: last)
    have = have - 1
    changed = true
  }
  if have < wanted {
    let idx: Int = sceneRegistryIndex(reg: scenes, key: itemSceneId)
    if idx < 0 {
      ret changed
    }
    let scene: view Scene => sceneRegistryGet(reg: scenes, idx: idx)
    loop have < wanted {
      let item: EntityId = createEntity(world: world)
      let rect: Rect = { position: { x: 0.0, y: 0.0 }, size: { x: 0.0, y: 0.0 } }
      componentSet(this: world.rects, entityId: item, data: rect)
      setParent(
        parents: uiSystems.hierarchy.parents
        childrens: world.childrens
        child: item
        parent: pool
      )
      let overrides: List(SceneOverride) = emptyOverrides()
      mountSceneInstanceIntoPage(
        world: world
        uiSystems: uiSystems
        mountEntityId: item
        scene: scene
        overrides: overrides
        pageId: "guides"
      )
      have = have + 1
      changed = true
    }
  }
  ret changed
}

# Place pooled instance `item` over `target` (compare-before-write); true
# if anything was written.
func placePooledOutline(
  world: mod UiWorld
  uiSystems: view UiSystems
  item: view EntityId
  target: view EntityId
) ret Bool {
  var changed: Bool = false
  let transform: view WorldTransform2D => componentView(
    this: uiSystems.transform2d.worldTransforms
    entityId: target
  )
  let computed: view ComputedRect => componentView(
    this: uiSystems.layout.computedRects
    entityId: target
  )
  let w: Float = computed.size.x * transform.scale.x
  let h: Float = computed.size.y * transform.scale.y
  if componentHas(this: world.rects, entityId: item) {
    let current: view Rect => componentView(this: world.rects, entityId: item)
    if current.size.x is not w or current.size.y is not h {
      let rect: mod Rect => componentMod(this: world.rects, entityId: item)
      rect.size.x = w
      rect.size.y = h
      changed = true
    }
  }
  var write: Bool = true
  if componentHas(this: uiSystems.transform2d.runtimeOffsets, entityId: item) {
    let current: Vec2 = componentView(this: uiSystems.transform2d.runtimeOffsets, entityId: item).delta
    if current.x is transform.position.x and current.y is transform.position.y {
      write = false
    }
  }
  if write {
    let offset: RuntimeOffset = { delta: Vec2 { x: transform.position.x, y: transform.position.y } }
    componentSet(this: uiSystems.transform2d.runtimeOffsets, entityId: item, data: own offset)
    changed = true
  }
  ret changed
}

# Per frame: every active OutlinePool follows the document's entities.
# Returns whether any pool grew, shrank or moved (the transform pass must
# run this frame then).
func outlinePoolUpdate(
  outlinePoolSystem: view OutlinePoolSystem
  world: mod UiWorld
  uiSystems: view UiSystems
  documentRoot: view EntityId
  scenes: view SceneRegistry
  selection: view List(EntityId)
  anchor: view EntityId
) ret Bool {
  var changed: Bool = false
  let poolCount: Int = componentCount(this: outlinePoolSystem.outlinePools)
  if poolCount is 0 {
    ret false
  }
  var entities: List(EntityId) = List.create(EntityId, cap: 64)
  collectDocumentEntities(
    world: world
    uiSystems: uiSystems
    entityId: documentRoot
    out: entities
  )
  loop var p: Int = 0, p < poolCount, ++p {
    let pool: EntityId = componentEntityAt(this: outlinePoolSystem.outlinePools, i: p)
    let spec: view OutlinePool => queryViewAt(table: outlinePoolSystem.outlinePools, denseIndex: p)
    var active: Bool = true
    if componentHas(this: world.actives, entityId: pool) {
      active = componentView(this: world.actives, entityId: pool).value
    }
    if active is false {
      if sizeOutlinePool(
        world: world
        uiSystems: uiSystems
        pool: pool
        itemSceneId: spec.itemSceneId
        wanted: 0
        scenes: scenes
      ) {
        changed = true
      }
      continue
    }
    var matched: List(EntityId) = List.create(EntityId, cap: entities.length)
    loop var i: Int = 0, i < entities.length, ++i {
      let entityId: EntityId = entities.copyAtFallback(index: i, fallback: noEntity())
      if poolMatches(
        world: world
        matches: spec.matches
        entityId: entityId
        selection: selection
        anchor: anchor
      ) {
        matched.add(value: entityId)
      }
    }
    if sizeOutlinePool(
      world: world
      uiSystems: uiSystems
      pool: pool
      itemSceneId: spec.itemSceneId
      wanted: matched.length
      scenes: scenes
    ) {
      changed = true
    }
    if componentHas(this: world.childrens, entityId: pool) is false {
      continue
    }
    let children: view Children => componentView(this: world.childrens, entityId: pool)
    loop var i: Int = 0, i < matched.length and i < children.ids.length, ++i {
      if placePooledOutline(
        world: world
        uiSystems: uiSystems
        item: children.ids.copyAtFallback(index: i, fallback: noEntity())
        target: matched.copyAtFallback(index: i, fallback: noEntity())
      ) {
        changed = true
      }
    }
  }
  ret changed
}
