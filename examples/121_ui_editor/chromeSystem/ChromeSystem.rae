# chromeSystem — the editor's chrome is driven through COMPONENTS, never node
# ids (#32499842; the 106 shape, docs/ecs-general-architecture.md). The
# chrome scene authors `TextBinding { key: "editor.<name>" }` on every label,
# `EditorPanel` / `PanelToggle` on the panels and the pills that minimise
# them, `EditArea` on the space the document is fitted into, `EditorList` on
# the three lists and `DiagnosticsBadge` on the count pill; the systems here
# find them by table and write what the ChromeSystem resource says.
open ui/Ecs
open ui/Components
open ui/BindingComponents
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable
open ecs/Event
open ui/UiSystems

# What the chrome shows, as data: every `editor.*` text the labels bind to.
# The app fills it after a load, a selection, a camera move; editorTextSystem
# writes it into the bound Text nodes.
# The chrome system (docs/ecs-systems-own-their-tables.md §3): it OWNS the
# chrome's authored components — its tables, no longer lib/ui's — and the
# state its update functions write: the chrome page root (so H can hide it;
# whether the chrome or a panel is open is the node's own Active, read via
# chromeVisible / editorPanelOpen, never a mirror) and what the chrome's bound
# labels show (editorTextSystem writes Text from these fields).
type ChromeSystem {
  editorPanels: ComponentTable(EditorPanel)
  panelToggles: ComponentTable(PanelToggle)
  editAreas: ComponentTable(EditArea)
  editorLists: ComponentTable(EditorList)
  diagnosticsBadges: ComponentTable(DiagnosticsBadge)
  pageRoot: EntityId
  fileName: String
  nodeCount: Int
  diagnosticsCount: Int
  designSize: String
  statusLine: String
  zoomLabel: String
  projectTitle: String
  frameLabel: String
  safeAreaLabel: String
  inspectorNodeId: String
  inspectorType: String
  inspectorComponents: String
  # The selected node's authored components no lib table matched — an app's
  # own, kept as authored; "" when none.
  inspectorAppComponents: String
  inspectorRect: String
  inspectorParents: String
}

func createChromeSystem() ret ChromeSystem {
  ret ChromeSystem {
    editorPanels: ComponentTable.create(EditorPanel)
    panelToggles: ComponentTable.create(PanelToggle)
    editAreas: ComponentTable.create(EditArea)
    editorLists: ComponentTable.create(EditorList)
    diagnosticsBadges: ComponentTable.create(DiagnosticsBadge)
    pageRoot: noEntity()
    fileName: ""
    nodeCount: 0
    diagnosticsCount: 0
    designSize: ""
    statusLine: ""
    zoomLabel: "100%"
    projectTitle: "Project"
    frameLabel: ""
    safeAreaLabel: ""
    inspectorNodeId: "nothing selected"
    inspectorType: "click a node, or use the arrows"
    inspectorComponents: ""
    inspectorAppComponents: ""
    inspectorRect: ""
    inspectorParents: ""
  }
}

# The chrome root's Active (absent = shown).
func chromeVisible(world: view UiWorld, chromeSystem: view ChromeSystem) ret Bool {
  if componentHas(this: world.actives, entity: chromeSystem.pageRoot) is false {
    ret true
  }
  ret componentGet(this: world.actives, entity: chromeSystem.pageRoot).value
}

func editorTextFor(chromeSystem: view ChromeSystem, key: view String) ret String {
  if key is "editor.fileName" {
    ret "{chromeSystem.fileName}"
  }
  if key is "editor.nodeCount" {
    ret "{chromeSystem.nodeCount} nodes"
  }
  if key is "editor.diagnosticsCount" {
    if chromeSystem.diagnosticsCount is 0 {
      ret "no diagnostics"
    }
    if chromeSystem.diagnosticsCount is 1 {
      ret "1 diagnostic"
    }
    ret "{chromeSystem.diagnosticsCount} diagnostics"
  }
  if key is "editor.designSize" {
    ret "{chromeSystem.designSize}"
  }
  if key is "editor.statusLine" {
    ret "{chromeSystem.statusLine}"
  }
  if key is "editor.zoomLabel" {
    ret "{chromeSystem.zoomLabel}"
  }
  if key is "editor.projectTitle" {
    ret "{chromeSystem.projectTitle}"
  }
  if key is "editor.frameLabel" {
    ret "{chromeSystem.frameLabel}"
  }
  if key is "editor.safeAreaLabel" {
    ret "{chromeSystem.safeAreaLabel}"
  }
  if key is "editor.inspector.nodeId" {
    ret "{chromeSystem.inspectorNodeId}"
  }
  if key is "editor.inspector.type" {
    ret "{chromeSystem.inspectorType}"
  }
  if key is "editor.inspector.components" {
    ret "{chromeSystem.inspectorComponents}"
  }
  if key is "editor.inspector.appComponents" {
    ret "{chromeSystem.inspectorAppComponents}"
  }
  if key is "editor.inspector.rect" {
    ret "{chromeSystem.inspectorRect}"
  }
  if key is "editor.inspector.parents" {
    ret "{chromeSystem.inspectorParents}"
  }
  ret ""
}

# Every `TextBinding` whose key is an `editor.*` key gets its Text from the
# status. Other keys (a document's own bindings, 106's `album.title`) are
# another app's and are left alone. Writes only on change, so an idle frame
# bumps no table generation.
func editorTextSystem(world: mod UiWorld, chromeSystem: view ChromeSystem) {
  let count: Int = componentCount(this: world.textBindings)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: world.textBindings, i: i)
    let binding: view TextBinding => componentView(this: world.textBindings, entity: entity)
    if binding.key.startsWith(prefix: "editor.") is false {
      continue
    }
    if componentHas(this: world.texts, entity: entity) is false {
      continue
    }
    let value: String = editorTextFor(chromeSystem: chromeSystem, key: binding.key)
    let current: view Text => componentView(this: world.texts, entity: entity)
    if current.text is value {
      continue
    }
    let text: mod Text => componentMod(this: world.texts, entity: entity)
    text.text = value
  }
}

# The diagnostics pill chooses its authored colour for the current state.
func diagnosticsBadgeSystem(
  chromeSystem: view ChromeSystem
  world: mod UiWorld
  diagnosticsCount: view Int
) {
  let count: Int = componentCount(this: chromeSystem.diagnosticsBadges)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: chromeSystem.diagnosticsBadges, i: i)
    let badge: view DiagnosticsBadge => componentView(
      this: chromeSystem.diagnosticsBadges
      entity: entity
    )
    var fill: RgbaColor = badge.clearFill
    if diagnosticsCount > 0 {
      fill = badge.errorFill
    }
    if componentHas(this: world.shapes, entity: entity) is false {
      continue
    }
    let current: Shape = componentGet(this: world.shapes, entity: entity)
    if current.fill.r is fill.r and current.fill.g is fill.g and current.fill.b is fill.b and current.fill.a is fill.a and current.fillSlot.length() is 0 {
      continue
    }
    let shape: mod Shape => componentMod(this: world.shapes, entity: entity)
    shape.fill = fill
    shape.fillSlot = ""
  }
}

# ----- panels ---------------------------------------------------------------

# Whether any EditorPanel of `kind` is active (the panel's own component is
# the truth — there is no mirror flag).
func editorPanelOpen(
  chromeSystem: view ChromeSystem
  world: view UiWorld
  kind: view EditorPanelKind
) ret Bool {
  let count: Int = componentCount(this: chromeSystem.editorPanels)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: chromeSystem.editorPanels, i: i)
    let panel: EditorPanel = componentDataAt(this: chromeSystem.editorPanels, i: i)
    if panel.panel is kind {
      if componentHas(this: world.actives, entity: entity) is false {
        ret true
      }
      ret componentGet(this: world.actives, entity: entity).value
    }
  }
  ret false
}

func setEditorPanelOpen(
  chromeSystem: view ChromeSystem
  world: mod UiWorld
  kind: view EditorPanelKind
  open: view Bool
) {
  let count: Int = componentCount(this: chromeSystem.editorPanels)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: chromeSystem.editorPanels, i: i)
    let panel: EditorPanel = componentDataAt(this: chromeSystem.editorPanels, i: i)
    if panel.panel is kind {
      componentSet(this: world.actives, entity: entity, data: Active { value: open })
    }
  }
}

func toggleEditorPanel(
  chromeSystem: view ChromeSystem
  world: mod UiWorld
  kind: view EditorPanelKind
) {
  setEditorPanelOpen(
    chromeSystem: chromeSystem
    world: world
    kind: kind
    open: not editorPanelOpen(chromeSystem: chromeSystem, world: world, kind: kind)
  )
}

# A fired action whose entity carries a PanelToggle flips that panel kind.
# Returns whether any panel changed.
func panelToggleSystem(chromeSystem: view ChromeSystem, world: mod UiWorld) ret Bool {
  var changed: Bool = false
  let count: Int = eventCount(this: world.uiActions)
  loop var a: Int = 0, a < count, ++a {
    let action: UiAction = eventAt(this: world.uiActions, i: a)
    if componentHas(this: chromeSystem.panelToggles, entity: action.entity) {
      let toggle: PanelToggle = componentGet(this: chromeSystem.panelToggles, entity: action.entity)
      toggleEditorPanel(chromeSystem: chromeSystem, world: world, kind: toggle.panel)
      changed = true
    }
  }
  ret changed
}

# ----- the edit area --------------------------------------------------------
type EditAreaRect {
  x: Float
  y: Float
  w: Float
  h: Float
}

# The rect of the node tagged EditArea (the space between the panels), or the
# whole canvas until the chrome has laid out.
func editAreaOf(
  chromeSystem: view ChromeSystem
  world: view UiWorld
  uiSystems: view UiSystems
  canvasW: view Float
  canvasH: view Float
) ret EditAreaRect {
  var area: EditAreaRect = { x: 0.0, y: 0.0, w: canvasW, h: canvasH }
  if componentCount(this: chromeSystem.editAreas) is 0 {
    ret area
  }
  let entity: EntityId = componentEntityAt(this: chromeSystem.editAreas, i: 0)
  if componentHas(this: uiSystems.layout.computedRects, entity: entity) and componentHas(
    this: world.worldTransforms
    entity: entity
  ) {
    let rect: ComputedRect = componentGet(this: uiSystems.layout.computedRects, entity: entity)
    let transform: WorldTransform2D = componentGet(this: world.worldTransforms, entity: entity)
    if rect.size.x > 0.0 and rect.size.y > 0.0 {
      area.x = transform.position.x
      area.y = transform.position.y
      area.w = rect.size.x
      area.h = rect.size.y
    }
  }
  ret area
}

func pointInEditArea(
  chromeSystem: view ChromeSystem
  world: view UiWorld
  uiSystems: view UiSystems
  x: view Float
  y: view Float
) ret Bool {
  if componentCount(this: chromeSystem.editAreas) is 0 {
    ret true
  }
  let area: EditAreaRect = editAreaOf(
    chromeSystem: chromeSystem
    world: world
    uiSystems: uiSystems
    canvasW: 0.0
    canvasH: 0.0
  )
  if area.w <= 0.0 {
    ret true
  }
  ret x >= area.x and y >= area.y and x <= area.x + area.w and y <= area.y + area.h
}

# ----- lists ----------------------------------------------------------------

# The ListView tagged with `source`, or none.
func editorListEntity(
  chromeSystem: view ChromeSystem
  world: view UiWorld
  source: view EditorListSource
) ret EntityId {
  let count: Int = componentCount(this: chromeSystem.editorLists)
  loop var i: Int = 0, i < count, ++i {
    let list: EditorList = componentDataAt(this: chromeSystem.editorLists, i: i)
    if list.source is source {
      ret componentEntityAt(this: chromeSystem.editorLists, i: i)
    }
  }
  ret noEntity()
}

# Hand the list its rows. Its width is layout's (`Size: { w: Fill }` fills
# the panel) and its height follows the visible row count (`h: Hug`, the
# ListView rule in the layout measure pass) — nothing to size here.
func setEditorListRows(world: mod UiWorld, list: view EntityId, rows: own List(ListViewRow)) {
  if isNone(this: list) {
    ret
  }
  componentSet(this: world.listViewDatas, entity: list, data: ListViewData { rows: own rows })
}
