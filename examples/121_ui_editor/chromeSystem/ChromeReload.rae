# chromeReload — the editor's chrome is a scene like any it edits, so it hot-
# reloads the same way: `rae watch` restarts the app on a `.rae` change, but
# a `.raescene` is DATA the app loads at runtime, and reloading it is the
# app's job. The document watcher already reloads the opened scene; this
# does the same for the chrome's own files (Editor.raescene, Guides.raescene,
# chrome/*) — remounting the chrome and guides pages in place while keeping
# what the user has: which panels are open, the camera, the selection.
import Gpu2d
open Sys
open ui/Ecs
open ui/Components
open ui/BindingComponents
open ui/Layer
open ui/Scene
open ui/SceneFile
open ui/SceneInstance
open ui/SceneLoader
open app3d/UiShell
open ecs/Entity
open ecs/ComponentTable

# Every file the chrome is made of: the chrome scene, the guides scene and
# the registered sub-scenes (rows, inspector, outlines).
func chromeScenePaths(builtinScenePaths: view List(String)) ret List(String) {
  var paths: List(String) = List.create(String, cap: builtinScenePaths.length + 2)
  paths.add(value: chromeScenePath)
  paths.add(value: guidesScenePath)
  loop var i: Int = 0, i < builtinScenePaths.length, ++i {
    if let path: String = builtinScenePaths.copyAt(index: i) {
      paths.add(value: path)
    }
  }
  ret paths
}

# The panel kinds by index (a List of an enum is not expressible yet).
const editorPanelKindCount: Int = 8

func editorPanelKindAt(index: view Int) ret EditorPanelKind {
  if index is 1 {
    ret EditorPanelKind.right
  }
  if index is 2 {
    ret EditorPanelKind.tree
  }
  if index is 3 {
    ret EditorPanelKind.project
  }
  if index is 4 {
    ret EditorPanelKind.diagnostics
  }
  if index is 5 {
    ret EditorPanelKind.guides
  }
  if index is 6 {
    ret EditorPanelKind.outlines
  }
  if index is 7 {
    ret EditorPanelKind.buttons
  }
  ret EditorPanelKind.left
}

# Mount the chrome page (boot and reload share this).
func mountChrome(
  world: mod UiWorld
  registry: view SceneRegistry
  designW: view Float
  designH: view Float
) ret EntityId {
  let chromeScene: Scene = loadSceneFile(path: chromeScenePath)
  let overrides: List(SceneOverride) = List.create(SceneOverride, cap: 1)
  let root: EntityId = mountPage(
    world: world
    pageId: "chrome"
    scene: chromeScene
    overrides: overrides
    w: designW
    h: designH
  )
  setLayerById(world: world, entity: root, id: "chrome")
  # The chrome's own sub-scenes (the inspector panel) resolve from the same
  # registry the document uses.
  resolveSceneInstances(world: world, registry: registry, pageId: "chrome")
  ret root
}

# A chrome file changed: remount the chrome and the guides from disk. What
# the user has stays: the panels' open states (read from the old nodes,
# written to the new), the camera (read from the old guides root), the
# selection (re-found by node id) and the status texts.
func reloadChrome(app: mod App) {
  var open: List(Bool) = List.create(Bool, cap: editorPanelKindCount)
  loop var k: Int = 0, k < editorPanelKindCount, ++k {
    open.add(value: editorPanelOpen(world: app.world, kind: editorPanelKindAt(index: k)))
  }
  let camera: Camera2D = cameraOf(camera: app.camera, world: app.world)
  var keepSelected: String = "{app.testSelectNodeId}"
  if keepSelected.length() is 0 and isNone(this: app.inspector.selected) is false {
    keepSelected = nodeIdOf(world: app.world, entity: app.inspector.selected)
  }

  unmountPage(world: app.world, pageId: "chrome")
  unmountPage(world: app.world, pageId: "guides")
  registerBuiltinScenes(
    document: app.document
    world: app.world
    builtinScenePaths: app.builtinScenePaths
    builtinSceneIds: app.builtinSceneIds
  )
  app.chrome.pageRoot = mountChrome(
    world: app.world
    registry: app.document.registry
    designW: app.viewport.designW
    designH: app.viewport.designH
  )
  app.guides = createGuides(
    world: app.world
    designW: app.document.designW
    designH: app.document.designH
  )
  syncGuides(
    guides: app.guides
    world: app.world
    status: app.status
    designW: app.document.designW
    designH: app.document.designH
    columnW: app.document.columnW
    safeInsets: app.document.safeInsets
  )
  setCameraFrame(
    camera: app.camera
    frameW: app.document.designW
    frameH: app.document.designH
    homeX: documentHomeX(designW: app.document.designW, columnW: app.document.columnW)
    documentRoot: app.document.pageRoot
    guidesRoot: app.guides.frameSpace
  )
  writeCamera(
    camera: app.camera
    world: app.world
    status: app.status
    next: camera
  )
  loop var k: Int = 0, k < editorPanelKindCount, ++k {
    setEditorPanelOpen(
      world: app.world
      kind: editorPanelKindAt(index: k)
      open: open.copyAtFallback(index: k, fallback: true)
    )
  }
  chromeSyncSystem(
    world: app.world
    status: app.status
    fileName: app.document.fileName
    designW: app.document.designW
    designH: app.document.designH
    columnW: app.document.columnW
    safeTop: app.document.safeInsets.t
    nodeCount: app.document.nodeCount
    documentStatus: app.document.status
  )
  projectListSystem(
    world: app.world
    status: app.status
    projectName: app.document.projectName
    projectScenes: app.document.projectScenes
    currentScene: documentPackagePath(document: app.document)
  )
  inspectorAfterLoad(
    inspector: app.inspector
    world: app.world
    status: app.status
    pageRoot: app.document.pageRoot
    selectNodeId: keepSelected
  )
  editorTextSystem(world: app.world, status: app.status)
  watchRememberMtimes(watch: app.chromeWatch, paths: app.chromePaths)
  log("[ui-editor] reloaded the chrome ({app.chromePaths.length} files watched)")
}
