# diagnosticsSystem — everything the document could not fully supply, made
# visible (docs/ui-editor-design.md §3): the loader's `sceneDiagnostics`
# (unknown component, runtime-only component, unknown token, missing
# sub-scene, parse error — the #996 `report` policy) plus the textures this
# system resolves itself. `Sprite.textureKey` resolves through what the scene
# and its `import`s declare (#1008: the `assets.textures` map, then its dirs as
# `<dir>/<key>.png`), with `$RAE_UI_EDITOR_ASSETS/<key>.png` as the viewer's
# own override tried FIRST — nothing is searched by convention; a miss
# registers a hatched placeholder under the key (so the sprite draws a box, not
# nothing) and records a missingTexture diagnostic. The chrome's counters and status line are
# written here from the document + the list; the chrome itself is a scene.
import Gpu2d
import String
open ui/SceneImports
open Sys
open ui/Ecs
open ui/Components
open ui/ScenePolicy
open ui/BindingComponents
open ui/animationSystem/EffectSystems
open ecs/Entity
open ecs/ComponentTable
open Gpu2dCanvas

# The placeholder bitmap's size bounds. It is generated at the size its largest
# sprite is DRAWN at (authored Rect x the canvas's logical-to-physical scale),
# so a hero cover does not show a 64 px hatch magnified twentyfold.
const placeholderMinSize: Int = 64

const placeholderMaxSize: Int = 2048

# When no frame has run yet the canvas scale is 0: assume a 2x display.
const placeholderFallbackScale: Float = 2.0

# The key -> path search state: which keys were already looked up, so the scan
# over the sprite table is free once every key is settled, and the viewer-only
# override directory.
type TextureSystem {
  resolvedKeys: List(String)
  overrideDirectory: String
}

func createTextureSystem() ret TextureSystem {
  ret TextureSystem {
    resolvedKeys: List.create(String, cap: 16)
    overrideDirectory: getEnv(name: "RAE_UI_EDITOR_ASSETS")
  }
}

func textureKeySettled(textureSystem: view TextureSystem, key: view String) ret Bool {
  loop var i: Int = 0, i < textureSystem.resolvedKeys.length, ++i {
    if let entry: view String => textureSystem.resolvedKeys.viewAt(index: i) {
      if entry is key {
        ret true
      }
    }
  }
  ret false
}

# The override directory's `<key>.png` when it exists, else what the scene's
# assets resolve the key to, else "".
func findTexturePath(
  textureSystem: view TextureSystem
  assets: view SceneAssets
  key: view String
) ret String {
  if textureSystem.overrideDirectory.length() > 0 {
    let candidate: String = "{textureSystem.overrideDirectory}/{key}.png"
    if exists(path: candidate) {
      ret candidate
    }
  }
  ret sceneAssetTexturePath(assets: assets, key: key)
}

# The physical pixel size a placeholder for `key` needs: the largest authored
# Rect side among the sprites showing it, scaled to physical pixels.
func placeholderSizeFor(
  world: view UiWorld
  canvas: view Gpu2dCanvas
  wanted: view List(String)
  wantedEntities: view List(EntityId)
  key: view String
) ret Int {
  var largest: Float = 0.0
  loop var i: Int = 0, i < wanted.length, ++i {
    if wanted.copyAtFallback(index: i, fallback: "") is key {
      let entityId: EntityId = wantedEntities.copyAtFallback(index: i, fallback: noEntity())
      if componentHas(this: world.rects, entityId: entityId) {
        let rect: Rect = componentGet(this: world.rects, entityId: entityId)
        if rect.size.x > largest {
          largest = rect.size.x
        }
        if rect.size.y > largest {
          largest = rect.size.y
        }
      }
    }
  }
  var scale: Float = xformAt(canvas: canvas, index: 2)
  if scale <= 0.0 {
    scale = placeholderFallbackScale
  }
  var size: Int = (largest * scale).toInt()
  if size < placeholderMinSize {
    size = placeholderMinSize
  }
  if size > placeholderMaxSize {
    size = placeholderMaxSize
  }
  ret size
}

# Grey diagonal stripes, one packed r | g<<8 | b<<16 | a<<24 per pixel
# (Gpu2d.registerImageRgba's layout). The stripe period grows with `size`, so
# the hatch looks the same on screen whatever size it is generated at. No
# border: the sprite's own CornerRadius / clip shapes the placeholder like it
# would the real image.
func registerPlaceholderImage(canvas: mod Gpu2dCanvas, key: view String, size: copy Int) {
  var pixels: List(Int) = List.create(Int, cap: size * size)
  var stripe: Int = size / 8
  if stripe < 8 {
    stripe = 8
  }
  loop var y: Int = 0, y < size, ++y {
    loop var x: Int = 0, x < size, ++x {
      var shade: Int = 150
      if ((x + y) / stripe) % 2 is 0 {
        shade = 96
      }
      pixels.add(value: shade + shade * 256 + shade * 65536 + 255 * 16777216)
    }
  }
  let handle: Int = Gpu2d.registerImageRgba(
    canvas: canvas
    key: "{key}"
    pixels: pixels.data
    w: size
    h: size
  )
}

# Resolve every Sprite.textureKey the world carries that is not settled yet.
# Runs after a load; the table scan is cheap and every key settles once.
func textureUpdate(
  textureSystem: mod TextureSystem
  world: mod UiWorld
  canvas: mod Gpu2dCanvas
  assets: view SceneAssets
  sceneId: view String
) {
  # Every key a sprite shows now or will show (#1005): its textureKey plus its
  # AnimFrames sequence (`<baseKey><i>` / textureKeys) and onEndTextureKey.
  var wanted: List(String) = List.create(String, cap: 16)
  var wantedEntities: List(EntityId) = List.create(EntityId, cap: 16)
  let spriteCount: Int = componentCount(this: world.sprites)
  loop var i: Int = 0, i < spriteCount, ++i {
    let sprite: Sprite = componentDataAt(this: world.sprites, i: i)
    wanted.add(value: "{sprite.textureKey}")
    wantedEntities.add(value: componentEntityAt(this: world.sprites, i: i))
  }
  let animCount: Int = componentCount(this: world.animFrames)
  loop var a: Int = 0, a < animCount, ++a {
    let owner: EntityId = componentEntityAt(this: world.animFrames, i: a)
    let frames: view AnimFrames => componentView(this: world.animFrames, entityId: owner)
    loop var f: Int = 0, f < animFrameCount(frames: frames), ++f {
      wanted.add(value: animFrameKey(frames: frames, index: f))
      wantedEntities.add(value: owner)
    }
    if frames.onEndTextureKey.length() > 0 {
      wanted.add(value: "{frames.onEndTextureKey}")
      wantedEntities.add(value: owner)
    }
  }
  loop var i: Int = 0, i < wanted.length, ++i {
    let key: String = wanted.copyAtFallback(index: i, fallback: "")
    let entityId: EntityId = wantedEntities.copyAtFallback(index: i, fallback: noEntity())
    # Empty keys are colour-only sprites; `mat:` keys are icon-font glyphs.
    if key.length() is 0 or key.startsWith(prefix: "mat:") or textureKeySettled(
      textureSystem: textureSystem
      key: key
    ) {
      continue
    }
    textureSystem.resolvedKeys.add(value: "{key}")
    if Gpu2d.hasImageKey(canvas: canvas, key: key) {
      continue
    }
    let path: String = findTexturePath(textureSystem: textureSystem, assets: assets, key: key)
    if path.length() > 0 {
      let handle: Int = Gpu2d.loadImageKey(canvas: canvas, key: key, path: path)
      if handle > 0 {
        continue
      }
    }
    registerPlaceholderImage(
      canvas: canvas
      key: key
      size: placeholderSizeFor(
        world: world
        canvas: canvas
        wanted: wanted
        wantedEntities: wantedEntities
        key: key
      )
    )
    var nodeLabel: String = ""
    if componentHas(this: world.nodeIdComponents, entityId: entityId) {
      nodeLabel = "{componentGet(this: world.nodeIdComponents, entityId: entityId).id}"
    }
    reportSceneDiagnostic(
      diagnostics: world.sceneDiagnostics
      sceneId: sceneId
      nodeId: nodeLabel
      kind: SceneDiagnosticKind.missingTexture
      name: key
      message: "no assets.textures map entry or dirs/{key}.png in the scene or its imports (nor $RAE_UI_EDITOR_ASSETS); drawing a placeholder"
    )
  }
}

# The diagnostics list's rows: one per diagnostic, `kind · sceneId/nodeId ·
# name · message` as four bound cells, on the ListView tagged
# `EditorList { source: diagnostics }`.
func diagnosticsListSystem(chromeSystem: view ChromeSystem, world: mod UiWorld) {
  let list: EntityId = editorListEntityId(
    chromeSystem: chromeSystem
    world: world
    source: EditorListSource.diagnostics
  )
  if isNone(this: list) {
    ret
  }
  let count: Int = world.sceneDiagnostics.length
  var rows: List(ListViewRow) = List.create(ListViewRow, cap: count + 1)
  loop var i: Int = 0, i < count, ++i {
    if let entry: view SceneDiagnostic => world.sceneDiagnostics.viewAt(index: i) {
      var keys: List(String) = {
        "id"
        "kind"
        "where"
        "name"
        "message"
      }
      var values: List(String) = List.create(String, cap: 5)
      values.add(value: "{i}")
      values.add(value: "{entry.kind.toString()}")
      values.add(value: "{entry.sceneId}/{entry.nodeId}")
      values.add(value: "{entry.name}")
      values.add(value: "{entry.message}")
      rows.add(value: ListViewRow { keys: own keys, values: own values })
    }
  }
  # INFO rows, after the real diagnostics: the authored components no lib
  # table matched. They are an app's own (docs/ecs-systems-own-their-tables.md
  # §4) — the editor keeps them on the node as authored and never counts them
  # as an error; the pill above stays the diagnostics count.
  let pendingCount: Int = world.pendingComponents.length
  loop var i: Int = 0, i < pendingCount, ++i {
    if let pending: view PendingComponent => world.pendingComponents.viewAt(index: i) {
      var keys: List(String) = {
        "id"
        "kind"
        "where"
        "name"
        "message"
      }
      var values: List(String) = List.create(String, cap: 5)
      values.add(value: "{count + i}")
      values.add(value: "appComponent")
      values.add(value: "{pending.sceneId}/{pending.nodeId}")
      values.add(value: "{pending.name}")
      values.add(value: "not a lib component; kept as authored")
      rows.add(value: ListViewRow { keys: own keys, values: own values })
    }
  }
  setEditorListRows(world: world, list: list, rows: own rows)
}

# Fill the status from the document + diagnostics and drive the chrome: the
# bound labels, the count pill, the diagnostics list.
func chromeSyncSystem(
  world: mod UiWorld
  chromeSystem: mod ChromeSystem
  fileName: view String
  designW: view Float
  designH: view Float
  columnW: view Float
  safeTop: view Float
  nodeCount: view Int
  documentStatus: view String
) {
  chromeSystem.fileName = "{fileName}"
  var frameLabel: String = "{designW.toInt()} x {designH.toInt()}"
  if columnW > 0.0 and columnW < designW {
    frameLabel = "{frameLabel} · column {columnW.toInt()}"
  }
  if safeTop > 0.0 {
    frameLabel = "{frameLabel} · safe {safeTop.toInt()}"
  }
  chromeSystem.designSize = frameLabel
  chromeSystem.nodeCount = nodeCount
  let count: Int = world.sceneDiagnostics.length
  chromeSystem.diagnosticsCount = count
  var line: String = "{documentStatus}"
  if count > 0 {
    if let first: view SceneDiagnostic => world.sceneDiagnostics.viewAt(index: 0) {
      line = formatSceneDiagnostic(diagnostic: first)
    }
  }
  chromeSystem.statusLine = line
  editorTextSystem(world: world, chromeSystem: chromeSystem)
  diagnosticsBadgeSystem(chromeSystem: chromeSystem, world: world, diagnosticsCount: count)
  diagnosticsListSystem(chromeSystem: chromeSystem, world: world)
}

# Log every diagnostic once, in the gate's one-line form, after a load.
func logDiagnostics(world: view UiWorld, sceneId: view String, nodeCount: view Int) {
  let count: Int = world.sceneDiagnostics.length
  var kept: String = ""
  if world.pendingComponents.length > 0 {
    kept = ", {world.pendingComponents.length} app components kept"
  }
  log("[ui-editor] mounted {sceneId}: {nodeCount} nodes, {count} diagnostics{kept}")
  loop var i: Int = 0, i < count, ++i {
    if let entry: view SceneDiagnostic => world.sceneDiagnostics.viewAt(index: i) {
      log("[ui-editor]   {formatSceneDiagnostic(diagnostic: entry)}")
    }
  }
}
