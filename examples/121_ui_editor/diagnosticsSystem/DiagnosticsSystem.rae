# diagnosticsSystem — everything the document could not fully supply, made
# visible (docs/ui-editor-design.md §3): the loader's `sceneDiagnostics`
# (unknown component, runtime-only component, unknown token, missing
# sub-scene, parse error — the #996 `report` policy) plus the textures this
# system resolves itself. `Sprite.textureKey` resolves through what the scene
# and its `import`s declare (#1008: the `assets.textures` map, then its dirs as
# `<dir>/<key>.png`), with `$RAE_UI_EDITOR_ASSETS/<key>.png` as the viewer's
# own override tried FIRST — nothing is searched by convention; a miss
# registers a hatched placeholder under the key (so the sprite draws a box, not
# nothing) and records a missingTexture diagnostic. The chrome's counters and status line are
# written here from the document + the list; the chrome itself is a scene.
import Gpu2d
import String
open ui/SceneImports
open Sys
open ui/Ecs
open ui/Components
open ui/ScenePolicy
open app3d/UiShell
open ui/animationSystem/EffectSystems
open ecs/Entity
open ecs/ComponentTable
open Gpu2dCanvas

const placeholderSize: Int = 64

# The key -> path search state: which keys were already looked up, so the scan
# over the sprite table is free once every key is settled, and the viewer-only
# override directory.
type TextureSearch {
  resolvedKeys: List(String)
  overrideDirectory: String
}

func createTextureSearch() ret TextureSearch {
  ret TextureSearch {
    resolvedKeys: List.create(String, cap: 16)
    overrideDirectory: getEnv(name: "RAE_UI_EDITOR_ASSETS")
  }
}

func textureKeySettled(search: view TextureSearch, key: view String) ret Bool {
  loop var i: Int = 0, i < search.resolvedKeys.length, ++i {
    if let entry: view String => search.resolvedKeys.viewAt(index: i) {
      if entry is key {
        ret true
      }
    }
  }
  ret false
}

# The override directory's `<key>.png` when it exists, else what the scene's
# assets resolve the key to, else "".
func findTexturePath(
  search: view TextureSearch
  assets: view SceneAssets
  key: view String
) ret String {
  if search.overrideDirectory.length() > 0 {
    let candidate: String = "{search.overrideDirectory}/{key}.png"
    if exists(path: candidate) {
      ret candidate
    }
  }
  ret sceneAssetTexturePath(assets: assets, key: key)
}

# A hatched grey box: diagonal stripes on a lighter field, one packed
# r | g<<8 | b<<16 | a<<24 per pixel (Gpu2d.registerImageRgba's layout).
func registerPlaceholderImage(canvas: mod Gpu2dCanvas, key: view String) {
  var pixels: List(Int) = List.create(Int, cap: placeholderSize * placeholderSize)
  loop var y: Int = 0, y < placeholderSize, ++y {
    loop var x: Int = 0, x < placeholderSize, ++x {
      var shade: Int = 150
      if ((x + y) / 8) % 2 is 0 {
        shade = 96
      }
      let edge: Bool = x < 2 or y < 2 or x >= placeholderSize - 2 or y >= placeholderSize - 2
      if edge {
        shade = 230
      }
      pixels.add(value: shade + shade * 256 + shade * 65536 + 255 * 16777216)
    }
  }
  let handle: Int = Gpu2d.registerImageRgba(
    canvas: canvas
    key: "{key}"
    pixels: pixels.data
    w: placeholderSize
    h: placeholderSize
  )
}

# Resolve every Sprite.textureKey the world carries that is not settled yet.
# Runs after a load; the table scan is cheap and every key settles once.
func textureSystem(
  search: mod TextureSearch
  world: mod UiWorld
  canvas: mod Gpu2dCanvas
  assets: view SceneAssets
  sceneId: view String
) {
  # Every key a sprite shows now or will show (#1005): its textureKey plus its
  # AnimFrames sequence (`<baseKey><i>` / textureKeys) and onEndTextureKey.
  var wanted: List(String) = List.create(String, cap: 16)
  var wantedEntities: List(EntityId) = List.create(EntityId, cap: 16)
  let spriteCount: Int = componentCount(this: world.sprites)
  loop var i: Int = 0, i < spriteCount, ++i {
    let sprite: Sprite = componentDataAt(this: world.sprites, i: i)
    wanted.add(value: "{sprite.textureKey}")
    wantedEntities.add(value: componentEntityAt(this: world.sprites, i: i))
  }
  let animCount: Int = componentCount(this: world.animFrames)
  loop var a: Int = 0, a < animCount, ++a {
    let owner: EntityId = componentEntityAt(this: world.animFrames, i: a)
    let frames: view AnimFrames => componentView(this: world.animFrames, entity: owner)
    loop var f: Int = 0, f < animFrameCount(frames: frames), ++f {
      wanted.add(value: animFrameKey(frames: frames, index: f))
      wantedEntities.add(value: owner)
    }
    if frames.onEndTextureKey.length() > 0 {
      wanted.add(value: "{frames.onEndTextureKey}")
      wantedEntities.add(value: owner)
    }
  }
  loop var i: Int = 0, i < wanted.length, ++i {
    let key: String = wanted.copyAtFallback(index: i, fallback: "")
    let entity: EntityId = wantedEntities.copyAtFallback(index: i, fallback: noEntity())
    # Empty keys are colour-only sprites; `mat:` keys are icon-font glyphs.
    if key.length() is 0 or key.startsWith(prefix: "mat:") or textureKeySettled(
      search: search
      key: key
    ) {
      continue
    }
    search.resolvedKeys.add(value: "{key}")
    if Gpu2d.hasImageKey(canvas: canvas, key: key) {
      continue
    }
    let path: String = findTexturePath(search: search, assets: assets, key: key)
    if path.length() > 0 {
      let handle: Int = Gpu2d.loadImageKey(canvas: canvas, key: key, path: path)
      if handle > 0 {
        continue
      }
    }
    registerPlaceholderImage(canvas: canvas, key: key)
    var nodeLabel: String = ""
    if componentHas(this: world.nodeIdComponents, entity: entity) {
      nodeLabel = "{componentGet(this: world.nodeIdComponents, entity: entity).id}"
    }
    reportSceneDiagnostic(
      diagnostics: world.sceneDiagnostics
      sceneId: sceneId
      nodeId: nodeLabel
      kind: SceneDiagnosticKind.missingTexture
      name: key
      message: "no assets.textures map entry or dirs/{key}.png in the scene or its imports (nor $RAE_UI_EDITOR_ASSETS); drawing a placeholder"
    )
  }
}

# The chrome's own state: its page root (so H can hide it), its visibility,
# and whether the diagnostics panel (D) is open.
type ChromeState {
  pageRoot: EntityId
  visible: Bool
  panelOpen: Bool
}

const diagnosticsPanelNode: String = "chrome/DiagnosticsPanel"

func setDiagnosticsPanelOpen(chrome: mod ChromeState, world: mod UiWorld, open: view Bool) {
  chrome.panelOpen = open
  setNodeActive(world: world, nodeId: diagnosticsPanelNode, value: open)
}

# The list's rows: one per diagnostic, `kind · sceneId/nodeId · name · message`
# as four bound cells. The list's authored width is replaced by the design
# width minus the panel padding, since the row pool takes its width from the
# list's Rect when it is built.
func syncDiagnosticsList(world: mod UiWorld, designW: view Float) {
  let entity: EntityId = nodeEntityFor(world: world, nodeId: "chrome/DiagnosticList")
  if isNone(this: entity) {
    ret
  }
  let count: Int = world.sceneDiagnostics.length
  if componentHas(this: world.rects, entity: entity) and componentHas(
    this: world.listViews
    entity: entity
  ) {
    let list: ListView = componentGet(this: world.listViews, entity: entity)
    var shown: Int = count
    if shown < 1 {
      shown = 1
    }
    if shown > list.visibleItemCount {
      shown = list.visibleItemCount
    }
    let rect: mod Rect => componentMod(this: world.rects, entity: entity)
    rect.size.x = designW - 48.0
    rect.size.y = shown.toFloat() * (list.itemHeight + list.itemGap) - list.itemGap
  }
  var rows: List(ListViewRow) = List.create(ListViewRow, cap: count + 1)
  loop var i: Int = 0, i < count, ++i {
    if let entry: view SceneDiagnostic => world.sceneDiagnostics.viewAt(index: i) {
      var keys: List(String) = {
        "id"
        "kind"
        "where"
        "name"
        "message"
      }
      var values: List(String) = List.create(String, cap: 5)
      values.add(value: "{i}")
      values.add(value: "{entry.kind.toString()}")
      values.add(value: "{entry.sceneId}/{entry.nodeId}")
      values.add(value: "{entry.name}")
      values.add(value: "{entry.message}")
      rows.add(value: ListViewRow { keys: own keys, values: own values })
    }
  }
  componentSet(this: world.listViewDatas, entity: entity, data: ListViewData { rows: own rows })
}

# A literal fill on a chrome node (the counter pill turns red, not a slot).
func setNodeFillLiteral(world: mod UiWorld, nodeId: view String, fill: view RgbaColor) {
  let entity: EntityId = nodeEntityFor(world: world, nodeId: nodeId)
  if isNone(this: entity) or componentHas(this: world.shapes, entity: entity) is false {
    ret
  }
  let shape: mod Shape => componentMod(this: world.shapes, entity: entity)
  shape.fill = fill
  shape.fillSlot = ""
}

# Write the top bar + status line from the document and the diagnostics.
func chromeSyncSystem(
  world: mod UiWorld
  fileName: view String
  designW: view Float
  designH: view Float
  nodeCount: view Int
  status: view String
) {
  setNodeText(world: world, nodeId: "chrome/FileName", value: fileName)
  setNodeText(
    world: world
    nodeId: "chrome/DesignSize"
    value: "{designW.toInt()} x {designH.toInt()}"
  )
  setNodeText(world: world, nodeId: "chrome/NodeCount", value: "{nodeCount} nodes")
  let count: Int = world.sceneDiagnostics.length
  var diagnosticsLabel: String = "no diagnostics"
  if count is 1 {
    diagnosticsLabel = "1 diagnostic"
  }
  if count > 1 {
    diagnosticsLabel = "{count} diagnostics"
  }
  setNodeText(world: world, nodeId: "chrome/DiagnosticsCount", value: diagnosticsLabel)
  var line: String = "{status}"
  if count > 0 {
    if let first: view SceneDiagnostic => world.sceneDiagnostics.viewAt(index: 0) {
      line = formatSceneDiagnostic(diagnostic: first)
    }
  }
  setNodeText(world: world, nodeId: "chrome/StatusLine", value: line)
  if count > 0 {
    setNodeFillLiteral(
      world: world
      nodeId: "chrome/DiagnosticsPill"
      fill: RgbaColor { r: 200, g: 40, b: 52, a: 255 }
    )
  } else {
    setNodeFillLiteral(
      world: world
      nodeId: "chrome/DiagnosticsPill"
      fill: RgbaColor { r: 46, g: 54, b: 78, a: 255 }
    )
  }
  syncDiagnosticsList(world: world, designW: designW)
}

# Log every diagnostic once, in the gate's one-line form, after a load.
func logDiagnostics(world: view UiWorld, sceneId: view String, nodeCount: view Int) {
  let count: Int = world.sceneDiagnostics.length
  log("[ui-editor] mounted {sceneId}: {nodeCount} nodes, {count} diagnostics")
  loop var i: Int = 0, i < count, ++i {
    if let entry: view SceneDiagnostic => world.sceneDiagnostics.viewAt(index: i) {
      log("[ui-editor]   {formatSceneDiagnostic(diagnostic: entry)}")
    }
  }
}
