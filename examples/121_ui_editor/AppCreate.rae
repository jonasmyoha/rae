# createApp — the setup half: window, fonts, the document's theme, ONE UiWorld
# under the #996 `report` policy with two layers (document / chrome), the
# document mounted, the chrome mounted, textures resolved.
import Gpu2d
import SdfText
import String
open Sys
open ui/Ecs
open ui/Layer
open ui/Pipeline
open ui/Scene
open ui/SceneFile
open ui/SceneInstance
open ui/SceneImports
open ui/SceneLoader
open ui/ScenePolicy
open ui/Theme
open ui/ThemeParse
open ui/ThemeResolved
open ui/renderSystem/RenderSystem
open ui/safeAreaSystem/SafeAreaSystem
open app3d/UiShell
open ecs/Entity
open ecs/Schedule
open Gpu2dCanvas

# The viewer's FALLBACK fonts (the shared Roboto + Material atlases, as 119
# uses) — what a document that declares no `assets.fonts` renders with. A
# document's own fonts come through its imports (#1008); RAE_UI_EDITOR_FONT /
# RAE_UI_EDITOR_ICON_FONT (a `.mtsdf.json` path) are viewer-only overrides.
const fallbackFontDirectory: String = "examples/105_ui_counter/assets/"

const chromeScenePath: String = "examples/121_ui_editor/assets/scenes/Editor.raescene"

# The chrome's own sub-scenes, registered into the document's registry on
# every load (one registry serves every ListView, chrome or document).
const diagnosticRowScenePath: String = "examples/121_ui_editor/assets/scenes/chrome/DiagnosticRow.raescene"

const inspectorScenePath: String = "examples/121_ui_editor/assets/scenes/chrome/Inspector.raescene"

const treeRowScenePath: String = "examples/121_ui_editor/assets/scenes/chrome/TreeRow.raescene"

const projectRowScenePath: String = "examples/121_ui_editor/assets/scenes/chrome/ProjectRow.raescene"

# The theme the document sees: its own token sections, then its `import`s in
# order (#1008) — nothing is read from the directory. Installed on every
# (re)load, BEFORE the page mounts, since tokens resolve at load time.
func applyDocumentTheme(gpuUi: mod Gpu2dUi, document: view SceneDocument, quiet: view Bool) {
  var theme: ResolvedTheme = createResolvedTheme()
  theme = sceneImportedTheme(
    entry: document.scene
    assets: document.assets
    registry: document.registry
  )
  if not quiet {
    if document.assets.importedIds.length > 0 {
      log("[ui-editor] theme: from {document.fileName} and its imports")
    } else {
      log("[ui-editor] theme: {document.fileName} alone (no imports)")
    }
  }
  gpuUi.activeTheme = overlayPalette(base: lightTheme(), tokens: theme)
  gpuUi.theme = own theme
}

# Which font files the document asks for: the viewer override, else the
# document's `assets.fonts`, else "" (the fallback atlas).
func wantedTextFont(document: view SceneDocument) ret String {
  let override: String = getEnv(name: "RAE_UI_EDITOR_FONT")
  if override.length() > 0 {
    ret override
  }
  ret "{document.assets.textFontPath}"
}

func wantedIconFont(document: view SceneDocument) ret String {
  let override: String = getEnv(name: "RAE_UI_EDITOR_ICON_FONT")
  if override.length() > 0 {
    ret override
  }
  ret "{document.assets.iconFontPath}"
}

# Swap the fonts when the document's differ from the loaded ones (an atlas
# slot is spent per load, so a reload with the same fonts loads nothing).
func applyDocumentFonts(gpuUi: mod Gpu2dUi, fonts: mod EditorFonts, document: view SceneDocument) {
  let text: String = wantedTextFont(document: document)
  if text is not fonts.textFontPath {
    var font: SdfFont = SdfText.loadSdfFont(
      jsonPath: "{fallbackFontDirectory}Roboto-Regular.mtsdf.json"
      rawAtlasPath: "{fallbackFontDirectory}Roboto-Regular.mtsdf.raw"
    )
    if text.length() > 0 {
      font = SdfText.loadSdfFontJson(jsonPath: text)
    }
    gpuUi.textFont = own font
    fonts.textFontPath = text
  }
  let icons: String = wantedIconFont(document: document)
  if icons is not fonts.iconFontPath {
    var font: SdfFont = SdfText.loadSdfFont(
      jsonPath: "{fallbackFontDirectory}MaterialIconsRound-Regular.mtsdf.json"
      rawAtlasPath: "{fallbackFontDirectory}MaterialIconsRound-Regular.mtsdf.raw"
    )
    if icons.length() > 0 {
      font = SdfText.loadSdfFontJson(jsonPath: icons)
    }
    gpuUi.iconFont = own font
    fonts.iconFontPath = icons
  }
}

# The fallback fonts and the library default tokens; the document's theme and
# fonts replace them per load (applyDocumentTheme / applyDocumentFonts).
func createEditorUi() ret Gpu2dUi {
  let textFont: SdfFont = SdfText.loadSdfFont(
    jsonPath: "{fallbackFontDirectory}Roboto-Regular.mtsdf.json"
    rawAtlasPath: "{fallbackFontDirectory}Roboto-Regular.mtsdf.raw"
  )
  let iconFont: SdfFont = SdfText.loadSdfFont(
    jsonPath: "{fallbackFontDirectory}MaterialIconsRound-Regular.mtsdf.json"
    rawAtlasPath: "{fallbackFontDirectory}MaterialIconsRound-Regular.mtsdf.raw"
  )
  var gpuUi: Gpu2dUi = {
    textFont: own textFont
    iconFont: own iconFont
    theme: createResolvedTheme()
    activeTheme: lightTheme()
  }
  ret gpuUi
}

func createApp() ret App {
  let headless: Bool = getEnv(name: "RAE_UI_HEADLESS").length() > 0
  var viewport: EditorViewport = createEditorViewport()
  Gpu2d.initWindow(
    width: viewport.windowW
    height: viewport.windowH
    title: "Rae UI Editor — .raescene viewer"
  )
  var canvas: Gpu2dCanvas = createGpu2dCanvas()

  var document: SceneDocument = createSceneDocument(path: resolveScenePath())
  var gpuUi: Gpu2dUi = createEditorUi()
  var fonts: EditorFonts = { textFontPath: "", iconFontPath: "" }
  var builtinScenePaths: List(String) = List.create(String, cap: 4)
  var builtinSceneIds: List(String) = List.create(String, cap: 4)
  builtinScenePaths.add(value: diagnosticRowScenePath)
  builtinSceneIds.add(value: "chrome/DiagnosticRow")
  builtinScenePaths.add(value: inspectorScenePath)
  builtinSceneIds.add(value: "chrome/Inspector")
  builtinScenePaths.add(value: treeRowScenePath)
  builtinSceneIds.add(value: "chrome/TreeRow")
  builtinScenePaths.add(value: projectRowScenePath)
  builtinSceneIds.add(value: "chrome/ProjectRow")

  var world: UiWorld = create()
  seedWorldTheme(world: world, res: gpuUi)
  # A viewer opens OTHER people's scenes: report what it cannot apply, never exit.
  world.scenePolicy.unknownComponents = UnknownComponentPolicy.report
  let documentLayer: EntityId = createLayerEntity(world: world, id: "document", order: 0)
  let chromeLayer: EntityId = createLayerEntity(world: world, id: "chrome", order: 100)
  var inspector: InspectorState = createInspectorState(world: world)

  let mounted: Bool = documentPrepareSystem(document: document, world: world)
  if mounted {
    applyDocumentTheme(gpuUi: gpuUi, document: document, quiet: false)
    reseedWorldTheme(world: world, res: gpuUi)
    applyDocumentFonts(gpuUi: gpuUi, fonts: fonts, document: document)
    documentMountSystem(
      document: document
      world: world
      builtinScenePaths: builtinScenePaths
      builtinSceneIds: builtinSceneIds
    )
  }
  applyViewport(
    viewport: viewport
    world: world
    designW: document.designW
    designH: document.designH
  )
  placeDocumentPage(world: world, pageRoot: document.pageRoot)
  # The device frame's safe-area insets reach the page through its own
  # `SafeArea { apply }` nodes, exactly as in the app (zero without a frame).
  safeAreaSystem(world: world, insets: document.safeInsets)
  # The frame + safe-area guides: an authored overlay between the document
  # and the chrome, positioned from the frame (RAE_UI_EDITOR_GUIDES=0 hides).
  var guides: GuideState = createGuides(
    world: world
    designW: viewport.designW
    designH: viewport.designH
  )
  if getEnv(name: "RAE_UI_EDITOR_GUIDES") is "0" {
    setGuidesVisible(guides: guides, world: world, visible: false)
  }
  syncGuides(
    guides: guides
    world: world
    designW: viewport.designW
    designH: viewport.designH
    columnW: document.columnW
    safeInsets: document.safeInsets
  )
  # The camera: zoom + pan on the document and guides roots (chrome untouched).
  var camera: EditorCamera = createEditorCamera()
  setCameraHome(
    camera: camera
    homeX: documentHomeX(viewport: viewport, columnW: document.columnW)
    homeY: documentHomeY(viewport: viewport, designH: document.designH)
  )
  bootCameraZoom(camera: camera, canvasW: viewport.designW, canvasH: viewport.designH)

  # The chrome: the app's own scene on its own layer, sized to the design
  # space (at least the chrome's own 1080x1920, viewportSystem).
  let chromeScene: Scene = loadSceneFile(path: chromeScenePath)
  let chromeOverrides: List(SceneOverride) = List.create(SceneOverride, cap: 1)
  let chromeRoot: EntityId = mountPage(
    world: world
    pageId: "chrome"
    scene: chromeScene
    overrides: chromeOverrides
    w: viewport.designW
    h: viewport.designH
  )
  setLayerById(world: world, entity: chromeRoot, id: "chrome")
  # The chrome's own sub-scenes (the inspector panel) resolve from the same
  # registry the document uses.
  resolveSceneInstances(world: world, registry: document.registry, pageId: "chrome")
  var chrome: ChromeState = {
    pageRoot: chromeRoot
    visible: true
    panelOpen: false
    projectOpen: false
  }
  # A project opens with its scene list showing (P hides it); a bare scene
  # has no project, so the panel stays hidden.
  if document.projectPack.length() > 0 {
    setProjectPanelOpen(chrome: chrome, world: world, open: true)
  }
  # RAE_UI_EDITOR_PANEL=1 opens the diagnostics panel at boot (the headless
  # gate's screenshot shows it; interactively D toggles it).
  if getEnv(name: "RAE_UI_EDITOR_PANEL") is "1" {
    setDiagnosticsPanelOpen(chrome: chrome, world: world, open: true)
  }

  applyCamera(
    camera: camera
    world: world
    documentRoot: document.pageRoot
    guidesRoot: guides.pageRoot
  )

  var textures: TextureSearch = createTextureSearch()
  unsafe {
    textureSystem(
      search: textures
      world: world
      canvas: canvas
      assets: document.assets
      sceneId: document.fileName
    )
  }
  chromeSyncSystem(
    world: world
    fileName: document.fileName
    designW: document.designW
    designH: document.designH
    columnW: document.columnW
    safeTop: document.safeInsets.t
    nodeCount: document.nodeCount
    status: document.status
  )
  syncProjectPanel(
    world: world
    projectName: document.projectName
    projectScenes: document.projectScenes
    currentScene: documentPackagePath(document: document)
    designW: document.designW
  )
  logDiagnostics(world: world, sceneId: document.scene.sceneId, nodeCount: document.nodeCount)
  # RAE_UI_EDITOR_TEST_SELECT=<nodeId>: select that node at boot (and again
  # after every reload), as a click would — the headless gate's hook.
  let testSelectNodeId: String = getEnv(name: "RAE_UI_EDITOR_TEST_SELECT")
  if getEnv(name: "RAE_UI_EDITOR_TREE") is "1" {
    inspector.treeOpen = true
  }
  var watch: FileWatch = createFileWatch(now: Gpu2d.nowSeconds())
  watchRememberMtimes(watch: watch, paths: document.watchedPaths)

  var schedule: Schedule = createUiPipeline(world: world)
  unsafe {
    ret App {
      gpuUi: own gpuUi
      canvas: own canvas
      world: own world
      schedule: own schedule
      document: own document
      viewport: viewport
      chrome: chrome
      textures: own textures
      fonts: fonts
      watch: own watch
      inspector: own inspector
      guides: guides
      camera: camera
      testSelectNodeId: testSelectNodeId
      builtinScenePaths: own builtinScenePaths
      builtinSceneIds: own builtinSceneIds
      headless: headless
    }
  }
}
