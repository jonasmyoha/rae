# DocumentSave — the document page back to its file (docs/ui-editor-design.md).
#
# Cmd/Ctrl+S writes the mounted document to `document.path` through
# lib/ui/SceneWriter: every component that still equals its authored text is
# written back verbatim (tokens, hex colors, the author's order survive), a
# changed one in the grammar, the node's app components (the pending outbox)
# as they were read, the headers from the parsed file. Canonical layout. The motion tokens edited
# since the last save go to the files that declare them (motionTokenSystem).
# `RAE_UI_EDITOR_TEST_SAVE=<path>` saves there once after the first frame —
# the headless gate's hook.
import Sys
open ui/Ecs
open ui/UiSystems
open ui/SceneWriter
open ecs/Entity
open ecs/ComponentTable

# The document page as `.raescene` text, what a save writes (the motion tokens
# apart): "" when no document is mounted.
func documentSaveText(app: view App) ret String {
  if app.document.loaded is false or isNone(this: app.document.pageRoot) {
    ret ""
  }
  let fresh: UiWorld = freshDecodeOf(
    world: app.world
    uiSystems: app.uiSystems
    scene: app.document.scene
  )
  ret writeSceneText(
    world: app.world
    uiSystems: app.uiSystems
    fresh: fresh
    scene: app.document.scene
    pageRoot: app.document.pageRoot
    pageId: "document"
  )
}

# Write the document to `path`; the node count written, -1 on failure.
# While a frame is shown nothing is written: the page holds that frame's
# overrides, and an edit made there belongs in the frame's override bag
# (docs/ui-coordinate-and-responsive-layout.md §2), which the writer does not
# write yet. Show Base (the frame pill, V) to save.
func saveDocumentTo(app: mod App, path: view String) ret Int {
  if app.document.loaded is false or isNone(this: app.document.pageRoot) {
    log("[ui-editor] nothing to save")
    ret -1
  }
  if app.document.frameName.length() > 0 {
    log("[ui-editor] not saved: frame {app.document.frameName} is shown; show Base to save")
    app.chromeSystem.statusLine = "not saved: showing frame {app.document.frameName} (show Base to save)"
    ret -1
  }
  let text: String = documentSaveText(app: app)
  let withTokens: String = motionTokensSave(
    system: app.motionTokens
    world: app.world
    document: app.document
    documentText: text
  )
  if Sys.writeFile(path: path, content: withTokens) is false {
    log("[ui-editor] could not write {path}")
    app.chromeSystem.statusLine = "could not write {path}"
    ret -1
  }
  markDocumentClean(app: app)
  let nodes: Int = app.document.nodeCount
  log("[ui-editor] saved {path} ({nodes} nodes)")
  app.chromeSystem.statusLine = "saved {app.document.fileName}"
  ret nodes
}

func saveDocument(app: mod App) ret Int {
  ret saveDocumentTo(app: app, path: app.document.path)
}
