# documentSystem — the viewed `.raescene` as a resource: which file, the parsed
# scene, the scene ROOT its references resolve from, the registry its sub-scenes
# load into, what its `import`s resolve to (theme tokens, textures, fonts) and
# the page root it is mounted under (docs/ui-editor-design.md §3).
#
# Loading is ONE mountPage, exactly like a 106 page; sub-scenes load
# transitively from `<root>/<package/Path>.raescene` (#1008: a scene reference is a package
# path, resolved from the root — the opened scene's directory unless
# `--scene-root` / RAE_UI_EDITOR_ROOT says otherwise) before the page resolves
# any instance. resolveSceneInstances turns whatever is still missing into a
# red sentinel + diagnostic (the #996 `report` policy). Nothing is inferred from
# file names: a theme reaches the page only through its `import` list. The app creates NO layout
# entities of its own (the #990/#991 rule): the only entities are the mounted
# scenes' nodes and the two layer roots.
#
# A RELOAD (watchSystem, #998) is the same function again: the new file is
# parsed FIRST, and only a scene that parses replaces the page — a broken save
# keeps the last good page on screen with the parse error in the chrome. The
# document's ScrollStates survive the remount, matched by node id.
import Json
import String
open Sys
open ui/Ecs
open ui/Components
open ui/Layer
open ui/Scene
open ui/SceneFile
open ui/SceneInstance
open ui/SceneImports
open ui/SceneBundles
open ui/SceneLoader
open ui/ScenePolicy
open ui/RegistryOpt
open ecs/Entity
open ecs/ComponentTable
open ui/UiSystems

const defaultDesignW: Float = 1080.0

const defaultDesignH: Float = 1920.0

# How many placeholder rows a viewed ListView gets, so a list authored against
# app data still shows its row scene in a passive viewer.
const listViewSampleRows: Int = 6

type SceneDocument {
  path: String
  directory: String
  # The scene root: package paths (`import`, `SceneInstance.sceneId`, a
  # ListView's row scenes) resolve as `<root>/<path>.raescene`.
  root: String
  # The PROJECT, when a `.raepack` was opened (projectSystem): the pack's path
  # ("" = a bare scene was opened), its `name`, and every scene under its
  # directory as a package path — the root is then the pack's directory.
  projectPack: String
  projectName: String
  projectScenes: List(String)
  fileName: String
  scene: Scene
  registry: SceneRegistry
  # What the page and its imports declare: theme tokens, texture map/dirs, fonts.
  assets: SceneAssets
  pageRoot: EntityId
  # The DESIGN extent the page is laid out in (the device frame when the
  # scene declares `unitScale`, viewportSystem; else the root's Rect / the
  # 1080x1920 default) and the page COLUMN mounted inside it.
  designW: Float
  designH: Float
  columnW: Float
  # The scene's authored `unitScale` (design units per point), 0 = none.
  unitScale: Float
  # The safe-area insets of the frame, in design units (zero without one).
  safeInsets: Insets
  nodeCount: Int
  loaded: Bool
  status: String
  # Every file the document depends on (the scene, its registered sub-scenes,
  # the theme), rebuilt per load — what the watcher polls.
  watchedPaths: List(String)
  reloads: Int
}

# The file to open — a `.raescene`, or a `.raepack` whose directory becomes the
# project (projectSystem): the first positional program argument, else
# RAE_UI_EDITOR_SCENE, else the shipped MainMenu sample. `--scene-root <dir>`
# and `--scene <package/Path>` may precede or follow it.
func resolveScenePath() ret String {
  loop var i: Int = 0, i < argCount(), ++i {
    let arg: String = argAt(index: i)
    if arg is "--scene-root" or arg is "--scene" {
      i = i + 1
      continue
    }
    if arg.length() > 0 {
      ret arg
    }
  }
  let fromEnv: String = getEnv(name: "RAE_UI_EDITOR_SCENE")
  if fromEnv.length() > 0 {
    ret fromEnv
  }
  ret "examples/121_ui_editor/assets/samples/MainMenu.raescene"
}

# Which scene of an opened PROJECT to mount first: `--scene <package/Path>`,
# else RAE_UI_EDITOR_PROJECT_SCENE, else "" (the first scene of the scan).
func resolveProjectSceneArg() ret String {
  loop var i: Int = 0, i + 1 < argCount(), ++i {
    if argAt(index: i) is "--scene" {
      ret argAt(index: i + 1)
    }
  }
  ret getEnv(name: "RAE_UI_EDITOR_PROJECT_SCENE")
}

# The scene root: `--scene-root <dir>`, else RAE_UI_EDITOR_ROOT, else the opened
# scene's own directory — the way `rae run` takes the entry file's folder as the
# project unless `--project` says otherwise. Always ends in a slash.
func resolveSceneRoot(scenePath: view String) ret String {
  var root: String = ""
  loop var i: Int = 0, i + 1 < argCount(), ++i {
    if argAt(index: i) is "--scene-root" {
      root = argAt(index: i + 1)
    }
  }
  if root.length() is 0 {
    root = getEnv(name: "RAE_UI_EDITOR_ROOT")
  }
  if root.length() is 0 {
    ret directoryOf(path: scenePath)
  }
  if root.endsWith(suffix: "/") {
    ret root
  }
  ret "{root}/"
}

func directoryOf(path: view String) ret String {
  let slash: Int = path.lastIndexOf(sub: "/")
  if slash < 0 {
    ret "./"
  }
  ret path.sub(start: 0, len: slash + 1)
}

func fileNameOf(path: view String) ret String {
  let slash: Int = path.lastIndexOf(sub: "/")
  if slash < 0 {
    ret "{path}"
  }
  ret path.sub(start: slash + 1, len: path.length() - slash - 1)
}

# ONE opener for every input — the boot argument / RAE_UI_EDITOR_SCENE, a
# project-panel row, the file picker (#51700883): `path` is a `.raepack` or a
# `.raescene`. A pack: its directory becomes the root (`--scene-root` /
# RAE_UI_EDITOR_ROOT still win, as an explicit override), its scenes are
# scanned, and the first (or `--scene`'s / `wantedScene`'s) is the document. A
# scene inside the OPEN project's root stays a project scene (the root does
# not move); any other scene is a bare open — the project is cleared and the
# root is the scene's own directory, exactly as at boot. `atBoot` is whether
# the `--scene-root` / RAE_UI_EDITOR_ROOT override applies: it describes the
# file named on the command line, so a file the user picks LATER gets its own
# root, never the boot one. The caller mounts or reloads; a project with no
# scene at all keeps an empty path and says so.
func documentOpenPath(
  document: mod SceneDocument
  path: view String
  wantedScene: view String
  atBoot: view Bool
) {
  if isPackPath(path: path) {
    document.projectPack = "{path}"
    document.projectName = packDisplayName(packPath: path)
    document.root = directoryOf(path: path)
    let declaredRoot: String = packSceneRoot(packPath: path)
    if declaredRoot.length() > 0 {
      # The pack says where its scenes live (`scenes: { root }`, the way
      # `sources` says where its code lives) — its references resolve from
      # there, exactly as the app itself resolves them.
      document.root = "{document.root}{declaredRoot}/"
    }
    if atBoot {
      document.root = resolveSceneRoot(scenePath: document.root)
    }
    document.projectScenes = collectProjectScenes(root: document.root)
    var wanted: String = "{wantedScene}"
    if wanted.length() is 0 {
      wanted = document.projectScenes.copyAtFallback(index: 0, fallback: "")
    }
    if wanted.length() > 0 {
      setDocumentScene(document: document, packagePath: wanted)
    } else {
      document.path = ""
      document.fileName = fileNameOf(path: path)
      document.status = "no .raescene under {document.root}"
    }
    log("[ui-editor] project {path}: {document.projectScenes.length} scenes under {document.root}")
    ret
  }
  if document.projectPack.length() > 0 and path.startsWith(prefix: document.root) {
    let start: Int = document.root.length()
    let stop: Int = path.length() - ".raescene".length()
    if stop > start {
      setDocumentScene(document: document, packagePath: path.sub(start: start, len: stop - start))
      ret
    }
  }
  document.projectPack = ""
  document.projectName = ""
  document.projectScenes.clear()
  document.path = "{path}"
  document.directory = directoryOf(path: path)
  document.root = document.directory
  if atBoot {
    document.root = resolveSceneRoot(scenePath: path)
  }
  document.fileName = fileNameOf(path: path)
}

func createSceneDocument(path: view String) ret SceneDocument {
  var document: SceneDocument = createEmptySceneDocument(path: path)
  documentOpenPath(
    document: document
    path: path
    wantedScene: resolveProjectSceneArg()
    atBoot: true
  )
  ret document
}

# Point an open project's document at one of its scenes (a package path,
# `assets/scenes/Album`); the root does not move. The caller mounts/reloads.
func setDocumentScene(document: mod SceneDocument, packagePath: view String) {
  document.path = scenePackageFile(root: document.root, sceneId: packagePath)
  document.directory = directoryOf(path: document.path)
  document.fileName = fileNameOf(path: document.path)
}

# The package path of the document within its project ("" for a bare scene).
func documentPackagePath(document: view SceneDocument) ret String {
  if document.projectPack.length() is 0 or document.path.length() is 0 {
    ret ""
  }
  let start: Int = document.root.length()
  let stop: Int = document.path.length() - ".raescene".length()
  if stop <= start {
    ret ""
  }
  ret document.path.sub(start: start, len: stop - start)
}

func createEmptySceneDocument(path: view String) ret SceneDocument {
  ret SceneDocument {
    path: "{path}"
    directory: directoryOf(path: path)
    root: resolveSceneRoot(scenePath: path)
    projectPack: ""
    projectName: ""
    projectScenes: List.create(String, cap: 1)
    fileName: fileNameOf(path: path)
    scene: parseScene(source: "")
    registry: createSceneRegistry()
    assets: createSceneAssets()
    pageRoot: noEntity()
    designW: defaultDesignW
    designH: defaultDesignH
    columnW: defaultDesignW
    unitScale: 0.0
    safeInsets: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
    nodeCount: 0
    loaded: false
    status: "no document"
    watchedPaths: List.create(String, cap: 8)
    reloads: 0
  }
}

# The design extent: the root node's authored Rect when it has one, else
# 1080x1920; RAE_UI_EDITOR_DESIGN=WxH wins over both. Then the DEVICE FRAME
# (viewportSystem): a scene that declares `unitScale` is authored for a phone
# — its extent becomes the active preset's size in design units, its page a
# 360pt column centered in it, with the preset's safe-area insets — the frame
# 106 lays its pages out in, so the editor shows the same coordinate system.
func documentDesignSize(document: mod SceneDocument) {
  document.designW = defaultDesignW
  document.designH = defaultDesignH
  document.unitScale = 0.0
  let scene: view Scene => document.scene
  if scene.ok {
    let top: JsonValue = Json.root(doc: scene.doc)
    document.unitScale = optFloat(
      doc: scene.doc
      container: top
      key: "unitScale"
      fallback: 0.0
    )
    let rootIdx: Int = sceneNodeIndex(this: scene, nodeId: scene.rootNodeId)
    if rootIdx >= 0 {
      let node: view SceneNode => nodeAt(this: scene, idx: rootIdx)
      let bag: JsonValue = Json.jsonValueAt(doc: scene.doc, idx: node.componentsValueIdx)
      let rectIdx: Int = Json.field(doc: scene.doc, this: bag, key: "Rect")
      if rectIdx >= 0 {
        let rect: JsonValue = Json.jsonValueAt(doc: scene.doc, idx: rectIdx)
        let w: Float = optFloat(
          doc: scene.doc
          container: rect
          key: "w"
          fallback: 0.0
        )
        let h: Float = optFloat(
          doc: scene.doc
          container: rect
          key: "h"
          fallback: 0.0
        )
        if w > 0.0 and h > 0.0 {
          document.designW = w
          document.designH = h
        }
      }
    }
  }
  let override: String = getEnv(name: "RAE_UI_EDITOR_DESIGN")
  let x: Int = override.indexOf(sub: "x")
  if x > 0 {
    let w: Int = override.sub(start: 0, len: x).toInt()
    let h: Int = override.sub(start: x + 1, len: override.length() - x - 1).toInt()
    if w > 0 and h > 0 {
      document.designW = w.toFloat()
      document.designH = h.toFloat()
    }
  }
  document.columnW = document.designW
  document.safeInsets = Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  let frame: DeviceFrame = editorDeviceFrame(unitScale: document.unitScale)
  if frame.enabled {
    document.designW = frame.extentW
    document.designH = frame.extentH
    document.columnW = frame.columnW
    document.safeInsets = frame.safeInsets
    log(
      "[ui-editor] frame: {frame.presetId} {frame.extentW.toInt()}x{frame.extentH.toInt()} column {frame.columnW.toInt()} safe {frame.safeInsets.l.toInt()},{frame.safeInsets.t.toInt()},{frame.safeInsets.r.toInt()},{frame.safeInsets.b.toInt()}"
    )
  }
}

# A passive viewer has no app data behind a ListView, so every list gets a few
# placeholder rows whose cells name their bound field — the row scene draws.
func seedListViewRows(world: mod UiWorld) {
  let listCount: Int = componentCount(this: world.listViews)
  loop var i: Int = 0, i < listCount, ++i {
    let entityId: EntityId = componentEntityAt(this: world.listViews, i: i)
    if componentHas(this: world.listViewDatas, entityId: entityId) {
      continue
    }
    let list: ListView = componentGet(this: world.listViews, entityId: entityId)
    var rows: List(ListViewRow) = List.create(ListViewRow, cap: listViewSampleRows)
    loop var row: Int = 0, row < listViewSampleRows, ++row {
      var keys: List(String) = List.create(String, cap: list.bindings.length + 1)
      var values: List(String) = List.create(String, cap: list.bindings.length + 1)
      keys.add(value: "{list.itemKeyField}")
      values.add(value: "row-{row + 1}")
      loop var b: Int = 0, b < list.bindings.length, ++b {
        if let binding: view ListViewBinding => list.bindings.viewAt(index: b) {
          keys.add(value: "{binding.itemField}")
          values.add(value: "{binding.itemField} {row + 1}")
        }
      }
      rows.add(value: ListViewRow { keys: own keys, values: own values })
    }
    componentSet(
      this: world.listViewDatas
      entityId: entityId
      data: ListViewData { rows: own rows }
    )
  }
}

# The document page's scroll positions by node id, so a remount can put them
# back (a reload must not jump a scrolled list to the top).
type ScrollSnapshot {
  nodeIds: List(String)
  offsets: List(Float)
}

func snapshotDocumentScrolls(world: view UiWorld) ret ScrollSnapshot {
  var snapshot: ScrollSnapshot = {
    nodeIds: List.create(String, cap: 4)
    offsets: List.create(Float, cap: 4)
  }
  let count: Int = componentCount(this: world.scrollStates)
  loop var i: Int = 0, i < count, ++i {
    let entityId: EntityId = componentEntityAt(this: world.scrollStates, i: i)
    if componentHas(this: world.nodeIdComponents, entityId: entityId) {
      let state: ScrollState = componentDataAt(this: world.scrollStates, i: i)
      snapshot.nodeIds.add(
        value: "{componentView(this: world.nodeIdComponents, entityId: entityId).id}"
      )
      snapshot.offsets.add(value: state.y)
    }
  }
  ret snapshot
}

func restoreDocumentScrolls(world: mod UiWorld, snapshot: view ScrollSnapshot) {
  loop var i: Int = 0, i < snapshot.nodeIds.length, ++i {
    if let nodeId: String = snapshot.nodeIds.copyAt(index: i) {
      if let raw: Int = world.nodeIds.get(k: "document/{nodeId}") {
        let entityId: EntityId = nodeEntityId(world: world, index: raw)
        if componentHas(this: world.scrollStates, entityId: entityId) {
          let state: mod ScrollState => componentMod(this: world.scrollStates, entityId: entityId)
          state.y = snapshot.offsets.copyAtFallback(index: i, fallback: 0.0)
        }
      }
    }
  }
}

# The files a reload depends on: the scene, every registered sub-scene that
# came from the scene's directory, and the theme beside it.
func rebuildWatchedPaths(document: mod SceneDocument) {
  document.watchedPaths.clear()
  document.watchedPaths.add(value: "{document.path}")
  loop var i: Int = 0, i < document.registry.ids.length, ++i {
    if let sceneId: String = document.registry.ids.copyAt(index: i) {
      let path: String = scenePackageFile(root: document.root, sceneId: sceneId)
      if exists(path: path) {
        document.watchedPaths.add(value: path)
      }
    }
  }
  loop var j: Int = 0, j < document.assets.importedPaths.length, ++j {
    if let path: String = document.assets.importedPaths.copyAt(index: j) {
      document.watchedPaths.add(value: path)
    }
  }
}

# A scene written against the old `<dir>/theme.raescene` auto-load (removed in
# #1008) declares no import while a theme file sits beside it: say which line
# it needs, instead of silently rendering in the library default theme.
func reportUnimportedTheme(document: view SceneDocument, world: mod UiWorld) {
  if sceneImports(scene: document.scene).length > 0 or sceneDeclaresTokens(scene: document.scene) {
    ret
  }
  var themeFile: String = ""
  if exists(path: "{document.directory}Theme.raescene") {
    themeFile = "Theme"
  } else if exists(path: "{document.directory}theme.raescene") {
    themeFile = "theme"
  }
  if themeFile.length() is 0 {
    ret
  }
  reportSceneDiagnostic(
    diagnostics: world.sceneDiagnostics
    sceneId: document.fileName
    nodeId: ""
    kind: SceneDiagnosticKind.unknownToken
    name: "import"
    message: "{themeFile}.raescene beside the scene is not loaded by convention (#1008); add \"import\": [\"Theme\"] to use it"
  )
}

# mountPage registers `document/<nodeId>` -> entity but tags no NodeId / Name
# component (loadScene does; the page mount does not). The inspector names
# nodes by component, so tag every mounted node of `scene` that has none.
# Instances of one sub-scene share ids, and the map keeps the last mounted, so
# only that instance's nodes get their authored id — the others read as their
# entity index.
func tagMountedNodeIds(world: mod UiWorld, scene: view Scene, pageId: view String) {
  loop var i: Int = 0, i < scene.nodes.length, ++i {
    let node: view SceneNode => nodeAt(this: scene, idx: i)
    if let raw: Int = world.nodeIds.get(k: "{pageId}/{node.nodeId}") {
      let entityId: EntityId = nodeEntityId(world: world, index: raw)
      if componentHas(this: world.nodeIdComponents, entityId: entityId) is false {
        let nodeId: NodeId = { id: "{node.nodeId}" }
        componentSet(this: world.nodeIdComponents, entityId: entityId, data: own nodeId)
        let name: Name = { label: "{node.nodeId}" }
        componentSet(this: world.names, entityId: entityId, data: own name)
      }
    }
  }
}

# Step 1 of a (re)load: parse the file and resolve what it imports. A parse
# failure keeps the last good page and puts the error in the status +
# diagnostics; returns whether the document is ready to mount. The theme the
# page sees is known only after this step (its `import`s name it), so the
# caller installs it on the world BEFORE documentMountSystem deserialises the
# nodes — tokens resolve at load time.
func documentPrepareSystem(document: mod SceneDocument, world: mod UiWorld) ret Bool {
  if document.path.length() is 0 {
    # A project with no scene: nothing to parse, the status already says so.
    clearSceneDiagnostics(diagnostics: world.sceneDiagnostics)
    ret false
  }
  let scene: Scene = loadSceneFile(path: document.path)
  if scene.ok is false {
    document.status = "parse error: {scene.errorMsg}"
    clearSceneDiagnostics(diagnostics: world.sceneDiagnostics)
    reportSceneDiagnostic(
      diagnostics: world.sceneDiagnostics
      sceneId: document.fileName
      nodeId: ""
      kind: SceneDiagnosticKind.parseError
      name: document.fileName
      message: scene.errorMsg
    )
    log("[ui-editor] {document.path}: {document.status}")
    ret false
  }
  clearSceneDiagnostics(diagnostics: world.sceneDiagnostics)
  document.scene = scene
  document.registry = createSceneRegistry()
  document.assets = resolveSceneAssets(
    entry: document.scene
    entryPath: document.path
    root: document.root
    registry: document.registry
    diagnostics: world.sceneDiagnostics
    sceneLabel: document.fileName
  )
  registerSceneReferencesTransitive(
    scene: document.scene
    root: document.root
    registry: document.registry
    diagnostics: world.sceneDiagnostics
  )
  reportUnimportedTheme(document: document, world: world)
  # The bundles the document and its imports declare (ui/SceneBundles): on
  # the world before the mount expands the nodes that list them.
  world.bundles = sceneImportedBundles(
    entry: document.scene
    assets: document.assets
    registry: document.registry
  )
  ret true
}

# Step 2: register + mount the prepared scene under the `document` layer; on a
# reload, unmount the previous page first. `builtinScenes` are the app's own
# sub-scenes (the chrome's rows) that live in the same registry, since the list
# system resolves every ListView against one registry.
func documentMountSystem(
  document: mod SceneDocument
  world: mod UiWorld
  uiSystems: view UiSystems
  builtinScenes: view List(BuiltinScene)
) {
  var scrolls: ScrollSnapshot = {
    nodeIds: List.create(String, cap: 1)
    offsets: List.create(Float, cap: 1)
  }
  if document.loaded {
    scrolls = snapshotDocumentScrolls(world: world)
    unmountPage(world: world, uiSystems: uiSystems, pageId: "document")
  }
  loop let entry: view BuiltinScene in builtinScenes {
    let builtin: Scene = loadScenePackageFile(path: entry.path, sceneId: entry.sceneId)
    if builtin.ok {
      let sceneId: String = stringCopy(string: entry.sceneId)
      registerSceneTransitive(
        sceneId: own sceneId
        scene: own builtin
        root: document.root
        registry: document.registry
        diagnostics: world.sceneDiagnostics
      )
    }
  }
  documentDesignSize(document: document)
  let overrides: List(SceneOverride) = List.create(SceneOverride, cap: 1)
  let before: Int = aliveCount(world: world)
  document.pageRoot = mountPage(
    world: world
    uiSystems: uiSystems
    pageId: "document"
    scene: document.scene
    overrides: overrides
    w: document.columnW
    h: document.designH
  )
  setLayerById(world: world, entityId: document.pageRoot, id: "document")
  # The complete reachable scene graph was registered during preparation, so
  # the resolver can safely mount nested instances in its own depth loop.
  resolveSceneInstances(
    world: world
    uiSystems: uiSystems
    registry: document.registry
    pageId: "document"
  )
  seedListViewRows(world: world)
  tagMountedNodeIds(world: world, scene: document.scene, pageId: "document")
  loop var r: Int = 0, r < document.registry.ids.length, ++r {
    let registered: view Scene => sceneRegistryGet(reg: document.registry, idx: r)
    tagMountedNodeIds(world: world, scene: registered, pageId: "document")
  }
  restoreDocumentScrolls(world: world, snapshot: scrolls)
  rebuildWatchedPaths(document: document)
  document.nodeCount = aliveCount(world: world) - before
  document.loaded = true
  document.status = "ok"
}
