# The editor's long-lived state (the 106/114 composition shape, #822): the
# `App` struct IS the resource list. No globals — every system takes the narrow
# state it needs from here.
open ui/Ecs
open ecs/Schedule
open ui/renderSystem/RenderSystem
open Gpu2dCanvas
open ui/DebugOverlay
open ui/WindowGeometry
open ui/UiSystems

# Which font files are loaded into gpuUi right now ("" = the fallback atlas),
# so a reload only spends an atlas slot when the document's fonts change.
type EditorFonts {
  textFontPath: String
  iconFontPath: String
}

# One chrome sub-scene the binary ships with: where its file is, and the
# package id the rest of the editor addresses it by. The two travel together
# because they are one fact — a path without its id registers a template
# nothing can find, and an id without its path is a dangling reference.
#
# Previously these were two parallel `List(String)`s zipped by index, which
# nothing enforced: a misaligned pair registered a row template under the
# wrong id and surfaced far away as a missing ListView template. `sceneId` is
# a plain String by decision (docs/stringly-typed-ids.md, #78790621).
type BuiltinScene {
  path: String
  sceneId: String
}

type App {
  gpuUi: Gpu2dUi
  canvas: Gpu2dCanvas
  world: UiWorld
  # The lib systems' derived tables (ui/UiSystems): layout's rects, the safe
  # insets, the parents — owned next to the world, handed to the pipeline.
  uiSystems: UiSystems
  schedule: Schedule
  document: SceneDocument
  viewportSystem: ViewportSystem
  # The chrome: its authored components (its own tables, not lib's) + page
  # root + what the bound labels show.
  chromeSystem: ChromeSystem
  textureSystem: TextureSystem
  fonts: EditorFonts
  watch: FileWatch
  inspectorSystem: InspectorSystem
  # The frame + safe-area guides (guideSystem), an authored overlay scene.
  guideSystem: GuideSystem
  # Zoom + pan of the document (cameraSystem).
  cameraSystem: CameraSystem
  # The outline pools ("Outlines" / "Buttons"): their authored pool roots.
  outlinePoolSystem: OutlinePoolSystem
  # The shared amber fps / memory / heartbeat widget every app carries
  # (lib/ui/DebugOverlay) — immediate-mode, drawn last so it sits on top of
  # the chrome. Created with everything off in headless runs so the gate's
  # screenshots stay deterministic.
  debugOverlay: DebugOverlay
  # Where the user put the window, remembered across restarts (a `rae watch`
  # reload is a restart) — the lib opt-in 106 uses, keyed by app id. Not
  # restored or written in headless runs, so the gate's window is always the
  # authored 1400x900.
  windowGeometry: WindowGeometry
  testSelectNodeId: String
  # RAE_UI_EDITOR_TEST_SET_RECT=<field>=<value> (e.g. "w=200"): after the boot
  # selection, write that Rect field on EVERY selected node — the headless
  # proof that an edit is a write-to-all, not a write-to-one.
  testSetRect: String
  # RAE_UI_EDITOR_TEST_CLICKS="[mod:]target ...": canvas clicks replayed once
  # after the first layout, through the live gesture path. The pixel-free
  # proof that empty-space deselect and the modifiers work.
  testClicks: String
  # RAE_UI_EDITOR_TEST_TREE_CLICKS: the same, for hierarchy rows — where
  # Shift spans a range instead of adding one node.
  testTreeClicks: String
  # RAE_UI_EDITOR_TEST_COMPONENT="add:|remove:|filter:<name>": one component-list
  # operation against the boot selection.
  testComponent: String
  # The chrome's own sub-scenes, re-registered into the document's registry on
  # every (re)load — one registry serves every ListView, chrome or document.
  builtinScenes: List(BuiltinScene)
  headless: Bool
}
