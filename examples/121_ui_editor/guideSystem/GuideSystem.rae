# guideSystem — the frame and safe-area guides (docs/ui-editor-design.md §2,
# the reference editor's overlays): a dashed outline around the page COLUMN
# (the design area the document is laid out in) and a second one around the
# SAFE AREA inside it (the device frame's insets), each with a small label.
# The guides are an AUTHORED scene (assets/scenes/chrome/Guides.raescene) on
# its own `guides` layer between the document and the chrome — plain `Shape`
# nodes with a dashed stroke; this system only writes their Rects from the
# document's frame after every load. `G` toggles them. The safe-area guide
# shows only when the frame has insets (a scene without `unitScale` has no
# device frame, so only the design area is outlined).
open ui/Ecs
open ui/Components
open ui/Layer
open ui/Scene
open ui/SceneFile
open ui/SceneInstance
open ui/BindingComponents
open ecs/Entity
open ecs/ComponentTable

const guidesScenePath: String = "examples/121_ui_editor/assets/scenes/chrome/Guides.raescene"

const guideLabelInset: Float = 8.0

# The chrome's status bar covers the bottom of the design space; the frame
# label sits just above it.
const statusBarClearance: Float = 72.0

type GuideState {
  pageRoot: EntityId
  # The child that carries the camera and the frame guides (the node
  # authored with Camera2D); the outlines are its screen-space siblings.
  frameSpace: EntityId
}

# Mount the guides page on its layer, sized to the design space.
func createGuides(world: mod UiWorld, designW: view Float, designH: view Float) ret GuideState {
  let layer: EntityId = createLayerEntity(world: world, id: "guides", order: 50)
  let scene: Scene = loadSceneFile(path: guidesScenePath)
  let overrides: List(SceneOverride) = List.create(SceneOverride, cap: 1)
  let root: EntityId = mountPage(
    world: world
    pageId: "guides"
    scene: scene
    overrides: overrides
    w: designW
    h: designH
  )
  setLayerById(world: world, entity: root, id: "guides")
  ret GuideState { pageRoot: root, frameSpace: guidesFrameSpace(world: world, pageRoot: root) }
}

# The guides page's camera entity: the descendant authored with Camera2D.
func guidesFrameSpace(world: view UiWorld, pageRoot: view EntityId) ret EntityId {
  let count: Int = componentCount(this: world.cameras)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: world.cameras, i: i)
    if pageOf(world: world, entity: entity) is "guides" {
      ret entity
    }
  }
  ret pageRoot
}

# Write the Rect of every node tagged with `kind`.
func setGuideRects(
  world: mod UiWorld
  kind: view GuideRectKind
  x: view Float
  y: view Float
  w: view Float
  h: view Float
  active: view Bool
) {
  let count: Int = componentCount(this: world.guideRects)
  loop var i: Int = 0, i < count, ++i {
    let entity: EntityId = componentEntityAt(this: world.guideRects, i: i)
    let guide: GuideRect = componentDataAt(this: world.guideRects, i: i)
    if guide.kind is not kind {
      continue
    }
    componentSet(this: world.actives, entity: entity, data: Active { value: active })
    if componentHas(this: world.rects, entity: entity) {
      let rect: mod Rect => componentMod(this: world.rects, entity: entity)
      rect.position.x = x
      rect.position.y = y
      rect.size.x = w
      rect.size.y = h
    }
  }
}

# Write the guides from the document's frame: the column centred in the
# design extent, the safe area inset from it. Call after every load. The
# labels' text goes through the status (TextBinding editor.frameLabel /
# editor.safeAreaLabel); their placement is a GuideRect like the outlines.
func syncGuides(
  guides: mod GuideState
  world: mod UiWorld
  status: mod EditorStatus
  designW: view Float
  designH: view Float
  columnW: view Float
  safeInsets: view Insets
) {
  if componentHas(this: world.rects, entity: guides.frameSpace) {
    let rect: mod Rect => componentMod(this: world.rects, entity: guides.frameSpace)
    rect.size.x = designW
    rect.size.y = designH
  }
  var columnX: Float = (designW - columnW) / 2.0
  if columnX < 0.0 {
    columnX = 0.0
  }
  setGuideRects(
    world: world
    kind: GuideRectKind.frame
    x: columnX
    y: 0.0
    w: columnW
    h: designH
    active: true
  )
  setGuideRects(
    world: world
    kind: GuideRectKind.frameLabel
    x: columnX + guideLabelInset
    y: designH - 28.0 - guideLabelInset - statusBarClearance
    w: 400.0
    h: 28.0
    active: true
  )
  status.frameLabel = "frame {columnW.toInt()} x {designH.toInt()}"
  let hasSafe: Bool = safeInsets.t > 0.0 or safeInsets.b > 0.0 or safeInsets.l > 0.0 or safeInsets.r > 0.0
  let safeX: Float = columnX + safeInsets.l
  let safeY: Float = safeInsets.t
  let safeW: Float = columnW - safeInsets.l - safeInsets.r
  let safeH: Float = designH - safeInsets.t - safeInsets.b
  setGuideRects(
    world: world
    kind: GuideRectKind.safeArea
    x: safeX
    y: safeY
    w: safeW
    h: safeH
    active: hasSafe
  )
  setGuideRects(
    world: world
    kind: GuideRectKind.safeAreaLabel
    x: safeX + guideLabelInset
    y: safeY + guideLabelInset
    w: 400.0
    h: 28.0
    active: hasSafe
  )
  status.safeAreaLabel = "safe area {safeInsets.l.toInt()},{safeInsets.t.toInt()},{safeInsets.r.toInt()},{safeInsets.b.toInt()}"
}

# RAE_UI_EDITOR_GUIDES=0: the guides page root is an EditorPanel of kind
# `guides`, so showing and hiding is the panel's Active (chromeSystem; `G`
# toggles it the same way).
func setGuidesVisible(world: mod UiWorld, visible: view Bool) {
  setEditorPanelOpen(world: world, kind: EditorPanelKind.guides, open: visible)
}
