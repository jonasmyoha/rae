# Link the existing one-command submission ABI (no window is created).
import Sdl3
open webgpu/Context
open webgpu/Webgpu
open webgpu/ReadRequest

func createBuffer(usage: copy UInt64) ret Ptr {
  let descriptor: WGPUBufferDescriptor = { size: 32 as UInt64, usage: usage }
  ret wgpuDeviceCreateBuffer(device: webgpuDevice(), descriptor: descriptor)
}

type ReadPair {
  first: ReadRequest
  second: ReadRequest
}

func createReadPair(firstBuffer: copy Ptr, secondBuffer: copy Ptr) ret opt ReadPair {
  if let first: ReadRequest = ReadRequest.create(buffer: firstBuffer, range: { offset: 8 as UInt64, size: 16 as UInt64 }) {
    if let second: ReadRequest = ReadRequest.create(buffer: secondBuffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
      ret ReadPair { first: own first, second: own second }
    }
  }
  ret none
}

func waitForRead(request: view ReadRequest) ret Int {
  var status: Int = 0
  var spins: Int = 0
  loop status is 0 and spins < 100000 {
    status = poll(this: request)
    spins = spins + 1
  }
  ret status
}

func consumeCompleted(request: own ReadRequest) ret Bool {
  ret waitForRead(request: request) is 1
}

func checkListCleanup() ret Bool {
  let firstBuffer: Ptr = createBuffer(usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst)
  let secondBuffer: Ptr = createBuffer(usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst)
  let requests: List(ReadRequest) = List.create(ReadRequest, cap: 2)
  if let first: ReadRequest = ReadRequest.create(buffer: firstBuffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
    requests.add(value: own first)
  } else {
    wgpuBufferRelease(buffer: firstBuffer)
    wgpuBufferRelease(buffer: secondBuffer)
    ret false
  }
  if let second: ReadRequest = ReadRequest.create(buffer: secondBuffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
    requests.add(value: own second)
  } else {
    wgpuBufferRelease(buffer: firstBuffer)
    wgpuBufferRelease(buffer: secondBuffer)
    ret false
  }
  # The two list elements now own the retained native requests and buffers.
  wgpuBufferRelease(buffer: firstBuffer)
  wgpuBufferRelease(buffer: secondBuffer)
  var correct: Bool = requests.length is 2
  if let firstRequest: view ReadRequest => requests.viewAt(index: 0) {
    if waitForRead(request: firstRequest) is not 1 { correct = false }
  } else {
    correct = false
  }
  if let secondRequest: view ReadRequest => requests.viewAt(index: 1) {
    if waitForRead(request: secondRequest) is not 1 { correct = false }
  } else {
    correct = false
  }
  # List cleanup consumes each element and invokes ReadRequest.drop exactly once.
  ret correct
}

func checkCycle() ret Bool {
  let source: Ptr = createBuffer(usage: WGPUBufferUsage_CopySrc + WGPUBufferUsage_CopyDst)
  let first: Ptr = createBuffer(usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst)
  let second: Ptr = createBuffer(usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst)
  let input: List(Int) = { 11, 22, 33, 44 }
  wgpuQueueWriteBuffer(queue: webgpuQueue(), buffer: source, bufferOffset: 0 as UInt64, data: input.data, size: 32 as UInt64)
  let encoderDescriptor: WGPUCommandEncoderDescriptor = { }
  let encoder: Ptr = wgpuDeviceCreateCommandEncoder(device: webgpuDevice(), descriptor: encoderDescriptor)
  wgpuCommandEncoderCopyBufferToBuffer(commandEncoder: encoder, source: source, sourceOffset: 0 as UInt64, destination: first, destinationOffset: 0 as UInt64, size: 32 as UInt64)
  wgpuCommandEncoderCopyBufferToBuffer(commandEncoder: encoder, source: source, sourceOffset: 0 as UInt64, destination: second, destinationOffset: 0 as UInt64, size: 32 as UInt64)
  let commandDescriptor: WGPUCommandBufferDescriptor = { }
  let command: Ptr = wgpuCommandEncoderFinish(commandEncoder: encoder, descriptor: commandDescriptor)
  submitCommand(command: command)
  wgpuCommandBufferRelease(commandBuffer: command)
  wgpuCommandEncoderRelease(commandEncoder: encoder)
  wgpuBufferRelease(buffer: source)
  if let reads: ReadPair = createReadPair(firstBuffer: first, secondBuffer: second) {
    # Each native request retains its buffer independently of these handles.
    wgpuBufferRelease(buffer: first)
    wgpuBufferRelease(buffer: second)
    var output: List(Int) = { 0 }
    var i: Int = 0
    loop i < 20 {
      output.add(value: 0)
      i = i + 1
    }
    let firstStatus: Int = waitForRead(request: reads.first)
    let secondStatus: Int = waitForRead(request: reads.second)
    var correct: Bool = firstStatus is 1 and secondStatus is 1
    if reads.first.byteCount is not (16 as UInt64) { correct = false }
    if reads.second.byteCount is not (32 as UInt64) { correct = false }
    var tooSmall: List(Int) = { 0 }
    if copyTo(this: reads.first, destination: tooSmall) { correct = false }
    if not copyTo(this: reads.first, destination: output) { correct = false }
    if output.copyAtFallback(index: 0, fallback: -1) is not 22 { correct = false }
    if output.copyAtFallback(index: 1, fallback: -1) is not 33 { correct = false }
    if not copyTo(this: reads.second, destination: output) { correct = false }
    if output.copyAtFallback(index: 3, fallback: -1) is not 44 { correct = false }
    ret correct
  }
  wgpuBufferRelease(buffer: first)
  wgpuBufferRelease(buffer: second)
  ret false
}

func main() ret Int {
  if webgpuBootstrap() is not 1 {
    log("no GPU")
    ret 1
  }
  var i: Int = 0
  loop i < 32 {
    if not checkCycle() {
      log("read cycle failed {i}")
      ret 1
    }
    i = i + 1
  }
  log("32 independent paired reads, bounded copies and growing destinations OK")
  if not checkListCleanup() { ret 6 }
  log("owner fields, transfer and List cleanup OK")
  let buffer: Ptr = createBuffer(usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst)
  if let invalid: ReadRequest = ReadRequest.create(buffer: buffer, range: { offset: 8 as UInt64, size: 32 as UInt64 }) {
    ret 2
  }
  if let cancelled: ReadRequest = ReadRequest.create(buffer: buffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
    cancelled.drop()
  } else {
    ret 2
  }
  webgpuPoll(wait: 0)
  # Reuse the same buffer after cancellation and completion/unmap.
  i = 0
  loop i < 32 {
    if let request: ReadRequest = ReadRequest.create(buffer: buffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
      if waitForRead(request: request) is not 1 { ret 3 }
    } else {
      ret 3
    }
    i = i + 1
  }
  if let transferred: ReadRequest = ReadRequest.create(buffer: buffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
    if not consumeCompleted(request: own transferred) { ret 3 }
  } else {
    ret 3
  }
  let blockingOutput: List(Int) = { 1, 1, 1, 1 }
  if webgpuMapRead(buffer: buffer, size: 32 as UInt64, dst: blockingOutput.data) is not 1 { ret 5 }
  if blockingOutput.copyAtFallback(index: 3, fallback: -1) is not 0 { ret 5 }
  log("existing blocking read diagnostic OK")
  if let destroyed: ReadRequest = ReadRequest.create(buffer: buffer, range: { offset: 0 as UInt64, size: 32 as UInt64 }) {
    wgpuBufferDestroy(buffer: buffer)
    if waitForRead(request: destroyed) is not -1 { ret 4 }
  } else {
    ret 4
  }
  wgpuBufferRelease(buffer: buffer)
  log("failure, cancellation, repeated map/unmap and destroyed-buffer callback OK")
  ret 0
}

# Existing generic single-command submission ABI.
func submitCommand(command: Ptr) extern("rae_gb_submit")
