# QR codes in 3D and in the UI (the qr package, docs/qr.md): a turning box whose
# faces carry a code as a material picture (qr/QrImage, crisp: every
# module a whole number of texels), and a QrCode node in the .raescene UI
# (qr/qrCodeSystem, painted as whole-pixel rectangles). A phone camera
# scans both. Beside the box stands a machine (mesh/RoundedBox: rounded vertical edges, a flat
# top) with the code on its front and right sides only: each side is a mesh of its own with its own
# material, and its UVs are a 0..1 square. Drag to turn the view, the wheel zooms.
#
#   RAE_QR_TEST_FRAME=1 holds the box still at a fixed angle (screenshots);
#   RAE_QR_YAW / RAE_QR_DISTANCE look at a face straight on;
#   RAE_QR_SCAN=1 reads the middle of the rendered frame every 10 frames
#   (qr/qrScanSystem) and logs what it reads; RAE_QR_SCAN_LAYER=world reads
#   it at the world layer's end instead (the 3D frame, none of the UI over it);
#   RAE_QR_HUD_CODE=1 shows a QR code in the HUD over the middle, and
#   RAE_QR_COVER=1 a dialog panel over the middle
import Gpu2d
import Math
import Sys
import Vec3
open app3d/UiShell
open Gbuffer
open Math3d
open Mesh3d
open RendererDeferred
open RendererImages
open Rendergraph
open Scene3d
open ui/Ecs
open ecs/Entity
open ecs/ComponentTable
open ui/Registry
open ui/RenderSystem
open ui/UiLayers
open qr/qrCodeSystem/QrCodeSystem
open Gpu2dCanvas
open ui/UiSystems
open qr/QrTables
open qr/QrEncoder
open qr/QrImage
open qr/QrReader
open qr/qrScanSystem/QrScanSystem
open mesh/RoundedBox

const boxText: String = "https://example.com/rae/qr/box"

# The box's code as a material picture layer (-1 when it cannot be made)
func boxCodeLayer(renderer: mod DeferredRenderer) ret Int {
  if let symbol: QrSymbol = qrEncodeText(text: boxText, level: QrErrorCorrection.medium) {
    ret rendererAddSurfaceImagePixels(
      renderer: renderer
      name: "qr-box"
      pixels: qrImagePixels(symbol: symbol, side: 512, quietZone: 4)
    )
  }
  ret -1
}

func meshOf(renderer: mod DeferredRenderer, meshData: view MeshData) ret MeshHandle {
  ret uploadMesh(
    renderer: renderer
    verts: meshData.verts
    vertCount: meshData.vertCount
    indices: meshData.indices
  )
}

func plainMaterial(color: view Vec3, roughness: view Float) ret Material3d {
  ret Material3d {
    baseColor: color
    metallic: 0.0
    roughness: roughness
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: false
  }
}

# A machine about the size of a vending machine at (x, y), standing on the ground: its body and
# back and left sides in `color`, its front and right sides in `coded` (the QR code)
func addMachine(
  renderer: mod DeferredRenderer
  scene: mod World3d
  x: view Float
  y: view Float
  color: view Material3d
  coded: view Material3d
) {
  let parts: RoundedBoxParts = makeRoundedBoxParts(spec: RoundedBoxSpec {
    width: 0.9
    depth: 0.8
    height: 1.9
    radius: 0.12
    segments: 8
  })
  var meshes: List(MeshData) = { parts.body }
  loop let side: view MeshData in parts.sides {
    meshes.add(value: side)
  }
  loop var i: Int = 0, i < meshes.length, ++i {
    var material: Material3d = color
    # the sides follow the body: front (1) and right (2) carry the code
    if i is 1 or i is 2 {
      material = coded
    }
    let unusedEntityId: EntityId = world3dAddMeshInstance(
      world: scene
      mesh: meshOf(
        renderer: renderer
        meshData: meshes.copyAtFallback(index: i, fallback: parts.body)
      )
      material: material
      position: Vec3.create(x: x, y: y, z: 0.0)
      rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
      scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
    )
  }
}

# Show or hide the scene node `nodeId`
func showNode(world: mod UiWorld, nodeId: view String, shown: view Bool) {
  let entityId: EntityId = nodeEntityFor(world: world, nodeId: nodeId)
  if not isNone(this: entityId) {
    componentSet(this: world.actives, entityId: entityId, data: Active { value: shown })
  }
}

func main() ret Int {
  Gpu2d.initWindow(width: 1280, height: 800, title: "147: QR codes in 3D and UI")
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  let box: MeshHandle = meshOf(renderer: renderer, meshData: makeBox(size: 2.0))
  let ground: MeshHandle = meshOf(renderer: renderer, meshData: makePlane(size: 30.0, segments: 1))
  var boxMaterial: Material3d = plainMaterial(
    color: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
    roughness: 0.6
  )
  boxMaterial.colorTextureLayer = boxCodeLayer(renderer: renderer)
  var scene: World3d = create()
  let boxEntityId: EntityId = world3dAddMeshInstance(
    world: scene
    mesh: box
    material: boxMaterial
    position: Vec3.create(x: 0.0, y: 0.0, z: 1.2)
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  let groundEntityId: EntityId = world3dAddMeshInstance(
    world: scene
    mesh: ground
    material: plainMaterial(color: Vec3.create(x: 0.2, y: 0.24, z: 0.3), roughness: 0.85)
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  addMachine(
    renderer: renderer
    scene: scene
    x: -2.3
    y: -0.4
    color: plainMaterial(color: Vec3.create(x: 0.75, y: 0.18, z: 0.16), roughness: 0.45)
    coded: boxMaterial
  )
  var camera: Camera3d = defaultCamera3d()
  camera.target = Vec3.create(x: 0.0, y: 0.0, z: 1.2)
  let light: Light3d = defaultLight3d()

  let uiResources: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: ""
    themeFile: "Theme.raescene"
  )
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  var qrCodeSystem: QrCodeSystem = createQrCodeSystem()
  seedWorldTheme(world: world, res: uiResources)
  # The UI lays out in the window's points (app3d/UiShell), like every Rae UI
  fitUiToWindow(world: world, uiSystems: uiSystems, res: uiResources)
  let uiRoot: EntityId = mountUiScene(
    world: world
    uiSystems: uiSystems
    path: "examples/147_qr_codes/assets/ui.raescene"
    res: uiResources
  )
  # The scene's QrCode components belong to the QR system (which marks their
  # nodes CustomPaint, so the layer plan leaves their places to qrCodePaintStep)
  qrCodeTakePending(world: world, qrCodeSystem: qrCodeSystem)
  # The window's layer stack, this world's part in it and the paint plan
  # (docs/ui-layers-design.md): the QR code is painted in its node's place in the
  # paint order, so a dialog over it covers it
  var layerStack: LayerStack = createStandardLayerStack()
  layerStackAddWorld(stack: layerStack, worldKey: 0)
  var layerContributions: List(LayerContribution) = { createLayerContribution(worldKey: 0) }
  var paintPlan: LayerPaintPlan = createLayerPaintPlan()

  if compileDeferred(renderer: renderer) is not 0 {
    log("deferred graph invalid")
    ret 1
  }
  let testFrame: Bool = Sys.getEnv(name: "RAE_QR_TEST_FRAME").length() > 0
  var scanner: QrScanner = createQrScanner(intervalFrames: 10, regionSide: 512)
  scanner.enabled = Sys.getEnv(name: "RAE_QR_SCAN").length() > 0
  scanner.afterLayer = Sys.getEnv(name: "RAE_QR_SCAN_LAYER")
  showNode(world: world, nodeId: "HudCode", shown: Sys.getEnv(name: "RAE_QR_HUD_CODE") is "1")
  showNode(world: world, nodeId: "Cover", shown: Sys.getEnv(name: "RAE_QR_COVER") is "1")
  let startTime: Float64 = Gpu2d.nowSeconds()
  var yaw: Float = -0.45
  var pitch: Float = 0.28
  var distance: Float = 6.0
  # A test view straight at one face (screenshots: RAE_QR_YAW=<radians>,
  # RAE_QR_DISTANCE=<m>)
  if Sys.getEnv(name: "RAE_QR_YAW").length() > 0 {
    yaw = Sys.getEnv(name: "RAE_QR_YAW").toFloat()
    pitch = 0.05
  }
  if Sys.getEnv(name: "RAE_QR_PITCH").length() > 0 {
    pitch = Sys.getEnv(name: "RAE_QR_PITCH").toFloat()
  }
  if Sys.getEnv(name: "RAE_QR_DISTANCE").length() > 0 {
    distance = Sys.getEnv(name: "RAE_QR_DISTANCE").toFloat()
  }
  var lastX: Float = 0.0
  var lastY: Float = 0.0
  var dragging: Bool = false
  loop not Gpu2d.pollClose() {
    let resized: Bool = resizeUiToWindow(world: world, uiSystems: uiSystems, res: uiResources)
    let pointerX: Float = Gpu2d.pointerX()
    let pointerY: Float = Gpu2d.pointerY()
    if Gpu2d.pointerDown() {
      if dragging {
        yaw = yaw + (pointerX - lastX) * 0.008
        pitch = Math.clamp(val: pitch - (pointerY - lastY) * 0.008, low: 0.05, high: 1.4)
      }
      dragging = true
    } else {
      dragging = false
    }
    lastX = pointerX
    lastY = pointerY
    distance = Math.clamp(val: distance - Gpu2d.wheelMove() * 0.6, low: 3.0, high: 20.0)
    camera.position = orbitEye(
      targetX: camera.target.x
      targetY: camera.target.y
      targetZ: camera.target.z
      yaw: yaw
      pitch: pitch
      dist: distance
    )
    var turn: Float = ((Gpu2d.nowSeconds() - startTime) as Float) * 0.35
    if testFrame {
      turn = 0.0
    }
    world3dWriteTransform(
      world: scene
      entityId: boxEntityId
      transform: Transform3d {
        position: Vec3.create(x: 0.0, y: 0.0, z: 1.2)
        rotation: Vec3.create(x: 0.0, y: 0.0, z: turn)
        scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      }
    )
    runUiSystems(world: world, uiSystems: uiSystems, res: uiResources)
    if Gpu2d.renderGate() {
      let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
      loop var pass: Int = 0, pass < deferredOrderLength(renderer: renderer), ++pass {
        let tag: Int = deferredTagAt(renderer: renderer, i: pass)
        if tag is RenderTag.uiOverlay {
          Gpu2d.beginFrameLoad(canvas: renderer.canvas)
          if let contribution: mod LayerContribution = layerContributions.modAt(index: 0) {
            refreshLayerContribution(
              contribution: contribution
              stack: layerStack
              world: world
              uiSystems: uiSystems
            )
          }
          buildLayerPaintPlan(
            plan: paintPlan
            stack: layerStack
            contributions: layerContributions
            editor: false
          )
          loop let step: view PaintStep in paintPlan.steps {
            # the scan's copy before the first step above its layer (RAE_QR_SCAN_LAYER)
            let unusedCopied: Bool = qrScanBeforeStep(
              scanner: scanner
              canvas: renderer.canvas
              stack: layerStack
              step: step
            )
            if not paintPlanStepRaeG(
              step: step
              stack: layerStack
              worldKey: 0
              world: world
              uiSystems: uiSystems
              res: uiResources
              canvas: renderer.canvas
            ) {
              let unusedQr: Bool = qrCodePaintStep(
                qrCodeSystem: qrCodeSystem
                world: world
                uiSystems: uiSystems
                canvas: renderer.canvas
                step: step
              )
            }
          }
        } else {
          renderDeferredPassWorld(
            renderer: renderer
            tag: tag
            world: scene
            camera: camera
            light: light
            aspect: aspect
          )
        }
      }
      world3dPrevTransformSystem(world: scene)
      if qrScanFrame(scanner: scanner, canvas: renderer.canvas) {
        if scanner.lastRead {
          if let result: view QrReadResult = scanner.latest {
            log(
              "[qr] scan {scanner.scans}: \"{result.text}\" ({scanner.lastLatencyFrames} frames, decoded in {scanner.lastDecodeNs / 1000} us)"
            )
          }
        } else {
          log(
            "[qr] scan {scanner.scans}: no code ({scanner.lastLatencyFrames} frames, {scanner.lastDecodeNs / 1000} us)"
          )
        }
      }
    }
    uiFrameEnd(world: world, uiSystems: uiSystems)
  }
  qrScanRelease(scanner: scanner, canvas: renderer.canvas)
  shutdownDeferredRenderer(renderer: renderer)
  Gbuffer.shutdownAll()
  Gpu2d.closeWindow()
  ret 0
}
