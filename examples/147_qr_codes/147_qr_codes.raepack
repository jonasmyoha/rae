pack QrCodes {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "QR codes"
  description: "A turning box with a QR code on each face and a QrCode node in the UI, from the qr package. A phone camera reads both."
  category: "UI"
  featured: "false"
  dependencies: {
    dep qr: {
      git: "../.."
      subdir: "packages/qr"
      version: "1.0.0"
      hash: "git-tree:79d8c270d8a9c6ae1a43bae85d65fc61dc576e4e"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
