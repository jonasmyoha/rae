pack QrCodes {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "QR codes"
  description: "A turning box with a QR code on each face and a QrCode node in the UI, from the qr package. A phone camera reads both."
  category: "UI"
  featured: "false"
  dependencies: {
    dep qr: {
      path: "../../packages/qr"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
