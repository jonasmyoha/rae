# Ocean — the realistic water tier on its own (#851): three FFT cascades
# (#849 spectrum, #850 evolution + inverse FFT) summed in the surface shader on
# a camera-centred radial LOD grid (lib/water/ClipMap.rae), whitecaps where the
# Jacobian folds, refraction and Fresnel over a deep bed. Nothing else is in
# the scene except the same brown island and three boxes as the toon lake.
#
# Controls: W/A/S/D move, Q/E down/up, shift boost, mouse-drag look;
# comma / period move the sun.
import Gpu2d
import Keys
import Math
import Sdl3
import Sys
import Vec3
open Gbuffer
open GbufferPasses
open Gpu3d
open Math3d
open Mesh3d
open RendererDeferred
open Rendergraph
open Scene3d
open Sky
open TransparentForward
open app3d/CameraRig
open water/Water
open water/WaterSystem
open water/WaterFft
open water/WaterSchedule
open WaterChecks
open water/ClipMap
open ecs/Entity

const bedDepth: Float = 6.0
const cubeCount: Int = 3

func uploadMeshData(meshData: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: meshData.verts, vertCount: meshData.vertCount, indices: meshData.indices)
}

# Identical comparison geometry in 118 and 119: a bed, three boxes and a
# central island with sloping shores. Keep this fixture synchronized.
func buildScene(box: view MeshHandle, ground: view MeshHandle) ret World3d {
  var sceneWorld: World3d = createWorld3d()
  let noEmission: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRotation: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let sand: Material3d = {
    baseColor: Vec3.create(x: 0.62, y: 0.52, z: 0.34)
    metallic: 0.0, roughness: 0.9, emission: noEmission, toon: true }
  let bedEntity: EntityId = world3dAddMeshInstance(
    world: sceneWorld, mesh: ground, material: sand
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0 - bedDepth)
    rotation: noRotation, scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0))
  loop var i: Int = 0, i < cubeCount, ++i {
    let angle: Float = i.toFloat() * 2.1 + 0.6
    let radius: Float = 26.0 + i.toFloat() * 9.0
    let size: Float = 14.0 + i.toFloat() * 6.0
    # Centre a little under the surface: the top face pokes out by ~1 m, the
    # sides run down to the bed, so depth goes 0 -> bedDepth around each island.
    let islandEntity: EntityId = world3dAddMeshInstance(
      world: sceneWorld, mesh: box, material: sand
      position: Vec3.create(x: Math.cos(x: angle) * radius, y: Math.sin(x: angle) * radius, z: 0.0 - bedDepth * 0.5 + 0.5)
      rotation: Vec3.create(x: 0.0, y: 0.0, z: angle)
      scale: Vec3.create(x: size, y: size * 0.7, z: bedDepth + 1.0))
  }

  # Low, untextured brown island: its sloping sides cross the waterline.
  let islandData: MeshData = makeSphere(rings: 24, segments: 48)
  let islandMesh: MeshHandle = uploadMeshData(meshData: islandData)
  let earth: Material3d = {
    baseColor: Vec3.create(x: 0.38, y: 0.19, z: 0.075)
    metallic: 0.0, roughness: 0.95, emission: noEmission, toon: true }
  let island: EntityId = world3dAddMeshInstance(
    world: sceneWorld, mesh: islandMesh, material: earth
    position: Vec3.create(x: 0.0, y: 0.0, z: -4.0)
    rotation: noRotation, scale: Vec3.create(x: 18.0, y: 14.0, z: 8.0))
  log("[water comparison] 1 brown island, 3 boxes")
  ret sceneWorld
}

func skyForHour(hour: copy Float) ret Sky {
  let sunDir: Vec3 = sunDirForHour(hour: hour)
  let height: Float = sunHeightForHour(hour: hour)
  let warm: Float = 1.0 - height
  let sunColor: Vec3 = Vec3.create(x: 1.0, y: 0.92 - 0.35 * warm, z: 0.85 - 0.6 * warm)
  let zenith: Vec3 = Vec3.create(x: 0.16 + 0.1 * warm, y: 0.38, z: 0.8 - 0.25 * warm)
  let horizon: Vec3 = Vec3.create(x: 0.7 + 0.2 * warm, y: 0.78, z: 0.88 - 0.3 * warm)
  ret createSkyStylised(sunDir: sunDir, sunColor: Vec3.vscale(a: sunColor, s: 2.5 + 3.0 * height),
    zenith: zenith, horizon: horizon, bands: 4.0)
}

func main() ret Int {
  Gpu2d.initWindow(width: 1280, height: 800, title: "Rae Ocean — FFT cascades, free camera")
  Gpu2d.setDesignResolution(width: 1280.0, height: 800.0, fit: 0)

  # Match the lake's depth and shoreline fixture; extend the bed to the horizon.
  let planeData: MeshData = makePlane(size: 6000.0, segments: 1)
  let ground: MeshHandle = uploadMeshData(meshData: planeData)
  let boxData: MeshData = makeBox(size: 1.0)
  let box: MeshHandle = uploadMeshData(meshData: boxData)
  var sceneWorld: World3d = buildScene(box: box, ground: ground)

  var camera: Camera3d = defaultCamera3d()
  camera.position = Vec3.create(x: 0.0, y: 0.0 - 48.0, z: 9.0)
  camera.target = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  camera.farZ = 4000.0
  var cameraRig: CameraRig = createCameraRig(camera: camera)
  toggleCameraRigMode(rig: cameraRig, camera: camera)
  var light: Light3d = defaultLight3d()

  var hour: Float = 15.5
  var sky: Sky = skyForHour(hour: hour)
  var renderer: DeferredRenderer = createDeferredRenderer()
  setRendererSky(renderer: renderer, sky: sky)
  let graphStatus: Int = compileDeferred(renderer: renderer)
  if graphStatus is not 0 {
    log("deferred graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }

  # The ocean: a realistic body on the camera-centred radial grid.
  let grid: MeshData = createRadialGridMesh(rings: 64, segments: 96, firstCell: 1.0, growth: 1.09)
  let gridMesh: MeshHandle = uploadMeshData(meshData: grid)
  var ocean: WaterBody = createOceanRealistic(surfaceZ: 0.0)
  ocean.meshId = gridMesh.id
  if Sys.getEnv(name: "RAE_WATER_MOBILE") is "1" { useMobileWaterTier(body: ocean) }
  let sizeSetting: String = Sys.getEnv(name: "RAE_WATER_FFT_SIZE")
  let cascadeSetting: String = Sys.getEnv(name: "RAE_WATER_CASCADES")
  let rateSetting: String = Sys.getEnv(name: "RAE_WATER_UPDATE_RATE")
  if sizeSetting.length() > 0 { ocean.fftSize = sizeSetting.toInt() }
  if cascadeSetting.length() > 0 { ocean.cascadeCount = cascadeSetting.toInt() }
  if rateSetting.length() > 0 { ocean.updateRate = rateSetting.toInt() }
  normalizeWaterTier(body: ocean)
  var waterSystem: WaterSystem = createWaterSystem(body: ocean)

  waterSystem.performance.enabled = Sys.getEnv(name: "RAE_WATER_PERF").length() > 0

  log("[ocean] W/A/S/D move, Q/E down/up, shift boost, mouse-drag look; comma/period move the sun")
  let fixedTestFrame: Bool = Sys.getEnv(name: "RAE_OCEAN_TEST_FRAME").length() > 0
  let startTime: Float64 = Gpu2d.nowSeconds()
  var lastTime: Float64 = startTime
  let tierCheck: Bool = Sys.getEnv(name: "RAE_WATER_TIER_CHECK") is "1"
  var checksOk: Bool = true
  var oceanFrames: Int = 0
  loop not Gpu2d.pollClose() and (not tierCheck or oceanFrames < waterCheckFrames) {
    let now: Float64 = Gpu2d.nowSeconds()
    var deltaTime: Float = (now - lastTime) as Float
    lastTime = now
    if deltaTime > 0.1 { deltaTime = 0.1 }
    if fixedTestFrame { deltaTime = 0.0 }
    var hourChanged: Bool = false
    if Sdl3.isKeyDown(key: Keys.keyComma) { hour = hour - deltaTime * 1.5 hourChanged = true }
    if Sdl3.isKeyDown(key: Keys.keyPeriod) { hour = hour + deltaTime * 1.5 hourChanged = true }
    if hour < 0.0 { hour = hour + 24.0 }
    if hour >= 24.0 { hour = hour - 24.0 }
    if hourChanged {
      sky = skyForHour(hour: hour)
      setRendererSky(renderer: renderer, sky: sky)
    }
    light.sunDir = sky.sunDir
    light.sunColor = sky.sunColor
    let cameraMoved: Bool = updateCameraRig(rig: cameraRig, camera: camera, allowInput: not fixedTestFrame, deltaTime: deltaTime)
    applyCameraRig(rig: cameraRig, camera: camera)

    let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
    if Gpu2d.renderGate() {
      var passIndex: Int = 0
      loop passIndex < deferredOrderLength(renderer: renderer) {
        let tag: Int = deferredTagAt(renderer: renderer, i: passIndex)
        if tag is RenderTag.waterFft {
          # In the test frame the sea is frozen at t = 2 s so the frame repeats.
          # Wave time is absolute elapsed time, independent of the camera's
          # capped deltaTime and of any skipped FFT update or render frame.
          waterSystem.time = (now - startTime) as Float
          if fixedTestFrame { waterSystem.time = 2.0 }
          if tierCheck and gbDeferredPrepare() is not 0 {
            prepareWaterCheck(waterSystem: waterSystem, frame: oceanFrames)
            let before: WaterCheckSample = takeWaterCheckSample(waterSystem: waterSystem)
            waterFftStep(waterSystem: waterSystem)
            if not verifyWaterCheck(waterSystem: waterSystem, before: before, frame: oceanFrames) { checksOk = false }
          } else { waterFftStep(waterSystem: waterSystem) }
        }
        if tag is RenderTag.transparentForward {
          transparentSnapshot(cache: renderer.passes.transparent)
          waterDraw(waterSystem: waterSystem, camera: camera, light: light,
            sky: renderer.sky, hasSky: renderer.hasSky, deltaTime: 0.0)
          oceanFrames = waterSystem.drawCount
        }
        renderDeferredPassWorld(
          renderer: renderer, tag: tag, world: sceneWorld
          camera: camera, light: light, aspect: aspect)
        passIndex = passIndex + 1
      }
      world3dPrevTransformSystem(world: sceneWorld)
      if tierCheck and oceanFrames > 0 and oceanFrames % waterCheckStageFrames is 0 {
        if not waterFftDiagnoseIfft(waterSystem: waterSystem) { checksOk = false }
      }
    }
  }

  if fixedTestFrame {
    log("[ocean] deterministic deferred frame rendered: hour {hour}, {ocean.cascadeCount} cascades of {ocean.fftSize}, {oceanFrames} ocean frames")
  }
  # Deliberately edit the count before shutdown: release must use allocated
  # resources, not the caller's newly requested tier.
  if tierCheck {
    var endingBody: WaterBody = primaryBody(waterSystem: waterSystem)
    endingBody.cascadeCount = 1
    waterSystem.bodies.set(index: 0, value: endingBody)
  }
  waterShutdown(waterSystem: waterSystem)
  if tierCheck {
    if not verifyWaterReleased() { checksOk = false }
    if oceanFrames is not waterCheckFrames { checksOk = false }
    if checksOk { log("[water tiers] 14 stages ok") } else { log("[water tiers] FAIL") }
  }
  Gbuffer.shutdownAll()
  Gpu2d.closeWindow()
  if not checksOk { ret 1 }
  ret 0
}
