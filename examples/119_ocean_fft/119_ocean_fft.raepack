pack OceanFft {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Ocean (FFT cascades, free camera)"
  description: "The realistic water tier: three FFT cascades (JONSWAP/TMA spectrum, Stockham inverse FFT) summed on a camera-centred LOD grid, with whitecaps from the Jacobian, refraction and Fresnel. Fly with WASD / Q / E, mouse-drag to look; comma / period move the sun."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
