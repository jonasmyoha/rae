# The shadow pass: fit cascades to this frame, then rasterise every caster
# (ground, props, the character's skinned parts + crowd). Its own function so the
# match arm stays a one-liner (and the systems refactor #543 gives it a home).
func renderShadowPass(app: mod App, aspect: copy Float, palette: view List(Float)) {
  let cascades: ShadowCascades = fitShadowCascades(
    camPos: app.cam.camera.position, camTarget: app.cam.camera.target,
    fovYDeg: app.cam.camera.fovYDeg, aspect: aspect,
    near: app.cam.camera.nearZ, far: 24.0, sunDir: app.cam.light.sunDir,
    count: 3, resolution: drsShadowRes(drs: app.render.drs), lambda: 0.75, backExtent: 12.0)
  uploadPalette(rows: palette, jointCount: jointCount(sk: app.character.skeleton))
  if app.io.settings.shadows {
    beginShadowPass(c: cascades)
    renderSceneShadow(scene: app.scene)
    drawTerrainPropsShadow(terrain: app.terrain, scene: app.scene)
    var sp: Int = 0
    loop sp < app.character.partIds.length {
      let sh: MeshHandle = meshHandle(id: walkerIntAt(values: app.character.partIds, index: sp), generation: 1)
      drawShadowCasterSkinned(mesh: sh, model: app.character.model)
      var shadowClone: Int = 0
      loop shadowClone < app.character.crowd.length {
        if let cloneModel: Mat4 = app.character.crowd.at(index: shadowClone) {
          drawShadowCasterSkinned(mesh: sh, model: cloneModel)
        }
        shadowClone = shadowClone + 1
      }
      sp = sp + 1
    }
    endShadowPass()
  }
  if app.render.shadowLogged is false {
    log("[shadow] casters {shadowCasterCount()}, {cascades.count} cascades at {cascades.resolution}")
    app.render.shadowLogged = true
  }
}

# The G-buffer pass: grass compute first, then the geometry — biome-splat ground,
# scene, instanced props, and the character's skinned parts + idle crowd — then
# the grass draw, all into one G-buffer pass.
func renderGbufferPass(app: mod App, aspect: copy Float, palette: view List(Float), t: copy Float, dt: copy Float) {
  var grassToonGen: Int = 0
  if app.character.toon { grassToonGen = 1 }
  let grassView: GrassViewSettings = grass_config.grassThirdPersonSettings(groundColor: walkerGroundColor())
  grassGenerate(playerX: app.character.controller.position.x,
                playerY: app.character.controller.position.y,
                groundZ: app.character.groundZ, time: t, dt: dt, toon: grassToonGen,
                camX: app.cam.camera.position.x, camY: app.cam.camera.position.y, camZ: app.cam.camera.position.z,
                fwdX: app.cam.camera.target.x - app.cam.camera.position.x,
                fwdY: app.cam.camera.target.y - app.cam.camera.position.y,
                fwdZ: app.cam.camera.target.z - app.cam.camera.position.z,
                settings: grassView)
  grassDiagTick()
  gbuffer.beginPass(camera: app.cam.camera, light: app.cam.light, aspect: aspect)
  drawTerrainGround(terrain: app.terrain, scene: app.scene)
  gbuffer.renderScene(scene: app.scene)
  drawTerrainProps(terrain: app.terrain, scene: app.scene)
  uploadPalette(rows: palette, jointCount: jointCount(sk: app.character.skeleton))
  var p: Int = 0
  loop p < app.character.partIds.length {
    let handle: MeshHandle = meshHandle(id: walkerIntAt(values: app.character.partIds, index: p), generation: 1)
    let mat: Material3d = {
      baseColor: vec3.create(x: 1.0, y: 1.0, z: 1.0),
      metallic: 0.0,
      roughness: walkerFloatAt(values: app.character.partRough, index: p),
      emission: vec3.create(x: 0.0, y: 0.0, z: 0.0),
      toon: app.character.toon
    }
    gbuffer.drawSkinnedInstance(mesh: handle, model: app.character.model,
                                prevModel: app.character.prevModel, material: mat)
    setInstanceBatchMesh(batch: app.character.crowdBatch, mesh: handle)
    resetInstanceBatch(batch: app.character.crowdBatch)
    var cloneDraw: Int = 0
    loop cloneDraw < app.character.crowd.length {
      if let cloneModel: Mat4 = app.character.crowd.at(index: cloneDraw) {
        addInstance(batch: app.character.crowdBatch, model: cloneModel, prevModel: cloneModel, material: mat)
      }
      cloneDraw = cloneDraw + 1
    }
    drawSkinnedInstances(batch: app.character.crowdBatch)
    p = p + 1
  }
  grassDraw()
  gbuffer.endPass()
}

# ----- render phase: animation sample + render-graph walk ------------------
func renderApp(app: mod App) {
  app.frame.renderedOnce = true
  app.io.lastLogRevision = app.io.logView.revision
  let dt: Float = app.frame.dt
  let now: Float64 = app.frame.now

  var clipRate: Float = 1.0
  if app.character.clipIndex is ClipKind.walkFast { clipRate = 1.6 }
  if app.character.playing {
    app.character.animTime = app.character.animTime + dt * app.character.speed * clipRate
  }
  applySkeletonPose(sk: app.character.skeleton, pose: app.character.bindPose)
  # Which clip feeds the pose. walk and walkFast share the walk clip (walkFast is
  # it at 1.6x via clipRate above); once or-patterns land (#622) they merge.
  match app.character.clipIndex {
    case ClipKind.idle { applyClip(sk: app.character.skeleton, c: app.character.idleClip, time: app.character.animTime) }
    case ClipKind.walk { applyClip(sk: app.character.skeleton, c: app.character.walkClip, time: app.character.animTime) }
    case ClipKind.walkFast { applyClip(sk: app.character.skeleton, c: app.character.walkClip, time: app.character.animTime) }
    case ClipKind.run { applyClip(sk: app.character.skeleton, c: app.character.runClip, time: app.character.animTime) }
  }
  let transitionActive: Bool = app.character.transitionElapsed < clipTransitionDuration
  if transitionActive {
    app.character.transitionElapsed = app.character.transitionElapsed + dt
    var blendWeight: Float = app.character.transitionElapsed / clipTransitionDuration
    if blendWeight > 1.0 { blendWeight = 1.0 }
    blendWeight = blendWeight * blendWeight * (3.0 - 2.0 * blendWeight)
    blendSkeletonPose(sk: app.character.skeleton, from: app.character.transitionFrom, weight: blendWeight)
  }
  let palette: List(Float) = buildPalette(sk: app.character.skeleton)

  applyCameraRig(rig: app.cam.rig, camera: app.cam.camera)
  syncCameraBar(world: app.io.world, rig: app.cam.rig, camera: app.cam.camera)
  let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
  let t: Float = (now - app.frame.startT) as Float

  var oi: Int = 0
  loop oi < deferredOrderLength(r: app.render.renderer) {
    let tag: Int = deferredTagAt(r: app.render.renderer, i: oi)
    profile.zoneBegin(name: (tag as RenderTag).toString())
    # Exhaustive over RenderTag: adding a pass is a compile error here until it is
    # handled (#624). Each pass is a helper/one-liner; the five generic passes
    # defer to renderDeferredPass (or-patterns, #622, will merge them into one arm).
    match tag {
      case RenderTag.shadow { renderShadowPass(app: app, aspect: aspect, palette: palette) }
      case RenderTag.gbuffer { renderGbufferPass(app: app, aspect: aspect, palette: palette, t: t, dt: dt) }
      case RenderTag.ssao {
        renderDeferredPass(r: app.render.renderer, tag: tag, scene: app.scene,
                           camera: app.cam.camera, light: app.cam.light, aspect: aspect)
      }
      case RenderTag.depthPyramid {
        renderDeferredPass(r: app.render.renderer, tag: tag, scene: app.scene,
                           camera: app.cam.camera, light: app.cam.light, aspect: aspect)
      }
      case RenderTag.lighting {
        renderDeferredPass(r: app.render.renderer, tag: tag, scene: app.scene,
                           camera: app.cam.camera, light: app.cam.light, aspect: aspect)
      }
      case RenderTag.taa {
        renderDeferredPass(r: app.render.renderer, tag: tag, scene: app.scene,
                           camera: app.cam.camera, light: app.cam.light, aspect: aspect)
      }
      case RenderTag.composite {
        renderDeferredPass(r: app.render.renderer, tag: tag, scene: app.scene,
                           camera: app.cam.camera, light: app.cam.light, aspect: aspect)
      }
      case RenderTag.uiOverlay {
        gpu2d.beginFrameLoad()
        renderSystemGpu2d(world: app.io.world, res: app.io.gpuUi)
        drawWalkerHud(logView: app.io.logView, gpuUi: app.io.gpuUi, dbg: app.io.dbg, moveStick: app.io.moveStick, panelOpen: app.io.settings.open)
      }
      case RenderTag.present { gpu2d.endFrame() }
    }
    profile.zoneEnd(name: (tag as RenderTag).toString())
    oi = oi + 1
  }
  snapshotPrevTransforms(scene: app.scene)
  capFrameSleep(drs: app.render.drs, frameStartSec: now)
}
