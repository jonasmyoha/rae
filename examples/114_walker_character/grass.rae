# Waving grass for the walker meadow (grass epic, phase 1 — #485).
#
# It is a SYSTEM in the ECS sense the project uses for per-feature behaviour,
# but it owns NO per-blade ECS entity and NO per-blade scene instance. Instead
# it keeps a fixed pool of blade DESCRIPTORS (base position on the noise height
# field, yaw, phase, scale — wrapped around the player by absolute world cell
# like the terrain), and each frame packs them into one compact instance stream
# that gbuffer.drawInstanced turns into a SINGLE instanced draw. So the whole
# field is one draw call, not one per clump.
#
# INTERMEDIATE, by design. The instance stream is still CPU-built here and the
# blade geometry is still the clump mesh; grass epic #486 moves generation onto
# a GPU compute pass and #487 replaces the mesh with procedural blades + a wind
# vertex shader. The instancing primitive this phase adds (gbuffer.drawInstanced)
# is what those phases build on, and is reusable for rocks/crowds/particles.
import core
import math
import math3d
import noise
import gltf
import gpu3d
import scene3d
import mesh3d
import vec3
open math3d
open gltf
open gpu3d
open scene3d
open mesh3d

const grassPerCell: Int = 10
const grassBladeCount: Int = 490
const grassRecordFloats: Int = 19600   # grassBladeCount * gbuffer.instanceRecordFloats (40)
const grassWindTau: Float = 6.283185307179586

# One clump descriptor: the planted base it sways around, a yaw for variety, a
# per-clump phase so the field does not pulse in unison, and a scale.
type GrassBlade {
  baseX: Float
  baseY: Float
  baseZ: Float
  yaw: Float
  phase: Float
  scale: Float
}

type GrassField {
  centreCellX: Int
  centreCellY: Int
  groundZ: Float
  meshId: Int
  blades: List(GrassBlade)
  # Reused DrawU staging buffer: grassBladeCount * gbuffer.instanceRecordFloats,
  # refilled in Rae each frame and handed to gbuffer.drawRecords. Never
  # reallocated.
  records: List(Float)
}

func grassBladeAt(blades: view List(GrassBlade), index: view Int) ret GrassBlade {
  if let blade: GrassBlade = blades.get(index: index) { ret blade }
  ret GrassBlade { baseX: 0.0, baseY: 0.0, baseZ: 0.0, yaw: 0.0, phase: 0.0, scale: 0.3 }
}

# Deterministic scatter for clump `slot` within cell (cellX, cellY). Same cell
# -> same clumps, which is what makes the wrap invisible.
func placeGrassCell(field: mod GrassField, poolBase: view Int,
                    cellX: view Int, cellY: view Int) {
  var slot: Int = 0
  loop slot < grassPerCell {
    let poolIndex: Int = poolBase + slot
    let hx: Float = noise.hash2(x: cellX, y: cellY, seed: 200 + slot)
    let hy: Float = noise.hash2(x: cellX, y: cellY, seed: 400 + slot)
    let hyaw: Float = noise.hash2(x: cellX, y: cellY, seed: 600 + slot)
    let hphase: Float = noise.hash2(x: cellX, y: cellY, seed: 800 + slot)
    let hscale: Float = noise.hash2(x: cellX, y: cellY, seed: 1000 + slot)
    let baseX: Float = (cellX.toFloat() + hx) * terrainCellSize - terrainCellSize * 0.5
    let baseY: Float = (cellY.toFloat() + hy) * terrainCellSize - terrainCellSize * 0.5
    let baseZ: Float = terrainHeightAt(x: baseX, y: baseY, groundZ: field.groundZ)
    field.blades.set(index: poolIndex, value: GrassBlade {
      baseX: baseX, baseY: baseY, baseZ: baseZ,
      yaw: hyaw * grassWindTau,
      phase: hphase * grassWindTau,
      scale: 0.28 + hscale * 0.34
    })
    slot = slot + 1
  }
}

# On a cell-boundary crossing, re-scatter every clump onto the square of cells
# now around the player. Returns true when it re-placed.
func updateGrassField(field: mod GrassField, playerPosition: view Vec3) ret Bool {
  let cellX: Int = math.floor(x: playerPosition.x / terrainCellSize).toInt()
  let cellY: Int = math.floor(x: playerPosition.y / terrainCellSize).toInt()
  if cellX is field.centreCellX and cellY is field.centreCellY {
    ret false
  }
  field.centreCellX = cellX
  field.centreCellY = cellY
  var row: Int = 0
  loop row < terrainGridSide {
    var column: Int = 0
    loop column < terrainGridSide {
      let cellIndex: Int = row * terrainGridSide + column
      placeGrassCell(field: field, poolBase: cellIndex * grassPerCell,
                     cellX: cellX + column - terrainHalfGrid,
                     cellY: cellY + row - terrainHalfGrid)
      column = column + 1
    }
    row = row + 1
  }
  ret true
}

# The wind lean at `time`: two sines at incommensurate rates plus the clump's
# own phase, so the field ripples rather than pulsing together.
func grassGust(phase: view Float, baseX: view Float, time: view Float) ret Float {
  ret 0.16 * math.sin(x: time * 1.7 + phase)
    + 0.06 * math.sin(x: time * 3.9 + phase * 1.7 + baseX * 0.15)
}

# Build one DrawU record per blade — this frame's sway and last frame's sway
# (so TAA gets correct motion while the field waves), plus a per-blade green —
# then one instanced draw for the whole field. The matrices and the record
# layout are gbuffer's Rae helpers; nothing here touches raw float offsets.
func drawGrassField(field: mod GrassField, time: view Float, dt: view Float, toon: view Int) {
  var index: Int = 0
  loop index < grassBladeCount {
    let blade: GrassBlade = grassBladeAt(blades: field.blades, index: index)
    let gust: Float = grassGust(phase: blade.phase, baseX: blade.baseX, time: time)
    let prevGust: Float = grassGust(phase: blade.phase, baseX: blade.baseX, time: time - dt)
    let model: Mat4 = gbuffer.swayModel(
      x: blade.baseX, y: blade.baseY, z: blade.baseZ, yaw: blade.yaw,
      tiltX: gust * 0.6, tiltY: gust, scale: blade.scale)
    let prevModel: Mat4 = gbuffer.swayModel(
      x: blade.baseX, y: blade.baseY, z: blade.baseZ, yaw: blade.yaw,
      tiltX: prevGust * 0.6, tiltY: prevGust, scale: blade.scale)
    # Per-blade green: a small deterministic spread off the base colour.
    let cvar: Float = blade.phase / grassWindTau
    gbuffer.packInstanceRecord(records: field.records, slot: index,
      model: model, prevModel: prevModel,
      r: 0.13 + cvar * 0.09, g: 0.33 + cvar * 0.16, b: 0.05 + cvar * 0.05,
      metallic: 0.0, roughness: 0.95, emissive: 0.0, toon: toon)
    index = index + 1
  }
  gbuffer.drawRecords(mesh: field.meshId, records: field.records.data,
                      count: grassBladeCount)
}

func createGrassField(assets: view String, groundZ: view Float) ret GrassField {
  let grassMesh: MeshHandle = terrainMesh(path: "{assets}environment/grass.glb")
  let blades: List(GrassBlade) = createList(GrassBlade, cap: grassBladeCount)
  var index: Int = 0
  loop index < grassBladeCount {
    blades.add(value: GrassBlade {
      baseX: 0.0, baseY: 0.0, baseZ: groundZ, yaw: 0.0, phase: 0.0, scale: 0.3
    })
    index = index + 1
  }
  let records: List(Float) = createList(Float, cap: grassRecordFloats)
  var floatIndex: Int = 0
  loop floatIndex < grassRecordFloats {
    records.add(value: 0.0)
    floatIndex = floatIndex + 1
  }
  ret GrassField {
    centreCellX: 1000000000, centreCellY: 1000000000,
    groundZ: groundZ, meshId: grassMesh.id,
    blades: own blades, records: own records
  }
}
