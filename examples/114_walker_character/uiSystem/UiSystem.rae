# UI system for the walker example (#549).
#
# uiUpdate runs the per-frame UI/settings/panel handling — device input into the
# ECS UI world, the clip + transport panels, the settings dialog, and the UI
# layout systems — extracted verbatim from updateApp with behaviour unchanged.
# It returns a UiTick because two of its outcomes (settingsChanged and scrolled)
# feed the render decision back in updateApp. It mutates character / cam
# / render as the inline code did.
#
# The UI STATE still lives in rae's InputSystem type (input + ui combined); the
# InputSystem -> InputState/UiState split rides with #545 (input intent), which owns
# that decomposition. Example-114 files are siblings in one module, so App and
# the sibling/stdlib helpers resolve cross-file.

import Math
import Profile
import Gpu2d
import Vec3
import Sys
import app3d/RenderScale
open GbufferInstanced
open GrassCompute
import GrassConfig
import app3d/Slider
open Scene3d
open Gpu3d
open RendererDeferred
open Sky
open Gbuffer
open Rendergraph
open Math3d
open Mesh3d
open Gltf
open GltfSkin
open SdfText
open Png
open app3d/CameraRig
open app3d/CharacterController
open app3d/SettingsDialog
open SkyHosek
open app3d/UiShell
open app3d/ControlPanel
open app3d/CameraBar
open Shadow3d
open app3d/Playback
open HotReload
open ui/LogOverlay
open ui/WindowGeometry
open ui/ScrollPanel
open ui/EventLoop
open ui/DebugOverlay
open ui/VirtualJoystick
open ui/Ecs
open ui/Components
open ui/inputSystem/InputSystem
open ui/renderSystem/RenderSystem

# What a UI tick reports back to updateApp for the render decision.
type UiTick {
  settingsChanged: Bool
  scrolled: Bool
}

func uiUpdate(cameraSystem: mod CameraSystem, characterSystem: mod CharacterSystem, frame: mod Frame, inputSystem: mod InputSystem, persist: mod PersistState, players: mod PlayerRoster, renderSystem: mod RenderSystem, terrainSystem: mod TerrainSystem, world: view GameWorld, deltaTime: copy Float, now: copy Float64) ret UiTick {
  updateUiInput(input: inputSystem.ui, world: inputSystem.world)
  if walkerMenuTapped() { toggleWalkerPanel(settings: inputSystem.settings, world: inputSystem.world) suppressUiPress(input: inputSystem.ui) }
  let scrolled: Bool = updateScrollPanel(world: inputSystem.world, viewport: inputSystem.panelScroll, input: inputSystem.ui)
  if updateDebugOverlay(d: inputSystem.dbg, screenW: windowExtentW(), screenH: windowExtentH(),
                        now: now, didRealWork: frame.dbgDidWork) {
    suppressUiPress(input: inputSystem.ui)
  }
  let clipHit: String = panelClickedId(panel: inputSystem.clipPanel, input: inputSystem.ui)
  if clipHit.length() > 0 and cameraSystem.rig.mode is not CameraRigMode.character {
    var nextClipIndex: Int = characterSystem.clipIndex
    if clipHit is "idle" { nextClipIndex = 0 }
    if clipHit is "walk" { nextClipIndex = 1 }
    if clipHit is "walkFast" { nextClipIndex = 2 }
    if clipHit is "run" { nextClipIndex = 3 }
    if nextClipIndex is not characterSystem.clipIndex {
      characterSystem.transitionFrom = captureSkeletonPose(sk: characterSystem.skeleton)
      characterSystem.transitionElapsed = 0.0
      characterSystem.clipIndex = nextClipIndex
      characterSystem.animTime = 0.0
      persist.stateDirty = true
    }
    setPanelSelection(panel: inputSystem.clipPanel, world: inputSystem.world, group: 1, id: clipHit)
  }
  let transportHit: String = panelClickedId(panel: inputSystem.transport, input: inputSystem.ui)
  if transportHit is "play" {
    characterSystem.playing = not characterSystem.playing
    var playLabel: String = "Pause"
    if not characterSystem.playing { playLabel = "Play" }
    setPanelButtonLabel(panel: inputSystem.transport, world: inputSystem.world, id: "play", label: playLabel)
    setPanelButtonOn(panel: inputSystem.transport, world: inputSystem.world, id: "play", on: characterSystem.playing)
  }
  if transportHit is "toon" {
    characterSystem.toon = not characterSystem.toon
    setPanelButtonOn(panel: inputSystem.transport, world: inputSystem.world, id: "toon", on: characterSystem.toon)
  }
  if transportHit is "slower" { characterSystem.speed = nextSpeed(current: characterSystem.speed, up: false) }
  if transportHit is "faster" { characterSystem.speed = nextSpeed(current: characterSystem.speed, up: true) }
  if transportHit.length() > 0 {
    let pct: Int = speedPercent(v: characterSystem.speed)
    setNodeText(world: inputSystem.world, nodeId: "SpeedLabel", value: "Speed {pct}%")
  }
  # Character-switch buttons (#546): same effect as Page Up/Down and keys 1/2.
  let charHit: String = panelClickedId(panel: inputSystem.charPanel, input: inputSystem.ui)
  if charHit is "prev" {
    rosterSwitchPrev(roster: players)
    onCharacterSwitched(cameraSystem: cameraSystem, inputSystem: inputSystem, persist: persist, players: players, world: world, characterSystem: characterSystem)
  }
  if charHit is "next" {
    rosterSwitchNext(roster: players)
    onCharacterSwitched(cameraSystem: cameraSystem, inputSystem: inputSystem, persist: persist, players: players, world: world, characterSystem: characterSystem)
  }
  var settingsChanged: Bool = false
  loop var ai: Int = 0, ai < uiActionCount(input: inputSystem.ui), ++ai {
    if settingsHandleAction(settingsState: inputSystem.settings, actionId: uiActionAt(input: inputSystem.ui, index: ai)) {
      settingsChanged = true
    }
  }
  if settingsUpdatePointer(settingsState: inputSystem.settings, world: inputSystem.world, input: inputSystem.ui) { settingsChanged = true }
  if settingsUpdateLatitudePointer(settingsState: inputSystem.settings, world: inputSystem.world, input: inputSystem.ui) { settingsChanged = true }
  if settingsUpdateDatePointer(settingsState: inputSystem.settings, world: inputSystem.world, input: inputSystem.ui) { settingsChanged = true }
  if settingsAdvanceTime(settingsState: inputSystem.settings, deltaTime: deltaTime) { settingsChanged = true }
  if settingsChanged {
    renderSystem.renderer.sky = settingsBuildSky(settingsState: inputSystem.settings, data: cameraSystem.hosek, turbidity: 3.0, groundAlbedo: 0.30)
    cameraSystem.light.sunDir = settingsSunDir(settingsState: inputSystem.settings)
    cameraSystem.light.sunColor = settingsSunColor(settingsState: inputSystem.settings)
    characterSystem.speed = inputSystem.settings.speed
    characterSystem.playing = inputSystem.settings.playing
    if characterSystem.toon is not inputSystem.settings.toon {
      characterSystem.toon = inputSystem.settings.toon
      setPanelButtonOn(panel: inputSystem.transport, world: inputSystem.world, id: "toon", on: characterSystem.toon)
    }
    let pctS: Int = speedPercent(v: characterSystem.speed)
    setNodeText(world: inputSystem.world, nodeId: "SpeedLabel", value: "Speed {pctS}%")
    settingsApplyToWorld(settingsState: inputSystem.settings, world: inputSystem.world)
    applyWalkerPanel(world: inputSystem.world, open: inputSystem.settings.open)
    persist.stateDirty = true
  }
  if clipHit.length() > 0 or transportHit.length() > 0 {
    inputSystem.settings.speed = characterSystem.speed
    inputSystem.settings.toon = characterSystem.toon
    settingsApplyToWorld(settingsState: inputSystem.settings, world: inputSystem.world)
    applyWalkerPanel(world: inputSystem.world, open: inputSystem.settings.open)
    persist.stateDirty = true
  }
  if terrainSystem.toon is not characterSystem.toon {
    setInfiniteTerrainToon(terrainSystem: terrainSystem, toon: characterSystem.toon)
  }
  if uiActionCount(input: inputSystem.ui) > 0 or settingsChanged {
    runUiSystems(world: inputSystem.world, res: inputSystem.gpuUi)
  }
  ret UiTick { settingsChanged: settingsChanged, scrolled: scrolled }
}
