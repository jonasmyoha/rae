# Fixed-size infinite meadow used by the walker example.
#
# #741 rewrite: the terrain props and heightfield tiles are ECS entities in the
# shared GameWorld (recycled, generational ids) — NOT parallel pool Lists synced
# by poolIndex, and NOT scale-to-0 culling. Each entity carries a `PropKind`
# {kind, slot, active}; trees carry a `TreeVariant` {broad}; tiles carry a
# `TileMesh` {meshId}. Placement, draw and shadow-cast are all QUERIES over these
# tables. Transforms are quaternion `Transform3D` (lib/ecs), consistent with the
# rest of the GameWorld — Euler is only ever an editor-authoring concern.
#
# The pool is allocated once; crossing a cell boundary re-places those same
# entities onto the square of world cells around the character.
import core
import math
import noise
import world_biome
open world_biome
import gltf
import gpu3d
import scene3d
import mesh3d
import vec3
import quat
import gbuffer
import gbuffer_terrain
open gbuffer_terrain
import gbuffer_instanced
import ecs/entity
import ecs/component_table
import ecs/transform
open gltf
open gpu3d
open scene3d
open mesh3d
open gbuffer_instanced
open ecs/entity
open ecs/component_table
open ecs/transform

# Single source of truth for the ground colour: the terrain ground material AND
# the GPU grass gradient's bottom both read this, so the grass roots match ground.
func walkerGroundColor() ret Vec3 { ret vec3.create(x: 0.105, y: 0.245, z: 0.055) }

const terrainGridSide: Int = 7
const terrainCellSize: Float = 18.0
const terrainHalfGrid: Int = 3
const terrainCellCount: Int = 49
const terrainTau: Float = 6.283185307179586

const terrainTileSegments: Int = 12
const terrainTileVerts: Int = 169
const terrainTileFloats: Int = 1352

# Prop kinds (the PropKind.kind discriminator).
const kindTile: Int = 0
const kindTree: Int = 1
const kindRock: Int = 2
const kindBush: Int = 3
const kindFlower: Int = 4
const kindGrassA: Int = 5
const kindGrassB: Int = 6

# The height field IS the biome elevation field (lib/world_biome).
func terrainHeightAt(x: view Float, y: view Float, groundZ: view Float) ret Float {
  ret worldTerrainHeight(x: x, y: y, groundZ: groundZ, cfg: defaultBiomeConfig())
}

const propGrassMin: Float = 0.45

# Nothing stands in the sea, and vegetation wants grass under it.
func terrainPropAllowed(x: view Float, y: view Float, minGrass: view Float) ret Bool {
  ret worldPropAllowed(x: x, y: y, minGrass: minGrass, cfg: defaultBiomeConfig())
}

# ----- ECS components (#741) -----------------------------------------
# A terrain prop / tile entity: which kind it is, which pool slot it occupies,
# and whether it is currently placed on valid ground (props over water are
# inactive and simply not gathered — no scale-to-0).
type PropKind {
  kind: Int
  slot: Int
  active: Bool
}

# A tree's broad-vs-tall choice, replacing the old broadVisible side-table.
type TreeVariant {
  broad: Bool
}

# A tile entity's unique heightfield mesh (rewritten in place on recycle).
type TileMesh {
  meshId: Int
}

# ----- instanced prop rendering --------------------------------------
# One instanced prop draw: its mesh, its material, and a pre-sized batch refilled
# each frame. The material is a value (not a scene index) so terrain owns no
# Scene3d state.
type PropInstancer {
  mesh: MeshHandle
  material: Material3d
  batch: InstanceBatch
}

func createPropInstancer(mesh: view MeshHandle, material: view Material3d,
                         capacity: copy Int) ret PropInstancer {
  ret PropInstancer {
    mesh: mesh, material: material,
    batch: own createInstanceBatch(mesh: mesh, capacity: capacity)
  }
}

type InfiniteTerrain {
  centreCellX: Int
  centreCellY: Int
  groundZ: Float
  toon: Bool
  # Reused staging buffer for a tile's per-cell heightfield rewrite.
  scratchVerts: List(Float)
  rockProp: PropInstancer
  bushProp: PropInstancer
  flowerProp: PropInstancer
  grassProp: PropInstancer
  broadTrunkProp: PropInstancer
  broadCrownProp: PropInstancer
  tallTrunkProp: PropInstancer
  tallCrownProp: PropInstancer
}

func terrainMesh(path: view String) ret MeshHandle {
  let model: Glb = loadGlb(path: path)
  let mesh: MeshData = loadAllPrimitives(g: model)
  if mesh.vertCount < 1 {
    log("[terrain] no mesh data in {path}")
    ret meshHandleNone()
  }
  ret uploadMesh(verts: mesh.verts, vertCount: mesh.vertCount, indices: mesh.indices)
}

func terrainHash(cellX: view Int, cellY: view Int, seed: view Int) ret Float {
  ret noise.hash2(x: cellX, y: cellY, seed: seed)
}

func terrainOffset(cellX: view Int, cellY: view Int, seed: view Int) ret Float {
  ret (terrainHash(cellX: cellX, cellY: cellY, seed: seed) - 0.5) * 12.0
}

func terrainScale(cellX: view Int, cellY: view Int, seed: view Int,
                  minimum: view Float, spread: view Float) ret Float {
  ret minimum + terrainHash(cellX: cellX, cellY: cellY, seed: seed) * spread
}

# A prop's placement transform for its cell: scattered x/y, height-sampled z, a
# yaw quaternion about +Z, uniform scale. (Editor-Euler is never involved.)
func propTransform3D(cellX: view Int, cellY: view Int, seedX: view Int, seedY: view Int,
                     seedScale: view Int, groundZ: view Float,
                     minScale: view Float, scaleSpread: view Float) ret Transform3D {
  let scale: Float = terrainScale(cellX: cellX, cellY: cellY, seed: seedScale,
                                  minimum: minScale, spread: scaleSpread)
  let posX: Float = cellX.toFloat() * terrainCellSize
    + terrainOffset(cellX: cellX, cellY: cellY, seed: seedX)
  let posY: Float = cellY.toFloat() * terrainCellSize
    + terrainOffset(cellX: cellX, cellY: cellY, seed: seedY)
  let yaw: Float = terrainHash(cellX: cellX, cellY: cellY, seed: seedScale + 71) * terrainTau
  ret Transform3D {
    position: vec3.create(x: posX, y: posY,
                          z: terrainHeightAt(x: posX, y: posY, groundZ: groundZ)),
    rotation: quat.fromAxisAngle(axis: vec3.create(x: 0.0, y: 0.0, z: 1.0), angle: yaw),
    scale: vec3.create(x: scale, y: scale, z: scale)
  }
}

# The prop transform for a given kind (per-kind scatter seeds + scale range).
func kindTransform(kind: view Int, broad: view Bool, cellX: view Int, cellY: view Int,
                   groundZ: view Float) ret Transform3D {
  if kind is kindTree {
    if broad {
      ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 11, seedY: 17, seedScale: 23,
        groundZ: groundZ, minScale: 0.30, scaleSpread: 0.15)
    }
    ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 11, seedY: 17, seedScale: 109,
      groundZ: groundZ, minScale: 0.25, scaleSpread: 0.14)
  }
  if kind is kindRock {
    ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 31, seedY: 37, seedScale: 41,
      groundZ: groundZ, minScale: 0.28, scaleSpread: 0.34)
  }
  if kind is kindBush {
    ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 47, seedY: 53, seedScale: 59,
      groundZ: groundZ, minScale: 0.22, scaleSpread: 0.16)
  }
  if kind is kindFlower {
    ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 61, seedY: 67, seedScale: 71,
      groundZ: groundZ + 0.015, minScale: 0.35, scaleSpread: 0.25)
  }
  if kind is kindGrassA {
    ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 73, seedY: 79, seedScale: 83,
      groundZ: groundZ, minScale: 0.52, scaleSpread: 0.30)
  }
  # kindGrassB
  ret propTransform3D(cellX: cellX, cellY: cellY, seedX: 89, seedY: 97, seedScale: 101,
    groundZ: groundZ, minScale: 0.38, scaleSpread: 0.27)
}

# Rocks may stand on bare ground; everything else wants grass under it.
func kindMinGrass(kind: view Int) ret Float {
  if kind is kindRock { ret 0.0 }
  ret propGrassMin
}

func slotCellX(centreCellX: view Int, slot: view Int) ret Int {
  ret centreCellX + (slot % terrainGridSide) - terrainHalfGrid
}

func slotCellY(centreCellY: view Int, slot: view Int) ret Int {
  ret centreCellY + (slot / terrainGridSide) - terrainHalfGrid
}

# Rewrite a tile's mesh so its vertices carry the ABSOLUTE world height of the
# cell it now covers. Normals from central differences of the height function.
func reshapeTerrainTile(terrain: mod InfiniteTerrain, meshId: view Int,
                        cellX: view Int, cellY: view Int) {
  if meshId < 1 { ret }
  let tileSize: Float = terrainCellSize + 0.04
  let centreX: Float = cellX.toFloat() * terrainCellSize
  let centreY: Float = cellY.toFloat() * terrainCellSize
  let eps: Float = 0.6
  loop var yi: Int = 0, yi <= terrainTileSegments, ++yi {
    let fy: Float = yi.toFloat() / terrainTileSegments.toFloat()
    let localY: Float = (fy - 0.5) * tileSize
    let worldY: Float = centreY + localY
    loop var xi: Int = 0, xi <= terrainTileSegments, ++xi {
      let fx: Float = xi.toFloat() / terrainTileSegments.toFloat()
      let localX: Float = (fx - 0.5) * tileSize
      let worldX: Float = centreX + localX
      let height: Float = terrainHeightAt(x: worldX, y: worldY, groundZ: terrain.groundZ)
      let slopeX: Float = (terrainHeightAt(x: worldX + eps, y: worldY, groundZ: terrain.groundZ)
        - terrainHeightAt(x: worldX - eps, y: worldY, groundZ: terrain.groundZ)) / (eps * 2.0)
      let slopeY: Float = (terrainHeightAt(x: worldX, y: worldY + eps, groundZ: terrain.groundZ)
        - terrainHeightAt(x: worldX, y: worldY - eps, groundZ: terrain.groundZ)) / (eps * 2.0)
      let inverseLength: Float = 1.0
        / math.sqrt(x: slopeX * slopeX + slopeY * slopeY + 1.0)
      let base: Int = (yi * (terrainTileSegments + 1) + xi) * 8
      terrain.scratchVerts.set(index: base, value: localX)
      terrain.scratchVerts.set(index: base + 1, value: localY)
      terrain.scratchVerts.set(index: base + 2, value: height)
      terrain.scratchVerts.set(index: base + 3, value: 0.0 - slopeX * inverseLength)
      terrain.scratchVerts.set(index: base + 4, value: 0.0 - slopeY * inverseLength)
      terrain.scratchVerts.set(index: base + 5, value: inverseLength)
      terrain.scratchVerts.set(index: base + 6, value: fx)
      terrain.scratchVerts.set(index: base + 7, value: fy)
    }
  }
  updateMeshVerts(mesh: meshHandle(id: meshId, generation: 0),
                  verts: terrain.scratchVerts, vertCount: terrainTileVerts)
}

# ----- streaming -----------------------------------------------------
# Re-place every prop/tile entity onto the world cell its pool slot now maps to.
# A single query over the PropKind table drives placement; no per-slot,
# per-kind list bookkeeping.
func updateInfiniteTerrain(terrain: mod InfiniteTerrain, world: mod GameWorld,
                           playerPosition: view Vec3) ret Bool {
  let cellX: Int = math.floor(x: playerPosition.x / terrainCellSize).toInt()
  let cellY: Int = math.floor(x: playerPosition.y / terrainCellSize).toInt()
  if cellX is terrain.centreCellX and cellY is terrain.centreCellY {
    ret false
  }
  terrain.centreCellX = cellX
  terrain.centreCellY = cellY

  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entity: EntityId = componentEntityAt(this: world.propKinds, i: i)
    var pk: PropKind = componentDataAt(this: world.propKinds, i: i)
    let ccx: Int = slotCellX(centreCellX: cellX, slot: pk.slot)
    let ccy: Int = slotCellY(centreCellY: cellY, slot: pk.slot)
    if pk.kind is kindTile {
      let tile: TileMesh = componentGet(this: world.tileMeshes, entity: entity)
      reshapeTerrainTile(terrain: terrain, meshId: tile.meshId, cellX: ccx, cellY: ccy)
      componentSet(this: world.transforms, entity: entity, data: Transform3D {
        position: vec3.create(x: ccx.toFloat() * terrainCellSize,
                              y: ccy.toFloat() * terrainCellSize, z: 0.0),
        rotation: quat.identity(),
        scale: vec3.create(x: 1.0, y: 1.0, z: 1.0)
      })
    } else {
      var broad: Bool = false
      if pk.kind is kindTree {
        broad = terrainHash(cellX: ccx, cellY: ccy, seed: 131) < 0.54
        componentSet(this: world.treeVariants, entity: entity, data: TreeVariant { broad: broad })
      }
      let t: Transform3D = kindTransform(kind: pk.kind, broad: broad,
        cellX: ccx, cellY: ccy, groundZ: terrain.groundZ)
      componentSet(this: world.transforms, entity: entity, data: t)
      pk.active = terrainPropAllowed(x: t.position.x, y: t.position.y,
        minGrass: kindMinGrass(kind: pk.kind))
      componentSet(this: world.propKinds, entity: entity, data: pk)
    }
  }
  ret true
}

# ----- draw (queries) ------------------------------------------------
func gatherKind(prop: mod PropInstancer, model: view Mat4) {
  addInstance(batch: prop.batch, model: model, prevModel: model, material: prop.material)
}

func drawTerrainProps(terrain: mod InfiniteTerrain, world: view GameWorld) {
  resetInstanceBatch(batch: terrain.rockProp.batch)
  resetInstanceBatch(batch: terrain.bushProp.batch)
  resetInstanceBatch(batch: terrain.flowerProp.batch)
  resetInstanceBatch(batch: terrain.grassProp.batch)
  resetInstanceBatch(batch: terrain.broadTrunkProp.batch)
  resetInstanceBatch(batch: terrain.broadCrownProp.batch)
  resetInstanceBatch(batch: terrain.tallTrunkProp.batch)
  resetInstanceBatch(batch: terrain.tallCrownProp.batch)
  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entity: EntityId = componentEntityAt(this: world.propKinds, i: i)
    let pk: PropKind = componentDataAt(this: world.propKinds, i: i)
    if pk.active and pk.kind is not kindTile {
      let model: Mat4 = transform3dToMatrix(t: componentGet(this: world.transforms, entity: entity))
      if pk.kind is kindRock { gatherKind(prop: terrain.rockProp, model: model) }
      if pk.kind is kindBush { gatherKind(prop: terrain.bushProp, model: model) }
      if pk.kind is kindFlower { gatherKind(prop: terrain.flowerProp, model: model) }
      if pk.kind is kindGrassA { gatherKind(prop: terrain.grassProp, model: model) }
      if pk.kind is kindGrassB { gatherKind(prop: terrain.grassProp, model: model) }
      if pk.kind is kindTree {
        if componentGet(this: world.treeVariants, entity: entity).broad {
          gatherKind(prop: terrain.broadTrunkProp, model: model)
          gatherKind(prop: terrain.broadCrownProp, model: model)
        } else {
          gatherKind(prop: terrain.tallTrunkProp, model: model)
          gatherKind(prop: terrain.tallCrownProp, model: model)
        }
      }
    }
  }
  drawInstances(batch: terrain.rockProp.batch)
  drawInstances(batch: terrain.bushProp.batch)
  drawInstances(batch: terrain.flowerProp.batch)
  drawInstances(batch: terrain.grassProp.batch)
  drawInstances(batch: terrain.broadTrunkProp.batch)
  drawInstances(batch: terrain.broadCrownProp.batch)
  drawInstances(batch: terrain.tallTrunkProp.batch)
  drawInstances(batch: terrain.tallCrownProp.batch)
}

func drawTerrainGround(terrain: view InfiniteTerrain, world: view GameWorld, time: copy Float) {
  loop var i: Int = 0, i < componentCount(this: world.tileMeshes), ++i {
    let entity: EntityId = componentEntityAt(this: world.tileMeshes, i: i)
    let tile: TileMesh = componentDataAt(this: world.tileMeshes, i: i)
    if tile.meshId >= 1 {
      let q: Transform3D = componentGet(this: world.transforms, entity: entity)
      # Tiles never rotate/scale, so an Euler Transform3d for the ground pipeline
      # is just the position.
      let euler: Transform3d = {
        position: q.position,
        rotation: vec3.create(x: 0.0, y: 0.0, z: 0.0),
        scale: vec3.create(x: 1.0, y: 1.0, z: 1.0)
      }
      drawTerrainMesh(mesh: tile.meshId, transform: euler, prevTransform: euler,
                      roughness: 0.96, time: time)
    }
  }
}

func castKind(mesh: view MeshHandle, model: view Mat4) {
  drawShadowCaster(mesh: mesh, model: model)
}

func drawTerrainPropsShadow(terrain: view InfiniteTerrain, world: view GameWorld) {
  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entity: EntityId = componentEntityAt(this: world.propKinds, i: i)
    let pk: PropKind = componentDataAt(this: world.propKinds, i: i)
    if pk.active and pk.kind is not kindTile {
      let model: Mat4 = transform3dToMatrix(t: componentGet(this: world.transforms, entity: entity))
      if pk.kind is kindRock { castKind(mesh: terrain.rockProp.mesh, model: model) }
      if pk.kind is kindBush { castKind(mesh: terrain.bushProp.mesh, model: model) }
      if pk.kind is kindFlower { castKind(mesh: terrain.flowerProp.mesh, model: model) }
      if pk.kind is kindGrassA { castKind(mesh: terrain.grassProp.mesh, model: model) }
      if pk.kind is kindGrassB { castKind(mesh: terrain.grassProp.mesh, model: model) }
      if pk.kind is kindTree {
        if componentGet(this: world.treeVariants, entity: entity).broad {
          castKind(mesh: terrain.broadTrunkProp.mesh, model: model)
          castKind(mesh: terrain.broadCrownProp.mesh, model: model)
        } else {
          castKind(mesh: terrain.tallTrunkProp.mesh, model: model)
          castKind(mesh: terrain.tallCrownProp.mesh, model: model)
        }
      }
    }
  }
}

func setPropInstancerToon(prop: mod PropInstancer, toon: view Bool) {
  prop.material.toon = toon
}

func setInfiniteTerrainToon(terrain: mod InfiniteTerrain, toon: view Bool) {
  if terrain.toon is toon { ret }
  terrain.toon = toon
  setPropInstancerToon(prop: terrain.rockProp, toon: toon)
  setPropInstancerToon(prop: terrain.bushProp, toon: toon)
  setPropInstancerToon(prop: terrain.flowerProp, toon: toon)
  setPropInstancerToon(prop: terrain.grassProp, toon: toon)
  setPropInstancerToon(prop: terrain.broadTrunkProp, toon: toon)
  setPropInstancerToon(prop: terrain.broadCrownProp, toon: toon)
  setPropInstancerToon(prop: terrain.tallTrunkProp, toon: toon)
  setPropInstancerToon(prop: terrain.tallCrownProp, toon: toon)
}

func terrainMaterial(color: view Vec3, roughness: view Float) ret Material3d {
  ret Material3d {
    baseColor: color, metallic: 0.0, roughness: roughness,
    emission: vec3.create(x: 0.0, y: 0.0, z: 0.0), toon: true
  }
}

# Spawn one prop entity of `kind` for pool slot `slot`.
func spawnProp(world: mod GameWorld, kind: view Int, slot: view Int) ret EntityId {
  let entity: EntityId = gameWorldAddEntity(world: world)
  componentSet(this: world.transforms, entity: entity, data: createTransform3D())
  componentSet(this: world.propKinds, entity: entity, data: PropKind {
    kind: kind, slot: slot, active: false
  })
  ret entity
}

func createInfiniteTerrain(world: mod GameWorld, assets: view String,
                           groundZ: view Float) ret InfiniteTerrain {
  let tilePlane: MeshData = makePlane(size: terrainCellSize + 0.04,
                                      segments: terrainTileSegments)
  let broadTrunk: MeshHandle = terrainMesh(path: "{assets}environment/tree_broad_trunk.glb")
  let broadCrown: MeshHandle = terrainMesh(path: "{assets}environment/tree_broad_crown.glb")
  let tallTrunk: MeshHandle = terrainMesh(path: "{assets}environment/tree_tall_trunk.glb")
  let tallCrown: MeshHandle = terrainMesh(path: "{assets}environment/tree_tall_crown.glb")
  let rockMesh: MeshHandle = terrainMesh(path: "{assets}environment/rock.glb")
  let bushMesh: MeshHandle = terrainMesh(path: "{assets}environment/bush.glb")
  let flowerMesh: MeshHandle = terrainMesh(path: "{assets}environment/flower.glb")
  let grassMesh: MeshHandle = terrainMesh(path: "{assets}environment/grass.glb")

  let trunkMat: Material3d = terrainMaterial(color: vec3.create(x: 0.205, y: 0.090, z: 0.032), roughness: 0.92)
  let crownMat: Material3d = terrainMaterial(color: vec3.create(x: 0.055, y: 0.255, z: 0.075), roughness: 0.88)
  let rockMat: Material3d = terrainMaterial(color: vec3.create(x: 0.235, y: 0.265, z: 0.285), roughness: 0.82)
  let bushMat: Material3d = terrainMaterial(color: vec3.create(x: 0.035, y: 0.185, z: 0.105), roughness: 0.90)
  let flowerMat: Material3d = terrainMaterial(color: vec3.create(x: 0.92, y: 0.38, z: 0.045), roughness: 0.72)
  let grassMat: Material3d = terrainMaterial(color: vec3.create(x: 0.18, y: 0.42, z: 0.055), roughness: 0.94)

  let scratch: List(Float) = createList(Float, cap: terrainTileFloats)
  loop var scratchIndex: Int = 0, scratchIndex < terrainTileFloats, ++scratchIndex {
    scratch.add(value: 0.0)
  }

  # One entity per pool slot per kind: a tile (with its own heightfield mesh) plus
  # tree/rock/bush/flower/grassA/grassB. Recycled every stream, placed by query.
  loop var slot: Int = 0, slot < terrainCellCount, ++slot {
    let tileMesh: MeshHandle = uploadMeshDataForTerrain(mesh: tilePlane)
    let tileEntity: EntityId = gameWorldAddEntity(world: world)
    componentSet(this: world.transforms, entity: tileEntity, data: createTransform3D())
    componentSet(this: world.propKinds, entity: tileEntity, data: PropKind {
      kind: kindTile, slot: slot, active: true
    })
    componentSet(this: world.tileMeshes, entity: tileEntity, data: TileMesh { meshId: tileMesh.id })

    let treeEntity: EntityId = spawnProp(world: world, kind: kindTree, slot: slot)
    componentSet(this: world.treeVariants, entity: treeEntity, data: TreeVariant { broad: false })
    let unusedRock: EntityId = spawnProp(world: world, kind: kindRock, slot: slot)
    let unusedBush: EntityId = spawnProp(world: world, kind: kindBush, slot: slot)
    let unusedFlower: EntityId = spawnProp(world: world, kind: kindFlower, slot: slot)
    let unusedGrassA: EntityId = spawnProp(world: world, kind: kindGrassA, slot: slot)
    let unusedGrassB: EntityId = spawnProp(world: world, kind: kindGrassB, slot: slot)
  }

  var terrain: InfiniteTerrain = {
    centreCellX: 1000000000, centreCellY: 1000000000,
    groundZ: groundZ, toon: true,
    scratchVerts: own scratch,
    rockProp: own createPropInstancer(mesh: rockMesh, material: rockMat, capacity: terrainCellCount),
    bushProp: own createPropInstancer(mesh: bushMesh, material: bushMat, capacity: terrainCellCount),
    flowerProp: own createPropInstancer(mesh: flowerMesh, material: flowerMat, capacity: terrainCellCount),
    grassProp: own createPropInstancer(mesh: grassMesh, material: grassMat, capacity: terrainCellCount * 2),
    broadTrunkProp: own createPropInstancer(mesh: broadTrunk, material: trunkMat, capacity: terrainCellCount),
    broadCrownProp: own createPropInstancer(mesh: broadCrown, material: crownMat, capacity: terrainCellCount),
    tallTrunkProp: own createPropInstancer(mesh: tallTrunk, material: trunkMat, capacity: terrainCellCount),
    tallCrownProp: own createPropInstancer(mesh: tallCrown, material: crownMat, capacity: terrainCellCount)
  }
  ret own terrain
}

func uploadMeshDataForTerrain(mesh: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: mesh.verts, vertCount: mesh.vertCount, indices: mesh.indices)
}
