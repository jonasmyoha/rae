# The deferred renderer + dynamic-resolution controller (#552). Lives with the
# RenderSystem — the App just aggregates it.
type RenderState {
  renderer: DeferredRenderer
  drs: RenderScaleController
  shadowLogged: Bool
}

# The shadow pass: fit cascades to this frame, then rasterise every caster
# (ground, props, the character's skinned parts + crowd). Its own function so the
# match arm stays a one-liner (and the systems refactor #543 gives it a home).
func renderShadowPass(cam: mod CameraState, character: mod CharacterState, io: mod InputUi, render: mod RenderState, scene: mod Scene3d, terrain: mod InfiniteTerrain, world: mod GameWorld, aspect: copy Float, palette: view List(Float)) {
  let cascades: ShadowCascades = fitShadowCascades(
    camPos: cam.camera.position, camTarget: cam.camera.target,
    fovYDeg: cam.camera.fovYDeg, aspect: aspect,
    near: cam.camera.nearZ, far: 24.0, sunDir: cam.light.sunDir,
    count: 3, resolution: drsShadowRes(drs: render.drs), lambda: 0.75, backExtent: 12.0)
  uploadPalette(rows: palette, jointCount: jointCount(sk: character.skeleton))
  if io.settings.shadows {
    beginShadowPass(c: cascades)
    renderSceneShadow(scene: scene)
    drawTerrainPropsShadow(terrain: terrain, world: world)
    # Each caster's shadow samples the SAME palette slot its G-buffer instance
    # does (#547), so a crowd member casts its own pose. Hero = slot 0.
    let jc: Int = jointCount(sk: character.skeleton)
    loop var sp: Int = 0, sp < gameWorldPartCount(world: world), ++sp {
      let sh: MeshHandle = meshHandle(id: gameWorldPartAt(world: world, i: sp).meshId, generation: 1)
      drawShadowCasterSkinned(mesh: sh, model: character.model, paletteBase: 0)
      loop var shadowClone: Int = 0, shadowClone < character.crowdEntities.length, ++shadowClone {
        if let member: EntityId = character.crowdEntities.copyAt(index: shadowClone) {
          let ctrl: ThirdPersonController = componentGet(this: world.controllers, entity: member)
          let cloneModel: Mat4 = walkerWorldModel(baseModel: character.basePartModel, controller: ctrl)
          drawShadowCasterSkinned(mesh: sh, model: cloneModel,
                                  paletteBase: characterPaletteBase(slot: shadowClone + 1, jointCount: jc))
        }
      }
    }
    endShadowPass()
  }
  if render.shadowLogged is false {
    log("[shadow] casters {shadowCasterCount()}, {cascades.count} cascades at {cascades.resolution}")
    render.shadowLogged = true
  }
}

# The G-buffer pass: grass compute first, then the geometry — biome-splat ground,
# scene, instanced props, and the character's skinned parts + idle crowd — then
# the grass draw, all into one G-buffer pass.
func renderGbufferPass(cam: mod CameraState, character: mod CharacterState, scene: mod Scene3d, splashes: mod ParticleSystem, terrain: mod InfiniteTerrain, world: mod GameWorld, aspect: copy Float, palette: view List(Float), t: copy Float, dt: copy Float) {
  var grassToonGen: Int = 0
  if character.toon { grassToonGen = 1 }
  let grassView: GrassViewSettings = grass_config.grassThirdPersonSettings(groundColor: walkerGroundColor())
  let heroPos: Vec3 = controllerOf(world: world, entity: character.heroEntity).position
  grassGenerate(playerX: heroPos.x,
                playerY: heroPos.y,
                groundZ: character.groundZ, time: t, dt: dt, toon: grassToonGen,
                camX: cam.camera.position.x, camY: cam.camera.position.y, camZ: cam.camera.position.z,
                fwdX: cam.camera.target.x - cam.camera.position.x,
                fwdY: cam.camera.target.y - cam.camera.position.y,
                fwdZ: cam.camera.target.z - cam.camera.position.z,
                settings: grassView)
  grassDiagTick()
  gbuffer.beginPass(camera: cam.camera, light: cam.light, aspect: aspect)
  drawTerrainGround(terrain: terrain, world: world, time: t)
  gbuffer.renderScene(scene: scene)
  drawTerrainProps(terrain: terrain, world: world)
  # Palettes (hero slot 0 + one per crowd member) were uploaded in renderApp.
  let jc: Int = jointCount(sk: character.skeleton)
  uploadPalette(rows: palette, jointCount: jc)
  loop var p: Int = 0, p < gameWorldPartCount(world: world), ++p {
    let part: PartRoughness = gameWorldPartAt(world: world, i: p)
    let handle: MeshHandle = meshHandle(id: part.meshId, generation: 1)
    let mat: Material3d = {
      baseColor: vec3.create(x: 1.0, y: 1.0, z: 1.0),
      metallic: 0.0,
      roughness: part.roughness,
      emission: vec3.create(x: 0.0, y: 0.0, z: 0.0),
      toon: character.toon
    }
    gbuffer.drawSkinnedInstance(mesh: handle, model: character.model,
                                prevModel: character.prevModel, material: mat)
    setInstanceBatchMesh(batch: character.crowdBatch, mesh: handle)
    resetInstanceBatch(batch: character.crowdBatch)
    loop var cloneDraw: Int = 0, cloneDraw < character.crowdEntities.length, ++cloneDraw {
      if let member: EntityId = character.crowdEntities.copyAt(index: cloneDraw) {
        # Each crowd member samples its OWN palette slot (#547) so it holds a
        # distinct pose in this single instanced skinned draw. Its model is
        # derived from the entity's controller (#739) — no stored model.
        let ctrl: ThirdPersonController = componentGet(this: world.controllers, entity: member)
        let cloneModel: Mat4 = walkerWorldModel(baseModel: character.basePartModel, controller: ctrl)
        addSkinnedInstance(batch: character.crowdBatch, model: cloneModel, prevModel: cloneModel,
                           material: mat, paletteBase: characterPaletteBase(slot: cloneDraw + 1, jointCount: jc))
      }
    }
    drawSkinnedInstances(batch: character.crowdBatch)
  }
  grassDraw()
  # Water splashes for anything wading this frame (#84): advance + emit, then draw
  # the droplets as instanced cubes into this same G-buffer pass (particles.rae).
  splashStep(character: character, splashes: splashes, world: world, dt: dt)
  particleDraw(sys: splashes, toon: character.toon)
  gbuffer.endPass()
}

# ----- render phase: animation sample + render-graph walk ------------------
func renderApp(cam: mod CameraState, character: mod CharacterState, frame: mod Frame, io: mod InputUi, render: mod RenderState, scene: mod Scene3d, world: mod GameWorld, terrain: mod InfiniteTerrain, splashes: mod ParticleSystem) {
  frame.renderedOnce = true
  io.lastLogRevision = io.logView.revision
  let dt: Float = frame.dt
  let now: Float64 = frame.now

  var clipRate: Float = 1.0
  if character.clipIndex is ClipKind.walkFast { clipRate = 1.6 }
  if character.playing {
    character.animTime = character.animTime + dt * character.speed * clipRate
  }
  applySkeletonPose(sk: character.skeleton, pose: character.bindPose)
  # Which clip feeds the pose. walk and walkFast share the walk clip (walkFast is
  # it at 1.6x via clipRate above); once or-patterns land (#622) they merge.
  match character.clipIndex {
    case ClipKind.idle { applyClip(sk: character.skeleton, c: character.idleClip, time: character.animTime) }
    case ClipKind.walk { applyClip(sk: character.skeleton, c: character.walkClip, time: character.animTime) }
    case ClipKind.walkFast { applyClip(sk: character.skeleton, c: character.walkClip, time: character.animTime) }
    case ClipKind.run { applyClip(sk: character.skeleton, c: character.runClip, time: character.animTime) }
  }
  let transitionActive: Bool = character.transitionElapsed < clipTransitionDuration
  if transitionActive {
    character.transitionElapsed = character.transitionElapsed + dt
    var blendWeight: Float = character.transitionElapsed / clipTransitionDuration
    if blendWeight > 1.0 { blendWeight = 1.0 }
    blendWeight = blendWeight * blendWeight * (3.0 - 2.0 * blendWeight)
    blendSkeletonPose(sk: character.skeleton, from: character.transitionFrom, weight: blendWeight)
  }
  let palette: List(Float) = buildPalette(sk: character.skeleton)

  # Per-character crowd palettes (#547): upload the hero into slot 0 first (this
  # also creates the shared palette buffer on frame 0), then give each crowd
  # member a time-shifted pose in its own slot so ONE instanced skinned draw per
  # part renders every character in a DISTINCT pose. The hero `palette` above is
  # untouched — poseCharacterPalette only borrows the skeleton as scratch.
  # Each crowd member advances its OWN animation and poses into its OWN palette
  # slot (#547) — independent of the player, so member 2 can idle while member 0
  # walks. Slot 0 is the hero (uploaded first, which also creates the buffer).
  let jc: Int = jointCount(sk: character.skeleton)
  uploadPalette(rows: palette, jointCount: jc)
  loop var crowdSlot: Int = 0, crowdSlot < character.crowdEntities.length, ++crowdSlot {
    if let member: EntityId = character.crowdEntities.copyAt(index: crowdSlot) {
      # Advance this member's AnimationState IN PLACE (#739) — no copy/set-back.
      let anim: mod AnimationState => componentMod(this: world.animStates, entity: member)
      anim.animTime = anim.animTime + dt * clipPlaybackRate(clipIndex: anim.clipIndex)
      let memberClip: Int = anim.clipIndex
      let memberTime: Float = anim.animTime
      let crowdPalette: List(Float) = poseCharacterPalette(character: character,
        clipIndex: memberClip, animTime: memberTime)
      uploadPaletteSlot(rows: crowdPalette, jointCount: jc, slot: crowdSlot + 1)
    }
  }

  applyCameraRigHierarchy(cam: cam, world: world)
  syncCameraBar(world: io.world, rig: cam.rig, camera: cam.camera)
  let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
  let t: Float = (now - frame.startT) as Float

  loop var oi: Int = 0, oi < deferredOrderLength(r: render.renderer), ++oi {
    let tag: Int = deferredTagAt(r: render.renderer, i: oi)
    profile.zoneBegin(name: (tag as RenderTag).toString())
    # Exhaustive over RenderTag: adding a pass is a compile error here until it is
    # handled (#624). Each pass is a helper/one-liner; the five generic passes
    # defer to renderDeferredPass (or-patterns, #622, will merge them into one arm).
    match tag {
      case RenderTag.shadow { renderShadowPass(cam: cam, character: character, io: io, render: render, scene: scene, terrain: terrain, world: world, aspect: aspect, palette: palette) }
      case RenderTag.gbuffer { renderGbufferPass(cam: cam, character: character, scene: scene, splashes: splashes, terrain: terrain, world: world, aspect: aspect, palette: palette, t: t, dt: dt) }
      case RenderTag.ssao {
        renderDeferredPass(r: render.renderer, tag: tag, scene: scene,
                           camera: cam.camera, light: cam.light, aspect: aspect)
      }
      case RenderTag.depthPyramid {
        renderDeferredPass(r: render.renderer, tag: tag, scene: scene,
                           camera: cam.camera, light: cam.light, aspect: aspect)
      }
      case RenderTag.lighting {
        renderDeferredPass(r: render.renderer, tag: tag, scene: scene,
                           camera: cam.camera, light: cam.light, aspect: aspect)
      }
      case RenderTag.taa {
        renderDeferredPass(r: render.renderer, tag: tag, scene: scene,
                           camera: cam.camera, light: cam.light, aspect: aspect)
      }
      case RenderTag.composite {
        renderDeferredPass(r: render.renderer, tag: tag, scene: scene,
                           camera: cam.camera, light: cam.light, aspect: aspect)
      }
      case RenderTag.uiOverlay {
        gpu2d.beginFrameLoad()
        renderSystemGpu2d(world: io.world, res: io.gpuUi)
        drawWalkerHud(logView: io.logView, gpuUi: io.gpuUi, dbg: io.dbg, moveStick: io.moveStick, panelOpen: io.settings.open)
      }
      case RenderTag.present { gpu2d.endFrame() }
    }
    profile.zoneEnd(name: (tag as RenderTag).toString())
  }
  snapshotPrevTransforms(scene: scene)
  capFrameSleep(drs: render.drs, frameStartSec: now)
}
