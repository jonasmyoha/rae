pack WalkerCharacter {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Walker Character (skinned + animated glTF)"
  description: "A 65-joint rigged character, skinned on the GPU and playing Mixamo clips loaded from separate .glb files and retargeted by joint name. Character camera mode adds camera-relative WASD/arrow movement, mouse orbit follow, smooth facing and automatic idle/walk/run crossfades; movement runs by default and Shift walks. Orbit and free WASD inspection modes remain available. 10 meshes / 12 primitives keep separate materials, and per-vertex colour is baked from a pure-Rae-decoded palette atlas. UI is authored through .raescene and shared app3d components."
  category: "3D Renderer"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
