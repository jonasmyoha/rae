pack WalkerCharacter {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Walker Character (skinned + animated glTF)"
  description: "A 65-joint rigged character explores an infinite cel-shaded meadow built from the original Unity walker project's trees, rocks, bushes, flowers and grass. A fixed 49-cell entity pool wraps around the player without allocating while moving. GPU skinning plays separately loaded Mixamo clips with automatic idle/walk/run crossfades; Character camera mode adds camera-relative movement and mouse-orbit follow, while Orbit and free WASD inspection remain available. UI is authored through .raescene and shared app3d components."
  category: "3D Renderer"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
