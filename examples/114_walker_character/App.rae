# App composition + main loop for the walker example.
#
# CONVENTION (#822): the `App` struct IS the system list. Each system's `App`
# member is named for its folder and typed as that folder's `<Folder>System`
# state — `cameraSystem: CameraSystem`, `renderSystem: RenderSystem`,
# `physicsSystem: PhysicsSystem`, `inputSystem: InputSystem`, … — so reading the
# `App` fields reads the systems. Cross-cutting DATA and resources stay
# data-typed and are NOT forced into an `XSystem` wrapper: the per-frame `frame:
# Frame` scratch, the ECS `world: GameWorld`, the `players: PlayerRoster` control
# roster, and pure resources (`profiler: Profiler`, `grassCompute: GrassCompute`)
# are not systems. See docs/naming-conventions.md.
#
# Structure (#743): every system is its own PascalCase folder + file —
# InputSystem/ MovementSystem/ AnimationSystem/ TerrainSystem/ GrassSystem/
# CameraSystem/ RenderSystem/ PhysicsSystem/ NetSystem/ UiSystem/ (plus the
# reused lib/ecs HierarchySystem + TransformSystem). Each system function takes
# the NARROW state it needs (its own state + the GameWorld + specific
# components), never the whole `App` — the App is a pure aggregate here, built by
# createApp, sequenced by updateApp / renderApp, and never threaded into a
# system as a God-object. (Rae auto-scans every project file into one compile
# unit, so the folders are namespaces, not import walls; the decoupling is at the
# parameter level.) app.rae keeps only App + Frame/InputSystem/CharacterSystem/
# PersistState, createApp, the loop, updateApp, frameBegin. hud/players/splash/
# state stay flat as shared helpers.
import Math
import Profile
import Gpu2d
import Quat
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
import Vec3
import Sys
open GbufferInstanced
open Particles
open water/Water
open water/WaterSystem
open water/WaterFft
open gpu/GpuResources
open gpu/GpuLifetime
open GrassCompute
import GrassConfig
import app3d/Slider
open Scene3d
open Gpu3d
open RendererDeferred
open Sky
open Gbuffer
open Rendergraph
open Math3d
open Mesh3d
open Gltf
open GltfSkin
open SdfText
open Png
open app3d/CameraRig
open app3d/CharacterController
open app3d/SettingsDialog
open ui/CornerMenuButton
open SkyHosek
open app3d/UiShell
open app3d/ControlPanel
open app3d/CameraBar
open Shadow3d
open app3d/Playback
open HotReload
open ui/LogOverlay
open ui/WindowGeometry
open ui/ScrollPanel
open ui/EventLoop
open ui/DebugOverlay
open ui/VirtualJoystick
open ui/Ecs
open ui/Components
open ui/inputSystem/InputSystem
open ui/renderSystem/RenderSystem
open app3d/RenderScale

const clipTransitionDuration: Float = 0.28

# Per-frame scratch shared across systems: timing and the render/park decision.
type Frame {
  deltaTime: Float
  now: Float64
  startT: Float64
  prevT: Float64
  time: Float
  aspect: Float
  needsRender: Bool
  dbgDidWork: Bool
  taaSettleFrames: Int
  renderedOnce: Bool
  headless: Bool
}

# Input devices + the UI world state (panels, dialog, overlays). Split further in
# #545 (input intent) and #549 (UI system).
type InputSystem {
  moveStick: VirtualJoystick
  ui: UiInput
  world: UiWorld
  gpuUi: Gpu2dUi
  clipPanel: ControlPanel
  transport: ControlPanel
  charPanel: ControlPanel   # prev/next character-switch buttons (#546)
  settings: SettingsState
  panelScroll: EntityId
  dbg: DebugOverlay
  logView: LogOverlay
  lastLogRevision: Int
}

# CameraSystem + cameraUpdate live in CameraSystem/ (#548, foldered #743).
# RenderSystem lives in RenderSystem/; the per-system state types live with their
# systems. app.rae keeps only the cross-cutting Frame / InputSystem / CharacterSystem /
# PersistState that no single system owns.

# The animated character: the player-controlled hero plus a `crowd` of
# independently-animated members. #739: the hero's controller and each crowd
# member are now ENTITIES in the GameWorld — `heroEntity` carries the hero's
# ThirdPersonController; `crowdEntities` are the crowd members, each an entity
# with a ThirdPersonController + AnimationState{clipIndex,animTime} + Transform3D.
# They're driven in place via componentMod (no copy-out/mutate/set-back), and
# each member's render model is derived from its controller (walkerWorldModel).
type CharacterSystem {
  skeleton: Skeleton
  idleClip: Clip
  walkClip: Clip
  runClip: Clip
  bindPose: SkeletonPose
  transitionFrom: SkeletonPose
  transitionElapsed: Float
  heroEntity: EntityId
  clipIndex: Int
  playing: Bool
  speed: Float
  animTime: Float
  toon: Bool
  basePartModel: Mat4
  model: Mat4
  prevModel: Mat4
  crowdEntities: List(EntityId)
  crowdBatch: InstanceBatch
  groundZ: Float
}

# Window-geometry + hot-reload persistence. (#555)
type PersistState {
  windowGeom: WindowGeometry
  lastStateSave: Float64
  stateDirty: Bool
}

type App {
  # An empty World3d kept only to satisfy renderDeferredPassWorld's signature on
  # the scene-independent passes (ssao/depthPyramid/lighting/taa/composite) —
  # 114 draws its geometry through the skinned/instanced/terrain/grass paths in
  # renderGbufferPass and renderShadowPass, never through the shared mesh query,
  # so this world carries no entities and is never read.
  emptyWorld: World3d
  # #738: the ECS GameWorld — the authoritative gameplay world (EntityAllocator +
  # Transform3D/WorldTransform3D/Material3D tables); the character, crowd, terrain
  # and grass live here.
  world: GameWorld
  frame: Frame
  inputSystem: InputSystem
  cameraSystem: CameraSystem
  characterSystem: CharacterSystem
  terrainSystem: TerrainSystem
  grassSystem: GrassSystem
  renderSystem: RenderSystem
  profiler: Profiler   # #764: was lib/profile.rae gProf* globals
  grassCompute: GrassCompute   # #764: was lib/GrassCompute.rae gGrass* globals
  physicsSystem: PhysicsSystem   # fixed-step sim seam (physics.rae, #553)
  netSystem: NetSystem           # multiplayer seam (net.rae, #554)
  players: PlayerRoster   # who the local player controls (players.rae, #546)
  persist: PersistState
  splashes: ParticleSystem   # water-splash droplets when the character wades (splash.rae, #84)
  waterSystem: WaterSystem   # the toon lake at the biome water plane (lib/water, #830)
  idIssuer: IdIssuer         # the root's shared ID issuer (#869)
  gpuResources: opt GpuResources   # the App-owned GPU manager water's IDs live in (#873)
  ok: Bool
}

# ----- setup ---------------------------------------------------------------
func createApp() ret App {
  unsafe {
    Gpu2d.initWindow(width: 1280, height: 800, title: "Rae 3D — walker character (animated) [{rendererPathName()}]")
    var idIssuer: IdIssuer = IdIssuer.create()
    var windowGeom: WindowGeometry = createWindowGeometry(
      dir: dir(), name: "window.{state114AppId}.geometry")
    restoreWindowGeometry(g: windowGeom)
    let extentW: Float = windowExtentW()
    let extentH: Float = windowExtentH()
    Gpu2d.setDesignResolution(width: extentW, height: extentH, fit: 0)

    var moveStick: VirtualJoystick = createVirtualJoystick(
      padFracX: 0.06, padFracY: 0.11, radiusFrac: 0.14)

    let assets: String = "examples/114_walker_character/assets/"
    let gpuUi: Gpu2dUi = loadUiAssets(dir: assets, textFontName: "Roboto-Regular",
                                      iconFontName: "", themeFile: "theme.raescene")
    var uiWorld: UiWorld = create()
    # #764: install the app's theme (palette + scene tokens) onto this world.
    seedWorldTheme(world: uiWorld, res: gpuUi)
    let uiRoot: EntityId = mountUiScene(world: uiWorld, path: "{assets}ui.raescene", res: gpuUi)
    var uiInput: UiInput = createUiInput()
    var logView: LogOverlay = createLogOverlay(capacity: 64, maxLines: 8, anchor: logAnchorBottomLeft, fontSize: 14.0)
    var dbg: DebugOverlay = createDebugOverlay(button: true, fps: true,
                                               memory: true, heartbeat: true)
    let reloadGen: Int = nextReloadGeneration()
    logInfoLine(ov: logView, text: "hot reload {reloadGen}")

    let g: Glb = loadGlb(path: "{assets}walker.glb")
    if g.ok is false {
      log("[gltf] {g.errorMsg}")
      log("[gltf] regenerate assets/walker.glb — see tools/README.md")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }
    let charData: MeshData = loadAllPrimitives(glb: g)
    if charData.vertCount is 0 {
      log("[gltf] model contained no readable primitives")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }
    log("[gltf] walker: {charData.vertCount} verts, {charData.indices.length / 3} triangles")

    let b: List(Float) = meshBounds(meshData: charData)
    let height: Float = walkerFloatAt(values: b, index: 4) - walkerFloatAt(values: b, index: 1)
    let targetHeight: Float = 2.0
    var modelScale: Float = 1.0
    if height > 0.0 {
      modelScale = targetHeight / height
    }
    let midX: Float = (walkerFloatAt(values: b, index: 0) + walkerFloatAt(values: b, index: 3)) * 0.5
    let midZ: Float = (walkerFloatAt(values: b, index: 2) + walkerFloatAt(values: b, index: 5)) * 0.5
    let footY: Float = walkerFloatAt(values: b, index: 1)
    log("[gltf] bounds height {height}, scale {modelScale}")

    var sk: Skeleton = loadSkeleton(glb: g, skinIndex: 0)
    if sk.ok is false {
      log("[gltf] walker.glb has no skin — cannot animate")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }
    log("[gltf] skeleton: {jointCount(sk: sk)} joints, {sk.nodeCount} nodes")

    let idleGlb: Glb = loadGlb(path: "{assets}idle.glb")
    let walkGlb: Glb = loadGlb(path: "{assets}walk.glb")
    let runGlb: Glb = loadGlb(path: "{assets}run.glb")
    let idleClip: Clip = loadClip(glb: idleGlb, animIndex: 0, sk: sk)
    let walkClip: Clip = loadClip(glb: walkGlb, animIndex: 0, sk: sk)
    let runClip: Clip = loadClip(glb: runGlb, animIndex: 0, sk: sk)
    let bindPose: SkeletonPose = captureSkeletonPose(sk: sk)
    log("[anim] idle {clipChannelCount(c: idleClip)} ch / {idleClip.duration}s, walk {clipChannelCount(c: walkClip)} ch / {walkClip.duration}s, run {clipChannelCount(c: runClip)} ch / {runClip.duration}s")

    var emptyWorld: World3d = create()
    let groundZ: Float = 0.0 - 1.0
    var characterController: ThirdPersonController = createThirdPersonController()
    # #739: the GameWorld holds the hero + crowd as entities; built here so
    # createApp can populate it, then moved into the App below.
    var gameWorld: GameWorld = createGameWorld()

    # #745: quat rotation, not Euler Vec3. The model is authored Z-up-rotated by
    # +pi/2 about X; as a quat that is fromAxisAngle(X, pi/2). transform3dToMatrix
    # (T*R*S) matches the old modelMatrix for this single-axis case exactly.
    let partTransform: Transform3D = {
      position: Vec3.create(
        x: 0.0 - midX * modelScale,
        y: 0.0 - midZ * modelScale,
        z: groundZ - footY * modelScale
      ),
      rotation: Quat.fromAxisAngle(axis: Vec3.create(x: 1.0, y: 0.0, z: 0.0), angle: 1.5707963),
      scale: Vec3.create(x: modelScale, y: modelScale, z: modelScale)
    }
    let basePartModel: Mat4 = transform3dToMatrix(t: partTransform)
    groundWalker(controller: characterController, groundZ: groundZ)
    var partModel: Mat4 = walkerWorldModel(baseModel: basePartModel, controller: characterController)

    let pngBytes: List(Int) = Sys.readFileBytes(path: "{assets}walker_palette.png")
    var atlasW: Int = 0
    var atlasH: Int = 0
    let atlas: List(Int) = decodePng(png: pngBytes, len: pngBytes.length, width: atlasW, height: atlasH)
    if atlasW is 0 {
      log("[png] walker_palette.png did not decode — parts will render untinted")
    } else {
      log("[png] palette atlas {atlasW}x{atlasH}")
    }

    # #740: each skinned body-mesh part is an ENTITY carrying a PartRoughness
    # {meshId, roughness} component — no parallel partIds/partRough Lists. The
    # renderer iterates the part table (query). firstPartId seeds the crowd
    # instance batch's capacity mesh.
    var firstPartId: Int = 0
    var haveFirstPart: Bool = false
    loop var mi: Int = 0, mi < meshCount(glb: g), ++mi {
      let name: String = meshName(glb: g, meshIndex: mi)
      var rough: Float = 0.68
      if name.startsWith(prefix: "Cylinder") {
        rough = 0.35
      }
      loop var pi: Int = 0, pi < primitiveCount(glb: g, meshIndex: mi), ++pi {
        let raw: SkinnedMeshData = loadSkinnedPrimitive(glb: g, meshIndex: mi, primIndex: pi)
        if raw.vertCount > 0 {
          let part: SkinnedMeshData = withAtlasColors(m: raw, atlas: atlas, width: atlasW, height: atlasH)
          let handle: MeshHandle = uploadSkinnedMesh(verts: part.verts, vertCount: part.vertCount, indices: part.indices)
          if meshHandleIsValid(h: handle) {
            let partEntity: EntityId = gameWorldAddEntity(world: gameWorld)
            gameWorldSetPartRoughness(world: gameWorld, entity: partEntity, part: PartRoughness {
              meshId: handle.id, roughness: rough
            })
            if haveFirstPart is false {
              firstPartId = handle.id
              haveFirstPart = true
            }
          }
        }
      }
    }
    let partCount: Int = gameWorldPartCount(world: gameWorld)
    log("[gltf] skinned parts: {partCount}")
    if partCount is 0 {
      log("[gltf] no skinned primitives uploaded")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }

    var terrainSystem: TerrainSystem = createTerrainSystem(world: gameWorld, assets: assets, groundZ: groundZ)
    var grass: GrassSystem = createGrassSystem(world: gameWorld, assets: assets, groundZ: groundZ)

    let cloneCount: Int = 5
    var crowdEntities: List(EntityId) = List.create(EntityId, cap: cloneCount)
    let firstPart: MeshHandle = meshHandle(id: firstPartId, generation: 1)
    var characterClones: InstanceBatch = createInstanceBatch(mesh: firstPart, capacity: cloneCount)

    var camera: Camera3d = defaultCamera3d()
    var light: Light3d = defaultLight3d()
    let hosekData: HosekDataset = loadDefaultHosekDataset()
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: groundZ + targetHeight * 0.5)

    var renderer: DeferredRenderer = createDeferredRendererWithUiSky(
      sky: createSkyStylised(
        sunDir: light.sunDir, sunColor: light.sunColor,
        zenith: Vec3.create(x: 0.16, y: 0.34, z: 0.62),
        horizon: Vec3.create(x: 0.74, y: 0.80, z: 0.72),
        bands: 3.0))
    let gs: Int = compileDeferred(renderer: renderer)
    if gs is not 0 {
      log("render graph invalid: {statusName(status: gs)}")
      Gpu2d.closeWindow()
      Sys.exit(code: 1)
    }

    var rig: CameraRig = createCameraRig(camera: camera)
    rig.characterModeEnabled = true
    rig.mode = CameraRigMode.character
    rig.yaw = characterController.heading
    rig.orbitPitch = 0.24
    rig.distance = 4.2
    rig.minDistance = 1.2
    rig.maxDistance = 20.0
    rig.wheelSpeed = 0.4
    camera.target = thirdPersonCameraTarget(controller: characterController, focusZ: characterFocusZ)
    snapCameraRigView(rig: rig)
    # Screenshot camera (#857): RAE_WALKER_CAMERA holds the twelve space-separated
    # values of CameraRig.stateString, so a headless frame can look at the river
    # or the lake instead of the spawn (mode 1 is the free camera).
    let cameraOverride: String = Sys.getEnv(name: "RAE_WALKER_CAMERA")
    if cameraOverride.length() > 0 {
      let overrideParts: List(String) = cameraOverride.split(sep: " ")
      if applyCameraRigState(parts: overrideParts, offset: 0, rig: rig, camera: camera) {
        log("[camera] RAE_WALKER_CAMERA applied: {cameraOverride}")
      }
    }
    # #744: express the camera rig as an ECS parent relation (rig entity -> camera
    # entity) in the GameWorld; applyCameraRigHierarchy resolves the eye each frame.
    let rigLink: CameraRigLink = createCameraRigLink(world: gameWorld)

    var clipIndex: Int = 0
    var playing: Bool = true
    var speed: Float = 1.0
    var toonShading: Bool = true

    var clipPanel: ControlPanel = createControlPanel(hostNodeId: "ClipRow")
    addPanelButton(panel: clipPanel, id: "idle", label: "Idle", actionId: "clip.idle", group: 1)
    addPanelButton(panel: clipPanel, id: "walk", label: "Walk", actionId: "clip.walk", group: 1)
    addPanelButton(panel: clipPanel, id: "walkFast", label: "Walk fast", actionId: "clip.walkFast", group: 1)
    addPanelButton(panel: clipPanel, id: "run", label: "Run", actionId: "clip.run", group: 1)
    buildControlPanel(panel: clipPanel, world: uiWorld, res: gpuUi)

    var transport: ControlPanel = createControlPanel(hostNodeId: "TransportRow")
    transport.buttonW = 84.0
    buildControlPanel(panel: transport, world: uiWorld, res: gpuUi)

    # Character-switch buttons (#546): Prev / Next cycle the controlled character,
    # the same as Page Up/Down and keys 1/2. Momentary (group 0), not a selection.
    var charPanel: ControlPanel = createControlPanel(hostNodeId: "CharacterRow")
    charPanel.buttonW = 84.0
    addPanelButton(panel: charPanel, id: "prev", label: "< Prev", actionId: "char.prev", group: 0)
    addPanelButton(panel: charPanel, id: "next", label: "Next >", actionId: "char.next", group: 0)
    buildControlPanel(panel: charPanel, world: uiWorld, res: gpuUi)
    setNodeText(world: uiWorld, nodeId: "CharacterReadout", value: "Controlling 1 / {1 + cloneCount}")

    let headless: Bool = Sys.getEnv(name: "RAE_SDL_HEADLESS_MS").length() > 0
      or Sys.getEnv(name: "RAE_HEADLESS_FRAMES").length() > 0
    if not headless {
      let saved: String = readHotReloadStateFor(appId: state114AppId)
      if restore114State(raw: saved, clipIndex: clipIndex, playing: playing, speed: speed,
                         toon: toonShading, controller: characterController,
                         rig: rig, camera: camera) {
        let pctR: Int = speedPercent(value: speed)
        logInfoLine(ov: logView, text: "state restored: clip {clipIndex}, speed {pctR}%, camera and window kept")
      }
    }

    # Nobody starts in the sea. The origin is not guaranteed land — the island mask
    # only guarantees land is SOMEWHERE inside the radius.
    spawnOnLand(controller: characterController, groundZ: groundZ)
    partModel = walkerWorldModel(baseModel: basePartModel, controller: characterController)

    # #739: the hero is an entity carrying its ThirdPersonController + Transform3D.
    # Its clip/animTime + motion-vector model stay on CharacterSystem (hero-specific
    # transitions); only the controller moves into the world.
    let heroEntity: EntityId = gameWorldAddEntity(world: gameWorld)
    gameWorldSetController(world: gameWorld, entity: heroEntity, controller: characterController)
    gameWorldSetTransform(world: gameWorld, entity: heroEntity, transform: controllerTransform3D(controller: characterController))

    loop var cloneIndex: Int = 0, cloneIndex < cloneCount, ++cloneIndex {
      let spiralAngle: Float = cloneIndex.toFloat() * 2.3999632
      let spiralRadius: Float = 3.5 + cloneIndex.toFloat() * 0.45
      let cloneX: Float = characterController.position.x + Math.cos(x: spiralAngle) * spiralRadius
      let cloneY: Float = characterController.position.y + Math.sin(x: spiralAngle) * spiralRadius
      let cloneSpot: Vec3 = terrainFindLand(x: cloneX, y: cloneY)
      let cloneZ: Float = terrainHeightAt(x: cloneSpot.x, y: cloneSpot.y, groundZ: groundZ) - groundZ
      # Each crowd member gets its OWN controller (so the player can switch to and
      # drive it, #546) plus its OWN clip + starting phase (#547). A deterministic
      # mix of walk/run/idle keeps the demo lively without loading extra assets.
      var cloneController: ThirdPersonController = createThirdPersonController()
      cloneController.position.x = cloneSpot.x
      cloneController.position.y = cloneSpot.y
      cloneController.position.z = cloneZ
      cloneController.heading = spiralAngle
      # #739: each crowd member is an entity — controller + AnimationState + a
      # Transform3D synced from the controller. Its render model is derived from
      # the controller (walkerWorldModel) at draw time, so no stored model.
      let cloneEntity: EntityId = gameWorldAddEntity(world: gameWorld)
      gameWorldSetController(world: gameWorld, entity: cloneEntity, controller: cloneController)
      gameWorldSetAnim(world: gameWorld, entity: cloneEntity, anim: AnimationState {
        clipIndex: crowdClipFor(index: cloneIndex), animTime: cloneIndex.toFloat() * 0.4
      })
      gameWorldSetTransform(world: gameWorld, entity: cloneEntity, transform: controllerTransform3D(controller: cloneController))
      crowdEntities.add(value: cloneEntity)
    }
    updateInfiniteTerrain(terrainSystem: terrainSystem, world: gameWorld, playerPosition: characterController.position)
    updateGrassField(field: grass, world: gameWorld, playerPosition: characterController.position)
    # #746: exercise the physics/net ECS seams once at startup — spawn/despawn via
    # generational entities, iterate a physics body. Leaves the world untouched.
    seamSelfTest(world: gameWorld)
    if rig.mode is CameraRigMode.character {
      camera.target = thirdPersonCameraTarget(controller: characterController, focusZ: characterFocusZ)
    }

    setPanelSelection(panel: clipPanel, world: uiWorld, group: 1, id: (clipIndex as ClipKind).toString())
    setPanelButtonOn(panel: transport, world: uiWorld, id: "play", on: playing)
    setPanelButtonOn(panel: transport, world: uiWorld, id: "toon", on: toonShading)
    var playLabel0: String = "Pause"
    if not playing {
      playLabel0 = "Play"
    }
    setPanelButtonLabel(panel: transport, world: uiWorld, id: "play", label: playLabel0)
    let pct0: Int = speedPercent(value: speed)
    setNodeText(world: uiWorld, nodeId: "SpeedLabel", value: "Speed {pct0}%")
    runUiSystems(world: uiWorld, res: gpuUi)

    var panelScroll: EntityId = createScrollPanel(world: uiWorld, viewportId: "SidePanelBody", contentId: "SidePanelContent")
    # The menu button is an ECS node in the same top row as the camera bar, so the
    # two hug to one height and resize together (lib/ui/CornerMenuButton).
    let menuOk: Bool = mountCornerMenuButton(world: uiWorld, res: gpuUi, hostNodeId: "CornerMenuSlot")
    if menuOk is false {
      logWarnLine(ov: logView, text: "corner menu button failed to mount")
    }
    let barOk: Bool = mountCameraBar(world: uiWorld, res: gpuUi, hostNodeId: "CameraBarSlot")
    walkerHideCameraChrome(world: uiWorld)
    var settings: SettingsState = createSettingsState(scene: 1, sceneCount: 1,
                                                      speed: speed, toon: toonShading,
                                                      hour: 12.0,
                                                      skyModel: SettingsSkyModel.preetham)
    setTaaEnabled(on: settings.taa)   # default FXAA; the settings pane toggles TAA
    let settingsOk: Bool = mountSettingsDialog(world: uiWorld, res: gpuUi, hostNodeId: "SettingsDialogSlot")
    if settingsOk is false {
      logWarnLine(ov: logView, text: "settings dialog failed to mount")
    }
    settingsApplyToWorld(settingsState: settings, world: uiWorld)
    settings.open = false
    applyWalkerPanel(world: uiWorld, open: settings.open)
    renderer.sky = settingsBuildSky(settingsState: settings, data: hosekData, turbidity: 3.0, groundAlbedo: 0.30)
    light.sunDir = settingsSunDir(settingsState: settings)
    light.sunColor = settingsSunColor(settingsState: settings)
    log("[ui] panel buttons: {clipPanel.buttonEntities.length} clip, {transport.buttonEntities.length} transport, camera bar {barOk}")

    let startT: Float64 = Gpu2d.nowSeconds()
    var drs: RenderScaleController = createRenderScaleController(targetFps: 60.0)

    ret App {
      emptyWorld: own emptyWorld
      world: own gameWorld
      frame: {
        deltaTime: 0.0, now: startT, startT: startT, prevT: startT, time: 0.0, aspect: 1.0,
        needsRender: true, dbgDidWork: true, taaSettleFrames: 0, renderedOnce: false,
        headless: headless
      }
      inputSystem: {
        moveStick: own moveStick, ui: own uiInput, world: own uiWorld, gpuUi: gpuUi,
        clipPanel: own clipPanel, transport: own transport, charPanel: own charPanel, settings: own settings,
        panelScroll: panelScroll, dbg: own dbg, logView: own logView, lastLogRevision: 0 - 1
      }
      cameraSystem: { camera: camera, rig: own rig, light: light, hosek: hosekData,
             rigEntity: rigLink.rigEntity, camEntity: rigLink.camEntity }
      characterSystem: {
        skeleton: own sk, idleClip: idleClip, walkClip: walkClip, runClip: runClip,
        bindPose: bindPose, transitionFrom: bindPose, transitionElapsed: clipTransitionDuration,
        heroEntity: heroEntity, clipIndex: clipIndex, playing: playing,
        speed: speed, animTime: 0.0, toon: toonShading,
        basePartModel: basePartModel,
        model: partModel, prevModel: partModel, crowdEntities: own crowdEntities,
        crowdBatch: own characterClones, groundZ: groundZ
      }
      terrainSystem: own terrainSystem
      grassSystem: own grass
      renderSystem: { renderer: own renderer, drs: own drs, shadowLogged: false }
      profiler: Profile.createProfiler(),
      grassCompute: createGrassCompute()
      physicsSystem: { accumulator: 0.0, worldHandle: 0 }
      netSystem: { role: 0, tick: 0 }
      players: createPlayerRoster(count: 1 + cloneCount)
      persist: { windowGeom: own windowGeom, lastStateSave: startT, stateDirty: false }
      splashes: own createParticleSystem(cap: 256, gravity: 24.0)
      waterSystem: own createWaterSystem(body: walkerLake(groundZ: groundZ))
      idIssuer: own idIssuer
      gpuResources: GpuResources.create(issuer: idIssuer, capacity: 96)
      ok: true
    }
  }
}

# ----- the loop ------------------------------------------------------------
func runWalkerApp() ret Int {
  var app: App = createApp()
  # A stream through the meadow (#833), baked once against the terrain.
  addMeadowRiver(waterSystem: app.waterSystem, groundZ: app.characterSystem.groundZ)
  # #739/#740/#741: the GameWorld holds the hero + crowd (controllers), the
  # skinned body parts (PartRoughness), and the terrain props + heightfield tiles
  # (PropKind) — all recycled ECS entities.
  log("[ecs] GameWorld: {gameWorldEntityCount(world: app.world)} entities ({gameWorldPartCount(world: app.world)} parts + hero + crowd + terrain + grass)")
  Profile.maybeAutoStart(profiler: app.profiler)
  loop not Gpu2d.pollClose() {
    frameBegin(app: app)
    updateApp(app: app)
    if Gpu2d.shouldRenderFrame(appNeedsRender: app.frame.needsRender) is false {
      # Park until the OS has something to say (shared policy, lib/ui/event_loop).
      Gpu2d.waitEvents(timeoutSec: nextWaitTimeoutSec(
        animating: false, mouseDown: false, pollWatcher: false,
        frameSec: 0.016667, heartbeatSec: 1.0
      ))
    } else {
      if let resources: mod GpuResources => app.gpuResources {
        renderApp(cameraSystem: app.cameraSystem, characterSystem: app.characterSystem, frame: app.frame, inputSystem: app.inputSystem, renderSystem: app.renderSystem, emptyWorld: app.emptyWorld, world: app.world, terrainSystem: app.terrainSystem, splashes: app.splashes, waterSystem: app.waterSystem, resources: resources, profiler: app.profiler, grassCompute: app.grassCompute)
      }
    }
  }
  if let resources: mod GpuResources => app.gpuResources {
    grassShutdown(grass: app.grassCompute, resources: resources)
    waterShutdown(waterSystem: app.waterSystem, resources: resources)
    shutdown(resources: resources)
  }
  shutdownDeferredRenderer(renderer: app.renderSystem.renderer)   # #904: the renderer-owned GPU manager, before the C shutdown
  skinShutdown()
  shutdown()
  Gpu2d.closeWindow()
  ret 0
}
