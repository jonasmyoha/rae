# ----- per-frame timing + resize -------------------------------------------
func frameBegin(app: mod App) {
  Profile.tick(profiler: app.profiler)
  resizeUiToWindow(
    world: app.inputSystem.world
    uiSystems: app.inputSystem.uiSystems
    res: app.inputSystem.gpuUi
  )
  let now: Float64 = Gpu2d.nowSeconds()
  var deltaTime: Float = (now - app.frame.prevT) as Float
  app.frame.prevT = now
  app.frame.now = now
  # NO CLAMP before DRS: the scale controller reacts to the true frame time.
  updateRenderScale(drs: app.renderSystem.drs, deltaTime: deltaTime, profiler: app.profiler)
  setDynamicRenderScale(renderer: app.renderSystem.renderer, scale: app.renderSystem.drs.scale)
  # Negative dt is a clock going backwards, not a long frame; refuse it.
  if deltaTime < 0.0 {
    deltaTime = 0.0
  }
  app.frame.deltaTime = deltaTime
}

# The world position / heading of whichever character the local player controls
# (#546) — the hero or a crowd member. Used to aim the camera and stream the
# terrain/grass around the ACTIVE character rather than always the hero.
func controlledPosition(
  world: view GameWorld
  players: view PlayerRoster
  characterSystem: view CharacterSystem
) ret Vec3 {
  ret controllerOf(
    world: world
    entityId: rosterControlledEntityId(players: players, characterSystem: characterSystem)
  ).position
}

func controlledHeading(
  world: view GameWorld
  players: view PlayerRoster
  characterSystem: view CharacterSystem
) ret Float {
  ret controllerOf(
    world: world
    entityId: rosterControlledEntityId(players: players, characterSystem: characterSystem)
  ).heading
}

# Shared reaction to a character switch (#546), from Page Up/Down, keys 1/2, or
# the settings-panel Prev/Next buttons: snap the orbit camera behind the new
# character and update the panel readout.
func onCharacterSwitched(
  cameraSystem: mod CameraSystem
  inputSystem: mod InputSystem
  persist: mod PersistState
  players: view PlayerRoster
  world: view GameWorld
  characterSystem: view CharacterSystem
) {
  cameraSystem.rig.yaw = controlledHeading(
    world: world
    players: players
    characterSystem: characterSystem
  )
  snapCameraRigView(rig: cameraSystem.rig)
  persist.stateDirty = true
  setNodeText(
    world: inputSystem.world
    nodeId: "CharacterReadout"
    value: "Controlling {players.controlledIndex + 1} / {players.count}"
  )
}

# ----- update phase: input, UI, camera, character, terrain, grass, persist --
func updateApp(app: mod App) {
  let deltaTime: Float = app.frame.deltaTime
  let now: Float64 = app.frame.now
  # Multiplayer seam (offline no-op today, #554): pull remote intents in before
  # the local sim; the matching publish runs after it, below.
  netApplyRemote(netSystem: app.netSystem, world: app.world)
  let uiTick: UiTick = uiUpdate(
    uiSystems: app.inputSystem.uiSystems
    cameraSystem: app.cameraSystem
    characterSystem: app.characterSystem
    frame: app.frame
    inputSystem: app.inputSystem
    persist: app.persist
    players: app.players
    renderSystem: app.renderSystem
    terrainSystem: app.terrainSystem
    world: app.world
    deltaTime: deltaTime
    now: now
  )
  let settingsChanged: Bool = uiTick.settingsChanged
  let scrolled: Bool = uiTick.scrolled

  let camTick: CameraTick = cameraUpdate(
    uiSystems: app.inputSystem.uiSystems
    cameraSystem: app.cameraSystem
    inputSystem: app.inputSystem
    persist: app.persist
    world: app.world
    heroEntityId: app.characterSystem.heroEntityId
    groundZ: app.characterSystem.groundZ
    deltaTime: deltaTime
  )
  let joyActive: Bool = camTick.joyActive
  let cameraMoved: Bool = camTick.cameraMoved

  # Character switching (#546): Page Up / Page Down cycle who the local player
  # controls. On a switch, snap the orbit camera behind the new character.
  if app.cameraSystem.rig.mode is CameraRigMode.character {
    var switched: Bool = false
    if sdl3.isKeyPressed(key: Keys.keyPageDown) or sdl3.isKeyPressed(key: keyNextChar) {
      rosterSwitchNext(roster: app.players)
      switched = true
    }
    if sdl3.isKeyPressed(key: Keys.keyPageUp) or sdl3.isKeyPressed(key: keyPrevChar) {
      rosterSwitchPrev(roster: app.players)
      switched = true
    }
    if switched {
      onCharacterSwitched(
        cameraSystem: app.cameraSystem
        inputSystem: app.inputSystem
        persist: app.persist
        players: app.players
        world: app.world
        characterSystem: app.characterSystem
      )
    }
  }

  app.characterSystem.prevModel = app.characterSystem.model
  var characterMoved: Bool = false
  let controlledEntityId: EntityId = rosterControlledEntityId(
    players: app.players
    characterSystem: app.characterSystem
  )
  # Devices -> intent (input.rae), then the CONTROLLED character's mover gets it
  # as a throttle (and the jump); every other character stands. A remote
  # player's intent would arrive from net.rae instead; the drive is the same.
  var intent: InputIntent = {
    moveX: 0.0
    moveY: 0.0
    walking: false
    jump: false
    actions: 0
  }
  if app.cameraSystem.rig.mode is CameraRigMode.character {
    intent = inputUpdate(
      moveStick: app.inputSystem.moveStick
      joyActive: joyActive
      allowKeys: uiPointerCaptured(input: app.inputSystem.ui) is false and app.characterSystem.playing
    )
  }
  # The controller's heading and position before the physics steps, to tell
  # whether the character moved this frame
  let before: Vec3 = controllerOf(world: app.world, entityId: controlledEntityId).position
  let headingBefore: Float = controllerOf(world: app.world, entityId: controlledEntityId).heading
  driveCharacters(
    physicsSystem: app.physicsSystem
    controlledEntityId: controlledEntityId
    controller: controllerOf(world: app.world, entityId: controlledEntityId)
    intent: intent
    cameraYaw: app.cameraSystem.rig.viewYaw
    speedScale: app.characterSystem.speed
  )
  # Fixed-timestep physics (#553, lib/box3d/ecs): the movers, then the bodies,
  # at 60 Hz from the frame time, decoupled from render; it writes every
  # character's controller and every cube's Transform3D.
  let physicsSteps: Int = stepPhysicsFrame(
    physicsSystem: app.physicsSystem
    world: app.world
    groundZ: app.characterSystem.groundZ
    frameTime: deltaTime
  )
  let after: view ThirdPersonController => controllerOf(
    world: app.world
    entityId: controlledEntityId
  )
  characterMoved = physicsSteps > 0 and (after.position.x is not before.x or after.position.y is not before.y or after.position.z is not before.z or after.heading is not headingBefore)
  let grounded: Bool = characterGrounded(
    physicsSystem: app.physicsSystem
    entityId: controlledEntityId
  )
  let controlledClip: Int = moverClipFor(
    speed: characterSpeed(physicsSystem: app.physicsSystem, entityId: controlledEntityId)
    grounded: grounded
  )
  if rosterControlledIsHero(roster: app.players) {
    app.characterSystem.airborne = grounded is false
  } else {
    app.characterSystem.airborne = characterGrounded(
      physicsSystem: app.physicsSystem
      entityId: app.characterSystem.heroEntityId
    ) is false
  }
  # The hero's model follows its controller whenever the physics moved it (it
  # can be pushed or fall even when the player drives someone else)
  app.characterSystem.model = walkerWorldModel(
    baseModel: app.characterSystem.basePartModel
    controller: controllerOf(world: app.world, entityId: app.characterSystem.heroEntityId)
  )
  if characterMoved {
    app.persist.stateDirty = true
  }
  if app.cameraSystem.rig.mode is CameraRigMode.character {
    if rosterControlledIsHero(roster: app.players) {
      if controlledClip is not app.characterSystem.clipIndex {
        app.characterSystem.transitionFrom = captureSkeletonPose(sk: app.characterSystem.skeleton)
        app.characterSystem.transitionElapsed = 0.0
        app.characterSystem.clipIndex = controlledClip
        app.characterSystem.animTime = 0.0
        setPanelSelection(
          panel: app.inputSystem.clipPanel
          world: app.inputSystem.world
          group: 1
          id: (app.characterSystem.clipIndex as ClipKind).toString()
        )
      }
    } else {
      # The player drives a crowd member: its clip follows its mover, slowed
      # in the air, written IN PLACE (componentMod, no copy/set-back).
      let drivenAnim: mod AnimationState => componentMod(
        this: app.world.animStates
        entityId: controlledEntityId
      )
      drivenAnim.clipIndex = controlledClip
      drivenAnim.playbackScale = 1.0
      if grounded is false {
        drivenAnim.playbackScale = airborneClipScale
      }
      # The hero, no longer player-driven, stands idle.
      app.characterSystem.clipIndex = ClipKind.idle as Int
    }
    let focusPos: Vec3 = controlledPosition(
      world: app.world
      players: app.players
      characterSystem: app.characterSystem
    )
    app.cameraSystem.camera.target = Vec3.create(
      x: focusPos.x
      y: focusPos.y
      z: focusPos.z + characterFocusZ
    )
  }
  let followPos: Vec3 = controlledPosition(
    world: app.world
    players: app.players
    characterSystem: app.characterSystem
  )
  let terrainWrapped: Bool = updateInfiniteTerrain(
    terrainSystem: app.terrainSystem
    renderer: app.renderSystem.renderer
    world: app.world
    playerPosition: followPos
  )
  let grassWrapped: Bool = updateGrassField(
    grassSystem: app.grassSystem
    world: app.world
    playerPosition: followPos
  )

  netPublishIntent(netSystem: app.netSystem, world: app.world)

  let resized: Bool = Gpu2d.windowResized()
  if resized {
    app.persist.stateDirty = true
  }
  updateWindowGeometry(windowGeometry: app.persist.windowGeometry, now: now, resized: resized)

  if app.persist.stateDirty and not app.frame.headless {
    if (now - app.persist.lastStateSave) as Float >= 0.25 {
      writeHotReloadStateFor(
        appId: state114AppId
        state: serialize114State(
          clipIndex: app.characterSystem.clipIndex
          playing: app.characterSystem.playing
          speed: app.characterSystem.speed
          toon: app.characterSystem.toon
          controller: controllerOf(world: app.world, entityId: app.characterSystem.heroEntityId)
          rig: app.cameraSystem.rig
          camera: app.cameraSystem.camera
        )
      )
      app.persist.lastStateSave = now
      app.persist.stateDirty = false
    }
  }

  let hadUiEvents: Bool = uiActionCount(world: app.inputSystem.world) > 0 or app.inputSystem.ui.pointer.down or app.inputSystem.ui.pointer.pressed or app.inputSystem.ui.pointer.released
  let logChanged: Bool = app.inputSystem.logOverlay.revision is not app.inputSystem.lastLogRevision
  let transitionActive: Bool = app.characterSystem.transitionElapsed < clipTransitionDuration
  # Live splash droplets are an animation source: keep rendering until the last one
  # dies out, or the wait-loop would freeze them mid-air when you stop wading (#84,
  # the "feed animation sources into the loop" lesson in AGENTS.md).
  let splashesAlive: Bool = app.splashes.list.length > 0
  # Bodies still moving (a toppling stack, a character in the air) are an
  # animation source too; the venue's static body is never awake
  let physicsAwake: Bool = physicsCounters(physics: app.physicsSystem.physics).awakeBodyCount > 0 or characterMoved
  var needsRender: Bool = app.characterSystem.playing or transitionActive or settingsChanged or cameraMoved or characterMoved or terrainWrapped or grassWrapped or splashesAlive or physicsAwake or hadUiEvents or logChanged or resized or scrolled or app.frame.renderedOnce is false
  if app.frame.taaSettleFrames > 0 {
    needsRender = true  # only meaningful with TAA on
  }
  app.frame.dbgDidWork = needsRender
  if needsRender {
    if app.inputSystem.settings.taa is false {
      app.frame.taaSettleFrames = 0  # FXAA has no history to converge
    } else if app.characterSystem.playing or settingsChanged or cameraMoved or hadUiEvents or resized {
      app.frame.taaSettleFrames = 6
    } else {
      app.frame.taaSettleFrames = app.frame.taaSettleFrames - 1
    }
  }
  app.frame.needsRender = needsRender
}
