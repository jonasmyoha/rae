# The transparent forward pass in isolation (#845): a lit deferred scene with a
# row of alpha-blended cubes drawn over it, so the pass is proven without the
# walker (136). Opaque geometry goes through the G-buffer as usual; at the
# transparentForward tag we queue instances into the renderer's transparent
# batch (addTransparentInstance) and the pass alpha-blends them into the lit
# HDR target against a READ-ONLY scene depth.
#
# What the picture must show (the headless gate checks the log line + a
# non-blank frame; the blend itself is a human check on hardware):
#   * nine cubes floating in a row, alpha 0.1 -> 0.9 left to right, the ground
#     and the opaque cubes visible THROUGH the faint ones;
#   * one cube half-sunk into the ground: its lower half is cut off by the
#     opaque ground (depth test), its upper half blends;
#   * the opaque cubes in front of the row occlude it (depth), the row never
#     occludes them (depth is not written);
#   * a tall shimmering wall round the scene (an open cylinder, style 4): bands
#     running up it, brighter where it is seen side-on, its far side visible
#     through its near side; and three soft glowing spheres. Three meshes in one
#     frame, each run one draw. RAE_TRANSPARENT_VIEW=inside puts the camera inside
#     the wall, =outside far outside it;
#   * with RAE_TRANSPARENT_TINT=1 a red screen tint at 0.35 over the whole lit
#     frame (setScreenTint), as a game shows being outside its safe zone.
import Gpu2d
import Sys
import Vec3
open app3d/UiShell
open Gbuffer
open GbufferRecord
open Math3d
open Mesh3d
open RendererDeferred
open Rendergraph
open Scene3d
open TransparentForward
open ecs/Entity

const alphaCubeCount: Int = 9

const opaqueCubeCount: Int = 4

const wallRadius: Float = 10.0

const wallHeight: Float = 9.0

func uploadMeshData(renderer: mod DeferredRenderer, meshData: view MeshData) ret MeshHandle {
  ret uploadMesh(
    renderer: renderer
    verts: meshData.verts
    vertCount: meshData.vertCount
    indices: meshData.indices
  )
}

# Ground plane + four opaque cubes: two in FRONT of the alpha row (they must
# occlude it) and two behind (they must show through the faint cubes).
func buildScene(box: view MeshHandle, ground: view MeshHandle) ret World3d {
  var sceneWorld: World3d = create()
  let noEmission: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRotation: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let oneScale: Vec3 = Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  let groundMaterial: Material3d = {
    baseColor: Vec3.create(x: 0.16, y: 0.2, z: 0.27)
    metallic: 0.0
    roughness: 0.82
    emission: noEmission
    toon: false
  }
  let groundEntityId: EntityId = world3dAddMeshInstance(
    world: sceneWorld
    mesh: ground
    material: groundMaterial
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    rotation: noRotation
    scale: oneScale
  )
  loop var i: Int = 0, i < opaqueCubeCount, ++i {
    # i 0,1 sit in front of the row (y = -3); i 2,3 behind it (y = +3).
    let front: Bool = i < 2
    var y: Float = 3.0
    if front {
      y = 0.0 - 3.0
    }
    let x: Float = (i % 2).toFloat() * 4.0 - 2.0
    let cubeMaterial: Material3d = {
      baseColor: Vec3.create(x: 0.85, y: 0.35 + (i.toFloat() * 0.15), z: 0.2)
      metallic: 0.05
      roughness: 0.55
      emission: noEmission
      toon: false
    }
    let cubeEntityId: EntityId = world3dAddMeshInstance(
      world: sceneWorld
      mesh: box
      material: cubeMaterial
      position: Vec3.create(x: x, y: y, z: 0.75)
      rotation: noRotation
      scale: Vec3.create(x: 1.5, y: 1.5, z: 1.5)
    )
  }
  ret sceneWorld
}

# Queue this frame's transparent instances: the alpha row + the sunk cube.
func queueTransparents(transparent: mod TransparentPassCache, box: view MeshHandle) {
  let noRotation: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  loop var i: Int = 0, i < alphaCubeCount, ++i {
    let alpha: Float = (i + 1).toFloat() / 10.0
    let x: Float = i.toFloat() * 1.4 - 5.6
    let cube: Transform3d = {
      position: Vec3.create(x: x, y: 0.0, z: 2.2)
      rotation: noRotation
      scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
    }
    addTransparentInstance(
      cache: transparent
      mesh: box
      transform: cube
      r: 0.25
      g: 0.65
      b: 1.0
      alpha: alpha
    )
  }
  # Half-sunk: center at z = 0, so the lower half is below the ground plane.
  let sunk: Transform3d = {
    position: Vec3.create(x: 0.0, y: 1.5, z: 0.0)
    rotation: noRotation
    scale: Vec3.create(x: 1.6, y: 1.6, z: 1.6)
  }
  addTransparentInstance(
    cache: transparent
    mesh: box
    transform: sunk
    r: 1.0
    g: 0.9
    b: 0.3
    alpha: 0.6
  )
}

# The wall: the open cylinder (unit, along y) stood up on z and scaled to the
# circle, shimmering in time. Then three glowing spheres, a third mesh.
func queueWall(
  transparent: mod TransparentPassCache
  wall: view MeshHandle
  sphere: view MeshHandle
  time: view Float
) {
  let standUp: Transform3d = {
    position: Vec3.create(x: 0.0, y: 0.0, z: wallHeight * 0.5)
    rotation: Vec3.create(x: 1.5707963, y: 0.0, z: 0.0)
    scale: Vec3.create(x: wallRadius, y: wallHeight * 0.5, z: wallRadius)
  }
  addTransparentShimmerInstance(
    cache: transparent
    mesh: wall
    model: modelMatrixOf(t: standUp)
    r: 0.35
    g: 0.75
    b: 1.0
    alpha: 0.22
    shimmer: { time: time, bandsPerMeter: 0.35, speed: 0.3, edgeGlow: 0.9 }
  )
  loop var i: Int = 0, i < 3, ++i {
    let ball: Transform3d = {
      position: Vec3.create(x: i.toFloat() * 3.0 - 3.0, y: 5.0, z: 4.5)
      rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
      scale: Vec3.create(x: 1.2, y: 1.2, z: 1.2)
    }
    addTransparentMaterialInstance(
      cache: transparent
      mesh: sphere
      model: modelMatrixOf(t: ball)
      r: 1.0
      g: 0.6
      b: 0.25
      alpha: 0.7
      style: 3.0
    )
  }
}

func main() ret Int {
  Gpu2d.initWindow(width: 960, height: 600, title: "139: Rae Transparent Pass — Deferred")
  # 2D (the debug overlay) is drawn in the window's points (app3d/UiShell)
  syncDesignResolution()

  let boxData: MeshData = makeBox(size: 1.0)
  let planeData: MeshData = makePlane(size: 30.0, segments: 1)
  var renderer: DeferredRenderer = createDeferredRenderer()

  let box: MeshHandle = uploadMeshData(renderer: renderer, meshData: boxData)
  let wall: MeshHandle = uploadMeshData(
    renderer: renderer
    meshData: makeOpenCylinder(segments: 96)
  )
  let sphere: MeshHandle = uploadMeshData(
    renderer: renderer
    meshData: makeSphere(rings: 16, segments: 24)
  )
  let ground: MeshHandle = uploadMeshData(renderer: renderer, meshData: planeData)
  var sceneWorld: World3d = buildScene(box: box, ground: ground)
  var camera: Camera3d = defaultCamera3d()
  camera.position = Vec3.create(x: 1.0, y: 0.0 - 13.0, z: 7.0)
  camera.target = Vec3.create(x: 0.0, y: 0.0, z: 1.5)
  let cameraPlace: String = Sys.getEnv(name: "RAE_TRANSPARENT_VIEW")
  if cameraPlace is "outside" {
    camera.position = Vec3.create(x: 4.0, y: 0.0 - 26.0, z: 12.0)
  } else if cameraPlace is "inside" {
    camera.position = Vec3.create(x: 0.0, y: 0.0 - 7.0, z: 2.5)
    camera.target = Vec3.create(x: 0.0, y: 6.0, z: 3.0)
  }
  let light: Light3d = defaultLight3d()

  if Sys.getEnv(name: "RAE_TRANSPARENT_TINT").length() > 0 {
    setScreenTint(
      cache: renderer.passes.transparent
      r: 0.9
      g: 0.12
      b: 0.08
      strength: 0.35
    )
  }
  let graphStatus: Int = compileDeferred(renderer: renderer)
  if graphStatus is not 0 {
    log("deferred graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }

  let fixedTestFrame: Bool = Sys.getEnv(name: "RAE_TRANSPARENT_TEST_FRAME").length() > 0
  var transparentFrames: Int = 0
  loop not Gpu2d.pollClose() {
    if Gpu2d.windowResized() {
      syncDesignResolution()
    }
    let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
    if Gpu2d.renderGate() {
      var passIndex: Int = 0
      loop passIndex < deferredOrderLength(renderer: renderer) {
        let tag: Int = deferredTagAt(renderer: renderer, i: passIndex)
        if tag is RenderTag.transparentForward {
          queueTransparents(transparent: renderer.passes.transparent, box: box)
          queueWall(
            transparent: renderer.passes.transparent
            wall: wall
            sphere: sphere
            time: transparentFrames.toFloat() / 60.0
          )
          transparentFrames = transparentFrames + 1
        }
        renderDeferredPassWorld(
          renderer: renderer
          tag: tag
          world: sceneWorld
          camera: camera
          light: light
          aspect: aspect
        )
        passIndex = passIndex + 1
      }
      world3dPrevTransformSystem(world: sceneWorld)
    }
  }

  if fixedTestFrame {
    log(
      "[transparent] deterministic deferred frame rendered: {alphaCubeCount + 1} alpha instances over {opaqueCubeCount} opaque, {transparentFrames} transparent frames"
    )
  }
  if fixedTestFrame {
    log("[transparent] a shimmering wall and 3 spheres beside the cubes: 3 meshes a frame")
  }
  shutdownDeferredRenderer(renderer: renderer)  # #904: the renderer-owned GPU manager, before the C shutdown
  Gbuffer.shutdownAll()
  Gpu2d.closeWindow()
  ret 0
}
