pack PhysicsPlaygroundPort {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Physics Playground — Box3D ported to Rae"
  description: "Six physics scenes on the Rae port of the Box3D physics engine: a box pyramid of 1k-10k bodies, dominoes, a hinged bridge with a hanging chain, welded towers, balls rolling over a mesh and a character walking a terrain. Fly with WASD/Q/E and look with a right drag. Hold the left button or F to fire balls like a machine gun, or press T for autofire; a bounded ECS pool despawns old balls. Bodies are drawn with one instanced draw per mesh kind, with shadows, under a lib/ui HUD showing step and frame timings. Its twin, 123_physics_playground_c, runs the same scenes on upstream Box3D's C library, so the two can be compared side by side."
  category: "Physics"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
