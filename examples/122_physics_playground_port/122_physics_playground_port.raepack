pack PhysicsPlaygroundPort {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Physics Playground — Box3D ported to Rae (frozen reference)"
  description: "Frozen reference (docs/physics-two-implementations.md §7): Rae's physics engine is Box3D's C library, and this Rae port of Box3D is kept as a benchmark and kept compiling, but it does not follow upstream. It runs the same six scenes as 123_physics_playground_c, with identical results: a box pyramid of 1k-10k bodies, dominoes, a hinged bridge with a hanging chain, welded towers, balls rolling over a mesh and a character walking a terrain. Fly with WASD/Q/E and look with a right drag; hold the left button or F to fire balls, or press T for autofire."
  category: "Physics"
  featured: "false"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
