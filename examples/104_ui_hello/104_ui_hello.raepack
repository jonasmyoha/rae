pack UiHello {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "UI hello world"
  description: "A value and three buttons: Clear, -1, +1. The smallest thing that is still a real application: a window, a themed layout, hit-tested buttons and a value on screen. The state is one Int, one function decides what a press does to it, and the layout is a .raescene document. Portrait, phone-shaped. Example 105 is the same idea carried further."
  category: "UI"
  wasmWebApp: "true"
  display: {
    width: 440
    height: 880
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
