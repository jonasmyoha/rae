    "h": 56
   },
   "Size": {
    "w": {
     "mode": "Fill"
    },
    "h": {
     "mode": "Fixed"
    }
   },
   "Shape": {
    "kind": "RoundedRect",
    "fill": "surfaceAlt",
    "radius": "radiusPill"
   },
   "OnClick": {
    "actionId": "counter.clear",
    "label": "Clear"
   },
   "Children": [
    "ButtonClearLabel"
   ]
  },
