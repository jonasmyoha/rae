{
 "type": "Scene",
 "version": 2,
 "root": "UiRoot",
 "nodes": {
  "UiRoot": {
   "Rect": {
    "x": 0,
    "y": 0,
    "w": 440,
    "h": 880
   },
   "Layout": {
    "type": "Vertical",
    "gap": "spaceM",
    "alignCross": "Stretch"
   },
   "Padding": {
    "l": "spaceL",
    "t": "spaceL",
    "r": "spaceL",
    "b": "spaceL"
   },
   "Children": [
    "ValueText",
    "ButtonRow"
   ]
  },
  "ValueText": {
   "bundles": [
    "appearRise"
   ],
   "Rect": {
    "x": 0,
    "y": 0,
    "w": 396,
    "h": 64
   },
   "Text": {
    "text": "Value: 3!",
    "styleId": "display"
   },
   "Size": {
    "w": {
     "mode": "Fill"
    }
   }
  },
  "ButtonRow": {
