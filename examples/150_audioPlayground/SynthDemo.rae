# The state of the Synth section: the synth's sound as the panel set it, the notes held now (by
# the mouse, by each finger, by a MIDI keyboard), the platform's MIDI with the sources connected
# so far, and the tempo map and transport the metronome is scheduled on.
open audio/AudioSynth
open audio/MidiPorts
open audio/MusicalTime
open ecs/Entity

# C4 (MIDI 60): the keyboard's lowest note at the starting octave, and the metronome's base
const keyboardLowNote: Int = 60

# The on-screen keyboard: thirteen keys, from the C of `octave` to the next C
const keyboardKeys: Int = 13

# The octaves the - and + buttons reach (C1 .. C7 as the keyboard's lowest C)
const lowestOctave: Int = 1

const highestOctave: Int = 7

type SynthDemo {
  sound: SynthSound
  # the waveforms the waveform button steps through, and which it shows
  waveformIndex: Int = 0
  # the octave of the keyboard's lowest C (4: C4, MIDI 60), for the on-screen keys and keyjazz
  octave: Int = 4
  # keyjazz: the computer keyboard plays the synth (Z..M and Q..P rows), on at launch
  keyjazz: Bool = true
  # the notes held by the on-screen keyboard this frame (MIDI numbers), and by MIDI
  keyboardHeld: List(Int)
  midiHeld: List(Int)
  # the keys as entities, C4 first (found once, after the scene is mounted)
  keyEntityIds: List(EntityId)
  midi: MidiPorts
  midiConnected: List(Int)
  # when the sources are looked at next (s, the window's clock)
  nextMidiScanSeconds: Float64 = 0.0
  midiStatus: String = "MIDI: looking for keyboards"
  midiLast: String = ""
  tempo: TempoMap
  transport: Transport
  patternsPlayed: Int = 0
  keyNotesPlayed: Int = 0
  # the most keyboard notes held at once (for the demo's summary)
  keyboardHeldMost: Int = 0
  midiNotesPlayed: Int = 0
}

func createSynthDemo(sampleRate: view Int) ret SynthDemo {
  ret SynthDemo {
    sound: SynthSound {}
    keyboardHeld: {}
    midiHeld: {}
    keyEntityIds: {}
    midi: openMidi(name: "Rae audio playground")
    midiConnected: {}
    tempo: createTempoMap(sampleRate: sampleRate)
    transport: createTransport()
  }
}

func endSynthDemo(demo: view SynthDemo) {
  closeMidi(this: demo.midi)
}

# The MIDI note of the keyboard's lowest key: the C of `octave`
func lowNoteOf(demo: view SynthDemo) ret Int {
  ret 12 * (demo.octave + 1)
}
