# 150: Audio playground — the audio package (packages/audio, docs/audio-design.md §10) to try by
# ear, a section for each of its parts: short sounds on the effects bus that overlap, a
# test-signal MP3 streamed from disk on the music bus with play, pause and seek, a volume per
# bus, pan, the alerts' ducking of the music bus, game sounds, a sound placed in 3D, footsteps
# from step events, the synth and MIDI, the microphone, effects on the buses, Now Playing, and a
# status of the device and of how the audio thread keeps up.
#
# The layout is a .raescene (assets/Ui.raescene); each section is its own module (SoundsSection,
# MusicSection, MixSection, StatusSection) run once a frame over the app's Playground, which holds
# the audio engine as a resource. With no device (RAE_AUDIO_DEVICE=offline, or a headless run such
# as the visual gate's) the engine renders offline and the app renders a frame's samples itself.
#
# RAE_AUDIO_PLAYGROUND_DEMO=1 presses the controls by itself on set frames (two sounds, the stream,
# an alert, a seek, a pan) and logs what the engine did, for a headless check;
# RAE_AUDIO_PLAYGROUND_SECONDS=N ends a run on the real device after N seconds.
import Gpu2d
open ui/EventLoop
open ui/Registry
open app3d/UiShell
open ui/Ecs
open ui/Pipeline
open ui/UiValues
open ui/valueSystem/ValueSystem
open ui/animationSystem/AnimationTracks
open ui/buttonSystem/ButtonHoverScale
open ecs/Schedule
open ui/inputSystem/InputSystem
open ui/renderSystem/RenderSystem
open ui/SceneInstance
open ecs/Entity
open Gpu2dCanvas
open ui/UiSystems
open audio/Audio
open audio/AudioMixer
open audio/AudioStreams
open audio/BusEffects
open Playground
open SoundsSection
open MusicSection
open MixSection
open GameSection
open PlacedSection
open StepsSection
open SynthSection
open InputSection
open EffectsSection
open NowPlayingSection
open audio/RenderTimes
open StatusSection

const designW: Int = 1880

const designH: Int = 1040

const idleHeartbeatSeconds: Float = 0.5

# While a MIDI keyboard is connected the loop looks for its notes this often (MIDI does not wake
# the window's wait), and redraws only at the heartbeat when nothing else changed
const midiPollSeconds: Float = 0.004

# An offline demo ends after this many frames (5.3 s of audio at a 60th of a second a frame), so
# what
# it played does not depend on how fast the machine draws: the sounds have ended, the stream plays
const demoOfflineFrames: Int = 320

# The demo's presses, frame by frame (RAE_AUDIO_PLAYGROUND_DEMO=1)
func demoStep(playground: mod Playground, values: mod UiValues, frame: view Int) {
  if frame is 3 {
    playSoundOn(playground: playground, sound: playground.click, bus: AudioBusKind.effects)
    playSoundOn(playground: playground, sound: playground.bell, bus: AudioBusKind.effects)
  }
  if frame is 6 {
    toggleMusic(playground: playground)
  }
  if frame is 20 {
    playSoundOn(playground: playground, sound: playground.alert, bus: AudioBusKind.alerts)
    playSoundOn(playground: playground, sound: playground.chime, bus: AudioBusKind.effects)
  }
  if frame is 40 {
    let unusedSought: Bool = playground.audio.seek(voiceId: playground.musicVoice, seconds: 16.0)
  }
  if frame is 45 {
    playground.pan = -0.8
    playground.audio.setVoicePan(voiceId: playground.musicVoice, pan: playground.pan)
    let unusedPan: Bool = setUiValue(values: values, key: "pan", value: -0.8)
  }
  # the buzz goes round at 6 m, then out past the far distance, where its voice is paused
  if frame is 50 {
    startOrbit(playground: playground, distance: 6.0)
  }
  # a varied footstep, a burst under its cap, and the buzz's engine rate up to 150 %
  if frame is 55 {
    playStep(playground: playground)
  }
  if frame is 60 {
    fireBurst(playground: playground)
  }
  if frame is 70 {
    playground.engineRate = 1.5
    applyEngineRate(playground: playground)
    let unusedRate: Bool = setUiValue(values: values, key: "game.rate", value: 1.5)
  }
  # the walker and the mech cross the strip side by side
  if frame is 50 {
    startWalker(demo: playground.stepsDemo)
  }
  if frame is 60 {
    startMech(demo: playground.stepsDemo)
  }
  # the effects measured on the stream, then the reverb on the music bus
  if frame is 10 {
    let before: Float64 = Gpu2d.nowSeconds()
    measureEffects(playground: playground)
    log(
      "[audioPlayground] the measurement took {((Gpu2d.nowSeconds() - before) * 1000.0) as Float} ms"
    )
  }
  if frame is 12 {
    playground.musicBusEffects.reverbOn = true
    playground.audio.applyBusEffects(bus: AudioBusKind.music, effects: playground.musicBusEffects)
  }
  # the metronome at 240 beats a minute: two bars in two seconds
  if frame is 20 {
    playMetronome(playground: playground, beatsPerMinute: 240.0)
  }
  if frame is 89 {
    log("[audioPlayground] orbit at 6 m: {orbitReadout(playground: playground, distance: 6.0)}")
  }
  if frame is 90 {
    let unusedDistance: Bool = setUiValue(values: values, key: "orbit.distance", value: 30.0)
  }
}

func main() ret Int {
  Gpu2d.initWindow(width: designW, height: designH, title: "150: Audio playground")
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  var gpuUi: Gpu2dUi = loadUiFonts(
    directory: "lib/assets/walker/"
    textFontName: "Roboto-Regular"
    iconFontName: "MaterialIconsRound-Regular"
  )
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  var sceneRegistry: SceneRegistry = createSceneRegistry()
  let root: EntityId = mountSceneWithImports(
    world: world
    uiSystems: uiSystems
    root: playgroundAssets
    sceneId: "Ui"
    resources: gpuUi
    canvas: canvas
    registry: sceneRegistry
  )
  if isNone(this: root) {
    log("[audioPlayground] the scene mounted no root")
    Gpu2d.closeWindow()
    ret 1
  }
  var playground: Playground = createPlayground()
  log(
    "[audioPlayground] {playground.audio.sampleRate} Hz, {playground.audio.channels} channels, offline {playground.audio.offline}"
  )
  var values: UiValues = createUiValues()
  setMixDefaults(values: values)
  applyBusVolumes(playground: playground, values: values)
  setPlacedDefaults(values: values)
  setGameDefaults(values: values)
  setSynthDefaults(values: values)
  setEffectsDefaults(values: values)
  startEffects(playground: playground, values: values)
  enableNowPlaying()
  var statusShown: List(String) = List.create(String, cap: 8)
  let demo: Bool = getEnv(name: "RAE_AUDIO_PLAYGROUND_DEMO") is "1"
  let recordByItself: Bool = getEnv(name: "RAE_AUDIO_PLAYGROUND_RECORD") is "1"
  let logPlaying: Bool = getEnv(name: "RAE_AUDIO_PLAYGROUND_BACKGROUND") is "1"
  let runSeconds: Float = getEnv(name: "RAE_AUDIO_PLAYGROUND_SECONDS").toFloat()
  let startedSeconds: Float64 = Gpu2d.nowSeconds()
  var schedule: Schedule = createUiPipeline(world: world)
  var input: UiInput = createUiInput()
  var renderedOnce: Bool = false
  var wokeUp: Bool = false
  var lastRenderSeconds: Float64 = 0.0
  var animating: Bool = false
  var lastFrameSeconds: Float64 = Gpu2d.nowSeconds()
  var frame: Int = 0
  loop not Gpu2d.pollClose() and not (runSeconds > 0.0 and Gpu2d.nowSeconds() - startedSeconds > runSeconds as Float64) and not (demo and playground.rendersItself and frame >= demoOfflineFrames) {
    var changed: Bool = resizeUiToWindow(world: world, uiSystems: uiSystems, res: gpuUi)
    updateUiInput(input: input, world: world, uiSystems: uiSystems)
    changed = valueSystem(
      world: world
      uiSystems: uiSystems
      input: input
      values: values
    ) or changed
    let hadEvents: Bool = uiActionCount(world: world) > 0
    let now: Float64 = Gpu2d.nowSeconds()
    let deltaTime: Float = (now - lastFrameSeconds) as Float
    let pressing: Bool = buttonHoverScaleUpdate(
      world: world
      uiSystems: uiSystems
      hovered: input.hoveredEntityId
      deltaTime: deltaTime
    )
    lastFrameSeconds = now
    frame = frame + 1
    playgroundFrame(playground: playground)
    if recordByItself {
      inputDemoStep(playground: playground, frame: frame)
    }
    if logPlaying {
      playingLogStep(playground: playground, frame: frame, now: now)
    }
    if demo {
      demoStep(playground: playground, values: values, frame: frame)
      nowPlayingDemoStep(frame: frame)
      synthDemoStep(
        demo: playground.synthDemo
        world: world
        uiSystems: uiSystems
        frame: frame
      )
    }
    changed = soundsSection(playground: playground, world: world) or changed
    changed = musicSection(playground: playground, world: world, values: values) or changed
    changed = mixSection(playground: playground, world: world, values: values) or changed
    changed = gameSection(playground: playground, world: world, values: values) or changed
    # offline the engine moves a 60th of a second a frame, so the orbit does too
    var audioDeltaTime: Float = deltaTime
    if playground.rendersItself {
      audioDeltaTime = 1.0 / 60.0
    }
    changed = inputSection(playground: playground, world: world, values: values) or changed
    changed = nowPlayingSection(playground: playground) or changed
    changed = effectsSection(playground: playground, world: world, values: values) or changed
    changed = synthSection(
      playground: playground
      world: world
      uiSystems: uiSystems
      input: input
      values: values
    ) or changed
    changed = stepsSection(playground: playground, world: world, deltaTime: audioDeltaTime) or changed
    changed = placedSection(
      playground: playground
      world: world
      values: values
      deltaTime: audioDeltaTime
    ) or changed
    changed = statusSection(
      playground: playground
      world: world
      shown: statusShown
      now: now
    ) or changed
    if hadEvents or changed or animating or pressing or renderedOnce is false {
      runScheduledUiSystems(
        schedule: schedule
        world: world
        uiSystems: uiSystems
        res: gpuUi
      )
    }
    # while the music plays its position moves, and the status a few times a second
    let musicMoving: Bool = musicIsPlaying(playground: playground) or playground.orbitOn
    animating = animationInFlight(world: world, uiSystems: uiSystems) or pressing or musicMoving
    let needsRender: Bool = hadEvents or changed or wokeUp or animating or renderedOnce is false
    wokeUp = false
    if Gpu2d.shouldRenderFrame(appNeedsRender: needsRender) {
      Gpu2d.beginFrame(
        canvas: canvas
        r: 0.04
        g: 0.05
        b: 0.08
        a: 1.0
      )
      renderSystemGpu2d(
        world: world
        uiSystems: uiSystems
        res: gpuUi
        canvas: canvas
      )
      Gpu2d.endFrame(canvas: canvas)
      renderedOnce = true
      lastRenderSeconds = Gpu2d.nowSeconds()
    } else {
      # the engine's feedback is read each turn, so an idle app still wakes a few times a second
      let midiListening: Bool = playground.synthDemo.midiConnected.length > 0
      var heartbeatSeconds: Float = idleHeartbeatSeconds
      if midiListening {
        heartbeatSeconds = midiPollSeconds
      }
      Gpu2d.waitEvents(timeoutSeconds: nextWaitTimeoutSeconds(
        visible: Gpu2d.renderableNow()
        animating: animating
        mouseDown: false
        pollWatcher: true
        frameSeconds: 0.016667
        heartbeatSeconds: heartbeatSeconds
      ))
      wokeUp = not midiListening or Gpu2d.nowSeconds() - lastRenderSeconds > idleHeartbeatSeconds as Float64
    }
  }
  var position: Float64 = 0.0
  if playground.musicStarted {
    position = playground.audio.positionSeconds(voiceId: playground.musicVoice)
  }
  let grounds: String = groundsHeardText(demo: playground.stepsDemo)
  let orbit: String = orbitSummary(playground: playground)
  log(
    "[audioPlayground] {frame} frames; sounds played {playground.soundsPlayed}, voices ended {playground.audio.voicesEnded}; music started {playground.musicStarted} at {((position * 10.0) as Float).toInt() / 10} s; pan {playground.pan}; underrun frames {playground.audio.underrunFrames()}; orbit {orbit}; steps {playground.stepsPlayed}, bursts {playground.burstsFired}, shots at once at most {playground.shotsAtOnceMost}, engine rate {playground.engineRate}; synth patterns {playground.synthDemo.patternsPlayed}, keyboard notes {playground.synthDemo.keyNotesPlayed} (at most {playground.synthDemo.keyboardHeldMost} at once); step events walker {playground.stepsDemo.walkerSteps}, mech {playground.stepsDemo.mechSteps}, on{grounds}"
  )
  log(
    "[audioPlayground] {playground.synthDemo.midiStatus}; MIDI notes played {playground.synthDemo.midiNotesPlayed}"
  )
  log("[audioPlayground] input: {inputSummary(playground: playground)}")
  log(
    "[audioPlayground] now playing: shown {playground.nowPlayingShown}, remote commands {playground.remoteCommands}, last {playground.lastRemoteCommand}; render: {playground.renderRecorder.calls} renders, max {playground.renderRecorder.maximumNanoseconds / 1000} us of {playground.renderRecorder.periodNanoseconds / 1000} us; helpers {playground.audio.renderHelperCount()}; real-time check {realtimeCheckText()}"
  )
  log("[audioPlayground] effects measured: {playground.effectsMeasured.length} effects")
  loop let line: String in playground.effectsMeasured {
    log("[audioPlayground] effect {line}")
  }
  let unusedBlocks: Int = endPlayground(playground: playground)
  Gpu2d.closeWindow()
  ret 0
}
