# The playground's state: the audio engine (a resource of the app, docs/audio-design.md §10.1),
# the sounds loaded once, the music stream's voice, and the mix settings the panel set. Each panel
# section (SoundsSection, MusicSection, MixSection, GameSection, PlacedSection, StatusSection;
# later steps add
# the synth, the microphone, the effects and the real-time view) reads and changes it once a frame.
import Math
import Realtime
import Sys
open audio/Audio
open audio/AudioInput
open audio/AudioMixer
open audio/AudioSession
open audio/BusEffects
open audio/RenderTimes
open audio/AudioSpatial
open audio/Sound
open audio/VoiceControls
open StepsDemo
open SynthDemo
open InputDemo
open ecs/ComponentTable
open ecs/Entity
open ecs/Transform
open ecs/World

# Where the example's files are, from the repository root (the iOS bundle keeps the same paths)
const playgroundAssets: String = "examples/150_audioPlayground/assets/"

type Playground {
  audio: AudioEngine
  # the effects bus's sounds, in the order of their buttons, and the alert
  click: Sound
  bell: Sound
  whoosh: Sound
  chime: Sound
  alert: Sound
  soundsPlayed: Int = 0
  # the music stream: its voice once started, and whether it plays
  musicVoice: VoiceId = { value: 0 }
  musicStarted: Bool = false
  # the mix: pan of the voices started from now on and of the music (-1 left .. 1 right), and
  # whether alerts duck the music
  pan: Float = 0.0
  ducking: Bool = true
  # no device (RAE_AUDIO_DEVICE=offline, or a headless run): the app renders a frame's samples
  # itself each frame, so the engine moves on as it would with a device
  rendersItself: Bool = false
  frames: Int = 0
  # sounds placed in 3D (audio/AudioSpatial): the listener and source tables, the transforms the
  # placed sources follow, the app's entities, and the buzz going round the listener
  placement: AudioPlacement
  transforms: ComponentTable(WorldTransform3D)
  entities: EntityAllocator
  buzz: Sound
  orbitEntityId: EntityId
  orbitOn: Bool = false
  # radians round the listener: 0 ahead, a quarter turn on its right
  orbitAngle: Float = 0.0
  # game sounds (audio/VoiceControls): a footstep played varied from the app's own Random (a
  # fixed seed, so a run plays the same), a gunshot capped at three voices, and the orbiting
  # buzz's playback rate (its engine speed)
  step: Sound
  shot: Sound
  random: Random
  stepsPlayed: Int = 0
  burstsFired: Int = 0
  # with no device, the most shot voices playing at once (not fading out), read from the mixer
  shotsAtOnceMost: Int = 0
  # a walker and a mech crossing a strip of grounds, and the steps their events play
  stepsDemo: StepsDemo
  # the synth's keyboard, sound, metronome and MIDI
  synthDemo: SynthDemo
  # the microphone: its permission, the meter, a take and its playback
  inputDemo: InputDemo
  # the effects on the music and effects buses (audio/BusEffects), the bus the Effects section
  # shows (0 music, 1 effects), and its last measurement
  musicBusEffects: BusEffects = {}
  effectsBusEffects: BusEffects = {}
  effectsBus: Int = 0
  effectsMeasured: List(String) = {}
  # the render's times (audio/RenderTimes) in a recorder of this thread, and the slowest render
  # of each half second for the history graph (the last renderHistoryLength of them)
  renderRecorder: Realtime.RealtimeRecorder
  renderHistory: List(Int) = {}
  renderWindowMaximum: Int = 0
  renderWindowStarted: Float64 = 0.0
  # Now Playing (audio/NowPlaying): shown for the stream, and the remote commands handled
  nowPlayingShown: Bool = false
  nowPlayingVoice: Int = -1
  # RAE_AUDIO_PLAYGROUND_BACKGROUND=1: when the stream's place is logged next (s)
  nextPlayingLog: Float64 = 0.0
  remoteCommands: Int = 0
  lastRemoteCommand: String = ""
  engineRate: Float = 1.0
}

# A headless run (the visual gate) has no device to depend on, so it renders offline
func playgroundWantsOffline() ret Bool {
  ret getEnv(name: "RAE_SDL_HEADLESS_MS").length() > 0 or audioOfflineWanted()
}

# The engine's settings: offline for a headless run; with one input channel (a duplex device, a
# play-and-record session on iOS) when `withInput`
func playgroundAudioSettings(withInput: view Bool) ret AudioSettings {
  var settings: AudioSettings = defaultAudioSettings()
  settings.offline = playgroundWantsOffline()
  # an EQ, a compressor and a reverb on the music and effects buses (EffectsSection)
  settings.busEffects = true
  # music: Now Playing shows it, and iOS keeps it playing in the background
  settings.session = AudioSessionKind.music
  if withInput and not settings.offline {
    settings.inputChannels = 1
    settings.session = AudioSessionKind.recording
  }
  ret settings
}

func createPlayground() ret Playground {
  # the microphone starts off: the Mic button turns it on (and asks for it). A run that records
  # by itself (RAE_AUDIO_PLAYGROUND_RECORD=1) opens it at once when it is already allowed.
  let microphoneAllowed: Bool = microphonePermission() is 3 and getEnv(
    name: "RAE_AUDIO_PLAYGROUND_RECORD"
  ) is "1"
  var audio: AudioEngine = audioStart(
    settings: playgroundAudioSettings(withInput: microphoneAllowed)
  )
  let click: Sound = audio.loadSound(path: "{playgroundAssets}click.wav")
  let bell: Sound = audio.loadSound(path: "{playgroundAssets}bell.wav")
  let whoosh: Sound = audio.loadSound(path: "{playgroundAssets}whoosh.wav")
  let chime: Sound = audio.loadSound(path: "{playgroundAssets}chime.m4a")
  let alert: Sound = audio.loadSound(path: "{playgroundAssets}alert.wav")
  let buzz: Sound = audio.loadSound(path: "{playgroundAssets}buzzLoop.wav")
  let step: Sound = audio.loadSound(path: "{playgroundAssets}step.wav")
  let shot: Sound = audio.loadSound(path: "{playgroundAssets}shot.wav")
  # a burst fires faster than a shot ends: at most three sound at once, the oldest fading
  audio.setSoundVoiceLimit(sound: shot, voiceLimit: 3, rule: AudioStealRule.oldest)
  # an alert takes the music down 14 dB while it plays (on the audio thread, §6.4)
  audio.duckWhilePlaying(
    source: AudioBusKind.alerts
    target: AudioBusKind.music
    gainDecibels: -14.0
  )
  let rendersItself: Bool = audio.offline
  let stepsDemo: StepsDemo = createStepsDemo(audio: audio, assets: playgroundAssets)
  # the listener stands at the origin looking along +Y; the orbiting source is its own entity
  var entities: EntityAllocator = createEntityAllocator()
  var placement: AudioPlacement = createAudioPlacement()
  let listenerEntityId: EntityId = entities.allocEntity()
  placement.listeners.componentSet(entityId: listenerEntityId, data: defaultListener())
  let orbitEntityId: EntityId = entities.allocEntity()
  ret Playground {
    audio: own audio
    click: click
    bell: bell
    whoosh: whoosh
    chime: chime
    alert: alert
    rendersItself: rendersItself
    placement: placement
    transforms: createComponentTable(WorldTransform3D)
    entities: entities
    buzz: buzz
    orbitEntityId: orbitEntityId
    step: step
    shot: shot
    random: createRandom(seed: 150)
    stepsDemo: stepsDemo
    synthDemo: createSynthDemo(sampleRate: audio.sampleRate)
    renderRecorder: Realtime.createRealtimeRecorder(
      name: "audio render"
      periodNanoseconds: audio.renderPeriodNanoseconds()
    )
    inputDemo: createInputDemo(audio: audio)
  }
}

# Once a frame, on the main thread: the engine's feedback, its ended voices, and with no device a
# frame's worth of samples rendered here
func playgroundFrame(playground: mod Playground) {
  if playground.rendersItself {
    let unusedSamples: List(Float) = playground.audio.renderOffline(
      frames: playground.audio.sampleRate / 60
    )
  }
  playground.audio.update()
  let unusedEnded: List(VoiceId) = playground.audio.takeEndedVoices()
  playground.frames = playground.frames + 1
}

# A volume slider's share (0 .. 1) as a gain: 0 dB at the top, 60 dB down at the bottom, and
# silence at zero
func shareToDecibels(share: view Float) ret Float {
  if share <= 0.001 {
    ret -100.0
  }
  ret 60.0 * (share - 1.0)
}

func endPlayground(playground: mod Playground) ret Int {
  endSynthDemo(demo: playground.synthDemo)
  ret playground.audio.stopAudio()
}
