pack TransparentPass {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Transparent forward pass (isolated)"
  description: "The deferred renderer's transparentForward pass proven on its own: a lit scene with a row of alpha-blended cubes (0.1 -> 0.9) and one half-sunk into the ground, so blending and the read-only depth test are visible without the walker."
  category: "3D Renderer"
  display: {
    width: 960
    height: 600
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
