pack WalkerForward {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Walker, forward rendering"
  description: "The FORWARD-rendered twin of example 114: the same 65-joint walker, crowd, island meadow, grass, props and Box3D cubes, shaded in one 4x MSAA pass on the Rae forward renderer (lib/RendererForward). No water (lake, river, sea) or splash droplets; SSAO comes later. README.md lists every difference from 114."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
