# The deferred renderer + dynamic-resolution controller (#552). Lives with the
# RenderSystem — the App just aggregates it.
type RenderSystem {
  renderer: DeferredRenderer
  drs: RenderScaleController
  shadowLogged: Bool
  # The physics cubes, one instanced draw (the unit box, scaled per cube)
  cubeBatch: InstanceBatch
}

# A clip plays this much slower while its character is in the air: there is
# no jump clip, so a slowed run stride stands in for the leap
const airborneClipScale: Float = 0.3

# The physics cubes into the G-buffer: one instanced draw of the unit box.
func drawPhysicsCubes(
  cache: mod GbufferCache
  resources: mod GpuResources
  batch: mod InstanceBatch
  physicsSystem: view PhysicsSystem
  world: view GameWorld
  toon: view Bool
) {
  resetInstanceBatch(batch: batch)
  loop var i: Int = 0, i < componentCount(this: physicsSystem.cubes), ++i {
    let cubeId: EntityId = componentEntityAt(this: physicsSystem.cubes, i: i)
    if componentHas(this: world.transforms, entityId: cubeId) is false {
      continue
    }
    let cube: view PhysicsCube => componentView(this: physicsSystem.cubes, entityId: cubeId)
    let model: Mat4 = physicsCubeModel(
      transform: componentView(this: world.transforms, entityId: cubeId)
      cube: cube
    )
    let material: Material3d = {
      baseColor: cube.color
      metallic: 0.0
      roughness: 0.7
      emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
      toon: toon
    }
    addInstance(
      batch: batch
      model: model
      prevModel: model
      material: material
    )
  }
  drawInstances(cache: cache, resources: resources, batch: batch)
}

# The physics cubes into the shadow map.
func drawPhysicsCubesShadow(
  renderer: mod DeferredRenderer
  batch: view InstanceBatch
  physicsSystem: view PhysicsSystem
  world: view GameWorld
) {
  let cubeMesh: MeshHandle = meshHandle(id: batch.meshId, generation: 1)
  loop var i: Int = 0, i < componentCount(this: physicsSystem.cubes), ++i {
    let cubeId: EntityId = componentEntityAt(this: physicsSystem.cubes, i: i)
    if componentHas(this: world.transforms, entityId: cubeId) {
      castKind(
        renderer: renderer
        mesh: cubeMesh
        model: physicsCubeModel(
          transform: componentView(this: world.transforms, entityId: cubeId)
          cube: componentView(this: physicsSystem.cubes, entityId: cubeId)
        )
      )
    }
  }
}

# The shadow pass: fit cascades to this frame, then rasterise every caster
# (ground, props, the character's skinned parts + crowd). Its own function so the
# match arm stays a one-liner (and the systems refactor #543 gives it a home).
func renderShadowPass(
  cameraSystem: mod CameraSystem
  characterSystem: mod CharacterSystem
  inputSystem: mod InputSystem
  renderSystem: mod RenderSystem
  terrainSystem: mod TerrainSystem
  world: mod GameWorld
  physicsSystem: view PhysicsSystem
  aspect: copy Float
  palette: view List(Float)
) {
  let cascades: ShadowCascades = fitShadowCascades(
    camPos: cameraSystem.camera.position
    camTarget: cameraSystem.camera.target
    fovYDeg: cameraSystem.camera.fovYDeg
    aspect: aspect
    near: cameraSystem.camera.nearZ
    far: 24.0
    sunDir: cameraSystem.light.sunDir
    count: 3
    resolution: drsShadowRes(drs: renderSystem.drs)
    lambda: 0.75
    backExtent: 12.0
  )
  uploadPalette(
    renderer: renderSystem.renderer
    rows: palette
    jointCount: jointCount(sk: characterSystem.skeleton)
  )
  if inputSystem.settings.shadows {
    beginShadowPass(renderer: renderSystem.renderer, c: cascades)
    drawTerrainPropsShadow(
      renderer: renderSystem.renderer
      terrainSystem: terrainSystem
      world: world
    )
    drawPhysicsCubesShadow(
      renderer: renderSystem.renderer
      batch: renderSystem.cubeBatch
      physicsSystem: physicsSystem
      world: world
    )
    # Each caster's shadow samples the SAME palette slot its G-buffer instance
    # does (#547), so a crowd member casts its own pose. Hero = slot 0.
    let jc: Int = jointCount(sk: characterSystem.skeleton)
    loop var sp: Int = 0, sp < gameWorldPartCount(world: world), ++sp {
      let sh: MeshHandle = meshHandle(
        id: gameWorldPartAt(world: world, i: sp).meshId
        generation: 1
      )
      drawShadowCasterSkinnedWith(
        renderer: renderSystem.renderer
        mesh: sh
        model: characterSystem.model
        paletteBase: 0
      )
      loop var shadowClone: Int = 0, shadowClone < characterSystem.crowdEntities.length, ++shadowClone {
        if let member: EntityId = characterSystem.crowdEntities.copyAt(index: shadowClone) {
          let ctrl: view ThirdPersonController => componentView(
            this: world.controllers
            entityId: member
          )
          let cloneModel: Mat4 = walkerWorldModel(
            baseModel: characterSystem.basePartModel
            controller: ctrl
          )
          drawShadowCasterSkinnedWith(
            renderer: renderSystem.renderer
            mesh: sh
            model: cloneModel
            paletteBase: characterPaletteBase(slot: shadowClone + 1, jointCount: jc)
          )
        }
      }
    }
    endShadowPass(renderer: renderSystem.renderer)
  }
  if renderSystem.shadowLogged is false {
    log(
      "[shadow] casters {shadowCasterCount(renderer: renderSystem.renderer)}, {cascades.count} cascades at {cascades.resolution}"
    )
    renderSystem.shadowLogged = true
  }
}

# The G-buffer pass: grass compute first, then the geometry — biome-splat ground,
# scene, instanced props, and the character's skinned parts + idle crowd — then
# the grass draw, all into one G-buffer pass.
func renderScenePass(
  cache: mod GbufferCache
  rendererResources: mod GpuResources
  cameraSystem: mod CameraSystem
  characterSystem: mod CharacterSystem
  terrainSystem: mod TerrainSystem
  world: mod GameWorld
  physicsSystem: view PhysicsSystem
  cubeBatch: mod InstanceBatch
  aspect: copy Float
  palette: view List(Float)
  t: copy Float
  deltaTime: copy Float
  profiler: mod Profiler
  grassCompute: mod GrassCompute
  resources: mod GpuResources
) {
  var grassToonGen: Int = 0
  if characterSystem.toon {
    grassToonGen = 1
  }
  var grassView: GrassViewSettings = GrassConfig.grassThirdPersonSettings(
    groundColor: walkerGroundColor()
  )
  # Low, broad tufts accent the painted ground instead of hiding it.
  grassView.bladeHeightScale = 0.55
  grassView.bladeWidthScale = 1.8
  grassView.densityScale = 0.55
  grassView.clusterStrength = 0.8
  grassView.tipLighten = 1.25
  grassView.windStrength = 0.45
  let heroPos: Vec3 = controllerOf(world: world, entityId: characterSystem.heroEntityId).position
  grassGenerate(
    grass: grassCompute
    resources: resources
    playerX: heroPos.x
    playerY: heroPos.y
    groundZ: characterSystem.groundZ
    time: t
    deltaTime: deltaTime
    toon: grassToonGen
    camX: cameraSystem.camera.position.x
    camY: cameraSystem.camera.position.y
    camZ: cameraSystem.camera.position.z
    fwdX: cameraSystem.camera.target.x - cameraSystem.camera.position.x
    fwdY: cameraSystem.camera.target.y - cameraSystem.camera.position.y
    fwdZ: cameraSystem.camera.target.z - cameraSystem.camera.position.z
    settings: grassView
  )
  grassDiagTick(grass: grassCompute, resources: resources, profiler: profiler)
  # #912: the geometry pass's pipelines/binds live in the RENDERER's manager
  # (rendererResources); the grass compute objects stay in the App's (resources).
  # The forward pass is open (RenderTag.forward in renderApp)
  drawTerrainGround(
    cache: cache
    resources: rendererResources
    terrainSystem: terrainSystem
    world: world
    time: t
  )
  drawTerrainProps(
    cache: cache
    resources: rendererResources
    terrainSystem: terrainSystem
    world: world
  )
  drawPhysicsCubes(
    cache: cache
    resources: rendererResources
    batch: cubeBatch
    physicsSystem: physicsSystem
    world: world
    toon: characterSystem.toon
  )
  # Palettes (hero slot 0 + one per crowd member) were uploaded in renderApp;
  # the hero's is re-written here into the cache's palette (slot 0).
  let jc: Int = jointCount(sk: characterSystem.skeleton)
  uploadPaletteAt(
    cache: cache
    resources: rendererResources
    rows: palette
    jointCount: jc
    baseRow: 0
  )
  loop var p: Int = 0, p < gameWorldPartCount(world: world), ++p {
    let part: view PartRoughness => gameWorldPartAt(world: world, i: p)
    let handle: MeshHandle = meshHandle(id: part.meshId, generation: 1)
    let mat: Material3d = {
      baseColor: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      metallic: 0.0
      roughness: part.roughness
      emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
      toon: characterSystem.toon
    }
    GbufferSkinned.drawSkinnedInstance(
      cache: cache
      resources: rendererResources
      mesh: handle
      model: characterSystem.model
      prevModel: characterSystem.prevModel
      material: mat
    )
    setInstanceBatchMesh(batch: characterSystem.crowdBatch, mesh: handle)
    resetInstanceBatch(batch: characterSystem.crowdBatch)
    loop var cloneDraw: Int = 0, cloneDraw < characterSystem.crowdEntities.length, ++cloneDraw {
      if let member: EntityId = characterSystem.crowdEntities.copyAt(index: cloneDraw) {
        # Each crowd member samples its OWN palette slot (#547) so it holds a
        # distinct pose in this single instanced skinned draw. Its model is
        # derived from the entity's controller (#739) — no stored model.
        let ctrl: view ThirdPersonController => componentView(
          this: world.controllers
          entityId: member
        )
        let cloneModel: Mat4 = walkerWorldModel(
          baseModel: characterSystem.basePartModel
          controller: ctrl
        )
        addSkinnedInstance(
          batch: characterSystem.crowdBatch
          model: cloneModel
          prevModel: cloneModel
          material: mat
          paletteBase: characterPaletteBase(slot: cloneDraw + 1, jointCount: jc)
        )
      }
    }
    drawSkinnedInstances(
      cache: cache
      resources: rendererResources
      batch: characterSystem.crowdBatch
    )
  }
  grassDraw(
    grass: grassCompute
    resources: resources
    gbuffer: cache
    gbufferResources: rendererResources
  )
}

# ----- render phase: animation sample + render-graph walk ------------------
func renderApp(
  uiSystems: view UiSystems
  cameraSystem: mod CameraSystem
  characterSystem: mod CharacterSystem
  frame: mod Frame
  inputSystem: mod InputSystem
  renderSystem: mod RenderSystem
  world: mod GameWorld
  physicsSystem: view PhysicsSystem
  terrainSystem: mod TerrainSystem
  resources: mod GpuResources
  profiler: mod Profiler
  grassCompute: mod GrassCompute
) {
  frame.renderedOnce = true
  inputSystem.lastLogRevision = inputSystem.logOverlay.revision
  let deltaTime: Float = frame.deltaTime
  let now: Float64 = frame.now

  var clipRate: Float = 1.0
  if characterSystem.clipIndex is ClipKind.walkFast {
    clipRate = 1.6
  }
  if characterSystem.airborne {
    clipRate = clipRate * airborneClipScale
  }
  if characterSystem.playing {
    characterSystem.animTime = characterSystem.animTime + deltaTime * characterSystem.speed * clipRate
  }
  applySkeletonPose(sk: characterSystem.skeleton, pose: characterSystem.bindPose)
  # Which clip feeds the pose. walk and walkFast share the walk clip (walkFast is
  # it at 1.6x via clipRate above); once or-patterns land (#622) they merge.
  match characterSystem.clipIndex {
    case ClipKind.idle {
      applyClip(
        sk: characterSystem.skeleton
        c: characterSystem.idleClip
        time: characterSystem.animTime
      )
    }
    case ClipKind.walk {
      applyClip(
        sk: characterSystem.skeleton
        c: characterSystem.walkClip
        time: characterSystem.animTime
      )
    }
    case ClipKind.walkFast {
      applyClip(
        sk: characterSystem.skeleton
        c: characterSystem.walkClip
        time: characterSystem.animTime
      )
    }
    case ClipKind.run {
      applyClip(
        sk: characterSystem.skeleton
        c: characterSystem.runClip
        time: characterSystem.animTime
      )
    }
  }
  let transitionActive: Bool = characterSystem.transitionElapsed < clipTransitionDuration
  if transitionActive {
    characterSystem.transitionElapsed = characterSystem.transitionElapsed + deltaTime
    var blendWeight: Float = characterSystem.transitionElapsed / clipTransitionDuration
    if blendWeight > 1.0 {
      blendWeight = 1.0
    }
    blendWeight = blendWeight * blendWeight * (3.0 - 2.0 * blendWeight)
    blendSkeletonPose(
      sk: characterSystem.skeleton
      from: characterSystem.transitionFrom
      weight: blendWeight
    )
  }
  let palette: List(Float) = buildPalette(sk: characterSystem.skeleton)

  # Per-character crowd palettes (#547): upload the hero into slot 0 first (this
  # also creates the shared palette buffer on frame 0), then give each crowd
  # member a time-shifted pose in its own slot so ONE instanced skinned draw per
  # part renders every character in a DISTINCT pose. The hero `palette` above is
  # untouched — poseCharacterPalette only borrows the skeleton as scratch.
  # Each crowd member advances its OWN animation and poses into its OWN palette
  # slot (#547) — independent of the player, so member 2 can idle while member 0
  # walks. Slot 0 is the hero (uploaded first, which also creates the buffer).
  let jc: Int = jointCount(sk: characterSystem.skeleton)
  uploadPalette(renderer: renderSystem.renderer, rows: palette, jointCount: jc)
  loop var crowdSlot: Int = 0, crowdSlot < characterSystem.crowdEntities.length, ++crowdSlot {
    if let member: EntityId = characterSystem.crowdEntities.copyAt(index: crowdSlot) {
      # Advance this member's AnimationState IN PLACE (#739) — no copy/set-back.
      let anim: mod AnimationState => componentMod(this: world.animStates, entityId: member)
      anim.animTime = anim.animTime + deltaTime * clipPlaybackRate(clipIndex: anim.clipIndex) * anim.playbackScale
      let memberClip: Int = anim.clipIndex
      let memberTime: Float = anim.animTime
      let crowdPalette: List(Float) = poseCharacterPalette(
        characterSystem: characterSystem
        clipIndex: memberClip
        animTime: memberTime
      )
      ensureRendererResources(renderer: renderSystem.renderer)
      if let rendererResources: mod GpuResources => renderSystem.renderer.gpuResources {
        uploadPaletteSlot(
          cache: renderSystem.renderer.passes.gbuffer
          resources: rendererResources
          rows: crowdPalette
          jointCount: jc
          slot: crowdSlot + 1
        )
      }
    }
  }

  applyCameraRigHierarchy(cameraSystem: cameraSystem, world: world)
  syncCameraBar(world: inputSystem.world, rig: cameraSystem.rig, camera: cameraSystem.camera)
  let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
  let t: Float = (now - frame.startT) as Float

  gpuPassTimingBegin(renderer: renderSystem.renderer)
  loop var oi: Int = 0, oi < deferredOrderLength(renderer: renderSystem.renderer), ++oi {
    let tag: Int = deferredTagAt(renderer: renderSystem.renderer, i: oi)
    gpuPassMark(renderer: renderSystem.renderer, tag: tag)
    Profile.zoneBegin(profiler: profiler, name: (tag as RenderTag).toString())
    # Exhaustive over RenderTag: adding a pass is a compile error here until it is
    # handled (#624). Each pass is a helper/one-liner; the five generic passes
    # defer to renderDeferredPass (or-patterns, #622, will merge them into one arm).
    match tag {
      case RenderTag.shadow {
        renderShadowPass(
          cameraSystem: cameraSystem
          characterSystem: characterSystem
          inputSystem: inputSystem
          renderSystem: renderSystem
          terrainSystem: terrainSystem
          world: world
          physicsSystem: physicsSystem
          aspect: aspect
          palette: palette
        )
      }
      case RenderTag.gbuffer {
        # No G-buffer: the scene draws in the forward step
      }
      case RenderTag.forward {
        # The scene, shaded in one 4x MSAA pass (lib/RendererForward)
        beginForwardPass(
          renderer: renderSystem.renderer
          camera: cameraSystem.camera
          light: cameraSystem.light
          aspect: aspect
        )
        if let rendererResources: mod GpuResources => renderSystem.renderer.gpuResources {
          renderScenePass(
            cache: renderSystem.renderer.passes.gbuffer
            rendererResources: rendererResources
            cameraSystem: cameraSystem
            characterSystem: characterSystem
            terrainSystem: terrainSystem
            world: world
            physicsSystem: physicsSystem
            cubeBatch: renderSystem.cubeBatch
            aspect: aspect
            palette: palette
            t: t
            deltaTime: deltaTime
            profiler: profiler
            grassCompute: grassCompute
            resources: resources
          )
        }
        endForwardPass(renderer: renderSystem.renderer)
      }
      case RenderTag.ssao {
        # SSAO needs a stored depth the forward pass does not keep: forward-rae-6
        # adds it (a depth + normal pre-pass), and its step goes here
      }
      case RenderTag.depthPyramid {
        # Not in the forward frame
      }
      case RenderTag.lighting {
        # Not in the forward frame: the forward step shades as it draws
      }
      case RenderTag.taa {
        # Not in the forward frame: 4x MSAA is the antialiasing
      }
      case RenderTag.waterFft {
        # No water in 126
      }
      case RenderTag.underwater {
        # No water in 126
      }
      case RenderTag.transparentForward {
        # No transparents in 126 (114 draws its water and splash droplets here)
      }
      case RenderTag.bloom {
        renderDeferredPass(
          renderer: renderSystem.renderer
          tag: tag
          camera: cameraSystem.camera
          light: cameraSystem.light
          aspect: aspect
        )
      }
      case RenderTag.antialias {
        # Not in the forward frame: 4x MSAA is the antialiasing
      }
      case RenderTag.composite {
        renderDeferredPass(
          renderer: renderSystem.renderer
          tag: tag
          camera: cameraSystem.camera
          light: cameraSystem.light
          aspect: aspect
        )
      }
      case RenderTag.uiOverlay {
        Gpu2d.beginFrameLoad(canvas: renderSystem.renderer.canvas)
        renderSystemGpu2d(
          world: inputSystem.world
          uiSystems: uiSystems
          res: inputSystem.gpuUi
          canvas: renderSystem.renderer.canvas
        )
        drawWalkerHud(
          logOverlay: inputSystem.logOverlay
          gpuUi: inputSystem.gpuUi
          canvas: renderSystem.renderer.canvas
          dbg: inputSystem.dbg
          moveStick: inputSystem.moveStick
          editor: inputSystem.uiModes.editor
        )
      }
      case RenderTag.present {
        endUiFrameTimed(renderer: renderSystem.renderer)
      }
    }
    Profile.zoneEnd(profiler: profiler, name: (tag as RenderTag).toString())
  }
  gpuPassTimingEnd(renderer: renderSystem.renderer)
  capFrameSleep(drs: renderSystem.drs, frameStartSec: now)
}
