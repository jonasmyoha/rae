import examples/24_code_hybrid_hot_reload/scripts/downloaded/devPatch
import examples/24_code_hybrid_hot_reload/scripts/downloaded/releasePatch

func buildHybridDevBundle() {
  log("[Hybrid demo] Compiling host stub for dev profile")
  emitDevPatch()
  log("[Hybrid demo] vm/dev_patch.vmchunk staged for code hot reload testing")
}

func buildHybridReleaseBundle() {
  log("[Hybrid demo] Compiling host stub for release profile")
  emitReleasePatch()
  log("[Hybrid demo] vm/release_patch.vmchunk staged for code hot reload testing")
}
