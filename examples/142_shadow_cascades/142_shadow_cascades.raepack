pack ShadowCascades {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Shadow cascades (debug view)"
  description: "The debugging ground for the sun's cascaded shadow maps. Each cascade is painted in its own colour (red, green, blue, yellow from the camera out): its area tinted, its shadow map's square outlined and a line where it ends, so you see where one cascade hands over to the next and where shadows stop. Posts every metre around a character marker and every 10 m out to 400 m. The standard editor panel: a Cascades switch in the top bar, and the fit (shadow distance, split lambda, cascade count, map resolution, back extent) with the split distances in the side panel. Every setting has an environment override for headless screenshots."
  category: "3D Renderer"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
