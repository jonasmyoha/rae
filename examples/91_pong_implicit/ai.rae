type AIState {
  reactionTimer: Float
  reactionDelay: Float
  targetY: Float
  velocityY: Float
  sampleCount: Int
}

func createAIState() ret AIState {
  ret AIState {
    reactionTimer: 0.22
    reactionDelay: 0.22
    targetY: 175.0
    velocityY: 0.0
    sampleCount: 0
  }
}

func predictInterceptY(
  ballX: view Float
  ballY: view Float
  ballDx: view Float
  ballDy: view Float
) ret Float {
  if ballDx <= 0.0 {
    ret fieldH * 0.5
  }

  var travelTime: Float = (760.0 - ballRadius - ballX) / ballDx
  if travelTime < 0.0 { travelTime = 0.0 }
  if travelTime > 3.0 { travelTime = 3.0 }

  let top: Float = ballRadius
  let bottom: Float = fieldH - ballRadius
  var predictedY: Float = ballY + ballDy * travelTime
  loop predictedY < top or predictedY > bottom {
    if predictedY < top {
      predictedY = top + (top - predictedY)
    }
    if predictedY > bottom {
      predictedY = bottom - (predictedY - bottom)
    }
  }
  ret predictedY
}

func updateAiTarget(
  ai: mod AIState
  ballX: view Float
  ballY: view Float
  ballVelocity: view Velocity
) {
  let paddleHeight: Float = paddleH
  if ballVelocity.dx > 0.0 {
    let interceptY: Float = predictInterceptY(
      ballX: ballX, ballY: ballY
      ballDx: ballVelocity.dx, ballDy: ballVelocity.dy)
    let errorStep: Int = (ai.sampleCount * 17 + ballY.toInt()) % 31 - 15
    let aimError: Float = errorStep.toFloat() * 3.0
    ai.targetY = interceptY - paddleHeight * 0.5 + aimError
  } else {
    # A human opponent prepares near centre instead of tracking an irrelevant
    # ball perfectly while it is travelling toward the player.
    ai.targetY = (fieldH - paddleHeight) * 0.5
  }

  if ai.targetY < 0.0 { ai.targetY = 0.0 }
  if ai.targetY > fieldH - paddleHeight {
    ai.targetY = fieldH - paddleHeight
  }
  ai.sampleCount = ai.sampleCount + 1
  ai.reactionDelay = 0.18 + (ai.sampleCount % 4).toFloat() * 0.025
}

func paddleAiSystem(
  ai: mod AIState
  ballPosition: view PaddleTransform
  ballVelocity: view Velocity
  paddleY: copy Float
  dt: view Float
) ret Float {
  ai.reactionTimer = ai.reactionTimer + dt
  if ai.reactionTimer >= ai.reactionDelay {
    ai.reactionTimer = 0.0
    updateAiTarget(
      ai: ai, ballX: ballPosition.x, ballY: ballPosition.y
      ballVelocity: ballVelocity)
  }

  let speed: Float = 285.0
  let acceleration: Float = 950.0
  let deadZone: Float = 8.0
  let distance: Float = ai.targetY - paddleY
  var desiredVelocity: Float = 0.0
  if distance > deadZone { desiredVelocity = speed }
  if distance < 0.0 - deadZone { desiredVelocity = 0.0 - speed }

  let velocityStep: Float = acceleration * dt
  if ai.velocityY < desiredVelocity {
    ai.velocityY = ai.velocityY + velocityStep
    if ai.velocityY > desiredVelocity { ai.velocityY = desiredVelocity }
  }
  if ai.velocityY > desiredVelocity {
    ai.velocityY = ai.velocityY - velocityStep
    if ai.velocityY < desiredVelocity { ai.velocityY = desiredVelocity }
  }

  paddleY = paddleY + ai.velocityY * dt
  if paddleY < 0.0 {
    paddleY = 0.0
    ai.velocityY = 0.0
  }
  if paddleY > fieldH - paddleH {
    paddleY = fieldH - paddleH
    ai.velocityY = 0.0
  }
  ret paddleY
}
