pack PongImplicit {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Pong"
  description: "A playable Pong in the data-oriented style Rae encourages: plain component types, systems that are ordinary functions over them, and no framework in between. Two paddles, an AI opponent, and collision — small enough to read in one sitting."
  featured: "true"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
