pack MetaballsDeferred {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Metaballs (deferred rendering)"
  description: "A WebGPU PBR renderer with three authored .raescene 3D worlds and a persistent ECS UI. Demonstrates stable mesh/material keys, SDF metaballs, UI-priority input, typed narrow state refresh, MSDF text and icons, and one native or browser present."
  category: "3D Renderer"
  featured: "true"
  wasmWebApp: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: { source: { path: ".", emit: compiled } }
    }
    target wasm: {
      label: "WASM (WebGPU)"
      entry: "main.rae"
      sources: { source: { path: ".", emit: compiled } }
    }
  }
}
