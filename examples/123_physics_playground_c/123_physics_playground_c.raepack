pack PhysicsPlaygroundC {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Physics Playground — Box3D's C library"
  description: "The same six physics scenes as the ported playground (122), on upstream Box3D's C library through Rae's generated bindings: a box pyramid of 1k-10k bodies, dominoes, a hinged bridge with a hanging chain, welded towers, balls rolling over a mesh and a character walking a terrain. Fly with WASD/Q/E and look with a right drag. Hold the left button or F to fire balls like a machine gun, or press T for autofire; a bounded ECS pool despawns old balls. Box3D runs on its own threads. Both playgrounds share every file but their physics adapter and print the same determinism hashes, so the two tracks can be compared side by side."
  category: "Physics"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
