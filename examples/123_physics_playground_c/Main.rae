# The physics playground's entry (docs/physics-two-implementations.md §3).
# The same file in both playgrounds: 122_physics_playground_port runs it on
# the Rae port of Box3D, 123_physics_playground_c on upstream Box3D's C
# library. The track is whichever SceneSpawn.rae sits beside this file, the
# one file of an example that names its physics track; everything else is the
# shared package lib/physicsScenes - the six scenes, the HUD, the instanced
# renderer and the window loop (PlaygroundApp).
#
# Controls: WASD flies, Q/E go down/up (Shift fast, Control slow), a right
# drag looks around; holding the left button or F fires balls like a machine
# gun at what the pointer is over, T toggles autofire; keys 1-6 switch scenes,
# R resets, the slider sizes the pyramid (1k-10k bodies). The balls live in a
# BallPool: the oldest go past its capacity, and any that live 20 s, fly far
# off or fall off the ground are despawned. An FPS meter sits top right. When
# every body sleeps and nothing is pressed the loop waits for events instead
# of rendering, and it never renders hidden.
#
#   RAE_PHYSICS_DETERMINISM=<steps>  headless: every scene stepped <steps>
#                                    fixed steps at 1 worker and at the pool's
#                                    worker count; prints both transform
#                                    hashes (the example gate's determinism
#                                    print); exits 1 when they differ
#   RAE_PLAYGROUND_SCRIPTED=1        headless: a scripted run through every
#                                    scene, printing the HUD's lines
# The window's settings (scene, body count, autofire, scene cycle, debug log)
# are listed in lib/physicsScenes/PlaygroundApp.rae.
# Headless screenshot, from the repository root:
#   RAE_SDL_HEADLESS_MS=3000 RAE_GPU2D_SCREENSHOT=/tmp/playground.bmp \
#     rae run examples/<this example>/Main.rae
import Sys
import Gpu2d
import Parallel
open Vec3
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open physicsScenes/PoseBlend
open RendererDeferred
open Rendergraph
open ui/Ecs
open ui/UiSystems
open physicsScenes/SceneTypes
open physicsScenes/SceneLibrary
open physicsScenes/SceneHud
open physicsScenes/BallPool
open physicsScenes/PlaygroundApp

# PhysicsScene `index` stepped `steps` fixed steps at `workerCount` workers: the
# transform hash.
func sceneHash(index: view Int, steps: view Int, workerCount: view Int) ret UInt64 {
  var world: PlaygroundWorld = createPlaygroundWorld(workerCount: workerCount)
  spawnScene(world: world, scene: buildScene(index: index, bodyCount: defaultPlaygroundBodyCount))
  loop var step: Int = 0, step < steps, ++step {
    if step is steps / 2 {
      let ballId: EntityId = throwBallAlong(
        world: world
        origin: Vec3 { x: -12.0, y: -12.0, z: 8.0 }
        direction: Vec3 { x: 0.6, y: 0.6, z: -0.3 }
      )
    }
    let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
  }
  let hash: UInt64 = transformHash(transforms: world.transforms)
  destroyPlaygroundWorld(world: world)
  ret hash
}

func determinismRun(steps: view Int) ret Int {
  let workers: Int = Parallel.workerCount()
  var mismatches: Int = 0
  loop var index: Int = 0, index < sceneCount, ++index {
    let single: UInt64 = sceneHash(index: index, steps: steps, workerCount: 1)
    let many: UInt64 = sceneHash(index: index, steps: steps, workerCount: workers)
    let same: Bool = single is many
    if same is false {
      mismatches = mismatches + 1
    }
    log(
      "{trackName} {sceneName(index: index)}: {steps} steps, hash {single} at 1 worker, {many} at {workers}, identical {same}"
    )
  }
  log("determinism: {mismatches} scenes differ")
  ret mismatches
}

func scriptedRun() {
  loop var index: Int = 0, index < sceneCount, ++index {
    var world: PlaygroundWorld = createPlaygroundWorld(workerCount: Parallel.workerCount())
    let scene: PhysicsScene = buildScene(index: index, bodyCount: defaultPlaygroundBodyCount)
    spawnScene(world: world, scene: scene)
    var stepWindow: TimingWindow = createTimingWindow()
    var frameWindow: TimingWindow = createTimingWindow()
    var time: Float = 0.0
    loop var frame: Int = 0, frame < 120, ++frame {
      if frame is 30 {
        let ballId: EntityId = throwBallAlong(
          world: world
          origin: vadd(a: scene.cameraTarget, b: Vec3 { x: -10.0, y: -10.0, z: 6.0 })
          direction: Vec3 { x: 0.6, y: 0.6, z: -0.4 }
        )
      }
      let started: Int = nowNs()
      let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
      let elapsed: Float = ((nowNs() - started) as Float) / 1000000.0
      time = time + 1.0 / 60.0
      addTimingSample(window: stepWindow, milliseconds: elapsed, now: time)
      addTimingSample(window: frameWindow, milliseconds: elapsed, now: time)
    }
    let lines: List(String) = hudLines(
      stats: playgroundStats(
        world: world
        sceneName: scene.name
        targetBodyCount: defaultPlaygroundBodyCount
      )
      step: stepWindow
      frame: frameWindow
    )
    loop let line: view String in lines {
      log(line)
    }
    destroyPlaygroundWorld(world: world)
  }
}

# The window: the shared PlaygroundApp does the frame; this loop makes the
# calls into the track (spawn, step, throw, despawn, counts).
func runWindowed() ret Int {
  openPlaygroundWindow(trackName: trackName)
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  var uiWorld: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  var app: PlaygroundApp = createPlaygroundApp(
    renderer: renderer
    uiWorld: uiWorld
    uiSystems: uiSystems
    assetBase: assetBase
  )
  let workers: Int = Parallel.workerCount()
  var world: PlaygroundWorld = createPlaygroundWorld(workerCount: workers)
  var scene: PhysicsScene = playgroundScene(app: app)
  spawnScene(world: world, scene: scene)
  startPlaygroundScene(app: app, renderer: renderer, scene: scene)
  let graphStatus: Int = compileDeferred(renderer: renderer)
  if graphStatus is not 0 {
    log("deferred graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }
  loop not Gpu2d.pollClose() {
    beginPlaygroundFrame(app: app, uiWorld: uiWorld, uiSystems: uiSystems)
    if readPlaygroundControls(app: app, uiWorld: uiWorld, uiSystems: uiSystems) {
      destroyPlaygroundWorld(world: world)
      if app.cycleSeconds > 0.0 {
        # The memory test's engine check: what the engine still holds with
        # no world alive must be the same at every switch
        log("[playground] engine bytes between worlds {engineByteCount()}")
      }
      world = createPlaygroundWorld(workerCount: workers)
      scene = playgroundScene(app: app)
      spawnScene(world: world, scene: scene)
      startPlaygroundScene(app: app, renderer: renderer, scene: scene)
    }
    updatePlaygroundCamera(app: app)
    loop let direction: view Vec3 in playgroundShots(app: app) {
      let ballId: EntityId = throwBallAlong(
        world: world
        origin: shotOrigin(app: app, direction: direction)
        direction: direction
      )
      addPooledBall(pool: app.balls, entityId: ballId, now: app.clock)
    }
    loop let ballId: view EntityId in retirePlaygroundBalls(app: app, transforms: world.transforms) {
      despawnBall(world: world, entityId: ballId)
    }
    var steps: Int = 0
    if playgroundShouldStep(app: app, awakeCount: playgroundAwakeCount(world: world)) {
      let started: Int = nowNs()
      steps = stepPlayground(world: world, frameTime: app.deltaTime)
      recordPlaygroundStep(app: app, startedNs: started, steps: steps)
    } else {
      settlePlaygroundPoses(world: world)
    }
    # Draw the poses between the last two fixed steps, so motion is smooth
    # however the frames and the steps fall
    let shown: ComponentTable(Transform3D) = interpolatedTransforms(
      previous: world.previousTransforms
      current: world.transforms
      blend: playgroundBlend(world: world)
    )
    logPlaygroundFrame(app: app, shown: shown, steps: steps)
    let hudChanged: Bool = updatePlaygroundHud(
      app: app
      uiWorld: uiWorld
      uiSystems: uiSystems
      stats: playgroundStats(world: world, sceneName: app.sceneName, targetBodyCount: app.bodyCount)
    )
    finishPlaygroundFrame(
      app: app
      renderer: renderer
      uiWorld: uiWorld
      uiSystems: uiSystems
      renderShapes: world.renderShapes
      transforms: shown
      awakeCount: playgroundAwakeCount(world: world)
      hudChanged: hudChanged
    )
  }
  destroyPlaygroundWorld(world: world)
  closePlaygroundWindow(renderer: renderer)
  ret 0
}

func main() ret Int {
  let steps: String = Sys.getEnv(name: "RAE_PHYSICS_DETERMINISM")
  if steps.length() > 0 {
    if determinismRun(steps: steps.toInt()) > 0 {
      ret 1
    }
    ret 0
  }
  if Sys.getEnv(name: "RAE_PLAYGROUND_SCRIPTED").length() > 0 {
    scriptedRun()
    ret 0
  }
  ret runWindowed()
}
