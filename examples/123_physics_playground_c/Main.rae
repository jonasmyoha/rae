# The physics playground's entry (docs/physics-two-implementations.md §3).
# The same file in both playgrounds: 123_physics_playground_c runs it on
# upstream Box3D's C library, Rae's physics engine, and
# 122_physics_playground_port on the Rae port of Box3D, a frozen reference
# (docs/physics-two-implementations.md §7). The track is whichever
# SceneSpawn.rae sits beside this file, the one file of an example that names
# its physics track; everything else is the shared package lib/physicsScenes -
# the six scenes, the HUD, the instanced renderer and the window loop
# (PlaygroundApp).
#
# Controls: WASD flies, Q/E go down/up (Shift fast, Control slow), a right
# drag looks around; holding the left button or F fires balls like a machine
# gun at what the pointer is over, T toggles autofire; keys 1-6 switch scenes,
# R resets, the slider sizes the pyramid (1k-10k bodies). The balls live in a
# BallPool: the oldest go past its capacity, and any that live 20 s, fly far
# off or fall off the ground are despawned. An FPS meter sits top right. When
# every body sleeps and nothing is pressed the loop waits for events instead
# of rendering, and it never renders hidden.
#
#   RAE_PHYSICS_DETERMINISM=<steps>  headless: every scene stepped <steps>
#                                    fixed steps at 1 worker and at the pool's
#                                    worker count; prints both transform
#                                    hashes (the example gate's determinism
#                                    print); exits 1 when they differ
#   RAE_PLAYGROUND_SCRIPTED=1        headless: a scripted run through every
#                                    scene, printing the HUD's lines
#   RAE_PLAYGROUND_SCALING=<counts>  headless: the pyramid at each body count
#                                    (comma-separated) stepped at the world's
#                                    worker count (the pool's, RAE_WORKERS);
#                                    one SCALING line per count with the mean
#                                    and median step ms
#                                    (benchmarks/physics_scaling)
#   RAE_PLAYGROUND_SPAWN=<bodies>    headless: the pyramid at <bodies>
#                                    spawned at once into a fresh world; one
#                                    SPAWN line with the spawn's and the first
#                                    steps' ms and allocations against a
#                                    steady step, and one ALLOC line with the
#                                    allocations of 120 steady steps (0 is the
#                                    goal: docs/physics-performance-plan.md
#                                    §10h)
# The window's settings (scene, body count, autofire, scene cycle, debug log)
# are listed in lib/physicsScenes/PlaygroundApp.rae.
# Headless screenshot, from the repository root:
#   RAE_SDL_HEADLESS_MS=3000 RAE_GPU2D_SCREENSHOT=/tmp/playground.bmp \
#     rae run examples/<this example>/Main.rae
import Sys
import Gpu2d
import Parallel
open Vec3
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open physicsScenes/PoseBlend
open RendererDeferred
open Rendergraph
open ui/Ecs
open ui/UiSystems
open physicsScenes/SceneTypes
open physicsScenes/SceneLibrary
open physicsScenes/SceneHud
open physicsScenes/BallPool
open physicsScenes/PlaygroundApp
open physicsScenes/FrameProfile

# PhysicsScene `index` stepped `steps` fixed steps at `workerCount` workers: the
# transform hash.
func sceneHash(index: view Int, steps: view Int, workerCount: view Int) ret UInt64 {
  var world: PlaygroundWorld = createPlaygroundWorld(workerCount: workerCount)
  spawnScene(world: world, scene: buildScene(index: index, bodyCount: defaultPlaygroundBodyCount))
  loop var step: Int = 0, step < steps, ++step {
    if step is steps / 2 {
      let ballId: EntityId = throwBallAlong(
        world: world
        origin: Vec3 { x: -12.0, y: -12.0, z: 8.0 }
        direction: Vec3 { x: 0.6, y: 0.6, z: -0.3 }
      )
    }
    let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
  }
  let hash: UInt64 = transformHash(transforms: world.transforms)
  destroyPlaygroundWorld(world: world)
  ret hash
}

func determinismRun(steps: view Int) ret Int {
  let workers: Int = Parallel.workerCount()
  var mismatches: Int = 0
  loop var index: Int = 0, index < sceneCount, ++index {
    let single: UInt64 = sceneHash(index: index, steps: steps, workerCount: 1)
    let many: UInt64 = sceneHash(index: index, steps: steps, workerCount: workers)
    let same: Bool = single is many
    if same is false {
      mismatches = mismatches + 1
    }
    log(
      "{trackName} {sceneName(index: index)}: {steps} steps, hash {single} at 1 worker, {many} at {workers}, identical {same}"
    )
  }
  log("determinism: {mismatches} scenes differ")
  ret mismatches
}

func scriptedRun() {
  loop var index: Int = 0, index < sceneCount, ++index {
    var world: PlaygroundWorld = createPlaygroundWorld(workerCount: Parallel.workerCount())
    let scene: PhysicsScene = buildScene(index: index, bodyCount: defaultPlaygroundBodyCount)
    spawnScene(world: world, scene: scene)
    var stepWindow: TimingWindow = createTimingWindow()
    var frameWindow: TimingWindow = createTimingWindow()
    var time: Float = 0.0
    loop var frame: Int = 0, frame < 120, ++frame {
      if frame is 30 {
        let ballId: EntityId = throwBallAlong(
          world: world
          origin: vadd(a: scene.cameraTarget, b: Vec3 { x: -10.0, y: -10.0, z: 6.0 })
          direction: Vec3 { x: 0.6, y: 0.6, z: -0.4 }
        )
      }
      let started: Int = nowNs()
      let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
      let elapsed: Float = ((nowNs() - started) as Float) / 1000000.0
      time = time + 1.0 / 60.0
      addTimingSample(window: stepWindow, milliseconds: elapsed, now: time)
      addTimingSample(window: frameWindow, milliseconds: elapsed, now: time)
    }
    let lines: List(String) = hudLines(
      stats: playgroundStats(
        world: world
        sceneName: scene.name
        targetBodyCount: defaultPlaygroundBodyCount
      )
      step: stepWindow
      frame: frameWindow
    )
    loop let line: view String in lines {
      log(line)
    }
    destroyPlaygroundWorld(world: world)
  }
}

# The scaling benchmark's steps: the first ones settle the freshly built
# pyramid (contacts, islands, the first tree rebuild); the next ones are timed
const scalingWarmupSteps: Int = 20

const scalingTimedSteps: Int = 100

# One SCALING line for the pyramid at `bodyCount` bodies, stepped at 60 Hz by
# `workerCount` workers: the bodies actually built, the mean and median ms per
# fixed step, and the bodies awake at the end (all of them: sleeping is
# turned off, as in Box3D's large-pyramid benchmark).
func scalingCase(bodyCount: view Int, workerCount: view Int) {
  var world: PlaygroundWorld = createPlaygroundWorld(workerCount: workerCount)
  spawnScene(world: world, scene: buildScene(index: 0, bodyCount: bodyCount))
  setPlaygroundSleeping(world: world, enabled: false)
  loop var step: Int = 0, step < scalingWarmupSteps, ++step {
    let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
  }
  var stepMs: List(Float) = List.create(Float, cap: scalingTimedSteps)
  var totalMs: Float = 0.0
  loop var step: Int = 0, step < scalingTimedSteps, ++step {
    let started: Int = nowNs()
    let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
    let elapsed: Float = ((nowNs() - started) as Float) / 1000000.0
    if taken > 0 {
      let perStep: Float = elapsed / (taken as Float)
      stepMs.add(value: perStep)
      totalMs = totalMs + perStep
    }
  }
  stepMs.sort()
  let median: Float = stepMs.copyAtDefault(index: stepMs.length / 2)
  let mean: Float = totalMs / (stepMs.length as Float)
  let stats: HudStats = playgroundStats(
    world: world
    sceneName: "pyramid"
    targetBodyCount: bodyCount
  )
  log(
    "SCALING,{trackName},{bodyCount},{workerCount},{stats.bodyCount},{mean},{median},{stats.awakeBodyCount}"
  )
  destroyPlaygroundWorld(world: world)
}

# One step of `world`: its ms.
func timedStep(world: mod PlaygroundWorld) ret Float {
  let started: Int = nowNs()
  let taken: Int = stepPlayground(world: world, frameTime: 1.0 / 60.0)
  ret ((nowNs() - started) as Float) / 1000000.0
}

# The spawn hitch and the steady step's allocations, at `bodyCount` bodies
# (sleeping off, so every body stays awake and every step does full work).
func spawnCheck(bodyCount: view Int) {
  var world: PlaygroundWorld = createPlaygroundWorld(workerCount: Parallel.workerCount())
  setPlaygroundSleeping(world: world, enabled: false)
  let scene: PhysicsScene = buildScene(index: 0, bodyCount: bodyCount)
  let spawnAllocations: Int = Sys.allocationCount()
  let spawnStarted: Int = nowNs()
  spawnScene(world: world, scene: scene)
  let spawnMs: Float = ((nowNs() - spawnStarted) as Float) / 1000000.0
  let firstAllocations: Int = Sys.allocationCount()
  let firstMs: Float = timedStep(world: world)
  let secondMs: Float = timedStep(world: world)
  let thirdMs: Float = timedStep(world: world)
  let afterFirst: Int = Sys.allocationCount()
  loop var step: Int = 3, step < 120, ++step {
    let warmMs: Float = timedStep(world: world)
  }
  var steadyMs: List(Float) = List.create(Float, cap: 120)
  let steadyAllocations: Int = Sys.allocationCount()
  loop var step: Int = 0, step < 120, ++step {
    steadyMs.add(value: timedStep(world: world))
  }
  let steadyAllocated: Int = Sys.allocationCount() - steadyAllocations
  steadyMs.sort()
  let median: Float = steadyMs.copyAtDefault(index: steadyMs.length / 2)
  log(
    "SPAWN,{trackName},{bodyCount},spawn {spawnMs} ms ({firstAllocations - spawnAllocations} allocations),first steps {firstMs} {secondMs} {thirdMs} ms ({afterFirst - firstAllocations} allocations),steady median {median} ms"
  )
  log("ALLOC,{trackName},{bodyCount},120 steady steps,{steadyAllocated} allocations")
  destroyPlaygroundWorld(world: world)
}

func scalingRun(counts: view String) {
  let workers: Int = Parallel.workerCount()
  let items: List(String) = counts.split(sep: ",")
  loop let item: view String in items {
    if item.length() > 0 {
      scalingCase(bodyCount: item.toInt(), workerCount: workers)
    }
  }
}

# Everything the window keeps between frames, owned in one value that main's
# mainLoop advances once per frame (docs/web-frame-loop.md). In a browser the
# page runs the loop's body on each animation frame; natively it is a plain
# loop.
type PlaygroundState {
  renderer: DeferredRenderer
  uiWorld: UiWorld
  uiSystems: UiSystems
  app: PlaygroundApp
  world: PlaygroundWorld
  scene: PhysicsScene
  workers: Int
}

# The window, the renderer, the UI and the first scene's world.
func createPlayground() ret PlaygroundState {
  openPlaygroundWindow(trackName: trackName)
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  var uiWorld: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  var app: PlaygroundApp = createPlaygroundApp(
    renderer: renderer
    uiWorld: uiWorld
    uiSystems: uiSystems
    assetBase: assetBase
  )
  let workers: Int = Parallel.workerCount()
  var world: PlaygroundWorld = createPlaygroundWorld(workerCount: workers)
  var scene: PhysicsScene = playgroundScene(app: app)
  spawnScene(world: world, scene: scene)
  startPlaygroundScene(app: app, renderer: renderer, scene: scene)
  # The state takes the renderer's GPU handles with it: moved, never copied
  unsafe {
    ret PlaygroundState {
      renderer: own renderer
      uiWorld: own uiWorld
      uiSystems: own uiSystems
      app: own app
      world: own world
      scene: own scene
      workers: workers
    }
  }
}

# Leaves the window: the world and the window go.
func endPlayground(state: mod PlaygroundState) {
  destroyPlaygroundWorld(world: state.world)
  closePlaygroundWindow(renderer: state.renderer)
}

# One frame: the shared PlaygroundApp does the frame; this makes the calls
# into the track (spawn, step, throw, despawn, counts). False once the profile
# run has its report.
func runPlaygroundFrame(state: mod PlaygroundState) ret Bool {
  profileFrameStart(profile: state.app.profile)
  beginPlaygroundFrame(app: state.app, uiWorld: state.uiWorld, uiSystems: state.uiSystems)
  if readPlaygroundControls(app: state.app, uiWorld: state.uiWorld, uiSystems: state.uiSystems) {
    destroyPlaygroundWorld(world: state.world)
    if state.app.cycleSeconds > 0.0 {
      # The memory test's engine check: what the engine still holds with
      # no world alive must be the same at every switch
      log("[playground] engine bytes between worlds {engineByteCount()}")
    }
    state.world = createPlaygroundWorld(workerCount: state.workers)
    state.scene = playgroundScene(app: state.app)
    spawnScene(world: state.world, scene: state.scene)
    startPlaygroundScene(app: state.app, renderer: state.renderer, scene: state.scene)
  }
  updatePlaygroundCamera(app: state.app)
  profileLap(profile: state.app.profile, section: profileInput)
  loop let direction: view Vec3 in playgroundShots(app: state.app) {
    let ballId: EntityId = throwBallAlong(
      world: state.world
      origin: shotOrigin(app: state.app, direction: direction)
      direction: direction
    )
    addPooledBall(pool: state.app.balls, entityId: ballId, now: state.app.clock)
  }
  loop let ballId: view EntityId in retirePlaygroundBalls(
    app: state.app
    transforms: state.world.transforms
  ) {
    despawnBall(world: state.world, entityId: ballId)
  }
  profileLap(profile: state.app.profile, section: profileShots)
  var steps: Int = 0
  if playgroundShouldStep(app: state.app, awakeCount: playgroundAwakeCount(world: state.world)) {
    let started: Int = nowNs()
    steps = stepPlaygroundProfiled(
      world: state.world
      frameTime: state.app.deltaTime
      profile: state.app.profile
    )
    recordPlaygroundStep(app: state.app, startedNs: started, steps: steps)
  } else {
    settlePlaygroundPoses(world: state.world)
    profileLap(profile: state.app.profile, section: profileCopyPrevious)
  }
  # Draw the poses between the last two fixed steps, so motion is smooth
  # however the frames and the steps fall
  let shown: ComponentTable(Transform3D) = interpolatedTransforms(
    previous: state.world.previousTransforms
    current: state.world.transforms
    blend: playgroundBlend(world: state.world)
  )
  profileLap(profile: state.app.profile, section: profileInterpolate)
  logPlaygroundFrame(app: state.app, shown: shown, steps: steps)
  let hudChanged: Bool = updatePlaygroundHud(
    app: state.app
    uiWorld: state.uiWorld
    uiSystems: state.uiSystems
    stats: playgroundStats(
      world: state.world
      sceneName: state.app.sceneName
      targetBodyCount: state.app.bodyCount
    )
  )
  profileLap(profile: state.app.profile, section: profileHud)
  finishPlaygroundFrame(
    app: state.app
    renderer: state.renderer
    uiWorld: state.uiWorld
    uiSystems: state.uiSystems
    renderShapes: state.world.renderShapes
    transforms: shown
    awakeCount: playgroundAwakeCount(world: state.world)
    hudChanged: hudChanged
  )
  if profileFrameEnd(profile: state.app.profile, section: profileFrameEnd) {
    ret false
  }
  ret true
}

func main() ret Int {
  let steps: String = Sys.getEnv(name: "RAE_PHYSICS_DETERMINISM")
  if steps.length() > 0 {
    if determinismRun(steps: steps.toInt()) > 0 {
      ret 1
    }
    ret 0
  }
  let scalingCounts: String = Sys.getEnv(name: "RAE_PLAYGROUND_SCALING")
  if scalingCounts.length() > 0 {
    scalingRun(counts: scalingCounts)
    ret 0
  }
  let spawnBodies: String = Sys.getEnv(name: "RAE_PLAYGROUND_SPAWN")
  if spawnBodies.length() > 0 {
    spawnCheck(bodyCount: spawnBodies.toInt())
    ret 0
  }
  if Sys.getEnv(name: "RAE_PLAYGROUND_SCRIPTED").length() > 0 {
    scriptedRun()
    ret 0
  }
  var state: PlaygroundState = createPlayground()
  let graphStatus: Int = compileDeferred(renderer: state.renderer)
  if graphStatus is not 0 {
    log("deferred graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }
  mainLoop state {
    if Gpu2d.pollClose() {
      endPlayground(state: state)
      break
    }
    if runPlaygroundFrame(state: state) is false {
      endPlayground(state: state)
      break
    }
  }
  ret 0
}
