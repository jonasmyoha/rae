# Focused 2D easing demo on Rae's GPU2D/SDL3 stack.
import core
import easing
import gpu2d
import sys
import ui/ecs
import ui/RenderSystem/RenderSystem
import app3d/ui_shell
open app3d/ui_shell
open ui/ecs
open ui/RenderSystem/RenderSystem

const canvasW: Float = 800.0
const canvasH: Float = 450.0

func main() ret Int {
  gpu2d.initWindow(width: canvasW.toInt(), height: canvasH.toInt(), title: "Rae Easing 2D — GPU2D")
  gpu2d.setDesignResolution(width: canvasW, height: canvasH, fit: 0)

  # The shared font/theme fixture keeps this example small; its authored UI is
  # still local and exercises the same .raescene ECS path as larger apps.
  let uiResources: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: ""
    themeFile: "theme.raescene"
  )
  var world: UiWorld = createUiWorld()
  let uiRoot: EntityId = mountUiScene(
    world: world
    path: "examples/95_easing_2d/assets/ui.raescene"
    res: uiResources
  )

  let duration: Float = 2.0
  var cycleStart: Float64 = gpu2d.nowSeconds()
  let fixedTestFrame: Bool = getEnv(name: "RAE_EASING_TEST_FRAME").length() > 0

  loop not gpu2d.pollClose() {
    let resized: Bool = resizeUiToWindow(world: world, res: uiResources)
    var elapsed: Float = (gpu2d.nowSeconds() - cycleStart) as Float
    if fixedTestFrame {
      elapsed = 1.0
    } else {
      if elapsed > duration {
        cycleStart = gpu2d.nowSeconds()
        elapsed = 0.0
      }
    }

    let phase: Float = elapsed / duration
    let eased: Float = easing.easeInOutQuad(t: phase)
    let currentX: Float = 150.0 + 500.0 * eased
    let huePhase: Int = (phase * 5.0).toInt()
    var ballColor: Int = 0xFF42A5F5
    if huePhase is 1 { ballColor = 0xFF26C6DA }
    if huePhase is 2 { ballColor = 0xFF66BB6A }
    if huePhase is 3 { ballColor = 0xFFFFCA28 }
    if huePhase >= 4 { ballColor = 0xFFEC407A }

    gpu2d.beginFrame(r: 0.06, g: 0.09, b: 0.15, a: 1.0)
    gpu2d.drawGradientRect(
      x: 0.0, y: 0.0, w: canvasW, h: canvasH, radius: 0.0
      from: 0xFF141E30, to: 0xFF243B55, angleDeg: 90.0)
    gpu2d.drawRoundedRect(
      x: currentX - 35.0, y: 195.0, w: 80.0, h: 80.0
      radius: 40.0, color: 0x44000000)
    gpu2d.drawGradientRect(
      x: currentX - 40.0, y: 185.0, w: 80.0, h: 80.0
      radius: 40.0, from: 0xFFFFFFFF, to: ballColor, angleDeg: 45.0)
    renderSystemGpu2d(world: world, res: uiResources)
    gpu2d.endFrame()
  }

  gpu2d.closeWindow()
  ret 0
}
