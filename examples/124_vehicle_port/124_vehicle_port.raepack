pack VehiclePort {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Vehicle — Box3D ported to Rae (frozen reference)"
  description: "Frozen reference (docs/physics-two-implementations.md §7): Rae's physics engine is Box3D's C library, and this Rae port of Box3D is kept as a benchmark and kept compiling, but it does not follow upstream. It drives the same car and course as 125_vehicle_c, step for step: Box3D's Driving sample with suspension, steering, spin motors and a keep-upright joint, on a height-field course with ramps, crates and a stunt park. Chase camera; W/S/A/D to drive, R to respawn, P for the autopilot."
  category: "Physics"
  featured: "false"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
