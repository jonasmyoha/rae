pack VehiclePort {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Vehicle — Box3D ported to Rae"
  description: "Box3D's Driving sample on the Rae port of the Box3D physics engine: a box chassis on four wheel joints with suspension, steering on the front axle, spin motors with the drive torque split between the axles, and a joint keeping it upright, on a height-field course with two ramps to jump and light crates and a wall of blocks to send flying. Chase camera; W/S/A/D to drive, R to respawn, P for an autopilot that takes the jump and tours the hills. Its twin, 125_vehicle_c, runs the same car on Box3D's C library and gives identical results."
  category: "Physics"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
