# glTF character — loading a real skinned model (#356 skinning arc).
#
# Renders the mesh of a 39-joint glTF character loaded from .glb at
# runtime, in its BIND POSE. The skin and its Mat3x4 palette come next,
# then animation; this increment proves the loader reads real exported
# geometry correctly, which is the thing skinning has to stand on.
#
# WHY BIND POSE FIRST. A skinned mesh in bind pose is exactly the mesh
# glTF stores — no joint transforms applied. So if this renders correctly,
# positions, normals, UVs and the index buffer are all being read right,
# and any later breakage is attributable to the skinning maths rather than
# to the loader. Skipping this step means debugging both at once.
#
# THE MODEL. `assets/character.glb` is the Khronos Fox sample — CC0 model,
# CC-BY rigging — with its licence recorded in assets/ATTRIBUTION.md. It
# was chosen for being clearly licensed AND for being awkward: it ships no
# NORMAL attribute and no index buffer, so it exercises the spec's
# flat-normal generation and the non-indexed path rather than the easy
# case every exporter produces. Any rigged .glb can replace it.
#
# The model is Y-up (glTF's convention); Rae is Z-up
# (docs/coordinate-system.md), so the transform below rotates it. It is
# also authored at roughly 80 units tall, hence the scale.
#
# Compiled-target only; needs wgpu-native + SDL3.
#   rae run --target compiled main.rae
# Headless screenshot:
#   RAE_SDL_HEADLESS_MS=1000 RAE_GPU2D_SCREENSHOT=/tmp/char.bmp \
#     rae run --target compiled main.rae
import Math
import Gpu2d
import Vec3
import Gltf
import ecs/Entity
open Scene3d
open ecs/Entity
open Gpu3d
open Renderer3d
open Rendergraph
open Math3d
open Mesh3d
open Gltf

func uploadMeshData(m: view MeshData) ret MeshHandle {
  ret uploadMesh(verts: m.verts, vertCount: m.vertCount, indices: m.indices)
}

func main() ret Int {
  Gpu2d.initWindow(width: 1280, height: 800, title: "Rae 3D — glTF character (bind pose)")

  let g: Glb = loadGlb(path: "examples/113_gltf_character/assets/character.glb")
  if g.ok is false {
    log("[gltf] {g.errorMsg}")
    log("[gltf] expected a rigged .glb at assets/character.glb — see assets/ATTRIBUTION.md")
    Gpu2d.closeWindow()
    ret 1
  }
  let charData: MeshData = loadPrimitive(g: g, meshIndex: 0, primIndex: 0)
  if charData.vertCount is 0 {
    log("[gltf] primitive had no POSITION accessor")
    Gpu2d.closeWindow()
    ret 1
  }
  log("[gltf] character: {charData.vertCount} verts, {charData.indices.length / 3} triangles")

  let planeData: MeshData = makePlane(size: 20.0, segments: 1)
  let character: MeshHandle = uploadMeshData(m: charData)
  let ground: MeshHandle = uploadMeshData(m: planeData)

  var sceneWorld: World3d = createWorld3d()
  let noEmit: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRot: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)

  let skinMat: Material3d = { baseColor: Vec3.create(x: 0.78, y: 0.66, z: 0.58), metallic: 0.0, roughness: 0.62, emission: noEmit, toon: false }
  # glTF is Y-up; Rae is Z-up, so a +90 degree turn about X maps one to
  # the other. The Fox is authored ~80 units tall, so it is scaled to
  # share a scene with a 20-unit ground plane rather than dwarfing it.
  let modelScale: Float = 0.025
  let charE: EntityId = world3dAddMeshInstance(
    world: sceneWorld, mesh: character, material: skinMat,
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0 - 1.0),
    rotation: Vec3.create(x: 1.5707963, y: 0.0, z: 0.0),
    scale: Vec3.create(x: modelScale, y: modelScale, z: modelScale)
  )

  let groundMat: Material3d = { baseColor: Vec3.create(x: 0.40, y: 0.41, z: 0.43), metallic: 0.0, roughness: 0.9, emission: noEmit, toon: false }
  let groundE: EntityId = world3dAddMeshInstance(
    world: sceneWorld, mesh: ground, material: groundMat,
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0 - 1.0), rotation: noRot,
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )

  var camera: Camera3d = defaultCamera3d()
  var light: Light3d = defaultLight3d()
  # Aim at the character's midriff rather than the origin under its
  # feet, so it sits centred in frame instead of low in it.
  camera.target = Vec3.create(x: 0.0, y: 0.0, z: 0.0 - 0.25)

  var renderer: Renderer3d = createRenderer3d()
  let gs: Int = compileRenderer(r: renderer)
  if gs is not 0 {
    log("render graph invalid: {statusName(status: gs)}")
    Gpu2d.closeWindow()
    ret 1
  }

  # Three-quarter view: head-on hides the silhouette that makes the
  # flat-shaded faceting legible.
  var yaw: Float = 0.9
  var pitch: Float = 0.30
  var dist: Float = 4.0
  var lastX: Float = 0.0
  var lastY: Float = 0.0
  var dragging: Bool = false
  let startT: Float64 = Gpu2d.nowSeconds()

  loop not Gpu2d.pollClose() {
    let px: Float = Gpu2d.pointerX()
    let py: Float = Gpu2d.pointerY()
    if Gpu2d.pointerDown() {
      if dragging {
        yaw = yaw + (px - lastX) * 0.008
        pitch = pitch - (py - lastY) * 0.008
        if pitch > 1.45 {
          pitch = 1.45
        }
        if pitch < 0.0 - 1.45 {
          pitch = 0.0 - 1.45
        }
      }
      dragging = true
    } else {
      dragging = false
    }
    lastX = px
    lastY = py
    dist = dist - Gpu2d.wheelMove() * 0.4
    if dist < 1.5 {
      dist = 1.5
    }
    if dist > 20.0 {
      dist = 20.0
    }

    let t: Float = (Gpu2d.nowSeconds() - startT) as Float
    camera.position = orbitEye(targetX: camera.target.x, targetY: camera.target.y, targetZ: camera.target.z, yaw: yaw, pitch: pitch, dist: dist)
    let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
    if Gpu2d.renderGate() {
      renderFrameWorld(r: renderer, world: sceneWorld, camera: camera, light: light, aspect: aspect, time: t)
      world3dPrevTransformSystem(world: sceneWorld)
    }
  }
  shutdown()
  Gpu2d.closeWindow()
  ret 0
}
