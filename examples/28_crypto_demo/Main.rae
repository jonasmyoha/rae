# lib/crypto in one walk: hash a password with Argon2id, use the hash as a
# key to lock a message with XChaCha20-Poly1305 (a fresh random nonce), unlock
# it, and see a changed message refused; then sign with Ed25519 and take a
# BLAKE2b content hash.
open crypto/CryptoBytes
open crypto/CryptoRandom
open crypto/Argon2
open crypto/Aead
open crypto/Ed25519
open crypto/Blake2b

func main() {
  log("1. Hashing a password with Argon2id...")
  let salt: List(UInt8) = cryptoRandomBytes(count: 16)
  # a light setting for a demo; argon2DefaultSettings() is 64 MiB
  let settings: Argon2Settings = {
    algorithm: Argon2Algorithm.argon2id
    memoryKiB: 1024
    passes: 3
    lanes: 1
  }
  let key: List(UInt8) = argon2Hash(
    password: bytesOfText(text: "password123")
    salt: salt
    settings: settings
    hashSize: 32
    key: List.create(UInt8, cap: 0)
    associatedData: List.create(UInt8, cap: 0)
  )
  log("   key: {key.length} bytes")

  log("2. Locking a message...")
  let nonce: List(UInt8) = cryptoRandomBytes(count: 24)
  let message: List(UInt8) = bytesOfText(text: "ABC")
  let sealed: AeadSealed = aeadLock(
    key: key
    nonce: nonce
    plainText: message
    associatedData: List.create(UInt8, cap: 0)
  )
  log("   cipher text {hexOfBytes(bytes: sealed.cipherText)}, mac {sealed.mac.length} bytes")

  log("3. Unlocking it...")
  if let opened: List(UInt8) = aeadUnlock(
    key: key
    nonce: nonce
    sealed: sealed
    associatedData: List.create(UInt8, cap: 0)
  ) {
    log("   recovered: {hexOfBytes(bytes: opened)} (the same: {bytesEqual(a: opened, b: message)})")
  } else {
    log("   ERROR: it did not unlock")
  }
  var changed: AeadSealed = {
    cipherText: copyBytes(bytes: sealed.cipherText)
    mac: copyBytes(bytes: sealed.mac)
  }
  changed.cipherText.set(index: 0, value: 0)
  log("   a changed message unlocks: {aeadUnlock(
    key: key
    nonce: nonce
    sealed: changed
    associatedData: List.create(UInt8, cap: 0)
  ) is not none}")

  log("4. Signing with Ed25519...")
  let pair: Ed25519KeyPair = ed25519NewKeyPair()
  let document: List(UInt8) = bytesOfText(text: "device sign-in")
  let signature: List(UInt8) = ed25519Sign(secretKey: pair.secretKey, message: document)
  log(
    "   verifies: {ed25519Verify(signature: signature, publicKey: pair.publicKey, message: document)}"
  )

  log("5. A BLAKE2b content hash:")
  log("   {hexOfBytes(bytes: blake2b(message: document, hashSize: 32))}")
}
