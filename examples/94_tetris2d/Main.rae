import Gpu2d
import Sdl3
import Keys
import Sys
open app3d/UiShell
open Math
open ui/Ecs
open ui/DebugOverlay
open ui/renderSystem/RenderSystem

const canvasW: Float = 800.0
const canvasH: Float = 600.0

enum GameState { menu, playing, paused, gameOver }

enum TetrominoKind {
  i
  j
  l
  o
  s
  t
  z
}

type Position {
  x: Int
  y: Int
}

type Piece {
  kind: TetrominoKind
  pos: Position
  rotation: Int
}

# 0-3
type Game {
  state: GameState
  grid: List(Int)
  width: Int
  height: Int
  currentPiece: Piece
  nextPieceKind: TetrominoKind
  score: Int
  lines: Int
  level: Int
  moveTimer: Int
  moveDelay: Int
  hMoveTimer: Int
  hMoveDelay: Int
  dasDelay: Int
  lockTimer: Int
  lockDelay: Int
  maxLockTimer: Int
}

func getModernColor(index: view Int) ret Int {
  # I - Cyan
  if index is 1 {
    ret 0xFF64E6FF
  }
  # J - Blue
  if index is 2 {
    ret 0xFF78A0FF
  }
  # L - Orange
  if index is 3 {
    ret 0xFFFFB478
  }
  # O - Yellow
  if index is 4 {
    ret 0xFFFFE678
  }
  # S - Green
  if index is 5 {
    ret 0xFF78FFA0
  }
  # T - Purple
  if index is 6 {
    ret 0xFFC8A0FF
  }
  # Z - Red
  if index is 7 {
    ret 0xFFFF788C
  }
  # Empty
  ret 0xFF282832
}

func getKindId(kind: TetrominoKind) ret Int {
  if kind is TetrominoKind.i {
    ret 1
  }
  if kind is TetrominoKind.j {
    ret 2
  }
  if kind is TetrominoKind.l {
    ret 3
  }
  if kind is TetrominoKind.o {
    ret 4
  }
  if kind is TetrominoKind.s {
    ret 5
  }
  if kind is TetrominoKind.t {
    ret 6
  }
  # Z
  ret 7
}

# Returns 1 if cell at (x, y) is occupied or out of bounds
func isOccupied(game: view Game, x: view Int, y: view Int) ret Int {
  if x < 0 or x >= game.width or y >= game.height {
    ret 1
  }
  if y < 0 {
    # Allow pieces above the board
    ret 0
  }
  if let cell: Int = game.grid.copyAt(index: y * game.width + x) {
    if cell > 0 {
      ret 1
    }
  }
  ret 0
}

# Simple shape definitions (4x4 max)
func getShapeCell(kind: TetrominoKind, rot: view Int, px: view Int, py: view Int) ret Int {
  if kind is TetrominoKind.i {
    if rot is 0 or rot is 2 {
      if px is 1 {
        ret 1
      }
    } else {
      if py is 1 {
        ret 1
      }
    }
  } else {
    if kind is TetrominoKind.j {
      if rot is 0 {
        if px is 1 and py >= 0 and py <= 2 or px is 0 and py is 2 {
          ret 1
        }
      } else {
        if rot is 1 {
          if py is 1 and px >= 0 and px <= 2 or px is 0 and py is 0 {
            ret 1
          }
        } else {
          if rot is 2 {
            if px is 1 and py >= 0 and py <= 2 or px is 2 and py is 0 {
              ret 1
            }
          } else {
            if rot is 3 {
              if py is 1 and px >= 0 and px <= 2 or px is 2 and py is 2 {
                ret 1
              }
            }
          }
        }
      }
    } else {
      if kind is TetrominoKind.l {
        if rot is 0 {
          if px is 1 and py >= 0 and py <= 2 or px is 2 and py is 2 {
            ret 1
          }
        } else {
          if rot is 1 {
            if py is 1 and px >= 0 and px <= 2 or px is 0 and py is 2 {
              ret 1
            }
          } else {
            if rot is 2 {
              if px is 1 and py >= 0 and py <= 2 or px is 0 and py is 0 {
                ret 1
              }
            } else {
              if rot is 3 {
                if py is 1 and px >= 0 and px <= 2 or px is 2 and py is 0 {
                  ret 1
                }
              }
            }
          }
        }
      } else {
        if kind is TetrominoKind.o {
          if px >= 1 and px <= 2 and py >= 1 and py <= 2 {
            ret 1
          }
        } else {
          if kind is TetrominoKind.s {
            if rot is 0 or rot is 2 {
              if py is 1 and px >= 1 and px <= 2 or py is 2 and px >= 0 and px <= 1 {
                ret 1
              }
            } else {
              if px is 1 and py >= 0 and py <= 1 or px is 2 and py >= 1 and py <= 2 {
                ret 1
              }
            }
          } else {
            if kind is TetrominoKind.t {
              if rot is 0 {
                if py is 1 and px >= 0 and px <= 2 or px is 1 and py is 0 {
                  ret 1
                }
              } else {
                if rot is 1 {
                  if px is 1 and py >= 0 and py <= 2 or px is 2 and py is 1 {
                    ret 1
                  }
                } else {
                  if rot is 2 {
                    if py is 1 and px >= 0 and px <= 2 or px is 1 and py is 2 {
                      ret 1
                    }
                  } else {
                    if rot is 3 {
                      if px is 1 and py >= 0 and py <= 2 or px is 0 and py is 1 {
                        ret 1
                      }
                    }
                  }
                }
              }
            } else {
              if kind is TetrominoKind.z {
                if rot is 0 or rot is 2 {
                  if py is 1 and px >= 0 and px <= 1 or py is 2 and px >= 1 and px <= 2 {
                    ret 1
                  }
                } else {
                  if px is 1 and py >= 1 and py <= 2 or px is 2 and py >= 0 and py <= 1 {
                    ret 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  ret 0
}

func canMove(game: view Game, dx: view Int, dy: view Int, dr: view Int) ret Int {
  let cp: view Piece => game.currentPiece
  let pos: view Position => cp.pos
  let newX: Int = pos.x + dx
  let newY: Int = pos.y + dy
  var newRot: Int = (cp.rotation + dr) % 4
  if newRot < 0 {
    newRot = newRot + 4
  }
  var py: Int = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: cp.kind, rot: newRot, px: px, py: py) is 1 {
        if isOccupied(game: game, x: newX + px, y: newY + py) is 1 {
          ret 0
        }
      }
      px = px + 1
    }
    py = py + 1
  }
  ret 1
}

func lockPiece(game: mod Game) {
  let cp: mod Piece => game.currentPiece
  let pos: view Position => cp.pos
  let grid: mod List(Int) => game.grid
  let kindId: Int = getKindId(kind: cp.kind)
  var py: Int = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: cp.kind, rot: cp.rotation, px: px, py: py) is 1 {
        let gx: Int = pos.x + px
        let gy: Int = pos.y + py
        if gy >= 0 and gy < game.height {
          grid.set(index: gy * game.width + gx, value: kindId)
        }
      }
      px = px + 1
    }
    py = py + 1
  }
}

func checkLines(game: mod Game) {
  let grid: mod List(Int) => game.grid
  var linesCleared: Int = 0
  var y: Int = game.height - 1
  loop y >= 0 {
    var full: Int = 1
    var x: Int = 0
    loop x < game.width {
      if let cell: Int = grid.copyAt(index: y * game.width + x) {
        if cell is 0 {
          full = 0
        }
      }
      x = x + 1
    }
    if full is 1 {
      linesCleared = linesCleared + 1
      # Shift lines down
      var ty: Int = y
      loop ty > 0 {
        var tx: Int = 0
        loop tx < game.width {
          if let above: Int = grid.copyAt(index: (ty - 1) * game.width + tx) {
            grid.set(index: ty * game.width + tx, value: above)
          }
          tx = tx + 1
        }
        ty = ty - 1
      }
      # Top line is 0
      var tx: Int = 0
      loop tx < game.width {
        grid.set(index: tx, value: 0)
        tx = tx + 1
      }
      # Re-check same line
      y = y + 1
    }
    y = y - 1
  }
  if (linesCleared > 0) {
    game.lines = game.lines + linesCleared
    game.score = game.score + linesCleared * 100 * game.level
    # GEN-Z PROGRESSION: Level up every single line
    let newLevel: Int = game.lines + 1
    if (newLevel > game.level) {
      game.level = newLevel
      # GRADUAL FRANTIC SPEED: 
      # Level 1: ~21 frames, Level 15: 2 frames (Max Speed)
      game.moveDelay = 22 - (game.level * 4 / 3)
      if (game.moveDelay < 2) {
        game.moveDelay = 2
      }
    }
  }
}

func randomKind() ret TetrominoKind {
  let k: Int = random(min: 0, max: 6)
  if k is 0 {
    ret TetrominoKind.i
  }
  if k is 1 {
    ret TetrominoKind.j
  }
  if k is 2 {
    ret TetrominoKind.l
  }
  if k is 3 {
    ret TetrominoKind.o
  }
  if k is 4 {
    ret TetrominoKind.s
  }
  if k is 5 {
    ret TetrominoKind.t
  }
  ret TetrominoKind.z
}

func spawnPiece(game: mod Game) {
  let cp: mod Piece => game.currentPiece
  cp.kind = game.nextPieceKind
  game.nextPieceKind = randomKind()

  let pos: mod Position => cp.pos
  pos.x = game.width / 2 - 2
  pos.y = -1
  cp.rotation = 0
  game.lockTimer = 0
  game.maxLockTimer = 0
  game.moveTimer = 0
  if canMove(game: game, dx: 0, dy: 0, dr: 0) is 0 {
    game.state = GameState.gameOver
  }
}

func initGame(game: mod Game) {
  game.state = GameState.playing
  game.width = 10
  game.height = 20
  game.score = 0
  game.lines = 0
  game.level = 1
  game.moveTimer = 0
  game.moveDelay = 21
  game.hMoveTimer = 0
  # repeat speed
  game.hMoveDelay = 4
  # DAS delay
  game.dasDelay = 14
  game.lockTimer = 0
  # 0.5s at 60fps
  game.lockDelay = 30
  # Max cumulative lock delay (e.g. 2s)
  game.maxLockTimer = 0
  
  game.nextPieceKind = randomKind()

  # Initialize grid with 0s
  var i: Int = 0
  let grid: mod List(Int) => game.grid
  grid.clear()
  loop i < game.width * game.height {
    grid.add(value: 0)
    i = i + 1
  }
  spawnPiece(game)
}

func drawFrame(x: view Float, y: view Float, w: view Float, h: view Float) {
  Gpu2d.drawRect(x: x, y: y, w: w, h: 2.0, color: 0xFFB4B4FF)
  Gpu2d.drawRect(x: x, y: y + h - 2.0, w: w, h: 2.0, color: 0xFFB4B4FF)
  Gpu2d.drawRect(x: x, y: y, w: 2.0, h: h, color: 0xFFB4B4FF)
  Gpu2d.drawRect(x: x + w - 2.0, y: y, w: 2.0, h: h, color: 0xFFB4B4FF)
}

func drawCell(x: view Float, y: view Float, size: view Float, colorId: view Int) {
  Gpu2d.drawRect(
    x: x, y: y, w: size - 1.0, h: size - 1.0
    color: getModernColor(index: colorId))
}

func shouldFillTestCell(row: view Int, column: view Int) ret Bool {
  if row is 19 {
    ret column is not 6
  }
  if row is 18 {
    ret column is not 2 and column is not 6
  }
  if row is 17 {
    ret column is 0 or column is 1 or column is 3 or column is 4 or column is 5 or column >= 7
  }
  if row is 16 {
    ret column <= 5 or column >= 8
  }
  if row is 15 {
    ret column >= 1 and column <= 5 or column is 8
  }
  if row is 14 {
    ret column >= 2 and column <= 5
  }
  if row is 13 {
    ret column >= 3 and column <= 5
  }
  if row is 12 {
    ret column is 3 or column is 4
  }
  if row is 11 or row is 10 {
    ret column is 4
  }
  ret false
}

func stageTestFrame(game: mod Game) {
  game.score = 4500
  game.lines = 9
  game.level = 10

  var row: Int = 10
  loop row < game.height {
    var column: Int = 0
    loop column < game.width {
      if shouldFillTestCell(row: row, column: column) {
        let colorId: Int = (row * 3 + column * 2) % 7 + 1
        game.grid.set(index: row * game.width + column, value: colorId)
      }
      column = column + 1
    }
    row = row + 1
  }

  let currentPiece: mod Piece => game.currentPiece
  currentPiece.kind = TetrominoKind.j
  currentPiece.rotation = 0
  currentPiece.pos.x = 4
  currentPiece.pos.y = 5
  game.nextPieceKind = TetrominoKind.l
}

func drawGame(game: view Game) {
  let cellSize: Float = 22.0
  let offsetX: Float = 290.0
  let offsetY: Float = 80.0
  Gpu2d.drawGradientRect(
    x: 0.0, y: 0.0, w: canvasW, h: canvasH, radius: 0.0
    from: 0xFF111827, to: 0xFF07101B, angleDeg: 90.0)
  Gpu2d.drawRoundedRect(
    x: offsetX - 12.0, y: offsetY - 12.0
    w: game.width.toFloat() * cellSize + 24.0
    h: game.height.toFloat() * cellSize + 24.0
    radius: 10.0, color: 0x661B2538)
  drawFrame(
    x: offsetX - 2.0, y: offsetY - 2.0
    w: game.width.toFloat() * cellSize + 4.0
    h: game.height.toFloat() * cellSize + 4.0)
  var y: Int = 0
  loop y < game.height {
    var x: Int = 0
    loop x < game.width {
      if let val: Int = game.grid.copyAt(index: y * game.width + x) {
        if val > 0 {
          drawCell(
            x: x.toFloat() * cellSize + offsetX
            y: y.toFloat() * cellSize + offsetY
            size: cellSize
            colorId: val
          )
        }
      }
      x = x + 1
    }
    y = y + 1
  }
  # Draw current piece
  let cp: view Piece => game.currentPiece
  let pos: view Position => cp.pos
  let kindId: Int = getKindId(kind: cp.kind)
  var py: Int = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: cp.kind, rot: cp.rotation, px: px, py: py) is 1 {
        drawCell(
          x: (pos.x + px).toFloat() * cellSize + offsetX
          y: (pos.y + py).toFloat() * cellSize + offsetY
          size: cellSize
          colorId: kindId
        )
      }
      px = px + 1
    }
    py = py + 1
  }

  let previewOffsetX: Float = offsetX + game.width.toFloat() * cellSize + cellSize * 2.0
  let previewOffsetY: Float = offsetY + cellSize * 2.0
  drawFrame(
    x: previewOffsetX - 5.0, y: previewOffsetY - 5.0
    w: cellSize * 4.0 + 10.0, h: cellSize * 4.0 + 10.0)

  let nextKindId: Int = getKindId(kind: game.nextPieceKind)
  py = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: game.nextPieceKind, rot: 0, px: px, py: py) is 1 {
        drawCell(
          x: previewOffsetX + px.toFloat() * cellSize
          y: previewOffsetY + py.toFloat() * cellSize
          size: cellSize
          colorId: nextKindId
        )
      }
      px = px + 1
    }
    py = py + 1
  }
}

func handleInput(game: mod Game) {
  if game.state is not GameState.playing {
    ret
  }
  let cp: mod Piece => game.currentPiece
  let pos: mod Position => cp.pos
  var moved: Int = 0

  # DAS (Delayed Auto Shift)
  let moveLeft: Bool = Sdl3.isKeyDown(key: Keys.keyLeft) or Sdl3.isKeyDown(key: Keys.keyA)
  let moveRight: Bool = Sdl3.isKeyDown(key: Keys.keyRight) or Sdl3.isKeyDown(key: Keys.keyD)

  if moveLeft or moveRight {
    if game.hMoveTimer is 0 {
      # First press: move immediately
      if moveLeft {
        if canMove(game: game, dx: -1, dy: 0, dr: 0) is 1 {
          pos.x = pos.x - 1
          moved = 1
        }
      } else {
        if canMove(game: game, dx: 1, dy: 0, dr: 0) is 1 {
          pos.x = pos.x + 1
          moved = 1
        }
      }
      game.hMoveTimer = 1
    } else {
      game.hMoveTimer = game.hMoveTimer + 1
      if game.hMoveTimer >= game.dasDelay {
        if (game.hMoveTimer - game.dasDelay) % game.hMoveDelay is 0 {
          if moveLeft {
            if canMove(game: game, dx: -1, dy: 0, dr: 0) is 1 {
              pos.x = pos.x - 1
              moved = 1
            }
          } else {
            if canMove(game: game, dx: 1, dy: 0, dr: 0) is 1 {
              pos.x = pos.x + 1
              moved = 1
            }
          }
        }
      }
    }
  } else {
    game.hMoveTimer = 0
  }

  # Rotate (still single-press)
  if Sdl3.isKeyPressed(key: Keys.keySpace) or Sdl3.isKeyPressed(key: Keys.keyUp) or Sdl3.isKeyPressed(key: Keys.keyW) {
    if canMove(game: game, dx: 0, dy: 0, dr: 1) is 1 {
      cp.rotation = (cp.rotation + 1) % 4
      moved = 1
    }
  }

  # Reset lock timer if piece moved or rotated while touching bottom
  if moved is 1 {
    if canMove(game: game, dx: 0, dy: 1, dr: 0) is 0 {
      game.lockTimer = 0
    }
  }

  # Soft Drop
  var effectiveDelay: Int = game.moveDelay
  if Sdl3.isKeyDown(key: Keys.keyDown) or Sdl3.isKeyDown(key: Keys.keyS) {
    effectiveDelay = 2
  }

  # Gravity & Lock Delay
  game.moveTimer = game.moveTimer + 1
  if game.moveTimer >= effectiveDelay {
    if canMove(game: game, dx: 0, dy: 1, dr: 0) is 1 {
      pos.y = pos.y + 1
      game.moveTimer = 0
      # Reset lock timers on successful gravity move
      game.lockTimer = 0
      game.maxLockTimer = 0
    } else {
      # Can't move down, handled by lock delay below
      game.moveTimer = effectiveDelay # keep it at threshold
    }
  }

  # Handle Lock Delay if touching bottom
  if canMove(game: game, dx: 0, dy: 1, dr: 0) is 0 {
    game.lockTimer = game.lockTimer + 1
    game.maxLockTimer = game.maxLockTimer + 1
    if game.lockTimer >= game.lockDelay or game.maxLockTimer >= 120 {
      lockPiece(game)
      checkLines(game)
      spawnPiece(game)
    }
  }
}

func main() ret Int {
  Gpu2d.initWindow(width: canvasW.toInt(), height: canvasH.toInt(), title: "Rae Tetris 2D — GPU2D")
  Gpu2d.setDesignResolution(width: canvasW, height: canvasH, fit: 0)
  let uiResources: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: ""
    themeFile: "theme.raescene")
  var dbg: DebugOverlay = createDebugOverlay(
    button: true, fps: true, memory: true, heartbeat: false)
  var world: UiWorld = createUiWorld()
  # #764: install the app's theme (palette + scene tokens) onto this world.
  seedWorldTheme(world: world, res: uiResources)
  let uiRoot: EntityId = mountUiScene(
    world: world
    path: "examples/94_tetris2d/assets/ui.raescene"
    res: uiResources)
  let game: Game = {
    state: GameState.menu
    grid: createList(cap: 200)
    width: 0
    height: 0
    currentPiece: { kind: TetrominoKind.i, pos: { x: 0, y: 0 }, rotation: 0 }
    nextPieceKind: TetrominoKind.i
    score: 0
    lines: 0
    level: 1
    moveTimer: 0
    moveDelay: 0
    hMoveTimer: 0
    hMoveDelay: 0
    dasDelay: 0
    lockTimer: 0
    lockDelay: 0
    maxLockTimer: 0
  }
  seed(n: 2026)
  initGame(game)
  let testMode: Bool = getEnv(name: "RAE_TETRIS2D_TEST_FRAME").length() > 0
  if testMode {
    stageTestFrame(game: game)
    log("[tetris2d] deterministic frame ready")
  }
  var displayedScore: Int = 0 - 1
  var displayedLines: Int = 0 - 1
  var displayedLevel: Int = 0 - 1

  loop not Gpu2d.pollClose() {
    let now: Float64 = Gpu2d.nowSeconds()
    if updateDebugOverlay(
      d: dbg, screenW: Gpu2d.designWidth(), screenH: Gpu2d.designHeight()
      now: now, didRealWork: true) {
    }
    let resized: Bool = resizeUiToWindow(world: world, res: uiResources)
    # Input: Global (Menu/GameOver)
    if game.state is GameState.gameOver {
      # R key
      if Sdl3.isKeyPressed(key: Keys.keyR) {
        initGame(game)
      }
    }
    # Input: Pause
    # P key
    if Sdl3.isKeyPressed(key: Keys.keyP) {
      if game.state is GameState.playing {
        game.state = GameState.paused
      } else {
        if game.state is GameState.paused {
          game.state = GameState.playing
        }
      }
    }
    # early returns don't work yet, so gate it here.
    if game.state is GameState.playing and testMode is false {
      handleInput(game)
    }
    if game.score is not displayedScore or game.lines is not displayedLines or game.level is not displayedLevel {
      setNodeText(world: world, nodeId: "ScoreText", value: "SCORE  {game.score}")
      setNodeText(world: world, nodeId: "LevelText", value: "LEVEL  {game.level}")
      setNodeText(world: world, nodeId: "LinesText", value: "LINES  {game.lines}")
      displayedScore = game.score
      displayedLines = game.lines
      displayedLevel = game.level
    }
    setNodeActive(world: world, nodeId: "PauseText", value: game.state is GameState.paused)
    setNodeActive(world: world, nodeId: "GameOverPanel", value: game.state is GameState.gameOver)
    runUiSystems(world: world, res: uiResources)

    Gpu2d.beginFrame(r: 0.03, game: 0.05, b: 0.09, a: 1.0)
    drawGame(game: game)
    renderSystemGpu2d(world: world, res: uiResources)
    drawDebugOverlay(debugOverlay: dbg, font: uiResources.textFont, didRealWork: true)
    Gpu2d.endFrame()
  }
  Gpu2d.closeWindow()
  ret 0
}
