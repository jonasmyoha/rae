pack Tetris2d {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Tetris 2D"
  description: "Minimal Tetris using GPU2D, SDL3 input, ECS scene UI, and List."
  category: "90-99 Graphics & Games"
  featured: "true"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
