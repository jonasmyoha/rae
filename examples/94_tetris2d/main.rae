import core
import gpu2d
import math
import sdl3
import keys
import sys
import ui/ecs
import ui/render_gpu2d
import app3d/ui_shell
open app3d/ui_shell
open math
open ui/ecs
open ui/debug_overlay
open ui/render_gpu2d

const canvasW: Float = 800.0
const canvasH: Float = 600.0

enum GameState { menu, playing, paused, gameOver }

enum TetrominoKind {
  i
  j
  l
  o
  s
  t
  z
}

type Pos {
  x: Int
  y: Int
}

type Piece {
  kind: TetrominoKind
  pos: Pos
  rotation: Int
}

# 0-3
type Game {
  state: GameState
  grid: List(Int)
  width: Int
  height: Int
  currentPiece: Piece
  nextPieceKind: TetrominoKind
  score: Int
  lines: Int
  level: Int
  moveTimer: Int
  moveDelay: Int
  hMoveTimer: Int
  hMoveDelay: Int
  dasDelay: Int
  lockTimer: Int
  lockDelay: Int
  maxLockTimer: Int
}

func getModernColor(index: view Int) ret Int {
  # I - Cyan
  if index is 1 {
    ret 0xFF64E6FF
  }
  # J - Blue
  if index is 2 {
    ret 0xFF78A0FF
  }
  # L - Orange
  if index is 3 {
    ret 0xFFFFB478
  }
  # O - Yellow
  if index is 4 {
    ret 0xFFFFE678
  }
  # S - Green
  if index is 5 {
    ret 0xFF78FFA0
  }
  # T - Purple
  if index is 6 {
    ret 0xFFC8A0FF
  }
  # Z - Red
  if index is 7 {
    ret 0xFFFF788C
  }
  # Empty
  ret 0xFF282832
}

func getKindId(kind: TetrominoKind) ret Int {
  if kind is TetrominoKind.i {
    ret 1
  }
  if kind is TetrominoKind.j {
    ret 2
  }
  if kind is TetrominoKind.l {
    ret 3
  }
  if kind is TetrominoKind.o {
    ret 4
  }
  if kind is TetrominoKind.s {
    ret 5
  }
  if kind is TetrominoKind.t {
    ret 6
  }
  # Z
  ret 7
}

# Returns 1 if cell at (x, y) is occupied or out of bounds
func isOccupied(g: view Game, x: view Int, y: view Int) ret Int {
  if x < 0 or x >= g.width or y >= g.height {
    ret 1
  }
  if y < 0 {
    # Allow pieces above the board
    ret 0
  }
  if g.grid.get(index: y * g.width + x) > 0 {
    ret 1
  }
  ret 0
}

# Simple shape definitions (4x4 max)
func getShapeCell(kind: TetrominoKind, rot: view Int, px: view Int, py: view Int) ret Int {
  if kind is TetrominoKind.i {
    if rot is 0 or rot is 2 {
      if px is 1 {
        ret 1
      }
    } else {
      if py is 1 {
        ret 1
      }
    }
  } else {
    if kind is TetrominoKind.j {
      if rot is 0 {
        if px is 1 and py >= 0 and py <= 2 or px is 0 and py is 2 {
          ret 1
        }
      } else {
        if rot is 1 {
          if py is 1 and px >= 0 and px <= 2 or px is 0 and py is 0 {
            ret 1
          }
        } else {
          if rot is 2 {
            if px is 1 and py >= 0 and py <= 2 or px is 2 and py is 0 {
              ret 1
            }
          } else {
            if rot is 3 {
              if py is 1 and px >= 0 and px <= 2 or px is 2 and py is 2 {
                ret 1
              }
            }
          }
        }
      }
    } else {
      if kind is TetrominoKind.l {
        if rot is 0 {
          if px is 1 and py >= 0 and py <= 2 or px is 2 and py is 2 {
            ret 1
          }
        } else {
          if rot is 1 {
            if py is 1 and px >= 0 and px <= 2 or px is 0 and py is 2 {
              ret 1
            }
          } else {
            if rot is 2 {
              if px is 1 and py >= 0 and py <= 2 or px is 0 and py is 0 {
                ret 1
              }
            } else {
              if rot is 3 {
                if py is 1 and px >= 0 and px <= 2 or px is 2 and py is 0 {
                  ret 1
                }
              }
            }
          }
        }
      } else {
        if kind is TetrominoKind.o {
          if px >= 1 and px <= 2 and py >= 1 and py <= 2 {
            ret 1
          }
        } else {
          if kind is TetrominoKind.s {
            if rot is 0 or rot is 2 {
              if py is 1 and px >= 1 and px <= 2 or py is 2 and px >= 0 and px <= 1 {
                ret 1
              }
            } else {
              if px is 1 and py >= 0 and py <= 1 or px is 2 and py >= 1 and py <= 2 {
                ret 1
              }
            }
          } else {
            if kind is TetrominoKind.t {
              if rot is 0 {
                if py is 1 and px >= 0 and px <= 2 or px is 1 and py is 0 {
                  ret 1
                }
              } else {
                if rot is 1 {
                  if px is 1 and py >= 0 and py <= 2 or px is 2 and py is 1 {
                    ret 1
                  }
                } else {
                  if rot is 2 {
                    if py is 1 and px >= 0 and px <= 2 or px is 1 and py is 2 {
                      ret 1
                    }
                  } else {
                    if rot is 3 {
                      if px is 1 and py >= 0 and py <= 2 or px is 0 and py is 1 {
                        ret 1
                      }
                    }
                  }
                }
              }
            } else {
              if kind is TetrominoKind.z {
                if rot is 0 or rot is 2 {
                  if py is 1 and px >= 0 and px <= 1 or py is 2 and px >= 1 and px <= 2 {
                    ret 1
                  }
                } else {
                  if px is 1 and py >= 1 and py <= 2 or px is 2 and py >= 0 and py <= 1 {
                    ret 1
                  }
                }
              }
            }
          }
        }
      }
    }
  }
  ret 0
}

func canMove(g: view Game, dx: view Int, dy: view Int, dr: view Int) ret Int {
  let cp: view Piece => g.currentPiece
  let pos: view Pos => cp.pos
  let newX: Int = pos.x + dx
  let newY: Int = pos.y + dy
  var newRot: Int = (cp.rotation + dr) % 4
  if newRot < 0 {
    newRot = newRot + 4
  }
  var py: Int = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: cp.kind, rot: newRot, px: px, py: py) is 1 {
        if isOccupied(g: g, x: newX + px, y: newY + py) is 1 {
          ret 0
        }
      }
      px = px + 1
    }
    py = py + 1
  }
  ret 1
}

func lockPiece(g: mod Game) {
  let cp: mod Piece => g.currentPiece
  let pos: view Pos => cp.pos
  let grid: mod List(Int) => g.grid
  let kindId: Int = getKindId(kind: cp.kind)
  var py: Int = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: cp.kind, rot: cp.rotation, px: px, py: py) is 1 {
        let gx: Int = pos.x + px
        let gy: Int = pos.y + py
        if gy >= 0 and gy < g.height {
          grid.set(index: gy * g.width + gx, value: kindId)
        }
      }
      px = px + 1
    }
    py = py + 1
  }
}

func checkLines(g: mod Game) {
  let grid: mod List(Int) => g.grid
  var linesCleared: Int = 0
  var y: Int = g.height - 1
  loop y >= 0 {
    var full: Int = 1
    var x: Int = 0
    loop x < g.width {
      if grid.get(index: y * g.width + x) is 0 {
        full = 0
      }
      x = x + 1
    }
    if full is 1 {
      linesCleared = linesCleared + 1
      # Shift lines down
      var ty: Int = y
      loop ty > 0 {
        var tx: Int = 0
        loop tx < g.width {
          grid.set(index: ty * g.width + tx, value: grid.get(index: (ty - 1) * g.width + tx))
          tx = tx + 1
        }
        ty = ty - 1
      }
      # Top line is 0
      var tx: Int = 0
      loop tx < g.width {
        grid.set(index: tx, value: 0)
        tx = tx + 1
      }
      # Re-check same line
      y = y + 1
    }
    y = y - 1
  }
  if (linesCleared > 0) {
    g.lines = g.lines + linesCleared
    g.score = g.score + linesCleared * 100 * g.level
    # GEN-Z PROGRESSION: Level up every single line
    let newLevel: Int = g.lines + 1
    if (newLevel > g.level) {
      g.level = newLevel
      # GRADUAL FRANTIC SPEED: 
      # Level 1: ~21 frames, Level 15: 2 frames (Max Speed)
      g.moveDelay = 22 - (g.level * 4 / 3)
      if (g.moveDelay < 2) {
        g.moveDelay = 2
      }
    }
  }
}

func randomKind() ret TetrominoKind {
  let k: Int = random(min: 0, max: 6)
  if k is 0 {
    ret TetrominoKind.i
  }
  if k is 1 {
    ret TetrominoKind.j
  }
  if k is 2 {
    ret TetrominoKind.l
  }
  if k is 3 {
    ret TetrominoKind.o
  }
  if k is 4 {
    ret TetrominoKind.s
  }
  if k is 5 {
    ret TetrominoKind.t
  }
  ret TetrominoKind.z
}

func spawnPiece(g: mod Game) {
  let cp: mod Piece => g.currentPiece
  cp.kind = g.nextPieceKind
  g.nextPieceKind = randomKind()

  let pos: mod Pos => cp.pos
  pos.x = g.width / 2 - 2
  pos.y = -1
  cp.rotation = 0
  g.lockTimer = 0
  g.maxLockTimer = 0
  g.moveTimer = 0
  if canMove(g: g, dx: 0, dy: 0, dr: 0) is 0 {
    g.state = GameState.gameOver
  }
}

func initGame(g: mod Game) {
  g.state = GameState.playing
  g.width = 10
  g.height = 20
  g.score = 0
  g.lines = 0
  g.level = 1
  g.moveTimer = 0
  g.moveDelay = 21
  g.hMoveTimer = 0
  # repeat speed
  g.hMoveDelay = 4
  # DAS delay
  g.dasDelay = 14
  g.lockTimer = 0
  # 0.5s at 60fps
  g.lockDelay = 30
  # Max cumulative lock delay (e.g. 2s)
  g.maxLockTimer = 0
  
  g.nextPieceKind = randomKind()

  # Initialize grid with 0s
  var i: Int = 0
  let grid: mod List(Int) => g.grid
  grid.clear()
  loop i < g.width * g.height {
    grid.add(value: 0)
    i = i + 1
  }
  spawnPiece(g)
}

func drawFrame(x: view Float, y: view Float, w: view Float, h: view Float) {
  gpu2d.drawRect(x: x, y: y, w: w, h: 2.0, color: 0xFFB4B4FF)
  gpu2d.drawRect(x: x, y: y + h - 2.0, w: w, h: 2.0, color: 0xFFB4B4FF)
  gpu2d.drawRect(x: x, y: y, w: 2.0, h: h, color: 0xFFB4B4FF)
  gpu2d.drawRect(x: x + w - 2.0, y: y, w: 2.0, h: h, color: 0xFFB4B4FF)
}

func drawCell(x: view Float, y: view Float, size: view Float, colorId: view Int) {
  gpu2d.drawRect(
    x: x, y: y, w: size - 1.0, h: size - 1.0
    color: getModernColor(index: colorId))
}

func shouldFillTestCell(row: view Int, column: view Int) ret Bool {
  if row is 19 {
    ret column is not 6
  }
  if row is 18 {
    ret column is not 2 and column is not 6
  }
  if row is 17 {
    ret column is 0 or column is 1 or column is 3 or column is 4 or column is 5 or column >= 7
  }
  if row is 16 {
    ret column <= 5 or column >= 8
  }
  if row is 15 {
    ret column >= 1 and column <= 5 or column is 8
  }
  if row is 14 {
    ret column >= 2 and column <= 5
  }
  if row is 13 {
    ret column >= 3 and column <= 5
  }
  if row is 12 {
    ret column is 3 or column is 4
  }
  if row is 11 or row is 10 {
    ret column is 4
  }
  ret false
}

func stageTestFrame(g: mod Game) {
  g.score = 4500
  g.lines = 9
  g.level = 10

  var row: Int = 10
  loop row < g.height {
    var column: Int = 0
    loop column < g.width {
      if shouldFillTestCell(row: row, column: column) {
        let colorId: Int = (row * 3 + column * 2) % 7 + 1
        g.grid.set(index: row * g.width + column, value: colorId)
      }
      column = column + 1
    }
    row = row + 1
  }

  let currentPiece: mod Piece => g.currentPiece
  currentPiece.kind = TetrominoKind.j
  currentPiece.rotation = 0
  currentPiece.pos.x = 4
  currentPiece.pos.y = 5
  g.nextPieceKind = TetrominoKind.l
}

func drawGame(g: view Game) {
  let cellSize: Float = 22.0
  let offsetX: Float = 290.0
  let offsetY: Float = 80.0
  gpu2d.drawGradientRect(
    x: 0.0, y: 0.0, w: canvasW, h: canvasH, radius: 0.0
    from: 0xFF111827, to: 0xFF07101B, angleDeg: 90.0)
  gpu2d.drawRoundedRect(
    x: offsetX - 12.0, y: offsetY - 12.0
    w: g.width.toFloat() * cellSize + 24.0
    h: g.height.toFloat() * cellSize + 24.0
    radius: 10.0, color: 0x661B2538)
  drawFrame(
    x: offsetX - 2.0, y: offsetY - 2.0
    w: g.width.toFloat() * cellSize + 4.0
    h: g.height.toFloat() * cellSize + 4.0)
  var y: Int = 0
  loop y < g.height {
    var x: Int = 0
    loop x < g.width {
      let val: Int = g.grid.get(index: y * g.width + x)
      if val > 0 {
        drawCell(
          x: x.toFloat() * cellSize + offsetX
          y: y.toFloat() * cellSize + offsetY
          size: cellSize
          colorId: val
        )
      }
      x = x + 1
    }
    y = y + 1
  }
  # Draw current piece
  let cp: view Piece => g.currentPiece
  let pos: view Pos => cp.pos
  let kindId: Int = getKindId(kind: cp.kind)
  var py: Int = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: cp.kind, rot: cp.rotation, px: px, py: py) is 1 {
        drawCell(
          x: (pos.x + px).toFloat() * cellSize + offsetX
          y: (pos.y + py).toFloat() * cellSize + offsetY
          size: cellSize
          colorId: kindId
        )
      }
      px = px + 1
    }
    py = py + 1
  }

  let previewOffsetX: Float = offsetX + g.width.toFloat() * cellSize + cellSize * 2.0
  let previewOffsetY: Float = offsetY + cellSize * 2.0
  drawFrame(
    x: previewOffsetX - 5.0, y: previewOffsetY - 5.0
    w: cellSize * 4.0 + 10.0, h: cellSize * 4.0 + 10.0)

  let nextKindId: Int = getKindId(kind: g.nextPieceKind)
  py = 0
  loop py < 4 {
    var px: Int = 0
    loop px < 4 {
      if getShapeCell(kind: g.nextPieceKind, rot: 0, px: px, py: py) is 1 {
        drawCell(
          x: previewOffsetX + px.toFloat() * cellSize
          y: previewOffsetY + py.toFloat() * cellSize
          size: cellSize
          colorId: nextKindId
        )
      }
      px = px + 1
    }
    py = py + 1
  }
}

func handleInput(g: mod Game) {
  if g.state is not GameState.playing {
    ret
  }
  let cp: mod Piece => g.currentPiece
  let pos: mod Pos => cp.pos
  var moved: Int = 0

  # DAS (Delayed Auto Shift)
  let moveLeft: Bool = sdl3.isKeyDown(key: keys.keyLeft) or sdl3.isKeyDown(key: keys.keyA)
  let moveRight: Bool = sdl3.isKeyDown(key: keys.keyRight) or sdl3.isKeyDown(key: keys.keyD)

  if moveLeft or moveRight {
    if g.hMoveTimer is 0 {
      # First press: move immediately
      if moveLeft {
        if canMove(g: g, dx: -1, dy: 0, dr: 0) is 1 {
          pos.x = pos.x - 1
          moved = 1
        }
      } else {
        if canMove(g: g, dx: 1, dy: 0, dr: 0) is 1 {
          pos.x = pos.x + 1
          moved = 1
        }
      }
      g.hMoveTimer = 1
    } else {
      g.hMoveTimer = g.hMoveTimer + 1
      if g.hMoveTimer >= g.dasDelay {
        if (g.hMoveTimer - g.dasDelay) % g.hMoveDelay is 0 {
          if moveLeft {
            if canMove(g: g, dx: -1, dy: 0, dr: 0) is 1 {
              pos.x = pos.x - 1
              moved = 1
            }
          } else {
            if canMove(g: g, dx: 1, dy: 0, dr: 0) is 1 {
              pos.x = pos.x + 1
              moved = 1
            }
          }
        }
      }
    }
  } else {
    g.hMoveTimer = 0
  }

  # Rotate (still single-press)
  if sdl3.isKeyPressed(key: keys.keySpace) or sdl3.isKeyPressed(key: keys.keyUp) or sdl3.isKeyPressed(key: keys.keyW) {
    if canMove(g: g, dx: 0, dy: 0, dr: 1) is 1 {
      cp.rotation = (cp.rotation + 1) % 4
      moved = 1
    }
  }

  # Reset lock timer if piece moved or rotated while touching bottom
  if moved is 1 {
    if canMove(g: g, dx: 0, dy: 1, dr: 0) is 0 {
      g.lockTimer = 0
    }
  }

  # Soft Drop
  var effectiveDelay: Int = g.moveDelay
  if sdl3.isKeyDown(key: keys.keyDown) or sdl3.isKeyDown(key: keys.keyS) {
    effectiveDelay = 2
  }

  # Gravity & Lock Delay
  g.moveTimer = g.moveTimer + 1
  if g.moveTimer >= effectiveDelay {
    if canMove(g: g, dx: 0, dy: 1, dr: 0) is 1 {
      pos.y = pos.y + 1
      g.moveTimer = 0
      # Reset lock timers on successful gravity move
      g.lockTimer = 0
      g.maxLockTimer = 0
    } else {
      # Can't move down, handled by lock delay below
      g.moveTimer = effectiveDelay # keep it at threshold
    }
  }

  # Handle Lock Delay if touching bottom
  if canMove(g: g, dx: 0, dy: 1, dr: 0) is 0 {
    g.lockTimer = g.lockTimer + 1
    g.maxLockTimer = g.maxLockTimer + 1
    if g.lockTimer >= g.lockDelay or g.maxLockTimer >= 120 {
      lockPiece(g)
      checkLines(g)
      spawnPiece(g)
    }
  }
}

func main() ret Int {
  gpu2d.initWindow(width: canvasW.toInt(), height: canvasH.toInt(), title: "Rae Tetris 2D — GPU2D")
  gpu2d.setDesignResolution(width: canvasW, height: canvasH, fit: 0)
  let uiResources: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: ""
    themeFile: "theme.raescene")
  var dbg: DebugOverlay = createDebugOverlay(
    button: true, fps: true, memory: true, heartbeat: false)
  var world: UiWorld = createUiWorld()
  let uiRoot: EntityId = mountUiScene(
    world: world
    path: "examples/94_tetris2d/assets/ui.raescene"
    res: uiResources)
  let g: Game = {
    state: GameState.menu
    grid: createList(cap: 200)
    width: 0
    height: 0
    currentPiece: { kind: TetrominoKind.i, pos: { x: 0, y: 0 }, rotation: 0 }
    nextPieceKind: TetrominoKind.i
    score: 0
    lines: 0
    level: 1
    moveTimer: 0
    moveDelay: 0
    hMoveTimer: 0
    hMoveDelay: 0
    dasDelay: 0
    lockTimer: 0
    lockDelay: 0
    maxLockTimer: 0
  }
  seed(n: 2026)
  initGame(g)
  let testMode: Bool = getEnv(name: "RAE_TETRIS2D_TEST_FRAME").length() > 0
  if testMode {
    stageTestFrame(g: g)
    log("[tetris2d] deterministic frame ready")
  }
  var displayedScore: Int = 0 - 1
  var displayedLines: Int = 0 - 1
  var displayedLevel: Int = 0 - 1

  loop not gpu2d.pollClose() {
    let now: Float64 = gpu2d.nowSeconds()
    if updateDebugOverlay(
      d: dbg, screenW: gpu2d.designWidth(), screenH: gpu2d.designHeight()
      now: now, didRealWork: true) {
    }
    let resized: Bool = resizeUiToWindow(world: world, res: uiResources)
    # Input: Global (Menu/GameOver)
    if g.state is GameState.gameOver {
      # R key
      if sdl3.isKeyPressed(key: keys.keyR) {
        initGame(g)
      }
    }
    # Input: Pause
    # P key
    if sdl3.isKeyPressed(key: keys.keyP) {
      if g.state is GameState.playing {
        g.state = GameState.paused
      } else {
        if g.state is GameState.paused {
          g.state = GameState.playing
        }
      }
    }
    # early returns don't work yet, so gate it here.
    if g.state is GameState.playing and testMode is false {
      handleInput(g)
    }
    if g.score is not displayedScore or g.lines is not displayedLines or g.level is not displayedLevel {
      setNodeText(world: world, nodeId: "ScoreText", value: "SCORE  {g.score}")
      setNodeText(world: world, nodeId: "LevelText", value: "LEVEL  {g.level}")
      setNodeText(world: world, nodeId: "LinesText", value: "LINES  {g.lines}")
      displayedScore = g.score
      displayedLines = g.lines
      displayedLevel = g.level
    }
    setNodeActive(world: world, nodeId: "PauseText", value: g.state is GameState.paused)
    setNodeActive(world: world, nodeId: "GameOverPanel", value: g.state is GameState.gameOver)
    runUiSystems(world: world, res: uiResources)

    gpu2d.beginFrame(r: 0.03, g: 0.05, b: 0.09, a: 1.0)
    drawGame(g: g)
    renderSystemGpu2d(world: world, res: uiResources)
    drawDebugOverlay(d: dbg, font: uiResources.textFont, didRealWork: true)
    gpu2d.endFrame()
  }
  gpu2d.closeWindow()
  ret 0
}
