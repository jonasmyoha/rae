# The Sources view: the captures there are to look at, in one table to pick from. Programs that
# stream to this viewer (started with RAE_PROFILE=1 RAE_PERF_LIVE=<this machine>:<port>; the
# viewer listens on RAE_PERF_LISTEN, 7470 by default, 0 for any free port, "off" for none) come
# first, each with its program and machine and the blocks it sent, then the .raeperf files of a
# folder (RAE_PERF_FOLDER, this example's samples by default: a profile run's folder of captures).
# A click on a row opens it; a live one keeps its views current as its blocks arrive (the last
# 10 s, lib/perf/PerfListen).
open Files
import String
open app3d/UiShell
open ecs/ComponentTable
open ecs/Entity
open perf/PerfFile
open perf/PerfListen
open ui/ChartComponents
open ui/Ecs
open ui/statTableSystem/StatTableSystem
open Charts

const defaultLivePort: Int = 7470

# A row of the table: a live source (its index) or a file
type SourceRow {
  live: Int = -1
  path: String = ""
}

type ViewerSources {
  listener: opt PerfListener = none
  folder: String
  rows: List(SourceRow)
  listenNote: String = ""
  # the table was filled once (its state exists after the first frame)
  filled: Bool = false
  # RAE_PERF_FOLLOW=1: the first program to stream is shown by itself, as a click would
  follow: Bool = false
}

# The listener RAE_PERF_LISTEN asks for, and the folder RAE_PERF_FOLDER names
func openSources(listen: view String, folder: view String) ret ViewerSources {
  var sources: ViewerSources = { folder: "{folder}", rows: {} }
  if listen is "off" {
    sources.listenNote = "Not listening (RAE_PERF_LISTEN=off)."
    ret sources
  }
  var port: Int = defaultLivePort
  if listen.length() > 0 {
    port = listen.toInt()
  }
  if let listener: PerfListener = perfListen(host: "0.0.0.0", port: port) {
    sources.listenNote = "Listening on port {listener.port}: start a program with RAE_PROFILE=1 RAE_PERF_LIVE=<this machine>:{listener.port}."
    log("[perfViewer] listening on port {listener.port}")
    sources.listener = listener
  } else {
    sources.listenNote = "Could not listen on port {port} (RAE_PERF_LISTEN picks another, 0 any free one)."
    log("[perfViewer] could not listen on port {port}")
  }
  ret sources
}

func sourcesNote(sources: view ViewerSources) ret String {
  ret "{sources.listenNote} Files: {sources.folder} (RAE_PERF_FOLDER). Click a row to open it."
}

# The .raeperf files of the folder, by name
func folderCaptures(folder: view String) ret List(String) {
  var names: List(String) = {}
  loop let file: view File in listDirByExt(folder: folder, ext: "raeperf") {
    var at: Int = names.length
    loop at > 0 and names.copyAtDefault(index: at - 1).compare(other: file.name) > 0 {
      at = at - 1
    }
    names.insert(index: at, value: file.name)
  }
  ret names
}

# The table again: its rows rebuilt (the columns, the selection and the scroll kept)
func fillSources(state: mod StatTableState, sources: mod ViewerSources) {
  if state.columns.length is 0 {
    loop let title: view String in List(String) { "source", "program", "received", "where" } {
      var width: Float = 200.0
      if title is "program" or title is "where" {
        width = 420.0
      }
      let unusedColumn: Int = statAddColumn(
        state: state
        title: title
        width: width
        numeric: title is "received"
      )
    }
  }
  state.rows = {}
  state.order = {}
  sources.rows = {}
  if let listener: view PerfListener = sources.listener {
    loop var i: Int = 0, i < listener.sources.length, ++i {
      if let source: view PerfLiveSource = listener.sources.viewAt(index: i) {
        var status: String = "live"
        if not source.connected {
          status = "live, ended"
        }
        let unusedRow: Int = statAddRow(
          state: state
          texts: List(String) {
            status
            perfLiveSourceName(source: source)
            "{source.received} blocks"
            "port {listener.port}"
          }
          values: List(Float) { 0.0, 0.0, source.received as Float, 0.0 }
        )
        sources.rows.add(value: SourceRow { live: i })
      }
    }
  }
  loop let name: view String in folderCaptures(folder: sources.folder) {
    let unusedRow: Int = statAddRow(
      state: state
      texts: List(String) { "file", name, "", sources.folder }
      values: List(Float) { 0.0, 0.0, 0.0, 0.0 }
    )
    sources.rows.add(value: SourceRow { path: "{sources.folder}/{name}" })
  }
}

# What the viewer read, for its last log line
func sourcesSummary(sources: view ViewerSources) ret String {
  if let listener: view PerfListener = sources.listener {
    var text: String = "{listener.sources.length} live"
    loop let source: view PerfLiveSource in listener.sources {
      text = "{text}; {perfLiveSourceName(source: source)}: {source.received > 0} blocks, ended {not source.connected}"
    }
    ret text
  }
  ret "not listening"
}

# Live source `index`'s last seconds shown (the views emptied and filled again)
func showLive(
  world: mod UiWorld
  viewer: mod PerfViewer
  sources: mod ViewerSources
  index: view Int
) {
  if let listener: mod PerfListener = sources.listener {
    if let source: mod PerfLiveSource = listener.sources.modAt(index: index) {
      let file: PerfFile = perfLiveSourceFile(source: source)
      source.fresh = false
      showCapture(
        world: world
        viewer: viewer
        file: file
        path: "live: {perfLiveSourceName(source: source)}"
      )
      viewer.liveIndex = index
      viewer.liveFilledNs = nowNs()
      viewer.opened = true
    }
  }
}

# The row clicked: a live source followed, or a file opened
func pickSource(world: mod UiWorld, viewer: mod PerfViewer, sources: mod ViewerSources) {
  let table: EntityId = nodeEntityFor(world: world, nodeId: "SourcesTable")
  if not componentHas(this: world.statTableStates, entityId: table) {
    ret
  }
  let selected: Int = componentView(this: world.statTableStates, entityId: table).selected
  if let row: SourceRow = sources.rows.copyAt(index: selected) {
    if row.live >= 0 {
      showLive(
        world: world
        viewer: viewer
        sources: sources
        index: row.live
      )
    } else if let file: PerfFile = perfReadFile(path: row.path) {
      viewer.liveIndex = -1
      showCapture(
        world: world
        viewer: viewer
        file: file
        path: row.path
      )
      viewer.opened = true
    } else {
      log("[perfViewer] could not read {row.path}")
    }
  }
}

# Once a frame: programs accepted and read, the table kept current, a click on a row, and the live
# source shown kept current (twice a second at most); true when anything shown changed
func sourcesFrame(world: mod UiWorld, viewer: mod PerfViewer, sources: mod ViewerSources) ret Bool {
  var arrived: Bool = false
  if let listener: mod PerfListener = sources.listener {
    arrived = perfListenStep(listener: listener)
  }
  var changed: Bool = false
  let table: EntityId = nodeEntityFor(world: world, nodeId: "SourcesTable")
  if componentHas(this: world.statTableStates, entityId: table) and (arrived or not sources.filled) {
    fillSources(state: componentMod(this: world.statTableStates, entityId: table), sources: sources)
    sources.filled = true
    changed = true
  }
  if sources.follow and viewer.liveIndex < 0 {
    var streaming: Bool = false
    if let listener: view PerfListener = sources.listener {
      if let first: view PerfLiveSource = listener.sources.viewAt(index: 0) {
        streaming = first.received > 0
      }
    }
    if streaming {
      showLive(
        world: world
        viewer: viewer
        sources: sources
        index: 0
      )
      changed = true
    }
  }
  if uiActionFired(world: world, actionId: "sources.pick") {
    pickSource(world: world, viewer: viewer, sources: sources)
    changed = true
  }
  if viewer.liveIndex >= 0 and nowNs() - viewer.liveFilledNs >= 500000000 {
    var fresh: Bool = false
    if let listener: view PerfListener = sources.listener {
      if let source: view PerfLiveSource = listener.sources.viewAt(index: viewer.liveIndex) {
        fresh = source.fresh
      }
    }
    if fresh {
      showLive(
        world: world
        viewer: viewer
        sources: sources
        index: viewer.liveIndex
      )
      changed = true
    }
  }
  ret changed
}

# The live source shown has ended (its program closed the link) and its last blocks are shown
func followedEnded(viewer: view PerfViewer, sources: view ViewerSources) ret Bool {
  if viewer.liveIndex < 0 {
    ret false
  }
  if let listener: view PerfListener = sources.listener {
    if let source: view PerfLiveSource = listener.sources.viewAt(index: viewer.liveIndex) {
      ret not source.connected and not source.fresh
    }
  }
  ret false
}
