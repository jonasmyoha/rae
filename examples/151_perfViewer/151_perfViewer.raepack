pack PerfViewer {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Rae Perf"
  description: "A viewer for .raeperf capture files (RAE_PROFILE=1 RAE_PERF_OUT=<file>, or the perf HUD's save button): Frames, Timeline, Flame graph, Threads, GPU, Audio, Memory and Systems views of one capture, from lib/perf/PerfCapture through the lib/ui chart widgets. Opens the walker sample; RAE_PERF_OPEN=<file> opens another."
  category: "Tools"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
