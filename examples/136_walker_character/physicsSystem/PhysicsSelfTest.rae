# The physics check that needs no one to play (RAE_114_PHYSICS_TEST=1). The
# steps are app3d/WalkerPhysicsChecks: the cube stacks settle, the hero pushes
# one and jumps, then the tree trunks hold and the rocks and bushes. This file finds this example's
# own entities and prints
# the one [physicstest] line the gate greps; the exit code is 0 when all held.
import Math
import Vec3
open ecs/Entity
open ecs/ComponentTable
open ecs/Transform
open app3d/WalkerPhysics
open app3d/WalkerPhysicsChecks
open app3d/GroveTrees
open box3d/ecs/NatureBodies

# Fixed steps the walk at a trunk may take (8 s)
const trunkTestWalkSteps: Int = 480

# The placed tree nearest to `point`, or none
func nearestTree(world: view GameWorld, point: view Vec3) ret opt EntityId {
  var nearest: opt EntityId = none
  var nearestDistance: Float = 1000000.0
  loop var i: Int = 0, i < componentCount(this: world.treeVariants), ++i {
    let entityId: EntityId = componentEntityAt(this: world.treeVariants, i: i)
    if componentView(this: world.propKinds, entityId: entityId).active {
      let gap: Vec3 = Vec3.vsub(
        a: componentView(this: world.transforms, entityId: entityId).position
        b: point
      )
      let distance: Float = Math.sqrt(x: gap.x * gap.x + gap.y * gap.y)
      if distance < nearestDistance {
        nearestDistance = distance
        nearest = entityId
      }
    }
  }
  ret nearest
}

# The tree nearest the hero blocks a ray at waist height, the hero walking
# straight at it stops at its bark, and a trunk whose tree gets a new
# Transform3D is hit where the tree now stands. One [trunktest] line.
func runTreeTrunkTest(
  physicsSystem: mod WalkerPhysics
  world: mod GameWorld
  heroEntityId: view EntityId
) ret Bool {
  let heroFeet: Vec3 = controllerFeet(
    controller: controllerOf(world: world, entityId: heroEntityId)
    groundZ: physicsSystem.groundZ
  )
  if let treeEntityId: EntityId = nearestTree(world: world, point: heroFeet) {
    let placed: Transform3D = transformOf(transforms: world.transforms, entityId: treeEntityId)
    let blocksRay: Bool = rayHitsEntity(
      physicsSystem: physicsSystem
      entityId: treeEntityId
      foot: placed.position
      height: 1.2
      halfSpan: 3.0
    )
    let closest: Float = walkClosest(
      physicsSystem: physicsSystem
      transforms: world.transforms
      controllers: world.controllers
      bushes: bushSpots(world: world)
      heroEntityId: heroEntityId
      target: placed.position
      steps: trunkTestWalkSteps
    )
    let stoppedAtBark: Bool = closest > treeTrunkRadius + 0.1 and closest < treeTrunkRadius + 1.2
    # Lift the tree 30 m, as a new placement would move it, and step once:
    # the trunk must be hit up there and no longer down here
    var lifted: Transform3D = placed
    lifted.position.z = placed.position.z + 30.0
    componentSet(this: world.transforms, entityId: treeEntityId, data: lifted)
    stepPhysicsBodies(physicsSystem: physicsSystem, transforms: world.transforms)
    let followed: Bool = rayHitsEntity(
      physicsSystem: physicsSystem
      entityId: treeEntityId
      foot: lifted.position
      height: 1.2
      halfSpan: 3.0
    ) and rayHitsEntity(
      physicsSystem: physicsSystem
      entityId: treeEntityId
      foot: placed.position
      height: 1.2
      halfSpan: 3.0
    ) is false
    componentSet(this: world.transforms, entityId: treeEntityId, data: placed)
    stepPhysicsBodies(physicsSystem: physicsSystem, transforms: world.transforms)
    let passed: Bool = blocksRay and stoppedAtBark and followed
    log(
      "[trunktest] blocksRay={blocksRay}, closest {closest} m from the trunk (stoppedAtBark={stoppedAtBark}), followed={followed}, passed={passed}"
    )
    ret passed
  }
  log("[trunktest] no placed tree, passed=false")
  ret false
}

# The placed prop of `kind` nearest to `point`, or none
func nearestProp(world: view GameWorld, kind: view Int, point: view Vec3) ret opt EntityId {
  var nearest: opt EntityId = none
  var nearestDistance: Float = 1000000.0
  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entityId: EntityId = componentEntityAt(this: world.propKinds, i: i)
    let prop: view TerrainProp => componentView(this: world.propKinds, entityId: entityId)
    if prop.kind is kind and prop.active {
      let gap: Vec3 = Vec3.vsub(
        a: componentView(this: world.transforms, entityId: entityId).position
        b: point
      )
      let distance: Float = Math.sqrt(x: gap.x * gap.x + gap.y * gap.y)
      if distance < nearestDistance {
        nearestDistance = distance
        nearest = entityId
      }
    }
  }
  ret nearest
}

# The rock and bush nearest the hero (app3d/WalkerPhysicsChecks.runRockBushCheck)
func runRockBushTest(
  physicsSystem: mod WalkerPhysics
  world: mod GameWorld
  heroEntityId: view EntityId
) ret Bool {
  let heroFeet: Vec3 = controllerFeet(
    controller: controllerOf(world: world, entityId: heroEntityId)
    groundZ: physicsSystem.groundZ
  )
  var hasRock: Bool = false
  var rockEntityId: EntityId = noEntity()
  if let found: EntityId = nearestProp(world: world, kind: kindRock, point: heroFeet) {
    hasRock = true
    rockEntityId = found
  }
  var hasBush: Bool = false
  var bushFoot: Vec3 = heroFeet
  if let found: EntityId = nearestProp(world: world, kind: kindBush, point: heroFeet) {
    hasBush = true
    # The bush stands 5 cm into the ground (TerrainSystem.kindTransform)
    let bush: Vec3 = componentView(this: world.transforms, entityId: found).position
    bushFoot = Vec3.create(x: bush.x, y: bush.y, z: bush.z + 0.05)
  }
  ret runRockBushCheck(
    physicsSystem: physicsSystem
    transforms: world.transforms
    controllers: world.controllers
    bushes: bushSpots(world: world)
    heroEntityId: heroEntityId
    hasRock: hasRock
    rockEntityId: rockEntityId
    hasBush: hasBush
    bushFoot: bushFoot
  )
}

func runPhysicsSelfTest(
  physicsSystem: mod WalkerPhysics
  world: mod GameWorld
  heroEntityId: view EntityId
  groundZ: view Float
) ret Int {
  let check: CubeJumpCheck = runCubeJumpCheck(
    physicsSystem: physicsSystem
    transforms: world.transforms
    controllers: world.controllers
    bushes: bushSpots(world: world)
    heroEntityId: heroEntityId
  )
  let trunksHeld: Bool = runTreeTrunkTest(
    physicsSystem: physicsSystem
    world: world
    heroEntityId: heroEntityId
  )
  let rocksAndBushesHeld: Bool = runRockBushTest(
    physicsSystem: physicsSystem
    world: world
    heroEntityId: heroEntityId
  )
  let passed: Bool = cubeJumpCheckPassed(check: check) and trunksHeld and rocksAndBushesHeld
  log("[physicstest] {cubeJumpCheckText(check: check)}, passed={passed}")
  if passed {
    ret 0
  }
  ret 1
}
