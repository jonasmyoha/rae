# Walker character — a multi-primitive rigged glTF model, ANIMATED, walking
# the island under a deferred+toon renderer, with the FFT sea round it.
#
# The app is the walker app shell lib/app3d/WalkerApp; this example is its
# settings: the island (WalkerLand.island) on the deferred renderer. Its
# siblings are 137 (the same island, forward renderer) and 143 (the wide
# forest). The assets in assets/ are shared by all three.
#
# Compiled-target only; needs wgpu-native + SDL3.
#   rae run examples/136_walker_character/Main.rae
# Headless screenshot:
#   RAE_SDL_HEADLESS_MS=1000 RAE_GPU2D_SCREENSHOT=/tmp/walker.bmp \
#     rae run examples/136_walker_character/Main.rae
open app3d/WalkerAppRun
open app3d/WalkerAppSetup

func main() ret Int {
  let settings: WalkerAppSettings = {
    title: "136: Rae 3D — walker character (animated) [deferred]"
    appId: "136_walker_character"
    assets: "examples/136_walker_character/assets/"
    forward: false
    land: WalkerLand.island
  }
  ret runWalkerApp(settings: settings)
}
