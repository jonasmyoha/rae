# Fixed-size infinite meadow used by the walker example.
#
# #741 rewrite: the terrain props and heightfield tiles are ECS entities in the
# shared GameWorld (recycled, generational ids) — NOT parallel pool Lists synced
# by poolIndex, and NOT scale-to-0 culling. Each entity carries a `TerrainProp`
# {kind, slot, active}; trees carry a `TreeVariant` {species}; tiles carry a
# `TileMesh` {meshId}. Placement, draw and shadow-cast are all QUERIES over these
# tables. Transforms are quaternion `Transform3D` (lib/ecs), consistent with the
# rest of the GameWorld — Euler is only ever an editor-authoring concern.
#
# The pool is allocated once; crossing a cell boundary re-places those same
# entities onto the square of world cells around the character. The trees are
# not in the pool: the island's forest is planted once (terrainSystem/Forest).
import RendererDeferred
import Math
import Noise
open WorldBiome
import Vec3
import Quat
import Gbuffer
open GbufferTerrain
open gpu/GpuResources
open Gltf
open Scene3d
open Mesh3d
open GbufferInstanced
open ecs/Entity
open ecs/ComponentTable
open ecs/Query
open ecs/Transform
open terrainSystem/WalkerTrees
open terrainSystem/WalkerRocks
open app3d/PropField
open GbufferSprite

# Single source of truth for the ground colour: the terrain ground material AND
# the GPU grass gradient's bottom both read this, so the grass roots match ground.
func walkerGroundColor() ret Vec3 {
  ret Vec3.create(x: 0.080, y: 0.245, z: 0.015)
}

const terrainGridSide: Int = 7

const terrainCellSize: Float = 18.0

const terrainHalfGrid: Int = 3

const terrainCellCount: Int = 49

const terrainTau: Float = 6.283185307179586

const terrainTileSegments: Int = 24

const terrainTileVerts: Int = (terrainTileSegments + 1) * (terrainTileSegments + 1)

const terrainTileFloats: Int = terrainTileVerts * 8

# Prop kinds (the TerrainProp.kind discriminator).
const kindTile: Int = 0

const kindTree: Int = 1

const kindRock: Int = 2

const kindBush: Int = 3

const kindFlower: Int = 4

const kindGrassA: Int = 5

const kindGrassB: Int = 6

# The height field IS the biome elevation field (lib/world_biome).
func terrainHeightAt(x: view Float, y: view Float, groundZ: view Float) ret Float {
  ret worldTerrainHeight(
    x: x
    y: y
    groundZ: groundZ
    cfg: defaultBiomeConfig()
  )
}

const propGrassMin: Float = 0.45

# Nothing stands in the sea, and vegetation wants grass under it.
func terrainPropAllowed(x: view Float, y: view Float, minGrass: view Float) ret Bool {
  ret worldPropAllowed(
    x: x
    y: y
    minGrass: minGrass
    cfg: defaultBiomeConfig()
  )
}

# ----- ECS components (#741) -----------------------------------------
# A terrain prop / tile entity: which kind it is, which pool slot it occupies,
# and whether it is currently placed on valid ground (props over water are
# inactive and simply not gathered — no scale-to-0).
type TerrainProp {
  kind: Int
  slot: Int
  active: Bool
  # Which shape a rock is (terrainSystem/WalkerRocks); 0 for the other kinds
  variant: Int
}

# A tree's species (terrainSystem/WalkerTrees: the leaf-patch forms, the
# autumn broadleaves or the palm), chosen where it is planted (Forest).
type TreeVariant {
  species: Int
}

# A tile entity's unique heightfield mesh (rewritten in place on recycle).
type TileMesh {
  meshId: Int
}

# ----- instanced prop rendering --------------------------------------
# The trees and bushes are the lib's leaf-patch forms (terrainSystem/WalkerTrees);
# the rocks are the lib's procedural rocks (terrainSystem/WalkerRocks); the
# flowers and grass tufts are glb meshes.
type TerrainSystem {
  centreCellX: Int
  centreCellY: Int
  groundZ: Float
  toon: Bool
  # Reused staging buffer for a tile's per-cell heightfield rewrite.
  scratchVerts: List(Float)
  # One instancer per rock shape (TerrainProp.variant)
  rockParts: List(PropInstancer)
  flowerProp: PropInstancer
  grassProp: PropInstancer
  # The island's forest (terrainSystem/Forest): every tree species as a kind
  # at three levels of detail, its placements in cells; only what is near and
  # in view is drawn, one instanced draw per species, level and part
  forest: PropField
  # The sprite pass the forest's far level (its billboards) is drawn with
  sprites: SpriteCache
  # The bush's three leaf tones
  bushParts: List(PropInstancer)
}

func terrainMesh(renderer: mod DeferredRenderer, path: view String) ret MeshHandle {
  let model: Glb = loadGlb(path: path)
  let mesh: MeshData = loadAllPrimitives(glb: model)
  if mesh.vertCount < 1 {
    log("[terrain] no mesh data in {path}")
    ret meshHandleNone()
  }
  ret RendererDeferred.uploadMesh(
    renderer: renderer
    verts: mesh.verts
    vertCount: mesh.vertCount
    indices: mesh.indices
  )
}

func terrainHash(cellX: view Int, cellY: view Int, seed: view Int) ret Float {
  ret Noise.hash2(x: cellX, y: cellY, seed: seed)
}

func terrainOffset(cellX: view Int, cellY: view Int, seed: view Int) ret Float {
  ret (terrainHash(cellX: cellX, cellY: cellY, seed: seed) - 0.5) * 12.0
}

func terrainScale(
  cellX: view Int
  cellY: view Int
  seed: view Int
  minimum: view Float
  spread: view Float
) ret Float {
  ret minimum + terrainHash(cellX: cellX, cellY: cellY, seed: seed) * spread
}

# A prop's placement transform for its cell: scattered x/y, height-sampled z, a
# yaw quaternion about +Z, uniform scale. (Editor-Euler is never involved.)
func propTransform3D(
  cellX: view Int
  cellY: view Int
  seedX: view Int
  seedY: view Int
  seedScale: view Int
  groundZ: view Float
  minScale: view Float
  scaleSpread: view Float
) ret Transform3D {
  let scale: Float = terrainScale(
    cellX: cellX
    cellY: cellY
    seed: seedScale
    minimum: minScale
    spread: scaleSpread
  )
  let posX: Float = cellX.toFloat() * terrainCellSize + terrainOffset(
    cellX: cellX
    cellY: cellY
    seed: seedX
  )
  let posY: Float = cellY.toFloat() * terrainCellSize + terrainOffset(
    cellX: cellX
    cellY: cellY
    seed: seedY
  )
  let yaw: Float = terrainHash(cellX: cellX, cellY: cellY, seed: seedScale + 71) * terrainTau
  ret Transform3D {
    position: Vec3.create(x: posX, y: posY, z: terrainHeightAt(x: posX, y: posY, groundZ: groundZ))
    rotation: Quat.fromAxisAngle(axis: Vec3.create(x: 0.0, y: 0.0, z: 1.0), angle: yaw)
    scale: Vec3.create(x: scale, y: scale, z: scale)
  }
}

# A rock's placement, as Autumn Grove places its rocks: 0.5 to 1.3 m across,
# stretched along one side, flattened when small, sunk a fifth of its size
# into the ground and turned at random.
func rockTransform(cellX: view Int, cellY: view Int, groundZ: view Float) ret Transform3D {
  let size: Float = 0.5 + terrainHash(cellX: cellX, cellY: cellY, seed: 41) * 0.8
  let stretch: Float = 1.0 + terrainHash(cellX: cellX, cellY: cellY, seed: 43) * 0.35
  var height: Float = 0.8
  if size > 0.7 {
    height = 1.0
  }
  let posX: Float = cellX.toFloat() * terrainCellSize + terrainOffset(
    cellX: cellX
    cellY: cellY
    seed: 31
  )
  let posY: Float = cellY.toFloat() * terrainCellSize + terrainOffset(
    cellX: cellX
    cellY: cellY
    seed: 37
  )
  let yaw: Float = terrainHash(cellX: cellX, cellY: cellY, seed: 61) * terrainTau
  ret Transform3D {
    position: Vec3.create(
      x: posX
      y: posY
      z: terrainHeightAt(x: posX, y: posY, groundZ: groundZ) - size * 0.2
    )
    rotation: Quat.fromAxisAngle(axis: Vec3.create(x: 0.0, y: 0.0, z: 1.0), angle: yaw)
    scale: Vec3.create(x: size * stretch, y: size, z: size * height)
  }
}

# Which rock shape stands in a cell
func rockVariantAt(cellX: view Int, cellY: view Int) ret Int {
  let pick: Int = (terrainHash(cellX: cellX, cellY: cellY, seed: 67) * rockVariantCount.toFloat()).toInt()
  ret Math.min(a: pick, b: rockVariantCount - 1)
}

# The prop transform for a given kind (per-kind scatter seeds + scale range).
func kindTransform(
  kind: view Int
  cellX: view Int
  cellY: view Int
  groundZ: view Float
) ret Transform3D {
  if kind is kindRock {
    ret rockTransform(cellX: cellX, cellY: cellY, groundZ: groundZ)
  }
  if kind is kindBush {
    ret propTransform3D(
      cellX: cellX
      cellY: cellY
      seedX: 47
      seedY: 53
      seedScale: 59
      groundZ: groundZ - 0.05
      minScale: 1.5
      scaleSpread: 0.9
    )
  }
  if kind is kindFlower {
    ret propTransform3D(
      cellX: cellX
      cellY: cellY
      seedX: 61
      seedY: 67
      seedScale: 71
      groundZ: groundZ + 0.015
      minScale: 0.35
      scaleSpread: 0.25
    )
  }
  if kind is kindGrassA {
    ret propTransform3D(
      cellX: cellX
      cellY: cellY
      seedX: 73
      seedY: 79
      seedScale: 83
      groundZ: groundZ
      minScale: 0.52
      scaleSpread: 0.30
    )
  }
  # kindGrassB
  ret propTransform3D(
    cellX: cellX
    cellY: cellY
    seedX: 89
    seedY: 97
    seedScale: 101
    groundZ: groundZ
    minScale: 0.38
    scaleSpread: 0.27
  )
}

# Rocks may stand on bare ground; everything else wants grass under it.
func kindMinGrass(kind: view Int) ret Float {
  if kind is kindRock {
    ret 0.0
  }
  ret propGrassMin
}

func slotCellX(centreCellX: view Int, slot: view Int) ret Int {
  ret centreCellX + (slot % terrainGridSide) - terrainHalfGrid
}

func slotCellY(centreCellY: view Int, slot: view Int) ret Int {
  ret centreCellY + (slot / terrainGridSide) - terrainHalfGrid
}

# Rewrite a tile's mesh so its vertices carry the ABSOLUTE world height of the
# cell it now covers. Normals from central differences of the height function.
func reshapeTerrainTile(
  terrainSystem: mod TerrainSystem
  renderer: mod DeferredRenderer
  meshId: view Int
  cellX: view Int
  cellY: view Int
) {
  if meshId < 1 {
    ret
  }
  let tileSize: Float = terrainCellSize + 0.04
  let centreX: Float = cellX.toFloat() * terrainCellSize
  let centreY: Float = cellY.toFloat() * terrainCellSize
  let eps: Float = 0.6
  loop var yi: Int = 0, yi <= terrainTileSegments, ++yi {
    let fy: Float = yi.toFloat() / terrainTileSegments.toFloat()
    let localY: Float = (fy - 0.5) * tileSize
    let worldY: Float = centreY + localY
    loop var xi: Int = 0, xi <= terrainTileSegments, ++xi {
      let fx: Float = xi.toFloat() / terrainTileSegments.toFloat()
      let localX: Float = (fx - 0.5) * tileSize
      let worldX: Float = centreX + localX
      let height: Float = terrainHeightAt(x: worldX, y: worldY, groundZ: terrainSystem.groundZ)
      let slopeX: Float = (terrainHeightAt(
        x: worldX + eps
        y: worldY
        groundZ: terrainSystem.groundZ
      ) - terrainHeightAt(x: worldX - eps, y: worldY, groundZ: terrainSystem.groundZ)) / (eps * 2.0)
      let slopeY: Float = (terrainHeightAt(
        x: worldX
        y: worldY + eps
        groundZ: terrainSystem.groundZ
      ) - terrainHeightAt(x: worldX, y: worldY - eps, groundZ: terrainSystem.groundZ)) / (eps * 2.0)
      let inverseLength: Float = 1.0 / Math.sqrt(x: slopeX * slopeX + slopeY * slopeY + 1.0)
      let base: Int = (yi * (terrainTileSegments + 1) + xi) * 8
      terrainSystem.scratchVerts.set(index: base, value: localX)
      terrainSystem.scratchVerts.set(index: base + 1, value: localY)
      terrainSystem.scratchVerts.set(index: base + 2, value: height)
      terrainSystem.scratchVerts.set(index: base + 3, value: 0.0 - slopeX * inverseLength)
      terrainSystem.scratchVerts.set(index: base + 4, value: 0.0 - slopeY * inverseLength)
      terrainSystem.scratchVerts.set(index: base + 5, value: inverseLength)
      terrainSystem.scratchVerts.set(index: base + 6, value: fx)
      terrainSystem.scratchVerts.set(index: base + 7, value: fy)
    }
  }
  RendererDeferred.updateMeshVerts(
    renderer: renderer
    mesh: meshHandle(id: meshId, generation: 0)
    verts: terrainSystem.scratchVerts
    vertCount: terrainTileVerts
  )
}

# ----- streaming -----------------------------------------------------
# Re-place every prop/tile entity onto the world cell its pool slot now maps to.
# A single query over the TerrainProp table drives placement; no per-slot,
# per-kind list bookkeeping.
func updateInfiniteTerrain(
  terrainSystem: mod TerrainSystem
  renderer: mod DeferredRenderer
  world: mod GameWorld
  playerPosition: view Vec3
) ret Bool {
  let cellX: Int = Math.floor(x: playerPosition.x / terrainCellSize).toInt()
  let cellY: Int = Math.floor(x: playerPosition.y / terrainCellSize).toInt()
  if cellX is terrainSystem.centreCellX and cellY is terrainSystem.centreCellY {
    ret false
  }
  terrainSystem.centreCellX = cellX
  terrainSystem.centreCellY = cellY

  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entityId: EntityId = componentEntityAt(this: world.propKinds, i: i)
    let pk: mod TerrainProp => queryModAt(table: world.propKinds, denseIndex: i)
    # The trees are planted once over the whole island (terrainSystem/Forest)
    if pk.kind is kindTree {
      continue
    }
    let ccx: Int = slotCellX(centreCellX: cellX, slot: pk.slot)
    let ccy: Int = slotCellY(centreCellY: cellY, slot: pk.slot)
    if pk.kind is kindTile {
      let tile: view TileMesh => componentView(this: world.tileMeshes, entityId: entityId)
      reshapeTerrainTile(
        terrainSystem: terrainSystem
        renderer: renderer
        meshId: tile.meshId
        cellX: ccx
        cellY: ccy
      )
      componentSet(
        this: world.transforms
        entityId: entityId
        data: Transform3D {
          position: Vec3.create(
            x: ccx.toFloat() * terrainCellSize
            y: ccy.toFloat() * terrainCellSize
            z: 0.0
          )
          rotation: Quat.identity()
          scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
        }
      )
    } else {
      let transform: Transform3D = kindTransform(
        kind: pk.kind
        cellX: ccx
        cellY: ccy
        groundZ: terrainSystem.groundZ
      )
      pk.active = terrainPropAllowed(
        x: transform.position.x
        y: transform.position.y
        minGrass: kindMinGrass(kind: pk.kind)
      )
      if pk.kind is kindRock {
        pk.variant = rockVariantAt(cellX: ccx, cellY: ccy)
      }
      componentSet(this: world.transforms, entityId: entityId, data: transform)
    }
  }
  ret true
}

# ----- draw (queries) ------------------------------------------------
func gatherKind(prop: mod PropInstancer, model: view Mat4) {
  addInstance(
    batch: prop.batch
    model: model
    prevModel: model
    material: prop.material
  )
}

func drawTerrainProps(
  cache: mod GbufferCache
  resources: mod GpuResources
  terrainSystem: mod TerrainSystem
  world: view GameWorld
) {
  loop let part: mod PropInstancer in terrainSystem.rockParts {
    resetInstanceBatch(batch: part.batch)
  }
  resetInstanceBatch(batch: terrainSystem.flowerProp.batch)
  resetInstanceBatch(batch: terrainSystem.grassProp.batch)
  loop let part: mod PropInstancer in terrainSystem.bushParts {
    resetInstanceBatch(batch: part.batch)
  }
  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entityId: EntityId = componentEntityAt(this: world.propKinds, i: i)
    let pk: view TerrainProp => queryViewAt(table: world.propKinds, denseIndex: i)
    if pk.active and pk.kind is not kindTile {
      let model: Mat4 = transform3dToMatrix(
        t: componentView(this: world.transforms, entityId: entityId)
      )
      if pk.kind is kindRock {
        if let rockPart: mod PropInstancer => terrainSystem.rockParts.modAt(index: pk.variant) {
          gatherKind(prop: rockPart, model: model)
        }
      }
      if pk.kind is kindBush {
        loop let part: mod PropInstancer in terrainSystem.bushParts {
          gatherKind(prop: part, model: model)
        }
      }
      if pk.kind is kindFlower {
        gatherKind(prop: terrainSystem.flowerProp, model: model)
      }
      if pk.kind is kindGrassA {
        gatherKind(prop: terrainSystem.grassProp, model: model)
      }
      if pk.kind is kindGrassB {
        gatherKind(prop: terrainSystem.grassProp, model: model)
      }
    }
  }
  loop let part: view PropInstancer in terrainSystem.rockParts {
    drawInstances(cache: cache, resources: resources, batch: part.batch)
  }
  drawInstances(cache: cache, resources: resources, batch: terrainSystem.flowerProp.batch)
  drawInstances(cache: cache, resources: resources, batch: terrainSystem.grassProp.batch)
  drawPropField(cache: cache, resources: resources, field: terrainSystem.forest)
  drawPropFieldSprites(
    cache: cache
    resources: resources
    field: terrainSystem.forest
    sprites: terrainSystem.sprites
  )
  loop let part: view PropInstancer in terrainSystem.bushParts {
    drawInstances(cache: cache, resources: resources, batch: part.batch)
  }
}

func drawTerrainGround(
  cache: mod GbufferCache
  resources: mod GpuResources
  terrainSystem: view TerrainSystem
  world: view GameWorld
  time: copy Float
) {
  loop var i: Int = 0, i < componentCount(this: world.tileMeshes), ++i {
    let entityId: EntityId = componentEntityAt(this: world.tileMeshes, i: i)
    let tile: view TileMesh => queryViewAt(table: world.tileMeshes, denseIndex: i)
    if tile.meshId >= 1 {
      # #745: Quat all the way — the tile's authoritative transform is already a
      # Quat Transform3D; compose it straight to a Mat4 (no Euler Vec3 detour).
      let q: view Transform3D => componentView(this: world.transforms, entityId: entityId)
      let model: Mat4 = transform3dToMatrix(t: q)
      drawTerrainMesh(
        cache: cache
        resources: resources
        mesh: tile.meshId
        model: model
        prevModel: model
        roughness: 0.96
        time: time
      )
    }
  }
}

func castKind(renderer: mod DeferredRenderer, mesh: view MeshHandle, model: view Mat4) {
  RendererDeferred.drawShadowCasterWith(renderer: renderer, mesh: mesh, model: model)
}

func drawTerrainPropsShadow(
  renderer: mod DeferredRenderer
  terrainSystem: view TerrainSystem
  world: view GameWorld
) {
  loop var i: Int = 0, i < componentCount(this: world.propKinds), ++i {
    let entityId: EntityId = componentEntityAt(this: world.propKinds, i: i)
    let pk: view TerrainProp => queryViewAt(table: world.propKinds, denseIndex: i)
    if pk.active and pk.kind is not kindTile {
      let model: Mat4 = transform3dToMatrix(
        t: componentView(this: world.transforms, entityId: entityId)
      )
      if pk.kind is kindRock {
        if let rockPart: view PropInstancer => terrainSystem.rockParts.viewAt(index: pk.variant) {
          castKind(renderer: renderer, mesh: rockPart.mesh, model: model)
        }
      }
      if pk.kind is kindBush {
        loop let part: view PropInstancer in terrainSystem.bushParts {
          castKind(renderer: renderer, mesh: part.mesh, model: model)
        }
      }
      if pk.kind is kindFlower {
        castKind(renderer: renderer, mesh: terrainSystem.flowerProp.mesh, model: model)
      }
      if pk.kind is kindGrassA {
        castKind(renderer: renderer, mesh: terrainSystem.grassProp.mesh, model: model)
      }
      if pk.kind is kindGrassB {
        castKind(renderer: renderer, mesh: terrainSystem.grassProp.mesh, model: model)
      }
    }
  }
  drawPropFieldShadows(renderer: renderer, field: terrainSystem.forest)
  drawPropFieldSpriteShadows(
    renderer: renderer
    field: terrainSystem.forest
    aspect: spritePictureAspect
    cutoff: spriteCutoff
  )
}

# Fill the forest's batches for this frame (before the shadow and G-buffer
# passes, which both draw them). The view cone is widened by about 34
# degrees, so a tree just outside the picture still casts its shadow into it.
func gatherForest(terrainSystem: mod TerrainSystem, camera: view Camera3d, aspect: view Float) {
  var propView: PropView = propViewOf(camera: camera, aspect: aspect)
  propView.halfAngle = Math.min(a: propView.halfAngle + 0.6, b: 3.0)
  gatherPropField(field: terrainSystem.forest, propView: propView, toon: terrainSystem.toon)
}

func setPropInstancerToon(prop: mod PropInstancer, toon: view Bool) {
  prop.material.toon = toon
}

func setInfiniteTerrainToon(terrainSystem: mod TerrainSystem, toon: view Bool) {
  if terrainSystem.toon is toon {
    ret
  }
  terrainSystem.toon = toon
  loop let part: mod PropInstancer in terrainSystem.rockParts {
    setPropInstancerToon(prop: part, toon: toon)
  }
  setPropInstancerToon(prop: terrainSystem.flowerProp, toon: toon)
  setPropInstancerToon(prop: terrainSystem.grassProp, toon: toon)
  loop let part: mod PropInstancer in terrainSystem.bushParts {
    setPropInstancerToon(prop: part, toon: toon)
  }
}

func terrainMaterial(color: view Vec3, roughness: view Float) ret Material3d {
  ret Material3d {
    baseColor: color
    metallic: 0.0
    roughness: roughness
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: true
  }
}

# Spawn one prop entity of `kind` for pool slot `slot`.
func spawnProp(world: mod GameWorld, kind: view Int, slot: view Int) ret EntityId {
  let entityId: EntityId = gameWorldAddEntity(world: world)
  componentSet(this: world.transforms, entityId: entityId, data: createTransform3D())
  componentSet(
    this: world.propKinds
    entityId: entityId
    data: TerrainProp { kind: kind, slot: slot, active: false, variant: 0 }
  )
  ret entityId
}

func createTerrainSystem(
  renderer: mod DeferredRenderer
  world: mod GameWorld
  assets: view String
  groundZ: view Float
) ret TerrainSystem {
  let tilePlane: MeshData = makePlane(size: terrainCellSize + 0.04, segments: terrainTileSegments)
  let flowerMesh: MeshHandle = terrainMesh(
    renderer: renderer
    path: "{assets}environment/flower.glb"
  )
  let grassMesh: MeshHandle = terrainMesh(renderer: renderer, path: "{assets}environment/grass.glb")

  let flowerMat: Material3d = terrainMaterial(
    color: Vec3.create(x: 0.92, y: 0.38, z: 0.045)
    roughness: 0.72
  )
  let grassMat: Material3d = terrainMaterial(
    color: Vec3.create(x: 0.18, y: 0.42, z: 0.055)
    roughness: 0.94
  )

  var scratch: List(Float) = List.create(Float, cap: terrainTileFloats)
  loop var scratchIndex: Int = 0, scratchIndex < terrainTileFloats, ++scratchIndex {
    scratch.add(value: 0.0)
  }

  # One entity per pool slot per kind: a tile (with its own heightfield mesh) plus
  # tree/rock/bush/flower/grassA/grassB. Recycled every stream, placed by query.
  loop var slot: Int = 0, slot < terrainCellCount, ++slot {
    let tileMesh: MeshHandle = uploadMeshDataForTerrain(renderer: renderer, mesh: tilePlane)
    let tileEntityId: EntityId = gameWorldAddEntity(world: world)
    componentSet(this: world.transforms, entityId: tileEntityId, data: createTransform3D())
    componentSet(
      this: world.propKinds
      entityId: tileEntityId
      data: TerrainProp { kind: kindTile, slot: slot, active: true, variant: 0 }
    )
    componentSet(
      this: world.tileMeshes
      entityId: tileEntityId
      data: TileMesh { meshId: tileMesh.id }
    )

    let unusedRock: EntityId = spawnProp(world: world, kind: kindRock, slot: slot)
    let unusedBush: EntityId = spawnProp(world: world, kind: kindBush, slot: slot)
    let unusedFlower: EntityId = spawnProp(world: world, kind: kindFlower, slot: slot)
    let unusedGrassA: EntityId = spawnProp(world: world, kind: kindGrassA, slot: slot)
    let unusedGrassB: EntityId = spawnProp(world: world, kind: kindGrassB, slot: slot)
  }

  # The forest's kinds now; its trees are planted once the spawn is known
  # (Forest.plantForest). The field covers the island and its shore.
  var forest: PropField = createPropField(
    originX: -100.0
    originY: -100.0
    size: 200.0
    cellSize: 20.0
  )
  var sprites: SpriteCache = createSpriteCache()
  addForestKinds(field: forest, renderer: renderer, sprites: sprites)
  var terrainSystem: TerrainSystem = {
    centreCellX: 1000000000
    centreCellY: 1000000000
    groundZ: groundZ
    toon: true
    scratchVerts: own scratch
    rockParts: own createRockParts(renderer: renderer, capacity: terrainCellCount)
    flowerProp: own createPropInstancer(
      mesh: flowerMesh
      material: flowerMat
      capacity: terrainCellCount
    )
    grassProp: own createPropInstancer(
      mesh: grassMesh
      material: grassMat
      capacity: terrainCellCount * 2
    )
    forest: own forest
    sprites: own sprites
    bushParts: own createBushParts(renderer: renderer, capacity: terrainCellCount)
  }
  ret own terrainSystem
}

func uploadMeshDataForTerrain(renderer: mod DeferredRenderer, mesh: view MeshData) ret MeshHandle {
  ret RendererDeferred.uploadMesh(
    renderer: renderer
    verts: mesh.verts
    vertCount: mesh.vertCount
    indices: mesh.indices
  )
}
