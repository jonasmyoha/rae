# Capture each character's rendered pose before the shared skeleton is reused.
import Vec3
open Particles
open Math3d
open GltfSkin
open ecs/Entity
open ecs/ComponentTable
open water/WaterContact
open water/WaterSystem
open water/FftSurfaceCache

type SplashFeet {
  leftPosition: Vec3
  rightPosition: Vec3
  left: WaterContact
  right: WaterContact
  leftCached: Bool
  rightCached: Bool
  sampled: Bool
}

func captureSplashFeet(
  characterSystem: view CharacterSystem
  world: mod GameWorld
  entityId: view EntityId
) {
  if characterSystem.leftFootNode < 0 or characterSystem.rightFootNode < 0 {
    ret
  }
  if not componentHas(this: world.splashFeet, entityId: entityId) {
    componentSet(this: world.splashFeet, entityId: entityId, data: SplashFeet {})
  }
  let model: Mat4 = walkerWorldModel(
    baseModel: characterSystem.basePartModel
    controller: controllerOf(world: world, entityId: entityId)
  )
  let left: Mat4 = mat4Mul(
    a: model
    b: nodeWorldMatrix(sk: characterSystem.skeleton, node: characterSystem.leftFootNode)
  )
  let right: Mat4 = mat4Mul(
    a: model
    b: nodeWorldMatrix(sk: characterSystem.skeleton, node: characterSystem.rightFootNode)
  )
  let feet: mod SplashFeet => componentMod(this: world.splashFeet, entityId: entityId)
  feet.leftPosition = Vec3.create(
    x: mat4Get(m: left, i: 12)
    y: mat4Get(m: left, i: 13)
    z: mat4Get(m: left, i: 14)
  )
  feet.rightPosition = Vec3.create(
    x: mat4Get(m: right, i: 12)
    y: mat4Get(m: right, i: 13)
    z: mat4Get(m: right, i: 14)
  )
  feet.sampled = true
}

func splashFootLevel(
  waterSystem: view WaterSystem
  position: view Vec3
  cached: mod Bool
) ret Float {
  loop let body: view WaterBody in waterSystem.bodies {
    if let sample: FftSurfaceSample = sampleFftSurface(
      cache: waterSystem.surfaceCache
      body: body
      x: position.x
      y: position.y
      now: waterSystem.time
      maxAge: 0.15
    ) {
      cached = true
      ret sample.height
    }
    cached = false
    ret body.centre.z
  }
  cached = false
  ret 0.0
}

func splashFeetStep(
  world: mod GameWorld
  particles: mod ParticleSystem
  waterSystem: view WaterSystem
  deltaTime: copy Float
) {
  loop var index: Int = 0, index < componentCount(this: world.splashFeet), ++index {
    let entityId: EntityId = componentEntityAt(this: world.splashFeet, i: index)
    let feet: mod SplashFeet => componentMod(this: world.splashFeet, entityId: entityId)
    if not feet.sampled {
      feet.left.initialized = false
      feet.right.initialized = false
      continue
    }
    feet.sampled = false
    let leftWetGround: Bool = terrainWaterDepth(x: feet.leftPosition.x, y: feet.leftPosition.y) > splashMinDepth
    let rightWetGround: Bool = terrainWaterDepth(x: feet.rightPosition.x, y: feet.rightPosition.y) > splashMinDepth
    if not leftWetGround and not rightWetGround {
      feet.left.initialized = false
      feet.right.initialized = false
      continue
    }
    var leftCached: Bool = false
    var rightCached: Bool = false
    let leftLevel: Float = splashFootLevel(
      waterSystem: waterSystem
      position: feet.leftPosition
      cached: leftCached
    )
    let rightLevel: Float = splashFootLevel(
      waterSystem: waterSystem
      position: feet.rightPosition
      cached: rightCached
    )
    if leftCached is not feet.leftCached {
      feet.left.initialized = false
    }
    if rightCached is not feet.rightCached {
      feet.right.initialized = false
    }
    feet.leftCached = leftCached
    feet.rightCached = rightCached
    if let event: WaterContactEvent = stepWaterContact(
      contact: feet.left
      position: feet.leftPosition
      level: leftLevel
      deltaTime: deltaTime
      available: leftWetGround
    ) {
      emitFootSplash(particles: particles, event: event)
    }
    if let event: WaterContactEvent = stepWaterContact(
      contact: feet.right
      position: feet.rightPosition
      level: rightLevel
      deltaTime: deltaTime
      available: rightWetGround
    ) {
      emitFootSplash(particles: particles, event: event)
    }
  }
}

func splashFootNode(skeleton: view Skeleton, name: view String) ret Int {
  if let node: Int = nodeByName(sk: skeleton, name: name) {
    ret node
  }
  log("[splash] missing foot bone: {name}")
  ret -1
}
