# Water spray driven by each rendered foot pose and its water contact.
# Only the isolated material preview uses a timer.
import Vec3
import Math
open WorldBiome
open Particles
open WaterParticles
open water/WaterContact
open water/WaterSystem
open ecs/Entity
open ecs/ComponentTable
open app3d/CharacterController

const splashMinDepth: Float = 0.03  # world units of water under a unit before it splashes

# A small fan: varied droplet sizes and launch speeds, no repeated cube clouds.
func emitSplashAt(
  particles: mod ParticleSystem
  x: copy Float
  y: copy Float
  waterZ: copy Float
) {
  let event: WaterContactEvent = {
    position: { x: x, y: y, z: waterZ }
    velocity: { z: -2.0 }
    strength: 1.0
  }
  emitFootSplash(particles: particles, event: event)
}

func emitFootSplash(particles: mod ParticleSystem, event: view WaterContactEvent) {
  let count: Int = 3 + (event.strength * 5.0).toInt()
  let x: Float = event.position.x
  let y: Float = event.position.y
  let waterZ: Float = event.position.z
  loop var index: Int = 0, index < count, ++index {
    let phase: Float = index.toFloat() * 2.399963 + x * 0.7 + y * 0.31
    let variation: Float = Math.abs(value: Math.sin(x: phase * 1.7))
    let speed: Float = (0.35 + variation) * event.strength
    let lift: Float = (0.7 + variation * 1.2) * Math.sqrt(x: event.strength)
    particleEmit(
      sys: particles
      x: x + Math.cos(x: phase) * 0.12
      y: y + Math.sin(x: phase) * 0.12
      z: waterZ + 0.025
      vx: Math.cos(x: phase) * speed + event.velocity.x * 0.35
      vy: Math.sin(x: phase) * speed + event.velocity.y * 0.35
      vz: lift
      life: 2.0 * lift / particles.gravity
      size: 0.018 + variation * 0.028
      r: 0.77
      g: 0.91
      b: 0.98
    )
  }
}

# Advance + emit splashes for everything wading this frame. Call once per frame.
func splashStep(
  splashes: mod ParticleSystem
  world: mod GameWorld
  waterSystem: view WaterSystem
  deltaTime: copy Float
) {
  if world.splashPreview.enabled and world.splashPreview.age >= 0.0 {
    splashes.list.clear()
    emitSplashAt(
      particles: splashes
      x: world.splashPreview.origin.x
      y: world.splashPreview.origin.y
      waterZ: world.splashPreview.origin.z
    )
    waterParticleUpdate(particles: splashes, deltaTime: world.splashPreview.age)
    ret
  }
  waterParticleUpdate(particles: splashes, deltaTime: deltaTime)
  if world.splashPreview.enabled {
    world.splashElapsed = world.splashElapsed + deltaTime
    if world.splashElapsed < 0.12 {
      ret
    }
    # At most one burst after a stall: never catch up with a huge emission spike.
    world.splashElapsed = world.splashElapsed - Math.floor(x: world.splashElapsed / 0.12) * 0.12

    emitSplashAt(
      particles: splashes
      x: world.splashPreview.origin.x
      y: world.splashPreview.origin.y
      waterZ: world.splashPreview.origin.z
    )
    ret
  }
  splashFeetStep(
    world: world
    particles: splashes
    waterSystem: waterSystem
    deltaTime: deltaTime
  )
}
