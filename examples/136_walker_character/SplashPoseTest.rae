# Exercise the shipped skeleton/clip, not an estimated walk-cycle phase.
import Vec3
open ecs/ComponentTable
open water/WaterContact

func runSplashPoseTest(characterSystem: mod CharacterSystem, world: mod GameWorld) ret Int {
  if characterSystem.leftFootNode < 0 or characterSystem.rightFootNode < 0 {
    ret 1
  }
  let origin: Vec3 = controllerOf(world: world, entityId: characterSystem.heroEntityId).position
  let level: Float = origin.z + characterSystem.groundZ + 0.12
  var left: WaterContact = {}
  var right: WaterContact = {}
  var leftEvents: Int = 0
  var rightEvents: Int = 0
  var airborneEvents: Int = 0
  loop var frame: Int = 0, frame < 180, ++frame {
    let palette: List(Float) = poseCharacterPalette(
      characterSystem: characterSystem
      clipIndex: ClipKind.walk as Int
      animTime: frame.toFloat() / 60.0
    )
    captureSplashFeet(
      characterSystem: characterSystem
      world: world
      entityId: characterSystem.heroEntityId
    )
    let feet: view SplashFeet => componentView(
      this: world.splashFeet
      entityId: characterSystem.heroEntityId
    )
    if let event: WaterContactEvent = stepWaterContact(
      contact: left
      position: feet.leftPosition
      level: level
      deltaTime: 1.0 / 60.0
      available: true
    ) {
      leftEvents = leftEvents + 1
    }
    if let event: WaterContactEvent = stepWaterContact(
      contact: right
      position: feet.rightPosition
      level: level
      deltaTime: 1.0 / 60.0
      available: true
    ) {
      rightEvents = rightEvents + 1
    }
  }
  # Hold the last rendered pose: no timer may keep generating spray.
  let feet: view SplashFeet => componentView(
    this: world.splashFeet
    entityId: characterSystem.heroEntityId
  )
  var pausedEvents: Int = 0
  loop var frame: Int = 0, frame < 60, ++frame {
    if let event: WaterContactEvent = stepWaterContact(
      contact: left
      position: feet.leftPosition
      level: level
      deltaTime: 1.0 / 60.0
      available: true
    ) {
      pausedEvents = pausedEvents + 1
    }
  }
  var air: WaterContact = {}
  loop var frame: Int = 0, frame < 60, ++frame {
    let position: Vec3 = { x: frame.toFloat() * 0.01, y: 0.0, z: level + 2.0 }
    if let event: WaterContactEvent = stepWaterContact(
      contact: air
      position: position
      level: level
      deltaTime: 1.0 / 60.0
      available: true
    ) {
      airborneEvents = airborneEvents + 1
    }
  }
  let ok: Bool = leftEvents > 0 and rightEvents > 0 and pausedEvents is 0 and airborneEvents is 0
  log(
    "[splash-pose] left={leftEvents} right={rightEvents} paused={pausedEvents} airborne={airborneEvents} ok={ok}"
  )
  if ok {
    ret 0
  }
  ret 1
}
