# A seeded autumn grove: leaf geometry, branching trees, stratified stones and meadow.
# All geometry is authored in Rae. The shared editor panel (app3d/EditorPanel)
# is the chrome: drag to orbit, wheel to zoom, the camera bar's mode button for
# the free WASD camera, the menu button for the settings (sky, time of day,
# shadows, the three views). Keys 1 / 2 / 3 pick the views too.
import Gpu2d
import Vec3
import Keys
import Sdl3
import Sys
open Scene3d
open ecs/Entity
open RendererDeferred
open Rendergraph
open Math3d
open Mesh3d
open Shadow3d
open Sky
open GroveScene
open Gpu2dCanvas
open app3d/CameraRig
open app3d/EditorPanel
open app3d/SettingsDialog
open app3d/UiShell
open ui/WindowGeometry
open HotReload

# The sun's three cascades, fitted to this frame's camera, with every mesh of
# the world as a caster. Without `castShadows` (the panel's shadow switch) the
# cascades stay empty, which is a frame without shadows.
func renderShadows(
  renderer: mod DeferredRenderer
  world: view World3d
  camera: view Camera3d
  light: view Light3d
  aspect: view Float
  castShadows: view Bool
) {
  let cascades: ShadowCascades = fitShadowCascades(
    camPos: camera.position
    camTarget: camera.target
    fovYDeg: camera.fovYDeg
    aspect: aspect
    near: camera.nearZ
    far: 60.0
    sunDir: light.sunDir
    count: 3
    resolution: 2048
    lambda: 0.7
    backExtent: 30.0
  )
  beginShadowPass(renderer: renderer, c: cascades)
  if castShadows {
    renderSceneShadowWorldWith(renderer: renderer, world: world)
  }
  endShadowPass(renderer: renderer)
}

# Everything the window keeps between frames, owned in one value that main's
# mainLoop advances once per frame (docs/web-frame-loop.md). In a browser the
# page runs the loop's body on each animation frame; natively it is a plain
# loop.
type ShowcaseState {
  renderer: DeferredRenderer
  sceneWorld: World3d
  light: Light3d
  camera: Camera3d
  cameraRig: CameraRig
  editorPanel: EditorPanel
  windowGeometry: WindowGeometry
  lastTime: Float64
}

# The window, the generated grove, the sky and the camera
func createShowcase() ret ShowcaseState {
  Gpu2d.initWindow(
    width: 1280
    height: 800
    title: "Autumn Grove | 1 Overview  2 Trees  3 Rocks | Drag to orbit"
  )
  # Remember where the user put the window, across restarts
  var windowGeometry: WindowGeometry = createWindowGeometry(
    dir: dir()
    name: "window.138_procgen_showcase.geometry"
  )
  restoreWindowGeometry(windowGeometry: windowGeometry)
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  let sceneWorld: World3d = buildGrove(renderer: renderer)

  # The settings start on the Preetham sky at a fixed mid-morning hour (the
  # clock runs from the panel), and the panel's scene chooser is the three views
  let initialView: Int = groveViewNumber(viewName: Sys.getEnv(name: "RAE_GROVE_VIEW"))
  var settings: SettingsState = createSettingsState(
    scene: initialView
    sceneCount: 3
    speed: 1.0
    toon: true
    hour: 10.0
    skyModel: SettingsSkyModel.preetham
  )
  settings.animateTime = false
  let editorPanel: EditorPanel = createEditorPanel(
    assetBase: "examples/136_walker_character/assets/"
    settings: settings
  )
  var light: Light3d = defaultLight3d()
  applyEditorPanelSettings(
    editorPanel: editorPanel
    renderer: renderer
    light: light
    sunStrength: groveSunStrength
  )
  light.ambSky = Vec3.create(x: 0.30, y: 0.37, z: 0.42)
  light.ambGround = Vec3.create(x: 0.15, y: 0.12, z: 0.09)

  var camera: Camera3d = defaultCamera3d()
  camera.target = Vec3.create(x: 0.0, y: 3.0, z: 1.7)
  camera.fovYDeg = 42
  camera.farZ = 600
  var cameraRig: CameraRig = createCameraRig(camera: camera)
  cameraRig.maxDistance = 55
  setGroveView(camera: camera, cameraRig: cameraRig, groveView: initialView)

  # The state takes the renderer's GPU handles with it: moved, never copied
  unsafe {
    ret ShowcaseState {
      renderer: own renderer
      sceneWorld: own sceneWorld
      light: light
      camera: camera
      cameraRig: cameraRig
      editorPanel: own editorPanel
      windowGeometry: own windowGeometry
      lastTime: Gpu2d.nowSeconds()
    }
  }
}

# The grove's materials are authored for a bright sun
const groveSunStrength: Float = 3.1

# The view RAE_GROVE_VIEW names: 1 the grove, 2 the trees, 3 the rocks
func groveViewNumber(viewName: view String) ret Int {
  if viewName is "trees" {
    ret 2
  }
  if viewName is "rocks" {
    ret 3
  }
  ret 1
}

# Presets are also the visual gate's reproducible inspection angles.
func setGroveView(camera: mod Camera3d, cameraRig: mod CameraRig, groveView: view Int) {
  cameraRig.mode = CameraRigMode.orbit
  camera.target = Vec3.create(x: 0, y: 3, z: 1.7)
  cameraRig.yaw = 0.10
  cameraRig.orbitPitch = 0.48
  cameraRig.distance = 34
  if groveView is 2 {
    camera.target = Vec3.create(x: -4.8, y: 2, z: 3.4)
    cameraRig.yaw = -0.5
    cameraRig.orbitPitch = 0.15
    cameraRig.distance = 13
  } else if groveView is 3 {
    camera.target = Vec3.create(x: -4.6, y: -2.2, z: 0.6)
    cameraRig.yaw = 0.6
    cameraRig.orbitPitch = 0.55
    cameraRig.distance = 12
  }
  snapCameraRigView(rig: cameraRig)
  applyCameraRig(rig: cameraRig, camera: camera)
}

# One frame: input, the camera, then the deferred graph's passes in their
# derived order
func runShowcaseFrame(state: mod ShowcaseState) {
  let now: Float64 = Gpu2d.nowSeconds()
  let deltaTime: Float = (now - state.lastTime) as Float
  state.lastTime = now

  let resized: Bool = Gpu2d.windowResized()
  updateWindowGeometry(windowGeometry: state.windowGeometry, now: now, resized: resized)
  let renderFrame: Bool = Gpu2d.renderGate()
  let shownView: Int = state.editorPanel.settings.scene
  let panelFrame: EditorPanelFrame = updateEditorPanel(
    editorPanel: state.editorPanel
    cameraRig: state.cameraRig
    camera: state.camera
    now: now
    deltaTime: deltaTime
    resized: resized
    rendered: renderFrame
  )
  if panelFrame.settingsChanged {
    applyEditorPanelSettings(
      editorPanel: state.editorPanel
      renderer: state.renderer
      light: state.light
      sunStrength: groveSunStrength
    )
  }
  # The views from the keys, kept in step with the panel's scene chooser
  if Sdl3.isKeyPressed(key: Keys.key1) {
    selectEditorPanelScene(editorPanel: state.editorPanel, scene: 1)
  } else if Sdl3.isKeyPressed(key: Keys.key2) {
    selectEditorPanelScene(editorPanel: state.editorPanel, scene: 2)
  } else if Sdl3.isKeyPressed(key: Keys.key3) {
    selectEditorPanelScene(editorPanel: state.editorPanel, scene: 3)
  }
  if state.editorPanel.settings.scene is not shownView {
    setGroveView(
      camera: state.camera
      cameraRig: state.cameraRig
      groveView: state.editorPanel.settings.scene
    )
  }
  if not renderFrame {
    ret
  }

  let renderer: mod DeferredRenderer => state.renderer
  let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
  gpuPassTimingBegin(renderer: renderer)
  loop var passIndex: Int = 0, passIndex < deferredOrderLength(renderer: renderer), ++passIndex {
    let tag: Int = deferredTagAt(renderer: renderer, i: passIndex)
    gpuPassMark(renderer: renderer, tag: tag)
    if tag is RenderTag.shadow {
      renderShadows(
        renderer: renderer
        world: state.sceneWorld
        camera: state.camera
        light: state.light
        aspect: aspect
        castShadows: state.editorPanel.settings.shadows
      )
    } else if tag is RenderTag.uiOverlay {
      drawEditorPanel(editorPanel: state.editorPanel, canvas: renderer.canvas)
    } else {
      renderDeferredPassWorld(
        renderer: renderer
        tag: tag
        world: state.sceneWorld
        camera: state.camera
        light: state.light
        aspect: aspect
      )
    }
  }
  gpuPassTimingEnd(renderer: renderer)
  world3dPrevTransformSystem(world: state.sceneWorld)
}

func endShowcase(state: mod ShowcaseState) {
  shutdownDeferredRenderer(renderer: state.renderer)
  Gbuffer.shutdownAll()
  Gpu2d.closeWindow()
}

func main() ret Int {
  var state: ShowcaseState = createShowcase()
  let graphStatus: Int = compileDeferred(renderer: state.renderer)
  if graphStatus is not 0 {
    log("render graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }
  mainLoop state {
    if Gpu2d.pollClose() {
      endShowcase(state: state)
      break
    }
    runShowcaseFrame(state: state)
  }
  ret 0
}
