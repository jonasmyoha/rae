# The same LOD0 prototype as the walkers: a small grove beside the path.
open app3d/GroveTrees
open RendererImages
open RendererDeferred
open FoliageMesh
open Scene3d
open Mesh3d
open Vec3
open ecs/Entity
open GroveGrass
open procgen/Birch

func addBirchGrove(
  world: mod World3d
  renderer: mod DeferredRenderer
  obstacles: mod List(GroveObstacle)
) {
  let layer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: "lib/assets/trees/birchBark.png"
  )
  let leafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: "lib/assets/trees/birchLeaves.png"
  )
  let colors: List(Vec3) = speciesAlbedos(species: speciesBirch)
  let positions: List(Vec3) = {
    { x: -16, y: -10, z: 0 }
    { x: -20, y: -7, z: 0 }
    { x: -23, y: -12, z: 0 }
    { x: -14, y: -16, z: 0 }
    { x: -26, y: -8, z: 0 }
  }
  let seeds: List(Int) = {
    1437
    311
    4201
    827
    2189
  }
  let heights: List(Float) = {
    7.1
    8.0
    6.6
    7.6
    8.4
  }
  loop var treeIndex: Int = 0, treeIndex < positions.length, ++treeIndex {
    let position: Vec3 = positions.copyAtDefault(index: treeIndex)
    let seed: Int = seeds.copyAtDefault(index: treeIndex)
    let tree: BirchTree = birchTree(seed: seed, height: heights.copyAtDefault(index: treeIndex))
    var meshes: List(MeshData) = List.create(MeshData, cap: 5)
    meshes.add(value: tree.wood)
    loop var tone: Int = 0, tone < 3, ++tone {
      meshes.add(value: birchLeaves(twigs: tree.twigs, seed: seed, tone: tone))
    }
    meshes.add(value: tree.twigWood)
    var handles: List(MeshHandle) = List.create(MeshHandle, cap: 5)
    loop let mesh: view MeshData in meshes {
      handles.add(value: uploadFoliage(renderer: renderer, mesh: mesh))
    }
    loop var part: Int = 0, part < handles.length, ++part {
      var material: Material3d = foliageMaterial(color: colors.copyAtDefault(index: part))
      if part is 0 {
        material.colorTextureLayer = layer
      } else if part < 4 {
        material.colorTextureLayer = leafLayer
      }
      let entityId: EntityId = world3dAddMeshInstance(
        world: world
        mesh: handles.copyAtDefault(index: part)
        material: material
        position: position
        rotation: Vec3.create(x: 0, y: 0, z: treeIndex.toFloat() * 1.7)
        scale: Vec3.create(x: 1, y: 1, z: 1)
      )
    }
    obstacles.add(value: { x: position.x, y: position.y, radius: 0.25 })
  }
  log("birch grove: 5 seeded trees, 6.6-8.4 m, joined forks and hanging painted sprays")
}
