# Forest kind 6 has its own named study. GroveScene's local green value 2
# remains the date palm; no numeric slot or existing specimen is repurposed.
import Sys
open app3d/GroveTrees
open procgen/Ginkgo
open procgen/Foliage
open RendererImages
open RendererDeferred
open FoliageMesh
open Scene3d
open Mesh3d
open Vec3
open ecs/Entity
open GroveGrass

func addGinkgoGrove(
  world: mod World3d
  renderer: mod DeferredRenderer
  obstacles: mod List(GroveObstacle)
) {
  let isolated: Bool = Sys.getEnv(name: "RAE_GINKGO_ISOLATE") is "1"
  let control: Bool = Sys.getEnv(name: "RAE_GINKGO_CONTROL") is "1"
  let bare: Bool = Sys.getEnv(name: "RAE_GINKGO_BARE") is "1"
  let positions: List(Vec3) = {
    { x: 13, y: -8, z: 0 }
    { x: 19, y: -4, z: 0 }
    { x: 16, y: 2, z: 0 }
  }
  let seeds: List(Int) = { 1125, 311, 2189 }
  let heights: List(Float) = { 5.5, 4.6, 6.2 }
  let barkLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: ginkgoBarkTexture())
  let leafLayer: Int = rendererLoadSurfaceImage(renderer: renderer, path: ginkgoLeafTexture())
  loop var treeIndex: Int = 0, treeIndex < positions.length, ++treeIndex {
    if isolated and treeIndex > 0 {
      continue
    }
    var seed: Int = seeds.copyAtDefault(index: treeIndex)
    var height: Float = heights.copyAtDefault(index: treeIndex)
    if isolated and Sys.getEnv(name: "RAE_GINKGO_SEED").length() > 0 {
      seed = Sys.getEnv(name: "RAE_GINKGO_SEED").toInt()
    }
    if isolated and Sys.getEnv(name: "RAE_GINKGO_HEIGHT").length() > 0 {
      height = Sys.getEnv(name: "RAE_GINKGO_HEIGHT").toFloat()
    }
    var parts: List(MeshData) = List.create(MeshData, cap: 4)
    if control {
      let tree: BroadleafTree = broadleafTree(seed: seed, height: height, width: 2)
      parts.add(value: tree.wood)
      loop var tone: Int = 0, tone < 3, ++tone {
        parts.add(value: broadleafLeaves(
          tips: tree.tips
          seed: seed
          height: height
          width: 2
          tone: tone
          leafCount: nearLeaves
        ))
      }
    } else {
      let tree: GinkgoTree = ginkgoTree(seed: seed, height: height, width: 2)
      parts.add(value: tree.wood)
      loop var tone: Int = 0, tone < 3, ++tone {
        parts.add(value: ginkgoLeaves(tree: tree, seed: seed, tone: tone))
      }
    }
    var triangles: Int = 0
    var vertices: Int = 0
    loop var part: Int = 0, part < parts.length, ++part {
      let mesh: MeshData = parts.copyAtDefault(index: part)
      triangles = triangles + mesh.indices.length / 3
      vertices = vertices + mesh.vertCount
      if bare and part > 0 {
        continue
      }
      var material: Material3d = foliageMaterial(color: ginkgoWoodColor())
      material.colorTextureLayer = barkLayer
      if part > 0 {
        material.baseColor = ginkgoLeafColor(tone: part - 1)
        material.colorTextureLayer = leafLayer
      }
      if control {
        material.colorTextureLayer = -1
        material.baseColor = speciesWoodColor()
        if part > 0 {
          material.baseColor = autumnLeafColor(species: speciesGold, tone: part - 1)
        }
      }
      let meshHandle: MeshHandle = uploadFoliage(renderer: renderer, mesh: mesh)
      let entityId: EntityId = world3dAddMeshInstance(
        world: world
        mesh: meshHandle
        material: material
        position: positions.copyAtDefault(index: treeIndex)
        rotation: Vec3.create(x: 0, y: 0, z: 0)
        scale: Vec3.create(x: 1, y: 1, z: 1)
      )
    }
    let position: Vec3 = positions.copyAtDefault(index: treeIndex)
    obstacles.add(value: { x: position.x, y: position.y, radius: 0.35 })
    log(
      "[ginkgo] kind=6 seed={seed} height={height} vertices={vertices} triangles={triangles} control={control}"
    )
  }
}
