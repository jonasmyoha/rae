# All placement and material choices belong to this example. Shared generators
# and renderer defaults are untouched. Every visible object is a World3d entity;
# the grass is the lib GPU grass (GroveGrass), kept out of the rocks and trunks.
import Math
open Vec3
open Noise
open Mesh3d
open Scene3d
open RendererDeferred
open procgen/Foliage
open GroveGrass
open procgen/Rock
open ecs/Entity

# The island's grass-ground colour; the GPU grass's blades grow from it
const groveGroundRed: Float = 0.13

const groveGroundGreen: Float = 0.23

const groveGroundBlue: Float = 0.055

func paint(red: view Float, green: view Float, blue: view Float) ret Material3d {
  ret Material3d {
    baseColor: Vec3.create(x: red, y: green, z: blue)
    metallic: 0
    roughness: 1
    emission: Vec3.create(x: 0, y: 0, z: 0)
    toon: true
  }
}

func place(
  world: mod World3d
  renderer: mod DeferredRenderer
  mesh: view MeshData
  material: view Material3d
  position: view Vec3
  scale: view Vec3
  rotation: view Float
) {
  let handle: MeshHandle = uploadMesh(
    renderer: renderer
    verts: mesh.verts
    vertCount: mesh.vertCount
    indices: mesh.indices
  )
  let entityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: handle
    material: material
    position: position
    rotation: Vec3.create(x: 0, y: 0, z: rotation)
    scale: scale
  )
}

func foliagePaint(species: view Int, tone: view Int) ret Material3d {
  let variation: Float = 0.85 + tone.toFloat() * 0.13
  if species is 0 {
    ret paint(red: 0.86 * variation, green: 0.39 * variation, blue: 0.022)
  }
  if species is 1 {
    ret paint(red: 0.72 * variation, green: 0.13 * variation, blue: 0.025)
  }
  if species is 2 {
    ret paint(red: 0.28 * variation, green: 0.42 * variation, blue: 0.045)
  }
  ret paint(red: 0.33 * variation, green: 0.035 * variation, blue: 0.022)
}

# One tree: the wood, then its leaves in three tones. `palm` keeps the
# palm-style stem (palmWood); every other tree has ordinary branching wood
# (broadleafTree).
func plantTree(
  world: mod World3d
  renderer: mod DeferredRenderer
  position: view Vec3
  height: view Float
  width: view Float
  seed: view Int
  species: view Int
  palm: view Bool
) {
  let bark: Material3d = paint(red: 0.16, green: 0.073, blue: 0.039)
  let unit: Vec3 = Vec3.create(x: 1, y: 1, z: 1)
  if palm {
    let wood: MeshData = palmWood(seed: seed, height: height, width: width)
    place(
      world: world
      renderer: renderer
      mesh: wood
      material: bark
      position: position
      scale: unit
      rotation: 0
    )
    loop var tone: Int = 0, tone < 3, ++tone {
      let leaves: MeshData = palmLeaves(
        seed: seed
        height: height
        width: width
        tone: tone
        leafCount: fullLeafCount
      )
      place(
        world: world
        renderer: renderer
        mesh: leaves
        material: foliagePaint(species: species, tone: tone)
        position: position
        scale: unit
        rotation: 0
      )
    }
    ret
  }
  let tree: BroadleafTree = broadleafTree(seed: seed, height: height, width: width)
  place(
    world: world
    renderer: renderer
    mesh: tree.wood
    material: bark
    position: position
    scale: unit
    rotation: 0
  )
  loop var tone: Int = 0, tone < 3, ++tone {
    let leaves: MeshData = broadleafLeaves(
      tips: tree.tips
      seed: seed
      height: height
      width: width
      tone: tone
      leafCount: fullLeafCount
    )
    place(
      world: world
      renderer: renderer
      mesh: leaves
      material: foliagePaint(species: species, tone: tone)
      position: position
      scale: unit
      rotation: 0
    )
  }
}

func pathCenter(distance: view Float) ret Float {
  ret Math.sin(x: distance * 0.27) * 1.8 + 0.8
}

func groundHeight(x: view Float, y: view Float) ret Float {
  let radius: Float = Math.sqrt(x: x * x / 190.44 + (y - 2) * (y - 2) / 156.25)
  let base: Float = 0.12 * Math.sin(x: x * 0.36) * Math.sin(x: y * 0.3)
  if radius > 0.9167 {
    ret base * (1 - (radius - 0.9167) * 12) - 0.35 * (radius - 0.9167) * 12
  }
  ret base
}

func islandPoint(ring: view Int, index: view Int) ret Vec3 {
  let angle: Float = index.toFloat() * 6.2831853 / 128
  let fraction: Float = ring.toFloat() / 12
  let x: Float = Math.cos(x: angle) * 13.8 * fraction
  let y: Float = 2.0 + Math.sin(x: angle) * 12.5 * fraction
  var height: Float = groundHeight(x: x, y: y)
  if ring is 12 {
    height = -0.35
  }
  ret Vec3.create(x: x, y: y, z: height)
}

func gardenGround() ret MeshData {
  var mesh: MeshData = foliageMesh()
  loop var ring: Int = 0, ring < 12, ++ring {
    loop var i: Int = 0, i < 128, ++i {
      let first: Vec3 = islandPoint(ring: ring, index: i)
      let second: Vec3 = islandPoint(ring: ring + 1, index: i)
      let third: Vec3 = islandPoint(ring: ring, index: i + 1)
      let fourth: Vec3 = islandPoint(ring: ring + 1, index: i + 1)
      foliageFace(
        mesh: mesh
        first: first
        second: second
        third: third
      )
      foliageFace(
        mesh: mesh
        first: third
        second: second
        third: fourth
      )
    }
  }
  ret mesh
}

func gardenEdge() ret MeshData {
  var mesh: MeshData = foliageMesh()
  loop var i: Int = 0, i < 128, ++i {
    let top: Vec3 = islandPoint(ring: 12, index: i)
    let next: Vec3 = islandPoint(ring: 12, index: i + 1)
    let bottom: Vec3 = Vec3.create(x: top.x * 0.99, y: top.y, z: -1.15)
    let bottomNext: Vec3 = Vec3.create(x: next.x * 0.99, y: next.y, z: -1.15)
    foliageFace(
      mesh: mesh
      first: top
      second: bottom
      third: next
    )
    foliageFace(
      mesh: mesh
      first: next
      second: bottom
      third: bottomNext
    )
  }
  ret mesh
}

func gardenPath() ret MeshData {
  var mesh: MeshData = foliageMesh()
  loop var i: Int = 0, i < 48, ++i {
    let front: Float = i.toFloat() * 0.5 - 10.4
    let back: Float = front + 0.5
    let left: Float = pathCenter(distance: front) - 0.9
    let right: Float = pathCenter(distance: back) - 0.9
    let first: Vec3 = Vec3.create(x: left, y: front, z: groundHeight(x: left, y: front) + 0.025)
    let second: Vec3 = Vec3.create(
      x: left + 1.8
      y: front
      z: groundHeight(x: left + 1.8, y: front) + 0.025
    )
    let third: Vec3 = Vec3.create(x: right, y: back, z: groundHeight(x: right, y: back) + 0.025)
    let fourth: Vec3 = Vec3.create(
      x: right + 1.8
      y: back
      z: groundHeight(x: right + 1.8, y: back) + 0.025
    )
    foliageFace(
      mesh: mesh
      first: first
      second: second
      third: third
    )
    foliageFace(
      mesh: mesh
      first: third
      second: second
      third: fourth
    )
  }
  ret mesh
}

# A tree's place and shape
type GroveTreeSpot {
  x: Float
  y: Float
  height: Float
  width: Float
  seed: Int
  species: Int
  palm: Bool
}

func groveTreeSpots() ret List(GroveTreeSpot) {
  ret List(GroveTreeSpot) {
    {
      x: -4.8
      y: 2
      height: 4.7
      width: 2.05
      seed: 501
      species: 0
      palm: false
    }
    {
      x: 4.2
      y: 4
      height: 5.8
      width: 1.8
      seed: 605
      species: 1
      palm: false
    }
    {
      x: -0.9
      y: 8
      height: 6.4
      width: 1.7
      seed: 710
      species: 0
      palm: false
    }
    {
      x: -8.1
      y: 7.5
      height: 4.2
      width: 1.8
      seed: 301
      species: 3
      palm: false
    }
    {
      x: 7.5
      y: 9
      height: 5.2
      width: 2.1
      seed: 903
      species: 2
      palm: true
    }
    {
      x: 5.8
      y: -1.8
      height: 2.6
      width: 1.15
      seed: 217
      species: 0
      palm: false
    }
  }
}

# A rock's place: its centre on the ground, its size (about its radius) and
# the seed of its shape
type GroveRock {
  x: Float
  y: Float
  size: Float
  seed: Int
}

# Groups of rocks around the island: one big rock with smaller ones around
# it. `cx`, `cy` the group's centre, `size` the big rock's.
func addRockGroup(
  rocks: mod List(GroveRock)
  cx: view Float
  cy: view Float
  size: view Float
  smallCount: view Int
  seed: view Int
) {
  rocks.add(value: { x: cx, y: cy, size: size, seed: seed })
  loop var i: Int = 0, i < smallCount, ++i {
    let angle: Float = i.toFloat() * 2.39996 + hash2(x: i, y: 1, seed: seed) * 0.8
    let distance: Float = size * (1.25 + hash2(x: i, y: 2, seed: seed) * 0.7)
    rocks.add(
      value: {
        x: cx + Math.cos(x: angle) * distance
        y: cy + Math.sin(x: angle) * distance
        size: size * (0.28 + hash2(x: i, y: 3, seed: seed) * 0.3)
        seed: seed + 13 + i * 7
      }
    )
  }
}

func groveRocks() ret List(GroveRock) {
  var rocks: List(GroveRock) = List.create(GroveRock, cap: 64)
  # The outcrop by the path, the biggest group
  addRockGroup(
    rocks: rocks
    cx: -5.2
    cy: -2.6
    size: 1.6
    smallCount: 5
    seed: 230
  )
  addRockGroup(
    rocks: rocks
    cx: -3.5
    cy: -1.4
    size: 0.85
    smallCount: 2
    seed: 247
  )
  # Smaller groups spread over the island, clear of the path and the trees
  addRockGroup(
    rocks: rocks
    cx: 8.0
    cy: 2.4
    size: 0.85
    smallCount: 3
    seed: 311
  )
  addRockGroup(
    rocks: rocks
    cx: -10.0
    cy: 2.4
    size: 0.75
    smallCount: 3
    seed: 359
  )
  addRockGroup(
    rocks: rocks
    cx: 2.8
    cy: 11.4
    size: 0.7
    smallCount: 3
    seed: 401
  )
  addRockGroup(
    rocks: rocks
    cx: -4.4
    cy: 10.6
    size: 0.55
    smallCount: 2
    seed: 443
  )
  addRockGroup(
    rocks: rocks
    cx: 10.6
    cy: 6.0
    size: 0.65
    smallCount: 2
    seed: 487
  )
  addRockGroup(
    rocks: rocks
    cx: 3.6
    cy: -6.8
    size: 0.8
    smallCount: 3
    seed: 521
  )
  addRockGroup(
    rocks: rocks
    cx: -4.2
    cy: -7.6
    size: 0.6
    smallCount: 2
    seed: 563
  )
  addRockGroup(
    rocks: rocks
    cx: 9.0
    cy: -3.6
    size: 0.5
    smallCount: 2
    seed: 601
  )
  # Pebbles: single small rocks wherever the ground is clear
  var placed: Int = 0
  loop var i: Int = 0, i < 400 and placed < 18, ++i {
    let x: Float = hash2(x: i, y: 21, seed: 977) * 24 - 12
    let y: Float = hash2(x: i, y: 22, seed: 977) * 20 - 8
    if groundIsClear(x: x, y: y, rocks: rocks) {
      rocks.add(
        value: { x: x, y: y, size: 0.18 + hash2(x: i, y: 23, seed: 977) * 0.2, seed: 1000 + i }
      )
      placed = placed + 1
    }
  }
  ret rocks
}

# Inside the island's rim, off the path, away from the trunks and the rocks
func groundIsClear(x: view Float, y: view Float, rocks: view List(GroveRock)) ret Bool {
  if x * x / 169 + (y - 2) * (y - 2) / 121 > 0.8 {
    ret false
  }
  if Math.abs(value: x - pathCenter(distance: y)) < 1.6 {
    ret false
  }
  loop let spot: view GroveTreeSpot in groveTreeSpots() {
    if (x - spot.x) * (x - spot.x) + (y - spot.y) * (y - spot.y) < 1.4 * 1.4 {
      ret false
    }
  }
  loop let rock: view GroveRock in rocks {
    let reach: Float = rock.size * 1.6 + 0.4
    if (x - rock.x) * (x - rock.x) + (y - rock.y) * (y - rock.y) < reach * reach {
      ret false
    }
  }
  ret true
}

# The grove: its World3d, and the obstacles the grass keeps out of
type Grove {
  world: World3d
  obstacles: List(GroveObstacle)
}

func buildGrove(renderer: mod DeferredRenderer) ret Grove {
  var world: World3d = create()
  var obstacles: List(GroveObstacle) = List.create(GroveObstacle, cap: 80)
  let origin: Vec3 = Vec3.create(x: 0, y: 0, z: 0)
  let unit: Vec3 = Vec3.create(x: 1, y: 1, z: 1)
  let backdrop: MeshData = makePlane(size: 1000, segments: 1)
  place(
    world: world
    renderer: renderer
    mesh: backdrop
    material: paint(red: 0.11, green: 0.25, blue: 0.29)
    position: Vec3.create(x: 0, y: 0, z: -1.2)
    scale: unit
    rotation: 0
  )
  let edge: MeshData = gardenEdge()
  place(
    world: world
    renderer: renderer
    mesh: edge
    material: paint(red: 0.20, green: 0.16, blue: 0.085)
    position: origin
    scale: unit
    rotation: 0
  )
  let ground: MeshData = gardenGround()
  place(
    world: world
    renderer: renderer
    mesh: ground
    material: paint(red: groveGroundRed, green: groveGroundGreen, blue: groveGroundBlue)
    position: origin
    scale: unit
    rotation: 0
  )
  let path: MeshData = gardenPath()
  place(
    world: world
    renderer: renderer
    mesh: path
    material: paint(red: 0.48, green: 0.32, blue: 0.16)
    position: origin
    scale: unit
    rotation: 0
  )
  loop let spot: view GroveTreeSpot in groveTreeSpots() {
    plantTree(
      world: world
      renderer: renderer
      position: Vec3.create(x: spot.x, y: spot.y, z: 0)
      height: spot.height
      width: spot.width
      seed: spot.seed
      species: spot.species
      palm: spot.palm
    )
    obstacles.add(value: { x: spot.x, y: spot.y, radius: 0.45 })
  }
  # The lib's faceted rocks, flattened a little and sunk into the ground so
  # they sit in it rather than on it
  loop let rock: view GroveRock in groveRocks() {
    let shape: MeshData = generateRock(
      subdivision: 5
      sliceCount: 4 + rock.seed % 3
      size: 1.0
      seed: rock.seed
      irregularity: 0.12
    )
    let tint: Float = hash2(x: rock.seed, y: 4, seed: 891) * 0.07
    let stretch: Float = 1.0 + hash2(x: rock.seed, y: 5, seed: 891) * 0.35
    # Big rocks stand up; pebbles lie flatter
    var height: Float = 0.8
    if rock.size > 0.7 {
      height = 1.0
    }
    place(
      world: world
      renderer: renderer
      mesh: shape
      material: paint(red: 0.15 + tint, green: 0.16 + tint, blue: 0.155 + tint)
      position: Vec3.create(
        x: rock.x
        y: rock.y
        z: groundHeight(x: rock.x, y: rock.y) - rock.size * 0.2
      )
      scale: Vec3.create(x: rock.size * stretch, y: rock.size, z: rock.size * height)
      rotation: hash2(x: rock.seed, y: 6, seed: 891) * 6.2831853
    )
    obstacles.add(value: { x: rock.x, y: rock.y, radius: rock.size * stretch * 0.95 })
  }
  # Low scarlet shrubs balance the trees and tie the stone group into the grove.
  loop var i: Int = 0, i < 7, ++i {
    var shrub: MeshData = foliageMesh()
    leafCrown(
      mesh: shrub
      center: Vec3.create(x: 0, y: 0, z: 0.45)
      radius: Vec3.create(x: 0.85, y: 0.65, z: 0.6)
      seed: 913 + i * 47
      tone: i % 3
      leafCount: fullLeafCount
    )
    place(
      world: world
      renderer: renderer
      mesh: shrub
      material: foliagePaint(species: 3, tone: i % 3)
      position: Vec3.create(
        x: -7.0 + i.toFloat() * 2.2
        y: 4.5 + Math.sin(x: i.toFloat() * 2) * 2
        z: 0
      )
      scale: unit
      rotation: 0
    )
  }
  ret Grove { world: own world, obstacles: own obstacles }
}
