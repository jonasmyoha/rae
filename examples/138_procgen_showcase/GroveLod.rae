# The museum's level-of-detail scene (RAE_GROVE_VIEW=lod from eye height,
# lod-high from 35 m over it,
# docs/tree-sets-design.md §5 step 4): the low-poly tree set as a forest
# that runs from the camera out to 1.9 km, so every level the walkers use is
# in one picture: the full meshes near, the sparser crowns from 30 m, the
# trees' billboards (impostors baked from every side) from 60 m, far
# billboards from 140 m and past 300 m the far canopy (app3d/TreeForest).
# It is a world of its own: a flat meadow and the forest, no island.
open Vec3
open Scene3d
open Mesh3d
open FoliageMesh
open RendererDeferred
open app3d/CameraRig
open app3d/PropField
open app3d/TreeForest
open treeSets/TreeSet
open lowPolyTrees/LowPolyTrees

const groveLodViewName: String = "lod"

# The forest: a band `groveLodWidth` meters wide from groveLodNear to
# groveLodFar ahead of the camera, a tree every groveLodSpacing meters
# (TreeForest.plantTreeForestBand)
const groveLodWidth: Float = 640.0

const groveLodNear: Float = 8.0

const groveLodFar: Float = 1900.0

const groveLodSpacing: Float = 7.0

# The meadow under it: a green plane, a little bigger than the forest
const groveLodGroundSize: Float = 4400.0

func groveLodRequested(viewName: view String) ret Bool {
  ret viewName is groveLodViewName or viewName is "lod-high"
}

# The meadow: one big plane at the ground's height
func buildGroveLodWorld(renderer: mod DeferredRenderer) ret World3d {
  var world: World3d = create()
  let ground: MeshData = makePlane(size: groveLodGroundSize, segments: 1)
  place(
    world: world
    renderer: renderer
    mesh: ground
    material: paint(red: groveGroundRed, green: groveGroundGreen, blue: groveGroundBlue)
    position: Vec3.create(x: 0.0, y: groveLodGroundSize * 0.5 - 200.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
    rotation: 0.0
  )
  ret world
}

# The low-poly forest, planted and finished: its stands as the walkers plant
# theirs (TreeSet.treeSpeciesAt), its meadows from a noise
func buildGroveLodForest(renderer: mod DeferredRenderer) ret TreeForest {
  let treeSet: TreeSet = createLowPolyTrees()
  var forest: TreeForest = createTreeForest(
    treeSet: treeSet
    renderer: renderer
    settings: defaultTreeForestSettings(extent: groveLodFar * 2.0 + 400.0, farReach: 1800.0)
    toon: true
  )
  let unusedPlanted: Int = plantTreeForestBand(
    forest: forest
    treeSet: treeSet
    band: { width: groveLodWidth, near: groveLodNear, far: groveLodFar, spacing: groveLodSpacing }
  )
  let planted: Int = finishTreeForest(forest: forest, renderer: renderer)
  log("[grove-lod] {planted} low-poly trees, {groveLodNear}-{groveLodFar} m")
  ret forest
}

# The camera at eye height looking down the forest's lane, or (lod-high)
# 35 m over the lane looking down the forest, every level in view
func setGroveLodView(camera: mod Camera3d, cameraRig: mod CameraRig, viewName: view String) {
  cameraRig.mode = CameraRigMode.orbit
  camera.target = Vec3.create(x: 0.0, y: 30.0, z: 2.6)
  camera.farZ = 2600
  cameraRig.yaw = 0.0
  cameraRig.orbitPitch = 0.02
  cameraRig.distance = 40.0
  cameraRig.maxDistance = 400.0
  if viewName is "lod-high" {
    camera.target = Vec3.create(x: 0.0, y: 150.0, z: 0.0)
    cameraRig.orbitPitch = 0.22
    cameraRig.distance = 160.0
  }
  snapCameraRigView(rig: cameraRig)
  applyCameraRig(rig: cameraRig, camera: camera)
}
