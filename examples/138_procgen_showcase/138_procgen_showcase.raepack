pack ProcgenShowcase {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Autumn Grove — Procedural Props"
  description: "A stylized autumn garden generated entirely in Rae: trees with continuous branching wood (and one palm-style) and individual leaf silhouettes, faceted rock groups across the island, scarlet shrubs, the standard GPU grass and an earth path. Warm gold, copper and green cel-shaded foliage, cascaded shadows, and a raised garden base. Twelve additional broadleaf, cypress, umbrella pine and bush instances share low-density leaf-patch meshes on a larger island. Press 1 for the grove, 2 for the trees, 3 for the stones, 4 for fluffy leaves, 5 for evergreens; drag to orbit, wheel to zoom, Tab for free WASD. No mesh assets, noise texture swatches or new runtime code."
  featured: "true"
  category: "3D Renderer"
  wasmWebApp: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
    target wasm: {
      label: "WASM (WebGPU)"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
