# The existing local crimson specimen is forest kind 7. No extra tree slot.
import Sys
open procgen/JapaneseMaple
open app3d/GroveTrees
open Mesh3d
open FoliageMesh
open Scene3d
open RendererDeferred
open RendererImages
open Vec3
open ecs/Entity

func plantJapaneseMaple(
  world: mod World3d
  renderer: mod DeferredRenderer
  position: view Vec3
  height: view Float
  width: view Float
  seed: view Int
) {
  let tree: JapaneseMapleTree = japaneseMapleTree(
    seed: seed
    height: height
    width: width
    multiStem: Sys.getEnv(name: "RAE_JAPANESE_MAPLE_SINGLE") is not "1"
  )
  let barkLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: japaneseMapleBarkTexture()
  )
  let leafLayer: Int = rendererLoadSurfaceImage(
    renderer: renderer
    path: japaneseMapleLeafTexture()
  )
  var parts: List(MeshData) = List.create(MeshData, cap: 4)
  parts.add(value: tree.wood)
  loop var tone: Int = 0, tone < 3, ++tone {
    parts.add(value: japaneseMapleLeaves(tree: tree, seed: seed, tone: tone))
  }
  var triangles: Int = 0
  var vertices: Int = 0
  loop var part: Int = 0, part < parts.length, ++part {
    let mesh: MeshData = parts.copyAtDefault(index: part)
    triangles = triangles + mesh.indices.length / 3
    vertices = vertices + mesh.vertCount
    if part > 0 and Sys.getEnv(name: "RAE_JAPANESE_MAPLE_BARE") is "1" {
      continue
    }
    var material: Material3d = foliageMaterial(color: japaneseMapleWoodColor())
    material.colorTextureLayer = barkLayer
    if part > 0 {
      material.baseColor = japaneseMapleLeafColor(tone: part - 1)
      material.colorTextureLayer = leafLayer
    }
    let meshHandle: MeshHandle = uploadFoliage(renderer: renderer, mesh: mesh)
    let entityId: EntityId = world3dAddMeshInstance(
      world: world
      mesh: meshHandle
      material: material
      position: position
      rotation: Vec3.create(x: 0, y: 0, z: 0)
      scale: Vec3.create(x: 1, y: 1, z: 1)
    )
  }
  log(
    "[japanese-maple] kind=7 seed={seed} height={height} vertices={vertices} triangles={triangles}"
  )
}
