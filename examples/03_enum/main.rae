enum Direction {
  north
  south
  east
  west
}

# Sema requires every enum case to be covered (or a `default` arm) —
# delete one of the cases below and the compiler will tell you which
# Direction is missing.
func describe(d: view Int) ret String {
  match d {
    case Direction.north {
      ret "going north"
    }
    case Direction.south {
      ret "going south"
    }
    case Direction.east {
      ret "going east"
    }
    case Direction.west {
      ret "going west"
    }
  }
  ret "unknown"
}

func main() {
  log(describe(d: Direction.north))
  log(describe(d: Direction.south))
  log(describe(d: Direction.east))
  log(describe(d: Direction.west))

  # `is` still works for single-value checks.
  let d: Direction = Direction.east
  if d is Direction.east {
    log("d is East")
  }

  # Enums are int-backed value types, so no hand-written name tables:
  #   - `.toString()` yields the member name automatically
  #   - string interpolation of an enum member uses that name too
  #   - `enum as Int` and `Int as enum` cast both directions
  log(d.toString())            # east
  log("heading {Direction.north}")   # heading north

  let ordinal: Int = d as Int  # east -> 2
  log(ordinal)
  let rotated: Direction = (ordinal + 1) as Direction  # west
  log(rotated.toString())
}
