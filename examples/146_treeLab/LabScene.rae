# The tree lab's scene (docs/reference-tree-plan.md step 1): a flat ground,
# one PLACEHOLDER tree where the generated tree will stand, a few darker
# placeholder trees behind it and placeholder clouds in the sky. Plain
# cylinders and spheres only: nothing here is tree code, and none of it is
# meant to look like the reference. It is there so the comparison picture
# and the camera framing can be judged before step 3 grows a real tree.
import Vec3
open Scene3d
open ecs/Entity
open RendererDeferred
open Mesh3d

# The placeholder tree, sized like reference crop T02's tree: 13.5 m tall,
# the crown from about half its height, a trunk about 1/40 of the height
# thick at the base
const labTreeHeight: Float = 13.5

const labTrunkRadius: Float = 0.17

const labCrownStart: Float = 6.8

# The ground's colour (the grass takes its base colour from it too)
const labGroundRed: Float = 0.26

const labGroundGreen: Float = 0.34

const labGroundBlue: Float = 0.12

type LabMeshes {
  sphere: MeshHandle
  cylinder: MeshHandle
  ground: MeshHandle
}

func uploadLabMesh(renderer: mod DeferredRenderer, meshData: view MeshData) ret MeshHandle {
  ret uploadMesh(
    renderer: renderer
    verts: meshData.verts
    vertCount: meshData.vertCount
    indices: meshData.indices
  )
}

func createLabMeshes(renderer: mod DeferredRenderer) ret LabMeshes {
  ret LabMeshes {
    sphere: uploadLabMesh(renderer: renderer, meshData: makeSphere(rings: 16, segments: 24))
    cylinder: uploadLabMesh(renderer: renderer, meshData: makeCylinder(segments: 16))
    ground: uploadLabMesh(renderer: renderer, meshData: makePlane(size: 900.0, segments: 1))
  }
}

func labMaterial(
  red: view Float
  green: view Float
  blue: view Float
  roughness: view Float
) ret Material3d {
  ret Material3d {
    baseColor: Vec3.create(x: red, y: green, z: blue)
    metallic: 0.0
    roughness: roughness
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: false
  }
}

# An upright cylinder from `base` up `height` metres (makeCylinder is along
# Y from -1 to 1; a quarter turn about X stands it on Z)
func addStem(
  world: mod World3d
  meshes: view LabMeshes
  base: view Vec3
  height: view Float
  radius: view Float
  material: view Material3d
) {
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: meshes.cylinder
    material: material
    position: Vec3.create(x: base.x, y: base.y, z: base.z + height * 0.5)
    rotation: Vec3.create(x: 1.5707963, y: 0.0, z: 0.0)
    scale: Vec3.create(x: radius, y: height * 0.5, z: radius)
  )
}

func addBlob(
  world: mod World3d
  meshes: view LabMeshes
  centre: view Vec3
  size: view Vec3
  material: view Material3d
) {
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: meshes.sphere
    material: material
    position: centre
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: size
  )
}

# The placeholder tree at the origin: a warm trunk and seven grey-green
# spheres where T02's clumps are, roughly. Step 3 replaces it.
func addPlaceholderTree(world: mod World3d, meshes: view LabMeshes) {
  let trunk: Material3d = labMaterial(
    red: 0.45
    green: 0.22
    blue: 0.11
    roughness: 0.9
  )
  let crown: Material3d = labMaterial(
    red: 0.30
    green: 0.36
    blue: 0.24
    roughness: 0.95
  )
  addStem(
    world: world
    meshes: meshes
    base: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    height: labTreeHeight - 1.5
    radius: labTrunkRadius
    material: trunk
  )
  # (x, z, radius): the clumps, the top one the largest
  let clumps: List(Float) = [
    -1.6
    7.4
    1.1
    1.5
    8.0
    1.0
    -2.2
    9.4
    1.3
    1.9
    10.0
    1.2
    -0.9
    11.0
    1.4
    1.0
    11.8
    1.2
    0.0
    12.6
    1.6
  ]
  var i: Int = 0
  loop i + 2 < clumps.length {
    let radius: Float = clumps.copyAtDefault(index: i + 2)
    addBlob(
      world: world
      meshes: meshes
      centre: Vec3.create(
        x: clumps.copyAtDefault(index: i)
        y: 0.0
        z: clumps.copyAtDefault(index: i + 1)
      )
      size: Vec3.create(x: radius, y: radius, z: radius * 0.8)
      material: crown
    )
    i = i + 3
  }
}

# Darker placeholder trees behind, as T02 has
func addBackgroundTrees(world: mod World3d, meshes: view LabMeshes) {
  let trunk: Material3d = labMaterial(
    red: 0.30
    green: 0.18
    blue: 0.11
    roughness: 0.9
  )
  let crown: Material3d = labMaterial(
    red: 0.16
    green: 0.22
    blue: 0.14
    roughness: 0.95
  )
  # (x, y, height)
  let trees: List(Float) = [
    -9.0
    18.0
    12.0
    -4.0
    30.0
    15.0
    6.0
    24.0
    11.0
    12.0
    40.0
    16.0
    -15.0
    45.0
    14.0
    20.0
    60.0
    15.0
    -26.0
    70.0
    13.0
    2.0
    80.0
    16.0
  ]
  var i: Int = 0
  loop i + 2 < trees.length {
    let x: Float = trees.copyAtDefault(index: i)
    let y: Float = trees.copyAtDefault(index: i + 1)
    let height: Float = trees.copyAtDefault(index: i + 2)
    addStem(
      world: world
      meshes: meshes
      base: Vec3.create(x: x, y: y, z: 0.0)
      height: height * 0.8
      radius: 0.18
      material: trunk
    )
    addBlob(
      world: world
      meshes: meshes
      centre: Vec3.create(x: x, y: y, z: height * 0.72)
      size: Vec3.create(x: height * 0.2, y: height * 0.2, z: height * 0.24)
      material: crown
    )
    i = i + 3
  }
}

# Placeholder clouds: flattened white puffs far behind the tree, lit by
# their own emission so they read white against the sky. Step 2 decides
# how the sky and clouds really look.
func addPlaceholderClouds(world: mod World3d, meshes: view LabMeshes) {
  var cloud: Material3d = labMaterial(
    red: 1.0
    green: 1.0
    blue: 1.0
    roughness: 1.0
  )
  cloud.emission = Vec3.create(x: 0.9, y: 0.9, z: 0.9)
  # (x, z, width) of each cloud, all 420 m behind the tree
  let clouds: List(Float) = [
    -150.0
    170.0
    60.0
    -40.0
    220.0
    80.0
    90.0
    150.0
    55.0
    170.0
    240.0
    70.0
  ]
  var i: Int = 0
  loop i + 2 < clouds.length {
    let x: Float = clouds.copyAtDefault(index: i)
    let z: Float = clouds.copyAtDefault(index: i + 1)
    let width: Float = clouds.copyAtDefault(index: i + 2)
    loop var puff: Int = 0, puff < 4, ++puff {
      let offset: Float = (puff.toFloat() - 1.5) * width * 0.32
      # the middle puffs stand a little higher
      var rise: Float = 0.0
      if puff is 1 or puff is 2 {
        rise = width * 0.07
      }
      addBlob(
        world: world
        meshes: meshes
        centre: Vec3.create(x: x + offset, y: 420.0, z: z + rise)
        size: Vec3.create(x: width * 0.3, y: width * 0.12, z: width * 0.16)
        material: cloud
      )
    }
    i = i + 3
  }
}

# The whole scene: the ground, the placeholder tree, the trees behind it and
# the clouds
func buildLabWorld(meshes: view LabMeshes) ret World3d {
  var world: World3d = create()
  let ground: Material3d = labMaterial(
    red: labGroundRed
    green: labGroundGreen
    blue: labGroundBlue
    roughness: 1.0
  )
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: meshes.ground
    material: ground
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  addPlaceholderTree(world: world, meshes: meshes)
  addBackgroundTrees(world: world, meshes: meshes)
  addPlaceholderClouds(world: world, meshes: meshes)
  ret world
}
