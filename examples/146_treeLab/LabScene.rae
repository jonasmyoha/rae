# The tree lab's scene (docs/reference-tree-plan.md step 1): a flat ground,
# one PLACEHOLDER tree where the generated tree will stand, a few darker
# placeholder trees behind it and placeholder clouds in the sky. Plain
# cylinders and spheres only: nothing here is tree code, and none of it is
# meant to look like the reference. It is there so the comparison picture
# and the camera framing can be judged before step 3 grows a real tree.
import Math
import Vec3
open Scene3d
open ecs/Entity
open RendererDeferred
open Mesh3d

# The placeholder tree, sized like reference crop T02's tree: 13.5 m tall,
# the crown from about half its height, a trunk about 1/40 of the height
# thick at the base
const labTreeHeight: Float = 13.5

const labTrunkRadius: Float = 0.17

const labCrownStart: Float = 6.8

# The ground's color (the grass takes its base color from it too)
const labGroundRed: Float = 0.09

const labGroundGreen: Float = 0.115

const labGroundBlue: Float = 0.035

type LabMeshes {
  sphere: MeshHandle
  cylinder: MeshHandle
  ground: MeshHandle
}

func uploadLabMesh(renderer: mod DeferredRenderer, meshData: view MeshData) ret MeshHandle {
  ret uploadMesh(
    renderer: renderer
    verts: meshData.verts
    vertCount: meshData.vertCount
    indices: meshData.indices
  )
}

func createLabMeshes(renderer: mod DeferredRenderer) ret LabMeshes {
  ret LabMeshes {
    sphere: uploadLabMesh(renderer: renderer, meshData: makeSphere(rings: 16, segments: 24))
    cylinder: uploadLabMesh(renderer: renderer, meshData: makeCylinder(segments: 16))
    ground: uploadLabMesh(renderer: renderer, meshData: makePlane(size: 900.0, segments: 1))
  }
}

func labMaterial(
  red: view Float
  green: view Float
  blue: view Float
  roughness: view Float
) ret Material3d {
  ret Material3d {
    baseColor: Vec3.create(x: red, y: green, z: blue)
    metallic: 0.0
    roughness: roughness
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: false
  }
}

# An upright cylinder from `base` up `height` meters (makeCylinder is along
# Y from -1 to 1; a quarter turn about X stands it on Z)
func addStem(
  world: mod World3d
  meshes: view LabMeshes
  base: view Vec3
  height: view Float
  radius: view Float
  material: view Material3d
) {
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: meshes.cylinder
    material: material
    position: Vec3.create(x: base.x, y: base.y, z: base.z + height * 0.5)
    rotation: Vec3.create(x: 1.5707963, y: 0.0, z: 0.0)
    scale: Vec3.create(x: radius, y: height * 0.5, z: radius)
  )
}

func addBlob(
  world: mod World3d
  meshes: view LabMeshes
  center: view Vec3
  size: view Vec3
  material: view Material3d
) {
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: meshes.sphere
    material: material
    position: center
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: size
  )
}

# The placeholder tree at the origin: a warm trunk and seven gray-green
# spheres where T02's clumps are, roughly. Step 3 replaces it.
func addPlaceholderTree(world: mod World3d, meshes: view LabMeshes) {
  let trunk: Material3d = labMaterial(
    red: 0.45
    green: 0.22
    blue: 0.11
    roughness: 0.9
  )
  let crown: Material3d = labMaterial(
    red: 0.16
    green: 0.20
    blue: 0.07
    roughness: 0.95
  )
  addStem(
    world: world
    meshes: meshes
    base: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    height: labTreeHeight - 1.5
    radius: labTrunkRadius
    material: trunk
  )
  # (x, z, radius): the clumps, the top one the largest
  let clumps: List(Float) = [
    -1.6
    7.4
    1.1
    1.5
    8.0
    1.0
    -2.2
    9.4
    1.3
    1.9
    10.0
    1.2
    -0.9
    11.0
    1.4
    1.0
    11.8
    1.2
    0.0
    12.6
    1.6
  ]
  var i: Int = 0
  loop i + 2 < clumps.length {
    let radius: Float = clumps.copyAtDefault(index: i + 2)
    addBlob(
      world: world
      meshes: meshes
      center: Vec3.create(
        x: clumps.copyAtDefault(index: i)
        y: 0.0
        z: clumps.copyAtDefault(index: i + 1)
      )
      size: Vec3.create(x: radius, y: radius, z: radius * 0.8)
      material: crown
    )
    i = i + 3
  }
}

# A seeded random number in 0..1 (a small linear congruential generator): the
# lab's scene is the same on every run
func labRandom(seed: mod Int) ret Float {
  seed = (seed * 1103515245 + 12345) % 2147483648
  ret seed.toFloat() / 2147483648.0
}

# The forest behind, as T02 has: a dense band of darker placeholder trees from
# 10 to 90 m behind the tree, so no horizon shows through, and a few low
# bushes in front. Plain cylinders and spheres, like the tree itself.
func addBackgroundTrees(world: mod World3d, meshes: view LabMeshes) {
  let trunk: Material3d = labMaterial(
    red: 0.16
    green: 0.10
    blue: 0.06
    roughness: 0.9
  )
  let crown: Material3d = labMaterial(
    red: 0.045
    green: 0.07
    blue: 0.025
    roughness: 0.95
  )
  let litCrown: Material3d = labMaterial(
    red: 0.10
    green: 0.13
    blue: 0.03
    roughness: 0.95
  )
  var seed: Int = 7
  loop var i: Int = 0, i < 140, ++i {
    let depth: Float = 10.0 + labRandom(seed: seed) * 80.0
    # wider farther back, so the band fills the view at every depth
    let x: Float = (labRandom(seed: seed) - 0.5) * (30.0 + depth * 1.6)
    let height: Float = 9.0 + labRandom(seed: seed) * 8.0
    # keep the tree's own spot clear
    if Math.abs(value: x) < 3.0 and depth < 14.0 {
      continue
    }
    var leaves: Material3d = crown
    if labRandom(seed: seed) < 0.35 {
      leaves = litCrown
    }
    let base: Vec3 = Vec3.create(x: x, y: depth, z: 0.0)
    addStem(
      world: world
      meshes: meshes
      base: base
      height: height * 0.75
      radius: 0.16
      material: trunk
    )
    let width: Float = height * (0.18 + labRandom(seed: seed) * 0.1)
    addBlob(
      world: world
      meshes: meshes
      center: Vec3.create(x: x, y: depth, z: height * 0.7)
      size: Vec3.create(x: width, y: width, z: height * 0.26)
      material: leaves
    )
  }
  # Dark undergrowth through the band, so no open horizon shows between the
  # trunks (T02's forest floor is dense)
  let undergrowth: Material3d = labMaterial(
    red: 0.05
    green: 0.08
    blue: 0.025
    roughness: 0.95
  )
  loop var i: Int = 0, i < 90, ++i {
    let depth: Float = 8.0 + labRandom(seed: seed) * 72.0
    let x: Float = (labRandom(seed: seed) - 0.5) * (30.0 + depth * 1.6)
    if Math.abs(value: x) < 2.0 and depth < 12.0 {
      continue
    }
    let radius: Float = 1.2 + labRandom(seed: seed) * 1.6
    addBlob(
      world: world
      meshes: meshes
      center: Vec3.create(x: x, y: depth, z: radius * 0.5)
      size: Vec3.create(x: radius * 1.4, y: radius * 1.4, z: radius)
      material: undergrowth
    )
  }
  # Low bushes in front and round the tree, as T02 has
  let bush: Material3d = labMaterial(
    red: 0.22
    green: 0.25
    blue: 0.07
    roughness: 0.95
  )
  loop var i: Int = 0, i < 26, ++i {
    let y: Float = -6.0 + labRandom(seed: seed) * 16.0
    let x: Float = (labRandom(seed: seed) - 0.5) * 14.0
    if Math.abs(value: x) < 1.0 and Math.abs(value: y) < 1.0 {
      continue
    }
    let radius: Float = 0.3 + labRandom(seed: seed) * 0.45
    addBlob(
      world: world
      meshes: meshes
      center: Vec3.create(x: x, y: y, z: radius * 0.35)
      size: Vec3.create(x: radius * 1.2, y: radius * 1.2, z: radius * 0.8)
      material: bush
    )
  }
}

# Placeholder clouds: flattened white puffs far behind the tree, lit by
# their own emission so they read white against the sky. T02's sky is mostly
# cloud, so there are many, large and overlapping. They are placeholders: a
# real cloud look is not part of the tree plan.
func addPlaceholderClouds(world: mod World3d, meshes: view LabMeshes) {
  var cloud: Material3d = labMaterial(
    red: 1.0
    green: 1.0
    blue: 1.0
    roughness: 1.0
  )
  cloud.emission = Vec3.create(x: 0.85, y: 0.87, z: 0.9)
  var seed: Int = 31
  loop var i: Int = 0, i < 34, ++i {
    let x: Float = (labRandom(seed: seed) - 0.5) * 520.0
    let z: Float = 70.0 + labRandom(seed: seed) * 230.0
    let width: Float = 50.0 + labRandom(seed: seed) * 90.0
    let y: Float = 380.0 + labRandom(seed: seed) * 120.0
    loop var puff: Int = 0, puff < 5, ++puff {
      let offset: Float = (puff.toFloat() - 2.0) * width * 0.24
      let rise: Float = width * 0.09 * labRandom(seed: seed)
      let size: Float = width * (0.2 + labRandom(seed: seed) * 0.12)
      addBlob(
        world: world
        meshes: meshes
        center: Vec3.create(x: x + offset, y: y, z: z + rise)
        size: Vec3.create(x: size, y: size * 0.4, z: size * 0.55)
        material: cloud
      )
    }
  }
}

# The lab's ground and its clouds: the T02 scene's base, and the studies'
# (LabStudies)
func buildLabGround(meshes: view LabMeshes) ret World3d {
  var world: World3d = create()
  let ground: Material3d = labMaterial(
    red: labGroundRed
    green: labGroundGreen
    blue: labGroundBlue
    roughness: 1.0
  )
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: meshes.ground
    material: ground
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  addPlaceholderClouds(world: world, meshes: meshes)
  ret world
}

# The whole scene: the ground, the placeholder tree (when the generated one
# is not wanted: RAE_TREELAB_TREE=placeholder), the trees behind it and the
# clouds
func buildLabWorld(meshes: view LabMeshes, placeholderTree: view Bool) ret World3d {
  var world: World3d = buildLabGround(meshes: meshes)
  if placeholderTree {
    addPlaceholderTree(world: world, meshes: meshes)
  }
  addBackgroundTrees(world: world, meshes: meshes)
  ret world
}
