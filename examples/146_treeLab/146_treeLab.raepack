pack TreeLab {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Tree lab: one tree made to match a reference"
  description: "The scene lib/treeGen's T02 tree is made and judged in (docs/reference-tree-plan.md): the hand-drawn 2D trace of reference crop T02 turned into the tree's trunk, branches and leaf masses, the masses filled with camera-facing leaf cards in their own G-buffer pass, before a plain background of placeholder trees, bushes and clouds under the lab's sun and haze. RAE_TREELAB_CAMERA=near (T02's own framing), mid, far or bark; RAE_TREELAB_SEED; RAE_TREELAB_LEAVES=off for the plain leaf masses, RAE_TREELAB_CLUMPS=off for the bare wood. examples/146_treeLab/compare.sh puts a render beside T02."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
