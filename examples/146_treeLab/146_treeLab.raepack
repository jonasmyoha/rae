pack TreeLab {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Tree lab: trees, forests and grass through the year"
  description: "The lab where trees are made and judged, on the standard editor panel: the camera bar (orbit, free WASD camera), the debug readout and a side panel with four scenes (Forest: the stylized, low-poly or reference tree set at every distance; One tree; Reference T02: lib/treeGen's traced tree before placeholder trees, with its fixed framings as camera buttons; Studies: meadow flowers) and the lab's controls: weather, wind, the year's speed, latitude, the look, the forest set, the tree kind, seed and level drawn, the forest's reach and density, and the grass. The shared date drives the seasons: the leaves turn and fall, the grass dies back, snow lies in winter. See README.md for the controls and the variables of a headless run."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
