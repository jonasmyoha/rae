# The lab's tree: lib/treeGen's generated tree at the origin. So far the bare
# wood (docs/reference-tree-plan.md step 3): the skeleton's tubes in the
# bark material. The bark image is painted once into .rae/treeLab/ and
# loaded as one of the renderer's material images.
import Sys
import Math
import Image
import Vec3
open Scene3d
open ecs/Entity
open RendererDeferred
open RendererImages
open Mesh3d
open treeGen/TreeParams
open treeGen/Skeleton
open treeGen/BarkMesh
open treeGen/Bark
open treeGen/ClumpMesh
open treeGen/LeafImage
open treeGen/LeafCards
open treeGen/LeafPass
open treeGen/TreeGrower
open Math3d

const labBarkImagePath: String = ".rae/treeLab/warmBark.png"

# What the lab keeps of its trees: per tree, the leaves to draw in the
# G-buffer pass, and the solid leaf masses (shrunk to 75%) that cast the
# crown's shadow, with where that tree stands
type LabTree {
  leaves: List(LeafPass)
  massShadows: List(MeshHandle)
  shadowModels: List(Mat4)
  castsMassShadow: Bool
}

# The row's trees stand this far apart along x (the crowns are about 6 m
# wide)
const labRowSpacing: Float = 11.0

# The row (docs/reference-tree-plan.md step 6): the traced tree and three
# grown ones beside it. RAE_TREELAB_ROW=1, or the `row` camera.
func labRowRequested() ret Bool {
  ret Sys.getEnv(name: "RAE_TREELAB_ROW") is "1" or Sys.getEnv(name: "RAE_TREELAB_CAMERA") is "row" or Sys.getEnv(
    name: "RAE_TREELAB_CAMERA"
  ) is "fork"
}

# RAE_TREELAB_SEED, or 1
func labTreeSeed() ret Int {
  let text: String = Sys.getEnv(name: "RAE_TREELAB_SEED")
  if text.length() > 0 {
    ret text.toInt()
  }
  ret 1
}

# The bark image's layer in the renderer's material images (painted the
# first time), or -1 when it could not be made
func labBarkLayer(renderer: mod DeferredRenderer) ret Int {
  if not Sys.exists(path: labBarkImagePath) {
    let made: Bool = Sys.makeDir(path: ".rae/treeLab")
    if not writeBarkImage(path: labBarkImagePath) {
      log("[treeLab] could not write the bark image {labBarkImagePath}")
      ret -1
    }
  }
  ret rendererLoadSurfaceImage(renderer: renderer, path: labBarkImagePath)
}

# RAE_TREELAB_DUMP=<path>: write the tree's centre lines there, for
# traceTree.py's overlay (a `limb` line, then `x y z radius` per point)
func dumpSkeleton(skeleton: view TreeSkeleton) {
  let path: String = Sys.getEnv(name: "RAE_TREELAB_DUMP")
  if path.length() is 0 {
    ret
  }
  var text: String = ""
  loop let limb: view Limb in skeleton.limbs {
    text = "{text}limb\n"
    loop var i: Int = 0, i < limb.points.length, ++i {
      let point: Vec3 = limb.points.copyAtDefault(index: i)
      text = "{text}{point.x} {point.y} {point.z} {limb.radii.copyAtDefault(index: i)}\n"
    }
  }
  if not Sys.writeFile(path: path, content: text) {
    log("[treeLab] could not write {path}")
  }
}

# The lab's trees: the traced T02 tree (seed `seed`) at the origin, its
# right (+x) the picture's right, as in the trace it is built from; in the
# row (labRowRequested) also three trees GROWN from the trace's measures
# (treeGen/TreeGrower, seeds seed, seed + 1, seed + 2) beside it along +x.
# The leaf masses are filled with leaf cards (docs/reference-tree-plan.md
# step 5); the solid masses still cast the crowns' shadows.
#   RAE_TREELAB_LEAVES=off  the masses as plain solids (step 4's look)
#   RAE_TREELAB_CLUMPS=off  the bare wood
func addGeneratedTree(
  world: mod World3d
  renderer: mod DeferredRenderer
  seed: view Int
) ret LabTree {
  let masses: Bool = Sys.getEnv(name: "RAE_TREELAB_CLUMPS") is not "off"
  let leaves: Bool = masses and Sys.getEnv(name: "RAE_TREELAB_LEAVES") is not "off"
  var tree: LabTree = {
    leaves: List.create(LeafPass, cap: 4)
    massShadows: List.create(MeshHandle, cap: 4)
    shadowModels: List.create(Mat4, cap: 4)
    castsMassShadow: leaves
  }
  # the leaf stamps, painted once for every tree
  var pictures: List(List(Float)) = List.create(List(Float), cap: 0)
  if leaves {
    pictures = leafImageLayerPixels()
    previewLeafStamps(pictures: pictures)
  }
  let barkLayer: Int = labBarkLayer(renderer: renderer)
  addLabTree(
    world: world
    renderer: renderer
    params: warmBroadleafParams(seed: seed)
    x: 0.0
    barkLayer: barkLayer
    pictures: pictures
    tree: tree
    traced: true
  )
  if labRowRequested() {
    loop var i: Int = 0, i < 3, ++i {
      addLabTree(
        world: world
        renderer: renderer
        params: grownBroadleafParams(seed: seed + i)
        x: (i + 1).toFloat() * labRowSpacing
        barkLayer: barkLayer
        pictures: pictures
        tree: tree
        traced: false
      )
    }
  }
  ret tree
}

# One tree of the lab, standing at (`x`, 0): its bark, its leaf masses (as
# plain solids, or filled with leaf cards) and the masses' shadow. Only the
# traced tree writes the overlay's dumps (RAE_TREELAB_DUMP, _CARDS).
func addLabTree(
  world: mod World3d
  renderer: mod DeferredRenderer
  params: view TreeParams
  x: view Float
  barkLayer: view Int
  pictures: view List(List(Float))
  tree: mod LabTree
  traced: view Bool
) {
  let skeleton: TreeSkeleton = growSkeleton(params: params)
  let mesh: MeshData = barkMesh(skeleton: skeleton)
  if traced {
    dumpSkeleton(skeleton: skeleton)
  }
  let handle: MeshHandle = uploadMesh(
    renderer: renderer
    verts: mesh.verts
    vertCount: mesh.vertCount
    indices: mesh.indices
  )
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: handle
    material: barkMaterial(layer: barkLayer)
    position: Vec3.create(x: x, y: 0.0, z: 0.0)
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  let masses: Bool = Sys.getEnv(name: "RAE_TREELAB_CLUMPS") is not "off"
  if masses and not tree.castsMassShadow {
    let clumps: MeshData = clumpMesh(skeleton: skeleton)
    let clumpHandle: MeshHandle = uploadMesh(
      renderer: renderer
      verts: clumps.verts
      vertCount: clumps.vertCount
      indices: clumps.indices
    )
    let unusedClumpsEntityId: EntityId = world3dAddMeshInstance(
      world: world
      mesh: clumpHandle
      material: clumpLayoutMaterial()
      position: Vec3.create(x: x, y: 0.0, z: 0.0)
      rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
      scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
    )
  }
  var cardCount: Int = 0
  if tree.castsMassShadow {
    let shadowMasses: MeshData = clumpShadowMesh(skeleton: skeleton, scale: 0.75)
    tree.massShadows.add(value: uploadMesh(
      renderer: renderer
      verts: shadowMasses.verts
      vertCount: shadowMasses.vertCount
      indices: shadowMasses.indices
    ))
    tree.shadowModels.add(value: mat4Translate(x: x, y: 0.0, z: 0.0))
    var cards: LeafCards = leafCards(skeleton: skeleton, seed: params.seed)
    cardCount = cards.count
    if traced {
      dumpLeafCards(cards: cards)
    }
    var ownPictures: List(List(Float)) = pictures
    var leaves: LeafPass = createLeafPass(cards: own cards, pictures: own ownPictures)
    var placements: List(Float) = List.create(Float, cap: leafPlacementFloats)
    leafPlacement(
      placements: placements
      x: x
      y: 0.0
      z: 0.0
      yaw: 0.0
      scale: 1.0
    )
    setLeafPlacements(leaves: leaves, placements: own placements)
    tree.leaves.add(value: own leaves)
  }
  var kind: String = "grown"
  if traced {
    kind = "traced"
  }
  log(
    "[treeLab] {kind} tree, seed {params.seed}, at x {x}: {skeleton.limbs.length} limbs, {skeleton.clumps.length} leaf masses, {cardCount} leaf cards, {mesh.vertCount} bark vertices, fork at {skeleton.forkPoint.z / params.height}"
  )
}

# RAE_TREELAB_LEAF_PREVIEW=<path.png>: the leaf stamps side by side over
# mid grey, to look at them (a PNG cannot keep their gaps, so the grey
# stands in for them)
func previewLeafStamps(pictures: view List(List(Float))) {
  let path: String = Sys.getEnv(name: "RAE_TREELAB_LEAF_PREVIEW")
  if path.length() is 0 {
    ret
  }
  let width: Int = leafImageSize * pictures.length
  var pixels: List(Int) = List.create(Int, cap: width * leafImageSize)
  loop var i: Int = 0, i < width * leafImageSize, ++i {
    pixels.add(value: 0)
  }
  var offset: Int = 0
  loop let layer: view List(Float) in pictures {
    loop var row: Int = 0, row < leafImageSize, ++row {
      loop var column: Int = 0, column < leafImageSize, ++column {
        let base: Int = (row * leafImageSize + column) * 4
        let alpha: Float = layer.copyAtDefault(index: base + 3)
        # linear tone to a rough sRGB value, over grey 0.5
        let tone: Float = Math.pow(base: layer.copyAtDefault(index: base + 1), exp: 1.0 / 2.2)
        let value: Int = (255.0 * (tone * alpha + 0.5 * (1.0 - alpha))).toInt()
        pixels.set(
          index: row * width + offset + column
          value: 255 * 16777216 + value * 65536 + value * 256 + value
        )
      }
    }
    offset = offset + leafImageSize
  }
  if not Image.savePng(
    path: path
    pixels: pixels.data
    width: width
    height: leafImageSize
  ) {
    log("[treeLab] could not write {path}")
  }
}

# RAE_TREELAB_CARDS=<path>: write the leaf cards there (x y z size per card),
# for traceTree.py's overdraw measure
func dumpLeafCards(cards: view LeafCards) {
  let path: String = Sys.getEnv(name: "RAE_TREELAB_CARDS")
  if path.length() is 0 {
    ret
  }
  var text: String = ""
  loop var i: Int = 0, i < cards.count, ++i {
    let base: Int = i * leafCardFloats
    text = "{text}{cards.floats.copyAtDefault(index: base)} {cards.floats.copyAtDefault(
      index: base + 1
    )} {cards.floats.copyAtDefault(index: base + 2)} {cards.floats.copyAtDefault(index: base + 3)}\n"
  }
  if not Sys.writeFile(path: path, content: text) {
    log("[treeLab] could not write {path}")
  }
}

# The leaf masses' plain material for the layout step: a flat, matte
# grey-green, no picture
func clumpLayoutMaterial() ret Material3d {
  ret Material3d {
    colorTextureLayer: -1
    baseColor: Vec3.create(x: 0.36, y: 0.42, z: 0.3)
    metallic: 0.0
    roughness: 1.0
    emission: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    toon: false
  }
}
