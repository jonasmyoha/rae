# The tree lab's forest scene (RAE_TREELAB_SCENE=forest,
# docs/tree-sets-design.md §5 step 5): a tree set as a forest at every
# distance, from the camera out to 1.9 km (app3d/TreeForest), so the sets
# can be compared in the same light: the stylized set (the walkers') and the
# low-poly set (Autumn Grove's museum), and the T02 tree alone as a set
# (stylizedTrees/ReferenceTrees, reference-tree step 7).
# RAE_TREE_SET=lowPoly|stylized|reference picks the one shown first
# (stylized when unset); the T key goes to the next. All are built at the
# start, so a switch is instant.
# RAE_TREELAB_CAMERA=high looks from 35 m over the forest instead of eye
# height.
import Sys
open Vec3
open Mesh3d
open Scene3d
open ecs/Entity
open RendererDeferred
open app3d/TreeForest
open app3d/PropField
open treeSets/TreeSet
import stylizedTrees/StylizedTrees
import lowPolyTrees/LowPolyTrees
import stylizedTrees/ReferenceTrees

# The band of forest ahead of the camera, and the meadow under it
const labForestWidth: Float = 640.0

const labForestNear: Float = 8.0

const labForestFar: Float = 1900.0

const labForestSpacing: Float = 7.0

const labForestGroundSize: Float = 4400.0

# The sets the scene holds, in this order
const labForestStylized: Int = 0

const labForestLowPoly: Int = 1

const labForestReference: Int = 2

# The forest's reach and its trees' spacing (m): RAE_TREELAB_FOREST_FAR and
# RAE_TREELAB_FOREST_SPACING (the panel's Forest group sets them), else the constants above
func labForestEnvFloat(name: view String, fallback: view Float) ret Float {
  let text: String = Sys.getEnv(name: name)
  if text.length() > 0 {
    ret text.toFloat()
  }
  ret fallback
}

func labForestFarHere() ret Float {
  ret labForestEnvFloat(name: "RAE_TREELAB_FOREST_FAR", fallback: labForestFar)
}

func labForestSpacingHere() ret Float {
  ret labForestEnvFloat(name: "RAE_TREELAB_FOREST_SPACING", fallback: labForestSpacing)
}

# RAE_TREELAB_FOREST=off: the forest scene without its forests (its ground, sky and grass)
func labForestOn() ret Bool {
  ret Sys.getEnv(name: "RAE_TREELAB_FOREST") is not "off"
}

func labForestRequested() ret Bool {
  ret Sys.getEnv(name: "RAE_TREELAB_SCENE") is "forest"
}

# The set RAE_TREE_SET names (stylized when unset or unknown)
func labForestFirstSet() ret Int {
  if Sys.getEnv(name: "RAE_TREE_SET") is "lowPoly" {
    ret labForestLowPoly
  }
  if Sys.getEnv(name: "RAE_TREE_SET") is "reference" {
    ret labForestReference
  }
  ret labForestStylized
}

func labForestSetName(setIndex: view Int) ret String {
  if setIndex is labForestLowPoly {
    ret "lowPoly"
  }
  if setIndex is labForestReference {
    ret "reference"
  }
  ret "stylized"
}

# The lab's ground and clouds, and a meadow under the whole forest
func buildLabForestWorld(meshes: view LabMeshes, renderer: mod DeferredRenderer) ret World3d {
  var world: World3d = buildLabGround(meshes: meshes)
  let meadow: MeshData = makePlane(size: labForestGroundSize, segments: 1)
  let unusedEntityId: EntityId = world3dAddMeshInstance(
    world: world
    mesh: uploadLabMesh(renderer: renderer, meshData: meadow)
    material: labMaterial(
      red: labGroundRed
      green: labGroundGreen
      blue: labGroundBlue
      roughness: 1.0
    )
    position: Vec3.create(x: 0.0, y: labForestGroundSize * 0.5 - 200.0, z: -0.01)
    rotation: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  )
  ret world
}

# One set's forest, planted in the band and finished
func buildLabForestOf(treeSet: view TreeSet, renderer: mod DeferredRenderer) ret TreeForest {
  var forest: TreeForest = createTreeForest(
    treeSet: treeSet
    renderer: renderer
    settings: defaultTreeForestSettings(extent: labForestFarHere() * 2.0 + 400.0, farReach: 1800.0)
    toon: false
  )
  # RAE_TREE_NEAR_TO_FAR=1: gather and draw near to far (PropField.nearToFar)
  forest.field.nearToFar = Sys.getEnv(name: "RAE_TREE_NEAR_TO_FAR") is "1"
  let unusedPlanted: Int = plantTreeForestBand(
    forest: forest
    treeSet: treeSet
    band: {
      width: labForestWidth
      near: labForestNear
      far: labForestFarHere()
      spacing: labForestSpacingHere()
    }
  )
  let planted: Int = finishTreeForest(forest: forest, renderer: renderer)
  log("[treelab] forest of the {treeSet.name} set: {planted} trees, to {labForestFarHere()} m")
  ret forest
}

# Every set's forest, in the order of labForestStylized, labForestLowPoly,
# labForestReference
func buildLabForests(renderer: mod DeferredRenderer) ret List(TreeForest) {
  var forests: List(TreeForest) = List.create(TreeForest, cap: 3)
  if not labForestOn() {
    ret forests
  }
  forests.add(
    value: own buildLabForestOf(treeSet: StylizedTrees.createStylizedTrees(), renderer: renderer)
  )
  forests.add(
    value: own buildLabForestOf(treeSet: LowPolyTrees.createLowPolyTrees(), renderer: renderer)
  )
  forests.add(
    value: own buildLabForestOf(treeSet: ReferenceTrees.createReferenceTrees(), renderer: renderer)
  )
  ret forests
}

# The T02 scene's tree (variety 1, as the lab grows it) as the one tree of a
# forest of the reference set, at the origin: its levels at the walkers'
# distances (RAE_TREE_LEVEL pins one). RAE_TREELAB_SPECIES=<n> plants the
# stylized set's species n there instead, at its own height (scale 1), or
# with RAE_TREE_SET=lowPoly the low-poly set's.
func labLevelsForest(renderer: mod DeferredRenderer) ret TreeForest {
  let speciesName: String = Sys.getEnv(name: "RAE_TREELAB_SPECIES")
  var treeSet: TreeSet = ReferenceTrees.createReferenceTrees()
  var kind: Int = 0
  if speciesName.length() > 0 {
    treeSet = StylizedTrees.createStylizedTrees()
    if Sys.getEnv(name: "RAE_TREE_SET") is "lowPoly" {
      treeSet = LowPolyTrees.createLowPolyTrees()
    }
    kind = speciesName.toInt()
  }
  # RAE_TREELAB_SCALE sizes the tree (the low-poly set's are 1 m tall)
  var scale: Float = 1.0
  let scaleName: String = Sys.getEnv(name: "RAE_TREELAB_SCALE")
  if scaleName.length() > 0 {
    scale = scaleName.toFloat()
  }
  var forest: TreeForest = createTreeForest(
    treeSet: treeSet
    renderer: renderer
    settings: defaultTreeForestSettings(extent: 800.0, farReach: 400.0)
    toon: false
  )
  addPropPlacement(
    field: forest.field
    placement: { kind: kind, position: Vec3.create(x: 0.0, y: 0.0, z: 0.0), yaw: 0.0, scale: scale }
  )
  let unusedPlanted: Int = finishTreeForest(forest: forest, renderer: renderer)
  ret forest
}

# The tree kind One tree shows (RAE_TREELAB_SPECIES): -1 the reference T02 tree, else a kind of
# the stylized set (or the low-poly set with RAE_TREE_SET=lowPoly)
func labTreeKind() ret Int {
  let speciesName: String = Sys.getEnv(name: "RAE_TREELAB_SPECIES")
  if speciesName.length() is 0 {
    ret -1
  }
  ret speciesName.toInt()
}

func labTreeKindSet() ret TreeSet {
  if Sys.getEnv(name: "RAE_TREE_SET") is "lowPoly" {
    ret LowPolyTrees.createLowPolyTrees()
  }
  ret StylizedTrees.createStylizedTrees()
}

# The kinds the panel steps through: the reference tree, then the set's
func labTreeKindCount() ret Int {
  ret treeSpeciesCount(treeSet: labTreeKindSet())
}

func labTreeKindName() ret String {
  let kind: Int = labTreeKind()
  if kind < 0 {
    ret "T02 tree"
  }
  let treeSet: TreeSet = labTreeKindSet()
  if let species: view TreeSpecies = treeSet.species.viewAt(index: kind) {
    ret "{species.name}"
  }
  ret "kind {kind}"
}

# The camera at eye height down the forest's lane, or (high) from 35 m
func labForestCamera(name: view String) ret Camera3d {
  var camera: Camera3d = defaultCamera3d()
  camera.fovYDeg = 50
  camera.nearZ = 0.1
  camera.farZ = 2600
  if name is "high" {
    camera.position = Vec3.create(x: 0.0, y: -6.0, z: 34.0)
    camera.target = Vec3.create(x: 0.0, y: 150.0, z: 0.0)
    ret camera
  }
  camera.position = Vec3.create(x: 0.0, y: -10.0, z: 1.7)
  camera.target = Vec3.create(x: 0.0, y: 30.0, z: 2.6)
  ret camera
}
