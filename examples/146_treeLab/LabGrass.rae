# The tree lab's grass: the standard lib GPU grass (lib/GrassCompute.rae), on
# the lab's flat ground (assets/lab_surface.wgsl). The grid is centered on the
# tree (or the studies), so every camera sees grass round it; the trunk (or
# the studies' trunks and rocks) are obstacle circles.
#
# The panel's Grass groups (LabEditor labControlButtons, applyLabGrassControl) set LabGrassLook:
# the grass on or off, its density, its blades' height and width, how far it reaches and how much
# the wind moves it; its defaults are the lab's grass as it always was. In an interactive run the
# grass and the ground follow the date (app3d/GroundPalette, as the walkers' do: dead grass in
# winter, fresh in spring) as a tint of the lab's summer colors; the snow sinks it (lib/snow.wgsl,
# Gbuffer setGbufferSnow).
#
# Two kinds (the panel's Grass kind, RAE_TREELAB_GRASS=meadow|painted to start with one): the
# walkers' meadow grass, one field per scene (createLabGrass), and game proto1's painted grass in
# three rings to 20, 120 and 300 m (GrassConfig grassPaintedSettings, lib/GrassTiers), made the
# first time it is shown and kept for every scene: it takes the shown scene's obstacles from that
# scene's meadow field. Its blades are the ground's color where they stand, so the date reaches it
# through GrassTiers grassTiersSetGround. The blade height, width, reach and wind controls are the
# meadow's; the painted grass keeps its recipe, takes the density, and its outer rings switch off.
import GrassConfig
import Math
import Sys
import Vec3
open ecs/ComponentTable
open app3d/GroundPalette
open Wind
open GrassCompute
open GrassBenders
open GrassTiers
open Gbuffer
open Scene3d
open gpu/GpuResources
open LabScene

# The grid's span round the tree (m)
const labGrassExtent: Float = 90.0

# The grass of the T02 scene: one obstacle, the trunk at the origin
func labTrunkField() ret List(Float) {
  ret List(Float) { 1.0, 0.0, 0.0, labTrunkRadius + 0.15 }
}

# `obstacles` is the surface field: the count, then x, y and radius of each
# circle the grass leaves free
func createLabGrass(obstacles: view List(Float)) ret GrassCompute {
  var grass: GrassCompute = createGrassCompute()
  grassSetComputeShaderWithConstants(
    grass: grass
    shader: shader(files: [
      "lib/gpu/computeBounds.wgsl"
      "assets/lab_surface.wgsl"
      "lib/grass_field.wgsl"
      "lib/grass_root_field.wgsl"
      "lib/grass_compute.wgsl"
    ])
    constants: List.create(ShaderConstant, cap: 0)
  )
  grassSetSurfaceField(grass: grass, values: obstacles)
  ret grass
}

# The grass as the panel set it (the defaults: the meadow grass as the lab always drew it)
type LabGrassLook {
  on: Bool = true
  # the share of blades kept, their height and width (GrassViewSettings' scales), the grid's
  # span (m) and the wind's strength on the blades
  density: Float = 1.0
  height: Float = 0.55
  width: Float = 1.8
  reach: Float = labGrassExtent
  wind: Float = 0.48
  # the date's tint of the lab's summer grass and ground (1: summer), and its ground palette
  # (app3d/GroundPalette: the painted grass's dry straw and how far the ground has gone to it)
  tint: Vec3 = Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  palette: GroundPalette = summerGroundPalette()
  # the kind: "meadow" or "painted"; the painted grass's outer rings (120 and 300 m) on
  kind: String = labGrassKindAtStart()
  rings: Bool = true
}

func labGrassKindAtStart() ret String {
  if Sys.getEnv(name: "RAE_TREELAB_GRASS") is "painted" {
    ret "painted"
  }
  ret "meadow"
}

# The grass and the ground at the date's palette (LabSeason labGroundPalette)
func labGrassFollowDate(look: mod LabGrassLook, palette: view GroundPalette) {
  look.tint = labGrassTint(palette: palette)
  look.palette = palette
}

# The painted grass's rings, made the first time they are shown (none before), and the scene whose
# obstacles they have
type LabGrassField {
  painted: opt GrassTiers = none
  scene: Int = 0
}

# The painted rings with `obstacles` (a scene's surface field): the near field, the middle and the
# far ring, each its own GPU grass on the lab's ground (grids of 512, 512 and 256 blades a side,
# as game proto1's)
func createLabPaintedGrass(obstacles: view List(Float)) ret GrassTiers {
  let near: GrassViewSettings = GrassConfig.grassPaintedSettings(
    groundColor: labGroundColor(tint: Vec3.create(x: 1.0, y: 1.0, z: 1.0))
    dryColor: groundDryGrass()
    rootLift: 0.3
  )
  let mid: GrassViewSettings = GrassConfig.grassPaintedMidRing(
    near: near
    reach: GrassConfig.grassPaintedMidReach
  )
  let far: GrassViewSettings = GrassConfig.grassPaintedFarRing(
    mid: mid
    reach: GrassConfig.grassPaintedFarReach
  )
  var tiers: GrassTiers = createGrassTiers()
  addGrassTier(
    tiers: tiers
    compute: createLabGrass(obstacles: obstacles)
    settings: near
    side: 512
    on: true
  )
  addGrassTier(
    tiers: tiers
    compute: createLabGrass(obstacles: obstacles)
    settings: mid
    side: 512
    on: true
  )
  addGrassTier(
    tiers: tiers
    compute: createLabGrass(obstacles: obstacles)
    settings: far
    side: 256
    on: true
  )
  ret tiers
}

func labGrassSettings(look: view LabGrassLook) ret GrassViewSettings {
  var settings: GrassViewSettings = GrassConfig.grassMeadowSettings(
    groundColor: labGroundColor(tint: look.tint)
  )
  settings.extent = look.reach
  settings.densityScale = look.density
  settings.bladeHeightScale = look.height
  settings.bladeWidthScale = look.width
  settings.windStrength = look.wind
  ret settings
}

func labGroundColor(tint: view Vec3) ret Vec3 {
  ret Vec3.create(x: labGroundRed * tint.x, y: labGroundGreen * tint.y, z: labGroundBlue * tint.z)
}

# The date's tint: GroundPalette's grass now against its summer grass, channel by channel, so the
# lab's own green is kept in summer
func labGrassTint(palette: view GroundPalette) ret Vec3 {
  let summer: Vec3 = groundSummerGrass()
  ret Vec3.create(
    x: palette.grass.x / summer.x
    y: palette.grass.y / summer.y
    z: palette.grass.z / summer.z
  )
}

# The ground under the grass takes the same tint: it is the first entity of every scene's world
# (LabScene buildLabGround)
func setLabGroundTint(world: mod World3d, tint: view Vec3) {
  if componentCount(this: world.materials) is 0 {
    ret
  }
  var ground: Material3d = componentCopyAtDefault(this: world.materials, i: 0)
  ground.baseColor = labGroundColor(tint: tint)
  world3dSetMaterial(
    world: world
    entityId: componentEntityAt(this: world.materials, i: 0)
    material: ground
  )
}

# A Grass control (LabEditor labControlButtons): g on/off, x density, h height, b width, r reach,
# j wind. False when `group` is not one of them
func applyLabGrassControl(look: mod LabGrassLook, group: view String, value: view String) ret Bool {
  if group is "g" {
    look.on = value is "on"
  } else if group is "x" {
    look.density = value.toFloat()
  } else if group is "h" {
    look.height = value.toFloat()
  } else if group is "b" {
    look.width = value.toFloat()
  } else if group is "r" {
    look.reach = value.toFloat()
  } else if group is "j" {
    look.wind = value.toFloat()
  } else if group is "c" {
    look.kind = value
  } else if group is "e" {
    look.rings = value is "on"
  } else {
    ret false
  }
  ret true
}

# The Grass groups' current choices, to show them selected (the values as the buttons' ids spell
# them)
func labGrassChoiceIds(look: view LabGrassLook) ret List(String) {
  var on: String = "off"
  if look.on {
    on = "on"
  }
  var rings: String = "off"
  if look.rings {
    rings = "on"
  }
  ret List(String) {
    "g:{on}"
    "x:{look.density}"
    "h:{look.height}"
    "b:{look.width}"
    "r:{look.reach.toInt()}"
    "j:{look.wind}"
    "c:{look.kind}"
    "e:{rings}"
  }
}

# This frame's blades (the compute pass), before the G-buffer pass draws them;
# the grid is centered on (centerX, centerY)
func generateLabGrass(
  grass: mod GrassCompute
  resources: mod GpuResources
  centerX: view Float
  centerY: view Float
  camera: view Camera3d
  deltaTime: view Float
  wind: view WindVector
  look: view LabGrassLook
) {
  if not look.on {
    ret
  }
  # as many candidates per square meter at every reach: the default grid's side, scaled with the
  # span (a new side rebuilds the compute pipeline, so it is set only when it changes)
  let defaultSide: Float = Math.sqrt(x: grassGpuBladeCount.toFloat())
  let side: Int = (defaultSide * look.reach / labGrassExtent + 0.5).toInt()
  if side * side is not grass.bladeCount {
    grassSetBladeSide(grass: grass, side: side)
  }
  grassGenerate(
    grass: grass
    resources: resources
    centerX: centerX
    centerY: centerY
    groundZ: 0.0
    deltaTime: deltaTime
    wind: wind
    toon: 0
    camX: camera.position.x
    camY: camera.position.y
    camZ: camera.position.z
    fwdX: camera.target.x - camera.position.x
    fwdY: camera.target.y - camera.position.y
    fwdZ: camera.target.z - camera.position.z
    settings: labGrassSettings(look: look)
  )
}

# This frame's grass of the kind chosen (the compute passes), before the G-buffer pass: the
# meadow field of the scene shown (`meadow`), or the painted rings, given that scene's obstacles
# when the scene changed and the date's ground
func labGrassFrame(
  field: mod LabGrassField
  meadow: mod GrassCompute
  resources: mod GpuResources
  scene: view Int
  centerX: view Float
  centerY: view Float
  camera: view Camera3d
  deltaTime: view Float
  wind: view WindVector
  look: view LabGrassLook
) {
  if not look.on {
    ret
  }
  if look.kind is not "painted" {
    generateLabGrass(
      grass: meadow
      resources: resources
      centerX: centerX
      centerY: centerY
      camera: camera
      deltaTime: deltaTime
      wind: wind
      look: look
    )
    ret
  }
  if field.painted is none {
    field.painted = createLabPaintedGrass(obstacles: meadow.surfaceField)
    field.scene = scene
    log("[treelab] painted grass: rings to 20, 120 and 300 m")
  }
  if let tiers: mod GrassTiers = field.painted {
    if field.scene is not scene {
      loop var i: Int = 0, i < tiers.tiers.length, ++i {
        if let tier: mod GrassTier = tiers.tiers.modAt(index: i) {
          grassSetSurfaceField(grass: tier.compute, values: meadow.surfaceField)
        }
      }
      field.scene = scene
    }
    grassTierSetOn(tiers: tiers, index: 1, on: look.rings)
    grassTierSetOn(tiers: tiers, index: 2, on: look.rings)
    grassTiersSetGround(
      tiers: tiers
      groundColor: labGroundColor(tint: look.tint)
      dryColor: look.palette.dry
      dryAmount: look.palette.dryAmount
    )
    grassTiersFrame(
      tiers: tiers
      resources: resources
      centerX: centerX
      centerY: centerY
      groundZ: 0.0
      deltaTime: deltaTime
      wind: wind
      toon: 0
      share: look.density
      benders: List.create(Float, cap: 0)
      camera: camera.position
      target: camera.target
    )
  }
}

# The kind chosen's blades, into the open G-buffer pass
func labGrassDraw(
  field: mod LabGrassField
  meadow: mod GrassCompute
  resources: mod GpuResources
  gbuffer: view GbufferCache
  gbufferResources: view GpuResources
  look: view LabGrassLook
) {
  if not look.on {
    ret
  }
  if look.kind is "painted" {
    if let tiers: mod GrassTiers = field.painted {
      grassTiersDraw(
        tiers: tiers
        resources: resources
        cache: gbuffer
        rendererResources: gbufferResources
      )
    }
    ret
  }
  grassDraw(
    grass: meadow
    resources: resources
    gbuffer: gbuffer
    gbufferResources: gbufferResources
  )
}

func labGrassFieldShutdown(field: mod LabGrassField, resources: mod GpuResources) {
  if let tiers: mod GrassTiers = field.painted {
    grassTiersShutdown(tiers: tiers, resources: resources)
  }
}
