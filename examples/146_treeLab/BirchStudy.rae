# Optional fixed-clock captures. The normal app never moves its camera here.
open app3d/CameraRig
open Scene3d
open Vec3
import Sys
import Math

type BirchStudy {
  motion: String
  output: String
  frame: Int
}

func createBirchStudy() ret BirchStudy {
  ret BirchStudy {
    motion: Sys.getEnv(name: "RAE_BIRCH_MOTION")
    output: Sys.getEnv(name: "RAE_BIRCH_FRAMES")
    frame: 0
  }
}

func stepBirchStudy(study: mod BirchStudy, camera: mod Camera3d, rig: mod CameraRig) {
  if study.motion.length() is 0 {
    ret
  }
  let fraction: Float = Math.min(a: study.frame.toFloat() / 179.0, b: 1.0)
  rig.mode = CameraRigMode.orbit
  camera.target = Vec3.create(x: -16, y: -10, z: 4.3)
  rig.yaw = 0.1 + fraction * 6.2831853
  rig.orbitPitch = 0.12
  rig.distance = 16
  if study.motion is "walk" {
    rig.yaw = -0.55 + fraction * 1.1
    rig.distance = 16.0 - Math.sin(x: fraction * 3.1415927) * 7.0
    rig.orbitPitch = Math.asin(x: -2.6 / rig.distance)
  }
  snapCameraRigView(rig: rig)
  applyCameraRig(rig: rig, camera: camera)
  if study.output.length() > 0 {
    Sys.setEnv(name: "RAE_GPU2D_SCREENSHOT", value: "{study.output}/frame{study.frame}.bmp")
  }
  study.frame = study.frame + 1
}
