# The tree lab (docs/reference-tree-plan.md step 1): the scene the new tree
# generator is built and judged in, against ONE reference tree, crop T02 of
# the private reference study. The tree is lib/treeGen's (LabTree.rae); the
# background trees, bushes and clouds are placeholders of cylinders and
# spheres. Built new: it uses no older tree code of the lib (the plan's
# "Built new" list), only lib/treeGen, the renderer, the lib GPU grass and
# plain meshes.
#
# The tree is lib/treeGen's (step 3 on: the bare wood so far), seed
# RAE_TREELAB_SEED (default 1); RAE_TREELAB_TREE=levels draws it as a forest
# kind (near, middle and impostor levels, RAE_TREE_LEVEL to pin one:
# reference-tree step 7); RAE_TREELAB_TREE=placeholder shows step 1's
# cylinder and spheres instead.
#
# Cameras (RAE_TREELAB_CAMERA):
#   near (default)  T02's own framing of the 12.5 m tree: from eye height
#                   15.2 m away, looking 18 degrees up, the trunk's foot
#                   near the bottom edge, the top near the top edge
#   mid             the same tree from 40 m
#   far             the same tree from 120 m
#   bark            the trunk up close (4 m), for its color and streaks
#   row             the traced tree and three trees grown from its measures
#                   (treeGen/TreeGrower) beside it, from 32 m (also
#                   RAE_TREELAB_ROW=1 with another camera)
#   fork            the first grown tree's fork and branch joints up close
#                   (6 m, looking up), with the row
#   tracedFork      the same view of the traced tree
#   small           a 6 m tree (RAE_TREELAB_SPECIES) from 13 m at eye height
#   bush            the bush (RAE_TREELAB_SPECIES=15, scale 1) from 3 m
#
# The studies (LabStudies.rae): RAE_TREELAB_STUDY=<view> shows one of the
# meadow flower study scenes that Autumn Grove (138) held before it became
# the low-poly museum (flowers, bellflowers and its two other views) in
# place of the T02 scene.
#
# The forest scene (LabForest.rae): RAE_TREELAB_SCENE=forest shows a tree
# set as a forest at every distance, RAE_TREE_SET=lowPoly|stylized picks
# which (stylized when unset), the T key switches between the two;
# RAE_TREELAB_CAMERA=high looks from 35 m.
#
# RAE_TREELAB_DOLLY=<folder>: the camera moves from 20 m to 170 m away from
# the tree over labDollyFrames frames, each saved as a picture in the folder
# (frame0.bmp ...), then the lab ends: the camera move that shows whether
# the levels' switches are seen (with RAE_TREELAB_TREE=levels).
#
# The comparison picture (T02 beside the render, same height):
#   examples/146_treeLab/compare.sh [near|mid|far]
# The scene look (LabLook: haze, warm sun and cool shade, grade, glow) is on;
# RAE_TREELAB_LOOK=plain keeps the renderer's defaults for a before/after.
# A plain screenshot:
#   RAE_SDL_HEADLESS_MS=4000 RAE_GPU2D_SCREENSHOT=/tmp/lab.bmp \
#     rae run examples/146_treeLab/Main.rae
import Gpu2d
import Keys
import Sdl3
import Sys
import Vec3
import Math
open Wind
open Scene3d
open Gbuffer
open GbufferWorld
open RendererDeferred
open RendererDeferredShadow
open Rendergraph
open Math3d
open Shadow3d
open Sky
open GrassCompute
open gpu/GpuResources
open gpu/GpuLifetime
open LabScene
open LabGrass
open LabLook
open LabTree
open treeGen/LeafPass
open RendererWind
open app3d/CameraRig
open LabStudies
open app3d/TreeForest
open LabForest
open RendererQuality
open MeshStore

# A fixed late-morning sun from the camera's front left, as in T02 (the
# trunk is lit on its left): the direction the light TRAVELS
const labSunX: Float = 0.5

const labSunY: Float = 0.55

const labSunZ: Float = -0.62

# The dolly's length in frames, and its nearest and farthest distance (m)
const labDollyFrames: Int = 240

const labDollyNear: Float = 20.0

const labDollyFar: Float = 170.0

const labStatsFrames: Int = 120

type LabState {
  renderer: DeferredRenderer
  world: World3d
  light: Light3d
  camera: Camera3d
  # The app's GPU manager: the grass's compute pass lives in it
  gpuResources: opt GpuResources
  grass: GrassCompute
  # where the grass grid is centered: the tree, or the studies
  grassCenterX: Float = 0.0
  grassCenterY: Float = 0.0
  # the study shown (RAE_TREELAB_STUDY), empty for the T02 scene, and its
  # camera rig
  studyView: String = ""
  cameraRig: CameraRig
  # the forest scene's two forests (stylized, low-poly; empty in the other
  # scenes) and the one shown
  forests: List(TreeForest) = List.create(TreeForest, cap: 0)
  forestShown: Int = 0
  # the dolly (RAE_TREELAB_DOLLY): its folder and the frame it is at
  dollyFolder: String = Sys.getEnv(name: "RAE_TREELAB_DOLLY")
  dollyFrame: Int = 0
  # RAE_TREELAB_STATS=1: every labStatsFrames frames a line of what the
  # shown forest drew and how long the gather and the frames took
  statsOn: Bool = Sys.getEnv(name: "RAE_TREELAB_STATS") is "1"
  statsFrames: Int = 0
  statsGatherSeconds: Float64 = 0.0
  statsStart: Float64 = 0.0
  # the generated tree's leaves and its crown's shadow caster
  tree: opt LabTree
  windSettings: WindSettings
  wind: WindState
  lastTime: Float64
}

# The camera RAE_TREELAB_CAMERA names. The near one is T02's own framing,
# solved from the hand-drawn trace (examples/146_treeLab/traceTree.py):
# seen from 1.6 m with a 50 degree vertical field, a 12.5 m tree's foot
# lands on the trace's base dot (98% down the picture) and its top on the
# trace's top dot, so the trace maps onto the tree one to one: 15.2 m away,
# looking 18 degrees up, shifted 0.69 m so the trunk stands left of the
# middle as T02's does.
func labCamera(name: view String) ret Camera3d {
  var camera: Camera3d = defaultCamera3d()
  camera.fovYDeg = 50
  camera.nearZ = 0.1
  camera.farZ = 900
  if name is "mid" {
    camera.position = Vec3.create(x: 0.0, y: -40.0, z: 1.6)
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: 6.5)
    ret camera
  }
  if name is "row" {
    # the traced tree and the three grown ones beside it (LabTree's row,
    # 11 m apart along x), all in one frame from 32 m
    camera.position = Vec3.create(x: 16.5, y: -32.0, z: 1.6)
    camera.target = Vec3.create(x: 16.5, y: 0.0, z: 6.0)
    ret camera
  }
  if name is "tracedFork" {
    camera.position = Vec3.create(x: 1.0, y: -5.5, z: 6.5)
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: 9.5)
    ret camera
  }
  if name is "fork" {
    # the first grown tree of the row (x 11), its fork and the joints of
    # its upper branches
    camera.position = Vec3.create(x: 12.0, y: -5.5, z: 6.5)
    camera.target = Vec3.create(x: 11.0, y: 0.0, z: 9.5)
    ret camera
  }
  if name is "bark" {
    # the trunk up close, at eye height, for its color and streaks
    camera.position = Vec3.create(x: 0.6, y: -4.0, z: 1.7)
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: 2.6)
    ret camera
  }
  if name is "bush" {
    camera.position = Vec3.create(x: 0.0, y: -3.0, z: 0.9)
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: 0.3)
    ret camera
  }
  if name is "small" {
    camera.position = Vec3.create(x: 0.0, y: -13.0, z: 1.6)
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: 3.4)
    ret camera
  }
  if name is "far" {
    camera.position = Vec3.create(x: 0.0, y: -120.0, z: 1.6)
    camera.target = Vec3.create(x: 0.0, y: 0.0, z: 6.5)
    ret camera
  }
  let pitch: Float = 18.0 * 3.141592653589793 / 180.0
  camera.position = Vec3.create(x: 0.69, y: -15.2, z: 1.6)
  camera.target = Vec3.create(
    x: 0.69
    y: -15.2 + 10.0 * Math.cos(x: pitch)
    z: 1.6 + 10.0 * Math.sin(x: pitch)
  )
  ret camera
}

# One of the studies (RAE_TREELAB_STUDY): its world, light and camera
func createStudyLab(studyView: view String) ret LabState {
  var renderer: DeferredRenderer = createDeferredRenderer()
  # RAE_QUALITY=ultra: full resolution, as the settings panel's Ultra
  setRendererFullResolution(renderer: renderer, on: Sys.getEnv(name: "RAE_QUALITY") is "ultra")
  let meshes: LabMeshes = createLabMeshes(renderer: renderer)
  var obstacles: List(StudyObstacle) = List.create(StudyObstacle, cap: 64)
  var world: World3d = buildStudyWorld(meshes: meshes, renderer: renderer, obstacles: obstacles)
  var light: Light3d = defaultLight3d()
  applyStudyLight(renderer: renderer, light: light, studyView: studyView)
  var camera: Camera3d = studyCamera()
  let rig: CameraRig = studyCameraRig(camera: camera, studyView: studyView)
  var idIssuer: IdIssuer = IdIssuer.create()
  let windSettings: WindSettings = defaultWindSettings()
  unsafe {
    ret LabState {
      renderer: own renderer
      world: own world
      light: light
      camera: camera
      gpuResources: GpuResources.create(issuer: idIssuer, capacity: 32)
      grass: createLabGrass(obstacles: studyObstacleField(obstacles: obstacles))
      grassCenterX: studyGrassCenterX
      grassCenterY: studyGrassCenterY
      studyView: studyView
      cameraRig: rig
      tree: none
      windSettings: windSettings
      wind: createWindState(settings: windSettings)
      lastTime: Gpu2d.nowSeconds()
    }
  }
}

# The forest scene (RAE_TREELAB_SCENE=forest): both sets' forests, the
# lab's sun and look
func createForestLab() ret LabState {
  var renderer: DeferredRenderer = createDeferredRenderer()
  # RAE_QUALITY=ultra: full resolution, as the settings panel's Ultra
  setRendererFullResolution(renderer: renderer, on: Sys.getEnv(name: "RAE_QUALITY") is "ultra")
  let meshes: LabMeshes = createLabMeshes(renderer: renderer)
  var world: World3d = buildLabForestWorld(meshes: meshes, renderer: renderer)
  var forests: List(TreeForest) = buildLabForests(renderer: renderer)
  var light: Light3d = defaultLight3d()
  light.sunDir = Vec3.vnorm(a: Vec3.create(x: labSunX, y: labSunY, z: labSunZ))
  applyLabLook(renderer: renderer, light: light)
  let camera: Camera3d = labForestCamera(name: Sys.getEnv(name: "RAE_TREELAB_CAMERA"))
  var idIssuer: IdIssuer = IdIssuer.create()
  let windSettings: WindSettings = defaultWindSettings()
  unsafe {
    ret LabState {
      renderer: own renderer
      world: own world
      light: light
      camera: camera
      gpuResources: GpuResources.create(issuer: idIssuer, capacity: 32)
      # grass round the camera, no obstacles
      grass: createLabGrass(obstacles: List(Float) { 0.0 })
      grassCenterX: 0.0
      grassCenterY: 30.0
      cameraRig: createCameraRig(camera: camera)
      forests: own forests
      forestShown: labForestFirstSet()
      tree: none
      windSettings: windSettings
      wind: createWindState(settings: windSettings)
      lastTime: Gpu2d.nowSeconds()
    }
  }
}

func createLab() ret LabState {
  if labForestRequested() {
    Gpu2d.initWindow(
      width: 1280
      height: 800
      title: "146: Tree lab | forest: RAE_TREE_SET=lowPoly|stylized, T switches"
    )
    ret createForestLab()
  }
  let studyView: String = labStudyName()
  if studyView.length() > 0 {
    Gpu2d.initWindow(width: 1280, height: 800, title: "146: Tree lab | study: {studyView}")
    ret createStudyLab(studyView: studyView)
  }
  Gpu2d.initWindow(
    width: 1280
    height: 800
    title: "146: Tree lab | camera: RAE_TREELAB_CAMERA=near|mid|far"
  )
  var renderer: DeferredRenderer = createDeferredRenderer()
  # RAE_QUALITY=ultra: full resolution, as the settings panel's Ultra
  setRendererFullResolution(renderer: renderer, on: Sys.getEnv(name: "RAE_QUALITY") is "ultra")
  let meshes: LabMeshes = createLabMeshes(renderer: renderer)
  let placeholder: Bool = Sys.getEnv(name: "RAE_TREELAB_TREE") is "placeholder"
  var world: World3d = buildLabWorld(meshes: meshes, placeholderTree: placeholder)
  # RAE_TREELAB_TREE=levels: the same tree drawn as a forest kind (its near,
  # middle and impostor levels, LabForest's labLevelsForest) in place of
  # the leaf pass
  let levels: Bool = Sys.getEnv(name: "RAE_TREELAB_TREE") is "levels"
  var forests: List(TreeForest) = List.create(TreeForest, cap: 1)
  var tree: opt LabTree = none
  if levels {
    forests.add(value: own labLevelsForest(renderer: renderer))
  } else if not placeholder {
    tree = addGeneratedTree(world: world, renderer: renderer, seed: labTreeSeed())
  }
  var light: Light3d = defaultLight3d()
  light.sunDir = Vec3.vnorm(a: Vec3.create(x: labSunX, y: labSunY, z: labSunZ))
  applyLabLook(renderer: renderer, light: light)
  var idIssuer: IdIssuer = IdIssuer.create()
  let windSettings: WindSettings = defaultWindSettings()
  let camera: Camera3d = labCamera(name: Sys.getEnv(name: "RAE_TREELAB_CAMERA"))
  unsafe {
    ret LabState {
      renderer: own renderer
      world: own world
      light: light
      camera: camera
      gpuResources: GpuResources.create(issuer: idIssuer, capacity: 32)
      grass: createLabGrass(obstacles: labTrunkField())
      cameraRig: createCameraRig(camera: camera)
      forests: own forests
      tree: own tree
      windSettings: windSettings
      wind: createWindState(settings: windSettings)
      lastTime: Gpu2d.nowSeconds()
    }
  }
}

# The sun's cascades, fitted to the camera; every mesh of the world casts
func renderLabShadows(state: mod LabState, aspect: view Float) {
  let cascades: ShadowCascades = fitShadowCascades(
    camPos: state.camera.position
    camTarget: state.camera.target
    fovYDeg: state.camera.fovYDeg
    aspect: aspect
    near: state.camera.nearZ
    far: 160.0
    sunDir: state.light.sunDir
    count: 3
    resolution: 2048
    lambda: 0.7
    backExtent: 45.0
  )
  beginShadowPass(renderer: state.renderer, c: cascades)
  renderSceneShadowWorldWith(renderer: state.renderer, world: state.world)
  if let forest: view TreeForest = state.forests.viewAt(index: state.forestShown) {
    drawTreeForestShadows(renderer: state.renderer, forest: forest)
  }
  # the crown's shadow: its solid leaf masses, drawn only into the shadow maps
  if let tree: view LabTree = state.tree {
    if tree.castsMassShadow {
      loop var i: Int = 0, i < tree.massShadows.length, ++i {
        drawShadowCasterWith(
          renderer: state.renderer
          mesh: tree.massShadows.copyAtDefault(index: i)
          model: tree.shadowModels.copyAtDefault(index: i)
        )
      }
    }
  }
  endShadowPass(renderer: state.renderer)
}

# The G-buffer pass: the scene's meshes, then the grass the compute pass
# generated just before
func renderLabGeometry(state: mod LabState, aspect: view Float, deltaTime: view Float) {
  if let resources: mod GpuResources = state.gpuResources {
    generateLabGrass(
      grass: state.grass
      resources: resources
      centerX: state.grassCenterX
      centerY: state.grassCenterY
      camera: state.camera
      deltaTime: deltaTime
      wind: windVector(state: state.wind, settings: state.windSettings)
    )
  }
  ensureRendererResources(renderer: state.renderer)
  if let rendererResources: mod GpuResources = state.renderer.gpuResources {
    Gbuffer.beginPass(
      cache: state.renderer.passes.gbuffer
      resources: rendererResources
      camera: state.camera
      light: state.light
      aspect: aspect
    )
    renderSceneWorld(
      cache: state.renderer.passes.gbuffer
      resources: rendererResources
      world: state.world
    )
    if let forest: mod TreeForest = state.forests.modAt(index: state.forestShown) {
      drawTreeForest(
        cache: state.renderer.passes.gbuffer
        resources: rendererResources
        forest: forest
      )
    }
    if let resources: mod GpuResources = state.gpuResources {
      grassDraw(
        grass: state.grass
        resources: resources
        gbuffer: state.renderer.passes.gbuffer
        gbufferResources: rendererResources
      )
      if let tree: mod LabTree = state.tree {
        loop let leaves: mod LeafPass in tree.leaves {
          drawLeaves(
            leaves: leaves
            resources: resources
            gbuffer: state.renderer.passes.gbuffer
            gbufferResources: rendererResources
            camera: state.camera
            light: state.light
          )
        }
      }
    }
    Gbuffer.endPass(cache: state.renderer.passes.gbuffer, resources: rendererResources)
  }
}

func runLabFrame(state: mod LabState) {
  let now: Float64 = Gpu2d.nowSeconds()
  let deltaTime: Float = Math.min(a: (now - state.lastTime) as Float, b: 0.1)
  state.lastTime = now
  stepWind(state: state.wind, settings: state.windSettings, deltaTime: deltaTime)
  if state.studyView.length() > 0 {
    # the studies' flowers sway in the renderer's wind
    setRendererWind(
      renderer: state.renderer
      wind: windVector(state: state.wind, settings: state.windSettings)
    )
  }
  if state.forests.length > 0 and Sdl3.isKeyPressed(key: Keys.keyT) {
    state.forestShown = (state.forestShown + 1) % state.forests.length
    log("[treelab] showing the {labForestSetName(setIndex: state.forestShown)} set")
  }
  if state.dollyFolder.length() > 0 {
    # a fixed step per frame, so every run films the same move
    let fraction: Float = state.dollyFrame.toFloat() / (labDollyFrames - 1).toFloat()
    let distance: Float = labDollyNear + (labDollyFar - labDollyNear) * fraction
    state.camera.position = Vec3.create(x: 0.0, y: -distance, z: 1.6)
    state.camera.target = Vec3.create(x: 0.0, y: 0.0, z: 6.5)
    Sys.setEnv(
      name: "RAE_GPU2D_SCREENSHOT"
      value: "{state.dollyFolder}/frame{state.dollyFrame}.bmp"
    )
    state.dollyFrame = state.dollyFrame + 1
  }
  if not Gpu2d.renderGate() {
    ret
  }
  let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
  let gatherStart: Float64 = Gpu2d.nowSeconds()
  if let forest: mod TreeForest = state.forests.modAt(index: state.forestShown) {
    gatherTreeForest(forest: forest, camera: state.camera, aspect: aspect)
  }
  state.statsGatherSeconds = state.statsGatherSeconds + (Gpu2d.nowSeconds() - gatherStart)
  gpuPassTimingBegin(renderer: state.renderer)
  loop var passIndex: Int = 0, passIndex < deferredOrderLength(renderer: state.renderer), ++passIndex {
    let tag: Int = deferredTagAt(renderer: state.renderer, i: passIndex)
    gpuPassMark(renderer: state.renderer, tag: tag)
    if tag is RenderTag.shadow {
      renderLabShadows(state: state, aspect: aspect)
    } else if tag is RenderTag.gbuffer {
      renderLabGeometry(state: state, aspect: aspect, deltaTime: deltaTime)
    } else {
      renderDeferredPassWorld(
        renderer: state.renderer
        tag: tag
        world: state.world
        camera: state.camera
        light: state.light
        aspect: aspect
      )
    }
  }
  gpuPassTimingEnd(renderer: state.renderer)
  world3dPrevTransformSystem(world: state.world)
  logLabStats(state: state)
}

# The shown forest's levels this frame: trees and triangles per level (the
# meshes' triangles times their instances), then the impostors, far
# billboards and canopy clusters (two triangles each)
func labForestLevels(forest: view TreeForest, store: view MeshStore) ret String {
  var text: String = ""
  var levels: Int = 0
  loop let kind: view PropKind in forest.field.kinds {
    if kind.lods.length > levels {
      levels = kind.lods.length
    }
  }
  loop var level: Int = 0, level < levels, ++level {
    var trees: Int = 0
    var triangles: Int = 0
    loop var kindIndex: Int = 0, kindIndex < forest.field.kinds.length, ++kindIndex {
      if let kind: view PropKind = forest.field.kinds.viewAt(index: kindIndex) {
        if let lod: view PropLod = kind.lods.viewAt(index: level) {
          let first: Int = forest.field.lodFirstBatch.copyAtFallback(
            index: forest.field.kindFirstLod.copyAtFallback(index: kindIndex, fallback: 0) + level
            fallback: 0
          )
          loop var part: Int = 0, part < lod.parts.length, ++part {
            if let batch: view InstanceBatch = forest.field.batches.viewAt(index: first + part) {
              if part is 0 {
                trees = trees + batch.count
              }
              let mesh: MeshHandle = forest.field.batchMeshes.copyAtDefault(index: first + part)
              triangles = triangles + batch.count * meshStoreIndexCount(store: store, mesh: mesh.id) / 3
            }
          }
        }
      }
    }
    text = "{text} level{level} {trees} trees {triangles} tris;"
  }
  ret "{text} impostors {forest.field.spriteBatch.count}; far billboards {forest.farTrees.batch.count}; canopy clusters {forest.canopy.batch.count}"
}

func logLabStats(state: mod LabState) {
  if not state.statsOn {
    ret
  }
  if state.statsFrames is 0 {
    state.statsStart = Gpu2d.nowSeconds()
    state.statsGatherSeconds = 0.0
  }
  state.statsFrames = state.statsFrames + 1
  if state.statsFrames <= labStatsFrames {
    ret
  }
  let frames: Float = labStatsFrames.toFloat()
  let frameMs: Float = ((Gpu2d.nowSeconds() - state.statsStart) as Float) * 1000.0 / frames
  let gatherMs: Float = (state.statsGatherSeconds as Float) * 1000.0 / frames
  var levels: String = ""
  if let forest: view TreeForest = state.forests.viewAt(index: state.forestShown) {
    levels = labForestLevels(forest: forest, store: state.renderer.passes.gbuffer.meshes)
  }
  log("[treelab stats] frame {frameMs} ms, gather {gatherMs} ms;{levels}")
  state.statsFrames = 0
}

func endLab(state: mod LabState) {
  if let resources: mod GpuResources = state.gpuResources {
    grassShutdown(grass: state.grass, resources: resources)
    if let tree: mod LabTree = state.tree {
      loop let leaves: mod LeafPass in tree.leaves {
        releaseLeafPass(leaves: leaves, resources: resources)
      }
    }
    shutdown(resources: resources)
  }
  if let rendererResources: mod GpuResources = state.renderer.gpuResources {
    loop let forest: mod TreeForest in state.forests {
      treeForestShutdown(forest: forest, resources: rendererResources)
    }
  }
  shutdownDeferredRenderer(renderer: state.renderer)
  Gbuffer.shutdownAll()
  Gpu2d.closeWindow()
}

func main() ret Int {
  var state: LabState = createLab()
  let graphStatus: Int = compileDeferred(renderer: state.renderer)
  if graphStatus is not 0 {
    log("render graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }
  loop not Gpu2d.pollClose() and not (state.dollyFolder.length() > 0 and state.dollyFrame > labDollyFrames) {
    runLabFrame(state: state)
  }
  endLab(state: state)
  ret 0
}
