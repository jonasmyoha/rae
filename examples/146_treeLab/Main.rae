# The dolly's length in frames, and its nearest and farthest distance (m)
const labDollyFrames: Int = 240

const labDollyNear: Float = 20.0

const labDollyFar: Float = 170.0

const labStatsFrames: Int = 120

type LabState {
  # the lab's primitive meshes, uploaded once and shared by every scene
  meshes: LabMeshes
  # the scene shown (LabScenes), and the other scenes built so far, kept to come back to
  scene: Int
  stash: List(LabSceneContent) = List.create(LabSceneContent, cap: 4)
  # the meshes the shown scene's build uploaded (LabSceneContent meshFirst, meshEnd)
  meshFirst: Int = 0
  meshEnd: Int = 0
  # the panel readout's parts that are slow to find: the nearest city (and the latitude and
  # longitude it was found for), One tree's kind
  readoutCity: String = ""
  readoutLatitude: Float = -1000.0
  readoutLongitude: Float = -1000.0
  readoutKind: String = labTreeKindName()
  # RAE_TREELAB_CONTROLS: control ids (LabEditor labControlButtons, comma separated) clicked once
  # at frame 20, to check a rebuild with no panel; and the frames run so far
  scriptedControls: String = Sys.getEnv(name: "RAE_TREELAB_CONTROLS")
  framesRun: Int = 0
  # the editor chrome and its camera (none in a scripted run: LabScenes labScripted)
  editor: opt LabEditor = none
  # the date and the place the seasons run on, and its day slider
  # (LabSeason; the renderer's UI overlay draws it)
  season: LabSeason = createLabSeason()
  renderer: DeferredRenderer
  world: World3d
  light: Light3d
  camera: Camera3d
  # The app's GPU manager: the grass's compute pass lives in it
  gpuResources: opt GpuResources
  grass: GrassCompute
  # where the grass grid is centered: the tree, or the studies
  grassCenterX: Float = 0.0
  grassCenterY: Float = 0.0
  # the study shown (RAE_TREELAB_STUDY), empty for the T02 scene, and its
  # camera rig
  studyView: String = ""
  cameraRig: CameraRig
  # the forest scene's two forests (stylized, low-poly; empty in the other
  # scenes) and the one shown
  forests: List(TreeForest) = List.create(TreeForest, cap: 0)
  forestShown: Int = 0
  # the forest scene's rain and snow (app3d/Precipitation; none elsewhere)
  precipitation: opt Precipitation = none
  # the forest scene's leaves in the air (lib/LeafParticles, released by
  # app3d/LeafRelease; none elsewhere) and a frame count
  leafParticles: opt LeafParticles = none
  leafFrame: Int = 0
  # the dolly (RAE_TREELAB_DOLLY): its folder and the frame it is at
  dollyFolder: String = Sys.getEnv(name: "RAE_TREELAB_DOLLY")
  dollyFrame: Int = 0
  # RAE_TREELAB_STATS=1: every labStatsFrames frames a line of the leaves released, what the
  # shown forest drew and how long the gather and the frames took
  statsOn: Bool = Sys.getEnv(name: "RAE_TREELAB_STATS") is "1"
  statsFrames: Int = 0
  statsGatherSeconds: Float64 = 0.0
  statsStart: Float64 = 0.0
  # the generated tree's leaves and its crown's shadow caster; in an interactive run its leaves
  # follow the date (LabSeason labTreeLeaves; a scripted run keeps summer's, so its pictures stay)
  tree: opt LabTree
  treeSeason: PropSeason = labReferenceTreeSeason()
  treeLeaves: PropLeaves = labSummerLeaves()
  # the grass as the panel's Grass groups set it, and the date's tint (LabGrass)
  grassLook: LabGrassLook = {}
  windSettings: WindSettings
  wind: WindState
  lastTime: Float64
}

# The lab: one renderer and the start scene (LabScenes labStartScene); an interactive run also gets
# the editor chrome
func createLab() ret LabState {
  Gpu2d.initWindow(width: 1280, height: 800, title: "146: Tree lab")
  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  # RAE_QUALITY=ultra: full resolution, as the settings panel's Ultra
  setRendererFullResolution(renderer: renderer, on: Sys.getEnv(name: "RAE_QUALITY") is "ultra")
  let meshes: LabMeshes = createLabMeshes(renderer: renderer)
  let scene: Int = labStartScene()
  var content: LabSceneContent = buildLabScene(renderer: renderer, meshes: meshes, scene: scene)
  var idIssuer: IdIssuer = IdIssuer.create()
  let windSettings: WindSettings = windSettingsFromEnv(settings: defaultWindSettings())
  var editor: opt LabEditor = none
  # RAE_TREELAB_EDITOR=1: the editor in a scripted run too (a picture of the panel)
  if not labScripted() or Sys.getEnv(name: "RAE_TREELAB_EDITOR") is "1" {
    editor = createLabEditor(startScene: scene)
  }
  unsafe {
    var state: LabState = {
      meshes: meshes
      scene: scene
      editor: own editor
      renderer: own renderer
      world: own content.world
      light: content.light
      camera: content.camera
      gpuResources: GpuResources.create(issuer: idIssuer, capacity: 32)
      grass: own content.grass
      grassCenterX: content.grassCenterX
      grassCenterY: content.grassCenterY
      studyView: content.studyView
      cameraRig: createCameraRig(camera: content.camera)
      forests: own content.forests
      forestShown: content.forestShown
      precipitation: own content.precipitation
      leafParticles: own content.leafParticles
      tree: own content.tree
      meshFirst: content.meshFirst
      meshEnd: content.meshEnd
      windSettings: windSettings
      wind: createWindState(settings: windSettings)
      lastTime: Gpu2d.nowSeconds()
    }
    labCameraHome(state: state)
    # the panel's date replaces the season's own bottom slider, and starts at the season's date
    # (RAE_DAY_OF_YEAR), not the panel's own
    if let editor: mod LabEditor = state.editor {
      state.season.shown = false
      labEditorSetDate(
        editor: editor
        year: state.season.clock.year
        dayOfYear: state.season.clock.dayOfYear
      )
    }
    ret state
  }
}

# The camera rig starts from the lab's camera, and Orbit comes back round its target
func labCameraHome(state: mod LabState) {
  if let editor: mod LabEditor = state.editor {
    labEditorCameraHome(editor: editor, rig: state.cameraRig, camera: state.camera)
  }
}

# Show `scene`: the one shown now is kept in the stash, the picked one comes out of it, or is built
# the first time; its light and its camera come with it
func labShowScene(state: mod LabState, scene: view Int) {
  if scene is state.scene or scene < 1 or scene > labSceneLabels().length {
    ret
  }
  state.stash.add(value: own labTakeScene(state: state))
  let found: Int = labStashIndex(state: state, scene: scene)
  var content: LabSceneContent = buildLabSceneOrTake(state: state, scene: scene, found: found)
  applyLabSceneLight(renderer: state.renderer, content: content)
  labPutScene(state: state, content: content)
  labCameraHome(state: state)
  log("[treelab] scene {labSceneLabels().copyAtDefault(index: scene - 1)}")
}

# The stash's copy of `scene` (-1: none)
func labStashIndex(state: view LabState, scene: view Int) ret Int {
  var found: Int = -1
  loop var i: Int = 0, i < state.stash.length, ++i {
    if let stored: view LabSceneContent = state.stash.viewAt(index: i) {
      if stored.scene is scene {
        found = i
      }
    }
  }
  ret found
}

# The shown scene's parts, moved out of the state (labPutScene puts a scene's in)
func labTakeScene(state: mod LabState) ret LabSceneContent {
  ret LabSceneContent {
    scene: state.scene
    world: own state.world
    forests: own state.forests
    forestShown: state.forestShown
    tree: own state.tree
    grass: own state.grass
    grassCenterX: state.grassCenterX
    grassCenterY: state.grassCenterY
    studyView: state.studyView
    precipitation: own state.precipitation
    leafParticles: own state.leafParticles
    light: state.light
    camera: state.camera
    meshFirst: state.meshFirst
    meshEnd: state.meshEnd
  }
}

func labPutScene(state: mod LabState, content: mod LabSceneContent) {
  state.scene = content.scene
  state.world = own content.world
  state.forests = own content.forests
  state.forestShown = content.forestShown
  state.tree = own content.tree
  state.grass = own content.grass
  state.grassCenterX = content.grassCenterX
  state.grassCenterY = content.grassCenterY
  state.studyView = content.studyView
  state.precipitation = own content.precipitation
  state.leafParticles = own content.leafParticles
  state.light = content.light
  state.camera = content.camera
  state.meshFirst = content.meshFirst
  state.meshEnd = content.meshEnd
}

# Build `scenes` again after a control changed what they are built from: the shown one is released
# and built anew, keeping the camera where it is, its light and the forest shown; a kept one is
# released and dropped from the stash, so it is built anew when it is next shown
func labRebuildScenes(state: mod LabState, scenes: view List(Int)) {
  loop let scene: view Int in scenes {
    let found: Int = labStashIndex(state: state, scene: scene)
    if found >= 0 {
      state.stash.swap(i: found, j: state.stash.length - 1)
      var dropped: LabSceneContent = state.stash.pop()
      releaseLabScene(state: state, content: dropped)
    }
    if scene is state.scene {
      var old: LabSceneContent = labTakeScene(state: state)
      releaseLabScene(state: state, content: old)
      var content: LabSceneContent = buildLabScene(
        renderer: state.renderer
        meshes: state.meshes
        scene: scene
      )
      content.camera = old.camera
      content.light = old.light
      if old.forestShown < content.forests.length {
        content.forestShown = old.forestShown
      }
      labPutScene(state: state, content: content)
      log("[treelab] rebuilt {labSceneLabels().copyAtDefault(index: scene - 1)}")
    }
  }
}

# A scene out of the stash (moved, not copied: swapped to the end and popped), or built new
func buildLabSceneOrTake(
  state: mod LabState
  scene: view Int
  found: view Int
) ret LabSceneContent {
  if found >= 0 {
    state.stash.swap(i: found, j: state.stash.length - 1)
    ret state.stash.pop()
  }
  ret buildLabScene(renderer: state.renderer, meshes: state.meshes, scene: scene)
}

# The editor's frame: the camera bar and rig, the scene chooser, the Reference framings, the
# shared settings once changed
func labEditorStep(
  state: mod LabState
  now: view Float64
  deltaTime: view Float
  rendered: view Bool
) {
  var picked: LabEditorFrame = { scene: 0, framing: "", settingsChanged: false, control: "" }
  if let editor: mod LabEditor = state.editor {
    picked = labEditorFrame(
      editor: editor
      rig: state.cameraRig
      camera: state.camera
      now: now
      deltaTime: deltaTime
      resized: Gpu2d.windowResized()
      rendered: rendered
    )
  }
  if picked.scene > 0 {
    labShowScene(state: state, scene: picked.scene)
  }
  if picked.framing.length() > 0 {
    labShowScene(state: state, scene: labSceneReference)
    if let editor: mod LabEditor = state.editor {
      labEditorShowScene(editor: editor, scene: labSceneReference)
    }
    state.camera = labCamera(name: picked.framing)
    labCameraHome(state: state)
  }
  if picked.settingsChanged {
    if let editor: view LabEditor = state.editor {
      labEditorApplySettings(editor: editor, renderer: state.renderer, light: state.light)
      # the panel's date is the lab's: the season follows it
      state.season.clock.year = labEditorYear(editor: editor)
      state.season.clock.dayOfYear = labEditorDayOfYear(editor: editor)
    }
  }
  if picked.control.length() > 0 {
    applyLabControl(state: state, id: picked.control)
  }
  # and back: the date a key or the year's speed moved, and the choices the keys stepped
  let choices: List(String) = labChoiceIds(state: state)
  if let editor: mod LabEditor = state.editor {
    labEditorSetDate(
      editor: editor
      year: state.season.clock.year
      dayOfYear: state.season.clock.dayOfYear
    )
    labEditorShowChoices(editor: editor, ids: choices)
    labFindReadoutCity(state: state)
    labEditorSetReadout(editor: editor, text: labShortReadout(state: state))
  }
}

# The panel's readout: the nearest city, the temperature, the season and the weather (the first
# parts of LabSeason labSeasonClimateText), short enough for the side panel; in a tree's scene the
# tree (One tree's kind, Reference's seed), the city and the season. The latitude shows as its
# selected button
func labShortReadout(state: view LabState) ret String {
  let parts: List(String) = labSeasonClimateText(season: state.season).split(sep: ", ")
  if state.scene is labSceneOneTree {
    ret "{state.readoutKind}, near {state.readoutCity}, {parts.copyAtDefault(index: 1)}"
  }
  if state.scene is labSceneReference {
    ret "seed {labTreeSeed()}, near {state.readoutCity}, {parts.copyAtDefault(index: 1)}"
  }
  var text: String = "near {state.readoutCity}"
  loop var i: Int = 0, i < Math.min(a: 3, b: parts.length), ++i {
    text = "{text}, {parts.copyAtDefault(index: i)}"
  }
  ret text
}

# The city nearest the lab's place, found again only when the place moved
func labFindReadoutCity(state: mod LabState) {
  if state.readoutLatitude is state.season.latitude and state.readoutLongitude is state.season.longitude {
    ret
  }
  state.readoutLatitude = state.season.latitude
  state.readoutLongitude = state.season.longitude
  state.readoutCity = nearestCity(
    latitude: state.season.latitude
    longitude: state.season.longitude
  ).city.name
}

# A lab control (LabEditor labControlButtons): its group letter, then its value
func applyLabControl(state: mod LabState, id: view String) {
  let group: String = id.sub(start: 0, len: 1)
  let value: String = id.sub(start: 2, len: id.length() - 2)
  if group is "w" {
    state.season.weather = settingsWeatherNamed(name: value, fallback: SettingsWeather.auto)
  } else if group is "n" {
    state.season.wind = settingsWindNamed(name: value, fallback: SettingsWind.auto)
  } else if group is "y" {
    state.season.clock.yearSpeed = value.toFloat()
  } else if group is "l" {
    state.season.latitude = value.toFloat()
  } else if group is "k" {
    Sys.setEnv(name: "RAE_TREELAB_LOOK", value: value)
    labApplyLight(state: state)
  } else if group is "f" {
    let set: Int = value.toInt()
    if set < state.forests.length {
      state.forestShown = set
    }
  } else if not applyLabGrassControl(look: state.grassLook, group: group, value: value) {
    applyLabBuildControl(state: state, group: group, value: value)
  }
  log("[treelab] control {id}")
}

# A control that changes what a scene is built from (LabEditor labControlButtons' groups 9 to 14):
# its variable is set and the scenes built from it are built again
func applyLabBuildControl(state: mod LabState, group: view String, value: view String) {
  var scenes: List(Int) = List.create(Int, cap: 2)
  if group is "t" {
    var kind: Int = labTreeKind() + value.toInt()
    let count: Int = labTreeKindCount()
    # -1 (the reference tree) to count - 1, round
    if kind < -1 {
      kind = count - 1
    } else if kind >= count {
      kind = -1
    }
    var name: String = ""
    if kind >= 0 {
      name = "{kind}"
    }
    Sys.setEnv(name: "RAE_TREELAB_SPECIES", value: name)
    state.readoutKind = labTreeKindName()
    scenes.add(value: labSceneOneTree)
  } else if group is "s" {
    Sys.setEnv(
      name: "RAE_TREELAB_SEED"
      value: "{Math.max(a: 1, b: labTreeSeed() + value.toInt())}"
    )
    scenes.add(value: labSceneReference)
  } else if group is "v" {
    var level: String = value
    if value is "all" {
      level = ""
    }
    Sys.setEnv(name: "RAE_TREE_LEVEL", value: level)
    scenes.add(value: labSceneOneTree)
    scenes.add(value: labSceneForest)
  } else if group is "o" {
    Sys.setEnv(name: "RAE_TREELAB_FOREST", value: value)
    scenes.add(value: labSceneForest)
  } else if group is "d" {
    Sys.setEnv(name: "RAE_TREELAB_FOREST_FAR", value: value)
    scenes.add(value: labSceneForest)
  } else if group is "p" {
    Sys.setEnv(name: "RAE_TREELAB_FOREST_SPACING", value: value)
    scenes.add(value: labSceneForest)
  }
  labRebuildScenes(state: state, scenes: scenes)
}

# The scene's own light and sky again (after the look was switched)
func labApplyLight(state: mod LabState) {
  if state.scene is labSceneStudies {
    applyStudyLight(renderer: state.renderer, light: state.light, studyView: state.studyView)
  } else {
    applyLabLook(renderer: state.renderer, light: state.light)
  }
}

# The lab's choices now, one control id per group, to show them selected in the panel
func labChoiceIds(state: view LabState) ret List(String) {
  var look: String = "k:lab"
  if labLookPlain() {
    look = "k:plain"
  }
  var ids: List(String) = List(String) {
    "w:{labWeatherValue(weather: state.season.weather)}"
    "n:{labWindValue(wind: state.season.wind)}"
    "y:{state.season.clock.yearSpeed.toInt()}"
    "l:{state.season.latitude.toInt()}"
    look
    "f:{state.forestShown}"
    "v:{labLevelValue()}"
    "o:{labForestOnValue()}"
    "d:{labForestFarHere().toInt()}"
    "p:{labForestSpacingHere().toInt()}"
  }
  loop let id: view String in labGrassChoiceIds(look: state.grassLook) {
    ids.add(value: id)
  }
  ret ids
}

# The date and the weather reach every scene of an interactive lab; a scripted run keeps them to
# the scenes with a forest (the forest and One tree), so its other pictures stay as they were
func labSeasonHere(state: view LabState) ret Bool {
  ret state.forests.length > 0 or state.editor is not none
}

# The sun's cascades, fitted to the camera; every mesh of the world casts
func renderLabShadows(state: mod LabState, aspect: view Float) {
  let cascades: ShadowCascades = fitShadowCascades(
    camPos: state.camera.position
    camTarget: state.camera.target
    fovYDeg: state.camera.fovYDeg
    aspect: aspect
    near: state.camera.nearZ
    far: 160.0
    sunDir: state.light.sunDir
    count: 3
    resolution: 2048
    lambda: 0.7
    backExtent: 45.0
  )
  beginShadowPass(renderer: state.renderer, c: cascades)
  renderSceneShadowWorldWith(renderer: state.renderer, world: state.world)
  if let forest: view TreeForest = state.forests.viewAt(index: state.forestShown) {
    drawTreeForestShadows(renderer: state.renderer, forest: forest)
  }
  # the crown's shadow: its solid leaf masses, drawn only into the shadow maps
  if let tree: view LabTree = state.tree {
    # a crown that has lost most of its leaves casts the shadow of its wood only
    if tree.castsMassShadow and state.treeLeaves.loss < 0.6 {
      loop var i: Int = 0, i < tree.massShadows.length, ++i {
        drawShadowCasterWith(
          renderer: state.renderer
          mesh: tree.massShadows.copyAtDefault(index: i)
          model: tree.shadowModels.copyAtDefault(index: i)
        )
      }
    }
  }
  endShadowPass(renderer: state.renderer)
}

# The G-buffer pass: the scene's meshes, then the grass the compute pass
# generated just before
func renderLabGeometry(state: mod LabState, aspect: view Float, deltaTime: view Float) {
  if let resources: mod GpuResources = state.gpuResources {
    generateLabGrass(
      grass: state.grass
      resources: resources
      centerX: state.grassCenterX
      centerY: state.grassCenterY
      camera: state.camera
      deltaTime: deltaTime
      wind: windVector(state: state.wind, settings: state.windSettings)
      look: state.grassLook
    )
  }
  ensureRendererResources(renderer: state.renderer)
  if let rendererResources: mod GpuResources = state.renderer.gpuResources {
    Gbuffer.beginPass(
      cache: state.renderer.passes.gbuffer
      resources: rendererResources
      camera: state.camera
      light: state.light
      aspect: aspect
    )
    renderSceneWorld(
      cache: state.renderer.passes.gbuffer
      resources: rendererResources
      world: state.world
    )
    if let forest: mod TreeForest = state.forests.modAt(index: state.forestShown) {
      drawTreeForest(
        cache: state.renderer.passes.gbuffer
        resources: rendererResources
        forest: forest
      )
      if let leafParticles: mod LeafParticles = state.leafParticles {
        drawLeafParticles(
          leafParticles: leafParticles
          resources: rendererResources
          gbuffer: state.renderer.passes.gbuffer
        )
      }
    }
    # rain and snow falling, where the date reaches
    if labSeasonHere(state: state) {
      if let precipitation: mod Precipitation = state.precipitation {
        let air: Float = labAir(season: state.season)
        let labWind: WindVector = windVector(state: state.wind, settings: state.windSettings)
        drawPrecipitation(
          cache: state.renderer.passes.gbuffer
          resources: rendererResources
          precipitation: precipitation
          eye: state.camera.position
          seconds: state.season.seconds
          rate: labWeather(season: state.season).precipitation
          air: settingsWeatherAir(override: state.season.weather, air: air)
          windX: windMetersPerSecond(sway: labWind.x)
          windY: windMetersPerSecond(sway: labWind.y)
        )
      }
    }
    if let resources: mod GpuResources = state.gpuResources {
      if state.grassLook.on {
        grassDraw(
          grass: state.grass
          resources: resources
          gbuffer: state.renderer.passes.gbuffer
          gbufferResources: rendererResources
        )
      }
      if let tree: mod LabTree = state.tree {
        loop let leaves: mod LeafPass in tree.leaves {
          setLeafSeason(leaves: leaves, tint: state.treeLeaves.tint, loss: state.treeLeaves.loss)
          drawLeaves(
            leaves: leaves
            resources: resources
            gbuffer: state.renderer.passes.gbuffer
            gbufferResources: rendererResources
            camera: state.camera
            light: state.light
          )
        }
      }
    }
    Gbuffer.endPass(cache: state.renderer.passes.gbuffer, resources: rendererResources)
  }
}

func runLabFrame(state: mod LabState) {
  let now: Float64 = Gpu2d.nowSeconds()
  let deltaTime: Float = Math.min(a: (now - state.lastTime) as Float, b: 0.1)
  state.lastTime = now
  # the weather's wind (lib/WeatherWind) at the lab's place and hour
  state.windSettings = windSettingsFromWeather(
    weather: labWeather(season: state.season)
    settings: state.windSettings
  )
  stepWind(state: state.wind, settings: state.windSettings, deltaTime: deltaTime)
  # the renderer's wind: the studies' flowers and the forests' and levels'
  # leaves sway in it (the T02 scene's own leaf pass takes it below)
  setRendererWind(
    renderer: state.renderer
    wind: windVector(state: state.wind, settings: state.windSettings)
  )
  if updateLabSeason(season: state.season, deltaTime: deltaTime) {
    log("[treelab] day {state.season.clock.dayOfYear} of {state.season.clock.year}")
  }
  state.framesRun = state.framesRun + 1
  if state.framesRun is 20 and state.scriptedControls.length() > 0 {
    let ids: List(String) = state.scriptedControls.split(sep: ",")
    loop let id: view String in ids {
      applyLabControl(state: state, id: id)
    }
  }
  if state.forests.length > 0 and Sdl3.isKeyPressed(key: Keys.keyT) {
    state.forestShown = (state.forestShown + 1) % state.forests.length
    log("[treelab] showing the {labForestSetName(setIndex: state.forestShown)} set")
  }
  if state.dollyFolder.length() > 0 {
    # a fixed step per frame, so every run films the same move
    let fraction: Float = state.dollyFrame.toFloat() / (labDollyFrames - 1).toFloat()
    let distance: Float = labDollyNear + (labDollyFar - labDollyNear) * fraction
    state.camera.position = Vec3.create(x: 0.0, y: -distance, z: 1.6)
    state.camera.target = Vec3.create(x: 0.0, y: 0.0, z: 6.5)
    Sys.setEnv(
      name: "RAE_GPU2D_SCREENSHOT"
      value: "{state.dollyFolder}/frame{state.dollyFrame}.bmp"
    )
    state.dollyFrame = state.dollyFrame + 1
  }
  let renderFrame: Bool = Gpu2d.renderGate()
  if state.editor is not none {
    labEditorStep(
      state: state
      now: now
      deltaTime: deltaTime
      rendered: renderFrame
    )
  }
  if not renderFrame {
    ret
  }
  let aspect: Float = Gpu2d.windowWidth().toFloat() / Gpu2d.windowHeight().toFloat()
  let gatherStart: Float64 = Gpu2d.nowSeconds()
  if labSeasonHere(state: state) {
    applyLabWeather(season: state.season, renderer: state.renderer)
    # the snow lying in the lab's place (lib/Climate, lib/snow.wgsl)
    setGbufferSnow(
      cache: state.renderer.passes.gbuffer
      depth: climateSnowAt(climate: state.season.climate, east: 0.0, north: 0.0)
    )
  }
  if state.editor is not none {
    state.treeLeaves = labTreeLeaves(season: state.season, propSeason: state.treeSeason)
    state.grassLook.tint = labGrassTint(palette: labGroundPalette(season: state.season))
    setLabGroundTint(world: state.world, tint: state.grassLook.tint)
  }
  if let forest: mod TreeForest = state.forests.modAt(index: state.forestShown) {
    applyLabSeason(season: state.season, field: forest.field)
    let unusedBaked: Bool = updateSeasonImpostors(forest: forest, renderer: state.renderer)
    gatherTreeForest(
      forest: forest
      camera: state.camera
      aspect: aspect
      deltaTime: deltaTime
    )
    # the leaves its turning crowns let go, on the lab's flat ground
    if let leafParticles: mod LeafParticles = state.leafParticles {
      state.leafFrame = state.leafFrame + 1
      releaseFieldLeaves(
        leafParticles: leafParticles
        field: forest.field
        eye: state.camera.position
        reach: 32.0
        deltaTime: deltaTime
        wind: windVector(state: state.wind, settings: state.windSettings)
        frame: state.leafFrame
      )
      releaseGroundLitter(
        leafParticles: leafParticles
        field: forest.field
        eye: state.camera.position
        deltaTime: deltaTime
        wind: windVector(state: state.wind, settings: state.windSettings)
        frame: state.leafFrame
        biome: defaultBiomeConfig()
        groundZ: 0.0
        flatGround: true
      )
      if let rendererResources: mod GpuResources = state.renderer.gpuResources {
        let labWind: WindVector = windVector(state: state.wind, settings: state.windSettings)
        stepLeafParticles(
          leafParticles: leafParticles
          resources: rendererResources
          step: {
            eye: state.camera.position
            reach: 48.0
            windX: windMetersPerSecond(sway: labWind.x)
            windY: windMetersPerSecond(sway: labWind.y)
            wind: labWind
            deltaTime: deltaTime
            groundZ: 0.0
            flatGround: true
            snowDepth: state.renderer.passes.gbuffer.snowDepth
            sun: Vec3.vscale(a: state.light.sunDir, s: -1.0)
          }
        )
      }
    }
  }
  state.statsGatherSeconds = state.statsGatherSeconds + (Gpu2d.nowSeconds() - gatherStart)
  gpuPassTimingBegin(renderer: state.renderer)
  loop var passIndex: Int = 0, passIndex < deferredOrderLength(renderer: state.renderer), ++passIndex {
    let tag: Int = deferredTagAt(renderer: state.renderer, i: passIndex)
    gpuPassMark(renderer: state.renderer, tag: tag)
    if tag is RenderTag.shadow {
      renderLabShadows(state: state, aspect: aspect)
    } else if tag is RenderTag.gbuffer {
      renderLabGeometry(state: state, aspect: aspect, deltaTime: deltaTime)
    } else if tag is RenderTag.uiOverlay {
      drawLabSeason(season: state.season, canvas: state.renderer.canvas)
      if let editor: mod LabEditor = state.editor {
        drawLabEditor(editor: editor, canvas: state.renderer.canvas)
      }
    } else {
      renderDeferredPassWorld(
        renderer: state.renderer
        tag: tag
        world: state.world
        camera: state.camera
        light: state.light
        aspect: aspect
      )
    }
  }
  gpuPassTimingEnd(renderer: state.renderer)
  world3dPrevTransformSystem(world: state.world)
  logLabStats(state: state)
}

# The shown forest's levels this frame: trees and triangles per level (the
# meshes' triangles times their instances), then the impostors, far
# billboards and canopy clusters (two triangles each)
func labForestLevels(forest: view TreeForest, store: view MeshStore) ret String {
  var text: String = ""
  var levels: Int = 0
  loop let kind: view PropKind in forest.field.kinds {
    if kind.lods.length > levels {
      levels = kind.lods.length
    }
  }
  loop var level: Int = 0, level < levels, ++level {
    var trees: Int = 0
    var triangles: Int = 0
    loop var kindIndex: Int = 0, kindIndex < forest.field.kinds.length, ++kindIndex {
      if let kind: view PropKind = forest.field.kinds.viewAt(index: kindIndex) {
        if let lod: view PropLod = kind.lods.viewAt(index: level) {
          let first: Int = forest.field.lodFirstBatch.copyAtFallback(
            index: forest.field.kindFirstLod.copyAtFallback(index: kindIndex, fallback: 0) + level
            fallback: 0
          )
          loop var part: Int = 0, part < lod.parts.length, ++part {
            if let batch: view InstanceBatch = forest.field.batches.viewAt(index: first + part) {
              if part is 0 {
                trees = trees + batch.count
              }
              let mesh: MeshHandle = forest.field.batchMeshes.copyAtDefault(index: first + part)
              triangles = triangles + batch.count * meshStoreIndexCount(store: store, mesh: mesh.id) / 3
            }
          }
        }
      }
    }
    text = "{text} level{level} {trees} trees {triangles} tris;"
  }
  ret "{text} impostors {forest.field.spriteBatch.count}; far billboards {forest.farTrees.batch.count}; canopy clusters {forest.canopy.batch.count}"
}

func logLabStats(state: mod LabState) {
  if not state.statsOn {
    ret
  }
  if state.statsFrames is 0 {
    state.statsStart = Gpu2d.nowSeconds()
    state.statsGatherSeconds = 0.0
  }
  state.statsFrames = state.statsFrames + 1
  if state.statsFrames <= labStatsFrames {
    ret
  }
  let frames: Float = labStatsFrames.toFloat()
  let frameMs: Float = ((Gpu2d.nowSeconds() - state.statsStart) as Float) * 1000.0 / frames
  let gatherMs: Float = (state.statsGatherSeconds as Float) * 1000.0 / frames
  var levels: String = ""
  if let forest: view TreeForest = state.forests.viewAt(index: state.forestShown) {
    levels = labForestLevels(forest: forest, store: state.renderer.passes.gbuffer.meshes)
  }
  var leaves: Int = 0
  if let leafParticles: view LeafParticles = state.leafParticles {
    leaves = leafParticles.totalReleased
  }
  log("[treelab stats] frame {frameMs} ms, gather {gatherMs} ms; {leaves} leaves released;{levels}")
  state.statsFrames = 0
}

# Release a kept scene's GPU parts (its grass, its tree's leaves, its forests, its leaves in the
# air, the meshes its build uploaded)
func releaseLabScene(state: mod LabState, content: mod LabSceneContent) {
  if let resources: mod GpuResources = state.gpuResources {
    grassShutdown(grass: content.grass, resources: resources)
    if let tree: mod LabTree = content.tree {
      loop let leaves: mod LeafPass in tree.leaves {
        releaseLeafPass(leaves: leaves, resources: resources)
      }
    }
  }
  if let rendererResources: mod GpuResources = state.renderer.gpuResources {
    if let leafParticles: mod LeafParticles = content.leafParticles {
      releaseLeafParticles(leafParticles: leafParticles, resources: rendererResources)
    }
    loop let forest: mod TreeForest in content.forests {
      treeForestShutdown(forest: forest, resources: rendererResources)
    }
    loop var mesh: Int = content.meshFirst, mesh < content.meshEnd, ++mesh {
      meshStoreRelease(
        store: state.renderer.passes.gbuffer.meshes
        resources: rendererResources
        mesh: mesh
      )
    }
  }
}

func endLab(state: mod LabState) {
  loop state.stash.length > 0 {
    var content: LabSceneContent = state.stash.pop()
    releaseLabScene(state: state, content: content)
  }
  if let resources: mod GpuResources = state.gpuResources {
    grassShutdown(grass: state.grass, resources: resources)
    if let tree: mod LabTree = state.tree {
      loop let leaves: mod LeafPass in tree.leaves {
        releaseLeafPass(leaves: leaves, resources: resources)
      }
    }
    shutdown(resources: resources)
  }
  if let rendererResources: mod GpuResources = state.renderer.gpuResources {
    if let leafParticles: mod LeafParticles = state.leafParticles {
      releaseLeafParticles(leafParticles: leafParticles, resources: rendererResources)
    }
    loop let forest: mod TreeForest in state.forests {
      treeForestShutdown(forest: forest, resources: rendererResources)
    }
  }
  shutdownDeferredRenderer(renderer: state.renderer)
  Gbuffer.shutdownAll()
  Gpu2d.closeWindow()
}

func main() ret Int {
  var state: LabState = createLab()
  let graphStatus: Int = compileDeferred(renderer: state.renderer)
  if graphStatus is not 0 {
    log("render graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }
  loop not Gpu2d.pollClose() and not (state.dollyFolder.length() > 0 and state.dollyFrame > labDollyFrames) {
    runLabFrame(state: state)
  }
  endLab(state: state)
  ret 0
}
