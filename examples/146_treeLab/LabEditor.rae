# What the editor asked for this frame
type LabEditorFrame {
  # The scene picked (0: none)
  scene: Int
  # A Reference framing picked ("": none)
  framing: String
  # The shared settings changed (the app applies them to its renderer and light)
  settingsChanged: Bool
  # A lab control clicked (labControlButtons' id; "": none)
  control: String
}

func createLabEditor(startScene: view Int) ret LabEditor {
  var settings: SettingsState = createSettingsState(
    scene: startScene
    sceneCount: labSceneLabels().length
    speed: 1.0
    toon: false
    hour: 10.0
    skyModel: SettingsSkyModel.preetham
  )
  settings.animateTime = false
  var panel: EditorPanel = createEditorPanel(assetBase: "lib/assets/walker/", settings: settings)
  var scenes: EditorSceneChooser = createEditorSceneChooser(
    editorPanel: panel
    title: "Tree lab"
    labels: labSceneLabels()
  )
  # The Reference scene's framings: a click shows that scene from there; moving away is free
  var framings: ControlPanel = createControlPanel(hostNodeId: editorAppPanelNodeId)
  loop let name: view String in labFramingNames() {
    addPanelButton(
      panel: framings
      id: name
      label: "T02 {name}"
      actionId: "treelab.framing.{name}"
      group: 2
    )
  }
  let unusedBuilt: Bool = buildEditorPanelControls(editorPanel: panel, panel: framings)
  var controls: ControlPanel = createControlPanel(hostNodeId: editorAppPanelNodeId)
  loop let control: view LabControl in labControlButtons() {
    addPanelButton(
      panel: controls
      id: control.id
      label: control.label
      actionId: "treelab.control.{control.id}"
      group: control.group
    )
  }
  let unusedControlsBuilt: Bool = buildEditorPanelControls(editorPanel: panel, panel: controls)
  ret LabEditor {
    panel: own panel
    scenes: own scenes
    framings: own framings
    controls: own controls
  }
}

# One frame of the chrome and the camera (the rig moves the camera: orbit, or WASD in the free
# mode), and what was picked
func labEditorFrame(
  editor: mod LabEditor
  rig: mod CameraRig
  camera: mod Camera3d
  now: view Float64
  deltaTime: view Float
  resized: view Bool
  rendered: view Bool
) ret LabEditorFrame {
  let shown: Int = editor.panel.settings.scene
  let panelFrame: EditorPanelFrame = updateEditorPanel(
    editorPanel: editor.panel
    cameraRig: rig
    camera: camera
    now: now
    deltaTime: deltaTime
    resized: resized
    rendered: rendered
  )
  let unusedClicked: Bool = updateEditorSceneChooser(
    editorPanel: editor.panel
    chooser: editor.scenes
  )
  var scene: Int = 0
  if editor.panel.settings.scene is not shown {
    scene = editor.panel.settings.scene
  }
  let framing: String = panelClickedId(panel: editor.framings, world: editor.panel.world)
  editor.framesRun = editor.framesRun + 1
  ret LabEditorFrame {
    scene: scene
    framing: framing
    settingsChanged: panelFrame.settingsChanged and editor.framesRun > 2
    control: panelClickedId(panel: editor.controls, world: editor.panel.world)
  }
}

# Show `scene` as picked in the chooser (a scene the lab switched to by itself)
func labEditorShowScene(editor: mod LabEditor, scene: view Int) {
  selectEditorPanelScene(editorPanel: editor.panel, scene: scene)
}

# A new camera to orbit round: the rig starts exactly where the camera is (its orbit's yaw, pitch
# and distance solved from the camera's place and target, Math3d orbitEye's convention), so taking
# over does not move it, and Orbit comes back to its target
func labEditorCameraHome(editor: mod LabEditor, rig: mod CameraRig, camera: view Camera3d) {
  let offset: Vec3 = Vec3.vsub(a: camera.position, b: camera.target)
  let distance: Float = Math.max(a: 0.01, b: Vec3.vlen(a: offset))
  let pitch: Float = Math.asin(x: Math.clamp(val: offset.z / distance, low: -1.0, high: 1.0))
  rig = createCameraRig(camera: camera)
  rig.yaw = Math.atan2(y: offset.x, x: 0.0 - offset.y)
  rig.orbitPitch = pitch
  rig.freePitch = 0.0 - pitch
  rig.distance = distance
  rig.freePosition = camera.position
  # the lab's framings come as close as 3 m (the bush) and as far as 120 m
  rig.minDistance = 0.5
  rig.maxDistance = 400.0
  snapCameraRigView(rig: rig)
  setEditorPanelOrbitHome(editorPanel: editor.panel, target: camera.target)
}

func drawLabEditor(editor: mod LabEditor, canvas: mod Gpu2dCanvas) {
  drawEditorPanel(editorPanel: editor.panel, canvas: canvas)
}

# The panel's shared settings onto the renderer and the light, once they were changed in the panel:
# the sky model, the time of day and date, TAA, the quality. The lab look's sun is 66,000 lux at its
# brightest, the panel's 20,000 at noon: its sun is scaled to the look's level
const labPanelSunStrength: Float = 3.0

func labEditorApplySettings(
  editor: view LabEditor
  renderer: mod DeferredRenderer
  light: mod Light3d
) {
  applyEditorPanelSettings(
    editorPanel: editor.panel
    renderer: renderer
    light: light
    sunStrength: labPanelSunStrength
  )
}

# Show the lab's current choices selected: one id per group (labControlButtons' ids). Only when one
# changed, by a click or a key
func labEditorShowChoices(editor: mod LabEditor, ids: view List(String)) {
  var joined: String = ""
  loop let id: view String in ids {
    joined = "{joined} {id}"
  }
  if joined is editor.shownChoices {
    ret
  }
  editor.shownChoices = joined
  loop let id: view String in ids {
    loop let control: view LabControl in labControlButtons() {
      if control.id is id {
        setPanelSelection(
          panel: editor.controls
          world: editor.panel.world
          group: control.group
          id: id
        )
      }
    }
  }
}

# The panel's date, from the lab's season (moved by a key or the year's speed), shown in the panel
func labEditorSetDate(editor: mod LabEditor, year: view Int, dayOfYear: view Int) {
  if editor.panel.settings.timeOfDay.dayOfYear is dayOfYear and editor.panel.settings.timeOfDay.year is year {
    ret
  }
  editor.panel.settings.timeOfDay.year = year
  editor.panel.settings.timeOfDay.dayOfYear = dayOfYear
  settingsApplyToWorld(
    settingsState: editor.panel.settings
    world: editor.panel.world
    uiSystems: editor.panel.uiSystems
  )
}

# The panel's date (its shared settings), for the lab's season
func labEditorDayOfYear(editor: view LabEditor) ret Int {
  ret editor.panel.settings.timeOfDay.dayOfYear
}

func labEditorYear(editor: view LabEditor) ret Int {
  ret editor.panel.settings.timeOfDay.year
}

# The app section's readout: the latitude, the temperature, the season and the weather (LabSeason
# labSeasonClimateText), what the season's own slider showed; laid out again only when it changed
func labEditorSetReadout(editor: mod LabEditor, text: view String) {
  if text is editor.readout {
    ret
  }
  editor.readout = "{text}"
  setEditorPanelAppSection(editorPanel: editor.panel, title: "Tree lab", readout: text)
}

# The weather's and the wind's control values (LabEditor labControlButtons)
func labWeatherValue(weather: view SettingsWeather) ret String {
  if weather is SettingsWeather.clear {
    ret "clear"
  }
  if weather is SettingsWeather.cloudy {
    ret "cloudy"
  }
  if weather is SettingsWeather.rain {
    ret "rain"
  }
  if weather is SettingsWeather.snow {
    ret "snow"
  }
  if weather is SettingsWeather.mist {
    ret "mist"
  }
  ret "auto"
}

func labWindValue(wind: view SettingsWind) ret String {
  if wind is SettingsWind.calm {
    ret "calm"
  }
  if wind is SettingsWind.breeze {
    ret "breeze"
  }
  if wind is SettingsWind.strong {
    ret "strong"
  }
  if wind is SettingsWind.gale {
    ret "gale"
  }
  ret "auto"
}

# The level drawn's and the forest's control values
func labLevelValue() ret String {
  let level: String = Sys.getEnv(name: "RAE_TREE_LEVEL")
  if level.length() is 0 {
    ret "all"
  }
  ret level
}

func labForestOnValue() ret String {
  if labForestOn() {
    ret "on"
  }
  ret "off"
}
