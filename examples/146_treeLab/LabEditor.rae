# The tree lab's editor chrome: the shared editor panel of the 3D examples (lib/app3d/EditorPanel:
# the camera bar with orbit and the free WASD camera, the "..." menu, the debug readout, the side
# panel with the shared sky, time of day and date, shadows and TAA), and in its app section the
# lab's scene chooser (LabScenes) and the Reference scene's fixed framings as camera buttons.
#
# The panel's shared settings reach the scene only once they are changed in the panel: until then
# each scene keeps its own light (the lab look, or a study's hour), so the lab opens as it always
# looked. A scripted run (LabScenes labScripted) has no editor at all.
import Gpu2d
import Math
import Sys
import Vec3
open Scene3d
open Gpu2dCanvas
open RendererDeferred
open app3d/CameraRig
open app3d/ControlPanel
open app3d/EditorPanel
open app3d/SettingsDialog
open LabScenes
open LabForest
open app3d/SettingsWeather
open app3d/SettingsWind

type LabEditor {
  panel: EditorPanel
  scenes: EditorSceneChooser
  framings: ControlPanel
  # The lab's own controls (labControlButtons), and the choices they last showed selected
  controls: ControlPanel
  shownChoices: String = ""
  # The readout line under the section's title: the place and the season now
  readout: String = ""
  # Frames run: the panel reports its settings changed as it starts, which is not a change made
  framesRun: Int = 0
}

# One control: its id ("<group letter>:<value>"), its label and its group
type LabControl {
  id: String
  label: String
  group: Int
}

# The lab's controls, group by group (the group numbers follow the framings' 2), each first label
# naming the key that steps it: the weather (U), the wind (I), the year's speed (N, days a day), the
# latitude, the look, the forest set (T); then what builds a scene again (Main.rae
# applyLabBuildControl): One tree's kind, the Reference tree's seed, the level drawn (the T02 kinds
# honor it), the forest on or off, how far it reaches (m) and how far apart its trees stand (m);
# then the grass (LabGrass applyLabGrassControl): on or off, density, blade height and width, how
# far it reaches (the grid's span is twice the distance named) and the wind on it
func labControlButtons() ret List(LabControl) {
  ret List(LabControl) {
    { id: "w:auto", label: "Weather auto (U)", group: 3 }
    { id: "w:clear", label: "Clear", group: 3 }
    { id: "w:cloudy", label: "Cloudy", group: 3 }
    { id: "w:rain", label: "Rain", group: 3 }
    { id: "w:snow", label: "Snow", group: 3 }
    { id: "w:mist", label: "Mist", group: 3 }
    { id: "n:auto", label: "Wind auto (I)", group: 4 }
    { id: "n:calm", label: "Calm", group: 4 }
    { id: "n:breeze", label: "Breeze", group: 4 }
    { id: "n:strong", label: "Strong wind", group: 4 }
    { id: "n:gale", label: "Gale", group: 4 }
    { id: "y:0", label: "Year still (N)", group: 5 }
