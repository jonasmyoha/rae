# The tree lab's scene look (docs/reference-tree-plan.md step 2), aimed at
# reference crop T02: the shared lib look app3d/SceneLook.labSceneLook (sky
# haze, cooler sky light, mist, grade, glow) with the lab's own fixed sun and
# exposure. RAE_TREELAB_LOOK=plain keeps the renderer's defaults, for a
# before/after picture.
import Sys
import Vec3
open Scene3d
open Sky
open RendererDeferred
open app3d/SceneLook

# The lab's sun (lux: a warm, strong, late-morning sun) and exposure (T02 is
# a dark, shaded forest picture); the walkers keep their own
const labSunLux: Vec3 = { x: 66000.0, y: 57000.0, z: 44000.0 }

const labExposure: Float = 0.7

func labLookPlain() ret Bool {
  ret Sys.getEnv(name: "RAE_TREELAB_LOOK") is "plain"
}

# Set the look on the renderer and the sun. With RAE_TREELAB_LOOK=plain only
# the plain sky is set (the scene needs one), as step 1 had it.
func applyLabLook(renderer: mod DeferredRenderer, light: mod Light3d) {
  if labLookPlain() {
    setRendererSky(
      renderer: renderer
      sky: createSkyProcedural(sunDir: light.sunDir, sunColor: light.sunColor, turbidity: 3.0)
    )
    ret
  }
  let look: SceneLook = labSceneLook()
  light.sunColor = labSunLux
  light.exposure = labExposure
  var sky: Sky = createSkyProcedural(
    sunDir: light.sunDir
    sunColor: light.sunColor
    turbidity: look.turbidity
  )
  applySceneLookSky(sky: sky, look: look)
  setRendererSky(renderer: renderer, sky: sky)
  applySceneLook(renderer: renderer, look: look, mistBase: 0.0)
}
