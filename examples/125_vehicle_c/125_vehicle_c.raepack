pack VehicleC {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Vehicle — Box3D"
  description: "Box3D's Driving sample on Rae's physics engine (upstream Box3D's C library through Rae's generated bindings): a box chassis on four wheel joints with suspension, steering on the front axle, spin motors with the drive torque split between the axles, and a joint keeping it upright, on a height-field course with two ramps to jump, crates and a wall of blocks to send flying, and a stunt park. Chase camera; W/S/A/D to drive, R to respawn, P for an autopilot that takes the jump and tours the hills."
  category: "Physics"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
