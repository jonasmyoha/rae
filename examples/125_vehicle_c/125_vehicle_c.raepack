pack VehicleC {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Vehicle — Box3D's C library"
  description: "The same car and course as the ported vehicle (124), on upstream Box3D's C library through Rae's generated bindings: Box3D's Driving sample with suspension, steering on the front axle, spin motors with a torque split, and a keep-upright joint, on a height-field course with ramps, crates and a wall of blocks to scatter. Chase camera; W/S/A/D to drive, R to respawn, P for the autopilot. Both vehicles share every file but one import line and drive identically, step for step."
  category: "Physics"
  featured: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
