# The walker's terrain is lib/app3d/WalkerTerrain (the streamed tiles and
# small props, the forest field, their draws and shadows) with the island's
# forest from lib/app3d/IslandForest. This file is this example's settings:
# a 7 x 7 cell window on the default island.
open WorldBiome
open app3d/WalkerTerrain
open app3d/IslandForest

const terrainGridSide: Int = 7

const terrainHalfGrid: Int = 3

# The height field IS the biome elevation field (lib/WorldBiome).
func terrainHeightAt(x: view Float, y: view Float, groundZ: view Float) ret Float {
  ret worldTerrainHeight(
    x: x
    y: y
    groundZ: groundZ
    cfg: defaultBiomeConfig()
  )
}

# The terrain of the island, its props spawned into `world`, its forest not
# planted yet (IslandForest.plantIslandForest)
func createTerrainSystem(
  renderer: mod DeferredRenderer
  world: mod GameWorld
  assets: view String
  groundZ: view Float
) ret WalkerTerrain {
  ret createWalkerTerrain(
    renderer: renderer
    allocator: world.allocator
    transforms: world.transforms
    propKinds: world.propKinds
    assets: assets
    gridSide: terrainGridSide
    groundZ: groundZ
    biome: defaultBiomeConfig()
    forest: islandForestSettings()
  )
}
