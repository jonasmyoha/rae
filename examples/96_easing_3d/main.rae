# A minimal 3D easing example on Rae's production deferred renderer.
import core
import Easing
import gpu2d
import gbuffer
import math
import sys
import Vec3
import RendererDeferred
import ui/Ecs
import ui/RenderSystem/RenderSystem
import app3d/UiShell
open app3d/UiShell
open gbuffer
open gpu3d
open Math3d
open Mesh3d
open RendererDeferred
open Rendergraph
open Scene3d
open ui/Ecs
open ui/RenderSystem/RenderSystem

func uploadMeshData(meshData: view MeshData) ret MeshHandle {
  ret uploadMesh(
    verts: meshData.verts
    vertCount: meshData.vertCount
    indices: meshData.indices)
}

func buildScene(sphere: view MeshHandle, ground: view MeshHandle) ret World3d {
  var sceneWorld: World3d = createWorld3d()
  let noEmission: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let noRotation: Vec3 = Vec3.create(x: 0.0, y: 0.0, z: 0.0)
  let unitScale: Vec3 = Vec3.create(x: 1.0, y: 1.0, z: 1.0)
  let ballMaterial: Material3d = {
    baseColor: Vec3.create(x: 0.12, y: 0.62, z: 0.95)
    metallic: 0.15, roughness: 0.22, emission: noEmission, toon: false }
  let groundMaterial: Material3d = {
    baseColor: Vec3.create(x: 0.16, y: 0.2, z: 0.27)
    metallic: 0.0, roughness: 0.82, emission: noEmission, toon: false }
  let ballEntity: EntityId = world3dAddMeshInstance(
    world: sceneWorld, mesh: sphere, material: ballMaterial
    position: Vec3.create(x: 0.0, y: 0.0, z: 5.0)
    rotation: noRotation, scale: unitScale)
  let groundEntity: EntityId = world3dAddMeshInstance(
    world: sceneWorld, mesh: ground, material: groundMaterial
    position: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    rotation: noRotation, scale: unitScale)
  ret sceneWorld
}

func main() ret Int {
  gpu2d.initWindow(width: 960, height: 600, title: "Rae Easing 3D — Deferred")
  gpu2d.setDesignResolution(width: 960.0, height: 600.0, fit: 0)

  let sphereData: MeshData = makeSphere(rings: 32, segments: 48)
  let planeData: MeshData = makePlane(size: 30.0, segments: 1)
  let sphere: MeshHandle = uploadMeshData(meshData: sphereData)
  let ground: MeshHandle = uploadMeshData(meshData: planeData)
  var sceneWorld: World3d = buildScene(sphere: sphere, ground: ground)
  # The ball is the first mesh added (dense position 0); the easing below
  # animates its transform in place.
  let ballEntity: EntityId = world3dMeshRendererEntityAt(world: sceneWorld, i: 0)
  var camera: Camera3d = defaultCamera3d()
  camera.position = Vec3.create(x: 10.0, y: 0.0 - 12.0, z: 8.0)
  camera.target = Vec3.create(x: 0.0, y: 0.0, z: 2.0)
  let light: Light3d = defaultLight3d()

  let uiResources: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: ""
    themeFile: "theme.raescene")
  var world: UiWorld = createUiWorld()
  # #764: install the app's theme (palette + scene tokens) onto this world.
  seedWorldTheme(world: world, res: uiResources)
  let uiRoot: EntityId = mountUiScene(
    world: world
    path: "examples/96_easing_3d/assets/ui.raescene"
    res: uiResources)

  var renderer: DeferredRenderer = createDeferredRendererWithUi()
  let graphStatus: Int = compileDeferred(r: renderer)
  if graphStatus is not 0 {
    log("deferred graph invalid: {statusName(status: graphStatus)}")
    ret 1
  }

  let duration: Float = 3.0
  let startTime: Float64 = gpu2d.nowSeconds()
  let fixedTestFrame: Bool = sys.getEnv(name: "RAE_EASING3D_TEST_FRAME").length() > 0
  loop not gpu2d.pollClose() {
    let resized: Bool = resizeUiToWindow(world: world, res: uiResources)
    var elapsed: Float = (gpu2d.nowSeconds() - startTime) as Float
    loop elapsed > duration { elapsed = elapsed - duration }
    if fixedTestFrame { elapsed = 1.8 }
    let phase: Float = elapsed / duration
    let bounce: Float = Easing.easeOutBounce(t: phase)
    let currentZ: Float = 5.0 - 4.0 * bounce
    world3dWriteTransform(
      world: sceneWorld, entity: ballEntity
      transform: Transform3d {
        position: Vec3.create(x: 0.0, y: 0.0, z: currentZ)
        rotation: Vec3.create(x: 0.0, y: phase * 3.14159, z: 0.0)
        scale: Vec3.create(x: 1.0, y: 1.0, z: 1.0)
      })
    runUiSystems(world: world, res: uiResources)

    let aspect: Float = gpu2d.windowWidth().toFloat() / gpu2d.windowHeight().toFloat()
    if gpu2d.renderGate() {
      var passIndex: Int = 0
      loop passIndex < deferredOrderLength(r: renderer) {
        let tag: Int = deferredTagAt(r: renderer, i: passIndex)
        if tag is RenderTag.uiOverlay {
          gpu2d.beginFrameLoad()
          renderSystemGpu2d(world: world, res: uiResources)
        } else {
          renderDeferredPassWorld(
            r: renderer, tag: tag, world: sceneWorld
            camera: camera, light: light, aspect: aspect)
        }
        passIndex = passIndex + 1
      }
      world3dPrevTransformSystem(world: sceneWorld)
    }
  }

  if fixedTestFrame { log("[easing3d] deterministic deferred frame rendered") }
  gbuffer.shutdownAll()
  gpu2d.closeWindow()
  ret 0
}
