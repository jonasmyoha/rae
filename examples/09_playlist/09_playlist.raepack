pack Playlist {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Playlist — a taste of the language"
  description: "A small program that touches most of the language in one file: a type and a list of it, functions with explicit view/mod parameter modes, method-call syntax (track.play()), an optional result narrowed with if let, and braced string interpolation. No graphics, no runtime specifics — just Rae."
  featured: "true"
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
