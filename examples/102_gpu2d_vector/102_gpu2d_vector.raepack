pack Gpu2dVector {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "2D Renderer — Step 2: Vector shapes"
  description: "A showcase of the rounded-box SDF pipeline (#110): gradients, rounded-corner progressions, concentric rings, bordered cards, line art and premultiplied-alpha blending, laid out as a dashboard with a clipped header band — all from one instanced draw with analytic antialiasing (no MSAA), crisp at any size. Runs Compiled (wgpu-native + SDL3) or in the browser as WASM."
  category: "2D Renderer"
  featured: "true"
  wasmWebApp: "true"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
  }
}
