# Opt-in hardware regression for tier lifecycle, exact cadence and wave time.
# Driven by the normal ocean renderer so every tier also builds and draws the
# real surface bind group. No special allocation or dispatch path for the test.
import Math
open water/Water
open water/WaterSystem
open water/WaterFft
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuReadback
open gpu/GpuRender
open webgpu/Context

const waterCheckStageFrames: Int = 6

const waterCheckFrames: Int = 84

type WaterCheckSample {
  ordinal: Int
  counts: List(Int)
  times: List(Float)
}

func takeWaterCheckSample(waterSystem: view WaterSystem) ret WaterCheckSample {
  let counts: List(Int) = waterSystem.fftUpdateCounts
  let times: List(Float) = waterSystem.fftSampleTimes
  ret WaterCheckSample { ordinal: waterSystem.fftFrame, counts: own counts, times: own times }
}

func prepareWaterCheck(waterSystem: mod WaterSystem, resources: mod GpuResources, frame: copy Int) {
  let stage: Int = frame / waterCheckStageFrames
  var body: WaterBody = primaryBody(waterSystem: waterSystem)
  if frame % waterCheckStageFrames is 0 {
    body.fftSize = 128
    body.cascadeCount = stage % 3 + 1
    if stage / 3 is 1 {
      body.fftSize = 256
    }
    if stage / 3 is 2 {
      body.fftSize = 512
    }
    body.updateRate = stage % 3 + 1
    # Nine combinations, shrink from 512x3 to 128x1, then sea state,
    # cadence-only, explicit invalidation, and expansion back to 256x3.
    if stage is 9 {
      body.cascadeCount = 1
      body.updateRate = 2
    }
    if stage is 10 {
      body.cascadeCount = 1
      body.windSpeed = 11.0
      body.updateRate = 2
    }
    if stage is 11 {
      body.cascadeCount = 1
      body.updateRate = 5
    }
    if stage is 12 {
      body.cascadeCount = 1
      body.updateRate = 5
      waterFftInvalidate(waterSystem: waterSystem, resources: resources)
    }
    if stage is 13 {
      body.fftSize = 256
      body.cascadeCount = 3
      body.updateRate = 2
    }
    waterSystem.bodies.set(index: 0, value: body)
    log("[water tiers] stage {stage}: {body.fftSize} x {body.cascadeCount}, N={body.updateRate}")
  }
  # Deliberately non-unit elapsed time: missed updates must sample the CURRENT
  # absolute clock, not advance a cascade-local clock by one small timestep.
  waterSystem.time = frame.toFloat() * 0.27 + 2.0
}

func verifyWaterCheck(
  waterSystem: view WaterSystem
  resources: view GpuResources
  before: view WaterCheckSample
  frame: copy Int
) ret Bool {
  let body: WaterBody = primaryBody(waterSystem: waterSystem)
  let stage: Int = frame / waterCheckStageFrames
  # The previous stage's end diagnostic re-bakes the spectrum. It finishes with
  # fresh maps; stage 11 is cadence-only, so that boundary must NOT refresh all.
  let refreshAll: Bool = frame % waterCheckStageFrames is 0 and stage is not 11
  var expectedUpdates: Int = 0
  var ok: Bool = waterSystem.fftAllocatedSize is body.fftSize and waterSystem.fftAllocatedCount is body.cascadeCount
  if waterSystem.fftFrame is not before.ordinal + 1 {
    ok = false
  }
  loop var cascade: Int = 0, cascade < 3, ++cascade {
    var expectedCount: Int = 0
    var expectedTime: Float = 0.0
    if let count: Int = before.counts.copyAt(index: cascade) {
      expectedCount = count
    }
    if let time: Float = before.times.copyAt(index: cascade) {
      expectedTime = time
    }
    if cascade < body.cascadeCount and (refreshAll or before.ordinal % body.updateRate is cascade % body.updateRate) {
      expectedCount = expectedCount + 1
      expectedTime = waterSystem.time
      expectedUpdates = expectedUpdates + 1
    }
    if let count: Int = waterSystem.fftUpdateCounts.copyAt(index: cascade) {
      if count is not expectedCount {
        ok = false
      }
    }
    if let time: Float = waterSystem.fftSampleTimes.copyAt(index: cascade) {
      if Math.abs(value: time - expectedTime) > 0.0001 {
        ok = false
      }
    }
    let textureLive: Bool = isValidTexture(
      resources: resources
      id: cascadeTexture(waterSystem: waterSystem, cascade: cascade, map: 0)
    )
    if cascade < body.cascadeCount {
      if not textureLive {
        ok = false
      }
    } else {
      if textureLive {
        ok = false
      }
    }
  }
  if waterSystem.fftLastUpdates is not expectedUpdates {
    ok = false
  }
  if not ok {
    log(
      "[water tiers] frame {frame} FAIL: expected {expectedUpdates} updates, got {waterSystem.fftLastUpdates}"
    )
  }
  ret ok
}

# After waterShutdown + manager shutdown nothing of water's may be live or
# pending: every kind's live count is zero (the manager was water's alone).
func verifyWaterReleased(resources: view GpuResources) ret Bool {
  let live: Int = liveBufferCount(resources: resources) + liveTextureCount(resources: resources) + liveTextureViewCount(
    resources: resources
  ) + liveSamplerCount(resources: resources) + livePipelineCount(resources: resources) + liveBindGroupCount(
    resources: resources
  ) + liveRenderPipelineCount(resources: resources) + liveExternalCount(resources: resources) + liveReadbackCount(
    resources: resources
  ) + liveSubmissionCount(resources: resources)
  let pending: Int = pendingReleaseCount(resources: resources)
  if live is not 0 or pending is not 0 {
    log("[water tiers] leaked: {live} live, {pending} pending release")
  }
  ret live is 0 and pending is 0
}

# Water emits several hundred dependency triples per FFT frame. Completed
# submission slices must be compacted away; otherwise this CPU arena grows
# without changing any of the native WebGPU object counts.
func verifyWaterDependencyArena(resources: view GpuResources) ret Bool {
  let limit: Int = resources.capacity * 32
  if resources.depKinds.length > limit {
    log(
      "[water tiers] dependency arena grew to {resources.depKinds.length} entries (limit {limit})"
    )
    ret false
  }
  ret true
}

# ----- two systems on one manager (#873) --------------------------------------
# The twin is alive for frames twinStart..twinEnd of stage 1 (frames 6..11,
# whose tier is stable): created after the primary's frame-6 rebuild settled,
# stepped beside it, shut down mid-stage. Live counts are compared before it
# exists and after it is gone.
const twinStart: Int = 8

const twinEnd: Int = 10

func twinWaterActive(frame: view Int) ret Bool {
  ret frame >= twinStart and frame < twinEnd
}

func liveWaterObjects(resources: view GpuResources) ret Int {
  ret liveBufferCount(resources: resources) + liveTextureCount(resources: resources) + liveTextureViewCount(
    resources: resources
  ) + liveSamplerCount(resources: resources) + livePipelineCount(resources: resources) + liveBindGroupCount(
    resources: resources
  )
}

func stepTwinWater(
  twin: mod WaterSystem
  primary: view WaterSystem
  resources: mod GpuResources
  frame: view Int
  active: view Bool
) ret Bool {
  var ok: Bool = true
  if frame is twinStart {
    var body: WaterBody = primaryBody(waterSystem: twin)
    body.fftSize = 128
    body.cascadeCount = 1
    body.updateRate = 1
    twin.bodies.set(index: 0, value: body)
    twin.fftFrame = 0
    twin.time = 1.0
    twin.drawCount = liveWaterObjects(resources: resources)  # remembers the primary-only count
  }
  if twinWaterActive(frame: frame) {
    twin.time = twin.time + 0.1
    waterFftStep(waterSystem: twin, resources: resources)
    if not twin.cascadesMade or not twin.fftBaked {
      log("[water twin] frame {frame}: twin did not allocate/bake")
      ok = false
    }
    if twin.fftLastUpdates is not 1 {
      log("[water twin] frame {frame}: expected 1 twin update, got {twin.fftLastUpdates}")
      ok = false
    }
    if not isValidTexture(
      resources: resources
      id: cascadeTexture(waterSystem: primary, cascade: 0, map: 0)
    ) {
      log("[water twin] primary cascade lost")
      ok = false
    }
  }
  if frame is twinEnd {
    waterShutdown(waterSystem: twin, resources: resources)
    if twin.cascadesMade or twin.fftGpuMade or twin.fftFrameMade {
      ok = false
    }
    if not isValidTexture(
      resources: resources
      id: cascadeTexture(waterSystem: primary, cascade: 0, map: 0)
    ) {
      log("[water twin] primary cascade lost at twin shutdown")
      ok = false
    }
    let after: Int = liveWaterObjects(resources: resources)
    if after is not twin.drawCount {
      log(
        "[water twin] live objects {after} after twin shutdown, {twin.drawCount} before it existed"
      )
      ok = false
    }
    if ok {
      log(
        "[water twin] two systems on one manager ok: twin ran frames {twinStart}..{twinEnd - 1} and shut down alone"
      )
    }
  }
  ret ok
}
