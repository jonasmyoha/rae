# The walker's physics is lib/app3d/WalkerPhysics (the ground, the
# characters, the cubes, the fixed step, the ground following the walker, the trunk pool). This
# file is only what reads this
# example's own GameWorld.
open ecs/Entity
open ecs/World
open ecs/ComponentTable
open app3d/WalkerPhysics

# Despawn a cube: its body, collider and PhysicsCube row
# (app3d/WalkerPhysics), then every component row of the entity in this
# example's GameWorld (so a recycled index reads nothing stale), then the
# entity itself.
func despawnCubeEntity(
  physicsSystem: mod WalkerPhysics
  world: mod GameWorld
  entityId: view EntityId
) {
  despawnPhysicsCube(physicsSystem: physicsSystem, entityId: entityId)
  clearEntityComponents(world: world, entityId: entityId)
  freeEntity(this: world.allocator, entityId: entityId)
}
