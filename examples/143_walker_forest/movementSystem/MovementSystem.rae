# MovementSystem — the terrain gates a character moves under (land, wadable
# water) on this example's biome. The movement itself is the character's Box3D
# mover (PhysicsSystem), which keeps deep water a wall through terrainWadable;
# the spawn onto land and the model matrix are lib/app3d/WalkerCharacter.
import Math
import Vec3
import Quat
open WorldBiome
open Math3d
open Mesh3d
open app3d/CharacterController
import terrainSystem/TerrainSystem

# Is this spot walkable ground? NOT a height test: the seabed is ordinary ground
# to terrainHeightAt (#857), so only the biome can tell land from sea.
func terrainIsLand(x: view Float, y: view Float) ret Bool {
  ret worldIsLand(x: x, y: y, cfg: forestBiomeConfig())
}

# Can a character WALK/WADE here (#84): land, or shallow water up to waist depth.
# This is the MOVEMENT gate — deeper water still blocks (it would need swimming),
# while terrainIsLand stays the SPAWN test (nobody starts standing in the sea).
func terrainWadable(x: view Float, y: view Float) ret Bool {
  ret worldWadable(x: x, y: y, cfg: forestBiomeConfig())
}

# How deep the water is here in WORLD units (0 on land), so splash intensity can
# scale with it. worldWaterDepth is in elevation units; scale to world Z (#84).
func terrainWaterDepth(x: view Float, y: view Float) ret Float {
  ret worldWaterDepth(x: x, y: y, cfg: forestBiomeConfig()) * worldTerrainAmplitude
}

func terrainFindLand(x: view Float, y: view Float) ret Vec3 {
  ret worldFindLand(x: x, y: y, cfg: forestBiomeConfig())
}
