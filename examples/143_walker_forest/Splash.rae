# The walker's wading splashes are lib/water/WadeSplash; this file is only
# what is this app's: the material preview's switches and camera, and the pose
# check's loop over this app's skeleton and walk clip.
#
#   RAE_WALKER_SPLASH_PREVIEW=1      bursts at a shallow shore, camera on it
#   RAE_WALKER_SPLASH_AGE=0.12       ...one burst frozen at that age
#   RAE_WALKER_SPLASH_TEST=1         the pose check: one [splash-pose] line
import Sys
import Vec3
open WorldBiome
open app3d/CameraRig
open water/WadeSplash
open app3d/WalkerCharacter

# Start the material preview when RAE_WALKER_SPLASH_PREVIEW is set: bursts at
# the first shallow shore along +x, the orbit camera close on it
func prepareSplashPreview(
  wadeSplash: mod WadeSplash
  cameraSystem: mod CameraSystem
  groundZ: view Float
) {
  if Sys.getEnv(name: "RAE_WALKER_SPLASH_PREVIEW").length() is 0 {
    ret
  }
  if let shore: Vec3 = findShallowShore(biome: forestBiomeConfig(), groundZ: groundZ) {
    var age: Float = -1.0
    let ageSetting: String = Sys.getEnv(name: "RAE_WALKER_SPLASH_AGE")
    if ageSetting.length() > 0 {
      age = ageSetting.toFloat()
    }
    startWadeSplashPreview(wadeSplash: wadeSplash, origin: shore, age: age)
    cameraSystem.camera.target = Vec3.create(x: shore.x, y: shore.y, z: shore.z + 0.2)
    cameraSystem.rig.mode = CameraRigMode.orbit
    cameraSystem.rig.yaw = 0.0
    cameraSystem.rig.orbitPitch = 0.22
    cameraSystem.rig.distance = 2.4
    snapCameraRigView(rig: cameraSystem.rig)
    log("[splash-preview] shore {shore.x}, {shore.y}, {shore.z}; age {age}")
    ret
  }
  log("[splash-preview] no shallow shore found")
}

# The pose check (WadeSplash.finishWadePoseCheck) on the hero walking for 3 s,
# the water 12 cm above its feet. 0 when it passed.
func runSplashPoseTest(
  characterSystem: mod CharacterSystem
  world: view GameWorld
  wadeSplash: mod WadeSplash
) ret Int {
  if characterSystem.leftFootNode < 0 or characterSystem.rightFootNode < 0 {
    ret 1
  }
  let heroEntityId: EntityId = characterSystem.heroEntityId
  let origin: Vec3 = controllerOf(world: world, entityId: heroEntityId).position
  let level: Float = origin.z + characterSystem.groundZ + 0.12
  var check: WadePoseCheck = createWadePoseCheck()
  loop var frame: Int = 0, frame < 180, ++frame {
    let palette: List(Float) = poseCharacterPalette(
      characterSystem: characterSystem
      clipIndex: ClipKind.walk as Int
      animTime: frame.toFloat() / 60.0
    )
    captureCharacterFeet(
      characterSystem: characterSystem
      world: world
      wadeSplash: wadeSplash
      entityId: heroEntityId
    )
    wadePoseCheckFrame(
      check: check
      wadeSplash: wadeSplash
      entityId: heroEntityId
      level: level
    )
  }
  if finishWadePoseCheck(
    check: check
    wadeSplash: wadeSplash
    entityId: heroEntityId
    level: level
  ) {
    ret 0
  }
  ret 1
}

# Record the feet of `entityId` in the pose the skeleton has now
func captureCharacterFeet(
  characterSystem: view CharacterSystem
  world: view GameWorld
  wadeSplash: mod WadeSplash
  entityId: view EntityId
) {
  captureWadeFeet(
    wadeSplash: wadeSplash
    entityId: entityId
    model: walkerWorldModel(
      baseModel: characterSystem.basePartModel
      controller: controllerOf(world: world, entityId: entityId)
    )
    skeleton: characterSystem.skeleton
    leftFootNode: characterSystem.leftFootNode
    rightFootNode: characterSystem.rightFootNode
  )
}
