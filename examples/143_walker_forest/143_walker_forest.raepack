pack WalkerForest {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "3D Renderer — Walker in a huge forest"
  description: "The deferred walker (136) on a huge generated terrain instead of an island: about 32,000 trees of nine kinds in stands over 1.2 km, with lakes and meadows. The trees are one PropField (lib/app3d/PropField): three levels of detail, only what is near and in view gathered, one instanced draw per species, level and part. Physics stays the same size however big the forest is: a pool of 96 static trunk bodies is moved onto the trees nearest the walker, and the ground height field is made again round the walker as it goes. The ground tiles, small props, grass and sea follow the walker too."
  category: "3D Renderer"
  display: {
    width: 1280
    height: 800
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
