# Walker in a huge forest: the deferred walker of 136 on a wide generated
# terrain instead of an island (lib/app3d/WideForest): about 30,000 trees of
# ten kinds in stands over 1.2 km, with lakes and meadows, drawn from one
# PropField. Physics stays the same size however big the forest is: a pool
# of static trunk bodies is moved onto the trees nearest the walker, and the
# ground height field is made again round the walker as it goes.
#
# The app is the walker app shell lib/app3d/WalkerApp; this example is its
# settings: the wide forest (WalkerLand.forest) on the deferred renderer. The
# assets are 136's, read in place.
#
# Compiled-target only; needs wgpu-native + SDL3.
#   rae run examples/143_walker_forest/Main.rae
open app3d/WalkerApp
open app3d/WalkerAppSetup

func main() ret Int {
  let settings: WalkerAppSettings = {
    title: "143: Rae 3D — walker in a huge forest [deferred]"
    appId: "143_walker_forest"
    assets: "examples/136_walker_character/assets/"
    forward: false
    land: WalkerLand.forest
  }
  ret runWalkerApp(settings: settings)
}
