# The walker's terrain is lib/app3d/WalkerTerrain (the streamed tiles and
# small props, the forest field, their draws and shadows). This file is this
# example's settings: a 17 x 17 cell window on a world that is not an island,
# and the forest of terrainSystem/Forest.
open WorldBiome
open Scene3d
open app3d/WalkerTerrain

const terrainGridSide: Int = 17

const terrainHalfGrid: Int = 8

# The forest world is not an island. The lib's biome field fades the land out
# into the sea at its island radius; a radius far past anywhere the walker can
# go turns that off, so the noise terrain (hills, valleys, lakes) goes on.
const forestWorldRadius: Float = 1000000.0

func forestBiomeConfig() ret BiomeConfig {
  var config: BiomeConfig = defaultBiomeConfig()
  config.islandRadius = forestWorldRadius
  ret config
}

# The same radius for the terrain and grass shaders (world_biome.wgsl's
# `override`s), so the GPU ground matches the CPU's
func forestBiomeConstants() ret List(ShaderConstant) {
  ret islandConstantsFor(cfg: forestBiomeConfig())
}

# The height field IS the biome elevation field (lib/WorldBiome).
func terrainHeightAt(x: view Float, y: view Float, groundZ: view Float) ret Float {
  ret worldTerrainHeight(
    x: x
    y: y
    groundZ: groundZ
    cfg: forestBiomeConfig()
  )
}

# Nothing stands in the sea, and vegetation wants grass under it.
func terrainPropAllowed(x: view Float, y: view Float, minGrass: view Float) ret Bool {
  ret worldPropAllowed(
    x: x
    y: y
    minGrass: minGrass
    cfg: forestBiomeConfig()
  )
}

# The terrain of the forest world, its props spawned into `world`, its
# forest not planted yet (Forest.plantForest)
func createTerrainSystem(
  renderer: mod DeferredRenderer
  world: mod GameWorld
  assets: view String
  groundZ: view Float
) ret WalkerTerrain {
  ret createWalkerTerrain(
    renderer: renderer
    allocator: world.allocator
    transforms: world.transforms
    propKinds: world.propKinds
    assets: assets
    gridSide: terrainGridSide
    groundZ: groundZ
    biome: forestBiomeConfig()
    forest: forestFieldSettings()
  )
}
