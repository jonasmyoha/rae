pack AdvancedPong {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  targets: {
,
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: { path: "Main.rae", emit: compiled }
        source: { path: "ai.rae", emit: compiled }
      }
    }
  }
}
