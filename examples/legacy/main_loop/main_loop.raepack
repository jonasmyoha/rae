pack MainLoop {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  name: "Main loop"
  description: "Logs tick numbers until stopped. Compiled and Hybrid."
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: compiled }
      }
    }
    target hybrid: {
      label: "Hybrid"
      entry: "main.rae"
      sources: {
        source: { path: ".", emit: hybrid }
      }
    }
  }
}
