# The layer paint order on the GPU (ui/UiLayers, ui/RenderSystem's plan walk;
# docs/ui-layers-design.md
# §4.4, §5): one 800x600 frame from a program that walks its own layer plan, written as a BMP
# (RAE_GPU2D_SCREENSHOT; a file in the temp folder when it is not set) and read back:
#   1. the program's own drawing between two scene layers: a red box in hud, the program's green
#      LayerDraw in hudOver over it, a blue box in dock over both where the three overlap;
#   2. a QR code (qr 1.2.0, a CustomPaint node painted by qrCodePaintStep in its place) covered by
#      an open dialog's half-black scrim: the code's white is darkened, not drawn over the scrim;
#   3. a layer at opacity 0.5 (canvasPushLayer): its white draw over black is a mid gray;
#   4. a dock layer's draw cut at the safe rectangle (a 100-point safe area at the bottom): yellow
#      above the safe edge, black below it.
# Exit 0 when all of that holds.
#
#   compiler/bin/rae run checks/uiLayerOrder/Main.rae
import Gpu2d
import Math
import Sys
import ui/Components
open app3d/UiShell
open ecs/Entity
open ecs/Schedule
open ui/Ecs
open ui/LayerFrame
open ui/LayerMotion
open ui/Pipeline
open ui/RenderSystem
open ui/Scene
open ui/SceneLoader
open ui/UiLayers
open ui/UiSystems
open qr/qrCodeSystem/QrCodeSystem
open Gpu2dCanvas

const designW: Int = 800

const designH: Int = 600

func pageScene() ret String {
  ret "\{\"type\":\"Scene\",\"version\":2,\"root\":\"Page\",\"nodes\":\{\"Page\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":800,\"h\":600\},\"Children\":[\"HudBox\",\"Code\"]\},\"HudBox\":\{\"Rect\":\{\"x\":50,\"y\":50,\"w\":200,\"h\":200\},\"Shape\":\{\"kind\":\"Rect\",\"fill\":\"#FF0000\"\}\},\"Code\":\{\"Rect\":\{\"x\":450,\"y\":50,\"w\":200,\"h\":200\},\"QrCode\":\{\"text\":\"https://example.com/rae/layers\",\"errorCorrection\":\"M\"\}\}\}\}"
}

func dockScene() ret String {
  ret "\{\"type\":\"Scene\",\"version\":2,\"root\":\"Dock\",\"nodes\":\{\"Dock\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":800,\"h\":600\},\"LayerTag\":\{\"id\":\"dock\"\},\"Children\":[\"DockBox\"]\},\"DockBox\":\{\"Rect\":\{\"x\":150,\"y\":150,\"w\":200,\"h\":200\},\"Shape\":\{\"kind\":\"Rect\",\"fill\":\"#0000FF\"\}\}\}\}"
}

func dialogScene() ret String {
  ret "\{\"type\":\"Scene\",\"version\":2,\"root\":\"Dialog\",\"nodes\":\{\"Dialog\":\{\"Rect\":\{\"x\":0,\"y\":0,\"w\":800,\"h\":600\},\"LayerTag\":\{\"id\":\"dialog\"\},\"Children\":[\"Scrim\"]\},\"Scrim\":\{\"Rect\":\{\"x\":400,\"y\":0,\"w\":400,\"h\":300\},\"Shape\":\{\"kind\":\"Rect\",\"fill\":\"#00000080\"\}\}\}\}"
}

func readLe(bytes: view List(Int), at: view Int, count: view Int) ret Int {
  var value: Int = 0
  loop var i: Int = count - 1, i >= 0, --i {
    value = value * 256 + bytes.copyAtFallback(index: at + i, fallback: 0)
  }
  ret value
}

# One channel (0 blue, 1 green, 2 red) at a design-unit point of the 32-bit BMP, rows bottom-up
func channelAt(
  bytes: view List(Int)
  x: view Float
  y: view Float
  channel: view Int
) ret Int {
  let offset: Int = readLe(bytes: bytes, at: 10, count: 4)
  let width: Int = readLe(bytes: bytes, at: 18, count: 4)
  let height: Int = readLe(bytes: bytes, at: 22, count: 4)
  let px: Int = (x * width.toFloat() / designW.toFloat()).toInt()
  let py: Int = (y * height.toFloat() / designH.toFloat()).toInt()
  let row: Int = height - 1 - py
  ret bytes.copyAtFallback(index: offset + (row * width + px) * 4 + channel, fallback: 0)
}

func colorText(bytes: view List(Int), x: view Float, y: view Float) ret String {
  ret "{channelAt(
    bytes: bytes
    x: x
    y: y
    channel: 2
  )},{channelAt(
    bytes: bytes
    x: x
    y: y
    channel: 1
  )},{channelAt(
    bytes: bytes
    x: x
    y: y
    channel: 0
  )}"
}

# Is the point mostly `r`, `g`, `b` (each 0 or 255), within 40?
func isColor(
  bytes: view List(Int)
  x: view Float
  y: view Float
  r: view Int
  g: view Int
  b: view Int
) ret Bool {
  ret Math.abs(value: channelAt(
    bytes: bytes
    x: x
    y: y
    channel: 2
  ) - r) <= 40 and Math.abs(value: channelAt(
    bytes: bytes
    x: x
    y: y
    channel: 1
  ) - g) <= 40 and Math.abs(value: channelAt(
    bytes: bytes
    x: x
    y: y
    channel: 0
  ) - b) <= 40
}

func main() ret Int {
  var shot: String = Sys.getEnv(name: "RAE_GPU2D_SCREENSHOT")
  if shot.length() is 0 {
    var folder: String = Sys.getEnv(name: "TMPDIR")
    if folder.length() is 0 {
      folder = "/tmp"
    }
    shot = "{folder}/rae-uiLayerOrder.bmp"
    let unusedShotSet: Bool = Sys.setEnv(name: "RAE_GPU2D_SCREENSHOT", value: shot)
  }
  if Sys.getEnv(name: "RAE_HEADLESS_FRAMES").length() is 0 {
    let unusedFramesSet: Bool = Sys.setEnv(name: "RAE_HEADLESS_FRAMES", value: "6")
  }
  Gpu2d.initWindow(width: designW, height: designH, title: "UI layer order check")
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  let gpuUi: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: "MaterialIconsRound-Regular"
    themeFile: "Theme.raescene"
  )
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  seedWorldTheme(world: world, res: gpuUi)
  Gpu2d.setDesignResolution(width: designW.toFloat(), height: designH.toFloat(), fit: 0)
  world.layoutW = designW.toFloat()
  world.layoutH = designH.toFloat()
  var qrCodeSystem: QrCodeSystem = createQrCodeSystem()
  let page: EntityId = loadScene(
    world: world
    uiSystems: uiSystems
    scene: parseScene(source: pageScene())
  )
  let dock: EntityId = loadScene(
    world: world
    uiSystems: uiSystems
    scene: parseScene(source: dockScene())
  )
  let dialog: EntityId = loadScene(
    world: world
    uiSystems: uiSystems
    scene: parseScene(source: dialogScene())
  )
  qrCodeTakePending(world: world, qrCodeSystem: qrCodeSystem)
  var schedule: Schedule = createUiPipeline(world: world)

  # the window's stack: a 100-point safe area at the bottom; the program's three draws
  var stack: LayerStack = createStandardLayerStack()
  layerStackAddWorld(stack: stack, worldKey: 0)
  setLayerStackFrame(
    stack: stack
    width: designW.toFloat()
    height: designH.toFloat()
    safe: Insets { l: 0.0, t: 0.0, r: 0.0, b: 100.0 }
    reserved: Insets { l: 0.0, t: 0.0, r: 0.0, b: 0.0 }
  )
  let unusedGreen: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw {
      layer: layerIdOf(stack: stack, name: "hudOver")
      kind: LayerDrawKind.app
      appKind: 1
    }
  )
  let unusedWhite: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw {
      layer: layerIdOf(stack: stack, name: "popover")
      kind: LayerDrawKind.app
      appKind: 2
    }
  )
  let unusedYellow: Int = addLayerDraw(
    stack: stack
    draw: LayerDraw {
      layer: layerIdOf(stack: stack, name: "dock")
      kind: LayerDrawKind.app
      appKind: 3
    }
  )
  animateLayer(
    stack: stack
    id: layerIdOf(stack: stack, name: "popover")
    property: LayerMotionProperty.opacity
    to: 0.5
    seconds: 0.0
  )
  var contributions: List(LayerContribution) = { createLayerContribution(worldKey: 0) }
  var plan: LayerPaintPlan = createLayerPaintPlan()

  var frames: Int = 0
  loop not Gpu2d.pollClose() and frames < 600 {
    runScheduledUiSystems(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      res: gpuUi
    )
    if let contribution: mod LayerContribution = contributions.modAt(index: 0) {
      refreshLayerContribution(
        contribution: contribution
        stack: stack
        world: world
        uiSystems: uiSystems
      )
    }
    buildLayerPaintPlan(
      plan: plan
      stack: stack
      contributions: contributions
      editor: false
    )
    Gpu2d.beginFrame(
      canvas: canvas
      r: 0.0
      g: 0.0
      b: 0.0
      a: 1.0
    )
    loop let step: view PaintStep in plan.steps {
      if paintPlanStepRaeG(
        step: step
        stack: stack
        worldKey: 0
        world: world
        uiSystems: uiSystems
        res: gpuUi
        canvas: canvas
      ) {
        continue
      }
      if qrCodePaintStep(
        qrCodeSystem: qrCodeSystem
        world: world
        uiSystems: uiSystems
        canvas: canvas
        step: step
      ) {
        continue
      }
      if step.kind is PaintStepKind.draw {
        let clipped: Bool = beginLayerDrawG(step: step, stack: stack, canvas: canvas)
        if step.appKind is 1 {
          Gpu2d.drawRect(
            canvas: canvas
            x: 100.0
            y: 100.0
            w: 200.0
            h: 200.0
            color: 4278255360
          )
        } else if step.appKind is 2 {
          Gpu2d.drawRect(
            canvas: canvas
            x: 450.0
            y: 420.0
            w: 100.0
            h: 60.0
            color: 4294967295
          )
        } else if step.appKind is 3 {
          Gpu2d.drawRect(
            canvas: canvas
            x: 0.0
            y: 440.0
            w: 400.0
            h: 160.0
            color: 4294967040
          )
        }
        endLayerDrawG(canvas: canvas, pushed: clipped)
      }
    }
    Gpu2d.endFrame(canvas: canvas)
    frames = frames + 1
  }
  canvasShutdown(canvas: canvas)
  Gpu2d.closeWindow()
  let bytes: List(Int) = Sys.readFileBytes(path: shot)
  if bytes.length < 54 {
    log("UI LAYER ORDER FAILED: no picture at {shot}")
    ret 1
  }
  var failures: Int = 0
  # 1. red alone, green over red, blue over green
  let red: Bool = isColor(
    bytes: bytes
    x: 70.0
    y: 70.0
    r: 255
    g: 0
    b: 0
  )
  let green: Bool = isColor(
    bytes: bytes
    x: 120.0
    y: 120.0
    r: 0
    g: 255
    b: 0
  )
  let blue: Bool = isColor(
    bytes: bytes
    x: 200.0
    y: 200.0
    r: 0
    g: 0
    b: 255
  )
  log(
    "[uiLayerOrder] 1. the hud box {colorText(bytes: bytes, x: 70.0, y: 70.0)} (red {red}); the program's hudOver draw over it {colorText(
      bytes: bytes
      x: 120.0
      y: 120.0
    )} (green {green}); the dock box over both {colorText(bytes: bytes, x: 200.0, y: 200.0)} (blue {blue})"
  )
  if not red or not green or not blue {
    failures = failures + 1
  }
  # 2. the QR code under the scrim: its brightest pixel is the white darkened by half
  var brightest: Int = 0
  var darkest: Int = 255
  loop var gy: Int = 0, gy < 40, ++gy {
    loop var gx: Int = 0, gx < 40, ++gx {
      let value: Int = channelAt(
        bytes: bytes
        x: 452.0 + gx.toFloat() * 5.0
        y: 52.0 + gy.toFloat() * 5.0
        channel: 1
      )
      brightest = Math.max(a: brightest, b: value)
      darkest = Math.min(a: darkest, b: value)
    }
  }
  let underScrim: Bool = brightest >= 100 and brightest <= 160 and darkest < 40
  log(
    "[uiLayerOrder] 2. the QR code under the dialog's scrim: brightest {brightest}, darkest {darkest} (its white darkened, not over the scrim: {underScrim})"
  )
  if not underScrim {
    failures = failures + 1
  }
  # 3. a white draw in a layer at opacity 0.5, over black
  let half: Int = channelAt(
    bytes: bytes
    x: 500.0
    y: 450.0
    channel: 1
  )
  let blended: Bool = half >= 100 and half <= 160
  log(
    "[uiLayerOrder] 3. a white draw at layer opacity 0.5: {colorText(
      bytes: bytes
      x: 500.0
      y: 450.0
    )} (a mid gray {blended})"
  )
  if not blended {
    failures = failures + 1
  }
  # 4. the dock's draw cut at the safe rectangle (y 500)
  let above: Bool = isColor(
    bytes: bytes
    x: 200.0
    y: 470.0
    r: 255
    g: 255
    b: 0
  )
  let below: Bool = isColor(
    bytes: bytes
    x: 200.0
    y: 550.0
    r: 0
    g: 0
    b: 0
  )
  log(
    "[uiLayerOrder] 4. the dock's draw above the safe edge {colorText(
      bytes: bytes
      x: 200.0
      y: 470.0
    )} (yellow {above}), below it {colorText(bytes: bytes, x: 200.0, y: 550.0)} (cut {below})"
  )
  if not above or not below {
    failures = failures + 1
  }
  if failures > 0 {
    log("UI LAYER ORDER FAILED: {failures} of 4")
    ret 1
  }
  log("UI LAYER ORDER PASSED")
  ret 0
}
