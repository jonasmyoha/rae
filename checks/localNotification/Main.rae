# lib/LocalNotification on a real iPhone: nothing else can show one ringing. Off iOS it has
# nothing to test, says so and passes. On a phone it asks and at once, with the question still
# open on a fresh install, schedules (held until the answer, docs/local-notifications.md):
#   closed      in 45 s: must ring with the app closed (end it after the answer)
#   replaced    in 45 s, then the same id again: only "replaced, the new one" rings
#   cancelled   in 45 s, then cancelled: must not ring
#   past        a moment ago: answers false
# Run: delete the app from the phone, RAE_IOS_TEAM=<team> sh tools/ios/run-ios.sh
# checks/localNotification, tap Allow within 45 s, end the app, and look at the Lock Screen or
# Notification Center 45 s after it started. The screen is gray until the answer, then green for
# yes and red for no.
import Gpu2d
open Gpu2dCanvas
open LocalNotification

const delayMs: Int = 45000

func scheduleAll() ret Bool {
  let at: Int = nowMs() + delayMs
  let closed: Bool = localNotificationSchedule(
    id: "closed"
    atEpochMs: at
    title: "Rae check"
    body: "rang with the app closed"
  )
  let first: Bool = localNotificationSchedule(
    id: "replaced"
    atEpochMs: at
    title: "Rae check"
    body: "WRONG: this one was replaced"
  )
  let second: Bool = localNotificationSchedule(
    id: "replaced"
    atEpochMs: at
    title: "Rae check"
    body: "replaced, the new one"
  )
  let toCancel: Bool = localNotificationSchedule(
    id: "cancelled"
    atEpochMs: at
    title: "Rae check"
    body: "WRONG: this one was cancelled"
  )
  let cancelled: Bool = localNotificationCancel(id: "cancelled")
  let past: Bool = localNotificationSchedule(
    id: "past"
    atEpochMs: nowMs() - 1000
    title: "Rae check"
    body: "WRONG: this moment was in the past"
  )
  log(
    "scheduled: closed {closed}, replaced {first} {second}, cancel {toCancel} {cancelled}, past {past}"
  )
  ret closed and first and second and toCancel and cancelled and past is false
}

func main() ret Int {
  when Target.os is Os.ios {
    let startedMs: Int = nowMs()
    log("asked: {localNotificationAsk()}")
    log("all as expected: {scheduleAll()}")
    Gpu2d.initWindow(width: 390, height: 844, title: "Local notification check")
    var canvas: Gpu2dCanvas = createGpu2dCanvas()
    log("cleared: {localNotificationClearDelivered()}")
    var answerLogged: Bool = false
    loop Gpu2d.pollClose() is false and nowMs() - startedMs < 300000 {
      var red: Float = 0.3
      var green: Float = 0.3
      var blue: Float = 0.3
      if let allowed: Bool = localNotificationAllowed() {
        blue = 0.1
        if allowed {
          red = 0.1
          green = 0.6
        } else {
          red = 0.6
          green = 0.1
        }
        if answerLogged is false {
          answerLogged = true
          log("answered {allowed} after {nowMs() - startedMs} ms")
        }
      }
      Gpu2d.beginFrame(
        canvas: canvas
        r: red
        g: green
        b: blue
        a: 1.0
      )
      Gpu2d.endFrame(canvas: canvas)
    }
    ret 0
  } else {
    log("LOCAL NOTIFICATION OK: nothing to test off iOS; run it on a phone (see this file)")
    ret 0
  }
}
