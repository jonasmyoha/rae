# The LineGraph and StatTable charts, painted (ui/ChartComponents, ui/lineGraphSystem,
# ui/statTableSystem, docs/perf-tools-design.md §6): three counters over a second, one point
# selected, and a table of systems sorted by their total, descending, one row selected:
#
#   RAE_HEADLESS_FRAMES=10 RAE_GPU2D_SCREENSHOT=/tmp/linetable.bmp \
#     compiler/bin/rae run checks/uiLineTable/Main.rae
#
# The rules are checked exactly in compiler/tests/cases/1474_ui_line_table. Exit 0 when it drew.
import Gpu2d
import Math
import ui/Scene
open app3d/UiShell
open ecs/ComponentTable
open ecs/Entity
open ecs/Schedule
open ui/ChartComponents
open ui/Ecs
open ui/Pipeline
open ui/RenderSystem
open ui/SceneFile
open ui/SceneLoader
open ui/UiSystems
open ui/InputSystem
open ui/lineGraphSystem/LineGraphSystem
open ui/statTableSystem/StatTableSystem
open Gpu2dCanvas

const designW: Int = 800

const designH: Int = 600

func fillLines(state: mod LineGraphState) {
  let fps: Int = lineAddSeries(state: state, name: "frame ms")
  let gpu: Int = lineAddSeries(state: state, name: "gpu ms")
  let load: Int = lineAddSeries(state: state, name: "draws / 100")
  loop var i: Int = 0, i < 2000, ++i {
    let time: Int = i * 500000
    let wave: Float = Math.sin(x: (i as Float) * 0.01)
    var frame: Float = 12.0 + 2.0 * wave
    if i % 240 is 0 {
      frame = 30.0
    }
    let unusedFrame: Bool = lineAddPoint(
      state: state
      series: fps
      time: time
      value: frame
    )
    let unusedGpu: Bool = lineAddPoint(
      state: state
      series: gpu
      time: time
      value: 8.0 + 1.5 * Math.cos(x: (i as Float) * 0.013)
    )
    let unusedLoad: Bool = lineAddPoint(
      state: state
      series: load
      time: time
      value: 5.0 + (i % 400) as Float * 0.01
    )
  }
  lineShow(state: state, start: 0, end: 1000000000)
  state.selectedSeries = fps
  state.selectedPoint = 960
}

func fillTable(state: mod StatTableState) {
  let unusedName: Int = statAddColumn(
    state: state
    title: "system"
    width: 300.0
    numeric: false
  )
  let unusedCalls: Int = statAddColumn(
    state: state
    title: "calls"
    width: 200.0
    numeric: true
  )
  let total: Int = statAddColumn(
    state: state
    title: "total ms"
    width: 260.0
    numeric: true
  )
  let names: List(String) = List(String) {
    "layout"
    "transform"
    "render"
    "physics"
    "animation"
    "input"
    "audio mix"
    "terrain"
    "grass"
    "shadows"
    "water"
    "particles"
  }
  loop var i: Int = 0, i < names.length, ++i {
    let calls: Int = 60 * ((i % 3) + 1)
    let ms: Float = ((i * 37) % 23) as Float * 0.25 + 0.5
    let unusedRow: Int = statAddRow(
      state: state
      texts: List(String) { names.copyAtDefault(index: i), "{calls}", "{ms}" }
      values: List(Float) { 0.0, calls as Float, ms }
    )
  }
  statSort(state: state, column: total, descending: true)
  state.selected = 3
}

func main() ret Int {
  Gpu2d.initWindow(width: designW, height: designH, title: "UI line graph and table check")
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  let gpuUi: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: "MaterialIconsRound-Regular"
    themeFile: "Theme.raescene"
  )
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  seedWorldTheme(world: world, res: gpuUi)
  Gpu2d.setDesignResolution(width: designW.toFloat(), height: designH.toFloat(), fit: 0)
  world.layoutW = designW.toFloat()
  world.layoutH = designH.toFloat()
  let scene: Scene = loadSceneFile(path: "checks/uiLineTable/charts.raescene")
  if scene.ok is false {
    log("UI CHARTS FAILED: {scene.errorMsg}")
    Gpu2d.closeWindow()
    ret 1
  }
  loadScene(world: world, uiSystems: uiSystems, scene: scene)
  var schedule: Schedule = createUiPipeline(world: world)
  var input: UiInput = createUiInput()
  runScheduledUiSystems(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    res: gpuUi
  )
  let unusedLines: Bool = lineGraphSystem(world: world, uiSystems: uiSystems, input: input)
  let unusedTable: Bool = statTableSystem(world: world, uiSystems: uiSystems, input: input)
  var filled: Int = 0
  if let raw: Int = world.nodeIds.get(k: "Counters") {
    let counters: EntityId = id(v: raw)
    if componentHas(this: world.lineGraphStates, entityId: counters) {
      fillLines(state: componentMod(this: world.lineGraphStates, entityId: counters))
      filled = filled + 1
    }
  }
  if let raw: Int = world.nodeIds.get(k: "Stats") {
    let stats: EntityId = id(v: raw)
    if componentHas(this: world.statTableStates, entityId: stats) {
      fillTable(state: componentMod(this: world.statTableStates, entityId: stats))
      filled = filled + 1
    }
  }
  var frames: Int = 0
  loop not Gpu2d.pollClose() and frames < 600 {
    runScheduledUiSystems(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      res: gpuUi
    )
    Gpu2d.beginFrame(
      canvas: canvas
      r: 0.03
      g: 0.05
      b: 0.08
      a: 1.0
    )
    renderSystemGpu2d(
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    )
    Gpu2d.endFrame(canvas: canvas)
    frames = frames + 1
  }
  canvasShutdown(canvas: canvas)
  Gpu2d.closeWindow()
  if filled is not 2 {
    log("UI CHARTS FAILED: {filled} of 2 charts have their state")
    ret 1
  }
  log("UI CHARTS OK: {frames} frames")
  ret 0
}
