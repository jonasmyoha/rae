# A Sprite's hueRotate and brightness on the GPU (gpu2d_image.wgsl imageColor; case 1569 has the
# numbers without a GPU): one solid blue image (38, 89, 217) drawn by four sprites of a scene, at
# 0, 120 and -65 degrees and at 120 with brightness 1.3, through the real pipeline. The frame is
# written as a BMP (RAE_GPU2D_SCREENSHOT; a file in the temp folder when it is not set) and read
# back at each sprite's middle: blue, red, green, and the bright one redder than the plain red,
# each within a few steps of imageColorOf's color. Exit 0 when all of that holds.
#
#   compiler/bin/rae run checks/spriteHueRotate/Main.rae
import Gpu2d
import Math
import Sys
open app3d/UiShell
open ecs/Entity
open ecs/Schedule
open ui/Ecs
open ui/Pipeline
open ui/RenderSystem
open ui/SceneFile
open ui/SceneLoader
open ui/UiSystems
open Gpu2dCanvas
open Gpu2dCanvasImage

const designW: Int = 800

const designH: Int = 600

const artR: Int = 38

const artG: Int = 89

const artB: Int = 217

func readLe(bytes: view List(Int), at: view Int, count: view Int) ret Int {
  var value: Int = 0
  loop var i: Int = count - 1, i >= 0, --i {
    value = value * 256 + bytes.copyAtFallback(index: at + i, fallback: 0)
  }
  ret value
}

type Pixel {
  r: Int
  g: Int
  b: Int
}

# The pixel at a design-unit point of the 32-bit BMP (blue, green, red, alpha; rows bottom-up)
func pixelAt(bytes: view List(Int), x: view Float, y: view Float) ret Pixel {
  let offset: Int = readLe(bytes: bytes, at: 10, count: 4)
  let width: Int = readLe(bytes: bytes, at: 18, count: 4)
  let height: Int = readLe(bytes: bytes, at: 22, count: 4)
  let px: Int = (x * width.toFloat() / designW.toFloat()).toInt()
  let py: Int = (y * height.toFloat() / designH.toFloat()).toInt()
  let at: Int = offset + ((height - 1 - py) * width + px) * 4
  ret Pixel {
    r: bytes.copyAtFallback(index: at + 2, fallback: 0)
    g: bytes.copyAtFallback(index: at + 1, fallback: 0)
    b: bytes.copyAtFallback(index: at, fallback: 0)
  }
}

# The pixel against imageColorOf's color for the art: within `tolerance` steps in each channel
func matches(
  pixel: view Pixel
  hueDegrees: view Float
  brightness: view Float
  label: view String
) ret Bool {
  let want: ImageColor = imageColorOf(
    r: artR.toFloat() / 255.0
    g: artG.toFloat() / 255.0
    b: artB.toFloat() / 255.0
    hueDegrees: hueDegrees
    brightness: brightness
  )
  let wantR: Int = (want.r * 255.0 + 0.5).toInt()
  let wantG: Int = (want.g * 255.0 + 0.5).toInt()
  let wantB: Int = (want.b * 255.0 + 0.5).toInt()
  log("{label}: {pixel.r} {pixel.g} {pixel.b} (imageColorOf {wantR} {wantG} {wantB})")
  let tolerance: Int = 3
  ret Math.abs(value: pixel.r - wantR) <= tolerance and Math.abs(value: pixel.g - wantG) <= tolerance and Math.abs(
    value: pixel.b - wantB
  ) <= tolerance
}

func main() ret Int {
  var shot: String = Sys.getEnv(name: "RAE_GPU2D_SCREENSHOT")
  if shot.length() is 0 {
    var folder: String = Sys.getEnv(name: "TMPDIR")
    if folder.length() is 0 {
      folder = "/tmp"
    }
    shot = "{folder}/rae-spriteHueRotate.bmp"
    let unusedShotSet: Bool = Sys.setEnv(name: "RAE_GPU2D_SCREENSHOT", value: shot)
  }
  if Sys.getEnv(name: "RAE_HEADLESS_FRAMES").length() is 0 {
    let unusedFramesSet: Bool = Sys.setEnv(name: "RAE_HEADLESS_FRAMES", value: "5")
  }
  Gpu2d.initWindow(width: designW, height: designH, title: "Sprite hue rotation check")
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  let gpuUi: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: "MaterialIconsRound-Regular"
    themeFile: "Theme.raescene"
  )
  # the art: one solid blue, 32x16
  var pixels: List(Int) = List.create(Int, cap: 32 * 16)
  loop var i: Int = 0, i < 32 * 16, ++i {
    pixels.add(value: artR + artG * 256 + artB * 65536 + 255 * 16777216)
  }
  let handle: Int = Gpu2d.registerImageRgba(
    canvas: canvas
    key: "pill"
    pixels: pixels.data
    w: 32
    h: 16
  )
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  seedWorldTheme(world: world, res: gpuUi)
  Gpu2d.setDesignResolution(width: designW.toFloat(), height: designH.toFloat(), fit: 0)
  world.layoutW = designW.toFloat()
  world.layoutH = designH.toFloat()
  let scene: Scene = loadSceneFile(path: "checks/spriteHueRotate/page.raescene")
  if scene.ok is false or handle <= 0 {
    log("SPRITE HUE ROTATE FAILED: the scene ({scene.errorMsg}) or the image did not load")
    Gpu2d.closeWindow()
    ret 1
  }
  let root: EntityId = loadScene(world: world, uiSystems: uiSystems, scene: scene)
  var schedule: Schedule = createUiPipeline(world: world)
  var frames: Int = 0
  loop not Gpu2d.pollClose() and frames < 600 {
    runScheduledUiSystems(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      res: gpuUi
    )
    Gpu2d.beginFrame(
      canvas: canvas
      r: 0.0
      g: 0.0
      b: 0.0
      a: 1.0
    )
    renderSystemGpu2d(
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    )
    Gpu2d.endFrame(canvas: canvas)
    frames = frames + 1
  }
  canvasShutdown(canvas: canvas)
  Gpu2d.closeWindow()
  let bytes: List(Int) = Sys.readFileBytes(path: shot)
  if bytes.length < 54 {
    log("SPRITE HUE ROTATE FAILED: no picture at {shot} (root {isNone(this: root)})")
    ret 1
  }
  let blue: Pixel = pixelAt(bytes: bytes, x: 120.0, y: 300.0)
  let red: Pixel = pixelAt(bytes: bytes, x: 310.0, y: 300.0)
  let green: Pixel = pixelAt(bytes: bytes, x: 500.0, y: 300.0)
  let bright: Pixel = pixelAt(bytes: bytes, x: 690.0, y: 300.0)
  var ok: Bool = matches(
    pixel: blue
    hueDegrees: 0.0
    brightness: 1.0
    label: "0 degrees"
  )
  ok = matches(
    pixel: red
    hueDegrees: 120.0
    brightness: 1.0
    label: "120 degrees"
  ) and ok
  ok = matches(
    pixel: green
    hueDegrees: -65.0
    brightness: 1.0
    label: "-65 degrees"
  ) and ok
  ok = matches(
    pixel: bright
    hueDegrees: 120.0
    brightness: 1.3
    label: "120 at brightness 1.3"
  ) and ok
  let reads: Bool = blue.b > blue.r and blue.b > blue.g and red.r > red.g and red.r > red.b and green.g > green.r and green.g > green.b and bright.r > red.r
  if not ok or not reads {
    log("SPRITE HUE ROTATE FAILED: a sprite's color is not its turned color")
    ret 1
  }
  log("SPRITE HUE ROTATE OK")
  ret 0
}
