pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../.."
      subdir: "packages/audio"
      version: "0.16.0"
      hash: "git-tree:06b4220e1f8cbe1a1a7f979a699496ba8959afe6"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
