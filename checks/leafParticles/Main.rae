# lib/LeafParticles on the GPU (docs/leaf-particles-design.md §4): two crowns
# release 280 leaves over 20 frames into a ring of 4096 over flat ground at z 0, in a wind
# of 2 m/s toward +x; the ring is read back after 1 s, 12 s and 25 s. The
# leaves are all there and falling after 1 s, drifting downwind, each in its
# crown's color; after 12 s most still there lie on the ground and none is
# over the crowns (the swirls and the gusts' updrafts keep some aloft; one
# lies 6 s, so the first to land are gone); after 25 s (past a leaf's life)
# the ring is empty. A leaf past the reach dies at once. A ground lift's
# leaves rise off the ground.
#
# RAE_LEAF_BENCH=1 times the compute instead (docs/leaf-particles-design.md
# §6): a full ring in a gale, the GPU time of a frame's spawn and fly
# between two gpu/GpuTiming marks, for 16384 and 4096 leaves.
import Math
import Sys
import Vec3
open webgpu/Context
open webgpu/WebgpuEnums
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuReadback
open gpu/GpuArgs
open gpu/GpuIds
open LeafParticles
open gpu/GpuTiming
open gpu/DeviceFeatures
open Wind

const checkCapacity: Int = 4096

type RingCount {
  alive: Int
  landed: Int
  meanX: Float
  meanZ: Float
  lowest: Float
  highest: Float
  reddish: Int
  yellowish: Int
}

func floatAt(bytes: view List(UInt8), at: view Int) ret Float {
  ret Math.floatFromBits(bits: wordAt(bytes: bytes, at: at))
}

func wordAt(bytes: view List(UInt8), at: view Int) ret Int {
  var bits: Int = 0
  loop var k: Int = 3, k >= 0, --k {
    bits = bits * 256 + bytes.copyAtFallback(index: at + k, fallback: 0) as Int
  }
  ret bits
}

# The ring read back (empty when the read failed)
func readRing(resources: mod GpuResources, leafParticles: view LeafParticles) ret List(UInt8) {
  ret readRingOf(resources: resources, leafParticles: leafParticles, capacity: checkCapacity)
}

func readRingOf(
  resources: mod GpuResources
  leafParticles: view LeafParticles
  capacity: view Int
) ret List(UInt8) {
  let size: Int = capacity * leafRecordBytes
  var bytes: List(UInt8) = List.create(UInt8, cap: size)
  if let staging: BufferId = createBuffer(
    resources: resources
    size: size
    usage: WGPUBufferUsage_MapRead + WGPUBufferUsage_CopyDst
  ) {
    if var recording: Recording = beginRecording(resources: resources) {
      if recordCopyBuffer(
        recording: recording
        resources: resources
        source: leafParticles.leaves
        sourceOffset: 0
        destination: staging
        destinationOffset: 0
        size: size
      ) {
        if let submission: SubmissionId = submit(resources: resources, recording: recording) {
          if waitSubmission(resources: resources, id: submission) {
            if let read: ReadbackId = startReadback(
              resources: resources
              buffer: staging
              offset: 0
              size: size
            ) {
              if waitReadback(resources: resources, id: read) {
                loop var i: Int = 0, i < size, ++i {
                  bytes.add(value: 0)
                }
                if not copyReadback(resources: resources, id: read, destination: bytes) {
                  bytes.clear()
                }
              }
              retireReadback(resources: resources, id: read)
            }
          }
          retireSubmission(resources: resources, id: submission)
        }
      }
    }
    retireBuffer(resources: resources, id: staging)
  }
  ret bytes
}

func countRing(bytes: view List(UInt8)) ret RingCount {
  var count: RingCount = {
    alive: 0
    landed: 0
    meanX: 0.0
    meanZ: 0.0
    lowest: 1000.0
    highest: -1000.0
    reddish: 0
    yellowish: 0
  }
  loop var i: Int = 0, i < checkCapacity, ++i {
    let at: Int = i * leafRecordBytes
    if floatAt(bytes: bytes, at: at + 12) > 0.0 {
      let z: Float = floatAt(bytes: bytes, at: at + 8)
      count.alive = count.alive + 1
      count.meanX = count.meanX + floatAt(bytes: bytes, at: at)
      count.meanZ = count.meanZ + z
      count.lowest = Math.min(a: count.lowest, b: z)
      count.highest = Math.max(a: count.highest, b: z)
      if wordAt(bytes: bytes, at: at + 28) >= 2147483648 {
        count.landed = count.landed + 1
      }
      # the color's square root: red in byte 0, green in byte 1
      let red: Int = bytes.copyAtFallback(index: at + 24, fallback: 0) as Int
      let green: Int = bytes.copyAtFallback(index: at + 25, fallback: 0) as Int
      if red > green * 2 {
        count.reddish = count.reddish + 1
      } else {
        count.yellowish = count.yellowish + 1
      }
    }
  }
  if count.alive > 0 {
    count.meanX = count.meanX / count.alive.toFloat()
    count.meanZ = count.meanZ / count.alive.toFloat()
  }
  ret count
}

func stepFor(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  seconds: view Float
  eye: view Vec3
) {
  let steps: Int = (seconds * 30.0 + 0.5).toInt()
  loop var i: Int = 0, i < steps, ++i {
    stepLeafParticles(
      leafParticles: leafParticles
      resources: resources
      step: {
        eye: eye
        reach: 60.0
        windX: 2.0
        windY: 0.0
        wind: { x: 0.4, y: 0.0, gustiness: 0.6, time: 0.0 }
        deltaTime: 0.033333335
        groundZ: 0.0
        flatGround: true
      }
    )
    # no frame loop polls the device here: wait each step out
    drainSubmissions(inFlight: leafParticles.inFlight, resources: resources)
  }
}

func runCheck(resources: mod GpuResources) ret Int {
  var leafParticles: LeafParticles = createLeafParticles(
    capacity: checkCapacity
    constants: List.create(ShaderConstant, cap: 0)
  )
  let eye: Vec3 = Vec3.create(x: 0.0, y: -10.0, z: 2.0)
  # 9 red and 5 yellow a frame for 20 frames: under the frame cap
  # (LeafParticles leafFrameCap, 14 at 30 frames a second in this ring)
  loop var frame: Int = 0, frame < 20, ++frame {
    let unusedRed: Bool = leafEmit(
      leafParticles: leafParticles
      crown: Vec3.create(x: 0.0, y: 0.0, z: 5.0)
      radius: 1.5
      color: Vec3.create(x: 0.6, y: 0.1, z: 0.05)
      size: 0.12
      count: 9
      seed: 11 + frame
      shape: 1
      lift: false
    )
    let unusedYellow: Bool = leafEmit(
      leafParticles: leafParticles
      crown: Vec3.create(x: 4.0, y: 0.0, z: 6.0)
      radius: 1.5
      color: Vec3.create(x: 0.7, y: 0.6, z: 0.05)
      size: 0.12
      count: 5
      seed: 101 + frame
      shape: 3
      lift: false
    )
    stepFor(
      leafParticles: leafParticles
      resources: resources
      seconds: 0.033333335
      eye: eye
    )
  }
  stepFor(
    leafParticles: leafParticles
    resources: resources
    seconds: 0.33333334
    eye: eye
  )
  let early: RingCount = countRing(
    bytes: readRing(resources: resources, leafParticles: leafParticles)
  )
  log(
    "after 1 s: {early.alive} alive, {early.landed} landed, mean x {early.meanX}, mean z {early.meanZ}, {early.reddish} red, {early.yellowish} yellow"
  )
  if early.alive is not 280 or early.landed > 0 or early.reddish is not 180 or early.yellowish is not 100 {
    ret 2
  }
  # they fall (the crowns are at 5 and 6 m, centers at 1.33 m) and drift
  # downwind (the crowns' center at x 1.33)
  if early.meanZ > 5.2 or early.meanZ < 3.0 or early.meanX < 1.6 {
    ret 3
  }
  stepFor(
    leafParticles: leafParticles
    resources: resources
    seconds: 11.0
    eye: eye
  )
  let late: RingCount = countRing(
    bytes: readRing(resources: resources, leafParticles: leafParticles)
  )
  log(
    "after 12 s: {late.alive} alive, {late.landed} landed, lowest {late.lowest}, highest {late.highest}, mean x {late.meanX}"
  )
  if late.alive < 50 or late.landed * 4 < late.alive * 3 or late.lowest < 0.0 or late.highest > 5.0 {
    ret 4
  }
  stepFor(
    leafParticles: leafParticles
    resources: resources
    seconds: 13.0
    eye: eye
  )
  let gone: RingCount = countRing(
    bytes: readRing(resources: resources, leafParticles: leafParticles)
  )
  log("after 25 s: {gone.alive} alive")
  if gone.alive is not 0 {
    ret 5
  }
  # a leaf released far past the reach dies on its first step
  let unusedFar: Bool = leafEmit(
    leafParticles: leafParticles
    crown: Vec3.create(x: 500.0, y: 0.0, z: 5.0)
    radius: 1.0
    color: Vec3.create(x: 0.5, y: 0.4, z: 0.1)
    size: 0.1
    count: 50
    seed: 13
    shape: 0
    lift: false
  )
  stepFor(
    leafParticles: leafParticles
    resources: resources
    seconds: 0.1
    eye: eye
  )
  let far: RingCount = countRing(
    bytes: readRing(resources: resources, leafParticles: leafParticles)
  )
  log("past the reach: {far.alive} alive")
  if far.alive is not 0 {
    ret 6
  }
  # a ground lift: leaves from the ground thrown up into the air
  let unusedLift: Bool = leafEmit(
    leafParticles: leafParticles
    crown: Vec3.create(x: 0.0, y: 0.0, z: 0.0)
    radius: 2.0
    color: Vec3.create(x: 0.5, y: 0.3, z: 0.05)
    size: 0.12
    count: 10
    seed: 14
    shape: 2
    lift: true
  )
  stepFor(
    leafParticles: leafParticles
    resources: resources
    seconds: 0.3
    eye: eye
  )
  let lifted: RingCount = countRing(
    bytes: readRing(resources: resources, leafParticles: leafParticles)
  )
  log("lifted from the ground: {lifted.alive} alive, the lowest at {lifted.lowest} m")
  if lifted.alive is not 10 or lifted.landed > 0 or lifted.lowest < 0.3 {
    ret 7
  }
  log(
    "leaf particles: released, fell downwind, landed, lay, died, and rose from the ground on the GPU"
  )
  releaseLeafParticles(leafParticles: leafParticles, resources: resources)
  ret 0
}

# One timed frame of `leafParticles` in a gale at `clock`: the GPU
# microseconds between a mark before its compute and one after, the three in
# one submission so nothing else runs between them (-1: no sample)
func benchFrame(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  timing: mod GpuTiming
  markPipeline: view PipelineId
  clock: view Float
  speed: view Float
) ret Int {
  benchEmit(leafParticles: leafParticles, clock: clock)
  if not prepareLeafStep(
    leafParticles: leafParticles
    resources: resources
    step: benchLeafStep(clock: clock, speed: speed)
  ) {
    ret -1
  }
  beginTimingFrame(timing: timing)
  if var recording: Recording = beginRecording(resources: resources) {
    let markedBefore: Bool = recordTimingMark(
      timing: timing
      recording: recording
      resources: resources
      pipeline: markPipeline
      name: "leaves"
    )
    let computed: Bool = recordLeafCompute(
      leafParticles: leafParticles
      resources: resources
      recording: recording
    )
    let markedAfter: Bool = recordTimingMark(
      timing: timing
      recording: recording
      resources: resources
      pipeline: markPipeline
      name: "end"
    )
    let resolved: Bool = recordTimingResolve(
      timing: timing
      recording: recording
      resources: resources
    )
    if not (markedBefore and computed and markedAfter and resolved) {
      ret -1
    }
    if let submission: SubmissionId = submit(resources: resources, recording: recording) {
      let unusedWaited: Bool = waitSubmission(resources: resources, id: submission)
      retireSubmission(resources: resources, id: submission)
    }
  }
  if not startTimingSample(timing: timing, resources: resources) {
    ret -1
  }
  var spans: List(Int) = List.create(Int, cap: 2)
  loop var attempt: Int = 0, attempt < 1000000, ++attempt {
    if collectTimingMarks(timing: timing, resources: resources, out: spans) {
      ret spans.copyAtFallback(index: 0, fallback: -1)
    }
  }
  ret -1
}

# 40 crowns round the eye let leaves go (as many as the budget allows)
func benchEmit(leafParticles: mod LeafParticles, clock: view Float) {
  loop var crown: Int = 0, crown < 40, ++crown {
    let unusedEmitted: Bool = leafEmit(
      leafParticles: leafParticles
      crown: Vec3.create(
        x: (crown % 8).toFloat() * 8.0 - 28.0
        y: (crown / 8).toFloat() * 10.0 - 20.0
        z: 7.0
      )
      radius: 2.5
      color: Vec3.create(x: 0.6, y: 0.4, z: 0.05)
      size: 0.16
      count: 60
      seed: crown * 977 + (clock * 30.0).toInt()
      shape: crown % 4
      lift: false
    )
  }
}

# A frame at `clock` in a wind of `speed` m/s (17: a gale with storm gusts), a still eye
func benchLeafStep(clock: view Float, speed: view Float) ret LeafStep {
  ret LeafStep {
    eye: Vec3.create(x: 0.0, y: -20.0, z: 2.0)
    reach: 110.0
    windX: speed
    windY: 0.0
    wind: {
      x: speed / 5.0
      y: 0.0
      gustiness: 0.95
      time: clock
      driftX: clock * speed
      driftY: 0.0
    }
    deltaTime: 0.033333335
    groundZ: 0.0
    flatGround: true
  }
}

# A gale's frame, untimed
func benchStep(
  leafParticles: mod LeafParticles
  resources: mod GpuResources
  clock: view Float
  speed: view Float
) {
  benchEmit(leafParticles: leafParticles, clock: clock)
  stepLeafParticles(
    leafParticles: leafParticles
    resources: resources
    step: benchLeafStep(clock: clock, speed: speed)
  )
  drainSubmissions(inFlight: leafParticles.inFlight, resources: resources)
}

# The compute's GPU time for a ring of `capacity` in a wind of `speed`, filled first
func benchCapacity(resources: mod GpuResources, capacity: view Int, speed: view Float) ret Bool {
  var leafParticles: LeafParticles = createLeafParticles(
    capacity: capacity
    constants: List.create(ShaderConstant, cap: 0)
  )
  var clock: Float = 0.0
  loop var frame: Int = 0, frame < 360, ++frame {
    clock = clock + 0.033333335
    benchStep(
      leafParticles: leafParticles
      resources: resources
      clock: clock
      speed: speed
    )
  }
  var alive: Int = 0
  let ring: List(UInt8) = readRingOf(
    resources: resources
    leafParticles: leafParticles
    capacity: capacity
  )
  loop var i: Int = 0, i < capacity, ++i {
    if floatAt(bytes: ring, at: i * leafRecordBytes + 12) > 0.0 {
      alive = alive + 1
    }
  }
  var timing: GpuTiming = createGpuTiming(resources: resources, maxPasses: 4)
  if not timingAvailable(timing: timing) {
    log("[leaf bench] GPU timestamps unavailable")
    ret false
  }
  if let markPipeline: PipelineId = createComputePipelineSource(
    resources: resources
    wgsl: "@compute @workgroup_size(1) fn mark() \{\}"
    entryPoint: "mark"
    constants: noShaderConstants()
  ) {
    var total: Int = 0
    var samples: Int = 0
    var lowest: Int = 1000000
    loop var sample: Int = 0, sample < 30, ++sample {
      clock = clock + 0.033333335
      let microseconds: Int = benchFrame(
        leafParticles: leafParticles
        resources: resources
        timing: timing
        markPipeline: markPipeline
        clock: clock
        speed: speed
      )
      if microseconds >= 0 {
        total = total + microseconds
        samples = samples + 1
        lowest = Math.min(a: lowest, b: microseconds)
      }
    }
    if samples > 0 {
      log(
        "[leaf bench] {capacity} leaves ({alive} alive in {speed} m/s): compute {total / samples} us a frame on average, {lowest} us at least ({samples} samples)"
      )
    }
  }
  shutdownTiming(timing: timing, resources: resources)
  releaseLeafParticles(leafParticles: leafParticles, resources: resources)
  ret true
}

func main() ret Int {
  unsafe {
    # the timestamp-query feature, for RAE_LEAF_BENCH (gpu/DeviceFeatures)
    chooseDeviceFeatures()
    if webgpuBootstrap() is not 1 {
      ret 1
    }
  }
  var issuer: IdIssuer = IdIssuer.create()
  if var resources: GpuResources = GpuResources.create(issuer: issuer, capacity: 64) {
    if Sys.getEnv(name: "RAE_LEAF_BENCH") is "1" {
      let unusedGale: Bool = benchCapacity(resources: resources, capacity: 16384, speed: 17.0)
      let unusedBreeze: Bool = benchCapacity(resources: resources, capacity: 16384, speed: 2.0)
      let unusedSmall: Bool = benchCapacity(resources: resources, capacity: 4096, speed: 17.0)
      ret 0
    }
    ret runCheck(resources: resources)
  }
  ret 1
}
