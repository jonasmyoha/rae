pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../.."
      subdir: "packages/audio"
      version: "0.15.2"
      hash: "git-tree:f348e3368fc95b65d63ef27effe90d6d119fbcbb"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
