{
 "type": "Scene",
 "version": 2,
 "root": "Screen",
 "nodes": {
  "Screen": {
   "Rect": { "x": 0, "y": 0, "w": 800, "h": 600 },
   "Children": [ "Frame" ]
  },
  "Frame": {
   "Rect": { "x": 100, "y": 60, "w": 600, "h": 480 },
   "Overflow": { "mode": "Clip" },
   "Children": [ "List" ]
  },
  "List": {
   "Rect": { "x": 0, "y": 0, "w": 600, "h": 480 },
   "bundles": [ "staggerFromStart" ],
   "ListView": {
    "itemSceneId": "ListCheckRow",
    "itemKeyField": "id",
    "itemHeight": 80,
    "itemGap": 12,
    "visibleItemCount": 5,
    "overscanRows": 1,
    "animateMoves": true,
    "bindings": [
     { "nodeId": "Label", "component": "Text", "field": "text", "itemField": "id" }
    ]
   }
  }
 }
}
