pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep storeKit: {
      git: "../.."
      subdir: "packages/storeKit"
      version: "0.1.0"
      hash: "git-tree:fd51d0be60e6b2dd59021ca5f353e577de2e3a38"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
