# The Timeline chart, painted (ui/ChartComponents, ui/timelineSystem,
# ui/renderSystem/RenderTimeline,
# docs/perf-tools-design.md §6): a frame with nested parts on "main", a worker's tasks, a lane of
# 200 000 tiny spans drawn a pixel column at a time, marks, and one span selected:
#
#   RAE_HEADLESS_FRAMES=10 RAE_GPU2D_SCREENSHOT=/tmp/timeline.bmp \
#     compiler/bin/rae run checks/uiTimeline/Main.rae
#
# The rules are checked exactly in compiler/tests/cases/1472_ui_timeline. Exit 0 when it drew.
import Gpu2d
import ui/Scene
open app3d/UiShell
open ecs/ComponentTable
open ecs/Entity
open ecs/Schedule
open ui/ChartComponents
open ui/Ecs
open ui/Pipeline
open ui/renderSystem/RenderSystem
open ui/SceneFile
open ui/SceneLoader
open ui/UiSystems
open ui/inputSystem/InputSystem
open ui/flameGraphSystem/FlameGraphSystem
open ui/histogramSystem/HistogramSystem
open Gpu2dCanvas

const designW: Int = 800

const designH: Int = 600

func fillTree(state: mod FlameGraphState) {
  flameAddSample(
    state: state
    path: List(String) { "frame", "update", "physics", "solve" }
    value: 22
  )
  flameAddSample(
    state: state
    path: List(String) { "frame", "update", "physics", "broadphase" }
    value: 8
  )
  flameAddSample(state: state, path: List(String) { "frame", "update", "ai" }, value: 10)
  flameAddSample(state: state, path: List(String) { "frame", "render", "shadows" }, value: 12)
  flameAddSample(state: state, path: List(String) { "frame", "render", "gbuffer" }, value: 25)
  flameAddSample(state: state, path: List(String) { "frame", "render", "lighting" }, value: 13)
  flameAddSample(state: state, path: List(String) { "idle" }, value: 10)
  state.selected = 3
}

func fillSpread(state: mod HistogramState) {
  var edges: List(Float) = {}
  var counts: List(Int) = {}
  loop var i: Int = 0, i <= 20, ++i {
    edges.add(value: (i as Float) * 1.0)
  }
  let shape: List(Int) = List(Int) {
    0
    0
    0
    0
    0
    0
    12
    80
    260
    320
    180
    90
    40
    20
    10
    6
    4
    2
    1
    1
  }
  loop let count: Int in shape {
    counts.add(value: count)
  }
  let unusedSet: Bool = histogramSetBuckets(state: state, edges: edges, counts: counts)
  state.selected = 9
}

func main() ret Int {
  Gpu2d.initWindow(width: designW, height: designH, title: "UI flame graph and histogram check")
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  let gpuUi: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: "MaterialIconsRound-Regular"
    themeFile: "Theme.raescene"
  )
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  seedWorldTheme(world: world, res: gpuUi)
  Gpu2d.setDesignResolution(width: designW.toFloat(), height: designH.toFloat(), fit: 0)
  world.layoutW = designW.toFloat()
  world.layoutH = designH.toFloat()
  let scene: Scene = loadSceneFile(path: "checks/uiFlameHistogram/charts.raescene")
  if scene.ok is false {
    log("UI CHARTS FAILED: {scene.errorMsg}")
    Gpu2d.closeWindow()
    ret 1
  }
  loadScene(world: world, uiSystems: uiSystems, scene: scene)
  var schedule: Schedule = createUiPipeline(world: world)
  var input: UiInput = createUiInput()
  runScheduledUiSystems(
    schedule: schedule
    world: world
    uiSystems: uiSystems
    res: gpuUi
  )
  let unusedFlame: Bool = flameGraphSystem(world: world, uiSystems: uiSystems, input: input)
  let unusedSpread: Bool = histogramSystem(world: world, uiSystems: uiSystems, input: input)
  var filled: Int = 0
  if let raw: Int = world.nodeIds.get(k: "Flame") {
    let flame: EntityId = id(v: raw)
    if componentHas(this: world.flameGraphStates, entityId: flame) {
      fillTree(state: componentMod(this: world.flameGraphStates, entityId: flame))
      filled = filled + 1
    }
  }
  if let raw: Int = world.nodeIds.get(k: "Spread") {
    let spread: EntityId = id(v: raw)
    if componentHas(this: world.histogramStates, entityId: spread) {
      fillSpread(state: componentMod(this: world.histogramStates, entityId: spread))
      filled = filled + 1
    }
  }
  var frames: Int = 0
  loop not Gpu2d.pollClose() and frames < 600 {
    runScheduledUiSystems(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      res: gpuUi
    )
    Gpu2d.beginFrame(
      canvas: canvas
      r: 0.03
      g: 0.05
      b: 0.08
      a: 1.0
    )
    renderSystemGpu2d(
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    )
    Gpu2d.endFrame(canvas: canvas)
    frames = frames + 1
  }
  canvasShutdown(canvas: canvas)
  Gpu2d.closeWindow()
  if filled is not 2 {
    log("UI CHARTS FAILED: {filled} of 2 charts have their state")
    ret 1
  }
  log("UI CHARTS OK: {frames} frames")
  ret 0
}
