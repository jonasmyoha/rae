# Hardware check for gpu/GpuTiming (#871), the one GPU timing module:
# nonblocking per-pass GPU timing over the manager. Records two timed compute
# passes per frame (the first unnamed, "pass0", the second named "heavy"),
# resolves, submits, and reads the timestamps back through a manager-owned
# ReadbackId WITHOUT blocking — repeated across several frames (continuous
# timing). Each sample goes into a profiler capture (publishTimingCounters):
# counters gpu.pass0, gpu.heavy and gpu.total, and the passes as spans on the
# GPU's lane, put on the CPU's clock by perf/GpuClock; every span must fall
# inside its own frame (from before the frame's work was recorded to after its
# timestamps were read). Exit code 0 = every check passed. The unavailable-timestamps fallback is
# exercised by the code path even where hardware has timestamps.
import Sdl3
import Profile
open perf/Perf
open webgpu/Context
open webgpu/WebgpuEnums
open gpu/GpuResources
open gpu/GpuLifetime
open gpu/GpuReadback
open gpu/GpuTiming
open gpu/DeviceFeatures

# A GPU wait: tries, each a blocking device poll, not a spin count (see
# checks/readRequest)
const checkWaitTries: Int = 1000

func checkWaitForGpu() {
  unsafe {
    webgpuPoll(wait: 1)
  }
}

# The GPU spans in the capture that fall inside one of the frames' CPU windows (start, end pairs)
func spansInsideFrames(profiler: view Profiler, windows: view List(Int)) ret Int {
  var inside: Int = 0
  let hub: view PerfHub = profiler.hub
  loop var number: Int = hub.perfOldest(), number < hub.perfWritten(), ++number {
    let event: PerfEvent = hub.perfEventAt(number: number)
    if event.kind is PerfKind.gpuSpan {
      loop var w: Int = 0, w * 2 + 1 < windows.length, ++w {
        let start: Int = windows.copyAtDefault(index: w * 2)
        let end: Int = windows.copyAtDefault(index: w * 2 + 1)
        if event.time >= start and event.value <= end {
          inside = inside + 1
        }
      }
    }
  }
  ret inside
}

func countSpans(profiler: view Profiler) ret Int {
  var spans: Int = 0
  let hub: view PerfHub = profiler.hub
  loop var number: Int = hub.perfOldest(), number < hub.perfWritten(), ++number {
    if hub.perfEventAt(number: number).kind is PerfKind.gpuSpan {
      spans = spans + 1
    }
  }
  ret spans
}

func fail(message: view String) ret Bool {
  log("FAIL: {message}")
  ret false
}

func kernelSource() ret String {
  ret "@group(0) @binding(0) var<storage, read_write> data: array<u32>; @compute @workgroup_size(64) fn main(@builtin(global_invocation_id) id: vec3<u32>) \{ var acc: u32 = 0u; for (var k: u32 = 0u; k < 256u; k = k + 1u) \{ acc = acc + id.x + k; \} data[id.x] = acc; \}"
}

func awaitSubmission(resources: mod GpuResources, id: view SubmissionId) ret Int {
  var status: Int = 0
  var tries: Int = 0
  loop status is 0 and tries < checkWaitTries {
    status = pollSubmission(resources: resources, id: id)
    if status is 0 {
      checkWaitForGpu()
    }
    tries = tries + 1
  }
  ret status
}

func runFrame(
  resources: mod GpuResources
  timing: mod GpuTiming
  pipeline: view PipelineId
  bindGroup: view BindGroupId
) ret Bool {
  unsafe {
    beginTimingFrame(timing: timing)
    if let passA: Int = timedPass(timing: timing) {
      if passA is not 0 {
        ret fail(message: "timedPass 0")
      }
    } else {
      ret fail(message: "timedPass 0")
    }
    if var recording: Recording = beginRecording(resources: resources) {
      if recordComputeTimed(
        recording: recording
        resources: resources
        pipeline: pipeline
        bindGroup: bindGroup
        workgroupsX: 4
        workgroupsY: 1
        workgroupsZ: 1
        timestampWrites: timingWrites(timing: timing)
      ) is false {
        ret fail(message: "timed pass A")
      }
      if let passB: Int = timedPassNamed(timing: timing, name: "heavy") {
        if passB is not 1 {
          ret fail(message: "timedPass 1")
        }
      } else {
        ret fail(message: "timedPass 1")
      }
      if recordComputeTimed(
        recording: recording
        resources: resources
        pipeline: pipeline
        bindGroup: bindGroup
        workgroupsX: 4
        workgroupsY: 1
        workgroupsZ: 1
        timestampWrites: timingWrites(timing: timing)
      ) is false {
        ret fail(message: "timed pass B")
      }
      if recordTimingResolve(timing: timing, recording: recording, resources: resources) is false {
        ret fail(message: "resolve")
      }
      if let submission: SubmissionId = submit(resources: resources, recording: recording) {
        if awaitSubmission(resources: resources, id: submission) is not 1 {
          ret fail(message: "submission")
        }
        if retireSubmission(resources: resources, id: submission) is false {
          ret fail(message: "retire submission")
        }
        # Nonblocking timing readback: start after the submission completed.
        if startTimingSample(timing: timing, resources: resources) is false {
          ret fail(message: "start sample")
        }
        if timingSampleInFlight(timing: timing) is false {
          ret fail(message: "sample not in flight")
        }
        var perPass: List(Int) = List.create(Int, cap: 2)
        var done: Bool = false
        var tries: Int = 0
        loop done is false and tries < checkWaitTries {
          done = collectTiming(timing: timing, resources: resources, out: perPass)
          if done is false {
            checkWaitForGpu()
          }
          tries = tries + 1
        }
        if done is false {
          ret fail(message: "collect never completed")
        }
        if perPass.length is not 2 {
          ret fail(message: "expected 2 pass timings, got {perPass.length}")
        }
        var i: Int = 0
        loop i < 2 {
          if let microseconds: Int = perPass.copyAt(index: i) {
            if microseconds < 0 {
              ret fail(message: "negative pass time")
            }
          }
          i = i + 1
        }
        if lastTotalUs(timing: timing) < 0 {
          ret fail(message: "total unavailable after collect")
        }
        if timingSampleInFlight(timing: timing) {
          ret fail(message: "sample still in flight after collect")
        }
        ret true
      }
      ret fail(message: "submit")
    }
    ret fail(message: "recording")
  }
}

func main() ret Int {
  unsafe {
    # The device gets the timestamp-query feature only when it is requested
    # before it exists (gpu/DeviceFeatures, as Gpu2d.initWindow does)
    chooseDeviceFeatures()
    if webgpuBootstrap() is not 1 {
      log("no GPU")
      ret 1
    }
    var issuer: IdIssuer = IdIssuer.create()
    if var resources: GpuResources = GpuResources.create(issuer: issuer, capacity: 10) {
      var timing: GpuTiming = createGpuTiming(resources: resources, maxPasses: 4)
      if timingAvailable(timing: timing) is false {
        # Documented fallback: no timestamp support. Everything is inert.
        log("timestamps unavailable — fallback path (lastTotalUs = {lastTotalUs(timing: timing)})")
        shutdownTiming(timing: timing, resources: resources)
        ret 0
      }
      if let storage: BufferId = createBuffer(
        resources: resources
        size: 1024
        usage: WGPUBufferUsage_Storage + WGPUBufferUsage_CopySrc
      ) {
        if let pipeline: PipelineId = createComputePipelineSource(
          resources: resources
          wgsl: kernelSource()
          entryPoint: "main"
          constants: noShaderConstants()
        ) {
          var buffers: List(BufferId) = List.create(BufferId, cap: 1)
          buffers.add(value: storage)
          let noViews: List(TextureViewId) = List.create(TextureViewId, cap: 1)
          let noSamplers: List(SamplerId) = List.create(SamplerId, cap: 1)
          if let bindGroup: BindGroupId = createBindGroup(
            resources: resources
            pipeline: pipeline
            buffers: buffers
            textureViews: noViews
            samplers: noSamplers
          ) {
            # Each sample into a capture: a counter per named pass and the total, and the
            # passes as spans on the GPU's lane
            var profiler: Profiler = Profile.createProfiler()
            Profile.startCapture(
              profiler: profiler
              seconds: 3600.0
              outPath: "/tmp/rae_gpu_timing_check.json"
            )
            var frame: Int = 0
            var totalAcrossFrames: Int = 0
            var windows: List(Int) = {}
            loop frame < 5 {
              let frameStart: Int = nowNs()
              if runFrame(
                resources: resources
                timing: timing
                pipeline: pipeline
                bindGroup: bindGroup
              ) is false {
                ret 1
              }
              windows.add(value: frameStart)
              windows.add(value: nowNs())
              publishTimingCounters(timing: timing, profiler: profiler)
              totalAcrossFrames = totalAcrossFrames + lastTotalUs(timing: timing)
              frame = frame + 1
            }
            log("5 frames of nonblocking 2-pass timing OK (summed total {totalAcrossFrames} us)")
            let unusedWritten: Bool = Profile.tick(profiler: profiler)
            var countersSeen: String = ""
            let names: List(String) = Profile.capturedNames(profiler: profiler)
            loop var i: Int = 0, i < 3, ++i {
              countersSeen = "{countersSeen} {names.copyAtDefault(index: i)}"
            }
            let spans: Int = countSpans(profiler: profiler)
            let inside: Int = spansInsideFrames(profiler: profiler, windows: windows)
            let offsetUs: Int = profiler.gpuClock.offsetNs / 1000
            Profile.profileDiscard(profiler: profiler)
            if countersSeen is not " gpu.pass0 gpu.heavy gpu.total" {
              log("FAIL: profiler counters were{countersSeen}")
              ret 1
            }
            log("profiler counters:{countersSeen}")
            if spans is not 10 or inside is not spans {
              log("FAIL: {spans} GPU spans (10 expected), {inside} inside their frame")
              ret 1
            }
            log("GPU spans: {spans}, each inside its frame (the GPU clock's offset {offsetUs} us)")
            shutdownTiming(timing: timing, resources: resources)
            if liveReadbackCount(resources: resources) is not 0 {
              log("FAIL: readback leaked")
              ret 1
            }
            retireBindGroup(resources: resources, id: bindGroup)
            retirePipeline(resources: resources, id: pipeline)
            retireBuffer(resources: resources, id: storage)
            log("shutdown and cleanup OK")
            ret 0
          }
        }
      }
      log("FAIL: setup")
      ret 1
    }
    log("FAIL: manager creation")
    ret 1
  }
}
