pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../.."
      subdir: "packages/audio"
      version: "0.12.1"
      hash: "git-tree:e548add5d2415d3dfa02956090e971f0f5e7bf32"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
