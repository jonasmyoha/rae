# A sprite masked by another texture on the GPU (Sprite.maskKey; case 1701 has the queued draws):
# a solid red square drawn three times, masked by a circle's alpha (a circle on a transparent
# image), by a circle's luminance (a white circle on opaque black, maskLuminance) and unmasked. The
# frame is written as a BMP (RAE_GPU2D_SCREENSHOT; a file in the temp folder when it is not set)
# and read back: each masked square is red at its middle and black (the background) in its corners,
# outside the circle; the unmasked one is red in its corners too. Exit 0 when all of that holds.
#
#   compiler/bin/rae run checks/uiTextureMask/Main.rae
import Gpu2d
import Math
import Sys
open app3d/UiShell
open ecs/Entity
open ecs/Schedule
open ui/Ecs
open ui/Pipeline
open ui/RenderSystem
open ui/SceneFile
open ui/SceneLoader
open ui/UiSystems
open Gpu2dCanvas
open Gpu2dCanvasImage

const designW: Int = 800

const designH: Int = 600

func readLe(bytes: view List(Int), at: view Int, count: view Int) ret Int {
  var value: Int = 0
  loop var i: Int = count - 1, i >= 0, --i {
    value = value * 256 + bytes.copyAtFallback(index: at + i, fallback: 0)
  }
  ret value
}

type Pixel {
  r: Int
  g: Int
  b: Int
}

# The pixel at a design-unit point of the 32-bit BMP (blue, green, red, alpha; rows bottom-up)
func pixelAt(bytes: view List(Int), x: view Float, y: view Float) ret Pixel {
  let offset: Int = readLe(bytes: bytes, at: 10, count: 4)
  let width: Int = readLe(bytes: bytes, at: 18, count: 4)
  let height: Int = readLe(bytes: bytes, at: 22, count: 4)
  let px: Int = (x * width.toFloat() / designW.toFloat()).toInt()
  let py: Int = (y * height.toFloat() / designH.toFloat()).toInt()
  let at: Int = offset + ((height - 1 - py) * width + px) * 4
  ret Pixel {
    r: bytes.copyAtFallback(index: at + 2, fallback: 0)
    g: bytes.copyAtFallback(index: at + 1, fallback: 0)
    b: bytes.copyAtFallback(index: at, fallback: 0)
  }
}

func isRed(pixel: view Pixel) ret Bool {
  ret pixel.r > 200 and pixel.g < 40 and pixel.b < 40
}

func isBlack(pixel: view Pixel) ret Bool {
  ret pixel.r < 30 and pixel.g < 30 and pixel.b < 30
}

# A 64 x 64 image: inside the circle `inside`, outside it `outside` (0xAABBGGRR, as
# registerImageRgba)
func circleImage(inside: view Int, outside: view Int) ret List(Int) {
  var pixels: List(Int) = List.create(Int, cap: 64 * 64)
  loop var y: Int = 0, y < 64, ++y {
    loop var x: Int = 0, x < 64, ++x {
      let dx: Float = x.toFloat() + 0.5 - 32.0
      let dy: Float = y.toFloat() + 0.5 - 32.0
      if dx * dx + dy * dy <= 30.0 * 30.0 {
        pixels.add(value: inside)
      } else {
        pixels.add(value: outside)
      }
    }
  }
  ret pixels
}

func main() ret Int {
  var shot: String = Sys.getEnv(name: "RAE_GPU2D_SCREENSHOT")
  if shot.length() is 0 {
    var folder: String = Sys.getEnv(name: "TMPDIR")
    if folder.length() is 0 {
      folder = "/tmp"
    }
    shot = "{folder}/rae-uiTextureMask.bmp"
    let unusedShotSet: Bool = Sys.setEnv(name: "RAE_GPU2D_SCREENSHOT", value: shot)
  }
  if Sys.getEnv(name: "RAE_HEADLESS_FRAMES").length() is 0 {
    let unusedFramesSet: Bool = Sys.setEnv(name: "RAE_HEADLESS_FRAMES", value: "5")
  }
  Gpu2d.initWindow(width: designW, height: designH, title: "UI texture mask check")
  var canvas: Gpu2dCanvas = createGpu2dCanvas()
  let gpuUi: Gpu2dUi = loadUiAssets(
    dir: "examples/104_ui_hello/assets/"
    textFontName: "Roboto-Regular"
    iconFontName: "MaterialIconsRound-Regular"
    themeFile: "Theme.raescene"
  )
  # the art: a solid red square; the masks: a circle by its alpha, and a white circle on black
  var red: List(Int) = List.create(Int, cap: 16 * 16)
  loop var i: Int = 0, i < 16 * 16, ++i {
    red.add(value: 255 + 255 * 16777216)
  }
  let square: Int = Gpu2d.registerImageRgba(
    canvas: canvas
    key: "square"
    pixels: red.data
    w: 16
    h: 16
  )
  let alphaPixels: List(Int) = circleImage(inside: 0xFFFFFFFF, outside: 0x00000000)
  let circleAlpha: Int = Gpu2d.registerImageRgba(
    canvas: canvas
    key: "circleAlpha"
    pixels: alphaPixels.data
    w: 64
    h: 64
  )
  let whitePixels: List(Int) = circleImage(inside: 0xFFFFFFFF, outside: 0xFF000000)
  let circleWhite: Int = Gpu2d.registerImageRgba(
    canvas: canvas
    key: "circleWhite"
    pixels: whitePixels.data
    w: 64
    h: 64
  )
  let handle: Int = Math.min(a: square, b: Math.min(a: circleAlpha, b: circleWhite))
  var world: UiWorld = create()
  var uiSystems: UiSystems = createUiSystems()
  seedWorldTheme(world: world, res: gpuUi)
  Gpu2d.setDesignResolution(width: designW.toFloat(), height: designH.toFloat(), fit: 0)
  world.layoutW = designW.toFloat()
  world.layoutH = designH.toFloat()
  let scene: Scene = loadSceneFile(path: "checks/uiTextureMask/page.raescene")
  if scene.ok is false or handle <= 0 {
    log("UI TEXTURE MASK FAILED: the scene ({scene.errorMsg}) or the image did not load")
    Gpu2d.closeWindow()
    ret 1
  }
  let root: EntityId = loadScene(world: world, uiSystems: uiSystems, scene: scene)
  var schedule: Schedule = createUiPipeline(world: world)
  var frames: Int = 0
  loop not Gpu2d.pollClose() and frames < 600 {
    runScheduledUiSystems(
      schedule: schedule
      world: world
      uiSystems: uiSystems
      res: gpuUi
    )
    Gpu2d.beginFrame(
      canvas: canvas
      r: 0.0
      g: 0.0
      b: 0.0
      a: 1.0
    )
    renderSystemGpu2d(
      world: world
      uiSystems: uiSystems
      res: gpuUi
      canvas: canvas
    )
    Gpu2d.endFrame(canvas: canvas)
    frames = frames + 1
  }
  canvasShutdown(canvas: canvas)
  Gpu2d.closeWindow()
  let bytes: List(Int) = Sys.readFileBytes(path: shot)
  if bytes.length < 54 {
    log("UI TEXTURE MASK FAILED: no picture at {shot} (root {isNone(this: root)})")
    ret 1
  }
  var ok: Bool = true
  loop let left: Float in List(Float) { 40.0, 300.0, 560.0 } {
    let middle: Pixel = pixelAt(bytes: bytes, x: left + 100.0, y: 300.0)
    let corner: Pixel = pixelAt(bytes: bytes, x: left + 12.0, y: 212.0)
    let edge: Pixel = pixelAt(bytes: bytes, x: left + 12.0, y: 300.0)
    log(
      "square at {left}: middle {middle.r} {middle.g} {middle.b}, corner {corner.r} {corner.g} {corner.b}, inside the circle near its edge {edge.r} {edge.g} {edge.b}"
    )
    if left < 500.0 {
      ok = ok and isRed(pixel: middle) and isRed(pixel: edge) and isBlack(pixel: corner)
    } else {
      ok = ok and isRed(pixel: middle) and isRed(pixel: corner)
    }
  }
  if not ok {
    log("UI TEXTURE MASK FAILED: a masked square is not the circle, or the plain one is not square")
    ret 1
  }
  log("UI TEXTURE MASK OK")
  ret 0
}
