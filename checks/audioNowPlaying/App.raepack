pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../.."
      subdir: "packages/audio"
      version: "0.12.19"
      hash: "git-tree:a03949e8cbe1818f6a2e8f780d0c1cdf12d771f1"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
