pack App {
  format: "raepack"
  version: 1
  defaultTarget: compiled
  dependencies: {
    dep audio: {
      git: "../.."
      subdir: "packages/audio"
      version: "0.13.0"
      hash: "git-tree:c4337f6cab2c34ce86c0fc0e2bba97015a7ed657"
    }
  }
  targets: {
    target compiled: {
      label: "Compiled"
      entry: "Main.rae"
      sources: {
        source: {
          path: "."
          emit: compiled
        }
      }
    }
  }
}
