# audio/Sound — a sound held in memory, and WAV files (docs/audio-design.md §7.1,
# §7.3). WAV is decoded in Rae: its spec is small, and it is the reference the
# tests compare against.
#
#     let data: SoundData = readSoundFile(path: "assets/alarm.wav")   # any thread
#     if data.error.length() > 0 { ... }
#     let sound: Sound = audio.addSound(data: own data)               # audio/Audio
#
# SoundData's samples are interleaved Float (frame 0's channels, then frame 1's
# ...), at the file's own sample rate, in a Buffer the program frees: through
# the engine (`audio.freeSound`) once it was added, or with `freeSoundData`
# when it never was. Reading allocates and touches the disk, so it never runs on
# the audio thread; `spawn readSoundFile(path: path)` loads it on a worker.
import Math
open audio/AudioGlue

type SoundData {
  samples: Buffer(Float)
  frameCount: Int
  channels: Int
  sampleRate: Int
  # "" when the data is good, else what was wrong
  error: String
}

func emptySoundData(error: view String) ret SoundData {
  ret SoundData {
    samples: createSampleBuffer(count: 1)
    frameCount: 0
    channels: 1
    sampleRate: 48000
    error: "{error}"
  }
}

# A zeroed sample buffer of `count` samples (at least one)
func createSampleBuffer(count: view Int) ret Buffer(Float) {
  var size: Int = count
  if size < 1 {
    size = 1
  }
  unsafe {
    let samples: Buffer(Float) = rae_ext_rae_buf_alloc(size: size, elemSize: sizeof(Float))
    rae_ext_rae_buf_zero(
      buf: samples
      start: 0
      count: size
      elemSize: sizeof(Float)
    )
    ret samples
  }
}

func sampleAt(samples: view Buffer(Float), index: view Int) ret Float {
  unsafe {
    ret rae_ext_rae_buf_get(buf: samples, index: index)
  }
}

func setSampleAt(samples: view Buffer(Float), index: view Int, value: view Float) {
  unsafe {
    var target: Buffer(Float) = samples
    rae_ext_rae_buf_set(buf: target, index: index, value: value)
  }
}

# Free a SoundData that was never added to an engine
func freeSoundData(data: view SoundData) {
  unsafe {
    rae_ext_rae_buf_free(buf: data.samples)
  }
}

# A sound made in code: `frameCount` frames of a sine at `frequency` Hz,
# `amplitude` peak, `channels` identical channels.
func sineSoundData(
  frequency: view Float
  amplitude: view Float
  frameCount: view Int
  channels: view Int
  sampleRate: view Int
) ret SoundData {
  let samples: Buffer(Float) = createSampleBuffer(count: frameCount * channels)
  let step: Float = 6.2831855 * frequency / (sampleRate as Float)
  loop var frame: Int = 0, frame < frameCount, ++frame {
    let value: Float = amplitude * sin(x: step * (frame as Float))
    loop var channel: Int = 0, channel < channels, ++channel {
      setSampleAt(samples: samples, index: frame * channels + channel, value: value)
    }
  }
  ret SoundData {
    samples: samples
    frameCount: frameCount
    channels: channels
    sampleRate: sampleRate
    error: ""
  }
}

# A WAV file decoded in Rae; audio/Decoder.readAnySoundFile adds MP3, FLAC
# and Ogg Vorbis
func readSoundFile(path: copy String) ret SoundData {
  let bytes: List(UInt8) = readAudioFileBytes(path: path)
  if bytes.length() is 0 {
    ret emptySoundData(error: "cannot read {path}")
  }
  ret decodeWav(bytes: bytes)
}

# The bytes of `path` and a 0, as C reads a path
func pathBytesZ(path: view String) ret List(UInt8) {
  var pathZ: List(UInt8) = List.create(UInt8, cap: path.length() + 1)
  addText(bytes: pathZ, text: path)
  pathZ.add(value: 0)
  ret pathZ
}

# A file's bytes, or none when it cannot be read. Through the package's own C
# rather than Sys.readFileBytes: one byte per UInt8 instead of one per Int.
func readAudioFileBytes(path: view String) ret List(UInt8) {
  var pathZ: List(UInt8) = pathBytesZ(path: path)
  var bytes: List(UInt8) = {}
  unsafe {
    let size: Int = rae_audio_file_size(pathZ: pathZ.data)
    if size <= 0 {
      ret bytes
    }
    bytes.addDefaults(count: size)
    let got: Int = rae_audio_read_file(pathZ: pathZ.data, into: bytes.data, count: size)
    if got is not size {
      bytes.clear()
    }
  }
  ret bytes
}

func byteAt(bytes: view List(UInt8), at: view Int) ret Int {
  ret bytes.copyAtFallback(index: at, fallback: 0) as Int
}

func uint16At(bytes: view List(UInt8), at: view Int) ret Int {
  ret byteAt(bytes: bytes, at: at) bitor (byteAt(bytes: bytes, at: at + 1) shl 8)
}

func uint32At(bytes: view List(UInt8), at: view Int) ret Int {
  ret uint16At(bytes: bytes, at: at) bitor (uint16At(bytes: bytes, at: at + 2) shl 16)
}

func textAt(bytes: view List(UInt8), at: view Int, expected: view String) ret Bool {
  loop var i: Int = 0, i < expected.length(), ++i {
    if byteAt(bytes: bytes, at: at + i) is not expected.byteAt(index: i) {
      ret false
    }
  }
  ret true
}

# One sample of `bits` bits at `at`, as a Float in [-1, 1). `isFloat` for
# 32-bit IEEE samples.
func wavSampleAt(
  bytes: view List(UInt8)
  at: view Int
  bits: view Int
  isFloat: view Bool
) ret Float {
  if isFloat {
    ret floatFromBits(bits: uint32At(bytes: bytes, at: at))
  }
  if bits is 8 {
    ret ((byteAt(bytes: bytes, at: at) - 128) as Float) / 128.0
  }
  if bits is 16 {
    var value: Int = uint16At(bytes: bytes, at: at)
    if value >= 32768 {
      value = value - 65536
    }
    ret (value as Float) / 32768.0
  }
  if bits is 24 {
    var value: Int = uint16At(bytes: bytes, at: at) bitor (byteAt(bytes: bytes, at: at + 2) shl 16)
    if value >= 8388608 {
      value = value - 16777216
    }
    ret (value as Float) / 8388608.0
  }
  var value: Int = uint32At(bytes: bytes, at: at)
  if value >= 2147483648 {
    value = value - 4294967296
  }
  ret ((value as Float64) / 2147483648.0) as Float
}

# A RIFF/WAVE file: PCM 8, 16, 24 or 32 bits, or 32-bit float (format 1, 3, or
# 0xFFFE naming either).
func decodeWav(bytes: view List(UInt8)) ret SoundData {
  if not textAt(bytes: bytes, at: 0, expected: "RIFF") or not textAt(
    bytes: bytes
    at: 8
    expected: "WAVE"
  ) {
    ret emptySoundData(error: "not a WAV file")
  }
  var format: Int = 0
  var channels: Int = 0
  var sampleRate: Int = 0
  var bits: Int = 0
  var blockAlign: Int = 0
  var dataAt: Int = -1
  var dataSize: Int = 0
  var at: Int = 12
  loop at + 8 <= bytes.length() {
    let size: Int = uint32At(bytes: bytes, at: at + 4)
    if textAt(bytes: bytes, at: at, expected: "fmt ") {
      format = uint16At(bytes: bytes, at: at + 8)
      channels = uint16At(bytes: bytes, at: at + 10)
      sampleRate = uint32At(bytes: bytes, at: at + 12)
      blockAlign = uint16At(bytes: bytes, at: at + 20)
      bits = uint16At(bytes: bytes, at: at + 22)
      if format is 65534 and size >= 26 {
        format = uint16At(bytes: bytes, at: at + 32)
      }
    } else if textAt(bytes: bytes, at: at, expected: "data") {
      dataAt = at + 8
      dataSize = min(a: size, b: bytes.length() - dataAt)
    }
    at = at + 8 + size + (size bitand 1)
  }
  if dataAt < 0 or channels < 1 or blockAlign < 1 or sampleRate < 1 {
    ret emptySoundData(error: "a WAV file without fmt or data")
  }
  let isFloat: Bool = format is 3
  if not isFloat and format is not 1 {
    ret emptySoundData(error: "WAV format {format} is not PCM or float")
  }
  if isFloat and bits is not 32 {
    ret emptySoundData(error: "float WAV with {bits} bits")
  }
  if not isFloat and bits is not 8 and bits is not 16 and bits is not 24 and bits is not 32 {
    ret emptySoundData(error: "PCM WAV with {bits} bits")
  }
  let frameCount: Int = dataSize / blockAlign
  let bytesPerSample: Int = bits / 8
  let samples: Buffer(Float) = createSampleBuffer(count: frameCount * channels)
  loop var frame: Int = 0, frame < frameCount, ++frame {
    loop var channel: Int = 0, channel < channels, ++channel {
      let sampleOffset: Int = dataAt + frame * blockAlign + channel * bytesPerSample
      let value: Float = wavSampleAt(
        bytes: bytes
        at: sampleOffset
        bits: bits
        isFloat: isFloat
      )
      setSampleAt(samples: samples, index: frame * channels + channel, value: value)
    }
  }
  ret SoundData {
    samples: samples
    frameCount: frameCount
    channels: channels
    sampleRate: sampleRate
    error: ""
  }
}

func addUInt16(bytes: mod List(UInt8), value: view Int) {
  bytes.add(value: (value bitand 255) as UInt8)
  bytes.add(value: ((value shr 8) bitand 255) as UInt8)
}

func addUInt32(bytes: mod List(UInt8), value: view Int) {
  addUInt16(bytes: bytes, value: value bitand 65535)
  addUInt16(bytes: bytes, value: (value shr 16) bitand 65535)
}

func addText(bytes: mod List(UInt8), text: view String) {
  loop var i: Int = 0, i < text.length(), ++i {
    bytes.add(value: text.byteAt(index: i) as UInt8)
  }
}

# A 32-bit float WAV file of `frameCount` interleaved frames
func encodeWav(
  samples: view Buffer(Float)
  frameCount: view Int
  channels: view Int
  sampleRate: view Int
) ret List(UInt8) {
  let dataSize: Int = frameCount * channels * 4
  var bytes: List(UInt8) = List.create(UInt8, cap: 44 + dataSize)
  addText(bytes: bytes, text: "RIFF")
  addUInt32(bytes: bytes, value: 36 + dataSize)
  addText(bytes: bytes, text: "WAVEfmt ")
  addUInt32(bytes: bytes, value: 16)
  addUInt16(bytes: bytes, value: 3)
  addUInt16(bytes: bytes, value: channels)
  addUInt32(bytes: bytes, value: sampleRate)
  addUInt32(bytes: bytes, value: sampleRate * channels * 4)
  addUInt16(bytes: bytes, value: channels * 4)
  addUInt16(bytes: bytes, value: 32)
  addText(bytes: bytes, text: "data")
  addUInt32(bytes: bytes, value: dataSize)
  loop var i: Int = 0, i < frameCount * channels, ++i {
    addUInt32(bytes: bytes, value: floatBits(value: sampleAt(samples: samples, index: i)))
  }
  ret bytes
}

# Write a 32-bit float WAV file; answers whether it was written
func writeWavFile(
  path: view String
  samples: view Buffer(Float)
  frameCount: view Int
  channels: view Int
  sampleRate: view Int
) ret Bool {
  var bytes: List(UInt8) = encodeWav(
    samples: samples
    frameCount: frameCount
    channels: channels
    sampleRate: sampleRate
  )
  var pathZ: List(UInt8) = pathBytesZ(path: path)
  unsafe {
    ret rae_audio_write_file(pathZ: pathZ.data, bytes: bytes.data, count: bytes.length()) is 1
  }
}
