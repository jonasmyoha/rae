# audio/AudioMixer — the engine core that runs on the audio thread
# (docs/audio-design.md §5, §6.2, §6.4). Voices play sounds onto four buses;
# the buses are summed into the output with their gains and the in-mix duck.
#
# Everything here is real-time code: `mixerRender` and what it calls never
# allocate, free, lock, log or wait. The mixer's memory (voices, bus buffers)
# is made once by `createAudioMixer` and freed by `freeAudioMixer`, off the
# audio thread. The main thread talks to it only through the rings:
#   commands  main -> audio   AudioCommand (play, stop, gains, the duck, ...)
#   feedback  audio -> main   AudioFeedback (a voice ended)
#   reclaim   audio -> main   the soundId of a sound no voice reads any more,
#                             which the main thread then frees
# Every command carries the sample time it takes effect at (0: at once), and a
# voice starts at exactly that sample, whatever the block size (§6.2).
import Math
open audio/Sound
open collections/SpscRing

enum AudioBusKind { music, effects, alerts, voice }

const audioBusCount: Int = 4

const audioMaxVoices: Int = 64

enum AudioCommandKind {
  play
  stop
  fadeOut
  setVoiceGain
  setVoicePan
  setBusGain
  setDuck
  releaseSound
}

# One message to the audio thread. Plain values only (it crosses a ring): the
# sound's samples travel as the Buffer the main thread owns.
type AudioCommand {
  kind: AudioCommandKind
  voiceId: Int
  soundId: Int
  samples: Buffer(Float)
  frameCount: Int
  channels: Int
  sampleRate: Int
  bus: Int
  # the duck's target bus
  targetBus: Int
  # a gain (linear), a pan (-1 left .. 1 right), or seconds
  value: Float
  # a new voice's pan, or the duck's release in seconds
  other: Float
  looping: Bool
  # the sample time it starts at; 0 (or a past time) for the next block
  atSample: Int
}

enum AudioFeedbackKind { voiceEnded }

type AudioFeedback {
  kind: AudioFeedbackKind
  voiceId: Int
  atSample: Int
}

# A value that moves linearly to its target over a number of frames, so a
# change never clicks.
type AudioRamp {
  current: Float
  target: Float
  step: Float
  framesLeft: Int
}

func steadyRamp(value: view Float) ret AudioRamp {
  ret AudioRamp { current: value, target: value, step: 0.0, framesLeft: 0 }
}

func rampTo(ramp: mod AudioRamp, target: view Float, frames: view Int) {
  ramp.target = target
  if frames <= 0 {
    ramp.current = target
    ramp.framesLeft = 0
    ret
  }
  ramp.step = (target - ramp.current) / (frames as Float)
  ramp.framesLeft = frames
}

func rampAdvance(ramp: mod AudioRamp) {
  if ramp.framesLeft > 0 {
    ramp.framesLeft = ramp.framesLeft - 1
    if ramp.framesLeft is 0 {
      ramp.current = ramp.target
    } else {
      ramp.current = ramp.current + ramp.step
    }
  }
}

type AudioVoice {
  active: Bool
  voiceId: Int
  soundId: Int
  samples: Buffer(Float)
  frameCount: Int
  channels: Int
  # where in the sound, in its frames, and how far one output frame moves
  position: Float64
  step: Float64
  bus: Int
  gain: AudioRamp
  pan: AudioRamp
  looping: Bool
  # output frames to wait before the first sample
  delayFrames: Int
  # ends when the gain reaches 0
  stopping: Bool
}

type AudioMixer {
  sampleRate: Int
  maxFrames: Int
  smoothingFrames: Int
  voices: List(AudioVoice)
  busGains: List(AudioRamp)
  # bus b's left samples at [b * maxFrames ...], right likewise
  busLeft: Buffer(Float)
  busRight: Buffer(Float)
  duckOn: Bool
  duckSource: Int
  duckTarget: Int
  duckDepth: Float
  duckAttackStep: Float
  duckReleaseStep: Float
  duckLevel: Float
  sampleTime: Int
  # voices that could not start (all were busy) and feedback the ring refused
  droppedVoices: Int
  droppedFeedback: Int
  feedback: SpscRing(AudioFeedback)
  reclaim: SpscRing(Int)
}

func createAudioMixer(
  sampleRate: view Int
  maxFrames: view Int
  feedback: view SpscRing(AudioFeedback)
  reclaim: view SpscRing(Int)
) ret AudioMixer {
  var voices: List(AudioVoice) = List.create(AudioVoice, cap: audioMaxVoices)
  voices.addDefaults(count: audioMaxVoices)
  var busGains: List(AudioRamp) = List.create(AudioRamp, cap: audioBusCount)
  loop var bus: Int = 0, bus < audioBusCount, ++bus {
    busGains.add(value: steadyRamp(value: 1.0))
  }
  ret AudioMixer {
    sampleRate: sampleRate
    maxFrames: maxFrames
    smoothingFrames: sampleRate * 5 / 1000
    voices: voices
    busGains: busGains
    busLeft: createSampleBuffer(count: audioBusCount * maxFrames)
    busRight: createSampleBuffer(count: audioBusCount * maxFrames)
    duckOn: false
    duckSource: 0
    duckTarget: 0
    duckDepth: 1.0
    duckAttackStep: 1.0
    duckReleaseStep: 1.0
    duckLevel: 1.0
    sampleTime: 0
    droppedVoices: 0
    droppedFeedback: 0
    feedback: feedback
    reclaim: reclaim
  }
}

func freeAudioMixer(mixer: view AudioMixer) {
  unsafe {
    rae_ext_rae_buf_free(buf: mixer.busLeft)
    rae_ext_rae_buf_free(buf: mixer.busRight)
  }
}

func decibelsToGain(decibels: view Float) ret Float {
  ret pow(base: 10.0, exp: decibels / 20.0)
}

func secondsToFrames(mixer: view AudioMixer, seconds: view Float) ret Int {
  ret (seconds * (mixer.sampleRate as Float)) as Int
}

# Tell the main thread a voice ended (after its alias into `voices` is gone)
func reportVoiceEnded(mixer: mod AudioMixer, voiceId: view Int) {
  let ended: AudioFeedback = {
    kind: AudioFeedbackKind.voiceEnded
    voiceId: voiceId
    atSample: mixer.sampleTime
  }
  if not mixer.feedback.push(value: ended) {
    mixer.droppedFeedback = mixer.droppedFeedback + 1
  }
}

func startVoice(mixer: mod AudioMixer, command: view AudioCommand) {
  let sampleTime: Int = mixer.sampleTime
  let step: Float64 = (command.sampleRate as Float64) / (mixer.sampleRate as Float64)
  loop var index: Int = 0, index < audioMaxVoices, ++index {
    if let voice: mod AudioVoice = mixer.voices.modAt(index: index) {
      if not voice.active {
        voice.active = true
        voice.voiceId = command.voiceId
        voice.soundId = command.soundId
        voice.samples = command.samples
        voice.frameCount = command.frameCount
        voice.channels = command.channels
        voice.position = 0.0
        voice.step = step
        voice.bus = command.bus
        voice.gain = steadyRamp(value: command.value)
        voice.pan = steadyRamp(value: command.other)
        voice.looping = command.looping
        voice.delayFrames = 0
        if command.atSample > sampleTime {
          voice.delayFrames = command.atSample - sampleTime
        }
        voice.stopping = false
        ret
      }
    }
  }
  mixer.droppedVoices = mixer.droppedVoices + 1
}

func applyCommand(mixer: mod AudioMixer, command: view AudioCommand) {
  if command.kind is AudioCommandKind.play {
    startVoice(mixer: mixer, command: command)
    ret
  }
  if command.kind is AudioCommandKind.setBusGain {
    if let ramp: mod AudioRamp = mixer.busGains.modAt(index: command.bus) {
      rampTo(ramp: ramp, target: command.value, frames: mixer.smoothingFrames)
    }
    ret
  }
  if command.kind is AudioCommandKind.setDuck {
    mixer.duckOn = true
    mixer.duckSource = command.bus
    mixer.duckTarget = command.targetBus
    mixer.duckDepth = command.value
    mixer.duckAttackStep = (1.0 - command.value) / max(
      a: 1.0
      b: (mixer.smoothingFrames * 10) as Float
    )
    mixer.duckReleaseStep = (1.0 - command.value) / max(
      a: 1.0
      b: secondsToFrames(mixer: mixer, seconds: command.other) as Float
    )
    ret
  }
  let smoothing: Int = mixer.smoothingFrames
  let fadeFrames: Int = secondsToFrames(mixer: mixer, seconds: command.value)
  loop var index: Int = 0, index < audioMaxVoices, ++index {
    var endedVoiceId: Int = -1
    if let voice: mod AudioVoice = mixer.voices.modAt(index: index) {
      if voice.active {
        if command.kind is AudioCommandKind.releaseSound {
          if voice.soundId is command.soundId {
            voice.active = false
            endedVoiceId = voice.voiceId
          }
        } else if voice.voiceId is command.voiceId {
          if command.kind is AudioCommandKind.stop {
            voice.stopping = true
            rampTo(ramp: voice.gain, target: 0.0, frames: smoothing)
          } else if command.kind is AudioCommandKind.fadeOut {
            voice.stopping = true
            rampTo(ramp: voice.gain, target: 0.0, frames: fadeFrames)
          } else if command.kind is AudioCommandKind.setVoiceGain {
            rampTo(ramp: voice.gain, target: command.value, frames: smoothing)
          } else if command.kind is AudioCommandKind.setVoicePan {
            rampTo(ramp: voice.pan, target: command.value, frames: smoothing)
          }
        }
      }
    }
    if endedVoiceId >= 0 {
      reportVoiceEnded(mixer: mixer, voiceId: endedVoiceId)
    }
  }
  if command.kind is AudioCommandKind.releaseSound {
    if not mixer.reclaim.push(value: command.soundId) {
      mixer.droppedFeedback = mixer.droppedFeedback + 1
    }
  }
}

# The sound's channel `channel` at fractional frame `position`, linearly
# between the two frames around it.
func voiceSampleAt(voice: view AudioVoice, position: view Float64, channel: view Int) ret Float {
  let first: Int = position as Int
  let fraction: Float = (position - (first as Float64)) as Float
  let a: Float = sampleAt(samples: voice.samples, index: first * voice.channels + channel)
  if fraction <= 0.0 {
    ret a
  }
  var next: Int = first + 1
  if next >= voice.frameCount {
    if not voice.looping {
      ret a * (1.0 - fraction)
    }
    next = 0
  }
  let b: Float = sampleAt(samples: voice.samples, index: next * voice.channels + channel)
  ret a + (b - a) * fraction
}

func addToBus(
  busLeft: view Buffer(Float)
  busRight: view Buffer(Float)
  index: view Int
  left: view Float
  right: view Float
) {
  setSampleAt(
    samples: busLeft
    index: index
    value: sampleAt(samples: busLeft, index: index) + left
  )
  setSampleAt(
    samples: busRight
    index: index
    value: sampleAt(samples: busRight, index: index) + right
  )
}

# Play one voice for `frames` frames onto its bus's part of the bus buffers;
# it stops itself (active false) when it ends.
func renderVoice(
  voice: mod AudioVoice
  busLeft: view Buffer(Float)
  busRight: view Buffer(Float)
  maxFrames: view Int
  frames: view Int
) {
  loop var frame: Int = 0, frame < frames and voice.active, ++frame {
    if voice.delayFrames > 0 {
      voice.delayFrames = voice.delayFrames - 1
    } else {
      var left: Float = voiceSampleAt(voice: voice, position: voice.position, channel: 0)
      var right: Float = left
      let gain: Float = voice.gain.current
      let pan: Float = voice.pan.current
      if voice.channels >= 2 {
        right = voiceSampleAt(voice: voice, position: voice.position, channel: 1)
        # balance: the far side fades out, the near one stays
        var leftGain: Float = 1.0
        var rightGain: Float = 1.0
        if pan > 0.0 {
          leftGain = 1.0 - pan
        }
        if pan < 0.0 {
          rightGain = 1.0 + pan
        }
        left = left * leftGain
        right = right * rightGain
      } else {
        # equal power: -3 dB on each side in the middle
        let angle: Float = (pan + 1.0) * 0.78539816
        right = left * sin(x: angle)
        left = left * cos(x: angle)
      }
      addToBus(
        busLeft: busLeft
        busRight: busRight
        index: voice.bus * maxFrames + frame
        left: left * gain
        right: right * gain
      )
      rampAdvance(ramp: voice.gain)
      rampAdvance(ramp: voice.pan)
      voice.position = voice.position + voice.step
      if voice.position >= (voice.frameCount as Float64) {
        if voice.looping and voice.frameCount > 0 {
          voice.position = voice.position - (voice.frameCount as Float64)
        } else {
          voice.active = false
        }
      }
      if voice.stopping and voice.gain.framesLeft is 0 and voice.gain.current <= 0.0 {
        voice.active = false
      }
    }
  }
}

# Render `frames` (at most maxFrames) interleaved frames of `channels` into
# `output`, after taking every command waiting in `commands`.
func mixerRender(
  mixer: mod AudioMixer
  commands: view SpscRing(AudioCommand)
  output: view Buffer(Float)
  frames: view Int
  channels: view Int
) {
  loop commands.count() > 0 {
    if let command: AudioCommand = commands.pop() {
      applyCommand(mixer: mixer, command: command)
    }
  }
  unsafe {
    rae_ext_rae_buf_zero(
      buf: mixer.busLeft
      start: 0
      count: audioBusCount * mixer.maxFrames
      elemSize: sizeof(Float)
    )
    rae_ext_rae_buf_zero(
      buf: mixer.busRight
      start: 0
      count: audioBusCount * mixer.maxFrames
      elemSize: sizeof(Float)
    )
  }
  var duckWanted: Bool = false
  let busLeft: Buffer(Float) = mixer.busLeft
  let busRight: Buffer(Float) = mixer.busRight
  let maxFrames: Int = mixer.maxFrames
  let duckOn: Bool = mixer.duckOn
  let duckSource: Int = mixer.duckSource
  loop var index: Int = 0, index < audioMaxVoices, ++index {
    var endedVoiceId: Int = -1
    if let voice: mod AudioVoice = mixer.voices.modAt(index: index) {
      if voice.active {
        if duckOn and voice.bus is duckSource {
          duckWanted = true
        }
        renderVoice(
          voice: voice
          busLeft: busLeft
          busRight: busRight
          maxFrames: maxFrames
          frames: frames
        )
        if not voice.active {
          endedVoiceId = voice.voiceId
        }
      }
    }
    if endedVoiceId >= 0 {
      reportVoiceEnded(mixer: mixer, voiceId: endedVoiceId)
    }
  }
  loop var frame: Int = 0, frame < frames, ++frame {
    if mixer.duckOn {
      if duckWanted {
        mixer.duckLevel = max(a: mixer.duckDepth, b: mixer.duckLevel - mixer.duckAttackStep)
      } else {
        mixer.duckLevel = min(a: 1.0, b: mixer.duckLevel + mixer.duckReleaseStep)
      }
    }
    var left: Float = 0.0
    var right: Float = 0.0
    let duckTarget: Int = mixer.duckTarget
    let duckLevel: Float = mixer.duckLevel
    loop var bus: Int = 0, bus < audioBusCount, ++bus {
      if let ramp: mod AudioRamp = mixer.busGains.modAt(index: bus) {
        var gain: Float = ramp.current
        if duckOn and bus is duckTarget {
          gain = gain * duckLevel
        }
        let index: Int = bus * maxFrames + frame
        left = left + sampleAt(samples: busLeft, index: index) * gain
        right = right + sampleAt(samples: busRight, index: index) * gain
        rampAdvance(ramp: ramp)
      }
    }
    if channels is 1 {
      setSampleAt(samples: output, index: frame, value: (left + right) * 0.5)
    } else {
      setSampleAt(samples: output, index: frame * channels, value: left)
      setSampleAt(samples: output, index: frame * channels + 1, value: right)
      loop var extra: Int = 2, extra < channels, ++extra {
        setSampleAt(samples: output, index: frame * channels + extra, value: 0.0)
      }
    }
  }
  mixer.sampleTime = mixer.sampleTime + frames
}
