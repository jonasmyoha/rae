# audio/AacPlatform — the platform's AAC decoder behind audio/AacDecoder
# (docs/audio-design.md §7.3): AudioToolbox's AudioConverter on Apple, the
# NDK's AMediaCodec on Android, none elsewhere (until the FFmpeg package).
# Both through native/rae_audio_glue.c, one platform call per shim; the loops
# are here.
#
# The two differ in one way that matters: AudioConverter answers each packet
# with its frames, AMediaCodec may hold frames back and give them with a later
# packet, and at the end needs an end-of-stream packet and then more asking
# until the frames flagged as the last come out. So a decode call appends what
# came out (maybe nothing) and says whether the stream has ended.
import Math
open audio/AudioGlue
open audio/Sound
open media/Mp4

# AudioConverter's largest answer to one packet (HE-AAC: 2048)
const aacConverterMaxFrames: Int = 4096

# How long an Android call waits for the codec: an input buffer, or an output
# at the end of the stream
const codecWaitMicroseconds: Int = 10000

type AacCodec {
  # 0 when there is none
  handle: Int
  channels: Int
  # Android: the end-of-stream packet is queued
  endQueued: Bool
  # the samples AudioConverter writes, or AMediaCodec's bytes
  floats: List(Float)
  bytes: List(UInt8)
  info: List(Int)
}

type AacDecoded {
  frames: Int
  # the stream's last frames have come out
  ended: Bool
  # the platform failed
  failed: Bool
}

func noAacCodec() ret AacCodec {
  ret AacCodec {
    handle: 0
    channels: 0
    endQueued: false
    floats: List.create(Float, cap: 0)
    bytes: List.create(UInt8, cap: 0)
    info: List.create(Int, cap: 0)
  }
}

func setCodecString(format: view Int, key: view String, value: view String) {
  let keyZ: List(UInt8) = pathBytesZ(path: key)
  let valueZ: List(UInt8) = pathBytesZ(path: value)
  unsafe {
    rae_audio_codec_format_set_string(format: format, keyZ: keyZ.data, valueZ: valueZ.data)
  }
}

func setCodecInt(format: view Int, key: view String, value: view Int) {
  let keyZ: List(UInt8) = pathBytesZ(path: key)
  unsafe {
    rae_audio_codec_format_set_int(format: format, keyZ: keyZ.data, value: value)
  }
}

# A decoder for the track: Apple's takes the esds payload as its cookie,
# Android's the AudioSpecificConfig as csd-0
func openAacCodec(track: view Mp4Track, sampleRate: view Int) ret AacCodec {
  var codec: AacCodec = noAacCodec()
  codec.channels = track.channels
  when Target.isApple {
    unsafe {
      codec.handle = rae_audio_aac_open(sampleRate: sampleRate, channels: track.channels)
      if codec.handle is not 0 and track.elementaryStream.length() > 0 {
        let cookie: Int = rae_audio_aac_set_cookie(
          converter: codec.handle
          cookie: track.elementaryStream.data
          size: track.elementaryStream.length()
        )
      }
    }
    codec.floats.addDefaults(count: aacConverterMaxFrames * max(a: 1, b: track.channels))
  } else when Target.os is Os.android {
    let mime: List(UInt8) = pathBytesZ(path: "audio/mp4a-latm")
    var handle: Int = 0
    var format: Int = 0
    unsafe {
      handle = rae_audio_codec_create(mimeZ: mime.data)
      format = rae_audio_codec_format_new()
    }
    if handle is 0 or format is 0 {
      ret codec
    }
    setCodecString(format: format, key: "mime", value: "audio/mp4a-latm")
    setCodecInt(format: format, key: "sample-rate", value: sampleRate)
    setCodecInt(format: format, key: "channel-count", value: track.channels)
    setCodecInt(format: format, key: "is-adts", value: 0)
    let csdKey: List(UInt8) = pathBytesZ(path: "csd-0")
    unsafe {
      rae_audio_codec_format_set_bytes(
        format: format
        keyZ: csdKey.data
        bytes: track.codecConfig.data
        count: track.codecConfig.length()
      )
      let configured: Int = rae_audio_codec_configure(codec: handle, format: format)
      rae_audio_codec_format_delete(format: format)
      if configured is not 0 or rae_audio_codec_start(codec: handle) is not 0 {
        rae_audio_codec_close(codec: handle)
        ret codec
      }
    }
    codec.handle = handle
    codec.info.addDefaults(count: 4)
  }
  ret codec
}

# Forget the stream (a seek)
func resetAacCodec(this: mod AacCodec) {
  this.endQueued = false
  unsafe {
    when Target.isApple {
      rae_audio_aac_reset(converter: this.handle)
    } else when Target.os is Os.android {
      let flushed: Int = rae_audio_codec_flush(codec: this.handle)
    }
  }
}

func closeAacCodec(this: view AacCodec) {
  if this.handle is 0 {
    ret
  }
  unsafe {
    when Target.isApple {
      rae_audio_aac_close(converter: this.handle)
    } else when Target.os is Os.android {
      rae_audio_codec_close(codec: this.handle)
    }
  }
}

# One packet in (`size` 0: the stream has ended), its frames appended to
# `into` as interleaved Floats
func decodeAacPacket(
  this: mod AacCodec
  packet: view List(UInt8)
  size: view Int
  timeMicroseconds: view Int
  into: mod List(Float)
) ret AacDecoded {
  when Target.isApple {
    var got: Int = 0
    unsafe {
      got = rae_audio_aac_decode(
        converter: this.handle
        packet: packet.data
        size: size
        out: this.floats.data
        maxFrames: aacConverterMaxFrames
        channels: this.channels
      )
    }
    if got < 0 {
      ret AacDecoded { frames: 0, ended: true, failed: true }
    }
    loop var i: Int = 0, i < got * this.channels, ++i {
      into.add(value: this.floats.copyAtFallback(index: i, fallback: 0.0))
    }
    ret AacDecoded { frames: got, ended: size is 0, failed: false }
  } else when Target.os is Os.android {
    ret this.decodeWithMediaCodec(
      packet: packet
      size: size
      timeMicroseconds: timeMicroseconds
      into: into
    )
  } else {
    ret AacDecoded { frames: 0, ended: true, failed: true }
  }
}

# Android: queue the packet (or the end), then take every output ready
func decodeWithMediaCodec(
  this: mod AacCodec
  packet: view List(UInt8)
  size: view Int
  timeMicroseconds: view Int
  into: mod List(Float)
) ret AacDecoded {
  var frames: Int = 0
  var ended: Bool = false
  var queued: Bool = size is 0 and this.endQueued
  var tries: Int = 0
  loop not queued and tries < 50 {
    var index: Int = -1
    unsafe {
      index = rae_audio_codec_dequeue_input(codec: this.handle, timeoutUs: codecWaitMicroseconds)
    }
    if index >= 0 {
      var flags: Int = 0
      if size is 0 {
        flags = 4
        this.endQueued = true
      }
      unsafe {
        let status: Int = rae_audio_codec_queue_input(
          codec: this.handle
          index: index
          bytes: packet.data
          count: size
          timeUs: timeMicroseconds
          flags: flags
        )
        if status is not 0 {
          ret AacDecoded { frames: frames, ended: true, failed: true }
        }
      }
      queued = true
    } else {
      # no input buffer free: the codec waits for its outputs to be taken
      let taken: AacDecoded = this.takeMediaCodecOutputs(into: into, waitMicroseconds: 0)
      frames = frames + taken.frames
      ended = ended or taken.ended
    }
    tries = tries + 1
  }
  var wait: Int = 0
  if this.endQueued {
    # at the end the last frames take a moment
    wait = codecWaitMicroseconds
  }
  let taken: AacDecoded = this.takeMediaCodecOutputs(into: into, waitMicroseconds: wait)
  ret AacDecoded { frames: frames + taken.frames, ended: ended or taken.ended, failed: not queued }
}

# Every output buffer ready now (waiting up to `waitMicroseconds` for the
# first), as Floats from 16-bit PCM
func takeMediaCodecOutputs(
  this: mod AacCodec
  into: mod List(Float)
  waitMicroseconds: view Int
) ret AacDecoded {
  var frames: Int = 0
  var ended: Bool = false
  var wait: Int = waitMicroseconds
  var reading: Bool = true
  loop reading {
    var index: Int = -1
    unsafe {
      index = rae_audio_codec_dequeue_output(
        codec: this.handle
        info: this.info.data
        timeoutUs: wait
      )
    }
    wait = 0
    if index >= 0 {
      let offset: Int = this.info.copyAtFallback(index: 0, fallback: 0)
      let count: Int = this.info.copyAtFallback(index: 1, fallback: 0)
      let flags: Int = this.info.copyAtFallback(index: 2, fallback: 0)
      this.bytes.clear()
      this.bytes.addDefaults(count: max(a: 1, b: count))
      var copied: Int = 0
      unsafe {
        copied = rae_audio_codec_take_output(
          codec: this.handle
          index: index
          offset: offset
          into: this.bytes.data
          count: count
        )
      }
      loop var sample: Int = 0, sample * 2 + 1 < copied, ++sample {
        var value: Int = (this.bytes.copyAtFallback(index: sample * 2, fallback: 0) as Int) bitor ((this.bytes.copyAtFallback(
          index: sample * 2 + 1
          fallback: 0
        ) as Int) shl 8)
        if value >= 32768 {
          value = value - 65536
        }
        into.add(value: (value as Float) / 32768.0)
      }
      frames = frames + copied / (2 * max(a: 1, b: this.channels))
      if (flags bitand 4) is not 0 {
        ended = true
        reading = false
      }
    } else if index is -2 {
      let key: List(UInt8) = pathBytesZ(path: "channel-count")
      unsafe {
        this.channels = rae_audio_codec_output_int(
          codec: this.handle
          keyZ: key.data
          fallback: this.channels
        )
      }
    } else if index is not -3 {
      reading = false
    }
  }
  ret AacDecoded { frames: frames, ended: ended, failed: false }
}
