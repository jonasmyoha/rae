cheader "rae_audio.h"

# The bindings to native/rae_audio_glue.c (docs/audio-design.md §3 L1): the
# device through miniaudio's device layer, the thread's real-time policy and a
# file write, one call each. The engine is audio/AudioMixer and audio/Audio. A
# program that imports this links the package's C (native/build.sh builds it).
func rae_audio_device_open(
  sampleRate: Int
  channels: Int
  periodFrames: Int
) unsafe extern("rae_audio_device_open") ret Int

func rae_audio_device_sample_rate(device: Int) unsafe extern("rae_audio_device_sample_rate") ret Int

func rae_audio_device_channels(device: Int) unsafe extern("rae_audio_device_channels") ret Int

func rae_audio_device_period_frames(
  device: Int
) unsafe extern("rae_audio_device_period_frames") ret Int

func rae_audio_device_attach(
  device: Int
  slots: Buffer(Float)
  counters: Buffer(Int)
  capacity: Int
  signal: Int
) unsafe extern("rae_audio_device_attach")

func rae_audio_device_attach_render(
  device: Int
  state: Ptr
) unsafe extern("rae_audio_device_attach_render")

func rae_audio_device_start(device: Int) unsafe extern("rae_audio_device_start") ret Int

func rae_audio_device_stop(device: Int) unsafe extern("rae_audio_device_stop") ret Int

func rae_audio_device_close(device: Int) unsafe extern("rae_audio_device_close")

func rae_audio_device_underrun_frames(
  device: Int
) unsafe extern("rae_audio_device_underrun_frames") ret Int

func rae_audio_device_callbacks(device: Int) unsafe extern("rae_audio_device_callbacks") ret Int

func rae_audio_thread_set_realtime(
  periodNs: Int
  computeNs: Int
) unsafe extern("rae_audio_thread_set_realtime") ret Int

func rae_audio_file_size(pathZ: Buffer(UInt8)) unsafe extern("rae_audio_file_size") ret Int

func rae_audio_read_file(
  pathZ: Buffer(UInt8)
  into: Buffer(UInt8)
  count: Int
) unsafe extern("rae_audio_read_file") ret Int

func rae_audio_write_file(
  pathZ: Buffer(UInt8)
  bytes: Buffer(UInt8)
  count: Int
) blocking unsafe extern("rae_audio_write_file") ret Int

func rae_audio_session_available() unsafe extern("rae_audio_session_available") ret Int

func rae_audio_session_configure(
  category: Int
  mode: Int
  options: Int
) unsafe extern("rae_audio_session_configure") ret Int

func rae_audio_session_set_active(active: Int) unsafe extern("rae_audio_session_set_active") ret Int

func rae_audio_session_observe() unsafe extern("rae_audio_session_observe") ret Int

func rae_audio_session_poll() unsafe extern("rae_audio_session_poll") ret Int

func rae_audio_session_inject(kind: Int, value: Int) unsafe extern("rae_audio_session_inject")

func rae_audio_session_describe(
  into: Buffer(UInt8)
  capacity: Int
) unsafe extern("rae_audio_session_describe") ret Int

func rae_audio_focus_status() unsafe extern("rae_audio_focus_status") ret Int

func rae_audio_focus_request() unsafe extern("rae_audio_focus_request") ret Int

func rae_audio_decoder_open(pathZ: Buffer(UInt8)) unsafe extern("rae_audio_decoder_open") ret Int

func rae_audio_decoder_channels(decoder: Int) unsafe extern("rae_audio_decoder_channels") ret Int

func rae_audio_decoder_sample_rate(
  decoder: Int
) unsafe extern("rae_audio_decoder_sample_rate") ret Int

func rae_audio_decoder_length(decoder: Int) unsafe extern("rae_audio_decoder_length") ret Int

func rae_audio_decoder_read(
  decoder: Int
  into: Buffer(Float)
  frames: Int
) unsafe extern("rae_audio_decoder_read") ret Int

func rae_audio_decoder_seek(
  decoder: Int
  frame: Int
) unsafe extern("rae_audio_decoder_seek") ret Int

func rae_audio_decoder_close(decoder: Int) unsafe extern("rae_audio_decoder_close")

func rae_audio_file_open(pathZ: Buffer(UInt8)) unsafe extern("rae_audio_file_open") ret Int

func rae_audio_file_read_at(
  file: Int
  into: Buffer(UInt8)
  count: Int
  offset: Int
) unsafe extern("rae_audio_file_read_at") ret Int

func rae_audio_file_close(file: Int) unsafe extern("rae_audio_file_close")

func rae_audio_aac_open(sampleRate: Int, channels: Int) unsafe extern("rae_audio_aac_open") ret Int

func rae_audio_aac_set_cookie(
  converter: Int
  cookie: Buffer(UInt8)
  size: Int
) unsafe extern("rae_audio_aac_set_cookie") ret Int

func rae_audio_aac_decode(
  converter: Int
  packet: Buffer(UInt8)
  size: Int
  out: Buffer(Float)
  maxFrames: Int
  channels: Int
) unsafe extern("rae_audio_aac_decode") ret Int

func rae_audio_aac_reset(converter: Int) unsafe extern("rae_audio_aac_reset")

func rae_audio_aac_close(converter: Int) unsafe extern("rae_audio_aac_close")

func rae_audio_now_playing_set(
  titleZ: Buffer(UInt8)
  artistZ: Buffer(UInt8)
  albumZ: Buffer(UInt8)
  artworkPathZ: Buffer(UInt8)
  duration: Float64
  position: Float64
  rate: Float64
) unsafe extern("rae_audio_now_playing_set") ret Int

func rae_audio_now_playing_describe(
  into: Buffer(UInt8)
  capacity: Int
) unsafe extern("rae_audio_now_playing_describe") ret Int

func rae_audio_now_playing_clear() unsafe extern("rae_audio_now_playing_clear")

func rae_audio_remote_enable(mask: Int) unsafe extern("rae_audio_remote_enable") ret Int

func rae_audio_remote_poll() unsafe extern("rae_audio_remote_poll") ret Int

func rae_audio_remote_inject(kind: Int, value: Int) unsafe extern("rae_audio_remote_inject")

func rae_audio_run_loop_pump() unsafe extern("rae_audio_run_loop_pump")

func rae_audio_device_buffer_frames(
  device: Int
) unsafe extern("rae_audio_device_buffer_frames") ret Int

func rae_audio_device_core_audio_frames(
  device: Int
  property: Int
) unsafe extern("rae_audio_device_core_audio_frames") ret Int

func rae_audio_session_output_latency_ns() unsafe extern("rae_audio_session_output_latency_ns") ret
  Int

func rae_audio_device_backend_name(
  device: Int
  into: Buffer(UInt8)
  capacity: Int
) unsafe extern("rae_audio_device_backend_name") ret Int
