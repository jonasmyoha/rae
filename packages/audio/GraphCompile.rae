# audio/GraphCompile — compiling an AudioGraph into a RenderPlan on the main
# thread (docs/audio-design.md §5.2):
#
#   1. sort: every node after its inputs, depth first from the output (so few
#      buffers are alive at once); a cycle is refused with its nodes;
#   2. scratch buffers by liveness;
#   3. delay compensation: a node that reports latency (a look-ahead limiter,
#      a plugin; latentNode here) delays its path, so the compiler delays every
#      other path into the same node by the difference, and the paths line up
#      sample for sample;
#   5. prepare (audio/AudioGraph prepareRenderPlan).
#
# compileGraphAfter also makes the plan continue the previous one: each node
# that stands for the same entity (and kind) as a node of the previous plan
# records it, and the audio thread carries its running state over at the swap
# (a gain's current level, a meter, a limiter's gain, a delay line's contents:
# a reverb tail or an echo does not cut off when a track is added). A node of
# the previous graph that is gone but still has a tail (tailFrames) stays,
# fed silence, feeding the nodes it fed, until a later compile drops it.
#
#     let first: CompiledPlan = compileGraph(graph: graph, sampleRate: 48000, maxFrames: 512)
#     ... the graph changes ...
#     let next: CompiledPlan = compileGraphAfter(
#       graph: changed, previousGraph: graph, previousPlan: first.plan, sampleRate: 48000,
#       maxFrames: 512)
import String
open audio/AudioGraph
open audio/CustomNodes

func failedPlan(error: view String) ret CompiledPlan {
  ret CompiledPlan { plan: emptyRenderPlan(), error: error }
}

# Visit `node` after its inputs (depth first): 0 not seen, 1 on the current
# path, 2 placed. A node met again while on the path closes a cycle; `path`
# holds the nodes on it.
func visitNode(
  graph: view AudioGraph
  node: view Int
  marks: mod List(Int)
  path: mod List(Int)
  order: mod List(Int)
) ret Bool {
  let mark: Int = marks.copyAtFallback(index: node, fallback: 2)
  if mark is 2 {
    ret true
  }
  if mark is 1 {
    path.add(value: node)
    ret false
  }
  marks.set(index: node, value: 1)
  path.add(value: node)
  loop let edge: GraphEdge in graph.edges {
    if edge.to is node {
      if not visitNode(
        graph: graph
        node: edge.from
        marks: marks
        path: path
        order: order
      ) {
        ret false
      }
    }
  }
  path.removeLast()
  marks.set(index: node, value: 2)
  order.add(value: node)
  ret true
}

# The nodes' run order, every node after its inputs: depth first from the
# output, so each track (and each bus's group) runs to its end before the
# next starts and only a few buffers are alive at a time; then any node the
# output does not reach. Or an error naming the nodes on a cycle.
func sortGraph(graph: view AudioGraph, order: mod List(Int)) ret String {
  let count: Int = graph.nodes.length()
  var marks: List(Int) = {}
  marks.addDefaults(count: count)
  var path: List(Int) = {}
  var starts: List(Int) = {}
  loop var i: Int = 0, i < count, ++i {
    if graph.nodes.copyAtFallback(index: i, fallback: plainNode(kind: NodeKind.sum)).kind is NodeKind.output {
      starts.add(value: i)
    }
  }
  loop var i: Int = 0, i < count, ++i {
    starts.add(value: i)
  }
  loop let start: Int in starts {
    if not visitNode(
      graph: graph
      node: start
      marks: marks
      path: path
      order: order
    ) {
      # the cycle is the part of the path from the node met again
      let closing: Int = path.copyAtFallback(index: path.length() - 1, fallback: 0)
      var names: String = ""
      var inCycle: Bool = false
      loop var k: Int = 0, k < path.length() - 1, ++k {
        let node: Int = path.copyAtFallback(index: k, fallback: 0)
        if node is closing {
          inCycle = true
        }
        if inCycle {
          if names.length() > 0 {
            names = "{names} <- "
          }
          names = "{names}{node}"
        }
      }
      ret "the audio graph has a cycle: node {names} <- {closing} (each takes the next one's output)"
    }
  }
  ret ""
}

# A fresh plan: nothing to continue
func compileGraph(
  graph: view AudioGraph
  sampleRate: view Int
  maxFrames: view Int
) ret CompiledPlan {
  ret compileGraphAfter(
    graph: graph
    previousGraph: createAudioGraph()
    previousPlan: emptyRenderPlan()
    sampleRate: sampleRate
    maxFrames: maxFrames
  )
}

# A plan that continues `previousPlan` (compiled from `previousGraph`)
func compileGraphAfter(
  graph: view AudioGraph
  previousGraph: view AudioGraph
  previousPlan: view RenderPlan
  sampleRate: view Int
  maxFrames: view Int
) ret CompiledPlan {
  let count: Int = graph.nodes.length()
  loop let edge: GraphEdge in graph.edges {
    if edge.from < 0 or edge.from >= count or edge.to < 0 or edge.to >= count {
      ret failedPlan(
        error: "an edge names node {edge.from} -> {edge.to}, but the graph has {count} nodes"
      )
    }
  }
  var working: AudioGraph = graph
  keepTails(working: working, previousGraph: previousGraph)
  # a custom node's latency is the program's to say (audio/CustomNodes)
  loop var i: Int = 0, i < working.nodes.length(), ++i {
    var node: GraphNode = working.nodes.copyAtFallback(index: i, fallback: outputNode())
    if node.kind is NodeKind.custom {
      node.customLatency = customLatency(
        kind: node.customKind
        settings: node.customSettings
        sampleRate: sampleRate
      )
      working.nodes.set(index: i, value: node)
    }
  }
  var order: List(Int) = {}
  let cycle: String = sortGraph(graph: working, order: order)
  if cycle.length() > 0 {
    ret failedPlan(error: cycle)
  }
  compensateDelays(working: working, order: order)
  ret compileWorking(
    graph: working
    previousPlan: previousPlan
    sampleRate: sampleRate
    maxFrames: maxFrames
  )
}

# The node of `graph` standing for `entityId` (and of `kind`), or -1
func nodeOfEntity(graph: view AudioGraph, entityId: view Int, kind: view NodeKind) ret Int {
  if entityId is -1 {
    ret -1
  }
  loop var i: Int = 0, i < graph.nodes.length(), ++i {
    if let node: view GraphNode = graph.nodes.viewAt(index: i) {
      if node.entityId is entityId and node.kind is kind {
        ret i
      }
    }
  }
  ret -1
}

# A node of the previous graph that is gone but has a tail stays, fed silence,
# feeding the nodes it fed that are still there (matched by entity)
func keepTails(working: mod AudioGraph, previousGraph: view AudioGraph) {
  loop var i: Int = 0, i < previousGraph.nodes.length(), ++i {
    let node: GraphNode = previousGraph.nodes.copyAtFallback(index: i, fallback: outputNode())
    if node.entityId is -1 or tailFrames(node: node) is 0 {
      continue
    }
    if nodeOfEntity(graph: working, entityId: node.entityId, kind: node.kind) is not -1 {
      continue
    }
    var kept: Int = -1
    loop let edge: GraphEdge in previousGraph.edges {
      if edge.from is not i {
        continue
      }
      let reader: GraphNode = previousGraph.nodes.copyAtFallback(
        index: edge.to
        fallback: outputNode()
      )
      var target: Int = nodeOfEntity(graph: working, entityId: reader.entityId, kind: reader.kind)
      if reader.kind is NodeKind.output {
        target = nodeOfKind(graph: working, kind: NodeKind.output)
      }
      if target is -1 {
        continue
      }
      if kept is -1 {
        let silence: Int = working.addNode(node: sourceNode(kind: NodeKind.input, slot: -1))
        kept = working.addNode(node: node)
        working.connect(from: silence, to: kept)
      }
      working.connect(from: kept, to: target)
    }
  }
}

func nodeOfKind(graph: view AudioGraph, kind: view NodeKind) ret Int {
  loop var i: Int = 0, i < graph.nodes.length(), ++i {
    if let node: view GraphNode = graph.nodes.viewAt(index: i) {
      if node.kind is kind {
        ret i
      }
    }
  }
  ret -1
}

# Frames from the sources to each node's output, in run order
func arrivals(graph: view AudioGraph, order: view List(Int)) ret List(Int) {
  var arrival: List(Int) = {}
  arrival.addDefaults(count: graph.nodes.length())
  loop let index: Int in order {
    var latest: Int = 0
    loop let edge: GraphEdge in graph.edges {
      if edge.to is index {
        latest = max(a: latest, b: arrival.copyAtFallback(index: edge.from, fallback: 0))
      }
    }
    let node: GraphNode = graph.nodes.copyAtFallback(index: index, fallback: outputNode())
    arrival.set(index: index, value: latest + latencyFrames(node: node))
  }
  ret arrival
}

# §5.2 step 3: into a node with several inputs, every input that arrives
# earlier than the latest gets a delay of the difference (an entity of its
# own derived from the two ends, so its line is carried over too)
func compensateDelays(working: mod AudioGraph, order: mod List(Int)) {
  let arrival: List(Int) = arrivals(graph: working, order: order)
  let edgeCount: Int = working.edges.length()
  var inserted: Bool = false
  loop var e: Int = 0, e < edgeCount, ++e {
    let edge: GraphEdge = working.edges.copyAtFallback(
      index: e
      fallback: GraphEdge { from: 0, to: 0 }
    )
    var latest: Int = 0
    loop let other: GraphEdge in working.edges {
      if other.to is edge.to {
        latest = max(a: latest, b: arrival.copyAtFallback(index: other.from, fallback: 0))
      }
    }
    let missing: Int = latest - arrival.copyAtFallback(index: edge.from, fallback: 0)
    if missing <= 0 {
      continue
    }
    let from: GraphNode = working.nodes.copyAtFallback(index: edge.from, fallback: outputNode())
    let to: GraphNode = working.nodes.copyAtFallback(index: edge.to, fallback: outputNode())
    var entityId: Int = -1
    if from.entityId >= 0 and to.entityId >= 0 {
      entityId = -2 - (from.entityId * 65536 + to.entityId)
    }
    let delay: Int = working.addNode(
      node: identified(node: delayNode(frames: missing), entityId: entityId)
    )
    working.edges.set(index: e, value: GraphEdge { from: edge.from, to: delay })
    working.connect(from: delay, to: edge.to)
    inserted = true
  }
  if inserted {
    order.clear()
    let again: String = sortGraph(graph: working, order: order)
  }
}

# The frames from the sources to the output
func outputLatency(graph: view AudioGraph, order: view List(Int)) ret Int {
  let arrival: List(Int) = arrivals(graph: graph, order: order)
  ret arrival.copyAtFallback(index: nodeOfKind(graph: graph, kind: NodeKind.output), fallback: 0)
}

# For each node of `graph`, the node of the previous plan whose state it
# continues (same entity and kind), or -1
func carryMap(graph: view AudioGraph, previousPlan: view RenderPlan) ret List(Int) {
  var carry: List(Int) = {}
  loop let node: GraphNode in graph.nodes {
    var found: Int = -1
    if node.entityId is not -1 {
      loop var k: Int = 0, k < previousPlan.nodeCount and found is -1, ++k {
        if planEntityAt(plan: previousPlan, node: k) is node.entityId and planKindAt(
          plan: previousPlan
          node: k
        ) is node.kind {
          found = k
        }
      }
    }
    carry.add(value: found)
  }
  ret carry
}

# Validate, order, allocate the buffers and prepare `graph` (already with its
# tails and delay compensation)
func compileWorking(
  graph: view AudioGraph
  previousPlan: view RenderPlan
  sampleRate: view Int
  maxFrames: view Int
) ret CompiledPlan {
  let count: Int = graph.nodes.length()
  loop let edge: GraphEdge in graph.edges {
    if edge.from < 0 or edge.from >= count or edge.to < 0 or edge.to >= count {
      ret failedPlan(
        error: "an edge names node {edge.from} -> {edge.to}, but the graph has {count} nodes"
      )
    }
  }
  var order: List(Int) = {}
  let cycle: String = sortGraph(graph: graph, order: order)
  if cycle.length() > 0 {
    ret failedPlan(error: cycle)
  }
  # each node's inputs (in edge order), and how many read it
  var outputs: Int = 0
  loop var i: Int = 0, i < count, ++i {
    let node: GraphNode = graph.nodes.copyAtFallback(index: i, fallback: outputNode())
    var inputs: Int = 0
    loop let edge: GraphEdge in graph.edges {
      if edge.to is i {
        inputs = inputs + 1
      }
    }
    if isSourceKind(kind: node.kind) and inputs is not 0 {
      ret failedPlan(error: "node {i} is a source and takes no input, but has {inputs}")
    }
    # a compressor's second input is its sidechain
    if node.kind is NodeKind.compressor and inputs is not 1 and inputs is not 2 {
      ret failedPlan(
        error: "node {i} is a compressor and takes its input and an optional sidechain, but has {inputs}"
      )
    }
    if not isSourceKind(kind: node.kind) and node.kind is not NodeKind.sum and node.kind is not NodeKind.compressor and inputs is not 1 {
      ret failedPlan(error: "node {i} takes one input (add a sum node before it), but has {inputs}")
    }
    if node.kind is NodeKind.sum and inputs is 0 {
      ret failedPlan(error: "node {i} is a sum with no input")
    }
    if node.kind is NodeKind.output {
      outputs = outputs + 1
    }
  }
  if outputs is not 1 {
    ret failedPlan(error: "the audio graph needs exactly one output node, it has {outputs}")
  }
  let latency: Int = outputLatency(graph: graph, order: order)
  let carryFrom: List(Int) = carryMap(graph: graph, previousPlan: previousPlan)
  # position of each node in the run order, and its last reader's position
  var position: List(Int) = {}
  position.addDefaults(count: count)
  loop var k: Int = 0, k < count, ++k {
    position.set(index: order.copyAtFallback(index: k, fallback: 0), value: k)
  }
  var lastReader: List(Int) = {}
  loop var i: Int = 0, i < count, ++i {
    lastReader.add(value: position.copyAtFallback(index: i, fallback: 0))
  }
  loop let edge: GraphEdge in graph.edges {
    let reader: Int = position.copyAtFallback(index: edge.to, fallback: 0)
    if reader > lastReader.copyAtFallback(index: edge.from, fallback: 0) {
      lastReader.set(index: edge.from, value: reader)
    }
  }
  # buffers by liveness: a node's output takes a free buffer (or a new one);
  # a buffer goes back to the pool once its last reader has run
  var bufferOf: List(Int) = {}
  bufferOf.addDefaults(count: count)
  var free: List(Int) = {}
  var bufferCount: Int = 0
  loop var k: Int = 0, k < count, ++k {
    let node: Int = order.copyAtFallback(index: k, fallback: 0)
    var buffer: Int = bufferCount
    if free.length() > 0 {
      buffer = free.copyAtFallback(index: free.length() - 1, fallback: 0)
      free.removeLast()
    } else {
      bufferCount = bufferCount + 1
    }
    bufferOf.set(index: node, value: buffer)
    loop let edge: GraphEdge in graph.edges {
      if edge.to is node and lastReader.copyAtFallback(index: edge.from, fallback: 0) is k {
        free.add(value: bufferOf.copyAtFallback(index: edge.from, fallback: 0))
      }
    }
    # an output nobody reads (and not the graph's output) is free at once
    if lastReader.copyAtFallback(index: node, fallback: 0) is k and graph.nodes.copyAtFallback(
      index: node
      fallback: outputNode()
    ).kind is not NodeKind.output {
      free.add(value: buffer)
    }
  }
  ret CompiledPlan {
    plan: prepareRenderPlan(
      graph: graph
      order: order
      bufferOf: bufferOf
      bufferCount: bufferCount
      sampleRate: sampleRate
      maxFrames: maxFrames
      carryFrom: carryFrom
      previousSerial: previousPlan.serial
      latencyFrames: latency
    )
    error: ""
  }
}
