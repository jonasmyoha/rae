pack Audio {
  format: "raepack"
  version: 1
  meta: {
    version: "0.1.0"
  }
  rae: {
    version: "0.3.79"
  }
  native: {
    build: "native/build.sh"
    header: "rae_audio.h"
    include: "include"
    link: "lib/libraeaudio.a"
    linkLinux: "-lpthread -lm -ldl"
    sourcesDevice: "src/rae_audio_glue.c"
    definesDevice: "DEVICE_DEFINES"
  }
}
