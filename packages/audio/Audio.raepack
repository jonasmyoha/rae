pack Audio {
  format: "raepack"
  version: 1
  meta: {
    version: "0.12.3"
  }
  rae: {
    version: "0.3.108"
  }
  native: {
    build: "native/build.sh"
    header: "rae_audio.h"
    include: "include"
    link: "lib/libraeaudio.a"
    linkLinux: "-lpthread -lm -ldl"
    sourcesDevice: "src/rae_audio_glue.m"
    sourcesAndroid: "src/rae_audio_glue.c src/java/org/rae/audio/RaeAudioSession.java src/java/org/rae/audio/RaeAudioMidi.java src/java/org/rae/audio/RaeMidiLoopback.java"
    definesDevice: "DEVICE_DEFINES"
  }
}
