# audio/AudioTypes — the engine's small value types (audio/Audio): its
# settings, a voice's id, a sound the engine knows, its slot, and a voice the
# main thread knows.
open audio/AudioSession

type AudioSettings {
  sampleRate: Int
  channels: Int
  # the device period asked for, in frames (the device may choose another)
  periodFrames: Int
  # no device: render only through renderOffline
  offline: Bool
  # what the program's sound is for (audio/AudioSession)
  session: AudioSessionKind
  # input channels to record (audio/AudioInput), 0 for none: a duplex device
  inputChannels: Int
  # an EQ, a compressor and a reverb on the music and effects buses (audio/BusEffects)
  busEffects: Bool = false
  # copy every rendered block for the main thread (audio/AudioTap, takeOutput)
  outputTap: Bool = false
}

type VoiceId {
  value: Int
}

# A sound the engine knows (audio.addSound / audio.loadSound)
type Sound {
  soundId: Int
  samples: Buffer(Float)
  frameCount: Int
  channels: Int
  sampleRate: Int
  # "" when it loaded, else what was wrong (it then plays nothing)
  error: String
}

type SoundSlot {
  soundId: Int
  samples: Buffer(Float)
  live: Bool
  # freeSound asked; the samples go once the audio thread lets them go
  releasing: Bool
  # at most this many of its voices at once, 0 for no cap (audio/VoiceControls)
  voiceLimit: Int = 0
  stealQuietest: Bool = false
}

# A voice the main thread knows is playing, and on which bus
type LiveVoice {
  voiceId: Int
  bus: Int
}
