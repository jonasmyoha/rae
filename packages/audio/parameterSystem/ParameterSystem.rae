# audio/parameterSystem/ParameterSystem — the mixer's parameters as
# timestamped events (docs/audio-design.md §10.2, §5.4). Gain, mute and solo
# (a fader's effective level), pan and a send's level do not rebuild the plan:
# each change is sent to the audio thread as an event for `sampleTime`, where
# it lands on that exact sample (the renderer cuts its block there) and a gain
# ramps to it over 5 ms so it never clicks. Only values that changed since the
# last event (or the last compile) are sent.
open audio/AudioComponents
open audio/AudioGraph
open audio/GraphRender
open audio/graphSystem/GraphSystem
open ecs/ComponentTable
open ecs/Entity

func audioParameterSystem(
  entities: view AudioEntities
  state: mod AudioGraphState
  sampleTime: view Int
) {
  if not state.hasPlan {
    ret
  }
  let soloActive: Bool = soloIsActive(entities: entities)
  loop var i: Int = 0, i < entities.tracks.componentCount(), ++i {
    let entityId: EntityId = entities.tracks.componentEntityAt(i: i)
    let track: AudioTrack = entities.tracks.componentCopyAtDefault(i: i)
    let index: Int = entityId.index
    let fader: Float = effectiveFader(
      entities: entities
      entityId: entityId
      kind: track.kind
      soloActive: soloActive
    )
    if fader is not state.sentFader.copyAtFallback(index: index, fallback: fader) {
      let sent: Bool = state.renderer.sendParameter(
        event: GraphParameterEvent {
          key: audioNodeKey(entityId: entityId, role: roleFader)
          kind: 0
          value: fader
          sampleTime: sampleTime
        }
      )
      if sent {
        state.sentFader.set(index: index, value: fader)
      }
    }
    if track.kind is not AudioTrackKind.master {
      let pan: Float = panOf(entities: entities, entityId: entityId)
      if pan is not state.sentPan.copyAtFallback(index: index, fallback: pan) {
        let sent: Bool = state.renderer.sendParameter(
          event: GraphParameterEvent {
            key: audioNodeKey(entityId: entityId, role: rolePan)
            kind: 1
            value: pan
            sampleTime: sampleTime
          }
        )
        if sent {
          state.sentPan.set(index: index, value: pan)
        }
      }
    }
  }
}
