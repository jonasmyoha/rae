pack Sql {
  format: "raepack"
  version: 1
  meta: {
    version: "1.0.0"
  }
  rae: {
    version: "0.3.4"
  }
  native: {
    build: "native/build.sh"
    header: "rae_sql.h"
    include: "include"
    link: "lib/libsqlite3.a"
    linkBrowser: "lib/emscripten/libsqlite3.a"
    linkLinux: "-lpthread -lm"
    sourcesDevice: "src/sqlite3.c src/rae_sql_glue.c"
    definesDevice: "DEVICE_DEFINES"
  }
}
