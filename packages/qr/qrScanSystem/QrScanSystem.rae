# An in-game camera that reads QR codes in the 3D world (docs/qr.md,
# "Scanning the rendered frame"): every `intervalFrames` frames a square in
# the middle of the rendered frame is read back from the GPU
# (lib/gpu/FrameRegionReader: a frame or two later, nothing waits), turned
# to gray and decoded (qr/QrReader). `scanner.latest` is the last code
# read, `scanner.lastRead` whether the last scan read one.
#
# The app calls `qrScanFrame` after each present, on the frame's canvas.
#
# By default it reads the whole composed frame: every 2D layer is in it, so a code on the
# program's own HUD is read too, and a dialog over the middle hides the world's codes. With
# `afterLayer` set (the name of a layer of the window's stack, such as "world"), the picture is
# copied in the middle of the frame, before the first step of the paint plan above that layer:
# the 3D frame and the layers up to it, nothing over them. The program calls
# `qrScanBeforeStep` before each step of its plan (docs/ui-layers-design.md §4.4). A program with
# no plan calls `qrScanNow` right after its 3D frame, before any 2D, for the 3D frame alone.
# Copying mid-frame ends the canvas's 2D pass and starts it again (one more pass that frame).
import Math
open gpu/FrameRegionReader
open Gpu2dCanvas
open qr/GrayImage
open qr/QrReader
open ui/UiLayers

type QrScanner {
  enabled: Bool
  # A scan every this many frames (1: as often as the readback allows)
  intervalFrames: Int
  # The square read, physical pixels, centered in the frame
  regionSide: Int
  reader: FrameRegionReader
  framesUntilScan: Int
  # Scans done, and how many read a code
  scans: Int
  reads: Int
  lastRead: Bool
  latest: opt QrReadResult
  # The last scan's decode time, and how many frames its pixels took
  lastDecodeNs: Int
  lastLatencyFrames: Int
  # The layer whose end the picture is copied at ("": the whole frame after present)
  afterLayer: String = ""
  # A copy was made in this frame (qrScanNow), and the plan painted a step above `afterLayer`;
  # qrScanFrame clears both
  copiedThisFrame: Bool = false
  aboveSeen: Bool = false
}

func createQrScanner(intervalFrames: view Int, regionSide: view Int) ret QrScanner {
  ret QrScanner {
    enabled: true
    intervalFrames: intervalFrames
    regionSide: regionSide
    reader: createFrameRegionReader()
    framesUntilScan: 0
    scans: 0
    reads: 0
    lastRead: false
    latest: none
    lastDecodeNs: 0
    lastLatencyFrames: 0
  }
}

# The pixels that arrived, as gray (RGBA8 or BGRA8: green weighs twice,
# red and blue once, the same in either order)
func regionGray(reader: view FrameRegionReader) ret GrayImage {
  var pixels: List(UInt8) = List.create(UInt8, cap: reader.width * reader.height)
  loop var y: Int = 0, y < reader.height, ++y {
    let row: Int = y * reader.bytesPerRow
    loop var x: Int = 0, x < reader.width, ++x {
      let at: Int = row + x * 4
      let first: Int = reader.bytes.copyAtFallback(index: at, fallback: 0) as Int
      let green: Int = reader.bytes.copyAtFallback(index: at + 1, fallback: 0) as Int
      let third: Int = reader.bytes.copyAtFallback(index: at + 2, fallback: 0) as Int
      pixels.add(value: ((first + green * 2 + third) / 4) as UInt8)
    }
  }
  ret GrayImage { width: reader.width, height: reader.height, pixels: own pixels }
}

# One frame (after present): true when a scan finished this frame (read or
# not: see `scanner.lastRead`)
func qrScanFrame(scanner: mod QrScanner, canvas: mod Gpu2dCanvas) ret Bool {
  if not scanner.enabled {
    ret false
  }
  frameRegionKeepOffscreen(canvas: canvas)
  var finished: Bool = false
  if frameRegionUpdate(reader: scanner.reader, canvas: canvas) {
    let start: Int = nowNs()
    let image: GrayImage = regionGray(reader: scanner.reader)
    scanner.lastRead = false
    if let result: QrReadResult = qrRead(image: image) {
      scanner.latest = result
      scanner.lastRead = true
      scanner.reads = scanner.reads + 1
    }
    scanner.lastDecodeNs = nowNs() - start
    scanner.lastLatencyFrames = scanner.reader.latencyFrames
    scanner.scans = scanner.scans + 1
    finished = true
  }
  let copiedThisFrame: Bool = scanner.copiedThisFrame
  let aboveSeen: Bool = scanner.aboveSeen
  scanner.copiedThisFrame = false
  scanner.aboveSeen = false
  if frameRegionIsIdle(reader: scanner.reader) and not copiedThisFrame {
    if scanner.framesUntilScan > 0 {
      scanner.framesUntilScan = scanner.framesUntilScan - 1
    } else if not aboveSeen {
      # the whole frame after present; with `afterLayer`, only when the plan painted nothing
      # above it this frame (the same picture), never a frame with something over it
      let side: Int = Math.min(
        a: scanner.regionSide
        b: Math.min(a: canvas.offscreenWidth, b: canvas.offscreenHeight)
      )
      let started: Bool = frameRegionStart(
        reader: scanner.reader
        canvas: canvas
        x: (canvas.offscreenWidth - side) / 2
        y: (canvas.offscreenHeight - side) / 2
        width: side
        height: side
      )
      scanner.framesUntilScan = scanner.intervalFrames
    }
  }
  ret finished
}

func qrScanRelease(scanner: mod QrScanner, canvas: mod Gpu2dCanvas) {
  frameRegionRelease(reader: scanner.reader, canvas: canvas)
}

# The centered square of what the frame holds now, copied mid-frame when a scan is due: call it
# between the canvas's frame begin and end (true when it copied)
func qrScanNow(scanner: mod QrScanner, canvas: mod Gpu2dCanvas) ret Bool {
  if not scanner.enabled or scanner.copiedThisFrame or scanner.framesUntilScan > 0 or not frameRegionIsIdle(
    reader: scanner.reader
  ) {
    ret false
  }
  let side: Int = Math.min(
    a: scanner.regionSide
    b: Math.min(a: canvas.offscreenWidth, b: canvas.offscreenHeight)
  )
  if not frameRegionCopyNow(
    reader: scanner.reader
    canvas: canvas
    x: (canvas.offscreenWidth - side) / 2
    y: (canvas.offscreenHeight - side) / 2
    width: side
    height: side
  ) {
    ret false
  }
  scanner.copiedThisFrame = true
  scanner.framesUntilScan = scanner.intervalFrames
  ret true
}

# Before painting the plan's step `step`: with `afterLayer` set, the copy is made before the first
# step above that layer (true when it copied)
func qrScanBeforeStep(
  scanner: mod QrScanner
  canvas: mod Gpu2dCanvas
  stack: view LayerStack
  step: view PaintStep
) ret Bool {
  if scanner.afterLayer.length() is 0 or scanner.copiedThisFrame or scanner.aboveSeen {
    ret false
  }
  let target: Int = layerIdOf(stack: stack, name: scanner.afterLayer)
  if target < 0 {
    ret false
  }
  if layerPosition(stack: stack, id: step.layer) <= layerPosition(stack: stack, id: target) {
    ret false
  }
  let first: Bool = not scanner.aboveSeen
  scanner.aboveSeen = true
  if not first {
    ret false
  }
  ret qrScanNow(scanner: scanner, canvas: canvas)
}
