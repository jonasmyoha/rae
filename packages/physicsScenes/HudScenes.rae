# The HUD scenes of the physics playgrounds and the vehicle apps, as Rae: a package has no
# place for a file an app reads at run time yet (docs/toolchain-and-packages-decision.md,
# section 6), and text in a module also needs no path in a browser or on a phone.
open ui/Scene

func sceneFromLines(lines: view List(String), sceneId: view String) ret Scene {
  var source: String = ""
  loop let line: view String in lines {
    source = "{source}{line}\n"
  }
  var scene: Scene = parseScene(source: source)
  scene.sceneId = "{sceneId}"
  ret scene
}

